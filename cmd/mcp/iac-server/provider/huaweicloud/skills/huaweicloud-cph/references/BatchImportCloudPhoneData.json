        "tags": [
          "手机实例管理"
        ],
        "summary": "恢复云手机数据",
        "description": "批量恢复数据到云手机中。该接口为异步接口。接口调用前请先确保已完成CPH服务操作OBS桶的委托授权。委托CPH操作OBS桶请参见[委托CPH操作OBS桶](https://support.huaweicloud.com/bestpractice-cph/cph_bp_0050.html)。\n\n高版本手机导出的数据无法在低版本手机内恢复。低版本手机导出的数据可以在高版本手机内恢复,但可能会在极少数场景下有不兼容的风险。因此推荐您在同版本手机间进行导出与恢复。\n\n手机在运行状态会有数据缓存,直接运行恢复的文件可能带来访问失败、应用崩溃等现象,建议在还原成功后重启手机,以保证云手机稳定运行。"
      }
    }
  },
  "definitions": {
    "PhoneJob": {
      "type": "object",
      "description": "云手机任务。",
      "properties": {
        "phone_id": {
          "type": "string",
          "description": "云手机的唯一标识ID,云手机相关任务包含此字段。",
          "minLength": 32,
          "maxLength": 32
        },
        "job_id": {
          "type": "string",
          "description": "任务的唯一标识。",
          "minLength": 32,
          "maxLength": 32
        },
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 1024
        },
        "error_msg": {
          "type": "string",
          "description": "错误说明。",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "RestoreInfo": {
      "type": "object",
      "description": "待重建数据的云手机信息。",
      "required": [
        "phone_id",
        "bucket_name",
        "object_path"
      ],
      "properties": {
        "phone_id": {
          "type": "string",
          "description": "云手机ID。",
          "minLength": 32,
          "maxLength": 32
        },
        "bucket_name": {
          "type": "string",
          "description": "导出数据存储的OBS桶名。\n合法的OBS桶名,3-63个字符,只能由小写字母、数字、中划线(-)和小数点(.)组成。",
          "minLength": 0,
          "maxLength": 64
        },
        "object_path": {
          "type": "string",
          "description": "导出数据存储的OBS路径名。\n符合OBS的路径名规范,最大长度1024字符。",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "BatchImportCloudPhoneDataRequestBody": {
      "required": [
        "restore_infos"
      ],
      "properties": {
        "restore_infos": {
          "items": {
            "$ref": "#/definitions/RestoreInfo"
          },
          "description": "待导入数据的云手机信息。",
          "type": "array",
          "minItems": 0,
          "maxItems": 8096
        }
      },
      "type": "object",
      "description": "导入云手机数据请求体。"
    },
    "BatchImportCloudPhoneDataResponseBody": {
      "type": "object",
      "description": "批量导入云手机数据响应体。",
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "minLength": 32,
          "maxLength": 32
        },
        "jobs": {
          "items": {
            "$ref": "#/definitions/PhoneJob"
          },
          "description": "任务信息。",
          "type": "array",
          "minItems": 0,
          "maxItems": 8096
        }
      }
    }
  },
  "version": "2.0",
