          "minLength": 32,
          "maxLength": 32
        },
        "job_id": {
          "type": "string",
          "description": "任务的唯一标识。",
          "minLength": 32,
          "maxLength": 32
        },
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 1024
        },
        "error_msg": {
          "type": "string",
          "description": "错误说明。",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "InstallApkRequestBody": {
      "type": "object",
      "description": "安装应用请求体。",
      "required": [
        "command",
        "content"
      ],
      "properties": {
        "command": {
          "type": "string",
          "description": "安装单apk场景填写install,多apk场景填写install-multiple。",
          "default": "install",
          "minLength": 7,
          "maxLength": 7
        },
        "content": {
          "type": "string",
          "description": "指定OBS桶中的apk文件(需要提前上传到指定桶中)。\n只支持大小写字母、数字、下划线(_)、点(.)、斜线(/)、冒号(:)、中划线(-)。推送的文件只支持apk文件类型。\n\n单apk场景,只能传一个apk,最大长度为1024字节;多apk场景,最多传50个apk,中间用空格分开,最大长度8100字节。",
          "example": "obs://obs-bucket-name/obs-file-path/file.apk",
          "minLength": 0,
          "maxLength": 8096
        },
        "phone_ids": {
          "type": "array",
          "description": "云手机ID列表。\nserver_ids参数不存在时必选,同时存在只处理phone_ids。",
          "items": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32
          },
          "minItems": 0,
          "maxItems": 8096
        },
        "server_ids": {
          "type": "array",
          "description": "云手机服务器ID列表。\nphone_ids参数不存在时必选,同时存在只处理phone_ids。",
          "items": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32
          },
          "minItems": 0,
          "maxItems": 8096
        }
      }
    }
