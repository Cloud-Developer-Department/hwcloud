        "tags": [
          "云手机服务器管理"
        ],
        "summary": "购买云手机服务器",
        "description": "购买云手机服务器,支持您复用已有的VPC网络管理云手机服务器,支持云手机服务器复用您已购买的共享带宽等资源。\n- 请确保您使用的账号具有CPH AgencyDependencyAccess权限。\n- 请确保您有足够的服务器及网络配额,配额校验不通过将导致创建失败。"
      }
    }
  },
  "definitions": {
    "Port": {
      "type": "object",
      "required": [
        "name",
        "listen_port",
        "internet_accessible"
      ],
      "description": "云手机启用的应用端口,云手机服务会做端口转发。",
      "properties": {
        "name": {
          "type": "string",
          "description": "应用端口名称,不超过16个字节,系统关键服务名称不能使用\"adb\"和\"vnc\"。",
          "minLength": 0,
          "maxLength": 16
        },
        "listen_port": {
          "type": "integer",
          "format": "int32",
          "description": "端口号,大于等于10000,小于等于50000。",
          "minimum": 10000,
          "maximum": 50000
        },
        "internet_accessible": {
          "type": "string",
          "description": "为\"true\"则映射出公网访问(忽略大小写)。\n为其他则不映射。",
          "example": "true",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "Nic": {
      "type": "object",
      "required": [
        "subnet_id"
      ],
      "description": "租户自定义的网卡的结构体,为待创建的云服务器的网卡信息。",
      "properties": {
        "subnet_id": {
          "type": "string",
          "description": "租户自定义的子网 ID,为待创建的云服务器所属的子网。\n\n需要指定tenant_vpc_id对应VPC下已创建的子网(subnet)的网络ID,UUID格式。",
          "minLength": 0,
          "maxLength": 36,
          "example": "63d1b76c-eab0-45b0-904e-5d4c82259bfb"
        },
        "ipv6_enable": {
          "type": "boolean",
          "description": "是否支持ipv6。\n\n取值为true时,标识此网卡支持ipv6。",
          "example": true
        },
        "ipv6_bandwidth": {
          "properties": {
            "band_width_id": {
              "type": "string",
              "description": "ipv6绑定的共享带宽ID。",
              "minLength": 0,
              "maxLength": 36,
              "example": "388a04fb-c039-42d2-91e4-077444003e25"
            }
          },
          "required": [
            "band_width_id"
          ],
          "description": "绑定的共享带宽信息,详情请参见 ipv6_bandwidth数据结构说明。"
        }
      }
    },
    "CreateNet2CloudPhoneServerResponseBody": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "minLength": 32,
          "maxLength": 32
        },
        "order_id": {
          "type": "string",
          "description": "订单ID,不超过64个字节。",
          "minLength": 0,
          "maxLength": 64
        },
        "product_id": {
          "type": "string",
          "description": "产品ID,不超过64个字节。",
          "minLength": 0,
          "maxLength": 64
        },
        "server_ids": {
          "type": "array",
          "description": "服务器ID列表。",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "minLength": 32,
            "maxLength": 32,
            "type": "string"
          }
        },
        "error_msg": {
          "type": "string",
          "description": "任务错误码说明。",
          "minLength": 0,
          "maxLength": 1024
        },
        "error_code": {
          "type": "string",
          "description": "任务错误码。",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "CreateNet2CloudPhoneServerRequestBody": {
      "required": [
        "server_name",
        "server_model_name",
        "phone_model_name",
        "image_id",
        "count",
        "extend_param",
        "tenant_vpc_id",
        "nics",
        "public_ip",
        "band_width"
      ],
      "properties": {
        "server_name": {
          "type": "string",
          "example": "cph-kertus-1110",
          "description": "云手机服务器名称,\n\n不超过60个字符,只支持英文字母、数字、汉字、下划线和中划线。\n\n批量购买会在服务器名称后自动添加序号,比如设置此参数为server-1,那么创建的云手机服务器名称会自动按序增加数字后缀,比如为server-1-0001。",
          "minLength": 0,
          "maxLength": 64
        },
        "server_model_name": {
          "type": "string",
          "example": "physical.kg1.4xlarge.cp",
          "description": "云手机服务器规格,不超过64个字节。",
          "minLength": 0,
          "maxLength": 64
        },
        "phone_model_name": {
          "type": "string",
          "example": "kg1.cp.c20.d64SSD.e1v1",
          "description": "云手机规格,不超过64个字节。",
          "minLength": 0,
          "maxLength": 64
        },
        "image_id": {
          "type": "string",
          "example": "20060220200717f201120a2300000e91",
          "description": "云手机镜像ID,不超过32个字节。",
          "minLength": 0,
          "maxLength": 64
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "购买的云手机服务器个数,最多可购买10台。",
          "minimum": 0,
          "maximum": 1024
        },
        "keypair_name": {
          "type": "string",
          "example": "keypair",
          "description": "密钥对名称,不超过64个字节,用于云手机ADB登录。",
          "minLength": 0,
          "maxLength": 64
        },
        "ports": {
          "items": {
            "$ref": "#/definitions/Port"
          },
          "description": "云手机启用的应用端口,云手机服务会做端口转发。",
          "type": "array",
          "minItems": 0,
          "maxItems": 8096
        },
        "extend_param": {
          "description": "计费模式参数。",
          "required": [
            "charging_mode",
            "period_type",
            "period_num"
          ],
          "properties": {
            "charging_mode": {
              "type": "integer",
              "format": "int32",
              "example": 0,
              "description": "计费类型。\n\n- 0:包周期",
              "minimum": -128,
              "maximum": 128
            },
            "period_type": {
              "type": "integer",
              "format": "int32",
              "example": 2,
              "description": "订购周期类型。\n- 2:月\n- 3:年",
              "minimum": -128,
              "maximum": 128,
              "x-open-region-cloud": "hc,hk,cmcc,ctc"
            },
            "period_num": {
              "type": "integer",
              "format": "int32",
              "example": 1,
              "description": "订购周期数。\n当订购周期为月时,取值范围[1, 9]。\n当订购周期为年时,取值范围[1,10]。",
              "minimum": -128,
              "maximum": 128,
              "x-open-region-cloud": "hc,hk,cmcc,ctc"
            },
            "is_auto_pay": {
              "type": "integer",
              "format": "int32",
              "example": 0,
              "description": "是否自动付款。默认不自动付款。\n- 1:自动付款\n- 0:不自动付款",
              "minimum": -128,
              "maximum": 128,
              "x-open-region-cloud": "hc,hk,cmcc,ctc"
            },
            "is_auto_renew": {
              "type": "integer",
              "format": "int32",
              "example": 0,
              "description": "是否自动续订。默认不自动续订。\n- 1:自动续订\n- 0:不自动续订",
              "minimum": -128,
              "maximum": 128,
              "x-open-region-cloud": "hc,hk,cmcc,ctc"
            },
            "enterprise_project_id": {
              "type": "string",
              "description": "企业项目ID。\n该字段不传(或传为字符串“0”),则将资源绑定给默认企业项目。",
              "minLength": 0,
              "maxLength": 36,
              "example": "0"
            }
          }
        },
        "tenant_vpc_id": {
          "type": "string",
          "example": "fca063f6-b942-42a8-9004-e5545f58d6a2",
          "description": "租户自定义的VPC ID,为待创建的云服务器所属的虚拟私有云(简称VPC),需要指定已创建VPC的ID,UUID格式。",
          "minLength": 36,
          "maxLength": 36
        },
        "nics": {
          "items": {
            "$ref": "#/definitions/Nic"
          },
          "description": "租户自定义的网卡的结构体,为待创建的云服务器的网卡信息。",
          "type": "array",
          "minItems": 0,
          "maxItems": 8096
        },
        "public_ip": {
          "description": "租户自定义的弹性公网IP结构体。\n\n配置云服务器的弹性IP信息的方式,\n\n自动分配,需要指定新创建弹性IP的信息;\n使用已有,需要指定已经购买的EIP ID。",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 64,
                "example": "91aad32a-8be2-4070-af78-4d781f0d968c"
              },
              "description": "指定已有的EIP进行服务器创建,当前只支持传入一个已有的EIP ID。",
              "minItems": 0,
              "maxItems": 8096
            },
            "eip": {
              "description": "配置服务器自动分配弹性IP时,创建弹性IP的配置参数,详情见 eip 结构体。",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "example": "5_bgp",
                  "description": "弹性公网IP的类型。\n- 5_telcom:电信\n- 5_union:联通\n- 5_bgp:全动态BGP\n- 5_sbgp:静态BGP",
                  "minLength": 0,
                  "maxLength": 1024
                }
              }
            },
            "count": {
              "description": "Eip数量。默认为1,不需要Eip可设置为0,取值范围为0到手机IP数。",
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "maximum": 65535,
              "example": 1
            }
          }
        },
        "phone_count_per_ip": {
          "description": "多少个手机共用一个vip。默认为手机开数,表示所有手机共享1个vip。取值范围:1到手机规格开数。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 65535,
          "example": 1
        },
        "phone_data_volume": {
          "description": "手机磁盘结构体,2.0规格必选。",
          "required": [
            "volume_type",
            "size"
          ],
          "properties": {
            "volume_type": {
              "type": "string",
              "description": "磁盘类型,只支持如下类型:\n- SSD\n- GPSSD",
              "minLength": 0,
              "maxLength": 36,
              "example": "GPSSD"
            },
            "size": {
              "type": "integer",
              "format": "int32",
              "description": "手机磁盘大小,单位GiB,取值范围[1,32768]。",
              "minimum": 1,
              "maximum": 32768,
              "example": 1
            }
          }
        },
        "server_share_data_volume": {
          "description": "共享存储磁盘结构体,2.0规格可选。注:rx7服务器+AOSP11镜像当前不支持共享应用。",
          "required": [
            "volume_type",
            "size"
          ],
          "properties": {
            "volume_type": {
              "type": "string",
              "description": "磁盘类型,只支持如下类型:\n  - SSD\n  - GPSSD",
              "minLength": 36,
              "maxLength": 36,
              "example": "GPSSD"
            },
            "size": {
              "type": "integer",
              "format": "int32",
              "description": "共享磁盘大小,单位GiB,取值范围[10,32768]。",
              "minimum": 10,
              "maximum": 32768,
              "example": 10
            }
          }
        },
        "band_width": {
          "description": "云手机使用的带宽信息。",
          "properties": {
            "band_width_id": {
              "type": "string",
              "description": "云手机服务器的带宽唯一标识,选共享带宽时必选。",
              "minLength": 36,
              "maxLength": 36,
              "example": "388a04fb-c039-42d2-91e4-077444003e25"
            },
            "band_width_size": {
              "type": "integer",
              "format": "int32",
              "description": "云手机服务器的带宽大小,选独享带宽时必选。",
              "minimum": 0,
              "maximum": 8096,
              "example": 100
            },
            "band_width_charge_mode": {
              "type": "integer",
              "format": "int32",
              "description": "云手机服务器带宽的计费方式。\n\n- 0:bandwidth, 按带宽计费\n\n- 1:traffic, 按流量计费",
              "minimum": -128,
              "maximum": 128,
              "example": 1
            },
            "band_width_share_type": {
              "type": "integer",
              "format": "int32",
              "description": "云手机服务器的带宽类型。\n\n- 0:per,独享带宽\n- 1:whole,共享带宽",
              "minimum": -128,
              "maximum": 128
            }
          },
          "required": [
            "band_width_charge_mode",
            "band_width_share_type"
          ]
        },
        "availability_zone": {
          "type": "string",
          "description": "待创建云服务器所在的可用区,需要指定可用区(AZ)的名称。如上海一可用区1为cn-east-3a。",
          "minLength": 0,
          "maxLength": 1024,
          "example": "cn-east-3a"
        },
        "property": {
          "type": "string",
          "description": "云手机属性列表,为Json格式字符串。只可以预置有权限修改的属性。字符串长度[1,8192]。",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目id。",
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 0,
      "maxLength": 8096
    }
  },
  "host": "cph.cn-east-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
