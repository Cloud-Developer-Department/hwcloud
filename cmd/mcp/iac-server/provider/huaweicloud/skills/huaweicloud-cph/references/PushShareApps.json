        "x-request-examples-description-1": "将应用推送到服务器列表中的服务器上,应用来自于obs桶中",
        "x-request-examples-text-1": {
          "package_name": "com.miniteck.miniworld",
          "bucket_name": "bucket",
          "object_path": "my_apps/test.tar",
          "server_ids": [
            "1234567b8bab40ffb711234cb80d0234",
            "1678567b8bab40f93711234cb80d0764"
          ]
        },
        "x-request-examples-1": {
          "package_name": "com.miniteck.miniworld",
          "bucket_name": "bucket",
          "object_path": "my_apps/test.tar",
          "server_ids": [
            "1234567b8bab40ffb711234cb80d0234",
            "1678567b8bab40f93711234cb80d0764"
          ]
        },
        "description": "推送应用tar文件至共享应用存储目录中,该功能仅在支持共享应用的云手机服务器上可实现。接口调用前请先确保已完成CPH服务操作OBS桶的委托授权。委托CPH操作OBS桶请参见[委托CPH操作OBS桶](https://support.huaweicloud.com/bestpractice-cph/cph_bp_0050.html)。\n\n注意:不能向存在低安卓版本云手机的服务器推送高安卓版本手机导出的应用包,否则可能会造成手机数据兼容性问题。如果您使用的是physical.kg1.4xlarge.a.cp服务器规格,请确保共享存储的可用空间大于两倍的tar包大小",
        "operationId": "PushShareApps",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "name": "PushShareAppsRequestBody",
            "in": "body",
            "required": true,
            "description": "推送共享应用请求体",
            "schema": {
              "$ref": "#/definitions/PushShareAppsRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "request_id": "6837531fd3f54550927b930180a706bf",
                "jobs": [
                  {
                    "server_id": "1234567b8bab40ffb711234cb80d0234",
                    "job_id": "1564567b8bab40f34711234cb80d0123"
                  },
                  {
                    "server_id": "1678567b8bab40f93711234cb80d0764",
                    "job_id": "1564567b8bab40f34711234cb80d5678"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/PushShareAppsResponseBody"
            }
          }
        },
        "schemes": [
          "https"
        ],
        "tags": [
          "云手机服务器管理"
        ],
        "summary": "推送共享应用"
      }
    }
  },
  "definitions": {
    "PushShareAppsRequestBody": {
      "required": [
        "package_name",
        "bucket_name",
        "object_path",
        "server_ids"
      ],
      "properties": {
        "package_name": {
          "type": "string",
          "example": "com.miniteck.miniworld",
          "description": "合法的应用包名。",
          "minLength": 0,
          "maxLength": 1024
        },
        "pre_install_app": {
          "type": "integer",
          "format": "int32",
          "description": "是否预装应用。\n- 1:预装\n- 0:不预装;默认不预装",
          "minimum": -128,
          "maximum": 128
        },
        "bucket_name": {
          "type": "string",
          "example": "bucket",
          "description": "合法的OBS桶名,3-63个字符,只能由小写字母、数字、中划线(-)和小数点组成",
          "minLength": 0,
          "maxLength": 64
        },
        "object_path": {
          "type": "string",
          "example": "my_apps/test.tar",
          "description": "合法的OBS对象key,最大长度1024字符。仅支持大小写字母、数字、小数点(.)、斜线(/)、中划线(-)、下划线(_)、加号(+)、井号(#)、等号等这些字符。\n推送的文件只支持tar文件类型。推送时,按tar文件解压后的文件目录结构推送到手机。",
          "minLength": 0,
          "maxLength": 1024
        },
        "server_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32
          },
          "example": [
            "1234567b8bab40ffb711234cb80d0234",
            "1678567b8bab40f93711234cb80d0764"
          ],
          "description": "云手机服务器ID列表。传入的服务器id个数范围为[1, 100]。",
          "minItems": 0,
          "maxItems": 8096
        }
      }
    },
    "ServerJob": {
      "type": "object",
      "description": "云手机服务器任务。",
      "properties": {
        "server_id": {
          "type": "string",
          "description": "云手机服务器的唯一标识ID,云手机服务器相关任务包含此字段。",
          "minLength": 32,
          "maxLength": 32
        },
        "job_id": {
          "type": "string",
          "description": "任务的唯一标识。",
          "minLength": 32,
          "maxLength": 32
        },
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 1024
        },
        "error_msg": {
          "type": "string",
          "description": "错误说明。",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "PushShareAppsResponseBody": {
      "type": "object",
      "description": "推送共享应用响应体。",
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "minLength": 32,
          "maxLength": 32
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ServerJob"
          },
          "description": "任务列表。",
          "minItems": 0,
          "maxItems": 8096
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目id。",
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 0,
      "maxLength": 8096
    }
  },
