  "definitions": {
    "RunShellCommandRequestBody": {
      "type": "object",
      "description": "执行shell命令请求体。",
      "required": [
        "command",
        "content"
      ],
      "properties": {
        "command": {
          "type": "string",
          "description": "ADB命令,固定填写shell。",
          "default": "shell",
          "minLength": 5,
          "maxLength": 5
        },
        "content": {
          "type": "string",
          "description": "待执行的命令。\n\n最大长度为1024字节,只支持大小写字母、数字、下划线(_)、点(.)、斜线(/)、冒号(:)、中划线(-)。",
          "example": "ls -l /system",
          "minLength": 0,
          "maxLength": 1024
        },
        "phone_ids": {
          "type": "array",
          "description": "云手机ID列表。\nserver_ids参数不存在时必选,同时存在只处理phone_ids。",
          "items": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32
          },
          "minItems": 0,
          "maxItems": 8096
        },
        "server_ids": {
          "type": "array",
          "description": "云手机服务器ID列表。\nphone_ids参数不存在时必选,同时存在只处理phone_ids。",
          "items": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32
          },
          "minItems": 8096,
          "maxItems": 8096
        }
      }
    },
    "PhoneJob": {
      "type": "object",
      "description": "云手机任务。",
      "properties": {
        "phone_id": {
          "type": "string",
          "description": "云手机的唯一标识ID,云手机相关任务包含此字段。",
          "minLength": 32,
          "maxLength": 32
        },
        "job_id": {
          "type": "string",
          "description": "任务的唯一标识。",
          "minLength": 32,
          "maxLength": 32
        },
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 1024
        },
        "error_msg": {
          "type": "string",
          "description": "错误说明。",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "RunShellCommandResponseBody": {
      "type": "object",
      "description": "执行shell命令响应体。",
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "minLength": 32,
          "maxLength": 32
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PhoneJob"
          },
          "description": "任务列表。",
          "minItems": 0,
          "maxItems": 8096
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目id。",
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 0,
      "maxLength": 8096
    }
  },
