      }
    },
    "PhoneImage": {
      "type": "object",
      "description": "云手机镜像信息。",
      "properties": {
        "image_name": {
          "type": "string",
          "description": "手机镜像名称,不超过128个字节。",
          "minLength": 0,
          "maxLength": 128
        },
        "os_type": {
          "type": "string",
          "description": "镜像操作系统类型,不超过16个字节。",
          "minLength": 0,
          "maxLength": 16
        },
        "is_public": {
          "type": "integer",
          "format": "int32",
          "description": "镜像类型。\n- 1:公有镜像\n- 2 :私有镜像",
          "minimum": -128,
          "maximum": 128
        },
        "os_name": {
          "type": "string",
          "description": "手机操作系统,不超过36个字节。",
          "minLength": 0,
          "maxLength": 36
        },
        "image_label": {
          "type": "string",
          "description": "镜像适用的云手机规格。\n- cloud_phone:适用于physical.rx1.xlarge 类型云手机服务器\n- cloud_phone_1620:适用于physical.kg1.4xlarge.cp类型云手机服务器\n- cloud_game:适用于physical.rx1.xlarge.cg 类型云手游服务器\n- cloud_game_1620:适用于physical.kg1.4xlarge.cg 类型云手游服务器\n- qemu_phone: 适用于physical.rx1.xlarge 类型云手机服务器中 qemu类型云手机规格",
          "minLength": 0,
          "maxLength": 1024
        },
        "image_id": {
          "type": "string",
          "description": "手机镜像唯一标识ID,不超过32个字节。",
          "minLength": 0,
          "maxLength": 64
        },
        "is_support_encrypt": {
          "type": "boolean",
          "description": "当前镜像是否支持文件级加密"
        }
      }
    }
