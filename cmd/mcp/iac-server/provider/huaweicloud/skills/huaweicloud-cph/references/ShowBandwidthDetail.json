          "maximum": 128,
          "example": 1
        },
        "band_width_share_type": {
          "type": "integer",
          "format": "int32",
          "description": "云手机服务器的带宽类型。\n\n- 0:per,独享带宽\n- 1:whole,共享带宽",
          "minimum": -128,
          "maximum": 128
        },
        "create_time": {
          "type": "string",
          "description": "带宽创建时间,\n\n时间格式为UTC,YYYY-MM-DDTHH:MM:SSZ。",
