  "definitions": {
    "PushShareFilesResponseBody": {
      "type": "object",
      "description": "推送共享存储响应体。",
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "minLength": 32,
          "maxLength": 32
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ServerJob"
          },
          "description": "任务列表。",
          "minItems": 0,
          "maxItems": 8096
        }
      }
    },
    "ServerJob": {
      "type": "object",
      "description": "云手机服务器任务。",
      "properties": {
        "server_id": {
          "type": "string",
          "description": "云手机服务器的唯一标识ID,云手机服务器相关任务包含此字段。",
          "minLength": 32,
          "maxLength": 32
        },
        "job_id": {
          "type": "string",
          "description": "任务的唯一标识。",
          "minLength": 32,
          "maxLength": 32
        },
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 1024
        },
        "error_msg": {
          "type": "string",
          "description": "错误说明。",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "PushShareFilesRequestBody": {
      "type": "object",
      "required": [
        "bucket_name",
        "object_path",
        "server_ids"
      ],
      "properties": {
        "bucket_name": {
          "type": "string",
          "example": "bucketA",
          "description": "合法的OBS桶名,3-63个字符,只能由小写字母、数字、中划线(-)和小数点组成。仅推送共享存储接口使用。",
          "minLength": 0,
          "maxLength": 64
        },
        "object_path": {
          "type": "string",
          "example": "my_apps/test.tar",
          "description": "合法的OBS对象路径,最大长度1024字符。仅支持大小写字母、数字、小数点(.)、斜线(/)、中划线(-)、下划线(_)、加号(+)、井号(#)、等号等这些字符。\n推送的文件只支持tar文件类型。推送时,按tar文件解压后的文件目录结构推送到手机。当前只支持/data和/cache目录推送。仅推送共享存储接口使用。",
          "minLength": 0,
          "maxLength": 1024
        },
        "server_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32
          },
          "example": [
            "1234567b8bab40ffb711234cb80d0234",
            "1678567b8bab40f93711234cb80d0764"
          ],
          "description": "云手机服务器ID列表。",
          "minItems": 0,
          "maxItems": 8096
        }
      }
    }
  },
