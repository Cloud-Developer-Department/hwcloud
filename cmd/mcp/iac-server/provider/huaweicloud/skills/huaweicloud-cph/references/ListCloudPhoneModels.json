  "definitions": {
    "PhoneModel": {
      "type": "object",
      "description": "云手机规格信息。",
      "properties": {
        "server_model_name": {
          "type": "string",
          "description": "云手机服务器的规格名称,不超过64个字节。",
          "minLength": 0,
          "maxLength": 64
        },
        "phone_model_name": {
          "type": "string",
          "description": "云手机的规格名称,不超过64个字节。",
          "minLength": 0,
          "maxLength": 64
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "规格状态。\n- 1 表示正常使用状态\n- 0 表示已下线状态\n已下线的规格不可用来购买云手机服务器",
          "minimum": -128,
          "maximum": 128
        },
        "cpu": {
          "type": "integer",
          "format": "int32",
          "description": "CPU核数。",
          "minimum": -128,
          "maximum": 128
        },
        "memory": {
          "type": "integer",
          "format": "int32",
          "description": "内存大小,单位:MB。",
          "minimum": 0,
          "maximum": 8096
        },
        "disk": {
          "type": "integer",
          "format": "int32",
          "description": "系统存储大小,单位:GiB。",
          "minimum": 0,
          "maximum": 8096
        },
        "resolution": {
          "type": "string",
          "description": "分辨率,不超过16个字节。",
          "minLength": 0,
          "maxLength": 16
        },
        "extend_spec": {
          "type": "string",
          "description": "扩展描述,不超过512个字节。",
          "minLength": 0,
          "maxLength": 512
        },
        "spec_code": {
          "type": "string",
          "description": "规格名称,不超过64个字节。",
          "minLength": 0,
          "maxLength": 64
        },
        "phone_capacity": {
          "type": "integer",
          "format": "int32",
          "description": "当前云手机规格包含的云手机个数。",
          "minimum": 0,
          "maximum": 1024
        },
        "image_label": {
          "type": "string",
          "description": "镜像类型,只支持如下类型:\n- qemu_phone\n- cloud_phone\n- cloud_phone_1620\n- cloud_game\n- cloud_game_1620",
          "minLength": 0,
          "maxLength": 1024
        },
        "product_type": {
          "type": "integer",
          "format": "int32",
          "description": "产品类型。\n- 0:云手机\n- 1:云手游",
          "minimum": 0,
          "maximum": 1024
        },
        "phone_model_version": {
          "description": "规格版本:\n- 0:规格1.0\n- 1:规格2.0",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 65535
        },
        "dpi": {
          "description": "每英寸点数。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 65535
        },
        "fps": {
          "description": "渲染帧率。",
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "volume_mode": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 100,
          "description": "手机物理磁盘是否独立。\n- 0:不独立\n- 1:独立"
        },
        "render_fps": {
          "type": "integer",
          "format": "int32",
          "description": "渲染帧率。",
          "minimum": 0,
          "maximum": 256
        },
        "stream_fps": {
          "type": "integer",
          "format": "int32",
          "description": "出流帧率。",
          "minimum": 0,
          "maximum": 256
        }
      }
    },
    "ListCloudPhoneModelsResponseBody": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "minLength": 32,
          "maxLength": 32
        },
        "phone_models": {
          "items": {
            "$ref": "#/definitions/PhoneModel"
          },
          "description": "云手机的规格信息。",
          "type": "array",
          "minItems": 0,
          "maxItems": 8096
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目id。",
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 0,
      "maxLength": 8096
    },
    "phone_model_status": {
      "name": "status",
      "in": "query",
      "required": false,
      "description": "规格状态\n- 0:下线状态\n- 1:正常使用\n不传该参数表示查询所有状态的规格。",
      "type": "integer",
      "minimum": -128,
      "maximum": 128
    },
    "offset": {
      "name": "offset",
      "in": "query",
      "required": false,
      "description": "偏移量为一个大于等于0整数,表示查询该偏移量后面的所有的资源数,默认值为0。",
      "type": "integer",
      "minimum": 0,
      "maximum": 8096
    },
    "limit": {
      "name": "limit",
      "in": "query",
      "required": false,
      "description": "每页返回的资源个数。取值范围:1~100(默认值为100),一般设置为10、20、50。",
      "type": "integer",
      "minimum": 0,
      "maximum": 8096
    }
  },
