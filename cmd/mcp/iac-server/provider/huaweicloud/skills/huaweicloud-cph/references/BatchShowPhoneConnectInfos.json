              "type": "string",
              "description": "云手机服务器IPv6 IP",
              "minLength": 0,
              "maxLength": 1024
            },
            "access_port": {
              "type": "integer",
              "description": "云手机实例的访问端口",
              "minimum": 0,
              "maximum": 8096
