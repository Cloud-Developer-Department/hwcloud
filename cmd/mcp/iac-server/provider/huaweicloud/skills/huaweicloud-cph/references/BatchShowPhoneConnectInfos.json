            "1234567b8bab40ffb711234cb80d0234",
            "1234567b8bab40ffb711234cb8654321"
          ],
          "description": "phone_id数组,单次请求最大限制10",
          "minItems": 0,
          "maxItems": 10
        },
        "client_type": {
          "type": "string",
          "example": "ANDROID",
          "description": "申请接入的客户端类型\n- ANDROID: 安卓平台SDK\n- WINDOWS: Windows平台SDK\n- H5_MOBILE: H5移动端SDK\n- H5_PC: H5 PC端SDK\n- IOS: iOS平台SDK",
          "enum": [
            "ANDROID",
            "WINDOWS",
            "H5_MOBILE",
            "H5_PC",
            "IOS"
          ]
        }
      }
    }
