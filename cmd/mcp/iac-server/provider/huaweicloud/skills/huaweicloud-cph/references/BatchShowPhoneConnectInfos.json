              "type": "string",
              "description": "本次接入的会话ID",
              "minLength": 0,
              "maxLength": 1024
            },
            "timestamp": {
              "type": "string",
              "description": "时间戳",
              "minLength": 0,
              "maxLength": 1024
            },
            "ticket": {
              "type": "string",
              "description": "签名令牌",
              "minLength": 0,
              "maxLength": 1024
            }
          }
        }
      }
    },
    "ConnectionRequestBody": {
      "type": "object",
      "description": "获取云手机连接信息请求体",
      "required": [
