              "$ref": "#/definitions/CreateCloudPhoneSingleServerRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/CreateNet2CloudPhoneServerResponseBody"
            },
            "examples": {
              "application/json": {
                "request_id": "1564567b8bab40f34711234cb80d8574",
                "order_id": "CS1710111105S8IPB",
                "product_id": "00301-25217-0--0",
                "server_ids": [
                  "1234567b8bab40ffb711234cb80d0234",
                  "1678567b8bab40f93711234cb80d0764"
                ]
              }
            }
          }
