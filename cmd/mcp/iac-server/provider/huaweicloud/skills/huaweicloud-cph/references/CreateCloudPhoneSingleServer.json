  "definitions": {
    "NicForSingleServer": {
      "type": "object",
      "required": [
        "subnet_id"
      ],
      "properties": {
        "subnet_id": {
          "type": "string",
          "example": "f1cbfc37-eb42-4357-a0ec-9e4f11950908",
          "description": "租户自定义的子网 ID,为待创建的云手机裸服务器所属的子网。 需要指定vpc_id对应VPC下已创建的子网(subnet)的网络ID,UUID格式",
          "minLength": 0,
          "maxLength": 36
        },
        "ipv6_enable": {
          "type": "boolean",
          "example": true,
          "description": "是否支持ipv6,默认不支持ipv6。 false:不支持ipv6 true:支持ipv6"
        },
        "ipv6_band_width_id": {
          "type": "string",
          "example": "string",
          "description": "ipv6绑定的共享带宽ID。",
          "minLength": 0,
          "maxLength": 36
        }
      }
    },
    "CreateCloudPhoneSingleServerRequestBody": {
      "type": "object",
      "description": "创建云手机裸服务器请求体",
      "required": [
        "server_name",
        "server_model_name",
        "count",
        "order_param",
        "nics",
        "public_ip",
        "keypair_name"
      ],
      "properties": {
        "server_name": {
          "type": "string",
          "example": "cph-kertus-1110",
          "description": "云手机裸服务器名称,不超过60个字符,只支持英文字母、数字、汉字、下划线和中划线。批量购买会在云手机裸服务器名称后自动添加序号,比如设置此参数为server-1,那么创建的云手机裸服务器名称会自动按序增加数字后缀,比如为server-1-0001。",
          "minLength": 0,
          "maxLength": 64
        },
        "server_model_name": {
          "type": "string",
          "example": "physical.kg1.4xlarge.cp",
          "description": "云手机裸服务器规格名称。",
          "minLength": 0,
          "maxLength": 64
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "购买的云手机裸服务器个数,最多可购买10台。",
          "minimum": 0,
          "maximum": 1024
        },
        "order_param": {
          "description": "订单结构体。",
          "required": [
            "charging_mode",
            "period_type",
            "period_num"
          ],
          "properties": {
            "charging_mode": {
              "type": "integer",
              "format": "int32",
              "example": 0,
              "description": "计费类型。 0:包周期",
              "minimum": -128,
              "maximum": 128
            },
            "period_type": {
              "type": "integer",
              "format": "int32",
              "example": 2,
              "description": "订购周期类型。 2:月 3:年",
              "minimum": -128,
              "maximum": 128
            },
            "period_num": {
              "type": "integer",
              "format": "int32",
              "example": 1,
              "description": "订购周期数。 当订购周期为月时,取值范围[1, 9]。 当订购周期为年时,取值范围[1,10]。",
              "minimum": -128,
              "maximum": 128
            },
            "is_auto_pay": {
              "type": "integer",
              "format": "int32",
              "example": 0,
              "description": "是否自动付款。默认不自动付款。 0:不自动付款 1:自动付款",
              "minimum": -128,
              "maximum": 128
            },
            "is_auto_renew": {
              "type": "integer",
              "format": "int32",
              "example": 0,
              "description": "是否自动续订。默认不自动续订。 0:不自动续订 1:自动续订",
              "minimum": -128,
              "maximum": 128
            }
          }
        },
        "nics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NicForSingleServer"
          },
          "description": "租户自定义的网卡的结构体,为待创建的云手机裸服务器的网卡信息。",
          "minItems": 0,
          "maxItems": 8096
        },
        "public_ip": {
          "description": "租户自定义的弹性公网IP结构体。 配置云手机裸服务器的弹性IP信息的方式, 自动分配,需要指定新创建弹性IP的信息; 使用已有,需要指定已经购买的EIP ID。",
          "required": [
            "band_width"
          ],
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "string"
              ],
              "description": "指定已有的EIP进行云手机裸服务器创建,当前只支持传入一个已有的EIP ID。指定EIP后public_ip结构体中count字段和type字段不生效。",
              "minItems": 0,
              "maxItems": 8096
            },
            "type": {
              "type": "string",
              "example": "string",
              "description": "弹性公网IP的类型。 例如: 5_telcom:电信 5_union:联通 5_bgp:全动态BGP 5_sbgp:静态BGP",
              "minLength": 0,
              "maxLength": 1024
            },
            "count": {
              "type": "integer",
              "format": "int32",
              "example": 0,
              "description": "Eip数量。默认为0。取值范围为【0,1】",
              "minimum": 0,
              "maximum": 1
            },
            "band_width": {
              "description": "云手机裸服务器使用的带宽信息。",
              "required": [
                "band_width_charge_mode",
                "band_width_share_type"
              ],
              "properties": {
                "band_width_id": {
                  "type": "string",
                  "example": "string",
                  "description": "云手机服务器的带宽唯一标识,选共享带宽时必选。",
                  "minLength": 36,
                  "maxLength": 36
                },
                "band_width_size": {
                  "type": "integer",
                  "format": "int32",
                  "example": 0,
                  "description": "云手机服务器的带宽大小,选独享带宽时必选。",
                  "minimum": 0,
                  "maximum": 8096
                },
                "band_width_charge_mode": {
                  "type": "integer",
                  "format": "int32",
                  "example": 0,
                  "description": "云手机服务器带宽的计费方式。 0:bandwidth, 按带宽计费 1:traffic, 按流量计费",
                  "minimum": -128,
                  "maximum": 128
                },
                "band_width_share_type": {
                  "type": "integer",
                  "format": "int32",
                  "example": 0,
                  "description": "云手机服务器的带宽类型。 0:per,独享带宽 1:whole,共享带宽",
                  "minimum": -128,
                  "maximum": 128
                }
              }
            }
          }
        },
        "availability_zone": {
          "type": "string",
          "example": "string",
          "description": "待创建云手机裸服务器所在的可用区(AZ)的名称。如上海一可用区1为cn-east-3a。",
          "minLength": 0,
          "maxLength": 1024
        },
        "data_volume": {
          "description": "数据盘结构体。",
          "required": [
            "volume_type",
            "size"
          ],
          "properties": {
            "volume_type": {
              "type": "string",
              "example": "string",
              "description": "数据盘类型,只支持如下类型: SSD GPSSD",
              "minLength": 0,
              "maxLength": 36
            },
            "size": {
              "type": "integer",
              "format": "int32",
              "example": 0,
              "description": "数据盘大小,单位GiB,取值范围[1,32768]",
              "minimum": 0,
              "maximum": 32768
            },
            "count": {
              "type": "integer",
              "format": "int32",
              "example": 0,
              "description": "数据盘数量,默认值为1",
              "minimum": 0,
              "maximum": 1024
            }
          }
        },
        "keypair_name": {
          "type": "string",
          "example": "string",
          "description": "指定登录云手机裸服务器已有密钥的名称。",
          "minLength": 0,
          "maxLength": 64
        },
        "enterprise_project_id": {
          "type": "string",
          "example": "string",
          "description": "企业项目ID。 该字段不传(或传为字符串“0”),则将资源绑定给默认企业项目。",
          "minLength": 0,
          "maxLength": 36
        },
        "image_id": {
          "type": "string",
          "example": "string",
          "description": "云手机裸服务器镜像ID,不超过36个字节。未指定时使用默认云手机裸服务器镜像。",
          "minLength": 0,
          "maxLength": 36
        }
      }
    },
    "CreateNet2CloudPhoneServerResponseBody": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "minLength": 32,
          "maxLength": 32
        },
        "order_id": {
          "type": "string",
          "description": "订单ID,不超过64个字节。",
          "minLength": 0,
          "maxLength": 64
        },
        "product_id": {
          "type": "string",
          "description": "产品ID,不超过64个字节。",
          "minLength": 0,
          "maxLength": 64
        },
        "server_ids": {
          "type": "array",
          "description": "服务器ID列表。",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "minLength": 32,
            "maxLength": 32,
            "type": "string"
          }
        },
        "error_msg": {
          "type": "string",
          "description": "任务错误码说明。",
          "minLength": 0,
          "maxLength": 1024
        },
        "error_code": {
          "type": "string",
          "description": "任务错误码。",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目id。",
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 0,
      "maxLength": 8096
    }
  },
  "host": "cph.cn-east-2.myhuaweicloud.com",
  "base_path": null,
