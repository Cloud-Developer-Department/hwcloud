                  },
                  {
                    "phone_id": "1678567b8bab40f93711234cb80d0764",
                    "job_id": "1564567b8bab40f34711234cb80d5678",
                    "status": 2,
                    "error_code": "",
                    "error_msg": "",
                    "execute_msg": "xxxxx"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/RunSyncCommandResponseBody"
            }
          }
        },
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "name": "RunSyncCommandRequestBody",
            "in": "body",
            "required": true,
            "description": "同步命令请求体",
            "schema": {
              "$ref": "#/definitions/RunSyncCommandRequestBody"
            }
          }
        ],
        "tags": [
          "ADB命令"
        ],
        "summary": "同步执行adb命令",
        "description": "在云手机中同步执行命令并返回命令执行的输出信息,该接口仅支持adb shell命令的执行。1分钟内每个用户调用接口次数上限为6次,每个云手机允许执行命令超时时间为2秒,接口时间不超过30秒,执行云手机数越多,接口耗时相应越长。"
      }
    }
  },
  "definitions": {
    "RunSyncCommandResponseBody": {
      "type": "object",
      "description": "执行shell命令响应体。",
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "minLength": 32,
          "maxLength": 32
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RunSyncCommandJob"
          },
          "description": "任务列表。",
          "minItems": 0,
          "maxItems": 8096
        }
      }
    },
    "RunSyncCommandRequestBody": {
      "type": "object",
      "description": "执行shell命令请求体。",
      "required": [
        "command",
        "content"
      ],
      "properties": {
        "command": {
          "type": "string",
          "description": "ADB命令,固定填写shell。",
          "default": "shell",
          "minLength": 5,
          "maxLength": 5
        },
        "content": {
          "type": "string",
          "description": "待执行的命令。\n\n最大长度为1024字节,只支持大小写字母、数字、下划线(_)、点(.)、斜线(/)、冒号(:)、中划线(-)。",
          "example": "ls -l /system",
          "minLength": 0,
          "maxLength": 1024
        },
        "phone_ids": {
          "type": "array",
          "description": "云手机ID列表。\nserver_ids参数不存在时必选,同时存在只处理phone_ids。最多支持传入15个phone_id。",
          "items": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32
          },
          "minItems": 0,
          "maxItems": 8096
        },
        "server_ids": {
          "type": "array",
          "description": "云手机服务器ID列表。\nphone_ids参数不存在时必选,同时存在只处理phone_ids。",
          "items": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32
          },
          "minItems": 0,
          "maxItems": 8096
        }
      }
    },
    "RunSyncCommandJob": {
      "type": "object",
      "description": "执行异步shell命令任务。",
      "properties": {
        "phone_id": {
          "type": "string",
          "description": "云手机的唯一标识,云手机相关任务包含此字段。",
          "minLength": 32,
          "maxLength": 32
        },
        "job_id": {
          "type": "string",
          "description": "任务的唯一标识。",
          "minLength": 32,
          "maxLength": 32
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "任务状态\n- 2:成功\n- 1:运行中\n- -1:失败",
          "minimum": -128,
          "maximum": 128
        },
        "error_code": {
          "type": "string",
          "description": "任务错误码。",
          "minLength": 0,
          "maxLength": 1024
        },
        "error_msg": {
          "type": "string",
          "description": "任务错误码说明。",
          "minLength": 0,
          "maxLength": 1024
        },
        "execute_msg": {
          "type": "string",
          "description": "任务执行返回内容,最长1024字节。",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目id。",
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 0,
      "maxLength": 8096
    }
  },
  "host": "cph.cn-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}