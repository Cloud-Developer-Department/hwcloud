        "x-publishpath": "cph_api_0537",
        "x-hybridcloud": false,
        "x-request-examples-url-1": "POST https://{CPH Endpoint}/v1/{project_id}/cloud-phone/phones/sync-commands",
        "x-request-examples-description-1": "向手机列表中的手机同步执行shell命令,命令为ls -l /system",
        "x-request-examples-text-1": {
          "command": "shell",
