          },
          {
            "$ref": "#/parameters/server_id"
          },
          {
            "name": "ChangeCloudPhoneServerRequestBody",
            "in": "body",
            "required": true,
            "description": "切换的云手机服务器请求体",
            "schema": {
              "$ref": "#/definitions/ChangeCloudPhoneServerRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "request_id": "1564567b8bab40f34711234cb80d8574",
                "server_id": "1234567b8bab40ffb711234cb80d0234",
                "job_id": "3648acdc113a44d39a95f95bf3b8b01e"
              }
            },
            "schema": {
              "$ref": "#/definitions/ChangeCloudPhoneServerResponseBody"
            }
          }
        },
        "schemes": [
          "https"
        ],
        "tags": [
          "云手机服务器管理"
        ],
        "summary": "切换云手机服务器",
        "description": "切换云手机服务器, 支持您换一台新的云手机服务器。切换后服务器名称、服务器ID与原服务器相同, 服务器计费保持不变。服务器切换的同时服务器上的手机重新创建,不保留用户数据。切换需要额外的资源和资源配额。"
      }
    }
  },
  "definitions": {
    "Port": {
      "type": "object",
      "required": [
        "name",
        "listen_port",
        "internet_accessible"
      ],
      "description": "云手机启用的应用端口,云手机服务会做端口转发。",
      "properties": {
        "name": {
          "type": "string",
          "description": "应用端口名称,不超过16个字节,系统关键服务名称不能使用\"adb\"和\"vnc\"。",
          "minLength": 0,
          "maxLength": 16
        },
        "listen_port": {
          "type": "integer",
          "format": "int32",
          "description": "端口号,大于等于10000,小于等于50000。",
          "minimum": 10000,
          "maximum": 50000
        },
        "internet_accessible": {
          "type": "string",
          "description": "为\"true\"则映射出公网访问(忽略大小写)。\n为其他则不映射。",
          "example": "true",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "ChangeCloudPhoneServerResponseBody": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "minLength": 32,
          "maxLength": 32,
          "example": "423f0afc553148f991c24030e95c50cc"
        },
        "server_id": {
          "type": "string",
          "description": "服务器id。",
          "minLength": 0,
          "maxLength": 64,
          "example": "de0afaeca3044db3a8a4904b483f1099"
        },
        "job_id": {
          "type": "string",
          "description": "任务id。",
          "minLength": 0,
          "maxLength": 64,
          "example": "3648acdc113a44d39a95f95bf3b8b01e"
        },
        "error_msg": {
          "type": "string",
          "description": "任务错误码说明。",
          "minLength": 0,
          "maxLength": 1024
        },
        "error_code": {
          "type": "string",
          "description": "任务错误码。",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "Nic": {
      "type": "object",
      "required": [
        "subnet_id"
      ],
      "description": "租户自定义的网卡的结构体,为待创建的云服务器的网卡信息。",
      "properties": {
        "subnet_id": {
          "type": "string",
          "description": "租户自定义的子网 ID,为待创建的云服务器所属的子网。\n\n需要指定tenant_vpc_id对应VPC下已创建的子网(subnet)的网络ID,UUID格式。",
          "minLength": 0,
          "maxLength": 36,
          "example": "63d1b76c-eab0-45b0-904e-5d4c82259bfb"
        },
        "ipv6_enable": {
          "type": "boolean",
          "description": "是否支持ipv6。\n\n取值为true时,标识此网卡支持ipv6。",
          "example": true
        },
        "ipv6_bandwidth": {
          "properties": {
            "band_width_id": {
              "type": "string",
              "description": "ipv6绑定的共享带宽ID。",
              "minLength": 0,
              "maxLength": 36,
              "example": "388a04fb-c039-42d2-91e4-077444003e25"
            }
          },
          "required": [
            "band_width_id"
          ],
          "description": "绑定的共享带宽信息,详情请参见 ipv6_bandwidth数据结构说明。"
        }
      }
    },
    "ChangeCloudPhoneServerRequestBody": {
      "required": [
        "phone_model_name",
        "image_id",
        "tenant_vpc_id",
        "nics",
        "public_ip",
        "band_width"
      ],
      "properties": {
        "phone_model_name": {
          "type": "string",
          "example": "kg1.cp.c20.d64SSD.e1v1",
          "description": "云手机规格,不超过64个字节。",
          "minLength": 0,
          "maxLength": 64
        },
        "image_id": {
          "type": "string",
          "example": "20060220200717f201120a2300000e91",
          "description": "云手机镜像ID,不超过32个字节。",
          "minLength": 0,
          "maxLength": 64
        },
        "keypair_name": {
          "type": "string",
          "example": "keypair",
          "description": "密钥对名称,不超过64个字节,用于云手机ADB登录。",
          "minLength": 0,
          "maxLength": 64
        },
        "availability_zone": {
          "type": "string",
          "description": "云手机服务器所在的可用区,不填则维持原可用区不变。如上海一可用区1为cn-east-3a。",
          "minLength": 0,
          "maxLength": 1024
        },
        "ports": {
          "items": {
            "$ref": "#/definitions/Port"
          },
          "description": "云手机启用的应用端口,云手机服务会做端口转发。",
          "type": "array",
          "minItems": 0,
          "maxItems": 8096
        },
        "extend_param": {
          "description": "扩展字段。",
          "properties": {
            "enterprise_project_id": {
              "type": "string",
              "description": "企业项目ID。\n该字段不传(或传为字符串“0”),则将资源绑定给默认企业项目。",
              "minLength": 0,
              "maxLength": 36,
              "example": "0"
            }
          }
        },
        "tenant_vpc_id": {
          "type": "string",
          "example": "fca063f6-b942-42a8-9004-e5545f58d6a2",
          "description": "租户自定义的VPC ID,为待创建的云服务器所属的虚拟私有云(简称VPC),需要指定已创建VPC的ID,UUID格式。",
          "minLength": 36,
          "maxLength": 36
        },
        "nics": {
          "items": {
            "$ref": "#/definitions/Nic"
          },
          "description": "租户自定义的网卡的结构体,为待创建的云服务器的网卡信息。",
          "type": "array",
          "minItems": 0,
          "maxItems": 8096
        },
        "public_ip": {
          "description": "租户自定义的弹性公网IP结构体。\n\n配置云服务器的弹性IP信息的方式,\n\n自动分配,需要指定新创建弹性IP的信息;\n使用已有,需要指定已经购买的EIP ID。",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 64
              },
              "description": "指定已有的EIP进行服务器创建,当前只支持传入一个已有的EIP ID。",
              "minItems": 0,
              "maxItems": 8096
            },
            "eip": {
              "description": "配置服务器自动分配弹性IP时,创建弹性IP的配置参数,详情见 eip 结构体。",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "example": "5_bgp",
                  "description": "弹性公网IP的类型。\n- 5_telcom:电信\n- 5_union:联通\n- 5_bgp:全动态BGP\n- 5_sbgp:静态BGP",
                  "minLength": 0,
                  "maxLength": 1024
                }
              }
            },
            "count": {
              "description": "Eip数量。默认为1,不需要Eip可设置为0,取值范围为0到手机IP数。",
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "maximum": 65535,
              "example": 1
            }
          }
        },
        "phone_count_per_ip": {
          "description": "多少个手机共用一个vip。默认为手机开数,表示所有手机共享1个vip。取值范围:1到手机规格开数。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 65535,
          "example": 1
        },
        "phone_data_volume": {
          "description": "手机磁盘结构体,2.0规格必选。",
          "required": [
            "volume_type",
            "size"
          ],
          "properties": {
            "volume_type": {
              "type": "string",
              "description": "磁盘类型,只支持如下类型:\n- SSD\n- GPSSD",
              "minLength": 36,
              "maxLength": 36,
              "example": "GPSSD"
            },
            "size": {
              "type": "integer",
              "format": "int32",
              "description": "手机磁盘大小,单位GiB,取值范围[10,32768]。",
              "minimum": 10,
              "maximum": 32768,
              "example": 10
            }
          }
        },
        "server_share_data_volume": {
          "description": "共享存储磁盘结构体,2.0规格可选。注:rx7服务器+AOSP11镜像当前不支持共享应用。",
          "required": [
            "volume_type",
            "size"
          ],
          "properties": {
            "volume_type": {
              "type": "string",
              "description": "磁盘类型,只支持如下类型:\n  - SSD\n  - GPSSD",
              "minLength": 0,
              "maxLength": 36,
              "example": "GPSSD"
            },
            "size": {
              "type": "integer",
              "format": "int32",
              "description": "共享磁盘大小,单位GiB,取值范围[10,32768]。",
              "minimum": 10,
              "maximum": 32768,
              "example": 100
            }
          }
        },
        "band_width": {
          "description": "云手机使用的带宽信息。",
          "properties": {
            "band_width_id": {
              "type": "string",
              "description": "云手机服务器的带宽唯一标识,选共享带宽时必选。",
              "minLength": 36,
              "maxLength": 36,
              "example": "388a04fb-c039-42d2-91e4-077444003e25"
            },
            "band_width_size": {
              "type": "integer",
              "format": "int32",
              "description": "云手机服务器的带宽大小,选独享带宽时必选。",
              "minimum": 0,
              "maximum": 8096,
              "example": 100
            },
            "band_width_charge_mode": {
              "type": "integer",
              "format": "int32",
              "description": "云手机服务器带宽的计费方式。\n\n- 0:bandwidth, 按带宽计费\n\n- 1:traffic, 按流量计费",
              "minimum": -128,
              "maximum": 128,
              "example": 1
            },
            "band_width_share_type": {
              "type": "integer",
              "format": "int32",
              "description": "云手机服务器的带宽类型。\n\n- 0:per,独享带宽\n- 1:whole,共享带宽",
              "minimum": -128,
              "maximum": 128,
              "example": 0
            }
          },
          "required": [
            "band_width_charge_mode",
            "band_width_share_type"
          ]
        },
        "property": {
          "type": "string",
          "description": "云手机属性列表,为Json格式字符串。只可以预置有权限修改的属性。字符串长度[1,8192]。",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {
    "server_id": {
      "name": "server_id",
      "in": "path",
      "required": true,
      "description": "云手机服务器的唯一标识。",
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目id。",
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 0,
      "maxLength": 8096
    }
  },
  "host": "cph.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}