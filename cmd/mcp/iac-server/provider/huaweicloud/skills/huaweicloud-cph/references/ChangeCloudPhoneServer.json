{
  "name": "ChangeCloudPhoneServer",
  "summary": "切换云手机服务器",
  "tags": "云手机服务器管理",
  "productshort": "CPH",
  "region_id": "cn-east-3",
  "paths": {
    "/v2/{project_id}/cloud-phone/servers/{server_id}/change": {
