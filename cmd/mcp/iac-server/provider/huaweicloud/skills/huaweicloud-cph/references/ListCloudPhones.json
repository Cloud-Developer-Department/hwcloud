      "type": "integer",
      "minimum": 0,
      "maximum": 8096
    },
    "query_server_id": {
      "name": "server_id",
      "in": "query",
      "required": false,
      "description": "云手机服务器的唯一标识。",
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "phone_type": {
      "name": "type",
      "in": "query",
      "required": false,
      "description": "云手机类型。\n- 0:普通云手机",
      "type": "integer",
      "minimum": -128,
      "maximum": 128
