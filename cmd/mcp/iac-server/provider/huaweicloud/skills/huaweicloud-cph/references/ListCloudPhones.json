          "type": "array",
          "minItems": 0,
          "maxItems": 8096
        },
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "minLength": 32,
          "maxLength": 32
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "实例总数。",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "Phone": {
      "type": "object",
      "description": "云手机信息。",
      "properties": {
        "phone_name": {
          "type": "string",
          "description": "云手机的名称,不超过65个字符。",
          "minLength": 0,
          "maxLength": 65
        },
        "server_id": {
          "type": "string",
          "description": "云手机所在的服务器ID,不超过32个字节。",
          "minLength": 32,
          "maxLength": 32
