          "description": "云手机服务器所在的可用区。如上海一可用区1为cn-east-3a。",
          "minLength": 0,
          "maxLength": 1024
        },
        "metadata": {
          "description": "订单以及产品相关信息。",
          "properties": {
            "order_id": {
              "type": "string",
              "description": "订单ID,不超过64个字节。",
              "minLength": 0,
              "maxLength": 64
