          "minimum": -128,
          "maximum": 128
        },
        "type": {
          "type": "integer",
          "format": "int32",
          "description": "云手机类型。\n- 0:普通云手机\n- 1:试玩云手机",
          "minimum": -128,
          "maximum": 128
        },
        "imei": {
          "description": "imei码。",
          "type": "string",
          "example": "",
          "minLength": 0,
          "maxLength": 64
        },
        "traffic_type": {
          "description": "手机路由类型。\n- direct:默认路由\n- routing:路由到编码容器",
          "type": "string",
          "example": "",
