  "definitions": {
    "ListResourceInstancesRequestBody": {
      "type": "object",
      "description": "查询资源实例请求体。",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "description": "操作标识(仅限于filter,count):filter(过滤),count(查询总条数)。 为filter时表示分页查询,为count只需按照条件将总条数返回即可。",
          "enum": [
            "filter",
            "count"
          ]
        },
        "offset": {
          "type": "string",
          "description": "索引位置, 从offset指定的下一条数据开始查询。 查询第一页数据时,不需要传入此参数,查询后续页码数据时,将查询前一页数据时响应体中的值带入此参数。\n\naction为count时无此参数。\n\naction为filter时,默认为0,必须为数字,且不能为负数。",
          "minLength": 0,
          "maxLength": 32
        },
        "limit": {
          "type": "string",
          "description": "查询记录数。\n\naction为count时无此参数。\n\naction为filter时,默认为1000。limit最多为1000,不能为负数,最小值为1。",
          "minLength": 0,
          "maxLength": 32
        },
        "without_any_tag": {
          "type": "boolean",
          "description": "不包含任意一个标签,该字段为true时查询所有不带标签的资源。"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Tags"
          },
          "description": "最多包含10个key,每个key最多包含10个value,结构体不能缺失。key不能为空或者空字符串。key不能重复,同一个key中value不能重复,不同key对应的资源之间为与的关系。",
          "minItems": 0,
          "maxItems": 10
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Match"
          },
          "description": "搜索字段。\n\nkey为要匹配的字段,当前只支持resource_name。\n\nvalue为匹配的值,当前为精确匹配。",
          "minItems": 0,
          "maxItems": 2
        }
      }
    },
    "Tag": {
      "properties": {
        "key": {
          "type": "string",
          "description": "键。\n\n- 最大长度127个unicode字符。         \n- 不能为空,可以包含任意语种字母、数字、空格和_.:=+-@,不能以_sys_开头。",
          "minLength": 0,
          "maxLength": 127
        },
        "value": {
          "type": "string",
          "description": "值列表。\n\n- 每个值最大长度255个unicode字符。\n- 不能为空,可以包含任意语种字母、数字、空格和_.:=+-@,但首尾不能含有空格。",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object",
      "description": "资源标签。"
    },
    "Tags": {
      "properties": {
        "key": {
          "type": "string",
          "description": "键。\n\n- 最大长度127个unicode字符。\n\n- key不能为空。",
          "minLength": 0,
          "maxLength": 128
        },
        "values": {
          "type": "array",
          "description": "值列表。\n\n- 最多10个value。\n\n- value不允许重复。\n\n- 每个值最大长度255个unicode字符。\n\n- 如果values为空则表示any_value。\n\n- value之间为或的关系。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 255
          },
          "minItems": 0,
          "maxItems": 10
        }
      },
      "required": [
        "key",
        "values"
      ],
      "type": "object",
      "description": "资源标签列表。"
    },
    "Match": {
      "properties": {
        "key": {
          "type": "string",
          "description": "键。\n\n当前key的参数值只能取“resource_name”,此时value的参数值为资源名称。",
          "enum": [
            "resource_name"
          ]
        },
        "value": {
          "type": "string",
          "description": "值。\n\n当前key的参数值只能取“resource_name”,此时value的参数值为资源名称。",
          "minLength": 0,
          "maxLength": 128
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object",
      "description": "搜索字段。"
