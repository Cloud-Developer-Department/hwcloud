          "type": "string",
          "example": "physical.rx1.xlarge.special",
          "description": "目标云手机服务器规格,不超过64个字节。仅允许相同代系服务器之间的规格切换。",
          "minLength": 0,
          "maxLength": 64
        },
        "phone_model_name": {
          "type": "string",
          "description": "目标云手机规格。要求与变更前云手机规格路数相同,与目标云手机服务器规格匹配。",
          "minLength": 0,
          "maxLength": 128,
          "example": "rx1.cp.sp.c105.d8.e5v5"
