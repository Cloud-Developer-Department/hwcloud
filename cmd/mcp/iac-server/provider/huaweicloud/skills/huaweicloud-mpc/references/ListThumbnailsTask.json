{
  "name": "ListThumbnailsTask",
  "summary": "查询截图任务",
  "tags": "抽帧截图接口",
  "productshort": "MPC",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/{project_id}/thumbnails": {
      "get": {
        "x-navigation-title": "抽帧截图接口",
        "description": "查询截图任务状态。返回任务执行结果,包括状态、输入、输出等信息。",
        "summary": "查询截图任务",
        "x-publishpath": "mpc_04_0036",
        "operationId": "ListThumbnailsTask",
        "x-open-region-cloud": "hcso,hc,hk,g42",
        "x-external-api": true,
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-since": "1.0.0",
        "x-since-memo": "1.0.0 initial",
        "x-modifier-memo": "版本 | 修改日期 | 修改说明 | 修改者\n------------ | ------------- | ------------- | -------------\n1.0.0 | 2018/3/28 |新增此接口。 | 吴晓瑜\n",
        "tags": [
          "ThumbnailsTask"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/authorization"
          },
          {
            "$ref": "#/parameters/xProjectId"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "$ref": "#/parameters/xLanguage"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](mpc_04_0064.xml)",
            "required": true,
            "minLength": 0,
            "maxLength": 64
          },
          {
            "in": "query",
            "name": "task_id",
            "type": "array",
            "minItems": 0,
            "maxItems": 10,
            "collectionFormat": "multi",
            "items": {
              "type": "string"
            },
            "required": false,
            "description": "截图服务接受任务后产生的任务ID。一次最多10个"
          },
          {
            "in": "query",
            "name": "status",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": false,
            "enum": [
              "WAITING",
              "PROCESSING",
              "SUCCEEDED",
              "FAILED",
              "CANCELED"
            ],
            "description": "任务状态。\n\n取值如下:\n- WAITING: 等待启动\n- PROCESSING:截图中\n- SUCCEEDED:截图成功\n- FAILED:截图失败\n- CANCELED:已删除"
          },
          {
            "in": "query",
            "name": "start_time",
            "description": "起始时间。格式为yyyymmddhhmmss。必须是与时区无关的UTC时间,指定task_id时该参数无效",
            "type": "string",
            "minLength": 0,
            "maxLength": 32,
            "required": false
          },
          {
            "in": "query",
            "name": "end_time",
            "description": "结束时间。格式为yyyymmddhhmmss。必须是与时区无关的UTC时间,指定task_id时该参数无效",
            "type": "string",
            "minLength": 0,
            "maxLength": 32,
            "required": false
          },
          {
            "in": "query",
            "name": "page",
            "description": "分页编号。查询指定“task_id”时,该参数无效。\n\n默认值:0。",
            "type": "integer",
            "minimum": 0,
            "maximum": 50000,
            "format": "int32",
            "default": 0,
            "required": false
          },
          {
            "in": "query",
            "name": "size",
            "description": "每页记录数。查询指定“task_id”时,该参数无效。\n\n取值范围:[1,100]。\n\n默认值:10。",
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "format": "int32",
            "default": 10,
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "查询截图任务成功。",
            "schema": {
              "$ref": "#/definitions/QueryThumbnailsTaskRsp"
            },
            "examples": {
              "application/json": {
                "task_array": [
                  {
                    "task_id": 7684,
                    "status": "SUCCEEDED",
                    "create_time": 20201118121333,
                    "end_time": 20201118121336,
                    "input": {
                      "bucket": "obs-apitest-01",
                      "location": "cn-north-5",
                      "object": "ts/22.ts"
                    },
                    "output": {
                      "bucket": "obs-apitest-01",
                      "location": "cn-north-5",
                      "object": "out_gamma/thumbnails/query_02"
                    },
                    "thumbnail_info": [
                      {
                        "pic_name": "9.jpg"
                      },
                      {
                        "pic_name": "5.jpg"
                      }
                    ]
                  }
                ],
                "is_truncated": 0,
                "total": 1
              }
            }
          },
          "400": {
            "description": "查询截图任务失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "MPC.10212",
                "error_msg": "Operation failed."
              }
            }
          }
        },
        "x-request-examples-1": "GET https://{endpoint}/v1/{project_id}/thumbnails?task_id=7684\n",
        "x-response-example": "{\n   \"task_array\": [\n     {\n       \"task_id\": 2528,\n       \"status\": \"SUCCEEDED\",\n       \"create_time\": \"20181017022607\",\n       \"end_time\": \"20181017022628\",\n       \"input\": {\n         \"bucket\": \"example-bucket\",\n         \"location\": \"region1\",\n         \"object\": \"VOD/input/sample.MP4\"\n       },\n       \"output\": {\n         \"bucket\": \"example-bucket\",\n         \"location\": \"region1\",\n         \"object\": \"VOD/input/\"\n       },\n       \"thumbnail_info\": [\n        {\n           \"pic_name\": \"44.jpg\"\n        },\n         ......\n       ]\n     }\n    ......\n   ],\n   \"is_truncated\": 0,\n   \"total\": 1\n}\n"
      }
    }
  },
  "definitions": {
    "PicInfo": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "pic_name": {
          "description": "截图文件名。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "QueryThumbnailsTaskRsp": {
      "type": "object",
      "properties": {
        "task_array": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50000,
          "description": "截图任务组",
          "items": {
            "$ref": "#/definitions/ThumbTask"
          }
        },
        "is_truncated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "description": "查询结果是否被截取。\n- 1代表被截取,即还有结果未被返回,可以通过设置page和size参数继续查询。\n- 0代表未被截取,即所有结果已被返回。"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "查询结果的数量。"
        }
      }
    },
    "ObsObjInfo": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "required": [
        "bucket",
        "location",
        "object"
      ],
      "properties": {
        "bucket": {
          "description": "OBS的bucket名称。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "location": {
          "description": "OBS桶所在的区域,且必须与使用的MPC区域保持一致。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "object": {
          "description": "OBS对象路径,遵守OSS Object定义。\n\n- 当用于指示input时,需要指定到具体对象。\n- 当用于指示output时, 只需指定到转码结果期望存放的路径。",
          "type": "string",
          "minLength": 0,
          "maxLength": 2147483647
        },
        "file_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2147483647,
          "description": "文件名,仅用于转封装指定输出名称。\n\n- 当指定了此参数时,输出的对象名为object/file_name 。\n- 当不指定此参数时,输出的对象名为object/xxx,其中xxx由MPC指定。"
        }
      }
    },
    "ThumbTask": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "description": "任务ID。\n\n截图服务接受任务后产生的任务ID。一次最多10个。"
        },
        "status": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "任务状态",
          "enum": [
            "NO_TASK",
            "WAITING",
            "PROCESSING",
            "SUCCEEDED",
            "FAILED",
            "CANCELED"
          ]
        },
        "create_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "起始时间。\n\n格式为yyyymmddhhmmss。必须是与时区无关的UTC时间,指定task_id时该参数无效。"
        },
        "end_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "结束时间。\n\n格式为yyyymmddhhmmss。必须是与时区无关的UTC时间,指定task_id时该参数无效。"
        },
        "input": {
          "description": "输入存储位置。",
          "$ref": "#/definitions/ObsObjInfo"
        },
        "output": {
          "description": "输出存储位置。",
          "$ref": "#/definitions/ObsObjInfo"
        },
        "output_file_name": {
          "description": "输出文件名。",
          "type": "string",
          "minLength": 0,
          "maxLength": 2147483647,
          "x-inner-field": true
        },
        "user_data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65535,
          "description": "用户数据。"
        },
        "description": {
          "description": "任务描述。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "x-inner-field": true
        },
        "thumbnail_info": {
          "description": "截图文件信息。",
          "type": "array",
          "minItems": 0,
          "maxItems": 50000,
          "items": {
            "$ref": "#/definitions/PicInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xProjectId": {
      "name": "X-Project_Id",
