            "required": false,
            "description": "转码服务接受任务后产生的任务ID。一次最多10个"
          },
          {
            "in": "query",
            "name": "status",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": false,
            "description": "任务执行状态。\n\n取值如下:\n- WAITING:等待启动\n- TRANSCODING:转码中\n- SUCCEEDED:转码成功\n- FAILED:转码失败\n- CANCELED:已删除\n- NEED_TO_BE_AUDIT:片源待审核"
          },
          {
            "in": "query",
            "name": "start_time",
