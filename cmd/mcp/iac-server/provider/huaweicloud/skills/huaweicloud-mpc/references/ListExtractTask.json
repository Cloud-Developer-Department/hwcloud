{
  "name": "ListExtractTask",
  "summary": "查询视频解析任务",
  "tags": "视频解析接口",
  "productshort": "MPC",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/{project_id}/extract-metadata": {
      "get": {
        "x-navigation-title": "视频解析接口",
        "description": "查询解析任务的状态和结果。",
        "summary": "查询视频解析任务",
        "x-publishpath": "mpc_04_0062",
        "operationId": "ListExtractTask",
        "x-open-region-cloud": "hc,hk,g42",
        "x-external-api": true,
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-since": "1.0.0",
        "x-since-memo": "1.0.0 initial",
        "x-modifier-memo": "版本 | 修改日期 | 修改说明 | 修改者\n------------ | ------------- | ------------- | -------------\n1.0.0 | 2019/07/02 |新增此接口。 | 欧斯航\n",
        "tags": [
          "ExtractTaskManager"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/authorization"
          },
          {
            "$ref": "#/parameters/xProjectId"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "$ref": "#/parameters/xLanguage"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](mpc_04_0064.xml)",
            "required": true,
            "minLength": 0,
            "maxLength": 64
          },
          {
            "in": "query",
            "name": "task_id",
            "type": "array",
            "minItems": 0,
            "maxItems": 10,
            "collectionFormat": "multi",
            "items": {
              "type": "string"
            },
            "required": false,
            "description": "任务ID。一次最多10个"
          },
          {
            "in": "query",
            "name": "status",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "enum": [
              "INIT",
              "WAITING",
              "PREPROCESSING",
              "SUCCEED",
              "FAILED",
              "CANCELED"
            ],
            "required": false,
            "description": "任务执行状态。\n\n取值如下:\n- INIT:初始状态\n- WAITING:等待启动\n- PREPROCESSING:处理中\n- SUCCEED:处理成功\n- FAILED:处理失败\n- CANCELED:已取消"
          },
          {
            "in": "query",
            "name": "start_time",
            "type": "string",
            "minLength": 0,
            "maxLength": 32,
            "required": false,
            "description": "起始时间。格式为yyyymmddhhmmss。必须是与时区无关的UTC时间,指定task_id时该参数无效。"
          },
          {
            "in": "query",
            "name": "end_time",
            "type": "string",
            "minLength": 0,
            "maxLength": 32,
            "required": false,
            "description": "结束时间。格式为yyyymmddhhmmss。必须是与时区无关的UTC时间,指定task_id时该参数无效。"
          },
          {
            "in": "query",
            "name": "page",
            "type": "integer",
            "maximum": 50000,
            "required": false,
            "default": 0,
            "minimum": 0,
            "description": "分页编号。查询指定“task_id”时,该参数无效。\n\n默认值:0。"
          },
          {
            "in": "query",
            "name": "size",
            "description": "每页记录数。查询指定“task_id”时,该参数无效。\n\n取值范围:[1,100]。\n\n默认值:10。",
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "查询视频解析任务成功。",
            "schema": {
              "$ref": "#/definitions/QueryExtractTaskRsp"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "tasks": [
                  {
                    "task_id": 7967,
                    "status": "SUCCEED",
                    "create_time": 20201119103821,
                    "start_time": 20201119103822,
                    "end_time": 20201119103827,
                    "description": "The task has completed.",
                    "input": {
                      "bucket": "obs-apitest-01",
                      "location": "cn-north-5",
                      "object": "mp4/4k.mp4"
                    },
                    "output": {
                      "bucket": "obs-apitest-01",
                      "location": "cn-north-5",
                      "object": "out_gamma/extract/",
                      "file_name": "video_001.txt"
                    },
                    "metadata": {
                      "size": 43231240,
                      "duration_ms": 60.186,
                      "duration": 60,
                      "format": "MP4",
                      "bitrate": 5605,
                      "video": [
                        {
                          "width": 3824,
                          "height": 2152,
                          "bitrate": 5481,
                          "bitrate_bps": 5613152,
                          "frame_rate": 23,
                          "codec": "H.265"
                        }
                      ],
                      "audio": [
                        {
                          "codec": "AAC",
                          "sample": 48000,
                          "channels": 2,
                          "bitrate": 124,
                          "bitrate_bps": 127992
                        }
                      ]
                    }
                  }
                ]
              }
            }
          },
          "400": {
            "description": "查询视频解析任务失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "MPC.10202",
                "error_msg": "Invalid request parameter."
              }
            }
          }
        },
        "x-request-examples-1": "GET https://{endpoint}/v1/{project_id}/extract-metadata?task_id=7967\n",
        "x-response-example": "{\n    \"total\": 1,\n    \"tasks\": [\n        {\n            \"task_id\": \"471367\",\n            \"status\": \"SUCCEED\",\n            \"create_time\": \"20200608101432\",\n            \"start_time\": \"20200608101432\",\n            \"end_time\": \"20200608101437\",\n            \"description\": \"Task done successfully\",\n            \"input\": {\n                \"bucket\": \"lihaiou-01-region1\",\n                \"location\": \"region1\",\n                \"object\": \"input/d349ee9b7b7904a4c411b571021f881c.mp4\",\n                \"file_name\": null\n            },\n            \"output\": {\n                \"bucket\": \"lihaiou-01-region1\",\n                \"location\": \"region1\",\n                \"object\": \"yzp/0666/test/output.m3u8/\",\n                \"file_name\": \"40cf104dbbf45181fcd7bb56f54058ba.txt\"\n            },\n            \"metadata\": {\n                \"size\": 821407522,\n                \"duration\": 1428,\n                \"format\": \"MP4\",\n                \"bitrate\": 4590726,\n                \"video\": [\n                    {\n                        \"width\": 1280,\n                        \"height\": 720,\n                        \"bitrate\": 4460614,\n                        \"frame_rate\": 30,\n                        \"codec\": \"H.264\"\n                    }\n                ],\n                \"audio\": [\n                    {\n                        \"codec\": \"AAC\",\n                        \"sample\": 44100,\n                        \"channels\": 2,\n                        \"bitrate\": 130112\n                    }\n                ]\n            }\n        }\n    ]\n}\n"
      }
    }
  },
  "definitions": {
    "ExtractTask": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "allOf": [
        {
          "$ref": "#/definitions/CommonTask"
        },
        {
          "type": "object",
          "properties": {
            "metadata": {
              "$ref": "#/definitions/MetaData",
              "description": "输出参数"
            }
          }
        }
      ]
    },
    "QueryExtractTaskRsp": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "allOf": [
        {
          "$ref": "#/definitions/CommonQueryTaskRsp"
        },
        {
          "type": "object",
          "properties": {
            "tasks": {
              "type": "array",
              "minItems": 0,
              "maxItems": 50000,
              "description": "任务列表",
              "items": {
                "$ref": "#/definitions/ExtractTask"
              }
            }
          }
        }
      ]
    },
    "CommonQueryTaskRsp": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "任务总数"
        }
      }
    },
    "CommonTaskMeta": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "任务ID"
        },
        "status": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "任务状态。\n\n取值如下:\n- INIT:初始状态。\n- WAITING:等待启动。\n- PROCESSING:处理中。\n- SUCCEED:处理成功。\n- FAILED:处理失败。\n- CANCELED:已取消。"
        },
        "create_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "任务创建时间"
        },
        "start_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "任务启动时间"
        },
        "end_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "任务结束时间"
        },
        "error_code": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "description": "任务的返回码。"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "错误描述"
        },
        "user_data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65535,
          "description": "用户数据。"
        }
      }
    },
    "CommonTask": {
      "allOf": [
        {
          "$ref": "#/definitions/CommonTaskMeta"
        },
        {
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/definitions/ObsObjInfo",
              "description": "源文件信息"
            },
            "output": {
              "$ref": "#/definitions/ObsObjInfo",
              "description": "输出文件信息"
            }
          }
        }
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "VideoInfo": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "视频宽度"
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "视频高度"
        },
        "bitrate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "视频码率,单位: kbit/s"
        },
        "bitrate_bps": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "视频码率,单位: bit/s"
        },
        "frame_rate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "帧率。\n\n  取值范围:0或[5,60],0表示自适应。\n\n  单位:帧每秒。\n\n  > 若设置的帧率不在取值范围内,则自动调整为0,若设置的帧率高于片源帧率,则自动调整为片源帧率。"
        },
        "codec": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "视频编码格式"
        },
        "duration": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "视频流时长,单位:秒"
        },
        "duration_ms": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "视频流时长,单位:毫秒"
        },
        "rotate": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "format": "float",
          "description": "视频拍摄时的选择角度,单位:度。"
        }
      }
    },
    "AudioInfo": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "codec": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "音频编码格式"
        },
        "sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "音频采样率"
        },
        "channels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "音频信道"
        },
        "bitrate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "音频码率,单位: kbit/s"
        },
        "bitrate_bps": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "音频码率,单位: bit/s"
        },
        "duration": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "音频流时长,单位:秒"
        },
        "duration_ms": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "音频流时长,单位:毫秒"
        }
      }
    },
    "ObsObjInfo": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "required": [
        "bucket",
        "location",
        "object"
      ],
      "properties": {
        "bucket": {
          "description": "OBS的bucket名称。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "location": {
          "description": "OBS桶所在的区域,且必须与使用的MPC区域保持一致。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "object": {
          "description": "OBS对象路径,遵守OSS Object定义。\n\n- 当用于指示input时,需要指定到具体对象。\n- 当用于指示output时, 只需指定到转码结果期望存放的路径。",
          "type": "string",
          "minLength": 0,
          "maxLength": 2147483647
        },
        "file_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2147483647,
          "description": "文件名,仅用于转封装指定输出名称。\n\n- 当指定了此参数时,输出的对象名为object/file_name 。\n- 当不指定此参数时,输出的对象名为object/xxx,其中xxx由MPC指定。"
        }
      }
    },
    "MetaData": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "format": "int64",
          "description": "文件大小。"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647,
          "format": "double",
          "description": "视频时长,带小数位显示。单位:秒。"
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "format": "int64",
          "description": "视频时长。单位:秒。"
        },
        "format": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "description": "文件封装格式。"
        },
        "md5": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "视频的 md5 值。"
        },
        "bitrate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "format": "int64",
          "description": "总码率。单位:bit/秒"
        },
        "video": {
          "description": "视频流元数据。",
          "type": "array",
          "minItems": 0,
          "maxItems": 50000,
          "items": {
            "$ref": "#/definitions/VideoInfo"
          }
