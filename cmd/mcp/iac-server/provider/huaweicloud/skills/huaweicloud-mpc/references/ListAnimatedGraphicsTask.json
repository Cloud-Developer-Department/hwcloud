{
  "name": "ListAnimatedGraphicsTask",
  "summary": "查询转动图任务",
  "tags": "转动图接口",
  "productshort": "MPC",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/{project_id}/animated-graphics": {
      "get": {
        "x-navigation-title": "转动图接口",
        "description": "查询动图任务的状态。",
        "summary": "查询转动图任务",
        "x-publishpath": "mpc_04_0058",
        "operationId": "ListAnimatedGraphicsTask",
        "x-open-region-cloud": "hc,hk,g42",
        "x-external-api": true,
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-since": "1.0.0",
        "x-since-memo": "1.0.0 initial",
        "x-modifier-memo": "版本 | 修改日期 | 修改说明 | 修改者\n------------ | ------------- | ------------- | -------------\n1.0.0 | 2018/10/20 |新增此接口。 | 欧斯航\n",
        "tags": [
          "AnimatedGraphicsTaskManager"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/authorization"
          },
          {
            "$ref": "#/parameters/xProjectId"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "$ref": "#/parameters/xLanguage"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](mpc_04_0064.xml)",
            "required": true,
            "minLength": 0,
            "maxLength": 64
          },
          {
            "in": "query",
            "name": "task_id",
            "type": "array",
            "minItems": 0,
            "maxItems": 10,
            "collectionFormat": "multi",
            "items": {
              "type": "string"
            },
            "required": false,
            "description": "任务ID。一次最多10个"
          },
          {
            "in": "query",
            "name": "status",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "enum": [
              "INIT",
              "WAITING",
              "PREPROCESSING",
              "SUCCEED",
              "FAILED",
              "CANCELED"
            ],
            "required": false,
            "description": "任务执行状态。\n\n取值如下:\n- INIT:初始状态\n- WAITING:待启动\n- PREPROCESSING:处理中\n- SUCCEED:处理成功\n- FAILED:处理失败\n- CANCELED:已取消"
          },
          {
            "in": "query",
            "name": "start_time",
            "type": "string",
            "minLength": 0,
            "maxLength": 32,
            "required": false,
            "description": "起始时间。格式为yyyymmddhhmmss。必须是与时区无关的UTC时间,指定task_id时该参数无效。"
          },
          {
            "in": "query",
            "name": "end_time",
            "type": "string",
            "minLength": 0,
            "maxLength": 32,
            "required": false,
            "description": "结束时间。格式为yyyymmddhhmmss。必须是与时区无关的UTC时间,指定task_id时该参数无效。"
          },
          {
            "in": "query",
            "name": "page",
            "type": "integer",
            "maximum": 50000,
            "required": false,
            "default": 0,
            "minimum": 0,
            "description": "分页编号。查询指定“task_id”时,该参数无效。\n\n默认值:0。"
          },
          {
            "in": "query",
            "name": "size",
            "description": "每页记录数。查询指定“task_id”时,该参数无效。\n\n取值范围:[1,100]。\n\n默认值:10。",
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "查询动图任务成功。",
            "schema": {
              "$ref": "#/definitions/QueryAnimatedGraphicsTaskRsp"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "tasks": [
                  {
                    "task_id": 30647,
                    "status": "SUCCEED",
                    "create_time": 20201119103652,
                    "start_time": 20201119103653,
                    "end_time": 20201119103708,
                    "description": "The task has completed.",
                    "input": {
                      "bucket": "obs-apitest-01",
                      "location": "cn-north-5",
                      "object": "mp4/4k.mp4"
                    },
                    "output": {
                      "bucket": "obs-apitest-01",
                      "location": "cn-north-5",
                      "object": "out_gamma/gif_file/",
                      "file_name": "file_001.gif"
                    },
                    "output_param": {
                      "format": "gif",
                      "width": 100,
                      "height": 50,
                      "start": 0,
                      "end": 10000,
                      "frame_rate": 15
                    }
                  }
                ]
              }
            }
          },
          "400": {
            "description": "查询动图任务失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "MPC.10202",
                "error_msg": "Invalid request parameter."
              }
            }
          }
        },
        "x-request-examples-1": "GET https://{endpoint}/v1/{project_id}/animated-graphics?task_id=30647\n",
        "x-response-example": "{\n    \"total\" : 1,\n    \"tasks\" : [{\n            \"task_id\" : \"30647\",\n            \"status\" : \"WAITING\",\n            \"create_time\" : \"20200611125107\",\n            \"description\" : \"Try to start.\",\n            \"input\" : {\n                \"bucket\" : \"vostest\",\n                \"location\" : \"region1\",\n                \"object\" : \"vos_video/MediaCloudPubVideo.mp4\",\n                \"file_name\" : \"\"\n            },\n            \"output\" : {\n                \"bucket\" : \"vostest\",\n                \"location\" : \"region1\",\n                \"object\" : \"sswoutput/BTbjJ/\",\n                \"file_name\" : \"b3714d036446818c701f04d7dec12a43.gif\"\n            },\n            \"output_param\" : {\n                \"format\" : \"gif\",\n                \"width\" : 480,\n                \"height\" : 270,\n                \"start\" : 5,\n                \"end\" : 15,\n                \"frame_rate\" : 15\n            }\n        }\n    ]\n}\n"
      }
    }
  },
  "definitions": {
    "CommonQueryTaskRsp": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "任务总数"
        }
      }
    },
    "CommonTaskMeta": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "任务ID"
        },
        "status": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "任务状态。\n\n取值如下:\n- INIT:初始状态。\n- WAITING:等待启动。\n- PROCESSING:处理中。\n- SUCCEED:处理成功。\n- FAILED:处理失败。\n- CANCELED:已取消。"
        },
        "create_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "任务创建时间"
        },
        "start_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "任务启动时间"
        },
        "end_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "任务结束时间"
        },
        "error_code": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "description": "任务的返回码。"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "错误描述"
        },
        "user_data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65535,
          "description": "用户数据。"
        }
      }
    },
    "CommonTask": {
      "allOf": [
        {
          "$ref": "#/definitions/CommonTaskMeta"
        },
        {
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/definitions/ObsObjInfo",
              "description": "源文件信息"
            },
            "output": {
              "$ref": "#/definitions/ObsObjInfo",
              "description": "输出文件信息"
            }
          }
        }
      ]
    },
    "AnimatedGraphicsOutputParam": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "x-imports": "org.hibernate.validator.constraints.*;com.fasterxml.jackson.annotation.JsonInclude;",
      "type": "object",
      "required": [
        "width",
        "height",
        "start",
        "end",
        "format"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "description": "动图格式,目前仅支持取值 gif",
          "enum": [
            "gif"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": -1,
          "maximum": 3840,
          "format": "int32",
          "description": "输出动图的宽。\n\n取值范围:0,-1或[32,3840]之间2的倍数。\n\n>- 若设置为-1, 则宽根据高来自适应,此时“height”不能取-1或0。\n>- 若设置为0,则取原始视频的宽,此时“height”只能取0。"
        },
        "height": {
          "type": "integer",
          "minimum": -1,
          "maximum": 2160,
          "format": "int32",
          "description": "输出动图的高。\n\n取值范围:0,-1或[32,2160]之间2的倍数。\n\n>- 若设置为-1, 则高根据宽来自适应,此时“width”不能取-1或0。\n>- 若设置为0,则取原始视频的高,此时“width”只能取0。"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "format": "int32",
          "description": "起始时间,单位:毫秒"
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "format": "int32",
          "description": "结束时间。\n\n单位:毫秒。\n\nend、start差值最多60秒。"
        },
        "frame_rate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 76,
          "format": "int32",
          "default": 15,
          "description": "动图帧率。\n\n取值范围:[1,75]"
        }
      }
    },
    "AnimatedGraphicsTask": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "allOf": [
        {
          "$ref": "#/definitions/CommonTask"
        },
        {
          "type": "object",
          "properties": {
            "output_param": {
              "$ref": "#/definitions/AnimatedGraphicsOutputParam",
              "description": "动图输出参数。"
            }
          }
        }
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "QueryAnimatedGraphicsTaskRsp": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "allOf": [
        {
          "$ref": "#/definitions/CommonQueryTaskRsp"
        },
        {
          "type": "object",
          "properties": {
            "tasks": {
              "type": "array",
              "minItems": 0,
              "maxItems": 50000,
              "description": "任务列表",
              "items": {
                "$ref": "#/definitions/AnimatedGraphicsTask"
              }
            }
          }
        }
      ]
    },
    "ObsObjInfo": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "required": [
        "bucket",
        "location",
        "object"
      ],
      "properties": {
        "bucket": {
          "description": "OBS的bucket名称。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "location": {
          "description": "OBS桶所在的区域,且必须与使用的MPC区域保持一致。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "object": {
          "description": "OBS对象路径,遵守OSS Object定义。\n\n- 当用于指示input时,需要指定到具体对象。\n- 当用于指示output时, 只需指定到转码结果期望存放的路径。",
          "type": "string",
          "minLength": 0,
          "maxLength": 2147483647
        },
        "file_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2147483647,
          "description": "文件名,仅用于转封装指定输出名称。\n\n- 当指定了此参数时,输出的对象名为object/file_name 。\n- 当不指定此参数时,输出的对象名为object/xxx,其中xxx由MPC指定。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xProjectId": {
      "name": "X-Project_Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息, 与路径参数中的项目ID相同。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    },
    "authorization": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xLanguage": {
      "name": "x-language",
      "in": "header",
      "description": "客户端语言",
      "required": false,
      "type": "string",
      "x-hcso": "N",
      "x-hc": "N",
      "x-hk": "N",
      "x-apiexplorer-hide": "Y",
      "x-support-sdk": "Y",
      "x-is-registered": "Y"
    }
  },
  "host": "mpc.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
