{
  "name": "UpdateTemplateGroup",
  "summary": "更新转码模板组",
  "tags": "自定义转码模板组接口",
  "productshort": "MPC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/template_group/transcodings": {
      "put": {
        "x-navigation-title": "自定义转码模板组接口",
        "description": "修改模板组接口。",
        "summary": "更新转码模板组",
        "x-publishpath": "mpc_04_0074",
        "operationId": "UpdateTemplateGroup",
        "x-open-region-cloud": "hcso,hc,hk,g42",
        "x-external-api": true,
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-since": "1.0.0",
        "x-since-memo": "1.0.0 initial",
        "x-modifier-memo": "版本 | 修改日期 | 修改说明 |\n------------ | ------------- | ------------- |\n1.0.0 | 2019/04/25 |新增此接口。 |\n",
        "tags": [
          "TemplateGroup"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/authorization"
