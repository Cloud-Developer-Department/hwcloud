            "required": true,
            "minLength": 0,
            "maxLength": 64
          },
          {
            "in": "body",
            "description": "修改模板组",
            "name": "UpdateTemplateGroupRequestBody",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ModifyTransTemplateGroup"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "更新转码模板组成功。"
