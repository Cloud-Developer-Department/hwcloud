          "description": "视频时长。单位:秒。"
        },
        "format": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "description": "文件封装格式。"
        },
        "md5": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "视频的 md5 值。"
        },
        "bitrate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "format": "int64",
          "description": "总码率。单位:bit/秒"
        },
        "video": {
          "description": "视频流元数据。",
          "type": "array",
          "minItems": 0,
          "maxItems": 50000,
          "items": {
            "$ref": "#/definitions/VideoInfo"
          }
        },
        "audio": {
          "description": "音频流元数据。",
          "type": "array",
          "minItems": 0,
          "maxItems": 50000,
          "items": {
            "$ref": "#/definitions/AudioInfo"
          }
        }
      }
    },
