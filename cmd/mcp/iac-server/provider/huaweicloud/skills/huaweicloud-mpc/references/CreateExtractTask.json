{
  "name": "CreateExtractTask",
  "summary": "新建视频解析任务",
  "tags": "视频解析接口",
  "productshort": "MPC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/extract-metadata": {
      "post": {
        "x-navigation-title": "视频解析接口",
        "description": "创建视频解析任务,解析视频元数据。",
        "summary": "新建视频解析任务",
        "x-publishpath": "mpc_04_0061",
        "operationId": "CreateExtractTask",
        "x-open-region-cloud": "hc,hk,g42",
        "x-external-api": true,
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-since": "1.0.0",
        "x-since-memo": "1.0.0 initial",
        "x-modifier-memo": "版本 | 修改日期 | 修改说明 | 修改者\n------------ | ------------- | ------------- | -------------\n1.0.0 | 2019/07/02 | 新增此接口。 | 欧斯航\n",
        "tags": [
          "ExtractTaskManager"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/authorization"
          },
          {
            "$ref": "#/parameters/xProjectId"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](mpc_04_0064.xml)",
            "required": true,
            "minLength": 0,
            "maxLength": 64
          },
          {
            "in": "body",
            "name": "CreateExtractTaskRequestBody",
            "description": "创建解析请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateExtractTaskReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "新建视频解析任务成功。",
            "schema": {
              "$ref": "#/definitions/CreateExtractTaskRsp"
            }
          },
          "400": {
            "description": "新建视频解析任务失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "MPC.10202",
                "error_msg": "Invalid request parameter."
              }
            }
          }
        },
        "x-request-examples-1": "POST https://{endpoint}/v1/{project_id}/extract-metadata\n  {\n  \"input\": {\n             \"bucket\": \"obs-gxh\",\n             \"location\": \"region1\",\n             \"object\": \"1/okFLV.flv\"\n  },\n  \"output\": {\n             \"bucket\": \"obs-gxh\",\n             \"location\": \"region1\",\n             \"object\": \"1/output\"\n  },\n  \"sync\": 0\n  }\n"
      }
    }
  },
  "definitions": {
    "HlsEncrypt": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "required": [
        "key",
        "url"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "内容加密秘钥"
        },
        "url": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "秘钥获取服务的地址"
        },
        "iv": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "初始向量,base64binary,随机数"
        },
        "algorithm": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "description": "加密算法。\n- AES-128-CTR\n- AES-128-CBC\n- SM4CBC\n\n默认值:AES-128-CTR"
        }
      }
    },
    "CommonCreateTaskReq": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/definitions/ObsObjInfo",
          "description": "源文件信息。"
        },
        "output": {
          "$ref": "#/definitions/ObsObjInfo",
          "description": "输出文件信息。"
        },
        "user_data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65535,
          "description": "用户自定义数据。"
        }
      }
    },
    "Multidrm": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "required": [
        "drm_list",
        "streaming_mode"
      ],
      "properties": {
        "content_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "唯一标识"
        },
        "streaming_mode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "enum": [
            "DASH",
            "HLS"
          ],
          "description": "定义数据流的类型,取值为DASH或HLS"
        },
        "encrypt_audio": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "format": "int32",
          "description": "音频加密开关。\n\n取值如下:\n- 0:标识音频不加密。\n- 1:标识音频加密。\n\n默认值:0。\n该参数只对dash有效。"
        },
        "emi": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "format": "int32",
          "default": 16420,
          "description": "定义加密方式。\n\n取值如下:\n- 16418(AES-128,CBC)\n- 16420(AES-128,CTR)\n- 16422(SM4CBC)"
        },
        "drm_list": {
          "description": "HLS视频加密控制参数。\n\n取值如下:\n- PLAYREADY\n- CHINA_DRM\n- WIDEVINE",
          "type": "array",
          "minItems": 0,
          "maxItems": 50000,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CommonCreateTaskRsp": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "description": "任务ID"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "CreateExtractTaskRsp": {
      "allOf": [
        {
          "$ref": "#/definitions/CommonCreateTaskRsp"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "minLength": 0,
              "maxLength": 16,
              "description": "任务状态"
            },
            "create_time": {
              "type": "string",
              "minLength": 0,
              "maxLength": 32,
              "description": "任务创建时间"
            },
            "output": {
              "$ref": "#/definitions/ObsObjInfo",
              "description": "输出文件信息"
            },
            "output_file_name": {
              "type": "string",
              "minLength": 0,
              "maxLength": 2147483647,
              "description": "解析文件名称"
            },
            "description": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1024,
              "description": "任务描述,如当任务异常时,此字段为异常的具体信息"
            },
            "metadata": {
              "$ref": "#/definitions/MetaData",
              "description": "视频文件元数据"
            }
          }
        }
      ]
    },
    "VideoInfo": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "视频宽度"
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "视频高度"
        },
        "bitrate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "视频码率,单位: kbit/s"
        },
        "bitrate_bps": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "视频码率,单位: bit/s"
        },
        "frame_rate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "帧率。\n\n  取值范围:0或[5,60],0表示自适应。\n\n  单位:帧每秒。\n\n  > 若设置的帧率不在取值范围内,则自动调整为0,若设置的帧率高于片源帧率,则自动调整为片源帧率。"
        },
        "codec": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "视频编码格式"
        },
        "duration": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "视频流时长,单位:秒"
        },
        "duration_ms": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "视频流时长,单位:毫秒"
        },
        "rotate": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "format": "float",
          "description": "视频拍摄时的选择角度,单位:度。"
        }
      }
    },
    "AudioInfo": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "codec": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "音频编码格式"
        },
        "sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "音频采样率"
        },
        "channels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "音频信道"
        },
        "bitrate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "音频码率,单位: kbit/s"
        },
        "bitrate_bps": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "音频码率,单位: bit/s"
        },
        "duration": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "音频流时长,单位:秒"
        },
        "duration_ms": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "音频流时长,单位:毫秒"
        }
      }
    },
    "CreateExtractTaskReq": {
      "allOf": [
        {
          "$ref": "#/definitions/CommonCreateTaskReq"
        },
        {
          "type": "object",
          "properties": {
            "sync": {
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "maximum": 2,
              "description": "是否同步处理,\n- 0:排队处理\n- 1:同步处理\n\n默认值:0",
              "default": 0
            },
            "encryption": {
              "description": "视频加密控制参数。",
              "$ref": "#/definitions/Encryption"
            }
          }
        }
      ]
    },
    "ObsObjInfo": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "required": [
        "bucket",
        "location",
        "object"
      ],
      "properties": {
        "bucket": {
          "description": "OBS的bucket名称。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "location": {
          "description": "OBS桶所在的区域,且必须与使用的MPC区域保持一致。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "object": {
          "description": "OBS对象路径,遵守OSS Object定义。\n\n- 当用于指示input时,需要指定到具体对象。\n- 当用于指示output时, 只需指定到转码结果期望存放的路径。",
          "type": "string",
          "minLength": 0,
          "maxLength": 2147483647
        },
        "file_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2147483647,
          "description": "文件名,仅用于转封装指定输出名称。\n\n- 当指定了此参数时,输出的对象名为object/file_name 。\n- 当不指定此参数时,输出的对象名为object/xxx,其中xxx由MPC指定。"
        }
      }
    },
    "MetaData": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "format": "int64",
          "description": "文件大小。"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647,
          "format": "double",
          "description": "视频时长,带小数位显示。单位:秒。"
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
