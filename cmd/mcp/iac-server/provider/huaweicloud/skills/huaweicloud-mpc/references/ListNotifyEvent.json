{
  "name": "ListNotifyEvent",
  "summary": "查询转码服务端所有事件",
  "tags": "授权与配置接口",
  "productshort": "MPC",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/{project_id}/notification/event": {
      "get": {
        "x-navigation-title": "授权与配置接口",
        "x-inner-api": true,
        "description": "查询消息订阅功能板块, SMN主题的所有订阅事件。",
        "summary": "查询转码服务端所有事件",
        "operationId": "ListNotifyEvent",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-since": "1.0.0",
        "x-since-memo": "1.0.0 initial",
        "x-modifier-memo": "版本 | 修改日期 | 修改说明 | 修改者\n------------ | ------------- | ------------- | -------------\n1.0.0 | 2018/04/03 |新增此接口。 | 吴晓瑜\n",
        "tags": [
          "AuthorizationAndConfiguration"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/authorization"
          },
          {
            "$ref": "#/parameters/xProjectId"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID",
            "required": true,
            "minLength": 0,
            "maxLength": 64
          }
        ],
        "responses": {
          "200": {
            "description": "查询消息订阅功能板块, SMN主题的所有订阅事件成功。",
            "schema": {
              "$ref": "#/definitions/queryNotifyEventRsp"
            },
            "examples": {
              "application/json": {
                "total": 7,
                "event_name": [
                  "TranscodeComplete",
                  "TranscodeStart",
                  "ThumbnailComplete",
                  "RemuxComplete",
                  "AnimatedGraphicsComplete",
                  "ParseComplete",
                  "EditingComplete"
                ]
              }
            }
          },
          "403": {
            "description": "查询消息订阅功能板块, SMN主题的所有订阅事件失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "MPC.10208",
                "error_msg": "Failed to verify the tenant ID."
              }
            }
          }
        },
        "x-request-examples-1": "GET https://{endpoint}/v1/{project_id}/notification/event\n"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "queryNotifyEventRsp": {
      "type": "object",
      "properties": {
        "event_name": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50000,
          "description": "事件名称",
          "items": {
            "type": "string"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "点播通知事件总数"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xProjectId": {
      "name": "X-Project_Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息, 与路径参数中的项目ID相同。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authorization": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "mts.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}