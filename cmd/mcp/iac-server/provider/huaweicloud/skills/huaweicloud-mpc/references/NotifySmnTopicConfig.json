      ],
      "properties": {
        "notifications": {
          "description": "事件通知模板信息",
          "type": "array",
          "minItems": 0,
          "maxItems": 50000,
          "items": {
            "$ref": "#/definitions/Notification"
          }
        }
      }
    }
