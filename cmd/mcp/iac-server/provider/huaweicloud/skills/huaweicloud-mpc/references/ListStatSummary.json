{
  "name": "ListStatSummary",
  "summary": "查询点播概览信息",
  "tags": "媒资转码接口",
  "productshort": "MPC",
  "region_id": "cn-east-2",
  "paths": {
    "/v1/{project_id}/transcodings/summaries": {
      "get": {
        "x-navigation-title": "媒资转码接口",
        "x-inner-api": true,
        "description": "查询最近一周,最近一月或者自定义时间段的“转码时长”,“调用转码API次数”。",
        "summary": "查询点播概览信息",
        "operationId": "ListStatSummary",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-since": "1.0.0",
        "x-since-memo": "1.0.0 initial",
        "x-modifier-memo": "版本 | 修改日期 | 修改说明 | 修改者\n------------ | ------------- | ------------- | -------------\n1.1.0 | 2018/09/11 |新增此接口。 | 陈霏\n",
        "tags": [
          "TranscodeTask"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/authorization"
          },
          {
            "$ref": "#/parameters/xProjectId"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](mpc_04_0064.xml)",
            "required": true,
            "minLength": 0,
            "maxLength": 64
          },
          {
            "in": "query",
            "name": "start_time",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "description": "开始时间。格式为yyyymmdd。必须是与时区无关的UTC时间。"
          },
          {
            "in": "query",
            "name": "end_time",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "description": "结束时间。格式为yyyymmdd。必须是与时区无关的UTC时间。"
          },
          {
            "in": "query",
            "name": "stat_type",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "description": "支持的参数类型"
          }
        ],
        "responses": {
          "200": {
            "description": "查询转码概览信息成功。",
            "schema": {
              "$ref": "#/definitions/QueryStatSummaryRsp"
            },
            "examples": {
              "application/json": {
                "stat_type": "transcode_task_number",
                "total": 5.0,
                "summary": [
                  {
                    "value": "2.0",
                    "date": "2022/11/25"
                  },
                  {
                    "value": "3.0",
                    "date": "2022/11/25"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "查询转码概览信息失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "MPC.10202",
                "error_msg": "Invalid request parameter, start_time cannot be greater than end_time."
              }
            }
          }
        },
        "x-request-examples-1": "GET https://{endpoint}/v1/{project_id}/transcodings/summaries?start_time=20221119&end_time=20221125&stat_type=transcode_task_number\n"
      }
    }
  },
  "definitions": {
    "QueryStatSummaryRsp": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50000,
          "description": "统计概览信息",
          "items": {
            "$ref": "#/definitions/StatSummary"
          }
        },
        "total": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647,
          "format": "float",
          "description": "该指标的总值,精确到小数点后两位。"
        },
        "stat_type": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "统计类型。取值如下:\n- video_duration, 转码片源时长统计,单位:分钟。\n- remux_file_duration,转封装片源时长统计,单位:分钟。\n- transcode_task_number,转码次数统计,单位:次。\n- transcode_duration,转码耗时时长统计,单位:分钟。",
          "enum": [
            "video_duration",
            "remux_file_duration",
            "transcode_task_number",
            "transcode_duration"
          ]
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "StatSummary": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647,
          "format": "float",
          "description": "精确到小数点后两位。"
        },
        "date": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "description": "日期,精确到天,格式样例:2018/03/01。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xProjectId": {
      "name": "X-Project_Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息, 与路径参数中的项目ID相同。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authorization": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "mpc.cn-east-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}