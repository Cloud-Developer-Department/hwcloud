                    "common": {
                      "QDS": false,
                      "PVC": false,
                      "PVC_version": null,
                      "PVC_strength": 100,
                      "hls_interval": 5,
                      "dash_interval": 5,
                      "pack_type": 4
                    }
                  }
                ]
              }
            }
          },
          "403": {
            "description": "查询转码模板组失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "MPC.10212",
                "error_msg": "Operation failed."
              }
            }
          }
        },
        "x-request-examples-1": "GET https://{endpoint}/v1/{project_id}/template_group/transcodings?page=0&size=10\n",
        "x-response-example": "{\n    \"template_group_list\" : [{\n            \"group_id\" : \"be22e2895b78469588851c9e4f051f88\",\n            \"name\" : \"gege1\",\n            \"template_ids\" : [35, 36],\n            \"videos\" : [{\n                    \"template_id\" : 35,\n                    \"width\" : 1920,\n                    \"height\" : 1080,\n                    \"bitrate\" : 0\n                }, {\n                    \"template_id\" : 36,\n                    \"width\" : 1280,\n                    \"height\" : 720,\n                    \"bitrate\" : 0\n                }\n            ],\n            \"audio\" : {\n                \"output_policy\" : \"transcode\",\n                \"codec\" : 1,\n                \"bitrate\" : 0,\n                \"sample_rate\" : 1,\n                \"channels\" : 2\n            },\n            \"video_common\" : {\n                \"output_policy\" : \"transcode\",\n                \"GOP_structure\" : false,\n                \"level\" : 15,\n                \"profile\" : 3,\n                \"sr_factor\" : null,\n                \"preset\" : 3,\n                \"frame_rate\" : 0,\n                \"codec\" : 1,\n                \"max_iframes_interval\" : 5,\n                \"bframes_count\" : 4\n            },\n            \"common\" : {\n                \"QDS\" : false,\n                \"PVC\" : false,\n                \"PVC_version\" : null,\n                \"PVC_strength\" : \"100\",\n                \"hls_interval\" : 5,\n                \"dash_interval\" : 5,\n                \"pack_type\" : 1\n            }\n        }\n    ],\n    \"total\" : 1\n}\n"
      }
