  "definitions": {
    "QueryTemplateGroupRsp": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "template_group_list": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50000,
          "description": "模板组信息列表。",
          "items": {
            "$ref": "#/definitions/TemplateGroup"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "转码模板组总数",
          "format": "int32"
        }
      }
    },
    "OutputPolicy": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "x-imports": "com.fasterxml.jackson.annotation.JsonInclude;",
      "type": "object",
      "properties": {
        "output_policy": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "输出策略。\n\n取值如下:\n- discard\n- transcode\n\n>- 当视频参数中的“output_policy”为\"discard\",且音频参数中的“output_policy”为“transcode”时,表示只输出音频。\n>- 当视频参数中的“output_policy”为\"transcode\",且音频参数中的“output_policy”为“discard”时,表示只输出视频。\n>- 同时为\"discard\"时不合法。\n>- 同时为“transcode”时,表示输出音视频。",
          "default": "transcode",
          "enum": [
            "transcode",
            "discard",
            "copy"
          ]
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "Audio": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "x-imports": "org.hibernate.validator.constraints.*;",
      "allOf": [
        {
          "$ref": "#/definitions/OutputPolicy"
        },
        {
          "type": "object",
          "required": [
            "channels"
          ],
          "properties": {
            "codec": {
              "x-internal": false,
              "description": "音频编码格式。\n\n取值如下:\n\n- 1:AAC格式。\n- 2:HEAAC1格式 。\n- 3:HEAAC2格式。\n- 4:MP3格式 。",
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "format": "int32",
              "default": 1
            },
            "sample_rate": {
              "x-internal": false,
              "description": "音频采样率。\n\n取值如下:\n\n- 1:AUDIO_SAMPLE_AUTO\n- 2:AUDIO_SAMPLE_22050(22050Hz)\n- 3:AUDIO_SAMPLE_32000(32000Hz)\n- 4:AUDIO_SAMPLE_44100(44100Hz)\n- 5:AUDIO_SAMPLE_48000(48000Hz)\n- 6:AUDIO_SAMPLE_96000(96000Hz)",
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "format": "int32",
              "default": 1
            },
            "bitrate": {
              "x-internal": false,
              "description": "音频码率。\n\n取值范围:0或[8,1000]。\n\n单位:kbit/s。",
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647,
              "format": "int32"
            },
            "channels": {
              "x-internal": false,
              "description": "声道数。\n\n取值如下:\n- 1:AUDIO_CHANNELS_1\n- 2:AUDIO_CHANNELS_2\n- 6:AUDIO_CHANNELS_5_1",
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "format": "int32"
            }
          }
        }
      ]
    },
    "Common": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "required": [
        "pack_type"
      ],
      "x-imports": "org.hibernate.validator.constraints.*;",
      "properties": {
        "PVC": {
          "x-internal": false,
          "description": "是否开启高清低码功能。\n\n取值如下:\n- false:关闭。\n- true:开启。",
          "type": "boolean",
          "default": false
        },
        "hls_interval": {
          "x-internal": false,
          "description": "HLS分片间隔,仅封装类型“pack_type”取值为1或3时,该参数生效。\n\n取值范围:[2,10]。\n\n单位:秒。",
          "type": "integer",
          "minimum": 2,
          "maximum": 10,
          "format": "int32",
          "default": 5
        },
        "dash_interval": {
          "x-internal": false,
          "description": "DASH间隔,仅封装类型“pack_type”取值为2或3时,该参数生效。\n\n取值范围:[2,10]。\n\n单位:秒。",
          "type": "integer",
          "minimum": 2,
          "maximum": 10,
          "format": "int32",
          "default": 5
        },
        "pack_type": {
          "x-internal": false,
          "description": "封装类型。\n\n取值如下:\n- 1:HLS\n- 2:DASH\n- 3:HLS+DASH\n- 4:MP4\n- 5:MP3\n- 6:ADTS\n\n> pack_type设置为5和6时,不能设置视频参数。",
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "format": "int32"
        }
      }
    },
    "TemplateGroup": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "模板组id"
        },
        "name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "模板组名称"
        },
        "template_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "description": "模板组模板ID",
          "items": {
            "type": "integer"
          }
        },
        "videos": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "description": "视频信息列表",
          "items": {
            "$ref": "#/definitions/VideoAndTemplate"
          }
        },
        "audio": {
          "description": "音频信息",
          "$ref": "#/definitions/Audio"
        },
        "video_common": {
          "description": "视频通用信息",
          "$ref": "#/definitions/VideoCommon"
        },
        "common": {
          "description": "通用信息",
          "$ref": "#/definitions/Common"
        }
      }
    },
    "VideoAndTemplate": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "x-imports": "org.hibernate.validator.constraints.Range;",
      "properties": {
        "template_id": {
          "description": "模板ID",
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "format": "int32"
        },
        "width": {
          "description": "视频宽度(单位:像素)\n- H264:范围[32,4096],必须为2的倍数\n- H265:范围[320,4096],必须是4的倍数",
          "type": "integer",
          "minimum": 0,
          "maximum": 4096,
          "format": "int32",
          "x-annotations": [
            "@Range(min = 0, max = 4096)"
          ]
        },
        "height": {
          "description": "视频高度(单位:像素)\n- H264:范围[32,2880],必须为2的倍数\n- H265:范围[240,2880],必须是4的倍数",
          "type": "integer",
          "minimum": 0,
          "maximum": 2880,
          "format": "int32",
          "x-annotations": [
            "@Range(min = 0, max = 2880)"
          ]
        },
        "bitrate": {
          "description": "输出平均码率。\n\n取值范围:0或[40,30000]之间的整数。\n\n单位:kbit/s\n\n若设置为0,则输出平均码率为自适应值。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 30000
        },
        "stream_name": {
          "description": "流名称",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      }
    },
    "VideoCommon": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "x-imports": "org.hibernate.validator.constraints.Range;",
      "allOf": [
        {
          "$ref": "#/definitions/OutputPolicy"
        },
        {
          "type": "object",
          "properties": {
            "codec": {
              "description": "视频编码格式。\n\n取值如下:\n- 1:表示H.264。\n- 2:表示H.265。",
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "format": "int32",
              "x-annotations": [
                "@Range(min = 1, max = 3)"
              ]
            },
            "profile": {
              "description": "编码档次,建议设为3。\n\n取值如下:\n- 1:VIDEO_PROFILE_H264_BASE\n- 2:VIDEO_PROFILE_H264_MAIN\n- 3:VIDEO_PROFILE_H264_HIGH\n- 4:VIDEO_PROFILE_H265_MAIN",
              "type": "integer",
              "minimum": 0,
              "maximum": 5,
              "format": "int32",
              "x-annotations": [
                "@Range(min = 1, max = 5)"
              ]
            },
            "level": {
              "description": "编码级别。\n\n取值如下:\n- 1:VIDEO_LEVEL_1_0\n- 2:VIDEO_LEVEL_1_1\n- 3:VIDEO_LEVEL_1_2\n- 4:VIDEO_LEVEL_1_3\n- 5:VIDEO_LEVEL_2_0\n- 6:VIDEO_LEVEL_2_1\n- 7:VIDEO_LEVEL_2_2\n- 8:VIDEO_LEVEL_3_0\n- 9:VIDEO_LEVEL_3_1\n- 10:VIDEO_LEVEL_3_2\n- 11:VIDEO_LEVEL_4_0\n- 12:VIDEO_LEVEL_4_1\n- 13:VIDEO_LEVEL_4_2\n- 14:VIDEO_LEVEL_5_0\n- 15:VIDEO_LEVEL_5_1",
              "type": "integer",
              "minimum": 0,
              "maximum": 16,
              "format": "int32",
              "x-annotations": [
                "@Range(min = 1, max = 16)"
              ],
              "default": 15
            },
            "preset": {
              "description": "编码质量等级。\n\n取值如下:\n- 1:VIDEO_PRESET_SPEED,编码快速档位\n- 3:VIDEO_PRESET_HIGHQUALITY,编码高质量档位\n- 4:VIDEO_PRESET_QUALITY,编码质量档位\n- 5:VIDEO_PRESET_BALANCE,编码平衡档位\n默认值1。",
              "type": "integer",
              "minimum": 0,
              "maximum": 5,
              "default": 1,
              "format": "int32",
              "x-annotations": [
                "@Range(min = 1, max = 5)"
              ]
            },
            "max_iframes_interval": {
              "description": "I帧最大间隔\n\n取值范围:[2,10]。\n\n默认值:5。\n\n单位:秒。",
              "type": "integer",
              "format": "int32",
              "minimum": 2,
              "maximum": 10,
              "x-annotations": [
                "@Range(min = 2, max = 10)"
              ],
              "default": 5
            },
            "bframes_count": {
              "description": "最大B帧间隔。\n\n取值范围:\n- H264:[0,7],默认值为4。\n- H265:[0,7],默认值为7。\n\n单位:帧。",
              "type": "integer",
              "minimum": 0,
              "maximum": 8,
              "format": "int32",
              "x-annotations": [
                "@Range(min = 0, max = 8)"
              ]
            },
            "frame_rate": {
              "description": "帧率\n\n取值范围:0或[5,60]之间的整数,0表示自适应\n\n单位:帧每秒",
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647,
              "format": "int32"
            },
            "black_cut": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2,
              "format": "int32",
              "description": "黑边剪裁类型\n\n取值如下:\n- 0:不开启黑边剪裁\n- 1:开启黑边剪裁,低复杂度算法,针对长视频(>5分钟)\n- 2:开启黑边剪裁,高复杂度算法,针对短视频(<=5分钟)",
              "x-annotations": [
                "@Range(min = 0, max = 2)"
              ]
            }
          }
        }
      ]
    }
  },
