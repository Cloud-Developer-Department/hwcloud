                  {
                    "group_id": "397565a34913415c91955254add0461a",
                    "name": "test_templageGroup",
                    "template_ids": [
                      276195
                    ],
                    "videos": [
                      {
                        "template_id": 276195,
                        "width": 854,
                        "height": 480,
                        "bitrate": 500
