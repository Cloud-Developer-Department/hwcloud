{
  "name": "CreateWatermarkTemplate",
  "summary": "新建水印模板",
  "tags": "水印模板接口",
  "productshort": "MPC",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/{project_id}/template/watermark": {
      "post": {
        "x-navigation-title": "水印模板接口",
        "description": "自定义水印模板。",
        "summary": "新建水印模板",
        "x-publishpath": "mpc_04_0043",
        "operationId": "CreateWatermarkTemplate",
        "x-open-region-cloud": "hcso,hc,hk,g42",
        "x-external-api": true,
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-since": "1.0.0",
        "x-since-memo": "1.0.0 initial",
        "x-modifier-memo": "版本 | 修改日期 | 修改说明 | 修改者\n------------ | ------------- | ------------- | -------------\n1.0.0 | 2018/7/18 |新增此接口。 | 杨志鹏\n",
        "tags": [
          "WatermarkTemplateManager"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/authorization"
          },
          {
            "$ref": "#/parameters/xProjectId"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](mpc_04_0064.xml)",
            "required": true,
            "minLength": 0,
            "maxLength": 64
          },
          {
            "in": "header",
            "name": "x-vod-projectId",
            "x-inner-field": true,
            "x-is_inner_param": "true",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "description": "VOD调用MPC携带的客户projectId"
          },
          {
            "in": "body",
            "name": "CreateWatermarkTemplateRequestBody",
            "description": "创建用户自定义水印配置模板",
            "schema": {
              "$ref": "#/definitions/WatermarkTemplate"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "新建水印模板成功。",
            "schema": {
              "$ref": "#/definitions/CreateWatermarkTemplateRsp"
            },
            "examples": {
              "application/json": {
                "template_id": 100211
              }
            }
          },
          "403": {
            "description": "新建水印模板失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "MPC.10202",
                "error_msg": "Invalid request parameter."
              }
            }
          }
        },
        "x-request-examples-1": "POST https://{endpoint}/v1/{project_id}/template/watermark\n {\n    \"template_name\": \"watermark_1920*1080_10*10_ BottomLeft\",\n    \"type\": \"Image\",\n    \"image_process\": \"Grayed\",\n    \"width\": \"1920\",\n    \"height\": \"1080\",\n    \"dx\": \"10\",\n    \"dy\": \"10\",\n    \"referpos\": \"BottomLeft\",\n    \"timeline_start\": \"6\",\n    \"timeline_duration\": \"8\"\n  }\n",
        "x-response-example": "{\n  \"template_id\": 1001\n}\n"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "ImageWatermark": {
      "allOf": [
        {
          "$ref": "#/definitions/BasicWatermark"
        },
        {
          "type": "object",
          "description": "图片水印参数, 用于对模板中字段进行覆盖,目前模板只针对于图片水印",
          "properties": {
            "image_process": {
              "type": "string",
              "minLength": 0,
              "maxLength": 32,
              "description": "图片水印处理方式,type设置为Image时有效。\n\n取值如下:\n\n- Original:只做简单缩放,不做其他处理。\n- Grayed:彩色图片变灰。\n- Transparent:透明化。"
            },
            "width": {
              "type": "string",
              "minLength": 0,
              "maxLength": 32,
              "description": "水印图片宽,值有两种形式:\n- 整数型代水印图片宽的像素值,范围[8,4096],单位px。\n- 小数型代表相对输出视频分辨率宽的比率,范围(0,1),支持4位小数,如0.9999,超出部分系统自动丢弃。"
            },
            "height": {
              "type": "string",
              "minLength": 0,
              "maxLength": 32,
              "description": "水印图片高,值有两种形式:\n- 整数型代表水印图片高的像素值,范围[8,4096],单位px。\n- 小数型代表相对输出视频分辨率高的比率,范围(0,1),支持4位小数,如0.9999,超出部分系统自动丢弃。"
            },
            "base": {
              "type": "string",
              "minLength": 0,
              "maxLength": 32,
              "description": "水印叠加母体\n\n取值如下:\n- input :水印叠加在输入片源上,转码输出后实际大小按图像等比例缩放\n- output :水印叠加在转码输出文件上。",
              "default": "input",
              "enum": [
                "input",
                "output"
              ]
            }
          }
        }
      ]
    },
    "XCodeError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "错误码"
        },
        "msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误信息"
        }
      }
    },
    "BasicWatermark": {
      "type": "object",
      "properties": {
        "dx": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "default": 0,
          "description": "水印图片起点相对输出视频顶点的水平偏移量。\n\n设置方法有如下两种:\n\n- 整数型:表示图片起点水平偏移视频顶点的像素值,单位px。取值范围:[0,4096]\n- 小数型:表示图片起点相对于视频分辨率宽的水平偏移比率。取值范围:(0,1),支持4位小数,如0.9999,超出部分系统自动丢弃。\n\n示例:输出视频分辨率宽1920,设置“dx”为“0.1”,“referpos”为“TopRight”(右上角),则水印图片右上角到视频右顶点在水平方向上偏移距离为192。"
        },
        "dy": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "default": 0,
          "description": "水印图片起点相对输出视频顶点的垂直偏移量。\n\n- 设置方法有如下两种:整数型:表示图片起点垂直偏移视频顶点的像素值,单位px。取值范围:[0,4096]\n- 小数型:表示图片起点相对于视频分辨率高的垂直偏移比率。取值范围:(0,1),支持4位小数,如0.9999,超出部分系统自动丢弃。\n\n示例:输出视频分辨率高1080,设置“dy”为“0.1”,“referpos”为“TopRight”(右上角),则水印图片右上角到视频右顶点在垂直方向上的偏移距离为108。"
        },
        "referpos": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "水印的位置。\n\n取值如下:\n- TopRight:右上角。\n- TopLeft:左上角。\n- BottomRight:右下角。\n- BottomLeft:左下角。"
        },
        "timeline_start": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "default": 0,
          "description": "水印开始时间,与“timeline_duration”配合使用。\n\n取值范围:数字。\n\n单位:秒。"
        },
        "timeline_duration": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "description": "水印持续时间,与“timeline_start”配合使用。\n\n取值范围:[数字,ToEND]。“ToEND”表示持续到视频结束。\n\n默认值:ToEND。"
        },
        "random_time_min": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "default": 300,
          "description": "轮转间隔时间最小值,单位:秒"
        },
        "random_time_max": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "default": 1800,
          "description": "轮转间隔时间最大值,单位:秒"
        }
      }
    },
    "CreateWatermarkTemplateRsp": {
      "type": "object",
      "properties": {
        "template_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "水印模板Id"
        }
      }
    },
    "WatermarkTemplate": {
      "allOf": [
        {
          "$ref": "#/definitions/ImageWatermark"
        },
        {
          "type": "object",
          "properties": {
            "template_id": {
              "x-internal": false,
              "x-is_inner_param": "false",
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "maximum": 2147483647,
              "description": "水印模板ID"
            },
            "template_name": {
              "type": "string",
              "minLength": 0,
              "maxLength": 64,
              "description": "水印模板名称。"
            },
            "type": {
              "type": "string",
              "minLength": 0,
              "maxLength": 32,
              "description": "水印类型,当前只支持Image(图片水印)。后续根据需求再支持Text(文字水印)。"
            }
          }
        }
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "xProjectId": {
      "name": "X-Project_Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息, 与路径参数中的项目ID相同。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authorization": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "mts.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}