{
  "name": "ListAllBuckets",
  "summary": "查询桶列表",
  "tags": "授权与配置接口",
  "productshort": "MPC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/buckets": {
      "get": {
        "x-navigation-title": "授权与配置接口",
        "x-inner-api": true,
        "description": "请求查询自己创建的指定的桶区域位置的桶列表。",
        "summary": "查询桶列表",
        "operationId": "ListAllBuckets",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-since": "1.0.0",
        "x-since-memo": "1.0.0 initial",
        "x-modifier-memo": "版本 | 修改日期 | 修改说明 | 修改者\n------------ | ------------- | ------------- | -------------\n1.0.0 | 2018/3/28 |新增此接口。 | 吴晓瑜\n",
        "tags": [
          "AuthorizationAndConfiguration"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/authorization"
          },
          {
            "$ref": "#/parameters/xProjectId"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](mpc_04_0064.xml)",
            "required": true,
            "minLength": 0,
            "maxLength": 64
          }
        ],
        "responses": {
          "200": {
            "description": "查询桶列表成功。",
            "schema": {
              "$ref": "#/definitions/QueryAllBucketsRsp"
            },
            "examples": {
              "application/json": {
                "buckets": [
                  {
                    "bucket": "bucketName1",
                    "creation_date": 20221026152511,
                    "is_authorized": 1
                  },
                  {
                    "bucket": "bucketName2",
                    "creation_date": 20221026104736,
                    "is_authorized": 0
                  }
                ]
              }
            }
          },
          "403": {
            "description": "查询桶列表失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "MPC.10208",
                "error_msg": "Failed to verify the tenant ID."
              }
            }
          }
        },
        "x-request-examples-1": "GET https://{endpoint}/v1/{project_id}/buckets\n"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "QueryAllBucketsRsp": {
      "type": "object",
      "properties": {
        "buckets": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50000,
          "description": "桶列表",
          "items": {
            "$ref": "#/definitions/ObsBucket"
          }
        }
      }
    },
    "ObsBucket": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "桶名称"
        },
        "creation_date": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "桶的创建时间"
        },
        "is_authorized": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "授权结果,取值[0,1],0表示未授权给转码服务,1表示已授权转码服务"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xProjectId": {
      "name": "X-Project_Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息, 与路径参数中的项目ID相同。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authorization": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "mpc.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}