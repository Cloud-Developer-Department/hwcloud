{
  "name": "ShowRemoteConsole",
  "summary": "获取console地址信息",
  "tags": "物理服务器管理",
  "productshort": "CloudDC",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/{project_id}/physicalservers/{id}/remote-console-address": {
      "get": {
        "tags": [
          "物理服务器管理"
        ],
        "operationId": "ShowRemoteConsole",
        "summary": "获取console地址信息",
        "description": "获取console信息",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/ID"
          },
          {
            "$ref": "#/parameters/AuthToken"
          }
        ],
        "responses": {
          "200": {
            "description": "服务器已成功处理了请求",
            "schema": {
              "$ref": "#/definitions/RemoteConsoleResponseBody"
            }
          },
          "400": {
            "description": "请求参数错误,请求失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "请求未鉴权",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "429": {
            "description": "请求过载",
            "schema": {
              "type": "string",
              "example": "too many requests"
            }
          },
          "500": {
            "description": "服务端内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "x-order": 1
      }
    }
  },
  "definitions": {
    "Error": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "iMetal.00004000"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "error message"
        }
      },
      "type": "object"
    },
    "RemoteConsoleResponseBody": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "远程登录地址"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "project id",
      "type": "string"
    },
    "ID": {
      "name": "id",
      "in": "path",
      "required": true,
      "type": "string",
      "description": "imetal server id",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "AuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "租户账号的iam token。",
      "type": "string"
    }
  },
  "host": "clouddc.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}