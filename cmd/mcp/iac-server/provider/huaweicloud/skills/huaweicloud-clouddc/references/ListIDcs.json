{
  "name": "ListIDcs",
  "summary": "查询 IDC 列表",
  "tags": "机房管理",
  "productshort": "CloudDC",
  "region_id": "cn-south-1",
  "paths": {
    "/v1/{project_id}/idcs": {
      "get": {
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "tags": [
          "机房管理"
        ],
        "summary": "查询 IDC 列表",
        "description": "查询 IDC 列表",
        "operationId": "ListIDcs",
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/AuthToken"
          },
          {
            "name": "region",
            "in": "query",
            "required": true,
            "description": "区域",
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "分页大小,取值范围为[1,2000],默认2000",
            "type": "string",
            "default": 2000
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "排序升、降序",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          {
            "name": "marker",
            "in": "query",
            "required": false,
            "description": "上一页数据的最后一条记录id",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "IDC 列表",
            "schema": {
              "$ref": "#/definitions/IDcResponse"
            }
          },
          "400": {
            "description": "请求参数错误,请求失败",
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          },
          "401": {
            "description": "请求错误,用户未授权",
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          },
          "429": {
            "description": "请求错误,请求频率过高",
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          },
          "500": {
            "description": "服务器处理请求失败",
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "IDc": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "irack_num": {
          "type": "integer",
          "format": "int32"
        },
        "id": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "irack_num",
        "id"
      ]
    },
    "PageInfo": {
      "description": "分页信息",
      "properties": {
        "next_marker": {
          "type": "string",
          "description": "下一页查询地址",
          "example": "01939592-e8fe-7d9b-9332-d58948637755"
        },
        "previous_marker": {
          "type": "string",
          "description": "上一页查询地址",
          "example": "01939592-e8fe-7d9b-9332-4589486377a4"
        },
        "current_count": {
          "type": "integer",
          "format": "int32",
          "description": "本页返回条目数量",
          "example": 1
        }
      },
      "type": "object"
    },
    "IDcResponse": {
      "type": "object",
      "properties": {
        "idcs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IDc"
          }
        },
        "page_info": {
          "$ref": "#/definitions/PageInfo"
        },
        "count": {
          "type": "integer",
          "description": "机房总数"
        }
      }
    },
    "FailedRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "description": "任务异常错误信息描述",
          "type": "string",
          "example": "error message"
        },
        "error_code": {
          "description": "任务异常错误信息编码",
          "type": "string",
          "example": "iMetal.00004000"
        }
      },
      "description": "异常时返回的异常信息"
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "project id",
      "type": "string"
    },
    "AuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "租户账号的iam token。",
      "type": "string"
    }
  },
  "host": "clouddc.cn-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}