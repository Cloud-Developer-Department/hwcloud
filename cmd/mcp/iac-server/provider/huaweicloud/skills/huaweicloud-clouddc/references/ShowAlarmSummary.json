{
  "name": "ShowAlarmSummary",
  "summary": "服务器告警概览",
  "tags": "物理服务器诊断",
  "productshort": "CloudDC",
  "region_id": "cn-southwest-2",
  "paths": {
    "/v1/{project_id}/physicalservers/alarms/summary": {
      "get": {
        "tags": [
          "物理服务器诊断"
        ],
        "summary": "服务器告警概览",
        "description": "该 API 用于查询服务器告警概览",
        "operationId": "ShowAlarmSummary",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/AuthToken"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/AlarmSummaryResponseBody"
            }
          },
          "400": {
            "description": "请求参数错误,请求失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "请求未鉴权",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "429": {
            "description": "请求过载",
            "schema": {
              "type": "string",
              "example": "too many requests"
            }
          },
          "500": {
            "description": "服务端内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "x-order": 1
      }
    }
  },
  "definitions": {
    "AlarmDeviceInfo": {
      "type": "object",
      "properties": {
        "alarm_device": {
          "type": "string",
          "description": "告警硬件"
        },
        "alarm_number": {
          "type": "integer",
          "description": "告警数量"
        }
      }
    },
    "AlarmSummaryResponseBody": {
      "type": "object",
      "description": "告警概况响应体",
      "properties": {
        "alarm_levels": {
          "description": "告警级别",
          "type": "array",
          "items": {
            "$ref": "#/definitions/AlarmLevelInfo"
          }
        },
        "alarm_devices": {
          "description": "告警设备信息,包括设备类型及告警数量",
          "type": "array",
          "items": {
            "$ref": "#/definitions/AlarmDeviceInfo"
          }
        },
        "alarm_hosts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AlarmHost"
          },
          "description": "故障服务器Top10"
        },
        "alarm_groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AlarmGroup"
          },
          "description": "告警分组"
        }
      }
    },
    "AlarmInfo": {
      "type": "object",
      "properties": {
        "alarm_device": {
          "type": "string",
          "description": "告警设备"
        },
        "alarm_number": {
          "type": "integer",
          "description": "告警数量"
        },
        "alarm_duration": {
          "type": "integer",
          "description": "告警时间",
          "format": "int64"
        }
      }
    },
    "Error": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "iMetal.00004000"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "error message"
        }
      },
      "type": "object"
    },
    "AlarmGroup": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "标签"
        },
        "alarm_devices": {
          "type": "array",
          "description": "告警设备",
          "items": {
            "$ref": "#/definitions/AlarmDeviceInfo"
          }
        },
        "sns": {
          "type": "array",
          "description": "sn列表",
          "items": {
            "type": "string",
            "description": "sn"
          }
        }
      }
    },
    "AlarmLevelInfo": {
      "type": "object",
      "properties": {
        "alarm_level": {
          "type": "integer",
          "description": "告警级别"
        },
        "alarm_number": {
          "type": "integer",
          "description": "告警数量"
        }
      }
    },
    "AlarmHost": {
      "type": "object",
      "properties": {
        "resource_name": {
          "type": "string",
          "description": "资源名称"
        },
        "resource_id": {
          "type": "string",
          "description": "资源id"
        },
        "alarm_infos": {
          "description": "告警信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/AlarmInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "project id",
      "type": "string"
    },
    "AuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "租户账号的iam token。",
      "type": "string"
    }
  },
  "host": "clouddc.cn-southwest-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}