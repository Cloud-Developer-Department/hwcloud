{
  "name": "ShowServerFirmwareAttributes",
  "summary": "查询服务器固件详细信息",
  "tags": "物理服务器管理",
  "productshort": "CloudDC",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/physicalservers/{id}/firmware-attributes": {
      "get": {
        "tags": [
          "物理服务器管理"
        ],
        "operationId": "ShowServerFirmwareAttributes",
        "consumes": [
          "application/x-www-form-urlencoded"
        ],
        "summary": "查询服务器固件详细信息",
        "description": "获取详细固件信息",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/ID"
          },
          {
            "$ref": "#/parameters/AuthToken"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "固件详细信息",
            "schema": {
              "$ref": "#/definitions/ListFirmwareDetails"
            }
          },
          "400": {
            "description": "请求参数错误,请求失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "请求未鉴权",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "429": {
            "description": "请求过载",
            "schema": {
              "type": "string",
              "example": "too many requests"
            }
          },
          "500": {
            "description": "服务端内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "x-order": 3
      }
    }
  },
  "definitions": {
    "FirmwareDetails": {
      "type": "object",
      "description": "固件详细信息",
      "properties": {
        "component_name": {
          "type": "string",
          "description": "组件",
          "example": "ActiveBMC"
        },
        "model": {
          "type": "string",
          "description": "型号",
          "example": "BMC-iBMC"
        },
        "manufacturer": {
          "type": "string",
          "description": "制造商",
          "example": "Huawei"
        },
        "version": {
          "type": "string",
          "description": "版本",
          "example": 6.68
        }
      }
    },
    "Error": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "iMetal.00004000"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "error message"
        }
      },
      "type": "object"
    },
    "ListFirmwareDetails": {
      "type": "array",
      "description": "固件详细信息列表",
      "items": {
        "$ref": "#/definitions/FirmwareDetails"
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "project id",
      "type": "string"
    },
    "ID": {
      "name": "id",
      "in": "path",
      "required": true,
      "type": "string",
      "description": "imetal server id",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "AuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "租户账号的iam token。",
      "type": "string"
    }
  },
  "host": "clouddc.cn-east-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
