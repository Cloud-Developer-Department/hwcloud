{
  "name": "ShowAlarmTrend",
  "summary": "服务器告警趋势",
  "tags": "物理服务器诊断",
  "productshort": "CloudDC",
  "region_id": "cn-south-1",
  "paths": {
    "/v1/{project_id}/physicalservers/alarms/trend": {
      "get": {
        "tags": [
          "物理服务器诊断"
        ],
        "summary": "服务器告警趋势",
        "description": "该 API 用于查询服务器概览、服务器开机状态和服务器运行状态",
        "operationId": "ShowAlarmTrend",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/AuthToken"
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "查询开始时间戳,单位秒,from 必须小于 to",
            "type": "string"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "查询结束时间戳,单位秒,from 必须小于 to",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/AlarmDailyTrendStatResponseBody"
            }
          },
          "400": {
            "description": "请求参数错误,请求失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "请求未鉴权",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "429": {
            "description": "请求过载",
            "schema": {
              "type": "string",
              "example": "too many requests"
            }
          },
          "500": {
            "description": "服务端内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "x-order": 1
      }
    }
  },
  "definitions": {
    "AlarmDailyTrend": {
      "type": "object",
      "properties": {
        "alarm_date": {
          "type": "string",
          "format": "date-time",
          "description": "告警时间"
        },
        "alarm_devices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AlarmDeviceInfo"
          },
          "description": "告警设备信息,包括设备类型及告警数量"
        },
        "alarm_levels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AlarmLevelInfo"
          },
          "description": "告警级别"
        }
      }
    },
    "AlarmDeviceInfo": {
      "type": "object",
      "properties": {
        "alarm_device": {
          "type": "string",
          "description": "告警硬件"
        },
        "alarm_number": {
          "type": "integer",
          "description": "告警数量"
        }
      }
    },
    "AlarmDailyTrendStatResponseBody": {
      "type": "object",
      "description": "服务器告警概览响应体",
      "properties": {
        "fault_hosts": {
          "description": "故障服务器数趋势",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FaultHostInfo"
          }
        },
        "alarm_daily_new_trends": {
          "description": "告警每日新增趋势",
          "type": "array",
          "items": {
            "$ref": "#/definitions/AlarmDailyTrend"
          }
        }
      }
    },
    "Error": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "iMetal.00004000"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "error message"
        }
      },
      "type": "object"
    },
    "FaultHostInfo": {
      "type": "object",
      "properties": {
        "fault_date": {
          "type": "string",
          "format": "date-time",
          "description": "告警时间"
        },
        "new_fault_host": {
          "type": "integer",
          "description": "新增故障机器数"
        },
        "fault_host": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "故障机器SN"
        }
      }
    },
    "AlarmLevelInfo": {
      "type": "object",
      "properties": {
        "alarm_level": {
          "type": "integer",
          "description": "告警级别"
        },
        "alarm_number": {
          "type": "integer",
          "description": "告警数量"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "project id",
      "type": "string"
    },
    "AuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "租户账号的iam token。",
      "type": "string"
    }
  },
  "host": "clouddc.cn-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}