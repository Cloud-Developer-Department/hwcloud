{
  "name": "UpdateIDcs",
  "summary": "修改 IDC 描述",
  "tags": "机房管理",
  "productshort": "CloudDC",
  "region_id": "cn-south-1",
  "paths": {
    "/v1/{project_id}/idcs": {
      "put": {
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "tags": [
          "机房管理"
        ],
        "summary": "修改 IDC 描述",
        "description": "修改 IDC 描述",
        "operationId": "UpdateIDcs",
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/AuthToken"
          },
          {
            "name": "UpdateIRackRequestBody",
            "in": "body",
            "required": true,
            "description": "请求参数对象",
            "schema": {
              "$ref": "#/definitions/IDcRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "服务器已成功处理了请求",
            "schema": {
              "type": "string",
              "example": "update idc success"
            }
          },
          "400": {
            "description": "请求参数错误,请求失败",
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          },
          "401": {
            "description": "请求错误,用户未授权",
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          },
          "429": {
            "description": "请求错误,请求频率过高",
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          },
          "500": {
            "description": "服务器处理请求失败",
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "IDcRequest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "019550c5-435a-756e-8c5c-ff43f5173627",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "iDC唯一标识符,结构为UUID。",
            "minLength": 1,
            "maxLength": 63
          },
          "description": {
            "type": "string",
            "description": "iDC描述",
            "example": "description of DC1",
            "maxLength": 255
          }
        }
      }
    },
    "FailedRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "description": "任务异常错误信息描述",
          "type": "string",
          "example": "error message"
        },
        "error_code": {
          "description": "任务异常错误信息编码",
          "type": "string",
          "example": "iMetal.00004000"
        }
      },
      "description": "异常时返回的异常信息"
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "project id",
      "type": "string"
    },
    "AuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "租户账号的iam token。",
      "type": "string"
    }
  },
  "host": "clouddc.cn-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}