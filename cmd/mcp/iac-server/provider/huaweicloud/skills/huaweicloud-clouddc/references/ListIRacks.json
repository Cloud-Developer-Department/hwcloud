{
  "name": "ListIRacks",
  "summary": "查询 iRack 实例列表",
  "tags": "机架管理",
  "productshort": "CloudDC",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/{project_id}/iracks": {
      "get": {
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "tags": [
          "机架管理"
        ],
        "summary": "查询 iRack 实例列表",
        "description": "用户下单后,用户上报iRack设备列表。该 API 可以查看 iRack 实例与关联imetal数量列表。",
        "operationId": "ListIRacks",
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/AuthToken"
          },
          {
            "name": "region",
            "in": "query",
            "required": true,
            "description": "区域",
            "type": "string"
          },
          {
            "name": "marker",
            "in": "query",
            "required": false,
            "description": "取值为上一页数据的最后一条记录的id",
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "分页大小,取值范围为[1,2000],默认2000",
            "type": "string",
            "default": 2000
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "排序升、降序",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "irack列表",
            "schema": {
              "$ref": "#/definitions/ListIRacksRsp"
            }
          },
          "400": {
            "description": "请求参数错误,请求失败",
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          },
          "401": {
            "description": "请求错误,用户未授权",
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          },
          "429": {
            "description": "请求错误,请求频率过高",
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          },
          "500": {
            "description": "服务器处理请求失败",
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Tag": {
      "type": "object",
      "description": "标签对象",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "键。最大长度128个字符。\nkey需要满足3.1 KEY字符集规范。",
          "example": "tag key"
        },
        "value": {
          "type": "string",
          "description": "值,每个值最大长度255个字符。",
          "example": "tag value"
        }
      }
    },
    "PageInfo": {
      "description": "分页信息",
      "properties": {
        "next_marker": {
          "type": "string",
          "description": "下一页查询地址",
          "example": "01939592-e8fe-7d9b-9332-d58948637755"
        },
        "previous_marker": {
          "type": "string",
          "description": "上一页查询地址",
          "example": "01939592-e8fe-7d9b-9332-4589486377a4"
        },
        "current_count": {
          "type": "integer",
          "format": "int32",
          "description": "本页返回条目数量",
          "example": 1
        }
      },
      "type": "object"
    },
    "ListIRacksRsp": {
      "type": "object",
      "required": [
        "iracks",
        "page_info"
      ],
      "properties": {
        "iracks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IRack"
          }
        },
        "page_info": {
          "$ref": "#/definitions/PageInfo"
        },
        "count": {
          "type": "integer",
          "description": "机柜总数"
        }
      }
    },
    "IRack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "",
          "description": "机柜ID,资源的唯一标识"
        },
        "name": {
          "type": "string",
          "example": "",
          "description": "机柜名称"
        },
        "dc": {
          "type": "string",
          "description": "机房名称",
          "example": ""
        },
        "region": {
          "type": "string",
          "description": "局点信息",
          "example": "cn-southwest-242"
        },
        "location": {
          "type": "string",
          "description": "机柜位置",
          "example": ""
        },
        "size": {
          "type": "string",
          "description": "机柜尺寸",
          "example": ""
        },
        "unit": {
          "type": "string",
          "description": "机柜U位",
          "example": ""
        },
        "power": {
          "type": "string",
          "description": "机柜额定功率",
          "example": ""
        },
        "description": {
          "type": "string",
          "description": "描述",
          "example": ""
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Tag"
          },
          "description": "标签",
          "example": ""
        },
        "order_status": {
          "type": "string",
          "description": "订单状态",
          "example": ""
        },
        "is_cloud_based": {
          "type": "string",
          "description": "是否云化纳管柜",
          "example": "true"
        },
        "operation_status": {
          "type": "integer",
          "format": "int32",
          "description": "操作状态"
        },
        "freeze_effect": {
          "type": "integer",
          "format": "int32",
          "description": "冻结效果"
        },
        "scene": {
          "type": "string",
          "description": "冻结场景"
        }
      }
    },
    "FailedRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "description": "任务异常错误信息描述",
          "type": "string",
          "example": "error message"
        },
        "error_code": {
          "description": "任务异常错误信息编码",
          "type": "string",
          "example": "iMetal.00004000"
        }
      },
      "description": "异常时返回的异常信息"
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "project id",
      "type": "string"
    },
    "AuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "租户账号的iam token。",
      "type": "string"
    }
  },
  "host": "clouddc.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}