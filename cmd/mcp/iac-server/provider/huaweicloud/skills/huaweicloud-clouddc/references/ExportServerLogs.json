{
  "name": "ExportServerLogs",
  "summary": "导出服务器日志请求",
  "tags": "物理服务器管理",
  "productshort": "CloudDC",
  "region_id": "cn-south-1",
  "paths": {
    "/v1/{project_id}/physicalservers/{id}/logs/exports": {
      "post": {
        "tags": [
          "物理服务器管理"
        ],
        "operationId": "ExportServerLogs",
        "summary": "导出服务器日志请求",
        "description": "创建服务器日志导出异步任务。根据ShowLogsExportStatus查询status,当status状态为completed时,调用DownloadServerLogs下载日志文件。",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/ID"
          },
          {
            "$ref": "#/parameters/AuthToken"
          }
        ],
        "responses": {
          "202": {
            "description": "日志压缩包流文件",
            "schema": {
              "$ref": "#/definitions/LogsExportTask"
            },
            "headers": {
              "Content-Disposition": {
                "description": "格式为 \"attachment; filename=${id}-dump.tar.gz\",id为服务器唯一标识SN",
                "type": "string"
              },
              "Content-Transfer-Encoding": {
                "description": "固定为 binary",
                "type": "string"
              },
              "Content-Type": {
                "description": "固定为 application/octet-stream;charset=UTF-8",
                "type": "string"
              }
            }
          },
          "401": {
            "description": "请求未鉴权",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "429": {
            "description": "请求过载",
            "schema": {
              "type": "string",
              "example": "too many requests"
            }
          },
          "500": {
            "description": "服务端内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "x-order": 5
      }
    }
  },
  "definitions": {
    "Error": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "iMetal.00004000"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "error message"
        }
      },
      "type": "object"
    },
    "LogsExportTask": {
      "type": "object",
      "required": [
        "export_id",
        "status",
        "percentage",
        "created_at"
      ],
      "properties": {
        "export_id": {
          "type": "string",
          "description": "export task id"
        },
        "status": {
          "type": "string",
          "description": "导出进度",
          "enum": [
            "processing",
            "completed"
          ]
        },
        "percentage": {
          "type": "string",
          "description": "导出进度百分比,范围0-100,如\"10%\""
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "导出开始时间,时间戳格式为ISO 8601,例如:2025-03-20T02:48:06+00:00"
        }
      },
      "description": "日志导出任务"
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "project id",
      "type": "string"
    },
    "ID": {
      "name": "id",
      "in": "path",
      "required": true,
      "type": "string",
      "description": "imetal server id",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "AuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "租户账号的iam token。",
      "type": "string"
    }
  },
  "host": "clouddc.cn-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}