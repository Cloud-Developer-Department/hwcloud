        "hours_of_powered_up": {
          "type": "integer",
          "format": "int32",
          "description": "驱动器上电运行时间(单位:h)",
          "example": 34997
        },
        "power_state": {
          "type": "string",
          "description": "驱动器电源状态",
          "example": "Spun Up"
        },
        "patrol_state": {
          "type": "string",
          "description": "驱动器巡检状态",
          "example": "DoneOrNotPatrolled"
        },
        "associated_resource": {
          "type": "string",
          "description": "驱动器的资源归属",
          "example": "cpu1"
        },
        "predicted_media_life_left_percent": {
          "type": "integer",
