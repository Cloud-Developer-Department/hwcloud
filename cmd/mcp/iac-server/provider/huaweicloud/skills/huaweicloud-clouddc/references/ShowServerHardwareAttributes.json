{
  "name": "ShowServerHardwareAttributes",
  "summary": "查询服务器硬件详细信息",
  "tags": "物理服务器管理",
  "productshort": "CloudDC",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/physicalservers/{id}/hardware-attributes": {
      "get": {
        "tags": [
          "物理服务器管理"
        ],
        "operationId": "ShowServerHardwareAttributes",
        "summary": "查询服务器硬件详细信息",
        "description": "获取详细硬件信息",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/ID"
          },
          {
            "$ref": "#/parameters/AuthToken"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "硬件详细信息",
            "schema": {
              "$ref": "#/definitions/HardwareDetails"
            }
          },
          "400": {
            "description": "请求参数错误,请求失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "请求未鉴权",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "429": {
            "description": "请求过载",
            "schema": {
              "type": "string",
              "example": "too many requests"
            }
          },
          "500": {
            "description": "服务端内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "x-order": 2
      }
    }
  },
  "definitions": {
