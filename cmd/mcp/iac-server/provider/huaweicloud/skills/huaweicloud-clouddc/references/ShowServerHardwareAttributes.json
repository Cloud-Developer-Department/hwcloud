        "driver_version": {
          "type": "string",
          "description": "网络适配器的驱动版本",
          "example": null
        },
        "associated_resource": {
          "type": "string",
          "description": "网络适配器的资源归属",
          "example": "CPU1"
        },
        "firmware_version": {
          "type": "string",
          "description": "网络适配器的固件版本",
          "example": null
        },
        "health": {
          "type": "string",
          "description": "健康状态"
        },
        "network_ports": {
          "type": "array",
