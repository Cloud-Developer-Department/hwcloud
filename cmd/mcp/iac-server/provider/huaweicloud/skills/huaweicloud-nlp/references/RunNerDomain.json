  "definitions": {
    "PostDomainNerResponse": {
      "properties": {
        "named_entities": {
          "type": "array",
          "description": "命名实体识别结果。调用失败时无此字段。",
          "items": {
            "$ref": "#/definitions/DomainNamedEntity"
          }
        },
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参见错误码。调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。调用成功时无此字段。"
        }
      },
      "description": "领域版命名实体识别响应体。"
    },
    "DomainNamedEntity": {
      "required": [
        "len",
        "offset",
        "tag",
        "word"
      ],
      "properties": {
        "word": {
          "type": "string",
          "description": "实体文本。"
        },
        "tag": {
          "type": "string",
          "description": "实体类型,枚举类型。\n通用领域:支持人名nr,地名ns,机构名nt,时间点tpt,日期day,百分比pct,货币额度mny,序数词ord,计量规格词qtt,民族race,职业job,邮箱email,国家coun,节日fest。\n商务领域:支持公司名com、品牌名bra、职业job、职位post、邮箱email、手机号码cell、电话号码tele、IP地址ip、身份证号id、网址web。\n娱乐领域:支持电影名mov、动漫anime、书名book、互联网int、歌名song、产品名pro、电视剧名dra、电视节目名tv。"
        },
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "实体文本在待分析文本中的起始位置。"
        },
        "len": {
          "type": "integer",
          "format": "int32",
          "description": "实体文本长度。"
        }
      },
      "description": "命名实体类"
    },
    "PostDomainNerRequest": {
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "待分析文本,长度为1~512,文本编码为UTF-8。",
          "minLength": 1,
          "maxLength": 512
        },
        "lang": {
          "type": "string",
          "description": "支持的文本语言类型,目前只支持中文,默认为zh。",
          "enum": [
            "zh"
          ],
          "default": "zh"
        },
        "domain": {
          "type": "string",
          "description": "支持的领域类型,目前支持通用(general)领域、商务(business)领域、娱乐(entertainment)领域,默认为general。",
          "default": "general",
          "enum": [
            "general",
            "business",
            "entertainment"
          ]
        }
      },
      "description": "命名实体识别post请求体"
    }
  },
