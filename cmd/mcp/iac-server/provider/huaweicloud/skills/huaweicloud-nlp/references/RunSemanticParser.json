  "definitions": {
    "Slot": {
      "required": [
        "length",
        "normalized_word",
        "offset",
        "tag",
        "word"
      ],
      "properties": {
        "word": {
          "type": "string",
          "description": "实体文本。"
        },
        "tag": {
          "type": "string",
          "description": "实体类型。对于每个意图类别所支持的实体类型分别为:\nweather:date(日期),time(时间),location(位置)\ntime:location(位置),timezone(时区)\nnews:genre(风格)\njoke:genre(风格)\ntranslation:content(内容)\nnotification:content(内容),date(日期),time(时间),singer(歌手)\nalarm:date(日期),time:(时间)\nmusic:singer(歌手),song(歌曲),content(内容)"
        },
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "实体文本在待分析文本中的起始位置。"
        },
        "length": {
          "type": "integer",
          "format": "int32",
          "description": "实体文本长度。"
        },
        "normalized_word": {
          "type": "string",
          "description": "同义词或者其他标准表达的词,默认为原始的word。"
        }
      },
      "description": ""
    },
    "IntentReq": {
      "required": [
        "text"
      ],
      "properties": {
        "lang": {
          "enum": [
            "zh"
          ],
          "type": "string",
          "description": "支持的文本语言类型,目前只支持中文,默认为zh。"
        },
        "text": {
          "type": "string",
          "description": "待分析文本列表,UTF-8编码,限定32个字符以内,文本长度超过32个字符时,只检测前32个字符。"
        }
      },
      "description": ""
    },
    "IntentResp": {
      "properties": {
        "result": {
          "description": "调用成功时的返回情感信息。调用失败时无此字段。",
          "$ref": "#/definitions/IntentResult"
        },
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码。调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。调用成功时无此字段。"
        }
      },
      "description": ""
    },
    "IntentResult": {
      "required": [
        "confidence",
        "label",
        "slots",
        "text"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "format": "float",
          "description": "标签label的置信度。"
        },
        "label": {
          "type": "string",
          "description": "文本的意图标签。标签共有以下9类,取值如下:\nweather:天气\ntime:报时\nnews:新闻\njoke:笑话\ntranslation:翻译\nnotification:提醒\nalarm:闹钟\nmusic:音乐\nother:其它"
        },
        "slots": {
          "type": "array",
          "description": "slot数据结构",
          "items": {
            "$ref": "#/definitions/Slot"
          }
        },
        "text": {
          "type": "string",
          "description": "返回待分析文本。"
        }
      },
      "description": ""
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "nlp-ext.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "post",
  "uri": null
