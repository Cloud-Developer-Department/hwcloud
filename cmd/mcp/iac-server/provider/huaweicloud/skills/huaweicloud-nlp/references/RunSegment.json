  "definitions": {
    "Word": {
      "required": [
        "content",
        "pos"
      ],
      "properties": {
        "content": {
          "type": "string",
          "description": "词汇文本。"
        },
        "pos": {
          "type": "string",
          "description": "词汇对应的词性。"
        }
      },
      "description": "词汇类"
    },
    "SegmentRequest": {
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "待分词文本,长度为1~512,文本编码为UTF-8。",
          "minLength": 1,
          "maxLength": 512
        },
        "pos_switch": {
          "type": "integer",
          "format": "int32",
          "enum": [
            0,
            1
          ],
          "description": "是否开启词性标注功能,1为开启,0为关闭,默认为关闭。",
          "default": 0
        },
        "lang": {
          "type": "string",
          "description": "支持的文本语言类型,目前支持中文(zh)和英文(en),默认为中文。",
          "enum": [
            "zh",
            "en"
          ],
          "default": "zh"
        },
        "criterion": {
          "type": "string",
          "description": "支持的分词规范。\n中文分词标准目前支持PKU(北大分词标准)、CTB(宾州中文树库标准),默认为PKU。\n英文分词标准默认为Penn TreeBank(宾州树库标准),不需要传入该参数。",
          "enum": [
            "PKU",
            "CTB"
          ],
          "default": "PKU"
        }
      },
      "description": "分词post请求体"
    },
    "SegmentResponse": {
      "properties": {
        "words": {
          "type": "array",
          "description": "分词结果。调用失败时无此字段。",
          "items": {
            "$ref": "#/definitions/Word"
          }
        },
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参见错误码。调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。调用成功时无此字段。"
        }
      },
      "description": "分词结果响应信息"
    }
  },
