  "definitions": {
    "CreatePoem": {
      "required": [
        "title",
        "type"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "诗歌标题,目前仅支持UTF-8编码,仅支持中文,长度为1-10",
          "minLength": 1,
          "maxLength": 10
        },
        "type": {
          "type": "integer",
          "format": "int32",
          "enum": [
            0,
            1,
            2,
            3
          ],
          "default": 0,
          "description": "诗歌类型,取值如下:\n0:五言绝句;\n1:七言绝句;\n2:五言律诗;\n3:七言律诗;"
        },
        "acrostic": {
          "type": "boolean",
          "description": "藏头诗,取值如下:\n取值为true,为藏头诗;\n取值为false,非藏头诗;\n默认取值为false。"
        }
      },
      "description": ""
    },
    "CreatePoemResp": {
      "properties": {
        "poem": {
          "type": "array",
          "description": "根据文本请求体,返回生成的诗歌。调用失败时无此字段。",
          "items": {
            "type": "string"
          }
        },
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参见错误码。调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。调用成功时无此字段。"
        }
      },
      "description": ""
    }
