  "definitions": {
    "AspectSentimentAdvanceRequest": {
      "required": [
        "content",
        "type"
      ],
      "properties": {
        "content": {
          "type": "string",
          "description": "待分析文本。文本编码要求为utf-8,仅支持中文。 限定4096个字符以内,建议文本长度300个字符以内。"
        },
        "type": {
          "type": "integer",
          "format": "int32",
          "enum": [
            1,
            2
          ],
          "default": 1,
          "description": "取值如下:\n1 手机领域\n2 汽车领域"
        }
      },
      "description": ""
    },
    "AspectSentimentAdvanceResponse": {
      "properties": {
        "content": {
          "type": "string",
          "description": "待分析文本"
        },
        "label": {
          "type": "integer",
          "format": "int32",
          "description": "该文本的整体情感标签,取值如下:\n0  负向\n1  正向"
        },
        "confidence": {
          "type": "number",
          "format": "float",
          "description": "该文本整体情感label的置信度,小数点精确到3位。"
        },
        "aspect_opinions": {
          "type": "array",
          "description": "属性情感挖掘列表",
          "items": {
            "$ref": "#/definitions/AspectAdvanceOpinion"
          }
        },
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参见错误码。调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。调用成功时无此字段。"
        }
      },
      "description": "属性级情感分析响应"
    },
    "AspectAdvanceOpinion": {
      "required": [
        "aspect_category",
        "aspect_term",
        "label",
        "opinion_term",
        "span"
      ],
      "properties": {
        "aspect_category": {
          "type": "string",
          "description": "属性类别\n手机领域:['整体','内存','外形设计','屏幕','性价比','拍照','散热','电池','人脸识别','信号','指纹识别','音质','握持手感','活动配件赠品','防水','客服','物流派送','包装']\n汽车领域:['动力','外观','内饰','空间','操控', '舒适性', '性价比','能耗']"
        },
        "label": {
          "type": "integer",
          "format": "int32",
          "description": "情感标签,0:负向,1:正向"
        },
        "confidence": {
          "type": "number",
          "format": "float",
          "description": "情感标签置信度"
        },
        "aspect_term": {
          "type": "string",
          "description": "属性描述词,预留参数,暂不支持。"
        },
        "opinion_term": {
          "type": "string",
          "description": "观点描述词,预留参数,暂不支持。"
        },
        "span": {
          "type": "array",
          "description": "属性评价起始位置,预留参数,暂不支持。",
          "items": {
            "type": "integer",
            "format": "int32",
            "description": ""
          }
        },
        "tag": {
          "type": "string",
          "description": "观点标签,预留参数,暂不支持。"
        }
      },
      "description": "属性观点列表"
    }
  },
