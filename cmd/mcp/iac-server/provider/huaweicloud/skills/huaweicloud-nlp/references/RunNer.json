  "definitions": {
    "NerRequest": {
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "待分析文本,中文长度为1~512,英文和西班牙文长度为1~2000,文本编码为UTF-8。",
          "minLength": 1,
          "maxLength": 2000
        },
        "lang": {
          "type": "string",
          "description": "支持的文本语言类型,目前支持中文(zh),英文(en),和西班牙文(es),默认为中文。",
          "enum": [
            "zh",
            "en",
            "es"
          ],
          "default": "zh"
        }
      },
      "description": "命名实体识别post请求体"
    },
    "NamedEntity": {
      "required": [
        "len",
        "offset",
        "tag",
        "word"
      ],
      "properties": {
        "word": {
          "type": "string",
          "description": "实体文本。"
        },
        "tag": {
          "type": "string",
          "description": "实体类型,枚举类型。\n中文支持人名“nr”,地名“ns”,机构名“nt”,时间“t”。\n英文支持人名“per”,地名“loc”,机构名“org”,时间“t”。\n西班牙文支持人名“per”,地名“loc”,机构名“org”,时间“t”。"
        },
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "实体文本在待分析文本中的起始位置。"
        },
        "len": {
          "type": "integer",
          "format": "int32",
          "description": "实体文本长度。"
        }
      },
      "description": "命名实体。"
    },
    "NerResponse": {
      "required": [
        "named_entities"
      ],
      "properties": {
        "named_entities": {
          "type": "array",
          "description": "命名实体识别结果。调用失败时无此字段。",
          "items": {
            "$ref": "#/definitions/NamedEntity"
          }
        },
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参见错误码。调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。调用成功时无此字段。"
        }
      },
      "description": "ner响应体"
    }
  },
