  "definitions": {
    "HWCloudSentimentReq": {
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "string",
          "description": "待分析文本。文本编码要求为utf-8。仅支持中文和英文情感分析。\n限定180个字符以内,超过180个字符,只截取前180个字符。"
        },
        "lang": {
          "type": "string",
          "description": "支持的文本语言类型,目前支持中文(zh)和英文(en),默认为中文。",
          "enum": [
            "en",
            "zh"
          ]
        }
      },
      "description": ""
    },
    "HWCloudSentimentResp": {
      "required": [
        "confidence",
        "content",
        "label"
      ],
      "properties": {
        "label": {
          "type": "integer",
          "format": "int32",
          "description": "该文本的分析结果标签,取值如下:\n0 负向\n1 正向"
        },
        "confidence": {
          "type": "number",
          "format": "float",
          "description": "标签label的置信度。小数点精确到(6)位。"
        },
        "content": {
          "type": "string",
          "description": "待分析文本"
        }
      },
      "description": "result字段数据结构说明"
    },
    "GeneralRep": {
      "properties": {
        "result": {
          "description": "情感信息。调用失败时无此字段。",
          "$ref": "#/definitions/HWCloudSentimentResp"
        },
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参见错误码。调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。调用成功时无此字段。"
        }
      },
      "description": "情感分析返回信息"
    }
  },
