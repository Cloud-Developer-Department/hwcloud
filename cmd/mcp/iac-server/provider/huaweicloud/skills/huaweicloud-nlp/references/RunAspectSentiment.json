  "definitions": {
    "AspectSentimentResponse": {
      "properties": {
        "text": {
          "type": "string",
          "description": "待分析文本"
        },
        "label": {
          "type": "integer",
          "format": "int32",
          "description": "该文本的整体情感标签,取值如下:\n0  负向\n1  正向"
        },
        "confidence": {
          "type": "number",
          "format": "float",
          "description": "该文本整体情感label的置信度,小数点精确到3位。"
        },
        "aspect_opinions": {
          "type": "array",
          "description": "属性级情感挖掘列表",
          "items": {
            "$ref": "#/definitions/AspectOpinion"
          }
        },
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参见错误码。调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。调用成功时无此字段。"
        }
      },
      "description": "属性级情感分析响应"
    },
    "AspectSentimentRequest": {
      "required": [
        "content",
        "type"
      ],
      "properties": {
        "content": {
          "type": "string",
          "description": "待分析文本。仅支持中文,文本编码要求为utf-8。 建议文本长度1000个字符以内。"
        },
        "type": {
          "type": "integer",
          "format": "int32",
          "enum": [
            1
          ],
          "default": 1,
          "description": "取值如下:\n1 手机领域"
        }
      },
      "description": ""
    },
    "AspectOpinion": {
      "required": [
        "aspect_category",
        "aspect_term",
        "label",
        "opinion_term",
        "span"
      ],
      "properties": {
        "aspect_category": {
          "type": "string",
          "description": "属性类别\n手机领域:['整体','性价比', '赠品','分期', '配件', '活动', '品牌', '物流派送', '包装', '游戏性能', '系统性能', '芯片', '屏幕', '电池', '自拍', '拍照', '音质', '散热', '防水', '信号', '解锁', '外形设计', '握持手感', '质感', '颜色', '内存/容量', '客服/售后', '其他']"
        },
        "aspect_term": {
          "type": "string",
          "description": "属性词,与对应的描述词至少出现其中之一,可能为null。"
        },
        "opinion_term": {
          "type": "string",
          "description": "描述词,与对应的属性词至少出现其中之一,可能为null。"
        },
        "span": {
          "type": "array",
          "description": "共4个数字,分别表示属性词和描述词在文本中的起始位置和结束位置。若属性词为null,则1, 2两位不展示;若描述词为null,则3, 4位不展示。",
          "items": {
            "type": "integer",
            "format": "int32",
            "description": ""
          }
        },
        "label": {
          "type": "integer",
          "format": "int32",
          "description": "情感标签,0:负向,1:正向"
        },
        "confidence": {
          "type": "number",
          "format": "float",
          "description": "情感标签置信度"
        },
        "tag": {
          "type": "string",
          "description": "属性-描述词片段所对应的标签。若分类为'其他',则不给出标签,返回null。"
        }
      },
      "description": "属性观点列表"
    }
  },
