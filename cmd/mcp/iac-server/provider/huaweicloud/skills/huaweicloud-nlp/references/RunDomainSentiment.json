  "definitions": {
    "HWCloudSentimentResp": {
      "required": [
        "confidence",
        "content",
        "label"
      ],
      "properties": {
        "label": {
          "type": "integer",
          "format": "int32",
          "description": "该文本的分析结果标签,取值如下:\n0 负向\n1 正向"
        },
        "confidence": {
          "type": "number",
          "format": "float",
          "description": "标签label的置信度。小数点精确到(6)位。"
        },
        "content": {
          "type": "string",
          "description": "待分析文本"
        }
      },
      "description": "result字段数据结构说明"
    },
    "DomainSentimentReq": {
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "string",
          "description": "待分析文本。文本编码要求为utf-8。仅支持中文情感分析。\ntype为1(电商领域评论)时,限定200个字符以内,文本长度超过200个字符时,只检测前200个字符。\ntype为2(汽车领域评论)时,限定400个字符以内,文本长度超过400个字符时,只检测前400个字符。"
        },
        "type": {
          "type": "integer",
          "format": "int32",
          "enum": [
            0,
            1,
            2
          ],
          "description": "取值如下:\n0:自适应领域,根据输入内容自动识别适应领域。\n1:电商领域,适用于电商领域评论。\n2:汽车领域,适用于汽车领域评论。"
        }
      },
      "description": "请求消息"
    },
    "GeneralRep": {
      "properties": {
        "result": {
          "description": "情感信息。调用失败时无此字段。",
          "$ref": "#/definitions/HWCloudSentimentResp"
        },
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参见错误码。调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。调用成功时无此字段。"
        }
      },
      "description": "情感分析返回信息"
    }
  },
