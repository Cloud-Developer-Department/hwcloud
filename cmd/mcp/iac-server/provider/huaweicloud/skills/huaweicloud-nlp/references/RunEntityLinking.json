  "definitions": {
    "PostEntityLinkingRequest": {
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "example": "李娜唱的青藏高原真好听",
          "description": "待分析文本,长度为1~50,文本编码为UTF-8。",
          "minLength": 1,
          "maxLength": 50
        },
        "lang": {
          "type": "string",
          "description": "支持的文本语言类型,目前只支持中文,默认为zh。",
          "enum": [
            "zh"
          ],
          "default": "zh"
        }
      },
      "description": "实体链接post请求体"
    },
    "PostEntityLinkingResponse": {
      "required": [
        "entities"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "description": "识别出的实体列表",
          "items": {
            "$ref": "#/definitions/LinkedEntity"
          }
        }
      },
      "description": "实体链接响应体"
    },
    "LinkedEntity": {
      "required": [
        "entity_title",
        "mention",
        "offset"
      ],
      "properties": {
        "mention": {
          "type": "string",
          "description": "实体指称"
        },
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "偏移量"
        },
        "entity_title": {
          "type": "string",
          "description": "实体名称"
        }
      },
      "description": "链接的实体 类"
    }
  },
