  "paths": {
    "/v1/{project_id}/nlp-fundamental/entity-linking": {
      "post": {
        "tags": [
          "自然语言处理基础服务"
        ],
        "summary": "实体链接",
        "description": "针对通用领域的文本进行实体链接分析,识别出其中的实体,并返回实体相关信息。\n在使用本API之前, 需要您完成服务申请, 具体操作流程请参见[申请服务](https://support.huaweicloud.com/api-nlp/nlp_03_0004.html)章节。",
        "operationId": "RunEntityLinking",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "来自公有云的Project ID,用于资源隔离。",
            "required": true,
            "type": "string",
            "x-order": 1
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-order": 2
          },
          {
            "in": "body",
            "name": "postEntityLinkingReq",
            "description": "请求消息体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PostEntityLinkingRequest"
            },
            "x-order": 3
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "entities": [
                  {
                    "mention": "李娜",
                    "offset": 0,
                    "entity_title": "李娜(流行歌手、佛门女弟子)"
                  },
                  {
                    "mention": "青藏高原",
                    "offset": 4,
                    "entity_title": "青藏高原(李娜演唱歌曲)"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/PostEntityLinkingResponse"
            }
          }
        },
