        "operationId": "ListServiceSetDetail",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token,用于携带用户身份信息,配置后可通过接口鉴权,可通过[如何获取用户Token](cfw_02_0008.xml)获取。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,可以通过调用API获取,也可以从控制台获取。[项目ID获取方式](cfw_02_0015.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "set_id",
            "in": "path",
            "description": "服务组id,可通过[获取服务组列表接口](ListServiceSets.xml)查询获得,通过返回值中的data.records.set_id(.表示各对象之间层级的区分)获得。",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目ID,用户根据组织规划企业项目,对应的ID为企业项目ID,可通过[如何获取企业项目ID](cfw_02_0027.xml)获取,用户未开启企业项目时为0",
            "required": false,
            "type": "string"
          },
          {
            "name": "fw_instance_id",
            "in": "query",
            "description": "防火墙ID,可通过[防火墙ID获取方式](cfw_02_0028.xml)获取",
            "required": false,
            "type": "string"
          },
          {
            "name": "query_service_set_type",
            "in": "query",
            "description": "查询服务组类型,0表示自定义服务组,1表示预定义服务组",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "data": {
                  "service_set_type": 0,
                  "id": "221cfdca-3abf-4c30-ab0d-516a03c70866",
                  "name": "ceshi2"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ServiceSetDetailResponse"
            }
          },
          "400": {
            "description": "Bad Request,错误的请求",
            "examples": {
              "application/json": {
                "error_code": "CFW.00200005",
                "error_msg": "操作内容不存在"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "Unauthorized,错误的请求"
          },
          "403": {
            "description": "Forbidden,禁止访问"
          },
          "404": {
            "description": "Not Found,网页未找到"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-request-examples-url-1": "https://{Endpoint}/v1/9d80d070b6d44942af73c9c3d38e0429/service-sets/221cfdca-3abf-4c30-ab0d-516a03c70866",
        "x-request-examples-description-1": "查询项目id为9d80d070b6d44942af73c9c3d38e0429,服务组id为221cfdca-3abf-4c30-ab0d-516a03c70866的服务组的细节",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-order": 7
      }
    }
  },
