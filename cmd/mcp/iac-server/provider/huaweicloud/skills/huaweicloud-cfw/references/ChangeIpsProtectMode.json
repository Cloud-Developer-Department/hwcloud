      "properties": {
        "object_id": {
          "type": "string",
          "description": "防护对象id,是创建云防火墙后用于区分互联网边界防护和VPC边界防护的标志id,可通过调用[查询防火墙实例接口](ListFirewallDetail.xml),type为0时,object_id为互联网边界防护对象ID,type为1时,object_id为VPC边界防护对象ID。",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "mode": {
          "type": "integer",
          "description": "ips防护模式,0:观察模式,1:严格模式,2:中等模式,3:宽松模式"
        }
      },
