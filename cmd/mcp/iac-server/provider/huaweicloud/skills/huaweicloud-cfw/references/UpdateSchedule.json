  "definitions": {
    "ScheduleInfoDTO": {
      "type": "object",
      "required": [
        "name",
        "object_id"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "description": "**参数解释**:\n防护对象ID,是创建云防火墙后用于区分互联网边界防护和VPC边界防护的标志id,可通过调用[查询防火墙实例接口](ListFirewallDetail.xml)获得,通过返回值中的data.records.protect_objects.object_id(.表示各对象之间层级的区分)获得,注意type为0的为互联网边界防护对象id,type为1的为VPC边界防护对象id。\n**约束限制**:\n不涉及\n**取值范围**:\n32位UUID\n**默认取值**:\n不涉及",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
        },
        "name": {
          "type": "string",
          "description": "**参数解释**:\n时间表名称\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
          "pattern": "^[^<>]{0,255}$"
        },
        "description": {
          "type": "string",
          "description": "**参数解释**:\n时间表描述\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
          "pattern": "^[^<>]{0,255}$"
        },
        "periodic": {
          "type": "array",
          "description": "**参数解释**:\n周期计划\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "integer",
                "format": "int32",
                "description": "**参数解释**:\n周期计划类型\n**约束限制**:\n不涉及\n**取值范围**:\n0:每天\n1:每周的某几天\n2:每周的一段时间\n**默认取值**:\n不涉及",
                "minimum": 0,
                "maximum": 2
              },
              "start_time": {
                "type": "string",
                "example": "12:24:00",
                "description": "**参数解释**:\n周期计划开始时间\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
                "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
              },
              "end_time": {
                "type": "string",
                "example": "15:24:00",
                "description": "**参数解释**:\n周期计划结束时间\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
                "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
              },
              "week_mask": {
                "type": "array",
                "description": "**参数解释**:\n每周的某几天\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
                "items": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 1,
                  "maximum": 7
                },
                "maxItems": 7,
                "minItems": 0
              },
              "start_week": {
                "type": "integer",
                "format": "int32",
                "description": "**参数解释**:\n每周周期计划开始日\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
                "minimum": 1,
                "maximum": 7
              },
              "end_week": {
                "type": "integer",
                "format": "int32",
                "description": "**参数解释**:\n每周周期计划结束日\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
                "minimum": 1,
                "maximum": 7
              }
            },
            "required": [
              "end_time",
              "start_time",
              "type"
            ]
          },
          "maxItems": 16,
          "minItems": 0
        },
        "absolute": {
          "type": "object",
          "description": "**参数解释**:\n绝对时间计划\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
          "properties": {
            "start_time": {
              "type": "integer",
              "format": "int64",
              "description": "**参数解释**:\n绝对计划开始时间\n**约束限制**:\n不涉及\n**取值范围**:\n时间戳(毫秒级)\n**默认取值**:\n不涉及",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "end_time": {
              "type": "integer",
              "format": "int64",
              "description": "**参数解释**:\n绝对计划结束时间\n**约束限制**:\n不涉及\n**取值范围**:\n时间戳(毫秒级)\n**默认取值**:\n不涉及",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          }
        }
      }
