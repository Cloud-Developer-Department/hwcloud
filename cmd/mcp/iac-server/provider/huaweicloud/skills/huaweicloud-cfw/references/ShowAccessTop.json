        },
        "x-request-examples-url-1": "https://{Endpoint}/v1/a16df7cf1d094befa6bbc72cbf51e93a/cfw/logs/access-top?fw_instance_id=a7df0f6c-da03-4511-ad0b-b17b589ff0ec&item=strategy_dashboard&range=0",
        "x-request-examples-description-1": "查询项目ID为a16df7cf1d094befa6bbc72cbf51e93a防火墙ID为c598d612-8112-465c-bffd-863d4ce85a50时间范围为1小时的策略概览",
        "x-method-annotations": [
          "@IamAuthMeta(rbac = {RoleConst.TE_ADMIN, RoleConst.OP_SERVICE, RoleConst.READ_ONLY, RoleConst.TE_ADMIN_RESTRICTED, RoleConst.TE_ADMIN_SUSPENDED}, needRbacCheck = false, needCbcCheck = false, authContextInitializerName =\"FirewallInitializer\")",
          "@IamAuthAction(iam3Action = IamV3Action.GET_ATTACK_LOG_REPORT, iam5Action = CommonConstant.IAM5_GET_ACCESS_CONTROL_LOG_STATISTICS)",
          "@IamAuthMetaV5(needCbcCheck = false, needAbacResourceCheck = true, authContextInitializerName =\"FirewallInitializer\")",
          "@IamAuthParam(instanceId = \"fw_instance_id\")"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api"
      }
    }
  },
