{
  "name": "AddLogConfig",
  "summary": "创建日志配置",
  "tags": "日志管理",
  "productshort": "CFW",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/cfw/logs/configuration": {
      "post": {
        "tags": [
          "Log Management"
        ],
        "summary": "创建日志配置",
        "description": "创建日志配置",
        "operationId": "AddLogConfig",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,可以通过调用API获取,也可以从控制台获取。[项目ID获取方式](cfw_02_0015.xml)",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "LogConfigDto",
            "description": "添加LTS日志配置",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LogConfigDto"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token,用于携带用户身份信息,配置后可通过接口鉴权,可通过[如何获取用户Token](cfw_02_0008.xml)获取。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
            "required": true,
            "type": "string"
          },
          {
            "name": "fw_instance_id",
            "in": "query",
            "description": "防火墙ID,可通过[防火墙ID获取方式](cfw_02_0028.xml)获取",
            "required": true,
            "type": "string"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目ID,用户根据组织规划企业项目,对应的ID为企业项目ID,可通过[如何获取企业项目ID](cfw_02_0027.xml)获取,用户未开启企业项目时为0",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "data": "4d6c860a-0338-49e8-ac64-fcaeb4182ba5"
              }
            },
            "schema": {
              "$ref": "#/definitions/AddLogConfigResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "https://{Endpoint}/v1/408972e72dcd4c1a9b033e955802a36b/cfw/logs/configuration?fw_instance_id=4d6c860a-0338-49e8-ac64-fcaeb4182ba5&enterprise_project_id=default",
        "x-request-examples-description-1": "给项目id为408972e72dcd4c1a9b033e955802a36b下的防火墙4d6c860a-0338-49e8-ac64-fcaeb4182ba5添加日志流配置,lts分组id为20282428-a8f9-4e75-8246-165e64cf8ba8,访问控制日志流关闭,流量日志流关闭,攻击日志流关闭,lts关闭。",
        "x-request-examples-text-1": {
          "fw_instance_id": "4d6c860a-0338-49e8-ac64-fcaeb4182ba5",
          "lts_enable": 0,
          "lts_log_group_id": "20282428-a8f9-4e75-8246-165e64cf8ba8",
          "lts_attack_log_stream_enable": 0,
          "lts_access_log_stream_enable": 0,
          "lts_flow_log_stream_enable": 0
        },
        "x-request-examples-1": {
          "fw_instance_id": "4d6c860a-0338-49e8-ac64-fcaeb4182ba5",
          "lts_enable": 0,
          "lts_log_group_id": "20282428-a8f9-4e75-8246-165e64cf8ba8",
          "lts_attack_log_stream_enable": 0,
          "lts_access_log_stream_enable": 0,
          "lts_flow_log_stream_enable": 0
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-order": 8
      }
    }
  },
  "definitions": {
    "AddLogConfigResponseBody": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "description": "添加日志配置返回值,为防火墙ID"
        }
      }
    },
    "LogConfigDto": {
      "type": "object",
      "required": [
        "fw_instance_id",
        "lts_enable",
        "lts_log_group_id"
      ],
      "properties": {
        "fw_instance_id": {
          "type": "string",
          "description": "防火墙ID,可通过[防火墙ID获取方式](cfw_02_0028.xml)获取"
        },
        "lts_enable": {
          "type": "integer",
          "format": "int32",
          "description": "是否开启LTS,1表示是,0表示不是"
        },
        "lts_log_group_id": {
          "type": "string",
          "description": "LTS日志分组id,可通过查询LTS(云日志服务)下查询账号下所有日志组接口获得,通过返回值中的log_groups.log_group_id(.表示各对象之间层级的区分)获得"
        },
        "lts_attack_log_stream_id": {
          "type": "string",
          "description": "攻击日志流id,可通过查询LTS(云日志服务)下查询指定日志组下的所有日志流接口获得,通过返回值中的log_streams.log_stream_id(.表示各对象之间层级的区分)获得"
        },
        "lts_attack_log_stream_enable": {
          "type": "integer",
          "format": "int32",
          "description": "是否开启攻击日志流,1表示是,0表示不是"
        },
        "lts_access_log_stream_id": {
          "type": "string",
          "description": "访问控制日志流id,可通过查询LTS(云日志服务)下查询指定日志组下的所有日志流接口获得,通过返回值中的log_streams.log_stream_id(.表示各对象之间层级的区分)获得"
        },
        "lts_access_log_stream_enable": {
          "type": "integer",
          "format": "int32",
          "description": "是否开启访问控制流,1表示是,0表示不是"
        },
        "lts_flow_log_stream_id": {
          "type": "string",
          "description": "流量日志id,可通过查询LTS(云日志服务)下查询指定日志组下的所有日志流接口获得,通过返回值中的log_streams.log_stream_id(.表示各对象之间层级的区分)获得"
        },
        "lts_flow_log_stream_enable": {
          "type": "integer",
          "format": "int32",
          "description": "是否开启流量日志,1表示是,0表示不是"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cfw.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
