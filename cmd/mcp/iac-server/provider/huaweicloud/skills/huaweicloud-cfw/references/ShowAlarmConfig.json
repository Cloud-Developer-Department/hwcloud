{
  "name": "ShowAlarmConfig",
  "summary": "获取告警配置信息",
  "tags": "告警配置管理",
  "productshort": "CFW",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/cfw/alarm/config": {
      "get": {
        "tags": [
          "告警配置管理"
        ],
        "summary": "获取告警配置信息",
        "description": "获取告警配置信息",
        "operationId": "ShowAlarmConfig",
        "parameters": [
          {
            "name": "fw_instance_id",
            "in": "query",
            "description": "防火墙ID,可通过[防火墙ID获取方式](cfw_02_0028.xml)获取",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,可以通过调用API获取,也可以从控制台获取。可通过[项目ID获取方式](cfw_02_0015.xml)获取",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,可通过[如何获取用户Token](cfw_02_0008.xml)获取",
            "required": true,
            "type": "string"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目ID,用户根据组织规划企业项目,对应的ID为企业项目ID,可通过[如何获取企业项目ID](cfw_02_0027.xml)获取,用户未开启企业项目时为0",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "alarm_configs": [
                  {
                    "alarm_time_period": 0,
                    "alarm_type": 1,
                    "enable_status": 0,
                    "severity": "1"
                  },
                  {
                    "alarm_time_period": 0,
                    "alarm_type": 2,
                    "enable_status": 0,
                    "severity": "3"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/HttpAlarmConfigListResponse"
            }
          },
          "401": {
            "description": "Unauthorized,错误的请求",
            "schema": {}
          },
          "403": {
            "description": "Forbidden,禁止访问",
            "schema": {}
          },
          "404": {
            "description": "Not Found,网页未找到",
            "schema": {}
          }
        },
        "x-request-examples-url-1": "https://{Endpoint}/v1/408972e72dcd4c1a9b033e955802a36b/cfw/alarm/config?fw_instance_id=8de37729-026d-412f-ba82-80c46f388d14",
        "x-request-examples-description-1": "查询项目id为408972e72dcd4c1a9b033e955802a36b的防火墙告警配置,防火墙ID为8de37729-026d-412f-ba82-80c46f388d14。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "HttpAlarmConfigListResponse": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "readOnly": true
        },
        "alarm_configs": {
          "type": "array",
          "description": "告警配置列表",
          "items": {
            "$ref": "#/definitions/AlarmConfig"
          }
        }
      }
    },
    "AlarmConfig": {
      "type": "object",
      "properties": {
        "account_name": {
          "type": "string"
        },
        "alarm_id": {
          "type": "string"
        },
        "alarm_time_period": {
          "type": "integer",
          "description": "告警周期,0:8时到22时,1:全天"
        },
        "alarm_type": {
          "type": "integer",
          "description": "告警类型 0:攻击告警; 1:流量超额预警; 2:EIP未防护告警; 3:威胁情报告警"
        },
        "enable_status": {
          "type": "integer",
          "description": "告警状态 0:失效; 1:生效"
        },
        "frequency_count": {
          "type": "integer",
          "description": "告警触发频次"
        },
        "frequency_time": {
          "type": "integer",
          "description": "告警频次时间范围,以分钟为单位"
        },
        "language": {
          "type": "string",
          "description": "告警语言,zh-cn为中文,en-us为英文"
        },
        "name": {
          "type": "string",
          "description": "通知群组名称"
        },
        "severity": {
          "type": "string",
          "description": "告警等级,当type为0和4时,severity为CRITICAL,HIGH,MEDIUM,LOW四种等级的组合字符串,当type为2时,severity固定为3"
        },
        "topic_urn": {
          "type": "string",
          "description": "告警topic的urn"
        },
        "username": {
          "type": "string",
          "description": "用户名称,为cfw"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cfw.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}