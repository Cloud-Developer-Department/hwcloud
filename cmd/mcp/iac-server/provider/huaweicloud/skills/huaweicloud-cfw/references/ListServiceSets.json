{
  "name": "ListServiceSets",
  "summary": "获取服务组列表",
  "tags": "服务组管理",
  "productshort": "CFW",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/service-sets": {
      "get": {
        "tags": [
          "Service Group Management"
        ],
        "summary": "获取服务组列表",
        "description": "获取服务组列表",
        "operationId": "ListServiceSets",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,可以通过调用API获取,也可以从控制台获取。[项目ID获取方式](cfw_02_0015.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token,用于携带用户身份信息,配置后可通过接口鉴权,可通过[如何获取用户Token](cfw_02_0008.xml)获取。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
            "required": true,
            "type": "string"
          },
          {
            "name": "object_id",
            "in": "query",
            "description": "防护对象id,是创建云防火墙后用于区分互联网边界防护和VPC边界防护的标志id,可通过调用[查询防火墙实例接口](ListFirewallDetail.xml)获得,通过返回值中的data.records.protect_objects.object_id(.表示各对象之间层级的区分)获得,type为0时,object_id为互联网边界防护对象ID,type为1时,object_id为VPC边界防护对象ID,type可通过data.records.protect_objects.type(.表示各对象之间层级的区分)获得",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          {
            "name": "key_word",
            "in": "query",
            "description": "关键字,可使用功能服务组名称和服务组描述的一部分",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页查询个数,范围为1-1024",
            "required": true,
            "type": "integer",
            "maximum": 1024,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量:指定返回记录的开始位置,必须为数字,取值范围为大于或等于0,默认0",
            "required": true,
            "type": "integer",
            "minimum": 0,
            "format": "int32"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目ID,用户根据组织规划企业项目,对应的ID为企业项目ID,可通过[如何获取企业项目ID](cfw_02_0027.xml)获取,用户未开启企业项目时为0",
            "required": false,
            "type": "string"
          },
          {
            "name": "fw_instance_id",
            "in": "query",
            "description": "防火墙ID,可通过[防火墙ID获取方式](cfw_02_0028.xml)获取",
            "required": false,
            "type": "string"
          },
          {
            "name": "query_service_set_type",
            "in": "query",
            "description": "查询服务组类型,0表示自定义服务组,1表示预定义服务组",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "data": {
                  "limit": 50,
                  "offset": 0,
                  "records": [
                    {
                      "name": "test",
                      "project_id": "2349ba469daf4b7daf268bb0261d18b0",
                      "protocols": [
                        6
                      ],
                      "ref_count": 2,
                      "service_set_type": 0,
                      "set_id": "6f475bad-5d33-45d1-98f8-c79f2f308d5a"
                    }
                  ],
                  "total": 1
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryServiceSetList"
            }
          },
          "400": {
            "description": "Bad Request,错误的请求",
            "examples": {
              "application/json": {
                "error_code": "CFW.0020016",
                "error_msg": "实例状态错误"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "Unauthorized,错误的请求"
          },
          "403": {
            "description": "Forbidden,禁止访问"
          },
          "404": {
            "description": "Not Found,网页未找到"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-request-examples-url-1": "https://{Endpoint}/v1/2349ba469daf4b7daf268bb0261d18b0/service-sets?object_id=a37bb4eb-c49e-4e88-bf77-944a75b0ce8a&limit=10&offset=0",
        "x-request-examples-description-1": "查询项目id为2349ba469daf4b7daf268bb0261d18b0的项目的防护对象id为a37bb4eb-c49e-4e88-bf77-944a75b0ce8a的第一页服务组列表信息",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-order": 6
      }
    }
  },
  "definitions": {
    "ServiceSet": {
      "type": "object",
      "properties": {
        "set_id": {
          "type": "string",
          "description": "服务组id"
        },
        "name": {
          "type": "string",
          "description": "服务组名称"
        },
        "description": {
          "type": "string",
          "description": "服务组描述"
        },
        "service_set_type": {
          "type": "integer",
          "format": "int32",
          "description": "服务组类型,0表示自定义服务组,1表示常用WEB服务,2表示常用远程登录和PING,3表示常用数据库"
        },
        "ref_count": {
          "type": "integer",
          "format": "int32",
          "description": "服务组被规则引用次数"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID"
        },
        "protocols": {
          "type": "array",
          "description": "协议列表,协议类型:TCP为6,UDP为17,ICMP为1,ICMPV6为58,ANY为-1,type为0手动类型时不能为空。",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "ServiceSetRecords": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "偏移量:指定返回记录的开始位置,必须为数字,取值范围为大于或等于0,默认0"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "每页显示个数,范围为1-1024"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "查询服务组总数"
        },
        "records": {
          "type": "array",
          "description": "服务组列表",
          "items": {
            "$ref": "#/definitions/ServiceSet"
          }
        }
      }
    },
    "QueryServiceSetList": {
      "type": "object",
      "properties": {
        "data": {
          "description": "查询服务组列表记录",
          "$ref": "#/definitions/ServiceSetRecords"
        }
      }
    },
    "ErrorRsp": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:\n错误码\n**取值范围**:\n不涉及",
          "readOnly": true
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释**:\n错误描述\n**取值范围**:\n不涉及",
          "readOnly": true
        }
      },
      "description": "**参数解释**:\n失败时返回的错误信息\n**取值范围**:\n不涉及"
    }
  },
