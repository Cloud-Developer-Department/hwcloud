  "definitions": {
    "EipInfo": {
      "type": "object",
      "properties": {
        "eip_id": {
          "type": "string",
          "description": "**参数解释**:\n弹性公网ID,可通过调用弹性IP列表查询获取,通过返回值中的data.records.id(.表示各对象之间层级的区分)获得\n**约束限制**:\n不涉及\n**取值范围**:\n32位UUID\n**默认取值**:\n不涉及",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "fw_instance_id": {
          "type": "string",
          "description": "**参数解释**:\n防火墙ID,用户创建防火墙实例后产生的唯一ID,配置后可区分不同防火墙,可通过[防火墙ID获取方式](cfw_02_0028.xml)获取\n**约束限制**:\n不涉及\n**取值范围**:\n32位UUID\n**默认取值**:\n不涉及",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "object_id": {
          "type": "string",
          "description": "**参数解释**:\n防护对象ID,是创建云防火墙后用于区分互联网边界防护和VPC边界防护的标志ID,可通过调用[查询防火墙实例接口](ListFirewallDetail.xml)获得,通过返回值中的data.records.protect_objects.object_id(.表示各对象之间层级的区分)获得,注意type为0的为互联网边界防护对象ID,type为1的为VPC边界防护对象ID。\n**约束限制**:\n不涉及\n**取值范围**:\n32位UUID\n**默认取值**:\n不涉及",
          "minLength": 0,
          "maxLength": 48
        },
        "public_ip": {
          "type": "string",
          "description": "**参数解释**:\nIPV4地址 \n**约束限制**:\n不涉及\n**取值范围**:\n不涉及  \n**默认取值**:\n不涉及",
          "minLength": 0,
          "maxLength": 64,
          "x-annotations": [
            "@ValidCNFWAddress"
          ]
        },
        "public_ipv6": {
          "type": "string",
          "description": "**参数解释**:\nIPV6地址 \n**约束限制**:\n不涉及\n**取值范围**:\n不涉及  \n**默认取值**:\n不涉及",
          "minLength": 0,
          "maxLength": 64,
          "x-annotations": [
            "@ValidCNFWAddress"
          ]
        },
        "type": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\nEIP白名单标志\n**约束限制**:\n不涉及\n**取值范围**:\n0表示是EIP白名单,1表示不是EIP白名单\n**默认取值**:\n不涉及",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        }
      },
      "title": "EipInfo",
      "x-imports": [
        "com.huaweicloud.cfw.cnfw.common.annotation.ValidCNFWAddress"
