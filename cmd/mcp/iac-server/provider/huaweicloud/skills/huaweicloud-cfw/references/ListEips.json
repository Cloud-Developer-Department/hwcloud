{
  "name": "ListEips",
  "summary": "弹性IP列表查询",
  "tags": "EIP管理",
  "productshort": "CFW",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/eips/protect": {
      "get": {
        "tags": [
          "Eip Management"
        ],
        "summary": "弹性IP列表查询",
        "description": "弹性IP列表查询",
        "operationId": "ListEips",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,可以通过调用API获取,也可以从控制台获取。[项目ID获取方式](cfw_02_0015.xml)",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-f]{32}"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token,用于携带用户身份信息,配置后可通过接口鉴权,可通过[如何获取用户Token](cfw_02_0008.xml)获取。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
            "required": true,
            "type": "string"
          },
          {
            "name": "object_id",
            "in": "query",
            "description": "防护对象id,是创建云防火墙后用于区分互联网边界防护和VPC边界防护的标志id,可通过调用[查询防火墙实例接口](ListFirewallDetail.xml)获得,通过返回值中的data.records.protect_objects.object_id(.表示各对象之间层级的区分)获得,type为0时,object_id为互联网边界防护对象ID,type为1时,object_id为VPC边界防护对象ID。此处仅取type为0的防护对象id,可通过data.records.protect_objects.type(.表示各对象之间层级的区分)获得。",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          {
            "name": "key_word",
            "in": "query",
            "description": "查询防护EIP列表关键字,可选用弹性公网ID和弹性公网IP",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0,
            "allowEmptyValue": true
          },
          {
            "name": "status",
            "in": "query",
            "description": "防护状态 null-全部 0-开启防护 1-关闭防护",
            "required": false,
            "type": "string",
            "allowEmptyValue": true
          },
          {
            "name": "sync",
            "in": "query",
            "description": "是否同步租户EIP数据 0-不同步 1-同步",
            "required": false,
            "type": "integer",
            "format": "int32",
            "allowEmptyValue": true
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示个数,范围为1-1024",
            "required": true,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量:指定返回记录的开始位置,必须为数字,取值范围为大于或等于0,默认0",
            "required": true,
            "type": "integer",
            "exclusiveMaximum": true,
            "format": "int32"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目ID,用户根据组织规划企业项目,对应的ID为企业项目ID,可通过[如何获取企业项目ID](cfw_02_0027.xml)获取,用户未开启企业项目时为0",
            "required": false,
            "type": "string"
          },
          {
            "name": "device_key",
            "in": "query",
            "description": "设备关键字,是eip绑定的资产的名称或id,可通过EIP服务的查询弹性公网IP列表接口获取,通过返回值中的publicips.id(.表示各对象之间层级的区分)获得",
            "required": false,
            "type": "string"
          },
          {
            "name": "address_type",
            "in": "query",
            "description": "地址类型0 ipv4,1 ipv6",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "fw_instance_id",
            "in": "query",
            "description": "防火墙ID,可通过[防火墙ID获取方式](cfw_02_0028.xml)获取",
            "required": false,
            "type": "string"
          },
          {
            "name": "fw_key_word",
            "in": "query",
            "description": "防火墙关键字,可使用防火墙ID或名称查询,可通过[防火墙ID获取方式](cfw_02_0028.xml)",
            "required": false,
            "type": "string"
          },
          {
            "name": "eps_id",
            "in": "query",
            "description": "弹性公网ip的企业项目id,可通过[如何获取企业项目ID](cfw_02_0027.xml)获取,租户未开启企业项目时为0",
            "required": false,
            "type": "string"
          },
          {
            "name": "tags",
            "in": "query",
            "description": "标签列表信息可通过查询EIP服务界面列表标签页签获得",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "data": {
                  "limit": 200,
                  "offset": 0,
                  "records": [
                    {
                      "associate_instance_type": "PORT",
                      "device_id": "c87579ab-c76a-4afd-83ce-62e0f531f13e",
                      "device_name": "test",
                      "device_owner": "compute:test",
                      "domain_id": "7d07807209524a4280266db9df63c4fa",
                      "enterprise_project_id": "0",
                      "fw_domain_id": "7d07807209524a4280266db9df63c4fa",
                      "fw_enterprise_project_id": "default",
                      "fw_instance_id": "546af3f8-88e9-47f2-a205-2346d7090925",
                      "fw_instance_name": "test",
                      "id": "465b34fe-e017-4831-a21c-9c6c753bb1f2",
                      "object_id": "ae42418e-f077-41a0-9d3b-5b2f5ad9102b",
                      "public_ip": "100.85.223.15",
                      "status": 0,
                      "bypass_status": 0,
                      "tags": "combined_order_id=CBRCS23040615138M2KW912"
                    }
                  ],
                  "total": 1
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/EipResponse"
            }
          },
          "400": {
            "description": "Bad Request,错误的请求",
            "examples": {
              "application/json": {
                "error_code": "CFW.00109004",
                "error_msg": "HTTP请求错误"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "Unauthorized,错误的请求",
            "schema": {}
          },
          "403": {
            "description": "Forbidden,禁止访问",
            "schema": {}
          },
          "404": {
            "description": "Not Found,网页未找到",
            "schema": {}
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {}
          }
        },
        "x-request-examples-url-1": "https://{Endpoint}/v1/9d80d070b6d44942af73c9c3d38e0429/eips/protect?object_id=cfebd347-b655-4b84-b938-3c54317599b2&limit=10&offset=0&sync=0",
        "x-request-examples-description-1": "查询项目id为9d80d070b6d44942af73c9c3d38e0429,防护对象id为cfebd347-b655-4b84-b938-3c54317599b2,非同步的第一页的数据",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-order": 2
      }
    }
  },
  "definitions": {
    "EipResource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "弹性公网ID",
          "readOnly": true
        },
        "public_ip": {
          "type": "string",
          "example": "192.1.1.24",
          "description": "弹性公网IP",
          "readOnly": true
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "EIP防护状态,0表示防护中,1表示未防护",
          "readOnly": true,
          "exclusiveMinimum": true,
          "exclusiveMaximum": true,
          "enum": [
            0,
            1
          ]
        },
        "public_ipv6": {
          "type": "string",
          "description": "弹性公网IP,IPV6类型"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "Eip所在账户企业项目id"
        },
        "device_id": {
          "type": "string",
          "description": "EIP绑定设备(如ecs,nat)id"
        },
        "device_name": {
          "type": "string",
          "description": "EIP绑定设备(如ecs,nat)名称"
        },
        "device_owner": {
          "type": "string",
          "description": "EIP绑定设备(如ecs,nat)拥有者"
        },
        "associate_instance_type": {
          "type": "string",
          "description": "**参数解释**:\n关联实例类型\n**约束限制**:\n不涉及\n**取值范围**:\nPORT:IPV4云服务器\nNATGW:NAT网关\nELB: 负载均衡器\nVPN: 虚拟专用网络\nEVPN: 虚拟专用网络\nIPV6_PORT:IPV6云服务器\n**默认取值**:\n不涉及"
        },
        "fw_instance_name": {
          "type": "string",
          "description": "防火墙名称"
        },
        "fw_instance_id": {
          "type": "string",
          "description": "防火墙实例id,创建云防火墙后用于标志防火墙由系统自动生成的标志id,可通过调用[查询防火墙实例接口](ListFirewallDetail.xml)。"
        },
        "fw_enterprise_project_id": {
          "type": "string",
          "description": "Eip绑定的防火墙企业项目id"
        },
        "object_id": {
          "type": "string",
          "description": "防护对象id,是创建云防火墙后用于区分互联网边界防护和VPC边界防护的标志id,可通过调用[查询防火墙实例接口](ListFirewallDetail.xml)获得,通过返回值中的data.records.protect_objects.object_id(.表示各对象之间层级的区分)获得,type为0时,object_id为互联网边界防护对象ID,type为1时,object_id为VPC边界防护对象ID。此处仅取type为0的防护对象id,可通过data.records.protect_objects.type(.表示各对象之间层级的区分)获得。"
        },
        "tags": {
          "type": "string",
          "description": "标签列表"
        },
        "domain_id": {
          "type": "string",
          "description": "EIP所属用户id,可通过[获取账号、IAM用户、项目、用户组、区域、委托的名称和ID](cfw_02_0030.xml)获取。"
        },
        "fw_domain_id": {
          "type": "string",
          "description": "防火墙所属用户,可通过[获取账号、IAM用户、项目、用户组、区域、委托的名称和ID](cfw_02_0030.xml)获取。"
        },
        "bypass_status": {
          "type": "integer",
          "format": "int32",
          "description": "bypass状态,0: 未bypass, 1: 已bypass, 2: 失败"
        }
      },
      "description": "EIP资源防护信息"
    },
    "EipResponse": {
      "type": "object",
      "properties": {
        "data": {
          "description": "查询eip返回data",
          "$ref": "#/definitions/EipResponseData"
        }
      }
    },
    "EipResponseData": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "description": "每页显示个数,范围为1-1024"
        },
        "offset": {
          "type": "integer",
          "description": "偏移量:指定返回记录的开始位置,必须为数字,取值范围为大于或等于0,默认0"
        },
        "total": {
          "type": "integer",
          "description": "查询获得EIP列表总数"
        },
        "records": {
          "type": "array",
          "description": "eip资源记录",
          "items": {
            "$ref": "#/definitions/EipResource"
          }
        }
      }
    },
    "ErrorRsp": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:\n错误码\n**取值范围**:\n不涉及",
          "readOnly": true
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释**:\n错误描述\n**取值范围**:\n不涉及",
          "readOnly": true
        }
      },
      "description": "**参数解释**:\n失败时返回的错误信息\n**取值范围**:\n不涉及"
    }
  },
  "version": "2.0",
