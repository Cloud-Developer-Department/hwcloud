{
  "name": "ShowAntiVirusSwitch",
  "summary": "查看反病毒开关",
  "tags": "反病毒管理",
  "productshort": "CFW",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/anti-virus/switch": {
      "get": {
        "tags": [
          "反病毒管理"
        ],
        "summary": "查看反病毒开关",
        "description": "查看反病毒开关",
        "operationId": "ShowAntiVirusSwitch",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,可以通过调用API获取,也可以从控制台获取。可通过[项目ID获取方式](cfw_02_0015.xml)获取",
            "required": true,
            "type": "string"
          },
          {
            "name": "object_id",
            "in": "query",
            "description": "防护对象ID,是创建云防火墙后用于区分互联网边界防护和VPC边界防护的标志id,可通过调用[查询防火墙实例接口](ListFirewallDetail.xml)获得,通过返回值中的data.records.protect_objects.object_id(.表示各对象之间层级的区分)获得,type为0时,object_id为互联网边界防护对象ID,type为1时,object_id为VPC边界防护对象ID。此处仅取type为1的防护对象id,可通过data.records.protect_objects.type(.表示各对象之间层级的区分)获得。",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,可通过[如何获取用户Token](cfw_02_0008.xml)获取",
            "required": true,
            "type": "string"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目ID,用户根据组织规划企业项目,对应的ID为企业项目ID,可通过[如何获取企业项目ID](cfw_02_0027.xml)获取,用户未开启企业项目时为0",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
