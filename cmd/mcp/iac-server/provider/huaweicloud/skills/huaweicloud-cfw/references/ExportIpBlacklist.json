  "paths": {
    "/v1/{project_id}/ptf/ip-blacklist/export": {
      "post": {
        "tags": [
          "流量过滤"
        ],
        "summary": "导出用于流量过滤的IP黑名单",
        "description": "指定IP黑名单的名字进行导出,当前只有两种文件名,在EIP生效的文件名为ip-blacklist-eip.txt,在 NAT生效的文件名为ip-blacklist-nat.txt。",
        "operationId": "ExportIpBlacklist",
        "produces": [
          "application/json",
          "text/plain"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,可以通过调用API获取,也可以从控制台获取。可通过[项目ID获取方式](cfw_02_0015.xml)获取",
            "required": true,
            "type": "string"
          },
          {
            "name": "fw_instance_id",
            "in": "query",
            "description": "防火墙ID,可通过[防火墙ID获取方式](cfw_02_0028.xml)获取",
            "required": true,
            "type": "string"
          },
          {
            "name": "name",
            "in": "query",
            "description": "IP黑名单的名字,如果要导出生效范围为EIP的IP黑名单,就指定名字为ip-blacklist-eip.txt,如果要导出生效范围为NAT的IP黑名单,就指定名字为ip-blacklist-nat.txt。",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
