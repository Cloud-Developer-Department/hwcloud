        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token,用于携带用户身份信息,配置后可通过接口鉴权,可通过[如何获取用户Token](cfw_02_0008.xml)获取。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,可以通过调用API获取,也可以从控制台获取。[项目ID获取方式](cfw_02_0015.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "set_id",
            "in": "query",
            "description": "服务组id,可通过[获取服务组列表接口](ListServiceSets.xml)查询获得,通过返回值中的data.records.set_id(.表示各对象之间层级的区分)获得。",
            "required": true,
            "type": "string"
          },
          {
            "name": "key_word",
            "in": "query",
            "description": "查询字段,可为服务组成员名称或服务组成员描述的一部分。",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示个数,范围为1-1024",
            "required": true,
            "type": "integer"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量:指定返回记录的开始位置,必须为数字,取值范围为大于或等于0,默认0",
            "required": true,
            "type": "integer"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目ID,用户根据组织规划企业项目,对应的ID为企业项目ID,可通过[如何获取企业项目ID](cfw_02_0027.xml)获取,用户未开启企业项目时为0",
            "required": false,
            "type": "string"
          },
          {
            "name": "fw_instance_id",
            "in": "query",
            "description": "防火墙ID,可通过[防火墙ID获取方式](cfw_02_0028.xml)获取",
            "required": false,
            "type": "string"
          },
          {
            "name": "query_service_set_type",
            "in": "query",
            "description": "查询服务组类型,0表示自定义服务组,1表示预定义服务组。仅当set_id为预定义服务组id时生效",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "responses": {
