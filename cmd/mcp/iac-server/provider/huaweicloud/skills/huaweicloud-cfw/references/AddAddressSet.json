  "definitions": {
    "AddressSetId": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "地址组id"
        },
        "name": {
          "type": "string",
          "description": "地址组名称"
        }
      }
    },
    "AddAddressSetDto": {
      "type": "object",
      "required": [
        "name",
        "object_id"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "description": "防护对象id,是创建云防火墙后用于区分互联网边界防护和VPC边界防护的标志id,可通过调用[查询防火墙实例接口](ListFirewallDetail.xml)获得,通过返回值中的data.records.protect_objects.object_id(.表示各对象之间层级的区分)获得,type为0时,object_id为互联网边界防护对象ID,type为1时,object_id为VPC边界防护对象ID,type可通过data.records.protect_objects.type(.表示各对象之间层级的区分)获得,此处只能使用type为0的防护对象id",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "description": "地址组名称"
        },
        "description": {
          "type": "string",
          "description": "地址组描述"
        },
        "address_type": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n地址类型\n**约束限制**:\n不涉及\n**取值范围**:\n- 0:IPv4\n- 1:IPv6\n**默认取值**:\n0:IPv4"
        }
      },
      "title": "AddAddressSetDto",
      "description": "添加地址组请求体",
      "example": {
        "object_id": "1f1e070a-c5c0-4baf-b9dc-29dfa1abb049",
        "name": "ip_set_test1",
        "description": "this is a ip set for create",
        "address_items": [
          {
            "name": "ip_item1",
            "address_type": 0,
            "address": "192.168.26.25, 192.168.25.225",
            "description": "this is a ip item for create"
          },
          {
            "name": "ip_item1",
            "address_type": 0,
            "address": "192.168.26.25, 192.168.25.225",
            "description": "this is a ip item for create"
          }
        ]
      }
    },
