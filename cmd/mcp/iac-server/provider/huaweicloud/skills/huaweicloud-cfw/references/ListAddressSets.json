  "paths": {
    "/v1/{project_id}/address-sets": {
      "get": {
        "tags": [
          "Address Group Management"
        ],
        "summary": "查询地址组列表",
        "description": "查询地址组列表",
        "operationId": "ListAddressSets",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,可以通过调用API获取,也可以从控制台获取。[项目ID获取方式](cfw_02_0015.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token,用于携带用户身份信息,配置后可通过接口鉴权,可通过[如何获取用户Token](cfw_02_0008.xml)获取。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
            "required": true,
            "type": "string"
          },
          {
            "name": "object_id",
            "in": "query",
            "description": "防护对象id,是创建云防火墙后用于区分互联网边界防护和VPC边界防护的标志id,可通过调用[查询防火墙实例接口](ListFirewallDetail.xml)获得,通过返回值中的data.records.protect_objects.object_id(.表示各对象之间层级的区分)获得,type为0时,object_id为互联网边界防护对象ID,type为1时,object_id为VPC边界防护对象ID,type可通过data.records.protect_objects.type(.表示各对象之间层级的区分)获得",
            "required": true,
            "type": "string"
          },
          {
            "name": "key_word",
            "in": "query",
            "description": "关键字,包括地址组名称或描述的一部分",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示个数,范围为1-1024",
            "required": true,
            "type": "integer"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量:指定返回记录的开始位置,必须为数字,取值范围为大于或等于0,默认0",
            "required": true,
            "type": "integer"
          },
          {
            "name": "address",
            "in": "query",
            "description": "IP地址",
            "required": false,
            "type": "string"
          },
          {
            "name": "address_type",
            "in": "query",
            "description": "地址类型0 ipv4,1 ipv6",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目ID,用户根据组织规划企业项目,对应的ID为企业项目ID,可通过[如何获取企业项目ID](cfw_02_0027.xml)获取,用户未开启企业项目时为0",
            "required": false,
            "type": "string"
          },
          {
            "name": "fw_instance_id",
            "in": "query",
            "description": "防火墙ID,可通过[防火墙ID获取方式](cfw_02_0028.xml)获取",
            "required": false,
            "type": "string"
          },
          {
            "name": "query_address_set_type",
            "in": "query",
            "description": "查询地址组类型,0表示自定义地址组,1表示预定义地址组,当address_set_type不为0时,query_address_set_type为1时才可以生效。",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "address_set_type",
            "in": "query",
            "description": "地址组类型,0表示自定义地址组,1表示WAF回源IP地址组,2表示DDoS回源IP地址组,3表示NAT64转换地址组",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
