  "definitions": {
    "CreateFirewallReq": {
      "type": "object",
      "required": [
        "charge_info",
        "flavor",
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "**参数解释**:\n防火墙名称\n约束限制:\n不涉及\n**取值范围**:\n不涉及\n默认取值:\n不涉及"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "**参数解释**:\n企业项目ID,用户根据组织规划企业项目,对应的ID为企业项目ID,可通过[如何获取企业项目ID](cfw_02_0027.xml)获取\n约束限制:\n不涉及\n**取值范围**:\n不涉及\n默认取值:\n0",
          "default": "0"
        },
        "tags": {
          "type": "array",
          "description": "**参数解释**:\n服务资源标签列表,防火墙资源添加标签后,可根据键、值组合查询资源,同时可根据键、值组合进行话单合并统计\n**约束限制**:\n不涉及",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "**参数解释**:\n资源标签键\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
              },
              "value": {
                "type": "string",
                "description": "**参数解释**:\n资源标签值\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
              }
            }
          }
        },
        "flavor": {
          "type": "object",
          "description": "**参数解释**:\n防火墙规格信息\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
          "properties": {
            "version": {
              "type": "string",
              "description": "**参数解释**:\n防火墙版本\n**约束限制**:\n“charge_mode”为“prePaid”时,支持标准版、专业版。\n“charge_mode”为“postPaid”时,仅支持专业版。\n**取值范围**:\nStandard - 标准版\nProfessional - 专业版\n**默认取值**:\n不涉及",
              "enum": [
                "Standard",
                "Professional"
              ]
            },
            "extend_eip_count": {
              "type": "integer",
              "format": "int32",
              "description": "**参数解释**:\n扩展EIP数量\n**约束限制**:\n仅包周期场景下生效,当用户需要增加EIP防护数量时使用此参数。\n**取值范围**:\n0-2000\n**默认取值**:\n0",
              "minimum": 0,
              "maximum": 2000,
              "default": 0
            },
            "extend_bandwidth": {
              "type": "integer",
              "format": "int32",
              "description": "**参数解释**:\n扩展带宽,步长为5\n**约束限制**:\n仅包周期场景下生效,当用户需要防护带宽时使用此参数。\n**取值范围**:\n0-5000\n**默认取值**:\n不涉及",
              "minimum": 0,
              "maximum": 5000
            },
            "extend_vpc_count": {
              "type": "integer",
              "format": "int32",
              "description": "**参数解释**:\n扩展VPC数量\n**约束限制**:\n仅包周期场景下生效,当用户需要增加VPC防护数量时使用此参数。\n**取值范围**:\n0-100\n**默认取值**:\n不涉及",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "version"
          ]
        },
        "charge_info": {
          "type": "object",
          "description": "**参数解释**:\n计费类型信息,支持包年/包月和按需,默认为按需。\n**约束限制**:\n不涉及",
          "properties": {
            "charge_mode": {
              "type": "string",
              "description": "**参数解释**:\n计费模式\n**约束限制**:\n不涉及\n**取值范围**:\n- prePaid:预付费,即包年/包月。\n- postPaid:后付费,即按需付费\n**默认取值**:\n不涉及"
            },
            "period_type": {
              "type": "string",
              "description": "**参数解释**:\n订购周期类型\n**约束限制**:\n“charge_mode”为“prePaid”时生效,且为必选值。\n**取值范围**:\n- month:包月。\n- year:包年\n**默认取值**:\n不涉及"
            },
            "period_num": {
              "type": "integer",
              "format": "int32",
              "description": "**参数解释**:\n订购时间\n**约束限制**:\n“charge_mode”为“prePaid”时,“period_num”必填。\n**取值范围**:\n- 当“period_type”为“month”时,此处取值为1~9。\n- 当“period_type”为“year”时,此处取值为1~3。\n**默认取值**:\n不涉及"
            },
            "is_auto_renew": {
              "type": "boolean",
              "description": "**参数解释**:\n是否自动续订,续订的周期和原周期相同,且续订时会自动支付。\n**约束限制**:\n创建包周期实例时可指定\n**取值范围**:\n- true,为自动续订。\n- false,为不自动续订\n**默认取值**:\nfalse",
              "default": false
            },
            "is_auto_pay": {
              "type": "boolean",
              "description": "**参数解释**:\n是否自动从客户的账户中支付,此字段不影响自动续订的支付方式。\n**约束限制**:\n创建包周期时可指定\n**取值范围**:\n- true:自动支付(会自动选择折扣和优惠券进行优惠,并自动从客户账户中支付),自动支付失败会生成订单、但订单状态为“待支付”,等待客户手动支付(手动支付时,可以修改系统自动选择的折扣和优惠券)\n- false:手动支付,默认该方式。(需要客户手动去支付,客户可以选择折扣和优惠券)\n**默认取值**:\nfalse",
              "default": false
            }
          },
          "required": [
            "charge_mode",
            "is_auto_pay",
            "is_auto_renew"
          ]
        }
      },
      "description": "按需防火墙实体",
      "example": {
        "fw_instance_name": "CFW-TEST",
        "enterprise_project_id": "0",
        "tags": [
          {
            "key": "TagKey",
            "value": "TagVal"
          }
        ],
        "flavor": {
          "version": "standard",
          "extend_eip_count": 2000,
          "extend_bandwidth": 5000,
          "extend_vpc_count": 100
        },
        "charge_info": {
          "charge_mode": "prePaid",
          "period_type": "month",
          "period_num": 1,
          "is_auto_renew": true,
          "is_auto_pay": true
        }
      }
    },
    "CreateFirewallResp": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "**参数解释**:\n实例创建的任务id\n**取值范围**:\n不涉及"
        },
        "order_id": {
          "type": "string",
          "description": "**参数解释**:\n订单号\n**取值范围**:\n不涉及"
        },
        "data": {
          "description": "**参数解释**:\n创建防火墙请求体\n**取值范围**:\n不涉及",
          "$ref": "#/definitions/CreateFirewallReq"
        }
      },
      "description": "防火墙创建响应参数",
      "x-apidesigner-tag": "default"
    },
    "ErrorRsp": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:\n错误码\n**取值范围**:\n不涉及",
          "readOnly": true
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释**:\n错误描述\n**取值范围**:\n不涉及",
          "readOnly": true
        }
      },
      "description": "**参数解释**:\n失败时返回的错误信息\n**取值范围**:\n不涉及"
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "**参数解释**:\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以从调API处获取,也可以从控制台获取。[项目ID获取方式](cfw_02_0015.xml)\n**约束限制**:\n不涉及\n**取值范围**:\n32位UUID\n**默认取值**:\n不涉及",
      "required": true,
      "type": "string",
      "maxLength": 32,
      "minLength": 0
    }
  },
  "host": "cfw.af-north-1.myhuaweicloud.com",
