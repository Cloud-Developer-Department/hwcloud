            "required": true,
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
          },
          {
            "name": "range",
            "in": "query",
            "description": "**参数解释**:\n时间范围 \n**约束限制**:\n不涉及\n**取值范围**:\n0为近一时 1近一天 2近七天  \n**默认取值**:\n不涉及",
            "required": false,
            "type": "integer",
            "format": "int32",
            "enum": [
              0,
              1,
              2
            ]
          },
          {
            "name": "direction",
            "in": "query",
            "description": "**参数解释**:\n会话方向\n**约束限制**:\n不涉及\n**取值范围**:\nin2out为出云方向 out2in为入云方向\n**默认取值**:\n不涉及",
            "required": false,
            "type": "string",
            "enum": [
              "in2out",
              "out2in"
            ]
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "**参数解释**:\n开始时间\n**约束限制**:\n不涉及\n**取值范围**:\n毫秒级时间戳\n**默认取值**:\n不涉及",
            "required": false,
            "type": "integer",
            "maximum": 9007199254740992,
            "minimum": 0,
            "format": "int64"
          },
          {
            "name": "end_time",
            "in": "query",
