                "data": [
                  {
                    "agg_time": 1750299480000,
                    "bps": 0
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowTrafficTrendResp"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "CFW.00200007",
                "error_msg": "时间范围错误"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-request-examples-url-1": "https://{Endpoint}/v1/a16df7cf1d094befa6bbc72cbf51e93a/cfw/logs/traffic-trend?fw_instance_id=c598d612-8112-465c-bffd-863d4ce85a50&range=2&log_type=vpc&agg_type=max",
        "x-request-examples-description-1": "查询项目ID为a16df7cf1d094befa6bbc72cbf51e93a防火墙ID为c598d612-8112-465c-bffd-863d4ce85a50时间范围为7天的vpc间流量趋势,计算方式为最大值",
        "x-method-annotations": [
          "@IamAuthMeta(rbac = {RoleConst.TE_ADMIN, RoleConst.OP_SERVICE, RoleConst.READ_ONLY, RoleConst.TE_ADMIN_RESTRICTED, RoleConst.TE_ADMIN_SUSPENDED}, needRbacCheck = false, needCbcCheck = false, authContextInitializerName =\"FirewallInitializer\")",
          "@IamAuthAction(iam3Action = IamV3Action.GET_ATTACK_LOG_REPORT, iam5Action = CommonConstant.IAM5_GET_ENGINE_LOG_STATISTICS)",
          "@IamAuthMetaV5(needCbcCheck = false, needAbacResourceCheck = true, authContextInitializerName =\"FirewallInitializer\")",
          "@IamAuthParam(instanceId = \"fw_instance_id\")"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api"
      }
    }
  },
