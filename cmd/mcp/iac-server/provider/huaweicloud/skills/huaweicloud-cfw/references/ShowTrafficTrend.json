{
  "name": "ShowTrafficTrend",
  "summary": "查询流量趋势",
  "tags": "日志分析",
  "productshort": "CFW",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/cfw/logs/traffic-trend": {
      "get": {
        "tags": [
          "Log Analysis"
        ],
        "summary": "查询流量趋势",
        "description": "查询流量趋势,包括南北向、EIP、东西向的流量趋势",
        "operationId": "ShowTrafficTrend",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以从调API处获取,也可以从控制台获取。[项目ID获取方式](cfw_02_0015.xml)\n**约束限制**:\n不涉及\n**取值范围**:\n32位UUID\n**默认取值**:\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 0
          },
          {
            "name": "fw_instance_id",
            "in": "query",
            "description": "**参数解释**:\n防火墙ID,用户创建防火墙实例后产生的唯一ID,配置后可区分不同防火墙,可通过[防火墙ID获取方式](cfw_02_0028.xml)获取\n**约束限制**:\n不涉及\n**取值范围**:\n32位UUID\n**默认取值**:\n不涉及",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
          },
          {
            "name": "range",
            "in": "query",
            "description": "**参数解释**:\n时间范围 \n**约束限制**:\n不涉及\n**取值范围**:\n0为近一时 1近一天 2近七天  \n**默认取值**:\n不涉及",
            "required": false,
            "type": "integer",
            "format": "int32",
            "enum": [
              0,
              1,
              2
            ]
          },
          {
            "name": "log_type",
            "in": "query",
            "description": "**参数解释**:\n日志类型\n**约束限制**:\n不涉及\n**取值范围**:\ninternet为南北向日志、nat为nat场景日志,vpc为东西向日志,vgw为vgw场景日志\n**默认取值**:\n不涉及",
            "required": true,
            "type": "string",
            "enum": [
              "internet",
              "nat",
              "vpc",
              "vgw"
            ]
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "**参数解释**:\n开始时间\n**约束限制**:\n不涉及\n**取值范围**:\n毫秒级时间戳\n**默认取值**:\n不涉及",
            "required": false,
            "type": "integer",
            "maximum": 9007199254740992,
            "minimum": 0,
            "format": "int64"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "**参数解释**:\n结束时间\n**约束限制**:\n不涉及\n**取值范围**:\n毫秒级时间戳\n**默认取值**:\n不涉及",
            "required": false,
            "type": "integer",
            "maximum": 9007199254740992,
            "minimum": 0,
            "format": "int64"
          },
          {
            "name": "vgw_id",
            "in": "query",
            "description": "**参数解释**:\nVGW ID\n**约束限制**:\n不涉及\n**取值范围**:\n32位UUID\n**默认取值**:\n不涉及",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
            },
            "maxItems": 10,
            "minItems": 0
          },
          {
            "name": "agg_type",
            "in": "query",
            "description": "**参数解释**:\n聚合类型\n**约束限制**:\n不涉及\n**取值范围**:\navg为平均值 max为最大值\n**默认取值**:\n不涉及",
            "required": true,
            "type": "string",
            "enum": [
              "avg",
              "max"
            ]
          },
          {
            "name": "ip",
            "in": "query",
            "description": "**参数解释**:\nIP地址列表,查看IP的流量趋势\n**约束限制**:\n不涉及\n**取值范围**:\nIP地址\n**默认取值**:\n不涉及",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi",
            "maxItems": 100,
            "minItems": 1
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
