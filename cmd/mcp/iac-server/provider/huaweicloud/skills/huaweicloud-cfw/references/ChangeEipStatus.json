  "definitions": {
    "EIPSwitchStatusVO": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "description": "防护对象id,是创建云防火墙后用于区分互联网边界防护和VPC边界防护的标志id,可通过调用[查询防火墙实例接口](ListFirewallDetail.xml)获得,通过返回值中的data.records.protect_objects.object_id(.表示各对象之间层级的区分)获得,type为0时,object_id为互联网边界防护对象ID,type为1时,object_id为VPC边界防护对象ID。此处仅取type为0的防护对象id,可通过data.records.protect_objects.type(.表示各对象之间层级的区分)获得"
        },
        "fail_eip_id_list": {
          "type": "array",
          "description": "修改eip防护状态失败状态列表,状态包括成功“successful”,失败“fail”",
          "items": {
            "type": "string"
          }
        },
        "fail_eip_list": {
          "type": "array",
          "description": "修改eip防护状态失败信息列表",
          "items": {
            "$ref": "#/definitions/FailedEipInfo"
          }
        },
        "id": {
          "type": "string",
          "description": "防火墙ID,可通过[防火墙ID获取方式](cfw_02_0028.xml)获取"
        }
      }
    },
    "ProtectEipResponse": {
      "type": "object",
      "properties": {
        "data": {
          "description": "改变EIP防护状态返回值data",
          "$ref": "#/definitions/EIPSwitchStatusVO"
        }
      }
    },
    "FailedEipInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "修改状态失败的eipId。"
        },
        "error_message": {
          "type": "string",
          "description": "修改状态失败的错误码。"
        }
      }
    },
    "EipOperateProtectReq": {
      "type": "object",
      "required": [
        "ip_infos",
        "object_id",
        "status"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "description": "防护对象id,是创建云防火墙后用于区分互联网边界防护和VPC边界防护的标志id,可通过调用[查询防火墙实例接口](ListFirewallDetail.xml)获得,通过返回值中的data.records.protect_objects.object_id(.表示各对象之间层级的区分)获得,type为0时,object_id为互联网边界防护对象ID,type为1时,object_id为VPC边界防护对象ID。此处仅取type为0的防护对象id,可通过data.records.protect_objects.type(.表示各对象之间层级的区分)获得。"
        },
        "status": {
          "type": "integer",
          "description": "EIP切换的状态,0表示防护中,1表示未防护"
        },
        "ip_infos": {
          "type": "array",
          "description": "切换防护状态的EIP信息列表",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "弹性公网IP ID,可通过调用弹性IP列表查询接口获得,通过返回值中的data.records.id(.表示各对象之间层级的区分)获得。",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "public_ip": {
                "type": "string",
                "description": "弹性公网IP IPv4地址,可通过调用弹性IP列表查询接口获得,通过返回值中的data.records.public_ip(.表示各对象之间层级的区分)获得。"
              },
              "public_ipv6": {
                "type": "string",
                "description": "弹性公网IP IPv6地址,可通过调用弹性IP列表查询接口获得,通过返回值中的data.records.public_ipv6(.表示各对象之间层级的区分)获得。"
              }
            }
          },
          "maxItems": 50,
          "minItems": 0
        }
      },
      "description": "EIP操作防护请求体"
    },
    "ErrorRsp": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:\n错误码\n**取值范围**:\n不涉及",
          "readOnly": true
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释**:\n错误描述\n**取值范围**:\n不涉及",
          "readOnly": true
        }
      },
      "description": "**参数解释**:\n失败时返回的错误信息\n**取值范围**:\n不涉及"
    }
  },
  "version": "2.0",
