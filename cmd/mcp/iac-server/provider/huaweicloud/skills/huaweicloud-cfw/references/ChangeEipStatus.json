            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "Unauthorized,错误的请求"
          },
          "403": {
            "description": "Forbidden,禁止访问"
          },
          "404": {
            "description": "Not Found,网页未找到"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-request-examples-url-1": "https://{Endpoint}/v1/857ddec2-55f2-4503-a93a-fe70021b743c/eip/protect",
        "x-request-examples-description-1": "开启项目id为857ddec2-55f2-4503-a93a-fe70021b743c,防护对象id为6d3db4fd-fd58-4d8e-914b-ef91aa268f62弹性公网IPid为4a589be0-b40a-4694-94ff-c0710af9a0a2的 EIP(1.2.3.4)流量防护",
