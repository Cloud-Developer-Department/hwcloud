  "definitions": {
    "AddServiceItemsUsingPOSTRequestBody": {
      "type": "object",
      "required": [
        "service_items",
        "set_id"
      ],
      "properties": {
        "set_id": {
          "type": "string",
          "example": "789b00b6-9013-4245-9c41-6227e60f8a3f",
          "description": "服务组id,可通过[获取服务组列表接口](ListServiceSets.xml)查询获得,通过返回值中的data.records.set_id(.表示各对象之间层级的区分)获得。",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "service_items": {
          "type": "array",
          "description": "服务组成员列表",
          "items": {
            "type": "object",
            "description": "service item",
            "properties": {
              "protocol": {
                "type": "integer",
                "description": "协议类型:TCP为6,UDP为17,ICMP为1,ICMPV6为58,ANY为-1,手动类型不为空,自动类型为空"
              },
              "source_port": {
                "type": "string",
                "example": "80",
                "description": "源端口"
              },
              "dest_port": {
                "type": "string",
                "example": "22",
                "description": "目的端口"
              },
              "description": {
                "type": "string",
                "example": "this is a service item",
                "description": "服务成员描述"
              }
            },
            "required": [
              "dest_port",
              "protocol",
              "source_port"
            ]
          }
        }
      }
    },
    "AddServiceItemsResponseBody": {
      "type": "object",
      "properties": {
        "data": {
          "description": "创建服务组成员返回数据",
          "$ref": "#/definitions/ServiceItemIds"
        }
      }
    },
    "ServiceItemIds": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "description": "服务组成员id列表",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "服务组成员id"
              }
            }
          }
        }
      }
    },
