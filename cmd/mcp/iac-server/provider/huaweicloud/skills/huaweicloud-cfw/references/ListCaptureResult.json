        },
        "x-request-examples-url-1": "https://{Endpoint}/v1/09bb24e6fe80d23d2fa2c010b53b418c/capture-task/capture-result?fw_instance_id=14f99b45-47df-4e40-aa5d-cf3700ce9c8b&enterprise_project_id=default&task_id=ea47d7f9-8b93-45de-978d-b4bf0613cfed&type=0",
