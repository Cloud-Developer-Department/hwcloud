        "description": "获取抓包任务结果",
        "operationId": "ListCaptureResult",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,可以通过调用API获取,也可以从控制台获取。[项目ID获取方式](cfw_02_0015.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "fw_instance_id",
            "in": "query",
