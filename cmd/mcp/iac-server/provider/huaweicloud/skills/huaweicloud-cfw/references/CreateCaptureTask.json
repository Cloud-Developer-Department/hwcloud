          }
        },
        "x-request-examples-1": {
          "name": "zhuabaotest",
          "max_packets": 100000,
          "duration": 3,
          "source": {
            "type": 0,
            "address_type": 0,
            "address": "1.1.1.1"
          },
          "destination": {
            "type": 0,
            "address_type": 0,
            "address": "2.2.2.2"
          },
          "service": {
            "protocol": -1,
            "source_port": "",
            "dest_port": ""
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "HttpCreateCaptureTaskResponse": {
      "type": "object",
      "properties": {
        "data": {
          "description": "创建抓包任务id信息",
          "$ref": "#/definitions/CaptureTaskId"
        }
      }
    },
    "CaptureTaskId": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "防火墙ID"
        },
        "name": {
          "type": "string",
          "description": "防火墙名称"
        }
      }
    },
    "CaptureTaskDto": {
      "type": "object",
      "required": [
        "destination",
        "duration",
        "max_packets",
        "name",
        "service",
        "source"
      ],
      "properties": {
        "destination": {
          "description": "抓包规则目的地址请求体",
          "$ref": "#/definitions/CaptureRuleAddressDto"
        },
        "duration": {
          "type": "integer",
          "format": "int32",
          "description": "抓包时长,以分钟为单位"
        },
        "max_packets": {
          "type": "integer",
          "format": "int32",
          "description": "最大抓包数,以个为单位",
          "maximum": 1000000
        },
        "name": {
          "type": "string",
          "description": "抓包任务名称"
        },
        "service": {
          "description": "抓包任务服务请求体",
          "$ref": "#/definitions/CaptureServiceDto"
        },
        "source": {
          "description": "抓包规则源地址请求体",
          "$ref": "#/definitions/CaptureRuleAddressDto"
        }
      }
    },
    "CaptureRuleAddressDto": {
      "type": "object",
      "required": [
        "address",
        "address_type",
        "type"
      ],
      "properties": {
        "address": {
          "type": "string",
          "description": "地址"
        },
        "address_type": {
          "type": "integer",
          "format": "int32",
          "description": "目的地址类型0 ipv4,1 ipv6"
        },
        "type": {
          "type": "integer",
          "format": "int32",
          "description": "输入地址类型,目前只支持0,手工输入类型"
        }
      }
    },
    "CaptureServiceDto": {
      "type": "object",
      "required": [
        "protocol"
      ],
      "properties": {
        "dest_port": {
          "type": "string",
          "description": "目的端口"
        },
        "protocol": {
          "type": "integer",
          "format": "int32",
          "description": "协议类型:TCP为6,UDP为17,ICMP为1,ICMPV6为58,ANY为-1,手动类型不为空,自动类型为空"
        },
        "source_port": {
          "type": "string",
          "description": "源端口"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
