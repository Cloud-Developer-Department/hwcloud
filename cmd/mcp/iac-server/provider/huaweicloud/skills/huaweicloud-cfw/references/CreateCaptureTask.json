{
  "name": "CreateCaptureTask",
  "summary": "创建抓包任务",
  "tags": "抓包管理",
  "productshort": "CFW",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/capture-task": {
      "post": {
        "tags": [
          "抓包管理"
        ],
        "summary": "创建抓包任务",
        "description": "创建抓包任务,每个任务只能执行一次。",
        "operationId": "CreateCaptureTask",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,可以通过调用API获取,也可以从控制台获取。[项目ID获取方式](cfw_02_0015.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目ID,用户根据组织规划企业项目,对应的ID为企业项目ID,可通过[如何获取企业项目ID](cfw_02_0027.xml)获取,用户未开启企业项目时为0",
            "required": false,
            "type": "string"
          },
          {
            "name": "fw_instance_id",
            "in": "query",
            "description": "防火墙ID,可通过[防火墙ID获取方式](cfw_02_0028.xml)获取",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token,用于携带用户身份信息,配置后可通过接口鉴权,可通过[如何获取用户Token](cfw_02_0008.xml)获取。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "captureTaskDto",
            "description": "创建抓包任务请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CaptureTaskDto"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "data": {
                  "id": "ebf891cd-2163-48a0-9963-6309f99dd3c4",
                  "name": "test"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/HttpCreateCaptureTaskResponse"
            }
          }
        },
        "x-request-examples-url-1": "https://{Endpoint}/v1/09bb24e6fe80d23d2fa2c010b53b418c/capture-task?fw_instance_id=ebf891cd-2163-48a0-9963-6309f99dd3c4&enterprise_project_id=default",
        "x-request-examples-description-1": "向项目id为09bb24e6fe80d23d2fa2c010b53b418c,防火墙ID为ebf891cd-2163-48a0-9963-6309f99dd3c4添加抓包任务,任务名称为zhuabaotest,最大抓包数为100000,抓包时长为3分钟,剩余保留天数为7天,源地址协议为tcp协议,地址类型为ipv4,地址为1.1.1.1,端口号为1-65535,目的地址协议为tcp协议,地址类型为ipv4,地址为2.2.2.2,端口号为1-65535。",
        "x-request-examples-text-1": {
