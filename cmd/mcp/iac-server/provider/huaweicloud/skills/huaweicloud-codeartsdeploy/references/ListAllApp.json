          },
          "type": "array"
        }
      },
      "description": "查询应用详情响应体",
      "type": "object"
    },
    "ListAllAppRequestBody": {
      "properties": {
        "project_id": {
          "type": "string",
          "description": "项目id",
          "pattern": "^[A-Za-z0-9]{32}$",
          "minLength": 32,
          "maxLength": 32
        },
        "page": {
          "description": "分页页码, 表示从此页开始查询, page大于等于1",
          "type": "integer",
          "format": "int32"
        },
        "size": {
          "description": "每页显示的条目数量,size小于等于100",
          "type": "integer",
          "format": "int32"
        },
        "sort_name": {
          "description": "排序字段的名称,当前仅支持name和startTime",
          "type": "string",
          "enum": [
            "name",
            "startTime"
          ]
        },
        "sort_by": {
          "description": "排序顺序,正序(ASC)或者逆序(DESC)",
          "type": "string",
          "format": "int32"
        },
        "states": {
          "description": "应用状态列表,支持查询以下状态:\nabort: 部署中止\nfailed: 部署失败\nnot_started: 取消执行\npending: 排队中\nrunning: 正在部署\nsucceeded: 部署成功\ntimeout: 部署超时\nnot_executed: 未执行\n",
          "type": "array",
          "items": {
            "type": "string",
            "description": "应用最后一次执行的状态",
            "enum": [
              "abort",
              "failed",
              "not_started",
              "pending",
              "running",
              "succeeded",
              "timeout",
              "not_executed"
            ]
          }
        },
        "group_id": {
          "description": "应用的分组id,传入no_grouped为查询未分组的应用",
          "type": "string",
          "pattern": "^[A-Za-z0-9]{32}|no_grouped$",
          "x-example": "no_grouped"
        }
      },
      "required": [
        "project_id",
        "page",
        "size"
      ]
    },
    "ResultBodyV2": {
      "properties": {
        "total_num": {
          "type": "integer",
          "format": "int32",
          "description": "总数"
        },
        "result": {
          "type": "array",
          "description": "应用列表数组",
          "items": {
            "$ref": "#/definitions/AppExecutionInfo"
          }
        }
      }
    },
    "TaskBaseResponseBody": {
      "properties": {
        "id": {
          "type": "string",
          "description": "部署任务id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "state": {
          "type": "string",
          "description": "部署任务状态"
        },
        "deploy_system": {
          "type": "string",
          "description": "部署任务类型"
        }
      }
    }
