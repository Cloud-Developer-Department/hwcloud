  "definitions": {
    "ConfigInfoDO": {
      "description": "部署参数类",
      "properties": {
        "name": {
          "type": "string",
          "example": "serviceName",
          "description": "部署参数名称,用户可自定义"
        },
        "type": {
          "type": "string",
          "example": "text",
          "description": "类型,如果填写name字段,则type必选,若type为空则默认为text",
          "enum": [
            "text",
            "host_group",
            "enum",
            "encrypt"
          ]
        },
        "description": {
          "type": "string",
          "example": "服务名称",
          "description": "描述"
        },
        "value": {
          "type": "string",
          "example": "SpringBoot-Demo",
          "description": "部署参数值"
        },
        "task_id": {
          "type": "string",
          "example": "6ea272d3a0004397adf2f702ceffc6c0",
          "description": "部署任务id,创建应用后由系统自动生成",
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "static_status": {
          "type": "integer",
          "example": 1,
          "enum": [
            0,
            1
          ],
          "description": "表示是否为静态参数,值为1时不支持部署时变更参数,值为0时支持,并且也会把该参数上报流水线",
          "default": 1,
          "format": "int32"
        },
        "limits": {
          "type": "array",
          "maxItems": 30,
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/ParamTypeLimits"
          },
          "description": "当参数类型为enum枚举类型时,必须填写可选值"
        }
      }
    },
    "TemplateTaskResponseBody": {
      "properties": {
        "task_name": {
          "type": "string",
          "description": "应用名称",
          "pattern": "^[a-zA-Z0-9\\一-\\龥-_]+$",
          "maxLength": 128,
          "minLength": 3
        },
        "task_id": {
          "type": "string",
          "description": "部署任务id",
          "maxLength": 32,
          "minLength": 32
        }
      },
      "description": ""
    },
    "TemplateTaskRequestBody": {
      "properties": {
        "project_id": {
          "type": "string",
          "description": "项目id",
          "example": "6039d4480efc4dddb178abff98719913",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "project_name": {
          "type": "string",
          "description": "项目名称",
          "example": "DeployTest",
          "maxLength": 128,
          "minLength": 3
        },
        "template_id": {
          "type": "string",
          "description": "部署模板id",
          "example": "6efb0b24e2e9489eb0e53ee12904a19e",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "task_name": {
          "type": "string",
          "description": "应用名称",
          "example": "templateTest",
          "pattern": "^[a-zA-Z0-9\\一-\\龥-_]+$",
          "maxLength": 128,
          "minLength": 3
        },
        "slave_cluster_id": {
          "type": "string",
          "description": "自定义slave资源池id",
          "example": "9fee11a3722749598cd8468311e082d9",
          "pattern": "^[A-Za-z0-9]{1,32}$"
        },
        "configs": {
          "description": "部署参数类",
          "items": {
            "$ref": "#/definitions/ConfigInfoDO"
          },
          "type": "array"
        }
      },
      "description": "通过模板创建应用请求体",
      "required": [
        "project_id",
        "project_name",
        "template_id",
        "task_name"
      ]
    },
    "ParamTypeLimits": {
      "description": "枚举类型参数实体类",
      "properties": {
        "name": {
          "type": "string",
          "description": "枚举值可选参数",
          "pattern": "^[a-zA-Z0-9\\一-\\龥\\-_.]*$",
          "maxLength": 128,
          "minLength": 1
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),下方类型可任选其一使用:\n                        application/json;charset=utf-8\n                        application/json",
      "enum": [
        "application/json;charset=utf-8",
        "application/json"
      ],
      "type": "string",
      "default": "application/json;charset=utf-8"
