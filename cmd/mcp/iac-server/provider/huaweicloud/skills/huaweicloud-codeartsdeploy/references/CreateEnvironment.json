          "description": "部署类型:0表示主机, 1表示kubernetes",
          "enum": [
            0,
            1
          ],
          "default": 0,
          "example": 0
        },
        "os": {
          "type": "string",
          "description": "操作系统:windows|linux,需要和主机集群保持一致",
          "enum": [
            "windows",
            "linux"
          ],
          "example": "linux",
          "default": "linux"
        },
        "description": {
          "type": "string",
          "description": "环境描述",
