        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "hosts-group-controller-v2"
        ],
        "summary": "新建主机集群",
        "description": "在项目下新建主机集群。该接口于2024年09月30日后不再维护,推荐使用新版CreateHostCluster接口。",
        "operationId": "CreateDeploymentGroup",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "CreateDeploymentGroupRequestBody",
            "in": "body",
            "required": true,
            "description": "创建主机集群请求体",
            "schema": {
              "$ref": "#/definitions/DeploymentGroup"
            }
          },
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "responses": {
          "200": {
            "description": "OK 请求响应成功",
            "schema": {
              "$ref": "#/definitions/DeploymentGroupEntity"
            },
            "examples": {
              "application/json": {
                "group_id": "f3938bd63e354d2bb9d9cf7b5dc3bf95"
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "definitions": {
    "DeploymentGroup": {
      "description": "主机集群详细信息",
      "properties": {
        "name": {
          "type": "string",
          "description": "主机集群名",
          "maxLength": 128,
          "minLength": 3
        },
        "region_name": {
          "type": "string",
          "description": "局点信息",
          "maxLength": 20,
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "description": "项目id",
          "pattern": "^[0-9a-z]{32}$"
        },
        "os": {
          "type": "string",
          "description": "操作信息:windows|linux",
          "enum": [
            "windows",
            "linux"
          ]
        },
        "slave_cluster_id": {
          "type": "string",
          "description": "slave集群id,默认为null时使用默认slave集群,用户自定义slave时为slave集群id",
          "pattern": "^[A-Za-z0-9]{1,32}$"
        },
        "description": {
          "type": "string",
          "description": "描述",
          "maxLength": 500,
          "minLength": 0
        },
        "is_proxy_mode": {
          "type": "integer",
          "description": "主机集群是否为代理类型",
          "example": 1,
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [
        "name",
        "region_name",
        "project_id",
        "os"
      ]
    },
    "DeploymentGroupEntity": {
      "description": "主机集群响应body体",
      "properties": {
        "group_id": {
          "type": "string",
          "description": "主机集群id",
          "pattern": "^[A-Za-z0-9]{32}$"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),下方类型可任选其一使用:\n                        application/json;charset=utf-8\n                        application/json",
      "enum": [
        "application/json;charset=utf-8",
        "application/json"
      ],
      "type": "string",
      "default": "application/json;charset=utf-8"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)",
      "maxLength": 20000,
      "minLength": 0,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "codearts-deploy.la-north-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
