    "EnvironmentPermissionV2Body": {
      "description": "环境修改权限请求体",
      "properties": {
        "role_id": {
          "type": "string",
          "description": "角色id",
          "example": "fb3ecb58-9e5e-4181-a77e-4278a86c4db8",
          "minLength": 0,
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9\\-_]{1,40}$"
        },
        "permission_name": {
          "type": "string",
          "description": "权限名称,can_view:查看权限;can_edit:编辑权限;can_delete:删除权限;can_deploy:部署权限;can_manage:权限管理权限",
          "example": "can_edit",
          "minLength": 0,
          "maxLength": 32,
          "enum": [
            "can_view",
            "can_edit",
            "can_delete",
            "can_deploy",
            "can_manage"
          ]
        },
        "permission_value": {
          "type": "boolean",
          "description": "true 有权限,false 无权限",
          "example": true
        }
      }
    },
    "DevUcEnvironmentPermission": {
      "description": "应用环境鉴权类",
      "properties": {
        "id": {
          "type": "integer",
          "description": "权限id",
          "example": 99213234
        },
        "role_id": {
          "type": "string",
          "description": "角色id",
          "example": "ca50eb2c62ac4290bd71a52e9b6fddae",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9\\-_]{1,40}$"
        },
        "devuc_role_id_list": {
          "type": "array",
          "description": "角色id列表",
          "items": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32
          }
        },
        "role_type": {
          "type": "string",
          "enum": [
            "environment-creator",
            "project",
            "template-customized-inst",
            "template-project-customized",
            "project-customized"
          ],
          "description": "角色类型, environment-creator: 环境创建者; project: 项目管理员;template-customized-inst:系统角色; template-project-customized、project-customized:自定义角色"
        },
        "name": {
          "type": "string",
          "description": "角色名称",
          "example": "MyDemo",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9\\一-\\龥\\-_.]+(\\s+[a-zA-Z0-9\\一-\\龥\\-_.]+)*$"
        },
        "region": {
          "type": "string",
          "description": "局点信息",
          "example": "region"
        },
        "environment_id": {
          "type": "string",
          "description": "环境id",
          "example": "af50fc9452aa0ed5ea2528f61c3cc3d3",
          "minLength": 0,
          "maxLength": 32,
          "pattern": "^[0-9a-z]{32}$"
        },
        "can_view": {
          "type": "boolean",
          "description": "是否有查看权限",
          "example": true
        },
        "can_edit": {
          "type": "boolean",
          "description": "是否有编辑权限",
          "example": true
        },
        "can_delete": {
          "type": "boolean",
          "description": "是否有删除权限",
          "example": true
        },
        "can_deploy": {
          "type": "boolean",
          "description": "是否有部署权限",
          "example": true
        },
        "can_manage": {
          "type": "boolean",
          "description": "是否有权限管理权限",
          "example": true
        },
        "create_time": {
          "type": "string",
          "description": "创建时间",
          "format": "date-time",
          "example": "2022-09-19 10:12:59"
        },
        "update_time": {
          "type": "string",
          "description": "修改时间",
          "format": "date-time",
          "example": "2022-09-19 10:12:59"
        }
      }
