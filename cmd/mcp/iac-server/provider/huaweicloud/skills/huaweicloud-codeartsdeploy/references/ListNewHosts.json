  "definitions": {
    "HostInfoListResponseBody": {
      "description": "主机列表响应体",
      "properties": {
        "total": {
          "type": "integer",
          "description": "主机数量",
          "maximum": 200,
          "minimum": 0,
          "format": "int32"
        },
        "status": {
          "type": "string",
          "description": "请求成功失败状态"
        },
        "result": {
          "type": "array",
          "description": "主机信息列表",
          "items": {
            "$ref": "#/definitions/HostInfo"
          },
          "maxItems": 200,
          "minItems": 0
        }
      }
    },
    "HostInfo": {
      "description": "主机信息",
      "properties": {
        "uuid": {
          "type": "string",
          "description": "主机id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "ip": {
          "type": "string",
          "description": "主机IP"
        },
        "os": {
          "type": "string",
