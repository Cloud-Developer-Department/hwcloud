        },
        "create_time": {
          "type": "string",
          "description": "创建时间"
        },
        "lastest_connection_time": {
          "type": "string",
          "description": "上次连通时间"
        },
        "connection_result": {
          "type": "string",
          "description": "连通性验证结果"
        },
        "nick_name": {
          "type": "string",
          "description": "主机所属人昵称"
        },
        "import_status": {
          "type": "string",
          "description": "导入状态"
        },
        "env_count": {
          "type": "integer",
          "description": "关联环境数量"
        }
      }
    },
    "PermissionHostDetailNew": {
      "description": "主机相关权限详情类",
      "properties": {
        "can_view": {
          "type": "boolean",
          "description": "是否有查看权限"
        },
        "can_edit": {
          "type": "boolean",
          "description": "是否有编辑权限"
        },
        "can_delete": {
          "type": "boolean",
          "description": "是否有删除权限"
        },
        "can_add_host": {
          "type": "boolean",
          "description": "是否有添加主机权限"
        },
        "can_copy": {
          "type": "boolean",
          "description": "是否有复制主机权限"
        }
      }
    },
    "HostAuthorizationBody": {
      "properties": {
        "username": {
          "type": "string",
          "description": "用户名,可输入中英文,数字和符号(-_.)。",
          "example": "username",
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-zA-Z][a-zA-Z0-9\\_\\-\\.@]{1,31}$"
        },
        "password": {
          "type": "string",
          "description": "密码,认证类型为0时,密码必填。",
          "example": "pwd",
          "pattern": "^[^ \\f\\n\\r\\t\\\"\\']{5,32}$"
        },
        "private_key": {
          "type": "string",
          "description": "密钥,认证类型为1时,密钥必填",
          "example": "privatekey",
          "pattern": "^[A-Za-z0-9\\-\\_\\+\\\\=\\/\\s\\r\\n]{1,5000}$",
          "maxLength": 5000,
          "minLength": 1
        },
        "trusted_type": {
          "type": "integer",
          "description": "认证类型,0表示使用密码认证,1表示使用密钥认证",
          "enum": [
            0,
            1
          ],
          "format": "int32",
          "example": 0
        }
      },
      "description": "登录主机鉴权,使用密码登录则填写密码即可,使用密钥则填写密钥,二选一即可。",
      "required": [
        "username",
        "trusted_type"
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
