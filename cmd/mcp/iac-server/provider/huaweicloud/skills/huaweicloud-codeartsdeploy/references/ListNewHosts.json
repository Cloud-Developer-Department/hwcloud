        },
        "port": {
          "type": "integer",
          "description": "端口"
        },
        "authorization": {
          "type": "object",
          "$ref": "#/definitions/HostAuthorizationBody"
        },
        "permission": {
          "type": "object",
          "$ref": "#/definitions/PermissionHostDetailNew"
        },
        "host_name": {
          "type": "string",
          "description": "主机名称"
        },
        "as_proxy": {
          "type": "boolean",
          "description": "是否为代理机"
        },
        "group_id": {
          "type": "string",
          "description": "主机集群id"
        },
        "proxy_host_id": {
          "type": "string",
          "description": "代理机id"
        },
        "owner_id": {
          "type": "string",
          "description": "主机所属人id"
        },
        "owner_name": {
          "type": "string",
