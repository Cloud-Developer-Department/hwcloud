        },
        "name": {
          "type": "string",
          "description": "应用名称",
          "example": "templateTest",
          "pattern": "^[a-zA-Z0-9\\一-\\龥-_]+$",
          "maxLength": 128,
          "minLength": 3
        },
        "description": {
          "type": "string",
          "description": "描述"
        },
