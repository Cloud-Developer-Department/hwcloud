                "enum"
              ]
            }
          }
        }
      ],
      "description": "部署应用时传递的参数"
    },
    "KeyValueDO": {
      "properties": {
        "key": {
          "type": "string",
          "example": "test",
          "description": "部署应用时传递的参数名称",
          "pattern": "^[a-zA-Z0-9\\-_.]*$",
          "maxLength": 128,
          "minLength": 1
        },
        "value": {
          "type": "string",
          "example": "test",
          "description": "部署应用时传递的参数值",
          "pattern": "^(?![\\s\\S]*(\\{[\\{%#]))[\\s\\S]*$",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "description": "部署应用时传递的动态参数"
    },
    "AppComponentDao": {
      "properties": {
        "task_id": {
          "type": "string",
          "description": "部署任务id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "app_id": {
          "type": "string",
          "description": "AOM应用id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "app_name": {
          "type": "string",
          "description": "AOM应用名称",
