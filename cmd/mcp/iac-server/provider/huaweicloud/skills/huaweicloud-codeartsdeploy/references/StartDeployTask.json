        "domain_id": {
          "type": "string",
          "description": "租户id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "region": {
          "type": "string",
          "description": "局点信息",
          "maxLength": 256,
          "minLength": 1
        },
        "state": {
          "type": "string",
          "description": "AOM应用组件是否生效,0表示初始化,1表示执行成功,已生效",
          "example": 0,
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[0-1]{1}$"
        }
      },
      "description": "应用和AOM应用组件对应关系"
    },
    "EnvExecutionBody": {
      "description": "应用启动参数",
      "properties": {
        "params": {
          "description": "部署应用时传递的参数",
          "items": {
            "$ref": "#/definitions/DynamicConfigInfo"
          },
          "type": "array",
          "minItems": 0,
          "maxItems": 500
        },
        "record_id": {
          "type": "string",
          "description": "应用的部署id,可通过record_id回滚至之前的部署状态。选中应用历史部署记录,在URL中获取",
          "pattern": "[A-Za-z0-9]{1,32}$",
          "example": "5bf0a54f36b04ddda7b94470fee39307"
        },
        "trigger_source": {
          "type": "string",
          "description": "限制触发来源,0不限制任何部署请求来源,1时只允许通过流水线触发部署",
          "pattern": "^(0|1)$",
          "example": 0
        }
      }
    },
    "DeployRecordInfo": {
      "description": "部署应用响应体",
      "properties": {
        "id": {
          "type": "string",
