          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "job_name": {
          "type": "string",
          "description": "执行任务名称",
          "minLength": 45,
          "maxLength": 55
        },
        "app_component_list": {
          "description": "应用和AOM应用组件对应关系",
