                "as_proxy": false,
                "proxy_host_id": null,
                "owner_id": "6baa7454109d47c192f22078fe6cda20",
                "owner_name": "devcloud_devcloud_l00490255_01",
                "updator_id": "6baa7454109d47c192f22078fe6cda20",
                "updator_name": "devcloud_devcloud_l00490255_01",
                "connection_status": "success",
                "install_icagent": false,
                "create_time": "2021-05-13 09:35:41",
                "update_time": "2021-05-13 09:35:41",
                "connection_result": "连接成功",
                "lastest_connection_time": "2021-05-13 09:36:11",
                "nick_name": "AB边账号",
                "host_id": "300d6d2e53624d0da08b182099ad10f7"
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "definitions": {
    "DeploymentHostDetail": {
      "description": "主机信息详情",
      "allOf": [
        {
          "$ref": "#/definitions/DeploymentHostInfo"
        },
        {
          "type": "object",
          "properties": {
            "host_id": {
              "type": "string",
              "description": "主机id",
              "pattern": "^[A-Za-z0-9]{32}$"
            },
            "proxy_host": {
              "description": "代理机信息详情",
              "$ref": "#/definitions/DeploymentHostDetail"
            },
            "group_name": {
              "type": "string",
              "description": "主机集群名",
              "maxLength": 128,
              "minLength": 3
            },
            "project_id": {
              "type": "string",
              "description": "项目id",
              "pattern": "^[A-Za-z0-9]{32}$"
            },
            "project_name": {
              "type": "string",
              "description": "项目名称",
              "maxLength": 128,
              "minLength": 3
            },
            "permission": {
              "$ref": "#/definitions/PermissionHostDetail"
            },
            "update_time": {
              "type": "string",
              "description": "更新时间"
            },
            "lastest_connection_time": {
              "type": "string",
              "description": "最后连接时间"
            },
            "connection_status": {
              "type": "string",
              "description": "连接状态"
            },
            "owner_name": {
              "type": "string",
              "description": "拥有者名称"
            },
            "updator_id": {
              "type": "string",
              "description": "维护者id"
            },
            "create_time": {
              "type": "string",
              "description": "创建时间"
            },
            "nick_name": {
              "type": "string",
              "description": "昵称"
            },
            "owner_id": {
              "type": "string",
              "description": "拥有者id"
            },
            "updator_name": {
              "type": "string",
              "description": "维护者名称"
            },
            "connection_result": {
              "type": "string",
              "description": "连接结果"
            }
          }
        }
      ]
    },
    "PermissionHostDetail": {
      "description": "主机相关权限详情类",
      "properties": {
        "can_view": {
          "type": "boolean",
          "description": "是否有查看权限"
        },
        "can_edit": {
          "type": "boolean",
          "description": "是否有编辑权限"
        },
        "can_delete": {
          "type": "boolean",
          "description": "是否有删除权限"
        },
        "can_add_host": {
          "type": "boolean",
          "description": "是否有添加主机权限"
        },
        "can_connection_test": {
          "type": "boolean",
          "description": "是否测试主机连通性权限"
        }
      }
    },
    "DeploymentHostInfo": {
      "required": [
        "group_id",
        "host_name",
        "ip",
        "port",
        "os",
        "as_proxy",
        "authorization"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "description": "主机集群id",
          "example": "ab7647b0863c4e969c8949d38d591339",
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9A-Za-z]{32}$"
        },
        "host_name": {
          "type": "string",
          "description": "主机名称",
          "example": "test",
          "pattern": "^[a-zA-Z0-9\\一-\\龥\\-_.]+(\\s+[a-zA-Z0-9\\一-\\龥\\-_.]+)*$",
          "maxLength": 128,
          "minLength": 3
        },
        "ip": {
          "type": "string",
          "description": "IP,请输入弹性ip格式:161.17.101.12",
          "example": "10.21.155.245",
          "pattern": "^([0-9]{1,2}|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]{1,2}|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]{1,2}|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]{1,2}|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$"
        },
        "port": {
          "type": "integer",
          "description": "ssh端口,如:22",
          "format": "int32",
          "example": 22,
          "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-5])$"
        },
        "os": {
          "type": "string",
          "description": "操作系统:windows|linux,需要和主机集群保持一致",
          "enum": [
            "windows",
            "linux"
          ],
          "example": "linux"
        },
        "as_proxy": {
          "type": "boolean",
          "description": "是否为代理机",
          "example": false
        },
        "proxy_host_id": {
          "type": "string",
          "description": "代理机id",
          "pattern": "^[0-9A-Za-z]{32}$",
          "example": "1ac4c4c4870441b8befb031587fa64bc"
        },
        "authorization": {
          "$ref": "#/definitions/DeploymentHostAuthorizationBody"
        },
        "install_icagent": {
          "type": "boolean",
          "description": "免费启用应用运维服务(AOM),提供指标监控、日志查询、告警功能(自动安装数据采集器 ICAgent,仅支持华为云linux主机)",
          "example": true
        }
      },
      "description": "主机信息body体"
    },
    "DeploymentHostAuthorizationBody": {
      "properties": {
        "username": {
          "type": "string",
          "description": "用户名,可输入中英文,数字和符号(-_.)。",
          "example": "username",
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-zA-Z][a-zA-Z0-9\\_\\-\\.@]{1,31}$"
        },
        "password": {
          "type": "string",
          "description": "密码,认证类型为0时,密码必填。",
          "example": "pwd",
          "pattern": "^[^ \\f\\n\\r\\t\\\"\\']{5,32}$"
        },
        "private_key": {
          "type": "string",
          "description": "密钥,认证类型为1时,密钥必填",
          "example": "privatekey",
          "pattern": "^[A-Za-z0-9\\-\\_\\+\\\\=\\/\\s\\r\\n]{1,5000}$",
          "maxLength": 5000,
          "minLength": 1
        },
        "trusted_type": {
          "type": "integer",
          "description": "认证类型,0表示使用密码认证,1表示使用密钥认证",
          "enum": [
            0,
            1
          ],
          "format": "int32",
          "example": 0
        }
      },
      "description": "登录主机鉴权,使用密码登录则填写密码即可,使用密钥则填写密钥,二选一即可。",
      "required": [
        "username",
        "trusted_type"
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)",
      "maxLength": 20000,
      "minLength": 0,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "codearts-deploy.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}