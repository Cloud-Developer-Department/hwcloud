{
  "name": "ShowDeploymentHostDetail",
  "summary": "查询主机详情",
  "tags": "主机管理",
  "productshort": "CodeArtsDeploy",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v2/host-groups/{group_id}/hosts/{host_id}": {
      "get": {
        "x-request-examples-url-1": "https://{endpoint}/v2/host-groups/ab7647b0863c4e969c8949d38d591339/hosts/300d6d2e53624d0da08b182099ad10f7",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "tags": [
          "hosts-controller-v2"
        ],
        "summary": "查询主机详情",
        "description": "根据主机id查询主机详情。该接口于2024年09月30日后不再维护,推荐使用新版ShowHostDetail接口。",
        "operationId": "ShowDeploymentHostDetail",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "description": "主机集群id",
            "type": "string",
            "pattern": "^[A-Za-z0-9]{32}$"
          },
          {
            "name": "host_id",
            "in": "path",
            "required": true,
            "description": "主机id",
            "type": "string",
            "pattern": "^[A-Za-z0-9]{32}$"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "responses": {
          "200": {
            "description": "OK 请求响应成功",
            "schema": {
              "$ref": "#/definitions/DeploymentHostDetail"
            },
            "examples": {
              "application/json": {
                "ip": "100.101.28.215",
                "port": 22,
                "os": "linux",
                "authorization": {
                  "username": "root",
                  "password": null,
                  "private_key": null,
