        "execution_time": {
          "type": "string",
          "description": "最后一次部署时间",
          "maxLength": 128,
          "minLength": 3
        },
        "description": {
          "type": "string",
          "description": "描述",
          "maxLength": 1024,
          "minLength": 0
        },
        "is_defaut_permission": {
          "type": "boolean",
          "description": "是否使用默认权限矩阵"
        },
        "template_id": {
          "type": "string",
          "description": "模板id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "owner": {
          "type": "string",
          "description": "应用创建者用户名",
          "maxLength": 128,
          "minLength": 0
        },
        "nick_name": {
          "type": "string",
          "description": "应用创建者昵称",
          "maxLength": 128,
          "minLength": 0
        },
        "owner_id": {
          "type": "string",
          "description": "应用创建者用户id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "tenant_id": {
          "type": "string",
          "description": "应用创建者租户id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "tenant_name": {
          "type": "string",
          "description": "应用创建者租户名",
          "maxLength": 128,
          "minLength": 0
        },
        "slave_cluster_id": {
          "type": "string",
          "description": "slave集群id,默认为null时使用默认slave集群,用户自定义slave时为slave集群id",
          "pattern": "^[A-Za-z0-9]{1,32}$"
        },
        "is_care": {
          "type": "boolean",
          "description": "当前用户是否已收藏"
        },
        "can_modify": {
          "type": "boolean",
          "description": "是否有编辑权限"
        },
        "can_delete": {
          "type": "boolean",
          "description": "是否有删除的权限"
        },
        "can_view": {
          "type": "boolean",
          "description": "是否有查看权限"
        },
        "can_execute": {
          "type": "boolean",
          "description": "是否有部署权限"
        },
        "can_copy": {
          "type": "boolean",
          "description": "是否有复制权限"
        },
        "can_manage": {
          "type": "boolean",
          "description": "是否有编辑应用权限矩阵的权限"
        },
        "can_disable": {
          "type": "boolean",
          "description": "是否有禁用应用的权限"
        },
        "app_component_list": {
          "description": "应用和AOM应用组件对应关系",
