          "format": "int32"
        },
        "id": {
          "type": "string",
          "description": "部署任务id"
        },
        "release_id": {
          "type": "integer",
          "description": "部署记录序列号",
          "format": "int32"
        },
        "app_id": {
          "type": "string",
          "description": "部署应用id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "is_disable": {
          "type": "boolean",
          "description": "当前应用是否被禁用"
        },
        "duration": {
          "type": "string",
          "description": "部署时间"
        },
        "execution_state": {
          "type": "string",
          "description": "部署状态"
        },
        "executor_id": {
          "type": "string",
          "description": "部署者id"
        },
        "executor_nick_name": {
          "type": "string",
          "description": "部署者名称"
        },
        "steps": {
          "type": "object",
          "description": "部署步骤",
          "additionalProperties": {
            "$ref": "#/definitions/Step"
          }
        }
      },
      "description": "查询应用详情响应体",
      "type": "object"
    },
    "Step": {
      "type": "object",
      "description": "部署步骤",
      "properties": {
        "id": {
          "type": "string",
          "description": "id"
        },
        "name": {
          "type": "string",
          "description": "名称"
        },
        "params": {
          "type": "object",
          "description": "参数",
          "additionalProperties": {
            "type": "string",
            "description": "附加属性"
          }
        },
        "enable": {
          "type": "boolean",
          "description": "是否开启"
        }
      }
    },
    "AppComponentDao": {
      "properties": {
        "task_id": {
          "type": "string",
          "description": "部署任务id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "app_id": {
          "type": "string",
          "description": "AOM应用id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "app_name": {
          "type": "string",
          "description": "AOM应用名称",
          "pattern": "^deploy_[A-Za-z0-9]{6}$"
        },
        "comp_id": {
          "type": "string",
          "description": "AOM应用组件id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "comp_name": {
          "type": "string",
          "description": "AOM应用组件名称",
          "maxLength": 128,
          "minLength": 0
        },
        "domain_id": {
          "type": "string",
          "description": "租户id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "region": {
          "type": "string",
          "description": "局点信息",
          "maxLength": 256,
          "minLength": 1
        },
        "state": {
          "type": "string",
          "description": "AOM应用组件是否生效,0表示初始化,1表示执行成功,已生效",
          "example": 0,
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[0-1]{1}$"
        }
      },
      "description": "应用和AOM应用组件对应关系"
