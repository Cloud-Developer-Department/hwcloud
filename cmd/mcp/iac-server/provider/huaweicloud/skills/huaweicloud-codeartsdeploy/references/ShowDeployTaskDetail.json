{
  "name": "ShowDeployTaskDetail",
  "summary": "获取应用详情",
  "tags": "应用管理",
  "productshort": "CodeArtsDeploy",
  "region_id": "cn-north-1",
  "paths": {
    "/v2/tasks/{task_id}": {
      "get": {
        "x-request-examples-url-1": "https://{endpoint}/v2/tasks/d2dc947ec2424d8789bb3984bb3adf45",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "tags": [
          "deploy-env-controller-v2"
        ],
        "operationId": "ShowDeployTaskDetail",
        "consumes": [
          "application/json"
        ],
        "summary": "获取应用详情",
        "description": "根据部署任务id获取应用详情。该接口于2024年09月30日后不再维护,推荐使用新版ShowAppDetailById接口。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "部署任务id",
            "type": "string",
            "pattern": "^[A-Za-z0-9]{32}$"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "responses": {
          "200": {
            "description": "OK 请求响应成功",
            "schema": {
