                "slave_cluster_id": "",
                "is_care": false,
                "can_modify": true,
                "can_delete": true,
                "can_view": true,
                "can_execute": true,
                "can_copy": true,
                "can_manage": true,
                "can_disable": false,
                "app_component_list": [],
                "app_id": "88ef50e1d931450989c66adb09acc81d",
