  "definitions": {
    "TaskInfo": {
      "properties": {
        "task_id": {
          "type": "string",
          "description": "部署任务id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "name": {
          "type": "string",
          "description": "应用名称",
          "pattern": "^[a-zA-Z0-9\\一-\\龥-_]+$",
          "maxLength": 128,
          "minLength": 3
        },
        "project_id": {
          "type": "string",
          "description": "项目id",
          "pattern": "^[A-Za-z0-9]{32}$"
        },
        "project_name": {
          "type": "string",
          "description": "项目名称",
          "maxLength": 128,
          "minLength": 3
        },
        "deploy_system": {
          "type": "string",
          "description": "部署类型模式,包括deployTemplate,ansible,shell",
          "pattern": "^[A-Za-z]{1,128}$"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间",
          "example": "2021-02-25 10:37:27",
          "maxLength": 128,
          "minLength": 3
        },
        "update_time": {
          "type": "string",
          "description": "修改时间",
          "maxLength": 128,
          "minLength": 3
