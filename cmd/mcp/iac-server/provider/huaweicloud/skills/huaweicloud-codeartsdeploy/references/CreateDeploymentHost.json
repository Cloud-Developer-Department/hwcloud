{
  "name": "CreateDeploymentHost",
  "summary": "新建主机",
  "tags": "主机管理",
  "productshort": "CodeArtsDeploy",
  "region_id": "cn-east-3",
  "paths": {
    "/v2/host-groups/{group_id}/hosts": {
      "post": {
        "x-request-examples-url-1": "https://{endpoint}/v2/host-groups/ab7647b0863c4e969c8949d38d591339/hosts",
        "x-request-examples-description-1": "新建主机时需填写主机基本信息,信息包含主机名称、IP地址、端口、用户名、密码等。",
        "x-request-examples-text-1": {
          "host_name": "100.101.28.215",
          "ip": "100.101.28.215",
          "port": "22",
          "os": "linux",
          "as_proxy": false,
          "proxy_host_id": "",
          "authorization": {
            "username": "root",
            "password": "*****",
            "private_key": "",
            "trusted_type": 0
          },
          "install_icagent": true
        },
        "x-request-examples-1": {
          "host_name": "100.101.28.215",
          "ip": "100.101.28.215",
          "port": "22",
          "os": "linux",
          "as_proxy": false,
          "proxy_host_id": "",
          "authorization": {
            "username": "root",
            "password": "*****",
            "private_key": "",
            "trusted_type": 0
          },
          "install_icagent": true
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "hosts-controller-v2"
        ],
        "summary": "新建主机",
        "description": "在指定主机集群下新建主机。该接口于2024年09月30日后不再维护,推荐使用新版CreateHost接口。",
        "operationId": "CreateDeploymentHost",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "description": "主机集群id",
            "type": "string",
            "pattern": "^[A-Za-z0-9]{32}$"
          },
          {
            "name": "CreateDeploymentHostRequestBody",
            "in": "body",
            "required": true,
            "description": "创建主机请求体",
            "schema": {
              "$ref": "#/definitions/DeploymentHost"
            }
          },
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "responses": {
          "200": {
            "description": "OK 请求响应成功",
            "schema": {
              "$ref": "#/definitions/DeploymentHostEntity"
            },
            "examples": {
              "application/json": {
                "host_id": "300d6d2e53624d0da08b182099ad10f7"
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "definitions": {
    "DeploymentHostEntity": {
      "description": "主机相关信息",
      "properties": {
        "host_id": {
          "type": "string",
          "description": "主机id"
        }
      }
    },
    "DeploymentHostAuthorizationBody": {
      "properties": {
        "username": {
          "type": "string",
          "description": "用户名,可输入中英文,数字和符号(-_.)。",
          "example": "username",
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-zA-Z][a-zA-Z0-9\\_\\-\\.@]{1,31}$"
        },
        "password": {
          "type": "string",
          "description": "密码,认证类型为0时,密码必填。",
          "example": "pwd",
          "pattern": "^[^ \\f\\n\\r\\t\\\"\\']{5,32}$"
        },
        "private_key": {
          "type": "string",
          "description": "密钥,认证类型为1时,密钥必填",
          "example": "privatekey",
          "pattern": "^[A-Za-z0-9\\-\\_\\+\\\\=\\/\\s\\r\\n]{1,5000}$",
          "maxLength": 5000,
          "minLength": 1
        },
        "trusted_type": {
          "type": "integer",
          "description": "认证类型,0表示使用密码认证,1表示使用密钥认证",
          "enum": [
            0,
            1
          ],
          "format": "int32",
          "example": 0
        }
      },
      "description": "登录主机鉴权,使用密码登录则填写密码即可,使用密钥则填写密钥,二选一即可。",
      "required": [
        "username",
        "trusted_type"
      ]
    },
    "DeploymentHost": {
      "required": [
        "host_name",
        "ip",
        "port",
        "os",
        "as_proxy",
        "authorization"
      ],
      "properties": {
        "host_name": {
          "type": "string",
          "description": "主机名称",
          "example": "test",
          "pattern": "^[a-zA-Z0-9\\一-\\龥\\-_.]+(\\s+[a-zA-Z0-9\\一-\\龥\\-_.]+)*$",
          "maxLength": 128,
          "minLength": 3
        },
        "ip": {
          "type": "string",
          "description": "IP,请输入弹性ip格式:161.17.101.12",
          "example": "10.21.155.245",
          "pattern": "^([0-9]{1,2}|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]{1,2}|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]{1,2}|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]{1,2}|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$"
        },
        "port": {
          "type": "integer",
          "description": "ssh端口,如:22",
          "format": "int32",
          "example": 22,
          "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-5])$"
        },
        "os": {
          "type": "string",
          "description": "操作系统:windows|linux,需要和主机集群保持一致",
          "enum": [
            "windows",
            "linux"
          ],
          "example": "linux"
        },
        "as_proxy": {
          "type": "boolean",
          "description": "是否为代理机",
          "example": false
        },
        "proxy_host_id": {
          "type": "string",
          "description": "代理机id",
          "pattern": "^[0-9A-Za-z]{32}$",
          "example": "1ac4c4c4870441b8befb031587fa64bc"
        },
        "authorization": {
          "$ref": "#/definitions/DeploymentHostAuthorizationBody"
        },
        "install_icagent": {
          "type": "boolean",
          "description": "免费启用应用运维服务(AOM),提供指标监控、日志查询、告警功能(自动安装数据采集器 ICAgent,仅支持华为云linux主机)",
          "example": true
        }
      },
      "description": "主机信息body体"
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),下方类型可任选其一使用:\n                        application/json;charset=utf-8\n                        application/json",
      "enum": [
        "application/json;charset=utf-8",
        "application/json"
      ],
      "type": "string",
      "default": "application/json;charset=utf-8"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)",
      "maxLength": 20000,
      "minLength": 0,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "codearts-deploy.cn-east-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}