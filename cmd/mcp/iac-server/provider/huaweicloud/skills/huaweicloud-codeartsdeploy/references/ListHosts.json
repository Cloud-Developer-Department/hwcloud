{
  "name": "ListHosts",
  "summary": "查询主机列表",
  "tags": "主机管理",
  "productshort": "CodeArtsDeploy",
  "region_id": "cn-north-1",
  "paths": {
    "/v2/host-groups/{group_id}/hosts": {
      "get": {
        "x-request-examples-url-1": "https://{endpoint}/v2/host-groups/ab7647b0863c4e969c8949d38d591339/hosts?offset=0&limit=10&sort_key=AS_PROXY&sort_dir=asc&with_auth=false",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "hosts-controller-v2"
        ],
        "summary": "查询主机列表",
        "description": "根据主机集群id查询指定主机集群下的主机列表。该接口于2024年09月30日后不再维护,推荐使用新版ListNewHosts接口。",
        "operationId": "ListHosts",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "主机集群id",
            "pattern": "^[A-Za-z0-9]{32}$"
          },
          {
            "name": "as_proxy",
            "in": "query",
            "required": false,
            "description": "是否为代理机",
            "type": "boolean"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "偏移量,表示从此偏移量开始查询,offset大于等于0",
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页显示的条目数量,默认为1000",
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 1000
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "主机名,可输入中英文,数字和符号(-_.)",
            "type": "string",
            "maxLength": 128,
            "minLength": 3
          },
          {
            "name": "sort_key",
            "in": "query",
            "required": false,
            "description": "排序字段,支持:AS_PROXY|HOST_NAME|OS|OWNER_NAME|as_proxy|host_name|os|owner_name|nickName。不填默认为:as_proxy",
            "type": "string",
            "pattern": "^(AS_PROXY|HOST_NAME|OS|OWNER_NAME|as_proxy|host_name|os|owner_name|nickName)$"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "required": false,
            "description": "排序方式,默认为:DESC。DESC:降序排序。ASC:升序排序",
            "type": "string",
            "enum": [
              "DESC",
              "ASC"
            ]
          },
          {
            "name": "with_auth",
            "in": "query",
            "required": false,
            "description": "返回结果是否加密",
            "type": "boolean"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "responses": {
          "200": {
            "description": "OK 请求响应成功",
            "schema": {
              "$ref": "#/definitions/DeploymentHostList"
            },
            "examples": {
              "application/json": {
                "hosts": [
                  {
                    "host_name": "100.101.28.203",
                    "ip": "100.101.28.203",
                    "port": 22,
                    "os": "linux",
                    "authorization": {
                      "username": "root",
                      "password": null,
                      "private_key": null,
                      "trusted_type": 0
                    },
                    "permission": {
                      "can_view": true,
                      "can_edit": true,
                      "can_delete": true,
                      "can_add_host": true,
                      "can_connection_test": true
                    },
                    "host_id": "2cc913cc9a494f09b7320801ebacad02",
                    "group_id": "ab7647b0863c4e969c8949d38d591339",
                    "as_proxy": false,
                    "proxy_host_id": null,
                    "owner_id": "6baa7454109d47c192f22078fe6cda20",
                    "owner_name": "devcloud_devcloud_l00490255_01",
                    "updator_id": "6baa7454109d47c192f22078fe6cda20",
                    "updator_name": "devcloud_devcloud_l00490255_01",
                    "connection_status": "success",
                    "install_icagent": false,
                    "create_time": "2021-04-15 11:01:51",
                    "update_time": "2021-04-21 15:04:24",
                    "connection_result": "连接成功",
                    "lastest_connection_time": "2021-04-15 11:02:00",
                    "nick_name": "AB边账号",
                    "proxy_host": null,
                    "group_name": null,
                    "project_id": "6039d4480efc4dddb178abff98719913",
                    "project_name": null
                  }
                ],
                "total": 1,
                "group_name": "test"
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "definitions": {
    "DeploymentHostDetail": {
      "description": "主机信息详情",
      "allOf": [
        {
          "$ref": "#/definitions/DeploymentHostInfo"
        },
        {
          "type": "object",
          "properties": {
            "host_id": {
              "type": "string",
              "description": "主机id",
              "pattern": "^[A-Za-z0-9]{32}$"
            },
            "proxy_host": {
              "description": "代理机信息详情",
              "$ref": "#/definitions/DeploymentHostDetail"
            },
            "group_name": {
              "type": "string",
              "description": "主机集群名",
              "maxLength": 128,
              "minLength": 3
            },
            "project_id": {
              "type": "string",
              "description": "项目id",
              "pattern": "^[A-Za-z0-9]{32}$"
            },
            "project_name": {
              "type": "string",
              "description": "项目名称",
              "maxLength": 128,
              "minLength": 3
            },
            "permission": {
              "$ref": "#/definitions/PermissionHostDetail"
            },
            "update_time": {
              "type": "string",
              "description": "更新时间"
            },
            "lastest_connection_time": {
              "type": "string",
              "description": "最后连接时间"
            },
            "connection_status": {
              "type": "string",
              "description": "连接状态"
            },
            "owner_name": {
              "type": "string",
              "description": "拥有者名称"
            },
            "updator_id": {
              "type": "string",
              "description": "维护者id"
            },
            "create_time": {
              "type": "string",
              "description": "创建时间"
            },
            "nick_name": {
              "type": "string",
              "description": "昵称"
            },
            "owner_id": {
              "type": "string",
              "description": "拥有者id"
            },
            "updator_name": {
              "type": "string",
              "description": "维护者名称"
            },
            "connection_result": {
              "type": "string",
              "description": "连接结果"
            }
          }
        }
      ]
    },
    "PermissionHostDetail": {
      "description": "主机相关权限详情类",
      "properties": {
        "can_view": {
          "type": "boolean",
          "description": "是否有查看权限"
        },
        "can_edit": {
          "type": "boolean",
          "description": "是否有编辑权限"
        },
        "can_delete": {
          "type": "boolean",
          "description": "是否有删除权限"
        },
        "can_add_host": {
          "type": "boolean",
          "description": "是否有添加主机权限"
        },
        "can_connection_test": {
          "type": "boolean",
          "description": "是否测试主机连通性权限"
        }
      }
    },
    "DeploymentHostInfo": {
      "required": [
        "group_id",
        "host_name",
        "ip",
        "port",
        "os",
        "as_proxy",
        "authorization"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "description": "主机集群id",
          "example": "ab7647b0863c4e969c8949d38d591339",
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9A-Za-z]{32}$"
        },
        "host_name": {
          "type": "string",
          "description": "主机名称",
          "example": "test",
          "pattern": "^[a-zA-Z0-9\\一-\\龥\\-_.]+(\\s+[a-zA-Z0-9\\一-\\龥\\-_.]+)*$",
          "maxLength": 128,
          "minLength": 3
        },
        "ip": {
          "type": "string",
          "description": "IP,请输入弹性ip格式:161.17.101.12",
          "example": "10.21.155.245",
          "pattern": "^([0-9]{1,2}|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]{1,2}|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]{1,2}|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]{1,2}|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$"
        },
        "port": {
          "type": "integer",
          "description": "ssh端口,如:22",
          "format": "int32",
          "example": 22,
          "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-5])$"
        },
        "os": {
          "type": "string",
          "description": "操作系统:windows|linux,需要和主机集群保持一致",
          "enum": [
            "windows",
            "linux"
          ],
          "example": "linux"
        },
        "as_proxy": {
          "type": "boolean",
          "description": "是否为代理机",
          "example": false
        },
        "proxy_host_id": {
          "type": "string",
          "description": "代理机id",
          "pattern": "^[0-9A-Za-z]{32}$",
          "example": "1ac4c4c4870441b8befb031587fa64bc"
        },
        "authorization": {
          "$ref": "#/definitions/DeploymentHostAuthorizationBody"
        },
        "install_icagent": {
          "type": "boolean",
          "description": "免费启用应用运维服务(AOM),提供指标监控、日志查询、告警功能(自动安装数据采集器 ICAgent,仅支持华为云linux主机)",
          "example": true
        }
      },
      "description": "主机信息body体"
    },
    "DeploymentHostList": {
      "description": "非加密情况下,主机列表响应体",
      "properties": {
        "total": {
          "type": "integer",
          "description": "主机数量",
          "maximum": 200,
          "minimum": 0,
          "format": "int32"
        },
        "group_name": {
          "type": "string",
          "description": "主机集群名称",
          "maxLength": 128,
          "minLength": 3
        },
        "hosts": {
          "type": "array",
          "description": "主机列表信息",
          "items": {
            "$ref": "#/definitions/DeploymentHostDetail"
          },
          "maxItems": 200,
          "minItems": 0
        }
      }
    },
    "DeploymentHostAuthorizationBody": {
      "properties": {
        "username": {
          "type": "string",
          "description": "用户名,可输入中英文,数字和符号(-_.)。",
          "example": "username",
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-zA-Z][a-zA-Z0-9\\_\\-\\.@]{1,31}$"
        },
        "password": {
          "type": "string",
          "description": "密码,认证类型为0时,密码必填。",
          "example": "pwd",
          "pattern": "^[^ \\f\\n\\r\\t\\\"\\']{5,32}$"
        },
        "private_key": {
          "type": "string",
          "description": "密钥,认证类型为1时,密钥必填",
          "example": "privatekey",
          "pattern": "^[A-Za-z0-9\\-\\_\\+\\\\=\\/\\s\\r\\n]{1,5000}$",
          "maxLength": 5000,
          "minLength": 1
        },
        "trusted_type": {
          "type": "integer",
          "description": "认证类型,0表示使用密码认证,1表示使用密钥认证",
          "enum": [
            0,
            1
          ],
          "format": "int32",
          "example": 0
        }
      },
      "description": "登录主机鉴权,使用密码登录则填写密码即可,使用密钥则填写密钥,二选一即可。",
      "required": [
        "username",
        "trusted_type"
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)",
      "maxLength": 20000,
      "minLength": 0,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "codearts-deploy.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}