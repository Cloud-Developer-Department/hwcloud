{
  "name": "ListFoldersAndFiles",
  "summary": "查询文件夹和文件信息",
  "tags": "云存储",
  "productshort": "WorkspaceApp",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/cloud-storages/actions/list-folder-files": {
      "get": {
        "tags": [
          "CloudStorage"
        ],
        "summary": "查询文件夹和文件信息",
        "description": "查询指定目录下文件夹和文件信息",
        "operationId": "ListFoldersAndFiles",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "maxLength": 102400,
            "minLength": 1,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "user_name",
            "in": "query",
            "description": "用户名",
            "required": true,
            "type": "string",
            "pattern": "[\\S ]{0,128}$",
            "x-example": "tester"
          },
          {
            "name": "cloud_storage_assignment_id",
            "in": "query",
            "description": "个人文件夹ID。(用户拥有多个文件夹时,如果不传个人文件夹id则选择最早创建的文件系统进行文件查询)",
            "required": false,
            "type": "string",
            "pattern": "[\\S ]{0,128}$",
            "x-example": "2b31ed520x2va3cda3xxxebedb6e57xxxx"
          },
          {
            "name": "folder_url",
            "in": "query",
            "description": "查询文件夹路径",
            "required": true,
            "type": "string",
            "pattern": "^(?=.{1,512}$)([^<>:\"|?*]+[/\\\\])*[^<>:\"|?*]+[/\\\\]?$",
            "x-example": "Backup/"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "指定一个标识符,从该标识符以后按文件名的字典顺序返回文件列表。",
            "required": false,
            "type": "string",
            "pattern": "^.{1,1024}$",
            "x-example": "test"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "列举文件系统的最大数目,返回的文件系统列表将是按照字典顺序的最多前 limit 个,默认取值为1000。",
            "required": false,
            "type": "integer",
            "maximum": 1000000,
            "minimum": 0,
            "x-example": 1000
          }
        ],
        "security": [
          {
            "apig-auth-iam-used-authn5": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应。",
            "schema": {
              "$ref": "#/definitions/ListFoldersAndFilesResp"
            }
          },
          "400": {
            "description": "由于包含语法错误,当前请求无法被服务器理解。",
            "schema": {
              "$ref": "#/definitions/BadRequestErrorResp"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/UnauthorizedErrorResp"
            }
          },
          "403": {
            "description": "没有操作权限。",
            "schema": {
              "$ref": "#/definitions/ForbiddenErrorResp"
            }
          },
          "404": {
            "description": "找不到资源。",
            "schema": {
              "$ref": "#/definitions/NotFoundErrorResp"
            }
          },
          "405": {
            "description": "请求中指定的方法不被允许。",
            "schema": {
              "$ref": "#/definitions/MethodNotAllowedErrorResp"
            }
          },
          "500": {
            "description": "服务内部错误,具体返回错误码请参见错误码说明。",
            "schema": {
              "$ref": "#/definitions/InternalServerErrorResp"
            }
          },
          "503": {
            "description": "服务不可用。",
            "schema": {
              "$ref": "#/definitions/ServiceUnavailableErrorResp"
            }
          }
        },
        "x-request-examples-url-1": "GET /v1/a4da8115c9d8464ead3a38309130523f/cloud-storages/actions/list-folder-files",
        "x-apigateway-cors": false,
        "x-apigateway-match-mode": "NORMAL",
        "x-apigateway-ratelimit": "workspace_default_get",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-apig-group": "public,internal_token",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-apigateway-backend": {
          "type": "HTTP-VPC",
          "httpVpcEndpoints": {
            "name": "wks-appcenter-lb",
            "description": "",
            "method": "GET",
            "path": "/v1/{project_id}/cloud-storages/actions/list-folder-files",
            "scheme": "https",
            "timeout": 30000
          },
          "parameters": [
            {
              "description": "",
              "in": "header",
              "name": "X-Auth-Token",
              "origin": "request",
              "value": "X-Auth-Token"
            },
            {
              "description": "",
              "in": "path",
              "name": "project_id",
              "origin": "request",
              "value": "project_id"
            }
          ]
        }
      }
    }
  },
