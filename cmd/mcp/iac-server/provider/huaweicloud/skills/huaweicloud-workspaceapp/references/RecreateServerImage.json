    "CreateServerImageReq": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "Windows Server 2016 OpenOffice",
          "description": "镜像名称,名称需满足如下规则:\n* 首尾字符不能为空格。\n* 长度范围1~128个字符。\n* 只允许3种字符,英文大小写,数字,特殊字符包含-、.、_、空格和中文。",
          "pattern": "^(?! +)[\\ \\.\\-\\w\\一-\\龥]{0,127}[\\.\\-\\w\\一-\\龥]$"
        },
        "description": {
          "type": "string",
          "example": "Windows Server 2016 OpenOffice",
          "description": "镜像描述,描述需满足如下规则:\n* 首字符不能为空格。\n* 长度范围0~1024个字符。\n* 支持字母、数字、中文。\n* 不支持回车、<、 >字符。",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^(?! +)[^\\r\\n<>]{0,1024}$",
          "default": ""
        },
        "enterprise_project_id": {
          "type": "string",
          "example": "0",
          "description": "**⚠ : 此属性是预留字段,不需要传值,目前镜像产物默认属于default企业项目**\n镜像所属的企业项目ID,默认属于default企业项目。\n关于企业项目ID的获取及企业项目特性的详细信息,请参考“[企业中心总览](https://support.huaweicloud.com/zh-cn/usermanual-em/zh-cn_topic_0123692049.html)”。",
          "minLength": 0,
          "maxLength": 64
        },
        "execute_sysprep": {
          "type": "boolean",
          "description": "是否执行系统封装步骤。",
          "default": true
        }
      },
      "description": "构建云应用镜像的请求体。"
