        "x-apigateway-ratelimit": "workspace_default_get",
        "x-apigateway-request-type": "public",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-apig-group": "internal,public",
        "x-apigateway-backend": {
          "type": "HTTP-VPC",
          "httpVpcEndpoints": {
            "name": "wks-apsmanager-lb",
            "description": "",
            "method": "get",
            "path": "/v1/{project_id}/app-servers/metric-data/{server_id}",
            "scheme": "https",
            "timeout": 30000
          },
          "parameters": [
            {
              "in": "header",
              "name": "X-Auth-Token",
              "value": "X-Auth-Token",
              "description": "",
              "origin": "request"
            },
            {
              "in": "path",
              "name": "project_id",
              "value": "project_id",
