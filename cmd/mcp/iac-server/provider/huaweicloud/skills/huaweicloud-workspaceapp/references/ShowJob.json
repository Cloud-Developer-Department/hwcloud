    "JobDetail": {
      "properties": {
        "job_id": {
          "type": "string",
          "example": "1",
          "description": "任务ID。",
          "readOnly": true
        },
        "job_type": {
          "type": "integer",
          "example": 1,
          "description": "job类型,固定值1。",
          "readOnly": true
        },
        "job_status": {
          "type": "integer",
          "example": 1,
          "description": "job执行状态\n- 0:失败。(如果是开通失败,云运营查询到失败状态,直接退费给客户。如果是变更失败,当前是发运维工单,暂时还不是直接退费给客户。)\n- 1:成功。(处理结果成功。)\n- 2:处理中。\n- 3:正在初始化。",
          "readOnly": true
        },
        "sub_jobs": {
          "type": "array",
          "description": "子任务信息。",
          "readOnly": true,
          "items": {
            "$ref": "#/definitions/SubJobInfo"
          }
        },
        "begin_time": {
          "type": "string",
          "format": "date-time",
          "example": "2022-03-07T10:40:43Z",
          "description": "Job处理开始时间。",
          "readOnly": true
        },
        "end_time": {
          "type": "string",
          "format": "date-time",
          "example": "2022-03-07T10:40:43Z",
          "description": "job处理结束时间。",
          "readOnly": true
        },
        "expected_end_time": {
          "type": "string",
          "format": "date-time",
          "example": "2022-03-07T10:40:43Z",
          "description": "云服务预估的Job处理结束时间,只针对job有效,针对子job无效。",
          "readOnly": true
        },
        "execute_code": {
          "type": "string",
          "example": "0",
          "description": "Job执行结果码。",
          "readOnly": true
        },
        "execute_message": {
          "type": "string",
          "example": "success",
          "description": "Job执行结果描述,以及每个SubJob的执行结果描述。",
          "readOnly": true
        }
      },
      "description": "Job信息详情。"
    },
