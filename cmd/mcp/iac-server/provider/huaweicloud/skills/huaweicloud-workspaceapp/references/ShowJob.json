          "readOnly": true
        },
        "job_type": {
          "type": "integer",
          "example": 2,
          "description": "任务类型,固定值2:子Job。",
          "readOnly": true
        },
        "job_status": {
          "type": "integer",
          "example": 1,
          "description": "job状态\n- 0:失败。\n- 1:成功。\n- 2:处理中。\n- 3:正在初始化。",
          "readOnly": true
        },
        "entities": {
          "type": "array",
          "description": "SubJob中处理的云服务/云资源对象。 创建、规格变更等场景是必填;冻结、解冻、删除等场景可空。",
          "readOnly": true,
          "items": {
            "$ref": "#/definitions/JobResourceInfo"
          }
        },
        "begin_time": {
          "type": "string",
          "format": "date-time",
          "example": "2022-03-07T10:40:43Z",
          "description": "任务开始时间。",
          "readOnly": true
        },
        "end_time": {
          "type": "string",
          "format": "date-time",
          "example": "2022-03-07T10:40:43Z",
          "description": "任务结束时间。",
          "readOnly": true
        },
        "expected_end_time": {
          "type": "string",
          "format": "date-time",
          "example": "2022-03-07T10:40:43Z",
          "description": "云服务预估的Job处理结束时间,只针对job有效,针对子job无效。",
          "readOnly": true
        },
        "execute_code": {
          "type": "string",
          "example": "0",
          "description": "Job执行结果码。",
          "readOnly": true
        },
        "execute_message": {
          "type": "string",
          "example": "execute fail!",
          "description": "Job执行结果描述,以及每个SubJob的执行结果描述。",
          "readOnly": true
        }
      },
      "description": "子任务信息。"
    },
