{
  "name": "ListServerMetricData",
  "summary": "查询指定时间范围指定指标的指定粒度的监控数据",
  "tags": "服务器管理",
  "productshort": "WorkspaceApp",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/app-servers/server-metric-data/{server_id}": {
      "get": {
        "tags": [
          "Server"
        ],
        "summary": "查询指定时间范围指定指标的指定粒度的监控数据",
        "description": "查询指定时间范围指定指标的指定粒度的监控数据,可以通过参数指定需要查询的数据维度。",
        "operationId": "ListServerMetricData",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "maxLength": 2147483647,
            "minLength": 1,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目唯一标识。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "server_id",
            "in": "path",
            "description": "服务器唯一标识。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "namespace",
            "in": "query",
            "description": "服务的命名空间:例如 \"SYS.ECS/AGT.ECS\",当namespace为AGT.ECS,则查询GPU监控指标:  - SYS.ECS:弹性云服务器的基础监控指标。  - AGT.ECS:弹性云服务器操作系统监控的监控指标(GPU指标)。",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^(SYS.ECS|AGT.ECS)?$"
          },
          {
            "name": "metric_name",
            "in": "query",
            "description": "监控查询指标名称:  - SYS.ECS命名空间的指标名称,请参考帮助文档:“[弹性云服务器支持的基础监控指标](https://support.huaweicloud.com/usermanual-ecs/ecs_03_1002.html)”。  - AGT.ECS命名空间的指标名称,请参考帮助文档:“[操作系统监控指标:GPU](https://support.huaweicloud.com/usermanual-ecs/ecs_03_1003.html#section11)”。",
            "required": true,
            "type": "string",
            "maxLength": 255,
            "minLength": 1
          },
          {
            "name": "from",
            "in": "query",
            "description": "查询数据起始时间,UNIX时间戳,单位毫秒。",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "x-example": 1691671739879
          },
          {
            "name": "to",
            "in": "query",
            "description": "查询数据截止时间UNIX时间戳,单位毫秒。from必须小于to。",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "x-example": 1691671739879
          },
          {
            "name": "period",
            "in": "query",
            "description": "监控数据粒度。 取值范围:  - 1: 实时数据。  - 300: 5分钟粒度。  - 1200: 20分钟粒度。  - 3600: 1小时粒度。  - 14400: 4小时粒度。  - 86400: 1天粒度。",
            "required": true,
            "type": "integer",
            "format": "int32",
            "x-example": 300
          },
          {
            "name": "filter",
            "in": "query",
            "description": "数据聚合方式,支持的聚合方式如下:  - average:聚合周期内指标数据的平均值。  - max:聚合周期内指标数据的最大值。  - min:聚合周期内指标数据的最小值。  - sum:聚合周期内指标数据的求和值。  - variance:聚合周期内指标数据的方差。",
            "required": true,
            "type": "string",
            "pattern": "^(average|max|min|sum|variance)?$",
            "x-example": "average"
          }
        ],
        "security": [
          {
            "apig-auth-iam-used-authn5": []
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "examples": {
              "application/json": {
                "server_metrics": [
                  {
                    "datapoints": [
                      {
                        "average": 0.23,
                        "timestamp": 1442341200000,
                        "unit": "%"
