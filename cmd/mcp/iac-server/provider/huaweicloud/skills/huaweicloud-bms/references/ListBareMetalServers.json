{
  "name": "ListBareMetalServers",
  "summary": "查询裸金属服务器详情列表",
  "tags": "裸金属服务器生命周期管理",
  "productshort": "BMS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/baremetalservers/detail": {
      "get": {
        "summary": "查询裸金属服务器详情列表",
        "description": "用户根据设置的请求条件筛选裸金属服务器,并获取裸金属服务器的详细信息。该接口支持查询裸金属服务器计费方式,以及是否被冻结。",
        "tags": [
          "裸金属服务器生命周期管理"
        ],
        "operationId": "ListBareMetalServers",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)",
            "required": true,
            "type": "string",
            "x-order": 1
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "type": "string",
            "required": true,
            "x-order": 2
          },
          {
            "name": "flavor",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "裸金属服务器规格ID",
            "x-order": 3
          },
          {
            "name": "name",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "裸金属服务器名称",
            "x-order": 4
          },
          {
            "name": "status",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "裸金属服务器状态,只有管理员可以使用DELETED状态过滤查询已经删除的裸金属服务器。取值范围:ACTIVE、BUILD、ERROR、HARD_REBOOT、REBOOT、REBUILD、SHUTOFF",
            "x-order": 5
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "每页返回裸金属服务器的条数,默认值是25,最大值为1000。limit为每页返回裸金属服务器详情的条数",
            "x-order": 6
          },
          {
            "name": "offset",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "此接口为分页查询接口,offset为查询页码(起始页码为1),返回值包括总条数和裸金属服务器详情列表。传入offset:按limit值分页(limit默认为1000),返回第offset页裸金属服务器详情列表和总条数,总条数最大值为limit,不足按实际情况返回。不传入offset,传入limit:返回裸金属服务器详情列表和总条数,总条数最大值为limit,不足按实际情况返回。不传入offset,不传入limit:按25条分页,返回第1页裸金属服务器详情列表,总条数最大值为25,不足按实际情况返回。",
            "x-order": 7
          },
          {
            "name": "tags",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "裸金属服务器标签:__type_baremetal",
            "x-order": 8
          },
          {
            "name": "reservation_id",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "批量创建裸金属服务器时,指定返回的ID,用于查询本次批量创建的裸金属服务器",
            "x-order": 9
          },
          {
            "name": "detail",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "查询裸金属服务器结果的详细级别,级别越高,查询到的裸金属服务器信息越多,默认为4。可使用的级别为 1,2,3,4",
            "x-order": 10
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "查询绑定某个企业项目的裸金属服务器",
            "x-order": 11
          }
        ],
