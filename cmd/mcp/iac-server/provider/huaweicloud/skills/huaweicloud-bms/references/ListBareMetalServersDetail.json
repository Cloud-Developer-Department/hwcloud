  "definitions": {
    "FlavorDetailInfos": {
      "properties": {
        "id": {
          "description": "裸金属服务器规格ID",
          "type": "string"
        },
        "name": {
          "description": "裸金属服务器规格名称",
          "type": "string"
        },
        "disk": {
          "description": "该裸金属服务器规格对应要求系统盘大小,0为不限制。",
          "type": "integer"
        },
        "vcpus": {
          "description": "该裸金属服务器规格对应的CPU核数",
          "type": "integer"
        },
        "ram": {
          "description": "该裸金属服务器规格对应的内存大小,单位为MB",
          "type": "integer"
        },
        "gpus": {
          "type": "array",
          "description": "该裸金属服务器规格对应的GPU设备。",
          "items": {
            "$ref": "#/definitions/GpuInfo"
          }
        },
        "asic_accelerators": {
          "type": "array",
          "description": "该裸金属服务器规格对应的ASIC设备。",
          "items": {
            "$ref": "#/definitions/ASICAcceleratorInfo"
          }
        }
      },
      "description": "flavor数据结构说明"
    },
    "ServerListDetails": {
      "required": [
        "id",
        "name",
        "tenant_id",
        "status"
      ],
      "properties": {
        "id": {
          "description": "裸金属服务器ID,格式为UUID",
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "description": "创建裸金属服务器的用户ID,格式为UUID。",
          "type": "string"
        },
        "name": {
          "description": "裸金属服务器名称",
          "type": "string",
          "x-minLength": 1,
          "x-maxLength": 58,
          "pattern": "^[A-Z0-9-._~]+$"
        },
        "created": {
          "description": "裸金属服务器创建时间。时间戳格式为ISO 8601:YYYY-MM-DDTHH:MM:SSZ,例如:2019-05-22T03:30:52Z",
          "type": "string"
        },
        "updated": {
          "description": "裸金属服务器更新时间。时间戳格式为ISO 8601:YYYY-MM-DDTHH:MM:SSZ,例如:2019-05-22T04:30:52Z",
          "type": "string"
        },
        "tenant_id": {
          "description": "裸金属服务器所属租户ID,格式为UUID。该参数和project_id表示相同的概念。",
          "type": "string"
        },
        "flavor": {
          "description": "裸金属服务器规格信息。详情请参见表6 flavor数据结构说明。",
          "$ref": "#/definitions/FlavorDetailInfos"
        },
        "status": {
          "description": "裸金属服务器当前状态信息。\n\n取值范围:\n\nACTIVE:运行中/正在关机/删除中\nBUILD:创建中\nERROR:故障\nHARD_REBOOT:强制重启中\nREBOOT:重启中\nDELETED:实例已被正常删除\nSHUTOFF:关机/正在开机/删除中/重建中/重装操作系统中/重装操作系统失败/冻结",
          "type": "string",
          "enum": [
            "ACTIVE",
            "BUILD",
            "ERROR",
            "HARD_REBOOT",
            "REBOOT",
            "DELETED",
            "SHUTOFF"
          ]
        },
        "task_state": {
          "description": "扩展属性,裸金属服务器当前的任务状态。例如:rebooting:重启中reboot_started:普通重启reboot_started_hard:强制重启powering-off:关机中powering-on:开机中rebuilding:重建中scheduling:调度中deleting:删除中",
          "type": "string",
          "enum": [
            "rebooting",
            "reboot_started",
            "reboot_started_hard",
            "powering-off",
            "powering-on",
            "rebuilding",
            "scheduling",
            "deleting"
          ]
        },
        "vm_state": {
          "description": "扩展属性,裸金属服务器的稳定状态。例如:active:运行中shutoff:关机reboot:重启",
          "type": "string",
          "enum": [
            "active",
            "shutoff",
            "reboot"
          ]
        },
        "availability_zone": {
          "description": "扩展属性,裸金属服务器所在可用分区名称。",
          "type": "string"
        },
        "fault": {
          "description": "裸金属服务器故障原因。详情请参见表 fault数据结构说明。",
          "$ref": "#/definitions/Fault"
        },
        "in_recycle_bin": {
          "description": "裸机是否在回收站中",
          "type": "boolean"
        }
      },
      "description": "server字段数据结构说明"
    },
    "Error": {
      "properties": {
        "message": {
          "description": "任务异常错误信息描述",
          "type": "string"
        },
        "code": {
          "description": "任务异常错误信息编码",
          "type": "string"
        }
      },
      "description": "提交任务异常时返回的异常信息"
    },
    "Fault": {
      "properties": {
        "message": {
          "description": "故障信息",
          "type": "string"
        },
        "code": {
          "description": "故障code",
          "type": "integer",
          "format": "int32"
        },
        "details": {
          "description": "故障详情",
          "type": "string"
        },
        "created": {
          "description": "故障时间。时间戳格式为ISO 8601:YYYY-MM-DDTHH:MM:SSZ,例如:2019-05-22T03:30:52Z",
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "fault字段数据结构说明"
    },
    "QueryBaremetalServerListDetailResponse": {
      "required": [
        "servers"
      ],
      "properties": {
        "servers": {
          "description": "裸金属服务器详情列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ServerListDetails"
          }
        }
      }
    },
    "GpuInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "GPU设备名称。"
        },
        "count": {
          "type": "integer",
          "description": "GPU设备数量。"
        },
        "memory_mb": {
          "type": "integer",
          "description": "GPU设备的内存,单位为MB。"
        }
      }
    },
    "FailedRsp": {
      "properties": {
        "error": {
          "description": "提交任务异常时返回的异常信息",
          "$ref": "#/definitions/Error"
        }
      },
      "description": "FailedRsp"
    },
    "ASICAcceleratorInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "ASIC设备名称。"
        },
        "count": {
          "type": "integer",
          "description": "ASIC设备数量。"
        },
        "memory_mb": {
          "type": "integer",
          "description": "ASIC设备的内存,单位为MB。"
        }
      }
    }
  },
