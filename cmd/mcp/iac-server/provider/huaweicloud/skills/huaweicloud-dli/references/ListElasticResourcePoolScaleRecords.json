              }
            },
            "headers": {
              "X-Auth-Token": {
                "description": "租户token",
                "type": "string"
              }
            }
          }
        },
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc,hws_hk",
        "x-order": 7
      }
    }
