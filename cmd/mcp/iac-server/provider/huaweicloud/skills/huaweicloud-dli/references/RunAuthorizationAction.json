        "tags": [
          "权限相关API"
        ],
        "summary": "数据赋权(用户、项目)",
        "description": "该API用于将DLI资源权限赋给、回收、更新指定的其他用户或项目。",
        "operationId": "RunAuthorizationAction",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc,hws_hk",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "RunAuthorizationActionRequestBody",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RunAuthorizationActionRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/SuccessResponse"
            }
          },
          "400": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/FailResponse"
            }
          }
        },
        "x-order": 0
      }
    }
  },
  "definitions": {
    "FailResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述信息。"
        }
      },
      "type": "object"
    },
    "Privilege": {
      "type": "object",
      "required": [
        "object",
        "privileges"
      ],
      "properties": {
        "object": {
          "type": "string",
          "description": "赋权的DLI资源,具体可参考https://support.huaweicloud.com/usermanual-dli/dli_01_0417.html"
        },
        "privileges": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "待赋权,回收或更新的权限列表。\n说明:\n若“action”为“update”,更新列表为空,则表示回收用户在DLI的所有资源权限。"
        }
      }
    },
    "SuccessResponse": {
      "properties": {
        "is_success": {
          "type": "boolean",
          "description": "执行请求是否成功。“true”表示请求执行成功。"
        },
        "message": {
          "type": "string",
          "description": "系统提示信息,执行成功时,信息可能为空。"
        }
      },
      "type": "object"
    },
    "RunAuthorizationActionRequestBody": {
      "type": "object",
      "required": [
        "action",
        "privileges"
      ],
      "properties": {
        "user_name": {
          "type": "string",
          "description": "被赋权的用户名称,该用户将有权访问指定的DLI资源权限,被收回或者更新访问权限。"
        },
        "projectId": {
          "type": "string",
          "description": "被赋权的项目ID,数据赋权给其他项目后,该项目的管理员将有权访问指定的数据库或数据表。"
        },
        "action": {
          "type": "string",
          "description": "指定赋权或回收。值为:grant,revoke或update。\n 说明:当用户同时拥有grant和revoke权限的时候才有权限使用update操作。",
          "enum": [
            "grant",
            "revoke",
            "update"
          ]
        },
        "privileges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Privilege"
          },
          "description": "赋权信息。具体参数请参考Privilege参数。"
        }
      }
    }
  },
