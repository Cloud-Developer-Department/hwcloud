  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/queues/{queue_name}/properties": {
      "get": {
        "tags": [
          "队列相关API"
        ],
        "summary": "获取队列属性",
        "description": "获取队列配置的属性",
        "operationId": "ListQueueProperties",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID, 用于资源隔离",
            "pattern": "^[A-Za-z0-9_]+$",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "queue_name",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "队列名称",
            "pattern": "^(?!_)(?![0-9]+$)[A-Za-z0-9_]*$",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "校验token",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "偏移量",
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页显示条数",
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 1000
          }
        ],
        "responses": {
          "200": {
            "description": "队列属性列表结果",
            "schema": {
              "$ref": "#/definitions/ListQueuePropertiesResponseBody"
            }
          },
          "400": {
            "description": "失败结果",
            "schema": {
              "$ref": "#/definitions/FailResponse"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "string"
            }
          }
        },
        "x-order": 9,
        "deprecated": false,
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc,hws_hk"
      }
    }
  },
  "definitions": {
    "ListQueuePropertiesResponseBody": {
      "type": "object",
      "description": "获取队列属性返回值",
      "properties": {
        "is_success": {
          "type": "boolean",
          "example": true
        },
        "message": {
          "type": "string",
          "example": ""
        },
        "properties": {
          "items": {
            "$ref": "#/definitions/QueueProperty"
          },
          "type": "array"
        }
      },
      "required": [
        "is_success",
        "message",
        "properties"
      ],
      "example": {
        "message": "ok",
        "is_success": true,
        "properties": [
          {
            "key": "computeEngine.maxInstance",
            "value": "2"
          },
          {
            "key": "computeEngine.maxPrefetchInstance",
            "value": "1"
          },
          {
            "key": "job.maxConcurrent",
            "value": "32"
          },
          {
            "key": "multipleSc.support",
            "value": "true"
          }
        ]
      }
    },
    "FailResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述信息。"
        }
      },
      "type": "object"
    },
    "QueueProperty": {
      "required": [
        "key",
        "value"
      ],
      "type": "object",
      "properties": {
        "key": {
          "example": "computeEngine.maxInstances",
          "enum": [
            "computeEngine.maxInstances",
            "computeEngine.maxPrefetchInstance",
            "job.maxConcurrent",
            "multipleSc.support",
            "job.saveJobResultToJobBucket",
            "computeEngine.spark.nativeEnabled"
          ],
          "description": "返回属性值对应的key值: computeEngine.maxInstances, 队列能启动的最大spark driver数量; computeEngine.maxPrefetchInstance, 队列预先启动的最大spark driver数量; job.maxConcurrent,单个spark driver能同时运行的最大任务数量; multipleSc.support,是否支持设置多个spark driver; job.saveJobResultToJobBucket, 是否使用作业桶保存SQL查询结果,true代表开启; computeEngine.spark.nativeEnabled, 是否使用DLI Native;",
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  },
