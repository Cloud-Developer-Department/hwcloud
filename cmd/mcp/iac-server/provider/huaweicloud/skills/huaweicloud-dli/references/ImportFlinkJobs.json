{
  "name": "ImportFlinkJobs",
  "summary": "flink作业导入",
  "tags": "Flink作业-作业相关API",
  "productshort": "DLI",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1.0/{project_id}/streaming/jobs/import": {
      "post": {
        "tags": [
          "Flink作业-作业相关API"
        ],
        "summary": "flink作业导入",
        "description": "通过POST方式,导入flink作业,请求体为JSON格式。",
        "operationId": "ImportFlinkJobs",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号,用于资源隔离。",
            "required": true,
            "type": "string",
            "x-order": 1
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户Token。",
            "required": true,
            "type": "string",
            "x-order": 2
          },
          {
            "in": "body",
            "name": "ImportFlinkJobsRequestBody",
            "description": "导入作业的请求参数。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ImportFlinkJobsRequestBody"
            },
            "x-order": 3
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "is_success": true,
                "message": "导入作业成功",
                "jobs_mapping": [
                  {
                    "old_job_id": "100",
                    "new_job_id": "200",
                    "remark": "Job successfully created"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ImportFlinkJobsResponseBody"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "DLI.29002",
                "error_msg": "zip file path error"
              }
            },
            "schema": {
              "$ref": "#/definitions/FailResponse"
            }
          }
        },
        "deprecated": false,
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc,hws_hk",
        "x-apiErrorCodes": "[]",
        "x-order": 12
      }
    }
  },
  "definitions": {
    "FailResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述信息。"
        }
      },
      "type": "object"
    },
    "ImportFlinkJobsRequestBody": {
      "required": [
        "zip_file"
      ],
      "properties": {
        "zip_file": {
          "type": "string",
          "example": "obs-test/aggregate_1582677879475.zip",
          "description": "OBS上导入作业zip文件路径,支持填写目录,导入目录下所有zip文件。",
          "minLength": 1,
          "maxLength": 256
        },
        "is_cover": {
          "type": "boolean",
          "example": false,
          "description": "若导入作业中存在与服务已有作业同名情况,是否将服务中已有作业覆盖。",
          "default": false
        }
      },
      "description": "导入作业的请求参数。",
      "type": "object"
    },
    "JobMap": {
      "properties": {
        "old_job_id": {
          "type": "integer",
          "format": "int64",
          "description": "导入文件中的作业ID。"
        },
        "new_job_id": {
          "type": "integer",
          "format": "int64",
          "description": "导入完成后作业ID,若is_cover=false,服务中已有同名的作业,则为-1。"
        },
        "remark": {
          "type": "string",
          "description": "导入作业结果信息。"
        }
      },
      "description": "导入job作业结果的模型。",
      "type": "object"
    },
    "ImportFlinkJobsResponseBody": {
      "properties": {
        "is_success": {
          "type": "string",
          "description": "执行请求是否成功。“true”表示请求执行成功。"
        },
        "message": {
          "type": "string",
          "description": "消息内容。"
        },
        "job_mapping": {
          "type": "array",
          "description": "作业导入结果。",
          "items": {
            "$ref": "#/definitions/JobMap"
          }
        }
      },
      "description": "导入作业响应参数。",
      "type": "object"
    }
  },
