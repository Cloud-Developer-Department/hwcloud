  "region_id": "ae-ad-1",
  "paths": {
    "/v1.0/{project_id}/user-authorization": {
      "put": {
        "tags": [
          "已弃用-委托与权限相关API"
        ],
        "summary": "数据赋权(用户)",
        "description": "该API用于将数据库或数据表的数据权限赋给指定的其他用户。\n说明:\n被赋权用户所在用户组的所属区域需具有Tenant Guest权限。",
        "operationId": "RunDataAuthorizationAction",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号,用于资源隔离。",
            "required": true,
            "type": "string",
            "x-example": "48cc2c48765f481480c7db940d6409d1",
            "x-order": 1
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "从IAM服务获取的用户Token。",
            "required": true,
            "type": "string",
            "x-example": "xxx",
            "x-order": 3,
            "x-vision": ""
          },
          {
            "in": "body",
            "name": "RunDataAuthorizationActionRequestBody",
            "description": "队列赋权的请求body体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RunDataAuthorizationActionRequestBody"
            },
            "x-order": 2,
            "x-vision": ""
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/SuccessResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/FailResponse"
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "deprecated": true,
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc,hws_hk",
        "x-apiErrorCodes": "[]",
        "x-order": 2
      }
    }
  },
  "definitions": {
    "FailResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述信息。"
        }
      },
      "type": "object"
    },
    "RunDataAuthorizationActionRequestBody": {
      "required": [
        "user_name",
        "action",
        "privileges"
      ],
      "properties": {
        "user_name": {
          "type": "string",
          "example": "user2",
          "description": "被赋权的用户名称,该用户将有权访问指定的数据库或数据表,被收回或者更新访问权限。",
          "x-vision": ""
        },
        "action": {
          "type": "string",
          "example": "grant",
          "description": "指定赋权或回收。值为:grant,revoke或update。\n说明:\n当用户同时拥有grant和revoke权限的时候才有权限使用update操作。",
          "x-vision": ""
        },
        "privileges": {
          "type": "array",
          "description": "赋权信息。",
          "items": {
            "$ref": "#/definitions/DataAuthorizationPrivilege"
          },
          "x-vision": ""
        }
      },
      "description": "数据授权的请求body体。",
      "type": "object"
    },
    "SuccessResponse": {
      "properties": {
        "is_success": {
          "type": "boolean",
          "description": "执行请求是否成功。“true”表示请求执行成功。"
        },
        "message": {
          "type": "string",
          "description": "系统提示信息,执行成功时,信息可能为空。"
        }
      },
      "type": "object"
    },
    "DataAuthorizationPrivilege": {
      "required": [
        "object",
        "privileges"
      ],
      "properties": {
        "object": {
          "type": "string",
          "example": "databases.db1.tables.tb2.columns.column1",
          "description": "被赋权的数据对象,命名方式为:\n“databases.数据库名”,则数据库下面的所有数据都将被共享。\n“databases.数据库名.tables.表名”, 指定的表的数据将被共享。\n“databases.数据库名.tables.表名.columns.列名”,指定的列将被共享。\n\"jobs.flink.flink作业ID\",指定的作业将被共享。\n\"groups.程序包组名\",指定的程序包组将被共享。\n\"resources.程序包名\",指定程序包将被共享。",
          "x-vision": ""
        },
        "privileges": {
          "type": "array",
          "description": "待赋权、回收或更新的权限列表。\n说明:\n若“action”为“update”,更新列表为空,则表示回收用户在该数据库或表的所有权限",
          "items": {
            "type": "string"
          },
          "x-vision": ""
        }
      },
      "description": "数据赋权的赋权信息。",
      "type": "object"
    }
  },
