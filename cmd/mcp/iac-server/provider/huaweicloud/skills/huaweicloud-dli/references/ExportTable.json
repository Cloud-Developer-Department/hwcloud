  "definitions": {
    "FailResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述信息。"
        }
      },
      "type": "object"
    },
    "AsyncJobSuccessResponse": {
      "properties": {
        "is_success": {
          "type": "boolean",
          "example": true,
          "description": "请求发送是否成功。“true”表示请求发送成功。",
          "x-vision": ""
        },
        "message": {
          "type": "string",
          "example": "import data to table t2 started",
          "description": "系统提示信息,执行成功时,信息可能为空。",
          "x-vision": ""
        },
        "job_id": {
          "type": "string",
          "example": "6b29eb77-4c16-4e74-838a-2cf7959e9202",
          "description": "此SQL将生成并提交一个新的作业,返回作业ID。用户可以使用作业ID来查询作业状态和获取作业结果。",
          "x-vision": ""
        },
        "job_mode": {
          "type": "string",
          "description": "作业执行方式,是同步还是异步执行"
        }
      },
      "type": "object"
    },
    "ExportTableRequestBody": {
      "required": [
        "data_path",
        "data_type",
        "database_name",
        "table_name",
        "compress"
      ],
      "properties": {
        "data_path": {
          "type": "string",
          "example": "s3a://home/data1/DLI/test",
          "description": "导出数据的储存路径(当前仅支持将数据存储在OBS上,且OBS路径须以s3a开头)。另外,“export_mode”配置为“errorifexists”时,该路径下的文件夹须不存在,如请求样例中的“test”文件夹。",
          "x-vision": ""
        },
        "data_type": {
          "type": "string",
          "example": "cvs",
          "description": "导出数据的类型(当前仅支持csv格式数据)。",
          "x-vision": ""
        },
        "database_name": {
          "type": "string",
          "example": "db2",
          "description": "被导出数据的表所在的数据库名称。",
          "x-vision": ""
        },
        "table_name": {
          "type": "string",
          "example": "day1.cvs",
          "description": "被导出数据的表名称。",
          "x-vision": ""
        },
        "compress": {
          "type": "string",
          "example": "gzip",
          "description": "导出数据的压缩方法。目前支持gzip、bzip2、deflate压缩方式;若不希望压缩,则输入none。",
          "x-vision": ""
        },
        "queue_name": {
          "type": "string",
          "example": "queue1",
          "description": "指定执行该任务的队列。若不指定队列,将采用default队列执行操作。",
          "x-vision": ""
        },
        "export_mode": {
          "type": "string",
          "example": "Overwrite",
          "description": "导出模式,目前支持“ErrorIfExists”,“Overwrite”,不指定“export_mode”则默认为“ErrorIfExists”。\n\n“ErrorIfExists”:存在即报错。指定的导出目录必须不存在,如果指定目录已经存在,系统将返回错误信息,无法执行导出操作。\n“Overwrite”:覆盖。在指定目录下新建文件,会删除已有文件。",
          "x-vision": ""
        },
        "with_column_header": {
          "type": "boolean",
          "example": true,
          "description": "导出csv格式数据时,是否导出列名。\n\n设置为“true”,表示导出列名。\n设置为“false”,表示不导出列名。\n若为空,默认为“false”。",
          "default": false,
          "x-vision": ""
        }
      },
      "description": "导出数据",
      "type": "object"
    }
  },
