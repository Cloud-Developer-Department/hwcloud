        "error_msg": {
          "type": "string",
          "description": "错误描述信息。"
        }
      },
      "type": "object"
    },
    "Tag": {
      "type": "object",
      "description": "资源标签",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "example": "key",
          "description": "参数解释:  键 示例: key\n约束限制:  长度大于等于1且小于等于128\n取值范围: 无\n默认取值: 无",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "example": "value",
          "description": "参数解释:  值 示例: value\n约束限制:  长度大于等于1且小于等于255\n取值范围: 无\n默认取值: 无",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "CreateSqlJobRequestBody": {
      "required": [
        "sql"
      ],
      "properties": {
        "sql": {
          "type": "string",
          "maxLength": 500000,
          "example": "desc table1",
          "description": "参数解释: 待执行的SQL语句 示例: desc table1\n约束限制:  无\n取值范围: 无\n默认取值: 无"
        },
        "engine_type": {
          "type": "string",
          "enum": [
            "hetuEngine",
            "spark"
          ],
          "example": "hetuEngine",
          "description": "参数解释: 待提交作业的队列引擎名称,名称只能包含英文字母 示例: hetuEngine\n约束限制:  无\n取值范围: hetuEngine,spark\n默认取值: 无",
          "x-vision": ""
        },
        "current_catalog": {
          "type": "string",
          "pattern": "^(?!_)(?![0-9]+$)[A-Za-z0-9_]*$",
          "minLength": 0,
          "maxLength": 128,
          "example": "dli",
          "description": "参数解释: 待提交作业的表默认catalog 示例: dli\n约束限制:  匹配正则表达式'^(?!_)(?![0-9]+$)[A-Za-z0-9_]*$'且长度在[0,128]范围内的字符串\n取值范围: 无\n默认取值: 无",
          "x-vision": ""
        },
        "currentdb": {
          "type": "string",
          "pattern": "^(?!_)(?![0-9]+$)[A-Za-z0-9_]*$",
          "minLength": 0,
          "maxLength": 128,
          "example": "db1",
          "description": "参数解释: SQL语句执行所在的数据库。当创建新数据库时,不需要提供此参数 示例: db1\n约束限制:  匹配正则表达式'^(?!_)(?![0-9]+$)[A-Za-z0-9_]*$'且长度在[0,128]范围内的字符串\n取值范围: 无\n默认取值: 无",
          "x-vision": ""
        },
        "queue_name": {
          "type": "string",
          "pattern": "^(?!_)(?![0-9]+$)[A-Za-z0-9_]*$",
          "minLength": 1,
          "maxLength": 128,
          "example": "q1",
          "description": "参数解释: 待提交作业的队列名称,名称只能包含数字、英文字母和下划线,但不能是纯数字,且不能以下划线开头 示例: q1\n约束限制:  匹配正则表达式'^(?!_)(?![0-9]+$)[A-Za-z0-9_]*$'且长度在[1,128]范围内的字符串\n取值范围: 无\n默认取值: 无",
          "x-vision": ""
        },
        "conf": {
          "type": "array",
          "description": "参数解释: 用户以“key/value”的形式设置用于此作业的配置参数 示例: spark.sql.files.maxRecordsPerFile = 0, spark.sql.shuffle.partitions = 200\n约束限制:  元素满足key=value格式的字符串数组\n取值范围: 无\n默认取值: dli.sql.sqlasync.enabled = true",
          "items": {
            "type": "string"
          },
          "example": "spark.sql.files.maxRecordsPerFile = 0, spark.sql.shuffle.partitions = 200",
          "default": "dli.sql.sqlasync.enabled = true"
        },
        "tags": {
          "type": "array",
          "description": "作业标签",
          "items": {
            "description": "",
            "$ref": "#/definitions/Tag"
          }
        }
      },
      "description": "提交SQL作业"
    },
    "CreateSqlJobResponseBody": {
      "required": [
        "is_success",
        "job_id",
        "job_type",
        "message"
      ],
      "properties": {
        "is_success": {
          "type": "boolean",
          "example": true,
          "description": "参数解释: 当“job_type”为“DCL”时,为请求执行是否成功。“true”表示请求执行成功 示例: true\n约束限制:  无\n取值范围: true,false\n默认取值: 无",
          "x-vision": ""
        },
        "message": {
          "type": "string",
          "example": "success",
          "description": "参数解释: 系统提示信息,执行成功时,信息可能为空 示例: success\n约束限制:  无\n取值范围: 无\n默认取值: 无",
          "x-vision": ""
        },
        "job_id": {
          "type": "string",
          "example": "8ecb0777-9c70-4529-9935-29ea0946039c",
          "description": "参数解释: 此SQL语句将生成并提交一个新作业,返回此作业的ID,可用于获取作业状态和作业结果 示例: 8ecb0777-9c70-4529-9935-29ea0946039c\n约束限制:  无\n取值范围: 无\n默认取值: 无",
          "x-vision": ""
        },
        "job_type": {
          "type": "string",
          "example": "DCL",
          "description": "参数解释:  指定查询的作业类型,包含DDL、DCL、IMPORT、EXPORT、QUERY、INSERT、DATA_MIGRATION、UPDATE、DELETE、RESTART_QUEUE、SCALE_QUEUE,若要查询所有类型的作业,则传入ALL。 示例: QUERY\n约束限制:  无\n取值范围: DDL、DCL、IMPORT、EXPORT、QUERY、INSERT、DATA_MIGRATION、UPDATE、DELETE、RESTART_QUEUE、SCALE_QUEUE、ALL\n默认取值: 无",
          "enum": [
            "DDL",
            "DCL",
            "IMPORT",
            "EXPORT",
            "QUERY",
            "INSERT",
            "DATA_MIGRATION",
            "UPDATE",
            "DELETE",
            "RESTART_QUEUE",
            "SCALE_QUEUE",
            "ALL"
          ],
          "x-vision": ""
        },
        "schema": {
          "type": "array",
          "description": "参数解释:  当语句类型为DDL时,返回其结果的列名称及类型 示例: [{\"col_name\": \"string\"},{\"data_type\": \"string\"},{\"comment\": \"string\"}]\n约束限制:  无\n取值范围: 无\n默认取值: 无",
          "items": {
            "type": "object"
          },
          "example": "[{\"col_name\": \"string\"},{\"data_type\": \"string\"},{\"comment\": \"string\"}]",
          "x-vision": ""
        },
        "rows": {
          "type": "array",
          "description": "参数解释:  当语句类型为DDL时,直接返回其执行结果 示例: [[\"c1\",\"int\",null],[\"c2\",\"string\",null]]\n约束限制:  无\n取值范围: 无\n默认取值: 无",
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "x-vision": ""
        },
        "job_mode": {
          "type": "string",
          "example": "async",
          "description": "参数解释:  表示作业执行方式,是同步还是异步的 示例: async\n约束限制:  无\n取值范围: async(异步) sync(同步)\n默认取值: 无",
          "enum": [
            "async",
            "sync"
          ]
        }
      },
      "description": "提交SQL作业"
    }
  },
