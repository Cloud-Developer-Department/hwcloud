{
  "name": "ShowCredential",
  "summary": "获取临时密钥和securityToken",
  "tags": "Credential",
  "productshort": "LakeFormation",
  "region_id": "cn-southwest-2",
  "paths": {
    "/v1/{project_id}/instances/{instance_id}/credential": {
      "post": {
        "x-request-examples-text-1": {
          "user_names": [
            "user1"
          ],
          "groups": [
            "superGroup"
          ],
          "roles": [
            "admin"
          ]
        },
        "x-request-examples-1": {
          "user_names": [
            "user1"
          ],
          "groups": [
            "superGroup"
          ],
          "roles": [
            "admin"
          ]
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v1/{project_id}/instances/{instance_id}/credential",
        "x-apiexplorer-hide": "N",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "Credential"
        ],
        "summary": "获取临时密钥和securityToken",
        "description": "获取临时密钥和securityToken,失效时间大于等于1小时,请在1小时内更新",
        "operationId": "ShowCredential",
        "x-enable-auth-anno": {
          "type": "iam-token"
        },
        "x-iam-auth-meta-anno": {
          "authLevel": "instance",
          "abacAction": "lakeformation:credential:describe"
        },
        "x-cts-meta-anno": {
          "resourceType": "Credential",
          "traceName": "getCredential",
          "isAsyncApi": "false"
        },
        "x-method-annotations": [
          "@ApiCount"
        ],
        "x-imports": [
          "com.huawei.lakeformation.common.annotation.ApiCount;"
        ],
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "租户token",
            "required": true,
            "minItems": 1,
            "maxItems": 100
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号。获取方法,请参见[获取项目ID](lakeformation_04_0026.xml)。",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+$"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "LakeFormation实例ID。创建实例时自动生成。例如:2180518f-42b8-4947-b20b-adfc53981a25。",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{36}$",
            "minLength": 1
          },
          {
            "name": "ShowCredentialRequestBody",
            "in": "body",
            "required": true,
            "description": "用户/用户组/角色信息",
            "schema": {
              "$ref": "#/definitions/IdentityInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Credential"
            },
            "examples": {
              "application/json": {
                "access": "ABC***123",
                "secret": "ABC***123",
                "security_token": "abc***000"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "examples": {
              "application/json": {
                "error_code": "common.01000001",
                "error_msg": "failed to read http request, please check your input, code: 400, reason: Type mismatch., cause: TypeMismatchException"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": "{\n  \"error_code\": 'APIG.1002',\n  \"error_msg\": 'Incorrect token or token resolution failed'\n}"
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error": {
                  "code": "403",
                  "message": "X-Auth-Token is invalid in the request",
                  "error_code": null,
                  "error_msg": null,
                  "title": "Forbidden"
                },
                "error_code": "403",
                "error_msg": "X-Auth-Token is invalid in the request",
                "title": "Forbidden"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "examples": {
              "application/json": {
                "error_code": "common.01000001",
                "error_msg": "response status exception, code: 404"
              }
            }
          },
          "408": {
            "description": "Request Timeout",
            "examples": {
              "application/json": {
                "error_code": "common.00000408",
                "error_msg": "timeout exception occurred"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "examples": {
              "application/json": {
                "error_code": "common.00000500",
                "error_msg": "internal error"
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "IdentityInput": {
      "type": "object",
      "description": "用户名称,用户组,角色三个信息",
      "properties": {
        "user_names": {
          "type": "array",
          "description": "IAM用户",
          "example": "",
          "minItems": 0,
          "items": {
            "example": "admin",
            "pattern": "^[a-zA-Z_0-9]+$",
            "minLength": 1,
            "maxLength": 256,
            "type": "string"
          },
          "maxItems": 50
        },
        "groups": {
          "type": "array",
          "description": "用户组",
          "minItems": 0,
          "items": {
            "example": "superGroup",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-zA-Z_0-9]+$",
            "type": "string"
          },
          "maxItems": 50
        },
        "roles": {
          "type": "array",
          "description": "角色",
          "minItems": 0,
          "items": {
            "example": "admin",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-zA-Z_0-9]+$",
            "type": "string"
          },
          "maxItems": 50
        }
      }
    },
    "ErrorMessage": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "lakeformation.00010003"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "example": "failed"
        },
        "common_error_code": {
          "description": "CBC公共错误码",
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "example": "CMM.1008"
        },
        "solution_msg": {
          "description": "解决方案描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "example": "Please use correct instance id."
        }
      },
      "type": "object"
    },
    "Credential": {
      "type": "object",
      "description": "临时密钥和securityToken",
      "properties": {
        "access": {
          "type": "string",
          "description": "AK。Access Key,是用来标识用户身份的访问密钥。",
          "minLength": 0,
          "maxLength": 65534
        },
        "secret": {
          "type": "string",
          "description": "SK。Secret Key,用来对访问密钥进行加密签名,以验证身份。",
          "minLength": 0,
          "maxLength": 65534
        },
        "security_token": {
          "type": "string",
          "description": "security_token是将所获的AK、SK等信息进行加密后的字符串",
          "minLength": 0,
          "maxLength": 65534
        }
      }
    }
  },
  "version": "2.0",
