{
  "name": "ListTables",
  "summary": "根据条件分页列举表信息",
  "tags": "数据表管理",
  "productshort": "LakeFormation",
  "region_id": "la-north-2",
  "paths": {
    "/v1/{project_id}/instances/{instance_id}/catalogs/{catalog_name}/databases/{database_name}/tables": {
      "get": {
        "x-request-examples-url-1": "GET https://{endpoint} /v1/{project_id}/instances/{instance_id}/catalogs/{catalog_name}/databases/{database_name}/tables",
        "x-apiexplorer-hide": "N",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigw-publish": "Y",
        "tags": [
          "Table"
        ],
        "summary": "根据条件分页列举表信息",
        "description": "返回数据库下符合查询条件的表的元数据信息,不支持事务操作。\n当表名通配符或表类型不为空时,优先根据表名和类型筛选过滤。\n当表名通配符或表类型为空时,再根据属性筛选过滤。",
        "operationId": "ListTables",
        "x-enable-auth-anno": {
          "type": "iam-token"
        },
        "x-iam-auth-meta-anno": {
          "authLevel": "instance",
          "abacAction": "lakeformation:table:describe"
        },
        "x-method-annotations": [
          "@ApiCount"
        ],
        "x-imports": [
          "com.huawei.lakeformation.common.annotation.ApiCount;"
        ],
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "租户token。",
            "required": true,
            "minItems": 1,
            "maxItems": 100
          },
          {
            "name": "project_id",
            "in": "path",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+$",
            "description": "项目编号。获取方法,请参见[获取项目ID](lakeformation_04_0026.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{36}$|default",
            "description": "LakeFormation实例ID。创建实例时自动生成。例如:2180518f-42b8-4947-b20b-adfc53981a25。"
          },
          {
            "name": "catalog_name",
            "in": "path",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "[a-zA-Z0-9_]+",
            "description": "catalog名称。只能包含字母、数字和下划线,且长度为1~256个字符。",
            "required": true,
            "type": "string"
          },
          {
            "name": "database_name",
            "in": "path",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9\\一-\\龥_-]*$",
            "description": "数据库名称。只能包含中文、字母、数字、下划线、中划线,且长度为1~128个字符。",
            "required": true,
            "type": "string"
          },
          {
            "name": "table_name_pattern",
            "in": "query",
            "description": "表名称通配符。只能包含中文、字母、数字和_|*.-特殊字符,且长度为1~256个字符。",
            "type": "string",
            "required": false,
            "maxLength": 256,
            "pattern": "^[a-zA-Z0-9\\一-\\龥_|*.-]*$",
            "default": "",
            "minLength": 1
          },
          {
            "name": "table_format",
            "in": "query",
            "required": false,
            "description": "表格式。支持HIVE,ICEBERG,LANCE",
            "type": "string",
            "enum": [
              "HIVE",
              "ICEBERG",
              "LANCE"
            ],
            "pattern": "^(HIVE|ICEBERG|LANCE)$"
          },
          {
            "name": "table_type",
            "in": "query",
            "description": "表类型:MANAGED_TABLE-内表、EXTERNAL_TABLE-外表、VIRTUAL_VIEW-视图、MATERIALIZED_VIEW-物化视图、DICTIONARY_TABLE字典表、LAKE_TABLE内表。",
            "required": false,
            "type": "string",
            "enum": [
              "MANAGED_TABLE",
              "EXTERNAL_TABLE",
              "VIRTUAL_VIEW",
              "MATERIALIZED_VIEW",
              "DICTIONARY_TABLE",
              "LAKE_TABLE"
            ]
          },
          {
            "name": "filter",
            "in": "query",
            "minLength": 0,
            "maxLength": 1000,
            "description": "过滤条件字符串,可以按照属性查询表。\n支持的属性查找包括:\nHIVE_FILTER_FIELD_OWNER\nHIVE_FILTER_FIELD_LAST_ACCESS\nHIVE_FILTER_FIELD_PARAMS",
            "type": "string",
            "required": false,
            "default": ""
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询返回条数。默认值为100。最小值为1,最大值为1000。当include_fields只包含name时,最大值可以为5000",
            "default": 100,
            "type": "integer",
            "format": "int32",
            "required": false,
            "maximum": 5000,
            "minimum": 1
          },
          {
            "name": "marker",
            "in": "query",
            "description": "查询的起始记录ID。最小长度为0,最大长度为256。",
            "type": "string",
            "required": false,
            "maxLength": 1024,
            "minLength": 0,
            "default": ""
          },
          {
            "name": "reverse_page",
            "in": "query",
            "description": "是否倒序查询。",
            "default": false,
            "type": "boolean",
            "required": false,
            "x-annotations": [
              "@UsNoConstraint(reason = \"Boolean类型无需校验\")"
            ],
            "x-imports": [
              "com.huawei.us.validator.annotation.UsNoConstraint;"
            ]
          },
          {
            "name": "deleted",
            "in": "query",
            "required": false,
            "description": "是否查询被删除元数据。",
            "type": "boolean",
            "default": false,
            "x-annotations": [
              "@UsNoConstraint(reason = \"Boolean类型无需校验\")"
            ],
            "x-imports": [
              "com.huawei.us.validator.annotation.UsNoConstraint;"
            ]
          },
          {
            "name": "include_fields",
            "in": "query",
            "required": false,
            "description": "包含字段,非必填,多个字段使用英文逗号分隔,不填时返回全部字段,当前暂只支持name",
            "type": "string"
          }
        ],
        "responses": {
