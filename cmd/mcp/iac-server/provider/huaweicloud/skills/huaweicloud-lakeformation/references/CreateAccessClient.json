{
  "name": "CreateAccessClient",
  "summary": "创建服务接入客户端",
  "tags": "接入管理",
  "productshort": "LakeFormation",
  "region_id": "cn-southwest-2",
  "paths": {
    "/v1/{project_id}/instances/{instance_id}/access-clients": {
      "post": {
        "x-request-examples-text-1": {
          "name": "name-example",
          "vpc_id": "vpc-example",
          "subnet_id": "subnet-example"
        },
        "x-apiexplorer-hide": "N",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-enable-auth-anno": {
          "type": "iam-token"
        },
        "x-iam-auth-meta-anno": {
          "authLevel": "instance",
          "abacAction": "lakeformation:instance:access",
          "rbac": "te_admin"
        },
        "x-cts-meta-anno": {
          "resourceType": "Instance",
          "traceName": "createAccessClient",
          "isAsyncApi": "true"
        },
        "tags": [
          "Access"
        ],
        "summary": "创建服务接入客户端",
        "description": "创建服务接入客户端。\n其他限制:\n  同一个实例下默认最多创建20个接入客户端。",
        "operationId": "CreateAccessClient",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "x-request-examples-url-1": "POST https://{endpoint}/v1/{project_id}/instances/{instance_id}/access-clients",
        "x-request-examples-1": {
          "name": "lakeformation_client",
          "vpc_id": "d3fcxxxxxxxxxxxxxxxxxxxxxxxxxxxx8f1e",
          "subnet_id": "d3fcxxxxxxxxxxxxxxxxxxxxxxxxxxxx8f1e"
        },
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户token",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 65534,
            "x-example": "MIIjxxxxxxxxxxxxxxxxxxxxxxxx4qA="
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号。获取方法,请参见[获取项目ID](lakeformation_04_0026.xml)。",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-zA-Z]{32}$",
            "x-example": "41aaxxxxxxxxxxxxxxxxxxxxxxxcc046"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "LakeFormation实例ID。创建实例时自动生成。例如:2180518f-42b8-4947-b20b-adfc53981a25。",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{36}$",
            "x-example": "d3fcxxxxxxxxxxxxxxxxxxxxxxxxxxxx8f1e"
          },
          {
            "in": "body",
            "name": "CreateAccessClientRequestBody",
            "description": "申请接入信息",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AccessClientRequestBody"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/AccessClientInfo"
            },
            "examples": {
              "application/json": {
                "id": "gs23xxxxxxxxxxxxxxxxxxxxxxxxxxxxfgs2",
                "name": "lakeformation_client",
                "access_mode": "SYSTEM",
                "vpc_id": "d3fcxxxxxxxxxxxxxxxxxxxxxxxxxxxx8f1e",
                "subnet_id": "d3fcxxxxxxxxxxxxxxxxxxxxxxxxxxxx8f1e",
                "status": "CREATING"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "AccessClientInfo": {
      "description": "接入客户端信息",
      "properties": {
        "id": {
          "type": "string",
          "description": "客户端ID",
          "minLength": 0,
          "maxLength": 65534
        },
        "name": {
          "type": "string",
          "description": "客户端名称",
          "minLength": 0,
          "maxLength": 65534
        },
        "access_mode": {
          "type": "string",
          "description": "接入模式,SYSTEM,CUSTOM,AUTO",
          "enum": [
            "SYSTEM",
            "CUSTOM",
            "AUTO"
          ]
        },
        "status": {
          "type": "string",
          "description": "客户端状态,CREATING,RUNNING,DELETING,DELETED,CREATE_FAIL,DELETE_FAIL",
          "enum": [
            "CREATING",
            "RUNNING",
            "DELETING",
            "DELETED",
            "CREATE_FAIL",
            "DELETE_FAIL"
          ]
        },
        "vpc_id": {
          "type": "string",
          "description": "VPC ID",
          "minLength": 0,
          "maxLength": 65534
        },
        "subnet_id": {
          "type": "string",
          "description": "子网ID",
          "minLength": 0,
          "maxLength": 65534
        },
        "access_connections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AccessConnectionInfo"
          },
          "description": "接入连接列表",
          "minItems": 0,
          "maxItems": 100000
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "实例创建时间戳"
        }
      }
    },
    "AccessClientRequestBody": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "LakeFormation_client",
          "description": "客户端名称",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_-]{4,32}$"
        },
        "access_mode": {
          "type": "string",
          "description": "接入模式,\nSYSTEM:系统默认模式,由系统自动创建vpcep连接,也是推荐方式。该模式下vpc_id、subnet_id必填。\nCUSTOM:定制模式,由外部服务自行创建vpcep连接,适用于跨租户场景等。该模式下access_connection必填。",
          "enum": [
            "SYSTEM",
            "CUSTOM"
          ],
          "default": "SYSTEM"
        },
        "vpc_id": {
          "type": "string",
          "description": "VPC ID",
          "pattern": "^[a-zA-Z0-9-]{36}$"
        },
        "subnet_id": {
          "type": "string",
          "description": "子网ID",
          "pattern": "^[a-zA-Z0-9-]{36}$"
        },
        "access_connections": {
          "type": "array",
          "description": "接入连接列表",
          "items": {
            "$ref": "#/definitions/AccessConnectionRequestBody"
          },
          "maxItems": 100,
          "minItems": 0
        }
      },
      "description": "创建接入客户端的请求信息"
    },
    "AccessConnectionRequestBody": {
      "description": "创建接入连接的请求信息",
      "properties": {
        "vpcep_id": {
          "type": "string",
          "description": "虚拟私有云终端节点ID。在 接入管理-创建客户端-前往VPC创建-VPC终端节点 创建和查看。",
          "maxLength": 64,
          "minLength": 0
        },
        "vpcep_service_name": {
          "type": "string",
          "description": "终端节点服务名称。最大长度为64个字符。",
          "maxLength": 64,
          "minLength": 0
        },
        "domain": {
          "type": "string",
          "description": "接入域名,通过IP接入访问Lakeformation API时,需在请求头中添加HOST参数并传入该域名。",
          "maxLength": 100,
          "minLength": 0
        }
      }
    },
    "AccessConnectionInfo": {
      "description": "接入连接信息",
      "properties": {
        "vpcep_id": {
          "type": "string",
          "description": "虚拟私有云终端节点ID。在 接入管理-创建客户端-前往VPC创建-VPC终端节点 创建和查看。",
          "minLength": 0,
          "maxLength": 65534
        },
        "ip": {
          "type": "string",
          "description": "接入IP",
          "minLength": 0,
          "maxLength": 65534
        },
        "owner": {
          "type": "string",
          "description": "拥有者",
          "minLength": 0,
          "maxLength": 65534
        },
        "domain": {
          "type": "string",
          "description": "接入域名,通过IP接入访问Lakeformation API时,需在请求头中添加HOST参数并传入该域名。",
          "minLength": 0,
          "maxLength": 65534
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "lakeformation.cn-southwest-2.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}