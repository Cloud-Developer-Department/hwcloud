{
  "name": "ListAccessClientInfos",
  "summary": "获取服务接入客户端信息列表",
  "tags": "接入管理",
  "productshort": "LakeFormation",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/instances/{instance_id}/access-clients": {
      "get": {
        "x-apiexplorer-hide": "N",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-enable-auth-anno": {
          "type": "iam-token"
        },
        "x-iam-auth-meta-anno": {
          "authLevel": "instance",
          "abacAction": "lakeformation:instance:describe",
          "rbac": "te_admin"
        },
        "tags": [
          "Access"
        ],
        "summary": "获取服务接入客户端信息列表",
        "description": "根据LakeFormation实例获取服务实例相关的接入客户端信息列表。",
        "operationId": "ListAccessClientInfos",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/instances/{instance_id}/access-clients",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户token",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 65534,
            "x-example": "MIIjxxxxxxxxxxxxxxxxxxxxxxxx4qA="
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号。获取方法,请参见[获取项目ID](lakeformation_04_0026.xml)。",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-zA-Z]{32}$",
            "x-example": "41aaxxxxxxxxxxxxxxxxxxxxxxxcc046"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "LakeFormation实例ID。创建实例时自动生成。例如:2180518f-42b8-4947-b20b-adfc53981a25。",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{36}$",
            "x-example": "d3fcxxxxxxxxxxxxxxxxxxxxxxxxxxxx8f1e"
          },
          {
            "name": "id",
            "in": "query",
            "type": "string",
            "required": false,
            "pattern": "^[a-zA-Z0-9-]{36}$",
            "description": "ID搜索。根据ID进行搜索。"
          },
          {
            "name": "name",
            "in": "query",
            "type": "string",
            "required": false,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "maxLength": 32,
            "description": "名称关键字搜索。只能包含字母、数字、下划线和中划线,且最大长度为32个字符。"
          },
          {
            "name": "offset",
            "in": "query",
            "type": "integer",
            "required": true,
            "minimum": 0,
            "maximum": 1000,
            "default": 0,
            "description": "分页查询时的偏移量。默认值为0。最小值为0,最大值为1000。",
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "required": false,
            "default": 10,
            "description": "分页一页显示数。默认值为10。最小值为1,最大值为1000。",
            "x-example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/AccessClientInfos"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "access_client_infos": [
                  {
                    "id": "gs23xxxxxxxxxxxxxxxxxxxxxxxxxxxxfgs2",
                    "name": "lakeformation_client",
                    "access_mode": "SYSTEM",
                    "vpc_id": "d3fcxxxxxxxxxxxxxxxxxxxxxxxxxxxx8f1e",
                    "subnet_id": "d3fcxxxxxxxxxxxxxxxxxxxxxxxxxxxx8f1e",
                    "status": "RUNNING",
                    "access_connections": [
                      {
                        "vpcep_id": "0612xxxxxxxxxxxxxxxxxxxxxxxxxxxxa8fb",
                        "ip": "10.1.0.1",
                        "domain": "xxxxxx.com"
                      },
                      {
                        "vpcep_id": "0612xxxxxxxxxxxxxxxxxxxxxxxxxxxxa8fb",
                        "ip": "10.1.0.2",
                        "domain": "xxxxxx.com"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "AccessClientInfo": {
      "description": "接入客户端信息",
      "properties": {
        "id": {
          "type": "string",
          "description": "客户端ID",
          "minLength": 0,
          "maxLength": 65534
        },
        "name": {
          "type": "string",
          "description": "客户端名称",
          "minLength": 0,
          "maxLength": 65534
        },
        "access_mode": {
          "type": "string",
          "description": "接入模式,SYSTEM,CUSTOM,AUTO",
          "enum": [
            "SYSTEM",
            "CUSTOM",
            "AUTO"
          ]
        },
        "status": {
          "type": "string",
          "description": "客户端状态,CREATING,RUNNING,DELETING,DELETED,CREATE_FAIL,DELETE_FAIL",
          "enum": [
            "CREATING",
            "RUNNING",
            "DELETING",
            "DELETED",
            "CREATE_FAIL",
            "DELETE_FAIL"
          ]
        },
        "vpc_id": {
          "type": "string",
          "description": "VPC ID",
          "minLength": 0,
          "maxLength": 65534
        },
        "subnet_id": {
          "type": "string",
          "description": "子网ID",
          "minLength": 0,
          "maxLength": 65534
        },
        "access_connections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AccessConnectionInfo"
          },
          "description": "接入连接列表",
          "minItems": 0,
          "maxItems": 100000
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "实例创建时间戳"
        }
      }
    },
    "AccessClientInfos": {
      "properties": {
        "access_client_infos": {
          "type": "array",
          "description": "接入客户端信息列表",
          "items": {
            "$ref": "#/definitions/AccessClientInfo"
          },
          "maxItems": 1000,
          "minItems": 0
        },
        "total": {
          "type": "integer",
          "description": "接入客户端信息总数",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "description": "接入客户端信息列表"
    },
    "AccessConnectionInfo": {
      "description": "接入连接信息",
      "properties": {
        "vpcep_id": {
          "type": "string",
          "description": "虚拟私有云终端节点ID。在 接入管理-创建客户端-前往VPC创建-VPC终端节点 创建和查看。",
          "minLength": 0,
          "maxLength": 65534
        },
        "ip": {
          "type": "string",
          "description": "接入IP",
          "minLength": 0,
          "maxLength": 65534
        },
        "owner": {
          "type": "string",
          "description": "拥有者",
          "minLength": 0,
          "maxLength": 65534
        },
        "domain": {
          "type": "string",
          "description": "接入域名,通过IP接入访问Lakeformation API时,需在请求头中添加HOST参数并传入该域名。",
          "minLength": 0,
          "maxLength": 65534
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "lakeformation.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}