{
  "name": "ShowAccessClient",
  "summary": "获取服务接入客户端详情",
  "tags": "接入管理",
  "productshort": "LakeFormation",
  "region_id": "cn-north-11",
  "paths": {
    "/v1/{project_id}/instances/{instance_id}/access-clients/{client_id}": {
      "get": {
        "tags": [
          "Access"
        ],
        "operationId": "ShowAccessClient",
        "summary": "获取服务接入客户端详情",
        "description": "根据ID获取服务接入客户端详情",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-enable-auth-anno": {
          "type": "iam-token"
        },
        "x-iam-auth-meta-anno": {
          "abacAction": "lakeformation:instance:describe",
          "authLevel": "instance",
          "rbac": "te_admin"
        },
        "produces": [
          "application/json"
        ],
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/instances/{instance_id}/access-clients/{client_id}",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户token",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 65534,
            "x-example": "MIIjxxxxxxxxxxxxxxxxxxxxxxxx4qA="
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号。获取方法,请参见[获取项目ID](lakeformation_04_0026.xml)。",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-zA-Z]{32}$",
            "x-example": "41aaxxxxxxxxxxxxxxxxxxxxxxxcc046"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "LakeFormation实例ID。创建实例时自动生成。例如:2180518f-42b8-4947-b20b-adfc53981a25。",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{36}$",
            "x-example": "d3fcxxxxxxxxxxxxxxxxxxxxxxxxxxxx8f1e"
          },
          {
            "name": "client_id",
            "in": "path",
            "description": "客户端ID。创建客户端时自动生成。",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{36}$",
            "x-example": "gs23xxxxxxxxxxxxxxxxxxxxxxxxxxxxfgs2"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/AccessClientInfo"
            },
            "examples": {
              "application/json": {
                "id": "gs23xxxxxxxxxxxxxxxxxxxxxxxxxxxxfgs2",
                "name": "lakeformation_client",
                "access_mode": "SYSTEM",
                "status": "RUNNING",
                "vpc_id": "d3fcxxxxxxxxxxxxxxxxxxxxxxxxxxxx8f1e",
                "subnet_id": "d3fcxxxxxxxxxxxxxxxxxxxxxxxxxxxx8f1e",
                "access_connections": [
                  {
                    "vpcep_id": "0612xxxxxxxxxxxxxxxxxxxxxxxxxxxxa8fb"
                  }
                ],
                "create_time": "2023-05-30T01:22:44.100Z"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "AccessClientInfo": {
      "description": "接入客户端信息",
      "properties": {
        "id": {
          "type": "string",
          "description": "客户端ID",
          "minLength": 0,
          "maxLength": 65534
        },
        "name": {
          "type": "string",
          "description": "客户端名称",
          "minLength": 0,
          "maxLength": 65534
        },
        "access_mode": {
          "type": "string",
          "description": "接入模式,SYSTEM,CUSTOM,AUTO",
          "enum": [
            "SYSTEM",
            "CUSTOM",
            "AUTO"
          ]
        },
        "status": {
          "type": "string",
          "description": "客户端状态,CREATING,RUNNING,DELETING,DELETED,CREATE_FAIL,DELETE_FAIL",
          "enum": [
            "CREATING",
            "RUNNING",
            "DELETING",
            "DELETED",
            "CREATE_FAIL",
            "DELETE_FAIL"
          ]
        },
        "vpc_id": {
          "type": "string",
          "description": "VPC ID",
          "minLength": 0,
          "maxLength": 65534
        },
        "subnet_id": {
          "type": "string",
          "description": "子网ID",
          "minLength": 0,
          "maxLength": 65534
        },
        "access_connections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AccessConnectionInfo"
          },
          "description": "接入连接列表",
          "minItems": 0,
          "maxItems": 100000
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "实例创建时间戳"
        }
      }
    },
    "AccessConnectionInfo": {
      "description": "接入连接信息",
      "properties": {
        "vpcep_id": {
          "type": "string",
          "description": "虚拟私有云终端节点ID。在 接入管理-创建客户端-前往VPC创建-VPC终端节点 创建和查看。",
          "minLength": 0,
          "maxLength": 65534
        },
        "ip": {
          "type": "string",
          "description": "接入IP",
          "minLength": 0,
          "maxLength": 65534
        },
        "owner": {
          "type": "string",
          "description": "拥有者",
          "minLength": 0,
          "maxLength": 65534
        },
        "domain": {
          "type": "string",
          "description": "接入域名,通过IP接入访问Lakeformation API时,需在请求头中添加HOST参数并传入该域名。",
          "minLength": 0,
          "maxLength": 65534
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "lakeformation.cn-north-11.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}