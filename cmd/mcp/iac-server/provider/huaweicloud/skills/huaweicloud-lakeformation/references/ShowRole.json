          "type": "string",
          "example": "admin",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[a-zA-Z_0-9]+$",
          "description": "角色名称。只能包含字母、数字和下划线,且长度为1~255个字符。"
        },
        "description": {
          "type": "string",
          "maxLength": 4000,
