          "type": "string",
          "example": "LOCAL",
          "description": "主体来源\nIAM云用户\nSAML联邦\nLDAP ld用户\nLOCAL 本地用户\nAGENTTENANT 委托\nOTHER 其它",
          "enum": [
            "IAM",
            "SAML",
            "LDAP",
            "LOCAL",
            "AGENTTENANT",
            "OTHER"
          ]
