        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户token",
            "required": true,
            "type": "string",
            "x-example": "MIIjxxxxxxxxxxxxxxxxxxxxxxxx4qA="
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-zA-Z]{32}$",
            "x-example": "41aaxxxxxxxxxxxxxxxxxxxxxxxcc046"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "LakeFormation实例ID",
