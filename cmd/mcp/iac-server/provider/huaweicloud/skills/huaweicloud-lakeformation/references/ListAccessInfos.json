            "type": "integer",
            "default": 10,
            "maximum": 1000,
            "minimum": 1,
            "x-example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "total": 1,
                "access_infos": [
                  {
                    "vpcep_service_name": "cn-north-7.apig.3ab1xxxxxxxxxxxxxxxxxxxxxxxxxxxxf524",
