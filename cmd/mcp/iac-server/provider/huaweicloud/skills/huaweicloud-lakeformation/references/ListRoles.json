            "description": "查询的起始记录ID",
            "required": false,
            "type": "string",
            "maxLength": 1024
          },
          {
            "name": "reverse_page",
            "in": "query",
            "description": "是否查询上一页",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-annotations": [
