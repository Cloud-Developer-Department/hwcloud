  "definitions": {
    "PagedListRole": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Role"
          }
        },
        "page_info": {
          "description": "分页信息",
          "$ref": "#/definitions/PagedInfo"
        }
      },
      "title": "PagedListTable",
      "description": "列举角色"
    },
    "PagedInfo": {
      "type": "object",
      "required": [
        "current_count",
        "next_marker",
        "previous_marker"
      ],
      "properties": {
        "current_count": {
          "type": "integer",
          "format": "int32",
          "description": "本次返回的对象个数",
          "minimum": 0,
          "maximum": 2000
        },
        "next_marker": {
          "type": "string",
          "example": "006f492b-xxxx",
          "description": "下一页查询地址",
          "maxLength": 32
        },
        "previous_marker": {
          "type": "string",
          "example": "003e6eba-xxxx",
          "description": "上一页查询地址",
          "maxLength": 32
        }
      },
      "description": "分页返回信息"
    },
    "ErrorMessage": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "lakeformation.00010003"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "example": "failed"
        },
        "common_error_code": {
          "description": "CBC公共错误码",
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "example": "CMM.1008"
        },
        "solution_msg": {
          "description": "解决方案描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "example": "Please use correct instance id."
        }
      },
      "type": "object"
    },
    "Role": {
      "properties": {
        "role_name": {
          "type": "string",
          "example": "admin",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[a-zA-Z_0-9]+$",
          "description": "角色名称。只能包含字母、数字和下划线,且长度为1~255个字符。"
        },
        "description": {
          "type": "string",
          "maxLength": 4000,
          "description": "描述信息。最大长度为4000个字符。当无描述信息时,则description值为null,当值为null时,响应Body无该参数。",
          "pattern": ".*"
        },
        "principal_source": {
          "type": "string",
          "example": "LOCAL",
          "description": "主体来源\nIAM云用户\nSAML联邦\nLDAP ld用户\nLOCAL 本地用户\nAGENTTENANT 委托\nOTHER 其它",
          "enum": [
            "IAM",
            "SAML",
            "LDAP",
            "LOCAL",
            "AGENTTENANT",
            "OTHER"
          ]
        }
      },
      "description": "角色响应",
      "required": [
        "role_name",
        "principal_source"
      ],
      "type": "object"
    }
