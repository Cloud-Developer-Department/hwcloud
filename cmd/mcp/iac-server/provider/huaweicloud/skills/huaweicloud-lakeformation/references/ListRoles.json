{
  "name": "ListRoles",
  "summary": "根据条件分页列举角色",
  "tags": "角色管理",
  "productshort": "LakeFormation",
  "region_id": "la-north-2",
  "paths": {
    "/v1/{project_id}/instances/{instance_id}/roles": {
      "get": {
        "tags": [
          "Role"
        ],
        "summary": "根据条件分页列举角色",
        "description": "返回所有角色",
        "operationId": "ListRoles",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户token",
            "required": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目id",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+$"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{36}$"
          },
          {
            "name": "role_pattern",
            "in": "query",
            "description": "模糊匹配角色名称",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9\\一-\\龥_|*.]*$"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "返回的条目数量",
            "required": false,
            "type": "integer",
            "default": 100,
            "maximum": 1000,
            "minimum": 1,
            "format": "int32"
