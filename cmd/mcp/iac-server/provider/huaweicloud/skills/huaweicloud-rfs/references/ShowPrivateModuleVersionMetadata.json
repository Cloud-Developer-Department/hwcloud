{
  "name": "ShowPrivateModuleVersionMetadata",
  "summary": "获取私有模块版本元数据",
  "tags": "资源编排-模块管理",
  "productshort": "RFS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/private-modules/{module_name}/versions/{module_version}/metadata": {
      "get": {
        "tags": [
          "Module"
        ],
        "summary": "获取私有模块版本元数据",
        "description": "获取私有模块版本元数据(ShowPrivateModuleVersionMetadata)\n\n获取当前私有模块对应的版本的元数据信息\n\n  * 具体返回的信息见ShowPrivateModuleVersionMetadataResponseBody。\n  * 如果module_name和module_id同时存在,则资源编排服务会检查是否两个匹配,如果不匹配则会返回400。",
        "operationId": "ShowPrivateModuleVersionMetadata",
        "parameters": [
          {
            "name": "Client-Request-Id",
            "in": "header",
            "description": "用户指定的,对于此请求的唯一Id,用于定位某个请求,推荐使用UUID",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 36,
            "pattern": "^[A-Za-z0-9]+[A-Za-z0-9-]*$"
          },
          {
            "name": "module_name",
            "in": "path",
            "description": "私有模块(private-module)的名字。此名字在domain_id+region下应唯一,可以使用中文、大小写英文、数字、下划线、中划线。首字符需为中文或者英文,区分大小写。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[一-龥A-Za-z]+[一-龥A-Za-z0-9_-]*$"
          },
          {
            "name": "module_id",
            "in": "query",
            "description": "私有模块(private-module)的唯一Id。\n\n此Id由资源编排服务在生成模块的时候生成,为UUID。\n\n由于私有模块名称仅仅在同一时间下唯一,即用户允许先生成一个叫HelloWorld的私有模块,删除,再重新创建一个同名私有模块。\n\n对于团队并行开发,用户可能希望确保,当前我操作的私有模块就是我认为的那个,而不是其他队友删除后创建的同名私有模块。因此,使用Id就可以做到强匹配。\n\n资源编排服务保证每次创建的私有模块所对应的Id都不相同,更新不会影响Id。如果给予的module_id和当前模块的Id不一致,则返回400",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[a-z0-9]+[a-z0-9-]*$",
            "x-isnullable": true
          },
          {
            "name": "module_version",
            "in": "path",
            "description": "模块的版本号。版本号遵循语义化版本号(Semantic Version),为用户自定义",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 5
          }
        ],
        "responses": {
          "200": {
            "description": "获取私有模块元数据成功",
            "examples": {
              "x-response-examples-1": {
                "module_name": "test-limit_vpc_resource-module20241211160209172862",
                "module_id": "fd0e12bc-a1a4-4cac-8cbe-b023c389736b",
                "module_version": "1.0.0",
                "version_description": "My First Hello World Module Version Description",
                "create_time": "2024-12-11T08:03:37.417Z",
                "module_source": "rf://rfs.{region}.myhuaweicloud.com/private/1e05315aa3ec47b18db03f3771bbb4f3/test-limit_vpc_resource-module20241211160209172862?version=1.0.0"
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowPrivateModuleVersionMetadataResponseBody"
            }
          },
          "400": {
            "description": "用户请求非法",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "401": {
            "description": "用户身份认证失败",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "403": {
            "description": "用户无权限调用此API",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "404": {
            "description": "模块或者模块版本不存在",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "429": {
            "description": "请求数量过多",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "false",
        "x-rfs-internal": "Y",
        "x-rfs-external": "Y",
        "x-api-type": "open-api",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/private-modules/{module_name}/versions/{module_version}/metadata",
        "x-request-examples-description-1": "获取当前局点用户的私有模块版本元数据"
      }
    }
  },
  "definitions": {
    "PrivateModuleVersionSummary": {
      "allOf": [
        {
          "$ref": "#/definitions/PrivateModuleNamePrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateModuleIdPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateModuleVersionPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateModuleVersionDescriptionPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateModuleVersionCreateTimePrimitiveTypeHolder"
        }
      ]
    },
    "PrivateModuleIdPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "module_id": {
          "type": "string",
          "description": "私有模块(private-module)的唯一Id。\n\n此Id由资源编排服务在生成模块的时候生成,为UUID。\n\n由于私有模块名仅在同一时间下唯一,即允许用户先生成一个叫HelloWorld的私有模块,删除,再重新创建一个同名私有模块。\n\n对于团队并行开发,用户可能希望确保,当前我操作的私有模块就是我以为的那个,而不是其他队友删除后创建的同名私有模块。因此,使用Id就可以做到强匹配。\n\n资源编排服务保证每次创建的私有模块所对应的Id都不相同,更新不会影响Id。如果给予的module_id和当前模块的Id不一致,则返回400",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[a-z0-9]+[a-z0-9-]*$",
          "x-isnullable": true
        }
      },
      "example": {
        "module_id": "1b15e005-bdbb-4bd7-8f9a-a09b6774b4b3"
      }
    },
    "PrivateModuleNamePrimitiveTypeHolder": {
      "type": "object",
      "required": [
        "module_name"
      ],
      "properties": {
        "module_name": {
          "type": "string",
          "description": "私有模块(private-module)的名字。此名字在domain_id+region下应唯一,可以使用中文、大小写英文、数字、下划线、中划线。首字符需为中文或者英文,区分大小写。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[一-龥A-Za-z]+[一-龥A-Za-z0-9_-]*$"
        }
      },
      "example": {
        "module_name": "私有模块名称-Private_Module_Name"
      }
    },
    "ShowPrivateModuleVersionMetadataResponseBody": {
      "allOf": [
        {
          "$ref": "#/definitions/PrivateModuleVersion"
        }
      ]
    },
    "PrivateModuleVersionDescriptionPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "version_description": {
          "type": "string",
          "description": "模块版本(module version)的描述。可用于客户识别并管理模块的版本。注意:模块版本为不可更新(immutable),即描述不可更新,如果需要更新,请删除后重建",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "example": {
        "version_description": "My First Hello World Module Version"
      }
    },
    "PrivateModuleVersionCreateTimePrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "create_time": {
          "type": "string",
          "description": "私有模块(private-module)版本的生成时间,格式为YYYY-MM-DDTHH:mm:ss.SSSZ,精确到毫秒,UTC时区,即,如1970-01-01T00:00:00.000Z。"
        }
      },
      "example": {
        "create_time": "1970-01-01T00:00:00.000Z"
      }
    },
    "PrivateModuleSourcePrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "module_source": {
          "type": "string",
          "description": "在模板中使用模块需要定义如下格式:\n  module \"my_hello_word_module\" {\n    source = {module_source}\n  }\n\n其中{module_source}为本参数"
        }
      },
      "example": {
        "module_source": "rf://rfs.{region_id}.myhuaweicloud.com/private/1e05315aa3ec47b18db03f3771bbb4f3/my_module?version=0.1.0"
      }
    },
    "PrivateModuleVersion": {
      "allOf": [
        {
          "$ref": "#/definitions/PrivateModuleVersionSummary"
        },
        {
          "$ref": "#/definitions/PrivateModuleSourcePrimitiveTypeHolder"
        }
      ]
    },
    "CommonErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码",
          "minLength": 11,
          "maxLength": 11
        },
        "error_msg": {
          "type": "string",
          "description": "响应消息"
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "包含有关未经授权请求的信息。",
          "x-omitempty": true
        },
        "details": {
          "type": "array",
          "description": "权限拒绝时服务返回的详细错误信息。",
          "items": {
            "$ref": "#/definitions/Detail"
          },
          "x-omitempty": true
        }
      },
      "description": "通用错误响应体"
    },
    "Detail": {
