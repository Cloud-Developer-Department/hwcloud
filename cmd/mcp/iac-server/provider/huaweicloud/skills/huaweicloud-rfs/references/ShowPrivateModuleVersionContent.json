{
  "name": "ShowPrivateModuleVersionContent",
  "summary": "获取私有模块版本内容",
  "tags": "资源编排-模块管理",
  "productshort": "RFS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/private-modules/{module_name}/versions/{module_version}": {
      "get": {
        "tags": [
          "Module"
        ],
        "summary": "获取私有模块版本内容",
        "description": "获取私有模块版本内容(ShowPrivateModuleVersionContent)\n\n获取指定私有模块对应版本的内容。\n\n  * 如果获取成功,则以临时重定向形式返回模块下载链接(OBS Pre Signed地址,有效期为5分钟),大多数的客户端会进行自动重定向并下载模块;\n  * 如果未进行自动重定向,请参考HTTP的重定向规则获取模块下载链接,手动下载模块。",
        "operationId": "ShowPrivateModuleVersionContent",
        "parameters": [
          {
            "name": "Client-Request-Id",
            "in": "header",
            "description": "用户指定的,对于此请求的唯一Id,用于定位某个请求,推荐使用UUID",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 36,
            "pattern": "^[A-Za-z0-9]+[A-Za-z0-9-]*$"
          },
          {
            "name": "module_name",
            "in": "path",
            "description": "私有模块(private-module)的名字。此名字在domain_id+region下应唯一,可以使用中文、大小写英文、数字、下划线、中划线。首字符需为中文或者英文,区分大小写。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[一-龥A-Za-z]+[一-龥A-Za-z0-9_-]*$"
          },
          {
            "name": "module_version",
            "in": "path",
            "description": "模块的版本号。版本号遵循语义化版本号(Semantic Version),为用户自定义",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 5
          },
          {
            "name": "module_id",
            "in": "query",
            "description": "私有模块(private-module)的唯一Id。\n\n此Id由资源编排服务在生成模块的时候生成,为UUID。\n\n由于私有模块名称仅仅在同一时间下唯一,即用户允许先生成一个叫HelloWorld的私有模块,删除,再重新创建一个同名私有模块。\n\n对于团队并行开发,用户可能希望确保,当前我操作的私有模块就是我认为的那个,而不是其他队友删除后创建的同名私有模块。因此,使用Id就可以做到强匹配。\n\n资源编排服务保证每次创建的私有模块所对应的Id都不相同,更新不会影响Id。如果给予的module_id和当前模块的Id不一致,则返回400",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[a-z0-9]+[a-z0-9-]*$",
            "x-isnullable": true
          }
        ],
        "responses": {
          "307": {
            "description": "获取成功,临时重定向",
            "headers": {
              "Location": {
                "type": "string",
                "description": "HTTP重定向指定头域,客户端可通过此头域重定向至新地址。其内容为模块下载链接,为OBS Pre Signed地址,有效期为5分钟"
              }
            }
          },
          "400": {
            "description": "用户请求非法",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "401": {
            "description": "用户身份认证失败",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "403": {
            "description": "用户无权限调用此API",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "404": {
            "description": "模块或者模块版本不存在",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "429": {
            "description": "请求数量过多",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "false",
        "x-rfs-internal": "Y",
        "x-rfs-external": "Y",
        "x-api-type": "open-api",
        "x-request-examples-url-1": "GET /v1/private-modules/{module_name}/versions/{module_version}",
        "x-request-examples-description-1": "获取指定私有模块版本的模块内容"
      }
    }
  },
