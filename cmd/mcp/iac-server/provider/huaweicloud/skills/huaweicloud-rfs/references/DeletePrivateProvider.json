{
  "name": "DeletePrivateProvider",
  "summary": "删除私有provider",
  "tags": "资源编排-自定义provider",
  "productshort": "RFS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/private-providers/{provider_name}": {
      "delete": {
        "tags": [
          "CustomizedProvider"
        ],
        "summary": "删除私有provider",
        "description": "删除私有provider(DeletePrivateProvider)\n\n删除某个私有provider及私有provider下的所有provider版本。\n\n  * 如果provider_name和provider_id同时存在,则资源编排服务会检查是否两个匹配,如果不匹配则会返回400。\n\n** 请谨慎操作,删除私有provider将会删除该私有provider下的所有provider版本。 **",
        "operationId": "DeletePrivateProvider",
        "parameters": [
          {
            "name": "Client-Request-Id",
            "in": "header",
            "description": "用户指定的,对于此请求的唯一Id,用于定位某个请求,推荐使用UUID",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 36,
            "pattern": "^[A-Za-z0-9]+[A-Za-z0-9-]*$"
          },
          {
            "name": "provider_name",
            "in": "path",
            "description": "私有provider(private-provider)的名称。此名字在domain_id+region下应唯一,可以使用小写英文、数字、中划线。仅支持以小写英文、数字开头结尾。",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[0-9a-z]([0-9a-z-]*[0-9a-z])*$"
          },
          {
            "name": "provider_id",
            "in": "query",
            "description": "私有provider的唯一Id,由资源编排服务随机生成,为UUID。\n\n由于私有provider名称仅仅在同一时间下唯一,即用户允许先生成一个叫helloword的私有provider,删除,再重新创建一个同名私有provider。\n\n对于团队并行开发,用户可能希望确保,当前我操作的私有provider就是我以为的那个,而不是由其他队友删除后创建的同名私有provider。\n\n因此,使用ID就可以做到强匹配。资源编排服务保证每次创建私有provider所对应的Id都不相同。\n\n如果给予的provider_id和当前私有provider的Id不一致,则返回400。",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[a-z0-9]+[a-z0-9-]*$",
            "x-isnullable": true
          }
        ],
        "responses": {
          "204": {
            "description": "删除私有provider成功,无数据返回"
          },
          "400": {
            "description": "用户请求非法",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "401": {
            "description": "用户身份认证失败",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "403": {
            "description": "1. 用户无权限调用此API\n2. 私有provider下存在私有provider版本号(provider_version)",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "404": {
            "description": "私有provider不存在",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "429": {
            "description": "请求数量过多",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-rfs-internal": "N",
        "x-rfs-external": "N",
        "x-request-examples-url-1": "DELETE https://{endpoint}/v1/private-providers/my-hello-world-provider-name",
        "x-request-examples-description-1": "删除私有provider及私有provider下的所有provider版本",
        "x-request-examples-url-2": "DELETE https://{endpoint}/v1/private-providers/my-hello-world-provider-name?provider_id=ea6a4f0e-ee8a-494e-b12a-8be4a1e65af2",
        "x-request-examples-description-2": "删除私有provider及私有provider下的所有provider版本,并提供provider ID以校验是否与当前私有provider匹配"
      }
    }
  },
  "definitions": {
    "CommonErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码",
          "minLength": 11,
          "maxLength": 11
        },
        "error_msg": {
          "type": "string",
          "description": "响应消息"
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "包含有关未经授权请求的信息。",
          "x-omitempty": true
        },
        "details": {
          "type": "array",
          "description": "权限拒绝时服务返回的详细错误信息。",
          "items": {
            "$ref": "#/definitions/Detail"
          },
          "x-omitempty": true
        }
      },
      "description": "通用错误响应体"
    },
    "Detail": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码"
        },
        "error_msg": {
          "type": "string",
          "description": "响应消息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rfs.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "delete",
  "uri": null
}