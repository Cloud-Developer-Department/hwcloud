            },
            {
              "name": "template_id",
              "in": "QUERY",
              "origin": "REQUEST",
              "value": "template_id"
            }
          ],
          "type": "HTTP-VPC"
        },
        "x-apigateway-cors": false,
        "x-apigateway-match-mode": "NORMAL",
        "x-apigateway-query-string-encode": "DISABLE",
        "x-apigateway-request-type": "public",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/c364070ab35041ddae68cf8b4839b60f/templates/my_template/metadata",
        "x-request-examples-description-1": "获取当前模板的元数据信息",
        "x-request-examples-url-2": "GET https://{endpoint}/v1/c364070ab35041ddae68cf8b4839b60f/templates/my_template/metadata?template_id=1b15e005-bdbb-4bd7-8f9a-a09b6774b4b3",
        "x-request-examples-description-2": "获取当前模板的元数据信息,并提供模板id以校验是否与当前模板匹配",
        "x-imports": [
          "com.huawei.clouds.wushan.integration.common.auth.EnableAuth;",
          "com.huawei.clouds.wushan.auth.token.IamAuthMeta;",
          "com.huawei.clouds.wushan.auth.token.IamAuthLevel;",
          "com.huawei.clouds.wushan.auth.IamAuthParam;",
          "com.huawei.clouds.wushan.cts.meta.CtsMeta;"
        ],
        "x-method-annotations": [
          "@EnableAuth",
          "@IamAuthMeta(abacAction = \"rf:privateTemplate:showMetadata\", authLevel = IamAuthLevel.INSTANCE, needAbacResourceCheck = true, needApigwJwtAuthCheck = true, authContextInitializerName = \"defaultIamAuthContextInitializer\")",
          "@IamAuthParam(instanceId = \"template_name\")",
          "@CtsMeta(resourceType = \"rf-template\", traceName = \"showTemplateMetadata\", operationId = \"ShowTemplateMetadata\")"
        ]
      }
    }
  },
  "definitions": {
    "BaseTemplate": {
      "required": [
        "create_time",
        "template_id",
        "template_name",
        "update_time"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "description": "模板的唯一ID,由模板服务随机生成",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[a-z0-9\\-]{36}$"
        },
        "template_name": {
          "type": "string",
          "description": "模板(Template)的名字。此名字在domain_id+region下应唯一,可以使用中文、大小写英文、数字、下划线、中划线。首字符需为中文或者英文,区分大小写。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\一-\\龥A-Za-z][\\一-\\龥A-Za-z0-9_-]{0,127}$"
        },
        "template_description": {
          "type": "string",
          "description": "模板的描述。可用于客户识别自己的模板",
          "minLength": 0,
          "maxLength": 1024
        },
        "create_time": {
          "type": "string",
          "description": "模板的生成时间,格式遵循RFC3339,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z"
        },
        "update_time": {
          "type": "string",
          "description": "模板的更新时间,格式遵循RFC3339,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z"
        }
      },
      "description": "模板基本信息",
      "example": {
        "template_id": "69f8d5ea-eaa4-4a3b-a96d-bae9230e97c8",
        "template_name": "my_first_template",
        "template_description": "模板描述",
        "create_time": "2017-12-08T08:00:00.00+08:00",
        "update_time": "2017-12-08T08:00:00.00+08:00"
      }
    },
    "ShowTemplateMetadataResponseBody": {
