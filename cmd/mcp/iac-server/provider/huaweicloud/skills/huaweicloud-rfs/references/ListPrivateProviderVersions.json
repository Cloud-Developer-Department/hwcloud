          "minLength": 11,
          "maxLength": 11
        },
        "error_msg": {
          "type": "string",
          "description": "响应消息"
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "包含有关未经授权请求的信息。",
          "x-omitempty": true
        },
        "details": {
          "type": "array",
          "description": "权限拒绝时服务返回的详细错误信息。",
          "items": {
            "$ref": "#/definitions/Detail"
          },
          "x-omitempty": true
        }
      },
      "description": "通用错误响应体"
    },
    "PrivateProviderNamePrimitiveTypeHolder": {
      "type": "object",
      "required": [
        "provider_name"
      ],
      "properties": {
        "provider_name": {
          "type": "string",
          "description": "私有provider(private-provider)的名称。此名字在domain_id+region下应唯一,可以使用小写英文、数字、中划线。仅支持以小写英文、数字开头结尾。\n\n按照HCL最佳实践,该名称推荐为在模板中定义的provider的本地名称(local_name)。\n\n创建私有Provider(CreatePrivateProvider)API 还会以 “huawei.com/private-provider”为固定前缀,并以“huawei.com/private-provider/{provider_name}”的形式返回provider_source字段。关于provider_name和provider_source字段在模板中的使用细节,详见创建私有Provider的API描述。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-z]([0-9a-z-]*[0-9a-z])*$"
        }
      },
      "example": {
        "provider_name": "my-hello-world-provider-name"
      }
    },
    "Detail": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码"
        },
        "error_msg": {
          "type": "string",
          "description": "响应消息"
        }
      }
    },
    "PrivateProviderVersionPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "provider_version": {
          "type": "string",
          "description": "provider的版本号。版本号必须遵循语义化版本号(Semantic Version),为用户自定义",
          "minLength": 5,
          "maxLength": 128,
          "x-isnullable": true
        }
      },
      "example": {
        "provider_version": "3.7.10"
      }
    },
    "PrivateProviderIdPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "provider_id": {
          "type": "string",
          "description": "私有provider(private-provider)的唯一Id。\n\n此Id由资源编排服务在生成provider的时候生成,为UUID。\n\n由于私有provider名仅仅在同一时间下唯一,即用户允许先生成一个叫HelloWorld的私有provider,删除,再重新创建一个同名私有provider。\n\n对于团队并行开发,用户可能希望确保,当前我操作的私有provider就是我以为的那个,而不是其他队友删除后创建的同名私有provider。因此,使用Id就可以做到强匹配。\n\n资源编排服务保证每次创建的私有provider所对应的Id都不相同,更新不会影响Id。如果给予的provider_id和当前provider的Id不一致,则返回400",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[a-z0-9]+[a-z0-9-]*$",
          "x-isnullable": true
        }
      },
      "example": {
        "provider_id": "1b15e005-bdbb-4bd7-8f9a-a09b6774b4b3"
      }
    }
  },
  "version": "2.0",
  "parameters": {},
