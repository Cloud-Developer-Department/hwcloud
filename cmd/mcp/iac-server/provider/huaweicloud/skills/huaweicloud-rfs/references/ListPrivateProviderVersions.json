{
  "name": "ListPrivateProviderVersions",
  "summary": "列举私有provider版本",
  "tags": "资源编排-自定义provider",
  "productshort": "RFS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/private-providers/{provider_name}/versions": {
      "get": {
        "tags": [
          "CustomizedProvider"
        ],
        "summary": "列举私有provider版本",
        "description": "列举私有provider版本(ListPrivateProviderVersions)\n\n列举所选择的私有provider中所有的provider版本信息。\n\n  * 可以使用sort_key和sort_dir两个关键字对返回结果按创建时间(create_time)进行排序。给予的sort_key和sort_dir数量须一致,否则返回400。如果未给予sort_key和sort_dir,则默认按照创建时间降序排序。\n  * 如果provider_name和provider_id同时存在,则资源编排服务会检查是否两个匹配,如果不匹配则会返回400。\n  * 如果provider下不存在provider版本,则返回空list。\n  * 如果provider不存在则返回404。\n  * 支持分页返回。如果响应中存在next_marker,则表示实际总输出比当前响应中包含的输出多。在对请求的后续调用中,在请求参数中使用此值,以获取输出的下一部分。您应该重复此操作,直到next_marker响应元素返回为null",
        "operationId": "ListPrivateProviderVersions",
        "parameters": [
          {
            "name": "Client-Request-Id",
            "in": "header",
            "description": "用户指定的,对于此请求的唯一Id,用于定位某个请求,推荐使用UUID",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 36,
            "pattern": "^[A-Za-z0-9]+[A-Za-z0-9-]*$"
          },
          {
            "name": "provider_name",
            "in": "path",
            "description": "私有provider(private-provider)的名称。此名字在domain_id+region下应唯一,可以使用小写英文、数字、中划线。仅支持以小写英文、数字开头结尾。",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[0-9a-z]([0-9a-z-]*[0-9a-z])*$"
          },
          {
            "name": "provider_id",
            "in": "query",
            "description": "私有provider的唯一Id,由资源编排服务随机生成,为UUID。\n\n由于私有provider名称仅仅在同一时间下唯一,即用户允许先生成一个叫helloword的私有provider,删除,再重新创建一个同名私有provider。\n\n对于团队并行开发,用户可能希望确保,当前我操作的私有provider就是我以为的那个,而不是由其他队友删除后创建的同名私有provider。\n\n因此,使用ID就可以做到强匹配。资源编排服务保证每次创建私有provider所对应的Id都不相同。\n\n如果给予的provider_id和当前私有provider的Id不一致,则返回400。",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[a-z0-9]+[a-z0-9-]*$",
            "x-isnullable": true
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序字段,仅支持给予create_time",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "create_time"
              ]
            },
            "collectionFormat": "multi"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "指定升序还是降序\n  * `asc` - 升序\n  * `desc` - 降序",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "asc",
                "desc"
              ]
            },
            "collectionFormat": "multi"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "分页标记。当一页无法返回所有结果,上一次的请求将返回next_marker以指引还有更多页数,用户可以将next_marker中的值放到此处以查询下一页的信息。此marker只能用于与上一请求指定的相同参数的请求。不指定时默认从第一页开始查询。",
            "required": false,
            "type": "string",
            "maxLength": 512,
            "minLength": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页返回的最多结果数量",
            "required": false,
            "type": "integer",
            "default": 1000,
            "maximum": 1000,
            "minimum": 10
          }
        ],
        "responses": {
          "200": {
            "description": "列举私有provider版本成功",
            "examples": {
              "x-response-examples-1": {
                "versions": [
                  {
                    "provider_id": "1b15e005-bdbb-4bd7-8f9a-a09b6774b4b3",
                    "provider_name": "my-hello-world-provider-name",
                    "provider_version": "3.7.10",
                    "version_description": "my first hello world private provider version",
                    "function_graph_urn": "urn:fss:cn-north-7:b61dfe3154de4282787126568d5040f:function:default:myFG:latest",
                    "create_time": "2024-01-01T00:00:00.000Z"
                  },
                  {
                    "provider_id": "1b15e005-bdbb-4bd7-8f9a-a09b6774b4b3",
                    "provider_name": "my-hello-world-provider-name",
                    "provider_version": "3.7.10",
                    "version_description": "my first hello world private provider version",
                    "function_graph_urn": "urn:fss:cn-north-7:b61dfe3154de4282787126568d5040f:function:default:myFG:latest",
                    "create_time": "2023-01-01T00:00:00.000Z"
                  }
                ],
                "page_info": {
                  "current_count": 2,
                  "previous_marker": "zxc1oHc08HcCmypYGTsOoRcvoHUvHRUAW5NOSnc1oHc08HcCPZrwP5NOeTlRiukJgtGxeujJeuGwGIihaIUCmypYGTsOtqvKPr2xmH8fPqpGWyQ0axGwGZp9aqvx8pQ7m5FvGTsJiKk7gtNFiuaxetdRCks="
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ListPrivateProviderVersionsResponseBody"
            }
          },
          "400": {
            "description": "用户请求非法",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "401": {
            "description": "用户身份认证失败",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "403": {
            "description": "用户无权限调用此API",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "404": {
            "description": "provider不存在",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "429": {
            "description": "请求数量过多",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-rfs-internal": "N",
        "x-rfs-external": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/private-providers/my-hello-world-provider-name/versions",
        "x-request-examples-description-1": "获取名为my-hello-world-provider-name的私有模块下的所有版本,以创建时间降序排序",
        "x-request-examples-url-2": "GET https://{endpoint}/v1/private-providers/my-hello-world-provider-name/versions?sort_key=create_time&sort_dir=asc",
        "x-request-examples-description-2": "获取名为my-hello-world-provider-name的私有模块下的所有版本,以创建时间升序排序",
        "x-request-examples-url-3": "GET https://{endpoint}/v1/private-providers/my-hello-world-provider-name/versions?provider_id=ea6a4f0e-ee8a-494e-b12a-8be4a1e65af2&sort_key=create_time&sort_dir=asc",
        "x-request-examples-description-3": "获取名为my-hello-world-provider-name的私有模块下的所有版本,并提供provider ID以校验是否与当前私有provider匹配,以创建时间升序排序"
      }
    }
  },
  "definitions": {
    "FunctionGraphUrnPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "function_graph_urn": {
          "type": "string",
          "description": "FunctionGraph方法的统一资源标识,用于唯一标识的FunctionGraph方法。当前只支持和RFS同region的function_graph_urn,如果给予了关于其他region的,会报错400。\n\n关于该参数的详细解释,请参考官方文档:https://support.huaweicloud.com/api-functiongraph/functiongraph_06_0102.html",
          "minLength": 32,
          "maxLength": 256,
          "pattern": "^urn:fss:.+:[A-Za-z0-9]{3,64}:function:default:[A-Za-z][A-Za-z0-9_-]{0,58}[A-Za-z0-9]:([A-Za-z0-9][A-Za-z0-9_.-]{0,40}|![A-Za-z][A-Za-z0-9_-]{0,61})[A-Za-z0-9]$",
          "x-isnullable": true
        }
      },
      "example": {
        "function_graph_urn": "urn:fss:cn-north-7:b61dfe3154de4282787126568d5040f:function:default:myFG:latest"
      }
    },
    "PrivateProviderVersionSummary": {
      "allOf": [
        {
          "$ref": "#/definitions/PrivateProviderIdPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateProviderNamePrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateProviderVersionPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateProviderVersionDescriptionPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/FunctionGraphUrnPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateProviderVersionCreateTimePrimitiveTypeHolder"
        }
      ]
    },
    "PageInfo": {
      "type": "object",
      "properties": {
        "next_marker": {
          "type": "string",
          "description": "向后分页标识符。如果存在,则表示实际总输出比当前响应中包含的输出多。在对请求的后续调用中,在请求参数中使用此值,以获取输出的下一部分。您应该重复此操作,直到next_marker响应元素返回为null。",
          "x-omitempty": false,
          "x-isnullable": true
        },
        "previous_marker": {
          "type": "string",
          "description": "向前分页标识符。",
          "x-omitempty": false,
          "x-isnullable": true
        },
        "current_count": {
          "type": "integer",
          "description": "本页显示的条目数量。",
          "x-omitempty": false
        }
      },
      "description": "分页信息",
      "x-isnullable": false
    },
    "PrivateProviderVersionDescriptionPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "version_description": {
          "type": "string",
          "description": "私有provider版本(provider version)的描述。可用于客户识别并管理私有provider的版本。注意:provider版本为不可更新(immutable),所以该字段不可更新,如果需要更新,请删除后重建",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "example": {
        "version_description": "my first hello world private provider version"
      }
    },
    "ListPrivateProviderVersionsResponseBody": {
      "type": "object",
      "properties": {
        "versions": {
          "type": "array",
          "description": "私有provider版本的列表。默认以创建时间降序排序。",
          "items": {
            "$ref": "#/definitions/PrivateProviderVersionSummary"
          }
        },
        "page_info": {
          "description": "分页信息",
          "$ref": "#/definitions/PageInfo"
        }
      },
      "description": "ListPrivateProviderVersions API的响应Body体"
    },
    "PrivateProviderVersionCreateTimePrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "create_time": {
          "type": "string",
          "description": "私有provider(private-provider)版本的生成时间,格式为YYYY-MM-DDTHH:mm:ss.SSSZ,精确到毫秒,UTC时区,即,如1970-01-01T00:00:00.000Z。"
        }
      },
      "example": {
        "create_time": "1970-01-01T00:00:00.000Z"
      }
    },
    "CommonErrorResponse": {
      "type": "object",
      "properties": {
