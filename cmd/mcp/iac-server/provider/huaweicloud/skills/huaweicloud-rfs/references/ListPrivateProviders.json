{
  "name": "ListPrivateProviders",
  "summary": "列举私有provider",
  "tags": "资源编排-自定义provider",
  "productshort": "RFS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/private-providers": {
      "get": {
        "tags": [
          "CustomizedProvider"
        ],
        "summary": "列举私有provider",
        "description": "列举私有provider(ListPrivateProviders)\n\n列举当前局点下用户所有的私有provider。\n\n  * 可以使用sort_key和sort_dir两个关键字对返回结果按创建时间(create_time)进行排序。给予的sort_key和sort_dir数量须一致,否则返回400。如果未给予sort_key和sort_dir,则默认按照创建时间降序排序。\n  * 如果当前用户下没有任何私有provider,则返回空list。\n  * 如果需要某个provider的所有版本信息,可以调用ListPrivateProviderVersions。\n  * 支持分页返回。如果响应中存在next_marker,则表示实际总输出比当前响应中包含的输出多。在对请求的后续调用中,在请求参数中使用此值,以获取输出的下一部分。您应该重复此操作,直到next_marker响应元素返回为null",
        "operationId": "ListPrivateProviders",
        "parameters": [
          {
            "name": "Client-Request-Id",
            "in": "header",
            "description": "用户指定的,对于此请求的唯一Id,用于定位某个请求,推荐使用UUID",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 36,
            "pattern": "^[A-Za-z0-9]+[A-Za-z0-9-]*$"
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序字段,仅支持给予create_time",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "create_time"
              ]
            },
            "collectionFormat": "multi"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "指定升序还是降序\n  * `asc` - 升序\n  * `desc` - 降序",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "asc",
                "desc"
              ]
            },
            "collectionFormat": "multi"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "分页标记。当一页无法返回所有结果,上一次的请求将返回next_marker以指引还有更多页数,用户可以将next_marker中的值放到此处以查询下一页的信息。此marker只能用于与上一请求指定的相同参数的请求。不指定时默认从第一页开始查询。",
            "required": false,
            "type": "string",
            "maxLength": 512,
            "minLength": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页返回的最多结果数量",
            "required": false,
            "type": "integer",
            "default": 1000,
            "maximum": 1000,
            "minimum": 10
          }
        ],
        "responses": {
          "200": {
            "description": "列举私有provider成功",
            "examples": {
              "x-response-examples-1": {
                "providers": [
                  {
                    "provider_id": "1b15e005-bdbb-4bd7-8f9a-a09b6774b4b3",
                    "provider_name": "my-hello-world-provider-name-1",
                    "provider_description": "my first hello world private provider",
                    "provider_source": "huawei.com/private-provider/my-hello-world-provider-name",
                    "create_time": "2024-01-01T00:00:00.000Z",
                    "update_time": "2024-01-01T00:00:00.000Z"
                  },
                  {
                    "provider_id": "337cb9a1-6293-4f80-a903-66cd195283f7",
                    "provider_name": "my-hello-world-provider-name-2",
                    "provider_description": "my first hello world private provider",
                    "provider_source": "huawei.com/private-provider/my-hello-world-provider-name",
                    "create_time": "2023-01-01T00:00:00.000Z",
                    "update_time": "2023-01-01T00:00:00.000Z"
                  }
                ],
                "page_info": {
                  "current_count": 2,
                  "previous_marker": "zxc1oHc08HcCmypYGTsOoRcvoHUvHRUAW5NOSnc1oHc08HcCPZrwP5NOeTlRiukJgtGxeujJeuGwGIihaIUCmypYGTsOtqvKPr2xmH8fPqpGWyQ0axGwGZp9aqvx8pQ7m5FvGTsJiKk7gtNFiuaxetdRCks="
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ListPrivateProvidersResponseBody"
            }
          },
          "400": {
            "description": "用户请求非法",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "401": {
            "description": "用户身份认证失败",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "403": {
            "description": "用户无权限调用此API",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "429": {
            "description": "请求数量过多",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-rfs-internal": "N",
        "x-rfs-external": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/private-providers",
        "x-request-examples-description-1": "获取当前局点下用户所有的私有provider,以创建时间降序排序",
        "x-request-examples-url-2": "GET https://{endpoint}/v1/private-providers?sort_key=create_time&sort_dir=asc",
        "x-request-examples-description-2": "获取当前局点下用户所有的私有provider,以创建时间升序排序"
      }
    }
  },
  "definitions": {
    "ProviderAgencyNamePrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "provider_agency_name": {
          "type": "string",
          "description": "自定义provider所绑定的IAM委托名称,provider_agency_name和provider_agency_urn最多只能提供一个。",
          "minLength": 0,
          "maxLength": 64,
          "x-omitempty": true,
          "x-isnullable": true
        }
      },
      "example": {
        "provider_agency_name": "provider_agency"
      }
    },
    "ProviderAgencyUrnPrimitiveTypeHolder": {
      "properties": {
        "provider_agency_urn": {
          "type": "string",
          "description": "自定义provider所绑定的IAM委托URN,provider_agency_name和provider_agency_urn最多只能提供一个。",
          "pattern": "^(iam:\\*?:[A-Za-z0-9-]{1,64}:agency:.{1,64})?$",
          "x-omitempty": true,
          "x-isnullable": true
        }
      },
      "example": {
        "provider_agency_urn": "iam::d46063b5305e4910b509c15b9d2b39a1:agency:provider_agency"
      }
    },
    "PrivateProviderSummary": {
      "allOf": [
        {
          "$ref": "#/definitions/PrivateProviderIdPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateProviderNamePrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateProviderDescriptionPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateProviderSourcePrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/ProviderAgencyUrnPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/ProviderAgencyNamePrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateProviderCreateTimePrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateProviderUpdateTimePrimitiveTypeHolder"
        }
      ]
    },
    "ListPrivateProvidersResponseBody": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "description": "私有provider的列表。默认以创建时间降序排序。",
          "items": {
            "$ref": "#/definitions/PrivateProviderSummary"
          }
        },
        "page_info": {
          "description": "分页信息",
          "$ref": "#/definitions/PageInfo"
        }
      },
      "description": "ListPrivateProviders API的响应Body体"
    },
    "PrivateProviderIdPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "provider_id": {
          "type": "string",
          "description": "私有provider(private-provider)的唯一Id。\n\n此Id由资源编排服务在生成provider的时候生成,为UUID。\n\n由于私有provider名仅仅在同一时间下唯一,即用户允许先生成一个叫HelloWorld的私有provider,删除,再重新创建一个同名私有provider。\n\n对于团队并行开发,用户可能希望确保,当前我操作的私有provider就是我以为的那个,而不是其他队友删除后创建的同名私有provider。因此,使用Id就可以做到强匹配。\n\n资源编排服务保证每次创建的私有provider所对应的Id都不相同,更新不会影响Id。如果给予的provider_id和当前provider的Id不一致,则返回400",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[a-z0-9]+[a-z0-9-]*$",
          "x-isnullable": true
        }
      },
      "example": {
        "provider_id": "1b15e005-bdbb-4bd7-8f9a-a09b6774b4b3"
      }
    },
    "PrivateProviderDescriptionPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "provider_description": {
          "type": "string",
          "description": "私有provider(private-provider)的描述。可用于客户识别被管理的私有provider。",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "example": {
        "provider_description": "my first hello world private provider"
      }
    },
    "PrivateProviderCreateTimePrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "create_time": {
          "type": "string",
          "description": "私有provider(private-provider)的生成时间,格式为YYYY-MM-DDTHH:mm:ss.SSSZ,精确到毫秒,UTC时区,即,如1970-01-01T00:00:00.000Z。"
        }
      },
      "example": {
        "create_time": "1970-01-01T00:00:00.000Z"
      }
    },
    "PageInfo": {
      "type": "object",
      "properties": {
        "next_marker": {
          "type": "string",
          "description": "向后分页标识符。如果存在,则表示实际总输出比当前响应中包含的输出多。在对请求的后续调用中,在请求参数中使用此值,以获取输出的下一部分。您应该重复此操作,直到next_marker响应元素返回为null。",
          "x-omitempty": false,
          "x-isnullable": true
        },
        "previous_marker": {
          "type": "string",
          "description": "向前分页标识符。",
          "x-omitempty": false,
          "x-isnullable": true
        },
        "current_count": {
          "type": "integer",
          "description": "本页显示的条目数量。",
          "x-omitempty": false
        }
      },
      "description": "分页信息",
      "x-isnullable": false
    },
    "CommonErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码",
          "minLength": 11,
          "maxLength": 11
        },
        "error_msg": {
          "type": "string",
          "description": "响应消息"
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "包含有关未经授权请求的信息。",
          "x-omitempty": true
        },
        "details": {
          "type": "array",
          "description": "权限拒绝时服务返回的详细错误信息。",
          "items": {
            "$ref": "#/definitions/Detail"
          },
          "x-omitempty": true
        }
      },
      "description": "通用错误响应体"
    },
    "PrivateProviderNamePrimitiveTypeHolder": {
      "type": "object",
      "required": [
        "provider_name"
      ],
      "properties": {
        "provider_name": {
          "type": "string",
          "description": "私有provider(private-provider)的名称。此名字在domain_id+region下应唯一,可以使用小写英文、数字、中划线。仅支持以小写英文、数字开头结尾。\n\n按照HCL最佳实践,该名称推荐为在模板中定义的provider的本地名称(local_name)。\n\n创建私有Provider(CreatePrivateProvider)API 还会以 “huawei.com/private-provider”为固定前缀,并以“huawei.com/private-provider/{provider_name}”的形式返回provider_source字段。关于provider_name和provider_source字段在模板中的使用细节,详见创建私有Provider的API描述。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-z]([0-9a-z-]*[0-9a-z])*$"
        }
      },
      "example": {
        "provider_name": "my-hello-world-provider-name"
      }
    },
    "Detail": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码"
        },
        "error_msg": {
          "type": "string",
          "description": "响应消息"
        }
      }
    },
    "PrivateProviderUpdateTimePrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "update_time": {
          "type": "string",
          "description": "私有provider(private-provider)的更新时间,格式为YYYY-MM-DDTHH:mm:ss.SSSZ,精确到毫秒,UTC时区,即,如1970-01-01T00:00:00.000Z。"
        }
      },
      "example": {
        "update_time": "1970-01-01T00:00:00.000Z"
      }
    },
    "PrivateProviderSourcePrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "provider_source": {
          "type": "string",
          "description": "用户使用私有provider,在Terraform模板中定义required_providers信息时,需要指明的source参数。\n\n该参数按照“huawei.com/private-provider/{provider_name}”的形式拼接。关于provider_name和provider_source字段在模板中的使用细节,详见创建私有Provider的API描述。"
        }
      },
      "example": {
        "provider_source": "huawei.com/private-provider/my-hello-world-provider-name"
      }
    }
  },
  "version": "2.0",
