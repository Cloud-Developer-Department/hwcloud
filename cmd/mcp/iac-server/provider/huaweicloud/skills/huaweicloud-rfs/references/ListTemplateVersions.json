  "definitions": {
    "BaseTemplateVersion": {
      "required": [
        "create_time",
        "template_id",
        "template_name"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "description": "模板的唯一ID,由模板服务随机生成",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[a-z0-9\\-]{36}$"
        },
        "template_name": {
          "type": "string",
          "description": "模板(Template)的名字。此名字在domain_id+region下应唯一,可以使用中文、大小写英文、数字、下划线、中划线。首字符需为中文或者英文,区分大小写。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\一-\\龥A-Za-z][\\一-\\龥A-Za-z0-9_-]{0,127}$"
        },
        "version_description": {
          "type": "string",
          "description": "模板版本的描述。可用于客户识别自己的模板版本",
          "minLength": 0,
          "maxLength": 1024
        },
        "create_time": {
          "type": "string",
          "description": "版本创建时间,格式遵循RFC3339,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z"
        }
      },
      "description": "模板版本基本信息",
      "example": {
        "template_id": "69f8d5ea-eaa4-4a3b-a96d-bae9230e97c8",
        "template_name": "my_first_template",
        "version_description": "version description",
        "create_time": "2017-12-08T08:00:00.00+08:00"
      }
    },
