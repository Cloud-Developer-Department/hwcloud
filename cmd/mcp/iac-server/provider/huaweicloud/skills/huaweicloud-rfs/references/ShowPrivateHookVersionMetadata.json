        },
        "error_msg": {
          "type": "string",
          "description": "响应消息"
        }
      }
    },
    "PrivateHookNamePrimitiveTypeHolder": {
      "type": "object",
      "required": [
        "hook_name"
      ],
      "properties": {
        "hook_name": {
          "type": "string",
          "description": "私有hook的名字。此名字在domain_id+region下应唯一,可以使用中文、大小写英文、数字、下划线、中划线。首字符需为中文或者英文,区分大小写。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[一-龥A-Za-z]+[一-龥A-Za-z0-9_-]*$"
        }
      },
      "example": {
