{
  "name": "UpdatePrivateHookMetadata",
  "summary": "更新私有hook元数据",
  "tags": "资源编排-Hook",
  "productshort": "RFS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/private-hooks/{hook_name}/metadata": {
      "patch": {
        "tags": [
          "Hook"
        ],
        "summary": "更新私有hook元数据",
        "description": "更新私有hook元数据(UpdatePrivateHookMetadata)\n\n更新当前私有hook的元数据信息\n\n  * 目前支持更新私有hook的描述、默认版本、配置。\n  * 如果需要创建新的版本,请调用CreatePrivateHookVersion。\n  * 更新为增量更新,即如果某个参数不提供,则保持原始值。\n  * 如果请求中没有需要被更新的参数(如请求中没有任何内容,或仅有hook_id),则返回400。注意:即使更新原始值和目标值一致也被认为是有效更新\n  * 更新后私有hook的更新时间(update_time)也会被更新\n  * 若hook_name和hook_id同时存在,则资源编排服务会检查是否两个匹配,如果不匹配则会返回400。",
        "operationId": "UpdatePrivateHookMetadata",
        "parameters": [
          {
            "name": "Client-Request-Id",
            "in": "header",
            "description": "用户指定的,对于此请求的唯一Id,用于定位某个请求,推荐使用UUID",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 36,
            "pattern": "^[A-Za-z0-9]+[A-Za-z0-9-]*$"
          },
          {
            "name": "hook_name",
            "in": "path",
            "description": "私有hook的名字。此名字在domain_id+region下应唯一,可以使用中文、大小写英文、数字、下划线、中划线。首字符需为中文或者英文,区分大小写。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[一-龥A-Za-z]+[一-龥A-Za-z0-9_-]*$"
          },
          {
            "in": "body",
            "name": "UpdatePrivateHookMetadataRequestBody",
            "description": "UpdatePrivateHookMetadata API的请求Body体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdatePrivateHookMetadataRequestBody"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "更新私有hook的元数据成功,无数据返回"
          },
          "400": {
            "description": "用户请求非法",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "401": {
            "description": "用户身份认证失败",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "403": {
            "description": "用户无权限调用此API",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "404": {
            "description": "1.私有hook不存在\n2.默认版本不存在",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "409": {
            "description": "1. 请求冲突,默认版本已经被删除。\n2. 请求冲突,私有hook已经被更新。",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "429": {
            "description": "请求数量过多",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-rfs-internal": "Y",
        "x-rfs-external": "Y",
        "x-api-type": "open-api",
        "x-request-examples-url-1": "PATCH https://{endpoint}/v1/private-hooks/my-hello-world-hook-name/metadata",
        "x-request-examples-description-1": "更新私有hook描述信息",
        "x-request-examples-1": {
          "hook_description": "my first private hook"
        },
        "x-request-examples-url-2": "PATCH https://{endpoint}/v1/private-hooks/my-hello-world-hook-name/metadata",
        "x-request-examples-description-2": "更新私有hook默认版本",
        "x-request-examples-2": {
          "default_version": "0.0.2"
        },
        "x-request-examples-url-3": "PATCH https://{endpoint}/v1/private-hooks/my-hello-world-hook-name/metadata",
        "x-request-examples-description-3": "更新私有hook配置",
        "x-request-examples-3": {
          "configuration": {
            "target_stacks": "ALL",
            "failure_mode": "FAIL"
          }
        },
        "x-request-examples-url-4": "PATCH https://{endpoint}/v1/private-hooks/my-hello-world-hook-name/metadata",
        "x-request-examples-description-4": "更新私有hook描述信息、默认版本、配置",
        "x-request-examples-4": {
          "hook_description": "my first private hook",
          "default_version": "0.0.2",
          "configuration": {
            "target_stacks": "ALL",
            "failure_mode": "FAIL"
          }
        },
        "x-request-examples-url-5": "PATCH https://{endpoint}/v1/private-hooks/my-hello-world-hook-name/metadata",
        "x-request-examples-description-5": "更新私有hook描述信息,并带有hook_id",
        "x-request-examples-5": {
          "hook_id": "77dad9a0-6b11-4bf5-ba62-c7e0029dcb6f",
          "hook_description": "my first private hook"
        }
      }
    }
  },
  "definitions": {
    "UpdatePrivateHookMetadataRequestBody": {
      "allOf": [
        {
          "$ref": "#/definitions/PrivateHookDescriptionPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateHookIdPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateHookDefaultVersionPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/ConfigurationPrimitiveTypeHolder"
        }
      ]
    },
    "ConfigurationPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "configuration": {
          "type": "object",
          "description": "私有hook配置项,可以指定私有hook生效的目标资源栈以及私有hook校验失败后资源栈的行为。可通过UpdatePrivateHook API更新私有hook配置项。",
          "properties": {
            "target_stacks": {
              "type": "string",
              "description": "指定私有hook生效的目标资源栈,有效值为NONE或ALL,默认值为NONE。\n\nNONE:指定此私有hook不会作用于任何资源栈\nALL:指定此私有hook将会应用于账号下的所有资源栈",
              "default": "NONE",
              "enum": [
                "NONE",
                "ALL"
              ]
            },
            "failure_mode": {
              "type": "string",
              "description": "指定私有hook校验失败后的行为,有效值为FAIL或WARN,默认值为WARN。\n\nFAIL:指定此私有hook校验失败后资源栈将停止部署,资源栈状态将更新为DEPLOYMENT_FAILED。\nWARN:指定此私有hook校验失败后仅通过资源栈事件展示警告消息,但不影响资源栈部署。",
              "default": "WARN",
              "enum": [
                "WARN",
                "FAIL"
              ]
            }
          }
        }
      }
    },
    "PrivateHookDescriptionPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "hook_description": {
          "type": "string",
          "description": "私有hook的描述。可用于客户识别创建的私有hook。可通过UpdatePrivateHook API更新私有hook的描述。",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "example": {
        "hook_description": "My First Hello World Hook Description"
      }
    },
    "CommonErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码",
          "minLength": 11,
          "maxLength": 11
        },
        "error_msg": {
          "type": "string",
          "description": "响应消息"
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "包含有关未经授权请求的信息。",
          "x-omitempty": true
        },
        "details": {
          "type": "array",
          "description": "权限拒绝时服务返回的详细错误信息。",
          "items": {
            "$ref": "#/definitions/Detail"
          },
          "x-omitempty": true
        }
      },
      "description": "通用错误响应体"
    },
    "Detail": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码"
        },
        "error_msg": {
          "type": "string",
          "description": "响应消息"
        }
      }
    },
    "PrivateHookDefaultVersionPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "default_version": {
          "type": "string",
          "description": "私有hook的默认版本号。版本号必须遵循语义化版本号(Semantic Version),为用户自定义。",
          "minLength": 5,
          "maxLength": 128,
          "x-isnullable": true
        }
      },
      "example": {
        "default_version": "1.0.0"
      }
    },
    "PrivateHookIdPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "hook_id": {
          "type": "string",
          "description": "私有hook(private-hook)的唯一Id。\n\n此Id由资源编排服务在生成私有hook的时候生成,为UUID。\n\n由于私有hook名称仅仅在同一时间下唯一,即用户允许先生成一个叫HelloWorld的私有hook,删除,再重新创建一个同名私有hook。\n\n对于团队并行开发,用户可能希望确保,当前我操作的私有hook就是我认为的那个,而不是其他队友删除后创建的同名私有hook。因此,使用Id就可以做到强匹配。\n\n资源编排服务保证每次创建的私有hook所对应的Id都不相同,更新不会影响Id。如果给予的hook_id和当前hook的Id不一致,则返回400。",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[a-z0-9]+[a-z0-9-]*$",
          "x-isnullable": true
        }
      },
      "example": {
        "hook_id": "77dad9a0-6b11-4bf5-ba62-c7e0029dcb6f"
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rfs.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "patch",
  "uri": null
}