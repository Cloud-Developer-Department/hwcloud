  },
  "definitions": {
    "CbsGetResourceIdTags": {
      "description": "TMS查询当前project下所有标签的返回体。",
      "required": [
        "action",
        "tags"
      ],
      "properties": {
        "action": {
          "description": "执行动作。\n- create,创建\n- delete,删除",
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        },
        "tags": {
          "description": "标签列表\n\n租户权限时该字段必选,op_service权限时和sys_tags二选一。",
          "type": "array",
          "minItems": 0,
          "maxItems": 36,
          "items": {
            "$ref": "#/definitions/ResourceTag"
          }
        },
        "sys_tags": {
          "description": "系统标签列表\n\nop_service权限可以访问,和tags二选一。\n\n目前TMS调用时只包含一个resource_tag结构体 ,key固定为:_sys_enterprise_project_id\n\nvalue是UUID或0,value为0表示默认企业项目。\n\n现在仅支持create操作。",
          "type": "array",
          "minItems": 0,
          "maxItems": 36,
          "items": {
            "$ref": "#/definitions/ResourceTag"
          }
        }
      },
      "example": {
        "action": "create",
        "tags": [
          {
            "key": "key1",
            "value": "value1"
          },
          {
            "key": "key",
            "value": "value3"
          }
        ]
      }
    },
    "ResourceTag": {
      "required": [
        "key",
        "value"
      ],
      "description": "标签列表的结构体。",
      "properties": {
        "key": {
          "description": "键。最大长度128个字符。",
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^((?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)$"
        },
        "value": {
          "description": "值。每个值最大长度255个字符。",
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$"
        }
      }
    },
    "ErrorRsp401": {
      "description": "校验TOKEN失败。",
      "required": [
        "error_code",
        "error_description"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        },
        "error_description": {
          "description": "校验TOKEN失败。",
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
      },
      "example": {
        "error_code": 401,
        "description": "校验TOKEN失败"
      }
    },
    "ErrorRsp404": {
      "description": "没有找到CBH资源。",
      "required": [
        "error_code",
        "error_description"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        },
        "error_description": {
          "description": "没有找到CBH资源。",
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
      },
      "example": {
        "error_code": 404,
        "description": "没有找到CBH资源"
      }
    },
    "ErrorRsp403": {
      "description": "租户无权限操作。",
      "required": [
        "error_code",
        "error_description"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        },
        "error_description": {
          "description": "租户无权限操作。",
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
      },
      "example": {
        "error_code": 403,
        "description": "租户无权限操作"
      }
    }
  },
  "version": "2.0",
