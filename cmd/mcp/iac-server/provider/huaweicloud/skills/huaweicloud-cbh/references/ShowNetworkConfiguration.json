        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        },
        "error_description": {
          "description": "请求参数错误。",
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
      },
