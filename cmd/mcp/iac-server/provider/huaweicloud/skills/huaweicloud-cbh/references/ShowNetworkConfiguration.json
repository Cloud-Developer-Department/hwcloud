        }
      },
      "example": {
        "error_code": 401,
        "description": "校验TOKEN失败"
      }
    },
    "NetworkRequestBody": {
      "description": "检查云堡垒机实例网络请求信息。",
      "required": [
        "type",
        "security_groups",
        "nics"
      ],
      "properties": {
        "type": {
          "description": "云堡垒机实例状态,枚举值如下:\n- create  创建\n- renewals  更新\n- change  变更\n状态为renewals或change时server_id必传。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "security_groups": {
          "description": "云堡垒升级实例所在安全组信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SecurityGroup"
          },
          "minItems": 0,
          "maxItems": 512,
          "uniqueItems": true
        },
        "nics": {
          "description": "云堡垒机实例的网卡信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Nics"
          },
          "minItems": 0,
          "maxItems": 512,
          "uniqueItems": true
        },
        "server_id": {
          "description": "云堡垒机实例ID。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        }
      },
      "example": {
        "type": "create",
        "security_groups": [
          {
            "id": "02dcf62d-b84d-4a14-aad3-c310f2ceea55"
          }
        ],
        "nics": [
          {
            "subnet_id": "dd08a6a9-ced7-484b-ace6-1b821854a772",
            "ip_address": "100.93.5.36"
          }
        ]
      }
    },
    "Nics": {
      "description": "云堡垒机实例网卡信息。",
      "required": [
        "subnet_id"
      ],
      "properties": {
        "subnet_id": {
          "description": "子网ID,字母数字下划线连接符组成。",
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        },
        "ip_address": {
          "description": "IPV4地址。",
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        }
      }
    },
    "NetworkConfigurationResponse": {
      "description": "云堡垒机实例网络信息。",
      "required": [
        "status",
        "security_grp_status",
        "firewall_status",
        "public_eip_status"
      ],
      "properties": {
        "status": {
          "description": "云堡垒机实例网络状态。下面3个正常则正常,有一个不正常,网络状态为失败。",
          "type": "boolean",
          "minLength": 0,
          "maxLength": 64
        },
        "security_grp_status": {
          "description": "云堡垒机实例安全组状态。\n- true  正常\n- false 失败",
          "type": "boolean",
          "minLength": 0,
          "maxLength": 64
        },
        "firewall_status": {
          "description": "云堡垒机实例防火墙状态。\n- true  正常\n- false 失败",
          "type": "boolean",
          "minLength": 0,
          "maxLength": 64
        },
        "public_eip_status": {
          "description": "云堡垒机实例公网IP状态。\n- true  正常\n- false 失败",
          "type": "boolean",
          "minLength": 0,
          "maxLength": 64
        }
      },
      "example": {
        "status": true,
        "security_grp_status": true,
        "firewall_status": true,
        "public_eip_status": true
      }
    },
    "ErrorRsp404": {
      "description": "没有找到CBH资源。",
