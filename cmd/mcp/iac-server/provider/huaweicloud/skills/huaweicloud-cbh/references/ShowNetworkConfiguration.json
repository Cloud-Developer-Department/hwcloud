        "description": "请求参数错误。"
      }
    },
    "ErrorRsp401": {
      "description": "校验TOKEN失败。",
      "required": [
        "error_code",
        "error_description"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 36
