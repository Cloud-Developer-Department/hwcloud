          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "vpc_id": {
          "description": "待创建云服务器所属虚拟私有云(简称VPC),需要指定已创建VPC的ID,UUID格式。\nVPC的ID可以从控制台或者参考《虚拟私有云接口参考》的“查询VPC”章节获取。\n例如:03211ecf-697e-4306-a7a0-6e939bf948de",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "nics": {
