          "items": {
            "$ref": "#/definitions/Nics"
          },
          "minItems": 0,
          "maxItems": 512,
          "uniqueItems": true
        },
        "public_ip": {
          "$ref": "#/definitions/PublicIp"
        },
        "security_groups": {
          "type": "array",
