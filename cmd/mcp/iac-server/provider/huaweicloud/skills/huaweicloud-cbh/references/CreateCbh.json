            "$ref": "#/definitions/SecurityGroup"
          },
          "minItems": 0,
          "maxItems": 512,
          "uniqueItems": true
        },
        "availability_zone": {
          "description": "创建云堡垒机所在的可用区,需要指定可用区名称。\n可参考[地区和终端节点](https://developer.huaweicloud.com/endpoint)获取",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "slave_availability_zone": {
          "description": "创建云堡垒机所在的备机可用区,需要指定备机可用区名称。(当前字段未启用,填写默认值null)\n可参考[地区和终端节点](https://developer.huaweicloud.com/endpoint)获取",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "comment": {
          "description": "云堡垒机实例描述信息。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "region": {
