          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "hx_password": {
          "description": "堡垒机实例前端登录密码。密码规则:8-32位,不能包含amdin或nidma及其大写形式,必须包含大小写数字特殊字符四种类型中的三种。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "bastion_type": {
