        "description": "请求参数错误。"
      }
    },
    "ChangeInstanceRequestBody": {
      "description": "创建云堡垒机实例变更任务请求体。\n\n> 说明:\nnew_resource_spec_code和attach_disk_size字段只能选择使用,不能同时使用。",
      "required": [
        "server_id"
      ],
      "properties": {
        "server_id": {
          "description": "云堡垒机实例ID,使用UUID格式表示。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "new_resource_spec_code": {
          "description": "待变更云堡垒机规格ID,例如:\n- cbh.basic.50\n- cbh.enhance.50\n\n可参考接口\"查询云堡垒机规格信息\"获取",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "attach_disk_size": {
          "description": "附加磁盘大小。单位TB\n\n> 说明:\n附加磁盘和规格自带磁盘大小不能超过300TB。",
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "is_auto_pay": {
          "$ref": "#/definitions/IsAutoPay"
        }
      },
      "example": {
        "server_id": "xxxxxx",
        "new_resource_spec_code": "cbh.basic.10",
        "attach_disk_size": 1,
        "is_auto_pay": 1
      }
    },
