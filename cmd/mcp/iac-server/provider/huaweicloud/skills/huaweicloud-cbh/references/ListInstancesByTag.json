              "$ref": "#/definitions/CbsShowProjectTags"
            },
            "examples": {
              "application/json": {
                "resources": [
                  {
                    "resource_id": "cdfs_cefs_wesas_12_dsad",
                    "resource_name": "resouece1",
                    "tags": [
                      {
                        "key": "key1",
                        "value": "value1"
                      },
                      {
                        "key": "key2",
                        "value": "value1"
