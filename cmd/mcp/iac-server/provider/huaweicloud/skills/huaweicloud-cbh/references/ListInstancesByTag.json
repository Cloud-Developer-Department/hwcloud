    "ResourceTag": {
      "required": [
        "key",
        "value"
      ],
      "description": "标签列表的结构体。",
      "properties": {
        "key": {
          "description": "键。最大长度128个字符。",
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^((?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)$"
        },
        "value": {
          "description": "值。每个值最大长度255个字符。",
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$"
        }
      }
    },
    "Match": {
      "description": "match字段值描述。",
      "required": [
