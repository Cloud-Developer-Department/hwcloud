{
  "name": "ShowOmUrl",
  "summary": "获取运维链接",
  "tags": "操作管理",
  "productshort": "CBH",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/cbs/instance/get-om-url": {
      "get": {
        "x-open-region-cloud": "hws,hws_hk,hcso",
        "tags": [
          "操作管理"
        ],
        "operationId": "ShowOmUrl",
        "summary": "获取运维链接",
        "description": "获取运维链接",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "in": "query",
            "name": "server_id",
            "description": "云堡垒机服务器ID",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": true
          },
          {
            "in": "query",
            "name": "ip_address",
            "description": "被纳管主机IP",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": true
          },
          {
            "in": "query",
            "name": "host_account_name",
            "description": "被纳管主机的账户",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": true
          }
        ],
        "x-apigateway-ratelimit": "CBH_Server",
        "responses": {
          "200": {
            "description": "Get HOST O&M URL Success",
            "schema": {
              "$ref": "#/definitions/EcsLoginResponse"
            },
            "examples": {
              "application/json": {
                "state": "SUCCESS",
                "login_url": "xxxxxx"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorRsp400"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorRsp401"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorRsp403"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorRsp404"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "EcsLoginResponse": {
      "type": "object",
      "required": [
        "state",
        "login_url"
      ],
      "properties": {
        "state": {
          "type": "string",
          "description": "链接获取状态\n    # SUCCESS(0): 成功;非SUCCESS状态都认为获取失败,需要展示错误代码及description\n    # IAM_USER_CONFLICT(1016): IAM用户冲突;\n    # HOST_NOT_MANAGE(1): 查询主机未被纳管;\n    # HOST_ACCOUNT_NOT_EXIST(553): 主机账户不可用;\n    # IAM_USER_NO_PERMISSION(901): IAM用户无运维该主机权限;\n    # CUR_VERSION_NOT_SUPPORT_OPERATION(9001):当前服务版本不支持;\n    # INS_WHITE_LIST_INITIALIZING(9002):实例白名单正在初始化,请稍后重试;\n    # UNKNOWN_ERROR(9003):未知错误;",
          "enum": [
            "SUCCESS",
            "IAM_USER_CONFLICT",
            "HOST_NOT_MANAGE",
            "HOST_ACCOUNT_NOT_EXIST",
            "IAM_USER_NO_PERMISSION",
            "CUR_VERSION_NOT_SUPPORT_OPERATION",
            "INS_WHITE_LIST_INITIALIZING",
            "UNKNOWN_ERROR"
          ],
          "minLength": 0,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "description": "链接获取异常时说明提示",
          "minLength": 0,
          "maxLength": 255
        },
        "login_url": {
          "type": "string",
          "description": "ECS运维登录地址",
          "minLength": 0,
          "maxLength": 255
        }
      }
    },
    "ErrorRsp400": {
      "description": "请求参数错误。",
      "required": [
        "error_code",
        "error_description"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        },
        "error_description": {
          "description": "请求参数错误。",
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
