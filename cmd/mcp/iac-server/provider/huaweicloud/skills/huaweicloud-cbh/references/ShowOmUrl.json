          "maxLength": 36
        },
        "error_description": {
          "description": "租户无权限操作。",
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
      },
      "example": {
        "error_code": 403,
        "description": "租户无权限操作"
      }
    }
