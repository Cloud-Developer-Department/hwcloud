{
  "name": "ListQuotaStatus",
  "summary": "获取弹性云服务器配额",
  "tags": "云堡垒机信息查询",
  "productshort": "CBH",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/cbs/instance/ecs-quota": {
      "get": {
        "tags": [
          "云堡垒机信息查询"
        ],
        "operationId": "ListQuotaStatus",
        "summary": "获取弹性云服务器配额",
        "description": "获取当前租户所选择的可用分区、性能规格所对应的弹性云服务器是否可用。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "deprecated": true,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "description": "项目ID。获取方法详见API参考,附录[获取项目ID](https://support.huaweicloud.com/api-cbh/cbh_02_0020.html)。",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": true
          },
          {
            "in": "query",
            "name": "availability_zone",
            "description": "创建云堡垒机所在的可用区,需要指定可用分区名称。\n可参考[地区和终端节点](https://developer.huaweicloud.com/endpoint)获取",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": true
          },
          {
            "in": "query",
            "name": "resource_spec_code",
            "description": "待创建云堡垒机规格ID,例如:\n- cbh.basic.10  10资产标准版\n- cbh.enhance.10  10资产专业版\n已上线的规格详情请参见《云堡垒机常见问题》的购买,[云堡垒机实例有哪些规格](https://support.huaweicloud.com/cbh_faq/cbh_03_0025.html)章节。",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Get Ecs Quota Success",
            "schema": {
              "$ref": "#/definitions/GetEcsQuotaResponse"
            },
            "examples": {
              "application/json": {
                "status_v6": "sellout",
                "status": "normal"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorRsp400"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorRsp401"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorRsp403"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorRsp404"
            }
          }
        }
      }
    }
  },
