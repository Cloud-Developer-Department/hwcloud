      ],
      "properties": {
        "status_v6": {
          "description": "支持IPv6弹性云服务器资源状态。\n- sellout 售罄\n- normal  正常商用\n- abandon 下线(即不显示)",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "status": {
          "description": "弹性云服务器资源状态。\n- sellout 售罄\n- normal  正常商用\n- abandon 下线(即不显示)",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "eip_quota": {
          "description": "弹性配额信息,返回默认值null。",
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "quota": {
          "description": "剩余可创建云堡垒机配额信息,返回默认值null。",
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "example": {
        "quota": null,
        "status_v6": "sellout",
        "eip_quota": null,
        "status": "normal"
      }
