{
  "name": "ListTags",
  "summary": "查询租户在项目中的资源标签集合",
  "tags": "标签管理",
  "productshort": "CBH",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/cbs/instance/tags": {
      "get": {
        "x-open-region-cloud": "hws,hws_hk,cmcc",
        "tags": [
          "标签管理"
        ],
        "operationId": "ListTags",
        "summary": "查询租户在项目中的资源标签集合",
        "description": "查询租户在项目中的资源标签集合。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "x-apigateway-ratelimit": "CBH_Server",
        "responses": {
          "200": {
            "description": "Show Project Tags Success",
            "schema": {
              "$ref": "#/definitions/CbsGetTags"
            },
            "examples": {
              "application/json": {
                "tags": [
                  {
                    "key": "cbh-test",
                    "values": [
                      "test1",
                      "test2"
                    ]
                  },
                  {
                    "key": "cbh-test1",
                    "values": [
                      "test3",
                      "test4"
                    ]
                  }
                ]
              }
            }
          },
          "400": {
