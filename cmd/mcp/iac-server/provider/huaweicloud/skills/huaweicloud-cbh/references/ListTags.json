    "ErrorRsp401": {
      "description": "校验TOKEN失败。",
      "required": [
        "error_code",
        "error_description"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        },
        "error_description": {
          "description": "校验TOKEN失败。",
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
      },
      "example": {
        "error_code": 401,
        "description": "校验TOKEN失败"
      }
    },
    "Tags": {
      "description": "标签信息。\n\n> 说明:\n- 不允许重复key\n- 每实例最多允许20个标签(系统可配置),不包含_sys开头系统标签 \n- 优先按照创建时间的倒序排序。如果没有创建时间则按照资源名称ASCII码进行排序",
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "description": "键。\n\n> 说明:\n- key不能为空,长度1~128个字符(中文也可以输入128个字符)\n- 可用 UTF-8 格式表示的字母(包含中文)、数字和空格,以及以下字符: _ . : = + - @\n- _sys_开头属于系统标签,租户不能输入\n- 建议正则:^((?!_sys_)[\\\\p{L}\\\\p{Z}\\\\p{N}_.:=+\\\\-@]*)$",
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        },
        "values": {
          "description": "值列表。\n\n> 说明:\n- 长度0~255个字符(中文也可以输入255个字符)\n- 可用 UTF-8 格式表示的字母(包含中文)、数字和空格,以及以下字符: _ . : / = + - @ 建议正则:^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$\n- 资源标签值可以为空(empty or null)\n- 预定义标签值不可以为空",
          "type": "array",
          "minItems": 0,
          "maxItems": 36,
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 64
          }
        }
      }
    },
    "ErrorRsp404": {
      "description": "没有找到CBH资源。",
      "required": [
        "error_code",
        "error_description"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        },
        "error_description": {
          "description": "没有找到CBH资源。",
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
      },
      "example": {
        "error_code": 404,
        "description": "没有找到CBH资源"
      }
    },
    "CbsGetTags": {
      "description": "查询租户在指定项目ID中实例类型的所有资源标签集合返回体。",
      "required": [
        "tags"
      ],
      "properties": {
        "tags": {
          "description": "标签列表。",
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/Tags"
          }
        }
      }
    },
    "ErrorRsp403": {
      "description": "租户无权限操作。",
