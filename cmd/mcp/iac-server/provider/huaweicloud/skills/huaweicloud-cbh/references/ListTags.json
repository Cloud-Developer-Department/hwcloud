            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorRsp403"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorRsp404"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorRsp400": {
      "description": "请求参数错误。",
      "required": [
        "error_code",
        "error_description"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
