        "error_description"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        },
        "error_description": {
          "description": "校验TOKEN失败。",
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
