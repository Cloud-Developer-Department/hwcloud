{
  "name": "ListSpecifications",
  "summary": "查询云堡垒机规格信息",
  "tags": "规格管理",
  "productshort": "CBH",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/cbs/instance/specification": {
      "get": {
        "x-open-region-cloud": "hws,hws_hk,ctc,cmcc,hcso",
        "tags": [
          "规格管理"
        ],
        "operationId": "ListSpecifications",
        "summary": "查询云堡垒机规格信息",
        "description": "查询云堡垒机规格信息。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "in": "query",
            "name": "action",
            "description": "查询云堡垒机规格当前动作。\n- create:查询可创建云堡垒机规格信息\n- update:查询可变更云堡垒机规格信息",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": true
          },
          {
            "in": "query",
            "name": "spec_code",
            "description": "云堡垒机规格信息,当action为update时此字段必填。",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": false
          }
        ],
        "x-apigateway-ratelimit": "CBH_Server",
        "responses": {
          "200": {
            "description": "CBH instance specifications queried",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/CbsGetSpecInfo"
              }
            },
            "examples": {
              "application/json": [
                {
                  "data_disk_size": 1,
                  "ecs_system_data_size": 10,
                  "cpu": 4,
                  "connection": 10,
                  "resource_spec_code": "cbh.basic.xxx",
                  "asset": 10,
                  "type": "basic",
                  "ram": 8
                }
              ]
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorRsp400"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorRsp401"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorRsp403"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorRsp404"
            }
          }
        }
      }
    }
  },
  "definitions": {
