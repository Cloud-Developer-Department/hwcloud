    "CbsGetSpecInfo": {
      "description": "堡垒机规格信息。",
      "required": [
        "resource_spec_code",
        "ecs_system_data_size",
        "cpu",
        "ram",
        "asset",
        "connection",
        "type",
        "data_disk_size"
      ],
      "properties": {
        "resource_spec_code": {
          "description": "云堡垒机规格名称。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "ecs_system_data_size": {
          "description": "云堡垒机系统盘磁盘大小,单位GB。",
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "cpu": {
          "description": "云堡垒机CPU核心数。",
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "ram": {
          "description": "云堡垒机内存大小,单位GB。",
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "asset": {
          "description": "云堡垒机资产数量。",
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "connection": {
          "description": "云堡垒机最大连接数。",
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "type": {
          "description": "云堡垒机规格类型。\n- basic:标准版\n- enhance:专业版",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "data_disk_size": {
          "description": "云堡垒机数据盘大小,单位TB。",
          "type": "number",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
