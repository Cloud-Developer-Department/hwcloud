{
  "name": "ListAssetEditTask",
  "summary": "查询编辑任务",
  "tags": "媒资编辑管理",
  "productshort": "VOD",
  "region_id": "ap-southeast-2",
  "paths": {
    "/v1/{project_id}/asset/editing/tasks": {
      "get": {
        "description": "查询编辑任务",
        "summary": "查询编辑任务",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "operationId": "ListAssetEditTask",
        "tags": [
          "媒资编辑管理"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "pattern": "^([0-9a-zA-Z]+)$",
            "description": "项目ID"
          },
          {
            "in": "query",
            "name": "task_id",
            "type": "string",
            "description": "编辑任务ID",
            "minLength": 0,
            "maxLength": 64,
            "required": false
          },
          {
            "in": "query",
            "name": "offset",
            "type": "integer",
            "description": "查询偏移量,默认0",
            "minimum": 0,
            "maximum": 2147483647,
            "default": 0,
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "type": "integer",
            "description": "查询一页返回数,默认10,最大支持100",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。",
            "schema": {
              "$ref": "#/definitions/QueryAssetEditTaskRsp"
            }
          },
          "400": {
            "description": "处理失败返回。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "EditingTaskInfo": {
      "type": "object",
      "properties": {
        "task_id": {
          "description": "编辑任务ID\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "asset_id": {
          "description": "输出的媒资ID\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "description": "任务状态\n- WAITING 等待中\n- PROCESSING 处理中;\n- SUCCEED 成功;\n- FAILED 失败;\n- CANCEL 已取消;\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "progress": {
          "description": "进度,取值0-100\n",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "create_time": {
          "description": "任务创建时间,格式按照RFC3339,UTC时间,如2020-09-01T18:50:20Z\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "end_time": {
          "description": "任务结束时间,格式按照RFC3339,UTC时间,如2020-09-01T18:50:20Z,当任务结束时才有值\n",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "QueryAssetEditTaskRsp": {
      "type": "object",
      "properties": {
        "total": {
          "description": "任务总数\n",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 2147483647
        },
        "tasks": {
          "description": "任务列表\n",
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/EditingTaskInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.ap-southeast-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}