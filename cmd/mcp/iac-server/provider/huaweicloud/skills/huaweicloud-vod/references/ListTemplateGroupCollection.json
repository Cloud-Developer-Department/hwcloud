{
  "name": "ListTemplateGroupCollection",
  "summary": "查询自定义模板组集合",
  "tags": "转码模板集合管理",
  "productshort": "VOD",
  "region_id": "cn-north-4",
  "paths": {
    "/v1.0/{project_id}/asset/template-collection/transcodings": {
      "get": {
        "description": "查询转码模板组集合",
        "summary": "查询自定义模板组集合",
        "operationId": "ListTemplateGroupCollection",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "x-since": "1.0.0",
        "x-since-memo": "1.0.0 initial",
        "tags": [
          "转码模板集合管理"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/usermanual-vod/vod_01_0058.html)",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
            "required": true
          },
          {
            "in": "query",
            "name": "group_collection_id",
            "required": false,
            "type": "string",
            "description": "模板组集合id\n"
          },
          {
            "in": "query",
            "name": "offset",
            "type": "integer",
            "format": "int32",
            "required": false,
            "default": 0,
            "description": "偏移量。默认为0。指定group_collection_id时该参数无效。<br/>\n"
          },
          {
            "in": "query",
            "name": "limit",
            "type": "integer",
            "format": "int32",
            "required": false,
            "default": 10,
            "description": "每页记录数。默认为10,范围[1,100]。指定group_collection_id时该参数无效。<br/>\n"
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。\n",
            "schema": {
              "$ref": "#/definitions/QueryTemplateGroupCollectionRsp"
            },
            "examples": {
              "application/json": {
                "template_group_collection_list": [
                  {
                    "group_collection_id": "9751249d25f14587b212544d6fd8dcf8",
                    "name": "test",
                    "template_group_list": [
                      {
                        "group_id": "9751249d25f14587b212544d6fd8dcf8",
                        "name": "test112",
                        "status": "0",
                        "type": "custom_template_group",
                        "auto_encrypt": 0,
                        "quality_info_list": [
                          {
                            "video": {
                              "quality": "UNKNOW",
                              "width": 0,
                              "height": 0,
                              "bitrate": 0,
                              "frame_rate": 0
                            },
                            "audio": null,
                            "format": "UNKNOW"
                          }
                        ],
                        "watermark_template_ids": null,
                        "description": null,
                        "common": {
                          "pvc": null,
                          "pvc_version": null,
                          "video_codec": null,
                          "audio_codec": "AAC",
                          "hls_interval": 0
                        }
                      }
                    ]
                  }
                ],
                "total": 1
              }
            }
          },
          "400": {
            "description": "处理失败返回。\n",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "VOD.10053",
                "error_msg": "The request parameter is illegal, illegal field: {xx}."
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1.0/{project_id}/asset/template-collection/transcodings"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "QualityInfo": {
      "required": [
        "format"
      ],
      "properties": {
        "video": {
          "$ref": "#/definitions/VideoTemplateInfo"
        },
        "audio": {
          "$ref": "#/definitions/AudioTemplateInfo"
        },
        "format": {
          "type": "string",
          "description": "格式。",
          "enum": [
            "MP4",
            "HLS",
            "DASH",
            "DASH_HLS",
            "MP3",
            "ADTS",
            "UNKNOW"
          ]
        }
      },
      "description": ""
    },
    "QueryTemplateGroupCollectionRsp": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "template_group_collection_list": {
          "type": "array",
          "description": "模板组集合信息<br/>\n",
          "items": {
            "$ref": "#/definitions/TemplateGroupCollection"
          }
        },
        "total": {
          "description": "总记录条数<br/>\n",
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "VideoTemplateInfo": {
      "x-imports": "org.hibernate.validator.constraints.*;",
      "required": [
        "quality"
      ],
      "properties": {
        "quality": {
          "type": "string",
          "description": "画质。",
          "enum": [
            "FULL_HD",
            "HD",
            "SD",
            "FLUENT",
            "AD",
            "2K",
            "4K",
            "UNKNOW"
          ]
        },
        "width": {
          "description": "视频宽度。",
          "type": "integer"
        },
        "height": {
          "description": "视频高度。",
          "type": "integer"
        },
        "bitrate": {
          "description": "码率。",
          "type": "integer"
        },
        "frame_rate": {
          "description": "帧率(默认为1,1代表自适应,单位是帧每秒)。",
          "type": "integer"
        }
      },
      "description": "模板视频信息"
    },
    "Common": {
      "x-imports": "org.hibernate.validator.constraints.*;",
      "required": [
        "pvc"
      ],
      "properties": {
        "pvc": {
          "type": "string",
          "description": "高清低码开关。",
          "enum": [
            "0",
            "1",
            "2",
            "UNKNOW"
          ]
        },
        "pvc_version": {
          "type": "string",
          "description": "高清低码版本。"
        },
        "video_codec": {
          "type": "string",
          "description": "视频编码格式。",
          "enum": [
            "H264",
            "H265",
            "UNKNOW"
          ]
        },
        "audio_codec": {
          "description": "音频编码格式(有效值范围)\n- 1:AUDIO_CODECTYPE_AAC\n- 2:AUDIO_CODECTYPE_HEAAC1\n- 3:AUDIO_CODECTYPE_HEAAC2\n- 4:AUDIO_CODECTYPE_MP3\n\n默认值为1。",
          "type": "string",
          "format": "int32",
          "enum": [
            "AAC",
            "HEAAC1",
            "HEAAC2",
            "MP3"
          ]
        },
        "hls_interval": {
          "description": "分片时长(默认为5秒)。",
          "type": "integer"
        }
      },
      "description": "模板信息。"
    },
    "TemplateGroupCollection": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "group_collection_id": {
          "type": "string",
          "description": "模板组集合id<br/>\n"
        },
        "name": {
          "type": "string",
          "description": "模板组集合名称<br/>\n"
        },
        "description": {
          "type": "string",
          "description": "模板介绍<br/>\n"
        },
        "template_group_list": {
          "description": "转码组列表<br/>\n",
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/TemplateGroup"
          }
        }
      }
    },
    "TemplateGroup": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string",
          "description": "模板组id<br/>\n"
        },
        "name": {
          "type": "string",
          "description": "模板组名称<br/>\n"
        },
        "status": {
          "type": "string",
          "description": "是否默认<br/>\n"
        },
        "type": {
          "type": "string",
          "description": "模板组类型<br/>\n"
        },
        "auto_encrypt": {
          "type": "integer",
          "description": "是否自动加密。\n\n取值如下:\n- 0:表示不加密。\n- 1:表示需要加密。\n\n默认值:0。\n\n加密与转码必须要一起进行,当需要加密时,转码参数不能为空,且转码输出格式必须要为HLS。",
          "default": 0
        },
        "quality_info_list": {
          "type": "array",
          "description": "画质配置信息列表<br/>\n",
          "items": {
            "$ref": "#/definitions/QualityInfo"
          }
        },
        "watermark_template_ids": {
          "type": "array",
          "description": "绑定的水印模板组ID数组<br/>\n",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "description": "模板介绍<br/>\n"
        },
        "common": {
          "description": "高清低码开关,高清低码版本,编码格式多路共同参数<br/>\n",
          "$ref": "#/definitions/Common"
        }
      }
    },
    "AudioTemplateInfo": {
      "x-imports": "org.hibernate.validator.constraints.*;",
      "required": [
        "sample_rate",
        "channels"
      ],
      "properties": {
        "sample_rate": {
          "description": "音频采样率(有效值范围)\n- 1:AUDIO_SAMPLE_AUTO\n- 2:AUDIO_SAMPLE_22050\n- 3:AUDIO_SAMPLE_32000\n- 4:AUDIO_SAMPLE_44100\n- 5:AUDIO_SAMPLE_48000\n- 6:AUDIO_SAMPLE_96000\n\n默认值为1。",
          "type": "integer",
          "format": "int32",
          "x-annotations": [
            "@Range(min = 1, max = 6)"
          ]
        },
        "bitrate": {
          "description": "音频码率(单位:Kbps)。",
          "type": "integer",
          "format": "int32"
        },
        "channels": {
          "description": "声道数(有效值范围)\n- 1:AUDIO_CHANNELS_1\n- 2:AUDIO_CHANNELS_2",
          "type": "integer",
          "format": "int32",
          "x-annotations": [
            "@Range(min = 1, max = 2)"
          ]
        }
      },
      "description": "模板音频信息"
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
