  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "AdditionalManifest": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "required": [
        "manifest_name_modifier",
        "selected_outputs"
      ],
      "properties": {
        "manifest_name_modifier": {
          "type": "string",
          "description": "索引后缀名,后缀名仅支持数字,字母、下划线、中划线。",
          "maxLength": 64,
          "minLength": 1
        },
        "selected_outputs": {
          "type": "array",
          "description": "选择流名列表,最多支持9路流。",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "QualityInfoList": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "required": [
        "format"
      ],
      "properties": {
        "video": {
          "$ref": "#/definitions/VideoInfo"
        },
        "audio": {
          "$ref": "#/definitions/AudioInfo"
        }
      }
    },
    "VideoInfo": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "required": [
        "quality",
        "bitrate",
        "frame_rate"
      ],
      "x-imports": "org.hibernate.validator.constraints.*;",
      "properties": {
        "stream_name": {
          "type": "string",
          "description": "流名,流名仅支持数字、字母、下划线、中划线。\n如果流名不填,则点播会按照video_stream_l{index}形式,生成一个流名。\n",
          "minLength": 1,
          "maxLength": 64
        },
        "quality": {
          "type": "string",
          "description": "画质<br/>\n4K默认分辨率3840*2160,码率8000kbit/s<br/>\n2K默认分辨率2560*1440,码率7000kbit/s<br/>\nFULL_HD默认分辨率1920*1080,码率3000kbit/s<br/>\nHD默认分辨率1280*720,码率1000kbit/s<br/>\nSD默认分辨率854*480,码率600kbit/s<br/>\nFLUENT默认分辨率480*270,码率300kbit/s<br/>\n",
          "enum": [
            "FULL_HD",
            "HD",
            "SD",
            "FLUENT",
            "2K",
            "4K",
            "UNKNOW"
          ]
        },
        "width": {
          "description": "视频宽度<br/>\n",
          "type": "integer"
        },
        "height": {
          "description": "视频高度<br/>\n",
          "type": "integer"
        },
        "bitrate": {
          "description": "码率,单位:kbit/s<br/>\n",
          "type": "integer"
        },
        "frame_rate": {
          "description": "帧率(默认为0,0代表自适应,单位是帧每秒)<br/>\n",
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        }
      }
    },
    "AudioInfo": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "required": [
        "sample_rate",
        "channels"
      ],
      "x-imports": "org.hibernate.validator.constraints.*;",
      "properties": {
        "sample_rate": {
          "description": "音频采样率(有效值范围)<br/>\nAUDIO_SAMPLE_AUTO (default),\nAUDIO_SAMPLE_22050:22050Hz<br/>\nAUDIO_SAMPLE_32000:32000Hz<br/>\nAUDIO_SAMPLE_44100:44100Hz<br/>\nAUDIO_SAMPLE_48000:48000Hz<br/>\nAUDIO_SAMPLE_96000:96000Hz<br/>\n",
          "type": "string",
          "enum": [
            "AUDIO_SAMPLE_AUTO",
            "AUDIO_SAMPLE_22050",
            "AUDIO_SAMPLE_32000",
            "AUDIO_SAMPLE_44100",
            "AUDIO_SAMPLE_48000",
            "AUDIO_SAMPLE_96000"
          ]
        },
        "bitrate": {
          "description": "音频码率(单位:Kbps)<br/>\n",
          "type": "integer",
          "format": "int32"
        },
        "channels": {
          "description": "声道数(有效值范围)<br/>\nAUDIO_CHANNELS_1:单声道<br/>\nAUDIO_CHANNELS_2:双声道<br/>\nAUDIO_CHANNELS_5_1:5.1声道<br/>\n",
          "type": "string",
          "enum": [
            "AUDIO_CHANNELS_1",
            "AUDIO_CHANNELS_2",
            "AUDIO_CHANNELS_5_1"
          ]
        }
      }
    },
    "CreateTranscodeTemplate": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "x-imports": "javax.validation.constraints.NotEmpty;",
      "required": [
        "name",
        "common",
        "quality_info_list"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "模板组名称<br/>\n",
          "maxLength": 128,
          "minLength": 1,
          "x-annotations": [
            "@NotEmpty"
          ]
        },
        "is_default": {
          "type": "boolean",
          "description": "是否设置成默认转码模板<br/>\n",
          "default": false
        },
        "is_auto_encrypt": {
          "type": "boolean",
          "description": "是否开启加密",
          "default": false
        },
        "additional_manifests": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "description": "自定义索引后缀列表,支持最大设置10个索引后缀。\n如果填写索引后缀,则必须指定流名stream_name。\n",
          "items": {
            "$ref": "#/definitions/AdditionalManifest"
          }
        },
        "quality_info_list": {
          "type": "array",
          "description": "画质配置信息列表<br/>\n",
          "x-annotations": [
            "@NotNull"
          ],
          "minLength": 1,
          "items": {
            "$ref": "#/definitions/QualityInfoList"
          }
        },
        "common": {
          "description": "高清低码开关,编码格式多路共同参数<br/>\n",
          "$ref": "#/definitions/CommonInfo"
        },
        "watermark_template_ids": {
          "x-annotations": [
            "@Size(max = 1)"
          ],
          "type": "array",
          "description": "绑定的水印模板组ID数组<br/>\n",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "description": "模板介绍<br/>\n",
          "maxLength": 256
        }
      }
    },
    "CommonInfo": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "required": [
        "format"
      ],
      "x-imports": "org.hibernate.validator.constraints.*;",
      "properties": {
        "pvc": {
          "type": "boolean",
          "description": "高清低码开关<br/>\n",
          "default": false
        },
        "video_codec": {
          "description": "视频编码格式<br/>\n",
          "type": "string",
          "enum": [
            "H264",
            "H265"
          ]
        },
        "audio_codec": {
          "description": "音频编码格式<br/>\nAAC:AAC格式 (default)<br/>\nHEAAC1:HEAAC1格式<br/>\nHEAAC2:HEAAC2格式<br/>\nMP3:MP3格式<br/>\n",
          "type": "string",
          "enum": [
            "AAC",
            "HEAAC1",
            "HEAAC2",
            "MP3"
          ]
        },
        "is_black_cut": {
          "description": "黑边剪裁类型<br/>\n",
          "type": "boolean",
          "default": false
        },
        "format": {
          "type": "string",
          "description": "格式<br/>\n",
          "enum": [
            "MP4",
            "HLS",
            "DASH",
            "DASH_HLS",
            "MP3",
            "ADTS",
            "UNKNOW"
          ]
        },
        "hls_interval": {
          "description": "分片时长(默认为5秒)<br/>\n",
          "type": "integer",
          "default": 5,
          "minimum": 2,
          "maximum": 10
        },
        "upsample": {
          "description": "上采样<br/>\n",
          "type": "boolean",
          "default": false
        },
        "adaptation": {
          "description": "SHORT:短边自适应<br/>\nLONG:长边自适应<br/>\nNONE:宽高自适应<br/>\n",
          "type": "string",
          "enum": [
            "SHORT",
            "LONG",
            "NONE"
          ],
          "default": "NONE"
        },
        "preset": {
          "description": "编码质量等级,取值[0,2] 0表示当前现网方式默认方式,1表示转码效率优先,2表示转码质量优先。<br/>\n",
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "max_iframes_interval": {
          "description": "I帧最大间隔,取值范围:[2,10]。默认值:5,单位秒。<br/>\n",
          "type": "integer",
          "format": "int32"
        },
        "hls_audio_separate": {
          "description": "转码后音频是否独立存储。<br/>\n",
          "type": "boolean",
          "default": false
        },
        "hls_segment_type": {
          "description": "分片的封装格式,目前支持TS和FMP4,默认TS格式。\n",
          "type": "string",
          "enum": [
            "TS",
            "FMP4"
          ]
        }
      }
    },
    "CreateTemplateGroupRsp": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string",
          "description": "模板组ID<br/>\n"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.ap-southeast-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
