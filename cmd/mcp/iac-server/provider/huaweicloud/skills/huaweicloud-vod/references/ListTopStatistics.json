{
  "name": "ListTopStatistics",
  "summary": "查询TopN媒资信息",
  "tags": "统计分析",
  "productshort": "VOD",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1.0/{project_id}/asset/top-statistics": {
      "get": {
        "x-publishpath": "vod_04_0105",
        "description": "查询指定域名在指定日期播放次数排名Top 100的媒资统计数据。",
        "summary": "查询TopN媒资信息",
        "operationId": "ListTopStatistics",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "tags": [
          "统计分析"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/usermanual-vod/vod_01_0058.html)",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
            "required": true
          },
          {
            "in": "query",
            "name": "domain",
            "required": true,
            "type": "string",
            "description": "查询域名,暂只支持查询单个或者全部域名。\n\n取值如下:\n- 单个加速域名,格式:example.test1.com。\n- ALL:表示查询名下全部域名。"
          },
          {
            "in": "query",
            "name": "date",
            "required": true,
            "type": "string",
            "description": "查询日期,格式为yyyymmdd\n- date必须为昨天或之前的日期。\n- 最多只能查最近一个月内的数据。"
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。",
            "schema": {
              "$ref": "#/definitions/queryTopStatRsp"
            },
            "examples": {
              "application/json": {
                "top_urls": [
                  {
                    "value": 0,
                    "asset_id": "548b6023bf2cc925bd64343f04ca0f88",
                    "title": "test",
                    "duration": 0,
                    "duration_ms": 0,
                    "size": 0
                  }
                ]
              }
            }
          },
          "400": {
            "description": "处理失败返回。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "VOD.10053",
                "error_msg": "The request parameter is illegal, illegal field: {xx}."
              }
            }
          }
        },
        "x-request-examples-url-1": "GET\nhttps://{endpoint}/v1.0/{project_id}/asset/top-statistics?domain=ALL&date=20190612"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "queryTopStatRsp": {
      "type": "object",
      "properties": {
        "top_urls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TopUrl"
          }
        }
      }
    },
    "TopUrl": {
      "properties": {
        "value": {
          "type": "integer",
          "format": "int64",
          "description": "总播放次数。"
        },
        "asset_id": {
          "type": "string",
          "description": "媒资ID。"
        },
        "title": {
          "type": "string",
          "description": "媒资名称。"
        },
        "duration": {
          "type": "integer",
          "description": "媒资时长。\n\n单位:秒。"
        },
        "duration_ms": {
          "type": "integer",
          "format": "int64",
          "description": "视频时长,单位毫秒。"
        },
        "size": {
          "type": "integer",
          "format": "int64",
          "description": "媒资原始大小。\n\n单位:字节。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}