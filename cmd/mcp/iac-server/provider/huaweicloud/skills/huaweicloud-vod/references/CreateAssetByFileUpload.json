                "error_code": "VOD.10064",
                "error_msg": "Media asset classification does not exist, please check."
              }
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v1/{project_id}/asset",
        "x-request-examples-1": {
          "title": "Avatar test test",
          "description": "Avatar, test",
          "category_id": 1,
          "tags": "mytags",
          "video_name": "Avatar_480P.mp4",
          "video_type": "MP4",
          "video_md5": "a945d4b3d8fc317190a9332fe856f03d",
          "cover_type": "JPG",
          "cover_md5": "a655d4b3d8fc758691a9332fe387f26c",
          "auto_publish": 0,
          "subtitles": [
            {
              "id": 1,
              "language": "CN",
              "type": "SRT",
              "md5": "SqcyFjJZoDZaP8oKIY6rgQ==",
              "description": "AAAAA"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "Subtitle": {
      "required": [
        "id",
        "type",
        "language"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "description": "字幕id。\n\n取值范围:[1,8]。"
        },
        "type": {
          "type": "string",
          "enum": [
            "SRT"
          ],
          "description": "字幕文件类型,目前暂只支持“SRT”。"
        },
        "language": {
          "type": "string",
          "enum": [
            "CN",
            "EN"
          ],
          "description": "字幕语言类型。\n\n取值如下:\n- CN:表示中文字幕。\n- EN:表示英文字幕。"
        },
        "name": {
          "type": "string",
          "description": "subtitle name"
        },
        "md5": {
          "type": "string",
          "description": "字幕文件的MD5值。"
        },
        "description": {
          "type": "string",
          "description": "字幕描述。"
        }
      }
    },
    "File_addr": {
      "required": [
        "bucket",
        "location",
        "object"
      ],
      "properties": {
        "bucket": {
          "description": "OBS的bucket名称。",
          "type": "string"
        },
        "location": {
          "description": "桶所在的区域名, 如“华北-北京四”的区域名为“cn-north-4”,创建的桶所在区域必须和点播服务所在区域保持一致。",
          "type": "string"
        },
        "object": {
          "description": "文件的存储路径。",
          "type": "string"
        }
      },
      "description": "媒资存储参数信息。"
    },
    "CreateAssetByFileUploadReq": {
      "required": [
        "title",
        "video_name",
        "video_type"
      ],
      "properties": {
        "title": {
          "type": "string",
          "example": "string",
          "description": "媒资标题,长度不超过128个字节,UTF-8编码。"
        },
        "description": {
          "type": "string",
          "example": "string",
          "description": "视频描述,长度不超过1024个字节。"
        },
        "video_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "音视频文件名,长度不超过128个字节。\n\n文件名后缀可选。"
        },
        "video_type": {
          "type": "string",
          "example": "string",
          "description": "上传音视频文件的格式。\n\n取值如下:\n- 视频文件:MP4、TS、MOV、MXF、MPG、FLV、WMV、AVI、M4V、F4V、MPEG、3GP、ASF、MKV、HLS\n- 音频文件:MP3、OGG、WAV、WMA、APE、FLAC、AAC、AC3、MMF、AMR、M4A、M4R、WV、MP2\n\n若上传格式为音频文件,则不支持转码、添加水印和字幕。"
        },
        "category_id": {
          "type": "integer",
          "example": "integer",
          "description": "媒资分类ID。\n\n您可以调用[创建媒资分类](https://support.huaweicloud.com/api-vod/vod_04_0028.html)接口或在点播控制台的[分类设置](https://support.huaweicloud.com/usermanual-vod/vod010006.html)中创建对应的媒资分类,并获取分类ID。\n\n> 若不设置或者设置为-1,则上传的音视频归类到系统预置的“其它”分类中。"
        },
        "video_md5": {
          "type": "string",
          "description": "视频文件MD5值。\n\n建议参考[媒资上传和更新](https://support.huaweicloud.com/api-vod/vod_04_0212.html)生成对应的MD5值。"
        },
        "cover_type": {
          "type": "string",
          "description": "封面图片文件类型。\n\n取值如下:\n- JPG\n- PNG\n\n上传后的封面名称是固定的,后缀名为封面类型缩写。例如cover0.jpg,cover1.png\n若不指定类型,则封面文件无后缀名。\n\n> 如果设置了图片格式,则不会执行首帧截图作为封面动作,需自行上传封面。",
          "enum": [
            "JPG",
            "PNG"
          ]
        },
        "cover_md5": {
          "type": "string",
          "description": "封面文件MD5值"
        },
        "subtitles": {
          "type": "array",
          "description": "字幕文件信息",
          "items": {
            "$ref": "#/definitions/Subtitle"
          }
        },
        "tags": {
          "type": "string",
          "example": "string",
          "description": "视频标签。\n\n单个标签不超过16个字节,最多不超过16个标签。\n\n多个用逗号分隔,UTF8编码。"
        },
        "auto_publish": {
          "type": "integer",
          "format": "int32",
          "example": "integer",
          "description": "是否自动发布。\n\n取值如下:\n- 0:表示不自动发布。\n- 1:表示自动发布。\n\n默认值:1。",
          "enum": [
            0,
            1
          ]
        },
        "template_group_name": {
          "type": "string",
          "example": "string",
          "description": "转码模板组名称。\n\n若不为空,则使用指定的转码模板对上传的音视频进行转码,您可以在视频点播控制台配置转码模板,具体请参见[转码设置](https://support.huaweicloud.com/usermanual-vod/vod_01_0072.html)。\n\n>\n若同时设置了“**template_group_name**”和“**workflow_name**”字段,则“**template_group_name**”字段生效。"
        },
        "auto_encrypt": {
          "type": "integer",
          "description": "是否自动加密。\n\n取值如下:\n- 0:表示不加密。\n- 1:表示需要加密。\n\n默认值:0。\n\n加密与转码必须要一起进行,当需要加密时,转码参数不能为空,且转码输出格式必须要为HLS。",
          "default": 0
        },
        "auto_preheat": {
          "type": "string",
          "example": "integer",
          "description": "是否自动预热到CDN。\n\n取值如下:\n- 0:表示不自动预热。\n- 1:表示自动预热。\n\n默认值:0。"
        },
        "thumbnail": {
          "$ref": "#/definitions/Thumbnail"
        },
        "review": {
          "$ref": "#/definitions/Review"
        },
        "workflow_name": {
          "type": "string",
          "example": "string",
          "description": "工作流名称。\n\n若不为空,则使用指定的工作流对上传的音视频进行处理,您可以在视频点播控制台配置工作流,具体请参见[工作流设置](https://support.huaweicloud.com/usermanual-vod/vod010041.html)。"
        }
      }
    },
    "CreateAssetByFileUploadRsp": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "description": "媒体ID\n"
        },
        "video_upload_url": {
          "type": "string",
          "description": "视频上传URL\n"
        },
        "cover_upload_url": {
          "type": "string",
          "description": "封面上传地址\n"
        },
        "subtitle_upload_urls": {
          "type": "array",
          "description": "字幕文件上传url数组\n",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "$ref": "#/definitions/File_addr"
        }
      }
    },
    "Thumbnail": {
      "description": "截图参数",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "截图类型。\n\n取值如下:\n- time:每次进行截图的间隔时间。\n- dots: 按照指定的时间点截图。\n- quantity: 按照指定张数,根据视频时长等分视频截图。",
          "enum": [
            "time",
            "dots",
            "quantity"
          ]
        },
        "quantity": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 10,
          "description": "**type**取值为quantity时必填。 按照指定张数,根据视频时长等分视频截图。\n取值范围:[1,10]之间的整数。"
        },
        "quantity_time": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "**type**取值为quantity时选填。 按照指定时间间隔取指定张数截图。\n取值范围:[0,2147483647]之间的整数。"
        },
        "time": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 100,
          "description": "根据时间间隔采样时的时间间隔值。单位:秒。\n**type**取值为time时。\n默认值:12\n取值范围:[0,100]之间的整数。"
        },
        "dots": {
          "type": "array",
          "description": "**type**取值为dots时必填。指定时间截图时的时间点数组。",
          "items": {
            "type": "integer"
          }
        },
        "cover_position": {
          "type": "integer",
          "description": "该值表示指定第几张截图作为封面。\n\n默认值:1。"
        },
        "format": {
          "type": "integer",
          "description": "截图文件格式。\n\n取值如下:\n- 1:jpg。\n\n默认值:1 。",
          "default": 1
        },
        "aspect_ratio": {
          "type": "integer",
          "description": "纵横比,图像缩放方式。\n\n取值如下:\n- 0:自适应(保持原有宽高比)。\n- 1:16:9。\n\n默认值:0。",
          "default": 0
        },
        "max_length": {
          "type": "integer",
          "description": "截图最长边的尺寸。\n\n单位:像素。\n\n宽边尺寸按照该尺寸与原始视频像素等比缩放计算。"
        }
      }
    },
    "Review": {
      "description": "媒资审核参数",
      "properties": {
        "template_id": {
          "type": "string",
          "description": "审核模板ID。您可以在视频点播控制台配置审核模板后获取,具体请参见[审核设置](https://support.huaweicloud.com/usermanual-vod/vod_01_0057.html)。"
        },
        "interval": {
          "type": "integer",
          "description": "截图检测时间间隔,取值范围为[0,100],该参数在请求参数中忽略。"
        },
        "politics": {
          "type": "integer",
          "description": "鉴政内容检测置信度,取值范围为[0,100],该参数在请求参数中忽略。 置信度越高,说明审核结果越可信。未开启或设置为0时,表示未进行此项检测。"
        },
        "terrorism": {
          "type": "integer",
          "description": "鉴恐内容的检测置信度,取值范围为[0,100],该参数在请求参数中忽略。 置信度越高,说明审核结果越可信。未开启或设置为0时,表示未进行此项检测。"
        },
        "porn": {
          "type": "integer",
          "description": "鉴黄内容的检测置信度,取值范围为[0,100],该参数在请求参数中忽略。 置信度越高,说明审核结果越可信。未开启或设置为0时,表示未进行此项检测。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.ap-southeast-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}