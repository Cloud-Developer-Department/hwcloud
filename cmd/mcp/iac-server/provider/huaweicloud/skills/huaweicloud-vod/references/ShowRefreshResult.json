{
  "name": "ShowRefreshResult",
  "summary": "查询CDN刷新",
  "tags": "媒资刷新",
  "productshort": "VOD",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/{project_id}/asset/refresh": {
      "get": {
        "x-publishpath": "vod_04_0120",
        "description": "查询刷新结果。",
        "summary": "查询CDN刷新",
        "operationId": "ShowRefreshResult",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "tags": [
          "媒资刷新"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/usermanual-vod/vod_01_0058.html)",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
            "required": true
          },
          {
            "in": "query",
            "description": "任务ID",
            "name": "task_id",
            "required": true,
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。",
            "schema": {
              "$ref": "#/definitions/QueryRefreshAssetResultRsp"
            },
            "examples": {
              "application/json": {
                "refresh_results": [
                  {
                    "url": "https://example.com/asset/9db42f5e08c15edecd99a98da241994a/313bfd52a75f95ff48e8bf02eca2ab20.flv",
                    "status": "processing"
                  },
                  {
                    "url": "https://example.com/asset/9e455adb02295aa123809e8dc7ca51c1/68b1241af3bf58bcde9914626e07f5af.mp4",
                    "status": "succeed"
                  },
                  {
                    "url": "https://example.com/asset/9e455adb02295aa123809e8dc7ca51c1/play_video/68b1241af3bf58bcde9914626e07f5af_H.264_480X270_HEAACV1_300.mp4",
                    "status": "failed"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "处理失败返回。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "VOD.10053",
                "error_msg": "The request parameter is illegal, illegal field: {xx}."
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/asset/refresh?task_id={task_id}"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "RefreshResult": {
      "properties": {
        "url": {
          "type": "string",
          "description": "刷新URL。"
        },
        "status": {
          "type": "string",
          "description": "刷新任务状态。\n\n取值如下:\n- PROCESSING:处理中\n- SUCCEED:刷新完成\n- FAILED:刷新失败\n",
          "enum": [
            "PROCESSING",
            "SUCCEED",
            "FAILED"
          ]
        }
      }
    },
    "QueryRefreshAssetResultRsp": {
      "properties": {
        "refresh_results": {
          "type": "array",
          "description": "刷新任务结果",
          "items": {
            "$ref": "#/definitions/RefreshResult"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}