{
  "name": "ListAssetDailySummaryLog",
  "summary": "查询媒资日播放统计数据",
  "tags": "统计分析",
  "productshort": "VOD",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/asset/daily-summary": {
      "get": {
        "description": "查询媒资日播放统计数据。\n\n使用媒资日播放统计查询API前,需要先提交工单开通统计功能,才能触发统计任务。\n\n支持查询最近一年的播放统计数据。",
        "summary": "查询媒资日播放统计数据",
        "operationId": "ListAssetDailySummaryLog",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "x-api-type": "open-api",
        "tags": [
          "统计分析"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/usermanual-vod/vod_01_0058.html)",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
            "required": true
          },
          {
            "in": "query",
            "name": "start_time",
            "required": true,
            "pattern": "^[0-9]{8}000000$",
            "type": "string",
            "description": "查询开始时间。仅支持查询一年内的数据,且一次查询的日期跨度不能超过90天。\n\n如果查询指定开始日期的数据,格式为:yyyyMMdd000000。"
          },
          {
            "in": "query",
            "name": "end_time",
            "required": true,
            "pattern": "^[0-9]{8}000000$",
            "type": "string",
            "description": "查询结束时间。仅支持查询一年内的数据,且一次查询的日期跨度不能超过90天。\n\n如果查询指定结束日期的数据,格式为:yyyyMMdd000000。"
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "minimum": 0,
            "maximum": 20000,
            "default": 0,
            "type": "integer",
            "description": "偏移量,表示查询该偏移量后面的记录。\n"
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "minimum": 0,
            "maximum": 100,
            "default": 90,
            "type": "integer",
            "description": "查询返回记录的数量限制。\n"
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。\n",
            "schema": {
              "$ref": "#/definitions/AssetDailySummaryResp"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "summary_results": [
                  {
                    "date": "20231201000000",
                    "link": "http://cdn-log-user-bj4.obs.cn-north-4.myhuaweicloud.com:80/asset-play-summary/05a8aee14d8026a92fcdc018fe235c2c/20231201-asset-play-summary.gz?AccessKeyId=QXBNBGA2GW9EP2XXOYUN&Expires=1701786544&Signature=fJjkLLU1IBeTwANC0U0wUZuzd%2F8%3D"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "处理失败返回。\n",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "VOD.10053",
                "error_msg": "The request parameter is illegal, illegal field: {xx}."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "AssetDailySummaryResult": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "播放日期,格式为:yyyyMMdd000000。\n"
        },
        "link": {
          "type": "string",
          "description": "日播放统计数据文件的下载地址,有效期为12个小时。\n\n文件内容格式:[域名]\\t[媒资ID]\\t[日期]\\t[播放流量]\\t[播放次数]\n\n播放次数统计说明:\n- HLS文件:访问M3U8文件时会统计播放次数,访问TS文件时不会统计播放次数。\n- 其它文件:如MP4文件,当播放请求带有range且range的start参数不等于0时,不统计播放次数。其它情况下,会统计播放次数。"
        }
      }
    },
    "AssetDailySummaryResp": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "description": "记录总数\n"
        },
        "summary_results": {
          "type": "array",
          "description": "日志文件列表\n",
          "items": {
            "$ref": "#/definitions/AssetDailySummaryResult"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}