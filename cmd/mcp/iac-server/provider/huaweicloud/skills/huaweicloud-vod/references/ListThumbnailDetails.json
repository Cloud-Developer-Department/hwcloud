{
  "name": "ListThumbnailDetails",
  "summary": "查询截图详情",
  "tags": "截图管理",
  "productshort": "VOD",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/{project_id}/asset/thumbnail/details": {
      "get": {
        "description": "查询截图结果\n",
        "summary": "查询截图详情",
        "operationId": "ListThumbnailDetails",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-external-api": true,
        "tags": [
          "截图管理"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "name": "project_id",
            "in": "path",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](vod_04_0211.xml)",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "query",
            "name": "task_id",
            "type": "string",
            "description": "截图对应的任务id",
            "minLength": 0,
            "maxLength": 1024,
            "required": true
          },
          {
            "in": "query",
            "name": "offset",
            "type": "integer",
            "description": "查询偏移量。取值范围[0,20480],默认值:0。",
            "minimum": 0,
            "maximum": 20480,
            "default": 0,
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "type": "integer",
            "description": "查询一页返回数。取值范围[1,100],默认值:20。",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。\n",
            "schema": {
              "$ref": "#/definitions/QueryAssetThumbnailDetailRsp"
            }
          },
          "400": {
            "description": "处理失败返回。\n",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "QueryAssetThumbnailDetailRsp": {
      "type": "object",
      "properties": {
        "total": {
          "description": "截图图片总数\n",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647
        },
        "thumbnail_result": {
          "description": "截图结果列表\n",
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/ThumbnailRsp"
          }
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "ThumbnailRsp": {
      "description": "截图结果",
      "type": "object",
      "required": [
        "offset",
        "url"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "description": "截图在视频中的时间偏移,单位为秒。"
        },
        "url": {
          "type": "string",
          "description": "截图访问URL"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}