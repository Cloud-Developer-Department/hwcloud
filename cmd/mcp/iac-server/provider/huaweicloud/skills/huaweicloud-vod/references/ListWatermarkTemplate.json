{
  "name": "ListWatermarkTemplate",
  "summary": "查询水印列表",
  "tags": "水印模板管理",
  "productshort": "VOD",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1.0/{project_id}/template/watermark": {
      "get": {
        "description": "查询水印模板",
        "summary": "查询水印列表",
        "operationId": "ListWatermarkTemplate",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "tags": [
          "水印模板管理"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/usermanual-vod/vod_01_0058.html)",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
            "required": true
          },
          {
            "in": "query",
            "name": "id",
            "type": "array",
            "collectionFormat": "multi",
            "items": {
              "type": "string"
            },
            "required": false,
            "description": "水印模板配置id,一次最多10个。"
          },
          {
            "in": "query",
            "name": "page",
            "type": "integer",
            "format": "int32",
            "required": false,
            "default": 0,
            "description": "分页编号。\n\n默认为0。指定id时该参数无效。"
          },
          {
            "in": "query",
            "name": "size",
            "type": "integer",
            "format": "int32",
            "required": false,
            "default": 10,
            "description": "每页记录数。\n\n默认为10,范围[1,100]。指定id时该参数无效。"
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。",
            "schema": {
              "$ref": "#/definitions/QueryWatermarkTemplateRsp"
            },
            "examples": {
              "application/json": {
                "templates": [
                  {
                    "name": "test",
                    "id": "2305739f855413a84af9e6ad6ebb21be",
                    "status": 0,
                    "dx": "0.05",
                    "dy": "0.05",
                    "position": "TOPRIGHT",
                    "width": "0.12",
                    "height": null,
                    "create_time": "20210204092325",
                    "image_url": "https://103-cn-north-4.cdn-vod.huaweicloud.com/05ab5cef408026f22f62c018de60cf2e/watermark/2305739f855413a84af9e6ad6ebb21be.png",
                    "type": "PNG",
                    "watermark_type": "IMAGE",
                    "image_process": "TRANSPARENT",
                    "timeline_start": null,
                    "timeline_duration": null
                  }
                ],
                "total": 1
              }
            }
          },
          "400": {
            "description": "处理失败返回。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "VOD.10053",
                "error_msg": "The request parameter is illegal, illegal field: {xx}."
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1.0/{project_id}/template/watermark?id={id}"
      }
    }
  },
  "definitions": {
    "QueryWatermarkTemplateRsp": {
      "properties": {
        "templates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WatermarkTemplate"
          },
          "description": "水印模板信息。"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "总数。"
        }
      },
      "description": ""
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "WatermarkTemplate": {
      "properties": {
        "name": {
          "type": "string",
          "description": "水印模板名称。"
        },
        "id": {
          "type": "string",
          "description": "水印模板配置id。"
        },
        "status": {
          "type": "integer",
          "format": "int64",
          "description": "启用状态。\n\n取值为:\n- 0:停用\n- 1:启用"
        },
        "dx": {
          "type": "string",
          "description": "水印图片相对输出视频的水平偏移量。\n\n默认值是0。"
        },
        "dy": {
          "type": "string",
          "description": "水印图片相对输出视频的垂直偏移量。\n\n默认值是0。"
        },
        "position": {
          "type": "string",
          "description": "水印的位置。"
        },
        "width": {
          "type": "string",
          "description": "水印图片宽。"
        },
        "height": {
          "type": "string",
          "description": "水印图片高。"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间。"
        },
        "image_url": {
          "type": "string",
          "description": "水印图片下载url。"
        },
        "type": {
          "type": "string",
          "description": "水印图片格式类型。"
        },
        "watermark_type": {
          "type": "string",
          "description": "水印类型,当前只支持Image(图片水印)。"
        },
        "image_process": {
          "type": "string",
          "description": "type设置为Image时有效。\n\n目前包括:\n- Original:只做简单缩放,不做其他处理\n- Transparent:图片底色透明\n- Grayed:彩色图片变灰"
        },
        "timeline_start": {
          "type": "string",
          "description": "水印开始时间,与\"timeline_duration\"配合使用。\n取值范围:[0, END)。\"END\"表示视频结束时间。\n单位:秒。\n"
        },
        "timeline_duration": {
          "type": "string",
          "description": "水印持续时间,与\"timeline_start\"配合使用。\n取值范围:(0,END-开始时间]。\"END\"表示视频结束时间。\n单位:秒。\n默认:END。\n"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
