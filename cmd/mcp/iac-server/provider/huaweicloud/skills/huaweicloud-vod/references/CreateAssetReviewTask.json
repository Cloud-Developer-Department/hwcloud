          "type": "string",
          "description": "媒资ID"
        },
        "review": {
          "$ref": "#/definitions/Review"
        }
      }
    },
    "AssetReviewReq": {
      "type": "object",
      "required": [
        "asset_id",
        "review"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "description": "媒资ID"
        },
        "review": {
          "$ref": "#/definitions/Review"
        }
      }
    },
    "Review": {
      "description": "媒资审核参数",
      "properties": {
        "template_id": {
          "type": "string",
          "description": "审核模板ID。您可以在视频点播控制台配置审核模板后获取,具体请参见[审核设置](https://support.huaweicloud.com/usermanual-vod/vod_01_0057.html)。"
        },
        "interval": {
          "type": "integer",
          "description": "截图检测时间间隔,取值范围为[0,100],该参数在请求参数中忽略。"
        },
        "politics": {
          "type": "integer",
          "description": "鉴政内容检测置信度,取值范围为[0,100],该参数在请求参数中忽略。 置信度越高,说明审核结果越可信。未开启或设置为0时,表示未进行此项检测。"
        },
        "terrorism": {
          "type": "integer",
          "description": "鉴恐内容的检测置信度,取值范围为[0,100],该参数在请求参数中忽略。 置信度越高,说明审核结果越可信。未开启或设置为0时,表示未进行此项检测。"
        },
        "porn": {
          "type": "integer",
          "description": "鉴黄内容的检测置信度,取值范围为[0,100],该参数在请求参数中忽略。 置信度越高,说明审核结果越可信。未开启或设置为0时,表示未进行此项检测。"
        }
      }
    }
