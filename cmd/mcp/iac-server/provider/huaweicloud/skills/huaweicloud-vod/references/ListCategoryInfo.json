{
  "name": "ListCategoryInfo",
  "summary": "查询指定分类信息",
  "tags": "媒资分类",
  "productshort": "VOD",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/asset/categories": {
      "get": {
        "description": "## 典型场景 ##\n  查询指定分类信息,及其子分类(即下一级分类)的列表。",
        "summary": "查询指定分类信息",
        "operationId": "ListCategoryInfo",
        "x-publishpath": "vod_04_0031",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-external-api": true,
        "tags": [
          "媒资分类"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](vod_04_0211.xml)",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
            "required": true
          },
          {
            "in": "query",
            "description": "视频分类ID,最多支持10个,传0表示查询所有一级分类",
            "name": "id",
            "required": true,
            "type": "array",
            "collectionFormat": "multi",
            "items": {
              "type": "integer"
            },
            "minItems": 1,
            "maxItems": 10
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回",
            "schema": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "description": "分类返回值\n",
              "items": {
                "$ref": "#/definitions/QueryCategoryInfoRsp"
              }
            }
          },
          "400": {
            "description": "处理失败返回。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "QueryCategoryInfoRsp": {
      "type": "object",
      "properties": {
        "id": {
          "description": "查询的分类ID,-1表示默认的其他分类\n",
          "type": "integer",
          "format": "int32",
          "minimum": -1,
          "maximum": 2147483647
        },
        "name": {
          "description": "查询的分类名称\n",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "sub_categories": {
          "description": "子层分类信息\n",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CategoryInfo"
          },
          "minItems": 0,
          "maxItems": 129
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "CategoryInfo": {
      "type": "object",
      "properties": {
        "id": {
          "description": "查询的分类ID\n",
          "type": "integer",
          "format": "int32",
          "minimum": -1,
          "maximum": 2147483647
        },
        "name": {
          "description": "查询的分类名称\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}