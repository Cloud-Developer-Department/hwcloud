{
  "name": "CheckMd5Duplication",
  "summary": "上传检验",
  "tags": "媒资上传",
  "productshort": "VOD",
  "region_id": "cn-north-4",
  "paths": {
    "/v1.0/{project_id}/asset/duplication": {
      "get": {
        "x-publishpath": "vod_04_0050",
        "description": "校验媒资文件是否已存储于视频点播服务中。",
        "summary": "上传检验",
        "operationId": "CheckMd5Duplication",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "tags": [
          "媒资上传"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/usermanual-vod/vod_01_0058.html)",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
            "required": true
          },
          {
            "in": "query",
            "name": "size",
            "type": "integer",
            "format": "int64",
            "description": "文件大小",
            "required": true
          },
          {
            "in": "query",
            "name": "md5",
            "type": "string",
            "description": "文件MD5。\n\n建议参考[上传校验](https://support.huaweicloud.com/api-vod/vod_04_0212.html#vod_04_0212__section575102165412)生成对应的MD5值。",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。",
            "schema": {
              "$ref": "#/definitions/CheckDuplicationRsp"
            },
            "examples": {
              "application/json": {
                "is_duplicated": 1,
                "asset_ids": [
                  "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                ]
              }
            }
          },
          "400": {
            "description": "处理失败返回。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "VOD.10053",
                "error_msg": "The request parameter is illegal, illegal field: {xx}."
              }
            }
          }
        },
        "x-request-examples-url-1": "GET\nhttps://{endpoint}/v1.0/{project_id}/asset/duplication?md5={md5}&size={size}"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "CheckDuplicationRsp": {
      "required": [
        "is_duplicated"
      ],
      "properties": {
        "is_duplicated": {
          "type": "integer",
          "format": "int32",
          "description": "是否重复。\n\n取值如下:\n- 0:表示不重复。\n- 1:表示重复。"
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "重复的媒资ID"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}