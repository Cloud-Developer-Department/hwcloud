{
  "name": "ShowAssetMeta",
  "summary": "查询媒资信息",
  "tags": "媒资管理",
  "productshort": "VOD",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1.0/{project_id}/asset/info": {
      "get": {
        "x-publishpath": "vod_04_0022",
        "x-request-examples-description-1": "单媒资ID查询",
        "x-request-examples-url-2": "GET\n/v1.0/{project_id}/asset/info?asset_id=652c1e4085afeb22fdc256c6757d751b&asset_id=xxxxxx&asset_id=xxxxxx",
        "x-request-examples-description-2": "多媒资ID查询",
        "x-request-examples-url-3": "GET /v1.0/{project_id}/asset/info?start_time=20170725181000&end_time=\n20170726181000&page=0&size=20",
        "x-request-examples-description-3": "按时间段查询",
        "x-request-examples-url-4": "GET /v1.0/{project_id}/asset/info",
        "x-request-examples-description-4": "查询(当前租户下)所有媒资:最近创建的10个,page为默认值0,size为默认值10",
        "x-request-examples-url-5": "GET /v1.0/{project_id}/asset/info?page=1&size=20",
        "x-request-examples-description-5": "查询(当前租户下)所有媒资:最近创建的第21个到第40个",
        "x-request-examples-url-6": "GET /v1.0/{project_id}/asset/info?category_id=100",
        "x-request-examples-description-6": "按分类查询",
        "description": "查询媒资信息,支持指定媒资ID、分类、状态、起止时间查询。",
        "summary": "查询媒资信息",
        "operationId": "ShowAssetMeta",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "tags": [
          "媒资管理"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/usermanual-vod/vod_01_0058.html)",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
            "required": true
          },
          {
            "in": "query",
            "name": "asset_id",
            "type": "array",
            "collectionFormat": "multi",
            "items": {
              "type": "string"
            },
            "required": false,
            "description": "媒资id,最多同时查询10个媒资。"
          },
          {
            "in": "query",
            "name": "status",
            "type": "array",
            "collectionFormat": "multi",
            "items": {
              "type": "string",
              "enum": [
                "UNCREATED",
                "DELETED",
                "CANCELLED",
                "SERVER_ERROR",
                "UPLOAD_FAILED",
                "CREATING",
                "PUBLISHED",
                "WAITING_TRANSCODE",
                "TRANSCODING",
                "TRANSCODE_FAILED",
                "TRANSCODE_SUCCEED",
                "CREATED"
              ]
            },
            "required": false,
            "description": "媒资状态。\n\n取值如下:\n- UNCREATED:未创建(媒资ID不存在 )\n- DELETED:已删除\n- CANCELLED:上传取消\n- SERVER_ERROR:上传失败(点播服务端故障)\n- UPLOAD_FAILED:上传失败(向OBS上传失败)\n- CREATING:创建中\n- PUBLISHED:已发布\n- TRANSCODING:待发布(转码中)\n- TRANSCODE_FAILED:待发布(转码失败)\n- TRANSCODE_SUCCEED:待发布(转码成功)\n- CREATED:待发布(未转码)"
          },
          {
            "in": "query",
            "name": "transcodeStatus",
            "type": "array",
            "collectionFormat": "multi",
            "items": {
              "type": "string",
              "enum": [
                "TRANSCODING",
                "TRANSCODE_FAILED",
                "TRANSCODE_SUCCEED",
                "UN_TRANSCODE",
                "WAITING_TRANSCODE"
              ]
            },
            "required": false,
            "description": "转码状态\n\n取值如下:\n- TRANSCODING:转码中\n- TRANSCODE_FAILED:转码失败\n- TRANSCODE_SUCCEED:转码成功\n- UN_TRANSCODE:未转码\n- WAITING_TRANSCODE:等待转码"
          },
          {
            "in": "query",
            "name": "assetStatus",
            "type": "array",
            "collectionFormat": "multi",
            "items": {
              "type": "string",
              "enum": [
                "PUBLISHED",
                "CREATED"
              ]
            },
            "required": false,
            "description": "媒资状态。\n\n取值如下:\n- PUBLISHED:已发布\n- CREATED:未发布"
          },
          {
            "in": "query",
            "name": "start_time",
            "type": "string",
            "required": false,
            "description": "起始时间,查询指定“**asset_id**”时,该参数无效。\n\n格式为yyyymmddhhmmss。必须是与时区无关的UTC时间。"
          },
          {
            "in": "query",
            "name": "end_time",
            "type": "string",
            "required": false,
            "description": "结束时间,查询指定“**asset_id**”时,该参数无效。\n\n格式为yyyymmddhhmmss。必须是与时区无关的UTC时间。"
          },
          {
            "in": "query",
            "name": "category_id",
            "type": "integer",
            "required": false,
            "description": "分类ID。"
          },
          {
            "in": "query",
            "name": "tags",
            "type": "string",
            "required": false,
            "description": "媒资标签。\n\n单个标签不超过16个字节,最多不超过16个标签。\n\n多个用逗号分隔,UTF8编码。"
          },
          {
            "in": "query",
            "name": "query_string",
            "type": "string",
            "required": false,
            "description": "在媒资标题、描述中模糊查询的字符串。"
          },
          {
            "in": "query",
            "name": "page",
            "type": "integer",
            "required": false,
            "default": 0,
            "minimum": 0,
            "description": "分页编号,查询指定“asset_id”时,该参数无效。\n\n默认值:0。"
          },
          {
            "in": "query",
            "name": "size",
            "description": "每页记录数,查询指定“**asset_id**”时,该参数无效。\n\n取值范围:[1,100]。\n\n默认值:10。",
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。",
            "schema": {
              "$ref": "#/definitions/queryAssetMetaRsp"
            },
            "examples": {
              "application/json": {
                "asset_info_array": [
                  {
                    "asset_id": "652c1e4085afeb22fdc256c6757d751b",
                    "status": "PUBLISHED",
                    "description": "Asset meta is published",
                    "base_info": {
                      "title": "okFLV.flv",
                      "video_name": "okFLV.flv",
                      "description": null,
                      "category_id": -1,
                      "category_name": "其他",
                      "create_time": "20190704144303",
                      "last_modified": "20190704144303",
                      "video_type": "FLV",
                      "tags": null,
                      "meta_data": {
                        "play_type": 0,
                        "pack_type": null,
                        "codec": "H.264",
                        "duration": 244,
                        "duration_ms": 244000,
                        "video_size": 13682041,
                        "width": 512,
                        "hight": 288,
                        "height": 288,
                        "bit_rate": 448,
                        "frame_rate": 30,
                        "quality": null
                      },
                      "video_url": "https://651.cdn-vod.huaweicloud.com/asset/652c1e4085afeb22fdc256c6757d751b/45c2493abe68de3dac7e98b0dadcf8ce.flv",
                      "sign_url": "",
                      "cover_info_array": [
                        {
                          "cover_url": "https://651.cdn-vod.huaweicloud.com/asset/652c1e4085afeb22fdc256c6757d751b/cover/Cover0.jpg"
                        }
                      ],
                      "subtitle_info": [],
                      "source_path": {
                        "bucket": "obs-host",
                        "location": "cn-north-4",
                        "object": "1/okFLV.flv"
                      },
                      "output_path": {
                        "bucket": "obs-host",
                        "location": "cn-north-4",
                        "object": "output/652c1e4085afeb22fdc256c6757d751b/"
                      }
                    },
                    "play_info_array": [
                      {
                        "play_type": "hls",
                        "url": "https://651.cdn-vod.huaweicloud.com/asset/652c1e4085afeb22fdc256c6757d751b/play_video/index.m3u8",
                        "encrypted": 0,
                        "meta_data": {
                          "play_type": 0,
                          "pack_type": null,
                          "codec": "H.264",
                          "duration": 0,
                          "duration_ms": 0,
                          "video_size": 0,
                          "width": 0,
                          "hight": 0,
                          "height": 0,
                          "bit_rate": 0,
                          "frame_rate": 0,
                          "quality": null
                        }
                      },
                      {
                        "play_type": "hls",
                        "url": "https://651.cdn-vod.huaweicloud.com/asset/652c1e4085afeb22fdc256c6757d751b/play_video/b5d498082bbcff7a2055041d803ae2f9_1.m3u8",
                        "encrypted": 0,
                        "meta_data": {
                          "play_type": 0,
                          "pack_type": null,
                          "codec": "H.264",
                          "duration": 205,
                          "duration_ms": 205000,
                          "video_size": 14669824,
                          "width": 512,
                          "hight": 288,
                          "height": 288,
                          "bit_rate": 534,
                          "frame_rate": 0,
                          "quality": null
                        }
                      }
                    ]
                  }
                ],
                "is_truncated": 0,
                "total": 1
              }
            }
          },
          "400": {
            "description": "处理失败返回。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "VOD.10053",
                "error_msg": "The request parameter is illegal, illegal field: {xx}."
              }
            }
          }
        },
        "x-request-examples-url-1": "GET\n/v1.0/{project_id}/asset/info?asset_id=652c1e4085afeb22fdc256c6757d751b"
      }
    }
  },
  "definitions": {
    "PlayInfo": {
      "properties": {
        "play_type": {
          "type": "string",
          "description": "播放协议类型。\n\n取值如下:\n- hls\n- dash\n- mp4"
        },
        "group_id": {
          "type": "string",
          "description": "所属转码组Id"
        },
        "group_name": {
          "type": "string",
          "description": "所属转码组名称"
        },
        "url": {
          "type": "string",
          "description": "播放URL。"
        },
        "encrypted": {
          "type": "integer",
          "description": "标记流是否已被加密。\n\n取值如下:\n- 0:表示未加密。\n- 1:表示已被加密。\n\n默认值:0。"
        },
        "meta_data": {
          "$ref": "#/definitions/MetaData"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "File_addr": {
      "required": [
        "bucket",
        "location",
        "object"
      ],
      "properties": {
        "bucket": {
          "description": "OBS的bucket名称。",
          "type": "string"
        },
        "location": {
          "description": "桶所在的区域名, 如“华北-北京四”的区域名为“cn-north-4”,创建的桶所在区域必须和点播服务所在区域保持一致。",
          "type": "string"
        },
        "object": {
          "description": "文件的存储路径。",
          "type": "string"
        }
      },
      "description": "媒资存储参数信息。"
    },
    "SubtitleInfo": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "字幕文件的下载地址\n"
        },
        "id": {
          "type": "integer",
          "description": "字幕文件id\n"
        },
        "type": {
          "type": "string",
          "description": "字幕文件类型\n"
        },
        "language": {
          "type": "string",
          "description": "字幕文件语言种类\n"
        }
      }
    },
    "BaseInfo": {
      "properties": {
        "title": {
          "type": "string",
          "description": "媒资标题。\n\n长度不超过128个字节,UTF8编码。"
        },
        "video_name": {
          "type": "string",
          "description": "媒资文件名。"
        },
        "description": {
          "type": "string",
          "description": "媒资描述。\n\n长度不超过1024个字节。"
        },
        "category_id": {
          "type": "integer",
          "format": "int64",
          "description": "媒资分类id。"
        },
        "category_name": {
          "type": "string",
          "description": "媒资分类名称。"
        },
        "create_time": {
          "type": "string",
          "description": "媒资创建时间。\n\n格式为yyyymmddhhmmss。必须是与时区无关的UTC时间。"
        },
        "last_modified": {
          "type": "string",
          "description": "媒资最近修改时间。\n\n格式为yyyymmddhhmmss。必须是与时区无关的UTC时间。"
        },
        "video_type": {
          "type": "string",
          "description": "音视频文件类型。\n\n取值如下:\n- 视频文件:MP4、TS、MOV、MXF、MPG、FLV、WMV、AVI、M4V、F4V、MPEG、3GP、ASF、MKV。\n- 音频文件:MP3、OGG、WAV、WMA、APE、FLAC、AAC、AC3、MMF、AMR、M4A、M4R、WV、MP2。"
        },
        "tags": {
          "type": "string",
          "description": "媒资标签。\n\n单个标签不超过16个字节,最多不超过16个标签。\n\n多个用逗号分隔,UTF8编码。"
        },
        "meta_data": {
          "$ref": "#/definitions/MetaData"
        },
        "video_url": {
          "type": "string",
          "description": "原始视频文件的访问地址。"
        },
        "sign_url": {
          "type": "string",
          "description": "原视频文件的OBS临时访问地址,仅媒资详情接口生效"
        },
        "cover_info_array": {
          "type": "array",
          "description": "封面信息。",
          "items": {
            "$ref": "#/definitions/CoverInfo"
          }
        },
        "subtitle_info": {
          "type": "array",
          "x-is_inner_param": true,
          "description": "字幕信息数组",
          "items": {
            "$ref": "#/definitions/SubtitleInfo"
          }
        },
        "source_path": {
          "$ref": "#/definitions/File_addr"
        },
        "output_path": {
          "$ref": "#/definitions/File_addr"
        }
      },
      "description": "媒资基本信息。"
    },
    "MetaData": {
      "properties": {
        "pack_type": {
          "type": "string",
          "description": "视频封装格式。\n\n取值如下:\n- MP4\n- TS\n- MOV\n- MXF\n- MPG\n- FLV\n- WMV\n- MP3\n- WMA\n- APE\n- FLAC\n- AAC\n- AC3\n- MMF\n- AMR\n- M4A\n- M4R\n- OGG\n- WAV\n- WV\n- MP2\n- AVI\n- F4V\n- M4V\n- MPEG\n- HLS\n- DASH",
          "enum": [
            "MP4",
            "TS",
            "MOV",
            "MXF",
            "MPG",
            "FLV",
            "WMV",
            "MP3",
            "WMA",
            "APE",
            "FLAC",
            "AAC",
            "AC3",
            "MMF",
            "AMR",
            "M4A",
            "M4R",
            "OGG",
            "WAV",
            "WV",
            "MP2",
            "AVI",
            "F4V",
            "M4V",
            "MPEG",
            "HLS",
            "DASH"
          ]
        },
        "codec": {
          "type": "string",
          "description": "视频编码格式。\n\n取值如下:\n- MPEG-2\n- MPEG-4\n- H.264\n- H.265\n- WMV\n- Vorbis\n- AAC\n- AC-3\n- AMR\n- APE\n- FLAC\n- MP3\n- MP2\n- WMA\n- PCM\n- ADPCM\n- WavPack",
          "enum": [
            "MPEG-2",
            "MPEG-4",
            "H.264",
            "H.265",
            "WMV",
            "Vorbis",
            "AAC",
            "EAC-3",
            "AC-3",
            "AMR",
            "APE",
            "FLAC",
            "MP3",
            "MP2",
            "WMA",
            "PCM",
            "ADPCM",
            "WavPack",
            "HEAAC",
            "UNKNOWN"
          ]
        },
        "duration": {
          "type": "integer",
          "format": "int64",
          "description": "视频时长,单位:秒。\n\n若视频的原时长为非整数,则该字段值为原时长的向下取整。\n若视频的原时长小于1,则该字段值为1。"
        },
        "duration_ms": {
          "type": "integer",
          "format": "int64",
          "description": "视频时长,单位毫秒。"
        },
        "video_size": {
          "type": "integer",
          "format": "int64",
          "description": "视频文件大小。\n\n单位:字节。"
        },
        "width": {
          "type": "integer",
          "format": "int64",
          "description": "视频宽度(单位:像素)。\n- 编码为H.264的取值范围:[32,3840]之间2的倍数。\n- 编码为H.265的取值范围:[320,3840]之间4的倍数。"
        },
        "hight": {
          "type": "integer",
          "format": "int64",
          "description": "视频高度(单位:像素)。该字段会逐渐废弃,请使用height字段。\n- 编码为H.264的取值范围:[32,2160]之间2的倍数 。\n- 编码为H.265的取值范围:[240,2160]之间4的倍数。"
        },
        "height": {
          "type": "integer",
          "format": "int64",
          "description": "视频高度(单位:像素)。\n- 编码为H.264的取值范围:[32,2160]之间2的倍数 。\n- 编码为H.265的取值范围:[240,2160]之间4的倍数。"
        },
        "bit_rate": {
          "type": "integer",
          "format": "int64",
          "description": "视频平均码率。"
        },
        "frame_rate": {
          "type": "integer",
          "format": "int64",
          "description": "帧率(单位:帧每秒)。\n\n取值如下:\n- FRAMERATE_AUTO = 1,\n- FRAMERATE_10 = 2,\n- FRAMERATE_15 = 3,\n- FRAMERATE_2397 = 4, // 23.97 fps\n- FRAMERATE_24 = 5,\n- FRAMERATE_25 = 6,\n- FRAMERATE_2997 = 7, // 29.97 fps\n- FRAMERATE_30 = 8,\n- FRAMERATE_50 = 9,\n- FRAMERATE_60 = 10\n\n默认值:1。\n\n单位:帧每秒。"
        },
        "quality": {
          "type": "string",
          "description": "清晰度。\n\n取值如下:\n- FULL_HD:超高清\n- HD:高清\n- SD:标清\n- FLUENT:流畅\n- AD:自适应\n- 2K\n- 4K"
        },
        "audio_channels": {
          "type": "integer",
          "format": "int32",
          "description": "音频的声道数。"
        }
      },
      "description": "视频的元数据信息。\n\n经过视频解析后产生,包括封装格式、大小、分辨率、码率、帧率。"
    },
    "CoverInfo": {
      "properties": {
        "cover_url": {
          "type": "string",
          "description": "封面文件的下载地址。"
        }
      },
      "description": "封面信息。"
    },
    "queryAssetMetaRsp": {
      "properties": {
        "asset_info_array": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AssetInfo"
          },
          "description": "媒资信息列表。"
        },
        "is_truncated": {
          "type": "integer",
          "description": "列表是否被截断。\n\n取值如下:\n- 1:表示本次查询未返回全部结果。\n- 0:表示本次查询已经返回了全部结果。"
        },
        "total": {
          "type": "integer",
          "description": "查询媒资总数。\n\n>\n暂只能统计2万个媒资,若您需要查询具体的媒资总数,请[提交工单](https://console.huaweicloud.com/ticket/?#/ticketindex/business?productTypeId=462902cc39a04ab3a429df872021f970)申请。"
        }
      }
    },
    "AssetInfo": {
      "properties": {
        "asset_id": {
          "type": "string",
          "description": "媒资ID。"
        },
        "status": {
