    "UpdateStorageModeReq": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "required": [
        "asset_id",
        "storage_mode"
      ],
      "properties": {
        "asset_id": {
          "description": "原媒资id\n",
          "type": "string"
        },
        "storage_mode": {
          "type": "string",
          "description": "存储模式。\n取值如下:\n- STANDARD:标准存储。\n- WARM:低频存储。\n- COLD:归档存储。\n",
          "enum": [
            "STANDARD",
            "WARM",
            "COLD"
          ]
        },
        "restore_mode": {
          "type": "string",
          "description": "归档恢复方式。\n取值如下:\n- TEMP:临时\n- FOREVER:永久\n",
          "enum": [
            "TEMP",
            "FOREVER"
          ]
        },
        "days": {
          "type": "integer",
          "format": "int32",
          "description": "从归档转标准存储且选择临时恢复时临时恢复时间。\n",
          "default": 1,
          "minimum": 1,
          "maximum": 30
        },
        "restore_tier": {
          "type": "string",
          "description": "归档恢复选项,快速恢复EXPEDITED,标准恢复STANDARD,默认快速恢复\n",
          "enum": [
            "EXPEDITED",
            "STANDARD"
          ]
        }
      }
    },
    "UpdateStorageModeRsp": {
      "x-since": "1.0.0",
      "x-modifier-memo": "add",
      "type": "object",
      "properties": {
