  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "QualityInfo": {
      "required": [
        "format"
      ],
      "properties": {
        "video": {
          "$ref": "#/definitions/VideoTemplateInfo"
        },
        "audio": {
          "$ref": "#/definitions/AudioTemplateInfo"
        },
        "format": {
          "type": "string",
          "description": "格式。",
          "enum": [
            "MP4",
            "HLS",
            "DASH",
            "DASH_HLS",
            "MP3",
            "ADTS",
            "UNKNOW"
          ]
        }
      },
      "description": ""
    },
    "VideoTemplateInfo": {
      "x-imports": "org.hibernate.validator.constraints.*;",
      "required": [
        "quality"
      ],
      "properties": {
        "quality": {
          "type": "string",
          "description": "画质。",
          "enum": [
            "FULL_HD",
            "HD",
            "SD",
            "FLUENT",
            "AD",
            "2K",
            "4K",
            "UNKNOW"
          ]
        },
        "width": {
          "description": "视频宽度。",
          "type": "integer"
        },
        "height": {
          "description": "视频高度。",
          "type": "integer"
        },
        "bitrate": {
          "description": "码率。",
          "type": "integer"
        },
        "frame_rate": {
          "description": "帧率(默认为1,1代表自适应,单位是帧每秒)。",
          "type": "integer"
        }
      },
      "description": "模板视频信息"
    },
    "Common": {
      "x-imports": "org.hibernate.validator.constraints.*;",
      "required": [
        "pvc"
      ],
      "properties": {
        "pvc": {
          "type": "string",
          "description": "高清低码开关。",
          "enum": [
            "0",
            "1",
            "2",
            "UNKNOW"
          ]
        },
        "pvc_version": {
          "type": "string",
          "description": "高清低码版本。"
        },
        "video_codec": {
          "type": "string",
          "description": "视频编码格式。",
          "enum": [
            "H264",
            "H265",
            "UNKNOW"
          ]
        },
        "audio_codec": {
          "description": "音频编码格式(有效值范围)\n- 1:AUDIO_CODECTYPE_AAC\n- 2:AUDIO_CODECTYPE_HEAAC1\n- 3:AUDIO_CODECTYPE_HEAAC2\n- 4:AUDIO_CODECTYPE_MP3\n\n默认值为1。",
          "type": "string",
          "format": "int32",
          "enum": [
            "AAC",
            "HEAAC1",
            "HEAAC2",
            "MP3"
          ]
        },
        "hls_interval": {
          "description": "分片时长(默认为5秒)。",
          "type": "integer"
        }
      },
      "description": "模板信息。"
    },
    "AudioTemplateInfo": {
      "x-imports": "org.hibernate.validator.constraints.*;",
      "required": [
        "sample_rate",
        "channels"
      ],
      "properties": {
        "sample_rate": {
          "description": "音频采样率(有效值范围)\n- 1:AUDIO_SAMPLE_AUTO\n- 2:AUDIO_SAMPLE_22050\n- 3:AUDIO_SAMPLE_32000\n- 4:AUDIO_SAMPLE_44100\n- 5:AUDIO_SAMPLE_48000\n- 6:AUDIO_SAMPLE_96000\n\n默认值为1。",
          "type": "integer",
          "format": "int32",
          "x-annotations": [
            "@Range(min = 1, max = 6)"
          ]
        },
        "bitrate": {
          "description": "音频码率(单位:Kbps)。",
          "type": "integer",
          "format": "int32"
        },
        "channels": {
          "description": "声道数(有效值范围)\n- 1:AUDIO_CHANNELS_1\n- 2:AUDIO_CHANNELS_2",
          "type": "integer",
          "format": "int32",
          "x-annotations": [
            "@Range(min = 1, max = 2)"
          ]
        }
      },
      "description": "模板音频信息"
    },
    "TransTemplateGroup": {
      "x-imports": "javax.validation.constraints.NotEmpty;",
      "properties": {
        "name": {
          "type": "string",
          "description": "模板组名称。",
          "maxLength": 128,
          "minLength": 1,
          "x-annotations": [
            "@NotEmpty"
          ]
        },
        "status": {
          "type": "string",
          "description": "是否设置默认。",
          "x-annotations": [
            "@NotNull"
          ],
          "default": "0",
          "enum": [
            "1",
            "0"
          ]
        },
        "type": {
          "type": "string",
          "description": "模板组类型。",
          "x-annotations": [
            "@NotNull"
          ],
          "enum": [
            "custom_template_group"
          ]
        },
        "auto_encrypt": {
          "type": "integer",
          "description": "是否自动加密。\n\n取值如下:\n- 0:表示不加密。\n- 1:表示需要加密。\n\n默认值:0。\n\n加密与转码必须要一起进行,当需要加密时,转码参数不能为空,且转码输出格式必须要为HLS。",
          "default": 0
        },
        "quality_info_list": {
          "type": "array",
          "description": "画质配置信息列表。",
          "x-annotations": [
            "@NotNull"
          ],
          "items": {
            "$ref": "#/definitions/QualityInfo"
          }
        },
        "common": {
          "$ref": "#/definitions/Common"
        },
        "watermark_template_ids": {
          "x-annotations": [
            "@Size(max = 1)"
          ],
          "type": "array",
          "description": "绑定的水印模板组ID数组。",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "description": "模板介绍。",
          "maxLength": 256
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "CreateTemplateGroupRsp": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string",
          "description": "模板组ID<br/>\n"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
