        },
        "description": "将媒资设置为发布状态。支持批量发布。",
        "summary": "媒资发布",
        "operationId": "PublishAssets",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "tags": [
          "媒资管理"
        ],
