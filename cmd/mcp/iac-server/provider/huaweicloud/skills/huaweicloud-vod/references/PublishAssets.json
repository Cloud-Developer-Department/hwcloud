                    "description": "Asset meta download fail, errorCode is VOD.100021010,\nerrorMag is Internal server communication is abnormal",
                    "base_info": {
                      "title": "Avatar test test",
                      "video_name": "Avatar_480P.mp4",
                      "description": "Avatar, test",
                      "category_id": -1,
                      "category_name": "其他",
                      "create_time": "20180209024019",
                      "last_modified": "20180209024019",
                      "video_type": "MP4",
                      "tags": "mytags"
                    }
                  },
                  {
                    "asset_id": "07ba4d46463355e800c2f42f628f0631",
                    "status": " UNCREATED",
                    "description": "no asset"
                  }
                ]
              }
            }
          },
          "403": {
            "description": "处理失败返回。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "VOD.10062",
                "error_msg": "Media asset or resource does not exist, please check."
              }
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v1.0/{project_id}/asset/status/publish",
        "x-request-examples-1": {
          "asset_id": [
            "f488337c31c8e4622f1590735b134c65",
            "07ba4d46463355e800c2f42f628f0631"
          ]
        }
      }
    }
  },
  "definitions": {
    "PlayInfo": {
      "properties": {
        "play_type": {
          "type": "string",
          "description": "播放协议类型。\n\n取值如下:\n- hls\n- dash\n- mp4"
        },
        "group_id": {
          "type": "string",
          "description": "所属转码组Id"
        },
        "group_name": {
          "type": "string",
          "description": "所属转码组名称"
        },
        "url": {
          "type": "string",
          "description": "播放URL。"
        },
        "encrypted": {
          "type": "integer",
          "description": "标记流是否已被加密。\n\n取值如下:\n- 0:表示未加密。\n- 1:表示已被加密。\n\n默认值:0。"
        },
        "meta_data": {
          "$ref": "#/definitions/MetaData"
        }
      }
    },
    "PublishAssetReq": {
      "required": [
        "asset_id"
      ],
      "properties": {
        "asset_id": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "媒资ID。"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "File_addr": {
      "required": [
        "bucket",
        "location",
        "object"
      ],
      "properties": {
        "bucket": {
          "description": "OBS的bucket名称。",
          "type": "string"
        },
        "location": {
          "description": "桶所在的区域名, 如“华北-北京四”的区域名为“cn-north-4”,创建的桶所在区域必须和点播服务所在区域保持一致。",
          "type": "string"
        },
        "object": {
          "description": "文件的存储路径。",
          "type": "string"
        }
      },
      "description": "媒资存储参数信息。"
    },
    "SubtitleInfo": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "字幕文件的下载地址\n"
        },
        "id": {
          "type": "integer",
          "description": "字幕文件id\n"
        },
        "type": {
          "type": "string",
          "description": "字幕文件类型\n"
        },
        "language": {
          "type": "string",
          "description": "字幕文件语言种类\n"
        }
      }
    },
    "PublishAssetsRsp": {
      "properties": {
        "asset_info_array": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AssetInfo"
          },
          "description": "发布的媒资信息。"
        }
      }
    },
    "BaseInfo": {
      "properties": {
        "title": {
          "type": "string",
          "description": "媒资标题。\n\n长度不超过128个字节,UTF8编码。"
        },
        "video_name": {
          "type": "string",
          "description": "媒资文件名。"
        },
        "description": {
          "type": "string",
          "description": "媒资描述。\n\n长度不超过1024个字节。"
        },
        "category_id": {
          "type": "integer",
          "format": "int64",
          "description": "媒资分类id。"
        },
        "category_name": {
          "type": "string",
          "description": "媒资分类名称。"
        },
        "create_time": {
          "type": "string",
          "description": "媒资创建时间。\n\n格式为yyyymmddhhmmss。必须是与时区无关的UTC时间。"
        },
        "last_modified": {
          "type": "string",
          "description": "媒资最近修改时间。\n\n格式为yyyymmddhhmmss。必须是与时区无关的UTC时间。"
        },
        "video_type": {
          "type": "string",
          "description": "音视频文件类型。\n\n取值如下:\n- 视频文件:MP4、TS、MOV、MXF、MPG、FLV、WMV、AVI、M4V、F4V、MPEG、3GP、ASF、MKV。\n- 音频文件:MP3、OGG、WAV、WMA、APE、FLAC、AAC、AC3、MMF、AMR、M4A、M4R、WV、MP2。"
        },
        "tags": {
          "type": "string",
          "description": "媒资标签。\n\n单个标签不超过16个字节,最多不超过16个标签。\n\n多个用逗号分隔,UTF8编码。"
        },
        "meta_data": {
          "$ref": "#/definitions/MetaData"
        },
        "video_url": {
          "type": "string",
          "description": "原始视频文件的访问地址。"
        },
        "sign_url": {
          "type": "string",
          "description": "原视频文件的OBS临时访问地址,仅媒资详情接口生效"
        },
        "cover_info_array": {
          "type": "array",
          "description": "封面信息。",
          "items": {
            "$ref": "#/definitions/CoverInfo"
          }
        },
        "subtitle_info": {
          "type": "array",
          "x-is_inner_param": true,
          "description": "字幕信息数组",
          "items": {
            "$ref": "#/definitions/SubtitleInfo"
          }
        },
        "source_path": {
          "$ref": "#/definitions/File_addr"
        },
        "output_path": {
          "$ref": "#/definitions/File_addr"
        }
      },
      "description": "媒资基本信息。"
    },
    "MetaData": {
      "properties": {
        "pack_type": {
          "type": "string",
          "description": "视频封装格式。\n\n取值如下:\n- MP4\n- TS\n- MOV\n- MXF\n- MPG\n- FLV\n- WMV\n- MP3\n- WMA\n- APE\n- FLAC\n- AAC\n- AC3\n- MMF\n- AMR\n- M4A\n- M4R\n- OGG\n- WAV\n- WV\n- MP2\n- AVI\n- F4V\n- M4V\n- MPEG\n- HLS\n- DASH",
          "enum": [
            "MP4",
            "TS",
            "MOV",
            "MXF",
            "MPG",
            "FLV",
            "WMV",
            "MP3",
            "WMA",
            "APE",
            "FLAC",
            "AAC",
            "AC3",
            "MMF",
            "AMR",
            "M4A",
            "M4R",
            "OGG",
            "WAV",
            "WV",
            "MP2",
            "AVI",
            "F4V",
            "M4V",
            "MPEG",
            "HLS",
            "DASH"
          ]
        },
        "codec": {
          "type": "string",
          "description": "视频编码格式。\n\n取值如下:\n- MPEG-2\n- MPEG-4\n- H.264\n- H.265\n- WMV\n- Vorbis\n- AAC\n- AC-3\n- AMR\n- APE\n- FLAC\n- MP3\n- MP2\n- WMA\n- PCM\n- ADPCM\n- WavPack",
          "enum": [
            "MPEG-2",
            "MPEG-4",
            "H.264",
            "H.265",
            "WMV",
            "Vorbis",
            "AAC",
            "EAC-3",
            "AC-3",
            "AMR",
            "APE",
            "FLAC",
            "MP3",
            "MP2",
            "WMA",
            "PCM",
            "ADPCM",
            "WavPack",
            "HEAAC",
            "UNKNOWN"
          ]
        },
        "duration": {
          "type": "integer",
          "format": "int64",
          "description": "视频时长,单位:秒。\n\n若视频的原时长为非整数,则该字段值为原时长的向下取整。\n若视频的原时长小于1,则该字段值为1。"
        },
        "duration_ms": {
          "type": "integer",
          "format": "int64",
          "description": "视频时长,单位毫秒。"
        },
        "video_size": {
          "type": "integer",
          "format": "int64",
          "description": "视频文件大小。\n\n单位:字节。"
        },
        "width": {
          "type": "integer",
          "format": "int64",
          "description": "视频宽度(单位:像素)。\n- 编码为H.264的取值范围:[32,3840]之间2的倍数。\n- 编码为H.265的取值范围:[320,3840]之间4的倍数。"
        },
        "hight": {
          "type": "integer",
          "format": "int64",
          "description": "视频高度(单位:像素)。该字段会逐渐废弃,请使用height字段。\n- 编码为H.264的取值范围:[32,2160]之间2的倍数 。\n- 编码为H.265的取值范围:[240,2160]之间4的倍数。"
        },
        "height": {
          "type": "integer",
          "format": "int64",
          "description": "视频高度(单位:像素)。\n- 编码为H.264的取值范围:[32,2160]之间2的倍数 。\n- 编码为H.265的取值范围:[240,2160]之间4的倍数。"
        },
        "bit_rate": {
          "type": "integer",
          "format": "int64",
          "description": "视频平均码率。"
        },
        "frame_rate": {
          "type": "integer",
          "format": "int64",
          "description": "帧率(单位:帧每秒)。\n\n取值如下:\n- FRAMERATE_AUTO = 1,\n- FRAMERATE_10 = 2,\n- FRAMERATE_15 = 3,\n- FRAMERATE_2397 = 4, // 23.97 fps\n- FRAMERATE_24 = 5,\n- FRAMERATE_25 = 6,\n- FRAMERATE_2997 = 7, // 29.97 fps\n- FRAMERATE_30 = 8,\n- FRAMERATE_50 = 9,\n- FRAMERATE_60 = 10\n\n默认值:1。\n\n单位:帧每秒。"
        },
        "quality": {
          "type": "string",
          "description": "清晰度。\n\n取值如下:\n- FULL_HD:超高清\n- HD:高清\n- SD:标清\n- FLUENT:流畅\n- AD:自适应\n- 2K\n- 4K"
        },
        "audio_channels": {
          "type": "integer",
          "format": "int32",
          "description": "音频的声道数。"
        }
      },
      "description": "视频的元数据信息。\n\n经过视频解析后产生,包括封装格式、大小、分辨率、码率、帧率。"
    },
    "CoverInfo": {
      "properties": {
        "cover_url": {
          "type": "string",
          "description": "封面文件的下载地址。"
        }
      },
      "description": "封面信息。"
    },
    "AssetInfo": {
      "properties": {
        "asset_id": {
          "type": "string",
          "description": "媒资ID。"
        },
        "status": {
          "description": "媒资状态。\n\n取值如下:\n- UNCREATED:未创建(媒资ID不存在 )\n- DELETED:已删除\n- CANCELLED:上传取消\n- SERVER_ERROR:上传失败(点播服务端故障)\n- UPLOAD_FAILED:上传失败(向OBS上传失败)\n- CREATING:创建中\n- PUBLISHED:已发布\n- WAITING_TRANSCODE:待发布(转码排队中)\n- TRANSCODING:待发布(转码中)\n- TRANSCODE_FAILED:待发布(转码失败)\n- TRANSCODE_SUCCEED:待发布(转码成功)\n- CREATED:待发布(未转码)\n- NO_ASSET:该媒资不存在\n- DELETING:正在删除\n- DELETE_FAILED:删除失败\n- OBS_CREATING:OBS转存方式创建中\n- OBS_CREATE_FAILED: OBS转存失败\n- OBS_CREATE_SUCCESS: OBS转存成功",
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "媒资子状态或描述信息。\n- 对于媒资异常场景,描述具体的异常原因。\n- 对于正常场景,描述媒资的处理信息。"
        },
        "is_multi_transcode": {
          "type": "boolean",
          "description": "是否是多转码模式\n",
          "default": false
        },
        "base_info": {
          "$ref": "#/definitions/BaseInfo"
        },
        "play_info_array": {
          "type": "array",
          "description": "转码文件的播放信息。\n- HLS或DASH:此数组的成员个数为n+1,n为转码输出路数。\n- MP4:此数组的成员个数为n,n为转码输出路数。",
          "items": {
            "$ref": "#/definitions/PlayInfo"
          }
        }
      },
      "description": ""
    }
  },
