{
  "name": "ShowHttpsConfig",
  "summary": "查询https配置",
  "tags": "Https配置",
  "productshort": "VOD",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1.0/{project_id}/asset/domain/https": {
      "get": {
        "description": "查询证书配置",
        "summary": "查询https配置",
        "operationId": "ShowHttpsConfig",
        "tags": [
          "Https配置"
        ],
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID",
            "required": true
          },
          {
            "in": "query",
            "name": "domain",
            "type": "string",
            "required": true,
            "description": "加速域名"
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。",
            "schema": {
              "$ref": "#/definitions/QueryCdnHttpsRsp"
            }
          },
          "400": {
            "description": "处理失败返回。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "QueryCdnHttpsRsp": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "来源,user表示用户自己上传,scm表示scm证书\n",
          "maxLength": 64,
          "minLength": 0
        },
        "cert_name": {
          "type": "string",
          "description": "证书名称\n",
          "minLength": 3,
          "maxLength": 64
        },
        "cert_id": {
          "type": "string",
          "description": "证书id\n",
          "maxLength": 16,
          "minLength": 16
        },
        "https_status": {
          "type": "integer",
          "description": "https配置\n",
          "minimum": 0,
          "maximum": 1
        },
        "certificate": {
          "type": "string",
          "description": "证书内容\n",
          "maxLength": 10240,
          "minLength": 0
        },
        "force_redirect_https": {
          "type": "integer",
          "description": "客户端请求是否强制重定向,0表示不重定向,1表示重定向\n",
          "minimum": 0,
          "maximum": 1
        },
        "http2": {
          "type": "integer",
          "description": "是否使用HTTP2.0,0表示不使用HTTP2.0,1表示使用\n",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}