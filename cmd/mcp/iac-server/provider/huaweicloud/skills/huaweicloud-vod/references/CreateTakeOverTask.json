          "object": "1/Shoushu_FLV.flv",
          "suffix": [],
          "template_group_name": "original_template_group",
          "host_type": 1,
          "output_bucket": "obs-gg",
          "output_path": "ouput/"
        },
        "description": "通过存量托管的方式,将已存储在OBS桶中的音视频文件同步到点播服务。\n\nOBS托管方式分为增量托管和存量托管,增量托管暂只支持通过视频点播控制台配置,配置后,若OBS有新增音视频文件,则会自动同步到点播服务中,具体请参见[增量托管](https://support.huaweicloud.com/usermanual-vod/vod010032.html)。两个托管方式都需要先将对应的OBS桶授权给点播服务,具体请参见[桶授权](https://support.huaweicloud.com/usermanual-vod/vod010031.html)。",
        "summary": "创建媒资:OBS托管方式",
        "operationId": "CreateTakeOverTask",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "tags": [
          "媒资上传"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/usermanual-vod/vod_01_0058.html)",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
            "required": true
          },
          {
            "in": "body",
            "name": "CreateTakeOverTaskReq",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateTakeOverTaskReq"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "处理成功返回",
            "schema": {
              "$ref": "#/definitions/CreateTakeOverTaskRsp"
            },
            "examples": {
              "application/json": {
                "task_id": "456"
              }
            }
          },
          "403": {
            "description": "处理失败返回。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "VOD.10053",
                "error_msg": "The request parameter is illegal, illegal field: {xx}."
              }
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v1.0/{project_id}/asset/obs/host/stock/task",
        "x-request-examples-1": {
          "bucket": "obs-gg",
          "object": "1/Shoushu_FLV.flv",
          "suffix": [],
          "template_group_name": "original_template_group",
          "host_type": 1,
          "output_bucket": "obs-gg",
          "output_path": "ouput/"
        }
