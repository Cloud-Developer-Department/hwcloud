  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "CreateTakeOverTaskReq": {
      "required": [
        "bucket",
        "object"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "description": "源桶名。"
        },
        "object": {
          "type": "string",
          "description": "源目录名或源文件名。"
        },
        "suffix": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "批量托管时的文件后缀名列表。不传或传空值时,表示托管所有音视频文件,不进行后缀名过滤。"
        },
        "template_group_name": {
          "type": "string",
          "description": "转码模板组名称。\n\n若不为空,则使用指定的转码模板对上传的音视频进行转码,您可以在视频点播控制台配置转码模板,具体请参见转码设置。\n\n>\n若同时设置了“**template_group_name**”和“**workflow_name**”字段,则“**template_group_name**”字段生效。"
        },
        "workflow_name": {
          "type": "string",
          "description": "工作流名称。\n\n若不为空,则使用指定的工作流对上传的音视频进行处理,您可以在视频点播控制台配置工作流,具体请参见[工作流设置](https://support.huaweicloud.com/usermanual-vod/vod010041.html)。"
        },
        "host_type": {
          "type": "integer",
          "description": "表示音视频处理后生成的媒资文件所存储的位置类型。\n\n取值如下所示:\n- 0:表示存储到点播桶。\n- 1:表示存储在租户桶。\n- 2:表示存储到租户桶,并且存储路径与源文件一致。",
          "default": 0
        },
        "output_bucket": {
          "type": "string",
          "description": "输出桶名,host_type为1时必选"
        },
        "output_path": {
          "type": "string",
          "description": "输出路径名,host_type为1时必选"
        }
      }
    },
    "CreateTakeOverTaskRsp": {
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务ID。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
