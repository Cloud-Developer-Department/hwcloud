{
  "name": "CreateTakeOverTask",
  "summary": "创建媒资:OBS托管方式",
  "tags": "媒资上传",
  "productshort": "VOD",
  "region_id": "cn-north-1",
  "paths": {
    "/v1.0/{project_id}/asset/obs/host/stock/task": {
      "post": {
        "x-publishpath": "vod_04_0051",
        "x-request-examples-text-1": {
