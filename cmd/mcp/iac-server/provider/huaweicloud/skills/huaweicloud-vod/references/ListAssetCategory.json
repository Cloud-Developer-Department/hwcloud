{
  "name": "ListAssetCategory",
  "summary": "查询指定分类信息",
  "tags": "媒资分类",
  "productshort": "VOD",
  "region_id": "cn-north-1",
  "paths": {
    "/v1.0/{project_id}/asset/category": {
      "get": {
        "x-publishpath": "vod_04_0031",
        "description": "查询指定分类信息,及其子分类(即下一级分类)的列表。",
        "summary": "查询指定分类信息",
        "operationId": "ListAssetCategory",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "tags": [
          "媒资分类"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/usermanual-vod/vod_01_0058.html)",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
            "required": true
          },
          {
            "in": "query",
            "description": "视频分类ID。\n\n若设置为0,则查询所有一级分类。",
            "name": "id",
            "required": true,
            "type": "integer",
            "minimum": 0
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。",
            "schema": {
              "type": "array",
              "description": "分类返回值",
              "items": {
                "$ref": "#/definitions/QueryCategoryRsp"
              }
            },
            "examples": {
              "application/json": [
                {
                  "id": "334",
                  "name": "电影",
                  "children": [
                    {
                      "id": "335",
                      "name": "电视",
                      "children": []
                    }
                  ]
                }
              ]
            }
          },
          "400": {
            "description": "处理失败返回。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "VOD.10053",
                "error_msg": "The request parameter is illegal, illegal field: {xx}."
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1.0/{project_id}/asset/category?id={id}"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "QueryCategoryRsp": {
      "properties": {
        "id": {
          "type": "string",
          "description": "分类ID。"
        },
        "name": {
          "type": "string",
          "description": "分类名称。"
        },
        "children": {
          "type": "array",
          "description": "子分类列表。",
          "items": {
            "$ref": "#/definitions/QueryCategoryRsp"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
