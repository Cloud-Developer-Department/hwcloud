  "definitions": {
    "ReviewInfo": {
      "description": "审核信息数组。\n\n> 仅当审核成功后才能查询到此信息,未审核、正在审核以及审核失败时,无此字段信息。",
      "required": [
        "review_status"
      ],
      "properties": {
        "suggestion": {
          "type": "string",
          "description": "检测结果是否通过。\n\n取值如下:\n- block:包含敏感信息,不通过。\n- pass:不包含敏感信息,通过。\n- review:需要人工复检。\n\n>\n当同时检测多个场景时,suggestion的值以最可能包含敏感信息的场景为准。即任一场景出现了block则总的suggestion为block,所有场景都pass时suggestion为pass,这两种情况之外则一定有场景需要review,此时suggestion为review。",
          "enum": [
            "block",
            "pass",
            "review"
          ]
        },
        "text": {
          "$ref": "#/definitions/TextReviewRet"
        },
        "cover": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PictureReviewRet"
          },
          "description": "封面检测结果。"
        },
        "video": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PictureReviewRet"
          },
          "description": "视频检测结果。"
        },
        "exec_desc": {
          "type": "string",
          "description": "执行情况描述。"
        },
        "review_status": {
          "type": "string",
          "description": "审核状态。\n\n取值如下:\n- UN_REVIEW:未审核\n- REVIEWING:审核中\n- REVIEW_SUSPICIOUS:审核可疑,需要人工审核\n- REVIEW_PASSED:审核通过\n- REVIEW_FAILED:审核失败。\n- REVIEW_BLOCKED:已屏蔽。"
        }
      }
    },
    "Output": {
      "description": "转码输出数组。\n- HLS或DASH格式:此数组的成员个数为n+1,n为转码输出路数。\n- MP4格式:此数组的成员个数为n,n为转码输出路数。",
      "required": [
        "play_type",
        "url",
        "meta_data"
      ],
      "properties": {
        "play_type": {
          "description": "协议类型。\n\n取值如下:\n- hls\n- dash\n- mp4",
          "type": "string",
          "enum": [
            "HLS",
            "DASH",
            "MP4",
            "MP3",
            "AAC"
          ]
        },
        "url": {
          "description": "播放URL。",
          "type": "string"
        },
        "group_id": {
          "type": "string",
          "description": "所属转码组Id"
        },
        "group_name": {
          "type": "string",
          "description": "所属转码组名称"
        },
        "encrypted": {
          "description": "标记流是否已被加密。\n\n取值如下:\n- 0:表示未加密。\n- 1:表示已被加密。",
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "quality": {
          "type": "string",
          "description": "清晰度。\n\n取值如下:\n- FLUENT:流畅\n- SD:标清\n- HD:高清\n- FULL_HD:超清",
          "enum": [
            "FLUENT",
            "SD",
            "HD",
            "FULL_HD"
          ]
        },
        "meta_data": {
          "$ref": "#/definitions/MetaData"
        }
      }
    },
    "ThumbnailInfo": {
      "description": "截图信息。\n\n> 仅当截图成功后才能查询到此信息,未截图、正在截图以及截图失败时,无此字段信息。",
      "properties": {
        "sample": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ThumbnailRsp"
          },
          "description": "视频截图信息。"
        },
        "dots": {
          "type": "array",
          "x-is_inner_param": true,
          "items": {
            "$ref": "#/definitions/ThumbnailRsp"
          }
        },
        "quantity": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ThumbnailRsp"
          },
          "description": "视频截图信息,截图类型为数量。"
        },
        "exec_desc": {
          "type": "string",
          "description": "执行情况描述。"
        },
        "thumbnail_status": {
          "type": "string",
          "description": "截图状态。\n\n取值如下:\n- UN_THUMBNAIL:未截图\n- THUMBNAILING:截图中\n- THUMBNAIL_SUCCEED:截图成功\n- THUMBNAIL_FAILED:截图失败"
        }
      }
    },
    "QueryAssetDetailRsp": {
      "required": [
        "asset_id"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "description": "媒资ID。"
        },
        "base_info": {
          "$ref": "#/definitions/BaseInfo"
        },
        "transcode_info": {
          "$ref": "#/definitions/TranscodeInfo"
        },
        "thumbnail_info": {
          "$ref": "#/definitions/ThumbnailInfo"
        },
        "review_info": {
          "$ref": "#/definitions/ReviewInfo"
        }
      }
    },
    "ThumbnailRsp": {
      "description": "截图结果",
      "type": "object",
      "required": [
        "offset",
        "url"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "description": "截图在视频中的时间偏移,单位为秒。"
        },
        "url": {
          "type": "string",
          "description": "截图访问URL"
        }
      }
    },
    "TranscodeInfo": {
      "description": "转码生成文件信息。\n\n> 仅当转码成功后才能查询到此信息,未转码、正在转码以及转码失败时,无此字段信息。",
      "required": [
        "template_group_name",
        "output"
      ],
      "properties": {
        "template_group_name": {
          "type": "string",
          "description": "转码模板组名称。"
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Output"
          },
          "description": "转码输出数组。\n- HLS或DASH格式:此数组的成员个数为n+1,n为转码输出路数。\n- MP4格式:此数组的成员个数为n,n为转码输出路数。"
        },
        "exec_desc": {
          "type": "string",
          "description": "执行情况描述。"
        },
        "transcode_status": {
          "type": "string",
          "description": "转码状态。\n\n取值如下:\n- UN_TRANSCODE:未转码\n- WAITING_TRANSCODE:待转码\n- TRANSCODING:转码中\n- TRANSCODE_SUCCEED:转码成功\n- TRANSCODE_FAILED:转码失败"
        }
      }
    },
    "BaseInfo": {
      "properties": {
        "title": {
          "type": "string",
          "description": "媒资标题。\n\n长度不超过128个字节,UTF8编码。"
        },
        "video_name": {
          "type": "string",
          "description": "媒资文件名。"
        },
        "description": {
          "type": "string",
          "description": "媒资描述。\n\n长度不超过1024个字节。"
        },
        "category_id": {
          "type": "integer",
          "format": "int64",
          "description": "媒资分类id。"
        },
        "category_name": {
          "type": "string",
          "description": "媒资分类名称。"
        },
        "create_time": {
          "type": "string",
          "description": "媒资创建时间。\n\n格式为yyyymmddhhmmss。必须是与时区无关的UTC时间。"
        },
        "last_modified": {
          "type": "string",
          "description": "媒资最近修改时间。\n\n格式为yyyymmddhhmmss。必须是与时区无关的UTC时间。"
        },
        "video_type": {
          "type": "string",
          "description": "音视频文件类型。\n\n取值如下:\n- 视频文件:MP4、TS、MOV、MXF、MPG、FLV、WMV、AVI、M4V、F4V、MPEG、3GP、ASF、MKV。\n- 音频文件:MP3、OGG、WAV、WMA、APE、FLAC、AAC、AC3、MMF、AMR、M4A、M4R、WV、MP2。"
        },
        "tags": {
          "type": "string",
          "description": "媒资标签。\n\n单个标签不超过16个字节,最多不超过16个标签。\n\n多个用逗号分隔,UTF8编码。"
        },
        "meta_data": {
          "$ref": "#/definitions/MetaData"
        },
        "video_url": {
          "type": "string",
          "description": "原始视频文件的访问地址。"
        },
        "sign_url": {
          "type": "string",
          "description": "原视频文件的OBS临时访问地址,仅媒资详情接口生效"
        },
        "cover_info_array": {
          "type": "array",
          "description": "封面信息。",
          "items": {
            "$ref": "#/definitions/CoverInfo"
          }
        },
        "subtitle_info": {
          "type": "array",
          "x-is_inner_param": true,
          "description": "字幕信息数组",
          "items": {
            "$ref": "#/definitions/SubtitleInfo"
          }
        },
        "source_path": {
          "$ref": "#/definitions/File_addr"
        },
        "output_path": {
          "$ref": "#/definitions/File_addr"
        }
      },
      "description": "媒资基本信息。"
    },
    "ReviewDetail": {
      "description": "审核结果",
      "required": [
        "confidence"
      ],
      "properties": {
        "confidence": {
          "type": "string",
          "description": "置信度。\n\n取值范围:[0,1]。"
        },
        "label": {
          "type": "string",
          "description": "每个检测结果的标签化说明。\n- politics场景:label为对应的政治人物信息。\n- terrorism场景: label为对应的暴恐元素(枪支、刀具、火灾等) 信息。\n- porn场景:label为对应的涉黄元素(涉黄、性感等)信息。"
        }
      }
    },
    "CoverInfo": {
      "properties": {
        "cover_url": {
          "type": "string",
          "description": "封面文件的下载地址。"
        }
      },
      "description": "封面信息。"
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "PictureReviewRet": {
      "description": "图片审核结果",
      "required": [
        "url"
      ],
      "properties": {
        "suggestion": {
          "type": "string",
          "description": "检测结果是否通过。\n\n取值如下:\n- block:包含敏感信息,不通过。\n- pass:不包含敏感信息,通过。\n- review:需要人工复检。",
          "enum": [
            "block",
            "pass",
            "review"
          ]
        },
        "offset": {
          "type": "integer",
          "description": "截图在视频中的时间偏移值。封面不涉及此字段\n\n单位:秒。"
        },
        "url": {
          "type": "string",
          "description": "对应截图/封面的访问URL。"
        },
        "politics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReviewDetail"
          },
          "description": "政治因素审核结果。"
        },
        "terrorism": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReviewDetail"
          },
          "description": "暴恐元素审核结果。"
        },
        "porn": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReviewDetail"
          },
          "description": "涉黄内容审核结果。"
        }
      }
    },
    "File_addr": {
      "required": [
        "bucket",
        "location",
        "object"
      ],
      "properties": {
        "bucket": {
          "description": "OBS的bucket名称。",
          "type": "string"
        },
        "location": {
          "description": "桶所在的区域名, 如“华北-北京四”的区域名为“cn-north-4”,创建的桶所在区域必须和点播服务所在区域保持一致。",
          "type": "string"
        },
        "object": {
          "description": "文件的存储路径。",
          "type": "string"
        }
      },
      "description": "媒资存储参数信息。"
    },
    "TextReviewRet": {
      "description": "文本检测结果",
      "required": [
        "suggestion"
      ],
      "properties": {
        "suggestion": {
          "type": "string",
          "description": "检测结果是否通过。\n\n取值如下:\n- block:包含敏感信息,不通过。\n- pass:不包含敏感信息,通过。\n- review:需要人工复检。",
          "enum": [
            "block",
            "pass",
            "review"
          ]
        },
        "politics": {
          "type": "string",
          "description": "涉政敏感词列表"
        },
        "porn": {
          "type": "string",
          "description": "涉黄敏感词列表"
        },
        "abuse": {
          "type": "string",
          "description": "辱骂敏感词列表"
        }
      }
    },
    "SubtitleInfo": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "字幕文件的下载地址\n"
        },
        "id": {
          "type": "integer",
          "description": "字幕文件id\n"
        },
        "type": {
          "type": "string",
          "description": "字幕文件类型\n"
        },
        "language": {
          "type": "string",
          "description": "字幕文件语言种类\n"
        }
      }
    },
    "MetaData": {
      "properties": {
        "pack_type": {
          "type": "string",
          "description": "视频封装格式。\n\n取值如下:\n- MP4\n- TS\n- MOV\n- MXF\n- MPG\n- FLV\n- WMV\n- MP3\n- WMA\n- APE\n- FLAC\n- AAC\n- AC3\n- MMF\n- AMR\n- M4A\n- M4R\n- OGG\n- WAV\n- WV\n- MP2\n- AVI\n- F4V\n- M4V\n- MPEG\n- HLS\n- DASH",
          "enum": [
            "MP4",
            "TS",
            "MOV",
            "MXF",
            "MPG",
            "FLV",
            "WMV",
            "MP3",
            "WMA",
            "APE",
            "FLAC",
            "AAC",
            "AC3",
            "MMF",
            "AMR",
            "M4A",
            "M4R",
            "OGG",
            "WAV",
            "WV",
            "MP2",
