        "asset_status": {
          "description": "媒资状态。\n- \"CREATING\":上传中\n- \"FAILED\":上传失败\n- \"CREATED\":上传成功\n- \"PUBLISHED\":已发布\n- \"DELETED\":已删除",
          "type": "string",
          "enum": [
            "CREATING",
            "FAILED",
            "CREATED",
            "PUBLISHED",
            "DELETED"
          ]
        },
        "transcode_status": {
          "description": "转码状态。\n- \"UN_TRANSCODE\":未转码\n- \"WAITING_TRANSCODE\":等待转码,排队中\n- \"TRANSCODING\":转码中\n- \"TRANSCODE_SUCCEED\":转码成功\n- \"TRANSCODE_FAILED\":转码失败",
          "type": "string",
          "enum": [
            "UN_TRANSCODE",
            "WAITING_TRANSCODE",
            "TRANSCODING",
            "TRANSCODE_SUCCEED",
            "TRANSCODE_FAILED"
          ]
        },
        "base_info": {
          "$ref": "#/definitions/BaseInfo"
        },
        "transcode_info": {
          "$ref": "#/definitions/TranscodeInfo"
        }
      }
