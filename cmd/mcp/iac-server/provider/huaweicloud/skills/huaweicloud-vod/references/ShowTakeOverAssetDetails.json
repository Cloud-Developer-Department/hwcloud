        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "Output": {
      "description": "转码输出数组。\n- HLS或DASH格式:此数组的成员个数为n+1,n为转码输出路数。\n- MP4格式:此数组的成员个数为n,n为转码输出路数。",
      "required": [
        "play_type",
        "url",
        "meta_data"
      ],
      "properties": {
        "play_type": {
          "description": "协议类型。\n\n取值如下:\n- hls\n- dash\n- mp4",
          "type": "string",
          "enum": [
            "HLS",
            "DASH",
            "MP4",
            "MP3",
            "AAC"
          ]
        },
        "url": {
          "description": "播放URL。",
          "type": "string"
        },
        "group_id": {
          "type": "string",
          "description": "所属转码组Id"
        },
        "group_name": {
          "type": "string",
          "description": "所属转码组名称"
        },
