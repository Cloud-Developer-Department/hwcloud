          "enum": [
            0,
            1
          ]
        },
        "quality": {
          "type": "string",
          "description": "清晰度。\n\n取值如下:\n- FLUENT:流畅\n- SD:标清\n- HD:高清\n- FULL_HD:超清",
          "enum": [
            "FLUENT",
            "SD",
            "HD",
            "FULL_HD"
          ]
        },
        "meta_data": {
          "$ref": "#/definitions/MetaData"
        }
