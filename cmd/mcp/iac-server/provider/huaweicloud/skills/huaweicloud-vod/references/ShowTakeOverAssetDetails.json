          "type": "integer",
          "format": "int64",
          "description": "视频文件大小。\n\n单位:字节。"
        },
        "width": {
          "type": "integer",
          "format": "int64",
          "description": "视频宽度(单位:像素)。\n- 编码为H.264的取值范围:[32,3840]之间2的倍数。\n- 编码为H.265的取值范围:[320,3840]之间4的倍数。"
        },
        "hight": {
          "type": "integer",
          "format": "int64",
          "description": "视频高度(单位:像素)。该字段会逐渐废弃,请使用height字段。\n- 编码为H.264的取值范围:[32,2160]之间2的倍数 。\n- 编码为H.265的取值范围:[240,2160]之间4的倍数。"
        },
        "height": {
          "type": "integer",
          "format": "int64",
          "description": "视频高度(单位:像素)。\n- 编码为H.264的取值范围:[32,2160]之间2的倍数 。\n- 编码为H.265的取值范围:[240,2160]之间4的倍数。"
        },
        "bit_rate": {
          "type": "integer",
          "format": "int64",
          "description": "视频平均码率。"
        },
        "frame_rate": {
          "type": "integer",
          "format": "int64",
          "description": "帧率(单位:帧每秒)。\n\n取值如下:\n- FRAMERATE_AUTO = 1,\n- FRAMERATE_10 = 2,\n- FRAMERATE_15 = 3,\n- FRAMERATE_2397 = 4, // 23.97 fps\n- FRAMERATE_24 = 5,\n- FRAMERATE_25 = 6,\n- FRAMERATE_2997 = 7, // 29.97 fps\n- FRAMERATE_30 = 8,\n- FRAMERATE_50 = 9,\n- FRAMERATE_60 = 10\n\n默认值:1。\n\n单位:帧每秒。"
        },
        "quality": {
          "type": "string",
          "description": "清晰度。\n\n取值如下:\n- FULL_HD:超高清\n- HD:高清\n- SD:标清\n- FLUENT:流畅\n- AD:自适应\n- 2K\n- 4K"
        },
        "audio_channels": {
          "type": "integer",
          "format": "int32",
          "description": "音频的声道数。"
        }
      },
      "description": "视频的元数据信息。\n\n经过视频解析后产生,包括封装格式、大小、分辨率、码率、帧率。"
