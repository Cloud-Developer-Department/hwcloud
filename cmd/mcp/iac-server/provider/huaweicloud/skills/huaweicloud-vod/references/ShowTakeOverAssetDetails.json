            "AMR",
            "APE",
            "FLAC",
            "MP3",
            "MP2",
            "WMA",
            "PCM",
            "ADPCM",
            "WavPack",
            "HEAAC",
            "UNKNOWN"
          ]
        },
        "duration": {
          "type": "integer",
          "format": "int64",
          "description": "视频时长,单位:秒。\n\n若视频的原时长为非整数,则该字段值为原时长的向下取整。\n若视频的原时长小于1,则该字段值为1。"
        },
        "duration_ms": {
          "type": "integer",
          "format": "int64",
          "description": "视频时长,单位毫秒。"
        },
