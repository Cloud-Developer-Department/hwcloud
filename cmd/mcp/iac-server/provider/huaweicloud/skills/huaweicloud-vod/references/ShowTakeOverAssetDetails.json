          "type": "integer",
          "description": "字幕文件id\n"
        },
        "type": {
          "type": "string",
          "description": "字幕文件类型\n"
        },
        "language": {
          "type": "string",
          "description": "字幕文件语言种类\n"
        }
      }
    },
    "TranscodeInfo": {
      "description": "转码生成文件信息。\n\n> 仅当转码成功后才能查询到此信息,未转码、正在转码以及转码失败时,无此字段信息。",
      "required": [
        "template_group_name",
        "output"
      ],
      "properties": {
