{
  "name": "ShowAssetCipher",
  "summary": "密钥查询",
  "tags": "密钥查询",
  "productshort": "VOD",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1.0/{project_id}/asset/ciphers": {
      "get": {
        "x-publishpath": "vod_04_0100",
        "description": "终端播放HLS加密视频时,向租户管理系统请求密钥,租户管理系统先查询其本地有没有已缓存的密钥,没有时则调用此接口向VOD查询。该接口的具体使用场景请参见[通过HLS加密防止视频泄露](https://support.huaweicloud.com/bestpractice-vod/vod_10_0004.html)。",
        "summary": "密钥查询",
        "operationId": "ShowAssetCipher",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "tags": [
          "密钥查询"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/usermanual-vod/vod_01_0058.html)",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
            "required": true
          },
          {
            "in": "query",
            "name": "asset_id",
            "type": "string",
            "required": true,
            "description": "媒资ID。"
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。",
            "schema": {
              "$ref": "#/definitions/GetCipherRsp"
            },
            "examples": {
              "application/json": {
                "asset_id": "06da0367af8f297ea3efc791e8b27157",
                "edk": "",
                "dk": "4Q9KYgKbUChxocNYbteP3A=="
              }
            }
          },
          "400": {
            "description": "处理失败返回。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "VOD.10101",
                "error_msg": "Unable to get the key because there is no encryption."
              }
            }
          }
        },
        "x-request-examples-url-1": "GET\nhttps://{endpoint}/v1.0/{project_id}/asset/ciphers?asset_id={asset_id}"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "GetCipherRsp": {
      "properties": {
        "asset_id": {
          "type": "string",
          "description": "媒资ID。"
        },
        "edk": {
          "type": "string",
          "description": "密钥密文。"
        },
        "dk": {
          "type": "string",
          "description": "密钥明文。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}