      "x-imports": "org.hibernate.validator.constraints.*;",
      "properties": {
        "name": {
          "type": "string",
          "description": "水印模板名称。",
          "x-annotations": [
            "@NotEmpty"
          ]
        },
        "watermark_type": {
          "type": "string",
          "description": "水印类型,当前只支持Image(图片水印)。",
          "enum": [
            "IMAGE",
            "TEXT"
          ]
        },
        "image_process": {
          "type": "string",
          "description": "type设置为Image时有效。\n\n目前包括:\n- Original:只做简单缩放,不做其他处理\n- Transparent:图片底色透明\n- Grayed:彩色图片变灰",
          "enum": [
            "ORIGINAL",
            "TRANSPARENT",
            "GRAYED"
          ]
        },
        "dx": {
          "type": "string",
          "description": "水印图片相对输出视频的水平偏移量,默认值是0。"
        },
        "dy": {
          "type": "string",
          "description": "水印图片相对输出视频的垂直偏移量,默认值是0。"
        },
        "position": {
          "type": "string",
          "description": "水印的位置。",
          "enum": [
            "TOPRIGHT",
            "TOPLEFT",
            "BOTTOMRIGHT",
            "BOTTOMLEFT"
          ]
        },
        "width": {
          "type": "string",
          "description": "水印图片宽。"
        },
        "height": {
          "type": "string",
          "description": "水印图片高。"
        },
        "timeline_start": {
          "type": "string",
          "description": "水印开始时间,与\"timeline_duration\"配合使用。\n取值范围:[0, END)。\"END\"表示视频结束时间。\n单位:秒。\n"
        },
        "timeline_duration": {
          "type": "string",
          "description": "水印持续时间,与\"timeline_start\"配合使用。\n取值范围:(0,END-开始时间]。\"END\"表示视频结束时间。\n单位:秒。\n默认:END。\n"
        },
        "type": {
          "type": "string",
          "description": "水印图片格式类型。",
          "x-annotations": [
            "@NotEmpty"
          ]
        },
        "md5": {
          "type": "string",
          "description": "水印图片MD5值。"
