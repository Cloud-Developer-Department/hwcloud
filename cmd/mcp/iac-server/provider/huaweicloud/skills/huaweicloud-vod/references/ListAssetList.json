{
  "name": "ListAssetList",
  "summary": "查询媒资列表",
  "tags": "媒资管理",
  "productshort": "VOD",
  "region_id": "cn-north-1",
  "paths": {
    "/v1.0/{project_id}/asset/list": {
      "get": {
        "x-publishpath": "vod_04_0203",
        "description": "查询媒资列表,列表中的每一条记录包含媒资的概要信息。",
        "summary": "查询媒资列表",
        "operationId": "ListAssetList",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "tags": [
          "媒资管理"
        ],
        "produces": [
          "application/json"
        ],
        "x-navigation-title": "媒资信息管理",
        "parameters": [
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "$ref": "#/parameters/xSdkDate"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/usermanual-vod/vod_01_0058.html)",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
            "required": true
          },
          {
            "in": "query",
            "name": "asset_id",
            "description": "媒资ID,最多同时查询10个。",
            "type": "array",
            "items": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "status",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "CREATING",
                "FAILED",
                "CREATED",
                "PUBLISHED",
                "WAITING_TRANSCODE",
                "TRANSCODING",
                "TRANSCODE_SUCCEED",
                "TRANSCODE_FAILED",
                "THUMBNAILING",
                "THUMBNAIL_SUCCEED",
                "THUMBNAIL_FAILED",
                "UN_REVIEW",
                "REVIEWING",
                "REVIEW_SUSPICIOUS",
                "REVIEW_PASSED",
                "REVIEW_FAILED",
                "REVIEW_BLOCKED"
              ]
            },
            "description": "媒资状态,同时查询多个状态的媒资。\n\n取值如下:\n- CREATING:上传中\n- FAILED:上传失败\n- CREATED:上传成功\n- PUBLISHED:已发布\n- TRANSCODING:转码中\n- TRANSCODE_SUCCEED:转码成功\n- TRANSCODE_FAILED:转码失败\n- THUMBNAILING:截图中\n- THUMBNAIL_SUCCEED:截图成功\n- THUMBNAIL_FAILED:截图失败\n- UN_REVIEW:未审核\n- REVIEWING:审核中\n- REVIEW_SUSPICIOUS :审核不过,待人工复审\n- REVIEW_PASSED:审核通过\n- REVIEW_FAILED:审核任务失败\n- REVIEW_BLOCKED:已屏蔽",
            "required": false
          },
          {
            "in": "query",
            "name": "start_time",
            "description": "起始时间。\n\n格式为yyyymmddhhm mss。必须是与时区无关的UTC时间。",
            "type": "string",
            "required": false
          },
          {
            "in": "query",
            "type": "string",
            "name": "end_time",
            "description": "结束时间。\n\n格式为yyyymmddhhm mss。必须是与时区无关的UTC时间。",
            "required": false
          },
          {
            "in": "query",
            "name": "category_id",
            "description": "分类ID。",
            "type": "integer",
            "required": false
          },
          {
            "in": "query",
            "name": "tags",
            "type": "string",
            "description": "媒资标签。 单个标签不超过16个字节, 最多不超过16 个标签。 多个用英文逗号分隔,UTF8编码。",
            "required": false
          },
          {
            "in": "query",
            "name": "query_string",
            "type": "string",
            "description": "在媒资标题、 描述、分类名称中模糊查询的字符串。",
            "required": false
          },
          {
            "in": "query",
            "name": "media_type",
            "description": "音视频文件的格式,支持多格式查询,最多不超过20个。\n\n取值如下:\n- 视频文件格式:MP4、TS、MOV、MXF、MPG、FLV、WMV、AVI、M4V、F4V、MPEG\n- 音频文件格式:MP3、OGG、WAV、WMA、APE、FLAC、AAC、AC3、MMF、AMR、M4A、M4R、WV、MP2",
            "type": "array",
            "items": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "page",
            "type": "integer",
            "description": "分页编号。\n\n默认值:0。",
            "default": 0,
            "required": false
          },
          {
            "in": "query",
            "name": "size",
            "type": "integer",
            "description": "每页记录数。\n\n取值范围:[1,100]。\n\n默认值:10。",
            "default": 10,
            "required": false
          },
          {
            "in": "query",
            "name": "order",
            "type": "string",
            "x-is_inner_param": true,
            "enum": [
              "asc",
              "desc"
            ],
            "default": "desc",
            "description": "查询顺序,按createTime顺序还是倒序",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。",
            "schema": {
              "$ref": "#/definitions/QueryAssetListRsp"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "assets": [
                  {
                    "asset_id": "67d1470893419bfcb9663103dd8a66ac",
                    "title": "video.mp4",
                    "duration": 60,
                    "duration_ms": 60000,
                    "size": 12881945,
                    "category": "其他",
                    "covers": [
                      {
                        "cover_url": "https://355.cdn-vod.huaweicloud.com/asset/67d1470893419bfcb9663103dd8a66ac/cover/Cover0.jpg"
                      }
                    ],
                    "create_time": "20190625020756",
                    "asset_status": "PUBLISHED",
                    "transcode_status": "TRANSCODE_SUCCEED",
                    "thumbnail_status": "UN_THUMBNAIL",
                    "review_status": "UN_REVIEW",
                    "exec_desc": "asset_exec_desc:Asset meta is\npublished;transcode_exec_desc:Transcode success;",
                    "media_type": "MP4"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "处理失败返回。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "VOD.10053",
                "error_msg": "The request parameter is illegal, illegal field: {xx}."
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1.0/{project_id}/asset/list"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string"
        }
      }
    },
    "QueryAssetListRsp": {
      "required": [
        "total",
        "assets"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "description": "媒资总数\n\n> 暂只能统计2万个媒资,若您需要查询具体的媒资总数,请提交工单申请。"
        },
        "assets": {
          "type": "array",
          "description": "媒资列表",
          "items": {
            "$ref": "#/definitions/AssetSummary"
          }
        }
      }
    },
    "AssetSummary": {
      "description": "媒资总览",
      "required": [
        "asset_id",
        "title",
        "duration",
        "size",
        "asset_status"
      ],
      "properties": {
        "asset_id": {
          "description": "媒资ID。",
          "type": "string"
        },
        "title": {
          "description": "媒资标题。长度不超过128个字节,UTF-8编码。",
          "type": "string",
          "maxLength": 128
        },
        "description": {
          "description": "媒资描述。长度不超过1024个字节。",
          "type": "string",
          "maxLength": 1024
        },
        "duration": {
          "description": "媒资时长。\n\n单位:秒。",
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer",
          "format": "int64",
          "description": "视频时长,单位毫秒。"
        },
        "size": {
          "description": "媒资大小。\n\n单位:字节。",
          "type": "integer",
          "format": "int64"
        },
        "original_url": {
          "description": "原始播放url。",
          "type": "string"
        },
        "category": {
          "description": "媒资分类名称。",
          "type": "string"
        },
        "covers": {
          "description": "封面信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CoverInfo"
          }
        },
        "create_time": {
          "description": "媒资创建时间。\n\n格式为yyyymmddhhmmss。必须是与时区无关的UTC时间。",
          "type": "string"
        },
        "asset_status": {
          "description": "媒资状态。\n\n取值如下:\n- CREATING:上传中。\n- FAILED:上传失败。\n- CREATED:上传成功。\n- PUBLISHED:已发布。\n- DELETED:已删除。",
          "type": "string",
          "enum": [
            "CREATING",
            "FAILED",
            "CREATED",
            "PUBLISHED",
            "DELETED"
          ]
        },
        "transcode_status": {
          "description": "转码状态。\n\n取值如下:\n- UN_TRANSCODE:未转码。\n- WAITING_TRANSCODE:待转码\n- TRANSCODING:转码中。\n- TRANSCODE_SUCCEED:转码成功。\n- TRANSCODE_FAILED:转码失败。",
          "type": "string",
          "enum": [
            "UN_TRANSCODE",
            "WAITING_TRANSCODE",
            "TRANSCODING",
            "TRANSCODE_SUCCEED",
            "TRANSCODE_FAILED"
          ]
        },
        "thumbnail_status": {
          "description": "截图状态。\n\n取值如下:\n- UN_THUMBNAIL:未截图。\n- THUMBNAILING:截图中。\n- THUMBNAIL_SUCCEED:截图成功。\n- THUMBNAIL_FAILED:截图失败。",
          "type": "string",
          "enum": [
            "UN_THUMBNAIL",
            "THUMBNAILING",
            "THUMBNAIL_SUCCEED",
            "THUMBNAIL_FAILED"
          ]
        },
        "review_status": {
          "description": "内容审核状态\n\n取值如下:\n- UN_REVIEW:未审核。\n- REVIEWING:审核中。\n- REVIEW_SUSPICIOUS:审核可疑,需要人工复审。\n- REVIEW_PASSED:审核通过。\n- REVIEW_FAILED:审核失败。\n- REVIEW_BLOCKED:已屏蔽。",
          "type": "string",
          "enum": [
            "UN_REVIEW",
            "REVIEWING",
            "REVIEW_SUSPICIOUS",
            "REVIEW_PASSED",
            "REVIEW_FAILED",
            "REVIEW_BLOCKED"
          ]
        },
        "exec_desc": {
          "type": "string",
          "description": "媒资的任务执行描述汇总。\n\n示例:\n- asset_exec_desc: upload success,媒资任务执行描述信息。\n- transcode_exec_desc: transcode success,转码任务执行描述信息。\n- thumbnail_exec_desc: thumbnail failed,截图任务执行描述信息。\n- review_exec_desc: review pass,审核任务执行描述信息。"
        },
        "media_type": {
          "type": "string",
          "description": "音视频文件的格式。\n\n取值如下:\n- 视频文件格式:MP4、TS、MOV、MXF、MPG、FLV、WMV、AVI、M4V、F4V、MPEG\n- 音频文件格式:MP3、OGG、WAV、WMA、APE、FLAC、AAC、AC3、MMF、AMR、M4A、M4R、WV、MP2"
        }
      }
    },
    "CoverInfo": {
      "properties": {
        "cover_url": {
          "type": "string",
          "description": "封面文件的下载地址。"
        }
      },
      "description": "封面信息。"
    }
  },
  "version": "2.0",
  "parameters": {
    "xSdkDate": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token,使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
      "required": false,
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "host": "vod.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}