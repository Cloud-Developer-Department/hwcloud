{
  "name": "UploadExtensionFile",
  "summary": "上传插件",
  "tags": "插件市场",
  "productshort": "CloudIDE",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/marketplace/file/plugin": {
      "post": {
        "tags": [
          "插件市场"
        ],
        "summary": "上传插件",
        "description": "上传插件",
        "operationId": "UploadExtensionFile",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          },
          {
            "in": "formData",
            "name": "file",
            "description": "文件",
            "required": true,
            "type": "file",
            "x-example": "file"
          },
          {
            "name": "official",
            "in": "query",
            "description": "插件类型。目前只支持CodeArtsIDEOnline",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 255,
            "x-example": "CodeArtsIDEOnline"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/MarketplaceResponse"
            },
            "examples": {
              "application/json": {
                "result": {
                  "security": {
                    "status": "success",
                    "errors": []
                  },
                  "basicInformation": {
                    "status": "success",
                    "errors": []
                  },
                  "file": {
                    "status": "success",
                    "errors": []
                  },
                  "upload": {
                    "status": "success",
                    "errors": []
                  }
                },
                "status": "success"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/CloudBuErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_msg": "suspended",
                "error_code": "IDE.00000005"
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "schema": {
              "$ref": "#/definitions/CloudBuErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_msg": "The user has not signed the service declare.",
                "error_code": "IDE.00010001"
              }
            }
          }
        },
        "x-request-examples-description-1": "上传插件。通过form表单提交,file为具体文件",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/marketplace/file/plugin?official=CodeArtsIDEOnline"
      }
    }
  },
