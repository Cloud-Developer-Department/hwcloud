{
  "name": "UploadFilePublisher",
  "summary": "文件上传归一化",
  "tags": "插件市场",
  "productshort": "CloudIDE",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/fileservice/file/upload": {
      "post": {
        "tags": [
          "插件市场"
        ],
        "summary": "文件上传归一化",
        "description": "文件上传归一化",
        "operationId": "UploadFilePublisher",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\nx-publisher-token和X-Auth-Token必传一个",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          },
          {
            "name": "x-publisher-token",
            "in": "header",
            "description": "发布商凭证,x-publisher-token和X-Auth-Token必传一个",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          {
            "name": "file",
            "in": "formData",
            "description": "文件",
            "required": true,
            "type": "file"
          },
          {
            "name": "publisher_id",
            "in": "formData",
            "description": "传用户token时,此字段为必传项",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 10000
          },
          {
            "name": "chunk_index",
            "in": "formData",
            "description": "分片索引,第几个分片 取值范围:1-100",
            "required": true,
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 100
          },
          {
            "name": "merge",
            "in": "formData",
            "description": "是否合并已上传的分片(包含本次分片内容),true",
            "required": true,
            "type": "boolean"
          },
          {
            "name": "total_chunk_num",
            "in": "formData",
            "description": "总分片数 0-100",
            "required": true,
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 100
          },
          {
            "name": "parent_file_size",
            "in": "formData",
            "description": "父文件大小",
            "required": true,
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          {
            "name": "parent_file_name",
            "in": "formData",
            "description": "父文件名称",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 10000
          },
          {
            "name": "override",
            "in": "formData",
            "description": "是否覆盖原有文件",
            "required": true,
            "type": "boolean"
          },
          {
            "name": "chunk_md5",
            "in": "formData",
            "description": "文件分片的md5,用于校验文件分片是否完整",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 10000
          },
          {
            "name": "parent_file_sha256",
            "in": "formData",
            "description": "父文件hash,用于校验合并后的文件",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 10000
          },
          {
            "name": "task_id",
            "in": "formData",
            "description": "上传任务的唯一标识,第一次上传分片时可不传",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 10000
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/InstancesResponse"
            },
            "examples": {
              "application/json": {
                "result": {
                  "task_id": "597a3fc9-a023-48fa-93bd-14386bf5936b"
                },
                "status": "success"
              }
            }
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/CloudBuErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/CloudBuErrorResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/CloudBuErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v1/fileservice/file/upload",
        "x-request-examples-description-1": "文件上传归一化"
      }
    }
  },
  "definitions": {
    "InstancesResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "返回值"
        },
        "status": {
          "type": "string",
          "description": "状态",
          "minLength": 0,
          "maxLength": 100,
          "example": "success"
        }
      },
      "title": "InstancesResponse"
    },
    "CloudBuErrorResponse": {
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 255
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 0,
          "maxLength": 100
        }
      },
      "title": "CloudBuErrorResponse"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cloudide.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}