          "maxLength": 100,
          "example": "success"
        }
      },
      "title": "InstancesResponseboolean"
    },
    "InstanceUpdateParam": {
      "type": "object",
      "required": [
        "display_name",
        "refresh_interval"
      ],
      "properties": {
        "description": {
          "type": "string",
          "description": "描述",
          "minLength": 0,
          "maxLength": 100,
          "example": "test"
        },
        "display_name": {
          "type": "string",
          "description": "实例名。\n可以输入中文、数字、字母、下划线、点、破折号。长度介于3-100之间",
          "minLength": 3,
          "maxLength": 100,
          "example": "test"
        },
        "refresh_interval": {
          "type": "string",
          "description": "自动休眠时长。\narm架构,自动休眠时长只能设置成30,60。x86架构可取值为30,60,240,1440和-1。除-1外,其它值的单位为“分钟”。实例无操作超过自动休眠时长后,将会被暂停(已保存的数据不会被删除)。-1表示实例不会自动停止",
          "pattern": "^30$|^60$|^240$|^1440$|^-1$",
          "example": 60
        }
      },
      "title": "InstanceUpdateParam"
    }
