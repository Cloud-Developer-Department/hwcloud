{
  "name": "ListInstances",
  "summary": "查询IDE实例列表",
  "tags": "IDE实例管理",
  "productshort": "CloudIDE",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/instances": {
      "get": {
        "tags": [
          "IDE实例管理"
        ],
        "summary": "查询IDE实例列表",
        "description": "查询IDE实例列表",
        "operationId": "ListInstances",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量 10/15/30",
            "minimum": 10,
            "maximum": 30,
            "pattern": "^10$|^15$|^30$",
            "required": false,
            "type": "integer",
            "default": 30,
            "format": "int64",
            "x-example": 30
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,表示从此偏移量开始查询",
            "minimum": 0,
            "maximum": 999,
            "required": false,
            "type": "integer",
            "default": 0,
            "format": "int64",
            "x-example": 0
          },
          {
            "name": "is_temporary",
            "in": "query",
            "description": "是否页面显示(以标签配置为准)",
            "required": false,
            "type": "boolean",
            "x-example": false
          },
          {
            "name": "label",
            "in": "query",
            "description": "标签",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 255,
            "x-example": "default"
          },
          {
            "name": "search",
            "in": "query",
            "description": "关键字查询(根据实例名,描述模糊查询)",
            "minLength": 0,
            "maxLength": 100,
            "required": false,
            "type": "string",
            "x-example": "test"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序方式 asc/desc",
            "minLength": 0,
            "maxLength": 10,
            "pattern": "^desc$|^asc$",
            "required": false,
            "type": "string",
            "default": "desc",
            "x-example": "desc"
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序字段。\ndisplay_name 实例名、status状态、pvc_quantity 存储容量、created_time\n创建时间、stack_id 技术栈",
            "minLength": 0,
            "maxLength": 100,
            "pattern": "^created_time$|^display_name$|^status$|^pvc_quantity$|^stack_id$",
            "required": false,
            "type": "string",
            "default": "created_time",
            "x-example": "created_time"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/InstancesPageResult"
            },
            "examples": {
              "application/json": {
                "instances": {
                  "items_before": 0,
                  "size": 10,
                  "items": [
                    {
                      "updated_time": "2020-03-17 15:21:36",
                      "private": false,
                      "owner_id": "d78cbac186b744899480f25bd022f...",
                      "description": "ddd",
                      "cpu_memory": "2U4G",
                      "domain_name": "IAM_DOMAIN_NAME_A",
                      "is_temporary": false,
                      "stack_id": "java",
                      "id": "instancewrqztsgn12imjq7e",
                      "created_time": "2020-01-06 15:25:04",
                      "owner_name": "ide_owner_name",
                      "refresh_interval": 30,
                      "display_name": "test001",
                      "organization_id": "6251b1ee539f4c02ad4b83daeda81633...",
                      "name": "ide-instance4xceoej8vvpn32lx",
                      "platform_id": 1,
                      "attributes": {
                        "cpu_limit": "2",
                        "pvc_quantity": "5Gi",
                        "memory_limit_bytes": "4294967296"
                      },
                      "pvc_quantity": "5GB",
                      "arch": "x86",
                      "region": "cn-north-7",
                      "status": "STOPPED",
                      "visitor_id": "c78cbac186b744899480f25bd022f...",
                      "visitor_name": "ide_visitor_name",
                      "visitor_domain_name": "IAM_DOMAIN_NAME_B"
                    }
                  ],
                  "empty": false
                },
                "status": "success"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          },
          "406": {
            "description": "Not Acceptable",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-description-1": "查询IDE实例列表",
        "x-request-examples-url-1": "GET https://{endpoint}/v2/instances"
      }
    }
  },
  "definitions": {
    "PageInstancesVO": {
      "type": "object",
      "properties": {
        "empty": {
          "type": "boolean",
          "description": "是否为空"
        },
        "items": {
          "type": "array",
          "description": "列表详情",
          "minItems": 0,
          "maxItems": 30,
          "items": {
            "$ref": "#/definitions/InstancesVO"
          }
        },
        "items_before": {
          "type": "integer",
          "format": "int64",
          "description": "偏移量,表示从此偏移量开始查询",
          "minimum": 0,
          "maximum": 999
        },
        "size": {
          "type": "integer",
          "format": "int64",
          "description": "每页显示的条目数量",
          "minimum": 10,
          "maximum": 30,
          "pattern": "^10$|^15$|^30$"
        },
        "total_items_count": {
          "type": "integer",
          "format": "int64",
          "description": "总数",
          "minimum": 1,
          "maximum": 9223372036854776000
        }
      },
      "title": "PageInstancesVO"
    },
    "InstancesPageResult": {
      "type": "object",
      "properties": {
        "instances": {
          "description": "实例列表",
          "$ref": "#/definitions/PageInstancesVO"
        },
        "status": {
          "type": "string",
          "description": "状态",
          "minLength": 0,
          "maxLength": 100,
          "example": "success"
        }
      },
      "title": "InstancesPageResult"
    },
    "CloudBUErrorResponse": {
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 255
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 0,
          "maxLength": 100
        }
      },
      "title": "CloudBUErrorResponse"
    },
    "InstancesVO": {
      "type": "object",
      "properties": {
        "arch": {
          "type": "string",
          "description": "cpu架构 x86|arm",
          "enum": [
            "x86",
            "arm"
          ],
          "pattern": "^arm$|^x86$"
        },
        "attributes": {
          "description": "属性",
          "$ref": "#/definitions/Attributes"
        },
        "cpu_memory": {
          "type": "string",
          "description": "cpu规格.arm架构支持4U8G,x86架构支持1U1G,2U4G,2U8G\n与技术栈配置的规格对应,可通过技术栈管理ListStacks接口获取。如果标签不为空,以标签配置的技术栈规格为准。\nquantum技术栈,x86架构cpu规格为2U8G;其他技术栈,x86架构cpu规格为1U1G,2U4G",
          "enum": [
            "1U1G",
            "2U4G",
            "2U8G",
            "4U8G"
          ],
          "pattern": "^1U1G$|^2U4G$|^2U8G$|^4U8G$"
        },
        "created_time": {
          "type": "string",
          "pattern": "yyyy-MM-dd HH:mm:ss",
          "description": "创建时间"
        },
        "description": {
          "type": "string",
          "description": "描述",
          "minLength": 0,
          "maxLength": 100
        },
        "display_name": {
          "type": "string",
          "description": "实例名。\n可以输入中文、数字、字母、下划线、点、破折号。长度介于3-100之间",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[\\一-\\龥_a-zA-Z0-9-_.]{1,126}$"
        },
        "domain_name": {
          "type": "string",
          "description": "租户名",
          "minLength": 0,
          "maxLength": 255
        },
        "id": {
          "type": "string",
          "description": "id",
          "pattern": "^[a-zA-Z0-9][-_.a-zA-Z0-9]{1,126}[a-zA-Z0-9]$"
        },
        "is_temporary": {
          "type": "boolean",
          "description": "是否页面显示(以标签配置为准)"
        },
        "label": {
          "type": "string",
          "description": "标签",
          "pattern": "[a-zA-Z0-9_-]*$"
        },
        "link": {
          "type": "string",
          "description": "链接",
          "minLength": 0,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "description": "名称",
          "minLength": 0,
          "maxLength": 255
        },
        "organization_id": {
          "type": "string",
          "description": "租户id(对应华为云帐号的domainId)",
          "minLength": 0,
          "maxLength": 255
        },
        "owner_id": {
          "type": "string",
          "description": "用户id",
          "minLength": 0,
          "maxLength": 255
        },
        "owner_name": {
          "type": "string",
          "description": "用户名",
          "minLength": 0,
          "maxLength": 255
        },
        "platform_id": {
          "type": "integer",
          "format": "int64",
          "description": "平台ID",
          "minimum": 1,
          "maximum": 100
        },
        "private": {
          "type": "boolean",
          "description": "是否私有平台"
        },
        "pvc_quantity": {
          "type": "string",
          "description": "PVC规格 5GB|10GB|20GB",
          "enum": [
            "5GB",
            "10GB",
            "20GB"
          ],
          "pattern": "^5GB$|^10GB$|^20GB$"
        },
        "refresh_interval": {
          "type": "integer",
          "format": "int64",
          "description": "自动休眠时长。\narm架构,自动休眠时长只能设置成30,60。x86架构可取值为30,60,240,1440和-1。除-1外,其它值的单位为“分钟”。实例无操作超过自动休眠时长后,将会被暂停(已保存的数据不会被删除)。-1表示实例不会自动停止",
          "minimum": -1,
          "maximum": 1440
        },
        "region": {
          "type": "string",
          "description": "区域",
          "minLength": 0,
          "maxLength": 255
        },
        "server_map": {
          "type": "object",
          "description": "server",
          "additionalProperties": {
            "type": "string"
          }
        },
        "server_url": {
          "type": "string",
          "description": "服务链接",
          "minLength": 0,
          "maxLength": 255
        },
        "stack_id": {
          "type": "string",
          "description": "技术栈ID,通过技术栈管理ListStacks接口获取。",
          "pattern": "^[a-zA-Z0-9][-_.a-zA-Z0-9]{0,126}[a-zA-Z0-9]$"
        },
        "status": {
          "type": "string",
          "description": "实例状态 。\n- INIT 初始化\n- STARTING 启动中\n- RUNNING 运行中\n- STOPPING 停止中\n- STOPPED 已停止\n- DELETING 删除中\n- DELETED 已删除\n- DELETE_FAILED 删除失败",
          "enum": [
            "INIT",
            "STARTING",
            "RUNNING",
            "STOPPING",
            "STOPPED",
            "DELETING",
            "DELETED",
            "DELETE_FAILED"
          ]
        },
        "updated_time": {
          "type": "string",
          "pattern": "yyyy-MM-dd HH:mm:ss",
          "description": "更新时间"
        },
        "visitor_id": {
          "type": "string",
          "description": "访问者id",
          "minLength": 0,
          "maxLength": 255
        },
        "visitor_name": {
          "type": "string",
          "description": "访问者名称",
          "minLength": 0,
          "maxLength": 255
        },
        "visitor_domain_name": {
          "type": "string",
          "description": "访问者租户名称",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "title": "InstancesVO"
    },
    "Attributes": {
      "type": "object",
      "properties": {
        "cpu_limit": {
          "type": "string",
          "description": "cpu限制",
          "minLength": 0,
          "maxLength": 255,
          "example": "2"
        },
        "memory_limit_bytes": {
          "type": "string",
          "description": "内存限制",
          "minLength": 0,
          "maxLength": 255,
          "example": "4294967296"
        },
        "pvc_quantity": {
          "type": "string",
          "description": "pvc规格",
          "minLength": 0,
          "maxLength": 255,
          "example": "5Gi"
        }
      },
      "title": "Attributes"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cloudide.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}