                "status": "success"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_msg": "Instance does not belong to the user or tenant",
                "error_code": "IDE.00010129"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          },
          "406": {
            "description": "Not Acceptable",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v2/extension/authorization/zhkfjt",
        "x-request-examples-description-1": "设置插件实例授权",
        "x-request-examples-1": {
          "extension_version": "1.0.1",
          "identifier": "redhat.java",
          "status": "AGREE"
        }
      }
    }
