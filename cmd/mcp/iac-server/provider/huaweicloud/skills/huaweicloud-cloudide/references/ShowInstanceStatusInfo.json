{
  "name": "ShowInstanceStatusInfo",
  "summary": "查询某个IDE实例的状态",
  "tags": "IDE实例管理",
  "productshort": "CloudIDE",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/instances/{instance_id}/status": {
      "get": {
        "tags": [
          "IDE实例管理"
        ],
        "summary": "查询某个IDE实例的状态",
        "description": "查询某个IDE实例的状态",
        "operationId": "ShowInstanceStatusInfo",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "CodeArtsIDEOnline实例id",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][-_.a-zA-Z0-9]{1,126}[a-zA-Z0-9]$",
            "required": true,
            "type": "string",
            "x-example": "zhkfjt"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/InstancesResponseInstanceStatusResponse"
            },
            "examples": {
              "application/json": {
                "result": {
                  "server_url": "xxxx",
                  "status": "STARTING"
                },
                "status": "success"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          },
          "406": {
            "description": "Not Acceptable",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "查询某个IDE实例的状态",
        "x-request-examples-url-1": "GET https://{endpoint}/v2/instances/zhkfjt/status"
      }
    }
  },
  "definitions": {
    "InstancesResponseInstanceStatusResponse": {
      "type": "object",
      "properties": {
        "result": {
          "description": "返回值",
          "$ref": "#/definitions/InstanceStatusResponse"
        },
        "status": {
          "type": "string",
          "description": "状态",
          "minLength": 0,
          "maxLength": 100
        }
      },
      "title": "InstancesResponseInstanceStatusResponse"
    },
    "CloudBUErrorResponse": {
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 255
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 0,
          "maxLength": 100
        }
      },
      "title": "CloudBUErrorResponse"
    },
    "InstanceStatusResponse": {
      "type": "object",
      "properties": {
        "server_url": {
          "type": "string",
          "description": "服务链接",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "description": "实例状态。\n- DELETED 已删除\n- DELETE_FAILED 删除失败\n- DELETING 删除中\n- READY 热实例就绪状态\n- RUNNING 正在运行\n- STARTING 正在启动\n- STOPPED 已停止\n- STOPPING 停止中\n- UPDATE 更新Schdule信息\n- WAITING 热实例创建初始态",
          "enum": [
            "DELETED",
            "DELETE_FAILED",
            "DELETING",
            "READY",
            "RUNNING",
            "STARTING",
            "STOPPED",
            "STOPPING",
            "UPDATE",
            "WAITING"
          ]
        }
      },
      "title": "InstanceStatusResponse"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cloudide.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
