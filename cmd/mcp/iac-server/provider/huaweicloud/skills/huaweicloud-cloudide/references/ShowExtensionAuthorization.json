{
  "name": "ShowExtensionAuthorization",
  "summary": "查询ide实例对插件的授权情况",
  "tags": "插件管理",
  "productshort": "CloudIDE",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/extension/authorization": {
      "get": {
        "tags": [
          "插件管理"
        ],
        "summary": "查询ide实例对插件的授权情况",
        "description": "查询ide实例对插件的授权情况,同意授权的插件能在ide实例内携带登陆用户的token调用第三方服务",
        "operationId": "ShowExtensionAuthorization",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          },
          {
            "name": "extension_version",
            "in": "query",
            "description": "插件版本",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          {
            "name": "identifier",
            "in": "query",
            "description": "插件标识(发布者.插件名)",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          {
            "name": "instance_id",
            "in": "query",
            "description": "CodeArtsIDEOnline实例ID",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/InstancesResponse"
            },
            "examples": {
              "application/json": {
                "result": {
                  "identifier": "redhat.java",
                  "instance_id": "***",
                  "extension_version": "1.0.1",
                  "status": "AGREE"
                },
                "status": "success"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_msg": "Instance does not belong to the user or tenant",
                "error_code": "IDE.00010129"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          },
          "406": {
            "description": "Not Acceptable",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "查询插件实例授权",
        "x-request-examples-url-1": "GET https://{endpoint}/v2/extension/authorization?instance_id=***&identifier=redhat.java&extension_version=1"
      }
    }
  },
  "definitions": {
    "CloudBUErrorResponse": {
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 255
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 0,
          "maxLength": 100
        }
      },
      "title": "CloudBUErrorResponse"
    },
    "InstancesResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "返回值"
        },
        "status": {
          "type": "string",
          "description": "状态",
          "minLength": 0,
          "maxLength": 100,
          "example": "success"
        }
      },
      "title": "InstancesResponse"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cloudide.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}