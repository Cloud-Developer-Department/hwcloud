{
  "name": "UpdateInstanceActivity",
  "summary": "刷新IDE实例活跃状态",
  "tags": "IDE实例管理",
  "productshort": "CloudIDE",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/instances/{instance_id}/activity": {
      "put": {
        "tags": [
          "IDE实例管理"
        ],
        "summary": "刷新IDE实例活跃状态",
        "description": "刷新IDE实例活跃状态,超过该实例设置的过期时间后实例自动关闭。",
        "operationId": "UpdateInstanceActivity",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "CodeArtsIDEOnline实例id",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][-_.a-zA-Z0-9]{1,126}[a-zA-Z0-9]$",
            "required": true,
            "type": "string",
            "x-example": "zhkfjt"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/InstancesResponseExpireVo"
            },
            "examples": {
              "application/json": {
                "result": {
                  "instance_id": "zhkfjt",
                  "expiration": 1635837203706,
                  "interval": 30
                },
                "status": "success"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "IDE.00010129",
                "error_msg": "Instance does not belong to the user or tenant"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "IDE.00010030",
                "error_msg": "instance not exist"
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "IDE.00010048",
                "error_msg": "active error:instance status error"
              }
            }
          }
        },
        "x-request-examples-description-1": "刷新IDE实例活跃状态",
        "x-request-examples-url-1": "PUT https://{endpoint}/v2/instance/zhkfjt/activity"
      }
    }
  },
  "definitions": {
    "CloudBUErrorResponse": {
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 255
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 0,
          "maxLength": 100
        }
      },
      "title": "CloudBUErrorResponse"
    },
    "ExpireVo": {
      "type": "object",
      "properties": {
        "expiration": {
          "type": "integer",
          "format": "int64",
          "minimum": -1,
          "maximum": 9999999999999,
          "description": "过期时间。UNIX时间戳,单位毫秒。eg:1635905480465"
        },
        "instance_id": {
          "type": "string",
          "description": "CodeArtsIDEOnline实例id",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][-_.a-zA-Z0-9]{1,126}[a-zA-Z0-9]$"
        },
        "interval": {
          "type": "integer",
          "format": "int64",
          "minimum": -1,
          "maximum": 1440,
          "description": "CodeArtsIDEOnline实例自动休眠时长,单位‘分钟’"
        }
      },
      "title": "ExpireVo"
    },
    "InstancesResponseExpireVo": {
      "type": "object",
      "properties": {
        "result": {
          "description": "返回值",
          "$ref": "#/definitions/ExpireVo"
        },
        "status": {
          "type": "string",
          "description": "状态",
          "minLength": 0,
          "maxLength": 100,
          "example": "success"
        }
      },
      "title": "InstancesResponseExpireVo"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cloudide.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "put",
  "uri": null
}