{
  "name": "ShowInstance",
  "summary": "查询某个IDE实例",
  "tags": "IDE实例管理",
  "productshort": "CloudIDE",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/instances/{instance_id}": {
      "get": {
        "tags": [
          "IDE实例管理"
        ],
        "summary": "查询某个IDE实例",
        "description": "查询某个IDE实例",
        "operationId": "ShowInstance",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例id",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][-_.a-zA-Z0-9]{1,126}[a-zA-Z0-9]$",
            "required": true,
            "type": "string",
            "x-example": "zhkfjt"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/InstancesResult"
            },
            "examples": {
              "application/json": {
                "instance": {
                  "created_time": "2020-01-07 11:25:56",
                  "updated_time": "2020-03-20 17:14:00",
                  "private": false,
                  "owner_name": "ide_owner_name",
                  "refresh_interval": 30,
                  "owner_id": "d78cbac186b744899480f25bd022f...",
                  "description": "aaa",
                  "cpu_memory": "1U1G",
                  "display_name": "chen002",
                  "domain_name": "IAM_DOMAIN_NAME_A",
                  "is_temporary": false,
                  "organization_id": "6251b1ee539f4c02ad4b83daeda81633...",
                  "stack_id": "python",
                  "name": "ide_instance8bmjgqx6vfrb9e9n",
                  "platform_id": 1,
                  "attributes": {
                    "cpu_limit": "1",
                    "pvc_quantity": "5Gi",
                    "memory_limit_bytes": "1073741824"
                  },
                  "pvc_quantity": "5GB",
                  "arch": "x86",
                  "id": "instancewc0yk05c8y6jov0v",
                  "region": "cn-north-7",
                  "status": "STOPPED",
                  "visitor_id": "c78cbac186b744899480f25bd022f...",
                  "visitor_name": "ide_visitor_name",
                  "visitor_domain_name": "IAM_DOMAIN_NAME_B"
                },
                "status": "success"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          },
          "406": {
            "description": "Not Acceptable",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/CloudBUErrorResponse"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-description-1": "查询某个IDE实例",
        "x-request-examples-url-1": "GET https://{endpoint}/v2/instances/zhkfjt"
      }
    }
  },
  "definitions": {
    "InstancesResult": {
      "type": "object",
      "properties": {
        "instance": {
          "description": "实例",
          "$ref": "#/definitions/InstancesVO"
        },
        "status": {
          "type": "string",
          "description": "状态",
          "minLength": 0,
          "maxLength": 100,
          "example": "success"
        },
        "bundle_url": {
          "type": "string",
          "description": "静态资源链接",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "title": "InstancesResult"
    },
    "CloudBUErrorResponse": {
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 255
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 0,
          "maxLength": 100
        }
      },
      "title": "CloudBUErrorResponse"
    },
    "InstancesVO": {
      "type": "object",
      "properties": {
        "arch": {
          "type": "string",
          "description": "cpu架构 x86|arm",
          "enum": [
            "x86",
            "arm"
          ],
          "pattern": "^arm$|^x86$"
        },
        "attributes": {
          "description": "属性",
          "$ref": "#/definitions/Attributes"
        },
        "cpu_memory": {
          "type": "string",
          "description": "cpu规格.arm架构支持4U8G,x86架构支持1U1G,2U4G,2U8G\n与技术栈配置的规格对应,可通过技术栈管理ListStacks接口获取。如果标签不为空,以标签配置的技术栈规格为准。\nquantum技术栈,x86架构cpu规格为2U8G;其他技术栈,x86架构cpu规格为1U1G,2U4G",
          "enum": [
            "1U1G",
            "2U4G",
            "2U8G",
            "4U8G"
          ],
          "pattern": "^1U1G$|^2U4G$|^2U8G$|^4U8G$"
        },
        "created_time": {
          "type": "string",
          "pattern": "yyyy-MM-dd HH:mm:ss",
          "description": "创建时间"
        },
        "description": {
          "type": "string",
          "description": "描述",
          "minLength": 0,
          "maxLength": 100
        },
        "display_name": {
          "type": "string",
          "description": "实例名。\n可以输入中文、数字、字母、下划线、点、破折号。长度介于3-100之间",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[\\一-\\龥_a-zA-Z0-9-_.]{1,126}$"
        },
        "domain_name": {
          "type": "string",
          "description": "租户名",
          "minLength": 0,
          "maxLength": 255
        },
        "id": {
          "type": "string",
          "description": "id",
          "pattern": "^[a-zA-Z0-9][-_.a-zA-Z0-9]{1,126}[a-zA-Z0-9]$"
        },
        "is_temporary": {
          "type": "boolean",
          "description": "是否页面显示(以标签配置为准)"
        },
        "label": {
          "type": "string",
          "description": "标签",
          "pattern": "[a-zA-Z0-9_-]*$"
        },
        "link": {
          "type": "string",
          "description": "链接",
          "minLength": 0,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "description": "名称",
          "minLength": 0,
          "maxLength": 255
        },
        "organization_id": {
          "type": "string",
          "description": "租户id(对应华为云帐号的domainId)",
          "minLength": 0,
          "maxLength": 255
        },
        "owner_id": {
          "type": "string",
          "description": "用户id",
          "minLength": 0,
          "maxLength": 255
        },
        "owner_name": {
          "type": "string",
          "description": "用户名",
          "minLength": 0,
          "maxLength": 255
        },
        "platform_id": {
          "type": "integer",
          "format": "int64",
          "description": "平台ID",
          "minimum": 1,
          "maximum": 100
        },
        "private": {
          "type": "boolean",
          "description": "是否私有平台"
        },
        "pvc_quantity": {
          "type": "string",
          "description": "PVC规格 5GB|10GB|20GB",
          "enum": [
            "5GB",
            "10GB",
            "20GB"
          ],
          "pattern": "^5GB$|^10GB$|^20GB$"
        },
        "refresh_interval": {
          "type": "integer",
          "format": "int64",
          "description": "自动休眠时长。\narm架构,自动休眠时长只能设置成30,60。x86架构可取值为30,60,240,1440和-1。除-1外,其它值的单位为“分钟”。实例无操作超过自动休眠时长后,将会被暂停(已保存的数据不会被删除)。-1表示实例不会自动停止",
          "minimum": -1,
          "maximum": 1440
        },
        "region": {
          "type": "string",
          "description": "区域",
          "minLength": 0,
          "maxLength": 255
        },
        "server_map": {
          "type": "object",
          "description": "server",
          "additionalProperties": {
            "type": "string"
          }
        },
        "server_url": {
          "type": "string",
          "description": "服务链接",
          "minLength": 0,
          "maxLength": 255
        },
        "stack_id": {
          "type": "string",
          "description": "技术栈ID,通过技术栈管理ListStacks接口获取。",
          "pattern": "^[a-zA-Z0-9][-_.a-zA-Z0-9]{0,126}[a-zA-Z0-9]$"
        },
        "status": {
          "type": "string",
          "description": "实例状态 。\n- INIT 初始化\n- STARTING 启动中\n- RUNNING 运行中\n- STOPPING 停止中\n- STOPPED 已停止\n- DELETING 删除中\n- DELETED 已删除\n- DELETE_FAILED 删除失败",
          "enum": [
            "INIT",
            "STARTING",
            "RUNNING",
            "STOPPING",
            "STOPPED",
            "DELETING",
            "DELETED",
            "DELETE_FAILED"
          ]
        },
        "updated_time": {
          "type": "string",
          "pattern": "yyyy-MM-dd HH:mm:ss",
          "description": "更新时间"
        },
        "visitor_id": {
          "type": "string",
          "description": "访问者id",
          "minLength": 0,
          "maxLength": 255
        },
        "visitor_name": {
          "type": "string",
          "description": "访问者名称",
          "minLength": 0,
          "maxLength": 255
        },
        "visitor_domain_name": {
          "type": "string",
          "description": "访问者租户名称",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "title": "InstancesVO"
    },
    "Attributes": {
      "type": "object",
      "properties": {
        "cpu_limit": {
          "type": "string",
          "description": "cpu限制",
          "minLength": 0,
          "maxLength": 255,
          "example": "2"
        },
        "memory_limit_bytes": {
          "type": "string",
          "description": "内存限制",
          "minLength": 0,
          "maxLength": 255,
          "example": "4294967296"
        },
        "pvc_quantity": {
          "type": "string",
          "description": "pvc规格",
          "minLength": 0,
          "maxLength": 255,
          "example": "5Gi"
        }
      },
      "title": "Attributes"
    }
  },
