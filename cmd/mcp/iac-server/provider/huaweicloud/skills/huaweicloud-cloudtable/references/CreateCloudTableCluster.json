  "definitions": {
    "Datastore": {
      "properties": {
        "version": {
          "type": "string",
          "example": "1.0.6",
          "description": "controller版本号,默认1.0.6"
        },
        "type": {
          "type": "string",
          "example": "hbase",
          "description": "集群数据库类型"
        }
      },
      "description": "创建集群数据库参数。",
      "required": [
        "version",
        "type"
      ]
    },
    "CreateClusterReqBody": {
      "properties": {
        "cluster_name": {
          "type": "string",
          "example": "cloudtable-zym-doris-202305306",
          "description": "集群名字"
        },
        "datastore": {
          "description": "集群内核引擎",
          "$ref": "#/definitions/Datastore"
        },
        "availability_zone": {
          "type": "string",
          "example": "cn-north-7c",
          "description": "可用区"
        },
        "nics": {
          "description": "子网安全组等网络信息",
          "$ref": "#/definitions/Nics"
        },
        "cluster_info": {
          "description": "集群详情",
          "required": [
            "feature_map",
            "cluster_instance_info"
          ],
          "properties": {
            "feature_map": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "特性属性开关\n     * 属性开关必须以enable开头,value必须为true|false\n     * doris: enable_broker\n     * hbase: storage_io_type(COMMON,ULTRAHIGH,两种取值),enable_open_tsdb(默认false,若为true需要在集群节点信息列表中指定tsd节点个数),enable_broker\n     示例:\n     \"feature_map\":{\"enable_broker\":\"false\"}\n      \"feature_map\":{\"enable_lemon\":\"false\",\"enable_open_tsdb\":\"false\",\"storage_io_type\": \"COMMON\"}",
              "example": ""
            },
            "cluster_instance_info": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/CreateClusterInstanceBody"
              },
              "description": "集群节点信息类"
            }
          }
        },
        "enterprise_project_id": {
          "type": "string",
          "example": 0,
          "description": "企业项目ID"
        },
        "vpc_id": {
          "type": "string",
          "example": "0c950906-8caf-4c08-862a-8abe3947b3cf",
          "description": "虚拟私有云ID"
        },
        "dbuser": {
          "type": "string",
          "example": "admin",
          "description": "type为doris时,必填项,管理账号:admin"
        },
        "dbuserpwd": {
          "type": "string",
          "example": "Huawei@123",
          "description": "type为doris时,必填项,管理账号密码"
        }
      },
      "description": "创建集群发起的请求的请求体对象。",
      "required": [
        "cluster_name",
        "datastore",
        "availability_zone",
        "nics",
        "cluster_info",
        "vpc_id"
      ],
      "type": "object"
    },
    "CreateCloudtableClusterResponseBody": {
      "type": "object",
      "description": "创建集群成功后返回的集群ID",
      "required": [
        "cluster_id"
      ],
      "properties": {
        "cluster_id": {
          "type": "string",
          "example": "e194bbd6-e1a4-4ab6-b6ea-3d75db6316da",
          "description": "集群ID"
        },
        "jobId": {
          "type": "string",
          "example": "2c9080288c627a7c018c62e0965602dc"
        },
        "getJobEndpoint": {
          "type": "string",
          "example": "https://****/v1.0/jobs/2c9080288c627a7c018c62e0965602dc"
        }
      }
    },
    "CreateClusterInstanceBody": {
      "type": "object",
      "required": [
        "instance_type",
        "instance_num"
      ],
      "properties": {
        "instance_type": {
          "type": "string",
          "example": "",
          "description": "集群节点类型,hbase有regionserver,hmaster,opentsdb等,doris有be,fe节点,clickhouse有server(计算节点),zookeeper"
        },
        "instance_num": {
          "type": "integer",
          "format": "int32",
          "example": "",
          "minimum": 1,
          "description": "节点个数,hbase取值:2<=num<=10],偶数\ndoris取值:be[3,100]\nfe只能是3或5,\nclickhouse取值:计算节点[2,10000],取偶数,zookeeper节点固定为3"
        },
        "flavor": {
          "type": "string",
          "example": "",
          "description": "节点规格,doris集群、clickhouse集群必选"
        },
        "volume_type": {
          "type": "string",
          "example": "",
          "description": "数据盘规格:COMMON、HIGH、ULTRAHIGH,NORMALHIGH, EXTREMEHIGH. doris集群、clickhouse集群必选"
        },
        "volume_size": {
          "type": "integer",
          "format": "int32",
          "example": "",
          "minimum": 1,
          "description": "数据盘大小,doris集群、clickhouse集群必选。\nfe[200,2000]\nbe[400,10000]\nserver[500,10000]\nzookeeper[200,1000]"
        },
        "flavor_type": {
          "type": "string",
          "description": "节点入参类型 0:flavor模式 ,1:cu模式,doris、hbase、clickhouse都是flavor模式"
        }
      }
    },
    "nic": {
      "type": "object",
      "required": [
        "net_id",
        "security_group_id"
      ],
      "properties": {
        "net_id": {
          "type": "string",
          "example": "47a5bb30-450a-4300-8949-f1e1b049305c",
          "description": "子网ID"
        },
        "security_group_id": {
          "type": "string",
          "example": "0151bc62-4016-46af-af5e-cab8d9e66382",
          "description": "安全组ID"
        }
      }
    },
    "Nics": {
      "description": "集群所在的网络信息以及安全组信息。",
      "type": "array",
      "items": {
        "$ref": "#/definitions/nic"
      }
    }
  },
