{
  "name": "ListTable",
  "summary": "列举表",
  "tags": "仓接口",
  "productshort": "KVS",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/list-table": {
      "post": {
        "tags": [
          "仓接口"
        ],
        "summary": "列举表",
        "operationId": "ListTable",
        "description": "指定仓列举创建的所有表。",
        "x-support-sdk": "Y",
        "consumes": [
          "application/bson"
        ],
        "produces": [
          "application/bson"
        ],
        "parameters": [
          {
            "name": "store_name",
            "in": "query",
            "description": "仓名,全域唯一,不同租户的仓名不能相同。 \n- 格式:${prefix}-${region-code}-${account-id},其中prefix为自定义前缀,region-code为kvs集群所在的区域代码,account-id为用户的账户id\n- 取值字符限制:[a-z0-9-]+\n- 长度:[16,52]\n> \"-\"不能出现在名字头部或尾部",
            "type": "string",
            "x-location-cname": true
          },
          {
            "in": "body",
            "name": "ListTableRequestBody",
            "description": "查询表的请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListTableRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "表示列举表请求成功",
            "schema": {
              "$ref": "#/definitions/ListTableResponseBody"
            },
            "x-response-examples-description-1": "列举表的返回体",
            "x-response-examples-tags-1": "hws",
            "examples": {
              "application/bson": {
                "cursor_name": "test_table_name_3",
                "table_name_list": [
                  "test_table_1",
                  "test_table_2"
                ]
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          }
        },
        "x-request-examples-description-1": "列举指定仓中的表,限制返回表数量为2",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/list-table",
        "x-request-examples-tags-1": "hws",
        "x-request-examples-1": {
          "limit": 2
        }
      }
    }
  },
  "definitions": {
    "ErrorResp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "KVS.00000001",
          "description": "请求返回的错误码。"
        },
        "error_msg": {
          "type": "string",
          "example": "系统遇到内部错误,请重试。",
          "description": "请求返回的错误信息。"
        }
      }
    },
    "ListTableRequestBody": {
      "type": "object",
      "properties": {
        "cursor_name": {
          "type": "string",
          "description": "上次返回游标位置,本次响应包含该table,空表示遍历完。\n- 长度:[3, 63]\n- 取值字符限制:[a-z0-9_-]+\n> 如果为空,表示后面无更多。"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "响应返回的表个数。\n- 长度:最大100"
        }
      }
    },
    "ListTableResponseBody": {
      "required": [
        "cursor_name",
        "table_names"
      ],
      "type": "object",
      "properties": {
        "cursor_name": {
          "type": "string",
          "description": "本次响应后的游标位置,下次请求时携带,如果为空,表示后面无更多。\n- 长度:[3, 63]\n- 取值字符限制:[a-z0-9_-]+\n> 如果为空,表示后面无更多。"
        },
        "table_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "返回的表名列表。\n- 长度:最大100"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kvs.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}