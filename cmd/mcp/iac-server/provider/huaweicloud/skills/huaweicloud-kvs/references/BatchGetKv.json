{
  "name": "BatchGetKv",
  "summary": "批量读请求",
  "tags": "KV接口",
  "productshort": "KVS",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/batch-get-kv": {
      "post": {
        "tags": [
          "KV接口"
        ],
        "summary": "批量读请求",
        "operationId": "BatchGetKv",
        "description": "批量读请求,其中可以携带一或多个表的不同kv的查询操作。",
        "x-support-sdk": "Y",
        "consumes": [
          "application/bson"
        ],
        "produces": [
          "application/bson"
        ],
        "parameters": [
          {
            "name": "store_name",
            "in": "query",
            "description": "仓名",
            "type": "string",
            "x-location-cname": true
          },
          {
            "in": "body",
            "name": "BatchGetKvRequestBody",
            "description": "批量读请求的请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BatchGetKvRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "表示批量读请求成功",
            "schema": {
              "$ref": "#/definitions/BatchGetKvResponseBody"
            },
            "x-response-examples-description-1": "批量读请求的响应体,包括批量读取的所有kv。",
            "x-response-examples-tags-1": "hws",
            "examples": {
              "application/bson": {
                "returned_kv_items_of_all": [
                  {
                    "table_name": "test_table_1",
                    "returned_kv_items": {
                      "primary_key": {
                        "owner": "user_3",
                        "filename": "test_file_3"
                      },
                      "blob_data": "binary_blob_data",
                      "xattr": "binary_xattr_data"
                    }
                  }
                ]
              }
            }
          }
        },
        "x-request-examples-description-1": "批量读请求,从test-table-1表中批量读取数据。",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/batch-get-kv",
        "x-request-examples-tags-1": "hws",
        "x-request-examples-1": {
          "batch_get_kv_opers": [
            {
              "batch_get_kv_opers": {
                "table_name": "test_table_1",
                "get_kv_opers": [
                  {
                    "get_kv": {
                      "oper_id": 3,
                      "primary_key": {
                        "owner": "user_3",
                        "filename": "test_file_3"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "returned_kv_items_of_table": {
      "required": [
        "table_name"
      ],
      "type": "object",
      "properties": {
        "table_name": {
          "type": "string",
          "description": "表名,仓内唯一。\n- 长度:[3, 63]\n- 取值字符限制:[a-z0-9_-]+"
        },
        "returned_kv_items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/returned_kv_item",
            "description": "返回的kv列表,与scan_kv的kv_array相同。"
          }
        }
      }
    },
    "returned_kv_item": {
      "type": "object",
      "properties": {
        "kv_doc": {
          "type": "string",
          "format": "bson-document",
          "description": "对kv_doc有效。"
        }
      },
      "description": "kv元素。"
    },
    "BatchGetKvResponseBody": {
      "required": [
        "exception_opers"
      ],
      "type": "object",
      "properties": {
        "exception_opers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/exception_opers_of_table"
          },
          "description": "异常处理的操作,按照table分类组织。"
        },
        "returned_kv_items_of_all": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/returned_kv_items_of_table"
          },
          "description": "返回的kvdoc列表,按照table分类组织。"
        }
      }
    },
    "exception_opers_of_table": {
      "required": [
        "table_name"
      ],
      "type": "object",
      "properties": {
        "table_name": {
          "type": "string",
          "description": "表名,仓内唯一。\n- 长度:[3, 63]\n- 取值字符限制:[a-z0-9_-]+"
        },
        "unprocessed_opers": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "description": "未处理的操作列表。\n- 数组元素:未处理的操作标识。"
        },
        "failed_opers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fail"
          },
          "description": "失败的操作列表,可以是多个。"
        }
      }
    },
    "BatchGetKvRequestBody": {
      "required": [
        "batch_get_kv_opers"
      ],
      "type": "object",
      "properties": {
        "batch_get_kv_opers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/batch_get_kv_of_table"
          },
          "description": "按照table分类组织的get操作。"
        }
      }
    },
    "fail": {
      "required": [
        "oper_id",
        "status"
      ],
      "type": "object",
      "properties": {
        "oper_id": {
          "type": "integer",
          "format": "int32",
          "description": "失败的操作标识,1个或多个。"
        },
        "status": {
          "type": "string",
          "description": "处理失败操作提示。"
        }
      },
      "description": "失败的操作指示。"
    },
    "batch_get_kv_of_table": {
      "required": [
        "table_name",
        "get_kv_opers"
      ],
      "type": "object",
      "properties": {
        "table_name": {
          "type": "string",
          "description": "表名,仓内唯一。\n- 长度:[3, 63]\n- 取值字符限制:[a-z0-9_-]+"
        },
        "get_kv_opers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/get_oper"
          },
          "description": "行操作数组,行操作类型可以是多个文档的get。"
        }
      },
      "description": "单个表的所有kv操作。"
    },
    "get_oper": {
      "type": "object",
      "properties": {
        "get_kv": {
          "type": "object",
          "$ref": "#/definitions/get_kv"
        }
      }
    },
    "get_kv": {
      "required": [
        "oper_id",
        "primary_key"
      ],
      "type": "object",
      "properties": {
        "oper_id": {
          "type": "integer",
          "format": "int32",
          "description": "请求内的操作编码,未成功的操作返回该标识。"
        },
        "primary_key": {
          "type": "string",
          "format": "bson-document",
          "description": "用户自定义的主键名及值。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kvs.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}