{
  "name": "ListStore",
  "summary": "列举仓",
  "tags": "仓接口",
  "productshort": "KVS",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/list-store": {
      "post": {
        "tags": [
          "仓接口"
        ],
        "summary": "列举仓",
        "operationId": "ListStore",
        "description": "一个账户下可以创建最多25个仓,每个仓可以创建最多100个store,响应中一次性返回所有仓名称。",
        "x-support-sdk": "Y",
        "consumes": [
          "application/bson"
        ],
        "produces": [
          "application/bson"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "ListStoreRequestBody",
            "description": "列举仓请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListStoreRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "表示列举仓成功。",
            "schema": {
              "$ref": "#/definitions/ListStoreResponseBody"
            },
            "x-response-examples-description-1": "列举仓的返回体",
            "x-response-examples-tags-1": "hws",
            "examples": {
              "application/bson": {
                "cursor_name": "test_store_name_3",
                "table_name_list": [
                  "test_store_1",
                  "test_store_2"
                ]
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          }
        },
        "x-request-examples-description-1": "列举用户账户下的仓,从指定仓名位置开始返回,限制返回仓名数量2个。",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/list-store",
        "x-request-examples-tags-1": "hws",
        "x-request-examples-1": {
          "limit": 2
        }
      }
    }
  },
  "definitions": {
    "ErrorResp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "KVS.00000001",
          "description": "请求返回的错误码。"
        },
        "error_msg": {
          "type": "string",
          "example": "系统遇到内部错误,请重试。",
          "description": "请求返回的错误信息。"
        }
      }
    },
    "ListStoreRequestBody": {
      "type": "object",
      "properties": {
        "cursor_name": {
          "type": "string",
          "description": "上次返回的游标位置,本次响应包含该仓名。\n- 长度:[16,52]\n- 取值字符限制:[a-z0-9-]+"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "响应返回的仓个数。"
        }
      }
    },
    "ListStoreResponseBody": {
      "required": [
        "cursor_name",
        "stores"
      ],
      "type": "object",
      "properties": {
        "cursor_name": {
          "type": "string",
          "description": "本次响应后的游标位置,下次请求时携带。 - 长度:[16,52] - 取值字符限制:[a-z0-9-]+ > 如果为空,表示后面无更多仓名。"
        },
        "stores": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "返回的仓名列表。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kvs.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}