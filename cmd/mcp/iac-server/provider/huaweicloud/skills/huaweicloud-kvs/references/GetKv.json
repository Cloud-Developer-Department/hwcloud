{
  "name": "GetKv",
  "summary": "查询单个kv",
  "tags": "KV接口",
  "productshort": "KVS",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/get-kv": {
      "post": {
        "tags": [
          "KV接口"
        ],
        "summary": "查询单个kv",
        "operationId": "GetKv",
        "description": "下载一个kv文档的全部内容,或者部分字段的内容。",
        "x-support-sdk": "Y",
        "consumes": [
          "application/bson"
        ],
        "produces": [
          "application/bson"
        ],
        "parameters": [
          {
            "name": "store_name",
            "in": "query",
            "description": "仓名,全域唯一,不同租户的仓名不能相同。 \n- 格式:${prefix}-${region-code}-${account-id},其中prefix为自定义前缀,region-code为kvs集群所在的区域代码,account-id为用户的账户id\n- 取值字符限制:[a-z0-9-]+\n- 长度:[16,52]\n> \"-\"不能出现在名字头部或尾部",
            "type": "string",
            "x-location-cname": true
          },
          {
            "in": "body",
            "name": "GetKvRequestBody",
            "description": "下载kv的请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GetKvRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "表示查询单个kv请求成功",
            "schema": {
              "$ref": "#/definitions/GetKvResponseBody"
            },
            "x-response-examples-description-1": "查询单个kv的返回体",
            "x-response-examples-tags-1": "hws",
            "examples": {
              "application/bson": {
                "kv_doc": {
                  "owner": "user_1",
                  "filename": "test_file_1",
                  "otherKey": "otherValue"
                }
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          }
        },
        "x-request-examples-description-1": "下载一个kv,表名为test-table-1,设置分区键值为user1,排序键值为test-file-1。",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/get-kv",
        "x-request-examples-tags-1": "hws",
        "x-request-examples-1": {
          "table_name": "test_table_1",
          "primary_key": {
            "owner": "user_1",
            "filename": "test_file_1"
          }
        }
      }
    }
  },
  "definitions": {
    "GetKvRequestBody": {
      "required": [
        "table_name",
        "primary_key"
      ],
      "type": "object",
      "properties": {
        "table_name": {
          "type": "string",
          "description": "表名,仓内唯一。\n- 长度:[3, 63]\n- 取值字符限制:[a-z0-9_-]+"
        },
        "primary_key": {
          "type": "string",
          "format": "bson-document",
          "description": "用户自定义的主键名及值。"
        }
      }
    },
    "ErrorResp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "KVS.00000001",
          "description": "请求返回的错误码。"
        },
        "error_msg": {
          "type": "string",
          "example": "系统遇到内部错误,请重试。",
          "description": "请求返回的错误信息。"
        }
      }
    },
    "GetKvResponseBody": {
      "type": "object",
      "properties": {
        "kv_doc": {
          "type": "string",
          "format": "bson-document",
          "description": "对kv_doc有效。\n> 内容字段:主键字段+投影字段或者全部字段。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kvs.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}