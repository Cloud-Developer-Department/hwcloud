{
  "name": "CreateTable",
  "summary": "创建表",
  "tags": "仓接口",
  "productshort": "KVS",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/create-table": {
      "post": {
        "tags": [
          "仓接口"
        ],
        "summary": "创建表",
        "operationId": "CreateTable",
        "description": "在指定仓内创建表,表名在仓内唯一;创建表时,指定主键模板及本地二级索引模板及全局二级索引模板。创建表时,如果仓不存在,将会自动创建仓。",
        "x-support-sdk": "Y",
        "consumes": [
          "application/bson"
        ],
        "produces": [
          "application/bson"
        ],
        "parameters": [
          {
            "name": "store_name",
            "in": "query",
            "description": "仓名,全域唯一,不同租户的仓名不能相同。 \n- 格式:${prefix}-${region-code}-${account-id},其中prefix为自定义前缀,region-code为kvs集群所在的区域代码,account-id为用户的账户id\n- 取值字符限制:[a-z0-9-]+\n- 长度:[16,52]\n> \"-\"不能出现在名字头部或尾部",
            "type": "string",
            "x-location-cname": true
          },
          {
            "in": "body",
            "name": "CreateTableRequestBody",
            "description": "创建表的请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateTableRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "表示创建表成功。",
            "schema": {
              "$ref": "#/definitions/CreateTableResponseBody"
            },
            "x-response-examples-description-1": "创建表的返回体,为Table的全量属性。",
            "x-response-examples-tags-1": "hws",
            "examples": {
              "application/bson": {
                "table_name": "test_table",
                "primary_key_schema": {
                  "shard_key_fields": [
                    {
                      "name": "owner",
                      "order": true
                    }
                  ],
                  "sort_key_fields": [
                    {
                      "name": "filename",
                      "order": true
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          },
          "409": {
            "description": "表已存在",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          }
        },
        "x-request-examples-description-1": "创建表,表名为test-table,分区键字段名为owner,排序键字段名称为filename",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/create-table",
        "x-request-examples-tags-1": "hws",
        "x-request-examples-1": {
          "table_name": "test_table",
          "primary_key_schema": {
            "shard_key_fields": [
              {
                "name": "owner",
                "order": true
              }
            ],
            "sort_key_fields": [
              {
                "name": "filename",
                "order": true
              }
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "secondary_index": {
      "required": [
        "index_name",
        "sort_key_fields"
      ],
      "type": "object",
      "description": "二级索引定义,元素key为数组下标。",
      "properties": {
        "index_name": {
          "type": "string",
          "description": "二级索引名称,表内唯一。"
        },
        "sort_key_fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          },
          "description": "排序键字段名数组,顺序组合。"
        },
        "abstract_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "摘要字段名数组。"
        }
      }
    },
    "pre_split_key_options": {
      "type": "object",
      "description": "按照设定的键值前缀进行预分裂。",
      "properties": {
        "range_split_points": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "bson-document"
          },
          "description": "在range分区模式有效,最大10个。"
        }
      }
    },
    "ttl_specification": {
      "required": [
        "enable"
      ],
      "type": "object",
      "description": "TTL设置。非必填项,默认不启用TTL。",
      "properties": {
        "enable": {
          "type": "boolean",
          "description": "TTL开关",
          "default": false
        },
        "expire_after_seconds": {
          "type": "integer",
          "format": "int32",
          "description": "生存时间,以秒为单位"
        },
        "field_name": {
          "type": "string",
          "description": "文档中记录TTL过期时间的字段名,字段值为UTC时间,单位秒"
        }
      }
    },
    "CreateTableRequestBody": {
      "required": [
        "table_name",
        "primary_key_schema"
      ],
      "type": "object",
      "properties": {
        "table_name": {
          "type": "string",
          "description": "表名,仓内唯一。"
        },
        "bill_mode": {
          "type": "string",
          "description": "表计费模式,可为\"provisioned\"或\"on_demand\"\n- 预置模式:provisioned\n- 按需模式:on_demand",
          "default": "on_demand"
        },
        "provisioned_throughput": {
          "$ref": "#/definitions/provisioned_throughput",
          "description": "预置吞吐读写请求单元数,在bill_mode=\"provisioned\"有效"
        },
        "primary_key_schema": {
          "$ref": "#/definitions/primary_key_schema",
          "description": "主键模板, 最多1个,必须指定主键schema。"
        },
        "local_secondary_index_schema": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/secondary_index"
          },
          "description": "本地二级索引模板,可以多个。"
        },
        "global_secondary_index_schema": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/global_secondary_index"
          },
          "description": "全局二级索引模板。"
        },
        "pre_split_key_options": {
          "$ref": "#/definitions/pre_split_key_options",
          "description": "按照设定的分裂键值或者键值前缀进行预分裂.\n> range分区时该参数有效,且只作用于主表,其他场景无效。"
        },
        "ttl_specification": {
          "$ref": "#/definitions/ttl_specification",
          "description": "设置表或行级TTL。"
        },
        "sse_specification": {
          "$ref": "#/definitions/sse_specification",
          "description": "用户数据静态加密设置。非必填项,默认不启用静态加密。"
        }
      }
    },
    "ErrorResp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "KVS.00000001",
          "description": "请求返回的错误码。"
        },
        "error_msg": {
          "type": "string",
          "example": "系统遇到内部错误,请重试。",
          "description": "请求返回的错误信息。"
        }
      }
    },
    "global_secondary_index": {
      "required": [
        "index_name",
        "shard_key_fields"
      ],
      "type": "object",
      "properties": {
        "index_name": {
          "type": "string",
          "description": "二级索引名称,表内唯一。"
        },
        "shard_key_fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          },
          "description": "分区键字段名数组,顺序组合。"
        },
        "shard_mode": {
          "type": "string",
          "description": "分区模式。"
        },
        "sort_key_fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          },
          "description": "排序键字段名数组,顺序组合。"
        },
        "abstract_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "摘要字段名数组。"
        },
        "provisioned_throughput": {
          "$ref": "#/definitions/provisioned_throughput",
          "description": "预置吞吐读写请求单元数,在bill_mode=\"provisioned\"有效"
        }
      }
    },
    "provisioned_throughput": {
      "required": [
        "rcu",
        "wcu"
      ],
      "type": "object",
      "properties": {
        "rcu": {
          "type": "integer",
          "format": "int64",
          "description": "预置表级读请求单元数",
          "default": 0
        },
        "wcu": {
          "type": "integer",
          "format": "int64",
          "description": "预置表级写请求单元数",
          "default": 0
        }
      }
    },
    "sse_specification": {
      "type": "object",
      "description": "用户数据静态加密设置。非必填项,默认不启用静态加密。",
      "required": [
        "enable"
      ],
      "properties": {
        "enable": {
          "type": "boolean",
          "description": "启用静态加密。"
        },
        "sse_type": {
          "type": "string",
          "description": "加密类型,支持SSE-KMS-S和SSE-KMS-C。"
        },
        "sse_algorithm": {
          "type": "string",
          "description": "加密算法,支持AES256_GCM。"
        },
        "cmk_id": {
          "type": "string",
          "description": "KMS中的用户主密钥ID。非必填项,仅当加密类型是SSE-KMS-C时需要填写该字段。"
        }
      }
    },
    "CreateTableResponseBody": {
      "required": [
        "table_name",
        "primary_key_schema"
      ],
      "type": "object",
      "properties": {
        "table_name": {
          "type": "string",
          "description": "表名,仓内唯一。"
        },
        "bill_mode": {
          "type": "string",
          "description": "计费模式,可为\"provisioned\"或\"on_demand\""
        },
        "provisioned_throughput": {
          "$ref": "#/definitions/provisioned_throughput",
          "description": "预置吞吐读写请求单元数,在bill_mode=\"provisioned\"有效"
        },
        "primary_key_schema": {
          "$ref": "#/definitions/primary_key_schema",
          "description": "主键模板, 最多1个,必须指定主键schema。"
        },
        "local_secondary_index_schema": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/secondary_index"
          },
          "description": "本地二级索引模板,可以多个。"
        },
        "global_secondary_index_schema": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/global_secondary_index"
          },
          "description": "全局二级索引模板。"
        },
        "pre_split_key_options": {
          "$ref": "#/definitions/pre_split_key_options",
          "description": "按照设定的分裂键值或者键值前缀进行预分裂.\n> range分区时该参数有效,且只作用于主表,其他场景无效。"
        },
        "ttl_specification": {
          "$ref": "#/definitions/ttl_specification",
          "description": "设置表或行级TTL。"
        },
        "sse_specification": {
          "$ref": "#/definitions/sse_specification",
          "description": "用户数据静态加密设置。非必填项,默认不启用静态加密。"
        }
      }
    },
    "field": {
      "required": [
        "name"
      ],
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "字段名。"
        },
        "order": {
          "type": "boolean",
          "description": "bool值预留无意义。"
        }
      }
    },
    "primary_key_schema": {
      "required": [
        "shard_key_fields"
      ],
      "type": "object",
      "properties": {
        "shard_key_fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          },
          "description": "分区键字段名数组,顺序组合。"
        },
        "shard_mode": {
          "type": "string",
          "description": "分区模式。"
        },
        "sort_key_fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          },
          "description": "排序键字段名数组,顺序组合。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kvs.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}