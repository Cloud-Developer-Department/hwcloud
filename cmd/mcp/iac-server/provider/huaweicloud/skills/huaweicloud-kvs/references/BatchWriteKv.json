          "type": "string",
          "description": "多字段条件,多个相同优先级的单字段条件。"
        },
        "expressions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/single_field_expression"
          },
          "description": "多个相同逻辑操作的单字段条件。"
        }
      }
    },
    "single_kv_expression": {
      "required": [
        "func"
      ],
      "type": "object",
      "properties": {
        "func": {
          "type": "string",
          "description": "取值:\"is_doc\", \"is_blob\", \"is_exist\", \"not_exist\"。"
        }
      }
    },
