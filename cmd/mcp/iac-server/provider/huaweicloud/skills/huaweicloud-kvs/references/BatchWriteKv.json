      "properties": {
        "table_name": {
          "type": "string",
          "description": "表名,仓内唯一。\n- 长度:[3, 63]\n- 取值字符限制:[a-z0-9_-]+"
        },
        "kv_opers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/oper_item"
          },
          "description": "kv操作数组。"
        }
      },
      "description": "单个表的所有kv操作。"
    },
    "BatchWriteKvRequestBody": {
