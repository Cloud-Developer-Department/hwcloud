{
  "name": "ListOffers",
  "summary": "查询指定连接器下的offer列表",
  "tags": "offer",
  "productshort": "EDS",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eds/instances/{instance_id}/connectors/{connector_id}/offers": {
      "post": {
        "tags": [
          "offer"
        ],
        "summary": "查询指定连接器下的offer列表",
        "description": "查询指定连接器下的offer列表",
        "operationId": "ListOffers",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)",
            "required": true,
            "type": "string",
            "maxLength": 100000,
            "minLength": 1
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,租户+REGION确定唯一项目",
            "required": true,
            "type": "string"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID,开通的数据交换平台实例ID",
            "required": true,
            "type": "string"
          },
          {
            "name": "connector_id",
            "in": "path",
            "description": "连接器ID,指定数据交换平台下连接器的ID",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "body",
            "required": false,
            "schema": {
              "$ref": "#/definitions/OfferPage"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/OfferListResponseBody"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "OfferPage": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "分页"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "example": 10,
          "description": "分页大小"
        },
        "offer_name": {
          "type": "string",
          "example": "xxx",
          "description": "邀约名称"
        }
      },
      "description": "查询列表"
    },
    "OfferListResponseBody": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "总数"
        },
        "entities": {
          "type": "array",
          "description": "合约列表",
          "items": {
            "$ref": "#/definitions/OfferListResponseBodyEntities"
          },
          "maxItems": 9999,
          "minItems": 0
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string"
        },
        "error_msg": {
          "type": "string"
        }
      }
    },
    "OfferListResponseBodyEntities": {
      "type": "object",
      "properties": {
        "offer_id": {
          "type": "string",
          "description": "合约ID"
        },
        "offer_code": {
          "type": "string",
          "description": "合约编码"
        },
        "offer_name": {
          "type": "string",
          "description": "合约名称"
        },
        "offer_description": {
          "type": "string",
          "description": "合约描述"
        },
        "create_time": {
          "type": "string",
          "description": "合约创建时间"
        },
        "offer_status": {
          "type": "string",
          "description": "合约状态"
        }
      }
    }
