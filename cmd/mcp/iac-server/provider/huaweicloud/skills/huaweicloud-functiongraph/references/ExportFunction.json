{
  "name": "ExportFunction",
  "summary": "导出函数",
  "tags": "函数导入导出",
  "productshort": "FunctionGraph",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/fgs/functions/{function_urn}/export": {
      "get": {
        "tags": [
          "函数导入导出"
        ],
        "summary": "导出函数",
        "description": "导出函数",
        "operationId": "ExportFunction",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/function_urn"
          },
          {
            "name": "config",
            "in": "query",
            "description": "是否导出函数配置,默认为false。若无type参数,则必填code=true或config=true至少一项。",
            "required": false,
            "type": "boolean",
            "default": false
          },
          {
            "name": "code",
            "in": "query",
            "description": "是否导出函数代码,默认为false。若无type参数,则必填code=true或config=true至少一项。",
            "required": false,
            "type": "boolean",
            "default": false
          },
          {
            "name": "type",
            "in": "query",
            "description": "不兼容与code、config参数混用;type=code代表导出代码,type=config代码导出配置",
            "required": false,
            "type": "string"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Content-Type"
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          },
          "404": {
            "description": "Not Found 找不到资源。",
            "examples": {
              "application/json": {
                "error_code": "FSS.1051",
                "error_msg": "Not found the function"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          },
          "500": {
            "description": "Internal Server Error 服务内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          }
        },
        "x-request-examples-description-1": "导出函数代码(新方式)。",
        "x-request-examples-url-1": "GET /v2/{project_id}/fgs/functions/{func_urn}/export?type=code",
        "x-request-examples-description-2": "导出函数代码与配置(老方式)。",
        "x-request-examples-url-2": "GET /v2/{project_id}/fgs/functions/{func_urn}/export?code=true&config=true",
        "x-support-sdk": "Y",
        "x-produc-type": "functiongraph"
      }
    }
  },
  "definitions": {
    "ErrorResp": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
