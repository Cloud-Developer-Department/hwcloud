  "paths": {
    "/v2/{project_id}/fgs/functions/statistics": {
      "get": {
        "tags": [
          "函数指标"
        ],
        "summary": "租户函数统计信息",
        "description": "租户函数统计信息。\n\n返回三类的统计信息,函数格式和大小使用情况包括配额和使用量,流量报告。\n通过查询参数filter可以进行过滤,查询参数period可以指定返回的时间段。",
        "operationId": "ListStatistics",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "filter",
            "in": "query",
            "description": "参数过滤器。\nmonitor_data: 查询统计信息。\nmonthly_report:查询月度统计信息。",
            "required": true,
            "type": "string",
            "enum": [
              "monitor_data",
              "monthly_report"
            ],
            "x-example": "metric",
            "x-order": 2
          },
          {
            "name": "period",
            "in": "query",
            "description": "时间段单位为分钟,与filter参数metric配合使用。",
            "required": false,
            "type": "string",
            "x-example": "5",
            "x-order": 3
          },
          {
            "name": "option",
            "in": "query",
            "description": "月度统计的维度,filter参数取值为monthly_report时才生效。\n当取值不在以上范围时,默认取\"0\"。\n- \"0\": 表示统计本月。\n- \"1\": 表示统计上月。\n- \"2\": 表示统计最近三个月。\n- \"3\": 表示统计最近六个月。",
            "required": false,
            "type": "string",
            "x-example": "2",
            "x-order": 4
          },
          {
            "name": "limit",
            "in": "query",
            "description": "本次查询最大返回的数据条数,最大值500,默认值100",
            "required": false,
            "type": "string",
            "default": "100",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "name": "marker",
            "in": "query",
            "description": "本次查询起始位置,默认值0",
            "required": false,
            "type": "string",
            "default": "0",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Content-Type"
          }
