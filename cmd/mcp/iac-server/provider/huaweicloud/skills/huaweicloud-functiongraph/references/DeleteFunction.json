  "paths": {
    "/v2/{project_id}/fgs/functions/{function_urn}": {
      "delete": {
        "tags": [
          "函数生命周期管理"
        ],
        "summary": "删除函数/版本",
        "description": "删除指定的函数或者特定的版本(不允许删除latest版本)。\n\n如果URN中包含函数版本或者别名,则删除特定的函数版本或者别名指向的版本以及该版本关联的trigger。\n如果URN中不包含版本或者别名,则删除整个函数,包含所有版本以及别名,触发器。",
        "operationId": "DeleteFunction",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "function_urn",
            "in": "path",
            "description": "函数的URN,详细解释见FunctionGraph函数模型的描述。\n\n不允许删除函数的latest版本,如要删除整个函数(包含所有版本),提供不带任何版本号/别名的urn,如:\nurn:fss:xxxxxxxx:7aad83af3e8d42e99ac194e8419e2c9b:function:default:test",
            "required": true,
            "type": "string",
            "x-order": 2
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Content-Type"
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized 鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          },
          "403": {
            "description": "Forbidden 没有操作权限。",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          },
          "404": {
            "description": "Not Found 找不到资源。",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          },
          "500": {
            "description": "Internal Server Error 服务内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          }
        },
        "x-request-examples-description-1": "删除租户指定函数/版本。",
        "x-request-examples-url-1": "DELETE https://{Endpoint}/v2/{project_id}/fgs/functions/{func_urn}",
