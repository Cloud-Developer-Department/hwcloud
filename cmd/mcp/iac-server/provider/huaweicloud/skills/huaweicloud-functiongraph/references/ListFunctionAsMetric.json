{
  "name": "ListFunctionAsMetric",
  "summary": "获取按指定指标排序的函数列表",
  "tags": "函数指标",
  "productshort": "FunctionGraph",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/fgs/function/report": {
      "get": {
        "tags": [
          "函数指标"
