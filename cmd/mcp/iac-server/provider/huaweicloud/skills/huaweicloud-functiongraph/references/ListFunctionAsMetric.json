        "summary": "获取按指定指标排序的函数列表",
        "description": "按指定指标排序的函数列表。\n\n默认统计按错误次数指标统计最近一天失败次数最多的前10个函数",
        "operationId": "ListFunctionAsMetric",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "type",
            "description": "指标类型,默认值为failcount。",
            "type": "string",
            "in": "query",
            "x-example": "failcount",
            "x-order": 2
          },
          {
            "name": "start_time",
            "description": "起始时间。",
            "type": "string",
            "in": "query",
            "x-example": "1658073600",
            "x-order": 3
          },
          {
            "name": "end_time",
            "description": "结束时间。",
            "type": "string",
            "in": "query",
            "x-example": "1658160000",
            "x-order": 4
          },
          {
            "name": "limit",
            "description": "指标类型,默认值为failcount。",
            "type": "string",
            "in": "query",
            "x-example": "10",
            "x-order": 5
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Content-Type"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "examples": {
              "application/json": {
                "next_marker": 2,
                "count": 2,
                "values": [
                  {
                    "key": "funcUrn1",
                    "value": 1
                  },
                  {
                    "key": "funcUrn2",
                    "value": 2
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListFunctionAsMetricResponseBody"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          }
        },
        "x-request-examples-description-1": "获取按指定指标排序的函数列表。",
        "x-request-examples-url-1": "GET /v2/{project_id}/fgs/function/report",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "functiongraph_06_0150",
        "x-produc-type": "functiongraph"
      }
    }
  },
