  "definitions": {
    "ShowFunctionCodeResponseBody": {
      "required": [
        "code_size",
        "code_type",
        "digest",
        "domain_id",
        "func_name",
        "func_urn",
        "last_modified",
        "runtime"
      ],
      "properties": {
        "func_urn": {
          "type": "string",
          "description": "函数的URN(Uniform Resource Name),唯一标识函数。"
        },
        "func_name": {
          "type": "string",
          "description": "函数名称。"
        },
        "domain_id": {
          "type": "string",
          "description": "域名id。"
        },
        "runtime": {
          "type": "string",
          "description": "FunctionGraph函数的执行环境\nJava8: Java语言8版本。\nJava11: Java语言11版本。\nJava17: Java语言17版本(当前仅支持华北-乌兰察布二零二)\nPython2.7: Python语言2.7版本。\nPython3.6: Pyton语言3.6版本。\nPython3.9: Python语言3.9版本。\nPython3.10: Python语言3.10版本。\nGo1.8: Go语言1.8版本。\nGo1.x: Go语言1.x版本。\nNode.js6.10: Nodejs语言6.10版本。\nNode.js8.10: Nodejs语言8.10版本。\nNode.js10.16: Nodejs语言10.16版本。\nNode.js12.13: Nodejs语言12.13版本。\nNode.js14.18: Nodejs语言14.18版本。\nNode.js16.17: Nodejs语言16.17版本。\nNode.js18.15: Nodejs语言18.15版本。\nC#(.NET Core 2.0): C#语言2.0版本。\nC#(.NET Core 2.1): C#语言2.1版本。\nC#(.NET Core 3.1): C#语言3.1版本。\nC#(.NET Core 6.0): C#语言6.0版本(当前仅支持华北-乌兰察布二零二)。\nCustom: 自定义运行时。\nPHP7.3: Php语言7.3版本。\nPHP8.3: Php语言8.3版本。\nCangjie1.0:仓颉语言1.0版本。\nhttp: HTTP函数。\nCustom Image: 自定义镜像函数。",
          "enum": [
            "Java8",
            "Java11",
            "Java17",
            "Python2.7",
            "Python3.6",
            "Python3.9",
            "Python3.10",
            "Go1.8",
            "Go1.x",
            "Node.js6.10",
            "Node.js8.10",
            "Node.js10.16",
            "Node.js12.13",
            "Node.js14.18",
            "Node.js16.17",
            "Node.js18.15",
            "C#(.NET Core 2.0)",
            "C#(.NET Core 2.1)",
            "C#(.NET Core 3.1)",
            "C#(.NET Core 6.0)",
            "Custom",
            "PHP7.3",
            "PHP8.3",
            "Cangjie1.0",
            "http",
            "Custom Image"
          ]
        },
        "code_type": {
          "type": "string",
          "description": "函数代码类型,取值有5种。\ninline: UI在线编辑代码。\nzip: 函数代码为zip包。\nobs: 函数代码来源于obs存储。\njar: 函数代码为jar包,主要针对Java函数。\nCustom-Image-Swr: 函数代码来源与SWR自定义镜像。",
          "enum": [
            "inline",
            "zip",
            "obs",
            "jar",
            "Custom-Image-Swr"
          ]
        },
        "code_url": {
          "type": "string",
          "description": "当CodeType为obs时,该值为函数代码包在OBS上的地址,CodeType为其他值时,该字段为空。"
        },
        "code_filename": {
          "type": "string",
          "description": "函数的文件名,当CodeType为jar/zip时必须提供该字段,inline和obs不需要提供。"
        },
        "code_size": {
          "type": "integer",
          "format": "int64",
          "description": "函数大小,单位:字节。"
        },
        "digest": {
          "type": "string",
          "description": "函数代码SHA512 hash值,用于判断函数是否变化。"
        },
        "last_modified": {
          "type": "string",
          "format": "date-time",
          "description": "函数最后一次更新时间。"
        },
        "func_code": {
          "$ref": "#/definitions/FuncCode"
        },
        "depend_list": {
          "type": "array",
          "description": "依赖id列表",
          "items": {
            "type": "string"
          }
        },
        "depend_version_list": {
          "type": "array",
          "description": "依赖版本id列表",
          "items": {
            "type": "string"
          }
        },
        "strategy_config": {
          "$ref": "#/definitions/StrategyConfig"
        },
        "dependencies": {
          "type": "array",
          "description": "函数依赖代码包列表。",
          "items": {
            "$ref": "#/definitions/Dependency"
          }
        }
      },
      "description": "函数代码属性结构体。"
    },
    "ErrorResp": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      }
    },
    "StrategyConfig": {
      "required": [
        "concurrency",
        "concurrent_num"
      ],
      "properties": {
        "concurrency": {
          "type": "integer",
          "format": "int32",
          "description": "单函数最大实例数,v1取值0和-1,v2取值-1到1000\n-1代表该函数实例数无限制\n0代表该函数被禁用"
        },
        "concurrent_num": {
          "type": "integer",
          "format": "int32",
          "description": "单实例并发数,v2版本才支持,取值1到1000"
        }
      },
      "description": "函数策略配置。"
    },
    "FuncCode": {
      "properties": {
        "file": {
          "type": "string",
          "description": "函数代码,如果不为空必须进行base64编码,为空时使用默认的代码。"
        },
        "link": {
          "type": "string",
          "description": "函数代码链接。"
        }
      },
      "description": "FuncCode结构返回体。"
    },
    "Dependency": {
      "required": [
        "description",
        "etag",
        "link",
        "name",
        "owner",
        "runtime",
        "size"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "依赖包版本ID。",
          "example": "6578de50-9a18-48fa-b84e-b2d36636e433"
        },
        "owner": {
          "type": "string",
          "description": "依赖包属主的domainId。"
        },
        "link": {
          "type": "string",
          "description": "依赖包在OBS上的链接。"
        },
        "runtime": {
          "type": "string",
          "description": "FunctionGraph函数的执行环境\nJava8: Java语言8版本。\nJava11: Java语言11版本。\nJava17: Java语言17版本(当前仅支持华北-乌兰察布二零二)\nPython2.7: Python语言2.7版本。\nPython3.6: Pyton语言3.6版本。\nPython3.9: Python语言3.9版本。\nPython3.10: Python语言3.10版本。\nGo1.8: Go语言1.8版本。\nGo1.x: Go语言1.x版本。\nNode.js6.10: Nodejs语言6.10版本。\nNode.js8.10: Nodejs语言8.10版本。\nNode.js10.16: Nodejs语言10.16版本。\nNode.js12.13: Nodejs语言12.13版本。\nNode.js14.18: Nodejs语言14.18版本。\nNode.js16.17: Nodejs语言16.17版本。\nNode.js18.15: Nodejs语言18.15版本。\nC#(.NET Core 2.0): C#语言2.0版本。\nC#(.NET Core 2.1): C#语言2.1版本。\nC#(.NET Core 3.1): C#语言3.1版本。\nC#(.NET Core 6.0): C#语言6.0版本(当前仅支持华北-乌兰察布二零二)。\nCustom: 自定义运行时。\nPHP7.3: Php语言7.3版本。\nPHP8.3: Php语言8.3版本。\nCangjie1.0:仓颉语言1.0版本。\nhttp: HTTP函数。\nCustom Image: 自定义镜像函数。",
          "enum": [
            "Java8",
            "Java11",
            "Java17",
            "Python2.7",
            "Python3.6",
            "Python3.9",
            "Python3.10",
            "Go1.8",
            "Go1.x",
            "Node.js6.10",
            "Node.js8.10",
            "Node.js10.16",
            "Node.js12.13",
            "Node.js14.18",
            "Node.js16.17",
            "Node.js18.15",
            "C#(.NET Core 2.0)",
            "C#(.NET Core 2.1)",
            "C#(.NET Core 3.1)",
            "C#(.NET Core 6.0)",
            "Custom",
            "PHP7.3",
            "PHP8.3",
            "Cangjie1.0",
            "http",
            "Custom Image"
          ]
        },
        "etag": {
          "type": "string",
          "description": "依赖包的md5值"
        },
        "size": {
          "type": "integer",
          "format": "int64",
          "description": "依赖包大小。"
        },
        "name": {
          "type": "string",
          "description": "依赖包名称。"
        },
        "description": {
          "type": "string",
          "description": "依赖包描述。"
        },
        "file_name": {
          "type": "string",
          "description": "依赖包文件名,如果创建方式为zip时。"
        },
        "version": {
          "type": "integer",
          "format": "int64",
          "description": "依赖包版本编号。"
        },
        "dep_id": {
          "type": "string",
          "description": "依赖包ID",
          "example": "3cf4xxxx-xxxx-xxxx-xxxx-823f0dxxxxxx"
        },
        "last_modified": {
          "type": "integer",
          "format": "int64",
          "description": "依赖包最后一次更新时间。"
        }
      },
      "description": "函数依赖包结构。"
    }
  },
  "version": "2.0",
