      "x-example": "application/json",
      "default": "application/json",
      "description": "消息体的类型(格式)"
    },
    "project_id": {
      "in": "path",
      "name": "project_id",
      "required": true,
      "type": "string",
      "x-example": "46b6f338fc3445b8846c71dfb1fbd9e8",
      "description": "租户项目 ID,获取方式请参见[获取项目ID](functiongraph_06_0260.xml)。"
    },
    "function_urn": {
      "in": "path",
      "name": "function_urn",
      "required": true,
      "type": "string",
      "x-example": "urn:fss:{region}:46b6f338fc3445b8846c71dfb1fbxxxx:function:csharp:test2-0:latest",
      "description": "函数的URN,详细解释见FunctionGraph函数模型的描述。"
    },
    "X-Auth-Token": {
      "in": "header",
      "name": "X-Auth-Token",
