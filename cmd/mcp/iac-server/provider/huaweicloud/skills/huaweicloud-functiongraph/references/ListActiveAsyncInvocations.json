            "default": "0",
            "maxLength": 64,
            "minLength": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "本次查询最大返回的数据条数,最大值500,默认值100",
            "required": false,
            "type": "string",
            "default": "100",
            "maxLength": 64,
            "minLength": 0
          },
          {
