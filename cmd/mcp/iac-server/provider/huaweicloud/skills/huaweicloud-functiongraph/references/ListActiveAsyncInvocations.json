  "definitions": {
    "ErrorResp": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      }
    },
    "ListFunctionAsyncInvocationsResult": {
      "properties": {
        "request_id": {
          "type": "string",
          "description": "异步调用请求ID"
        },
        "status": {
          "type": "string",
          "description": "异步调用状态,支持5种状态\nWAIT: 等待\nRUNNING: 执行中\nSUCCESS: 执行成功\nFAIL: 执行失败\nDISCARD: 请求丢弃",
          "enum": [
            "WAIT",
            "RUNNING",
            "SUCCESS",
            "FAIL",
            "DISCARD"
          ]
        },
        "error_message": {
          "type": "string",
          "description": "异步调用错误信息,如果执行成功,则返回空"
        },
        "error_code": {
          "type": "integer",
          "description": "异步调用错误码,如果执行成功,则返回0"
        },
        "start_time": {
          "type": "string",
          "format": "date-time",
          "description": "异步调用开始时间(格式为YYYY-MM-DD'T'HH:mm:ss,UTC时间)。"
        },
        "end_time": {
          "type": "string",
          "description": "异步调用结束时间(格式为YYYY-MM-DD'T'HH:mm:ss,UTC时间)。"
        }
      },
      "description": "异步调用记录"
    },
    "ListFunctionAsyncInvocationsResponseBody": {
      "properties": {
        "invocations": {
          "type": "array",
          "description": "异步调用记录列表。",
          "items": {
            "$ref": "#/definitions/ListFunctionAsyncInvocationsResult"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "查询数据总条数"
        },
        "next_marker": {
          "type": "integer",
          "format": "int32",
          "description": "查询下一页的起始位置"
        }
      },
      "description": "异步调用记录列表。"
    }
  },
