            "type": "string",
            "format": "date-time",
            "x-example": "2021-01-01T12:00:00"
          },
          {
            "name": "query_end_time",
            "in": "query",
            "description": "搜索结束时间(格式为YYYY-MM-DD'T'HH:mm:ss,UTC时间)。如果不指定默认为当前时间",
            "required": false,
            "type": "string",
            "format": "date-time",
            "x-example": "2021-01-01T14:00:00"
