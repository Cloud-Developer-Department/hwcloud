            "required": false,
            "description": "虚拟机id",
            "type": "string"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "查询时间范围的起始时间,毫秒时间戳,默认0,默认查询从三天前。",
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "查询时间范围的终止时间,毫秒时间戳,默认0,默认查询到当前时间。",
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "description": "统计数据周期,默认0,默认周期为5分钟",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "统计值类型,默认min,默认查询最小值",
