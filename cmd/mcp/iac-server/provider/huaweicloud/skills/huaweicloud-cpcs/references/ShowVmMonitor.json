  "definitions": {
    "Datapoint": {
      "type": "object",
      "description": "时间点的统计数据",
      "properties": {
        "max": {
          "type": "number",
          "format": "double",
          "description": "最大值,未计算默认为0"
        },
        "min": {
          "type": "number",
          "format": "double",
          "description": "最小值,未计算默认为0"
        },
        "average": {
          "type": "number",
          "format": "double",
          "description": "平均值,未计算默认为0"
        },
        "sum": {
          "type": "number",
          "format": "double",
          "description": "综合,未计算默认为0"
        },
        "variance": {
          "type": "number",
          "format": "double",
          "description": "方差,未计算默认为0"
        },
        "timestamp": {
          "type": "integer",
          "format": "int64",
          "description": "毫秒时间戳"
        },
        "unit": {
          "type": "string",
          "description": "数据单位,比如%,个"
        }
      }
    },
    "MetricDataResponse": {
      "type": "object",
      "description": "单个指标数据结构体",
      "properties": {
        "datapoints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Datapoint"
          },
          "description": "指标的时间序列"
        },
        "metric_name": {
          "type": "string",
          "description": "指标名称,比如:cpu_util"
        },
        "max": {
          "type": "number",
          "format": "double",
          "description": "最大值,未计算默认为0"
        },
        "average": {
          "type": "number",
          "format": "double",
          "description": "平均值,未计算默认为0"
        }
      }
    }
