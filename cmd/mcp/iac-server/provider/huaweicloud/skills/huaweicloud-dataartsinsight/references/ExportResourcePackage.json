{
  "name": "ExportResourcePackage",
  "summary": "API导出资源包",
  "tags": "资源迁移",
  "productshort": "DataArtsInsight",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/resource-package/export": {
      "post": {
        "x-is-registered": "Y",
        "x-support-sdk": "N",
        "tags": [
          "资源迁移"
        ],
        "summary": "API导出资源包",
        "description": "API导出资源包",
        "operationId": "ExportResourcePackage",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目id",
            "minLength": 0,
            "maxLength": 128
          },
          {
            "name": "X-Workspace-Id",
            "in": "header",
            "required": true,
            "description": "工作空间ID,即控制台的项目ID。",
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。 通过调用IAM服务 获取IAM用户Token接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。",
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          },
          {
            "name": "ExportResourcePackageRequestBody",
            "in": "body",
            "required": true,
            "description": "导出参数",
            "schema": {
              "$ref": "#/definitions/ApiExportResourcePackageVo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "文件流",
            "schema": {
              "type": "file"
            },
            "headers": {
              "X-Package-Access-Code": {
                "description": "资源包提取码",
                "type": "string"
              }
            }
          }
        },
        "security": [
          {
            "apig-auth-iam": []
          }
        ]
      }
    }
  },
  "definitions": {
    "ApiExportResourcePackageVo": {
      "type": "object",
      "required": [
        "name",
        "expire_days",
        "resources"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "未命名资源包",
          "description": "导出包名称",
          "minLength": 0,
          "maxLength": 128
        },
        "expire_days": {
          "type": "integer",
          "format": "int32",
          "example": 30,
          "description": "有效时长",
          "minimum": 0,
          "maximum": 2147483647
        },
        "resources": {
          "items": {
            "required": [
              "resource_type",
              "resource_id"
            ],
            "properties": {
              "resource_type": {
                "type": "string",
                "example": "datasource",
                "description": "资源类型",
                "minLength": 0,
                "maxLength": 128
              },
              "resource_id": {
                "type": "string",
                "example": "12awedqweqweqwe",
                "description": "资源id",
                "minLength": 0,
                "maxLength": 128
              }
            }
          },
          "type": "array",
          "description": "导出资源明细",
          "minItems": 0,
          "maxItems": 2147483647
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dataartsinsight.cn-east-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}