              "$ref": "#/definitions/DatasetPermissionConfigVo"
            },
            "examples": {
              "application/json": {
                "row_permission_config": {
                  "is_open": true,
                  "is_open_by_condition": true,
                  "others_has_permission_by_condition": false,
                  "is_open_by_tag": true
