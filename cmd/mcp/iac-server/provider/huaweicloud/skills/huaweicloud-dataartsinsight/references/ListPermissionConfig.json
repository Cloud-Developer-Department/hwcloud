  "definitions": {
    "DatasetPermissionConfigVo": {
      "type": "object",
      "properties": {
        "row_permission_config": {
          "properties": {
            "is_open": {
              "type": "boolean",
              "example": true,
              "description": "是否开启行权限"
            },
            "is_open_by_condition": {
              "type": "boolean",
              "example": true,
              "description": "是否开启条件组合授权"
            },
            "others_has_permission_by_condition": {
              "type": "boolean",
              "example": false,
              "description": "其他用户(未在行级条件组合授权中指定)的权限"
            },
            "is_open_by_tag": {
              "type": "boolean",
              "example": true,
              "description": "行列权限额外配置, 如是否开启行级条件组合授权"
            }
          },
          "description": "行级权限配置"
        },
        "col_permission_config": {
          "properties": {
            "is_open": {
              "type": "boolean",
              "example": true,
              "description": "是否开启列权限"
            }
          },
          "description": "列级权限配置"
        }
      }
    }
  },
