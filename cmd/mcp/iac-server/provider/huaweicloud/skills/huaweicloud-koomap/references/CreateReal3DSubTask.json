  "definitions": {
    "CreateReal3DSubTaskDto": {
      "type": "object",
      "properties": {
        "subtask_name": {
          "type": "string",
          "description": "精修后处理任务名称。支持中文、英文、数字以及“_”字符,长度限制1~50个字符。"
        }
      },
      "description": "创建实景三维精修后处理任务传输对象。",
      "required": [
        "subtask_name"
      ]
    },
    "Real3DSubTaskDto": {
      "type": "object",
      "description": "实景三维精修后处理任务模型。",
      "properties": {
        "subtask_id": {
          "type": "string",
          "description": "实景三维精修后处理任务ID。"
        },
        "task_id": {
          "type": "string",
          "description": "原始实景三维建模任务ID。"
        },
        "subtask_name": {
          "type": "string",
          "description": "精修后处理任务别名。"
        },
        "task_name": {
          "type": "string",
          "description": "原始实景三维建模任务名称。"
        },
        "workspace_id": {
          "type": "string",
          "description": "原始实景三维建模任务所属工作共享空间ID。"
        },
        "modeling_params": {
          "$ref": "#/definitions/ModelingParams",
          "description": "原始实景三维建模任务建模参数列表。"
        },
        "subtask_status": {
          "type": "string",
          "description": "实景三维精修后处理任务当前状态。\n- INIT(初始化)\n- UPLOADING(上传中)\n- UPLOAD_SUCCESS(上传成功)\n- UPLOAD_FAILED(上传失败)\n- PENDING(等待中)\n- STARTING(启动中)\n- START_FAILED(启动失败)\n- RUNNING(运行中)\n- SUCCESS(运行成功)\n- FAILED(运行失败)\n- STOPPING(停止中)\n- STOP_SUCCESS(已停止)"
        },
        "model_path": {
          "type": "string",
          "description": "模型数据上传路径。"
        },
        "refine_product_id": {
          "type": "string",
          "description": "精修后处理任务成果数据ID。"
        },
        "create_time": {
          "type": "string",
          "description": "精修后处理任务创建时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "update_time": {
          "type": "string",
          "description": "精修后处理任务更新时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "tenant_domain_id": {
          "type": "string",
          "description": "华为云IAM租户账号ID。"
        },
        "creator": {
          "type": "string",
          "description": "精修后处理任务创建人。"
        },
        "latest_operator": {
          "type": "string",
          "description": "精修后处理任务最近操作人。"
        },
        "subtask_progress": {
          "type": "string",
          "description": "精修后处理任务进度。该字段为保留两位小数的浮点型数值字符串,数值表示范围为0.00~1.00。"
        },
        "exec_start_time": {
          "type": "string",
          "description": "精修后处理任务执行开始时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "exec_stop_time": {
          "type": "string",
          "description": "精修后处理任务执行结束时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "fail_message": {
          "type": "string",
          "description": "失败消息。当精修后处理任务执行失败时,该字段显示任务的失败原因,用于辅助定位问题。"
        }
      }
    },
    "ModelingParams": {
      "type": "object",
      "description": "实景三维建模参数。",
      "properties": {
        "accuracy": {
          "type": "string",
          "description": "空三精度。取值包括:Highest、High、Medium、Low、Lowest。缺省值:High。"
        },
        "key_point_limit": {
          "type": "string",
          "format": "int32",
          "description": "空三关键点数量。取值范围:1000~1000000。缺省值:40000。"
        },
        "tie_point_limit": {
          "type": "string",
          "format": "int32",
          "description": "空三连接点数量。取值范围:100~100000。缺省值:4000。"
        },
        "mesh_accuracy": {
          "type": "string",
          "format": "int32",
          "description": "Mesh重建质量。枚举值:\n\n- 0:高\n- 1:中\n- 2:低",
          "default": 0
        }
      },
      "required": [
        "accuracy",
        "key_point_limit",
        "tie_point_limit",
        "mesh_accuracy"
      ]
    },
    "ErrorMsg": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "请求状态码。",
          "type": "string",
          "minLength": 3,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    }
  },
