{
  "name": "ListTasksInWorkspace",
  "summary": "分页查询工作共享空间内实景三维任务列表",
  "tags": "实景三维任务管理",
  "productshort": "KooMap",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/real3d/{workspace_id}/tasks": {
      "get": {
        "x-request-examples-description-1": "该请求分页查询工作共享空间内的任务,从第0个任务开始,查询2个任务。",
        "x-request-examples-url-1": "GET https://{Endpoint}/v1/real3d/c734a30b6c5f42cfaf49e01eb6903xxx/tasks?limit=2&offset=0",
        "tags": [
          "实景三维任务管理"
        ],
        "summary": "分页查询工作共享空间内实景三维任务列表",
        "description": "对单个工作共享空间内的任务进行分页查询,支持过滤条件:\n- 任务名称(task_name):支持模糊查询。\n- 任务类型(task_type):支持REAL3D-UNCTRL和REAL3D-CTRL。\n- 建模类型(modeling_type):支持Mesh和Nerf。\n- 任务ID(task_ids):支持同时过滤多个任务ID。\n- 任务状态(task_status):支持同时过滤多个任务状态。\n- 创建时间范围(create_time_from和create_time_to):为UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。\n- 更新时间范围(update_time_from和update_time_to):为UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。\n- 分页参数:偏移量offset(缺省值为0)、每页数量limit(缺省值为10)。",
        "operationId": "ListTasksInWorkspace",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-opseverity": "Info",
        "x-apigateway-request-type": "Public",
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "工作共享空间ID。"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "description": "偏移量。查询时忽略的记录数量。",
            "minimum": 0,
            "maximum": 2147483647
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 10,
            "description": "分页大小。",
            "minimum": 1,
            "maximum": 100
          },
          {
            "name": "task_name",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "任务名称。支持中文、英文、数字以及“_”字符,长度限制1~50个字符。支持模糊查询。"
          },
          {
            "name": "task_type",
            "in": "query",
            "required": false,
            "description": "任务类型。支持过滤多种任务类型。",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "name": "modeling_type",
            "in": "query",
            "required": false,
            "description": "建模类型。支持Mesh和Nerf。",
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "IAM Token信息,用于租户鉴权,该字段由租户请求IAM的Token接口获得。"
          },
          {
            "name": "create_time_from",
            "in": "query",
            "required": false,
            "description": "创建时间起始。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          },
          {
            "name": "create_time_to",
            "in": "query",
            "required": false,
            "description": "创建时间终止。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          },
          {
            "name": "update_time_from",
            "in": "query",
            "required": false,
            "description": "更新时间起始。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          },
          {
            "name": "update_time_to",
            "in": "query",
            "required": false,
            "description": "更新时间终止。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          },
          {
            "name": "task_ids",
            "in": "query",
            "required": false,
            "description": "根据任务ID查询。支持过滤多个任务ID。",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "name": "task_status",
            "in": "query",
            "required": false,
            "description": "根据任务状态查询。支持过滤多个任务状态。",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。",
            "schema": {
              "$ref": "#/definitions/Real3DTasksWithPage"
            },
            "examples": {
              "application/json": {
                "tasks": [
                  {
                    "task_id": "914305233ef7428e8073a95d8042fxxx",
                    "task_name": "测试任务1685087027834",
                    "task_type": "REAL3D-UNCTRL",
                    "modeling_type": "Nerf",
                    "workspace_id": "c734a30b6c5f42cfaf49e01eb6903xxx",
                    "modeling_params": {
                      "accuracy": "High",
                      "key_point_limit": 40000,
                      "tie_point_limit": 4000,
                      "center_x_offset": 0,
                      "center_y_offset": 0,
                      "center_z_offset": 0,
                      "mesh_accuracy": 0,
                      "is_calibration": true,
                      "blend_intensity": 0,
                      "compress_accuracy": 0,
                      "intp_accuracy": 0
                    },
                    "coordinate_sys": "WGS84-UTM",
                    "has_marker": false,
                    "folder_code": "m73MeiI7ztsJpRTaYE3X-YqeZDWfgpxxx",
                    "create_time": "2023-05-26T07:43:47Z",
                    "update_time": "2023-05-26T08:00:00Z",
                    "tenant_domain_id": "xxxx",
                    "creator": "xxxx",
                    "latest_operator": "xxxx",
                    "task_status": "SUCCESS",
                    "complete_stage": 10,
                    "total_stage": 10,
                    "exec_start_time": "2023-05-26T07:57:00Z",
                    "task_progress": "1.00",
                    "exec_stop_time": "2023-05-26T08:00:00Z",
                    "fail_message": null,
                    "AT_progress": null
                  }
                ],
                "page": {
                  "offset": 0,
                  "limit": 2,
                  "total": 1
                }
              }
            }
          },
          "400": {
            "description": "非法请求。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            }
          },
          "500": {
            "description": "服务内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            }
          }
        },
        "x-order": 6
      }
    }
  },
  "definitions": {
    "Real3DTaskDto": {
      "type": "object",
      "description": "实景三维任务模型。",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务ID。"
        },
        "task_name": {
          "type": "string",
          "description": "任务名称。"
        },
        "task_type": {
          "type": "string",
          "description": "任务类型。\n- REAL3D-UNCTRL(无控建模)\n- REAL3D-CTRL(有控建模)"
        },
        "modeling_type": {
          "type": "string",
          "description": "建模类型。\n\n- Mesh:纹理模型实景三维建模。\n- Nerf:显式辐射场实景三维建模。"
        },
        "task_description": {
          "type": "string",
          "description": "任务描述。"
        },
        "workspace_id": {
          "type": "string",
          "description": "任务所属工作共享空间ID。"
        },
        "modeling_params": {
          "$ref": "#/definitions/ModelingParams",
          "description": "任务建模参数列表。"
        },
        "coordinate_sys": {
          "type": "string",
          "description": "建模坐标系。"
        },
        "has_marker": {
          "type": "boolean",
          "description": "是否添加了刺点。"
        },
        "folder_code": {
          "type": "string",
          "description": "任务绑定的倾斜影像的影像code。"
        },
        "create_time": {
          "type": "string",
          "description": "任务创建时间。格式为UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "update_time": {
          "type": "string",
          "description": "任务更新时间。格式为UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "tenant_domain_id": {
          "type": "string",
          "description": "华为云IAM租户账号ID。"
        },
        "creator": {
          "type": "string",
          "description": "任务创建人。"
        },
        "latest_operator": {
          "type": "string",
          "description": "任务最近操作人。"
        },
        "task_status": {
          "type": "string",
          "description": "任务当前状态。\n- INIT(初始化)\n- PENDING(等待中)\n- STARTING(启动中)\n- START_FAILED(启动失败)\n- RUNNING(运行中)\n- SUCCESS(运行成功)\n- FAILED(运行失败)\n- STOPPING(停止中)\n- STOP_SUCCESS(已停止)\n- ARCHIVED(已归档)\n- BUNDLE_SUCCESS(空三建模成功)"
        },
        "complete_stage": {
          "type": "integer",
          "format": "int32",
          "description": "建模已完成作业步骤数。"
        },
        "total_stage": {
          "type": "integer",
          "format": "int32",
          "description": "建模总作业步骤数。"
        },
        "task_progress": {
          "type": "string",
          "description": "任务进度。该字段为字符串表示的保留两位小数的浮点型数值,取值范围:0.00~1.00。"
        },
        "exec_start_time": {
          "type": "string",
          "description": "任务执行开始时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "exec_stop_time": {
          "type": "string",
          "description": "任务执行结束时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "fail_message": {
          "type": "string",
          "description": "失败消息。当任务执行失败时,该字段显示任务的失败原因,用于辅助定位问题。"
        },
        "AT_progress": {
          "type": "string",
          "description": "空三建模进度,取值范围:0.00~1.00。展示有控建模任务空三建模阶段的执行进度。因为空三建模仅在有控建模任务中执行,无控建模任务中该字段取值始终为null。"
        }
      }
    },
    "ModelingParams": {
      "type": "object",
      "description": "实景三维建模参数。",
      "properties": {
        "accuracy": {
          "type": "string",
          "description": "空三精度。取值包括:Highest、High、Medium、Low、Lowest。缺省值:High。"
        },
        "key_point_limit": {
          "type": "string",
          "format": "int32",
          "description": "空三关键点数量。取值范围:1000~1000000。缺省值:40000。"
        },
        "tie_point_limit": {
          "type": "string",
          "format": "int32",
          "description": "空三连接点数量。取值范围:100~100000。缺省值:4000。"
        },
        "mesh_accuracy": {
          "type": "string",
          "format": "int32",
          "description": "Mesh重建质量。枚举值:\n\n- 0:高\n- 1:中\n- 2:低",
          "default": 0
        }
      },
      "required": [
        "accuracy",
        "key_point_limit",
        "tie_point_limit",
        "mesh_accuracy"
      ]
    },
    "Page": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "偏移量,表示从第几条数据开始查询。"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "每页包含的查询记录数量。"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "符合查询条件的记录总数。"
        }
      },
      "required": [
        "offset",
        "limit",
        "total"
      ]
    },
    "ErrorMsg": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "请求状态码。",
          "type": "string",
          "minLength": 3,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    },
    "Real3DTasksWithPage": {
      "type": "object",
      "description": "实景三维任务分页列表。",
      "required": [
        "tasks",
        "page"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Real3DTaskDto"
          },
          "description": "任务列表。"
        },
        "page": {
          "description": "分页信息。",
          "$ref": "#/definitions/Page"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "koomap.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}