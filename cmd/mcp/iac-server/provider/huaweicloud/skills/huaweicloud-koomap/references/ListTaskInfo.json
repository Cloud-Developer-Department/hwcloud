{
  "name": "ListTaskInfo",
  "summary": "查询任务",
  "tags": "卫星影像任务管理",
  "productshort": "KooMap",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/kmp-control/tasks": {
      "get": {
        "x-request-examples-description-1": "查询工作共享空间下的任务列表。",
        "x-request-examples-text-1": "?offset=0&limit=10&workspace_id=e81bb7cae54e4eed8cf873676d6872ef",
        "x-request-examples-1": "?offset=0&limit=10&workspace_id=e81bb7cae54e4eed8cf873676d6872ef",
        "x-request-examples-url-1": "GET https://{Endpoint}/v1/kmp-control/tasks?offset=0&limit=10&workspace_id={workspace_id}",
        "tags": [
          "卫星影像任务管理"
        ],
        "description": "根据设置的过滤条件(任务状态)分页查询任务。",
        "operationId": "ListTaskInfo",
        "summary": "查询任务",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-opseverity": "Info",
        "x-apigateway-request-type": "Public",
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "task_name",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "任务名称,支持模糊查询。",
            "pattern": "[\\一-\\龥_a-zA-Z0-9_]{1,50}",
            "minLength": 1,
            "maxLength": 50
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "任务所属工作共享空间ID。",
            "minLength": 32,
            "maxLength": 32
          },
          {
            "name": "task_status",
            "in": "query",
            "required": false,
            "description": "任务状态。包括INIT(初始化)、RUNNING(运行中)、SUCCESS(执行成功)、ARCHIVED(已归档)、FAILED(执行失败)、STOPPING(停止中)、STOP_SUCCESS(已停止)、STOP_FAILD(停止失败)、START_RUNNING(等待中)。",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "name": "create_time_start",
            "in": "query",
            "required": false,
            "description": "创建开始时间。格式为UTC标准时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          },
          {
            "name": "create_time_end",
            "in": "query",
            "required": false,
            "description": "创建结束时间。格式为UTC标准时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": true,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "description": "偏移量,从第几条记录开始查询。",
            "minimum": 0,
            "maximum": 2147483647
          },
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "type": "integer",
            "format": "int32",
            "default": 10,
            "description": "分页大小。",
            "minimum": 1,
            "maximum": 100
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "IAM Token信息,用于租户鉴权,该字段由租户请求IAM的Token接口获得。"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。",
            "schema": {
              "$ref": "#/definitions/TaskList"
            },
            "examples": {
              "application/json": {
                "page": {
                  "offset": 0,
                  "limit": 10,
                  "total": 1
                },
                "data": [
                  {
                    "task_id": "4673779ec6d34a0cad106a2aaa5xxxxx",
                    "workspace_id": "ce5694adfd4f4f11a13a67e2e7exxxxx",
                    "data_id": "[\"3f7eb40cf46d45fd96a927361c57787\"]",
                    "task_name": "任45YU655675ds",
                    "domain_id": "c163c3c55c3c4526b2ed7a0213bxxxxx",
                    "creator": "创建人",
                    "create_time": "2022-12-19T12:41:41Z",
                    "task_status": "INIT",
                    "task_type": "ORSIP",
                    "task_description": "任务描述",
                    "exec_start_time": null,
                    "exec_stop_time": null,
                    "origin_data_alias": null,
                    "production_level": "tile",
                    "task_progress": "0.0",
                    "shape_id": "541f58792fb84cd0bc3d8d6d8cd93337",
                    "is_deleted": 0,
                    "image_url": "https://koomap-optical-image-data.obs.cn-north-5.myhuaweicloud.com:443/c163c3c55c3c4526b2ed7a0213bc9871/%E6%95%B0%E6%8D%AE%E5%8A%A0%E5%B7%A5/%E5%85%89%E5%AD%A6%E5%BD%B1%E5%83%8F/%E6%88%90%E6%9E%9C%E5%BD%B1%E5%83%8F/%E4%BB%BB45YU655675ds_L5_tile_1671453701674/%E4%BB%BB45YU655675ds_L5_tile_per.png?AccessKeyId=7REUSI4BCCNDICBJ9CZF&Expires=1672217213&Signature=yzB8ao4%2Bzo5BXen6HPXOJ6FOdyI%3D",
                    "frozen_tag": null,
                    "is_clip": "0",
                    "is_tile": "0"
                  }
                ],
                "taskNumVo": [
                  {
                    "totalNum": 10,
                    "failedNum": 1,
                    "archivedNum": 1,
                    "successNum": 1,
                    "runningNum": 1
                  }
                ]
              }
            }
          },
          "400": {
            "description": "非法请求。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            }
          },
          "500": {
            "description": "服务内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            }
          }
        },
        "x-order": 2
      }
    }
  },
  "definitions": {
    "TaskVo": {
      "required": [
        "task_id",
        "workspace_id",
        "data_id",
        "task_name",
        "creator",
        "create_time",
        "task_status",
        "task_type",
        "production_level",
        "task_progress"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务唯一标识ID。",
          "minLength": 32,
          "maxLength": 36,
          "example": "28f61af50fc9452aa0ed5ea25c3cc3d3"
        },
        "workspace_id": {
          "type": "string",
          "description": "工作共享空间ID。",
          "example": "56bf8e2767cd4b44b86e16c21f769c66"
        },
        "data_id": {
          "type": "string",
          "description": "数据ID。",
          "example": [
            "aab1b0770a2a4fcbbb6a6f422b1163b7",
            "add9499ddcca4882bcaf91170d3d5e59"
          ]
        },
        "task_name": {
          "type": "string",
          "description": "任务名称。",
          "minLength": 2,
          "maxLength": 64,
          "example": "MyDemo"
        },
        "creator": {
          "type": "string",
          "description": "创建者ID。",
          "minLength": 2,
          "maxLength": 512,
          "example": "this is a demo"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间。",
          "example": "2022-11-07T08:54:36Z"
        },
        "task_status": {
          "type": "string",
          "description": "任务状态。包括INIT(初始化)、RUNNING(运行中)、SUCCESS(执行成功)、ARCHIVED(已归档)、FAILED(执行失败)、STOPPING(停止中)、STOP_SUCCESS(已停止)、STOP_FAILED(停止失败)、START_RUNNING(等待中)。"
        },
        "task_type": {
          "type": "string",
          "description": "任务类型。\n当前仅支持ORSIP(卫星影像生产)。"
        },
        "task_description": {
          "type": "string",
          "description": "任务描述。"
        },
        "exec_start_time": {
          "type": "string",
          "description": "开始操作时间。\n缺省值:null",
          "example": "2022-11-07T08:54:36Z"
        },
        "exec_stop_time": {
          "type": "string",
          "description": "停止操作时间。\n缺省值:null",
          "example": "2022-11-07T08:54:36Z"
        },
        "origin_data_alias": {
          "type": "string",
          "description": "原始数据别名。"
        },
        "production_level": {
          "type": "string",
          "description": "任务输出结果影像级别,当前支持以下级别: L2、L3、L4、L5。"
        },
        "task_progress": {
          "type": "string",
          "description": "任务执行进度。",
          "example": 0.0
        },
        "shape_id": {
          "type": "string",
          "description": "矢量数据文件ID,“isClip”为“1”时必填。"
        },
        "is_deleted": {
          "type": "integer",
          "format": "int32",
          "description": "是否删除。\n- 0:未删除\n- 1:已删除"
        },
        "image_url": {
          "type": "string",
          "description": "影像链接。"
        },
        "domain_id": {
          "type": "string",
          "description": "租户ID。"
        },
        "fail_message": {
          "type": "string",
          "description": "任务失败原因。"
        },
        "frozen_tag": {
          "type": "string",
          "description": "任务冻结状态。当前仅支持frozen(冻结中)。"
        },
        "isClip": {
          "type": "string",
          "description": "是否为矢量切割。\n- 0:否\n- 1:是"
        },
        "isTile": {
          "type": "string",
          "description": "是否为金字塔切割。\n- 0:否\n- 1:是"
        }
      },
      "type": "object"
    },
    "Page": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "偏移量,表示从第几条数据开始查询。"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "每页包含的查询记录数量。"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "符合查询条件的记录总数。"
        }
      },
      "required": [
        "offset",
        "limit",
        "total"
      ]
    },
    "ErrorMsg": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "请求状态码。",
          "type": "string",
          "minLength": 3,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    },
    "TaskNumVo": {
      "type": "object",
      "properties": {
        "totalNum": {
          "type": "integer",
          "description": "任务总数量。"
        },
        "failedNum": {
          "type": "integer",
          "description": "失败任务数量。"
        },
        "archivedNum": {
          "type": "integer",
          "description": "存档任务数量。"
        },
        "successNum": {
          "type": "integer",
          "description": "成功任务数量。"
        },
        "runningNum": {
          "type": "integer",
          "description": "运行中任务数量。"
        }
      }
    },
    "TaskList": {
      "type": "object",
      "properties": {
        "page": {
          "$ref": "#/definitions/Page",
          "description": "分页信息。"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TaskVo"
          },
          "description": "任务列表。"
        },
        "taskNumVo": {
          "$ref": "#/definitions/TaskNumVo",
          "description": "各状态任务数量。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "koomap.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}