                "creator": "xxxx",
                "latest_operator": "xxxx",
                "create_time": "2023-05-23T07:26:28Z",
                "update_time": "2023-05-23T07:26:28Z",
                "star": 0,
                "can_delete": false
              }
            }
          },
          "400": {
            "description": "非法请求。",
