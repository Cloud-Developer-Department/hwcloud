{
  "name": "ListCommonWorkspace",
  "summary": "查询工作共享空间列表",
  "tags": "工作共享空间",
  "productshort": "KooMap",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/workspaces": {
      "get": {
        "x-request-examples-description-1": "该请求用来分页查询工作共享空间列表,从第0个开始,查询10条符合条件的工作共享空间。",
        "x-request-examples-url-1": "GET https://{Endpoint}/v1/workspaces?offset=0&limit=10",
        "tags": [
          "工作共享空间"
        ],
        "summary": "查询工作共享空间列表",
        "description": "该接口用于分页查询工作共享空间列表,支持过滤条件:\n- 工作共享空间名称(workspace_name):支持模糊查询。\n- 工作共享空间是否置顶显示:最多可置顶4个工作共享空间。\n- 创建时间范围(create_time_from和create_time_to):UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。\n- 更新时间范围(update_time_from和update_time_to):UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。\n- 分页参数:偏移量offset(缺省值为0),每页限制数量limit(缺省值为10)。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-opseverity": "Info",
        "x-apigateway-request-type": "Public",
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "operationId": "ListCommonWorkspace",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "IAM Token信息,用于租户鉴权,该字段由租户请求IAM的Token接口获得。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "description": "偏移量。查询时忽略的记录数量。",
            "minimum": 0,
            "maximum": 2147483647
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 10,
            "description": "分页大小。",
            "minimum": 1,
            "maximum": 100
          },
          {
            "name": "workspace_ids",
            "in": "query",
            "required": false,
            "description": "根据工作共享空间ID查询。",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "name": "workspace_name",
            "in": "query",
            "required": false,
            "description": "工作共享空间名称。支持模糊查询。",
            "type": "string"
          },
          {
            "name": "star",
            "in": "query",
            "required": false,
            "description": "工作共享空间是否置顶显示(最多可置顶4个)。\n- 0:否\n- 1:是",
            "type": "boolean"
          },
          {
            "name": "create_time_from",
            "in": "query",
            "required": false,
            "description": "创建工作共享空间的起始时间。查询在该时间之后创建的工作共享空间。接收UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          },
          {
            "name": "create_time_to",
            "in": "query",
            "required": false,
            "description": "创建工作共享空间的截止时间。查询在该时间之前创建的工作共享空间。接收UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          },
          {
            "name": "update_time_from",
            "in": "query",
            "required": false,
            "description": "更新工作共享空间的起始时间。查询在该时间之后更新的工作共享空间。接收UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          },
          {
            "name": "update_time_to",
            "in": "query",
            "required": false,
            "description": "更新工作共享空间的截止时间。查询在该时间之前更新的工作共享空间。接收UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          },
          {
            "name": "order_by",
            "in": "query",
            "required": false,
            "description": "排序字段。置顶空间默认排列在列表最前面,并且根据该排序字段组合排序。\n\n- create_time_asc:按照创建时间升序排列。\n- create_time_desc:按照创建时间降序排列。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。",
            "schema": {
              "$ref": "#/definitions/ListWorkspacesWithPage"
            },
            "examples": {
              "application/json": {
                "data": [
                  {
                    "workspace_id": "8c008cabac124f74ad7deba48e1bdf7a",
                    "workspace_name": "测试空间1",
                    "workspace_description": "空间描述",
                    "creator": "xxxx",
                    "latest_operator": "xxxx",
                    "create_time": "2023-05-23T07:57:14Z",
                    "update_time": "2023-05-23T07:57:14Z",
                    "star": 0,
                    "can_delete": false
                  },
                  {
                    "workspace_id": "cd8a29375dc0452889e3cce805bace1d",
                    "workspace_name": "测试空间2",
                    "workspace_description": "空间描述",
                    "creator": "xxxx",
                    "latest_operator": "xxxx",
                    "create_time": "2023-05-23T07:36:30Z",
                    "update_time": "2023-05-23T07:36:30Z",
                    "star": 0,
                    "can_delete": true
                  }
                ],
                "page": {
                  "offset": 0,
                  "limit": 2,
                  "total": 12
                }
              }
            }
          },
          "400": {
            "description": "非法请求。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            }
          },
          "500": {
            "description": "服务内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "WorkspaceDto": {
      "type": "object",
      "description": "工作共享空间传输对象。",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "工作共享空间ID。"
        },
        "workspace_name": {
          "type": "string",
          "description": "工作共享空间名称。"
        },
        "workspace_description": {
          "type": "string",
          "description": "工作共享空间描述。"
        },
        "tenant_domain_id": {
          "type": "string",
          "description": "IAM租户账号domain ID。"
        },
        "creator": {
          "type": "string",
          "description": "创建人。"
        },
        "latest_operator": {
          "type": "string",
          "description": "最近修改人。"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间。返回UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "update_time": {
          "type": "string",
          "description": "更新时间。返回UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "star": {
          "type": "integer",
          "format": "int32",
          "description": "工作共享空间是否置顶显示(最多可置顶4个)。"
        },
        "can_delete": {
          "type": "boolean",
          "description": "工作共享空间是否允许删除标志位。当工作共享空间置顶显示或者该空间下存在任务时,取值为“true”,表示不可以删除。"
        }
      }
    },
    "Page": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "偏移量,表示从第几条数据开始查询。"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "每页包含的查询记录数量。"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "符合查询条件的记录总数。"
        }
      },
      "required": [
        "offset",
        "limit",
        "total"
      ]
    },
    "ErrorMsg": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "请求状态码。",
          "type": "string",
          "minLength": 3,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    },
    "ListWorkspacesWithPage": {
      "type": "object",
      "properties": {
        "data": {
          "items": {
            "$ref": "#/definitions/WorkspaceDto"
          },
          "type": "array",
          "description": "工作共享空间列表。"
        },
        "page": {
          "$ref": "#/definitions/Page",
          "description": "分页信息。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "koomap.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}