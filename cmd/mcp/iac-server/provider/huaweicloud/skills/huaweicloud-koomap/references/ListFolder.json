{
  "name": "ListFolder",
  "summary": "查询当前租户的倾斜影像列表",
  "tags": "实景三维数据管理",
  "productshort": "KooMap",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/real3d/folders": {
      "get": {
        "x-request-examples-description-1": "该请求分页查询当前租户的影像列表。",
        "x-request-examples-url-1": "POST https://{Endpoint}/v1/real3d/folders?offset=0&limit=10",
        "tags": [
          "实景三维数据管理"
        ],
        "summary": "查询当前租户的倾斜影像列表",
        "operationId": "ListFolder",
        "description": "根据过滤条件查询当前租户的倾斜影像基本信息列表。过滤条件有:影像名称、影像别名、影像上传起止时间、影像状态、影像描述、分页偏移量、每页显示条数,影像排序规则。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-opseverity": "Info",
        "x-apigateway-request-type": "Public",
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "query_info",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/QueryFolderReq"
            },
            "description": "查询请求体。"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "IAM Token信息,用于租户鉴权,该字段由租户请求IAM的Token接口获得。"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。",
            "schema": {
              "$ref": "#/definitions/FoldersWithPage"
            },
            "examples": {
              "application/json": {
                "folders": [
                  {
                    "folder_code": "16565875049557xxxx",
                    "folder_name": "xxxx",
                    "folder_alias": "xxxx",
                    "folder_desc": "xxxx",
                    "obs_endpoint": "obs.xxxx.myhuaweicloud.com",
                    "obs_path": "real3d/xxxxx/real-test",
                    "create_time": "2023-05-11 17:10:13.000",
                    "status": 1
                  },
                  {
                    "folder_code": "16558314669791xxxx",
                    "folder_name": "xxxx",
                    "folder_alias": "xxxx",
                    "folder_desc": "xxxx",
                    "obs_endpoint": "obs.xxxx.myhuaweicloud.com",
                    "obs_path": "real3d/xxxxxx/test-image-source",
                    "create_time": "2023-05-09 15:06:00.000",
                    "status": 1
                  }
                ],
                "page": {
                  "offset": 0,
                  "limit": 10,
                  "total": 2
                }
              }
            }
          },
          "400": {
            "description": "非法请求。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            }
          },
          "500": {
            "description": "服务内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            }
          }
        },
        "x-order": 1
      }
    }
  },
  "definitions": {
    "FoldersWithPage": {
      "description": "影像图片文件夹列表。",
      "required": [
        "page"
      ],
      "properties": {
        "folders": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FolderVo"
          },
          "description": "文件夹列表。",
          "readOnly": true,
          "example": "28f61af50fc9452aa0ed5ea25c3cc3d3"
        },
        "page": {
          "description": "分页信息。",
          "$ref": "#/definitions/Page"
        }
      },
      "type": "object"
    },
    "FolderQueryCondition": {
      "type": "object",
      "properties": {
        "folder_name": {
          "type": "string",
          "example": "string",
          "description": "倾斜影像名称。支持中文、英文、数字以及“_”、“-”、“.”字符,长度限制为[1, 100]。"
        },
        "folder_alias": {
          "type": "string",
          "example": "string",
          "description": "倾斜影像别名。支持中文、英文、数字以及“_”、“-”、“.”字符,长度限制为[1, 100]。"
        },
        "folder_desc": {
          "type": "string",
          "example": "string",
          "description": "倾斜影像描述。支持中文、英文、数字以及“_”、“-”、“.”字符,长度限制为[0, 255]。"
        },
        "from": {
          "type": "string",
          "description": "倾斜影像上传起始时间。格式为UTC标准时间:yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "to": {
          "type": "string",
          "description": "倾斜影像上传结束时间。格式为UTC标准时间:yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "status": {
          "type": "string",
          "description": "倾斜影像状态。当前仅支持处理中(0)、已完成(1)、导入失败(2)。"
        },
        "order": {
          "type": "string",
          "description": "倾斜影像排序规则。\n当前仅支持影像名称正序(1)、影像名称倒序(-1)、影像别名正序(2)、影像别名倒序(-2)、影像上传日期正序(3)、影像上传日期倒序(-3)。"
        }
      }
    },
    "Page": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "偏移量,表示从第几条数据开始查询。"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "每页包含的查询记录数量。"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "符合查询条件的记录总数。"
        }
      },
      "required": [
        "offset",
        "limit",
        "total"
      ]
    },
    "ErrorMsg": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "请求状态码。",
          "type": "string",
          "minLength": 3,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    },
    "FolderVo": {
      "type": "object",
      "description": "倾斜影像信息。",
      "properties": {
        "folder_code": {
          "type": "string",
          "example": "string",
          "description": "倾斜影像的唯一标识。"
        },
        "folder_name": {
          "type": "string",
          "example": "string",
          "description": "倾斜影像名称。"
        },
        "folder_alias": {
          "type": "string",
          "example": "string",
          "description": "倾斜影像别名。"
        },
        "folder_desc": {
          "type": "string",
          "example": "string",
          "description": "倾斜影像描述。"
        },
        "obs_endpoint": {
          "type": "string",
          "description": "倾斜影像所在OBS的Endpoint。"
        },
        "obs_path": {
          "type": "string",
          "example": "string",
          "description": "倾斜影像所在OBS的目录地址。"
        },
        "create_time": {
          "type": "string",
          "description": "倾斜影像上传时间。"
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "倾斜影像状态。\n\n- 0:处理中\n- 1:已完成\n- 2:导入失败"
        }
      }
    },
    "QueryFolderReq": {
      "type": "object",
      "required": [
        "offset",
        "limit"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "偏移量,表示从第几条记录开始查询。"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "每页显示条数。"
        },
        "condition": {
          "description": "查询条件。",
          "$ref": "#/definitions/FolderQueryCondition"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "koomap.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}