        },
        "create_time": {
          "type": "string",
          "description": "精修后处理任务创建时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "update_time": {
          "type": "string",
          "description": "精修后处理任务更新时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "tenant_domain_id": {
          "type": "string",
          "description": "华为云IAM租户账号ID。"
        },
        "creator": {
          "type": "string",
          "description": "精修后处理任务创建人。"
        },
        "latest_operator": {
          "type": "string",
          "description": "精修后处理任务最近操作人。"
        },
        "subtask_progress": {
          "type": "string",
          "description": "精修后处理任务进度。该字段为保留两位小数的浮点型数值字符串,数值表示范围为0.00~1.00。"
        },
        "exec_start_time": {
          "type": "string",
          "description": "精修后处理任务执行开始时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "exec_stop_time": {
          "type": "string",
          "description": "精修后处理任务执行结束时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。"
        },
        "fail_message": {
          "type": "string",
          "description": "失败消息。当精修后处理任务执行失败时,该字段显示任务的失败原因,用于辅助定位问题。"
        }
      }
    },
    "ModelingParams": {
      "type": "object",
      "description": "实景三维建模参数。",
      "properties": {
        "accuracy": {
          "type": "string",
          "description": "空三精度。取值包括:Highest、High、Medium、Low、Lowest。缺省值:High。"
        },
        "key_point_limit": {
          "type": "string",
          "format": "int32",
          "description": "空三关键点数量。取值范围:1000~1000000。缺省值:40000。"
        },
        "tie_point_limit": {
          "type": "string",
          "format": "int32",
          "description": "空三连接点数量。取值范围:100~100000。缺省值:4000。"
        },
        "mesh_accuracy": {
          "type": "string",
          "format": "int32",
          "description": "Mesh重建质量。枚举值:\n\n- 0:高\n- 1:中\n- 2:低",
          "default": 0
        }
      },
      "required": [
        "accuracy",
        "key_point_limit",
        "tie_point_limit",
        "mesh_accuracy"
      ]
    },
    "Page": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "偏移量,表示从第几条数据开始查询。"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "每页包含的查询记录数量。"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "符合查询条件的记录总数。"
        }
      },
      "required": [
        "offset",
        "limit",
        "total"
      ]
    },
    "ErrorMsg": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "请求状态码。",
          "type": "string",
          "minLength": 3,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    }
  },
