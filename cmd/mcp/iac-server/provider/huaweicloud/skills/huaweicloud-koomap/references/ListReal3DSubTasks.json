{
  "name": "ListReal3DSubTasks",
  "summary": "分页查询实景三维精修后处理任务列表",
  "tags": "实景三维精修后处理任务管理",
  "productshort": "KooMap",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/real3d/{workspace_id}/tasks/{task_id}/subtasks": {
      "get": {
        "x-request-examples-description-1": "该请求分页查询任务ID为914305233ef7428e8073a95d8042fxxx的精修后处理任务列表,从第0个任务开始,查询2个任务。",
        "x-request-examples-url-1": "https://{endpoint}/v1/real3d/c734a30b6c5f42cfaf49e01eb6903xxx/tasks/914305233ef7428e8073a95d8042fxxx/subtasks?limit=2&offset=0",
        "tags": [
          "实景三维精修后处理任务管理"
        ],
        "summary": "分页查询实景三维精修后处理任务列表",
        "description": "对单个实景三维建模任务内的精修后处理任务进行分页查询,支持过滤条件:\n- 实景三维精修后处理任务ID(subtask_id):支持根据ID查询特定精修后处理任务。\n- 实景三维精修后处理任务别名(subtask_name):支持根据精修后处理任务别名进行模糊查询。\n- 实景三维精修后处理任务状态(subtask_status):支持同时查询多种状态的精修后处理任务。\n- 实景三维精修后处理任务创建时间范围(create_time_from和create_time_to):为UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。\n- 实景三维精修后处理任务更新时间范围(update_time_from和update_time_to):为UTC时间格式字符串,格式为yyyy-MM-dd'T'HH:mm:ss'Z'。\n- 分页参数:偏移量offset(缺省值为0)、每页数量limit(缺省值为10)。",
        "operationId": "ListReal3DSubTasks",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-opseverity": "Info",
        "x-apigateway-request-type": "Public",
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "工作共享空间ID。"
          },
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "原始实景三维建模任务ID。"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "description": "偏移量。",
            "minimum": 0,
            "maximum": 2147483647
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 10,
            "description": "分页大小。",
            "minimum": 1,
            "maximum": 100
          },
          {
            "name": "subtask_id",
            "in": "query",
            "required": false,
            "description": "精修后处理任务ID。",
            "type": "string"
          },
          {
            "name": "subtask_name",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "精修后处理任务别名,支持模糊查询。"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "IAM Token信息,用于租户鉴权,该字段由租户请求IAM的Token接口获得。"
          },
          {
            "name": "subtask_status",
            "in": "query",
            "required": false,
            "description": "根据精修后处理任务状态查询,支持输入多个状态。",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "name": "create_time_from",
            "in": "query",
            "required": false,
            "description": "创建精修后处理任务的起始时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          },
          {
            "name": "create_time_to",
            "in": "query",
            "required": false,
            "description": "创建精修后处理任务的截止时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          },
          {
            "name": "update_time_from",
            "in": "query",
            "required": false,
            "description": "更新精修后处理任务的起始时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          },
          {
            "name": "update_time_to",
            "in": "query",
            "required": false,
            "description": "更新精修后处理任务的截止时间。格式为UTC时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。",
            "schema": {
              "$ref": "#/definitions/Real3DSubTasksWithPage"
            },
            "examples": {
