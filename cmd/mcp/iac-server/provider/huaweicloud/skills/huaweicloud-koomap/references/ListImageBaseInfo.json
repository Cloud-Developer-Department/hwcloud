{
  "name": "ListImageBaseInfo",
  "summary": "查询卫星影像基本信息",
  "tags": "卫星影像数据管理",
  "productshort": "KooMap",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/kmp-data/imageinfo": {
      "post": {
        "x-request-examples-description-1": "查询卫星影像信息。参数需要以formData的形式组织。",
        "x-request-examples-text-1": "limit: \"10\"\noffset: \"0\"\nis_product: \"0\"\nimage_levels: \"L1,L1A,L1B\"\nis_product:“0”",
        "x-request-examples-1": "limit: \"10\"\noffset: \"0\"\nis_product: \"0\"\nimage_levels: \"L1,L1A,L1B\"\nis_product:“0”",
        "x-request-examples-url-1": "POST https://{Endpoint}/v1/kmp-data/imageinfo",
        "tags": [
          "卫星影像数据管理"
        ],
        "operationId": "ListImageBaseInfo",
        "consumes": [
          "multipart/form-data"
        ],
        "summary": "查询卫星影像基本信息",
        "description": "根据过滤条件查询卫星影像信息列表。过滤条件有:影像名称、上传日期、影像别名、影像等级、影像状态、是否为成果数据、分页偏移量、每页显示条数。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-opseverity": "Info",
        "x-apigateway-request-type": "Public",
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "IAM Token信息,用于租户鉴权,该字段由租户请求IAM的Token接口获得。",
            "type": "string"
          },
          {
            "name": "image_name",
            "in": "formData",
            "required": false,
            "description": "卫星影像名称,支持模糊查询。\n格式为中英文、数字、下划线、中划线、“.”,长度100个字符以内。",
            "type": "string",
            "pattern": "^[\\一-\\龥\\w._-]{0,100}$",
            "minLength": 0,
            "maxLength": 100
          },
          {
            "name": "image_date_from",
            "in": "formData",
            "required": false,
            "description": "卫星影像上传起始时间。\n格式为UTC标准时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string",
            "minLength": 20,
            "maxLength": 20
          },
          {
            "name": "image_date_to",
            "in": "formData",
            "required": false,
            "description": "卫星影像上传截止时间。\n格式为UTC标准时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
            "type": "string",
            "minLength": 20,
            "maxLength": 20
          },
          {
            "name": "image_status",
            "in": "formData",
            "required": false,
            "description": "卫星影像迁移状态列表。 当前仅支持完成(0)、迁入中(1)、迁入失败(2)、迁出中(3)、迁出失败(4)、删除中(6)、卫星影像正在被任务使用导致删除失败(7)、网络错误导致删除失败(8)。状态之间以“,”隔开。",
            "type": "string"
          },
          {
            "name": "raw_alias",
            "in": "formData",
            "required": false,
            "description": "卫星影像别名。\n支持模糊查询,格式为中英文、数字、下划线、中划线、“.”,长度100个字符以内。",
            "type": "string",
            "pattern": "^[\\一-\\龥\\w._-]{0,100}$",
            "minLength": 0,
            "maxLength": 100
          },
          {
            "name": "image_alias",
            "in": "formData",
            "required": false,
            "description": "卫星影像别名列表。\n格式为中英文、数字、下划线、中划线、“.”。别名之间以“,”隔开。",
            "type": "string",
            "pattern": "^\\一-\\龥\\w._-,$"
          },
          {
            "name": "image_levels",
            "in": "formData",
            "required": false,
            "description": "卫星影像等级列表。\n当前仅支持L1、L1A、L1B、L2、L3、L4、L5。等级之间以“,”隔开。",
            "type": "string"
          },
          {
            "name": "is_product",
            "in": "formData",
            "required": false,
            "description": "卫星影像是否为成果数据。\n当前仅支持原始数据(0)、成果数据(1)。",
            "type": "string"
          },
          {
            "name": "order",
            "in": "formData",
            "required": false,
            "description": "卫星影像排序规则。\n当前仅支持影像名称正序(1)、影像名称倒序(-1)、影像别名正序(2)、影像别名倒序(-2)、影像上传日期正序(3)、影像上传日期倒序(-3)。",
            "type": "string"
          },
          {
            "name": "description",
            "in": "formData",
            "required": false,
            "description": "卫星影像描述。 \n格式为中英文、数字、下划线、中划线,长度为255个字符以内。",
            "type": "string",
            "pattern": "Pattern:^[\\一-\\龥\\w_-]{0,255}$;Length:{0,255}"
          },
          {
            "name": "image_type",
            "in": "formData",
            "required": false,
            "description": "卫星影像类型。当前仅支持全色(0)、多光谱(1)。",
            "type": "string"
          },
          {
            "name": "limit",
            "in": "formData",
            "required": true,
            "description": "每页显示条数。",
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          },
          {
            "name": "offset",
            "in": "formData",
            "required": true,
            "description": "偏移量,表示从第几条记录开始查询。",
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 2147483647
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。",
            "schema": {
              "$ref": "#/definitions/ImageBaseInfoRsp"
            },
            "examples": {
              "application/json": "{\n  \"data_info\": [\n    {\n      \"image_name\": \"影像名称\",\n      \"is_product\": \"0\",\n      \"image_level\": \"L1A\",\n      \"image_status\": \"完成\",\n      \"image_date\": \"2013-10-09T16:00:00Z\",\n      \"upload_date\": \"2022-11-09T03:02:52Z\",\n      \"image_resolution\": \"16.0\",\n      \"image_description\": \"\",\n      \"image_id\": \"9260ad8d63f84ed1a9269f56162e42a5\",\n      \"image_type\": \"1\",\n      \"user_name\": \"IAM用户名称\",\n      \"image_alias\": \"WFV3\",\n      \"product_clip\": 1,\n      \"product_tile\": 1,\n      \"is_cog\": 1\n    }\n  ]\n}"
            }
          },
          "400": {
            "description": "非法请求。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "400",
                "error_msg": "参数不符合规范。"
              }
            }
          },
          "500": {
            "description": "服务内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "DataInfo": {
      "type": "object",
      "description": "卫星影像数据信息。",
      "required": [
        "image_name",
        "is_product",
        "image_level",
        "image_status",
        "image_date",
        "upload_date",
        "image_resolution",
        "image_description",
        "image_id",
        "image_type",
        "user_name",
        "image_alias"
      ],
      "properties": {
        "image_name": {
          "description": "卫星影像名称。\n支持模糊查询,格式为中英文、数字、下划线、中划线、“.”,长度100个字符以内。",
          "type": "string",
          "pattern": "^[\\一-\\龥\\w\\._-]{0,100}$"
        },
        "is_product": {
          "description": "卫星影像是否为成果影像。\n目前只支持原始影像(0)、成果影像(1)。",
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        },
        "image_level": {
          "description": "卫星影像等级。\n目前只支持L1、L1A、L1B、L2、L3、L4、L5。",
          "type": "string",
          "minLength": 2,
          "maxLength": 3
        },
        "image_status": {
          "description": "卫星影像迁移状态。\n当前仅支持完成(0)、迁入中(1)、迁入失败(2)、迁出中(3)、迁出失败(4)、删除中(6)、卫星影像正在被任务使用导致删除失败(7)、网络错误导致删除失败(8)。",
          "type": "string"
        },
        "image_date": {
          "description": "卫星影像成像时间。\n格式为UTC标准时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
          "type": "string",
          "minLength": 20,
          "maxLength": 20
        },
        "upload_date": {
          "description": "卫星影像上传时间。\n格式为UTC标准时间:yyyy-MM-dd'T'HH:mm:ss'Z'。",
          "type": "string",
          "minLength": 20,
          "maxLength": 20
        },
        "image_resolution": {
          "description": "卫星影像分辨率,精确到小数点后一位。",
          "type": "string"
        },
        "image_description": {
          "description": "卫星影像描述。\n格式为中英文、数字、下划线、中划线,长度255个字符以内。",
          "type": "string",
          "pattern": "^[\\一-\\龥\\w_-]{0,255}$",
          "minLength": 0,
          "maxLength": 255
        },
        "image_id": {
          "description": "卫星影像ID。\n格式为英文、数字,长度为32。",
          "type": "string",
          "pattern": "^[\\w]{32,32}$",
          "minLength": 32,
          "maxLength": 32
        },
        "image_type": {
          "description": "卫星影像类型。当前仅支持全色(0)、多光谱(1)。",
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        },
        "user_name": {
          "description": "IAM用户名称。",
          "type": "string",
          "pattern": "^[\\一-\\龥\\w\\_-]$"
        },
        "image_alias": {
          "description": "卫星影像别名。\n格式为中英文、数字、下划线、中划线、“.”,长度255个字符以内。",
          "type": "string",
          "pattern": "^[\\一-\\龥\\w._-]{0,255}$",
          "minLength": 0,
          "maxLength": 255
        },
        "product_clip": {
          "type": "integer",
          "format": "int32",
          "description": "是否为矢量切割影像。当前仅支持是(1)、否(0)。",
          "enum": [
            0,
            1
          ]
        },
        "product_tile": {
          "type": "integer",
          "format": "int32",
          "description": "是否为金字塔切割影像。当前仅支持是(1)、否(0)。",
          "enum": [
            0,
            1
          ]
        },
        "is_cog": {
          "type": "integer",
          "format": "int32",
          "description": "是否为COG影像。当前仅支持是(1)、否(0)。",
          "enum": [
            0,
            1
          ]
        }
      }
    },
    "Page": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "偏移量,表示从第几条数据开始查询。"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "每页包含的查询记录数量。"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "符合查询条件的记录总数。"
        }
      },
      "required": [
        "offset",
        "limit",
        "total"
      ]
    },
    "ImageBaseInfoRsp": {
      "description": "卫星影像数据信息返回",
      "type": "object",
      "required": [
        "data_info",
        "page"
      ],
      "properties": {
        "data_info": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DataInfo"
          },
          "description": "数据信息列表。"
        },
        "page": {
          "description": "分页信息。",
          "$ref": "#/definitions/Page"
        }
      }
    },
    "ErrorMsg": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "请求状态码。",
          "type": "string",
          "minLength": 3,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "koomap.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}