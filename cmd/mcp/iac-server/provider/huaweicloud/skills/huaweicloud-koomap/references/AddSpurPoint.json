        ],
        "operationId": "AddSpurPoint",
        "consumes": [
          "application/json"
        ],
        "summary": "新增图片上的刺点",
        "description": "用户选择生产资料列表中的像控点信息,并在图片中标记出来的过程叫做刺点。该接口用来在图片上新增刺点,刺点的具体信息包括: \n- 像控点的经度、纬度、高度及精度信息。\n- 刺点所在的图片ID,以及在图片中的像素点位置信息,包括横向和纵向像素值。\n- 刺点所属的任务ID信息。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-opseverity": "Info",
        "x-apigateway-request-type": "Public",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "spurInfo",
            "description": "新增的刺点信息。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SpurInfo"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "IAM Token信息,用于租户鉴权,该字段由租户请求IAM的Token接口获得。"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。",
            "schema": {
              "$ref": "#/definitions/SpurInfoDetail"
            },
            "examples": {
              "application/json": {
                "imageCode": "1674019035390013440",
                "id": "1676151290921086976",
                "taskId": "db554dbd410f4c53a2118c6e34a31eb0",
                "pointWidth": "7864.08984",
                "pointHeight": "5433.04541",
                "longitude": "113.87890565212626",
                "latitude": "22.876653471049696",
                "height": "37.884999999999998",
                "accuracy": "0.05"
              }
            }
          },
          "400": {
            "description": "非法请求。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            }
          },
          "500": {
            "description": "服务内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            }
          }
        },
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "x-order": 0
      }
    }
  },
  "definitions": {
