            "description": "追踪请求ID。",
            "required": false,
            "type": "string"
          },
          {
            "name": "App-Id",
            "in": "header",
            "description": "可选项,场景模板分配的app_id;若无,置空。",
            "required": false,
            "type": "string"
          },
          {
            "name": "Uuid",
            "in": "header",
            "description": "设备或者用户唯一标识。",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "IAM Token,和Authorization二选一必传。",
