  "definitions": {
    "NAVIServiceResp": {
      "type": "object",
      "properties": {
        "result": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "接口返回状态码。\n-  0:导航成功\n-  1:起始地点无效\n-  2:目标地点无效\n-  3:未连接\n-  6:栅格数据\n-  8:途径地点无效"
        },
        "path": {
          "type": "array",
          "description": "返回的路径信息。",
          "items": {
            "type": "object",
            "properties": {
              "linkID": {
                "type": "string",
                "example": "",
                "description": "路段ID。"
              },
              "x": {
                "type": "number",
                "format": "float",
                "example": 447715.97,
                "description": "X坐标。"
              },
              "y": {
                "type": "number",
                "format": "float",
                "example": 4418741.0,
                "description": "Y坐标。"
              },
              "z": {
                "type": "number",
                "format": "float",
                "example": 35.75,
                "description": "Z坐标。"
              },
              "floor": {
                "type": "string",
                "example": "1F",
                "description": "楼层信息。"
              },
              "building": {
                "type": "string",
                "example": "sandadian",
                "description": "楼层的描述。"
              },
              "status": {
                "type": "integer",
                "format": "int32",
                "example": 1,
                "description": "路段状态。\n-  0:未经计算\n-  1:直行\n-  2:左转\n-  3:左前方\n-  4:左后方\n-  5:右转\n-  6:右前方\n-  7:右后方\n-  8:直梯\n-  9:终止点\n-  10:扶梯\n-  11:楼梯\n-  12:途经点"
              }
            }
          }
        }
      }
    },
    "NaviServiceReq": {
      "type": "object",
      "required": [
        "payload"
      ],
      "properties": {
        "payload": {
          "type": "object",
          "description": "导航服务请求体。",
          "properties": {
            "from": {
              "type": "object",
              "description": "起始位置。",
              "properties": {
                "x": {
                  "type": "string",
                  "description": "X坐标。"
                },
                "y": {
                  "type": "string",
                  "description": "Y坐标。"
                },
                "z": {
                  "type": "string",
                  "description": "Z坐标。"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ]
            },
            "to": {
              "type": "object",
              "description": "终点位置。",
              "properties": {
                "x": {
                  "type": "string",
                  "description": "X坐标。"
                },
                "y": {
                  "type": "string",
                  "description": "Y坐标。"
                },
                "z": {
                  "type": "string",
                  "description": "Z坐标。"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ]
            },
            "utm": {
              "type": "string",
              "description": "地区UTM编码。"
            }
          },
          "required": [
            "from",
            "to",
            "utm"
          ]
        }
      }
    }
