{
  "name": "CreateTask",
  "summary": "新建任务",
  "tags": "卫星影像任务管理",
  "productshort": "KooMap",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/kmp-control/tasks": {
      "post": {
        "x-request-examples-description-1": "新建处理任务,目前只支持卫星影像处理任务(ORSIP)。",
        "x-request-examples-text-1": "{\n  \"task_name\": \"这是任务描述\",\n  \"task_type\": \"ORSIP\",\n  \"data_ids\": [\n    \"ed9313d537dd4cf7a6a7758f9xxxxd84\",\n    \"8dc0d6187b8e4f429c2d20d34xxxxx5a\"\n  ],\n  \"production_level\": \"L2\",\n  \"task_description\": \"这是任务描述\",\n  \"workspace_id\": \"dfa3527b45a24de6a2d0ddbcb8xxxxxx\",\n  \"shape_id\": null,\n  \"data_alias\": {\n    \"JL1_20160112_203_0018_L2\": \"JL1_20160112_203_0018_L2\"\n  },\n  \"coordination\": \"WGS84\",\n  \"data_description\": {\n    \"JL1_20160112_203_0018_L2\": null\n  },\n  \"csv_ids\": [3cd09e0xbf7949a59c9ec14012a4xxxx],\n  \"is_clip\": \"0\",\n  \"is_tile\": \"0\"\n}",
        "x-request-examples-1": "{\n  \"task_name\": \"这是任务描述\",\n  \"task_type\": \"ORSIP\",\n  \"data_ids\": [\n    \"ed9313d537dd4cf7a6a7758f9xxxxd84\",\n    \"8dc0d6187b8e4f429c2d20d34xxxxx5a\"\n  ],\n  \"production_level\": \"L2\",\n  \"task_description\": \"这是任务描述\",\n  \"workspace_id\": \"dfa3527b45a24de6a2d0ddbcb8xxxxxx\",\n  \"shape_id\": null,\n  \"data_alias\": {\n    \"JL1_20160112_203_0018_L2\": \"JL1_20160112_203_0018_L2\"\n  },\n  \"coordination\": \"WGS84\",\n  \"data_description\": {\n    \"JL1_20160112_203_0018_L2\": null\n  },\n  \"csv_ids\": [3cd09e0xbf7949a59c9ec14012a4xxxx],\n  \"is_clip\": \"0\",\n  \"is_tile\": \"0\"\n}",
        "x-request-examples-url-1": "POST https://{Endpoint}/v1/kmp-control/tasks",
        "tags": [
          "卫星影像任务管理"
        ],
        "operationId": "CreateTask",
        "summary": "新建任务",
        "description": "在工作共享空间内新建数据处理任务,新建任务的“成果影像名称”参数可从“校验原始影像文件”接口中获取。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-opseverity": "Info",
        "x-apigateway-request-type": "Public",
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "task_dto",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateTaskDto"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "IAM Token信息,用于租户鉴权,该字段由租户请求IAM的Token接口获得。"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。",
            "schema": {
              "$ref": "#/definitions/TaskVo"
            },
            "examples": {
              "application/json": {
                "task_id": "4d40e927514a40898d23a20155xxxxxx",
                "workspace_id": "dfa3527b45a24de6a2d0ddbcb8xxxxxx",
                "data_id": "[\"ed9313d537dd4cf7a6a7758f942xxxxx\",\"8dc0d6187b8e4f429c2d20d340xxxxxa\"]",
                "task_name": "测试",
                "domain_id": "234602bf93714dcba145eaa45xxxxxxx",
                "creator": "xxxxx",
                "create_time": "2023-02-17T09:27:07Z",
                "task_status": "INIT",
                "task_type": "ORSIP",
                "task_description": "测试",
                "exec_start_time": null,
                "exec_stop_time": null,
                "origin_data_alias": null,
                "production_level": "L2",
                "task_progress": "0.0",
                "shape_id": null,
                "is_deleted": 0,
                "image_url": null,
                "frozen_tag": null,
                "is_clip": "0",
                "is_tile": "0"
              }
            }
          },
          "400": {
            "description": "非法请求。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            }
          },
          "500": {
            "description": "服务内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            }
          }
        },
        "x-order": 0
      }
    }
  },
  "definitions": {
    "TaskVo": {
      "required": [
        "task_id",
        "workspace_id",
        "data_id",
        "task_name",
        "creator",
        "create_time",
        "task_status",
        "task_type",
        "production_level",
        "task_progress"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务唯一标识ID。",
          "minLength": 32,
          "maxLength": 36,
          "example": "28f61af50fc9452aa0ed5ea25c3cc3d3"
        },
        "workspace_id": {
          "type": "string",
          "description": "工作共享空间ID。",
          "example": "56bf8e2767cd4b44b86e16c21f769c66"
        },
        "data_id": {
          "type": "string",
          "description": "数据ID。",
          "example": [
            "aab1b0770a2a4fcbbb6a6f422b1163b7",
            "add9499ddcca4882bcaf91170d3d5e59"
          ]
        },
        "task_name": {
          "type": "string",
          "description": "任务名称。",
          "minLength": 2,
          "maxLength": 64,
          "example": "MyDemo"
        },
        "creator": {
          "type": "string",
          "description": "创建者ID。",
          "minLength": 2,
          "maxLength": 512,
          "example": "this is a demo"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间。",
          "example": "2022-11-07T08:54:36Z"
        },
        "task_status": {
          "type": "string",
          "description": "任务状态。包括INIT(初始化)、RUNNING(运行中)、SUCCESS(执行成功)、ARCHIVED(已归档)、FAILED(执行失败)、STOPPING(停止中)、STOP_SUCCESS(已停止)、STOP_FAILED(停止失败)、START_RUNNING(等待中)。"
        },
        "task_type": {
          "type": "string",
          "description": "任务类型。\n当前仅支持ORSIP(卫星影像生产)。"
        },
        "task_description": {
          "type": "string",
          "description": "任务描述。"
        },
        "exec_start_time": {
          "type": "string",
          "description": "开始操作时间。\n缺省值:null",
          "example": "2022-11-07T08:54:36Z"
        },
        "exec_stop_time": {
          "type": "string",
          "description": "停止操作时间。\n缺省值:null",
          "example": "2022-11-07T08:54:36Z"
        },
        "origin_data_alias": {
          "type": "string",
          "description": "原始数据别名。"
        },
        "production_level": {
          "type": "string",
          "description": "任务输出结果影像级别,当前支持以下级别: L2、L3、L4、L5。"
        },
        "task_progress": {
          "type": "string",
          "description": "任务执行进度。",
          "example": 0.0
        },
        "shape_id": {
          "type": "string",
          "description": "矢量数据文件ID,“isClip”为“1”时必填。"
        },
        "is_deleted": {
          "type": "integer",
          "format": "int32",
          "description": "是否删除。\n- 0:未删除\n- 1:已删除"
        },
        "image_url": {
          "type": "string",
          "description": "影像链接。"
        },
        "domain_id": {
          "type": "string",
          "description": "租户ID。"
        },
        "fail_message": {
          "type": "string",
          "description": "任务失败原因。"
        },
        "frozen_tag": {
          "type": "string",
          "description": "任务冻结状态。当前仅支持frozen(冻结中)。"
        },
        "isClip": {
          "type": "string",
          "description": "是否为矢量切割。\n- 0:否\n- 1:是"
        },
        "isTile": {
          "type": "string",
          "description": "是否为金字塔切割。\n- 0:否\n- 1:是"
        }
      },
      "type": "object"
    },
    "CreateTaskDto": {
      "type": "object",
      "properties": {
        "task_name": {
          "type": "string",
          "description": "任务名称,支持中英文、数字和“_”,长度为[1,50]。",
          "pattern": "[\\一-\\龥_a-zA-Z0-9_]{1,50}",
          "minLength": 1,
          "maxLength": 50
        },
        "task_type": {
          "type": "string",
          "description": "任务类型,当前仅支持ORSIP(卫星影像生产)。"
        },
        "workspace_id": {
          "type": "string",
          "description": "任务所属工作共享空间ID。",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^[a-z0-9]{32}$"
        },
        "data_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]{32}$"
          },
          "description": "待处理影像文件ID列表。"
        },
        "shape_id": {
          "type": "string",
          "description": "矢量数据文件ID,“isClip”为“1”时必填。",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^[a-z0-9]{32}$"
        },
        "production_level": {
          "type": "string",
          "description": "任务输出结果影像级别,当前支持以下级别: L2、L3、L4、L5。"
        },
        "task_description": {
          "type": "string",
          "description": "任务描述,支持中英文、数字和“_”,长度为[0,255]。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "[\\一-\\龥_a-zA-Z0-9_]{0,255}"
        },
        "data_alias": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "成果影像别名。\nkey从“校验原始影像文件”接口获取。\n- key:成果影像名称\n- value:成果影像别名"
        },
        "coordination": {
          "type": "string",
          "description": "成果影像坐标。"
        },
        "data_description": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "成果影像描述。"
        },
        "csv_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "生产资料(csv文件)ID。"
        },
        "isClip": {
          "type": "string",
          "description": "是否为矢量切割。\n- 0:否\n- 1:是"
        },
        "isTile": {
          "type": "string",
          "description": "是否为金字塔切割。\n- 0:否\n- 1:是"
        }
      },
      "required": [
        "task_name",
        "task_type",
        "workspace_id",
        "data_ids",
        "production_level",
        "data_alias",
        "coordination",
        "data_description",
        "csv_ids",
        "isClip",
        "isTile"
      ],
      "description": "创建任务请求体"
    },
    "ErrorMsg": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "请求状态码。",
          "type": "string",
          "minLength": 3,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "koomap.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}