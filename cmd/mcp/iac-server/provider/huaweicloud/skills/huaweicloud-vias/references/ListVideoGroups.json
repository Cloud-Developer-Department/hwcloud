{
  "name": "ListVideoGroups",
  "summary": "获取视频源分组列表",
  "tags": "视频中心",
  "productshort": "VIAS",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/{project_id}/video-group/groups": {
      "get": {
        "tags": [
          "IVideoGroupController"
        ],
        "summary": "获取视频源分组列表",
        "description": "获取视频源分组列表",
        "operationId": "ListVideoGroups",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "sort_name",
            "in": "query",
            "description": "排序项。可选,可选值(create_at、modify_at、num_video_source、num_task)",
            "required": false,
            "type": "string",
            "default": "create_at",
            "pattern": "create_at|modify_at|num_video_source|num_task"
          },
          {
            "name": "order_by",
            "in": "query",
            "description": "排序顺序,可选,默认倒序,可选值(desc、asc)",
            "required": false,
            "type": "string",
            "default": "desc",
            "pattern": "desc|asc"
          },
          {
            "name": "is_paged",
            "in": "query",
            "description": "是否分页",
            "required": false,
            "type": "boolean",
            "default": false
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "分页每页显示的条目",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 200,
            "minimum": 5,
            "format": "int32"
          },
          {
            "name": "page_num",
            "in": "query",
            "description": "第几页",
            "required": false,
            "type": "integer",
            "default": 1,
            "maximum": 100000,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "name",
            "in": "query",
            "description": "模糊查找参数,可以按分组名称进行模糊查找",
            "required": false,
            "type": "string",
            "maxLength": 20
          },
          {
            "name": "status",
            "in": "query",
            "description": "状态level筛选,可选值(1、2、9)",
            "required": false,
            "type": "string",
            "pattern": "(^$)|(^1|2|9$)"
          },
          {
            "name": "access_type",
            "in": "query",
            "description": "根据接入方式筛选(可多选),可选值(cloud、edge)",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^$|cloud|edge"
            }
          },
          {
            "name": "has_task",
            "in": "query",
            "description": "是否有批量作业",
            "required": false,
            "type": "boolean",
            "default": false
          },
          {
            "name": "type",
            "in": "query",
            "description": "视频源类型筛选(可多选)类型:obs、vcn、url、restful、camera",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^$|obs|vcn|url|restful|camera|VIDEO_PLATFORM|VIDEO_IMAGE_DB|RTSP_STREAM"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "视频源分组列表响应体",
            "examples": {
              "application/json": "{\n  \"video_group_number\": 23,\n  \"total_number\": 23,\n  \"quota_number\": 200,\n  \"video_group_list\": [\n    {\n      \"video_group_id\": \"a9334780-a53c-454e-a3c1-259c54678ec1\",\n      \"video_group_name\": \"test000\",\n      \"num_video_source\": 2,\n      \"group_status\": {\n        \"num_online\": 2,\n        \"num_exception\": 0,\n        \"num_offline\": 0\n      },\n      \"access_type\": \"cloud\",\n      \"create_at\": 1680773327730,\n      \"modify_at\": 1680773463291,\n      \"num_batch_task\": 0,\n      \"type\": \"restful\"\n    }\n}"
            },
            "schema": {
              "$ref": "#/definitions/VideoGroupListResponse"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "/v2/{project_id}/videoGroup/groups?is_paged=true&page_size=10&page_num=1",
        "x-request-examples-text-1": "https://{endpoint}/v2/{project_id}/videoGroup/groups?is_paged=true&page_size=10&page_num=1",
        "x-request-examples-1": "https://{endpoint}/v2/{project_id}/videoGroup/groups?is_paged=true&page_size=10&page_num=1",
        "x-request-examples-description-1": "获取视频源分组列表,展示出账户下的所有视频源分组信息",
        "x-north-bound": true,
        "x-order": 4
      }
    }
  },
  "definitions": {
    "VideoGroupListInfoDto": {
      "type": "object",
      "properties": {
        "video_group_id": {
          "type": "string",
          "description": "视频源分组id"
        },
        "video_group_name": {
          "type": "string",
          "description": "视频源分组名称"
        },
        "num_video_source": {
          "type": "integer",
          "format": "int32",
          "description": "视频源数量"
        },
        "group_status": {
          "description": "分组中视频源状态",
          "$ref": "#/definitions/GroupStatusDto"
        },
        "access_type": {
          "type": "string",
          "description": "接入方式"
        },
        "create_at": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间"
        },
        "modify_at": {
          "type": "integer",
          "format": "int64",
          "description": "最后一次修改时间"
        },
        "num_batch_task": {
          "type": "integer",
          "format": "int32",
          "description": "已配置批量作业数量"
        },
        "type": {
          "type": "string",
          "description": "分组中视频源类型"
        }
      }
    },
    "VideoGroupListResponse": {
      "type": "object",
      "properties": {
        "video_group_number": {
          "type": "integer",
          "format": "int32",
          "description": "分组数量"
        },
        "total_number": {
          "type": "integer",
          "format": "int32",
          "description": "视频源分组总数"
        },
        "quota_number": {
          "type": "integer",
          "format": "int32",
          "description": "视频源分组最大限额"
        },
        "video_group_list": {
          "type": "array",
          "description": "分组列表",
          "items": {
            "$ref": "#/definitions/VideoGroupListInfoDto"
          }
        }
      }
    },
    "GroupStatusDto": {
      "type": "object",
      "properties": {
        "num_online": {
          "type": "integer",
          "format": "int32",
          "description": "在线视频源数量"
        },
        "num_exception": {
          "type": "integer",
          "format": "int32",
          "description": "异常视频源数量"
        },
        "num_offline": {
          "type": "integer",
          "format": "int32",
          "description": "离线视频源数量"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "vias.cn-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}