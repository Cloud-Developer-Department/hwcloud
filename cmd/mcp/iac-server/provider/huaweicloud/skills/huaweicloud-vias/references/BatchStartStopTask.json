{
  "name": "BatchStartStopTask",
  "summary": "启动/停止批量配置任务",
  "tags": "任务中心",
  "productshort": "VIAS",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/{project_id}/batch-tasks/{id}/action/{command}": {
      "put": {
