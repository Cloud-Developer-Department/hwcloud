        ],
        "summary": "启动/停止批量配置任务",
        "description": "启动/停止批量配置任务",
        "operationId": "BatchStartStopTask",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "id",
            "in": "path",
            "description": "批量配置ID",
            "required": true,
            "type": "string",
            "pattern": "^[a-z0-9-_]{4,36}$"
          },
          {
            "name": "command",
            "in": "path",
            "description": "指定该API要对批量任务配置进行的操作,停止或者启动 枚举值:start|stop",
            "required": true,
            "type": "string",
            "pattern": "^(start|stop)$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
