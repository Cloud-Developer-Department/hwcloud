{
  "name": "CreateVideoGroup",
  "summary": "创建视频源分组",
  "tags": "视频中心",
  "productshort": "VIAS",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/{project_id}/video-group": {
      "post": {
        "tags": [
          "IVideoGroupController"
        ],
        "summary": "创建视频源分组",
        "description": "创建视频源分组",
        "operationId": "CreateVideoGroup",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "createVideoGroupDto",
            "description": "创建视频源分组请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateVideoGroupDto"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "创建成功",
            "examples": {
              "application/json": {
                "video_group_id": "a9334780-a53c-454e-a3c1-259c54678ec1"
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateVideoGroupResponseBody"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-north-bound": true,
        "x-request-examples-url-1": "/v2/{project_id}/video-group",
        "x-request-examples-text-1": {
          "video_source_ids": [
            "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx"
          ],
          "video_group_name": "test000",
          "description": "",
          "access_type": "cloud"
        },
        "x-request-examples-1": {
          "video_source_ids": [
            "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx"
          ],
          "video_group_name": "test000",
          "description": "",
          "access_type": "cloud"
        },
        "x-request-examples-description-1": "创建视频源分组请求体",
        "x-order": 0
      }
    }
  },
  "definitions": {
    "CreateVideoGroupDto": {
      "type": "object",
      "required": [
        "access_type",
        "video_group_name"
      ],
      "properties": {
        "video_group_name": {
          "type": "string",
          "description": "视频源分组名称,只能由中文、小写英文字母(a~z)、大写英文字母(A~Z)、数字(0~9)组成, 长度范围为[1, 20]",
          "maxLength": 20,
          "pattern": "^[\\一-\\龥-_a-zA-Z0-9]{1,20}$"
        },
        "description": {
          "type": "string",
          "description": "视频源分组描述",
          "maxLength": 100
        },
        "access_type": {
          "type": "string",
          "description": "接入方式,只能选择cloud 或者 edge",
          "maxLength": 5,
          "pattern": "cloud|edge"
        },
        "video_source_ids": {
          "type": "array",
          "description": "选中分组内视频源id列表,只能由小写英文字母(a~z,)、数字(0~9)、中划线(-)、下划线(\\_)组成, 长度范围为[4, 36]",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-_]{4,36}$"
          },
          "minItems": 1
        }
      }
    },
    "CreateVideoGroupResponseBody": {
      "type": "object",
      "required": [
        "video_group_id"
      ],
      "properties": {
        "video_group_id": {
          "type": "string",
          "description": "视频源分组id"
        }
      },
      "description": "创建视频源分组响应体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "vias.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "post",
  "uri": null
}