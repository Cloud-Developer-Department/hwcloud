{
  "name": "ListUserServices",
  "summary": "我的算法服务列表",
  "tags": "算法中心",
  "productshort": "VIAS",
  "region_id": "ap-southeast-4",
  "paths": {
    "/v2/{project_id}/algorithm/services/user": {
      "get": {
        "tags": [
          "IAlgorithmController"
        ],
        "summary": "我的算法服务列表",
        "description": "我的算法服务列表",
        "operationId": "ListUserServices",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "pattern": "^[a-z0-9]{32}$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "name_like",
            "in": "query",
            "description": "服务名称,支持模糊匹配",
            "required": false,
            "type": "string"
          },
          {
            "name": "is_paged",
            "in": "query",
            "description": "是否分页",
            "required": false,
            "type": "boolean",
            "default": false
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "每页的最大条目数",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 200,
            "minimum": 5,
            "format": "int32"
          },
          {
            "name": "page_num",
            "in": "query",
            "description": "第几页",
            "required": false,
            "type": "integer",
            "default": 1,
            "maximum": 10000,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "order_by",
            "in": "query",
            "description": "排序方式,可选“asc”或“desc”,代表递增排序及递减排序",
            "required": false,
            "type": "string",
            "default": "desc",
            "pattern": "desc|asc"
          },
          {
            "name": "sort_name",
            "in": "query",
            "description": "排序字段,可选“created_at”或“function_version”",
            "required": false,
            "type": "string",
            "default": "created_at",
            "pattern": "created_at|function_version"
          },
          {
            "name": "alg_status",
            "in": "query",
            "description": "服务状态,支持多选。可选“service_running”、“service_deploying”、“service_failed”、“service_stopping”、“service_stopped”、“service_upgrading”、“service_finished”、“service_concerning”、“not_deployed”",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^service_running|service_deploying|service_failed|service_stopping|service_stopped|service_upgrading|service_finished|service_concerning|not_deployed$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "我的算法服务列表响应体",
            "examples": {
              "application/json": {
                "count": 3,
                "service_list": [
                  {
                    "alg_id": "068ed4d8-077e-4ec9-aa19-bc******e925",
