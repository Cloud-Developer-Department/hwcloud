          },
          "400": {
            "description": "请求错误"
          },
          "500": {
            "description": "内部错误"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-north-bound": true,
        "x-for-hc": true,
        "x-request-examples-url-1": "GET https://{endpoint}/v2/{project_id}/algorithm/services/user?alg_status=service_running&alg_status=service_stopped&alg_status=service_failed",
        "x-request-examples-description-1": "我的算法服务列表,过滤出状态为“运行中”、“已停止”或“部署异常”的服务",
        "x-order": 3
      }
    }
  },
  "definitions": {
    "ServiceListResponse": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "数量"
        },
        "service_list": {
          "type": "array",
          "description": "服务列表",
          "items": {
            "$ref": "#/definitions/ServicesListInfoDto"
          }
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "总数数量"
        }
      },
      "description": "查询算法服务响应体"
    },
    "ServicesListInfoDto": {
      "type": "object",
      "properties": {
        "alg_id": {
          "type": "string",
          "description": "算法ID"
        },
        "service_id": {
          "type": "string",
          "description": "服务ID"
        },
        "service_name": {
          "type": "string",
          "description": "服务名称"
        },
        "package_id": {
          "type": "string",
          "description": "算法服务包ID"
        },
        "package_name": {
          "type": "string",
          "description": "算法服务包名称"
        },
        "company": {
          "type": "string",
          "description": "厂商名称"
        },
        "alg_version": {
          "type": "string",
          "description": "算法版本"
        },
        "function_version": {
          "type": "string",
          "description": "功能版本"
        },
        "tags": {
          "type": "array",
          "description": "应用场景标签",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间"
        },
        "alg_status": {
          "type": "string",
          "description": "算法状态,取值为“service_running”、“service_deploying”、“service_failed”、“service_stopping”、“service_stopped”、“service_upgrading”、“service_finished”、“service_concerning”或者“not_deployed”"
        },
        "deploy_type": {
          "type": "string",
          "description": "部署类型,取值为“cloud”或者“edge”"
        },
        "alg_class": {
          "type": "string",
          "description": "算法类别,取值为“self”或者“partner”"
        },
        "request_mode": {
          "type": "string",
          "description": "请求模式,取值为“sync”或者“async”",
          "pattern": "sync|async"
        },
        "description": {
          "type": "string",
          "description": "算法描述,信息非空时返回"
        },
        "error_msg": {
          "type": "string",
          "description": "服务异常信息,信息非空时返回"
        },
        "can_update": {
          "type": "boolean",
          "description": "是否可升级,值为true时返回"
        },
        "new_alg_id": {
          "type": "string",
          "description": "升级后的算法ID,可升级时返回"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
