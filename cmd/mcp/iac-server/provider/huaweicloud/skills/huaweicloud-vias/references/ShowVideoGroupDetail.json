        "video_group_name": {
          "type": "string",
          "description": "视频源所在分组名称"
        },
        "description": {
          "type": "string",
          "description": "视频源所在分组描述"
        },
        "access_type": {
          "type": "string",
          "description": "接入方式(cloud、edge)"
        },
        "create_at": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间"
        },
        "modify_at": {
          "type": "integer",
          "format": "int64",
          "description": "修改时间"
        },
        "num_video_source": {
          "type": "integer",
          "format": "int32",
          "description": "视频源数量"
        },
        "group_status": {
          "description": "视频源状态",
          "$ref": "#/definitions/GroupStatusDto"
        },
        "num_batch_task": {
          "type": "integer",
          "format": "int32",
