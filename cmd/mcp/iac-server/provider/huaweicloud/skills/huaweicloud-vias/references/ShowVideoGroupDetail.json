        }
      }
    },
    "GroupStatusDto": {
      "type": "object",
      "properties": {
        "num_online": {
          "type": "integer",
          "format": "int32",
          "description": "在线视频源数量"
        },
        "num_exception": {
          "type": "integer",
          "format": "int32",
          "description": "异常视频源数量"
        },
        "num_offline": {
          "type": "integer",
          "format": "int32",
