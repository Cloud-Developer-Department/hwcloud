{
  "name": "ShowVideoGroupDetail",
  "summary": "获取视频源分组详情",
  "tags": "视频中心",
  "productshort": "VIAS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v2/{project_id}/video-group/{video_group_id}": {
      "get": {
        "tags": [
          "IVideoGroupController"
        ],
        "summary": "获取视频源分组详情",
        "description": "获取视频源分组详情",
        "operationId": "ShowVideoGroupDetail",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "video_group_id",
            "in": "path",
            "description": "视频源分组id,只能由小写英文字母(a~z)、数字(0~9)、中划线(-)、下划线(\\_)组成长度范围是[4,36]",
            "required": true,
            "type": "string",
            "pattern": "^[a-z0-9-_]{4,36}$"
          }
        ],
        "responses": {
          "200": {
            "description": "视频源分组信息",
            "examples": {
              "application/json": {
                "video_group_id": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx",
                "video_group_name": "test000",
                "description": "",
                "access_type": "cloud",
                "create_at": 1680773327730,
                "modify_at": 1680773463291,
                "num_video_source": 2,
                "group_status": {
                  "num_online": 2,
                  "num_exception": 0,
                  "num_offline": 0
                },
                "num_batch_task": 0
              }
            },
            "schema": {
              "$ref": "#/definitions/VideoGroupInfoDto"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-north-bound": true,
        "x-request-examples-url-1": "/v2/{project_id}/video-group/{video_group_id}",
        "x-request-examples-description-1": "获取视频源分组详情,展示分组名称,接入方式,分组下面的视频源列表等分组信息",
        "x-request-examples-text-1": "https://{endpoint}/v2/{project_id}/video-group/{video_group_id}",
        "x-request-examples-1": "https://{endpoint}/v2/{project_id}/video-group/{video_group_id}",
        "x-order": 3
      }
    }
  },
