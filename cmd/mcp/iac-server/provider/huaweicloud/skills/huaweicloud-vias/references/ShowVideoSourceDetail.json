{
  "name": "ShowVideoSourceDetail",
  "summary": "获取视频源详情",
  "tags": "视频中心",
  "productshort": "VIAS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v2/{project_id}/source/sources/{video_source_id}": {
      "get": {
        "tags": [
          "IVideoSourceController"
        ],
        "summary": "获取视频源详情",
        "description": "视频源详情展示",
        "operationId": "ShowVideoSourceDetail",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "video_source_id",
            "in": "path",
            "description": "已创建成功的视频源id,只能由小写英文字母(a~z)、数字(0~9)、中划线(-)、下划线(_)组成, 长度范围为[4, 36]",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "pattern": "^[a-z0-9-_]{4,36}$"
          }
        ],
        "responses": {
          "200": {
            "description": "视频源详情",
            "examples": {
              "application/json": {
                "video_source_name": "url_test",
                "access_type": "cloud",
                "status": {
                  "status": "Online",
                  "name": "在线",
                  "level": "1"
                },
                "type": "url",
                "latitude": "",
                "longitude": "",
                "create_at": 1680772763191,
                "type_config": "<type_config>        <url_address>rtsp://12.12.12.12:333</url_address>      </type_config>",
                "video_packages": [],
                "service_config_templates": [],
                "stream_path": "rtsp://12.12.12.12:333",
                "tag": [],
                "device_id": "1680772763191",
                "scene_recommend": [],
                "video_source_quality": []
              }
            },
            "schema": {
              "$ref": "#/definitions/VideoSourceInfoDto"
            }
          },
          "400": {
            "description": "参数错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-north-bound": true,
        "x-request-examples-url-1": "v2/{project_id}/source/sources/{video_source_id}",
        "x-request-examples-text-1": "https://{endpoint}/v2/{project_id}/source/sources/{video_source_id}",
        "x-request-examples-1": "https://{endpoint}/v2/{project_id}/source/sources/{video_source_id}",
        "x-request-examples-description-1": "获取视频源详情,展示视频源名称,接入类型,状态等视频源信息",
        "x-is-registered": "Y",
        "x-order": 3
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "advice",
        "detail",
        "error_code",
        "error_msg",
        "params",
        "reason"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "example": "VIAS.00010001",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "Invalid parameter: user_id.",
          "description": "错误信息描述"
        },
        "detail": {
          "type": "string",
          "description": "错误详情"
        },
        "params": {
          "type": "array",
          "description": "错误参数列举",
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 0
        },
        "reason": {
          "type": "string",
          "example": "Invalid parameter.",
          "description": "错误原因"
        },
        "advice": {
          "type": "string",
          "example": "Ensure that the entered parameter is valid.",
          "description": "建议"
        }
      },
      "description": "400,401,500等错误码响应"
    },
    "VideoGroupInfoDto": {
      "type": "object",
      "properties": {
        "video_group_id": {
          "type": "string",
          "description": "视频源所在分组id"
        },
        "video_group_name": {
          "type": "string",
          "description": "视频源所在分组名称"
        },
        "description": {
          "type": "string",
          "description": "视频源所在分组描述"
        },
        "access_type": {
          "type": "string",
          "description": "接入方式(cloud、edge)"
        },
        "create_at": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间"
        },
        "modify_at": {
          "type": "integer",
          "format": "int64",
          "description": "修改时间"
        },
        "num_video_source": {
          "type": "integer",
          "format": "int32",
          "description": "视频源数量"
        },
        "group_status": {
          "description": "视频源状态",
          "$ref": "#/definitions/GroupStatusDto"
        },
        "num_batch_task": {
          "type": "integer",
          "format": "int32",
          "description": "已配置批量作业数量"
        }
      }
    },
    "VideoSourceStatusInfoDto": {
      "type": "object",
      "required": [
        "level",
        "name",
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "description": "视频源状态"
        },
        "name": {
          "type": "string",
          "description": "状态中文名"
        },
        "level": {
          "type": "string",
          "description": "状态等级(用于前端图片颜色匹配)"
        }
      },
      "description": "视频源状态"
    },
    "GroupStatusDto": {
      "type": "object",
      "properties": {
        "num_online": {
          "type": "integer",
          "format": "int32",
          "description": "在线视频源数量"
        },
        "num_exception": {
          "type": "integer",
          "format": "int32",
          "description": "异常视频源数量"
        },
        "num_offline": {
          "type": "integer",
          "format": "int32",
          "description": "离线视频源数量"
        }
      }
    },
    "VideoSourceInfoDto": {
      "type": "object",
      "required": [
        "access_type",
        "type",
        "video_source_name"
      ],
      "properties": {
        "video_source_name": {
          "type": "string",
          "description": "视频源名称,只支持中文、英文字母(a-z,A-Z)、数字、特殊字符(空格.-_() ()),不能以空格开头和结尾\n最小长度:1\n最大长度:100"
        },
        "access_type": {
          "type": "string",
          "description": "接入类型(cloud、edge)"
        },
        "status": {
          "description": "数据源状态",
          "$ref": "#/definitions/VideoSourceStatusInfoDto"
        },
        "type": {
          "type": "string",
          "description": "类型:obs、vcn、url、restful、camera"
        },
        "latitude": {
          "type": "string",
          "description": "视频源的地理位置信息,纬度,-90.00000~90.00000"
        },
        "longitude": {
          "type": "string",
          "description": "视频源的地理位置信息,经度,-180.00000~180.00000"
        },
        "create_at": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间"
        },
        "type_config": {
          "type": "string",
          "description": "视频源配置信息xml"
        },
        "video_packages": {
          "type": "array",
          "description": "视频源所在分组",
          "items": {
            "$ref": "#/definitions/VideoGroupInfoDto"
          }
        },
        "service_config_templates": {
          "type": "array",
          "description": "算法模板体",
          "items": {
            "$ref": "#/definitions/VideoServiceConfigTemplateDto"
          }
        },
        "stream_path": {
          "type": "string",
          "description": "流地址"
        },
        "image": {
          "type": "string",
          "description": "视频源截图的base64转码"
        },
        "tag": {
          "type": "array",
          "description": "视频源标签,标签最多选择4个,标签内容只能由中文, 英文字母(a~z, A~Z)、数字(0~9)、中划线(-)、下划线(_)组成,\n最小长度:1\n最大长度:10",
          "items": {
            "type": "string"
          }
        },
        "scene_recommend": {
          "type": "array",
          "description": "智能算法推荐的标签",
          "items": {
            "type": "string"
          }
        },
        "video_source_quality": {
          "type": "array",
          "description": "视频源的视频流质量:\nBlurry:画面模糊;\nColorDistortion:画面颜色失真;\nAbnormalLight:画面光线异常;\nScreenSplash:画面花屏异常;\nScreenJitter:画面抖动;\nScreenMovement:画面移动;\nSceneUpheaval:画面剧变;\nScreenFreeze:画面冻结;\nBlackScreen:黑屏;\nSnowNoise:雪花噪声;\nOcclude:遮挡;\nGrayScreen:灰屏;ScreenSmudge:画面污迹",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "VideoServiceConfigTemplateDto": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "算法服务名称"
        },
        "roi": {
          "type": "string",
          "description": "公共roi"
        },
        "serviceConfig": {
          "type": "string",
          "description": "算法服务公共配置"
        },
        "createAt": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间"
        },
        "modifyAt": {
          "type": "integer",
          "format": "int64",
          "description": "修改时间"
        },
        "numTask": {
          "type": "integer",
          "format": "int32",
          "description": "已运行算法数量"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "vias.ap-southeast-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}