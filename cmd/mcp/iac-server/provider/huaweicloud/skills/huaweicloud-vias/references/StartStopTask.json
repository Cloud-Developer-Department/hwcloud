        "tags": [
          "ITaskController"
        ],
        "summary": "任务启停",
        "description": "该接口用于启动或停止任务",
        "operationId": "StartStopTask",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "pattern": "[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "task_id",
            "in": "path",
            "description": "已创建成功任务的id信息",
            "required": true,
            "type": "string",
            "pattern": "^[a-z0-9-_]{4,36}$"
          },
          {
            "name": "command",
            "in": "path",
            "description": "指定该API要对任务进行的操作,停止或者启动",
            "required": true,
            "type": "string",
            "pattern": "^(start|stop)$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          }
