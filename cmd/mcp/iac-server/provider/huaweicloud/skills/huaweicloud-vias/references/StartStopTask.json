{
  "name": "StartStopTask",
  "summary": "任务启停",
  "tags": "任务中心",
  "productshort": "VIAS",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/{project_id}/tasks/{task_id}/action/{command}": {
