{
  "name": "ListTasks",
  "summary": "获取任务列表",
  "tags": "任务中心",
  "productshort": "VIAS",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/{project_id}/tasks": {
      "get": {
        "tags": [
          "ITaskController"
        ],
        "summary": "获取任务列表",
        "description": "获取任务列表",
        "operationId": "ListTasks",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "pattern": "[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "source_data_type",
            "in": "query",
            "description": "任务类型,用作查询过滤。仅支持async_task与sync_task两种类型。",
            "required": false,
            "type": "string",
            "pattern": "^(async_task|sync_task)$"
          },
          {
            "name": "title",
            "in": "query",
            "description": "算法中文名,需要满足正则表达式^[a-zA-Z0-9\\一-\\龥-_\\,]{2,64}$",
            "required": false,
            "type": "string",
            "pattern": "^[a-zA-Z0-9\\一-\\龥-_\\,]{2,64}$"
          },
          {
            "name": "camera_name",
            "in": "query",
            "description": "摄像头名称",
            "required": false,
            "type": "string",
            "maxLength": 255
          },
          {
            "name": "task_state",
            "in": "query",
            "description": "任务状态,状态可选PENDING|RECOVERING|STARTING|UPGRADING|CREATE_FAILED|START_FAILED|RUNNING|STOPPING|STOPPED|ABNORMAL|SUCCEEDED|FAILED|DELETING|FREEZING|FROZEN|SCHEDULING|LACK_OF_RESOURCES",
            "required": false,
            "type": "string",
            "pattern": "PENDING|RECOVERING|STARTING|UPGRADING|CREATE_FAILED|START_FAILED|RUNNING|STOPPING|STOPPED|ABNORMAL|SUCCEEDED|FAILED|DELETING|FREEZING|FROZEN|SCHEDULING|LACK_OF_RESOURCES"
          },
          {
            "name": "task_name",
            "in": "query",
            "description": "任务名称",
            "required": false,
            "type": "string",
            "maxLength": 1024
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "每页显示的条目数量",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 1000,
            "minimum": 5,
            "format": "int32"
          },
          {
            "name": "page",
            "in": "query",
            "description": "偏移量",
            "required": false,
            "type": "integer",
            "default": 1,
            "format": "int32"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "展示服务任务时的排序规则",
            "required": false,
            "type": "string",
            "default": "desc",
            "pattern": "desc|asc"
          },
          {
            "name": "batch_id",
            "in": "query",
            "description": "批量配置ID,需要满足正则表达式^[a-z0-9-_]{4,36}$",
            "required": false,
            "type": "string",
            "pattern": "^[a-z0-9-_]{4,36}$"
          },
          {
            "name": "video_group_id",
            "in": "query",
            "description": "视频分组ID(多个ID英文逗号分隔拼接),长度要求[4,2048]",
            "required": false,
            "type": "string",
            "pattern": "^[a-z0-9-_]{4,2048}$"
          },
          {
            "name": "company",
            "in": "query",
            "description": "厂商(多选时逗号分隔拼接)",
            "required": false,
            "type": "string",
            "pattern": "^[\\一-\\龥a-zA-Z0-9\\,_-]{0,100}$"
          },
          {
            "name": "alg_id",
            "in": "query",
            "description": "算法ID,需要满足正则表达式^[0-9a-f]{8}-[0-9a-f]{4}-[4][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "required": false,
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[4][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询作业列表响应体",
            "examples": {
              "application/json": {
                "count": 2,
                "tasks": [
                  {
                    "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                    "name": "qqqq_task",
                    "service_id": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx",
                    "created_at": "1686034773024",
                    "state": "PENDING",
                    "video_source_name": "url_test",
                    "title": "testwjh",
                    "type": "0",
                    "algorithm_publish_id": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx"
                  },
                  {
                    "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                    "name": "task_test1",
                    "service_id": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx",
                    "created_at": "1686027880205",
                    "state": "STOPPED",
                    "video_source_name": "test_g11",
                    "title": "alg_test",
                    "type": "0",
                    "algorithm_publish_id": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx"
                  }
                ],
                "page": 1,
                "page_size": 10
              }
            },
            "schema": {
              "$ref": "#/definitions/TaskListDto"
            }
          },
          "400": {
            "description": "请求错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-north-bound": true,
        "x-request-examples-url-1": "/v2/{project_id}/tasks",
        "x-request-examples-description-1": "获取任务列表,展示出状态为“运行中”,“运行成功”,“已停止”,“等待中”,“运行失败”或者“异常”的任务",
        "x-request-examples-text-1": "https://{endpoint}/v2/{project_id}/tasks?page=1&page_size=10",
        "x-request-examples-1": "https://{endpoint}/v2/{project_id}/tasks?page=1&page_size=10",
        "x-is-registered": "Y",
        "x-order": 3
      }
    }
  },
  "definitions": {
    "TaskInfo": {
      "type": "object",
      "required": [
        "algorithm_publish_id",
        "created_at",
        "id",
        "name",
        "service_id",
        "state",
        "title",
        "type",
        "video_source_name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "example": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
          "description": "任务ID"
        },
        "name": {
          "type": "string",
          "example": "task_test1",
          "description": "任务的名称"
        },
        "service_id": {
          "type": "string",
          "example": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx",
          "description": "任务对应服务的ID"
        },
        "created_at": {
          "type": "string",
          "example": "1686027880205",
          "description": "任务创建的时间"
        },
        "state": {
          "type": "string",
          "example": "STOPPED",
          "description": "任务当前的状态,分别为PENDING(等待中),RECOVERING(恢复中),STARTING(启动中),UPGRADING(升级中),CREATE_FAILED(创建失败),START_FAILED(启动失败),RUNNING(运行中),STOPPING(停止中),STOPPED(已停止),ABNORMAL(异常),SUCCEEDED(运行成功),FAILED(运行失败),DELETING(删除中),FREEZING(冻结中),FROZEN(已冻结)"
        },
        "video_source_name": {
          "type": "string",
          "example": "test_g11",
          "description": "视频源名称"
        },
        "title": {
          "type": "string",
          "example": "alg_test",
          "description": "算法中文名称"
        },
        "type": {
          "type": "string",
          "example": "0",
          "description": "任务类型(0:云上任务 1:边缘任务)"
        },
        "algorithm_publish_id": {
          "type": "string",
          "example": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx",
          "description": "算法id"
        }
      },
      "description": "查询任务列表响应体"
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "advice",
        "detail",
        "error_code",
        "error_msg",
        "params",
        "reason"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "example": "VIAS.00010001",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "Invalid parameter: user_id.",
          "description": "错误信息描述"
        },
        "detail": {
          "type": "string",
          "description": "错误详情"
        },
        "params": {
          "type": "array",
          "description": "错误参数列举",
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 0
        },
        "reason": {
          "type": "string",
          "example": "Invalid parameter.",
          "description": "错误原因"
        },
        "advice": {
          "type": "string",
          "example": "Ensure that the entered parameter is valid.",
          "description": "建议"
        }
      },
      "description": "400,401,500等错误码响应"
    },
    "TaskListDto": {
      "type": "object",
      "required": [
        "count",
        "page",
        "page_size",
        "tasks"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "当前页面的条目数"
        },
        "tasks": {
          "type": "array",
          "description": "查询到的任务列表信息",
          "items": {
            "$ref": "#/definitions/TaskInfo"
          }
        },
        "page": {
          "type": "integer",
          "format": "int32",
          "description": "当前页号"
        },
        "page_size": {
          "type": "integer",
          "format": "int32",
          "description": "分页尺寸"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "vias.cn-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}