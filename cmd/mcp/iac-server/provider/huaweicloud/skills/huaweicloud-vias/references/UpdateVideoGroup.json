{
  "name": "UpdateVideoGroup",
  "summary": "更新视频源分组",
  "tags": "视频中心",
  "productshort": "VIAS",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/video-group/{video_group_id}": {
      "put": {
        "tags": [
          "IVideoGroupController"
        ],
        "summary": "更新视频源分组",
        "description": "更新视频源分组",
        "operationId": "UpdateVideoGroup",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "video_group_id",
            "in": "path",
            "description": "已创建成功的视频源分组id。只能由小写英文字母(a~z)、数字(0~9)、中划线(-)、下划线(\\_)组成长度范围是[4,36]",
            "required": true,
            "type": "string",
            "pattern": "^[a-z0-9-_]{4,36}$"
          },
          {
            "in": "body",
            "name": "updateVideoGroupDto",
            "description": "内含选中videoSource列表",
            "required": false,
            "schema": {
              "$ref": "#/definitions/UpdateVideoGroupDto"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "更新成功",
            "schema": {
              "type": "string"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-north-bound": true,
        "x-request-examples-url-1": "/v2/{project_id}/video-group/{video_group_id}",
        "x-request-examples-text-1": {
          "video_source_ids": [
            "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx",
            "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx"
          ],
          "video_group_name": "test000",
          "description": ""
        },
        "x-request-examples-1": {
          "video_source_ids": [
            "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx",
            "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx"
          ],
          "video_group_name": "test000",
          "description": ""
        },
        "x-request-examples-description-1": "修改视频源分组请求体",
        "x-order": 2
      }
    }
  },
  "definitions": {
    "UpdateVideoGroupDto": {
      "type": "object",
      "required": [
        "video_source_ids"
      ],
      "properties": {
        "video_group_name": {
          "type": "string",
          "description": "视频源分组名称。如不传入则不修改名称,传入则只能由中文、中划线(-)、下划线(\\_)、英文字母(a~z)、数字(0~9)组成长度范围为[1, 20]",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[\\一-\\龥-_a-zA-Z0-9]{1,20}$"
        },
        "description": {
          "type": "string",
          "description": "描述。如不传入则不修改描述。",
          "maxLength": 100
        },
        "video_source_ids": {
          "type": "array",
          "description": "分组中的视频源id集。id个数需在1~50,每个id只能由小写英文字母(a~z,)、数字(0~9)、中划线(-)、下划线(\\_)组成长度范围为[4, 36]",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-_]{4,36}$"
          },
          "maxItems": 50,
          "minItems": 1
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "vias.ap-southeast-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "put",
  "uri": null
}