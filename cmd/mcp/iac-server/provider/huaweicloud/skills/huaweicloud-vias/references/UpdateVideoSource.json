{
  "name": "UpdateVideoSource",
  "summary": "修改视频源",
  "tags": "视频中心",
  "productshort": "VIAS",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/{project_id}/source/{video_source_id}": {
      "put": {
        "tags": [
          "IVideoSourceController"
        ],
        "summary": "修改视频源",
        "description": "修改视频源",
        "operationId": "UpdateVideoSource",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "video_source_id",
            "in": "path",
            "description": "已创建成功的视频源id,只能由小写英文字母(a~z,)、数字(0~9)、中划线(-)、下划线(\\_)长度范围为[4, 36]",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "pattern": "^[0-9a-z-_]{4,36}$"
          },
          {
            "in": "body",
            "name": "UpdateVideoSource",
            "description": "修改视频源请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateVideoSourceDto"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "更新视频源响应体",
            "examples": {
              "application/json": {
                "video_source_name": "url_test",
                "access_type": "cloud",
                "status": {
                  "status": "Online",
                  "name": "在线",
                  "level": "1"
                },
                "type": "url",
                "latitude": "",
                "longitude": "",
                "create_at": 1680772763191,
                "type_config": "<type_config>        <url_address>rtsp://12.12.12.12:333</url_address>      </type_config>",
                "stream_path": "rtsp://12.12.12.12:333",
                "tag": [
                  "1"
                ],
                "device_id": "1680772763191",
                "scene_recommend": [],
                "video_source_quality": []
              }
            },
            "schema": {
              "$ref": "#/definitions/VideoSourceInfoDto"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-north-bound": true,
        "x-request-examples-url-1": "/v2/{project_id}/source/{video_source_id}",
        "x-request-examples-description-1": "修改视频源请求体",
        "x-request-examples-text-1": {
          "video_source_name": "url_test",
          "access_type": "cloud",
          "type": "url",
          "longitude": "",
          "latitude": "",
          "tag": [
            "1"
          ],
          "video_group_ids": [],
          "type_config": "<type_config>        <url_address>rtsp://12.12.12.12:333</url_address>      </type_config>"
        },
        "x-request-examples-1": {
          "video_source_name": "url_test",
          "access_type": "cloud",
          "type": "url",
          "longitude": "",
          "latitude": "",
          "tag": [
            "1"
          ],
          "video_group_ids": [],
          "type_config": "<type_config>        <url_address>rtsp://12.12.12.12:333</url_address>      </type_config>"
        },
        "x-order": 1
      }
    }
  },
  "definitions": {
    "VideoGroupInfoDto": {
      "type": "object",
      "properties": {
        "video_group_id": {
          "type": "string",
          "description": "视频源所在分组id"
        },
        "video_group_name": {
          "type": "string",
          "description": "视频源所在分组名称"
        },
        "description": {
          "type": "string",
          "description": "视频源所在分组描述"
        },
        "access_type": {
          "type": "string",
          "description": "接入方式(cloud、edge)"
        },
        "create_at": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间"
        },
        "modify_at": {
          "type": "integer",
          "format": "int64",
          "description": "修改时间"
        },
        "num_video_source": {
          "type": "integer",
          "format": "int32",
          "description": "视频源数量"
        },
        "group_status": {
          "description": "视频源状态",
          "$ref": "#/definitions/GroupStatusDto"
        },
        "num_batch_task": {
          "type": "integer",
          "format": "int32",
          "description": "已配置批量作业数量"
        }
      }
    },
    "VideoSourceStatusInfoDto": {
      "type": "object",
      "required": [
        "level",
        "name",
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "description": "视频源状态"
        },
        "name": {
          "type": "string",
          "description": "状态中文名"
        },
        "level": {
          "type": "string",
          "description": "状态等级(用于前端图片颜色匹配)"
        }
      },
      "description": "视频源状态"
    },
    "UpdateVideoSourceDto": {
      "type": "object",
      "required": [
        "type_config",
        "video_source_name"
      ],
      "properties": {
        "video_source_name": {
          "type": "string",
          "description": "视频源名称,只支持中文、英文字母(a-z,A-Z)、数字、特殊字符(空格.-_() ()),不能以空格开头和结尾",
          "minLength": 0,
          "maxLength": 100,
          "pattern": "^$|^([\\一-\\龥a-zA-Z0-9()()._-]|([\\一-\\龥a-zA-Z0-9()()._-][\\一-\\龥a-zA-Z0-9 ()()._-]{0,98}[\\一-\\龥a-zA-Z0-9()()._-]))$"
        },
        "latitude": {
          "type": "string",
          "description": "视频源的地理位置信息,纬度,-90.00000~90.00000",
          "pattern": "^$|^[+-]?(([0-8]?\\d(\\.\\d{1,5})?)|(90(\\.0{1,5})?))$"
        },
        "longitude": {
          "type": "string",
          "description": "视频源的地理位置信息,经度,-180.00000~180.00000",
          "pattern": "^$|^-?((([0-9]\\d?|1[0-7]\\d)(\\.\\d{1,5})?)|180(\\.0{1,5})?)$"
        },
        "type_config": {
          "type": "string",
          "description": "视频源配置信息xml\nurl形式:\n\\<type>URL\\</type>\n\\<config>\n\\<URL_ADDRESS>\\</URL_ADDRESS>\n\\</config>\nvcn形式:\n\\<type>VCN\\</type>\n\\<config>\n<DATA_SOURCE_ID>\\</DATA_SOURCE_ID>\n<STREAM_TYPE>\\</STREAM_TYPE>\n\\<IP>\\</IP>\n\\<PORT>\\</PORT>\n<USER_NAME>\\</USER_NAME>\n\\<PASSWORD>\\</PASSWORD>\n\\</config>\nrestful形式:\n\\<type>RESTFUL\\</type>\n\\<config>\n<HTTP_CHECK>\\</HTTP_CHECK>\n\\<URL>\\</URL>\n<RTSP_URL>\\</RTSP_URL>\n\\</config>\ncamera形式:\n\\<type>CAMERA\\</type>\n\\<config>\n\\<EDGE_CAMERA_ID>\\</EDGE_CAMERA_ID>\n\\</config>",
          "maxLength": 1024
        },
        "tag": {
          "type": "array",
          "description": "视频源标签,标签最多选择4个,标签内容只能由中文, 英文字母(a~z, A~Z)、数字(0~9)、中划线(-)、下划线(_)组成, \n最小长度:1\n最大长度:10",
          "items": {
            "type": "string",
            "pattern": "^[\\一-\\龥a-zA-Z0-9,_-]{1,10}$"
          },
          "maxItems": 4
        }
      }
    },
    "GroupStatusDto": {
      "type": "object",
      "properties": {
        "num_online": {
          "type": "integer",
          "format": "int32",
          "description": "在线视频源数量"
        },
        "num_exception": {
          "type": "integer",
          "format": "int32",
          "description": "异常视频源数量"
        },
        "num_offline": {
          "type": "integer",
          "format": "int32",
          "description": "离线视频源数量"
        }
      }
    },
    "VideoSourceInfoDto": {
      "type": "object",
      "required": [
        "access_type",
        "type",
        "video_source_name"
      ],
      "properties": {
        "video_source_name": {
          "type": "string",
          "description": "视频源名称,只支持中文、英文字母(a-z,A-Z)、数字、特殊字符(空格.-_() ()),不能以空格开头和结尾\n最小长度:1\n最大长度:100"
        },
        "access_type": {
          "type": "string",
          "description": "接入类型(cloud、edge)"
        },
        "status": {
          "description": "数据源状态",
          "$ref": "#/definitions/VideoSourceStatusInfoDto"
        },
        "type": {
          "type": "string",
          "description": "类型:obs、vcn、url、restful、camera"
        },
        "latitude": {
          "type": "string",
          "description": "视频源的地理位置信息,纬度,-90.00000~90.00000"
        },
        "longitude": {
          "type": "string",
          "description": "视频源的地理位置信息,经度,-180.00000~180.00000"
        },
        "create_at": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间"
        },
        "type_config": {
          "type": "string",
          "description": "视频源配置信息xml"
        },
        "video_packages": {
          "type": "array",
          "description": "视频源所在分组",
          "items": {
            "$ref": "#/definitions/VideoGroupInfoDto"
          }
        },
        "service_config_templates": {
          "type": "array",
          "description": "算法模板体",
          "items": {
            "$ref": "#/definitions/VideoServiceConfigTemplateDto"
          }
        },
        "stream_path": {
          "type": "string",
          "description": "流地址"
        },
        "image": {
          "type": "string",
          "description": "视频源截图的base64转码"
        },
        "tag": {
          "type": "array",
          "description": "视频源标签,标签最多选择4个,标签内容只能由中文, 英文字母(a~z, A~Z)、数字(0~9)、中划线(-)、下划线(_)组成,\n最小长度:1\n最大长度:10",
          "items": {
            "type": "string"
          }
        },
        "scene_recommend": {
          "type": "array",
          "description": "智能算法推荐的标签",
          "items": {
            "type": "string"
          }
        },
        "video_source_quality": {
          "type": "array",
          "description": "视频源的视频流质量:\nBlurry:画面模糊;\nColorDistortion:画面颜色失真;\nAbnormalLight:画面光线异常;\nScreenSplash:画面花屏异常;\nScreenJitter:画面抖动;\nScreenMovement:画面移动;\nSceneUpheaval:画面剧变;\nScreenFreeze:画面冻结;\nBlackScreen:黑屏;\nSnowNoise:雪花噪声;\nOcclude:遮挡;\nGrayScreen:灰屏;ScreenSmudge:画面污迹",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "VideoServiceConfigTemplateDto": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "算法服务名称"
        },
        "roi": {
          "type": "string",
          "description": "公共roi"
        },
        "serviceConfig": {
          "type": "string",
          "description": "算法服务公共配置"
        },
        "createAt": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间"
        },
        "modifyAt": {
          "type": "integer",
          "format": "int64",
          "description": "修改时间"
        },
        "numTask": {
          "type": "integer",
          "format": "int32",
          "description": "已运行算法数量"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "vias.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "put",
  "uri": null
}