{
  "name": "CreateVideoSource",
  "summary": "创建视频源",
  "tags": "视频中心",
  "productshort": "VIAS",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/{project_id}/source": {
      "post": {
        "tags": [
          "IVideoSourceController"
        ],
        "summary": "创建视频源",
        "description": "创建视频源",
        "operationId": "CreateVideoSource",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "CreateVideoSourceRequest",
            "description": "创建视频源请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateVideoSourceDto"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "视频源信息",
            "examples": {
              "application/json": {
                "video_source_id": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx"
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateVideoSourceResponseBody"
            }
          }
        },
        "x-north-bound": true,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "/v2/{project_id}/source/sources/{video_source_id}",
        "x-request-examples-description-1": "创建视频源请求体",
        "x-request-examples-text-1": {
          "video_source_name": "url_test",
          "access_type": "cloud",
          "type": "url",
          "longitude": "",
          "latitude": "",
          "tag": [],
          "video_group_ids": [],
          "type_config": "<type_config>        <url_address>rtsp://12.12.12.12:333</url_address>      </type_config>"
        },
        "x-request-examples-1": {
          "video_source_name": "url_test",
          "access_type": "cloud",
          "type": "url",
          "longitude": "",
          "latitude": "",
          "tag": [],
          "video_group_ids": [],
          "type_config": "<type_config>        <url_address>rtsp://12.12.12.12:333</url_address>      </type_config>"
        },
        "x-order": 0
      }
    }
  },
  "definitions": {
    "CreateVideoSourceResponseBody": {
      "type": "object",
      "required": [
        "video_source_id"
      ],
      "properties": {
        "video_source_id": {
          "type": "string",
          "description": "视频源id"
        }
      },
      "description": "创建视频源响应体"
    },
    "CreateVideoSourceDto": {
      "type": "object",
      "required": [
        "access_type",
        "type",
        "type_config",
        "video_source_name"
      ],
      "properties": {
        "video_source_name": {
          "type": "string",
          "description": "视频源名称,只支持中文、英文字母(a-z,A-Z)、数字、特殊字符(空格.-_() ()),不能以空格开头和结尾",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^([\\一-\\龥a-zA-Z0-9()()._-]|([\\一-\\龥a-zA-Z0-9()()._-][\\一-\\龥a-zA-Z0-9 ()()._-]{0,98}[\\一-\\龥a-zA-Z0-9()()._-]))$"
        },
        "access_type": {
          "type": "string",
          "description": "接入类型(cloud、edge)",
          "pattern": "cloud|edge"
        },
        "type": {
          "type": "string",
          "description": "类型:obs、vcn、url、restful、camera",
          "pattern": "obs|vcn|url|restful|camera|VIDEO_PLATFORM|VIDEO_IMAGE_DB|RTSP_STREAM"
        },
        "latitude": {
          "type": "string",
          "description": "视频源的地理位置信息,纬度,-90.00000~90.00000",
          "pattern": "^$|^[+-]?(([0-8]?\\d(\\.\\d{1,5})?)|(90(\\.0{1,5})?))$"
        },
        "longitude": {
          "type": "string",
          "description": "视频源的地理位置信息,经度,-180.00000~180.00000",
          "pattern": "^$|^-?((([0-9]\\d?|1[0-7]\\d)(\\.\\d{1,5})?)|180(\\.0{1,5})?)$"
        },
        "video_group_ids": {
          "type": "array",
          "description": "系统中所有的视频源分组,只能由小写英文字母(a~z)、数字(0~9)、中划线(-)、下划线(_)组成, 长度范围为[4, 36]",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-_]{4,36}$"
          }
        },
        "type_config": {
          "type": "string",
          "description": "视频源配置信息xml\nurl形式:\n\\<type>URL\\</type>\n\\<config>\n<URL_ADDRESS>\\</URL_ADDRESS>\n\\</config>\nvcn形式:\n\\<type>VCN\\</type>\n\\<config>\n<DATA_SOURCE_ID>\\</DATA_SOURCE_ID>\n<STREAM_TYPE>\\</STREAM_TYPE>\n\\<IP>\\</IP>\n\\<PORT>\\</PORT>\n<USER_NAME>\\</USER_NAME>\n\\<PASSWORD>\\</PASSWORD>\n\\</config>\nrestful形式:\n\\<type>RESTFUL\\</type>\n\\<config>\n\\<HTTP_CHECK>\\</HTTP_CHECK>\n\\<URL>\\</URL>\n<RTSP_URL>\\</RTSP_URL>\n\\</config>\ncamera形式:\n\\<type>CAMERA\\</type>\n\\<config>\n<EDGE_CAMERA_ID>\\</EDGE_CAMERA_ID>\n\\</config>",
          "maxLength": 1024
        },
        "tag": {
          "type": "array",
          "description": "视频源标签,标签最多选择4个,标签内容只能由中文, 英文字母(a~z, A~Z)、数字(0~9)、中划线(-)、下划线(_)组成, \n最小长度:1\n最大长度:10",
          "items": {
            "type": "string",
            "pattern": "^[\\一-\\龥a-zA-Z0-9,_-]{1,10}$"
          },
          "maxItems": 4
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "vias.cn-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "post",
  "uri": null
}