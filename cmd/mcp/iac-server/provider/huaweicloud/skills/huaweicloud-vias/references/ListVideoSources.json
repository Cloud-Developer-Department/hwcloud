{
  "name": "ListVideoSources",
  "summary": "获取视频源列表",
  "tags": "视频中心",
  "productshort": "VIAS",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/{project_id}/source/sources": {
      "get": {
        "tags": [
          "IVideoSourceController"
        ],
        "summary": "获取视频源列表",
        "description": "获取视频源列表",
        "operationId": "ListVideoSources",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "scope",
            "in": "query",
            "description": "模糊查找参数,可选,根据名称查找",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "scope_name",
            "in": "query",
            "description": "模糊查找参数字段名,可选,名称(取值source_name)或分组名称(取值group_name)",
            "required": false,
            "type": "string",
            "default": "source_name",
            "maxLength": 11,
            "pattern": "^$|source_name|group_name"
          },
          {
            "name": "status",
            "in": "query",
            "description": "视频源状态,可选,取值为1 2 9,分别代表在线、离线、异常",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "1|2|9"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "类型:obs、vcn、url、restful、camera、ivm",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "obs|vcn|url|restful|camera|VIDEO_PLATFORM|VIDEO_IMAGE_DB|RTSP_STREAM"
            }
          },
          {
            "name": "video_group_id",
            "in": "query",
            "description": "视频源分组,可选。若传入则需要符合正则表达式^[0-9a-zA-Z-_]{1,36}$",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-zA-Z-_]{1,36}$"
            }
          },
          {
            "name": "sort_name",
            "in": "query",
            "description": "排序项。可选,值范围(create_at,num_task,num_template)",
            "required": false,
            "type": "string",
            "default": "create_at",
            "pattern": "create_at|num_task|num_template"
          },
          {
            "name": "order_by",
            "in": "query",
            "description": "排序顺序,可选,默认倒序",
            "required": false,
            "type": "string",
            "default": "desc",
            "pattern": "desc|asc"
          },
          {
            "name": "is_paged",
            "in": "query",
            "description": "是否分页",
            "required": false,
            "type": "boolean",
            "default": false
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "分页每页显示的条目",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 200,
            "minimum": 5,
            "format": "int32"
          },
          {
            "name": "page_num",
            "in": "query",
            "description": "第几页",
            "required": false,
            "type": "integer",
            "default": 1,
            "maximum": 100000,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "access_type",
            "in": "query",
            "description": "接入方式",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^$|cloud|edge"
            }
          },
          {
            "name": "platform_name",
            "in": "query",
            "description": "平台名称",
            "required": false,
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          {
            "name": "tag",
            "in": "query",
            "description": "标签",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          }
        ],
        "responses": {
          "200": {
            "description": "视频源列表响应体",
            "examples": {
              "application/json": {
                "video_source_number": 230,
                "total_number": 230,
                "quota_number": 5000,
                "video_source_list": [
                  {
                    "video_source_id": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx",
                    "video_source_name": "url_test",
                    "status": {
                      "status": "Online",
                      "name": "在线",
                      "level": "1"
                    },
                    "access_type": "cloud",
                    "type": "url",
                    "latitude": "",
                    "longitude": "",
                    "create_at": 1680772763191,
                    "video_packages": [],
                    "num_tasks": 0,
                    "num_service_config_templates": 0,
                    "type_config": "<type_config>        <url_address>rtsp://12.12.12.12:333</url_address>      </type_config>",
                    "tag": [],
                    "stream_path": "rtsp://12.12.12.12:333",
                    "device_id": "1680772763191",
                    "scene_recommend": [],
                    "video_source_quality": []
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListVideoSourceResponse"
            }
          },
          "400": {
            "description": "参数错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-north-bound": true,
        "x-request-examples-url-1": "v2/{project_id}/source/sources",
        "x-request-examples-text-1": "https://{endpoint}/v2/{project_id}/source/sources?is_paged=true&page_size=10&page_num=1&scope_name=source_name",
        "x-request-examples-1": "https://{endpoint}/v2/{project_id}/source/sources?is_paged=true&page_size=10&page_num=1&scope_name=source_name",
        "x-request-examples-description-1": "获取视频源列表,展示出账户下的所有视频源信息",
        "x-order": 4
      }
    }
  },
  "definitions": {
    "ListVideoSourceResponse": {
      "type": "object",
      "properties": {
        "video_source_number": {
          "type": "integer",
          "format": "int32",
          "description": "视频源数量"
        },
        "total_number": {
          "type": "integer",
          "format": "int32",
          "description": "视频源总数"
        },
        "quota_number": {
          "type": "integer",
          "format": "int32",
          "description": "视频源限额"
        },
        "video_source_list": {
          "type": "array",
          "description": "视频源列表数据",
          "items": {
            "$ref": "#/definitions/ListVideoSourceInfoDto"
          }
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "advice",
        "detail",
        "error_code",
        "error_msg",
        "params",
        "reason"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "example": "VIAS.00010001",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "Invalid parameter: user_id.",
          "description": "错误信息描述"
        },
        "detail": {
          "type": "string",
          "description": "错误详情"
        },
        "params": {
          "type": "array",
          "description": "错误参数列举",
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 0
        },
        "reason": {
          "type": "string",
          "example": "Invalid parameter.",
          "description": "错误原因"
        },
        "advice": {
          "type": "string",
          "example": "Ensure that the entered parameter is valid.",
          "description": "建议"
        }
      },
      "description": "400,401,500等错误码响应"
    },
    "VideoGroupInfoDto": {
      "type": "object",
      "properties": {
        "video_group_id": {
          "type": "string",
          "description": "视频源所在分组id"
        },
        "video_group_name": {
          "type": "string",
          "description": "视频源所在分组名称"
        },
        "description": {
          "type": "string",
          "description": "视频源所在分组描述"
        },
        "access_type": {
          "type": "string",
          "description": "接入方式(cloud、edge)"
        },
        "create_at": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间"
        },
        "modify_at": {
          "type": "integer",
          "format": "int64",
          "description": "修改时间"
        },
        "num_video_source": {
          "type": "integer",
          "format": "int32",
          "description": "视频源数量"
        },
        "group_status": {
          "description": "视频源状态",
          "$ref": "#/definitions/GroupStatusDto"
        },
        "num_batch_task": {
          "type": "integer",
          "format": "int32",
          "description": "已配置批量作业数量"
        }
      }
    },
    "VideoSourceStatusInfoDto": {
      "type": "object",
      "required": [
        "level",
        "name",
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "description": "视频源状态"
        },
        "name": {
          "type": "string",
          "description": "状态中文名"
        },
        "level": {
          "type": "string",
          "description": "状态等级(用于前端图片颜色匹配)"
        }
      },
      "description": "视频源状态"
    },
    "ListVideoSourceInfoDto": {
      "type": "object",
      "required": [
        "access_type",
        "create_at",
        "status",
        "type",
        "video_source_id",
        "video_source_name"
      ],
      "properties": {
        "video_source_id": {
          "type": "string",
          "description": "已创建成功的视频源id"
        },
        "video_source_name": {
          "type": "string",
          "description": "视频源名称,只支持中文、英文字母(a-z,A-Z)、数字、特殊字符(空格.-_() ()),不能以空格开头和结尾\n最小长度:1\n最大长度:100"
        },
        "status": {
          "description": "视频源状态",
          "$ref": "#/definitions/VideoSourceStatusInfoDto"
        },
        "access_type": {
          "type": "string",
          "description": "接入类型(cloud、edge)"
        },
        "type": {
          "type": "string",
          "description": "类型:obs、vcn、url、restful、camera"
        },
        "latitude": {
          "type": "string",
          "description": "视频源的地理位置信息,纬度,-90.00000~90.00000"
        },
        "longitude": {
          "type": "string",
          "description": "视频源的地理位置信息,经度,-180.00000~180.00000"
        },
        "create_at": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间"
        },
        "video_packages": {
          "type": "array",
          "description": "视频源所在分组",
          "items": {
            "$ref": "#/definitions/VideoGroupInfoDto"
          }
        },
        "num_tasks": {
          "type": "integer",
          "format": "int32",
          "description": "视频源已运行算法作业数量"
        },
        "num_service_config_templates": {
          "type": "integer",
          "format": "int32",
          "description": "视频源算法服务配置模板数量"
        },
        "type_config": {
          "type": "string",
          "description": "视频源配置信息xml\n\nurl形式:\n<type>URL</type>\n\n<config>\n<URL_ADDRESS></URL_ADDRESS>\n</config>\nvcn形式:\n<type>VCN</type>\n<config>\n\n<DATA_SOURCE_ID></DATA_SOURCE_ID>\n<STREAM_TYPE></STREAM_TYPE>\n<IP></IP>\n\n<PORT></PORT>\n<USER_NAME></USER_NAME>\n<PASSWORD></PASSWORD>\n</config>\nrestful形式:\n<type>RESTFUL</type>\n<config>\n<HTTP_CHECK></HTTP_CHECK>\n<URL></URL>\n<RTSP_URL></RTSP_URL>\n</config>\ncamera形式:\n<type>CAMERA</type>\n<config>\n\n\n\n<EDGE_CAMERA_ID></EDGE_CAMERA_ID>\n</config>"
        },
        "tag": {
          "type": "array",
          "description": "视频源标签,标签最多选择4个,标签内容只能由中文, 英文字母(a~z, A~Z)、数字(0~9)、中划线(-)、下划线(_)组成,\n最小长度:1\n最大长度:10",
          "items": {
            "type": "string"
          }
        },
        "stream_path": {
          "type": "string",
          "description": "流地址"
        },
        "scene_recommend": {
          "type": "array",
          "description": "智能算法推荐的标签",
          "items": {
            "type": "string"
          }
        },
        "video_source_quality": {
          "type": "array",
          "description": "视频源的视频流质量:\nBlurry:画面模糊;\nColorDistortion:画面颜色失真;\nAbnormalLight:画面光线异常;\nScreenSplash:画面花屏异常;\nScreenJitter:画面抖动;\nScreenMovement:画面移动;\nSceneUpheaval:画面剧变;\nScreenFreeze:画面冻结;\nBlackScreen:黑屏;\nSnowNoise:雪花噪声;\nOcclude:遮挡;\nGrayScreen:灰屏;ScreenSmudge:画面污迹",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "GroupStatusDto": {
      "type": "object",
      "properties": {
        "num_online": {
          "type": "integer",
          "format": "int32",
          "description": "在线视频源数量"
        },
        "num_exception": {
          "type": "integer",
          "format": "int32",
          "description": "异常视频源数量"
        },
        "num_offline": {
          "type": "integer",
          "format": "int32",
          "description": "离线视频源数量"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "vias.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}