{
  "name": "DeployAlgorithm",
  "summary": "部署算法",
  "tags": "算法中心",
  "productshort": "VIAS",
  "region_id": "ap-southeast-4",
  "paths": {
    "/v2/{project_id}/algorithm/{alg_id}/deploy": {
      "post": {
        "tags": [
          "IAlgorithmController"
        ],
        "summary": "部署算法",
        "description": "部署算法",
        "operationId": "DeployAlgorithm",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "pattern": "^[a-z0-9]{32}$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "alg_id",
            "in": "path",
            "description": "算法ID",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[4][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          {
            "in": "body",
            "name": "DeployServiceReq",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DeployServiceReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "部署算法响应体",
            "examples": {
              "application/json": {
                "alg_name": "入侵检测"
              }
            },
            "schema": {
              "$ref": "#/definitions/DeployServiceResp"
            }
          },
          "400": {
            "description": "请求错误"
          },
          "500": {
            "description": "内部错误"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-north-bound": true,
        "x-request-examples-url-1": "GET https://{endpoint}/v2/{project_id}/algorithm/068ed4d8-077e-4ec9-aa19-bc******e925/deploy",
        "x-request-examples-description-1": "部署算法,配置资源池ID、可承载的最大路数和服务启动参数",
        "x-request-examples-1": {
          "pool_id": "ed9f128bf7d04f5683f0ef******a255",
          "stream_count": 1,
          "deploy_config": {
            "sub_scene": "common"
          }
        },
        "x-request-examples-text-1": {
          "pool_id": "ed9f128bf7d04f5683f0ef******a255",
          "stream_count": 1,
          "deploy_config": {
            "sub_scene": "common"
          }
        },
        "x-order": 0
      }
    }
  },
  "definitions": {
    "DeployServiceResp": {
      "type": "object",
      "properties": {
        "alg_name": {
          "type": "string",
          "description": "算法名称"
        }
      }
    },
    "DeployServiceReq": {
      "type": "object",
      "required": [
        "stream_count"
      ],
      "properties": {
        "pool_id": {
          "type": "string",
          "description": "资源池ID,服务状态为未部署时必填",
          "pattern": "^[A-Za-z-_0-9]{1,64}$"
        },
        "stream_count": {
          "type": "integer",
          "format": "int32",
          "description": "视频流路数",
          "minimum": 1,
          "maximum": 10000
        },
        "deploy_config": {
          "type": "object",
          "description": "服务启动参数,须按照模型的部署约束填写。类型为“Map<String, Object>”,可选填,默认为空。为确保您的数据安全,在环境变量中,请勿输入敏感信息,如明文密码",
          "properties": {}
        },
        "envs": {
          "type": "object",
          "description": "运行服务需要的环境变量键值对。类型为“Map<String, String>”,可选填,默认为空。为确保您的数据安全,在环境变量中,请勿输入敏感信息,如明文密码",
          "properties": {}
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "vias.ap-southeast-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "post",
  "uri": null
}