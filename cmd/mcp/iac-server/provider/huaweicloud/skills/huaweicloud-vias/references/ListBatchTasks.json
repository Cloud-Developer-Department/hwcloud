{
  "name": "ListBatchTasks",
  "summary": "获取批量配置任务列表",
  "tags": "任务中心",
  "productshort": "VIAS",
  "region_id": "ap-southeast-4",
  "paths": {
    "/v2/{project_id}/batch-tasks": {
      "get": {
        "tags": [
          "IBatchTaskController"
        ],
        "summary": "获取批量配置任务列表",
        "description": "获取批量配置任务列表",
        "operationId": "ListBatchTasks",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "is_paged",
            "in": "query",
            "description": "是否分页",
            "required": false,
            "type": "boolean",
            "default": true
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "每页显示的条目数量",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 200,
            "minimum": 5,
            "format": "int32"
          },
          {
            "name": "page_num",
            "in": "query",
            "description": "页号",
            "required": false,
            "type": "integer",
            "default": 1,
            "maximum": 10000,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "order_by",
            "in": "query",
            "description": "升序或降序,枚举值:asc|desc。",
            "required": false,
            "type": "string",
            "default": "desc",
            "pattern": "asc|desc"
          },
          {
            "name": "sort_name",
            "in": "query",
            "description": "排序字段,枚举值:task_count|created_at。",
            "required": false,
            "type": "string",
            "default": "created_at",
            "pattern": "task_count|created_at"
          },
          {
            "name": "video_group",
            "in": "query",
            "description": "视频源分组列表,多个以逗号分隔,需要满足正则:^[a-zA-Z0-9\\一-\\龥\\,-_]{1,1000}$",
            "required": false,
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9\\一-\\龥\\,-_]{1,1000}$"
          },
          {
            "name": "task_state",
            "in": "query",
            "description": "任务状态,需要枚举值:pending|recovering|starting|upgrading|create_failed|start_failed|running|stopping|stopped|abnormal|succeeded|failed|deleting|freezing|frozen|stopped_no_service|scheduling|lack_of_resources",
            "required": false,
            "type": "string",
            "pattern": "pending|recovering|starting|upgrading|create_failed|start_failed|running|stopping|stopped|abnormal|succeeded|failed|deleting|freezing|frozen|stopped_no_service|scheduling|lack_of_resources"
          },
          {
            "name": "type_like",
            "in": "query",
            "description": "模糊查询字段,枚举值: batch_task_name|publish_service_name",
            "required": false,
            "type": "string",
            "pattern": "^(batch_task_name|publish_service_name)$"
          },
          {
            "name": "name_like",
            "in": "query",
            "description": "模糊查询名称,需要与type_like搭配使用来实现是通过batch_task_name还是publish_service_name进行模糊查询",
            "required": false,
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          {
            "name": "manufacturer",
            "in": "query",
            "description": "根据厂商字段筛选,需要满足正则表达式 ^[a-zA-Z0-9\\一-\\龥\\,-_]{2,64}$",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 2,
            "pattern": "^[a-zA-Z0-9\\一-\\龥\\,-_]{2,64}$"
          },
          {
            "name": "title",
            "in": "query",
            "description": "算法中文名,需要满足正则表达式 ^[a-zA-Z0-9\\一-\\龥\\,-_]{2,64}$",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 2,
            "pattern": "^[a-zA-Z0-9\\一-\\龥\\,-_]{2,64}$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "批量操作响应体",
            "examples": {
              "application/json": {
                "count": 2,
                "batch_task_list": [
                  {
                    "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                    "batch_task_name": "qqqq",
                    "video_group_name": "2312,1889,927,914",
                    "alg_name": "testwjh",
                    "type": "0",
                    "priority": "low",
                    "num_task": 3,
                    "created_at": 1685667905165,
                    "batch_task_status_info": {
                      "stopped": 3
                    }
                  },
                  {
                    "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                    "batch_task_name": "qqq",
                    "video_group_name": "2312",
                    "alg_name": "testwjh",
                    "type": "0",
                    "priority": "low",
                    "num_task": 1,
                    "created_at": 1685667856283,
                    "batch_task_status_info": {
                      "running": 1
                    }
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/BatchTaskListResp"
            }
          },
          "400": {
            "description": "请求错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-north-bound": true,
        "x-request-examples-url-1": " https://xxx/v2/xxx/batch-tasks?page_num=1&page_size=10",
        "x-request-examples-description-1": "获取批量配置任务列表,展示批量配置名称,视频源分组,算法服务名称,配置类型,配置任务数量,创建时间,配置下任务状态。",
        "x-is-registered": "Y",
        "x-order": 4
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "advice",
        "detail",
        "error_code",
        "error_msg",
        "params",
        "reason"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "example": "VIAS.00010001",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "Invalid parameter: user_id.",
          "description": "错误信息描述"
        },
        "detail": {
          "type": "string",
          "description": "错误详情"
        },
        "params": {
          "type": "array",
          "description": "错误参数列举",
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 0
        },
        "reason": {
          "type": "string",
          "example": "Invalid parameter.",
          "description": "错误原因"
        },
        "advice": {
          "type": "string",
          "example": "Ensure that the entered parameter is valid.",
          "description": "建议"
        }
      },
      "description": "400,401,500等错误码响应"
    },
    "BatchTaskStatusInfoDto": {
      "type": "object",
      "properties": {
        "pending": {
          "type": "integer",
          "format": "int32",
          "description": "等待中作业数量"
        },
        "recovering": {
          "type": "integer",
          "format": "int32",
          "description": "恢复中作业数量"
        },
        "starting": {
          "type": "integer",
          "format": "int32",
          "description": "启动中作业数量"
        },
        "upgrading": {
          "type": "integer",
          "format": "int32",
          "description": "升级中作业数量"
        },
        "create_failed": {
          "type": "integer",
          "format": "int32",
          "description": "创建失败作业数量"
        },
        "start_failed": {
          "type": "integer",
          "format": "int32",
          "description": "启动失败作业数量"
        },
        "running": {
          "type": "integer",
          "format": "int32",
          "description": "运行中作业数量"
        },
        "stopping": {
          "type": "integer",
          "format": "int32",
          "description": "停止中作业数量"
        },
        "stopped": {
          "type": "integer",
          "format": "int32",
          "description": "已停止作业数量"
        },
        "abnormal": {
          "type": "integer",
          "format": "int32",
          "description": "异常作业数量"
        },
        "succeeded": {
          "type": "integer",
          "format": "int32",
          "description": "运行成功作业数量"
        },
        "failed": {
          "type": "integer",
          "format": "int32",
          "description": "运行失败作业数量"
        },
        "deleting": {
          "type": "integer",
          "format": "int32",
          "description": "删除中作业数量"
        },
        "freezing": {
          "type": "integer",
          "format": "int32",
          "description": "冻结中作业数量"
        },
        "frozen": {
          "type": "integer",
          "format": "int32",
          "description": "已冻结作业数量"
        },
        "stopped_no_service": {
          "type": "integer",
          "format": "int32",
          "description": "无服务的任务数量"
        },
        "scheduling": {
          "type": "integer",
          "format": "int32",
          "description": "调度中"
        },
        "lack_of_resources": {
          "type": "integer",
          "format": "int32",
          "description": "资源不足,创建失败"
        }
      }
    },
    "BatchTaskListResp": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "条目总数"
        },
        "batch_task_list": {
          "type": "array",
          "description": "批量作业列表",
          "items": {
            "$ref": "#/definitions/BatchTaskDto"
          }
        }
      }
    },
    "BatchTaskDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "批量作业ID"
        },
        "batch_task_name": {
          "type": "string",
          "description": "批量作业名称"
        },
        "video_source_name": {
          "type": "string",
          "description": "视频源名称"
        },
        "video_group_name": {
          "type": "string",
          "description": "分组名称"
        },
        "alg_name": {
          "type": "string",
          "description": "算法名称"
        },
        "company": {
          "type": "string",
          "description": "厂商名"
        },
        "type": {
          "type": "string",
          "description": "作业类型"
        },
        "num_task": {
          "type": "integer",
          "format": "int32",
          "description": "批量作业总数"
        },
        "created_at": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间"
        },
        "batch_task_status_info": {
          "description": "批量作业状态基本信息",
          "$ref": "#/definitions/BatchTaskStatusInfoDto"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "vias.ap-southeast-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}