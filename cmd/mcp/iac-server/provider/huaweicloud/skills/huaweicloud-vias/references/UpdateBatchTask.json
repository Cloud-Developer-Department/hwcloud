              "render_result_sw": 1,
              "fire_detection_sw": 1,
              "smoke_detection_sw": 1
            }
          }
        },
        "x-request-examples-1": {
          "name": "wdwdxx",
          "service_name": "烟火演示算法",
          "service_version": "1.0",
          "manufacturer": "VIAS",
          "priority": "low",
          "is_saved_as_template": false,
          "description": "",
          "batch_input": {
            "video_source_group": [
              {
                "video_source_group_id": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx",
                "video_source_list": [
                  {
                    "video_source_id": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx"
                  }
                ]
              }
            ]
          },
          "output": {
            "webhook": {
              "url": "http://test",
              "headers": {
                "a": "a"
              }
            }
          },
          "config": {
            "common": {
              "render_result_sw": 1,
              "fire_detection_sw": 1,
              "smoke_detection_sw": 1
            }
          }
        },
        "x-is-registered": "Y",
        "x-order": 2
      }
    }
  },
  "definitions": {
    "BatchTaskInputDto": {
      "type": "object",
      "properties": {
        "video_source_group": {
          "type": "array",
          "description": "视频源分组信息",
          "items": {
            "$ref": "#/definitions/BatchTaskVideoSourceGroupDto"
          },
          "maxItems": 100,
          "minItems": 1
        }
      }
    },
    "UpdateBatchTaskRequestBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "task-test",
          "description": "任务的名称,必填。仅能包含汉字、字母、数字、中划线和下划线,长度介于1~100之间",
          "pattern": "^[\\一-\\龥a-zA-Z0-9_-]{1,100}$"
        },
        "description": {
          "type": "string",
          "example": "hello world!",
          "description": "任务的描述,选填。长度不超过500",
          "minLength": 0,
          "maxLength": 500
        },
        "schedule": {
          "description": "定时任务参数",
          "$ref": "#/definitions/TaskSchedule"
        },
        "batch_input": {
          "description": "任务的输入配置",
          "$ref": "#/definitions/BatchTaskInputDto"
        },
        "output": {
          "description": "任务的输出配置",
          "$ref": "#/definitions/TaskOutput"
        },
        "config": {
          "description": "任务配置参数",
          "$ref": "#/definitions/TaskServiceConfig"
        },
        "is_saved_as_template": {
          "type": "boolean",
          "description": "是否保存为模板",
          "default": false
        },
        "resource_order_id": {
          "type": "string",
          "description": "资源订单id,与关联算法挂钩。非商用白名单的算法 就不用填,商用算法就为必填项,需要满足正则表达式^[a-z0-9-_]{4,36}$。",
          "pattern": "^[a-z0-9-_]{4,36}$"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "advice",
        "detail",
        "error_code",
        "error_msg",
        "params",
        "reason"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "example": "VIAS.00010001",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "Invalid parameter: user_id.",
          "description": "错误信息描述"
        },
        "detail": {
          "type": "string",
          "description": "错误详情"
        },
        "params": {
          "type": "array",
          "description": "错误参数列举",
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 0
        },
        "reason": {
          "type": "string",
          "example": "Invalid parameter.",
          "description": "错误原因"
        },
        "advice": {
          "type": "string",
          "example": "Ensure that the entered parameter is valid.",
          "description": "建议"
        }
      },
      "description": "400,401,500等错误码响应"
    },
    "BatchTaskInputVideoSourceDto": {
      "type": "object",
      "required": [
        "video_source_id"
      ],
      "properties": {
        "video_source_id": {
          "type": "string",
          "description": "视频源id",
          "pattern": "^[a-z0-9-_]{4,36}$"
        },
        "target_roi": {
          "type": "string",
          "description": "roi区域",
          "minLength": 0,
          "maxLength": 2048
        }
      }
    },
    "BatchTaskResDto": {
      "type": "object",
      "properties": {
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "作业总数"
        },
        "failed_count": {
          "type": "integer",
          "format": "int32",
          "description": "失败作业数量"
        },
        "succeed_count": {
          "type": "integer",
          "format": "int32",
          "description": "成功作业数量"
        },
        "id": {
          "type": "string",
          "description": "批量作业id"
        },
        "error_list": {
          "type": "array",
          "description": "错误信息列表",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TaskServiceConfig": {
      "type": "object",
      "properties": {
        "common": {
          "type": "object",
          "example": {
            "stream_direct": "reverse"
          },
          "description": "任务运行时指定的具体的自定义配置项,由服务发布者定义。整体呈json格式,具体配置项参见相应算法服务的说明",
          "properties": {}
        }
      },
      "description": "任务运行时指定的自定义参数,由服务发布者定义"
    },
    "TaskOutput": {
      "type": "object",
      "properties": {
        "obs": {
          "$ref": "#/definitions/TaskOutputObs"
        },
        "dis": {
          "$ref": "#/definitions/TaskOutputDis"
        },
        "webhook": {
          "$ref": "#/definitions/TaskOutputWebhook"
        },
        "event_center": {
          "type": "boolean",
          "description": "输出方式是否选择为事件中心,选择 true或者1表示是,默认为false",
          "default": false
        }
      },
      "description": "作业的输出配置,至少需要配置一项输出方式"
    },
    "TaskOutputWebhook": {
      "type": "object",
      "required": [
        "headers",
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "example": "https://api.huawei.com/v1/tasks",
          "description": "结果回调地址,选用webhook类型输出时必填",
          "maxLength": 1000,
          "pattern": "^(https?|rtsp|rtmp|ftp|file):\\/\\/[-A-Za-z0-9+&@*#/%?=~_|!:,.;]+[-A-Za-z0-9+&@*#/%=~_|]$"
        },
        "headers": {
          "type": "object",
          "example": {
            "appKey": "24bnaxxxxxxxxxxxxxxxj9sdf",
            "appId": "10000000"
          },
          "description": "结果回调时需要携带的请求头,选用webhook类型输出时必填。整体呈json格式,以键值对的形式表示请求头和取值,至少1组,至多10组",
          "properties": {}
        },
        "data_category": {
          "type": "array",
          "example": [
            "FaceImage"
          ],
          "description": "任务输出数据类别的列表,选填,仅部分服务需要。当输出类型下有这个列表时,表示希望这个输出类型下存放dataCategory列表内的数据",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 0
        }
      },
      "description": "输出为webhook类型时的配置信息"
    },
    "TaskSchedule": {
      "type": "object",
      "required": [
        "timezone",
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "example": "weekly",
          "description": "计划任务的类型,使用计划任务时必填。可选类型weekly(每周执行)。",
          "pattern": "^(weekly|monthly)$"
        },
        "timezone": {
          "type": "string",
          "example": "+08:00",
          "description": "用户所处的时区,使用计划任务时必填。精确到分钟",
          "pattern": "^[+-][0-9]{2}:[0-9]{2}$"
        },
        "days_of_week": {
          "type": "array",
          "example": [
            1,
            2,
            3,
            4,
            5
          ],
          "description": "任务会在一周的哪几天执行,当且仅当计划任务类型为weekly时,该字段需填且必填。1~7分别指代星期一至星期日",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "format": "int32",
            "example": 1,
            "minimum": 1,
            "maximum": 7
          },
          "maxItems": 7,
          "minItems": 1
        },
        "days_of_month": {
          "type": "array",
          "example": 1,
          "description": "任务会在一个月的哪几天执行,当且仅当计划任务类型为monthly时,该字段需填且必填。1~31分别指代一个月中的1日至31日,当前系统不支持该参数。",
          "items": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 31
          }
        },
        "periods": {
          "type": "array",
          "description": "时间段模式配置,指定周计划或者月计划中具体每天任务的执行时间段,至少需指定一个时间段",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "begin_at": {
                  "type": "string",
                  "example": "08:00:00",
                  "description": "单个时间段执行的起始时间,必填。其余计划任务类型时,格式为hh:mm:ss",
                  "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T)?[0-9]{2}:[0-9]{2}:[0-9]{2}$"
                },
                "end_at": {
                  "type": "string",
                  "example": "12:00:00",
                  "description": "单个时间段执行的结束时间,必填,其余计划任务类型时,格式为hh:mm:ss",
                  "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T)?[0-9]{2}:[0-9]{2}:[0-9]{2}$"
                }
              },
              "required": [
                "begin_at",
                "end_at"
              ]
            },
            "maxItems": 10,
            "minItems": 1
          }
        }
      },
      "description": "定时任务参数,定时周期 仅支持周模式"
    },
    "TaskOutputDis": {
      "type": "object",
      "required": [
        "stream_name"
      ],
      "properties": {
        "stream_name": {
          "type": "string",
          "example": "dis-test",
          "description": "DIS流名称,选用dis类型输出时必填,校验规则:^[-A-Za-z0-9_]{1,64}$。",
          "maxLength": 64,
          "pattern": "^[-A-Za-z0-9_]{1,64}$"
        },
        "data_category": {
          "type": "array",
          "example": [
            "FaceImage"
          ],
          "description": "任务输出数据类别的列表,选填,仅部分服务需要。当输出类型下有这个列表时,表示希望这个输出类型下存放dataCategory列表内的数据。\n【例如创建边缘人脸任务API中,输出结果支持data_category参数,取值范围为[FacaImage,OriginImage],分别表示是否发送人脸图和原始图】",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 0
        }
      },
      "description": "输出为dis类型时的配置信息"
    },
    "BatchTaskVideoSourceGroupDto": {
      "type": "object",
      "required": [
        "video_source_group_id",
        "video_source_list"
      ],
      "properties": {
        "video_source_group_id": {
          "type": "string",
          "description": "视频源分组id",
          "pattern": "^[a-z0-9-_]{4,36}$"
        },
        "video_source_list": {
          "type": "array",
          "description": "视频源列表",
          "items": {
            "$ref": "#/definitions/BatchTaskInputVideoSourceDto"
          },
          "maxItems": 100,
          "minItems": 0
        }
      }
    },
    "TaskOutputObs": {
      "type": "object",
      "required": [
        "bucket",
        "path"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "example": "obs-iva",
          "description": "OBS桶名,选用obs类型输出时必填,校验规则:(pattern:“^\\[a-z0-9](?!.*[-.]\\[-.].*)(\\[a-z0-9-.]{1,61})\\[a-z0-9]$”)",
          "maxLength": 63,
          "pattern": "^[a-z0-9](?!.*[-.][-.].*)([a-z0-9-.]{1,61})[a-z0-9]$"
        },
        "path": {
          "type": "string",
          "example": "output/",
          "description": "OBS的路径,选用obs类型输出时必填,校验规则:^(?![/.\\s])(?!.*//.*)([^:*?\"<>|\\\\]{0,1023})(?<![.\\s])$",
          "maxLength": 1023,
          "pattern": "^(?![/.\\s])(?!.*//.*)([^:*?\"<>|\\\\]{0,1023})(?<![.\\s])$"
        },
        "data_category": {
          "type": "array",
          "example": [
            "FaceImage"
          ],
          "description": "作业输出数据类别的列表,选填,仅部分服务需要。当输出类型下有这个列表时,表示希望这个输出类型下存放dataCategory列表内的数据",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 0
        }
      },
      "description": "输出为obs类型时的配置信息"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "vias.ap-southeast-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "put",
  "uri": null
}