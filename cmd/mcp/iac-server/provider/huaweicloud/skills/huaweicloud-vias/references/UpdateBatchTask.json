{
  "name": "UpdateBatchTask",
  "summary": "修改批量配置任务",
  "tags": "任务中心",
  "productshort": "VIAS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v2/{project_id}/batch-tasks/{id}": {
      "put": {
        "tags": [
          "IBatchTaskController"
        ],
        "summary": "修改批量配置任务",
        "description": "修改批量配置任务",
        "operationId": "UpdateBatchTask",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "id",
            "in": "path",
            "description": "批量配置ID",
            "required": true,
            "type": "string",
            "pattern": "^[a-z0-9-_]{4,36}$"
          },
          {
            "in": "body",
            "name": "requestBody",
            "description": "编辑批量配置请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateBatchTaskRequestBody"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "批量操作响应体",
            "examples": {
              "application/json": {
                "total_count": 1,
                "failed_count": 0,
                "succeed_count": 1,
                "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "error_list": []
              }
            },
            "schema": {
              "$ref": "#/definitions/BatchTaskResDto"
            }
          },
          "400": {
            "description": "请求错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-north-bound": true,
        "x-request-examples-url-1": "/v2/{project_id}/batch-tasks/{id}",
        "x-request-examples-description-1": "修改配置名称为“wdwd”使用算法名为“烟火演示算法”版本为“1.0”厂商为“VIAS”不保存模板输入方式为“video_source”输出方式为“webhook”有相关算法配置的批量配置",
        "x-request-examples-text-1": {
          "name": "wdwdxx",
          "service_name": "烟火演示算法",
          "service_version": "1.0",
          "manufacturer": "VIAS",
