{
  "name": "UpdateTask",
  "summary": "修改任务",
  "tags": "任务中心",
  "productshort": "VIAS",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/{project_id}/tasks/{task_id}": {
      "put": {
        "tags": [
          "ITaskController"
        ],
        "summary": "修改任务",
        "description": "任务修改接口,用于修改任务配置",
        "operationId": "UpdateTask",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方法参见[获取项目ID和名称](vias_03_0283.xml)",
            "required": true,
            "type": "string",
            "pattern": "[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "task_id",
            "in": "path",
            "description": "已创建成功任务的id信息",
            "required": true,
            "type": "string",
            "pattern": "^[a-z0-9-_]{4,36}$"
          },
          {
            "in": "body",
            "name": "reuqestBody",
            "description": "编辑任务请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateTasksRequestBody"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,获取方法参见[认证鉴权](vias_03_0009.xml)",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "任务编辑成功",
            "schema": {
              "type": "object"
            }
          },
          "400": {
            "description": "请求错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-north-bound": true,
        "x-request-examples-url-1": "/v2/{project_id}/tasks/{task_id}",
        "x-request-examples-description-1": "任务修改接口,用于修改任务配置(支持修改任务名称,视频源,调度模式,输出配置)",
        "x-request-examples-text-1": {
          "name": "TestA",
          "input": {
            "type": "video_source",
            "data": [
              {
                "video_source_id": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx"
              }
            ]
          },
          "output": {
            "webhook": {
              "url": "http://test",
              "headers": {
                "a": "a"
              }
            }
          },
          "config": {
            "common": {}
          },
          "priority": "low",
          "service_version": "1.1",
          "manufacturer": "VIAS",
          "is_saved_as_template": false
        },
        "x-request-examples-1": {
          "name": "TestA",
          "input": {
            "type": "video_source",
            "data": [
              {
                "video_source_id": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx"
              }
            ]
          },
          "output": {
            "webhook": {
              "url": "http://test",
              "headers": {
                "a": "a"
              }
            }
          },
          "config": {
            "common": {}
          },
          "priority": "low",
          "service_version": "1.1",
          "manufacturer": "VIAS",
          "is_saved_as_template": false
        },
        "x-order": 2
      }
    }
  },
  "definitions": {
    "TaskInput": {
      "type": "object",
      "required": [
        "data",
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "example": "obs",
          "description": "任务的输入类型,创建时必填,视频源类型为video_source 时 不支持切换为其他的type。创建时可选类型有\nobs(对象存储服务存储的文件  仅云上任务支持,支持输出到webhook),\nurl(指定的文件地址或取流地址  仅云上任务支持,支持输出到webhook),\nedgecamera(绑定在IEF的边缘摄像头  仅边缘任务支持,支持输出到webhook),\nrestful(从自定义的流媒体服务器通过Restful接口获取取流地址  云上和边缘任务均支持,支持输出到webhook),\nvcn(VCN设备  仅边缘任务支持),\nvideo_source(使用VIAS平台视频中心管理的视频源,云上和边缘任务均支持),\n建议使用video_source类型,其他类型为了兼容老业务,后续将废弃。\n 枚举值:\n - video_source\n - obs (不建议使用,后续废弃)\n - url (不建议使用,后续废弃)\n - edgecamera (不建议使用,后续废弃)\n - restful (不建议使用,后续废弃)\n - vcn (不建议使用,后续废弃)",
          "pattern": "^(video_source|obs|url|edgecamera|restful|vcn)$"
        },
        "data": {
          "type": "array",
          "description": "任务的输入详情,必填。针对不同的输入类型有不同的配置。创建时允许填写多路输入,但更新时只允许填写一路输入。\n当输入类型为:obs,需要配置 bucket,path , index 。例如:  \"bucket\": \"aicam\", \"path\": \"3rdpartylicenses.txt\", \"index\": 0 \n当输入类型为:url,需要配置 url, index 。例如: \"url\": \"https://xxx-xxx.com\", \"index\": 0\n当输入类型为:restful,需要配置 certificate_check, rtsp_path_in_response, url, index, headers 。例如:\"certificate_check\": true, \"url\": \"https://hsaij-dasahbi.com\", \"rtsp_path_in_response\": \"data/url\", \"index\": 0, \"headers\": { \"AAA\": \"AAA\" }\n当输入类型为:vcn,需要配置 device_id, stream_type, index。例如:\"device_id\": \"21356478954612546874#gdhjkiushdgdksjhslmhscjsckjhdbnk\", \"stream_type\": 1, \"index\": 0\n当输入类型为:EdgeCamera,需要配置 id, index 例如:\"id\": \"007cdafc-6000-47ce-b0e3-870b4a0db65e\",\"index\": 0",
          "items": {
            "$ref": "#/definitions/TaskInputData"
          },
          "maxItems": 50,
          "minItems": 1
        },
        "vcn": {
          "$ref": "#/definitions/TaskInputVcn"
        }
      },
      "description": "任务的输入配置,必填"
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "advice",
        "detail",
        "error_code",
        "error_msg",
        "params",
        "reason"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "example": "VIAS.00010001",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "Invalid parameter: user_id.",
          "description": "错误信息描述"
        },
        "detail": {
          "type": "string",
          "description": "错误详情"
        },
        "params": {
          "type": "array",
          "description": "错误参数列举",
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 0
        },
        "reason": {
          "type": "string",
          "example": "Invalid parameter.",
          "description": "错误原因"
        },
        "advice": {
          "type": "string",
          "example": "Ensure that the entered parameter is valid.",
          "description": "建议"
        }
      },
      "description": "400,401,500等错误码响应"
    },
    "TaskServiceConfig": {
      "type": "object",
      "properties": {
        "common": {
          "type": "object",
          "example": {
            "stream_direct": "reverse"
          },
          "description": "任务运行时指定的具体的自定义配置项,由服务发布者定义。整体呈json格式,具体配置项参见相应算法服务的说明",
          "properties": {}
        }
      },
      "description": "任务运行时指定的自定义参数,由服务发布者定义"
    },
    "TaskInputVcn": {
      "type": "object",
      "required": [
        "ip",
        "password",
        "port",
        "username"
      ],
      "properties": {
        "ip": {
          "type": "string",
          "format": "ipv4",
          "example": "10.10.10.10",
          "description": "VCN服务器的IP地址,仅输入类型为vcn时需填且必填"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "example": 60,
          "description": "VCN服务器的端口号,仅输入类型为vcn时需填且必填",
          "minimum": 0,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "example": "user_test",
          "description": "VCN服务器的账号名,仅输入类型为vcn时需填且必填,需要满足正则表达式^.{1,100}$。",
          "pattern": "^.{1,100}$"
        },
        "password": {
          "type": "string",
          "example": "xxxxxxxxxx",
          "description": "VCN服务器的与账号对应的密码,仅输入类型为vcn时需填且必填,需要满足正则表达式^.{1,1000}$。",
          "pattern": "^.{1,1000}$"
        }
      },
      "description": "VCN服务器信息,仅输入类型为vcn时需填且必填"
    },
    "TaskOutput": {
      "type": "object",
      "properties": {
        "obs": {
          "$ref": "#/definitions/TaskOutputObs"
        },
        "dis": {
          "$ref": "#/definitions/TaskOutputDis"
        },
        "webhook": {
          "$ref": "#/definitions/TaskOutputWebhook"
        },
        "event_center": {
          "type": "boolean",
          "description": "输出方式是否选择为事件中心,选择 true或者1表示是,默认为false",
          "default": false
        }
      },
      "description": "作业的输出配置,至少需要配置一项输出方式"
    },
    "TaskOutputWebhook": {
      "type": "object",
      "required": [
        "headers",
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "example": "https://api.huawei.com/v1/tasks",
          "description": "结果回调地址,选用webhook类型输出时必填",
          "maxLength": 1000,
          "pattern": "^(https?|rtsp|rtmp|ftp|file):\\/\\/[-A-Za-z0-9+&@*#/%?=~_|!:,.;]+[-A-Za-z0-9+&@*#/%=~_|]$"
        },
        "headers": {
          "type": "object",
          "example": {
            "appKey": "24bnaxxxxxxxxxxxxxxxj9sdf",
            "appId": "10000000"
          },
          "description": "结果回调时需要携带的请求头,选用webhook类型输出时必填。整体呈json格式,以键值对的形式表示请求头和取值,至少1组,至多10组",
          "properties": {}
        },
        "data_category": {
          "type": "array",
          "example": [
            "FaceImage"
          ],
          "description": "任务输出数据类别的列表,选填,仅部分服务需要。当输出类型下有这个列表时,表示希望这个输出类型下存放dataCategory列表内的数据",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 0
        }
      },
      "description": "输出为webhook类型时的配置信息"
    },
    "TaskSchedule": {
      "type": "object",
      "required": [
        "timezone",
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "example": "weekly",
          "description": "计划任务的类型,使用计划任务时必填。可选类型weekly(每周执行)。",
          "pattern": "^(weekly|monthly)$"
        },
        "timezone": {
          "type": "string",
          "example": "+08:00",
          "description": "用户所处的时区,使用计划任务时必填。精确到分钟",
          "pattern": "^[+-][0-9]{2}:[0-9]{2}$"
        },
        "days_of_week": {
          "type": "array",
          "example": [
            1,
            2,
            3,
            4,
            5
          ],
          "description": "任务会在一周的哪几天执行,当且仅当计划任务类型为weekly时,该字段需填且必填。1~7分别指代星期一至星期日",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "format": "int32",
            "example": 1,
            "minimum": 1,
            "maximum": 7
          },
          "maxItems": 7,
          "minItems": 1
        },
        "days_of_month": {
          "type": "array",
          "example": 1,
          "description": "任务会在一个月的哪几天执行,当且仅当计划任务类型为monthly时,该字段需填且必填。1~31分别指代一个月中的1日至31日,当前系统不支持该参数。",
          "items": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 31
          }
        },
        "periods": {
          "type": "array",
          "description": "时间段模式配置,指定周计划或者月计划中具体每天任务的执行时间段,至少需指定一个时间段",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "begin_at": {
                  "type": "string",
                  "example": "08:00:00",
                  "description": "单个时间段执行的起始时间,必填。其余计划任务类型时,格式为hh:mm:ss",
                  "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T)?[0-9]{2}:[0-9]{2}:[0-9]{2}$"
                },
                "end_at": {
                  "type": "string",
                  "example": "12:00:00",
                  "description": "单个时间段执行的结束时间,必填,其余计划任务类型时,格式为hh:mm:ss",
                  "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T)?[0-9]{2}:[0-9]{2}:[0-9]{2}$"
                }
              },
              "required": [
                "begin_at",
                "end_at"
              ]
            },
            "maxItems": 10,
            "minItems": 1
          }
        }
      },
      "description": "定时任务参数,定时周期 仅支持周模式"
    },
    "TaskOutputDis": {
      "type": "object",
      "required": [
        "stream_name"
      ],
      "properties": {
        "stream_name": {
          "type": "string",
          "example": "dis-test",
          "description": "DIS流名称,选用dis类型输出时必填,校验规则:^[-A-Za-z0-9_]{1,64}$。",
          "maxLength": 64,
          "pattern": "^[-A-Za-z0-9_]{1,64}$"
        },
        "data_category": {
          "type": "array",
          "example": [
            "FaceImage"
          ],
          "description": "任务输出数据类别的列表,选填,仅部分服务需要。当输出类型下有这个列表时,表示希望这个输出类型下存放dataCategory列表内的数据。\n【例如创建边缘人脸任务API中,输出结果支持data_category参数,取值范围为[FacaImage,OriginImage],分别表示是否发送人脸图和原始图】",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 0
        }
      },
      "description": "输出为dis类型时的配置信息"
    },
    "UpdateTasksRequestBody": {
      "type": "object",
      "required": [
        "input",
        "name",
        "output"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "task-test",
          "description": "任务名称,只能由中文、字母(a~z A~Z)、数字(0~9)、中划线(-)、下划线(_)组成,长度范围为[1,100]",
          "pattern": "^[\\一-\\龥a-zA-Z0-9_-]{1,100}$"
        },
        "description": {
          "type": "string",
          "example": "hello world!",
          "description": "任务的描述,选填。长度不超过500",
          "minLength": 0,
          "maxLength": 500,
          "pattern": "^[\\一-\\龥a-zA-Z0-9_-]{0,500}$"
        },
        "schedule": {
          "description": "定时任务参数,定时周期 仅支持周模式",
          "$ref": "#/definitions/TaskSchedule"
        },
        "input": {
          "$ref": "#/definitions/TaskInput"
        },
        "output": {
          "$ref": "#/definitions/TaskOutput"
        },
        "config": {
          "description": "任务配置参数",
          "$ref": "#/definitions/TaskServiceConfig"
        },
        "is_saved_as_template": {
          "type": "boolean",
          "description": "是否保存为模板",
          "default": false
        },
        "resource_order_id": {
          "type": "string",
          "description": "资源订单id,与关联算法挂钩。非商用白名单的算法 就不用填,商用算法就为必填项,需要满足正则表达式^[a-z0-9-_]{4,36}$",
          "pattern": "^[a-z0-9-_]{4,36}$"
        }
      }
    },
    "TaskInputData": {
      "type": "object",
      "properties": {
        "video_source_id": {
          "type": "string",
          "description": "视频源id,当输入类型为video_source时必填。",
          "pattern": "^[0-9a-z-_]{4,36}$"
        },
        "stream_name": {
          "type": "string",
          "example": "stream-test",
          "description": "视频流名称",
          "pattern": "^[-A-Za-z0-9_]{1,80}$"
        },
        "bucket": {
          "type": "string",
          "example": "obs-iva",
          "description": "OBS桶名,当输入为obs类型时必填",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?!.*[-.][-.].*)([a-z0-9-.]{1,61})[a-z0-9]$"
        },
        "path": {
          "type": "string",
          "example": "/input/test.mp4",
          "description": "OBS的路径,当输入为obs类型时必填",
          "maxLength": 1023,
          "pattern": "^(?![/.\\s])(?!.*//.*)([^:*?\"<>|\\\\]{0,1023})(?<![.\\s])$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "example": "https://livestream.com/live/stream-test",
          "description": "url输入源的地址或者获取视频流地址的restful请求地址,当输入为url类型或者edgerestful类型时必填。长度不超过1000",
          "maxLength": 1000,
          "pattern": "^(https?|rtsp|rtmp|ftp|file):\\/\\/[-A-Za-z0-9+&@*#/%?=~_|!:,.;]+[-A-Za-z0-9+&@*#/%=~_|]$"
        },
        "headers": {
          "type": "object",
          "example": {
            "Content-Type": "application/json"
          },
          "description": "获取视频流地址的restful请求携带的请求头,当输入为edgerestful类型时可选。整体呈json格式,以键值对的形式表示请求头和取值,最多允许10组。",
          "properties": {}
        },
        "rtsp_path_in_response": {
          "type": "string",
          "example": "data/url",
          "description": "restful请求返回的body中,视频流地址的路径,当输入为edgerestful类型时必填。长度不超过1024",
          "maxLength": 1024,
          "pattern": "^([-A-Za-z0-9+&?=~_][-A-Za-z0-9+&/?=~_]+[-A-Za-z0-9+&/?=~_]|[A-Za-z]+)$"
        },
        "device_id": {
          "type": "string",
          "example": "46459876132169871364#xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
          "description": "VCN设备ID,当输入为vcn类型时必填",
          "pattern": "^([0-9]{20}[#]{1}[a-zA-Z0-9]{32})|([0-9]{20}[#]{1}[0-9]{1,10}[#]{1}[a-zA-Z0-9]{32})$"
        },
        "stream_type": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "准备进行分析的码流,当输入为vcn类型时选填。取值范围为1~3,其中1代表主码流,2代表子码流1,3代表子码流2",
          "minimum": 1,
          "maximum": 3
        },
        "id": {
          "type": "string",
          "example": "xxxxxxx-xxxxxxx-xxxxxxx-xxxxx-xxxxxx",
          "description": "IEF挂载的边缘设备的ID,当输入为edgecamera类型时必填",
          "maxLength": 63,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "certificate_check": {
          "type": "boolean",
          "example": false,
          "description": "是否需要对https请求进行证书校验,当输入为edgerestful类型时必填。取值为true或者false。",
          "default": false
        }
      },
      "description": "输入数据的配置信息"
    },
    "TaskOutputObs": {
      "type": "object",
      "required": [
        "bucket",
        "path"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "example": "obs-iva",
          "description": "OBS桶名,选用obs类型输出时必填,校验规则:(pattern:“^\\[a-z0-9](?!.*[-.]\\[-.].*)(\\[a-z0-9-.]{1,61})\\[a-z0-9]$”)",
          "maxLength": 63,
          "pattern": "^[a-z0-9](?!.*[-.][-.].*)([a-z0-9-.]{1,61})[a-z0-9]$"
        },
        "path": {
          "type": "string",
          "example": "output/",
          "description": "OBS的路径,选用obs类型输出时必填,校验规则:^(?![/.\\s])(?!.*//.*)([^:*?\"<>|\\\\]{0,1023})(?<![.\\s])$",
          "maxLength": 1023,
          "pattern": "^(?![/.\\s])(?!.*//.*)([^:*?\"<>|\\\\]{0,1023})(?<![.\\s])$"
        },
        "data_category": {
          "type": "array",
          "example": [
