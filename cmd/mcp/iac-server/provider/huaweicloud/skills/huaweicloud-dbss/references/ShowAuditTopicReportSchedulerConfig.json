{
  "name": "ShowAuditTopicReportSchedulerConfig",
  "summary": "获取报表的计划任务配置信息(topic方式)",
  "tags": "报表管理",
  "productshort": "DBSS",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/audit/{instance_id}/reports/tasks/{id}": {
      "get": {
        "x-apigateway-request-type": "public",
        "x-apigateway-ratelimit": "YunTanRateLimitDefault",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "default": "xxxxxxxxxxxxxxxx",
            "description": "**参数解释**:\n用户Token。通过调用IAM服务查询用户Token接口获取(响应消息头中X-Subject-Token的值)。\n**约束限制**:\n不涉及\n**取值范围**:\nIAM服务查询用户Token接口为准\n**默认取值**:\n不涉及",
            "in": "header",
            "name": "X-Auth-Token",
            "required": true,
            "type": "string"
          },
          {
            "description": "**参数解释**:\n项目ID。可通过IAM服务[查询指定IAM用户的项目列表]接口获取。\n**约束限制**:\n不涉及\n**取值范围**:\n以IAM服务接口返回值为准,字符长度32-64。\n**默认取值**:\n不涉及",
            "in": "path",
            "name": "project_id",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "type": "string"
          },
          {
            "description": "**参数解释**:\n实例ID。可通过查询实例列表接口ID字段获取\n**约束限制**:\n不涉及\n**取值范围**:\n以查询实例列表接口值为准,字符长度32-64。\n**默认取值**:\n不涉及",
            "in": "path",
            "name": "instance_id",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "type": "string"
          },
          {
            "description": "**参数解释**:\n模板ID。可通过获取报表模板接口ID字段获取。\n**约束限制**:\n不涉及\n**取值范围**:\n以获取报表模板接口值为准,字符长度16-64。\n**默认取值**:\n不涉及",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ReportTopicSchedulerBean"
            },
            "examples": {
              "application/json": {
                "scheduler": null,
                "smn_effective": true
              }
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          },
          "401": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          },
          "403": {
            "description": "未授权",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          },
          "500": {
            "description": "服务端错误",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          }
        },
        "tags": [
          "报表管理"
        ],
        "description": "获取报表的计划任务配置信息(topic方式)",
        "operationId": "ShowAuditTopicReportSchedulerConfig",
        "summary": "获取报表的计划任务配置信息(topic方式)",
        "x-api-type": "open-api",
        "x-apigateway-backend": {
          "httpEndpoints": {
            "method": "GET",
            "path": "/v2/{project_id}/audit/{instance_id}/reports/tasks/{id}"
          }
        },
        "x-is-registered": "Y",
        "x-request-examples-url-1": "/v2/{project_id}/audit/{instance_id}/reports/tasks/{id}",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "ReportTopicSchedulerBean": {
      "properties": {
        "scheduler": {
          "$ref": "#/definitions/SchedulerConfigBase"
        },
        "smn_effective": {
          "description": "是否支持订阅 \n- true:支持 \n- false:不支持",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "SchedulerConfigBase": {
      "description": "调度配置",
      "properties": {
        "db_ids": {
          "description": "数据库ID",
          "type": "string",
          "example": "ytjeZgBBt8O6JSxIFIq"
        },
        "format": {
          "description": "文件类型",
          "enum": [
            "PDF",
            "ZIP"
          ],
          "type": "string",
          "example": "ZIP"
        },
        "frequency": {
          "description": "周期\n- AUDIT_REPORT_DAY:天\n- AUDIT_REPORT_WEEK:周\n- AUDIT_REPORT_MONTH:月\n- AUDIT_REPORT_YEAR:年\n- AUDIT_REPORT_REAL_TIME:实时",
          "enum": [
            "AUDIT_REPORT_DAY",
            "AUDIT_REPORT_WEEK",
            "AUDIT_REPORT_MONTH",
            "AUDIT_REPORT_YEAR",
            "AUDIT_REPORT_REAL_TIME"
          ],
          "type": "string",
          "example": "AUDIT_REPORT_DAY"
        },
        "id": {
          "description": "报表模板ID",
          "type": "string",
          "example": "_ytjeZgBBt8O6JSxIFIq"
        },
        "mode": {
          "description": "调度方式",
          "enum": [
            "ONCE",
            "CYCLE"
          ],
          "type": "string",
          "example": "ONCE"
        },
        "notice": {
          "description": "是否通知 \n- OFF:不通知 \n- ON:通知",
          "enum": [
            "OFF",
            "ON"
          ],
          "type": "string",
          "example": "ON"
        },
        "start_time": {
          "description": "开始时间",
          "type": "string",
          "example": "2025-08-04 16:00:00"
        },
        "status": {
          "description": "模板状态\n- ON:开启\n- OFF:关闭",
          "enum": [
            "OFF",
            "ON"
          ],
          "type": "string",
          "example": "ON"
        },
        "topic_urn": {
          "description": "主题URN",
          "type": "string",
          "example": "urn:smn:cn-north-7:b9351f98c724428794ba7d105fa3558d:SMN-JJH"
        }
      },
      "type": "object"
    },
    "DbssError": {
