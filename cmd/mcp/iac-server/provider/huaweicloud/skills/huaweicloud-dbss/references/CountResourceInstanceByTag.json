  "definitions": {
    "ResourceInstanceResponse": {
      "type": "object",
      "required": [
        "resources",
        "total_count"
      ],
      "properties": {
        "resources": {
          "items": {
            "required": [
              "resource_id",
              "resource_name",
              "resource_detail",
              "tags"
            ],
            "properties": {
              "resource_id": {
                "type": "string",
                "example": "cdfs_cefs_wesas_12_dsad",
                "description": "资源ID"
              },
              "resource_name": {
                "type": "string",
                "example": "resource1",
                "description": "资源名称,资源没有名称时默认为空字符串,eip返回ip地址。"
              },
              "resource_detail": {
                "type": "object",
                "example": null,
                "description": "资源详情。 资源对象,用于扩展,默认为空。"
              },
              "tags": {
                "items": {
                  "properties": {
                    "key": {
                      "type": "string",
                      "example": "key1",
                      "description": "键。最大长度128个字符。"
                    },
                    "value": {
                      "type": "string",
                      "example": "value1",
                      "description": "值"
                    }
                  }
                },
                "description": "标签列表,没有标签默认为空数组",
                "type": "array"
              },
              "sys_tags": {
                "items": {
                  "properties": {
                    "key": {
                      "type": "string",
                      "example": "_sys_enterprise_project_id",
                      "description": "键。最大长度128个字符。"
                    },
                    "value": {
                      "type": "string",
                      "example": "5aa119a8-d25b-45a7-8d1b-88e127885635",
                      "description": "值。每个值最大长度255个字符。"
                    }
                  }
                },
                "description": "仅op_service权限才可以可以获取此字段:\n目前只包含一个resource_tag 结构体\nkey:_sys_enterprise_project_id\nvalue:企业项目id,0表示默认企业项目\n非op_service场景不能返回此字段",
                "type": "array"
              }
            }
          },
          "description": "资源实例列表",
          "type": "array"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "example": 1000,
          "description": "总记录数"
        }
      }
    },
    "ResourceInstanceTagRequest": {
      "type": "object",
      "properties": {
        "matches": {
          "items": {
            "properties": {
              "key": {
                "type": "string",
                "example": "resource_name",
                "description": "键,目前仅支持:resource_name"
              },
              "value": {
                "type": "string",
                "example": "resource1",
                "description": "值,需要匹配的资源名称"
              }
            }
          },
          "description": "搜索字段,key为要匹配的字段,如resource_name等。value为匹配的值。key为固定字典值,不能包含重复的key或不支持的key。 根据key的值确认是否需要模糊匹配,如resource_name默认为模糊搜索(不区分大小写),如果value为空字符串精确匹配(多数服务不存在资源名称为空的情况,因此此类情况返回空列表)。resource_id为精确匹配。第一期只做resource_name,后续再扩展。",
          "type": "array"
        },
        "not_tags": {
          "items": {
            "$ref": "#/definitions/TagKeyValuesBean"
          },
          "description": "不包含标签,最多包含50个key,每个key下面的value最多10个, 每个key对应的value可以为空数组但结构体不能缺失。Key不能重复,同一个key中values不能重复。结果返回不包含标签的资源列表,key之间是与的关系,key-value结构中value是或的关系。无过滤条件时返回全量数据",
          "type": "array"
        },
        "tags": {
          "items": {
            "$ref": "#/definitions/TagKeyValuesBean"
          },
          "description": "包含标签,最多包含50个key,每个key下面的value最多10个,每个key对应的value可以为空数组但结构体不能缺失。Key不能重复,同一个key中values不能重复。结果返回包含所有标签的资源列表,key之间是与的关系,key-value结构中value是或的关系。无tag过滤条件时返回全量数据",
          "type": "array"
        },
        "tags_any": {
          "items": {
            "$ref": "#/definitions/TagKeyValuesBean"
          },
          "description": "包含任意标签,最多包含50个key,每个key下面的value最多10个, 每个key对应的value可以为空数组但结构体不能缺失。Key不能重复,同一个key中values不能重复。结果返回包含标签的资源列表,key之间是或的关系,key-value结构中value是或的关系。无过滤条件时返回全量数据",
          "type": "array"
        },
        "not_tags_any": {
          "items": {
            "$ref": "#/definitions/TagKeyValuesBean"
          },
          "description": "不包含任意标签,最多包含50个key,每个key下面的value最多10个, 每个key对应的value可以为空数组但结构体不能缺失。Key不能重复,同一个key中values不能重复。结果返回不包含标签的资源列表,key之间是或的关系,key-value结构中value是或的关系。无过滤条件时返回全量数据",
          "type": "array"
        },
        "sys_tags": {
          "description": "仅op_service权限可以使用此字段做资源实例过滤条件。\n目前TMS调用时只包含一个tag结构体。\nkey:_sys_enterprise_project_id\nvalue:企业项目id列表\n目前TMS调用时,key下面只包含一个value。0表示默认企业项目\nsys_tags和租户标签过滤条件(without_any_tag 、tags、tags_any、not_tags、not_tags_any)不能同时使用\n无sys_tags时按照tag接口处理,无tag过滤条件时返回全量数据",
          "items": {
            "$ref": "#/definitions/TagKeyValuesBean"
          },
          "type": "array"
        },
        "without_any_tag": {
          "type": "boolean",
          "description": "不包含任意一个标签,该字段为true时查询所有不带标签的资源,此时忽略 “tags”、“tags_any”、“not_tags”、“not_tags_any”字段"
        }
      }
    },
    "DbssError": {
      "description": "异常消息体",
      "properties": {
        "details": {
          "description": "PDP5鉴权异常信息",
          "items": {
            "$ref": "#/definitions/DbssErrorDetail"
          },
          "type": "array",
          "minItems": 0,
          "maxItems": 100
        },
        "encoded_authorization_message": {
          "description": "PDP5鉴权异常信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        },
        "error_code": {
          "description": "错误码",
          "type": "string",
          "example": "DBSS.10020100",
          "minLength": 0,
          "maxLength": 2097152
        },
        "error_msg": {
          "description": "错误信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        }
      },
      "type": "object"
    },
    "DbssErrorDetail": {
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "example": "DBSS.00112233"
        },
        "error_msg": {
          "description": "PDP5错误信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        }
      },
      "type": "object"
    },
    "TagKeyValuesBean": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "example": "key1",
          "description": "键。最大长度128个unicode字符。 key不能为空。(搜索时不对此参数做字符集校验),key不能为空或者空字符串,不能为空格,校验和使用之前先trim 前后半角空格"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "*value1",
            "value2"
          ],
          "description": "值列表。每个值最大长度255个unicode字符,校验和使用之前先trim 前后半角空格。\nvalue可为空数组但不可缺省。\n如果values为空列表,则表示any_value(查询任意value)。value之间为或的关系"
        }
      },
      "required": [
        "key",
        "values"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dbss.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}