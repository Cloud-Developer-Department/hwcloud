{
  "name": "ListAuditDatabases",
  "summary": "查询数据库列表[待下线]",
  "tags": "待下线接口",
  "productshort": "DBSS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/{instance_id}/dbss/audit/databases": {
      "get": {
        "x-apigateway-request-type": "public",
        "x-apigateway-ratelimit": "YunTanRateLimitDefault",
        "deprecated": true,
        "x-request-examples-url-1": "/v1/{project_id}/{instance_id}/dbss/audit/databases",
        "x-api-type": "open-api",
        "tags": [
          "待下线接口"
        ],
        "summary": "查询数据库列表[待下线]",
        "description": "查询数据库列表",
        "operationId": "ListAuditDatabases",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "default": "xxxxxxxxxxxxxxxx",
            "description": "**参数解释**:\n用户Token。通过调用IAM服务查询用户Token接口获取(响应消息头中X-Subject-Token的值)。\n**约束限制**:\n不涉及\n**取值范围**:\nIAM服务查询用户Token接口为准\n**默认取值**:\n不涉及",
            "in": "header",
            "name": "X-Auth-Token",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "minLength": 32,
            "maxLength": 64,
            "in": "path",
            "required": true,
            "type": "string",
            "description": "**参数解释**:\n项目ID。可通过IAM服务[查询指定IAM用户的项目列表]接口获取。\n**约束限制**:\n不涉及\n**取值范围**:\n以IAM服务接口返回值为准,字符长度32-64。\n**默认取值**:\n不涉及"
          },
          {
            "name": "instance_id",
            "minLength": 32,
            "maxLength": 64,
            "in": "path",
            "required": true,
            "type": "string",
            "description": "**参数解释**:\n实例ID。可通过查询实例列表接口ID字段获取\n**约束限制**:\n不涉及\n**取值范围**:\n以查询实例列表接口值为准,字符长度32-64。\n**默认取值**:\n不涉及"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "实例状态\n- ON :开启\n- OFF : 关闭",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "**参数解释**:\n分页偏移量,从第一条数据偏移offset条数据后开始查询\n**约束限制**:\n仅支持大于等于0的整数\n**取值范围**:\n大于等于0\n**默认取值**:\n默认值为0",
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "**参数解释**:\n每页查询记录数。\n**约束限制**:\n仅支持大于0的整数\n**取值范围**:\n大于0小于等于10000\n**默认取值**:\n默认值为100",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "$ref": "#/definitions/DataBaseResponse"
            },
            "examples": {
              "application/json": {
                "databases": [
                  {
                    "database": {
                      "id": "zLKv83gBCwCqSg3BJt0m",
                      "name": "db01",
                      "type": "MYSQL",
                      "version": "5.0",
                      "charset": "UTF8",
                      "ip": "192.168.0.204",
                      "port": "3306",
                      "os": "LINUX64",
                      "status": "OFF",
                      "instance_name": "",
                      "audit_status": null,
                      "agent_url": [
                        "zrKw83gBCwCqSg3Bkt1P"
                      ],
                      "db_classification": "ECS"
                    }
                  }
                ]
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          }
        },
        "x-hc": "Y",
        "x-hcso": "Y",
        "x-hk": "Y",
        "x-sbc": "Y",
        "x-open-region-cloud": "hc,hk,hcso,sbc",
        "x-order": 0
      }
    }
  },
  "definitions": {
    "DataBaseBean": {
      "type": "object",
      "required": [
        "database"
      ],
      "properties": {
        "database": {
          "description": "数据库信息",
          "$ref": "#/definitions/DataBase"
        }
      }
    },
    "DataBase": {
      "type": "object",
      "description": "数据库信息",
      "required": [
        "name",
        "type",
        "version",
        "charset",
        "ip",
        "port",
        "os",
        "status",
        "instance_name",
        "db_classification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "数据库ID"
        },
        "name": {
          "type": "string",
          "description": "数据库名称"
        },
        "type": {
          "type": "string",
          "description": "添加的数据库类型:\n- MYSQL:MySQL\n- ORACLE:Oracle\n- POSTGRESQL:PostgreSQL\n- SQLSERVER:SqlServer\n- DAMENG:Dameng\n- TAURUS:Taurus\n- DWS:Dws\n- KINGBASE:Kingbase\n- GAUSSDBOPENGAUSS:GaussDB(for openGauss)\n- GREENPLUM:Greenplum\n- HIGHGO:HighGo\n- SHENTONG:ShenTong\n- GBASE8A:GBase 8a\n- GBASE8S:GBase 8s\n- GBASEXDM:GBase XDM\n- MONGODB:MongoDB\n- DDS:DDS(Document Database Service)"
        },
        "version": {
          "type": "string",
          "description": "数据库版本"
        },
        "charset": {
          "type": "string",
          "description": "数据库字符集\n- GBK:GBK\n- UTF8:UTF8"
        },
        "ip": {
          "type": "string",
          "description": "数据库IP"
        },
        "port": {
          "type": "string",
          "description": "数据库端口"
        },
        "os": {
          "type": "string",
          "description": "数据库操作系统"
        },
        "status": {
          "type": "string",
          "description": "实例状态\n- ON:开启\n- OFF: 关闭"
        },
        "instance_name": {
          "type": "string",
          "description": "数据库实例名"
        },
        "audit_status": {
          "type": "string",
          "description": "数据库的运行状态\n- ACTIVE:运行中\n- SHUTOFF:已关闭\n- ERROR:故障"
        },
        "agent_url": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "agent的唯一ID"
        },
        "db_classification": {
          "type": "string",
          "description": "数据库分类\n- RDS:表示RDS数据库\n- ECS:自建数据库"
        },
        "rds_audit_switch_mismatch": {
          "type": "boolean",
          "description": "rds实例审计开关状态不匹配。当数据库审计开启且rds侧日志上传开关关闭时该字段为true。"
        },
        "rds_id": {
          "type": "string",
          "description": "RDS数据库的ID。"
        },
        "rds_obj_info": {
          "type": "string",
          "description": "RDS数据库信息。"
        },
        "dws_obj_info": {
          "type": "string",
          "description": "DWS数据库信息。"
        },
        "clouddb_obj_info": {
          "type": "string",
          "description": "云数据库信息,该字段已废弃。"
        }
      }
    },
    "DbssError": {
      "description": "异常消息体",
      "properties": {
        "details": {
          "description": "PDP5鉴权异常信息",
          "items": {
            "$ref": "#/definitions/DbssErrorDetail"
          },
          "type": "array",
          "minItems": 0,
          "maxItems": 100
        },
        "encoded_authorization_message": {
          "description": "PDP5鉴权异常信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        },
        "error_code": {
          "description": "错误码",
          "type": "string",
          "example": "DBSS.10020100",
          "minLength": 0,
          "maxLength": 2097152
        },
        "error_msg": {
          "description": "错误信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        }
      },
      "type": "object"
    },
    "DbssErrorDetail": {
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "example": "DBSS.00112233"
        },
        "error_msg": {
          "description": "PDP5错误信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        }
      },
      "type": "object"
    },
    "DataBaseResponse": {
      "type": "object",
      "properties": {
        "databases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DataBaseBean"
          },
          "description": "数据库信息列表"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "总数"
        }
      },
      "required": [
        "databases",
        "total"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dbss.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}