{
  "name": "ListAuditAgentNew",
  "summary": "查询数据库Agent列表",
  "tags": "审计Agent",
  "productshort": "DBSS",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/audit/{instance_id}/agents": {
      "get": {
        "x-apigateway-request-type": "public",
        "x-apigateway-ratelimit": "YunTanRateLimitDefault",
        "x-request-examples-url-1": "/v3/{project_id}/audit/{instance_id}/agents",
        "x-api-type": "open-api",
        "tags": [
          "审计Agent"
        ],
        "summary": "查询数据库Agent列表",
        "description": "查询数据库Agent列表",
        "operationId": "ListAuditAgentNew",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "default": "xxxxxxxxxxxxxxxx",
            "description": "**参数解释**:\n用户Token。通过调用IAM服务查询用户Token接口获取(响应消息头中X-Subject-Token的值)。\n**约束限制**:\n不涉及\n**取值范围**:\nIAM服务查询用户Token接口为准\n**默认取值**:\n不涉及",
            "in": "header",
            "name": "X-Auth-Token",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "minLength": 32,
            "maxLength": 64,
            "in": "path",
            "required": true,
            "type": "string",
            "description": "**参数解释**:\n项目ID。可通过IAM服务[查询指定IAM用户的项目列表]接口获取。\n**约束限制**:\n不涉及\n**取值范围**:\n以IAM服务接口返回值为准,字符长度32-64。\n**默认取值**:\n不涉及"
          },
          {
            "name": "instance_id",
            "minLength": 32,
            "maxLength": 64,
            "in": "path",
            "required": true,
            "type": "string",
            "description": "**参数解释**:\n实例ID。可通过查询实例列表接口ID字段获取\n**约束限制**:\n不涉及\n**取值范围**:\n以查询实例列表接口值为准,字符长度32-64。\n**默认取值**:\n不涉及"
          },
          {
            "name": "db_id",
            "in": "query",
            "required": true,
            "description": "**参数解释**:\n数据库ID, 可在查询数据库列表接口ID字段获取。\n**约束限制**:\n不涉及\n**取值范围**:\n以查询数据库列表接口值为准,字符长度16-64。\n**默认取值**:\n不涉及",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "$ref": "#/definitions/AuditAgentRespoonse"
            },
            "examples": {
              "application/json": {
                "agents": [
                  {
                    "agent_id": "X1miCo8BDdIO3rwSbhug",
                    "agent_type": "DB",
                    "agent_os": "LINUX64_X86",
                    "agent_ip": "2407:c080:11f0:23b:59d5:7ddf:5650:447b",
                    "agent_nic": "",
                    "cpu_threshold": 80,
                    "mem_threshold": 80,
                    "db_name": "",
                    "status": 1,
                    "datacap_status": 1,
                    "agent_url": "/opt/dbss_audit/audit_server/agent/",
                    "universal": false,
                    "sha256": "2619a4fc8ff3b3dda48c4347630bc8d7ece2e1f046eab7ac044e7d0df49886e3"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          }
        },
        "x-hc": "Y",
        "x-hcso": "Y",
        "x-hk": "Y",
        "x-sbc": "Y",
        "x-open-region-cloud": "hc,hk,hcso,sbc",
        "x-order": 2
      }
    }
  },
  "definitions": {
    "AuditAgentRespoonse": {
      "type": "object",
      "required": [
        "agents"
      ],
      "properties": {
        "agents": {
          "items": {
            "required": [
              "agent_id",
              "agent_type",
              "agent_os",
              "agent_ip"
            ],
            "properties": {
              "agent_id": {
                "type": "string",
                "example": "X1miCo8BDdIO3rwSbhug",
                "description": "agent ID"
              },
              "agent_type": {
                "type": "string",
                "example": "DB",
                "description": "agent 类型\n- DB:数据库端\n- APP:应用端"
              },
              "agent_os": {
                "type": "string",
                "example": "LINUX64_X86",
                "description": "agent OS"
              },
              "agent_ip": {
                "type": "string",
                "example": "2407:c080:11f0:23b:59d5:7ddf:5650:447b",
                "description": "agent安装节点IP"
              },
              "mem_threshold": {
                "type": "integer",
                "format": "int32",
                "example": 80,
                "description": "内存阈值"
              },
              "cpu_threshold": {
                "type": "integer",
                "format": "int32",
                "example": 80,
                "description": "cpu阈值"
              },
              "status": {
                "type": "integer",
                "format": "int32",
                "example": 1,
                "description": "agent状态\n- 1:开启\n- 0:关闭"
              },
              "agent_nic": {
                "type": "string",
                "example": "",
                "description": "agent网卡"
              },
              "db_name": {
                "type": "string",
                "example": "",
                "description": "数据库名称"
              },
              "datacap_status": {
                "type": "integer",
                "format": "int32",
                "example": 1,
                "description": "数据流量抓取状态\n- 1:运行中\n- 2:休眠中\n- 3:已停止\n- 4:异常"
              },
              "agent_url": {
                "type": "string",
                "example": "/opt/dbss_audit/audit_server/agent/",
                "description": "agent安装地址"
              },
              "universal": {
                "type": "boolean",
                "example": false,
                "description": "是否CCE场景"
              },
              "sha256": {
                "type": "string",
                "example": "2619a4fc8ff3b3dda48c4347630bc8d7ece2e1f046eab7ac044e7d0df49886e3",
                "description": "sha256值"
              }
            }
          },
          "description": "agent列表",
          "type": "array"
        }
      }
    },
    "DbssError": {
      "description": "异常消息体",
      "properties": {
        "details": {
          "description": "PDP5鉴权异常信息",
