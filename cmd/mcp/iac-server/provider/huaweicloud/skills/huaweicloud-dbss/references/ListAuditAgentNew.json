        "encoded_authorization_message": {
          "description": "PDP5鉴权异常信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        },
        "error_code": {
          "description": "错误码",
          "type": "string",
          "example": "DBSS.10020100",
          "minLength": 0,
          "maxLength": 2097152
        },
        "error_msg": {
          "description": "错误信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        }
      },
      "type": "object"
    },
    "DbssErrorDetail": {
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "example": "DBSS.00112233"
        },
        "error_msg": {
          "description": "PDP5错误信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        }
      },
      "type": "object"
    }
