          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          },
          "500": {
            "description": "服务端错误",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          }
        },
        "x-hc": "Y",
        "x-hcso": "Y",
        "x-hk": "Y",
        "x-sbc": "Y",
        "x-open-region-cloud": "hc,hk,hcso,sbc",
        "x-order": 3
      }
    }
