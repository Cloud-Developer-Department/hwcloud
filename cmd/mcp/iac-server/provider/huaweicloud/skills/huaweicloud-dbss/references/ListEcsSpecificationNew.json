  "definitions": {
    "EcsSpecificationBean": {
      "type": "object",
      "required": [
        "azs",
        "id",
        "level",
        "name",
        "proxy",
        "ram",
        "vcpus"
      ],
      "properties": {
        "azs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ECS规格所在的可用区集合"
        },
        "id": {
          "type": "string",
          "description": "规格ID"
        },
        "level": {
          "type": "string",
          "description": "规格等级,支持的等级以局点配置为准。\n- entry:入门版\n- low:基础版\n- medium:专业版\n- high:高级版"
        },
        "name": {
          "type": "string",
          "description": "规格名称"
        },
        "proxy": {
          "type": "integer",
          "format": "int32",
          "description": "规格可添加的数据库数量"
        },
        "ram": {
          "type": "integer",
          "format": "int32",
          "description": "内存"
        },
        "vcpus": {
          "type": "integer",
          "format": "int32",
          "description": "CPU"
        },
        "az_type": {
          "type": "string",
          "description": "可用区类型\n- DEDICATED:大网\n- DEC:边缘小站\n- EDGE:专属"
        }
      }
    },
    "DbssError": {
      "description": "异常消息体",
      "properties": {
        "details": {
          "description": "PDP5鉴权异常信息",
          "items": {
            "$ref": "#/definitions/DbssErrorDetail"
          },
          "type": "array",
          "minItems": 0,
          "maxItems": 100
        },
        "encoded_authorization_message": {
          "description": "PDP5鉴权异常信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        },
        "error_code": {
          "description": "错误码",
          "type": "string",
          "example": "DBSS.10020100",
          "minLength": 0,
          "maxLength": 2097152
        },
        "error_msg": {
          "description": "错误信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        }
      },
      "type": "object"
    },
    "DbssErrorDetail": {
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "example": "DBSS.00112233"
        },
        "error_msg": {
          "description": "PDP5错误信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        }
      },
      "type": "object"
    },
    "EcsSpecificationResponseNew": {
      "type": "object",
      "properties": {
        "specifications": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EcsSpecificationBean"
          },
          "description": "ecs规格集合"
        }
      }
    }
