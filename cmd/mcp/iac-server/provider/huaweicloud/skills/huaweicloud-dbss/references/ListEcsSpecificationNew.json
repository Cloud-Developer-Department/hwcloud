{
  "name": "ListEcsSpecificationNew",
  "summary": "查询ECS服务器规格信息",
  "tags": "审计实例",
  "productshort": "DBSS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/audit/specification": {
      "get": {
        "x-apigateway-request-type": "public",
        "x-apigateway-ratelimit": "YunTanRateLimitDefault",
        "x-request-examples-url-1": "/v1/{project_id}/audit/specification",
        "x-api-type": "open-api",
        "tags": [
          "审计实例"
        ],
        "summary": "查询ECS服务器规格信息",
        "description": "查询ECS服务器规格信息",
        "operationId": "ListEcsSpecificationNew",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "default": "xxxxxxxxxxxxxxxx",
            "description": "**参数解释**:\n用户Token。通过调用IAM服务查询用户Token接口获取(响应消息头中X-Subject-Token的值)。\n**约束限制**:\n不涉及\n**取值范围**:\nIAM服务查询用户Token接口为准\n**默认取值**:\n不涉及",
            "in": "header",
            "name": "X-Auth-Token",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "minLength": 32,
            "maxLength": 64,
            "in": "path",
            "required": true,
            "type": "string",
            "description": "**参数解释**:\n项目ID。可通过IAM服务[查询指定IAM用户的项目列表]接口获取。\n**约束限制**:\n不涉及\n**取值范围**:\n以IAM服务接口返回值为准,字符长度32-64。\n**默认取值**:\n不涉及"
          },
          {
            "name": "image_business_type",
            "in": "query",
            "required": false,
            "format": "int32",
            "type": "integer",
            "description": "**参数解释**:\n镜像类型。\n**约束限制**:\n以取值范围为准\n**取值范围**:\n- 1:运维\n- 2:加密\n- 3:审计\n**默认取值**:\n  不传则默认为审计"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "$ref": "#/definitions/EcsSpecificationResponseNew"
            },
            "examples": {
              "application/json": {
                "specifications": [
                  {
                    "level": "low",
                    "id": "s2.xlarge.4",
                    "name": "s2.xlarge.4",
                    "vcpus": 4,
                    "ram": 16384,
                    "proxy": 3,
                    "azs": [
                      "cn-cmcc1a-01"
                    ]
                  },
                  {
                    "level": "medium",
                    "id": "s2.2xlarge.4",
                    "name": "s2.2xlarge.4",
                    "vcpus": 8,
                    "ram": 32768,
                    "proxy": 6,
                    "azs": [
                      "cn-cmcc1a-01"
                    ]
                  },
                  {
                    "level": "high",
                    "id": "s3.4xlarge.4",
                    "name": "s3.4xlarge.4",
                    "vcpus": 16,
                    "ram": 65536,
                    "proxy": 30,
                    "azs": [
                      "cn-cmcc1a-01",
                      "cn-cmcc1b-01"
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "客户端错误",
            "schema": {
              "$ref": "#/definitions/DbssError"
