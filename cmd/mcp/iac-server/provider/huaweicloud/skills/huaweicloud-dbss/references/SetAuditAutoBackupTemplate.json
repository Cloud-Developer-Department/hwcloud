{
  "name": "SetAuditAutoBackupTemplate",
  "summary": "获取备份配置信息",
  "tags": "备份管理",
  "productshort": "DBSS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/audit/{instance_id}/backup/template": {
      "get": {
        "x-apigateway-request-type": "public",
        "x-apigateway-ratelimit": "YunTanRateLimitDefault",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "default": "xxxxxxxxxxxxxxxx",
            "description": "**参数解释**:\n用户Token。通过调用IAM服务查询用户Token接口获取(响应消息头中X-Subject-Token的值)。\n**约束限制**:\n不涉及\n**取值范围**:\nIAM服务查询用户Token接口为准\n**默认取值**:\n不涉及",
            "in": "header",
            "name": "X-Auth-Token",
            "required": true,
            "type": "string"
          },
          {
            "description": "**参数解释**:\n项目ID。可通过IAM服务[查询指定IAM用户的项目列表]接口获取。\n**约束限制**:\n不涉及\n**取值范围**:\n以IAM服务接口返回值为准,字符长度32-64。\n**默认取值**:\n不涉及",
            "in": "path",
            "name": "project_id",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "type": "string"
          },
          {
            "description": "**参数解释**:\n实例ID。可通过查询实例列表接口ID字段获取\n**约束限制**:\n不涉及\n**取值范围**:\n以查询实例列表接口值为准,字符长度32-64。\n**默认取值**:\n不涉及",
            "in": "path",
            "name": "instance_id",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/BackupTemplate"
            },
            "examples": {
              "application/json": {
                "cycle": "PER_HOUR",
                "trigger_time": "2025-08-21 02:15:44",
                "triggered": false,
                "latest_backup_time": null,
                "status": 1,
                "bucket_name": "cbh-ynf",
                "bucket_root_path": "/dbss"
              }
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          },
          "401": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          },
          "403": {
            "description": "未授权",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          },
          "500": {
            "description": "服务端错误",
            "schema": {
              "$ref": "#/definitions/DbssError"
            }
          }
        },
        "tags": [
          "备份管理"
        ],
        "description": "设置备份配置信息",
        "operationId": "SetAuditAutoBackupTemplate",
        "summary": "获取备份配置信息",
        "x-api-type": "open-api",
        "x-apigateway-backend": {
          "httpEndpoints": {
            "method": "GET",
            "path": "/v1/{project_id}/audit/{instance_id}/backup/template"
          }
        },
        "x-is-registered": "Y",
        "x-request-examples-url-1": "/v1/{project_id}/audit/{instance_id}/backup/template",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "DbssError": {
      "description": "异常消息体",
      "properties": {
        "details": {
          "description": "PDP5鉴权异常信息",
          "items": {
            "$ref": "#/definitions/DbssErrorDetail"
          },
          "type": "array",
          "minItems": 0,
          "maxItems": 100
        },
        "encoded_authorization_message": {
          "description": "PDP5鉴权异常信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        },
        "error_code": {
          "description": "错误码",
          "type": "string",
          "example": "DBSS.10020100",
          "minLength": 0,
          "maxLength": 2097152
        },
        "error_msg": {
          "description": "错误信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        }
      },
      "type": "object"
    },
    "DbssErrorDetail": {
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "example": "DBSS.00112233"
        },
        "error_msg": {
          "description": "PDP5错误信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 2097152,
          "example": "DBSS.00112233"
        }
      },
      "type": "object"
    },
    "BackupTemplate": {
      "properties": {
        "bucket_name": {
          "description": "OBS桶名称",
          "type": "string",
          "example": "定时备份"
        },
        "bucket_root_path": {
          "description": "OBS备份根路径",
          "type": "string",
          "example": "/dbss"
        },
        "cycle": {
          "description": "周期\n- PER_DAY:每天\n- PER_WEEK:每周\n- PER_MONTH:每月\n- PER_HOUR:每小时\n- FIVE_MIN:每5分钟",
          "type": "string",
          "example": "PER_HOUR"
        },
        "latest_backup_time": {
          "description": "最近备份时间",
          "format": "date-time",
          "type": "string",
          "example": "2025-08-05 09:23:19"
        },
        "status": {
          "description": "备份开关 \n- 0:关闭 \n- 1:开启",
          "format": "int32",
          "type": "integer",
          "example": 1
        },
        "trigger_time": {
          "description": "触发时间",
          "format": "date-time",
          "type": "string",
          "example": "2025-08-05 09:23:19"
        },
        "triggered": {
          "description": "是否已触发",
          "type": "boolean",
          "example": true
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dbss.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}