  "definitions": {
    "AlarmLogResponseNew": {
      "type": "object",
      "required": [
        "total_num",
        "alarm_log"
      ],
      "properties": {
        "total_num": {
          "type": "integer",
          "format": "int32",
          "example": 3,
          "description": "总条数"
        },
        "alarm_log": {
          "items": {
            "properties": {
              "id": {
                "type": "string",
                "example": "99AJFI8BZEbGVdGbOczC",
                "description": "告警ID"
              },
              "alarm_life": {
                "type": "string",
                "example": "ON",
                "description": "告警状态\n- ON:持续中\n- OFF:已关闭"
              },
              "send_email": {
                "type": "boolean",
                "example": true,
                "description": "是否发送邮件"
              },
              "alarm_time": {
                "type": "string",
                "example": "2024-04-25 06:55:00",
                "description": "告警发生时间"
              },
              "alarm_type": {
                "type": "string",
                "example": "RISK_DISK",
                "description": "告警类型\n- RISK_RULE:风险规则\n- RISK_CPU:CPU超限\n- RISK_MEMORY:内存超限\n- RISK_DISK:磁盘超限\n- RISK_DISK_CAPACITY:磁盘容量不足六个月\n- RISK_BACKUP:备份失败\n- AUDIT_QPS_OVERFLOW:流量超限入库延迟告警\n- RISK_AGENT:Agent异常\n- AUDIT_BACKUP_FAILED:实例备份失败(运维侧)"
              },
              "alarm_fix_time": {
                "type": "string",
                "example": null,
                "description": "告警恢复时间"
              },
              "alarm_status": {
                "type": "string",
                "example": "UNDO",
                "description": "告警确认状态\n- DONE:已确认\n- UNDO:未确认"
              },
              "alarm_risk": {
                "type": "string",
                "example": "HIGH",
                "description": "告警风险等级\n- LOW:低\n- MEDIUM:中\n- HIGH:高"
              },
              "alarm_description": {
                "type": "string",
                "example": "DISK USAGE 5%",
                "description": "告警描述信息"
              }
            }
          },
          "description": "告警列表",
          "type": "array"
        }
      }
    },
    "AlarmLogRequest": {
      "type": "object",
      "required": [
        "page",
        "size",
        "time"
      ],
      "properties": {
        "time": {
          "description": "时间",
          "properties": {
            "time_range": {
              "type": "string",
              "example": "DAY",
              "description": "时间范围。和start_time,end_time不能同时使用,同时传该参数优先级更高。枚举值\n- HALF_HOUR:半小时\n- HOUR:1小时\n- THREE_HOUR:3小时\n- TWELVE_HOUR:12小时\n- DAY:1天\n- WEEK:1周\n- MONTH:1个月;",
              "enum": [
                "HALF_HOUR",
                "HOUR",
                "THREE_HOUR",
                "TWELVE_HOUR",
                "DAY",
                "WEEK",
                "MONTH"
              ]
            },
            "start_time": {
              "type": "string",
              "example": null,
              "description": "开始时间,必须和end_time成对出现。格式必须为yyyy-MM-dd HH:mm:ss。UTC时间"
            },
            "end_time": {
              "type": "string",
              "example": null,
              "description": "结束时间,必须和start_time成对出现。格式必须为yyyy-MM-dd HH:mm:ss。UTC时间"
            }
          }
        },
        "risk": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "LOW",
            "MEDIUM"
          ],
          "description": "风险级别\n- LOW:低\n- MEDIUM:中\n- HIGH:高"
        },
        "type": {
          "type": "string",
          "example": null,
          "description": "告警类型\n- RISK_RULE:风险规则\n- RISK_CPU:CPU超限\n- RISK_MEMORY:内存超限\n- RISK_DISK:磁盘超限\n- RISK_DISK_CAPACITY:磁盘容量不足六个月\n- RISK_BACKUP:备份失败\n- AUDIT_QPS_OVERFLOW:流量超限入库延迟告警\n- RISK_AGENT:Agent异常\n- AUDIT_BACKUP_FAILED:实例备份失败(运维侧)"
        },
        "status": {
          "type": "string",
          "example": null,
          "description": "告警确认状态\n- DONE:已确认\n- UNDO:未确认",
          "enum": [
            "DONE",
            "UNDO"
          ]
        },
        "page": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "页码"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "example": 100,
          "description": "每页条数"
        }
      }
    },
    "DbssError": {
