  "definitions": {
    "IpcResponseDTO": {
      "type": "object",
      "properties": {
        "camera_id": {
          "type": "string",
          "description": "**参数说明**:摄像头ID,console界面查询摄像头IPC列表中的设备Id。",
          "minLength": 0,
          "maxLength": 255
        },
        "v2x_edge_id": {
          "type": "string",
          "description": "**参数说明**:Edge ID,用于唯一标识一个Edge,创建Edge后获得。方法参见 [创建Edge](https://support.huaweicloud.com/api-v2x/v2x_04_0078.html)。",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "(^$|^[a-zA-Z0-9_-]{1,128}$)"
        },
        "name": {
          "type": "string",
          "description": "**参数说明**:摄像头名称。",
          "minLength": 0,
          "maxLength": 255
        },
        "cross_id": {
          "type": "string",
          "description": "**参数说明**:摄像头所感知的路口或者路段的Id。",
          "minLength": 0,
          "maxLength": 255
        },
        "focal_type": {
          "type": "string",
          "description": "**参数说明**:摄像头聚焦类型。\n\n- long:长焦\n\n- short:短焦"
        },
        "parent_connect_code": {
          "type": "string",
          "description": "**参数说明**:摄像头连接的ITS800的互联编码。",
          "minLength": 0,
          "maxLength": 128
        },
        "connect_code": {
          "type": "string",
          "description": "**参数说明**:摄像头的互联编码。",
          "minLength": 0,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "description": "**参数说明**:描述。",
          "maxLength": 255,
          "pattern": "(^$|^[\\一-\\龥a-zA-Z0-9_-]{1,256}$)"
        },
        "esn": {
          "type": "string",
          "description": "**参数说明**:IPC的设备编码。",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_]{1,64}$"
        },
        "ip": {
          "type": "string",
          "description": "**参数说明**:该摄像头的ip地址。",
          "maxLength": 255
        },
        "status": {
          "type": "string",
          "description": "**参数说明**:摄像机的状态。\n\n**取值范围**:\n\n- ONLINE:在线 \n\n- OFFLINE:离线\n\n- INITIAL:初始化\n\n- UNKNOWN:未知 \n\n- SLEEP:休眠",
          "enum": [
            "ONLINE",
            "OFFLINE",
            "INITIAL",
            "UNKNOWN",
            "SLEEP"
          ]
        },
        "created_time": {
          "type": "string",
          "format": "date-time",
          "description": "**参数说明**:创建时间。\n          \n格式:yyyy-MM-dd''T''HH:mm:ss''Z''。\n\n例如 2020-09-01T01:37:01Z。",
          "x-type": "DateTime"
        },
        "last_modified_time": {
          "type": "string",
          "format": "date-time",
          "description": "**参数说明**:最后修改时间。\n          \n格式:yyyy-MM-dd''T''HH:mm:ss''Z''。\n\n例如 2020-09-01T01:37:01Z。",
          "x-type": "DateTime"
        },
        "last_online_time": {
          "type": "string",
          "format": "date-time",
          "description": "**参数说明**:最后在线时间。\n        \n格式:yyyy-MM-dd''T''HH:mm:ss''Z''。\n\n例如 2020-09-01T01:37:01Z。",
          "x-type": "DateTime"
        }
      },
      "x-subPackage": "ipc",
      "x-imports": "org.joda.time.DateTime;"
