      "type": "object",
      "properties": {
        "platform_type": {
          "type": "string",
          "example": "DRIS",
          "description": "**参数说明**:平台类型。\n\n **取值范围**:\n - DRIS:华为路网数字化平台\n - LITONG:利通\n - ZHONGQIYAN:中汽研",
          "pattern": "(DRIS|LITONG|ZHONGQIYAN)"
        },
        "platform_para": {
          "description": "**参数说明**:platform_type为非DRIS时有效,表示第三方平台的对接参数",
          "$ref": "#/definitions/PlatformPara"
        },
        "channel_status": {
          "type": "string",
          "example": "ONLINE",
          "description": "**参数说明**:华为路网数字化平台或第三方业务平台连接状态。\n\n**取值范围**:\n- ONLINE:在线\n- OFFLINE:离线\n- INITIAL:初始化",
          "pattern": "(ONLINE|OFFLINE|INITIAL)"
        }
      },
