  "definitions": {
    "HistoryTrafficEventDTO": {
      "type": "object",
      "x-subPackage": "v2xhistorydatadto",
      "x-imports": [
        "org.joda.time.DateTime;"
      ],
      "properties": {
        "event_id": {
          "description": "**参数说明**:事件ID,由平台生成。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "example": 11111
        },
        "event_source_type": {
          "description": "\n**参数说明**:事件来源类型列表,支持事件来源。\n\n**取值范围**:\n\n- unknown:未知数据\n\n- police:警方数据\n\n- government:政府数据\n\n- meteorological:气象数据\n\n- internet:互联网数据\n\n- detection:检测器检测到的数据\n\n- v2xServer:平台上报数据\n\n- rsu:RSU上报数据\n\n- obu:车载终端上报数据\n",
          "type": "string",
          "example": 2
        },
        "event_source_id": {
          "description": "**参数说明**:事件来源ID。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "example": 2
        },
        "esn": {
          "description": "**参数说明**:设备编码。\n**取值范围**:长度不超过64,只允许字母、数字、以及_等字符的组合。\n",
          "type": "string",
          "example": "2102312ETX10K7000037",
          "pattern": "^[a-zA-Z0-9_]{1,64}$"
        },
        "area_code": {
          "description": "**参数说明**:区域码。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647,
          "example": 568
        },
        "event_class": {
          "description": "**参数说明**:事件的分类。\n\n**取值范围**:\n\n- AbnormalTraffic:异常路况\n\n- AbnormalVehicle:异常车况\n\n- AdverseWeather:恶劣天气\n\n- TrafficSign:标志标牌\n",
          "type": "string",
          "example": "AbnormalTraffic"
        },
        "event_type": {
          "description": "**参数说明**:事件类型,参照附录[《国标交通事件及标志列表》](https://support.huaweicloud.com/api-v2x/v2x_04_0101.html)文件。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647,
          "example": 1111
        },
        "cross_id": {
          "description": "**参数说明**:路口id,对应到一组雷视拟合设备,检测一个特定的路口或者路段。",
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "example": 1111
        },
        "event_description": {
          "description": "**参数说明**:交通事件描述。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "example": "车辆事故"
        },
        "event_level": {
          "description": "**参数说明**:事件级别(1-5) 由低到高的事件严重程度。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 7,
          "example": 1
        },
        "event_params": {
          "description": "**参数说明**:事件参数,用户自定义。",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "event_position": {
          "description": "**参数说明**:事件发生位置经纬度。",
          "$ref": "#/definitions/Position3D"
        },
        "event_position_name": {
          "description": "**参数说明**:事件位置名称。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "example": "深圳深南大道"
        },
        "reference_paths": {
          "description": "**参数说明**:事件的关联路径。",
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/ReferencePath"
          }
        },
        "note": {
          "description": "**参数说明**:用户备注信息。",
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "example": "交通事件信息"
        },
        "event_status": {
          "description": "**参数说明**:事件的状态。\n\n**取值范围**:\n\n- Invalid:过期事件,事件发生的时间段在当前时间之前。\n\n- Active:活动事件,事件正在发生,当前时间处于事件发生时间段内。\n\n- Future:未来事件,在当前时间之后才会发生的事件。\n",
          "type": "string",
          "example": "Invalid"
        },
        "event_confidence": {
          "description": "**参数说明**:事件可信度。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1000,
          "example": 1
        },
        "event_ex_info": {
          "description": "**参数说明**:交通事件扩展信息。",
          "type": "object",
          "$ref": "#/definitions/EventExInfo"
        },
        "rsu_id": {
          "description": "**参数说明**:事件关联的rsuID。",
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 256
          }
        },
        "start_time": {
          "description": "**参数说明**:事件的开始时间。\n\n格式:yyyy-MM-dd''T''HH:mm:ss''Z''。\n\n例如 2020-09-01T01:37:01Z。\n",
          "type": "string",
          "x-type": "DateTime"
        },
        "end_time": {
          "description": "**参数说明**:事件的结束时间。\n\n格式:yyyy-MM-dd''T''HH:mm:ss''Z''。\n\n例如 2020-09-01T01:37:01Z。\n",
          "type": "string",
          "x-type": "DateTime"
        },
        "created_time": {
          "description": "**参数说明**:事件的创建时间。\n\n格式:yyyy-MM-dd''T''HH:mm:ss''Z''。\n\n例如 2020-09-01T01:37:01Z。\n",
          "type": "string",
          "x-type": "DateTime"
        }
      }
    },
    "CongestionInfo": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "format": "int32",
          "description": "**参数说明**:拥堵级别。\n\n**取值范围**:\n\n- 1:拥堵级别低,速度[25, 30) 单位:km/h\n\n- 2:拥堵级别中,速度[15,25) 单位:km/h\n\n- 3:拥堵级别高,速度[0, 15) 单位:km/h",
          "minimum": 0,
          "maximum": 3
        },
        "length": {
          "type": "integer",
          "format": "int32",
          "example": 200,
          "description": "**参数说明**:拥堵长度,单位为米(m)。",
          "minimum": 0,
          "maximum": 1000
        },
        "start_point": {
          "description": "**参数说明**:拥堵的起点经纬度。",
          "$ref": "#/definitions/Position3D"
        },
        "end_point": {
          "description": "**参数说明**:拥堵的终点经纬度。",
          "$ref": "#/definitions/Position3D"
        },
        "congestion_lanes_info": {
          "type": "array",
          "description": "**参数说明**:车道拥堵信息。",
          "items": {
            "$ref": "#/definitions/CongestionLanesInfo"
          },
          "maxItems": 100,
          "minItems": 0
        }
      },
      "description": "拥堵事件信息",
      "x-subPackage": "v2xhistorydatadto"
    },
    "TargetPos": {
      "x-subPackage": "v2xhistorydatadto",
      "type": "object",
      "x-imports": "java.math.BigDecimal;",
      "description": "目标检测框信息。采用万分比相对坐标:即假定任何图像的宽高均为10000*10000时,其目标框的坐标值。在实际图像中恢复实际像素坐标系的方法:X*1920/10000,Y*1080/10000;",
      "properties": {
        "left_top_x": {
          "type": "integer",
          "format": "int64",
          "description": "**参数说明**:目标区域框左上X坐标。",
          "example": 10,
          "minimum": 0,
          "maximum": 2147483647
        },
        "left_top_y": {
          "type": "integer",
          "format": "int64",
          "description": "**参数说明**:目标区域框左上Y坐标。",
          "example": 10,
          "minimum": 0,
          "maximum": 2147483647
        },
        "right_bottom_x": {
          "type": "integer",
          "format": "int64",
          "description": "**参数说明**:目标区域框右下X坐标。",
          "example": 10,
          "minimum": 0,
          "maximum": 2147483647
        },
        "right_bottom_y": {
          "type": "integer",
          "format": "int64",
          "description": "**参数说明**:目标区域框右下Y坐标。",
          "example": 10,
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "HistoryTrafficEventPageDTO": {
      "title": "条件查询历史交通事件返回结构体",
      "type": "object",
      "description": "条件查询历史交通事件返回结构体",
      "x-subPackage": "v2xhistorydatadto",
      "properties": {
        "count": {
          "description": "**参数说明**:条件查询返回的总条数。",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 2147483647,
          "example": 2
        },
        "events": {
          "description": "**参数说明**:事件列表。",
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "$ref": "#/definitions/HistoryTrafficEventDTO"
          }
        }
      }
    },
    "EventExInfo": {
      "type": "object",
      "description": "交通事件扩展信息",
      "x-subPackage": "v2xhistorydatadto",
      "properties": {
        "participants": {
          "description": "**参数说明**:识别出交通事件时所对应的交通参与者。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/EventParticipant"
          }
        },
        "congestion_info": {
          "description": "**参数说明**:拥堵事件时携带的信息。",
          "type": "object",
          "$ref": "#/definitions/CongestionInfo"
        }
      }
    },
    "ReferencePath": {
      "type": "object",
      "x-subPackage": "v2xhistorydatadto",
      "properties": {
        "active_path": {
          "description": "**参数说明**:事件的有效路径",
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "$ref": "#/definitions/Position3D"
          }
        },
        "path_radius": {
          "description": "**参数说明**:事件的影响区域半径,可选,单位为分米。用半径表示影响区域边界离中心线的垂直距离,反映该区域的宽度以覆盖实际路段。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 100000,
          "example": 100
        }
      }
    },
    "Position3D": {
      "x-subPackage": "v2xhistorydatadto",
      "type": "object",
      "x-imports": "java.math.BigDecimal;",
      "description": "位置信息。",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "description": "**参数说明**:定义纬度数值,北纬为正,南纬为负,单位°,精度小数点后7位。",
          "type": "object",
          "x-type": "BigDecimal",
          "example": 40.1234567,
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "description": "**参数说明**:定义经度数值。东经为正,西经为负,单位°,精度小数点后7位。",
          "type": "object",
          "x-type": "BigDecimal",
