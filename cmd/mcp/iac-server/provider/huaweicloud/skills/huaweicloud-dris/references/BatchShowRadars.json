    "RadarResourceDTO": {
      "x-subPackage": "radar",
      "x-imports": "org.joda.time.DateTime;",
      "properties": {
        "radar_id": {
          "type": "string",
          "description": "**参数说明**:雷达ID\n",
          "minLength": 0,
          "maxLength": 255,
          "example": "28f61af50fc9452aa0ed5ea25c3cc3d3"
        },
        "name": {
          "type": "string",
          "description": "**参数说明**:名称\n\n**取值范围**:长度不小于1,不大于128的汉字、英文字母、数字、下划线(_)和横杠(-)的组合。\n",
          "pattern": "^[\\一-\\龥a-zA-Z0-9_-]{1,128}$",
          "example": "radarname"
        },
        "v2x_edge_id": {
          "type": "string",
          "description": "**参数说明**:所属的EdgeId\n\n**取值范围**:长度不小于1,不大于128的英文字母、数字、下划线(_)和横杠(-)的组合。\n",
          "pattern": "(^$|^[a-zA-Z0-9_-]{1,128}$)",
          "example": "28f61af50fc9452aa0ed5ea25c3cc3d3"
        },
        "ip": {
          "type": "string",
          "description": "**参数说明**:设备IP\n",
          "pattern": "^((0|1\\d?\\d?|2[0-4]?\\d?|25[0-5]?|[3-9]\\d?)\\.){3}(0|1\\d?\\d?|2[0-4]?\\d?|25[0-5]?|[3-9]\\d?)$",
          "example": "127.0.0.1"
        },
        "status": {
          "type": "string",
          "enum": [
            "ONLINE",
            "OFFLINE",
            "UNKNOWN",
            "SLEEP"
          ],
          "description": "**参数说明**:状态值\n\n**取值范围**:\n  - ONLINE:在线\n  - OFFLINE:离线\n  - UNKNOWN:未知\n  - SLEEP:睡眠\n",
          "example": "ONLINE"
        },
        "esn": {
          "type": "string",
          "description": "**参数说明**:设备编号\n\n**取值范围**:长度不小于1,不大于64的英文字母、数字和下划线(_)的组合。\n",
          "pattern": "^[a-zA-Z0-9_]{1,64}$",
          "example": "28f61af50fc9452aa0ed5ea25c3cc3d3"
        },
        "position_description": {
          "type": "string",
          "description": "**参数说明**:位置描述\n\n**取值范围**:长度不小于1,不大于128的英文字母、数字和下划线(_)的组合。\n",
          "pattern": "^[0-9a-zA-Z_]{1,128}$",
          "example": "k01"
        },
        "created_time": {
          "description": "**参数说明**:最后修改的时间。格式:yyyy-MM-dd'T'HH:mm:ss'Z' 例如 2020-09-01T01:37:01Z\n",
          "type": "string",
          "format": "date-time",
          "x-type": "DateTime"
        },
        "last_modified_time": {
          "description": "**参数说明**:最后修改时间。格式:yyyy-MM-dd'T'HH:mm:ss'Z' 例如 2020-09-01T01:37:01Z\n",
          "type": "string",
          "format": "date-time",
          "x-type": "DateTime"
        },
        "last_online_time": {
          "description": "**参数说明**:最后的在线时间。格式:yyyy-MM-dd'T'HH:mm:ss'Z' 例如 2020-09-01T01:37:01Z\n",
          "type": "string",
          "format": "date-time",
          "x-type": "DateTime"
        }
      }
    }
