      "post": {
        "tags": [
          "APIG-SN-ForwardingConfigResources"
        ],
        "summary": "创建数据转发配置",
        "description": "创建数据转发配置。当前仅支持数据转发至kafka,数据转发配置成功添加后配置中的Topic消息将会转发至指定的brokers。",
        "operationId": "AddForwardingConfigs",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-v2x/v2x_04_0031.html)。\n\n**取值范围**:仅支持数字,a到f的小写字母组合,长度32。",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。dris物理实例的唯一标识。获取方法参见[获取Instance-Id](https://support.huaweicloud.com/api-v2x/v2x_04_0030.html)。\n\n**取值范围**:仅支持数字,小写字母和连接符(-)的组合,长度36。",
            "required": false,
            "type": "string",
            "pattern": "^[a-z0-9-]{36}$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数说明**:用户Token,Token认证鉴权时必选。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-v2x/v2x_04_0012.html)。",
            "required": false,
            "type": "string",
            "maxLength": 20000,
            "minLength": 1
          },
          {
            "in": "body",
            "name": "AddForwardingConfigsRequestBody",
            "description": "添加相关配置请求结构",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AddForwardingConfigRequestDTO"
            }
          }
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "responses": {
