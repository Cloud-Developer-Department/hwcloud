  "definitions": {
    "KafkaConfigRequestDTO": {
      "type": "object",
      "required": [
        "brokers"
      ],
      "properties": {
        "topic_prefix": {
          "type": "string",
          "example": "prefix",
          "description": "**参数说明**:Topic前缀,不携带时以user_topics中具体Topic为准,携带时前缀将拼接在user_topics中的topic前方,例如:topic_prefixv2x-v1-tracks,topic_prefixv2x-v1-bsm。",
          "minLength": 0,
          "maxLength": 255
        },
        "user_topics": {
          "type": "array",
          "description": "**参数说明**:kafka的主题列表,根据需要转发的消息类型填写。\n\n**取值范围**:\n\n- v2x-v1-tracks:edge上报的车辆轨迹数据\n\n- v2x-v1-bsm:车载T-BOX,mqtt协议接入rsu, websocket协议接入rsu上报的BSM消息数据\n\n- v2x-v1-rsi:mqtt协议接入rsu,edge上报的RSI消息数据\n\n- v2x-v1-rsm: mqtt协议接入rsu,edge上报的RSM消息数据\n\n- v2x-v1-spat:mqtt协议接入rsu, websocket协议接入rsu上报的SPAT消息数据\n\n- v2x-v1-edge-flow:edge上报的车流量统计信息数据",
          "items": {
            "type": "string",
            "example": "v2x-v1-rsm"
          },
          "maxItems": 7,
          "minItems": 0,
          "x-annotations": [
            "@PatternInList(regexp = \"^(v2x-v1-tracks|v2x-v1-bsm|v2x-v1-map|v2x-v1-rsi|v2x-v1-rsm|v2x-v1-spat|v2x-v1-edge-flow)$\")"
          ]
        },
        "brokers": {
          "type": "array",
          "description": "**参数说明**:Kafka broker列表。",
          "items": {
            "type": "string",
            "example": "127.0.0.1:10000",
            "minLength": 1,
            "maxLength": 255
          },
          "maxItems": 255,
          "minItems": 1
        },
        "username": {
          "type": "string",
          "example": "1234567890",
          "description": "**参数说明**:kafka用户名。\n\n**取值范围**:只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_-]*$"
        },
        "password": {
          "type": "string",
          "example": "1234567890",
          "description": "**参数说明**:kafka密码。",
          "minLength": 1,
          "maxLength": 255
        }
