            "$ref": "#/definitions/IdAndStatus"
          },
          "maxItems": 2147483647,
          "minItems": 0
        },
        "radars": {
          "type": "array",
          "description": "**参数说明**:Edge关联的雷达列表。",
          "items": {
            "$ref": "#/definitions/IdAndStatus"
          },
          "maxItems": 2147483647,
          "minItems": 0
        },
        "local_rsus": {
          "type": "array",
          "description": "**参数说明**:Edge关联的本地RSU列表。",
          "items": {
            "$ref": "#/definitions/IdAndStatus"
          },
          "maxItems": 2147483647,
          "minItems": 0
        },
        "edge_general_config": {
          "description": "**参数说明**:Edge通用配置。",
          "$ref": "#/definitions/EdgeGeneralConfigInResponse"
        },
        "edge_advance_config": {
          "type": "object",
          "example": {
            "key": "value",
            "key1": {
              "inner_key1": "inner_value1"
            }
          },
          "description": "**参数说明**:Edge高级配置,Json格式",
          "properties": {}
        },
        "status": {
          "type": "string",
          "example": "RUNNING",
          "description": "**参数说明**:状态。\n\n**取值范围**:\n- UNINSTALLED: 待部署\n- INSTALLED:部署中\n- OFFLINE:离线\n- ONLINE:在线:\n- UPGRADING:升级中\n- DELETING:删除中",
          "pattern": "(UNINSTALLED|INSTALLED|OFFLINE|ONLINE|UPGRADING|DELETING)"
        },
        "channel_status": {
          "type": "string",
          "example": "ONLINE",
          "description": "**参数说明**:业务通道状态。\n\n**取值范围**:\n- ONLINE:在线\n- OFFLINE:离线\n- INITIAL:初始化",
          "pattern": "(ONLINE|OFFLINE|INITIAL)"
        },
        "node_id": {
          "type": "string",
          "description": "**参数说明**:边缘管理服务返回的node_id,用于关联EdgeManager的资源。",
          "minLength": 0,
          "maxLength": 255
        },
        "created_time": {
          "type": "string",
          "format": "date-time",
          "description": "**参数说明**:创建时间。\n\n格式:yyyy-MM-dd''T''HH:mm:ss''Z''。\n\n例如 2020-09-01T01:37:01Z。",
          "x-type": "DateTime"
        },
        "last_modified_time": {
          "type": "string",
          "format": "date-time",
          "description": "**参数说明**:创建时间。\n\n格式:yyyy-MM-dd''T''HH:mm:ss''Z''。\n\n例如 2020-09-01T01:37:01Z。",
          "x-type": "DateTime"
        }
      },
      "description": "V2XEdge模型资源详情返回对象",
      "x-subPackage": "edge",
      "x-imports": "org.joda.time.DateTime;"
    },
    "EdgeGeneralConfigInResponse": {
      "type": "object",
      "properties": {
        "avp_enabled": {
          "type": "boolean",
          "description": "**参数说明**:AVP场景。"
        },
        "rsm_enabled": {
          "type": "boolean",
          "description": "**参数说明**:RSM上报:默认不上报。"
        },
        "time_compensate": {
          "type": "boolean",
          "description": "**参数说明**:时延补偿:是否启动Edge时延补偿功能。"
        },
        "rsi_positioning_enabled": {
          "type": "boolean",
          "description": "**参数说明**:RSI事件定位功能。"
        },
        "log_level": {
          "type": "string",
          "example": "off",
          "description": "**参数说明**:应用日志级别\n\n**取值范围**:on/off,默认关闭。",
          "pattern": "(on|off)",
          "default": "off"
        },
        "road_detection_length": {
          "type": "number",
          "format": "double",
          "description": "**参数说明**:道路检测长度,单位:米。",
          "minimum": 1,
          "maximum": 1000
        },
        "ramp_detection_length": {
          "type": "number",
          "format": "double",
          "description": "**参数说明**:匝道检测长度,单位:米。",
          "minimum": 1,
          "maximum": 1000
        },
        "gat1400_username": {
          "type": "string",
          "example": "dris_user",
          "description": "**参数说明**:1400接口用户名。\n\n**取值范围**:长度不小于8,不大于32,只允许数字字母下划线组合,且不能以数字下划线开头,不能有中文和特殊字符,gat1400用户名不能与gat1400密码相同。",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{7,31}$"
        },
        "user_name": {
          "type": "string",
          "example": "dris_user",
          "description": "**参数说明**:ITS800鉴权用的用户名和密码。",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "x-subPackage": "edge"
    }
  },
