    "V2XEdgeDetailResponseDTO": {
      "type": "object",
      "properties": {
        "v2x_edge_id": {
          "type": "string",
          "example": "v2x_edge_id",
          "description": "**参数说明**:Edge ID,用于唯一标识一个Edge。",
          "minLength": 0,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "example": "NAMEMC007",
          "description": "**参数说明**:名称。\n\n**取值范围**:长度不超过128,只允许中文、字母、数字、以及_.-等字符的组合。",
          "maxLength": 128,
          "pattern": "^[-a-zA-Z0-9_\\一-\\龥]{1,128}$"
        },
        "description": {
          "type": "string",
          "description": "**参数说明**:Edge描述。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "(^$|^[a-zA-Z0-9_\\-\\s\\一-\\龥]*$)"
        },
        "esn": {
          "type": "string",
          "example": "2102312ETX10K7000037",
          "description": "**参数说明**:序列号。\n\n**取值范围**:长度不超过64,只允许字母、数字、以及_等字符的组合。",
          "pattern": "^[a-zA-Z0-9_]{1,64}$"
        },
        "ip": {
          "type": "string",
          "example": "127.0.0.1",
          "description": "**参数说明**:网络I,例如127.0.0.1。",
          "pattern": "(^$|^((0|1\\d?\\d?|2[0-4]?\\d?|25[0-5]?|[3-9]\\d?)\\.){3}(0|1\\d?\\d?|2[0-4]?\\d?|25[0-5]?|[3-9]\\d?)$)"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "description": "ITS800,ATLAS 端口号",
          "minimum": 0,
          "maximum": 65535
        },
        "hardware_type": {
          "type": "string",
          "example": "ITS800",
          "description": "**参数说明**:硬件类型。\n\n**取值范围**:ITS800 或者 ATLAS。",
          "pattern": "(ITS800|ATLAS)"
        },
        "position_description": {
          "type": "string",
          "example": "K08",
          "description": "**参数说明**:安装位置编码,由用户自定义。\n\n**取值范围**:长度不低于1不超过128,只允许字母、数字、下划线(_)的组合。",
          "pattern": "^[a-zA-Z0-9_]{1,128}$"
        },
        "location": {
          "description": "**参数说明**:经纬度坐标。",
          "$ref": "#/definitions/Location"
        },
        "cameras": {
          "type": "array",
