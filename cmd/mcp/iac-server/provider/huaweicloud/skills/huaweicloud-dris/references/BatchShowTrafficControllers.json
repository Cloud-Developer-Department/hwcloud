  "definitions": {
    "TrafficControllerPageDTO": {
      "title": "批量查询返回结构体",
      "type": "object",
      "description": "批量查询返回结构体",
      "x-subPackage": "trafficcontroller",
      "properties": {
        "count": {
          "description": "**参数说明**:返回信号机设备的总体数量。",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 2147483647,
          "example": 1
        },
        "traffic_controller_devices": {
          "description": "**参数说明**:数据列表。",
          "type": "array",
          "minItems": 0,
          "maxItems": 2147483647,
          "items": {
            "$ref": "#/definitions/TrafficControllerDTO"
          }
        }
      }
    },
    "TrafficControllerDTO": {
      "x-subPackage": "trafficcontroller",
      "type": "object",
      "x-imports": "org.joda.time.DateTime;",
      "properties": {
        "traffic_controller_id": {
          "description": "**参数说明**:信号机设备ID,全局唯一。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "esn": {
          "description": "\"**参数说明**:序列号。\n\n**取值范围**:长度不超过64,只允许字母、数字、以及_等字符的组合。\n",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_]{1,64}$"
        },
        "name": {
          "description": "**参数说明**:名称。",
          "type": "string",
          "maxLength": 128,
          "pattern": "^[-a-zA-Z0-9_\\一-\\龥]{1,128}$"
        },
        "description": {
          "description": "**参数说明**:描述。\n\n**取值范围**:长度不超过2048,只允许中文、字母、数字、以及_?'#().,&%@!-等字符的组合。\n",
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[a-zA-Z0-9_;:?!,;:、,.?!。\\-\\s\\一-\\龥]*$"
        },
        "lat": {
          "description": "**参数说明**:定义纬度数值,北纬为正,南纬为负,单位°,精度小数点后7位。",
          "type": "number",
          "example": 40.1234567,
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "description": "**参数说明**:定义经度数值。东经为正,西经为负,单位°,精度小数点后7位。",
          "type": "number",
          "example": 116.1234567,
          "minimum": -180,
          "maximum": 180
        },
        "ele": {
          "description": "**参数说明**:定义海拔高程,可选,单位为分米。",
          "type": "number",
          "example": 1000,
          "minimum": -4095,
          "maximum": 61439
        },
        "pos_description": {
          "description": "**参数说明**:位置说明。\n\n**取值范围**:长度不超过128,只允许字母、数字、以及_等字符的组合。\n",
          "type": "string",
          "example": "K08",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_]{1,128}$"
        },
        "installation_mode": {
          "description": "**参数说明**:架设方式。\n\n**取值范围**:\n- columnar:柱式\n- road-side-attach:路侧附着式\n- cantilever:悬臂式\n- gantry:门架式\n- lane-above-attach:车行道上方附着式\n",
          "type": "string",
          "pattern": "(columnar|road-side-attach|cantilever|gantry|lane-above-attach)"
        },
        "road_name": {
          "description": "**参数说明**:所属道路名称,比如高速名称。\n\n**取值范围**:长度不超过64,只允许汉字、字母、数字、以及_-等字符的组合。\n",
          "type": "string",
          "example": "1号高速",
          "pattern": "^[\\一-\\龥a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "link_id": {
          "description": "**参数说明**:信号机设备所属路段ID。\n\n**取值范围**:长度等于30,只允许大写字母、数字。\n",
          "type": "string",
          "pattern": "^[A-Z0-9]{30}$"
        },
        "status": {
          "description": "**参数说明**:设备状态。\n\n**取值范围**:\n- ONLINE:在线\n- OFFLINE:离线\n- INITIAL:初始化\n",
          "type": "string",
          "pattern": "(ONLINE|OFFLINE|UNKNOWN)"
        },
        "last_modified_time": {
          "description": "**参数说明**:最后修改的时间。格式:yyyy-MM-dd'T'HH:mm:ss'Z' 例如 2020-09-01T01:37:01Z",
          "type": "string",
          "format": "date-time",
          "x-type": "DateTime"
        },
        "created_time": {
          "description": "**参数说明**:创建的时间。格式:yyyy-MM-dd'T'HH:mm:ss'Z' 例如 2020-09-01T01:37:01Z",
          "type": "string",
          "format": "date-time",
          "x-type": "DateTime"
        },
        "last_online_time": {
          "description": "**参数说明**:最后的在线时间。格式:yyyy-MM-dd'T'HH:mm:ss'Z' 例如 2020-09-01T01:37:01Z",
          "type": "string",
          "format": "date-time",
          "x-type": "DateTime"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-v2x/v2x_04_0031.html)。\n\n**取值范围**:仅支持数字,a到f的小写字母组合,长度32。",
      "required": true,
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数说明**:用户Token,Token认证鉴权时必选。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-v2x/v2x_04_0012.html)。",
      "required": false,
      "type": "string",
      "maxLength": 20000,
      "minLength": 1
    },
    "Instance-Id": {
      "name": "Instance-Id",
      "in": "header",
      "description": "\"**参数说明**:实例ID。dris物理实例的唯一标识。获取方法参见[获取Instance-Id](https://support.huaweicloud.com/api-v2x/v2x_04_0030.html)。\n\n**取值范围**:仅支持数字,小写字母和横杠(-)的组合,长度36。\"",
      "required": false,
      "type": "string",
      "pattern": "^[a-z0-9-]{36}$"
    }
  },
