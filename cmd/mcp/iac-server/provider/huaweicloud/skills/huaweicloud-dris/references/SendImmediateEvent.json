          "enum": [
            "unknown",
            "police",
            "government",
            "meteorological",
            "internet",
            "detection",
            "v2xServer",
            "rsu",
            "obu"
          ]
        },
        "event_source_id": {
          "type": "string",
          "example": "0123456789",
          "description": "**参数说明**:事件来源的ID,由用户自定义。",
          "minLength": 0,
          "maxLength": 255
        },
        "event_confidence": {
          "type": "integer",
          "format": "int32",
          "example": 100,
          "description": "**参数说明**:道路交通事件的信息来源提供的事件置信度水平,帮助接收端判断是否相信该事件信息,可选。",
          "minimum": 0,
          "maximum": 200
        },
        "event_position": {
          "$ref": "#/definitions/ImmediateEventPosition3D"
        },
        "event_radius": {
          "type": "integer",
          "format": "int32",
          "example": 1000,
          "description": "**参数说明**:事件的发生区域半径,单位为分米。",
          "minimum": 0,
          "maximum": 65535
        },
        "event_description": {
          "type": "string",
          "example": "0123456789",
          "description": "**参数说明**:事件的文本描述信息,可自行扩展需传递的信息。",
          "minLength": 0,
          "maxLength": 255
        },
        "event_priority": {
          "type": "integer",
          "format": "int32",
          "example": 3,
          "description": "**参数说明**:事件优先级,0-7,数字越大,级别越高。",
          "minimum": 0,
          "maximum": 7
