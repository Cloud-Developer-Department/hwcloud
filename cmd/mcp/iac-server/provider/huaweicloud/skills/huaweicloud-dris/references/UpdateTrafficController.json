          "minLength": 0,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_;:?!,;:、,.?!。\\-\\s\\一-\\龥]*$"
        },
        "lat": {
          "description": "**参数说明**:定义纬度数值,北纬为正,南纬为负,单位°,精度小数点后7位。",
          "type": "number",
          "example": 40.1234567,
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "description": "**参数说明**:定义经度数值。东经为正,西经为负,单位°,精度小数点后7位。",
          "type": "number",
          "example": 116.1234567,
          "minimum": -180,
          "maximum": 180
        },
        "ele": {
          "description": "**参数说明**:定义海拔高程,可选,单位为分米。",
          "type": "number",
          "example": 1000,
          "minimum": -4095,
          "maximum": 61439
        },
        "pos_description": {
