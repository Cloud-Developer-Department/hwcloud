  "definitions": {
    "AllKafkaConfigResponseDTO": {
      "type": "object",
      "properties": {
        "forwarding_type": {
          "type": "string",
          "example": "kafka",
          "description": "**参数说明**:转发配置的类型。\n\n**取值范围**:当前仅支持“kafka、mrskafka”。",
          "pattern": "kafka|mrskafka"
        },
        "kafka_config_id": {
          "type": "string",
          "example": "1234567890",
          "description": "**参数说明**:每一套Kafka配置的唯一ID。\n\n**取值范围**:只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_-]*$"
        },
        "kafka_topics": {
          "type": "array",
          "description": "**参数说明**:kafka的主题列表。\n\n**取值范围**:\n\n- v2x-v1-tracks:edge上报的车辆轨迹数据\n\n- v2x-v1-bsm:车载T-BOX,mqtt协议接入rsu, websocket协议接入rsu上报的BSM消息数据\n\n- v2x-v1-rsi:mqtt协议接入rsu,edge上报的RSI消息数据\n\n- v2x-v1-rsm: mqtt协议接入rsu,edge上报的RSM消息数据\n\n- v2x-v1-spat:mqtt协议接入rsu, websocket协议接入rsu上报的SPAT消息数据\n\n- v2x-v1-edge-flow:edge上报的车流量统计信息数据",
          "items": {
            "type": "string",
            "example": "v2x-v1-rsm",
            "pattern": "v2x-v1-tracks | v2x-v1-bsm | v2x-v1-map | v2x-v1-rsi | v2x-v1-rsm | v2x-v1-spat | v2x-v1-edge-flow"
          },
          "maxItems": 7,
          "minItems": 0
        },
        "brokers": {
          "type": "array",
          "description": "**参数说明**:Kafka broker列表。",
          "items": {
            "type": "string",
            "example": "127.0.0.1:10000",
            "minLength": 1,
            "maxLength": 255
          },
          "maxItems": 255,
          "minItems": 1
        },
        "username": {
          "type": "string",
          "example": "1234567890",
          "description": "**参数说明**:kafka用户名。\n\n**取值范围**:只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_-]*$"
        },
        "topic_prefix": {
          "type": "string",
          "example": "abc",
          "description": "**参数说明**:Topic前缀。\n\n**取值范围**:只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_-]*$"
        },
        "status": {
          "type": "string",
          "example": "ONLINE",
          "description": "**参数说明**:一套kafka的连接状态。\n\n**取值范围**:\n\n- OFFLINE:离线\n\n- ONLINE:在线",
          "enum": [
            "OFFLINE",
            "ONLINE"
          ]
        },
        "authentication": {
          "type": "boolean",
          "example": true,
          "description": "**参数说明**:是否开启kerberos安全认证的开关。若开启安全认证则需要先上传kerberos安全认证的凭证。",
          "default": false
        },
        "created_time": {
          "type": "string",
          "format": "date-time",
          "example": "2015-12-12T12:12:12Z",
          "description": "**参数说明**:创建时间。\n格式为yyyy-MM-dd'T'HH:mm:ss'Z'\n例如:2015-12-12T12:12:12Z",
          "x-type": "DateTime",
          "x-annotations": [
            "@JsonSerialize(using = CustomDateTimeSerializer.class)",
            "@JsonDeserialize(using = CustomDateTimeDeserializer.class)"
          ]
        },
        "last_modified_time": {
          "type": "string",
          "format": "date-time",
          "example": "2015-12-13T12:12:12Z",
          "description": "**参数说明**:修改时间。\n格式为yyyy-MM-dd'T'HH:mm:ss'Z'\n例如:2015-12-12T12:12:12Z",
          "x-type": "DateTime",
          "x-annotations": [
            "@JsonSerialize(using = CustomDateTimeSerializer.class)",
            "@JsonDeserialize(using = CustomDateTimeDeserializer.class)"
          ]
        }
      },
      "description": "**参数说明**:Kafka、MRS Kafka配置信息。",
      "x-subPackage": "forwardingconfig",
      "x-imports": "org.joda.time.DateTime;com.fasterxml.jackson.databind.annotation.JsonSerialize;com.fasterxml.jackson.databind.annotation.JsonDeserialize;com.huawei.iot.dris.component.base.serializer.CustomDateTimeSerializer;com.huawei.iot.dris.component.base.serializer.CustomDateTimeDeserializer;"
    }
  },
