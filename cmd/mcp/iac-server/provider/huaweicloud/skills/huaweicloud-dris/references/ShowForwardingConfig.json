      "get": {
        "tags": [
          "APIG-SN-ForwardingConfigResources"
        ],
        "summary": "查询数据转发配置",
        "description": "根据转发配置的唯一ID(forwarding_config_id)查询数据转发配置",
        "operationId": "ShowForwardingConfig",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-v2x/v2x_04_0031.html)。\n\n**取值范围**:仅支持数字,a到f的小写字母组合,长度32。",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。dris物理实例的唯一标识。获取方法参见[获取Instance-Id](https://support.huaweicloud.com/api-v2x/v2x_04_0030.html)。\n\n**取值范围**:仅支持数字,小写字母和连接符(-)的组合,长度36。",
            "required": false,
            "type": "string",
            "pattern": "^[a-z0-9-]{36}$"
          },
          {
            "name": "forwarding_type",
            "in": "query",
            "description": "**参数说明**:转发配置的类型。\n\n**取值范围**:当前仅支持“kafka,mrskafka”。",
            "required": true,
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^(kafka|mrskafka)$"
          },
          {
            "name": "forwarding_config_id",
            "in": "path",
            "description": "**参数说明**:转发配置的唯一ID。",
            "required": true,
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数说明**:用户Token,Token认证鉴权时必选。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-v2x/v2x_04_0012.html)。",
            "required": false,
            "type": "string",
            "maxLength": 20000,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "forwarding_type": "kafka",
                "kafka_config_id": 1234567890,
                "kafka_topics": [
                  "v2x-v1-tracks",
                  "v2x-v1-bsm",
                  "v2x-v1-rsi",
                  "v2x-v1-rsm",
                  "v2x-v1-spat",
                  "v2x-v1-edge-flow"
                ],
                "topic_prefix": "prefix",
                "brokers": [
                  "127.0.0.1:10000"
                ],
                "username": "1234567890",
                "status": "OFFLINE",
                "authentication": false,
                "created_time": "2015-12-12T12:12:12Z",
                "last_modified_time": "2015-12-12T12:12:12Z"
              }
            },
            "schema": {
              "$ref": "#/definitions/AllKafkaConfigResponseDTO"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
