  "definitions": {
    "RsuLocation": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "example": 40.1234567,
          "description": "**参数说明**:定义纬度数值,北纬为正,南纬为负,单位°,精度小数点后7位。",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "example": 116.1234567,
          "description": "**参数说明**:定义经度数值。东经为正,西经为负,单位°,精度小数点后7位。",
          "minimum": -180,
          "maximum": 180
        }
      },
      "x-subPackage": "rsu",
      "x-imports": [
        "com.fasterxml.jackson.annotation.JsonFormat"
      ]
    },
    "RsuDTO": {
      "type": "object",
      "properties": {
        "rsu_id": {
          "type": "string",
          "example": "b58efc27-a6e5-4bca-9d12-c76ecfe3f102",
          "description": "**参数说明**:RSU的唯一标识符,在平台创建RSU时由平台生成。",
          "minLength": 0,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "example": "RSU001",
          "description": "**参数说明**:RSU的名字。\n\n**取值范围**:长度不低于1不超过128,只允许中文、字母、数字、下划线(_)、连接符(-)的组合。"
        },
        "description": {
          "type": "string",
          "example": "TEST",
          "description": "**参数说明**:RSU的描述。\n\n**取值范围**:只允许中文、字母、数字、下划线(_)、中文分号(;)、中文冒号(:)、中文问号(?)、中文感叹号(!)中文逗号(,)、中文句号(。)、英文分号(;)、英文冒号(:)、英文逗号(,)、英文句号(.)、英文问号(?)、英文感叹号(!)、顿号(、)、连接符(-)的组合。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_;:?!,;:、,.?!。\\-\\s\\一-\\龥]*$"
        },
        "esn": {
          "type": "string",
          "example": "13518098671442480164720973683901",
          "description": "**参数说明**:RSU的设备序列号。\n\n**取值范围**:只允许字母、数字、下划线(_)的组合。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_]{1,64}$"
        },
        "last_modified_time": {
          "type": "string",
          "format": "date-time",
          "example": "2020-09-01T01:37:01Z",
          "description": "**参数说明**:最后修改的时间。\n\n格式:yyyy-MM-dd'T'HH:mm:ss'Z'\n\n例如 2020-09-01T01:37:01Z",
          "x-type": "DateTime"
        },
        "created_time": {
          "type": "string",
          "format": "date-time",
          "example": "2020-09-01T01:37:01Z",
          "description": "**参数说明**:创建的时间。\n\n格式:yyyy-MM-dd'T'HH:mm:ss'Z'\n\n例如 2020-09-01T01:37:01Z",
          "x-type": "DateTime"
        },
        "last_online_time": {
          "type": "string",
          "format": "date-time",
          "example": "2020-09-01T01:37:01Z",
          "description": "**参数说明**:最后的在线时间。\n\n格式:yyyy-MM-dd'T'HH:mm:ss'Z'\n\n例如 2020-09-01T01:37:01Z",
          "x-type": "DateTime"
        },
        "ip": {
          "type": "string",
          "example": "127.0.0.1",
          "description": "**参数说明**:RSU的IP。满足IP的格式,例如127.0.0.1。",
          "pattern": "(^$|^((0|1\\d?\\d?|2[0-4]?\\d?|25[0-5]?|[3-9]\\d?)\\.){3}(0|1\\d?\\d?|2[0-4]?\\d?|25[0-5]?|[3-9]\\d?)$)"
        },
        "position_description": {
          "type": "string",
          "example": "K08",
          "description": "**参数说明**:安装位置编码,由用户自定义。\n\n**取值范围**:长度不低于1不超过128,只允许字母、数字、下划线(_)的组合。",
          "pattern": "^[a-zA-Z0-9_]{1,128}$"
        },
        "location": {
          "description": "**参数说明**:RSU的位置信息。",
          "$ref": "#/definitions/RsuLocation"
        },
        "status": {
          "type": "string",
          "example": "ONLINE",
          "description": "**参数说明**:RSU设备状态。\n\n**取值范围**:\n\n- ONLINE:在线\n\n- OFFLINE:离线\n\n- INITIAL:初始化\n\n- UNKNOWN:未知",
          "pattern": "(ONLINE|OFFLINE|INITIAL|UNKNOWN)"
        },
        "rsu_model_id": {
          "type": "string",
          "example": "27652459499824704332521974743806",
          "description": "**参数说明**:RSU型号ID,用于唯一标识一个RSU型号,在平台创建RSU型号后由平台分配获得,获取方法可参见 [创建RSU型号](https://support.huaweicloud.com/api-v2x/v2x_04_0020.html)。\n\n**取值范围**:长度不低于1不超过36,只允许字母、数字、连接符(-)的组合。\n\n**该字段仅供使用MQTT协议RSU设备的用户输入。使用websocket协议RSU设备的用户需忽略此字段。**",
          "pattern": "^[a-zA-Z0-9-]{1,36}$"
        },
        "intersection_id": {
          "type": "string",
          "example": "1-301",
          "description": "**参数说明**:在地图中,rsu所在区域对应的路口ID,也即区域ID拼接路口ID,格式为:region-node_id。其中路网最基本的构成即节点和节点之间连接的路段。节点可以是路口,也可以是一条 路的端点。一个节点的ID在同一个区域内是唯一的。",
          "minLength": 0,
          "maxLength": 36
        },
        "related_edge_num": {
          "type": "integer",
          "format": "int32",
          "description": "**参数说明**:RSU可关联的Edge的数量。",
          "minimum": 0,
          "maximum": 64
        },
        "software_version": {
          "type": "string",
          "example": "V100X00XX00X325",
          "description": "**参数说明**:RSU的软件版本,由RSU上报其软件版本。",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "x-subPackage": "rsu",
      "x-imports": "org.joda.time.DateTime;"
    },
    "RsuPageDTO": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 1,
          "description": "**参数说明**:返回RSU的总体数量。",
          "minimum": 0,
          "maximum": 100000
        },
        "rsus": {
          "type": "array",
          "description": "**参数说明**:RSU数据列表。",
          "items": {
            "$ref": "#/definitions/RsuDTO"
          },
          "maxItems": 2147483647,
          "minItems": 0
        }
      },
      "title": "批量查询返回结构体",
      "description": "批量查询返回结构体",
      "x-subPackage": "rsu"
    }
  },
