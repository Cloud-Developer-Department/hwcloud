  "definitions": {
    "QueryLtsLogResponseBody": {
      "description": "lts查询结果详细",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minLength": 0,
          "maxLength": 5000,
          "description": "日志条数。"
        },
        "logs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5000,
          "description": "日志信息。",
          "items": {
            "$ref": "#/definitions/LogContents"
          }
        },
        "isQueryComplete": {
          "type": "boolean",
          "description": "是否查询完成。"
        },
        "analysisLogs": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "分析日志返回响应体"
        }
      }
    },
    "ErrorResultInfo": {
      "description": "调用失败时的返回值。",
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "enum": [
            "LTS.0403"
          ],
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "enum": [
            "Invalid projectId"
          ],
          "description": "调用失败响应信息描述。"
        }
      }
    },
    "LogContents": {
      "description": "参数集",
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "日志原数据。",
          "example": "warn:2020/04/09 06:57:01 helloworld.go:108: the main process is running now."
        },
        "line_num": {
          "type": "string",
          "minLength": 19,
          "maxLength": 19,
          "description": "日志单行序列号。",
          "example": "15390682339830002"
        },
        "labels": {
          "description": "该条日志包含的 labels。",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "QueryLtsLogParams": {
      "description": "此参数在请求实体中,采用json字符串格式",
      "type": "object",
      "required": [
        "start_time",
        "end_time"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "minLength": 13,
          "maxLength": 13,
          "description": "搜索起始时间(UTC时间,毫秒级)。"
        },
        "end_time": {
          "type": "string",
          "minLength": 13,
          "maxLength": 13,
          "description": "搜索结束时间(UTC时间,毫秒级)。"
        },
        "labels": {
          "description": "日志过滤条件集合,不同日志来源所需字段不同。",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "is_count": {
          "description": "日志条数统计。默认为false(不统计),true为统计日志条数。",
          "type": "boolean"
        },
        "keywords": {
          "type": "string",
          "description": "支持关键词精确搜索。关键词指相邻两个分词符之间的单词,例:error",
          "example": "error"
        },
        "line_num": {
          "type": "string",
          "minLength": 19,
          "maxLength": 19,
          "description": "日志单行序列号,第一次查询时不需要此参数,后续分页查询时需要使用,可从上次查询的返回信息中获取。line_num应在start_time 和 end_time 之间。"
        },
        "__time__": {
          "type": "string",
          "description": "若已开启自定义时间功能,需要使用该字段进行分页查询。"
        },
        "is_desc": {
          "type": "boolean",
          "default": false,
          "description": "顺序或者倒序查询, 默认为false(顺序查询)"
        },
        "scroll_id": {
          "type": "string",
          "description": "**参数解释:**\n分页查询时,若上次查询的返回结果中包含该字段,需要增加该字段参与分页查询。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "search_type": {
          "type": "string",
          "enum": [
            "forwards",
            "backwards"
          ],
          "description": "首次查询为 “init”, 分页查询时为 “forwards”或者“backwards”, 默认为首次查询“init”, 与 is_desc 参数配合进行分页查询。"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 5000,
          "description": "表示每次查询的日志条数,不填时默认为50,建议您设置为100。"
        },
        "highlight": {
          "type": "boolean",
          "default": true,
          "description": "日志关键词高亮显示,默认为true(高亮显示),false为取消高亮显示。"
        },
        "is_iterative": {
          "type": "boolean",
          "default": false,
          "description": "日志迭代查询,默认为false(不开启迭代),true为开启迭代。"
        },
        "query": {
          "type": "string",
          "description": "使用带管道符的sql分析语句进行查询,需要query参数is_analysis_query为true时生效。"
        },
        "is_analysis_query": {
          "type": "boolean",
          "description": "是否为带管道符的sql分析语句。当该参数为true时,将依照body体中的query参数内容进行查询,且body体中除start_time与end_time以外的参数失效,分页、排序、查询结果条数等功能请依照sql语法规则实现。查询结果的响应体不同于未启用时的查询方式,将以默认列存的形式返回查询结果。当前仅对内测用户开放。响应示例:{\"analysisLogs\":[{\"field1\":\"1\",\"field2\":\"2\",\"field3\":\"3\"},{\"field1\":\"1\",\"field2\":\"2\",\"field3\":\"3\"},{\"field1\":\"1\",\"field2\":\"2\",\"field3\":\"3\"}]}"
        }
      }
    }
  },
