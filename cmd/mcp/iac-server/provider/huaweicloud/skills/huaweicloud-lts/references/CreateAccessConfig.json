        },
        "processors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Processor"
          },
          "description": "IC结构化解析器"
        },
        "application_id": {
          "type": "string",
          "description": "ServiceStage应用ID"
        },
        "environment_id": {
          "type": "string",
          "description": "ServiceStage环境ID"
        },
        "component_id": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ServiceStage组件ID"
        },
        "access_config_type_source": {
          "type": "string",
          "description": "日志接入自建软件来源"
