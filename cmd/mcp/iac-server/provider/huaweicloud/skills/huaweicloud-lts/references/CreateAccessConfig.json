    "CreateAccessConfigRequestBody": {
      "description": "创建日志接入请求体",
      "required": [
        "access_config_name",
        "access_config_type",
        "access_config_detail",
        "log_info"
      ],
      "properties": {
        "access_config_name": {
          "type": "string",
          "description": "日志接入名称。\n满足正则表达式:^(?!\\.)(?!_)(?!.*?\\.$)[\\一-\\龥a-zA-Z0-9-_.]{1,64}$",
          "pattern": "^(?!\\.)(?!_)(?!.*?\\.$)[\\一-\\龥a-zA-Z0-9-_.]{1,64}$",
          "minLength": 1,
          "maxLength": 64
        },
        "access_config_type": {
          "type": "string",
          "description": "日志接入类型。AGENT:ECS接入,K8S_CCE:CCE接入",
          "enum": [
            "AGENT",
            "K8S_CCE"
          ]
        },
        "access_config_detail": {
          "$ref": "#/definitions/AccessConfigDeatilCreate"
        },
        "log_info": {
          "$ref": "#/definitions/AccessConfigBaseLogInfoCreate"
        },
        "host_group_info": {
          "$ref": "#/definitions/AccessConfigHostGroupIdListCreate"
        },
        "access_config_tag": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/accessConfigTag"
          },
          "description": "标签信息。KEY不能重复,最多20个标签"
        },
        "binary_collect": {
          "type": "boolean",
          "description": "二进制采集"
        },
        "log_split": {
          "type": "boolean",
          "description": "日志拆分"
        },
        "cluster_id": {
          "type": "string",
          "description": "CCE集群ID,当CCE类型时,为必填"
        },
        "incremental_collect": {
          "type": "boolean",
          "description": "是否增量采集 true 为是   false为否(全量采集)"
        },
        "encoding_format": {
          "type": "string",
          "description": "编码格式,支持UTF-8,GDB默认UTF-8"
        },
        "processor_type": {
          "type": "string",
          "description": "IC结构化解析类型包括 :SINGLE_LINE 单行全文,MULTI_LINE 多行全文,REGEX 单行正则,MULTI_REGEX 多行正则,SPLIT 分隔符,JSON JSON解析,NGINX nginx解析, COMPOSE组合解析"
        },
        "demo_log": {
          "type": "string",
          "description": "示例日志"
        },
        "demo_fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DemoFieldAccess"
          },
