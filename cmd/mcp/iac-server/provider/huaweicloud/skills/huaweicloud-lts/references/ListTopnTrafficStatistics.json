  "definitions": {
    "TopnRequstBody": {
      "type": "object",
      "required": [
        "end_time",
        "is_desc",
        "resource_type",
        "sort_by",
        "start_time",
        "topn",
        "filter",
        "search_list"
      ],
      "properties": {
        "end_time": {
          "type": "integer",
          "format": "int64",
          "description": "结束时间时间戳,毫秒时间"
        },
        "is_desc": {
          "type": "boolean",
          "description": "是否降序  true / false"
        },
        "resource_type": {
          "type": "string",
          "description": "资源类型,log_group / log_stream / tenant"
        },
        "sort_by": {
          "type": "string",
          "description": "排序依据,index/write/storage/basicTransfer/seniorTransfer/coldStorage,必须是search_list中存在的数据"
        },
        "start_time": {
          "type": "integer",
          "format": "int64",
          "description": "开始时间时间戳,毫秒时间,最多支持30天范围内的查询"
        },
        "topn": {
          "type": "integer",
          "format": "int32",
          "description": "查询前多少数据,范围1~100"
        },
        "filter": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "过滤条件 {\n    \"log_group_id\": \"xxxxxx\"\n}过滤器,为一个map结构,键为过滤属性,值为属性值,不支持模糊匹配"
        },
        "search_list": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "查询数据类型,字符串数组可多种搭配,只能在index/write/storage/basicTransfer/seniorTransfer/coldStorage中选填"
        }
      }
    },
    "Error400LTSRsp": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "description": "错误码\n最小长度:8\n最大长度:36"
        },
        "errorMessage": {
          "type": "string",
          "description": "错误描述\n最小长度:2\n最大长度:512"
        }
      }
    },
    "ResultsTopnBody": {
      "type": "object",
      "required": [
        "index_traffic",
        "storage",
        "write_traffic",
        "log_group_id",
        "log_group_name"
      ],
      "properties": {
        "index_traffic": {
          "type": "number",
          "format": "double",
          "description": "索引流量,byte, 查询数据类型中包含index时返回"
        },
        "storage": {
          "type": "number",
          "format": "double",
          "description": "存储量,byte, 查询数据类型中包含storage时返回"
        },
        "write_traffic": {
          "type": "number",
          "format": "double",
          "description": "写入流量,byte, 查询数据类型中包含write时返回"
        },
        "log_group_id": {
          "type": "string",
          "description": "日志组id,资源类型为日志组时返回"
        },
        "log_group_name": {
          "type": "string",
          "description": "日志组名称,资源类型为日志组时返回"
        },
        "log_group_name_alias": {
          "type": "string",
          "description": "**参数解释:**\n日志组名称别名。\n**取值范围:**\n不涉及。"
        },
        "log_stream_id": {
          "type": "string",
          "description": "日志流id,资源类型为日志流时返回"
        },
        "log_stream_name": {
          "type": "string",
          "description": "日志流名称,资源类型为日志流时返回"
        },
        "log_stream_name_alias": {
          "type": "string",
          "description": "**参数解释:**\n日志流名称别名。\n**取值范围:**\n不涉及。"
        },
        "basic_transfer": {
          "type": "number",
          "format": "double",
          "description": "基础转储流量,byte, 查询数据类型中包含basicTransfer时返回"
        },
        "senior_transfer": {
          "type": "number",
          "format": "double",
          "description": "基础转储流量,byte, 查询数据类型中包含seniorTransfer时返回"
        },
        "is_agency_transfer": {
          "type": "boolean",
          "description": "不是委托转储,true,是委托转储,则前端资源统计展示的流不能跳",
          "default": false
        },
        "cold_storage": {
          "type": "number",
          "format": "double",
          "description": "冷存储量"
        }
      }
    },
    "TopNRes200body": {
      "type": "object",
      "properties": {
        "results": {
          "items": {
            "$ref": "#/definitions/ResultsTopnBody"
          },
          "description": "响应结果",
          "type": "array"
        }
      }
    }
