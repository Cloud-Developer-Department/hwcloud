{
  "name": "ListTransfers",
  "summary": "查询日志转储",
  "tags": "日志转储",
  "productshort": "LTS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/transfers": {
      "get": {
        "x-request-examples-description-1": "若不传参数则查询所有日志转储信息。若根据log_transfer_type,log_group_name,log_stream_name这3中不同的参数,则查询对应的日志转储。",
        "x-request-examples-text-1": "/v2/{project_id}/transfers /v2/{project_id}/transfers?log_group_name=lts-group-txxx /v2/{project_id}/transfers?log_transfer_type=OBS /v2/{project_id}/transfers?log_stream_name=lts-topic-testRexxx /v2/{project_id}/transfers?log_group_name=lts-group-txxx&log_transfer_type=OBS /v2/{project_id}/transfers?log_group_name=lts-group-txxx&log_stream_name=lts-topic-testRxxx /v2/{project_id}/transfers?log_transfer_type=OBS&log_stream_name=lts-topic-testRxxx /v2/{project_id}/transfers?log_group_name=lts-group-txxx&log_transfer_type=OBS&log_stream_name=lts-topic-testRexxx",
        "x-request-examples-1": "/v2/{project_id}/transfers /v2/{project_id}/transfers?log_group_name=lts-group-txxx /v2/{project_id}/transfers?log_transfer_type=OBS /v2/{project_id}/transfers?log_stream_name=lts-topic-testRexxx /v2/{project_id}/transfers?log_group_name=lts-group-txxx&log_transfer_type=OBS /v2/{project_id}/transfers?log_group_name=lts-group-txxx&log_stream_name=lts-topic-testRxxx /v2/{project_id}/transfers?log_transfer_type=OBS&log_stream_name=lts-topic-testRxxx /v2/{project_id}/transfers?log_group_name=lts-group-txxx&log_transfer_type=OBS&log_stream_name=lts-topic-testRexxx",
        "x-request-examples-url-1": "GET https://{endpoint}/v2/{project_id}/transfers",
        "tags": [
          "日志转储"
        ],
        "operationId": "ListTransfers",
        "summary": "查询日志转储",
        "description": "该接口用于查询OBS转储,DIS转储,DMS转储配置。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方式请参见:获取账号ID、项目ID、日志组ID、日志流ID(https://support.huaweicloud.com/api-lts/lts_api_0006.html)。",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 32
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "从IAM服务获取的用户Token,获取方式请参见:获取用户Token(https://support.huaweicloud.com/api-iam/iam_30_0001.html)",
            "required": true,
            "type": "string",
            "maxLength": 2000,
            "minLength": 1000,
            "pattern": "X-Auth-Token"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "该字段填为:application/json;charset=UTF-8。",
            "required": true,
            "type": "string",
            "default": "application/json;charset=UTF-8",
            "minLength": 30,
            "maxLength": 30
          },
          {
            "name": "log_transfer_type",
            "in": "query",
            "required": false,
            "description": "日志转储类型。OBS指OBS日志转储,DIS指DIS日志转储,DMS指DMS日志转储",
            "type": "string",
            "enum": [
              "OBS",
              "DIS",
              "DMS"
            ]
          },
          {
            "name": "log_group_name",
            "in": "query",
            "required": false,
            "description": "日志组名称",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "log_stream_name",
            "in": "query",
            "required": false,
            "description": "日志流名称",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "responses": {
          "200": {
            "description": "查询转储请求响应成功。",
            "schema": {
              "$ref": "#/definitions/QueryTransfersResponseBody"
            },
            "examples": {
              "application/json": "{\"log_transfers\":[{\"log_group_id\":\"9a7e2183-2d6d-4732-9a9b-e897fd4e49e0\",\"log_group_name\":\"lts-group-kafka\",\"log_streams\":[{\"log_stream_id\":\"839dac89-35af-4db2-ab4a-a7dda0d0d3f8\",\"log_stream_name\":\"lts-topic-kafka\"}],\"log_transfer_id\":\"ddced522-233a-4181-a5fc-7b458c819afc\",\"log_transfer_info\":{\"log_create_time\":1634802241847,\"log_storage_format\":\"JSON\",\"log_agency_transfer\":{\"agency_domain_id\":\"1d26cc8c86a840e28a4f8d0d078xxxxx\",\"agency_domain_name\":\"paas_apm_z004xxxxx_xx\",\"agency_name\":\"test20210325\",\"agency_project_id\":\"2a473356cca5487f8373be891bfxxxxx\",\"be_agency_domain_id\":\"1d26cc8c86a840e28a4f8d0d078xxxxx\",\"be_agency_project_id\":\"2a473356cca5487f8373be891bfxxxxx\"},\"log_transfer_detail\":{//当创建OBS转储时,会返回如下参数\"obs_period\":2,\"obs_prefix_name\":\"\",\"obs_period_unit\":\"min\",\"obs_transfer_path\":\"/0002/LogTanks/cn-north-7/\",\"obs_eps_id\":\"0\",\"obs_bucket_name\":\"0002\",\"obs_encrypted_enable\":false,\"obs_dir_pre_fix_name\":\"\"//当创建DIS转储时,会返回如下参数\"dis_id\":\"xxxxx\",\"dis_name\":\"xxxxxx\",//当创建DMS转储时,会返回如下参数\"kafka_id\":\"xxxxxx\",\"kafka_topic\":\"xxxxx\"},\"log_transfer_mode\":\"cycle\",\"log_transfer_status\":\"ENABLE\",\"log_transfer_type\":\"OBS\"}}]}"
            }
          },
          "400": {
            "description": "BadRequest 非法请求 建议根据error_msg直接修改该请求。",
            "examples": {
              "application/json": {
                "error_code": "LTS.0205",
                "error_msg": "The log stream name has been existed"
              }
            },
            "schema": {
              "$ref": "#/definitions/LtsErrorResultInfo"
            }
          },
          "500": {
            "description": "表明服务端能被请求访问到,但是服务内部出错。",
            "examples": {
              "application/json": {
                "error_code": "LTS.0010",
                "error_msg": "The system encountered an internal error"
              }
            },
            "schema": {
              "$ref": "#/definitions/LtsErrorResultInfo"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "LtsErrorResultInfo": {
      "description": "调用失败时的返回值。",
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8,
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败响应信息描述。",
          "example": "Invalid projectId",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "CreateTransferResponseBody": {
      "properties": {
        "log_group_id": {
          "type": "string",
          "example": "9a7e2183-2d6d-4732-9a9b-e897fd4e49e0",
          "description": "日志组ID",
          "minLength": 36,
          "maxLength": 36
        },
        "log_group_name": {
          "type": "string",
          "example": "lts-group-kafka",
          "description": "日志组名称",
          "minLength": 1,
          "maxLength": 64
        },
        "log_streams": {
          "items": {
            "properties": {
              "log_stream_id": {
                "type": "string",
                "example": "839dac89-35af-4db2-ab4a-a7dda0d0d3f8",
                "description": "日志流ID",
                "minLength": 36,
                "maxLength": 36
              },
              "log_stream_name": {
                "type": "string",
                "example": "lts-topic-kafka",
                "description": "日志流名称",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "log_stream_id",
              "log_stream_name"
            ]
          },
          "description": "日志流ID集合",
          "type": "array",
          "minItems": 1,
          "maxItems": 1000
        },
        "log_transfer_id": {
          "type": "string",
          "example": "3f45b738-3594-4069-b69c-806775a5251f",
          "description": "日志转储ID",
          "minLength": 36,
          "maxLength": 36
        },
        "log_transfer_info": {
          "description": "日志转储信息",
          "properties": {
            "log_agency_transfer": {
              "description": "委托转储信息。若转储为委托转储,则会返回该参数",
              "properties": {
                "agency_domain_id": {
                  "type": "string",
                  "example": "1d26cc8c86a840e28a4f8d0d07852f1d",
                  "description": "委托方账号ID",
                  "minLength": 1,
                  "maxLength": 128
                },
                "agency_domain_name": {
                  "type": "string",
                  "example": "paas_apm_z00418070_01",
                  "description": "委托方账号名称",
                  "minLength": 1,
                  "maxLength": 128
                },
                "agency_name": {
                  "type": "string",
                  "example": "test20210325",
                  "description": "委托方配置的委托名称",
                  "minLength": 1,
                  "maxLength": 128
                },
                "agency_project_id": {
                  "type": "string",
                  "example": "2a473356cca5487f8373be891bffc1cf",
                  "description": "委托方项目ID",
                  "minLength": 32,
                  "maxLength": 32
                },
                "be_agency_domain_id": {
                  "type": "string",
                  "example": "1d26cc8c86a840e28a4f8d0d07852f1d",
                  "description": "被委托方账号ID,实际配置转储的账号ID",
                  "minLength": 1,
                  "maxLength": 128
                },
                "be_agency_project_id": {
                  "type": "string",
                  "example": "2a473356cca5487f8373be891bffc1cf",
                  "description": "被委托方项目ID,实际配置转储的账号的项目ID",
                  "minLength": 32,
                  "maxLength": 32
                }
              },
              "required": [
                "agency_domain_id",
                "agency_domain_name",
                "agency_name",
                "agency_project_id",
                "be_agency_domain_id",
                "be_agency_project_id"
              ]
            },
            "log_create_time": {
              "type": "integer",
              "format": "int64",
              "example": 1634801366301,
              "description": "日志转储创建时间",
              "minimum": 0,
              "maximum": 9999999999999
            },
            "log_storage_format": {
              "type": "string",
              "example": "JSON",
              "description": "日志转储格式。只支持\"RAW\", \"JSON\"。RAW是指原始日志格式,JSON是指JSON日志格式。OBS转储和DIS转储支持JSON和RAW,DMS转储仅支持RAW",
              "enum": [
                "JSON",
                "RAW"
              ]
            },
            "log_transfer_detail": {
              "description": "日志转储详细信息",
              "type": "object",
              "$ref": "#/definitions/TransferDetail"
            },
            "log_transfer_mode": {
              "type": "string",
              "example": "cycle",
              "description": "日志转储方式。cycle是指周期性转储,realTime是指实时转储。OBS转储只支持\"cycle\",DIS转储和DMS转储只支持\"realTime\"。",
              "enum": [
                "cycle",
                "realTime"
              ]
            },
            "log_transfer_status": {
              "type": "string",
              "example": "ENABLE",
              "description": "日志转储状态,ENABLE是指日志转储开启状态,DISABLE是指日志转储关闭状态,EXCEPTION是指日志转储异常状态",
              "enum": [
                "ENABLE",
                "DISABLE",
                "EXCEPTION"
              ]
            },
            "log_transfer_type": {
              "type": "string",
              "example": "OBS",
              "description": "日志转储类型。OBS指OBS日志转储,DIS指DIS日志转储,DMS指DMS日志转储",
              "enum": [
                "OBS",
                "DIS",
                "DMS"
              ]
            }
          },
          "required": [
            "log_create_time",
            "log_storage_format",
            "log_transfer_detail",
            "log_transfer_mode",
            "log_transfer_status",
            "log_transfer_type"
          ]
        }
      },
      "required": [
        "log_group_id",
        "log_group_name",
        "log_streams",
        "log_transfer_id",
        "log_transfer_info"
      ]
    },
    "QueryTransfersResponseBody": {
      "properties": {
        "log_transfers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CreateTransferResponseBody"
          },
          "description": "查询日志转储信息数组",
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "log_transfers"
      ]
    },
    "TransferDetail": {
      "required": [
        "obs_period",
        "obs_period_unit",
        "obs_bucket_name"
      ],
      "description": "日志转储详细信息",
      "properties": {
        "obs_period": {
          "type": "integer",
          "format": "int32",
          "example": 2,
          "description": "OBS转储时间",
          "enum": [
            1,
            2,
            3,
            5,
            6,
            12,
            30
          ]
        },
        "obs_encrypted_id": {
          "type": "string",
          "example": "1bd90032-1424-481f-8558-ba49854ad0cc",
          "description": "OBS转储KMS秘钥ID。若OBS转储未加密则不返回此字段",
          "minLength": 36,
          "maxLength": 36
        },
        "obs_prefix_name": {
          "type": "string",
          "example": "wjy",
          "description": "OBS转储日志文件前缀",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9\\._-]*$"
        },
        "obs_period_unit": {
          "type": "string",
          "example": "min",
          "description": "OBS转储单位"
        },
        "obs_transfer_path": {
          "type": "string",
          "example": "/0001/LogTanks/cn-north-7/test",
          "description": "OBS转储路径,指OBS日志桶中的路径",
          "minLength": 0,
          "maxLength": 256
        },
        "obs_bucket_name": {
          "type": "string",
          "example": "0001",
          "description": "OBS日志桶名称",
          "minLength": 3,
          "maxLength": 63
        },
        "obs_encrypted_enable": {
          "type": "boolean",
          "example": true,
          "description": "OBS是否开启加密。",
          "enum": [
            true,
            false
          ]
        },
        "obs_dir_pre_fix_name": {
          "type": "string",
          "example": "test",
          "description": "OBS转储自定义转储路径",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(/)?([a-zA-Z0-9\\._-]+)(/[a-zA-Z0-9\\._-]+)*(/)?$"
        },
        "dis_id": {
          "type": "string",
          "description": "DIS转储通道ID",
          "example": "i1y8vfMTvf4LQzxxxxx",
          "minLength": 1,
          "maxLength": 128
        },
        "dis_name": {
          "type": "string",
          "description": "DIS转储通道名称",
          "example": "xxxxx",
          "minLength": 1,
          "maxLength": 128
        },
        "kafka_id": {
          "type": "string",
          "description": "DMS转储kafka ID",
          "example": "346a58e6-4289-49e7-8f55-5833db7xxxxx",
          "minLength": 36,
          "maxLength": 36
        },
        "kafka_topic": {
          "type": "string",
          "description": "DMS转储kafka topic",
          "example": "xxxxx",
          "minLength": 1,
          "maxLength": 128
        },
        "obs_time_zone": {
          "type": "string",
          "description": "OBS转储时区。如果选择该参数,则必须选择obs_time_zone_id。"
        },
        "obs_time_zone_id": {
          "type": "string",
          "description": "OBS转储时区ID。参数选择参考OBS转储时区表。如果选择该参数,则必须选择obs_time_zone。"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "若开启tag投递,该字段必须包含主机信息:hostIP、hostId、hostName、pathFile、collectTime;\n\n公共字段有:logStreamName、regionName、logGroupName、projectId,为可选填;\n\n开启转储标签:streamTag,可选填"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "lts.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}