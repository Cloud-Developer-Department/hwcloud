  "definitions": {
    "ErrorUpResultInfo1": {
      "description": "调用失败时的返回值。",
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8,
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "example": "Invalid projectId",
          "description": "调用失败响应信息描述。"
        }
      }
    },
    "ListLogContextResponseBody": {
      "type": "object",
      "properties": {
        "logs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LogContents"
          },
          "description": "上下文日志信息。"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "返回的总日志条数,包含请求参数中所指定的起始日志。"
        },
        "backwards_count": {
          "type": "integer",
          "format": "int32",
          "description": "向前查询到的日志条数。",
          "minimum": 0,
          "maximum": 500
        },
        "forwards_count": {
          "type": "integer",
          "format": "int32",
          "description": "向后查询到的日志条数。",
          "minimum": 0,
          "maximum": 500
        },
        "isQueryComplete": {
          "type": "boolean",
          "description": "是否查询完成。"
        }
      }
    },
    "ListLogContextRequestBody": {
      "type": "object",
      "description": "查询上下文日志请求体。",
      "properties": {
        "line_num": {
          "type": "string",
          "description": "日志单行序列号,字段值需要从日志结果中获取,纳秒级时间戳。"
        },
        "__time__": {
          "type": "string",
          "description": "自定义时间特性时间字段,字段值需要从日志结果中获取,毫秒级时间戳。若已开启云端结构化自定义时间功能,需要使用该字段和line_num字段共同进行上下文查询。"
        },
        "backwards_size": {
          "type": "integer",
          "format": "int32",
          "description": "指定起始日志往前(上文)的日志条数,取值范围 [0, 500] ,默认值100",
          "minimum": 0,
          "maximum": 500
        },
        "forwards_size": {
          "type": "integer",
          "format": "int32",
          "description": "指定起始日志往后(下文)的日志条数,取值范围 [0, 500] ,默认值100",
          "minimum": 0,
          "maximum": 500
        },
        "scroll_id": {
          "type": "string",
          "description": "分页查询时,若上次查询的返回结果中包含该字段,需要增加该字段参与分页查询。"
        }
      }
    },
    "LogContents": {
      "description": "参数集",
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "日志原数据。",
          "example": "warn:2020/04/09 06:57:01 helloworld.go:108: the main process is running now."
        },
        "line_num": {
          "type": "string",
          "minLength": 19,
          "maxLength": 19,
          "description": "日志单行序列号。",
          "example": "15390682339830002"
        },
        "labels": {
          "description": "该条日志包含的 labels。",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
