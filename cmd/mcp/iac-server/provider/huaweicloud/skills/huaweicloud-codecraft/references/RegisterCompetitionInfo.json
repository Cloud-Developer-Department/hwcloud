            "in": "header",
            "description": "第三方token,需要平台配置账号权限",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvIIDgzCCXXXXXX...",
            "minLength": 1,
            "maxLength": 99999
          },
          {
            "in": "body",
            "name": "RegisterCompetitionInfoRequestBody",
            "description": "RegisterInfoRequestModel",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RegisterInfoRequestModel"
            }
          }
        ],
        "responses": {
