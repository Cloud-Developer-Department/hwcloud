            "description": "OK",
            "schema": {
              "$ref": "#/definitions/RegisterInfoResponseModel"
            },
            "examples": {
              "application/json": {
                "is_permitted": true,
                "team_id": "2288803"
              }
            }
          },
          "403": {
            "description": "用户无权操作",
