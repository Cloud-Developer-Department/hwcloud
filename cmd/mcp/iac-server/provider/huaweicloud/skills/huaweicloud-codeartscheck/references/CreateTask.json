          "type": "string",
          "description": "仓库有权限的用户名",
          "example": "test"
        },
        "access_token": {
          "type": "string",
          "description": "仓库有权限的用户token",
          "example": "testxxxxtest"
        },
        "endpoint_id": {
          "type": "string",
          "description": "仓库有权限的用户endpointId",
          "example": "cd9f6b87ffae43f08cc70a24c7fd7482"
        },
        "inc_config": {
          "$ref": "#/definitions/IncConfigV2"
        },
        "enable_fossbot": {
          "type": "boolean",
          "description": "是否打开fossbot检查,默认不开",
          "example": true
        },
        "resource_pool_id": {
          "type": "string",
          "description": "资源池id,可以从资源池管理页面获取",
          "example": "cd9f6b87ffae43f08cc70a24c7fd7482"
