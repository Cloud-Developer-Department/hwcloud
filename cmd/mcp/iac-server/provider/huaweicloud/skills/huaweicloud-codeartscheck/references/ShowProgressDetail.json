{
  "name": "ShowProgressDetail",
  "summary": "查询任务执行状态",
  "tags": "任务管理",
  "productshort": "CodeArtsCheck",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/tasks/{task_id}/progress": {
      "get": {
        "tags": [
          "任务管理"
        ],
        "summary": "查询任务执行状态",
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "description": "根据任务ID查询任务执行状态。任务状态:0表示检查中,1表示检查失败,2表示检查成功,3表示任务中止。只有正在检查中才有进度的详细信息。",
        "operationId": "ShowProgressDetail",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "minLength": 1,
            "maxLength": 100000
          },
          {
            "name": "task_id",
            "in": "path",
            "description": "任务ID",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          }
        ],
        "x-apigateway-backend": {
          "httpEndpoints": {
            "address": "10.63.38.190:40115",
            "description": "",
            "method": "GET",
            "path": "/codecheck/v2/tasks/{task_id}/progress",
            "scheme": "https",
            "timeout": 60000
          },
          "parameters": [
            {
              "description": "逻辑region",
              "in": "HEADER",
              "name": "X-AUTH-REGION",
              "origin": "CONSTANT",
              "value": "cn-north-7"
            },
            {
              "description": "任务ID",
              "in": "PATH",
              "name": "task_id",
              "origin": "REQUEST",
              "value": "task_id"
            }
          ],
          "type": "HTTP"
        },
        "x-apigateway-cors": false,
        "x-apigateway-match-mode": "NORMAL",
        "x-apigateway-request-type": "public",
        "responses": {
          "200": {
            "description": "Request succeeded!",
            "schema": {
              "$ref": "#/definitions/ProgressInfoV2"
            },
            "examples": {
              "application/json": {
                "task_status": 0,
                "progress": {
                  "ratio": "50%",
                  "info": "执行检查中"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "CC.00000000",
                "error_msg": "网络繁忙,请稍后再试"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "CC.00000003",
                "error_msg": "认证信息过期"
              }
            }
          }
        },
        "deprecated": false,
        "x-name": "查询任务详情",
        "x-version": "v2",
        "x-request-examples-description-1": "",
        "x-request-examples-1": "GET https://{endpoint}/v2/tasks/2b31ed520xxxxxxebedb6e57xxxxxxxx/progress"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "properties": {
        "error_code": {
          "type": "string",
          "example": "CC.00000000",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "网络繁忙,请稍后再试",
          "description": "错误描述"
        }
      }
    },
    "ProgressInfoV2": {
      "properties": {
        "task_status": {
          "type": "integer",
          "example": 0,
          "description": "任务状态,0表示检查中,1表示检查失败,2表示检查成功,3表示任务中止"
        },
        "progress": {
          "description": "检查进度",
          "$ref": "#/definitions/ProgressDetailV2"
        }
      }
    },
    "ProgressDetailV2": {
      "properties": {
        "ratio": {
          "type": "string",
          "description": "进度百分比"
        },
        "info": {
          "type": "string",
          "description": "中文信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "codearts-check.cn-south-1.myhuaweicloud.com",
  "base_path": "/",
