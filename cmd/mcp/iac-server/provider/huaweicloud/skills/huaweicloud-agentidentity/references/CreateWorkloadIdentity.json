{
  "name": "CreateWorkloadIdentity",
  "summary": "创建工作负载身份",
  "tags": "WorkloadIdentity",
  "productshort": "AgentIdentity",
  "region_id": "cn-southwest-2",
  "paths": {
    "/v1/workload-identities": {
      "post": {
        "tags": [
          "WorkloadIdentity"
        ],
        "operationId": "CreateWorkloadIdentity",
        "summary": "创建工作负载身份",
        "description": "Creates a new workload identity.",
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "security": [
          {
            "AccessKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkloadIdentityReqBody"
              },
              "examples": {
                "create-example": {
                  "summary": "Example request to create a workload identity",
                  "value": {
                    "name": "my_workload_identity",
                    "allowed_resource_oauth2_return_urls": [
                      "https://example.com/oauth2/callback"
                    ],
                    "authorizer_type": "CUSTOM_JWT",
                    "authorizer_configuration": {
                      "custom_jwt": {
                        "discovery_url": "https://example.com/.well-known/openid-configuration",
                        "allowed_audience": [
                          "example-audience"
                        ],
                        "allowed_clients": [
                          "example-client-id"
                        ],
                        "allowed_scopes": [
                          "read",
                          "write"
                        ],
                        "custom_claims": [
                          {
                            "inbound_token_claim_name": "tenant",
                            "inbound_token_claim_value_type": "STRING",
                            "authorizing_claim_match_value": {
                              "claim_match_operator": "EQUALS",
                              "claim_match_value": {
                                "match_value_string": "acme"
                              }
                            }
                          },
                          {
                            "inbound_token_claim_name": "roles",
                            "inbound_token_claim_value_type": "STRING_ARRAY",
                            "authorizing_claim_match_value": {
                              "claim_match_operator": "CONTAINS_ANY",
                              "claim_match_value": {
                                "match_value_string_list": [
                                  "admin",
                                  "editor"
                                ]
                              }
                            }
                          }
                        ]
                      }
                    },
                    "tags": [
                      {
                        "key": "key-1",
                        "value": "value-1"
                      }
                    ]
                  }
                },
                "create-keyauth-example": {
                  "summary": "Example request to create a workload identity with API Key authorizer",
                  "value": {
                    "name": "my_workload_identity",
                    "authorizer_type": "API_KEY",
                    "authorizer_configuration": {
                      "key_auth": {
                        "api_keys": [
                          {
                            "api_key": "22243eefff**",
                            "api_key_name": "test-key-1"
                          },
                          {
                            "api_key": "22243eefff**",
                            "api_key_name": "test-key-2"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Workload identity created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateWorkloadIdentityRespBody"
                },
                "examples": {
                  "create-response": {
                    "summary": "Example successful creation response",
                    "value": {
                      "workload_identity": {
                        "name": "my_workload_identity",
                        "urn": "agentIdentity:<region>:<account-id>:workloadIdentity:workloadIdentityDirectory/<workload-directory-id>/<workload-identity-name>",
                        "authorizer_type": "CUSTOM_JWT",
                        "allowed_resource_oauth2_return_urls": [
                          "https://example.com/oauth2/callback"
                        ],
                        "created_by": {
                          "type": "SERVICE",
                          "identifier": "service.AgentRuntime"
                        },
                        "created_at": "2025-01-01T00:00:00Z",
                        "updated_at": "2025-01-01T00:00:00Z",
                        "tags": [
                          {
                            "key": "key-1",
                            "value": "value-1"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResp"
                }
              }
            }
          },
          "409": {
            "description": "Request conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResp"
                }
              }
            }
          }
        }
      }
    }
  },
