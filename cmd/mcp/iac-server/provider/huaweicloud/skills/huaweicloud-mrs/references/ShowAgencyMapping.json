{
  "name": "ShowAgencyMapping",
  "summary": "查询用户(组)与IAM委托的映射关系",
  "tags": "委托管理",
  "productshort": "MRS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/clusters/{cluster_id}/agency-mapping": {
      "get": {
        "tags": [
          "委托管理"
        ],
        "operationId": "ShowAgencyMapping",
        "summary": "查询用户(组)与IAM委托的映射关系",
        "description": "获取用户(组)与IAM委托之间的映射关系的详细信息。",
        "x-is-registered": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号。获取方法,请参见[获取项目ID](https://support.huaweicloud.com/api-mrs/mrs_02_0011.html)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "cluster_id",
            "in": "path",
            "description": "集群ID。获取方法,请参见[获取集群ID](https://support.huaweicloud.com/api-mrs/mrs_02_9001.html)。",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询用户(组)与IAM委托的映射关系成功",
            "schema": {
              "$ref": "#/definitions/AgencyMappingArray"
            },
            "examples": {
              "application/json": {
                "agency_mappings": [
                  {
                    "agency": "agency01",
                    "identifier_type": "User",
                    "identifiers": [
                      "user01"
                    ],
                    "agency_id": "092adc623c00d2ea4fdac01d4b637f0b"
                  },
                  {
                    "agency": "agency02",
                    "identifier_type": "User",
                    "identifiers": [
                      "user02"
                    ],
                    "agency_id": "065239307e00d3ae4f80c01d4bdafdfd"
                  },
                  {
                    "agency": "groupAgency",
                    "identifier_type": "Group",
                    "identifiers": [
                      "group01",
                      "group02",
                      "group03"
                    ],
                    "agency_id": "08467a446200d5ac4ff9c01d56670c3b"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "查询用户(组)与IAM委托的映射关系失败",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-constraint": "无",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N"
      }
    }
  },
  "definitions": {
    "AgencyMappingArray": {
      "description": "用户(组)与IAM委托的映射关系数组结构体",
      "required": [
        "agency_mappings"
      ],
      "properties": {
        "agency_mappings": {
          "type": "array",
          "description": "用户(组)与委托之间的映射关系详细信息。",
          "items": {
            "$ref": "#/definitions/AgencyMapping"
          }
        }
      }
    },
    "AgencyMapping": {
      "description": "用户(组)与IAM委托的映射关系结构体",
      "required": [
        "agency",
        "identifier_type",
        "identifiers",
        "agency_id"
      ],
      "properties": {
        "agency": {
          "type": "string",
          "description": "该映射绑定的IAM委托名称。",
          "example": "agency01"
        },
        "identifier_type": {
          "type": "string",
          "description": "委托类型,分为“User”和“Group”两种。\n- User表示该映射关系为针对用户的映射,identifiers中填写用户名称列表。\n- Group表示该映射关系为针对用户组的映射,identifiers中填写用户组名称列表。",
          "example": "User"
        },
        "identifiers": {
          "type": "array",
          "description": "IAM委托映射的用户(组)名称列表。请前往IAM,单击“用户(组)”按钮,获取用户(组)名称列表。",
          "items": {
            "type": "string"
          },
          "example": [
            "user01",
            "user02"
          ]
        },
        "agency_id": {
          "type": "string",
          "description": "该映射关系绑定的委托的的唯一标识码。请前往IAM,单击“委托”按钮,进入委托页面,将鼠标放置委托名称上,在弹窗中获取委托唯一标识码。",
          "example": "092adc623c00d2ea4fdac01d4b637f0b"
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "mrs.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}