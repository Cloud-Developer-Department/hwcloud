              "description": "创建时间"
            },
            "last_update_time": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "description": "最后更新时间"
            },
            "create_by": {
              "type": "string",
              "minLength": 0,
              "maxLength": 64,
              "description": "创建时间"
            },
            "create_user": {
              "type": "string",
              "minLength": 0,
              "maxLength": 64,
              "description": "创建用户"
            },
            "tenant_id": {
              "type": "string",
              "minLength": 0,
              "maxLength": 64,
              "pattern": "^[a-z0-9A-Z_-]*$",
              "description": "租户ID"
            },
            "last_update_by": {
              "type": "string",
              "minLength": 0,
              "maxLength": 64,
              "description": "最后更新时间"
            },
            "status": {
              "type": "integer",
              "format": "int32",
              "description": "数据连接状态"
            },
            "used_clusters": {
              "type": "string",
