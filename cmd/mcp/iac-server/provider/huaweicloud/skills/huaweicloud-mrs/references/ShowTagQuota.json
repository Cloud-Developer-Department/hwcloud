{
  "name": "ShowTagQuota",
  "summary": "查询标签配额",
  "tags": "标签管理接口",
  "productshort": "MRS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/clusters/{cluster_id}/tags/quota": {
      "get": {
        "x-pdp5-enable": "N",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-is-registered": "Y",
        "x-apigateway-ratelimit": "tag_get",
        "tags": [
          "TagManagement"
        ],
        "summary": "查询标签配额",
        "description": "查询标签配额信息",
        "operationId": "ShowTagQuota",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID。",
            "pattern": "^[a-z0-9A-Z_-]*$",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "cluster_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "集群ID。",
            "maxLength": 64,
            "pattern": "^[a-z0-9A-Z_-]*$"
          },
          {
            "name": "auto_scaling_policy_tags",
            "in": "query",
            "required": false,
            "type": "boolean",
            "description": "是否查询弹性伸缩策略标签"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "schema": {
              "$ref": "#/definitions/TagQuotaResponseBody"
            },
            "examples": {
              "application/json": {
                "total_quota": 10,
                "available_quota": 2
              }
            }
          },
          "400": {
            "description": "请求失败",
            "examples": {
              "application/json": {
                "error": {
                  "error_code": "MRS.00000000",
                  "error_msg": "集群不存在"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "TagQuotaResponseBody": {
      "type": "object",
      "description": "标签配额信息",
      "required": [
        "total_quota",
        "available_quota"
      ],
      "properties": {
        "total_quota": {
          "type": "integer",
          "description": "总配额大小",
          "example": 10
        },
        "available_quota": {
          "type": "integer",
          "description": "可使用配额大小",
          "example": 2
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "mrs.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}