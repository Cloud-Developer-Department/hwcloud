{
  "name": "CreateAutoScalingPolicy",
  "summary": "创建弹性伸缩策略",
  "tags": "弹性伸缩接口",
  "productshort": "MRS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/autoscaling-policy/{cluster_id}": {
      "post": {
        "x-request-examples-url-1": "/v2/{project_id}/autoscaling-policy/{cluster_id}",
        "x-request-examples-description-1": "创建一个弹性伸缩策略, 在节点组node_group_1中配置节点组数量范围为0-5,并配置2个伸缩规则。  如果YARNAppRunning 大于等于 75 ,并持续 1 个五分钟,则添加1 个Task节点。如果 YARNAppRunning  小于等于25 ,并持续 1 个五分钟,则终止 1个Task节点。冷却时间皆为20分钟,并且设置了该策略下弹出的节点会打上aaa=bbb的标签。",
        "x-request-examples-text-1": {
          "node_group_name": "node_group_1",
          "auto_scaling_policy": {
            "auto_scaling_enable": true,
            "min_capacity": 0,
            "max_capacity": 5,
            "rules": [
              {
                "name": "default-expand-1",
                "adjustment_type": "scale_out",
                "cool_down_minutes": 20,
                "scaling_adjustment": 1,
                "trigger": {
                  "metric_name": "YARNAppRunning",
                  "metric_value": 75,
                  "comparison_operator": "GT",
                  "evaluation_periods": 1
                }
              },
              {
                "name": "default-shrink-1",
                "adjustment_type": "scale_in",
                "cool_down_minutes": 20,
                "scaling_adjustment": 1,
                "trigger": {
                  "metric_name": "YARNAppRunning",
                  "metric_value": 25,
                  "comparison_operator": "LT",
                  "evaluation_periods": 1
                }
              }
            ],
            "resources_plans": [
              {
                "period_type": "daily",
                "start_time": "06:00",
                "end_time": "20:00",
                "min_capacity": "0",
                "max_capacity": "2",
                "effective_days": [
                  "MONDAY"
                ]
              }
            ],
            "exec_scripts": [],
            "tags": [
              {
                "key": "aaa",
                "value": "bbb"
              }
            ]
          },
          "resource_pool_name": "default"
        },
        "x-request-examples-1": {
          "node_group_name": "node_group_1",
          "auto_scaling_policy": {
            "auto_scaling_enable": true,
            "min_capacity": 0,
            "max_capacity": 5,
            "rules": [
              {
                "name": "default-expand-1",
                "adjustment_type": "scale_out",
