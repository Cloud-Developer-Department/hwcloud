        },
        "max_capacity": {
          "type": "integer",
          "format": "int32",
          "description": "资源计划内该节点组的最大保留节点数。\n取值范围:[0~500]",
          "minimum": 0,
          "maximum": 500
        },
        "effective_days": {
          "type": "array",
          "description": "资源计划的生效日期,为空时代表每日,另外也可为以下返回值:\n\nMONDAY(周一)、TUESDAY(周二)、WEDNESDAY(周三)、THURSDAY(周四)、FRIDAY(周五)、SATURDAY(周六)、SUNDAY(周日)",
          "items": {
            "type": "string",
            "description": "枚举值:\n- MONDAY: 星期一\n- TUESDAY: 星期二\n- WEDNESDAY: 星期三\n- THURSDAY: 星期四\n- FRIDAY: 星期五\n- SATURDAY: 星期六\n- SUNDAY: 星期日",
            "enum": [
              "MONDAY",
              "TUESDAY",
              "WEDNESDAY",
              "THURSDAY",
              "FRIDAY",
              "SATURDAY",
              "SUNDAY"
            ]
          }
        }
      }
