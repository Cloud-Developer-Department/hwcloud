            "name": "cluster_id",
            "in": "path",
            "description": "集群ID。获取方法,请参见[获取集群ID](https://support.huaweicloud.com/api-mrs/mrs_02_9001.html)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "AddComponentRequestBody",
            "in": "body",
            "required": true,
            "description": "添加组件请求",
