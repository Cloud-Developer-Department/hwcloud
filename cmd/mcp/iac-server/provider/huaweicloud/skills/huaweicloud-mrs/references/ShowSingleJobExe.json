  "definitions": {
    "JobQueryBean": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "作业ID。"
        },
        "user": {
          "type": "string",
          "description": "提交作业的用户名称。"
        },
        "job_name": {
          "type": "string",
          "description": "作业名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "job_result": {
          "type": "string",
          "description": "作业最终结果。\n- FAILED:执行失败的作业\n- KILLED:执行中被手动终止的作业。\n- UNDEFINED:正在执行的作业。\n- SUCCEEDED:执行成功的作业。"
        },
        "job_state": {
          "type": "string",
          "description": "作业执行状态。\n\n- FAILED:失败\n- KILLED:已终止\n- NEW:已创建\n- NEW_SAVING:已创建保存中\n- SUBMITTED:已提交\n- ACCEPTED:已接受\n- RUNNING:运行中\n- FINISHED:已完成"
        },
        "job_progress": {
          "type": "number",
          "format": "float",
          "description": "作业执行进度。"
        },
        "job_type": {
          "type": "string",
          "description": "作业类型。\n- MapReduce\n- SparkSubmit:SparkPython类型的作业在查询时作业类型请选择SparkSubmit。\n- HiveScript\n- HiveSql\n- DistCp,导入、导出数据。\n- SparkScript\n- SparkSql\n- Flink"
        },
        "started_time": {
          "type": "integer",
          "format": "int64",
          "description": "作业开始执行时间。单位:毫秒。"
        },
        "submitted_time": {
          "type": "integer",
          "format": "int64",
          "description": "作业提交时间。单位:毫秒。"
        },
        "finished_time": {
          "type": "integer",
          "format": "int64",
          "description": "作业完成时间。单位:毫秒。"
        },
        "elapsed_time": {
          "type": "integer",
          "format": "int64",
          "description": "作业执行时长。单位:毫秒。"
        },
        "arguments": {
          "type": "string",
          "description": "运行参数。",
          "minLength": 0,
          "maxLength": 150000
        },
        "launcher_id": {
          "type": "string",
          "description": "实际作业编号。"
        },
        "properties": {
          "type": "string",
          "description": "配置参数,用于传-d参数。最多为2048字符,不能包含><|'`&!\\特殊字符,可为空。",
          "minLength": 0,
          "maxLength": 2048
        },
        "app_id": {
          "type": "string",
          "description": "实际作业编号。"
        },
        "tracking_url": {
          "type": "string",
          "description": "日志链接地址。当前仅SparkSubmit作业支持该参数。 该参数基于集群的EIP访问集群中的YARN WebUI页面,用户如果在VPC界面解绑EIP,MRS服务侧数据会因为未更新导致该参数引用旧EIP导致访问失败,可通过对集群重新进行EIP的绑定来修复该问题。"
        },
        "queue": {
          "type": "string",
          "description": "作业的资源对列类型。"
        }
      }
    },
    "SingleJob": {
      "type": "object",
      "properties": {
