        "x-request-examples-text-1": {
          "data_connector": {
            "connector_name": "mrs-mysql-connector",
            "source_type": "RDS_MYSQL",
            "source_info": "{\"db_name\":\"default\",\"user_name\":\"mrs\",\"password\":\"*****\",\"rds_instance_id\":\"3aa55f1cb4c3491686936130f21e9f16in01\"}"
          }
        },
        "x-request-examples-1": {
          "data_connector": {
            "connector_name": "mrs-mysql-connector",
            "source_type": "RDS_MYSQL",
            "source_info": "{\"db_name\":\"default\",\"user_name\":\"mrs\",\"password\":\"*****\",\"rds_instance_id\":\"3aa55f1cb4c3491686936130f21e9f16in01\"}"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-imports": [
          "org.springframework.web.bind.annotation.ResponseStatus",
          "org.springframework.http.HttpStatus"
        ],
        "x-method-annotations": [
          "@ResponseStatus(value = HttpStatus.CREATED)"
        ],
        "responses": {
          "201": {
            "description": "数据连接创建成功",
            "schema": {
              "$ref": "#/definitions/CreateDataConnectorResp"
            },
            "examples": {
              "application/json": "{\n    \"connector_id\":\"0822239c1e80d4502f82c008937da9b5\"\n}"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CreateDataConnectorResp": {
      "type": "object",
      "required": [
        "connector_id"
      ],
      "properties": {
        "connector_id": {
          "type": "string",
          "description": "数据连接创建成功后系统返回的数据连接ID值。"
        }
      }
    },
    "DataConnector": {
      "type": "object",
      "properties": {
        "connector_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "pattern": "^[a-z0-9A-Z_-]*$",
          "description": "数据连接名称。"
        },
        "source_type": {
          "type": "string",
          "description": "数据连接类型。\n- RDS_POSTGRES:RDS服务PostgreSQL数据库\n- RDS_MYSQL:RDS服务MySQL数据库\n- gaussdb-mysql:云数据库GaussDB(for MySQL)",
          "example": "RDS_MYSQL",
          "enum": [
            "RDS_MYSQL",
            "RDS_POSTGRES",
            "gaussdb-mysql"
          ],
          "x-annotations": "@EnumMatch(fieldName = \"source_type\", target = ExternalDataSourceType.class)"
        },
        "source_info": {
          "type": "string",
          "description": "数据源信息,为json格式,不同数据连接有不同的信息,各数据源的source_info请求内容可参见示例。",
          "example": "{\"db_name\":\"default\",\"user_name\":\"mrs\",\"password\":\"******\",\"rds_instance_id\":\"3aa55f1cb4c3491686936130f21e9f16in01\"}"
        }
      },
      "x-imports": [
        "com.huawei.mrs.manager.annotation.EnumMatch",
        "com.huawei.mrs.manager.model.externaldatasource.ExternalDataSourceType"
      ],
      "required": [
        "connector_name",
        "source_type",
        "source_info"
      ]
    },
    "DataConnectorReq": {
      "type": "object",
      "required": [
        "data_connector"
      ],
      "properties": {
        "data_connector": {
          "description": "数据连接",
          "$ref": "#/definitions/DataConnector"
        }
      },
      "description": "创建数据连接请求"
    }
  },
