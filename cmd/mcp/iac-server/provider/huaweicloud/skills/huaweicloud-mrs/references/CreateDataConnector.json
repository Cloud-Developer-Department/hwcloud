        ],
        "summary": "创建数据连接",
        "description": "创建数据连接",
        "operationId": "CreateDataConnector",
        "x-pdp5-enable": "N",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目id",
            "pattern": "^[a-z0-9A-Z_-]*$"
          },
          {
            "in": "body",
