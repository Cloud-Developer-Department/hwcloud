      "put": {
        "tags": [
          "集群管理接口"
        ],
        "summary": "调整集群节点",
        "description": "创建集群后,扩容/缩容集群Core节点或者Task节点。MRS集群创建成功后不支持调整Master节点数量,即不支持扩缩容Master节点。该接口不兼容Sahara。\n处于running状态的集群才允许扩容/缩容,其他状态则不允许扩容/缩容。 集群状态和集群ID可参考[查询集群列表](https://support.huaweicloud.com/api-mrs/ListClusters.html)接口获取。 本章节的接口只支持流式集群、分析集群和混合集群,不支持自定义集群。",
        "operationId": "UpdateClusterScaling",
        "x-is-registered": "Y",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号。获取方法,请参见[获取项目ID](https://support.huaweicloud.com/api-mrs/mrs_02_0011.html)。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "cluster_id",
            "in": "path",
            "description": "集群ID。获取方法,请参见[获取集群ID](https://support.huaweicloud.com/api-mrs/mrs_02_9001.html)。",
            "required": true,
            "type": "string",
            "x-example": "431b135exxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "clusterScalingReq",
            "in": "body",
            "description": "调整集群节点请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ClusterScalingReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "扩容/缩容集群Core节点或者Task节点成功。",
            "examples": {
              "application/json": {
                "result": "succeeded"
              }
            },
            "schema": {
              "$ref": "#/definitions/ApiCommonResponse"
            }
          }
        },
