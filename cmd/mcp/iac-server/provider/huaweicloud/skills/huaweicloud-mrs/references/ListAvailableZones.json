          "example": "Dedicated"
        },
        "az_tags": {
          "description": "可用区标签",
          "$ref": "#/definitions/AvailableTag"
        },
        "az_category": {
          "type": "integer",
          "format": "int32",
          "description": "当前可用区的类型,包括:\n- 0: 大云主可用区\n- 21: 本地可用区\n- 41: 边缘可用区",
          "example": 0
        },
        "charge_policy": {
          "type": "string",
          "description": "当前可用区的销售策略,包括:\n- charge: 计费\n- notCharge: 非计费",
          "enum": [
            "charge",
            "notCharge"
          ]
        }
      }
    },
