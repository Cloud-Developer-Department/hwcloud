        "support_physical_az_group": {
          "type": "boolean",
          "description": "支持的物理可用区分组",
          "example": false,
          "x-annotations": "@JsonAlias(\"supportPhysicalAzGroup\")"
        }
      }
    },
    "AvailableTag": {
      "type": "object",
      "description": "可用区标签",
      "properties": {
