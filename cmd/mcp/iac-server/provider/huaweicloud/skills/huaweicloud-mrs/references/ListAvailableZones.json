  "definitions": {
    "AvailableZoneV2": {
      "type": "object",
      "description": "可用区信息",
      "x-class-annotation": [
        "@JsonInclude(JsonInclude.Include.NON_NULL)"
      ],
      "x-imports": [
        "com.fasterxml.jackson.annotation.JsonInclude"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "可用区编码",
          "example": "cn-north-4a"
        },
        "az_code": {
          "type": "string",
          "description": "可用区编码",
          "example": "cn-north-4a"
        },
        "az_name": {
          "type": "string",
          "description": "可用区名称",
          "example": "可用区1"
        },
        "az_id": {
          "type": "string",
          "description": "可用区id",
          "example": "effdcbc7d4d64a02aa1fa26b42f56533"
        },
