{
  "name": "ShowTagStatus",
  "summary": "查询默认标签状态",
  "tags": "标签管理接口",
  "productshort": "MRS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/clusters/{cluster_id}/tags/status": {
      "get": {
        "x-pdp5-enable": "N",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-is-registered": "Y",
        "x-apigateway-ratelimit": "tag_get",
        "tags": [
          "TagManagement"
        ],
        "summary": "查询默认标签状态",
        "description": "查询集群默认标签状态",
        "operationId": "ShowTagStatus",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID。",
            "pattern": "^[a-z0-9A-Z_-]*$",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "cluster_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "集群ID。",
            "maxLength": 64,
            "pattern": "^[a-z0-9A-Z_-]*$"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "schema": {
              "$ref": "#/definitions/TagsStatusResponseBody"
            },
            "examples": {
              "application/json": {
                "status": "succeed",
                "default_tags_enable": "true"
              }
            }
          },
          "400": {
            "description": "请求失败",
            "examples": {
              "application/json": {
                "error_code": "MRS.00000000",
                "error_msg": "请求标签操作错误"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "TagsStatusResponseBody": {
      "type": "object",
      "description": "默认标签状态信息",
      "required": [
        "status",
        "default_tags_enable"
      ],
      "properties": {
        "status": {
          "type": "string",
          "description": "标签处理状态",
          "enum": [
            "processing",
            "succeed",
            "failed"
          ],
          "example": true
        },
        "default_tags_enable": {
          "type": "boolean",
          "description": "默认标签是否已开启",
          "example": true
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "mrs.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
