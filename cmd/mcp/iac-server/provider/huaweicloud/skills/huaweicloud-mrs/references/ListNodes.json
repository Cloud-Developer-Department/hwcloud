  "definitions": {
    "Tag": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "键。\n- 最大长度36个unicode字符,不能为空字符串。\n- 标签的key值不能包含非打印字符ASCII(0-31),“=”,“*”,“<”,“>”,“\\”,“,”,“|”,“/”,且首尾字符不能为空格。\n- 同一资源的key值不能重复。",
          "minLength": 1,
          "maxLength": 36
        },
        "value": {
          "type": "string",
          "description": "值。\n- 最大长度43个unicode字符,可以为空字符串。\n- 标签的value值不能包含非打印字符ASCII(0-31),“=”,“*”,“<”,“>”,“\\”,“,”,“|”,“/”,且首尾字符不能为空格。",
          "minLength": 0,
          "maxLength": 43
        }
      }
    },
    "NodeDetail": {
      "type": "object",
      "x-annotations": "@JsonInclude(JsonInclude.Include.NON_NULL)",
      "x-imports": [
        "com.fasterxml.jackson.annotation.JsonInclude"
      ],
      "description": "节点监控详情。",
      "properties": {
        "running_status": {
          "type": "string",
          "description": "运行状态。",
          "example": "GOOD",
          "minLength": 1
        },
        "cpu_usage": {
          "type": "string",
          "description": "CPU使用率。",
          "example": "20%",
          "minLength": 1
        },
        "memory_usage": {
          "type": "string",
          "description": "内存使用率。",
          "example": "30.1%",
          "minLength": 1
        },
        "disk_usage": {
          "type": "string",
          "description": "硬盘使用率。",
          "example": "7%",
          "minLength": 1
        },
        "total_memory": {
          "type": "string",
          "description": "总内存。单位MB。",
          "example": 31591
        },
        "available_memory": {
          "type": "string",
          "description": "可用内存。单位MB。",
          "example": 22580
        },
        "total_hard_disk_space": {
          "type": "string",
          "description": "总硬盘空间。单位GB。",
          "example": 1000
        },
        "available_hard_disk_space": {
          "type": "string",
          "description": "可用硬盘空间。单位GB。",
          "example": 800,
          "minLength": 1
        },
        "network_read": {
          "type": "string",
          "description": "网络读取速度。单位Byte/s。",
          "example": 18
        },
        "network_write": {
          "type": "string",
          "description": "网络写入速度。单位Byte/s。",
          "example": 15
        }
      }
    },
    "CceInfo": {
      "type": "object",
      "x-annotations": "@JsonInclude(JsonInclude.Include.NON_NULL)",
      "x-imports": [
        "com.fasterxml.jackson.annotation.JsonInclude"
      ],
      "description": "容器信息。",
      "properties": {
        "pod_name": {
          "type": "string",
          "description": "pod名称。"
        },
        "pod_ip": {
          "type": "string",
          "description": "pod的IP。"
        },
        "pod_id": {
          "type": "string",
          "description": "pod的ID。"
        },
        "cce_cluster_id": {
          "type": "string",
          "description": "容器集群ID。对应CCE集群ID。"
        },
        "cce_namespace": {
          "type": "string",
          "description": "容器集群命名空间。"
        },
        "cce_node_ip": {
          "type": "string",
          "description": "cce节点IP。"
        }
      }
    },
    "ListNodesResp": {
      "type": "object",
      "required": [
        "nodes",
        "node_total"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClusterNode"
          },
          "description": "节点列表。"
        },
        "node_total": {
          "type": "integer",
          "format": "int32",
          "description": "节点数。",
          "example": 3,
          "minimum": 0
        }
      }
    },
    "ComponentInfo": {
      "type": "object",
