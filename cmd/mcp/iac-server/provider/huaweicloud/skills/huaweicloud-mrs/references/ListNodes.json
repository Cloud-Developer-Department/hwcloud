        "server_name": {
          "type": "string",
          "description": "服务器名称。",
          "example": "4424ea14-0936-4934-ab02-1df8ea5c6145_node_master3fUnh",
          "minLength": 1
        },
        "server_type": {
          "type": "string",
          "description": "ECS或者BMS。",
          "example": "ecs",
          "minLength": 3
        },
        "data_volumes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VolumeInfo"
          },
          "description": "数据盘。"
        },
        "root_volume": {
          "description": "系统盘。",
          "$ref": "#/definitions/VolumeInfo"
        },
        "cpu_type": {
          "description": "CPU类型。x86或者ARM。",
          "type": "string",
          "example": "x86",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "description": "CPU大小。",
          "example": 4,
          "minLength": 1
        },
        "mem": {
          "type": "string",
          "description": "内存大小。",
          "example": 4096
        },
        "internal_ip": {
          "type": "string",
          "description": "内部IP。",
          "example": "127.0.0.1",
          "minLength": 7,
          "maxLength": 15
