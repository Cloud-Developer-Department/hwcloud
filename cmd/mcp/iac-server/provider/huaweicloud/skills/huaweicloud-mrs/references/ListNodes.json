        "summary": "查询集群节点列表",
        "description": "查询集群节点列表。",
        "operationId": "ListNodes",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID。",
            "pattern": "^[a-zA-Z0-9_\\-]{1,64}$",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "cluster_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "集群ID。",
            "pattern": "^[a-zA-Z0-9_\\-]{1,64}$",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "node_group",
            "in": "query",
            "required": false,
            "description": "要查询的节点组名称。",
            "type": "string",
            "minLength": 1,
            "allowEmptyValue": true
