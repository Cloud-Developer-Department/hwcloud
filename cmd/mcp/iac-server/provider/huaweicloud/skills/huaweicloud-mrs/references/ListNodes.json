          "minLength": 3
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "磁盘大小。单位为GB。",
          "minimum": 10,
          "maximum": 32768
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "磁盘数量。",
          "example": 1,
          "minimum": 0
        }
      }
