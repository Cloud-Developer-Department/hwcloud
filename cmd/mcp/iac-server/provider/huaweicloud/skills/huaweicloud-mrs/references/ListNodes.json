            "required": false,
            "type": "integer",
            "format": "int32",
            "description": "返回结果中每页显示条数。缺省值:10。",
            "minimum": 1,
            "default": 10,
            "allowEmptyValue": true
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "description": "表示作业列表从该偏移量开始查询。缺省值:1。",
            "minimum": 1,
            "default": 1,
            "allowEmptyValue": true
          },
          {
            "name": "node_name",
            "in": "query",
            "required": false,
            "description": "指定节点名称,支持模糊搜索。",
            "type": "string",
            "allowEmptyValue": true
          },
          {
            "name": "sort_key",
            "in": "query",
            "required": false,
            "description": "排序键,支持对节点名称排序。",
            "type": "string",
            "allowEmptyValue": true,
            "enum": [
              "node_name"
            ]
          },
          {
            "name": "sort_dir",
            "in": "query",
            "required": false,
            "description": "列表排序方式,desc为降序,asc为升序。",
            "type": "string",
            "allowEmptyValue": true,
            "enum": [
              "desc",
              "asc"
            ]
          },
          {
            "name": "query_node_detail",
            "in": "query",
            "required": false,
            "description": "是否查询节点详情。该字段设为true时可能会影响接口性能。",
            "type": "boolean",
            "default": false,
            "allowEmptyValue": true
          },
          {
            "name": "query_ecs_detail",
            "in": "query",
            "required": false,
            "description": "是否查询ECS详情信息,会涉及对ECS接口调用。",
            "type": "boolean",
            "default": false,
            "allowEmptyValue": true
          },
          {
            "name": "internal_ip",
