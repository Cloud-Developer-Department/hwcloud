    "ClusterNode": {
      "type": "object",
      "x-annotations": "@JsonInclude(JsonInclude.Include.NON_NULL)",
      "x-imports": [
        "com.fasterxml.jackson.annotation.JsonInclude"
      ],
      "properties": {
        "node_name": {
          "type": "string",
          "description": "节点名称,对应manager里的节点名称。",
          "example": "p4-node-master3lh",
          "minLength": 1
        },
        "resource_id": {
          "type": "string",
          "description": "资源id。确定节点的唯一性,包周期节点可用于计费的查询。",
          "example": "xxxxxxxxxxxxxx",
          "minLength": 1
        },
        "node_group_name": {
          "type": "string",
          "description": "节点组名称。",
          "example": "node_group_1",
          "minLength": 1
        },
        "node_type": {
          "type": "string",
          "description": "节点类型。Task、Core、Master等。",
          "example": "Core",
          "minLength": 1
        },
        "billing_type": {
          "type": "string",
          "description": "on-period包周期或者on-quantity按需。",
          "example": "on-period"
        },
        "deployment_type": {
          "type": "string",
          "description": "部署类型。支持Server主机类型。",
          "example": "server",
          "minLength": 3
        },
        "server_info": {
          "description": "如果部署类型为Server类型,则该字段不为空。",
          "$ref": "#/definitions/ServerInfo"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Tag"
          },
          "description": "节点标签"
        },
        "node_detail": {
          "description": "节点监控信息。需要IAM同步后才能返回。",
          "$ref": "#/definitions/NodeDetail"
        },
        "node_status": {
          "type": "string",
          "description": "节点状态。对应页面上的操作状态。"
        },
        "component_infos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ComponentInfo"
          },
          "description": "组件实例信息数组。"
        }
      },
      "required": [
        "deployment_type"
      ]
    },
    "VolumeInfo": {
      "type": "object",
      "description": "磁盘信息。",
      "required": [
        "type",
        "size",
        "count"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "磁盘类型。\n- SATA:普通IO磁盘类型。\n- SAS:高IO磁盘类型。\n- SSD:超高IO磁盘类型。\n- GPSSD:通用型SSD磁盘类型",
