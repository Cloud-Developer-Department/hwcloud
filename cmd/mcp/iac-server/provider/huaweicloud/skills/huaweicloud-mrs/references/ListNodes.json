        "role_name": {
          "type": "string",
          "description": "角色。",
          "example": "DataNode",
          "minLength": 1
        },
        "role_short_name": {
          "type": "string",
          "description": "角色缩写。",
          "example": "DN",
          "minLength": 1
        },
        "role_type": {
          "type": "string",
          "description": "角色类型。",
          "example": "DN",
          "minLength": 1
        },
        "service_name": {
          "type": "string",
          "description": "服务名。",
          "example": "HDFS",
          "minLength": 1
        },
        "pair_name": {
          "type": "string",
          "description": "对名。"
        },
        "relation_pairs": {
          "type": "string",
          "description": "关联对。"
        },
        "support_decom": {
          "type": "string",
