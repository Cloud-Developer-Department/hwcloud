{
  "name": "ShowHdfsFileList",
  "summary": "获取指定目录文件列表",
  "tags": "集群HDFS文件接口",
  "productshort": "MRS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/clusters/{cluster_id}/files": {
      "get": {
        "tags": [
          "集群HDFS文件接口"
        ],
        "summary": "获取指定目录文件列表",
        "description": "在MRS集群中获取指定目录文件列表。",
        "operationId": "ShowHdfsFileList",
        "x-publishpath": "mrs_02_0096",
        "x-is-registered": "Y",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号。获取方法,请参见[获取项目ID](https://support.huaweicloud.com/api-mrs/mrs_02_0011.html)。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "cluster_id",
            "in": "path",
            "description": "集群ID。获取方法,请参见[获取集群ID](https://support.huaweicloud.com/api-mrs/mrs_02_9001.html)。",
            "required": true,
            "type": "string",
            "x-example": "431b135exxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "path",
            "in": "query",
            "description": "文件目录。\n比如访问“/tmp/test”目录列表,此处必须是目录,整体URI为/v2/{project_id}/clusters/{cluster_id}/files?path=%2Ftmp%2Ftest\n单层目录要遵循以下规则:\n- 不能为空\n- 不能以\".\"开头或结尾\n- 不能包括下列符号 : :*?\"<>|\\;&,'`!{}[]$%+\n- 不能超过255个字节",
            "required": true,
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页参数,表示从该偏移量开始查询文件列表,默认值为1。",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "分页参数,列表当前分页的数量限制,默认为100,最大1000。",
            "required": false,
            "type": "string"
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "列表排序按该属性排序。缺省值:path_suffix\n- path_suffix:文件或目录名称\n- length:文件大小\n- modification_time:修改时间",
            "required": false,
            "type": "string",
            "default": "path_suffix",
            "enum": [
              "path_suffix",
              "length",
              "modification_time"
            ]
          },
          {
            "name": "order",
            "in": "query",
            "description": "列表排序方式,desc为降序,asc为升序,默认值为asc。",
            "required": false,
            "type": "string",
            "enum": [
              "desc",
              "asc"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "获取指定目录文件列表成功",
            "examples": {
              "application/json": {
                "total_count": 2,
                "files": [
                  {
                    "access_time": 0,
                    "block_size": 0,
                    "children_num": 0,
                    "group": "hadoop",
                    "length": 0,
                    "modification_time": 1587179516623,
                    "owner": "hdfs",
                    "path_suffix": "app-logs",
                    "permission": 777,
                    "replication": 0,
                    "type": "DIRECTORY"
                  },
                  {
                    "access_time": 1587267212761,
                    "block_size": 134217728,
                    "children_num": 0,
                    "group": "hadoop",
                    "length": 23666188,
                    "modification_time": 1587222156003,
                    "owner": "root",
                    "path_suffix": "data-m-00000",
                    "permission": "644",
                    "replication": 3,
                    "type": "FILE"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListFilesRespV2"
            }
          }
        },
        "deprecated": false,
        "x-name": "获取指定目录文件列表",
        "x-constraint": "无",
        "x-version": "v2",
        "x-scope": "Commercial",
        "x-request-examples-description-1": "获取指定目录文件列表请求示例",
        "x-request-examples-url-1": "GET /v2/{project_id}/clusters/{cluster_id}/files?path={directory}&offset={offset}&limit={limit}&sort_key={sort_key}&order={order}",
        "x-hk": "Y",
        "x-is-calling": "Y",
        "x-ctc": "N",
        "x-apigateway-auth-type": "IAM",
        "x-call-frequency": "high",
        "x-apigateway-match-mode": "NORMAL",
        "x-otc": "N",
        "x-hybridcloud": true,
        "x-apigateway-request-type": "public",
        "x-tlf": "N",
        "x-obc": "N",
        "x-hc": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N"
      }
    }
  },
  "definitions": {
    "ListFilesRespV2": {
      "type": "object",
      "required": [
        "total_count",
        "files"
      ],
      "properties": {
        "total_count": {
          "type": "integer",
          "format": "int64",
          "description": "文件总数,与分页无关。"
        },
        "files": {
          "type": "array",
          "description": "文件列表。",
          "items": {
            "$ref": "#/definitions/FileStatusV2"
          }
        }
      }
    },
    "FileStatusV2": {
      "type": "object",
      "properties": {
        "path_suffix": {
          "type": "string",
          "description": "文件在当前目录下的后缀,如获取“/tmp”目录,下面的“/tmp/test”文件,此处path_suffix内容为“test”。"
        },
        "owner": {
          "type": "string",
          "description": "文件拥有者。"
        },
        "group": {
          "type": "string",
          "description": "文件属组。"
        },
        "permission": {
          "type": "string",
          "description": "权限信息。"
        },
        "replication": {
          "type": "integer",
          "format": "int32",
          "description": "副本数。"
        },
        "block_size": {
          "type": "integer",
          "format": "int32",
          "description": "块大小。"
        },
        "length": {
          "type": "integer",
          "format": "int32",
          "description": "文件长度。"
        },
        "type": {
          "type": "string",
          "description": "文件类型:\n- FILE:文件\n- DIRECTORY:目录"
        },
        "children_num": {
          "type": "integer",
          "format": "int32",
          "description": "该目录下的文件条目数。"
        },
        "access_time": {
          "type": "integer",
          "format": "int64",
          "description": "文件访问时间。"
        },
        "modification_time": {
          "type": "integer",
          "format": "int64",
          "description": "文件修改时间。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "mrs.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}