        },
        "submitted_time": {
          "type": "integer",
          "format": "int64",
          "description": "作业提交时间。单位:毫秒。"
        },
        "finished_time": {
          "type": "integer",
          "format": "int64",
          "description": "作业完成时间。单位:毫秒。"
        },
        "elapsed_time": {
          "type": "integer",
          "format": "int64",
          "description": "作业执行时长。单位:毫秒。"
        },
        "arguments": {
          "type": "string",
          "description": "运行参数。",
          "minLength": 0,
          "maxLength": 150000
        },
        "launcher_id": {
          "type": "string",
          "description": "实际作业编号。"
        },
        "properties": {
          "type": "string",
          "description": "配置参数,用于传-d参数。最多为2048字符,不能包含><|'`&!\\特殊字符,可为空。",
          "minLength": 0,
          "maxLength": 2048
        },
        "app_id": {
          "type": "string",
          "description": "实际作业编号。"
        },
        "tracking_url": {
          "type": "string",
