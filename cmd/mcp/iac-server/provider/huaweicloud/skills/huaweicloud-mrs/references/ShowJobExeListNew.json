            "required": false,
            "type": "string"
          },
          {
            "name": "job_id",
            "in": "query",
            "description": "作业ID,只能由字母、数字、中划线(-)组成,并且长度为1~64字符。",
            "required": false,
            "type": "string"
          },
          {
            "name": "user",
            "in": "query",
            "description": "用户名称、只能由字母、数字、特殊字符(-_.)组成,且不能以数字开头,并且长度为1~32字符。",
            "required": false,
            "type": "string"
          },
          {
            "name": "job_type",
            "in": "query",
            "description": "作业类型。\n- MapReduce\n- SparkPython\n- SparkSubmit:SparkPython类型的作业在查询时作业类型请选择SparkSubmit。\n- HiveScript\n- HiveSql\n- DistCp,导入、导出数据。\n- SparkScript\n- SparkSql\n- Flink",
            "required": false,
            "type": "string"
          },
          {
            "name": "job_state",
            "in": "query",
            "description": "作业运行状态。\n- FAILED:失败\n- KILLED:已终止\n- NEW:已创建\n- NEW_SAVING:已创建保存中\n- SUBMITTED:已提交\n- ACCEPTED:已接受\n- RUNNING:运行中\n- FINISHED:已完成",
            "required": false,
            "type": "string",
            "enum": [
              "FAILED",
              "KILLED",
              "NEW",
              "NEW_SAVING",
              "SUBMITTED",
              "ACCEPTED",
              "RUNNING",
              "FINISHED"
            ]
          },
          {
            "name": "job_result",
            "in": "query",
            "description": "作业运行结果。\n- FAILED:执行失败的作业。\n- KILLED:执行中被手动终止的作业。\n- UNDEFINED:正在执行的作业。\n- SUCCEEDED:执行成功的作业。",
            "required": false,
            "type": "string",
            "enum": [
              "FAILED",
              "KILLED",
              "UNDEFINED",
              "SUCCEEDED"
            ]
          },
          {
            "name": "queue",
            "in": "query",
            "description": "作业的资源对列类型名称,作业的资源对列类型名称,只能由数字、字母和特殊字符(-_)组成, 并且长度为1~64字符。",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "返回结果中每页显示条数。缺省值:10",
            "required": false,
            "type": "string",
            "default": 10
          },
          {
            "name": "offset",
            "in": "query",
            "description": "表示作业列表从该偏移量开始查询。缺省值:1",
            "required": false,
            "type": "string",
            "default": 1
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "返回结果的排序方式,默认值为desc。\n- asc:按升序排列\n- desc:按降序排列",
            "required": false,
            "type": "string"
          },
          {
            "name": "submitted_time_begin",
            "in": "query",
            "description": "查询该时间之后提交的作业,UTC的毫秒时间戳。例如:1562032041362。",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "submitted_time_end",
            "in": "query",
            "description": "查询该时间之前提交的作业UTC的毫秒时间戳。例如:1562032041362。",
            "required": false,
            "type": "integer",
            "format": "int64"
          }
