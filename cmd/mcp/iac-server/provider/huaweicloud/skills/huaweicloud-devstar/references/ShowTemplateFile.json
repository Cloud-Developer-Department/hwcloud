{
  "name": "ShowTemplateFile",
  "summary": "读取模板文件",
  "tags": "模板管理",
  "productshort": "DevStar",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/templates/{template_id}/files": {
      "get": {
        "tags": [
          "TemplateEfsServer"
        ],
        "summary": "读取模板文件",
        "description": "该接口可以用于模板作者或模板维护人读取模板文件内容。",
        "operationId": "ShowTemplateFile",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言类型,缺省值为“zh-cn”。\n\n枚举值:\n- zh-cn:中文\n- en-us:英文\n",
            "required": false,
            "type": "string",
            "default": "zh-cn",
            "maxLength": 16,
            "minLength": 5,
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "x-example": "zh-cn",
            "x-notgenerate": true
          },
          {
            "name": "template_id",
            "in": "path",
            "description": "模板ID,通过查询模板列表接口可获取相应的模板ID。",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 32,
            "x-example": "0633650ed8a7e69212eed4c348eb6b8d"
          },
          {
            "name": "file_path",
            "in": "query",
            "description": "文件相对路径,基于当前根目录的相对文件路径,例如获取HELP.md文件内容,则文件相对路径为“template-resources/file/HELP.md”。",
            "required": true,
            "type": "string",
            "maxLength": 1024,
            "minLength": 0,
            "x-example": "src/test/java/Test.java"
          },
          {
            "name": "type",
            "in": "query",
            "description": "读取文件来源,缺省值为“source-pachage”。\n\n枚举值:\n- source-package: 源文件压缩包\n- introduction: 说明文件\n",
            "required": false,
            "type": "string",
            "default": "source-package",
            "maxLength": 16,
            "minLength": 1,
            "enum": [
              "source-package",
              "introduction"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "content": "cHVibGljIGNsYXNzIFRlc3Qgewp9",
                "encoding": "base64",
                "file_name": "Test.java",
                "file_path": "src/test/java/Test.java",
                "file_type": "text/plain; charset=utf-8"
              }
            },
            "schema": {
              "$ref": "#/definitions/TemplateFile"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "DEVSTAR.1001",
                "error_msg": "file_path : 非法参数"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": {
                "error_code": "DEV.00000003",
                "error_msg": "认证信息过期"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error_code": "DEVSTAR.1034",
                "error_msg": "无操作权限"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "examples": {
              "application/json": {
                "error_code": "DEVSTAR.1039",
                "error_msg": "文件不存在"
              }
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/template/0633650ed8a7e69212eed4c348eb6b8d/files?file_path=src/%2Ftest%2Fjava%2FTest.java"
      }
    }
  },
  "definitions": {
    "TemplateFile": {
      "properties": {
        "content": {
          "type": "string",
          "description": "文件内容(返回的文件内容为encoding指定的编码格式编码后的内容)。",
          "minLength": 0,
          "maxLength": 10000000
        },
        "encoding": {
          "type": "string",
          "description": "内容编码格式(固定base64)。",
          "minLength": 6,
          "maxLength": 6
        },
        "file_name": {
          "type": "string",
          "description": "文件名。",
          "minLength": 0,
          "maxLength": 128
        },
        "file_path": {
          "type": "string",
          "description": "文件相对路径。",
          "minLength": 0,
          "maxLength": 512
        },
        "file_type": {
          "type": "string",
          "description": "文件类型。",
          "minLength": 0,
          "maxLength": 128
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "devstar.cn-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}