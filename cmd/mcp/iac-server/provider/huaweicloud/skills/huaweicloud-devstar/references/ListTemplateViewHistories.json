{
  "name": "ListTemplateViewHistories",
  "summary": "我浏览的模板记录",
  "tags": "模板管理",
  "productshort": "DevStar",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/templates/view-histories": {
      "get": {
        "tags": [
          "TemplateServer"
        ],
        "summary": "我浏览的模板记录",
        "description": "查询DevStar或者CodeLabs登录用户浏览过的模板(只返回最近浏览的5个模板)。\n",
        "operationId": "ListTemplateViewHistories",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "maxLength": 10000,
            "minLength": 0,
            "x-notgenerate": true,
            "x-example": "MIIDkgYJKoZIhvIIDgzCCXXXXXX..."
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言类型,缺省值为“zh-cn”。\n\n枚举值:\n- zh-cn:中文\n- en-us:英文\n",
            "required": false,
            "type": "string",
            "default": "zh-cn",
            "maxLength": 16,
            "minLength": 5,
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "x-example": "zh-cn",
            "x-notgenerate": true
          },
          {
            "name": "platform_source",
            "in": "query",
            "description": "平台来源:\n- 0:查询CodeLabs中用户浏览过的模板。\n- 1:查询DevStar中用户浏览过的模板。\n",
            "required": true,
            "type": "integer",
            "maximum": 1,
            "minimum": 0,
            "enum": [
              0,
              1
            ],
            "x-example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "examples": {
              "application/json": {
                "templates": [
                  {
                    "template_id": "174522c0b5894593b08d329e048add93",
                    "template_title": "ssl1re22"
                  }
                ],
                "count": 5
              }
            },
            "schema": {
              "$ref": "#/definitions/ListTemplateViewHistoriesResp"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": {
                "error_code": "DEV.00000003",
                "error_msg": "认证信息过期"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error_code": "DEVSTAR.1034",
                "error_msg": "无操作权限"
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-description-1": "请求uri示例",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/templates/view-histories?platform_source=1"
      }
    }
  },
  "definitions": {
    "ListTemplateViewHistoriesResp": {
      "properties": {
        "templates": {
          "type": "array",
          "description": "我浏览的模板。",
          "items": {
            "$ref": "#/definitions/TemplateViewHistory"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "count": {
          "type": "integer",
          "description": "我浏览的模板数量。",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "TemplateViewHistory": {
      "required": [
        "template_id",
        "template_title"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "description": "模板的id。",
          "minLength": 32,
          "maxLength": 32
        },
        "template_title": {
          "type": "string",
          "description": "模板的名称。",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
