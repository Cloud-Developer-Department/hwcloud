{
  "name": "CheckRepositoryDuplicateName",
  "summary": "检查仓库名称是否重名",
  "tags": "应用管理",
  "productshort": "DevStar",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/check-repository-duplicate-name": {
      "post": {
        "tags": [
          "RepositoryServer"
        ],
        "summary": "检查仓库名称是否重名",
        "description": "检查仓库名称是否重名\n- 校验规则\n    同一个项目下的仓库名称不能存在重复,当结果为true时,校验通过,仓库名称可用,否则,校验不通过,当前项目下的仓库名称已存在,不可用\n- 必传参数\n    project_id,name,region_id",
        "operationId": "CheckRepositoryDuplicateName",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "maxLength": 10000,
            "minLength": 0,
            "x-notgenerate": true,
            "x-example": "MIIDkgYJKoZIhvIIDgzCCXXXXXX..."
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言类型 中文:zh-cn 英文:en-us",
            "required": false,
            "type": "string",
            "maxLength": 16,
            "minLength": 5,
            "x-example": "zh-cn",
            "x-notgenerate": true
          },
          {
            "name": "project_id",
            "in": "query",
            "description": "项目id",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 32,
            "x-example": "72322c7e02694b9196cc555d8c9a0d9e"
          },
          {
            "name": "name",
            "in": "query",
            "description": "仓库名称",
            "required": true,
            "type": "string",
            "maxLength": 99,
            "minLength": 1,
            "x-example": "repo"
          },
          {
            "name": "region_id",
            "in": "query",
            "description": "区域id",
            "required": true,
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "x-example": "cn-north-4"
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "examples": {
              "application/json": {
                "result": true
              }
            },
            "schema": {
              "$ref": "#/definitions/CheckDuplicateNameResult"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "DEVSTAR.1001",
                "error_msg": "project_id : 非法参数"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": {
                "error_code": "DEV.00000001",
                "error_msg": "未识别到用户认证信息"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error_code": "DEVSTAR.1034",
                "error_msg": "无操作权限"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "examples": {
              "application/json": {
                "error_code": "DEVSTAR.00001113",
                "error_msg": "项目不存在"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-1": "POST https://{endpoint}/v1/check-repository-duplicate-name?region_id=cn-north-7&project_id=72322c7e02694b9196cc555d8c9a0d9e&name=repo",
        "x-support-sdk": "Y",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误编码",
          "minLength": 1,
          "maxLength": 50
        },
        "error_msg": {
          "type": "string",
          "description": "错误原因",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "CheckDuplicateNameResult": {
      "properties": {
        "result": {
          "type": "boolean",
          "description": "重名校验是否通过,true:校验通过不重名,false:校验不通过重名"
        }
      }
    }
