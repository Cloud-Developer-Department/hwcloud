                "error_code": "DEVSTAR.2002",
                "error_msg": "未知错误"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": {
                "error_code": "DEV.00000001",
                "error_msg": "未识别到用户认证信息"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error_code": "DEVSTAR.1034",
                "error_msg": "没有权限"
              }
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-description-1": "创建部署任务",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/applications/658942cfdfdc46ed911bc7006f1364ef/environments/dev_env/deployment-jobs",
