{
  "name": "CreateDeploymentJobs",
  "summary": "创建部署任务",
  "tags": "应用管理",
  "productshort": "DevStar",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/applications/{application_id}/environments/{environment_tag}/deployment-jobs": {
