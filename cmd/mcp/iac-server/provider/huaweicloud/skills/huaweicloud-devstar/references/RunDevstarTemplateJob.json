{
  "name": "RunDevstarTemplateJob",
  "summary": "Devstar 模板生成代码",
  "tags": "代码生成",
  "productshort": "DevStar",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/jobs/template": {
      "post": {
        "tags": [
          "JobServer"
        ],
        "summary": "Devstar 模板生成代码",
        "description": "使用DevStar的模板创建应用代码。\n\n通过 DevStar 模板创建生成应用代码的任务,并将应用代码存储于指定的 CodeHub 仓库中,可以通过返回的任务 ID 查询相关任务状态。\n\n- 接口鉴权方式\n通过华为云服务获取的用户token。\n\n- 代码生成位置\n应用代码生成后的地址,目前支持codehub地址和压缩包下载地址。",
        "operationId": "RunDevstarTemplateJob",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "maxLength": 10240,
            "minLength": 0,
            "x-notgenerate": true,
            "x-example": "MIIDkgYJKoZIhvIIDgzCCXXXXXX..."
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言类型,缺省值为“zh-cn”。\n\n枚举值:\n- zh-cn:中文\n- en-us:英文\n",
            "required": false,
            "type": "string",
            "default": "zh-cn",
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "x-notgenerate": true
          },
          {
            "in": "body",
            "name": "RunDevstarTemplateJobRequestBody",
            "description": "创建任务参数",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TemplateJobInfo"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "examples": {
              "application/json": {
                "id": "j_zNvQCYTy"
              }
            },
            "schema": {
              "$ref": "#/definitions/JobResp"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "HDN.1001",
                "error_msg": "参数错误"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": {
                "error_code": "HDN.1001",
                "error_msg": "权限错误"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error_code": "HDN.1001",
                "error_msg": "权限错误"
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-description-1": "请求样例",
        "x-request-examples-url-1": "",
        "x-request-examples-1": {
          "template_id": "ad124ea592544244a73eb33f3ce9aedc",
          "application_name": "codehub",
          "repo_type": 1,
          "properties": {
            "artifactId": "Hello"
          }
        }
      }
    }
  },
  "definitions": {
    "FileTreeNode": {
      "properties": {
        "file_path": {
          "type": "string",
          "description": "文件路径",
          "minLength": 1,
          "maxLength": 1024
        },
        "file_name": {
          "type": "string",
          "description": "文件名称",
          "minLength": 1,
          "maxLength": 1024
        },
        "file_type": {
          "type": "string",
          "description": "是否文件夹",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "RepositoryInfo": {
      "properties": {
        "name": {
          "type": "string",
          "description": "代码仓的名称。",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "description": "代码仓描述。",
          "minLength": 0,
          "maxLength": 1024
        },
        "project_id": {
          "type": "string",
          "description": "项目id。",
          "minLength": 32,
          "maxLength": 32
        },
        "region_id": {
          "type": "string",
          "description": "区域id。",
          "minLength": 1,
          "maxLength": 100
        },
        "gitignore": {
          "type": "string",
          "description": "根据编程语言生成gitignore文件。",
          "minLength": 0,
          "maxLength": 100
        },
        "member_permission": {
          "type": "integer",
          "description": "是否允许项目内成员访问仓库:\n- 0:不允许\n- 1:允许\n",
          "minimum": 0,
          "maximum": 1
        },
        "readme_permission": {
          "type": "integer",
          "description": "是否允许生成README文件:\n- 0:不允许\n- 1:允许\n",
          "minimum": 0,
          "maximum": 1
        },
        "visibility_level": {
          "type": "integer",
          "description": "是否公开:\n- 0:私有\n- 20:公开只读\n",
          "minimum": 0,
          "maximum": 20
        },
        "license_id": {
          "type": "integer",
          "description": " 开源许可证id (0:默认)。",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "TemplateJobInfo": {
      "required": [
        "template_id"
      ],
      "properties": {
        "application_name": {
          "type": "string",
          "description": "应用名称",
          "minLength": 1,
          "maxLength": 100
        },
        "template_id": {
          "type": "string",
          "description": "任务依赖的模板id",
          "minLength": 32,
          "maxLength": 32
        },
        "project_name": {
          "type": "string",
          "description": "应用名称",
          "minLength": 1,
          "maxLength": 1024,
          "default": "application"
        },
        "repo_type": {
          "type": "integer",
          "description": "应用代码生成后的地址类型,目前支持0:codehub地址和1:压缩包下载地址",
          "minimum": 0,
          "maximum": 3
        },
        "properties": {
          "type": "object",
          "description": "应用的动态参数json",
          "properties": {}
        },
        "template_dependencies": {
          "type": "array",
          "description": "模板 dependency ID 集合",
          "items": {
            "type": "string"
          },
          "maxItems": 512,
          "minItems": 0
        },
        "repo_info": {
          "$ref": "#/definitions/RepositoryInfo"
        }
      }
    },
    "JobResp": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务id。",
          "minLength": 8,
          "maxLength": 8
        },
        "file_list": {
          "type": "array",
          "description": "文件列表。",
          "items": {
            "$ref": "#/definitions/FileTreeNode"
          },
          "maxItems": 1024,
          "minItems": 0
        }
      }
    }
  },
  "version": "2.0",
