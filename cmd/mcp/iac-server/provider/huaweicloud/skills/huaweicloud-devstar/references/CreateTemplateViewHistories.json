{
  "name": "CreateTemplateViewHistories",
  "summary": "同步模板浏览记录",
  "tags": "模板管理",
  "productshort": "DevStar",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/templates/view-histories": {
      "post": {
        "tags": [
          "TemplateServer"
        ],
        "summary": "同步模板浏览记录",
        "description": "未登录状态下,将用户浏览过的模板缓存在浏览器中,登录时,调用该接口同步模板浏览记录。\n",
        "operationId": "CreateTemplateViewHistories",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "maxLength": 10000,
            "minLength": 0,
            "x-notgenerate": true,
            "x-example": "MIIDkgYJKoZIhvIIDgzCCXXXXXX..."
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言类型,缺省值为“zh-cn”。\n\n枚举值:\n- zh-cn:中文\n- en-us:英文\n",
            "required": false,
            "type": "string",
            "default": "zh-cn",
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "x-example": "zh-cn",
            "x-notgenerate": true
          },
          {
            "in": "body",
            "name": "CreateTemplateViewHistoriesRequestBody",
            "description": "模板信息",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TemplatesInfo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "examples": {
              "application/json": {
                "templates": [
                  {
                    "template_id": "174522c0b5894593b08d329e048add93",
                    "template_title": "ssl1re22"
                  }
                ],
                "count": 5
              }
            },
            "schema": {
              "$ref": "#/definitions/ListTemplateViewHistoriesResp"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "DEVSTAR.1001",
                "error_msg": "template_ids:非法参数"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": {
                "error_code": "DEV.00000003",
                "error_msg": "认证信息过期"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error_code": "DEVSTAR.1034",
                "error_msg": "无操作权限"
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-example-description-1": "",
        "x-request-examples-1": {
          "template_ids": [
            "012345678998745632108520369741",
            "345601278998745632108520369741"
          ],
          "platform_source": 1
        }
      }
    }
  },
  "definitions": {
    "TemplatesInfo": {
      "required": [
        "platform_source",
        "template_ids"
      ],
      "properties": {
        "template_ids": {
          "type": "array",
          "description": "模板ID列表。",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "platform_source": {
          "type": "integer",
          "description": "平台来源:\n- 0:codelabs\n- 1:devstar\n",
          "minimum": 0,
          "maximum": 1,
          "x-example": 0
        }
      }
    },
    "ListTemplateViewHistoriesResp": {
      "properties": {
        "templates": {
          "type": "array",
          "description": "我浏览的模板。",
          "items": {
            "$ref": "#/definitions/TemplateViewHistory"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "count": {
          "type": "integer",
          "description": "我浏览的模板数量。",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "TemplateViewHistory": {
      "required": [
        "template_id",
        "template_title"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "description": "模板的id。",
          "minLength": 32,
          "maxLength": 32
        },
        "template_title": {
          "type": "string",
          "description": "模板的名称。",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "devstar.cn-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}