{
  "name": "ShowJobDetail",
  "summary": "查询任务详情",
  "tags": "代码生成",
  "productshort": "DevStar",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/jobs/{job_id}": {
      "get": {
        "tags": [
          "JobServer"
        ],
        "summary": "查询任务详情",
        "description": "查询任务的详情。\n\n通过任务ID可以查看任务的状态\n当任务结束时返回应用代码存放的位置。\n\n- 接口鉴权方式\n通过华为云服务获取的用户token。\n\n- 代码生成位置\n应用代码生成后的地址,目前支持codehub地址和压缩包下载地址。",
        "operationId": "ShowJobDetail",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "maxLength": 10240,
            "minLength": 0,
            "x-notgenerate": true,
            "x-example": "MIIDkgYJKoZIhvIIDgzCCXXXXXX..."
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言类型,缺省值为“zh-cn”。\n\n枚举值:\n- zh-cn:中文\n- en-us:英文\n",
            "required": false,
            "type": "string",
            "default": "zh-cn",
            "maxLength": 16,
            "minLength": 5,
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "x-notgenerate": true
          },
          {
            "name": "job_id",
            "in": "path",
            "description": "任务 ID: 可以通过调用 RunDevstarTemplateJob 返回结果获取",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "id": "zNvQCYTy",
                "name": "zNvQCYTy",
                "job_status": {
                  "initRepository": {
                    "name": "生成代码",
                    "status": "success",
                    "context": {
                      "web_url": "生成代码仓的地址"
                    },
                    "elapsedTime": "15",
