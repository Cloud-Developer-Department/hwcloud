                    "endTime": 1587896275897
                  },
                  "initPipeline": {
                    "name": "创建流水线",
                    "status": "running",
                    "elapsedTime": 2,
                    "createTime": 1587896259000,
                    "startTime": 1587896260331,
                    "endTime": 1587896275897
                  }
                },
                "job_result": "running"
              }
            },
            "schema": {
              "$ref": "#/definitions/Job"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "HDN.1001",
                "error_msg": "参数错误"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
