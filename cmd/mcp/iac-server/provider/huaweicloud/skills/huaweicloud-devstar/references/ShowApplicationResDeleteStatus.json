              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-description-1": "请求uri示例",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/application-resources/0633650ed8a7e69212eed4c348eb6b8d/delete-status"
