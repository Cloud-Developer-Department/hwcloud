                  ]
                },
                "job_progress": 0
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "error_msg": "can not find job, jobId is ff808081646e81d40164c5fb414b2b1a1",
