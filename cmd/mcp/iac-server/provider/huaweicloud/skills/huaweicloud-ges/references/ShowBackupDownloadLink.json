  "tags": "备份管理API",
  "productshort": "GES",
  "region_id": "cn-east-3",
  "paths": {
    "/v2/{project_id}/graphs/{graph_id}/backup-files": {
      "get": {
        "x-request-examples-url-1": "GET https://Endpoint//v2/{project_id}/graphs/{graph_id}/backup-files?backup_id=22aa0177-b20b-4f3a-8556-8147d6658ed8",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "备份管理API"
        ],
        "summary": "获取备份下载链接",
        "description": "获取备份下载链接",
        "operationId": "ShowBackupDownloadLink",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/graph_id"
          },
          {
            "name": "backup_id",
