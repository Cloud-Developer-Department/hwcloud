            "required": true,
            "description": "备份ID",
            "type": "string"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "schema": {
              "$ref": "#/definitions/ShowBackupDownloadLinkResp"
            },
            "examples": {
              "application/json": {
                "files": [
                  {
                    "name": "43e4feaab48f11e89039fa163ebaa7e4br01.xxx",
                    "size": 2803,
                    "download_link": "https://obs.domainname.com/rdsbucket.username.1/xxxxxx",
                    "link_expired_time": "2018-08-016T10:15:14+0800"
                  }
                ],
                "bucket": "rdsbucket.bucketname"
              }
            }
          },
          "400": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "GES.7006",
                "error_msg": "The underlying graph engine has internal error."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "BackupDownloadLink": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "43e4feaab48f11e89039fa163ebaa7e4br01.xxx",
          "description": "文件名"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "example": 2803,
          "description": "文件大小,单位:KB。"
        },
        "download_link": {
          "type": "string",
          "example": "https://obs.domainname.com/rdsbucket.username.1/xxxxxx",
          "description": "文件下载链接。"
        },
        "link_expired_time": {
          "type": "string",
          "example": "2018-08-016T10:15:14+0800",
          "description": "下载链接过期时间,格式为“yyyy-mm-ddThh:mm:ssZ”。其中,T指某个时间的开始,Z指时区偏移量,例如北京时间偏移显示为+0800。"
        }
      },
      "required": [
        "name",
        "size",
        "download_link",
        "link_expired_time"
      ]
    },
    "ErrorResp": {
      "type": "object",
      "description": "错误响应体",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "系统提示信息,执行成功时,字段可能为空。执行失败时,用于显示错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "系统提示信息,执行成功时,字段可能为空。执行失败时,用于显示错误信息。"
        }
      }
    },
    "ShowBackupDownloadLinkResp": {
      "type": "object",
      "required": [
        "bucket",
        "files"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "description": "文件所在的桶名。"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BackupDownloadLink"
          },
          "description": "备份包含的文件列表。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "graph_id": {
      "name": "graph_id",
      "in": "path",
      "required": true,
      "description": "图ID。",
      "type": "string"
