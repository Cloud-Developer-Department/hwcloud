  "definitions": {
    "ListGraphsResp": {
      "type": "object",
      "description": "查询图列表响应体",
      "properties": {
        "graph_count": {
          "type": "integer",
          "format": "int32",
          "description": "图总个数。请求失败时为空。"
        },
        "graphs": {
          "type": "array",
          "items": {
            "properties": {
              "id": {
                "type": "string",
                "description": "图ID。"
              },
              "name": {
                "type": "string",
                "description": "图名称。"
              },
              "created_by": {
                "type": "string",
                "description": "图的创建人账号。"
              },
              "is_multi_az": {
                "type": "string",
                "description": "是否支持跨AZ高可用。"
              },
              "region_code": {
                "type": "string",
                "description": "域编码。"
              },
              "az_code": {
                "type": "string",
                "description": "可用区编码。"
              },
              "schema_path": {
                "type": "array",
                "items": {
                  "properties": {
                    "job_id": {
                      "type": "string",
                      "description": "导入OBS文件对应的jobId。"
                    },
                    "path": {
                      "type": "string",
                      "description": "OBS存储路径,不包含OBS Endpoint。"
                    },
                    "status": {
                      "type": "string",
                      "description": "OBS文件导入状态。\n\n- success:完全导入成功\n- partiallyFailed:部分失败\n- failed:完全导入失败"
                    }
                  }
                },
                "description": "元数据文件路径。"
              },
              "edgeset_path": {
                "type": "array",
                "items": {
                  "properties": {
                    "job_id": {
                      "type": "string",
                      "description": "导入OBS文件对应的jobId。"
                    },
                    "path": {
                      "type": "string",
                      "description": "OBS存储路径,不包含OBS Endpoint。"
                    },
                    "status": {
                      "type": "string",
                      "description": "OBS文件导入状态。\n\n- success:完全导入成功\n- partiallyFailed:部分失败\n- failed:完全导入失败"
                    }
                  }
                },
                "description": "边数据集OBS路径。"
              },
              "vertexset_path": {
                "type": "array",
                "items": {
                  "properties": {
                    "job_id": {
                      "type": "string",
                      "description": "导入OBS文件对应的jobId。"
                    },
                    "path": {
                      "type": "string",
                      "description": "OBS存储路径,不包含OBS Endpoint。"
                    },
                    "status": {
                      "type": "string",
                      "description": "OBS文件导入状态。\n\n- success:完全导入成功\n- partiallyFailed:部分失败\n- failed:完全导入失败"
                    }
                  }
                },
                "description": "点数据集OBS路径。"
              },
              "edgeset_format": {
                "type": "string",
                "description": "边数据集文件格式。"
              },
              "edgeset_default_label": {
                "type": "string",
                "description": "边数据集文件默认Label。"
              },
              "vertexset_format": {
                "type": "string",
                "description": "点数据集文件格式。"
              },
              "vertexset_default_label": {
                "type": "string",
                "description": "点数据集文件默认Label。"
              },
              "data_store_version": {
                "type": "string",
                "description": "图版本。"
              },
              "sys_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "企业项目信息,如果未指定则不开启,默认不开启。"
              },
              "status": {
                "type": "string",
                "description": "图的状态码。\n\n- 100:准备中\n- 200:运行中\n- 201:升级中\n- 202:导入中\n- 203:回滚中\n- 204:导出中\n- 205:清空中\n- 206:扩容准备中\n- 207:扩容中\n- 208:扩容回退中\n- 210:扩副本准备中\n- 211:扩副本中\n- 300:故障\n- 303:创建失败\n- 400:被删除\n- 800:已冻结\n- 900:停止\n- 901:停止中\n- 920:启动中"
              },
              "action_progress": {
                "type": "string",
                "description": "图创建进度百分比。\n> 只有图状态码为100时返回该字段。"
              },
              "graph_size_type_index": {
                "type": "string",
                "description": "图规模类型索引。\n\n- 0:一万边\n- 1:百万边\n- 2:千万边\n- 3:一亿边\n- 4:十亿边\n- 5:百亿边\n- 6:千亿边\n- 401:十亿增强边"
              },
              "vpc_id": {
                "type": "string",
                "description": "虚拟私有云ID。"
              },
              "subnet_id": {
                "type": "string",
                "description": "指定虚拟私有云下的子网ID。"
              },
              "security_group_id": {
                "type": "string",
                "description": "安全组ID。"
              },
              "replication": {
                "type": "integer",
                "format": "int32",
                "description": "副本个数,默认为1。"
              },
              "created": {
                "type": "string",
                "description": "图创建时间。"
              },
              "updated": {
                "type": "string",
                "description": "图更新时间。"
              },
              "private_ip": {
                "type": "string",
                "description": "图实例私有网络访问浮动IP地址,通过该IP用户可以通过私有网络中已部署的弹性云服务器对图实例进行访问。"
              },
              "public_ip": {
                "type": "string",
                "description": "图实例公网访问地址,通过该IP用户可以从互联网对图实例进行访问。"
              },
              "arch": {
                "type": "string",
                "description": "图实例CPU架构类型,取值为x86_64和aarch64。"
              },
              "encrypted": {
                "type": "boolean",
                "description": "是否加密。默认值为“false”,默认不加密。"
              },
              "master_key_id": {
                "type": "string",
                "description": "用户主密钥ID。"
              },
              "master_key_name": {
                "type": "string",
                "description": "用户主密钥名称。"
              },
              "enable_rbac": {
                "type": "boolean",
                "description": "是否启用细粒度权限控制。"
              },
              "enable_full_text_index": {
                "type": "boolean",
                "description": "是否启用全文索引。"
              },
              "enable_hyg": {
                "type": "boolean",
                "description": "是否启用HyG,该参数只对千亿规格图生效。"
              },
              "traffic_ip_list": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "图实例私有网络访问物理地址列表。为了防止浮动IP切换造成业务闪断,我们推荐您通过轮询的方式使用物理IP访问图实例。"
              },
              "crypt_algorithm": {
                "type": "string",
                "description": "图实例加密算法,取值为:\n\n- generalCipher:国密算法\n- SMcompatible:商密算法(兼容国际)"
              },
              "enable_https": {
                "type": "boolean",
                "description": "是否开启安全模式,开启安全模式会对性能有较大影响"
              },
              "tags": {
                "type": "array",
                "items": {
                  "properties": {
                    "key": {
                      "type": "string",
                      "description": "标签key"
                    },
                    "value": {
                      "type": "string",
                      "description": "标签value"
                    }
                  }
                },
                "description": "标签列表,每个标签用<key,value>键值对表示。"
              },
              "product_type": {
                "type": "string",
                "description": "图产品类型,取值为InMemory和Persistence,默认为InMemory,当graph_size_type_index取值为\"6\"时,默认为Persistence。\n\n- InMemory:内存版\n- Persistence:持久化版"
              },
              "vertex_id_type": {
                "description": "点的id类型,仅持久化图需要填写。\n\n> 点ID类型确定后,将无法更改,请用户谨慎选择!",
                "required": [
                  "id_type"
                ],
                "properties": {
                  "id_type": {
                    "type": "string",
                    "description": "id类型,目前支持固定长度fixedLengthString和hash两种点ID类型。\n\n- fixedLengthString:固定长度String格式下,实际点ID直接用于内部存储与计算,用户需指定一长度,实际点ID不可超过此长度。长度过大,可能影响查询性能,建议用户根据数据集状态进行设置。\n\n- hash:哈希格式下,内部计算时将实际点ID转换成哈希码进行存储与计算,对实际点ID长度无限制,但是存在极低的概率(约10^(-43))出现点ID碰撞。若用户无法确定点ID的最大长度,建议选择哈希类型。"
                  },
                  "id_length": {
                    "type": "integer",
                    "format": "int32",
                    "description": "当id_type取值为fixedLengthString时必填,取值范围:1-128。"
                  }
                }
              },
              "origin_graph_size_type_index": {
                "type": "string",
                "description": "图的初始规格。该参数从2.3.15版本后开始支持。"
              },
              "expand_time": {
                "type": "string",
                "description": "图扩副本的时间。"
              },
              "resize_time": {
                "type": "string",
                "description": "图扩容的时间。"
              },
              "enable_multi_label": {
                "type": "boolean",
                "description": "是否启用多标签。"
              },
              "capacity_ratio": {
                "type": "integer",
                "format": "int32",
                "description": "图的容量倍率。只有持久化版百亿规格图支持该参数,该参数从2.3.18版本后开始支持。"
              },
              "sort_key_type": {
                "type": "string",
                "description": "图的sortKey类型,内存版图无此值。"
              },
              "enable_lts": {
                "type": "boolean",
                "description": "对接云服务LTS日志开启状态。\n\n- true:日志对接开启中。\n- false:日志对接关闭中。"
              }
            }
          },
          "description": "图列表。请求失败时为空。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目编号,用于资源隔离。",
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string"
    }
  },
