  "definitions": {
    "ErrorResp": {
      "type": "object",
      "description": "错误响应体",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "系统提示信息,执行成功时,字段可能为空。执行失败时,用于显示错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "系统提示信息,执行成功时,字段可能为空。执行失败时,用于显示错误信息。"
        }
      }
    },
    "CreateGraphResp": {
      "type": "object",
      "description": "创建图响应体",
      "properties": {
        "id": {
          "type": "string",
          "description": "图ID。"
        },
        "name": {
          "type": "string",
          "description": "图名称。"
        }
      }
    },
    "CreateGraphReq": {
      "type": "object",
      "description": "创建图请求体",
      "required": [
        "graph"
      ],
      "properties": {
        "graph": {
          "description": "图类型。",
          "required": [
            "name",
            "graph_size_type_index",
            "vpc_id",
            "subnet_id",
            "security_group_id",
            "crypt_algorithm",
            "enable_https"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "图名称(输入长度在4位到50位之间,必须以字母开头,可以包含字母、数字或者下划线,不能包含其他的特殊字符)。"
            },
            "graph_size_type_index": {
              "type": "string",
              "description": "图规模类型索引。\n\n- 0:一万边\n- 1:百万边\n- 2:千万边\n- 3:一亿边\n- 4:十亿边\n- 5:百亿边\n- 6:千亿边\n- 401:十亿增强边"
            },
            "arch": {
              "type": "string",
              "description": "图实例CPU架构类型,取值为x86_64和aarch64。默认取x86_64。\n\n- x86_64:X64 64位架构。\n- aarch64:ARM 64位架构。"
            },
            "vpc_id": {
              "type": "string",
              "description": "虚拟私有云ID。"
            },
            "subnet_id": {
              "type": "string",
              "description": "指定虚拟私有云下的子网ID。"
            },
            "security_group_id": {
              "type": "string",
              "description": "安全组ID。"
            },
            "public_ip": {
              "description": "公网IP地址,如果未指定,则默认不使用公网连接。",
              "properties": {
                "public_bind_type": {
                  "type": "string",
                  "description": "弹性IP绑定类型,取值如下。\n\n- auto_assign:自动绑定。\n- bind_existing:使用已有。"
                },
                "eip_id": {
                  "type": "string",
                  "description": "弹性IP的id,当publicBindType设置为bind_existing时,该值为用户某个已创建但尚未绑定的EIP的ID;当publicBindType设置为auto_assign时,该值设置为空。"
                }
              }
            },
            "enable_multi_az": {
              "type": "boolean",
              "description": "创建的图是否支持跨可用区(AZ),默认值是false,如果设置为true,系统将会把图中的ECS建在两个可用区中。\n\n如果创建图时,不加该参数,则会将图中的ECS都建在一个可用区中。"
            },
            "encryption": {
              "description": "图实例是否加密,默认不加密。",
              "properties": {
                "enable": {
                  "type": "boolean",
                  "description": "是否启动加密特性。取值为“true”或者“false”。默认为“false”。"
                },
                "master_key_id": {
                  "type": "string",
                  "description": "与建图对应的project下,华为云数据加密服务创建的用户主密钥ID。"
                }
              }
            },
            "lts_operation_trace": {
              "description": "图实例是否开启审计日志,默认不开启。",
              "properties": {
                "enable_audit": {
                  "type": "boolean",
                  "description": "是否开启图审计,默认“false”。"
                },
                "audit_log_group_name": {
                  "type": "string",
                  "description": "LTS日志组名称。"
                }
              }
            },
            "sys_tags": {
              "items": {
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "企业项目的key填:_sys_enterprise_project_id。"
                  },
                  "value": {
                    "type": "string",
                    "description": "企业项目的id。可以从企业项目获取。"
                  }
                }
              },
              "description": "企业项目信息,如果未指定则不开启,默认不开启。",
              "type": "array"
            },
            "tags": {
              "type": "array",
              "items": {
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "标签key"
                  },
                  "value": {
                    "type": "string",
                    "description": "标签value"
                  }
                }
              },
              "description": "支持标签TMS,做费用归集,默认不开启。"
            },
            "enable_rbac": {
              "type": "boolean",
              "description": "创建的图是否启用细粒度权限控制,默认不启用,值为false。如果设置为true,创建的图所有用户都没有权限,需要调用业务面细粒度权限控制API进行授权操作才可以访问图。"
            },
            "enable_full_text_index": {
              "type": "boolean",
              "description": "创建的图是否开启全文索引控制,默认不启用,值为false。\n如果设置为true,十亿增强版-规格版图支持全文索引,创建图时会创建云搜索服务集群。\n> 开启全文索引功能。如果CSS服务已经部署,图实例会自动创建CSS集群,图创建时间较长。如果CSS服务没有部署则图创建失败。"
            },
            "enable_hyg": {
              "type": "boolean",
              "description": "该参数只对千亿规格图生效。"
            },
            "crypt_algorithm": {
              "type": "string",
              "description": "图实例加密算法,取值为:\n\n- generalCipher:国密算法\n- SMcompatible:商密算法(兼容国际)"
            },
            "enable_https": {
              "type": "boolean",
              "description": "是否开启安全模式,开启安全模式会对性能有较大影响"
            },
            "product_type": {
              "type": "string",
              "description": "图产品类型,取值为InMemory和Persistence,默认为InMemory,当graph_size_type_index取值为\"6\"时,默认为Persistence。\n\n- InMemory:内存版\n- Persistence:持久化版"
            },
            "vertex_id_type": {
              "description": "点的id类型,仅持久化图需要填写。\n\n> 点ID类型确定后,将无法更改,请用户谨慎选择!",
              "required": [
                "id_type"
              ],
              "properties": {
                "id_type": {
                  "type": "string",
                  "description": "id类型,目前支持固定长度fixedLengthString和hash。\n\n- fixedLengthString:固定长度String格式下,实际点ID直接用于内部存储与计算,用户需指定一长度,实际点ID不可超过此长度。长度过大,可能影响查询性能,建议用户根据数据集状态进行设置。\n\n- hash:哈希格式下,内部计算时将实际点ID转换成哈希码进行存储与计算,对实际点ID长度无限制,但是存在极低的概率(约10^(-43))出现点ID碰撞。若用户无法确定点ID的最大长度,建议选择哈希类型。"
                },
                "id_length": {
                  "type": "integer",
                  "format": "int32",
                  "description": "当id_type取值为fixedLengthString时必填,取值范围:1-128。"
                }
              }
            },
            "enable_multi_label": {
              "description": "是否启用多标签",
              "type": "boolean"
            },
            "capacity_ratio": {
              "type": "integer",
              "format": "int32",
              "description": "图的容量倍率。该参数只有持久化版百亿规格图支持,且从2.3.18版本后开始支持。"
            },
            "is_dynamic_graph": {
              "type": "boolean",
              "description": "是否为动态图"
            },
            "sort_key_type": {
              "type": "string",
              "description": "持久化版图数据的sortKey的类型,通过配置不同SortKey的值来区分重复边(源点,终点,Label三者都相同的边),仅持久化图需要填写。取值为:\n- int:整型\n- string:字节长度小于等于40的字符串\n- varString:不限长度字符串,过长会影响读写性能,建议长度控制在1K字节以内,最大不要超过2K字节"
            }
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目编号,用于资源隔离。",
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string"
    }
  },
  "host": "ges.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "post",
  "uri": null
