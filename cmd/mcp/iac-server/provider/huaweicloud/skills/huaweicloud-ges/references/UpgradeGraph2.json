    "UpgradeGraphReq": {
      "type": "object",
      "description": "升级图请求体",
      "required": [
        "upgrade_version"
      ],
      "properties": {
        "upgrade_version": {
          "type": "string",
          "description": "升级到的版本,必须大于当前图版本。"
        },
        "force_upgrade": {
          "type": "boolean",
          "description": "是否强制升级。取值为true或false,默认为false。\n\n- true:强制升级,会中断升级时已经在处理的任务,比如运行算法长任务,可能会造成少量请求失败。\n- false:非强制升级,会等待已经运行的业务,升级过程可能较慢。"
        }
      }
