{
  "name": "ListApiAttachedPlugins",
  "summary": "查询API下绑定的插件",
  "tags": "专享版-插件管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/{project_id}/apigw/instances/{instance_id}/apis/{api_id}/attached-plugins": {
      "get": {
        "tags": [
          "专享版-插件管理"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-order": 8,
        "x-open-region-cloud": "hws,hws_hk,cmcc,ctc,dt,g42,hk_g42,hk_sbc,hk_tm,hws_eu,hws_ocb,ocb,sbc,tm,srg,ax",
        "x-api-type": "open-api",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "operationId": "ListApiAttachedPlugins",
        "summary": "查询API下绑定的插件",
        "description": "查询指定API下绑定的插件信息。\n- 用于查询指定API下已经绑定的插件列表信息\n- 支持分页返回\n- 支持插件名称模糊查询",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_offset"
          },
          {
            "$ref": "#/parameters/apic_limit"
          },
          {
            "name": "api_id",
            "type": "string",
            "required": true,
            "in": "path",
            "description": "API编号",
            "x-example": "8aa097b00e9843efabc9c593d11b769d"
          },
          {
            "name": "env_id",
            "type": "string",
            "description": "发布的环境编号",
            "required": false,
            "in": "query",
            "x-example": "DEFAULT_ENVIRONMENT_RELEASE_ID"
          },
          {
            "name": "plugin_name",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "插件名称",
            "x-example": "跨域插件"
          },
          {
            "name": "plugin_id",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "插件编号",
            "x-example": "5b729aa252764739b3s237ef0d66dc63"
          },
          {
            "name": "env_name",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "环境名称",
            "x-example": "RELEASE"
          },
          {
            "name": "plugin_type",
            "in": "query",
            "type": "string",
            "description": "插件类型",
            "x-example": "cros"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/AttachedApiPluginResp"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "size": 1,
                "plugins": [
                  {
                    "plugin_attach_id": "8aa097b00e9843efacb9c593d11b769e",
                    "plugin_id": "5b729aa252764739b3s237ef0d66dc63",
                    "plugin_name": "跨域插件",
                    "plugin_type": "cors",
                    "plugin_scope": "global",
                    "plugin_content": "{\"allow_origin\": \"*\",\"allow_methods\": \"GET,POST,PUT\",\"allow_headers\": \"Content-Type,Accept,Accept-Ranges,Cache-Control\",\"expose_headers\": \"X-Request-Id,X-Apig-Latency\",\"max_age\": 172800,\"allow_credentials\": true}",
                    "remark": "CORS跨域资源访问",
                    "env_id": "DEFAULT_ENVIRONMENT_RELEASE_ID",
                    "env_name": "RELEASE",
                    "attached_time": "2022-11-02T12:31:23.353Z",
                    "create_time": "2022-11-02T12:31:23.353Z",
                    "update_time": "2022-11-02T12:31:23.353Z"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:instance_id. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3002",
                "error_msg": "API 5f918d104dc84480a75166ba99efff21 does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "AttachedApiPluginResp": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "plugins": {
              "description": "绑定API的插件列表。",
              "type": "array",
              "items": {
                "$ref": "#/definitions/AttachedPluginInfo"
              }
            }
          }
        }
      ]
    },
    "BasePage": {
      "properties": {
        "size": {
          "description": "本次返回的列表长度",
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "description": "满足条件的记录数",
          "type": "integer",
          "format": "int64"
        }
      },
      "description": "分页基本信息",
      "required": [
        "size",
        "total"
      ]
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "AttachedPluginInfo": {
      "properties": {
        "plugin_attach_id": {
          "type": "string",
          "description": "插件绑定编码。",
          "example": "8aa097b00e9843efacb9c593d11b769e"
        },
        "plugin_id": {
          "type": "string",
          "description": "插件编码。",
          "example": "5b729aa252764739b3s237ef0d66dc63"
        },
        "plugin_name": {
          "type": "string",
          "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9_-]|[\\一-\\龥]){2,254}$",
          "description": "插件名称。支持汉字,英文,数字,中划线,下划线,且只能以英文和汉字开头,3-255字符\n> 中文字符必须为UTF-8或者unicode编码。",
          "example": "跨域插件"
        },
        "plugin_type": {
          "type": "string",
          "enum": [
            "cors",
            "set_resp_headers",
            "kafka_log",
            "breaker",
            "rate_limit",
            "third_auth",
            "proxy_cache",
            "proxy_mirror",
            "oidc_auth",
            "jwt_auth"
          ],
          "description": "插件类型。\n- cors:跨域资源共享\n- set_resp_headers:HTTP响应头管理\n- kafka_log:Kafka日志推送\n- breaker:断路器\n- rate_limit: 流量控制\n- third_auth: 第三方认证\n- proxy_cache: 响应缓存\n- proxy_mirror: 请求镜像\n- oidc_auth: OIDC认证\n- jwt_auth: JWT认证",
          "example": "cors"
        },
        "plugin_scope": {
          "type": "string",
          "enum": [
            "global"
          ],
          "description": "插件可见范围。global:全局可见。",
          "example": "global"
        },
        "env_id": {
          "type": "string",
          "description": "绑定API的环境编码。",
          "example": "DEFAULT_ENVIRONMENT_RELEASE_ID"
        },
        "env_name": {
          "description": "api授权绑定的环境名称",
          "type": "string",
          "example": "RELEASE"
        },
        "attached_time": {
          "type": "string",
          "format": "date-time",
          "description": "绑定时间。",
          "example": "2020-11-02T12:31:23.353Z"
        },
        "plugin_content": {
          "type": "string",
          "maxLength": 65535,
          "description": "插件定义内容,支持json。",
          "example": "'{\n  \"allow_origin\": \"*\",\n  \"allow_methods\": \"GET,POST,PUT\",\n  \"allow_headers\": \"Content-Type,Accept,Accept-Ranges,Cache-Control\",\n  \"expose_headers\": \"X-Request-Id,X-Apig-Latency\",\n  \"max_age\": 172800,\n  \"allow_credentials\": true\n  }'"
        },
        "remark": {
          "type": "string",
          "maxLength": 255,
          "description": "插件描述,255字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "example": "CORS跨域资源访问"
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间。",
          "example": "2022-11-02T12:31:23.353Z"
        },
        "update_time": {
          "type": "string",
          "format": "date-time",
          "description": "更新时间。",
          "example": "2022-11-02T12:31:23.353Z"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_offset": {
      "name": "offset",
      "in": "query",
      "type": "integer",
      "description": "偏移量,表示从此偏移量开始查询,偏移量小于0时,自动转换为0",
      "format": "int64",
      "default": 0,
      "x-example": 1
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID,在API网关控制台的“实例信息”中获取。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见[获取项目ID](apig-api-180713009.xml)。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "apic_limit": {
      "name": "limit",
      "in": "query",
      "type": "integer",
      "description": "每页显示的条目数量,条目数量小于等于0时,自动转换为20,条目数量大于500时,自动转换为500",
      "format": "int32",
      "minimum": 1,
      "maximum": 500,
      "default": 20,
      "x-example": 10
    }
  },
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
  "uri": null
}