          "enum": [
            "INSTANCE_NUM_LIMIT"
          ]
        },
        "config_value": {
          "description": "配额值\n\n当前实例所在租户该配额对应的数量",
          "type": "string"
        },
        "config_time": {
          "description": "配额创建时间",
          "type": "string",
          "format": "date-time"
        },
        "remark": {
          "description": "配额描述\n- INSTANCE_NUM_LIMIT:租户可以创建的实例个数限制",
