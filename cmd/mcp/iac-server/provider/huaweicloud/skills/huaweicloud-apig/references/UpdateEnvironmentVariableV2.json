  "definitions": {
    "EnvVariableCreate": {
      "required": [
        "env_id",
        "group_id",
        "variable_name"
      ],
      "allOf": [
        {
          "$ref": "#/definitions/EnvVariableBase"
        },
        {
          "type": "object",
          "properties": {
            "env_id": {
              "description": "环境编号",
              "type": "string",
              "minLength": 1,
              "maxLength": 65,
              "pattern": "^[a-zA-Z0-9-_]{0,64}$",
              "example": "7a1ad0c350844ee69479b47df9a881cb"
            },
            "group_id": {
              "description": "API分组编号",
              "type": "string",
              "minLength": 1,
              "maxLength": 65,
              "pattern": "^[a-zA-Z0-9-_]{0,64}$",
              "example": "73c58022f20d495aa18885d718647f09"
            },
            "variable_name": {
              "description": "变量名,支持英文字母、数字、英文格式的下划线、中划线,必须以英文字母开头,3~32个字符。在API定义中等于#Name的值#部分(区分大小写),发布到环境里的API被变量值替换。\n> 中文字符必须为UTF-8或者unicode编码。",
              "type": "string",
              "example": "address"
            }
          }
        }
      ]
    },
    "EnvVariableInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/EnvVariableCreate"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "环境变量编号",
              "type": "string"
            }
          }
        }
      ]
    },
    "EnvVariableBase": {
      "required": [
        "variable_value"
      ],
      "properties": {
        "variable_value": {
          "description": "变量值支持英文字母、数字、英文格式的下划线、中划线,斜线(/)、点、冒号,1 ~ 255个字符。",
          "type": "string",
          "example": "192.168.1.5"
        }
      }
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID,在API网关控制台的“实例信息”中获取。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见[获取项目ID](apig-api-180713009.xml)。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_env_variable_id": {
      "name": "env_variable_id",
      "in": "path",
      "type": "string",
      "description": "环境变量的编号",
      "required": true,
      "x-example": "25054838a624400bbf2267cf5b3a3f70"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
