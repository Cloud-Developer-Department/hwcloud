  "definitions": {
    "MicroServiceInfoCCEBase": {
      "description": "CCE云容器引擎工作负载信息,service_type为CCE时必填。app_name或(label_key、label_value)至少填一个,只填app_name时,相当于(label_key=‘app’、label_value=app_name值)",
      "properties": {
        "cluster_id": {
          "type": "string",
          "description": "云容器引擎集群编号",
          "example": "fde2c21c-5bd9-40f0-ad6a-81e4b6782805a",
          "maxLength": 64
        },
        "namespace": {
          "type": "string",
          "description": "命名空间",
          "example": "default",
          "maxLength": 64
        },
        "workload_type": {
          "description": "工作负载类型\n - deployment:无状态负载\n - statefulset:有状态负载\n - daemonset:守护进程集",
          "type": "string",
          "enum": [
            "deployment",
            "statefulset",
            "daemonset"
          ]
        },
        "app_name": {
          "type": "string",
          "description": "APP名称。支持汉字,英文,数字,点,中划线,下划线,且只能以英文和汉字开头,1-64字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "example": "name",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9._-]|[\\一-\\龥]){1,64}$"
        },
        "label_key": {
          "type": "string",
          "description": "服务标识名。支持汉字、英文、数字、中划线、下划线、点、斜杠、中英文格式下的小括号和冒号,且只能以英文、汉字和数字开头,1-64个字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "example": "app",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^([a-zA-Z0-9]|[\\一-\\龥])([a-zA-Z0-9:._()\\\\//-]|[\\一-\\龥\\（\\）\\：\\、]){1,64}$"
        },
        "label_value": {
          "type": "string",
          "description": "服务标识值。支持汉字,英文,数字,点,中划线,下划线,且只能以英文和汉字开头,1-64字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "example": "value",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9._-]|[\\一-\\龥]){1,64}$"
        }
      },
      "required": [
        "cluster_id",
        "namespace",
        "workload_type"
      ]
    },
    "MicroServiceInfoCCEServiceBase": {
      "description": "CCE云容器引擎Service信息",
      "properties": {
        "cluster_id": {
          "type": "string",
          "description": "云容器引擎集群编号",
          "example": "fde2c21c-5bd9-40f0-ad6a-81e4b6782805a",
          "maxLength": 64
        },
        "namespace": {
          "type": "string",
          "description": "命名空间。1-63字符。只能包含小写字母、数字,以及 '-',必须以字母开头,必须以字母数字结尾。",
          "example": "default",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^([a-z])([a-z0-9-]){0,62}$"
        },
        "service_name": {
          "type": "string",
          "description": "Service名称。支持汉字,英文,数字,点,中划线,下划线,且只能以英文和汉字开头,1-64字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "example": "name",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9._-]|[\\一-\\龥]){1,64}$"
        }
      },
      "required": [
        "cluster_id",
        "namespace",
        "service_name"
      ]
    },
    "MicroServiceCreate": {
      "description": "微服务详情。",
      "properties": {
        "service_type": {
          "type": "string",
          "description": "微服务类型。\n- CSE:CSE微服务注册中心\n- CCE:CCE云容器引擎(工作负载)\n- CCE_SERVICE:CCE云容器引擎(Service)(暂不支持)\n- NACOS:nacos注册中心,nacos_info必填",
          "enum": [
            "CSE",
            "CCE",
            "CCE_SERVICE",
            "NACOS"
          ],
          "example": "CSE"
        },
        "cse_info": {
          "$ref": "#/definitions/MicroServiceInfoCSEBase"
        },
        "cce_info": {
          "$ref": "#/definitions/MicroServiceInfoCCEBase"
        },
        "cce_service_info": {
          "$ref": "#/definitions/MicroServiceInfoCCEServiceBase"
        },
        "nacos_info": {
          "description": "nacos基础信息。",
          "$ref": "#/definitions/MicroServiceInfoNacosBase"
        }
      }
    },
    "MemberGroupCreate": {
      "required": [
        "member_group_name"
      ],
      "properties": {
        "member_group_name": {
          "description": "VPC通道后端服务器组名称。支持汉字、英文、数字、下划线、中划线、点,且只能以英文和汉字开头,3-64字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string"
        },
        "member_group_remark": {
          "description": "VPC通道后端服务器组描述。",
          "maxLength": 255,
          "type": "string"
        },
        "member_group_weight": {
          "description": "VPC通道后端服务器组权重值。\n\n当前服务器组存在服务器且此权重值存在时,自动使用此权重值分配权重。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 100
        },
        "dict_code": {
          "description": "VPC通道后端服务器组的字典编码\n\n支持英文,数字,特殊字符(-_.)\n\n暂不支持",
          "type": "string",
          "pattern": "([a-zA-Z0-9._-]){2,63}$",
          "minLength": 3,
          "maxLength": 64
        },
        "microservice_version": {
          "description": "VPC通道后端服务器组的版本,仅VPC通道类型为微服务时支持。",
          "type": "string",
          "maxLength": 64
        },
        "microservice_port": {
          "description": "VPC通道后端服务器组的端口号,仅VPC通道类型为微服务时支持。端口号为0时后端服务器组下的所有地址沿用原来负载端口继承逻辑。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 65535,
          "example": 80
        },
        "microservice_labels": {
          "description": "VPC通道后端服务器组的标签,仅VPC通道类型为微服务时支持。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MicroserviceLabel"
          }
        },
        "reference_vpc_channel_id": {
          "description": "引用的负载通道编号,仅VPC通道类型为引用类型(vpc_channel_type=reference)时支持。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        }
      }
    },
    "MicroServiceInfoCCEService": {
      "description": "CCE微服务Service信息",
      "allOf": [
        {
          "$ref": "#/definitions/MicroServiceInfoCCEServiceBase"
        },
        {
          "type": "object",
          "properties": {
            "cluster_name": {
              "type": "string",
              "description": "云容器引擎集群名称",
              "example": "cluster001"
            }
          }
        }
      ]
    },
    "MicroServiceInfoCSE": {
      "description": "CSE微服务详细信息",
      "allOf": [
        {
          "$ref": "#/definitions/MicroServiceInfoCSEBase"
        },
        {
          "type": "object",
          "properties": {
            "engine_name": {
              "type": "string",
              "description": "微服务引擎名称",
              "example": "engine001"
            },
            "service_name": {
              "type": "string",
              "description": "微服务名称",
              "example": "service001"
            },
            "register_address": {
              "type": "string",
              "description": "注册中心地址",
              "example": "https://1.2.3.4:8888"
            },
            "cse_app_id": {
              "type": "string",
              "description": "微服务所属的应用",
              "example": "default"
            },
            "version": {
              "type": "string",
              "description": "微服务的版本,已废弃,通过后端服务器组中的版本承载。",
              "example": "v1",
              "maxLength": 64
            }
          }
        }
      ]
    },
    "MemberBase": {
      "properties": {
        "host": {
          "description": "后端服务器地址\n\n后端实例类型为ip时必填",
          "type": "string",
          "maxLength": 255
        },
        "weight": {
          "description": "权重值。\n\n允许您对后端服务进行评级,权重值越大,转发到该云服务的请求数量越多。",
          "minimum": 0,
          "maximum": 10000,
          "type": "integer",
          "format": "int32"
        },
        "is_backup": {
          "description": "是否备用节点。\n\n开启后对应后端服务为备用节点,仅当非备用节点全部故障时工作。\n\n实例需要升级到对应版本才支持此功能,如果不支持请联系技术支持。",
          "type": "boolean",
          "default": false
        },
        "member_group_name": {
          "description": "后端服务器组名称。为后端服务地址选择服务器组,便于统一修改对应服务器组的后端地址。",
          "type": "string"
        },
        "status": {
          "description": "后端服务器状态\n  - 1:可用\n  - 2:不可用",
          "enum": [
            1,
            2
          ],
          "type": "integer",
          "format": "int32"
        },
        "port": {
          "description": "后端服务器端口",
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "format": "int32"
        }
      }
    },
    "VpcHealthConfigBase": {
      "description": "健康检查详情。",
      "required": [
        "protocol",
        "threshold_normal",
        "threshold_abnormal",
        "time_interval"
      ],
      "properties": {
        "protocol": {
          "description": "使用以下协议,对VPC中主机执行健康检查:\n- TCP\n- HTTP\n- HTTPS",
          "enum": [
            "TCP",
            "HTTP",
            "HTTPS"
          ],
          "type": "string"
        },
        "path": {
          "description": "健康检查时的目标路径。protocol = http或https时必选",
          "type": "string"
        },
        "method": {
          "description": "健康检查时的请求方法",
          "enum": [
            "GET",
            "HEAD"
          ],
          "default": "GET",
          "type": "string"
        },
        "port": {
          "description": "健康检查的目标端口,缺少或port = 0时为VPC中主机的端口号。\n\n如果此端口存在非0值,则使用此端口进行健康检查。",
          "minimum": 0,
          "maximum": 65535,
          "type": "integer",
          "format": "int32"
        },
        "threshold_normal": {
          "description": "正常阈值。判定VPC通道中主机正常的依据为:连续检查x成功,x为您设置的正常阈值。",
          "minimum": 1,
          "maximum": 10,
          "type": "integer",
          "format": "int32"
        },
        "threshold_abnormal": {
          "description": "异常阈值。判定VPC通道中主机异常的依据为:连续检查x失败,x为您设置的异常阈值。",
          "minimum": 1,
          "maximum": 10,
          "type": "integer",
          "format": "int32"
        },
        "time_interval": {
          "description": "间隔时间:连续两次检查的间隔时间,单位为秒。必须大于timeout字段取值。",
          "minimum": 1,
          "maximum": 300,
          "type": "integer",
          "format": "int32"
        },
        "http_code": {
          "description": "检查目标HTTP响应时,判断成功使用的HTTP响应码。取值范围为100到599之前的任意整数值,支持如下三种格式:\n- 多个值,如:200,201,202\n- 一系列值,如:200-299\n- 组合值,如:201,202,210-299\nprotocol = http时必选",
          "type": "string"
        },
        "enable_client_ssl": {
          "description": "是否开启双向认证。如果开启,则使用实例配置中的backend_client_certificate配置项的证书",
          "type": "boolean",
          "default": false
        },
        "status": {
          "description": "健康检查状态\n  - 1:可用\n  - 2:不可用",
          "enum": [
            1,
            2
          ],
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "NacosUserInfo": {
      "description": "nacos用户信息。",
      "required": [
        "user_name",
        "password"
      ],
      "properties": {
        "user_name": {
          "type": "string",
          "description": "nacos用户名。",
          "minLength": 1,
          "maxLength": 64
        },
        "password": {
          "type": "string",
          "description": "nacos密码。",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "NacosServerConfig": {
      "description": "nacos服务端配置信息。",
      "required": [
        "ip_address",
        "port"
      ],
      "properties": {
        "ip_address": {
          "type": "string",
          "description": "nacos服务端IP地址。不包含中文字符。",
          "example": "127.0.0.1",
          "pattern": "^[^\\一-\\龥]*$",
          "minLength": 7,
          "maxLength": 128
        },
        "port": {
          "type": "integer",
          "description": "nacos服务端端口号。取值范围1 ~ 65535。",
          "format": "int32",
          "minimum": 1,
          "maximum": 65535
        },
        "grpc_port": {
          "type": "integer",
          "description": "nacos服务端gRPC端口号,默认为port+1000。取值范围1 ~ 65535。",
          "format": "int32",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "MemberGroupInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/MemberGroupCreate"
        },
        {
          "type": "object",
          "properties": {
            "member_group_id": {
              "description": "VPC通道后端服务器组编号",
              "type": "string"
            },
            "create_time": {
              "description": "VPC通道后端服务器组创建时间",
              "type": "string",
              "format": "date-time"
            },
            "update_time": {
              "description": "VPC通道后端服务器组更新时间",
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "MicroServiceInfo": {
      "description": "微服务的响应对象",
      "properties": {
        "id": {
          "type": "string",
          "description": "微服务编号",
          "example": "a802aead5122433a91ea7df2c45c2a58"
        },
        "instance_id": {
          "type": "string",
          "description": "实例编号",
          "example": "eddc4d25480b4cd6b512f270a1b8b341"
        },
        "service_type": {
          "type": "string",
          "description": "微服务类型。\n- CSE:CSE微服务注册中心\n- CCE:CCE云容器引擎(工作负载)\n- CCE_SERVICE:CCE云容器引擎(Service)(暂不支持)\n- NACOS:nacos引擎,nacos_info必填",
          "enum": [
            "CSE",
            "CCE",
            "CCE_SERVICE",
            "NACOS"
          ],
          "example": "CSE"
        },
        "cse_info": {
          "$ref": "#/definitions/MicroServiceInfoCSE"
        },
        "cce_info": {
          "$ref": "#/definitions/MicroServiceInfoCCE"
        },
        "cce_service_info": {
          "$ref": "#/definitions/MicroServiceInfoCCEService"
        },
        "nacos_info": {
          "description": "nacos基础信息。",
          "$ref": "#/definitions/MicroServiceInfoNacosBase"
        },
        "update_time": {
          "type": "string",
          "format": "date-time",
          "description": "微服务更新时间",
          "example": "2020-11-02T12:31:23.353Z"
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "微服务创建时间",
          "example": "2020-11-02T12:31:23.353Z"
        }
      }
    },
    "VpcCreate": {
      "allOf": [
        {
          "$ref": "#/definitions/VpcBase"
        },
        {
          "type": "object",
          "properties": {
            "member_groups": {
              "description": "VPC通道后端服务器组列表。当microservice_info中service_type为NACOS类型时,服务器组的权重不支持手动设置。",
              "type": "array",
              "items": {
                "$ref": "#/definitions/MemberGroupCreate"
              }
            },
            "members": {
              "description": "VPC后端实例列表。\n\n对于引用负载通道类型的负载通道,不会使用此字段新增或更新后端实例。",
              "type": "array",
              "items": {
                "$ref": "#/definitions/MemberInfo"
              }
            },
            "vpc_health_config": {
              "$ref": "#/definitions/VpcHealthConfig"
            },
            "microservice_info": {
              "$ref": "#/definitions/MicroServiceCreate"
            }
          }
        }
      ]
    },
    "MicroServiceInfoCSEBase": {
      "description": "CSE微服务详细信息,service_type为CSE时必填",
      "properties": {
        "engine_id": {
          "type": "string",
          "description": "微服务引擎编号",
          "example": "fde2c21c-5bd9-40f0-ad6a-81e4b6782805a",
          "maxLength": 64
        },
        "service_id": {
          "type": "string",
          "description": "微服务编号",
          "example": "92919f98fba80c2df13cc285c983946c90e635ff",
          "maxLength": 64
        }
      },
      "required": [
        "engine_id",
        "service_id"
      ]
    },
    "MicroserviceLabel": {
      "required": [
        "label_name",
        "label_value"
      ],
      "properties": {
        "label_name": {
          "type": "string",
          "description": "标签名称。\n\n以字母或者数字开头和结尾,由字母、数字、连接符('-')、下划线('_')、点号('.')组成且63个字符之内。",
          "example": "clusterid",
          "pattern": "^[a-zA-Z0-9]$|(^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,61})[a-zA-Z0-9]$)",
          "minLength": 1,
          "maxLength": 63
        },
        "label_value": {
          "type": "string",
          "description": "标签值。\n\n以字母或者数字开头和结尾,由字母、数字、连接符('-')、下划线('_')、点号('.')组成且63个字符之内。",
          "example": "c429700c-5dc4-482a-9c0e-99f6c0635113",
          "pattern": "^[a-zA-Z0-9]$|(^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,61})[a-zA-Z0-9]$)",
          "minLength": 1,
          "maxLength": 63
        }
      }
    },
    "VpcBase": {
      "required": [
        "name",
        "port",
        "member_type",
        "balance_strategy"
      ],
      "properties": {
        "name": {
          "description": "VPC通道的名称。\n\n长度为3 ~ 64位的字符串,字符串由中文、英文字母、数字、中划线、下划线、点组成,且只能以英文或中文开头。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9-_.]|[\\一-\\龥]){2,63}$"
        },
        "port": {
          "description": "VPC通道中主机的端口号。\n\n取值范围1 ~ 65535。",
          "type": "integer",
          "format": "int32"
        },
        "balance_strategy": {
          "description": "分发算法。\n- 1:加权轮询(wrr)\n- 2:加权最少连接(wleastconn)\n- 3:源地址哈希(source)\n- 4:URI哈希(uri)",
          "type": "integer",
          "format": "int32",
          "enum": [
            1,
            2,
            3,
            4
          ],
          "default": 1
        },
        "member_type": {
          "description": "VPC通道的成员类型。\n- ip\n- ecs",
          "type": "string",
          "enum": [
            "ip",
            "ecs"
          ],
          "default": "ecs"
        },
        "type": {
          "description": "vpc通道类型,默认为服务器类型。\n- 2:服务器类型\n- 3:微服务类型\n\n当vpc_channel_type字段为空时,负载通道类型由type字段控制:\n当type不为3或microservice_info为空,VCP通道类型默认为服务器类型。\n当type=3,microservice_info不为空,VPC通道类型为微服务类型。\n\n修改负载通道时vpc通道类型不会修改,直接使用原有的vpc通道类型。\n\n请优先使用vpc_channel_type字段指定负载通道类型。",
          "type": "integer",
          "enum": [
            2,
            3
          ],
          "default": 2,
          "example": 2
        },
        "vpc_channel_type": {
          "description": "vpc通道类型。\n- builtin:服务器类型\n- microservice: 微服务类型\n- reference:引用负载通道类型\n\n当vpc_channel_type为空时,负载通道类型取决于type字段的取值。\n当vpc_channel_type不为空,但type字段非空或不为0时,当vpc_channel_type的指定类型与type字段指定的类型冲突时会校验报错。\n当vpc_channel_type不为空,且type字段为空或等于0时,直接使用vpc_channel_type字段的值指定负载通道类型。\n\n修改负载通道时vpc通道类型不会修改,直接使用原有的vpc通道类型。",
          "type": "string",
          "enum": [
            "builtin",
            "microservice",
            "reference"
          ],
          "example": "reference"
        },
        "dict_code": {
          "description": "VPC通道的字典编码\n\n支持英文,数字,特殊字符(-_.)\n\n暂不支持",
          "type": "string",
          "pattern": "([a-zA-Z0-9._-]){2,63}$",
          "minLength": 3,
          "maxLength": 64
        }
      }
    },
    "VpcHealthConfig": {
      "description": "健康检查详情。",
      "required": [
        "timeout"
      ],
      "allOf": [
        {
          "$ref": "#/definitions/VpcHealthConfigBase"
        },
        {
          "type": "object",
          "properties": {
            "timeout": {
              "description": "超时时间:检查期间,无响应的时间,单位为秒。必须小于time_interval字段取值。",
              "minimum": 1,
              "maximum": 30,
              "type": "integer",
              "format": "int32"
            }
          }
        }
      ]
    },
    "MemberInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/MemberBase"
        },
        {
          "type": "object",
          "properties": {
            "ecs_id": {
              "description": "后端云服务器的编号。\n\n后端实例类型为ecs时必填,支持英文,数字,“-”,“_”,1 ~ 64字符。",
              "type": "string",
              "maxLength": 255
            },
            "ecs_name": {
              "description": "后端云服务器的名称。\n\n后端实例类型为ecs时必填,支持汉字,英文,数字,“-”,“_”,“.”,1 ~ 64字符。",
              "type": "string",
              "maxLength": 64
            }
          }
        }
      ]
    },
    "VpcChannelInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/VpcBase"
        },
        {
          "type": "object",
          "properties": {
            "create_time": {
              "description": "VPC通道的创建时间",
              "type": "string",
              "format": "date-time"
            },
            "id": {
              "description": "VPC通道的编号",
              "type": "string"
            },
            "status": {
              "description": "VPC通道的状态。\n- 1:正常\n- 2:异常",
              "enum": [
                1,
                2
              ],
              "type": "integer",
              "format": "int32"
            },
            "member_groups": {
              "description": "后端云服务器组列表。",
              "type": "array",
              "items": {
                "$ref": "#/definitions/MemberGroupInfo"
              }
            },
            "microservice_info": {
              "$ref": "#/definitions/MicroServiceInfo"
            }
          }
        }
      ]
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "MicroServiceInfoNacosBase": {
      "description": "nacos微服务详细信息。",
      "required": [
        "service_name",
        "server_config",
        "user_info"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "description": "命名空间ID,当选择默认命名空间public时,此项为空。由字母、数字、连接符('-')、下划线('_')组成且64个字符之内。",
          "example": "e525eafa-f7d7-4029-83d9-008937f9d468",
          "pattern": "^[\\w-]+$",
          "minLength": 0,
          "maxLength": 64
        },
        "cluster_name": {
          "type": "string",
          "description": "集群名称,默认为DEFAULT。由字母、数字、连接符('-')、下划线('_')组成且64个字符之内。",
          "pattern": "^[0-9a-zA-Z-_]+$",
          "minLength": 0,
          "maxLength": 64
        },
        "group_name": {
          "type": "string",
          "description": "分组名称,默认为DEFAULT_GROUP。由字母、数字、连接符('-')、下划线('_')、点号('.')、冒号(':')组成且128个字符之内。",
          "pattern": "^[a-zA-Z0-9-_:\\.]*$",
          "minLength": 0,
          "maxLength": 128
        },
        "service_name": {
          "type": "string",
          "description": "微服务名称。不包含中文和@@,不得以@开头,512个字符以内。",
          "pattern": "^(?!@).((?!@@)[^\\一-\\龥])*$",
          "minLength": 1,
          "maxLength": 512
        },
        "server_config": {
          "description": "nacos服务端配置信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/NacosServerConfig"
          },
          "minItems": 1,
          "maxItems": 9
        },
        "user_info": {
          "$ref": "#/definitions/NacosUserInfo"
        }
      }
    },
    "MicroServiceInfoCCE": {
      "description": "CCE微服务工作负载信息",
      "allOf": [
        {
          "$ref": "#/definitions/MicroServiceInfoCCEBase"
        },
        {
          "type": "object",
          "properties": {
            "cluster_name": {
              "type": "string",
              "description": "云容器引擎集群名称",
              "example": "cluster001"
            }
          }
        }
      ]
    }
  },
