{
  "name": "ResettingTheAppSecret",
  "summary": "重置密钥",
  "tags": "共享版-APP管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/apigw/apps/secret/{app_id}": {
      "put": {
        "summary": "重置密钥",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "description": "重置指定APP的密钥。",
        "schemes": [
          "https"
        ],
        "tags": [
          "共享版-APP管理"
        ],
        "operationId": "ResettingTheAppSecret",
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/AppResp"
            },
            "examples": {
              "application/json": {
                "creator": "USER",
                "update_time": "2017-12-28T12:26:54.2345858Z",
                "app_key": "d49b1cbf-cc81-4a5f-b2a0-61b568e376eb",
                "name": "app_001",
                "remark": "第一个应用",
                "id": "14b399ac-967f-4115-bb62-c0346b4537e9",
                "app_secret": "******",
                "register_time": "2017-12-28T12:26:54.2345858Z",
                "status": 1
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "required": true
          },
          {
            "in": "path",
            "name": "app_id",
            "x-example": "57e7248244ee457cb0ddb64b012f4cbe",
            "description": "APP的编号,可通过查询APP列表获取",
            "type": "string",
            "required": true
          },
          {
            "in": "body",
            "name": "ResettingTheAppSecretRequestBody",
            "description": "重置密钥的请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AppSecretReq"
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "AppSecretReq": {
      "required": [
        "app_secret"
      ],
      "properties": {
        "app_secret": {
          "type": "string",
          "example": "ap******le",
          "description": "密钥支持英文,数字,“_”,“-”,“_”,“!”,“@”,“#”,“$”,“%”,且只能以英文或数字开头,8 ~ 64个字符。用户自定义APP的密钥需要开启配额开关"
        }
      }
    },
    "AppResp": {
      "properties": {
        "creator": {
          "description": "APP的创建者\n- USER:用户自行创建\n- MARKET:云市场分配",
          "type": "string",
          "example": "USER"
        },
        "update_time": {
          "description": "更新时间",
          "type": "string",
          "example": "2017-12-28T12:28:07.2966182Z"
        },
        "app_key": {
          "description": "APP的key",
          "type": "string",
          "example": "14b399ac-967f-4115-bb62-c0346b4537e9"
        },
        "name": {
          "description": "名称",
          "type": "string",
          "example": "app_sample"
        },
        "remark": {
          "description": "描述",
          "type": "string",
          "example": "第一个APP"
        },
        "id": {
          "description": "编号",
          "type": "string"
        },
        "app_secret": {
          "description": "密钥",
          "type": "string"
        },
        "register_time": {
          "description": "注册时间",
          "type": "string",
          "example": "2017-12-28T12:26:54Z"
        },
        "status": {
          "description": "状态",
          "type": "integer",
          "example": 1
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v1.0",
  "info_version": "v1",
  "method": "put",
  "uri": null
}