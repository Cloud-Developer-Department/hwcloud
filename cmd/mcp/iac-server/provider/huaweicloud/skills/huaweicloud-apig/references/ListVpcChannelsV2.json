              "description": "VPC通道后端服务器组更新时间",
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "VpcChannelInfoPage": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "vpc_channels": {
              "description": "本次查询到的VPC通道列表",
