          "example": "e525eafa-f7d7-4029-83d9-008937f9d468",
          "pattern": "^[\\w-]+$",
          "minLength": 0,
          "maxLength": 64
        },
        "cluster_name": {
          "type": "string",
          "description": "集群名称,默认为DEFAULT。由字母、数字、连接符('-')、下划线('_')组成且64个字符之内。",
          "pattern": "^[0-9a-zA-Z-_]+$",
          "minLength": 0,
          "maxLength": 64
        },
        "group_name": {
          "type": "string",
          "description": "分组名称,默认为DEFAULT_GROUP。由字母、数字、连接符('-')、下划线('_')、点号('.')、冒号(':')组成且128个字符之内。",
          "pattern": "^[a-zA-Z0-9-_:\\.]*$",
          "minLength": 0,
          "maxLength": 128
        },
        "service_name": {
          "type": "string",
