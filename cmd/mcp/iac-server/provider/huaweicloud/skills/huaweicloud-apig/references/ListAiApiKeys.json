{
  "name": "ListAiApiKeys",
  "summary": "查询AIAPIKey列表",
  "tags": "专享版-凭据管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/{project_id}/apigw/instances/{instance_id}/apps/{app_id}/ai-api-keys": {
      "get": {
        "description": "查询AIAPIKey列表。",
        "operationId": "ListAiApiKeys",
        "schemes": [
          "https"
        ],
        "summary": "查询AIAPIKey列表",
        "tags": [
          "专享版-凭据管理"
        ],
        "x-apigateway-request-type": "public",
        "x-api-type": "open-api",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-is-registered": "Y",
        "x-produc-type": "apig",
        "x-open-region-cloud": "hws,hws_hk",
        "x-support-sdk": "Y",
        "x-sec-authority-parameter-url": "project_id,instance_id,app_id",
        "x-sec-authority-parameter-body": null,
        "x-sec-sensitiveinfo": null,
        "x-sec-userinput-untrust": null,
        "x-sec-privacy-parameter": null,
        "x-sec-auditlog": "Y",
        "x-sec-upload-download": 0,
        "x-api-highrisk": "N",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_app_id"
          },
          {
            "$ref": "#/parameters/apic_offset"
          },
          {
            "$ref": "#/parameters/apic_limit"
          }
        ],
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/AiApiKeyPageInfo"
            },
            "examples": {
              "application/json": {
                "total": 2,
                "size": 2,
                "ai_api_keys": [
                  {
                    "ai_api_key": "GjOD3g80AABu*******8LcCcPZN",
                    "alias": "test1",
                    "app_id": "9ed8b7fe84224de681e7d7a5587e76dc",
                    "create_time": "2020-07-24T02:37:24Z",
                    "id": "32dc8ca22d1b4b9cb94022186880576b"
                  },
                  {
                    "ai_api_key": "fdc8d90a301*******13b6f572a",
                    "alias": "test2",
                    "app_id": "9ed8b7fe84224de681e7d7a5587e76dc",
                    "create_time": "2020-07-24T02:31:45Z",
                    "id": "b3d34f746d0847fb95138670e10207ed"
                  }
                ]
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:app_id. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3004",
                "error_msg": "App 9ed8b7fe84224de681e7d7a5587e76dc does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "AiApiKeyBaseInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/AiApiKeyCreate"
        },
        {
          "type": "object",
          "properties": {
            "app_id": {
              "description": "凭据编号。",
              "type": "string",
              "minLength": 32,
              "maxLength": 36,
              "example": "cfef79a8fb104923ba1bd5940d0ca2c3"
            },
            "create_time": {
              "description": "创建时间。",
              "type": "string",
              "format": "date-time",
              "example": "2022-11-02T12:31:23.353Z"
            },
            "id": {
              "description": "AIAPIKey编号。",
              "type": "string",
              "minLength": 32,
              "maxLength": 36,
              "example": "cabc79a8fb104923ba1bd5940d0ca2c3"
            }
          }
        }
      ]
    },
    "BasePage": {
      "properties": {
        "size": {
          "description": "本次返回的列表长度",
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "description": "满足条件的记录数",
          "type": "integer",
          "format": "int64"
        }
      },
      "description": "分页基本信息",
      "required": [
        "size",
        "total"
      ]
    },
    "AiApiKeyPageInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "ai_api_keys": {
              "description": "AIAPIKey列表,展示匿名化的已经创建的AIAPIKey。\nAIAPIKey的创建数量上限可以通过配额调整。",
              "type": "array",
              "items": {
                "$ref": "#/definitions/AiApiKeyBaseInfo"
              },
              "minItems": 0
            }
          }
        }
      ]
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "AiApiKeyCreate": {
      "properties": {
        "ai_api_key": {
          "description": "AIAPIKey值,不指定具体值时,由后台自动生成随机字符串。\n支持大小写英文字母、数字,以及+-_/=特殊字符,长度为8~128个字符。",
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9+\\-_/=]{8,128}$",
          "example": 1234567890
        },
        "alias": {
          "description": "AIAPIKey的别名。支持大小写字母,数字,下划线,中划线,长度为1~100个字符。",
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "example": "key_009"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_app_id": {
      "name": "app_id",
      "in": "path",
      "type": "string",
      "description": "凭据编号",
      "required": true,
      "x-example": "98df09fb-d459-4cbf-83a7-2b55ca6f3d5d",
      "pattern": "^[a-zA-Z0-9-_]{0,64}$"
    },
    "apic_offset": {
      "name": "offset",
      "in": "query",
      "type": "integer",
      "description": "偏移量,表示从此偏移量开始查询,偏移量小于0时,自动转换为0",
      "format": "int64",
      "default": 0,
      "x-example": 1
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID,在API网关控制台的“实例信息”中获取。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见[获取项目ID](apig-api-180713009.xml)。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "apic_limit": {
      "name": "limit",
      "in": "query",
      "type": "integer",
      "description": "每页显示的条目数量,条目数量小于等于0时,自动转换为20,条目数量大于500时,自动转换为500",
      "format": "int32",
      "minimum": 1,
      "maximum": 500,
      "default": 20,
      "x-example": 10
    }
  },
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
  "uri": null
}