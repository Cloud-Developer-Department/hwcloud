{
  "name": "CheckAnApp",
  "summary": "校验APP",
  "tags": "共享版-APP管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/apigw/apps/validation/{app_id}": {
      "get": {
        "summary": "校验APP",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "description": "校验app是否存在,非APP所有者可以调用该接口校验APP是否真实存在。这个接口只展示app的基本信息id 、name、 remark,其他信息不显示。",
        "schemes": [
          "https"
        ],
        "tags": [
          "共享版-APP管理"
        ],
        "operationId": "CheckAnApp",
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/AppValidationResp"
            },
            "examples": {
              "application/json": {
                "name": "app_001",
                "remark": "第一个APP",
                "id": "14b399ac-967f-4115-bb62-c0346b4537e9"
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "required": true
          },
          {
            "in": "path",
            "name": "app_id",
            "x-example": "57e7248244ee457cb0ddb64b012f4cbe",
            "description": "APP的编号",
            "type": "string",
            "required": true
          }
        ]
      }
    }
  },
  "definitions": {
    "AppValidationResp": {
      "required": [
        "id"
      ],
      "properties": {
        "name": {
          "description": "名称",
          "type": "string"
        },
        "remark": {
          "description": "描述",
          "type": "string"
        },
        "id": {
          "description": "编号",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v1.0",
  "info_version": "v1",
  "method": "get",
  "uri": null
}