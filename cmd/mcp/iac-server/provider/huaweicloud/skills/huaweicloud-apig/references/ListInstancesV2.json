    "apic_limit": {
      "name": "limit",
      "in": "query",
      "type": "integer",
      "description": "每页显示的条目数量,条目数量小于等于0时,自动转换为20,条目数量大于500时,自动转换为500",
      "format": "int32",
      "minimum": 1,
      "maximum": 500,
      "default": 20,
      "x-example": 10
    }
  },
