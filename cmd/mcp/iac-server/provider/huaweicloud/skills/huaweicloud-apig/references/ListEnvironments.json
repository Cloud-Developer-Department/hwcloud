                "total": 2,
                "size": 2,
                "envs": [
                  {
                    "create_time": "2017-12-29T03:39:03.165657Z",
                    "name": "RELEASE",
                    "remark": "生产环境",
                    "id": "DEFAULT_ENVIRONMENT_RELEASE_ID"
                  },
                  {
                    "create_time": "2017-12-28T12:50:47Z",
                    "name": "DEVELOP",
                    "remark": "开发环境",
                    "id": "cca3616a-f368-4b32-9064-b2a631cb3eeb"
                  }
                ]
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "required": true
          },
          {
            "in": "query",
            "name": "name",
            "x-example": "env_name",
            "description": "环境名称",
            "type": "string",
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "x-example": 20,
            "description": "每页显示的条数,默认值:20",
            "type": "integer",
            "required": false
          },
          {
            "in": "query",
            "name": "offset",
            "x-example": 1,
            "description": "页码,默认值:1",
            "type": "integer",
            "required": false
          }
        ]
      }
    }
  },
  "definitions": {
