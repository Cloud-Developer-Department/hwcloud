          "type": "string"
        },
        "name": {
          "description": "环境名称",
          "type": "string"
        },
        "remark": {
          "description": "描述信息",
          "type": "string"
        },
        "id": {
          "description": "环境id",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
