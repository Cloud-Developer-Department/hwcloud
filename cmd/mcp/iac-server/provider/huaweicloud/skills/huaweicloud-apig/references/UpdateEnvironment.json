{
  "name": "UpdateEnvironment",
  "summary": "修改环境",
  "tags": "共享版-环境管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/apigw/envs/{env_id}": {
      "put": {
        "summary": "修改环境",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "description": "修改指定环境的信息。其中可修改的属性为:name、remark,其它属性不可修改。",
        "schemes": [
          "https"
        ],
        "tags": [
          "共享版-环境管理"
        ],
        "operationId": "UpdateEnvironment",
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/EnvResp"
            },
            "examples": {
              "application/json": {
                "create_time": "2017-12-28T12:50:47.0744311Z",
                "name": "DEV",
                "remark": "开发环境",
                "id": "cca3616a-f368-4b32-9064-b2a631cb3eeb"
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "required": true
          },
          {
            "in": "path",
            "name": "env_id",
            "x-example": "57e7248244ee457cb0ddb64b012f4cbe",
            "description": "环境的ID,可通过查询环境信息获取该ID",
            "type": "string",
            "required": true
          },
          {
            "schema": {
              "$ref": "#/definitions/EnvReq"
            },
            "in": "body",
            "name": "UpdateEnvironmentRequestBody",
            "description": "创建环境的请求体",
            "required": true
          }
        ]
      }
    }
  },
  "definitions": {
    "EnvReq": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "环境的名称,支持英文,数字,下划线,且只能以英文字母开头,3 ~ 64字符。",
          "type": "string",
          "example": "DEV"
        },
        "remark": {
          "description": "描述信息,字符长度不能大于255\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "开发环境"
        }
      }
    },
    "EnvResp": {
      "properties": {
        "create_time": {
          "description": "创建时间",
          "type": "string"
        },
        "name": {
          "description": "环境名称",
          "type": "string"
        },
        "remark": {
          "description": "描述信息",
          "type": "string"
        },
        "id": {
          "description": "环境id",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v1.0",
  "info_version": "v1",
  "method": "put",
  "uri": null
}