{
  "name": "ListProjectCofigsV2",
  "summary": "查询某个实例的租户配置列表",
  "tags": "专享版-配置管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/{project_id}/apigw/instances/{instance_id}/project/configs": {
      "get": {
        "summary": "查询某个实例的租户配置列表",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-produc-type": "apig",
        "x-apigateway-request-type": "public",
        "x-order": 5,
        "description": "查询某个实例的租户配置列表,用户可以通过此接口查询各类型资源配置及使用情况。",
        "schemes": [
          "https"
        ],
        "tags": [
          "专享版-配置管理"
        ],
        "x-api-type": "open-api",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk,cmcc,ctc,dt,g42,hk_g42,hk_sbc,hk_tm,hws_eu,hws_ocb,ocb,sbc,tm,srg,ax",
        "operationId": "ListProjectCofigsV2",
        "parameters": [
          {
