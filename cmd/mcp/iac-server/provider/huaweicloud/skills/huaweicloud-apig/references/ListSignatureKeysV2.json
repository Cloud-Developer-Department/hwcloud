{
  "name": "ListSignatureKeysV2",
  "summary": "查询签名密钥列表",
  "tags": "专享版-签名密钥管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/{project_id}/apigw/instances/{instance_id}/signs": {
      "get": {
        "summary": "查询签名密钥列表",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-produc-type": "apig",
        "x-apigateway-request-type": "public",
        "x-order": 4,
        "description": "查询所有签名密钥的信息。",
        "schemes": [
          "https"
        ],
        "tags": [
          "专享版-签名密钥管理"
        ],
        "x-api-type": "open-api",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk,cmcc,ctc,dt,g42,hk_g42,hk_sbc,hk_tm,hws_eu,hws_ocb,ocb,sbc,tm,srg,ax",
        "operationId": "ListSignatureKeysV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_offset"
          },
          {
            "$ref": "#/parameters/apic_limit"
          },
          {
            "in": "query",
            "name": "id",
            "x-example": "0b0e8f456b8742218af75f945307173c",
            "description": "签名密钥编号",
            "type": "string",
            "required": false
          },
          {
            "in": "query",
            "name": "name",
            "x-example": "signature_demo",
            "description": "签名密钥名称",
            "type": "string",
            "required": false
          },
          {
            "in": "query",
            "name": "precise_search",
            "x-example": "name",
            "description": "指定需要精确匹配查找的参数名称,目前仅支持name",
            "type": "string",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/SignaturePage"
            },
            "examples": {
              "application/json": {
                "total": 2,
                "size": 2,
                "signs": [
                  {
                    "sign_secret": "sig************ret",
                    "update_time": "2018-02-07T02:00:27.964766Z",
                    "create_time": "2018-02-06T12:17:36Z",
                    "name": "signature_demo",
                    "id": "0b0e8f456b8742218af75f945307173c",
                    "sign_key": "signkeysignkey",
                    "sign_type": "hmac",
                    "bind_num": 0,
                    "ldapi_bind_num": 0
                  },
                  {
                    "sign_secret": "9ce************16a",
                    "update_time": "2020-07-30T03:56:58Z",
                    "create_time": "2020-07-30T03:56:58Z",
                    "name": "Signature_udlu",
                    "id": "9dc388382fba485aadd19f932303f4c9",
                    "sign_key": "ca50c5b670044c83b5b890a9a68a30d5",
                    "sign_type": "hmac",
                    "bind_num": 0,
                    "ldapi_bind_num": 0
                  }
                ]
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:name. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "SignaturePage": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "signs": {
              "description": "本次查询到的签名密钥列表",
              "type": "array",
              "items": {
                "$ref": "#/definitions/SignatureWithBindNum"
              }
            }
          }
        }
      ]
    },
    "BasePage": {
      "properties": {
        "size": {
          "description": "本次返回的列表长度",
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "description": "满足条件的记录数",
          "type": "integer",
          "format": "int64"
        }
      },
      "description": "分页基本信息",
      "required": [
        "size",
        "total"
      ]
    },
    "SignatureWithBindNum": {
      "allOf": [
        {
          "$ref": "#/definitions/Signature"
        },
        {
          "type": "object",
          "properties": {
            "update_time": {
              "description": "更新时间",
              "type": "string",
              "format": "date-time"
            },
            "create_time": {
              "description": "创建时间",
              "type": "string",
              "format": "date-time"
            },
            "id": {
              "description": "签名密钥的编号",
              "type": "string"
            },
            "bind_num": {
              "description": "绑定的API数量",
              "type": "integer",
              "format": "int32"
            },
            "ldapi_bind_num": {
              "description": "绑定的自定义后端数量\n\n暂不支持",
              "type": "integer",
              "format": "int32"
            }
          }
        }
      ]
    },
    "Signature": {
      "allOf": [
        {
          "$ref": "#/definitions/BaseSignature"
        },
        {
          "type": "object",
          "properties": {
            "update_time": {
              "description": "更新时间",
              "type": "string",
              "format": "date-time"
            },
            "create_time": {
              "description": "创建时间",
              "type": "string",
              "format": "date-time"
            },
            "id": {
              "description": "签名密钥的编号",
              "type": "string"
            }
          }
        }
      ]
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "BaseSignature": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "签名密钥的名称。支持汉字,英文,数字,下划线,且只能以英文和汉字开头。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9_]|[\\一-\\龥]){2,63}$",
          "example": "signature01"
        },
        "sign_type": {
          "description": "签名密钥类型:\n- hmac\n- basic\n- public_key\n- aes\n\nbasic类型需要实例升级到对应版本,如果不存在可联系技术工程师升级。\n\npublic_key类型开启实例配置public_key才可使用,实例特性配置详情请参考“附录 > 实例支持的APIG特性”,如确认实例不存在public_key配置可联系技术工程师开启。\n\naes类型需要实例升级到对应版本,如果不存在可联系技术工程师升级。",
          "enum": [
            "hmac",
            "basic",
            "public_key",
            "aes"
          ],
          "type": "string",
          "example": "hmac"
        },
        "sign_key": {
          "description": "签名密钥的key。\n- hmac类型的签名密钥key:支持英文,数字,下划线,中划线,且只能以英文字母或数字开头,8 ~ 32字符。未填写时后台自动生成。\n- basic类型的签名密钥key:支持英文,数字,下划线,中划线,且只能以英文字母开头,4 ~ 32字符。未填写时后台自动生成。\n- public_key类型的签名密钥key:支持英文,数字,下划线,中划线,+,/,=,可以英文字母,数字,+,/开头,8 ~ 512字符。未填写时后台自动生成。\n- aes类型的签名密钥key:支持英文,数字,下划线,中划线,!,@,#,$,%,+,/,=,可以英文字母,数字,+,/开头,签名算法为aes-128-cfb时为16个字符,签名算法为aes-256-cfb时为32个字符。未填写时后台自动生成。",
          "type": "string",
          "example": "abcd_123456789123456"
        },
        "sign_secret": {
          "description": "签名密钥的密钥。\n- hmac类型的签名密钥key:支持英文,数字,下划线,中划线,!,@,#,$,%,且只能以英文字母或数字开头,16 ~ 64字符。未填写时后台自动生成。\n- basic类型的签名密钥key:支持英文,数字,下划线,中划线,!,@,#,$,%,且只能以英文字母或数字开头,8 ~ 64字符。未填写时后台自动生成。\n- public_key类型的签名密钥key:支持英文,数字,下划线,中划线,!,@,#,$,%,+,/,=,可以英文字母,数字,+,/开头,16 ~ 2048字符。未填写时后台自动生成。\n- aes类型签名密钥使用的向量:支持英文,数字,下划线,中划线,!,@,#,$,%,+,/,=,可以英文字母,数字,+,/开头,16个字符。未填写时后台自动生成。",
          "type": "string",
          "example": "sig************ret"
        },
        "sign_algorithm": {
          "description": "签名算法。默认值为空,仅aes类型签名密钥支持选择签名算法,其他类型签名密钥不支持签名算法。",
          "enum": [
            "aes-128-cfb",
            "aes-256-cfb"
          ],
          "type": "string",
          "example": "aes-128-cfb"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_offset": {
      "name": "offset",
      "in": "query",
      "type": "integer",
      "description": "偏移量,表示从此偏移量开始查询,偏移量小于0时,自动转换为0",
      "format": "int64",
      "default": 0,
      "x-example": 1
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID,在API网关控制台的“实例信息”中获取。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见[获取项目ID](apig-api-180713009.xml)。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "apic_limit": {
      "name": "limit",
      "in": "query",
      "type": "integer",
      "description": "每页显示的条目数量,条目数量小于等于0时,自动转换为20,条目数量大于500时,自动转换为500",
      "format": "int32",
      "minimum": 1,
      "maximum": 500,
      "default": 20,
      "x-example": 10
    }
  },
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
  "uri": null
}