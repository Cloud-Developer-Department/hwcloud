{
  "name": "CreateAuthorizingApps",
  "summary": "APP授权",
  "tags": "共享版-APP授权管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/apigw/app-auths": {
      "post": {
        "summary": "APP授权",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "description": "APP创建成功后,还不能访问API,如果想要访问某个环境上的API,需要将该API在该环境上授权给APP。授权成功后,APP即可访问该环境上的这个API。",
        "schemes": [
          "https"
        ],
        "tags": [
          "共享版-APP授权管理"
        ],
        "operationId": "CreateAuthorizingApps",
        "responses": {
          "201": {
            "schema": {
              "$ref": "#/definitions/AppAuthListResp"
            },
            "examples": {
              "application/json": {
                "auths": [
                  {
                    "api_id": "8aa097b00e9843efabc9c593d11b769d",
                    "auth_result": "SUCCESS",
                    "auth_time": "2018-03-30T09:37:43.490197204Z",
                    "id": "dffcaff92d144135a9f420fcd485bbf3",
                    "app_id": "f8c6ea15-0d1b-4c5b-bd4b-911610bd3b3e",
                    "auth_role": "PROVIDER"
                  }
                ]
              }
            },
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "required": true
          },
          {
            "schema": {
              "$ref": "#/definitions/AppAuthReq"
            },
            "in": "body",
            "name": "CreateAuthorizingAppsRequestBody",
            "description": "APP授权的请求体",
            "required": true
          }
        ]
      }
    }
  },
  "definitions": {
    "AppAuthReq": {
      "required": [
        "api_ids",
        "app_ids",
        "env_id"
      ],
      "properties": {
        "env_id": {
          "description": "需要授权的环境编号",
          "type": "string",
          "example": "DEFAULT_ENVIRONMENT_RELEASE_ID"
        },
        "app_ids": {
          "description": "APP的编号列表",
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "f8c6ea15-0d1b-4c5b-bd4b-911610bd3b3e"
          ]
        },
        "api_ids": {
          "description": "API的编号列表,可以选择租户自己的API,也可以选择从云市场上购买的API。",
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": "8aa097b00e9843efabc9c593d11b769d"
        }
      }
    },
    "AppAuthListResp": {
      "properties": {
        "auths": {
          "description": "API与APP的授权关系列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/AppAuthResp"
          }
        }
      }
    },
    "AppAuthResp": {
      "properties": {
        "api_id": {
          "description": "API编号",
          "type": "string"
        },
        "auth_result": {
          "description": "授权结果:\n- SUCCESS:授权成功\n- SKIPPED:跳过",
          "type": "string"
        },
        "auth_time": {
          "description": "授权时间",
          "type": "string"
        },
        "id": {
          "description": "授权关系编号",
          "type": "string"
        },
        "app_id": {
          "description": "APP编号",
          "type": "string"
        },
        "auth_role": {
          "description": "授权者:\n- PROVIDER:API提供者授权\n- CONSUMER:API消费者授权",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v1.0",
  "info_version": "v1",
  "method": "post",
  "uri": null
}