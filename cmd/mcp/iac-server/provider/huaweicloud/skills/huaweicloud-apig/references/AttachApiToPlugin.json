{
  "name": "AttachApiToPlugin",
  "summary": "插件绑定API",
  "tags": "专享版-插件管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/{project_id}/apigw/instances/{instance_id}/plugins/{plugin_id}/attach": {
      "post": {
        "tags": [
          "专享版-插件管理"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-order": 6,
        "x-apigateway-request-type": "public",
        "x-open-region-cloud": "hws,hws_hk,cmcc,ctc,dt,g42,hk_g42,hk_sbc,hk_tm,hws_eu,hws_ocb,ocb,sbc,tm,srg,ax",
        "x-api-type": "open-api",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "operationId": "AttachApiToPlugin",
        "summary": "插件绑定API",
        "description": "绑定插件到API上。\n- 只能选择发布状态的API\n- 绑定以后及时生效\n- 修改插件后及时生效\n- 相同类型的插件只能绑定一个,如果再次绑定同类型的插件,那么已绑定的同类型插件将直接被覆盖。",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "name": "plugin_id",
            "type": "string",
            "required": true,
            "in": "path",
            "description": "插件编号",
            "x-example": "5b729aa252764739b3s237ef0d66dc63"
          },
          {
            "name": "AttachApiToPluginRequestBody",
            "required": true,
            "description": "插件绑定API请求体",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/PluginOperApiInfo"
            }
          }
        ],
        "x-request-examples-description-1": "将API绑定到插件上",
        "x-request-examples-1": {
          "env_id": "DEFAULT_ENVIRONMENT_RELEASE_ID",
          "api_ids": [
            "8aa097b00e9843efabc9c593d11b769d"
          ]
        },
        "responses": {
          "201": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/PluginApiAttachResult"
            },
            "examples": {
              "application/json": {
                "attached_plugins": [
                  {
                    "plugin_attach_id": "8aa097b00e9843efacb9c593d11b769e",
                    "plugin_id": "5b729aa252764739b3s237ef0d66dc63",
                    "plugin_name": "跨域插件",
                    "plugin_type": "cors",
                    "plugin_scope": "global",
                    "env_id": "DEFAULT_ENVIRONMENT_RELEASE_ID",
                    "env_name": "RELEASE",
                    "api_id": "8aa097b00e9843efabc9c593d11b769d",
                    "api_name": "api_name",
                    "attached_time": "2022-11-02T12:31:23.353Z"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:instance_id. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3068",
                "error_msg": "Plugin b294018ee0554156a875b3513e02e5b9 does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "PluginOperApiInfo": {
      "required": [
        "env_id",
        "api_ids"
      ],
      "properties": {
        "env_id": {
          "type": "string",
          "description": "绑定API的环境编码。",
          "example": "DEFAULT_ENVIRONMENT_RELEASE_ID"
        },
        "api_ids": {
          "type": "array",
          "description": "绑定的API编码列表。",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "string"
          },
          "example": [
            "8aa097b00e9843efabc9c593d11b769d"
          ]
        }
      }
    },
    "PluginApiAttachInfo": {
      "properties": {
        "plugin_attach_id": {
          "type": "string",
          "description": "插件绑定编码。",
          "example": "8aa097b00e9843efacb9c593d11b769e"
        },
        "plugin_id": {
          "type": "string",
          "description": "插件编码。",
          "example": "5b729aa252764739b3s237ef0d66dc63"
        },
        "plugin_name": {
          "type": "string",
          "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9_-]|[\\一-\\龥]){2,254}$",
          "description": "插件名称。支持汉字,英文,数字,中划线,下划线,且只能以英文和汉字开头,3-255字符\n> 中文字符必须为UTF-8或者unicode编码。",
          "example": "跨域插件"
        },
        "plugin_type": {
          "type": "string",
          "enum": [
            "cors",
            "set_resp_headers",
            "kafka_log",
            "breaker",
            "rate_limit",
            "third_auth",
            "proxy_cache",
            "proxy_mirror",
            "oidc_auth",
            "jwt_auth"
          ],
          "description": "插件类型。\n- cors:跨域资源共享\n- set_resp_headers:HTTP响应头管理\n- kafka_log:Kafka日志推送\n- breaker:断路器\n- rate_limit: 流量控制\n- third_auth: 第三方认证\n- proxy_cache: 响应缓存\n- proxy_mirror: 请求镜像\n- oidc_auth: OIDC认证\n- jwt_auth: JWT认证",
          "example": "cors"
        },
        "plugin_scope": {
          "type": "string",
          "enum": [
            "global"
          ],
          "description": "插件可见范围。global:全局可见。",
          "example": "global"
        },
        "env_id": {
          "type": "string",
          "description": "绑定API的环境编码。",
          "example": "DEFAULT_ENVIRONMENT_RELEASE_ID"
        },
        "env_name": {
          "description": "api授权绑定的环境名称",
          "type": "string",
          "example": "RELEASE"
        },
        "api_id": {
          "description": "绑定的API编码。",
          "type": "string",
          "example": "8aa097b00e9843efabc9c593d11b769d"
        },
        "api_name": {
          "description": "API的名称",
          "type": "string",
          "example": "测试API"
        },
        "attached_time": {
          "type": "string",
          "format": "date-time",
          "description": "绑定时间。",
          "example": "2020-11-02T12:31:23.353Z"
        }
      }
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "PluginApiAttachResult": {
      "properties": {
        "attached_plugins": {
          "type": "array",
          "description": "绑定插件信息列表。",
          "items": {
            "$ref": "#/definitions/PluginApiAttachInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID,在API网关控制台的“实例信息”中获取。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见[获取项目ID](apig-api-180713009.xml)。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "post",
  "uri": null
}