{
  "name": "UpdateSignatureKey",
  "summary": "修改签名密钥",
  "tags": "共享版-签名密钥管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/apigw/signs/{sign_id}": {
      "put": {
        "summary": "修改签名密钥",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "description": "修改指定签名密钥的详细信息。",
        "schemes": [
          "https"
        ],
        "tags": [
          "共享版-签名密钥管理"
        ],
        "operationId": "UpdateSignatureKey",
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/SignatureResp"
            },
            "examples": {
              "application/json": {
                "sign_secret": "sig******ret",
                "update_time": "2018-02-06T12:17:36.039954198Z",
                "create_time": "2018-02-06T12:17:36.039953112Z",
                "name": "signature01",
                "id": "3a793b65a9034bdfae08924f149bfb4a",
                "sign_key": "abcd_123456789123456"
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "required": true
          },
          {
            "in": "path",
            "name": "sign_id",
            "x-example": "57e7248244ee457cb0ddb64b012f4cbe",
            "description": "签名密钥编号",
            "type": "string",
            "required": true
          },
          {
            "schema": {
              "$ref": "#/definitions/SignatureReq"
            },
            "in": "body",
            "name": "UpdateSignatureKeyRequestBody",
            "description": "创建签名密钥的请求体",
            "required": true
          }
        ]
      }
    }
  },
  "definitions": {
    "SignatureResp": {
      "properties": {
        "sign_secret": {
          "description": "签名密钥的密钥",
          "type": "string"
        },
        "update_time": {
          "description": "更新时间",
          "type": "string"
        },
        "create_time": {
          "description": "创建时间",
          "type": "string"
        },
        "name": {
          "description": "签名密钥的名称",
          "type": "string"
        },
        "id": {
          "description": "签名密钥的编号",
          "type": "string"
        },
        "sign_key": {
          "description": "签名密钥的key",
          "type": "string"
        }
      }
    },
    "SignatureReq": {
      "required": [
        "name",
        "sign_key",
        "sign_secret"
      ],
      "properties": {
        "sign_secret": {
          "description": "签名密钥的密钥。支持英文,数字,下划线,中划线,!,@,#,$,%,且只能以英文字母开头,16 ~ 64字符。未填写时后台自动生成。",
          "type": "string",
          "example": "sig******ret"
        },
        "name": {
          "description": "签名密钥的名称。支持汉字,英文,数字,下划线,且只能以英文和汉字开头,3 ~ 64字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "signature01"
        },
        "sign_key": {
          "description": "签名密钥的key。支持英文,数字,下划线,中划线,且只能以英文字母开头,8 ~ 32字符。未填写时后台自动生成。",
          "type": "string",
          "example": "abcd_123456789123456"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v1.0",
  "info_version": "v1",
  "method": "put",
  "uri": null
}