{
  "name": "AssociateDomainV2",
  "summary": "绑定域名",
  "tags": "专享版-域名管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/{project_id}/apigw/instances/{instance_id}/api-groups/{group_id}/domains": {
      "post": {
        "summary": "绑定域名",
        "tags": [
          "专享版-域名管理"
        ],
        "description": "用户自定义的域名,需要增加A记录才能生效,具体方法请参见《云解析服务用户指南》的“添加A类型记录集”章节。\n\n每个API分组下最多可绑定5个域名。绑定域名后,用户可通过自定义域名调用API。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-produc-type": "apig",
        "x-apigateway-request-type": "public",
        "x-order": 1,
        "x-api-type": "open-api",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk,cmcc,ctc,dt,g42,hk_g42,hk_sbc,hk_tm,hws_eu,hws_ocb,ocb,sbc,tm,srg,ax",
        "operationId": "AssociateDomainV2",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_group_id"
          },
          {
            "schema": {
              "$ref": "#/definitions/UrlDomainCreate"
            },
            "in": "body",
            "name": "AssociateDomainV2RequestBody",
            "description": "绑定域名的请求体",
            "required": true
          }
        ],
        "x-request-examples-description-1": "为API分组绑定域名",
        "x-request-examples-1": {
          "url_domain": "www.company.com"
        },
        "responses": {
          "201": {
            "schema": {
              "$ref": "#/definitions/UrlDomainBaseInfo"
            },
            "examples": {
              "application/json": {
                "url_domain": "www.company.com",
                "id": "c5e0d5ba62a34d26ad5c709ae22c1a17",
                "status": 3,
                "min_ssl_version": "TLSv1.1",
                "is_http_redirect_to_https": false,
                "verified_client_certificate_enabled": false
              }
            },
            "description": "Created"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2024",
                "error_msg": "Invalid URL domain name"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3001",
                "error_msg": "API group c77f5e81d9cb4424bf704ef2b0ac7600 does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "UrlDomainBase": {
      "properties": {
        "min_ssl_version": {
          "description": "最小ssl协议版本号。支持TLSv1.1或TLSv1.2",
          "type": "string",
          "default": "TLSv1.1",
          "enum": [
            "TLSv1.1",
            "TLSv1.2"
          ],
          "example": "TLSv1.1"
        },
        "is_http_redirect_to_https": {
          "type": "boolean",
          "description": "是否开启http到https的重定向,false为关闭,true为开启,默认为false",
          "default": false,
          "example": true
        },
        "ingress_http_port": {
          "description": "访问该域名绑定的http协议入方向端口,-1表示无端口且协议不支持,可使用80默认端口,其他有效端口允许的取值范围为1024~49151,需为实例已开放的HTTP协议的自定义入方向端口。\n\n当创建域名时,该参数未填表示用默认80端口;如果填写该参数,则必须同时填写https_port;如果要http_port和https_port同时使用默认端口,则两个参数都不填。\n\n当修改域名时,该参数未填表示不修改该端口。",
          "type": "integer",
          "minimum": -1,
          "maximum": 49151,
          "example": 8080
        },
        "ingress_https_port": {
          "description": "访问该域名绑定的https协议入方向端口,-1表示无端口且协议不支持,可使用443默认端口,其他有效端口允许的取值范围为1024~49151,需为实例已开放的HTTPS协议的自定义入方向端口。\n\n当创建域名时,该参数未填表示用默认443端口;如果填写该参数,则必须同时填写http_port;如果要http_port和https_port同时使用默认端口,则两个参数都不填。\n\n当修改域名时,该参数未填表示不修改该端口。",
          "type": "integer",
          "minimum": -1,
          "maximum": 49151,
          "example": 8443
        }
      }
    },
    "UrlDomainBaseInfo": {
      "required": [
        "id",
        "url_domain",
        "status",
        "min_ssl_version"
      ],
      "properties": {
        "url_domain": {
          "description": "自定义域名",
          "type": "string",
          "example": "www.example.com"
        },
        "id": {
          "description": "自定义域名的编号",
          "type": "string",
          "example": "b9be707660c5406394f8973e087bae20"
        },
        "status": {
          "description": "CNAME解析状态\n- 1: 未解析\n- 2: 解析中\n- 3: 解析成功\n- 4: 解析失败",
          "enum": [
            1,
            2,
            3,
            4
          ],
          "type": "integer",
          "format": "int32",
          "example": 3
        },
        "min_ssl_version": {
          "description": "支持的最小SSL版本",
          "type": "string",
          "example": "TLSv1.1"
        },
        "is_http_redirect_to_https": {
          "type": "boolean",
          "description": "是否开启http到https的重定向,false为关闭,true为开启,默认为false",
          "default": false,
          "example": true
        },
        "verified_client_certificate_enabled": {
          "description": "是否开启客户端证书校验。只有绑定证书时,该参数才生效。当绑定证书存在trusted_root_ca时,默认开启;当绑定证书不存在trusted_root_ca时,默认关闭。",
          "type": "boolean",
          "default": false,
          "example": false
        },
        "ingress_http_port": {
          "description": "访问该域名绑定的http协议入方向端口,-1表示无端口且协议不支持,可使用80默认端口,其他有效端口允许的取值范围为1024~49151,需为实例已开放的HTTP协议的自定义入方向端口。\n\n当创建域名时,该参数未填表示用默认80端口;如果填写该参数,则必须同时填写https_port;如果要http_port和https_port同时使用默认端口,则两个参数都不填。\n\n当修改域名时,该参数未填表示不修改该端口。",
          "type": "integer",
          "minimum": -1,
          "maximum": 49151,
          "example": 8080
        },
        "ingress_https_port": {
          "description": "访问该域名绑定的https协议入方向端口,-1表示无端口且协议不支持,可使用443默认端口,其他有效端口允许的取值范围为1024~49151,需为实例已开放的HTTPS协议的自定义入方向端口。\n\n当创建域名时,该参数未填表示用默认443端口;如果填写该参数,则必须同时填写http_port;如果要http_port和https_port同时使用默认端口,则两个参数都不填。\n\n当修改域名时,该参数未填表示不修改该端口。",
          "type": "integer",
          "minimum": -1,
          "maximum": 49151,
          "example": 8443
        }
      }
    },
    "UrlDomainCreate": {
      "required": [
        "url_domain"
      ],
      "allOf": [
        {
          "$ref": "#/definitions/UrlDomainBase"
        },
        {
          "type": "object",
          "properties": {
            "url_domain": {
              "description": "自定义域名。长度为0-255位的字符串,需要符合域名规范(即符合正则'^(\\[a-zA-Z0-9]([a-zA-Z0-9-_]{0,61}[a-zA-Z0-9_])?\\\\.){1,7}[a-zA-Z]{2,64}\\\\.?$'或者符合正则'^\\[*](\\\\.\\[a-zA-Z0-9_]([a-zA-Z0-9-_]{0,61}[a-zA-Z0-9_])?){1,6}\\\\.[a-zA-Z]{2,64}\\\\.?$')。",
              "pattern": "^([a-zA-Z0-9]([a-zA-Z0-9-_]{0,61}[a-zA-Z0-9_])?\\.){1,7}[a-zA-Z]{2,64}\\.?$|^[*](\\.[a-zA-Z0-9_]([a-zA-Z0-9-_]{0,61}[a-zA-Z0-9_])?){1,6}\\.[a-zA-Z]{2,64}\\.?$",
              "minLength": 0,
              "maxLength": 255,
              "type": "string",
              "example": "www.company.com"
            }
          }
        }
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID,在API网关控制台的“实例信息”中获取。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见[获取项目ID](apig-api-180713009.xml)。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_group_id": {
      "name": "group_id",
      "in": "path",
      "type": "string",
      "description": "分组的编号",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "c77f5e81d9cb4424bf704ef2b0ac7600"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "post",
  "uri": null
}