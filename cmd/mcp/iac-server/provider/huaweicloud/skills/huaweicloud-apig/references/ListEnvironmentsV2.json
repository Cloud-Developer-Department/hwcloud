  "definitions": {
    "BasePage": {
      "properties": {
        "size": {
          "description": "本次返回的列表长度",
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "description": "满足条件的记录数",
          "type": "integer",
          "format": "int64"
        }
      },
      "description": "分页基本信息",
      "required": [
        "size",
        "total"
      ]
    },
    "EnvInfoPage": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "envs": {
              "description": "本次返回的环境列表",
              "type": "array",
              "items": {
                "$ref": "#/definitions/EnvInfo"
              }
            }
          }
        }
      ]
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "EnvInfo": {
      "properties": {
        "create_time": {
          "description": "创建时间",
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "description": "环境名称",
          "type": "string"
        },
        "remark": {
          "description": "描述信息",
          "type": "string"
        },
        "id": {
          "description": "环境id",
          "type": "string"
        }
      }
    }
