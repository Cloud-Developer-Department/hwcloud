  "definitions": {
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "AsyncTaskResult": {
      "type": "object",
      "properties": {
        "task_id": {
          "description": "任务id",
          "type": "string",
          "example": "41db8c563df34b1392aaaa1a8d6be236"
        },
        "task_status": {
          "description": "异步任务状态。\n- waiting:异步任务等待处理。\n- processing:异步任务处理中。\n- succeed:异步任务执行完成。\n- failed:异步任务执行失败。",
          "type": "string",
          "enum": [
            "waiting",
            "processing",
            "succeed",
            "failed"
          ]
        },
        "task_type": {
          "description": "任务类型。 import_api为异步导入api,export_api为异步导出api。",
          "type": "string",
          "enum": [
            "import_api",
            "export_api"
          ]
        },
        "task_result": {
          "description": "任务结果。string可转成json object。\n当task_type为import_api时,字段包括API分组编号group_id、success数组、failure数组、swagger结构体、ignore数组。\n  - success数组:导入成功的API,数组元素中包括4个字段,导入成功的API编号id、API请求方法method、API请求路径path、导入行为action(枚举值,update表示更新API,create表示新建API)。\n  - failure数组:导入失败的API,数组元素中包括4个字段,API请求方法method、API请求路径path、导入失败的错误码error_code、导入失败的错误信息error_msg。\n  - swagger结构体:包括2个字段,swagger文档编号id、导入结果说明result。\n  - ignore数组:元素包括API请求方法method、API请求路径path。\n  \n当task_type为export_api时,字段包括导出文件类型file_type、导出文件内容content。",
          "type": "string",
          "example": {
            "success": [
              {
                "id": "ee93ce6815f04896b301452982b92222",
                "action": "create",
                "method": "GET",
                "path": "/test1"
              }
            ],
            "failure": [],
            "swagger": {
              "id": "de1852ab6c5e4090b0bd88a02058e650",
              "result": "Success"
            },
            "group_id": "9100ae30705947cc9543d37cd7fb388c"
          }
        }
      }
    }
  },
