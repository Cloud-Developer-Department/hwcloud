  "definitions": {
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "ApiAclInfo": {
      "title": "ApiAclInfo",
      "type": "object",
      "properties": {
        "acl_name": {
          "description": "名称",
          "type": "string"
        },
        "acl_type": {
          "description": "类型。\n- PERMIT:白名单类型\n- DENY:黑名单类型",
          "enum": [
            "PERMIT",
            "DENY"
          ],
          "type": "string"
        },
        "acl_value": {
          "description": "ACL策略值",
          "type": "string"
        },
        "entity_type": {
          "description": "对象类型:\n- IP\n- DOMAIN\n- DOMAIN_ID",
          "type": "string"
        },
        "id": {
          "description": "编号",
          "type": "string"
        },
        "update_time": {
          "description": "更新时间",
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ApiAclCreate": {
      "required": [
        "acl_name",
        "entity_type",
        "acl_type",
        "acl_value"
      ],
      "properties": {
        "acl_name": {
          "description": "ACL策略名称。支持汉字,英文,数字,下划线,且只能以英文和汉字开头,3 ~ 64字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "test001"
        },
        "acl_type": {
          "description": "类型。\n- PERMIT:白名单类型\n- DENY:黑名单类型",
          "enum": [
            "PERMIT",
            "DENY"
          ],
          "type": "string",
          "example": "PERMIT"
        },
        "acl_value": {
          "type": "string",
          "description": "ACL策略值,支持一个或多个值,使用英文半角逗号分隔。\n- entity_type为IP时,策略值需填写IP地址,最多可支持100个IP地址。\n- entity_type为DOMAIN时,策略值需填写账号名,账号支持除英文半角逗号以外的任意ASCII字符,账号名长度限制在1-64个字符,不支持纯数字。多账号名字符的总长度不超过1024。\n- entity_type为DOMAIN_ID时,策略值需填写账号ID,获取方式请参见API参考的“附录 > 获取账号ID”章节。",
          "example": "192.168.1.5,192.168.10.1"
        },
        "entity_type": {
          "description": "对象类型:\n- IP:IP地址\n- DOMAIN:账号名\n- DOMAIN_ID:账号ID",
          "enum": [
            "IP",
            "DOMAIN",
            "DOMAIN_ID"
          ],
          "type": "string",
          "example": "IP"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_instance_id": {
