              "$ref": "#/definitions/ApiAclCreate"
            },
            "description": "创建ACL策略请求体",
            "required": true
          }
        ],
        "x-request-examples-description-1": "创建一个ACL策略,指定允许访问的IP地址",
        "x-request-examples-1": {
          "acl_name": "acl_demo",
          "acl_type": "PERMIT",
          "acl_value": "192.168.1.5,192.168.10.1",
          "entity_type": "IP"
        },
        "responses": {
          "201": {
            "description": "Created",
            "examples": {
              "application/json": {
                "id": "7eb619ecf2a24943b099833cd24a01ba",
                "acl_name": "acl_demo",
                "entity_type": "IP",
                "acl_type": "PERMIT",
                "acl_value": "192.168.1.5,192.168.10.1",
                "update_time": "2020-08-04T08:42:43.461276217Z"
              }
            },
            "schema": {
              "$ref": "#/definitions/ApiAclInfo"
            }
          },
          "400": {
