{
  "name": "ImportApiDefinitionsAsync",
  "summary": "异步导入API",
  "tags": "专享版-异步任务管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/{project_id}/apigw/instances/{instance_id}/openapi/async-import": {
      "post": {
        "summary": "异步导入API",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-produc-type": "apig",
        "x-apigateway-request-type": "public",
        "description": "导入API。导入文件内容需要符合swagger标准规范,API网关自定义扩展字段请参考《API网关用户指南》的“导入导出API:扩展定义”章节。",
        "schemes": [
          "https"
        ],
        "tags": [
          "专享版-异步任务管理"
        ],
        "operationId": "ImportApiDefinitionsAsync",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "name": "is_create_group",
            "type": "boolean",
            "in": "formData",
            "required": false,
            "description": "是否创建新分组",
            "default": true
          },
          {
            "in": "formData",
            "name": "group_id",
            "x-example": "57e7248244ee457cb0ddb64b012f4cbe",
            "description": "API分组编号,当is_create_group=false时为必填",
            "type": "string",
            "required": false
          },
          {
            "name": "extend_mode",
            "type": "string",
            "in": "formData",
            "required": false,
            "description": "扩展信息导入模式\n- merge:当扩展信息定义冲突时,merge保留原有扩展信息\n- override:当扩展信息定义冲突时,override会覆盖原有扩展信息",
            "enum": [
              "merge",
              "override"
            ],
            "default": "merge"
          },
          {
            "name": "simple_mode",
            "type": "boolean",
            "in": "formData",
            "required": false,
            "description": "是否开启简易导入模式",
            "default": false
          },
          {
            "name": "mock_mode",
            "type": "boolean",
            "in": "formData",
            "required": false,
            "description": "是否开启Mock后端",
            "default": false
          },
          {
            "name": "api_mode",
            "type": "string",
            "in": "formData",
            "required": false,
            "description": "导入模式\n- merge:当API信息定义冲突时,merge保留原有API信息\n- override:当API信息定义冲突时,override会覆盖原有API信息",
            "enum": [
              "merge",
              "override"
            ],
            "default": "merge"
          },
          {
            "name": "file_name",
            "in": "formData",
            "type": "file",
            "description": "导入Api的请求体,json或yaml格式的文件",
            "required": true
          }
        ],
        "x-request-examples-description-1": "导入API",
        "x-request-examples-1": {
          "is_create_group": false,
          "group_id": "d9ce8c9eede54b3f841ec324fe0bfdc2",
          "file_name": "APIGroup_test.json"
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "schema": {
              "$ref": "#/definitions/AsyncTaskInfo"
            },
            "examples": {
              "application/json": {
                "task_id": "d9ce8c9eede54b3f841ec324fe0bfdc2"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3603",
                "error_msg": "The input data is too long"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "AsyncTaskInfo": {
      "type": "object",
      "properties": {
        "task_id": {
          "description": "任务id",
          "type": "string",
          "example": "41db8c563df34b1392aaaa1a8d6be236"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID,在API网关控制台的“实例信息”中获取。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见[获取项目ID](apig-api-180713009.xml)。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "post",
  "uri": null
}