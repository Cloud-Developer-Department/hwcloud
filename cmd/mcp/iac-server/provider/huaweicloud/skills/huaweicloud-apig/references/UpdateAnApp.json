{
  "name": "UpdateAnApp",
  "summary": "修改APP",
  "tags": "共享版-APP管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/apigw/apps/{app_id}": {
      "put": {
        "summary": "修改APP",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "description": "修改指定APP的信息。其中可修改的属性为:name、remark,当支持用户自定义key和secret的开关开启时,app_key和app_secret也支持修改,其它属性不可修改。",
        "schemes": [
          "https"
        ],
        "tags": [
          "共享版-APP管理"
        ],
        "operationId": "UpdateAnApp",
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/AppResp"
            },
            "examples": {
              "application/json": {
                "creator": "USER",
                "update_time": "2017-12-28T12:26:54.2345858Z",
                "app_key": "d49b1cbf-cc81-4a5f-b2a0-61b568e376eb",
                "name": "app_001",
                "remark": "第一个应用",
                "id": "14b399ac-967f-4115-bb62-c0346b4537e9",
                "app_secret": "******",
                "register_time": "2017-12-28T12:26:54.2345858Z",
                "status": 1
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Too Many Requests"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "required": true
          },
          {
            "in": "path",
            "name": "app_id",
            "x-example": "57e7248244ee457cb0ddb64b012f4cbe",
            "description": "APP的编号",
            "type": "string",
            "required": true
          },
          {
            "schema": {
              "$ref": "#/definitions/AppReq"
            },
            "in": "body",
            "name": "UpdateAnAppRequestBody",
            "description": "修改APP的请求体",
            "required": true
          }
        ]
      }
    }
  },
  "definitions": {
    "AppReq": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "APP的名称。支持汉字,英文,数字,下划线,且只能以英文和汉字开头,3 ~ 64个字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "app_001"
        },
        "remark": {
          "description": "APP描述。字符长度不能大于255。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "APP1"
        },
        "app_key": {
          "description": "APP的key。支持英文,数字,“_”,“-”,且只能以英文或数字开头,8 ~ 64个字符。\n> 只支持部分region。",
          "type": "string",
          "example": "app_key_sample"
        },
        "app_secret": {
          "description": "密钥。支持英文,数字,“_”,“-”,“_”,“!”,“@”,“#”,“$”,“%”且只能以英文或数字开头,8 ~ 64个字符。\n> 只支持部分region。",
          "type": "string",
          "example": "ap******le"
        }
      }
    },
    "AppResp": {
      "properties": {
        "creator": {
          "description": "APP的创建者\n- USER:用户自行创建\n- MARKET:云市场分配",
          "type": "string",
          "example": "USER"
        },
        "update_time": {
          "description": "更新时间",
          "type": "string",
          "example": "2017-12-28T12:28:07.2966182Z"
        },
        "app_key": {
          "description": "APP的key",
          "type": "string",
          "example": "14b399ac-967f-4115-bb62-c0346b4537e9"
        },
        "name": {
          "description": "名称",
          "type": "string",
          "example": "app_sample"
        },
        "remark": {
          "description": "描述",
          "type": "string",
          "example": "第一个APP"
        },
        "id": {
          "description": "编号",
          "type": "string"
        },
        "app_secret": {
          "description": "密钥",
          "type": "string"
        },
        "register_time": {
          "description": "注册时间",
          "type": "string",
          "example": "2017-12-28T12:26:54Z"
        },
        "status": {
          "description": "状态",
          "type": "integer",
          "example": 1
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v1.0",
  "info_version": "v1",
  "method": "put",
  "uri": null
}