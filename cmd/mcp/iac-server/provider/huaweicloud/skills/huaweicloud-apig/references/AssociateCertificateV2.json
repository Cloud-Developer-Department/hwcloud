{
  "name": "AssociateCertificateV2",
  "summary": "绑定域名证书",
  "tags": "专享版-域名管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/{project_id}/apigw/instances/{instance_id}/api-groups/{group_id}/domains/{domain_id}/certificate": {
      "post": {
        "summary": "绑定域名证书",
        "tags": [
          "专享版-域名管理"
        ],
        "description": "如果创建API时,“定义API请求”使用HTTPS请求协议,那么在独立域名中需要添加SSL证书。\n使用实例自定义入方向端口的特性时,相同的域名会同时绑定证书,注意开启/关闭客户端校验会对相同域名的不同端口同时生效。\n本章节主要介绍为特定域名绑定证书。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-produc-type": "apig",
        "x-apigateway-request-type": "public",
        "x-order": 2,
        "x-api-type": "open-api",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk,cmcc,ctc,dt,g42,hk_g42,hk_sbc,hk_tm,hws_eu,hws_ocb,ocb,sbc,tm,srg,ax",
        "operationId": "AssociateCertificateV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_group_id"
          },
          {
            "$ref": "#/parameters/apic_domain_id"
          },
          {
            "schema": {
              "$ref": "#/definitions/CertForm"
            },
            "in": "body",
            "name": "AssociateCertificateV2RequestBody",
            "description": "绑定域名证书的请求体",
            "required": true
          }
        ],
        "x-request-examples-description-1": "绑定证书到域名上",
        "x-request-examples-1": {
          "name": "cert_demo",
          "private_key": "'-----BEGIN PRIVATE KEY-----THIS IS YOUR PRIVATE KEY-----END PRIVATE KEY-----\\n'",
          "cert_content": "'-----BEGIN CERTIFICATE-----THIS IS YOUR CERT CONTENT-----END CERTIFICATE-----\\n'"
        },
        "responses": {
          "201": {
            "schema": {
              "$ref": "#/definitions/UrlDomainCertInfo"
            },
            "examples": {
              "application/json": {
                "ssl_name": "cert_demo",
                "url_domain": "www.example.com",
                "ssl_id": "a27be832f2e9441c8127fe48e3b5ac67",
                "id": " f6bb84ccf1c34035878aa51b7253b21c",
                "status": 3
              }
            },
            "description": "Created"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:name. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3020",
                "error_msg": "The URL domain does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        },
        "schemes": [
          "https"
        ]
      }
    }
  },
  "definitions": {
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "UrlDomainBaseInfo": {
      "required": [
        "id",
        "url_domain",
        "status",
        "min_ssl_version"
      ],
      "properties": {
        "url_domain": {
          "description": "自定义域名",
          "type": "string",
          "example": "www.example.com"
        },
        "id": {
          "description": "自定义域名的编号",
          "type": "string",
          "example": "b9be707660c5406394f8973e087bae20"
        },
        "status": {
          "description": "CNAME解析状态\n- 1: 未解析\n- 2: 解析中\n- 3: 解析成功\n- 4: 解析失败",
          "enum": [
            1,
            2,
            3,
            4
          ],
          "type": "integer",
          "format": "int32",
          "example": 3
        },
        "min_ssl_version": {
          "description": "支持的最小SSL版本",
          "type": "string",
          "example": "TLSv1.1"
        },
        "is_http_redirect_to_https": {
          "type": "boolean",
          "description": "是否开启http到https的重定向,false为关闭,true为开启,默认为false",
          "default": false,
          "example": true
        },
        "verified_client_certificate_enabled": {
          "description": "是否开启客户端证书校验。只有绑定证书时,该参数才生效。当绑定证书存在trusted_root_ca时,默认开启;当绑定证书不存在trusted_root_ca时,默认关闭。",
          "type": "boolean",
          "default": false,
          "example": false
        },
        "ingress_http_port": {
          "description": "访问该域名绑定的http协议入方向端口,-1表示无端口且协议不支持,可使用80默认端口,其他有效端口允许的取值范围为1024~49151,需为实例已开放的HTTP协议的自定义入方向端口。\n\n当创建域名时,该参数未填表示用默认80端口;如果填写该参数,则必须同时填写https_port;如果要http_port和https_port同时使用默认端口,则两个参数都不填。\n\n当修改域名时,该参数未填表示不修改该端口。",
          "type": "integer",
          "minimum": -1,
          "maximum": 49151,
          "example": 8080
        },
        "ingress_https_port": {
          "description": "访问该域名绑定的https协议入方向端口,-1表示无端口且协议不支持,可使用443默认端口,其他有效端口允许的取值范围为1024~49151,需为实例已开放的HTTPS协议的自定义入方向端口。\n\n当创建域名时,该参数未填表示用默认443端口;如果填写该参数,则必须同时填写http_port;如果要http_port和https_port同时使用默认端口,则两个参数都不填。\n\n当修改域名时,该参数未填表示不修改该端口。",
          "type": "integer",
          "minimum": -1,
          "maximum": 49151,
          "example": 8443
        }
      }
    },
    "CertForm": {
      "required": [
        "name",
        "cert_content",
        "private_key"
      ],
      "properties": {
        "cert_content": {
          "description": "证书内容",
          "type": "string",
          "example": "example"
        },
        "name": {
          "description": "证书名称。长度为4 ~ 50位的字符串,字符串由中文、英文字母、数字、下划线组成,且只能以英文或中文开头。",
          "type": "string",
          "example": "test_ssl"
        },
        "private_key": {
          "description": "私钥内容",
          "type": "string",
          "example": "example"
        }
      }
    },
    "UrlDomainCertInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/UrlDomainBaseInfo"
        },
        {
          "required": [
            "ssl_id",
            "ssl_name"
          ],
          "properties": {
            "ssl_name": {
              "description": "证书的名称",
              "type": "string",
              "example": "证书"
            },
            "ssl_id": {
              "description": "证书的编号",
              "type": "string",
              "example": "0a515af69f4e4dcca84fbf85f68c0e27"
            },
            "instance_id": {
              "description": "实例ID。",
              "type": "string",
              "minLength": 32,
              "maxLength": 36,
              "example": "ee7740d067da4a37b5091c5d4ecca72d"
            },
            "api_group_id": {
              "description": "API分组的ID。",
              "type": "string",
              "minLength": 32,
              "maxLength": 36,
              "example": "5799841119cd453fbe791d32e040760b"
            },
            "api_group_name": {
              "description": "API分组的名称。",
              "type": "string",
              "minLength": 3,
              "maxLength": 255,
              "example": "APIGROUP_TEST"
            }
          }
        }
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_domain_id": {
      "name": "domain_id",
      "in": "path",
      "type": "string",
      "description": "域名的编号",
      "required": true,
      "x-example": "f6bb84ccf1c34035878aa51b7253b21c"
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID,在API网关控制台的“实例信息”中获取。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见[获取项目ID](apig-api-180713009.xml)。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_group_id": {
      "name": "group_id",
      "in": "path",
      "type": "string",
      "description": "分组的编号",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "c77f5e81d9cb4424bf704ef2b0ac7600"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "post",
  "uri": null
}