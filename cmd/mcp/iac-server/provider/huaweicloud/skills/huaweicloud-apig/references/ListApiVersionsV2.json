{
  "name": "ListApiVersionsV2",
  "summary": "查询API历史版本列表",
  "tags": "专享版-API管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/{project_id}/apigw/instances/{instance_id}/apis/publish/{api_id}": {
      "get": {
        "summary": "查询API历史版本列表",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "tags": [
          "专享版-API管理"
        ],
        "description": "查询某个API的历史版本。每个API在一个环境上最多存在10个历史版本。",
        "x-api-type": "open-api",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk,cmcc,ctc,dt,g42,hk_g42,hk_sbc,hk_tm,hws_eu,hws_ocb,ocb,sbc,tm,srg,ax",
        "operationId": "ListApiVersionsV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_api_id"
          },
          {
            "$ref": "#/parameters/apic_offset"
          },
          {
            "$ref": "#/parameters/apic_limit"
          },
          {
            "in": "query",
            "name": "env_id",
            "description": "环境的编号",
            "type": "string",
            "x-example": "DEFAULT_ENVIRONMENT_RELEASE_ID"
          },
          {
            "in": "query",
            "name": "env_name",
            "description": "环境的名称",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ApiVersionRespPage"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "size": 1,
                "api_versions": [
                  {
                    "version_id": "ee1a5a38d3d3493abf1dc4ed6cacfa0b",
                    "version_no": "20200803093600",
                    "api_id": "5f918d104dc84480a75166ba99efff21",
                    "env_id": "DEFAULT_ENVIRONMENT_RELEASE_ID",
                    "env_name": "RELEASE",
                    "publish_time": "2020-08-03T01:36:00Z",
                    "status": 1
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:env_name. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3002",
                "error_msg": "API 5f918d104dc84480a75166ba99efff21 does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "BasePage": {
      "properties": {
        "size": {
          "description": "本次返回的列表长度",
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "description": "满足条件的记录数",
          "type": "integer",
          "format": "int64"
        }
      },
      "description": "分页基本信息",
      "required": [
        "size",
        "total"
      ]
    },
    "ApiVersionRespPage": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "api_versions": {
              "description": "本次查询返回的API历史版本列表",
              "type": "array",
              "items": {
                "$ref": "#/definitions/ApiVersionResp"
              }
            }
          }
        }
      ]
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "ApiVersionResp": {
      "properties": {
        "version_id": {
          "description": "API历史版本的ID",
          "type": "string",
          "example": "04c194dc7b5340ed942f2451702060da"
        },
        "version_no": {
          "description": "API的版本号",
          "type": "string",
          "example": 20180722102526
        },
        "api_id": {
          "description": "API编号",
          "type": "string",
          "example": "acf141aa6279415088b593a4bbb55eed"
        },
        "env_id": {
          "description": "发布的环境编号",
          "type": "string",
          "example": "DEFAULT_ENVIRONMENT_RELEASE_ID"
        },
        "env_name": {
          "description": "发布的环境名称",
          "type": "string",
          "example": "RELEASE"
        },
        "remark": {
          "description": "发布描述",
          "type": "string",
          "example": "发布到生产环境"
        },
        "publish_time": {
          "description": "发布时间",
          "type": "string",
          "format": "date-time",
          "example": "2018-04-14T07:32:23Z"
        },
        "status": {
          "description": "版本状态\n- 1:当前生效中的版本\n- 2:未生效的版本",
          "enum": [
            1,
            2
          ],
          "type": "integer",
          "format": "int32",
          "example": 1
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_offset": {
      "name": "offset",
      "in": "query",
      "type": "integer",
      "description": "偏移量,表示从此偏移量开始查询,偏移量小于0时,自动转换为0",
      "format": "int64",
      "default": 0,
      "x-example": 1
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID,在API网关控制台的“实例信息”中获取。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见[获取项目ID](apig-api-180713009.xml)。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_api_id": {
      "name": "api_id",
      "in": "path",
      "type": "string",
      "description": "API的编号",
      "required": true,
      "x-example": "5f918d104dc84480a75166ba99efff21"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "apic_limit": {
      "name": "limit",
      "in": "query",
      "type": "integer",
      "description": "每页显示的条目数量,条目数量小于等于0时,自动转换为20,条目数量大于500时,自动转换为500",
      "format": "int32",
      "minimum": 1,
      "maximum": 500,
      "default": 20,
      "x-example": 10
    }
  },
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
  "uri": null
}