  "definitions": {
    "ApiAuthCreate": {
      "required": [
        "api_ids",
        "app_ids",
        "env_id"
      ],
      "properties": {
        "env_id": {
          "description": "需要授权的环境编号",
          "type": "string",
          "example": "DEFAULT_ENVIRONMENT_RELEASE_ID"
        },
        "app_ids": {
          "description": "APP的编号列表",
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "f8c6ea150d1b4c5bbd4b911610bd3b3e"
          ]
        },
        "api_ids": {
          "description": "API的编号列表,可以选择租户自己的API,也可以选择从云商店上购买的API。",
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "8aa097b00e9843efabc9c593d11b769d"
          ]
        }
      }
    },
    "AuthResult": {
      "description": "授权结果",
      "properties": {
        "status": {
          "description": "授权结果\n- SUCCESS:授权成功\n- SKIPPED:跳过\n- FAILED:授权失败",
          "enum": [
            "SUCCESS",
            "SKIPPED",
            "FAILED"
          ],
          "type": "string"
        },
        "error_msg": {
          "description": "授权失败错误信息",
          "type": "string"
        },
        "error_code": {
          "description": "授权失败错误码",
          "type": "string"
        },
        "api_name": {
          "description": "授权失败的API名称",
          "type": "string"
        },
        "app_name": {
          "description": "授权失败的APP名称",
          "type": "string"
        }
      }
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "ApiAuthResult": {
      "properties": {
        "auths": {
          "description": "API与APP的授权关系列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ApiAuthRelations"
          }
        }
      }
    },
    "ApiAuthRelations": {
      "properties": {
        "api_id": {
          "description": "API编号",
          "type": "string"
        },
        "auth_result": {
          "$ref": "#/definitions/AuthResult"
        },
        "auth_time": {
          "description": "授权时间",
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "description": "授权关系编号",
          "type": "string"
        },
        "app_id": {
          "description": "APP编号",
          "type": "string"
        },
        "auth_role": {
          "description": "授权者\n- PROVIDER:API提供者授权\n- CONSUMER:API消费者授权",
          "enum": [
            "PROVIDER",
            "CONSUMER"
          ],
          "type": "string"
        },
        "auth_tunnel": {
          "description": "授权通道类型\n- NORMAL:普通通道\n- GREEN:绿色通道\n\n暂不支持,默认NORMAL",
          "enum": [
            "NORMAL",
            "GREEN"
          ],
          "type": "string"
        },
        "auth_whitelist": {
          "description": "绿色通道的白名单配置",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auth_blacklist": {
          "description": "绿色通道的黑名单配置",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visit_params": {
          "description": "访问参数。",
          "type": "string"
        }
      }
    }
