  "definitions": {
    "BasePage": {
      "properties": {
        "size": {
          "description": "本次返回的列表长度",
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "description": "满足条件的记录数",
          "type": "integer",
          "format": "int64"
        }
      },
      "description": "分页基本信息",
      "required": [
        "size",
        "total"
      ]
    },
    "UrlDomainRefInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/UrlDomainBaseInfo"
        },
        {
          "required": [
            "api_group_id",
            "api_group_name",
            "instance_id"
          ],
          "type": "object",
          "properties": {
            "ssl_id": {
              "type": "string",
              "description": "证书ID",
              "example": "a27be832f2e9441c8127fe48e3b5ac67"
            },
            "ssl_name": {
              "type": "string",
              "description": "证书名称",
              "example": "cert_demo"
            },
            "api_group_id": {
              "type": "string",
              "description": "所属API分组ID",
              "example": "c77f5e81d9cb4424bf704ef2b0ac7600"
            },
            "api_group_name": {
              "type": "string",
              "description": "所属API分组名称",
              "example": "default"
            },
            "instance_id": {
              "type": "string",
              "description": "所属实例ID",
              "example": "f0fa1789-3b76-433b-a787-9892951c620e"
            }
          }
        }
      ],
      "description": "域名详情及关联的证书、分组信息"
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "UrlDomainsPage": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "bound_domains": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/UrlDomainRefInfo"
              },
              "description": "已绑定域名集合"
            }
          }
        }
      ]
    },
    "UrlDomainBaseInfo": {
      "required": [
        "id",
        "url_domain",
        "status",
        "min_ssl_version"
      ],
      "properties": {
        "url_domain": {
          "description": "自定义域名",
          "type": "string",
          "example": "www.example.com"
        },
        "id": {
          "description": "自定义域名的编号",
          "type": "string",
          "example": "b9be707660c5406394f8973e087bae20"
        },
        "status": {
          "description": "CNAME解析状态\n- 1: 未解析\n- 2: 解析中\n- 3: 解析成功\n- 4: 解析失败",
          "enum": [
            1,
            2,
            3,
            4
          ],
          "type": "integer",
          "format": "int32",
          "example": 3
        },
        "min_ssl_version": {
          "description": "支持的最小SSL版本",
          "type": "string",
          "example": "TLSv1.1"
        },
        "is_http_redirect_to_https": {
          "type": "boolean",
          "description": "是否开启http到https的重定向,false为关闭,true为开启,默认为false",
          "default": false,
          "example": true
        },
        "verified_client_certificate_enabled": {
          "description": "是否开启客户端证书校验。只有绑定证书时,该参数才生效。当绑定证书存在trusted_root_ca时,默认开启;当绑定证书不存在trusted_root_ca时,默认关闭。",
          "type": "boolean",
          "default": false,
          "example": false
        },
        "ingress_http_port": {
          "description": "访问该域名绑定的http协议入方向端口,-1表示无端口且协议不支持,可使用80默认端口,其他有效端口允许的取值范围为1024~49151,需为实例已开放的HTTP协议的自定义入方向端口。\n\n当创建域名时,该参数未填表示用默认80端口;如果填写该参数,则必须同时填写https_port;如果要http_port和https_port同时使用默认端口,则两个参数都不填。\n\n当修改域名时,该参数未填表示不修改该端口。",
          "type": "integer",
          "minimum": -1,
          "maximum": 49151,
          "example": 8080
        },
        "ingress_https_port": {
          "description": "访问该域名绑定的https协议入方向端口,-1表示无端口且协议不支持,可使用443默认端口,其他有效端口允许的取值范围为1024~49151,需为实例已开放的HTTPS协议的自定义入方向端口。\n\n当创建域名时,该参数未填表示用默认443端口;如果填写该参数,则必须同时填写http_port;如果要http_port和https_port同时使用默认端口,则两个参数都不填。\n\n当修改域名时,该参数未填表示不修改该端口。",
          "type": "integer",
          "minimum": -1,
          "maximum": 49151,
          "example": 8443
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_offset": {
      "name": "offset",
