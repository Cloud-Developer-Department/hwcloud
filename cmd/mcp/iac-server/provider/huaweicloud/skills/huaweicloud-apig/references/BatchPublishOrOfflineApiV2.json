  "definitions": {
    "ApiBatchPublish": {
      "properties": {
        "apis": {
          "description": "需要发布或下线的API ID列表,单次更新上限为1000个API。必须指定apis或group_id。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env_id": {
          "description": "环境ID",
          "type": "string"
        },
        "group_id": {
          "description": "API分组ID。必须指定apis或group_id。",
          "type": "string"
        },
        "remark": {
          "description": "对本次发布的描述信息\n\n字符长度不超过255\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string"
        }
      },
      "required": [
        "env_id"
      ]
    },
    "BatchPublishResult": {
      "properties": {
        "success": {
          "description": "发布或下线成功的信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PublishResp"
          }
        },
        "failure": {
          "description": "发布或下线失败的API及错误信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/BatchFailure"
          }
        }
      }
    },
    "PublishResp": {
      "properties": {
        "publish_id": {
          "description": "发布记录的ID",
          "type": "string",
          "example": "5b729aa252764739be2c37ef0d66dc63"
        },
        "api_id": {
          "description": "API编号",
          "type": "string",
          "example": "7addcd00cfab433984b1d8bf2fe08aaa"
        },
        "api_name": {
          "description": "API名称",
          "type": "string",
          "example": "api_name"
        },
        "env_id": {
          "description": "发布的环境编号",
          "type": "string",
          "example": "DEFAULT_ENVIRONMENT_RELEASE_ID"
        },
        "remark": {
          "description": "发布描述",
          "type": "string",
          "example": "string"
        },
        "publish_time": {
          "description": "发布时间",
          "type": "string",
          "format": "date-time",
          "example": "2018-07-26T13:18:04.1079916Z"
        },
        "version_id": {
          "description": "在线的版本号",
          "type": "string",
          "example": "3d9dcb733ba34352b0d02f85fd16b026"
        }
      }
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "BatchFailure": {
      "properties": {
        "api_id": {
          "description": "发布或下线失败的API ID",
          "type": "string"
        },
        "api_name": {
          "description": "发布或下线失败的APi名称",
          "type": "string"
        },
        "error_code": {
          "description": "发布或下线失败的错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "发布或下线失败的错误信息",
          "type": "string"
        }
      }
    }
