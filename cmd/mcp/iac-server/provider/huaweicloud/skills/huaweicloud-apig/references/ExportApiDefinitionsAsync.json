          "enum": [
            "json",
            "yaml",
            "yml"
          ],
          "default": "json"
        },
        "version": {
          "example": "v1",
          "description": "导出的API定义版本,默认为当前时间",
          "type": "string"
        },
        "apis": {
          "description": "导出的API ID列表",
          "example": [
            "8d76248244ee457cb077664b012f4cbe",
            "des6248dddwe457cb077664b012f4cbe"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "AsyncTaskInfo": {
      "type": "object",
      "properties": {
        "task_id": {
          "description": "任务id",
          "type": "string",
          "example": "41db8c563df34b1392aaaa1a8d6be236"
        }
      }
