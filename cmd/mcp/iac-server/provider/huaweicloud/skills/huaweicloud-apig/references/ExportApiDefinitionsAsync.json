      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "ExportOpenApiReq": {
      "required": [
        "group_id",
        "env_id"
      ],
      "properties": {
        "env_id": {
          "example": "DEFAULT_ENVIRONMENT_RELEASE_ID",
