    "TmsQueryReq": {
      "properties": {
        "without_any_tag": {
          "description": "不包含任意一个标签,该字段为true时查询所有不带标签的资源,此时忽略 “tags”字段。\n该字段为false或者未提供该参数时,该条件不生效。",
          "type": "boolean",
          "example": false
        },
        "tags": {
          "description": "包含标签,最多包含20个key,每个key下面的value最多20个。无tag过滤条件时返回全量数据。",
          "minItems": 0,
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "#/definitions/TmsKeyValues"
          }
        },
        "sys_tags": {
          "description": "企业项目.仅op_service权限可以使用此字段做资源实例过滤条件. 无sys_tags时按照tag接口处理,无tag过滤条件时返回全量数据。",
          "minItems": 0,
          "maxItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/TmsKeyValues"
          }
        },
        "matches": {
          "description": "搜索字段,key为要匹配的字段,当前限定为resource_name。value为匹配的值。\n根据key的值确认是否需要模糊匹配,如resource_name需要实现前缀搜索。",
          "minItems": 0,
          "type": "array",
          "items": {
            "$ref": "#/definitions/TmsMatchesKeyValue"
          }
        }
      }
    },
