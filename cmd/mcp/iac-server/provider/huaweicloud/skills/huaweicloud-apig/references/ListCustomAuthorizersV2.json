  "definitions": {
    "AuthorizerBase": {
      "required": [
        "name",
        "type",
        "authorizer_type",
        "authorizer_uri"
      ],
      "properties": {
        "name": {
          "description": "自定义认证的名称。\n长度为3 ~ 64位的字符串,字符串由中文、英文字母、数字、“_”组成,且只能以英文或中文开头。",
          "type": "string",
          "example": "Authorizer_demo"
        },
        "type": {
          "description": "自定义认证类型\n\n- FRONTEND:前端\n- BACKEND:后端\n\n不支持修改",
          "enum": [
            "FRONTEND",
            "BACKEND"
          ],
          "type": "string",
          "example": "FRONTEND"
        },
        "authorizer_type": {
          "description": "自定义认证的类型。当前只支持函数类型:FUNC。",
          "type": "string",
          "enum": [
            "FUNC"
          ],
          "example": "FUNC"
        },
        "authorizer_uri": {
          "description": "函数地址。",
          "type": "string"
        },
        "network_type": {
          "description": "对接函数的网络架构类型\n- V1:非VPC网络架构\n- V2:VPC网络架构",
          "type": "string",
          "enum": [
            "V1",
            "V2"
          ],
          "default": "V1",
          "example": "V1"
        },
        "authorizer_version": {
          "description": "函数版本。\n\n当函数别名URN和函数版本同时传入时,函数版本将被忽略,只会使用函数别名URN",
          "type": "string",
          "maxLength": 64,
          "example": "v1"
        },
        "authorizer_alias_uri": {
          "description": "函数别名地址。\n\n当函数别名URN和函数版本同时传入时,函数版本将被忽略,只会使用函数别名URN",
          "type": "string",
          "example": "urn:fss:xx-xxx-4:106506b9a92342df9a5025fc12351cfc:function:defau:apigDemo_1592617458814:!v1"
        },
        "identities": {
          "description": "认证来源",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Identity"
          }
        },
        "ttl": {
          "description": "缓存时间",
          "type": "integer",
          "format": "int32",
          "example": 5
        },
        "user_data": {
          "description": "用户数据",
          "type": "string",
          "example": "authorizer_test"
        },
        "ld_api_id": {
          "description": "自定义后端服务ID。\n\n暂不支持",
          "type": "string"
        },
        "need_body": {
          "description": "是否发送body",
          "type": "boolean",
          "example": true
        }
      }
    },
    "BasePage": {
      "properties": {
        "size": {
          "description": "本次返回的列表长度",
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "description": "满足条件的记录数",
          "type": "integer",
          "format": "int64"
        }
      },
      "description": "分页基本信息",
      "required": [
        "size",
        "total"
      ]
    },
    "Identity": {
      "required": [
        "name",
        "location"
      ],
      "properties": {
        "name": {
          "description": "参数名称",
          "type": "string",
          "example": "header"
        },
        "location": {
          "description": "参数位置",
          "enum": [
            "HEADER",
            "QUERY"
          ],
          "type": "string",
          "example": "HEADER"
        },
        "validation": {
          "description": "参数校验表达式,默认为null,不做校验",
          "type": "string"
        }
      }
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "AuthorizerResp": {
      "allOf": [
        {
          "$ref": "#/definitions/AuthorizerBase"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "自定义认证编号",
              "type": "string"
            },
            "create_time": {
              "type": "string",
              "description": "创建时间",
              "format": "date-time"
            },
            "roma_app_id": {
              "description": "自定义认证所属应用编号\n\n暂不支持",
              "type": "string"
            },
            "roma_app_name": {
              "description": "自定义认证所属应用名称\n\n暂不支持",
              "type": "string"
            }
          }
        }
      ]
    },
    "AuthorizerPage": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "authorizer_list": {
              "description": "自定义认证列表",
              "type": "array",
              "items": {
                "$ref": "#/definitions/AuthorizerResp"
              }
            }
          }
        }
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_offset": {
      "name": "offset",
      "in": "query",
      "type": "integer",
      "description": "偏移量,表示从此偏移量开始查询,偏移量小于0时,自动转换为0",
      "format": "int64",
      "default": 0,
      "x-example": 1
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID,在API网关控制台的“实例信息”中获取。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见[获取项目ID](apig-api-180713009.xml)。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "apic_limit": {
      "name": "limit",
      "in": "query",
      "type": "integer",
      "description": "每页显示的条目数量,条目数量小于等于0时,自动转换为20,条目数量大于500时,自动转换为500",
      "format": "int32",
      "minimum": 1,
      "maximum": 500,
      "default": 20,
      "x-example": 10
    }
  },
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
