  "definitions": {
    "MicroserviceImportResp": {
      "description": "导入微服务的响应对象",
      "properties": {
        "vpc_channel_id": {
          "type": "string",
          "description": "vpc通道编号",
          "example": "a802aead5122433a91ea7df2c45c2a58"
        },
        "api_group_id": {
          "type": "string",
          "description": "api分组编号",
          "example": "a802aead5122433a91ea7df2c45c2a58"
        },
        "apis": {
          "description": "导入的api列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MicroserviceImportApiResp"
          }
        }
      }
    },
    "MicroserviceImportReq": {
      "description": "导入微服务的请求对象",
      "properties": {
        "group_info": {
          "$ref": "#/definitions/MicroserviceGroup"
        },
        "service_type": {
          "description": "微服务中心类型。\n- CSE:CSE微服务注册中心\n- CCE:CCE云容器引擎(工作负载)\n- CCE_SERVICE:CCE云容器引擎(Service)(暂不支持)\n- NACOS:nacos注册中心,nacos_info必填",
          "enum": [
            "CSE",
            "CCE",
            "CCE_SERVICE",
            "NACOS"
          ],
          "type": "string"
        },
        "protocol": {
          "type": "string",
          "description": "API网关访问微服务的请求协议\n- HTTP\n- HTTPS",
          "enum": [
            "HTTP",
            "HTTPS"
          ],
          "example": "HTTPS",
          "default": "HTTPS"
        },
        "apis": {
          "description": "导入的api列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MicroserviceApiCreate"
          },
          "minItems": 1,
          "maxItems": 50
        },
        "backend_timeout": {
          "description": "APIG请求后端服务的超时时间。最大超时时间可通过实例特性backend_timeout配置修改,可修改的上限为600000,默认5000\n\n单位:毫秒。",
          "minimum": 1,
          "type": "integer",
          "format": "int32",
          "default": 5000,
          "example": 3000
        },
        "auth_type": {
          "description": "API的认证方式,默认无认证。\n- NONE:无认证\n- APP:APP认证\n- IAM:IAM认证",
          "type": "string",
          "default": "NONE",
          "enum": [
            "NONE",
            "APP",
            "IAM"
          ],
          "example": "IAM"
        },
        "cors": {
          "description": "是否支持跨域,默认不支持\n- true:支持\n- false:不支持",
          "default": false,
          "enum": [
            true,
            false
          ],
          "type": "boolean",
          "example": false
        },
        "cse_info": {
          "$ref": "#/definitions/MicroServiceInfoCSECreate"
        },
        "cce_info": {
          "$ref": "#/definitions/MicroServiceInfoCCECreate"
        },
        "cce_service_info": {
          "$ref": "#/definitions/MicroServiceInfoCCEServiceCreate"
        },
        "nacos_info": {
          "description": "nacos基础信息。",
          "$ref": "#/definitions/MicroServiceInfoNacosBase"
        }
      },
      "required": [
        "group_info",
        "apis",
        "service_type"
      ]
    },
    "MicroServiceInfoCCEBase": {
      "description": "CCE云容器引擎工作负载信息,service_type为CCE时必填。app_name或(label_key、label_value)至少填一个,只填app_name时,相当于(label_key=‘app’、label_value=app_name值)",
      "properties": {
        "cluster_id": {
          "type": "string",
          "description": "云容器引擎集群编号",
          "example": "fde2c21c-5bd9-40f0-ad6a-81e4b6782805a",
          "maxLength": 64
        },
        "namespace": {
          "type": "string",
          "description": "命名空间",
          "example": "default",
          "maxLength": 64
        },
        "workload_type": {
          "description": "工作负载类型\n - deployment:无状态负载\n - statefulset:有状态负载\n - daemonset:守护进程集",
          "type": "string",
          "enum": [
            "deployment",
            "statefulset",
            "daemonset"
          ]
        },
        "app_name": {
          "type": "string",
          "description": "APP名称。支持汉字,英文,数字,点,中划线,下划线,且只能以英文和汉字开头,1-64字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "example": "name",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9._-]|[\\一-\\龥]){1,64}$"
        },
        "label_key": {
          "type": "string",
          "description": "服务标识名。支持汉字、英文、数字、中划线、下划线、点、斜杠、中英文格式下的小括号和冒号,且只能以英文、汉字和数字开头,1-64个字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "example": "app",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^([a-zA-Z0-9]|[\\一-\\龥])([a-zA-Z0-9:._()\\\\//-]|[\\一-\\龥\\（\\）\\：\\、]){1,64}$"
        },
        "label_value": {
          "type": "string",
          "description": "服务标识值。支持汉字,英文,数字,点,中划线,下划线,且只能以英文和汉字开头,1-64字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "example": "value",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9._-]|[\\一-\\龥]){1,64}$"
        }
      },
      "required": [
        "cluster_id",
        "namespace",
        "workload_type"
      ]
    },
    "MicroServiceInfoCCEServiceCreate": {
      "description": "CCE云容器引擎Service信息,service_type为CCE_SERVICE时必填",
      "allOf": [
        {
          "$ref": "#/definitions/MicroServiceInfoCCEServiceBase"
        },
        {
          "type": "object",
          "properties": {
            "port": {
              "description": "Service的监听端口号。如果是多端口Service,用户需填写一个端口。",
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 65535,
              "example": 80
            }
          }
        }
      ]
    },
    "MicroServiceInfoCCEServiceBase": {
      "description": "CCE云容器引擎Service信息",
      "properties": {
        "cluster_id": {
          "type": "string",
          "description": "云容器引擎集群编号",
          "example": "fde2c21c-5bd9-40f0-ad6a-81e4b6782805a",
          "maxLength": 64
        },
        "namespace": {
          "type": "string",
          "description": "命名空间。1-63字符。只能包含小写字母、数字,以及 '-',必须以字母开头,必须以字母数字结尾。",
          "example": "default",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^([a-z])([a-z0-9-]){0,62}$"
        },
        "service_name": {
          "type": "string",
          "description": "Service名称。支持汉字,英文,数字,点,中划线,下划线,且只能以英文和汉字开头,1-64字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "example": "name",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9._-]|[\\一-\\龥]){1,64}$"
        }
      },
      "required": [
        "cluster_id",
        "namespace",
        "service_name"
      ]
    },
    "MicroServiceInfoCSEBase": {
      "description": "CSE微服务详细信息,service_type为CSE时必填",
      "properties": {
        "engine_id": {
          "type": "string",
          "description": "微服务引擎编号",
          "example": "fde2c21c-5bd9-40f0-ad6a-81e4b6782805a",
          "maxLength": 64
        },
        "service_id": {
          "type": "string",
          "description": "微服务编号",
          "example": "92919f98fba80c2df13cc285c983946c90e635ff",
          "maxLength": 64
        }
      },
      "required": [
        "engine_id",
        "service_id"
      ]
    },
    "MicroserviceApiCreate": {
      "description": "导入微服务创建单个API的对象",
      "properties": {
        "name": {
          "description": "API名称。\n\n支持汉字、英文、数字、中划线、下划线、点、斜杠、中英文格式下的小括号和冒号、中文格式下的顿号,且只能以英文、汉字和数字开头。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "pattern": "^([a-zA-Z0-9]|[\\一-\\龥])([a-zA-Z0-9:._()\\\\//-]|[\\一-\\龥\\（\\）\\：\\、]){2,254}$",
          "minLength": 3,
          "maxLength": 255,
          "example": "api_name"
        },
        "req_method": {
          "description": "API的请求方式",
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "HEAD",
            "PATCH",
            "OPTIONS",
            "ANY"
          ],
          "example": "GET",
          "default": "ANY"
        },
        "req_uri": {
          "description": "请求地址。可以包含请求参数,用{}标识,比如/getUserInfo/{userId},支持 * % - _ . 等特殊字符,总长度不超过512,且满足URI规范。\n\n/apic/health_check为APIG预置的健康检查路径,当req_method=GET时不支持req_uri=/apic/health_check。\n\n> 需要服从URI规范。",
          "type": "string",
          "example": "/test",
          "minLength": 1,
          "maxLength": 512
        },
        "match_mode": {
          "description": "API的匹配方式\n- SWA:前缀匹配\n- NORMAL:正常匹配(绝对匹配)\n默认:NORMAL",
          "type": "string",
          "default": "SWA",
          "enum": [
            "SWA",
            "NORMAL"
          ],
          "example": "NORMAL"
        }
      },
      "required": [
        "req_uri"
      ]
    },
    "MicroserviceLabel": {
      "required": [
        "label_name",
        "label_value"
      ],
      "properties": {
        "label_name": {
          "type": "string",
          "description": "标签名称。\n\n以字母或者数字开头和结尾,由字母、数字、连接符('-')、下划线('_')、点号('.')组成且63个字符之内。",
          "example": "clusterid",
          "pattern": "^[a-zA-Z0-9]$|(^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,61})[a-zA-Z0-9]$)",
          "minLength": 1,
          "maxLength": 63
        },
        "label_value": {
          "type": "string",
          "description": "标签值。\n\n以字母或者数字开头和结尾,由字母、数字、连接符('-')、下划线('_')、点号('.')组成且63个字符之内。",
          "example": "c429700c-5dc4-482a-9c0e-99f6c0635113",
          "pattern": "^[a-zA-Z0-9]$|(^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,61})[a-zA-Z0-9]$)",
          "minLength": 1,
          "maxLength": 63
        }
      }
    },
    "MicroServiceInfoCCECreate": {
      "description": "CCE云容器引擎工作负载信息,service_type为CCE时必填",
      "allOf": [
        {
          "$ref": "#/definitions/MicroServiceInfoCCEBase"
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "description": "工作负载的版本",
              "example": "v1",
              "maxLength": 64
            },
            "port": {
              "description": "工作负载的监听端口号",
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 65535,
              "example": 80
            },
            "labels": {
              "description": "工作负载的标签列表。",
              "type": "array",
              "items": {
                "$ref": "#/definitions/MicroserviceLabel"
              }
            }
          },
          "required": [
            "port"
          ]
        }
      ]
    },
    "MicroserviceGroup": {
      "description": "导入微服务的API分组信息",
      "properties": {
        "group_id": {
          "type": "string",
          "description": "指定已有的分组,为空时创建新的分组",
          "example": "9d075537ff314a5e8e5c98bf29549b89",
          "minLength": 0,
          "maxLength": 64
        },
        "group_name": {
          "description": "API分组的名称,group_id为空时必填。\n\n支持汉字、英文、数字、中划线、下划线、点、斜杠、中英文格式下的小括号和冒号、中文格式下的顿号,且只能以英文、汉字和数字开头,3-255个字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "maxLength": 255,
          "minLength": 3,
          "type": "string",
          "example": "api_group_001",
          "pattern": "^([a-zA-Z0-9]|[\\一-\\龥])([a-zA-Z0-9:._()\\\\//-]|[\\一-\\龥\\（\\）\\：\\、]){2,254}$"
        },
        "app_id": {
          "type": "string",
          "description": "group_id为空时必填,指定新分组所属的集成应用",
          "example": "9d075537ff314a5e8e5c98bf29549b89",
          "minLength": 0,
          "maxLength": 64
        }
      }
    },
    "MicroserviceImportApiResp": {
      "description": "导入的微服务API的响应对象",
      "properties": {
        "name": {
          "description": "API名称",
          "type": "string",
          "example": "/apiname"
        },
        "req_uri": {
          "description": "API请求路径",
          "type": "string",
          "example": "/example"
        },
        "req_method": {
          "description": "API请求方法",
          "type": "string",
          "example": "GET"
        },
        "id": {
          "description": "API编号",
          "type": "string",
          "example": "a802aead5122433a91ea7df2c45c2a58"
        },
        "match_mode": {
          "description": "API的匹配方式\n- SWA:前缀匹配\n- NORMAL:正常匹配(绝对匹配)\n默认:SWA",
          "type": "string",
          "enum": [
            "SWA",
            "NORMAL"
          ],
          "example": "NORMAL"
        }
      }
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "NacosUserInfo": {
      "description": "nacos用户信息。",
      "required": [
        "user_name",
        "password"
      ],
      "properties": {
        "user_name": {
          "type": "string",
          "description": "nacos用户名。",
          "minLength": 1,
          "maxLength": 64
        },
        "password": {
          "type": "string",
          "description": "nacos密码。",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "NacosServerConfig": {
      "description": "nacos服务端配置信息。",
      "required": [
        "ip_address",
        "port"
      ],
      "properties": {
        "ip_address": {
          "type": "string",
