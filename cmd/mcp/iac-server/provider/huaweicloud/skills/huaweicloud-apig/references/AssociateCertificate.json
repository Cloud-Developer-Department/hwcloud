{
  "name": "AssociateCertificate",
  "summary": "绑定域名证书",
  "tags": "共享版-域名管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/apigw/api-groups/{group_id}/domains/{domain_id}/certificate": {
      "post": {
        "summary": "绑定域名证书",
        "description": "如果创建API时,“定义API请求”使用HTTPS请求协议,那么在独立域名中需要添加SSL证书。\n本章节主要介绍为特定域名绑定证书。",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "operationId": "AssociateCertificate",
        "responses": {
          "201": {
            "schema": {
              "$ref": "#/definitions/DomainCertResp"
            },
            "examples": {
              "application/json": {
                "ssl_name": "test_ssl",
                "url_domain": "www.example.com",
                "ssl_id": "0a515af69f4e4dcca84fbf85f68c0e27",
                "id": " b9be707660c5406394f8973e087bae20",
                "status": 3
              }
            },
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "required": true
          },
          {
            "in": "path",
            "name": "domain_id",
            "x-example": "57e7248244ee457cb0ddb64b012f4cbe",
            "description": "域名的编号",
            "type": "string",
            "required": true
          },
          {
            "in": "path",
            "name": "group_id",
            "x-example": "57e7248244ee457cb0ddb64b012f4cbe",
            "description": "分组的编号",
            "type": "string",
            "required": true
          },
          {
            "schema": {
              "$ref": "#/definitions/DomainCertReq"
            },
            "in": "body",
            "name": "AssociateCertificateRequestBody",
            "description": "绑定域名证书的请求体",
            "required": true
          }
        ],
        "tags": [
          "共享版-域名管理"
        ]
      }
    }
  },
  "definitions": {
    "DomainCertReq": {
      "required": [
        "name",
        "cert_content",
        "private_key"
      ],
      "properties": {
        "cert_content": {
          "description": "证书内容",
          "type": "string",
          "example": "example"
        },
        "name": {
          "description": "证书名称。长度为4 ~ 50位的字符串,字符串由中文、英文字母、数字、下划线组成,且只能以英文或中文开头。",
          "type": "string",
          "example": "test_ssl"
        },
        "private_key": {
          "description": "私钥内容",
          "type": "string",
          "example": "example"
        }
      }
    },
    "DomainCertResp": {
      "required": [
        "id",
        "url_domain",
        "status",
        "ssl_id",
        "ssl_name"
      ],
      "properties": {
        "ssl_name": {
          "description": "证书的名称",
          "type": "string",
          "example": "证书"
        },
        "url_domain": {
          "description": "自定义域名",
          "type": "string",
          "example": "www.example.com"
        },
        "ssl_id": {
          "description": "证书的编号",
          "type": "string",
          "example": "0a515af69f4e4dcca84fbf85f68c0e27"
        },
        "id": {
          "description": "自定义域名的编号",
          "type": "string",
          "example": "b9be707660c5406394f8973e087bae20"
        },
        "status": {
          "description": "解析状态值",
          "type": "integer",
          "example": 3
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v1.0",
  "info_version": "v1",
  "method": "post",
  "uri": null
}