            "CreateSuccess",
            "CreateFail",
            "Initing",
            "Registering",
            "Running",
            "InitingFailed",
            "RegisterFailed",
            "Installing",
            "InstallFailed",
            "Updating",
            "UpdateFailed",
            "Rollbacking",
            "RollbackSuccess",
            "RollbackFailed",
            "Deleting",
            "DeleteFailed",
            "Unregistering",
            "UnRegisterFailed",
            "CreateTimeout",
            "InitTimeout",
            "RegisterTimeout",
            "InstallTimeout",
            "UpdateTimeout",
            "RollbackTimeout",
            "DeleteTimeout",
            "UnregisterTimeout",
            "Starting",
            "Freezing",
