{
  "name": "CreateEnvironment",
  "summary": "创建环境",
  "tags": "共享版-环境管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/apigw/envs": {
      "post": {
        "tags": [
          "共享版-环境管理"
        ],
        "summary": "创建环境",
        "description": "在实际的生产中,API提供者可能有多个环境,如开发环境、测试环境、生产环境等,用户可以自由将API发布到某个环境,供调用者调用。对于不同的环境,API的版本、请求地址甚至于包括请求消息等均有可能不同。如:某个API,v1.0的版本为稳定版本,发布到了生产环境供生产使用,同时,该API正处于迭代中,v1.1的版本是开发人员交付测试人员进行测试的版本,发布在测试环境上,而v1.2的版本目前开发团队正处于开发过程中,可以发布到开发环境进行自测等。\n为此,API网关提供多共享版-环境管理功能,使租户能够最大化的模拟实际场景,低成本的接入API网关。",
        "operationId": "CreateEnvironment",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "schemes": [
          "https"
        ],
        "responses": {
          "201": {
            "schema": {
              "$ref": "#/definitions/EnvResp"
            },
            "examples": {
              "application/json": {
                "create_time": "2017-12-28T12:50:47.0744311Z",
                "name": "DEV",
                "remark": "开发环境",
                "env_id": "cca3616a-f368-4b32-9064-b2a631cb3eeb"
              }
            },
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "required": true
          },
          {
            "schema": {
              "$ref": "#/definitions/EnvReq"
            },
            "in": "body",
            "name": "CreateEnvironmentRequestBody",
            "description": "创建环境的请求体",
            "required": true
          }
        ]
      }
    }
  },
  "definitions": {
    "EnvReq": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "环境的名称,支持英文,数字,下划线,且只能以英文字母开头,3 ~ 64字符。",
          "type": "string",
          "example": "DEV"
        },
        "remark": {
          "description": "描述信息,字符长度不能大于255\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "开发环境"
        }
      }
    },
    "EnvResp": {
      "properties": {
        "create_time": {
          "description": "创建时间",
          "type": "string"
        },
        "name": {
          "description": "环境名称",
          "type": "string"
        },
        "remark": {
          "description": "描述信息",
          "type": "string"
        },
        "id": {
          "description": "环境id",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v1.0",
  "info_version": "v1",
  "method": "post",
  "uri": null
}