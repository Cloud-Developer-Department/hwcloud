{
  "name": "AssociateDomain",
  "summary": "绑定域名",
  "tags": "共享版-域名管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/apigw/api-groups/{group_id}/domains": {
      "post": {
        "summary": "绑定域名",
        "description": "用户自定义的域名,需要CNAME到API分组的子域名上才能生效,具体方法请参见[增加CNAME类型记录集](https://support.huaweicloud.com/usermanual-dns/dns_usermanual_0010.html)。\n每个API分组下最多可绑定5个域名。绑定域名后,用户可通过自定义域名调用API。",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "operationId": "AssociateDomain",
        "responses": {
          "201": {
            "schema": {
              "$ref": "#/definitions/DomainResp"
            },
            "examples": {
              "application/json": {
                "url_domain": "www.company.com",
                "id": "c5e0d5ba62a34d26ad5c709ae22c1a17",
                "status": 3
              }
            },
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "required": true
          },
          {
            "in": "path",
            "name": "group_id",
            "x-example": "57e7248244ee457cb0ddb64b012f4cbe",
            "description": "API分组编号",
            "type": "string",
            "required": true
          },
          {
            "schema": {
              "$ref": "#/definitions/DomainReq"
            },
            "in": "body",
            "name": "AssociateDomainRequestBody",
            "description": "绑定域名的请求体",
            "required": true
          }
        ],
        "tags": [
          "共享版-域名管理"
        ]
      }
    }
  },
  "definitions": {
    "DomainResp": {
      "required": [
        "id",
        "url_domain",
        "status"
      ],
      "properties": {
        "url_domain": {
          "description": "自定义域名",
          "type": "string",
          "example": "www.MyCompany.com"
        },
        "id": {
          "description": "域名的编号",
          "type": "string",
          "example": "c5e0d5ba62a34d26ad5c709ae22c1a17"
        },
        "status": {
          "description": "CNAME解析状态\n- 1 未解析\n- 2 解析中\n- 3 解析成功\n- 4 解析失败",
          "type": "integer",
          "example": 3
        }
      }
    },
    "DomainReq": {
      "required": [
        "url_domain"
      ],
      "properties": {
        "url_domain": {
          "description": "自定义域名。长度为0-255位的字符串,需要符合域名规范。",
          "type": "string",
          "example": "www.company.com"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v1.0",
  "info_version": "v1",
  "method": "post",
  "uri": null
}