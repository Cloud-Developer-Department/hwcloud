  "definitions": {
    "BasePage": {
      "properties": {
        "size": {
          "description": "本次返回的列表长度",
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "description": "满足条件的记录数",
          "type": "integer",
          "format": "int64"
        }
      },
      "description": "分页基本信息",
      "required": [
        "size",
        "total"
      ]
    },
    "AppCodeCreate": {
      "required": [
        "app_code"
      ],
      "properties": {
        "app_code": {
          "description": "App Code值\n\n支持英文、数字,+_!@#$%-/=,且只能以英文、数字和+、/开头,64-180个字符。",
          "type": "string",
          "pattern": "^[a-zA-Z0-9+/]([a-zA-Z0-9-_!@#$%+/=]){63,179}$"
        }
      }
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "AppCodeBaseInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/AppCodeCreate"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "编号",
              "type": "string"
            },
            "app_id": {
              "description": "应用编号",
              "type": "string"
            },
            "create_time": {
              "description": "创建时间",
              "type": "string"
            }
          }
        }
      ]
    },
    "AppCodePageInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "app_codes": {
              "description": "App Code列表",
              "type": "array",
              "items": {
                "$ref": "#/definitions/AppCodeBaseInfo"
              }
            }
          }
        }
      ]
    }
