          "type": "integer"
        },
        "app_call_limits": {
          "description": "单个APP流控时间内能够访问API的次数限制",
          "type": "integer"
        },
        "name": {
          "description": "流控策略的名称",
          "type": "string"
        },
        "time_unit": {
          "description": "流控的时间单位",
          "type": "string"
        },
        "api_call_limits": {
          "description": "单个API流控时间内能够被访问的次数限制",
