  "definitions": {
    "ThrottleReq": {
      "required": [
        "name",
        "api_call_limits",
        "time_interval",
        "time_unit"
      ],
      "properties": {
        "app_call_limits": {
          "description": "APP流量限制是指一个API在时长之内被每个APP访问的次数上限,该数值不超过用户流量限制值。输入的值不超过2147483647。正整数。",
          "type": "integer",
          "example": 300
        },
        "name": {
          "description": "流控策略名称。支持汉字,英文,数字,下划线,且只能以英文和汉字开头,3 ~ 64字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "每秒1000次"
        },
        "time_unit": {
          "description": "流控的时间单位:\n- SECOND\n- MINUTE\n- HOUR\n- DAY",
          "type": "string",
          "example": "MINUTE"
        },
        "remark": {
          "description": "流控策略描述字符长度不超过255。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "API每秒800次,用户500次,APP300次,IP600次"
        },
        "api_call_limits": {
          "description": "API流量限制是指时长内一个API能够被访问的次数上限。该值不超过系统默认配额限制,系统默认配额为200tps,用户可根据实际情况修改该系统默认配额。输入的值不超过2147483647。正整数。",
          "type": "integer",
          "example": 800
        },
        "type": {
          "description": "流控策略的类型,取值如下:\n- 1:独享,表示绑定到流控策略的单个API流控时间内能够被调用多少次。\n- 2:共享,表示绑定到流控策略的所有API流控时间内能够被调用多少次。",
          "type": "integer",
          "example": 1
        },
        "enable_adaptive_control": {
          "description": "是否开启动态流控::\n- TRUE\n- FALSE\n\n暂不支持",
          "type": "string",
          "example": 1
        },
        "user_call_limits": {
          "description": "用户流量限制是指一个API在时长之内每一个用户能访问的次数上限,该数值不超过API流量限制值。输入的值不超过2147483647。正整数。",
          "type": "integer",
          "example": 500
        },
        "time_interval": {
          "description": "流量控制的时长单位。与“流量限制次数”配合使用,表示单位时间内的API请求次数上限。输入的值不超过2147483647。正整数。",
          "type": "integer",
          "example": 1
        },
        "ip_call_limits": {
          "description": "源IP流量限制是指一个API在时长之内被每个IP访问的次数上限,该数值不超过API流量限制值。输入的值不超过2147483647。正整数。",
          "type": "integer",
          "example": 600
        }
      }
    },
