            "update_time": {
              "description": "更新时间",
              "type": "string",
              "format": "date-time",
              "example": "2017-12-28T12:28:07.296Z"
            },
            "app_key": {
              "description": "APP凭据的key。",
              "type": "string",
              "example": "14b399ac967f4115bb62c0346b4537e9"
            },
            "related_domain_id": {
              "description": "凭据关联的账号ID。",
              "type": "string",
              "minLength": 32,
              "maxLength": 36,
              "example": "c90f12a0f1ee43bc90a1f4d17bce35bc"
            },
            "related_project_id": {
              "description": "凭据关联的项目ID。",
              "type": "string",
              "minLength": 32,
              "maxLength": 36,
              "example": "a10f12a0f1ee43bc90a1f4d17bce35aa"
            },
            "app_secret": {
              "description": "密钥",
              "type": "string"
            },
            "register_time": {
              "description": "注册时间",
              "type": "string",
              "format": "date-time",
              "example": "2017-12-28T12:26:54.000Z"
            },
            "status": {
              "description": "状态\n  - 1: 有效",
              "enum": [
                1
              ],
              "type": "integer",
              "format": "int32",
              "example": 1
            },
            "app_type": {
              "description": "APP的类型。\n- apig:APIG凭据应用\n\n默认apig,暂不支持其他类型",
              "type": "string",
              "example": "apig",
              "enum": [
                "apig"
              ]
            },
            "roma_app_type": {
              "type": "string",
              "description": "ROMA_APP的类型:\n- subscription:订阅应用\n- integration:集成应用\n\n暂不支持"
            }
          }
        }
      ]
    },
    "AppPageInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "apps": {
              "description": "APP列表",
              "type": "array",
              "items": {
                "$ref": "#/definitions/AppInfoWithBindNum"
              }
            }
          }
        }
      ]
    }
