          }
        }
      ]
    },
    "AppInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/AppBaseInfo"
        },
        {
          "type": "object",
          "properties": {
            "creator": {
              "description": "APP的创建者\n- USER:用户自行创建\n- MARKET:云商店分配\n\n暂不支持MARKET",
              "enum": [
                "USER",
                "MARKET"
              ],
              "type": "string",
              "example": "USER"
