        "size",
        "total"
      ]
    },
    "AppBaseInfo": {
      "properties": {
        "id": {
          "description": "编号",
          "type": "string"
        },
        "name": {
          "description": "名称",
          "type": "string",
          "example": "app_sample"
        },
        "remark": {
          "description": "描述",
          "type": "string",
          "example": "第一个APP"
