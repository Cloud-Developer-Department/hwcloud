{
  "name": "ListApiRuntimeDefinitionV2",
  "summary": "查询API运行时定义",
  "tags": "专享版-API管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/{project_id}/apigw/instances/{instance_id}/apis/runtime/{api_id}": {
      "get": {
        "summary": "查询API运行时定义",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-produc-type": "apig",
        "x-apigateway-request-type": "public",
        "tags": [
          "专享版-API管理"
        ],
        "description": "查询指定的API在指定的环境上的运行时定义,默认查询RELEASE环境上的运行时定义。\n\nAPI的定义分为临时定义和运行时定义,分别代表如下含义:\n- 临时定义:API在编辑中的定义,表示用户最后一次编辑后的API的状态\n- 运行时定义:API在发布到某个环境时,对发布时的API的临时定义进行快照,固化出来的API的状态。\n\n访问某个环境上的API,其实访问的就是其运行时的定义",
        "x-api-type": "open-api",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk,cmcc,ctc,dt,g42,hk_g42,hk_sbc,hk_tm,hws_eu,hws_ocb,ocb,sbc,tm,srg,ax",
        "operationId": "ListApiRuntimeDefinitionV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_api_id"
          },
          {
            "in": "query",
            "name": "env_id",
            "required": false,
            "description": "API的发布环境编号",
            "type": "string",
            "x-example": "DEFAULT_ENVIRONMENT_RELEASE_ID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ApiRuntimeDefinition"
            },
            "examples": {
              "application/json": {
                "name": "Api_http",
                "type": 1,
                "version": "V0.0.1",
                "req_protocol": "HTTPS",
                "req_method": "GET",
                "req_uri": "/test/http",
                "auth_type": "AUTHORIZER",
                "authorizer_id": "8d0443832a194eaa84244e0c1c1912ac",
                "auth_opt": {
                  "app_code_auth_type": "DISABLE"
                },
                "cors": false,
                "match_mode": "NORMAL",
                "backend_type": "HTTP",
                "remark": "Web backend API",
                "group_id": "c77f5e81d9cb4424bf704ef2b0ac7600",
                "result_normal_sample": "Example success response",
                "result_failure_sample": "Example failure response",
                "id": "5f918d104dc84480a75166ba99efff21",
                "group_name": "api_group_001",
                "run_env_id": "DEFAULT_ENVIRONMENT_RELEASE_ID",
                "run_env_name": "RELEASE",
                "publish_id": "9191cdb430724d4b8586ed7f1b962ca2",
                "sl_domain": "c77f5e81d9cb4424bf704ef2b0ac7600.apic.****.com",
                "sl_domains": [
                  "c77f5e81d9cb4424bf704ef2b0ac7600.apic.****.com",
                  "c77f5e81d9cb4424bf704ef2b0ac7600.apic.****.cn"
                ]
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3002",
                "error_msg": "API 5f918d104dc84480a75166ba99efff21 does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ApiRuntimeDefinition": {
      "allOf": [
        {
          "$ref": "#/definitions/ApiBaseInfo"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "API编号",
              "type": "string",
              "example": "0e51b689e0784bc884f43756bbf34fa5"
            },
            "group_name": {
              "description": "API所属分组的名称",
              "type": "string",
              "example": "market_group01"
            },
            "run_env_name": {
              "description": "发布的环境名",
              "type": "string",
              "example": "RELEASE"
            },
            "run_env_id": {
              "description": "发布的环境id",
              "type": "string",
              "example": "DEFAULT_ENVIRONMENT_RELEASE_ID"
            },
            "publish_id": {
              "description": "发布记录的编号",
              "type": "string",
              "example": "f07eb9f5e5ba4bbfbe89326f5cae99c7"
            },
            "sl_domain": {
              "description": "分组的二级域名",
              "type": "string",
              "example": "61297835ff1e4905b6f635dbcdf1777e.apigw.example.com"
            },
            "sl_domains": {
              "description": "系统默认分配的子域名列表",
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "aa35dd27fcb9475f8b1b19669ba60309.apic.****.com",
                "aa35dd27fcb9475f8b1b19669ba60309.apic.****.cn"
              ]
            },
            "req_params": {
              "description": "API的请求参数列表",
              "type": "array",
              "items": {
                "$ref": "#/definitions/ReqParam"
              }
            }
          }
        }
      ]
    },
    "ReqParam": {
      "allOf": [
        {
          "$ref": "#/definitions/ReqParamBase"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "参数编号",
              "type": "string"
            }
          }
        }
      ]
    },
    "ApiBaseInfo": {
      "required": [
        "group_id",
        "name",
        "type",
        "req_protocol",
        "req_method",
        "req_uri",
        "auth_type",
        "backend_type"
      ],
      "properties": {
        "name": {
          "description": "API名称。\n\n支持汉字、英文、数字、中划线、下划线、点、斜杠、中英文格式下的小括号和冒号、中文格式下的顿号,且只能以英文、汉字和数字开头,3-255个字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "api_name"
        },
        "type": {
          "description": "API类型\n- 1:公有API\n- 2:私有API",
          "type": "integer",
          "format": "int32",
          "enum": [
            1,
            2
          ],
          "example": 1
        },
        "version": {
          "description": "API的版本",
          "maxLength": 16,
          "type": "string",
          "example": "v1"
        },
        "req_protocol": {
          "description": "API的请求协议\n- HTTP\n- HTTPS\n- BOTH:同时支持HTTP和HTTPS\n- GRPCS",
          "default": "HTTPS",
          "type": "string",
          "enum": [
            "HTTP",
            "HTTPS",
            "BOTH",
            "GRPCS"
          ],
          "example": "HTTP"
        },
        "req_method": {
          "description": "API的请求方式,当API的请求协议为GRPC类型协议时请求方式固定为POST。",
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "HEAD",
            "PATCH",
            "OPTIONS",
            "ANY"
          ],
          "example": "GET"
        },
        "req_uri": {
          "description": "请求地址。可以包含请求参数,用{}标识,比如/getUserInfo/{userId},支持 * % - _ . 等特殊字符,总长度不超过512,且满足URI规范。\n\n> 需要服从URI规范。",
          "type": "string",
          "example": "/test"
        },
        "auth_type": {
          "description": "API的认证方式\n- NONE:无认证\n- APP:APP认证\n- IAM:IAM认证\n- AUTHORIZER:自定义认证,当auth_type取值为AUTHORIZER时,authorizer_id字段必须传入",
          "type": "string",
          "enum": [
            "NONE",
            "APP",
            "IAM",
            "AUTHORIZER"
          ],
          "example": "IAM"
        },
        "auth_opt": {
          "$ref": "#/definitions/AuthOpt"
        },
        "cors": {
          "description": "是否支持跨域\n- TRUE:支持\n- FALSE:不支持",
          "default": false,
          "enum": [
            true,
            false
          ],
          "type": "boolean",
          "example": false
        },
        "trace_enabled": {
          "description": "是否开启链路追踪,默认关闭。",
          "type": "boolean",
          "example": true,
          "default": false
        },
        "sampling_strategy": {
          "description": "采样策略,当选择开启链路追踪时,此字段必填。\n- RATE:按比例采样",
          "enum": [
            "RATE"
          ],
          "type": "string",
          "example": "RATE"
        },
        "sampling_param": {
          "description": "采样参数。\n- 当采样策略为RATE时,此字段取值为字符串化的整数,范围为0-100,缺省为'100','100'为采集每个请求,建议与后端应用的采样率保持一致。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "example": "10",
          "default": "100"
        },
        "match_mode": {
          "description": "API的匹配方式\n- SWA:前缀匹配\n- NORMAL:正常匹配(绝对匹配)\n默认:NORMAL",
          "type": "string",
          "enum": [
            "SWA",
            "NORMAL"
          ],
          "example": "NORMAL"
        },
        "backend_type": {
          "description": "后端类型\n- HTTP:web后端\n- FUNCTION:函数工作流,当backend_type取值为FUNCTION时,func_info字段必须传入\n- MOCK:模拟的后端,当backend_type取值为MOCK时,mock_info字段必须传入\n- GRPC:grpc后端",
          "type": "string",
          "enum": [
            "HTTP",
            "FUNCTION",
            "MOCK",
            "GRPC"
          ],
          "example": "HTTP"
        },
        "remark": {
          "description": "API描述。字符长度不超过255\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "API描述"
        },
        "group_id": {
          "description": "API所属的分组编号",
          "type": "string",
          "example": "b9be707660c5406394f8973e087bae20"
        },
        "body_remark": {
          "description": "API请求体描述,可以是请求体示例、媒体类型、参数等信息。字符长度不超过20480\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "API请求体描述"
        },
        "result_normal_sample": {
          "description": "正常响应示例,描述API的正常返回信息。字符长度不超过20480\n> 中文字符必须为UTF-8或者unicode编码。\n\n当API的请求协议为GRPC类型时不支持配置。",
          "type": "string",
          "example": "正常响应示例"
        },
        "result_failure_sample": {
          "description": "失败返回示例,描述API的异常返回信息。字符长度不超过20480\n> 中文字符必须为UTF-8或者unicode编码。\n\n当API的请求协议为GRPC类型时不支持配置。",
          "type": "string",
          "example": "失败返回示例"
        },
        "authorizer_id": {
          "description": "前端自定义认证对象的ID",
          "type": "string"
        },
        "tags": {
          "description": "标签。\n\n支持英文,数字,中文,特殊符号(-*#%.:_),且只能以中文或英文开头。\n\n默认支持10个标签,如需扩大配额请联系技术工程师修改API_TAG_NUM_LIMIT配置。",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9]|[\\一-\\龥]){2,23}$",
            "minLength": 1,
            "maxLength": 128
          },
          "example": [
            "tag"
          ]
        },
        "response_id": {
          "description": "分组自定义响应ID",
          "type": "string"
        },
        "roma_app_id": {
          "description": "集成应用ID\n\n暂不支持",
          "type": "string"
        },
        "domain_name": {
          "description": "API绑定的自定义域名\n\n暂不支持",
          "type": "string"
        },
        "tag": {
          "description": "标签\n\n待废弃,优先使用tags字段",
          "type": "string"
        },
        "content_type": {
          "description": "请求内容格式类型:\n\napplication/json\napplication/xml\nmultipart/form-data\ntext/plain",
          "type": "string",
          "enum": [
            "application/json",
            "application/xml",
            "multipart/form-data",
            "text/plain"
          ]
        },
        "is_send_fg_body_base64": {
          "type": "boolean",
          "default": true,
          "description": "是否对与FunctionGraph交互场景的body进行Base64编码。仅当content_type为application/json时,可以不对body进行Base64编码。\n应用场景:\n- 自定义认证\n- 绑定断路器插件,且断路器后端降级策略为函数后端\n- API后端类型为函数工作流"
        }
      }
    },
    "ReqParamBase": {
      "required": [
        "name",
        "type",
        "location"
      ],
      "properties": {
        "name": {
          "description": "参数名称。\n长度为1 ~ 32位的字符串,字符串由英文字母、数字、中划线、下划线、英文句号组成,且只能以英文开头。",
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,31}$",
          "example": "paramName"
        },
        "type": {
          "description": "参数类型。\n- STRING:字符串型\n- NUMBER:数字型",
          "type": "string",
          "enum": [
            "STRING",
            "NUMBER"
          ],
          "example": "STRING"
        },
        "location": {
          "description": "参数位置",
          "type": "string",
          "enum": [
            "PATH",
            "QUERY",
            "HEADER",
            "COOKIE"
          ],
          "example": "QUERY"
        },
        "default_value": {
          "description": "参数默认值",
          "type": "string",
          "example": "参数默认值"
        },
        "sample_value": {
          "description": "参数示例值",
          "type": "string",
          "example": "参数示例值"
        },
        "required": {
          "description": "是否必须\n- 1:是\n- 2:否\n\nlocation为PATH时,required默认为1,其他场景required默认为2",
          "enum": [
            1,
            2
          ],
          "type": "integer",
          "format": "int32",
          "example": 1
        },
        "valid_enable": {
          "description": "是否开启校验\n- 1:开启校验\n- 2:不开启校验",
          "type": "integer",
          "format": "int32",
          "enum": [
            1,
            2
          ],
          "default": 2,
          "example": 1
        },
        "remark": {
          "description": "描述信息。长度不超过255个字符\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "描述信息"
        },
        "enumerations": {
          "description": "参数枚举值",
          "type": "string"
        },
        "min_num": {
          "description": "参数最小值\n\n参数类型为NUMBER时有效",
          "type": "integer",
          "format": "int32"
        },
        "max_num": {
          "description": "参数最大值\n\n参数类型为NUMBER时有效",
          "type": "integer",
          "format": "int32"
        },
        "min_size": {
          "description": "参数最小长度\n\n参数类型为STRING时有效",
          "type": "integer",
          "format": "int32"
        },
        "max_size": {
          "description": "参数最大长度\n\n参数类型为STRING时有效",
          "type": "integer",
          "format": "int32"
        },
        "regular": {
          "description": "正则校验规则\n\n暂不支持",
          "type": "string"
        },
        "json_schema": {
          "description": "JSON校验规则\n\n暂不支持",
          "type": "string"
        },
        "pass_through": {
          "description": "是否透传\n- 1:是\n- 2:否",
          "enum": [
            1,
            2
          ],
          "type": "integer",
          "format": "int32"
        },
        "orchestrations": {
          "description": "请求参数匹配编排规则的生效优先级与列表顺序保持一致,列表中靠前的配置匹配优先级较高;\n如果编排规则列表中包含none_value类型的规则,则none_value类型的规则优先级最高,至多绑定一个none_value类型的规则;\n如果编排规则列表中包含default类型的规则,则default类型的规则优先级最低,至多绑定一个default类型的规则;\n当编排规则为预处理策略时,该规则不能作为除default以外的最后一个编排规则;\n每个API仅允许选择一个参数绑定编排规则,且编排规则不能重复,支持绑定的编排规则数量有配额限制,具体请参见产品介绍的“约束与限制”章节。",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      }
    },
    "AuthOpt": {
      "description": "认证方式参数",
      "properties": {
        "app_code_auth_type": {
          "description": "AppCode简易认证类型,仅在auth_type为APP时生效,默认为DISABLE:\n- DISABLE:不开启简易认证\n- HEADER:开启简易认证且AppCode位置在HEADER",
          "enum": [
            "DISABLE",
            "HEADER"
          ],
          "type": "string",
          "default": "DISABLE",
          "example": "DISABLE"
        }
      }
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID,在API网关控制台的“实例信息”中获取。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见[获取项目ID](apig-api-180713009.xml)。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_api_id": {
      "name": "api_id",
      "in": "path",
      "type": "string",
      "description": "API的编号",
      "required": true,
      "x-example": "5f918d104dc84480a75166ba99efff21"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
  "uri": null
}