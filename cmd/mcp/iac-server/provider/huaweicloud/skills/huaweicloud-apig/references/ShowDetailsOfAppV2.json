{
  "name": "ShowDetailsOfAppV2",
  "summary": "查询APP详情",
  "tags": "专享版-凭据管理",
  "productshort": "APIG",
  "region_id": "ae-ad-1",
  "paths": {
    "/{project_id}/apigw/instances/{instance_id}/apps/{app_id}": {
      "get": {
        "summary": "查询APP详情",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-produc-type": "apig",
        "x-apigateway-request-type": "public",
        "x-order": 6,
        "description": "查询指定APP的详细信息。",
        "schemes": [
          "https"
        ],
        "tags": [
          "专享版-凭据管理"
        ],
        "x-api-type": "open-api",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk,cmcc,ctc,dt,g42,hk_g42,hk_sbc,hk_tm,hws_eu,hws_ocb,ocb,sbc,tm,srg,ax",
        "operationId": "ShowDetailsOfAppV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_app_id"
          }
        ],
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/AppInfo"
            },
            "examples": {
              "application/json": {
                "creator": "USER",
                "update_time": "2020-08-03T13:09:13Z",
                "app_key": "ee8f878c252747028f07eb116c2cd91b",
                "related_domain_id": "123de8eb7a8742168586e5daf5339965",
                "related_project_id": "567de8eb7a8742168586e5daf5339965",
                "name": "app_demo",
                "remark": "Demo app",
                "id": "356de8eb7a8742168586e5daf5339965",
                "app_secret": "416************ab8",
                "register_time": "2020-08-03T13:09:13Z",
                "status": 1,
                "app_type": "apig"
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:id. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3002",
                "error_msg": "App 356de8eb7a8742168586e5daf5339965 does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMsg"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "AppBaseInfo": {
      "properties": {
        "id": {
          "description": "编号",
          "type": "string"
        },
        "name": {
          "description": "名称",
          "type": "string",
          "example": "app_sample"
        },
        "remark": {
          "description": "描述",
          "type": "string",
          "example": "第一个APP"
        }
      }
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "AppInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/AppBaseInfo"
        },
        {
          "type": "object",
          "properties": {
            "creator": {
              "description": "APP的创建者\n- USER:用户自行创建\n- MARKET:云商店分配\n\n暂不支持MARKET",
              "enum": [
                "USER",
                "MARKET"
              ],
              "type": "string",
              "example": "USER"
            },
            "update_time": {
              "description": "更新时间",
              "type": "string",
              "format": "date-time",
              "example": "2017-12-28T12:28:07.296Z"
            },
            "app_key": {
              "description": "APP凭据的key。",
              "type": "string",
              "example": "14b399ac967f4115bb62c0346b4537e9"
            },
            "related_domain_id": {
              "description": "凭据关联的账号ID。",
              "type": "string",
              "minLength": 32,
              "maxLength": 36,
              "example": "c90f12a0f1ee43bc90a1f4d17bce35bc"
            },
            "related_project_id": {
              "description": "凭据关联的项目ID。",
              "type": "string",
              "minLength": 32,
              "maxLength": 36,
              "example": "a10f12a0f1ee43bc90a1f4d17bce35aa"
            },
            "app_secret": {
              "description": "密钥",
              "type": "string"
            },
            "register_time": {
              "description": "注册时间",
              "type": "string",
              "format": "date-time",
              "example": "2017-12-28T12:26:54.000Z"
            },
            "status": {
              "description": "状态\n  - 1: 有效",
              "enum": [
                1
              ],
              "type": "integer",
              "format": "int32",
              "example": 1
            },
            "app_type": {
              "description": "APP的类型。\n- apig:APIG凭据应用\n\n默认apig,暂不支持其他类型",
              "type": "string",
              "example": "apig",
              "enum": [
                "apig"
              ]
            },
            "roma_app_type": {
              "type": "string",
              "description": "ROMA_APP的类型:\n- subscription:订阅应用\n- integration:集成应用\n\n暂不支持"
            }
          }
        }
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_app_id": {
      "name": "app_id",
      "in": "path",
      "type": "string",
      "description": "凭据编号",
      "required": true,
      "x-example": "98df09fb-d459-4cbf-83a7-2b55ca6f3d5d",
      "pattern": "^[a-zA-Z0-9-_]{0,64}$"
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID,在API网关控制台的“实例信息”中获取。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见[获取项目ID](apig-api-180713009.xml)。",
      "required": true,
      "x-sec-authority-parameter": "Y",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "apig.ae-ad-1.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
  "uri": null
}