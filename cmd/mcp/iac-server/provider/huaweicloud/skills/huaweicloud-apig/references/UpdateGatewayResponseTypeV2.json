    "apic_response_type": {
      "in": "path",
      "name": "response_type",
      "x-example": "ACCESS_DENIED",
      "description": "错误类型\n- AUTH_FAILURE: 认证失败,IAM或APP认证校验失败\n- AUTH_HEADER_MISSING: 认证身份来源信息缺失\n- AUTHORIZER_FAILURE: 自定义认证方返回认证失败\n- AUTHORIZER_CONF_FAILURE:自定义认证方异常,通信失败、返回异常响应等错误\n- AUTHORIZER_IDENTITIES_FAILURE: 前端自定义认证的身份来源信息缺失或不合法错误\n- BACKEND_UNAVAILABLE: 后端不可用,网络不可达错误\n- BACKEND_TIMEOUT: 后端超时,与后端的网络交互超过预配置的时间错误\n- THROTTLED: API调用次数超出所配置的流量策略阈值\n- UNAUTHORIZED: 使用的凭据未被授权访问该API\n- ACCESS_DENIED: 拒绝访问,如触发配置的访问控制策略、或异常攻击检测拦截\n- NOT_FOUND: 未匹配到API错误\n- REQUEST_PARAMETERS_FAILURE: 请求参数校验失败、不支持的HTTP方法\n- DEFAULT_4XX: 其它4XX类错误\n- DEFAULT_5XX: 其它5XX类错误\n- THIRD_AUTH_FAILURE: 第三方认证方返回认证失败\n- THIRD_AUTH_IDENTITIES_FAILURE: 第三方认证的身份来源信息缺失或不合法错误\n- THIRD_AUTH_CONF_FAILURE: 第三方认证方异常,通信失败、返回异常响应等错误\n- OIDC_AUTH_TOKEN_VERIFY_FAIL: OIDC认证中token校验失败\n- OIDC_AUTH_GET_DISCOVERY_ERROR: OIDC认证中从配置的discovery处获取信息失败\n- OIDC_AUTH_CODE_FLOW_FAIL: OIDC认证中授权码流程处理失败\n- JWT_AUTH_FAILURE: JWT认证中token校验失败\n- ORCHESTRATION_PARAMETER_NOT_FOUND: 参数编排失败,请求中没有待编排的入参\n- ORCHESTRATION_FAILURE: 参数编排失败,没有编排规则匹配成功",
      "enum": [
        "AUTH_FAILURE",
        "AUTH_HEADER_MISSING",
        "AUTHORIZER_FAILURE",
        "AUTHORIZER_CONF_FAILURE",
        "AUTHORIZER_IDENTITIES_FAILURE",
        "BACKEND_UNAVAILABLE",
        "BACKEND_TIMEOUT",
        "THROTTLED",
        "UNAUTHORIZED",
        "ACCESS_DENIED",
        "NOT_FOUND",
        "REQUEST_PARAMETERS_FAILURE",
        "DEFAULT_4XX",
        "DEFAULT_5XX",
        "THIRD_AUTH_FAILURE",
        "THIRD_AUTH_IDENTITIES_FAILURE",
        "THIRD_AUTH_CONF_FAILURE",
        "OIDC_AUTH_TOKEN_VERIFY_FAIL",
        "OIDC_AUTH_GET_DISCOVERY_ERROR",
        "OIDC_AUTH_CODE_FLOW_FAIL",
        "JWT_AUTH_FAILURE",
        "ORCHESTRATION_PARAMETER_NOT_FOUND",
        "ORCHESTRATION_FAILURE"
      ],
      "type": "string",
      "required": true
    },
