  "definitions": {
    "BasePage": {
      "properties": {
        "size": {
          "description": "本次返回的列表长度",
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "description": "满足条件的记录数",
          "type": "integer",
          "format": "int64"
        }
      },
      "description": "分页基本信息",
      "required": [
        "size",
        "total"
      ]
    },
    "EndpointConnectionPage": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "connections": {
              "type": "array",
              "description": "连接列表",
              "items": {
                "$ref": "#/definitions/EndpointConnection"
              }
            }
          }
        }
      ]
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "EndpointConnection": {
      "required": [
        "id",
        "marker_id",
        "created_at",
        "updated_at",
        "domain_id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "连接编号",
          "example": "181ff59f-c72f-4f64-bc60-ce96c76aca7f"
        },
        "marker_id": {
          "type": "integer",
          "description": "连接报文标识",
          "format": "int32",
          "example": 167882700
        },
        "created_at": {
          "type": "string",
          "description": "连接创建时间。UTC时间,格式:YYYY-MM-DDTHH:MM:SSZ",
          "format": "date-time",
          "example": "2022-05-17T17:20:01Z"
        },
        "updated_at": {
          "type": "string",
          "description": "连接更新时间。UTC时间,格式:YYYY-MM-DDTHH:MM:SSZ",
          "format": "date-time",
          "example": "2022-05-17T17:20:01Z"
        },
        "domain_id": {
          "type": "string",
          "description": "用户的Domain ID",
          "example": "b8aca445e0d04d81a34bb59de5280c72"
        },
        "status": {
          "type": "string",
          "description": "连接状态\n- pendingAcceptance 待接受\n- creating 创建中\n- accepted 已接受\n- rejected 已拒绝\n- failed 失败\n- deleting 删除中",
          "example": "accepted",
          "enum": [
            "pendingAcceptance",
            "creating",
            "accepted",
            "rejected",
            "failed",
            "deleting"
          ]
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_offset": {
      "name": "offset",
      "in": "query",
      "type": "integer",
      "description": "偏移量,表示从此偏移量开始查询,偏移量小于0时,自动转换为0",
      "format": "int64",
      "default": 0,
      "x-example": 1
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
