    "nic_clone": {
      "required": [
        "security_groups",
        "subnet_id"
      ],
      "properties": {
        "subnet_id": {
          "type": "string",
          "description": "子网ID。"
        },
        "ip_address": {
          "type": "string",
          "description": "待创建云服务器网卡的IP地址,IPv4格式。约束:不填或空字符串,默认在子网(subnet)中自动分配一个未使用的IP作网卡的IP地址。若指定IP地址,该IP地址必须在子网(subnet)对应的网段内,且未被使用。"
        },
        "ip_address_v6": {
          "type": "string",
          "description": "待创建云服务器网卡的IP地址,IPv6格式。约束:不填或空字符串,默认在子网(subnet)中自动分配一个未使用的IP作网卡的IP地址。若指定IP地址,该IP地址必须在子网(subnet)对应的网段内,且未被使用。"
        },
        "ipv6_enable": {
          "type": "boolean",
          "description": "是否分配IPv6地址,默认为true,表示当前子网已经使能IPv6时,此网卡分配IPv6地址,指定为false时不分配IPv6地址。"
        },
        "security_groups": {
          "type": "array",
          "description": "安全组列表,最多支持5个。",
          "items": {
            "description": "",
            "$ref": "#/definitions/secGroupClone"
          }
        }
      },
      "description": ""
    },
    "OsClone": {
      "type": "object",
      "properties": {
        "clone_num": {
          "type": "integer",
          "format": "int32",
          "description": "克隆弹性云服务器个数。默认为1。",
          "default": 1
        },
        "clone_type": {
          "type": "string",
          "description": "当前仅支持全量克隆,取值为full。",
          "enum": [
            "full"
          ]
        },
        "retain_passwd": {
          "type": "boolean",
          "description": "是否保持旧密码。已废弃。",
          "default": false
        },
        "key_name": {
          "type": "string",
          "description": "密钥对名称。"
        },
        "metadata": {
          "type": "object",
          "description": "云服务器元数据。",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string",
          "description": "云服务器名称。\n取值范围:\n1.只能由中文字符、英文字母(a~z,A~Z)、数字(0~9)、下划线(_)、中划线(-)组成,且长度为[1-64]个字符。\n2.克隆的云服务器数量(clone_num字段对应的值)大于1时,为区分不同云服务器,克隆过程中系统会自动在名称后加“-0000”的类似标记,故此时名称的长度为[1-59]个字符。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[\\一-\\龥a-zA-Z0-9_\\-]{1,64}"
        },
        "user_data": {
          "type": "string",
          "description": "用户数据注入。注入方式同创建云服务器接口中该字段的使用方式。"
        },
        "power_on": {
          "type": "boolean",
          "description": "克隆的弹性云服务器电源状态。true:开机状态,false:关机状态。默认为false。",
          "default": false
        },
        "postfix": {
          "type": "string",
          "description": "云服务器名称的后缀,默认为空。取值范围[0001-9999],限制:1、该值与参数clone_num值之和不能大于9999;2、该值长度与云服务器名称长度之和不能超过参数name的最大长度限制。"
        },
        "nics": {
          "type": "array",
          "description": "网卡列表,支持指定ip。如果参数不传,表示对原弹性云服务器的所有网卡都克隆。如果传了参数vpc_id,则此参数必传。",
          "items": {
            "$ref": "#/definitions/nic_clone"
          }
        },
        "vpc_id": {
          "type": "string",
          "description": "默认值为原弹性云服务器的vpc_id。可修改。参数nics中的子网要在vpc_id下,不传时用原弹性云服务器的vpc_id。如果传了参数nics,则此参数必传。"
        }
      },
      "description": "克隆弹性云服务器。"
    }
