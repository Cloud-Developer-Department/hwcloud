{
  "name": "ListExtAvailabilityZoneDetail",
  "summary": "查询可用分区详情列表",
  "tags": "可用分区",
  "productshort": "HCSECS",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/os-availability-zone/detail": {
      "get": {
        "tags": [
          "可用分区"
        ],
        "summary": "查询可用分区详情列表",
        "description": "查询可用域详情列表。",
        "operationId": "ListExtAvailabilityZoneDetail",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "发送的实体的MIME类型,媒体类型可按照流类型的不同进行确定。",
            "required": true,
            "type": "string",
            "default": "application/json",
            "enum": [
              "application/json"
            ]
          },
          {
            "name": "Content-Length",
            "in": "header",
            "description": "请求body长度,单位为Byte。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "project id,项目编号。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,请参考《华为云Stack 8.6.1 API参考》的“ManageOne 8.6.1 API参考 >  ManageOne xxx OTenantSecurity服务API参考 > API参考 > Token > 获取用户Token”章节。",
            "required": true,
            "type": "string",
            "pattern": "[\\\\w\\\\-\\\\+=]*"
          },
          {
            "name": "expect_fields",
            "in": "query",
            "description": "需要额外查询的可用分区的属性,当前仅支持security_level和external_info以及aggregate_capabilities。",
            "required": false,
            "type": "string"
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "请求执行成功。",
            "examples": {
              "application/json": {
                "count": 2,
                "availabilityZoneInfo": [
                  {
                    "zoneName": "az1.dc1",
                    "compute_capabilities": [
                      {
                        "hypervisor_type": "QEMU",
                        "cpu_vendor": "Hisilicon",
                        "architecture": "aarch64"
                      }
                    ],
                    "az_security_level": "unset",
                    "security_level": [
                      "unset"
                    ],
                    "external_info": {
                      "display_name": "az1.dc1"
                    },
                    "aggregate_capabilities": []
                  },
                  {
                    "zoneName": "manage_az",
                    "compute_capabilities": [
                      {
                        "hypervisor_type": "QEMU",
                        "cpu_vendor": "Hisilicon",
                        "architecture": "aarch64"
                      }
                    ],
                    "az_security_level": "internal",
                    "security_level": [
                      "internal"
                    ],
                    "external_info": {
                      "display_name": "manage_az"
                    },
                    "aggregate_capabilities": []
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ApicomGetAzDetailListResp"
            }
          },
          "400": {
            "description": "服务器未能处理请求。"
          },
          "401": {
            "description": "被请求的页面需要用户名和密码。"
          },
          "403": {
            "description": "对被请求页面的访问被禁止。"
          },
          "500": {
            "description": "请求未完成。服务异常。"
          },
          "503": {
            "description": "请求未完成。系统暂时异常。"
          }
        },
        "x-order": 2,
        "x-request-examples-url-1": "GET /v1/os-availability-zone/detail"
      }
    }
  },
  "definitions": {
    "ApicomGetAzDetailListResp": {
      "required": [
        "availabilityZoneInfo",
        "count"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "description": "可用分区数目"
        },
        "availabilityZoneInfo": {
          "type": "array",
          "description": "可用分区详情",
          "items": {
            "$ref": "#/definitions/availabilityZoneInfos_D_Rep"
          }
        }
      }
    },
    "availabilityZoneInfos_D_Rep": {
      "type": "object",
      "required": [
        "aggregate_capabilities",
        "compute_capabilities",
        "zoneName"
      ],
      "properties": {
        "zoneName": {
          "type": "string",
          "description": "可用分区名称。"
        },
        "compute_capabilities": {
          "type": "array",
          "description": "可用分区的计算能力信息",
          "items": {
            "$ref": "#/definitions/compute_capabilitiy_Rep"
          }
        },
        "az_security_level": {
          "type": "string",
          "description": "可用分区的密级属性,当请求的expect_fields中有security_level时,才返回该参数。"
        },
        "security_level": {
          "type": "array",
          "description": "可用分区内主机组的密级属性,当请求的expect_fields中有security_level时,才返回该参数。",
          "items": {
            "type": "string"
          }
        },
        "aggregate_capabilities": {
          "type": "array",
          "description": "可用分区内主机组的高级特性,当请求的expect_fields中有aggregate_capabilities才返回该参数。",
          "items": {
            "type": "string"
          }
        },
        "external_info": {
          "description": "可用分区的附加信息,当请求的expect_fields中有external_info时,才返回该参数。",
          "$ref": "#/definitions/ExternalInfo"
        }
      }
    },
    "compute_capabilitiy_Rep": {
      "required": [
        "architecture",
        "cpu_vendor",
        "hypervisor_type"
      ],
      "properties": {
        "hypervisor_type": {
          "type": "string",
          "description": "可用域的hypervisor类型。"
        },
        "cpu_vendor": {
          "type": "string",
          "description": "可用域的cpu厂商。"
        },
        "architecture": {
          "type": "string",
          "description": "可用域的cpu架构。"
        }
      }
    },
    "ExternalInfo": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string",
          "description": "可用分区的显示名称,当请求的expect_fields中有external_info时,才返回该参数。",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "description": "az的额外数据,目前仅包含az的displayname"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
