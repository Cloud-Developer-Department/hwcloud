      "properties": {
        "OS-DCF:diskConfig": {
          "type": "string",
          "example": "MANUAL",
          "description": "扩展属性,磁盘配置方式。对镜像启动虚拟机生效。 \n\nAUTO:API使用单个分区构建目标磁盘大小的云服务器。 API会自动调整文件系统以适应整个分区。 \n\nMANUAL:API使用源映像中的分区方案和文件系统构建服务器。如果目标磁盘较大,则API不分区剩余的磁盘空间。"
        },
        "OS-EXT-SRV-ATTR:hostname": {
          "type": "string",
          "example": "myhostname",
