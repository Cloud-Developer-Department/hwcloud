    "server_update_v1": {
      "properties": {
        "name": {
          "type": "string",
          "description": "修改后的云服务器名称。\n\n只能由中文字符、英文字母、数字及“_”、“-” 组成,且长度为[1-64]个字符。",
          "pattern": "[\\一-\\龥a-zA-Z0-9_\\-]{1,64}"
        },
        "description": {
          "type": "string",
          "description": "对弹性云服务器的任意描述。\n\n不能包含“<”,“>”,且长度范围为[0-63]个字符。",
          "minLength": 0,
          "maxLength": 63,
          "pattern": "[^<>]{0,63}"
        },
        "hostname": {
          "type": "string",
          "description": "修改云服务器 hostname。\n\n命名规范:长度为 [1-63] 个字符,允许使用点号(.)分隔字符成多段,每段允许使用大小写字母、数字或连字符(-),但不能连续使用点号(.)或连字符(-),不能以点号(.)或连字符(-)开头或结尾,不能出现(.-)和(-.)。",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "(((?![--]|[\\.\\.]|[\\.-]|[-\\.]).)|^(?!\\.|-)|(?<!\\.|-)$){1,63}"
        },
        "system_serial_number": {
          "type": "string",
          "description": "修改后的云服务器 serial number,仅管理员可修改。\n\n长度范围为utf-8编码情况下[1-255]个字节",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "description": "{\n\t\"server\": {\n\t\t\"name\": \"liu-001-123\",\n\t\t\"description\": \"this is description\",\n\t\t\"hostname\": \"myhostname\"\n\t\t\"system_serial_number\": \"this is system_serial_number\",\n\t}\n}"
    },
