        },
        "os-migrateLive": {
          "description": "热迁移云服务器,与其他参数互斥。",
          "$ref": "#/definitions/LiveMigrate"
        },
        "migrate": {
          "description": "冷迁移云服务器,与其他参数互斥。",
          "$ref": "#/definitions/Migrate"
        },
        "resize": {
          "description": "变更云服务器规格,与其他参数互斥",
          "$ref": "#/definitions/Resize"
        },
        "revertResize": {
          "type": "object",
          "description": "回退云服务器规格变更或回滚冷迁移云服务器,与其他参数互斥,数据结构为空。",
