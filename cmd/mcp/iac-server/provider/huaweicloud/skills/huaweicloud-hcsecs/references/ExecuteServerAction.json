  "definitions": {
    "RebootType": {
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "重启类型。\nSOFT:普通重启。\nHARD:强制重启。",
          "enum": [
            "SOFT",
            "HARD"
          ]
        }
      },
      "description": "标记为重启云服务器操作。"
    },
    "RebuildServer": {
      "required": [
        "imageRef"
      ],
      "properties": {
        "OS-DCF:diskConfig": {
          "type": "string",
          "description": "不支持。"
        },
        "adminPass": {
          "type": "string",
          "description": "重建的弹性云服务器密码,不生效。"
        },
        "imageRef": {
          "type": "string",
          "description": "重建弹性云服务器时的镜像ID或者镜像URL,或者是回滚云服务器的整机快照ID。"
        },
        "metadata": {
          "type": "object",
          "description": "重建弹性云服务器时的镜像属性。属性名称的长度大于0小于255字节,属性值的长度小于255字节,参数Key、Value用户可自定义。",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254
          }
        },
        "name": {
          "type": "string",
          "description": "重建后弹性云服务器的名称。长度大于0小于255字节。回滚云服务器整机快照不需要该参数",
          "minLength": 1,
          "maxLength": 254
        },
        "preserve_ephemeral": {
          "type": "boolean",
          "description": "是否保留临时磁盘,不支持。"
        },
        "personality": {
          "type": "array",
          "description": "用户数据注入,不支持。",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "description": "虚拟机重建接口参数,在整机快照回滚场景下为null。"
        }
      },
      "description": "重建弹性云服务器或者回滚云服务器整机快照。"
    },
    "Migrate": {
      "properties": {
        "host": {
          "type": "string",
          "description": "冷迁移目的主机。"
        }
      },
      "description": "冷迁移云服务器。"
    },
    "OperateServerReq": {
      "properties": {
        "os-stop": {
          "description": "关闭单台云服务器,与其他参数互斥。",
          "$ref": "#/definitions/StopType"
        },
        "os-start": {
          "type": "object",
          "description": "启动单台云服务器,与其他参数互斥,数据结构为空。",
          "properties": {}
        },
        "reboot": {
          "description": "重启单台云服务器,与其他参数互斥。",
          "$ref": "#/definitions/RebootType"
        },
        "addFloatingIp": {
          "description": "虚拟机绑定浮动IP,与其他参数互斥,该功能准备废弃,建议直接使用对应的网络服务接口,从微版本2.44开始,调用该接口将报404错误。",
          "$ref": "#/definitions/AddFloatingIp"
        },
        "removeFloatingIp": {
          "description": "虚拟机移除浮动IP,与其他参数互斥,该功能准备废弃,建议直接使用对应的网络服务接口,从微版本2.44开始,调用该接口将报404错误。",
          "$ref": "#/definitions/RemoveFloatingIp"
        },
