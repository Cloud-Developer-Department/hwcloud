                  }
                },
                {
                  "example2": {
                    "code": 202,
                    "message": "创建云服务器整机快照、弹性云服务器导出镜像的响应消息",
                    "data": {
                      "job_id": "xxx-xxx-xxx"
                    }
                  }
                },
                {
                  "example3": {
                    "code": 202,
                    "message": "其它接口任务成功,无响应体"
                  }
                }
              ]
            },
            "schema": {
              "$ref": "#/definitions/OperateServerResp_2"
            }
          },
          "204": {
            "description": "任务提交成功。(接口:确认云服务器规格变更、确认冷迁移云服务器)"
          },
          "400": {
            "description": "服务器未能处理请求。"
          },
          "401": {
            "description": "被请求的页面需要用户名和密码。"
          },
          "403": {
            "description": "对被请求页面的访问被禁止。"
          },
          "404": {
            "description": "服务器无法找到被请求的页面。"
          },
          "409": {
            "description": "请求状态与被处理对象状态冲突。"
          },
          "500": {
            "description": "请求未完成。服务异常。"
          },
          "503": {
            "description": "请求未完成。系统暂时异常。"
          }
        },
