  "paths": {
    "/v2.1/{tenant_id}/servers/{server_id}/action": {
      "post": {
        "tags": [
          "操作云服务器"
        ],
        "summary": "操作云服务器_社区兼容",
        "description": "操作云服务器(关闭单台云服务器、启动单台云服务器、重启单台云服务器、虚拟机移除浮动IP、虚拟机绑定浮动IP、获取弹性云服务器控制台日志、解锁弹性云服务器、锁定弹性云服务器、重建弹性云服务器、回滚云服务器整机快照、创建云服务器整机快照、弹性云服务器导出镜像、热迁移云服务器、冷迁移云服务器、变更云服务器规格、回退云服务器规格变更、回滚冷迁移云服务器、确认云服务器规格变更、确认冷迁移云服务器),兼容v2接口。",
        "operationId": "ExecuteServerAction",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "发送的实体的MIME类型,媒体类型可按照流类型的不同进行确定。",
            "required": true,
            "type": "string",
            "default": "application/json",
            "enum": [
              "application/json"
            ]
          },
          {
            "name": "Content-Length",
            "in": "header",
            "description": "请求body长度,单位为Byte。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "project id,项目编号。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,请参考《华为云Stack 8.6.1 API参考》的“ManageOne 8.6.1 API参考 >  ManageOne xxx OTenantSecurity服务API参考 > API参考 > Token > 获取用户Token”章节。",
            "required": true,
            "type": "string",
            "pattern": "[\\\\w\\\\-\\\\+=]*"
          },
          {
            "in": "body",
            "name": "OperateServerReq",
            "description": "操作云服务器的请求体,请按具体业务需要选择对应的一个参数",
