        "summary": "查询指定API版本信息_社区兼容",
        "description": "返回指定版本的信息。为了支持功能不断扩展,Nova API支持版本号区分。Nova中有两种形式的版本号:\n\n1. 主版本号:具有独立的url。\n\n2. 微版本号:通过Http请求头X-OpenStack-Nova-API-Version来使用,从2.27版本后更改为OpenStack-API-Version。",
        "operationId": "NovaShowApiVersion",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "发送的实体的MIME类型,媒体类型可按照流类型的不同进行确定。",
            "required": true,
            "type": "string",
            "default": "application/json",
            "enum": [
              "application/json"
            ]
          },
          {
            "name": "Content-Length",
            "in": "header",
            "description": "请求body长度,单位为Byte。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "project id,项目编号。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,请参考《华为云Stack 8.6.1 API参考》的“ManageOne 8.6.1 API参考 >  ManageOne xxx OTenantSecurity服务API参考 > API参考 > Token > 获取用户Token”章节。",
            "required": true,
            "type": "string",
            "pattern": "[\\\\w\\\\-\\\\+=]*"
          },
          {
            "name": "api_version",
            "in": "path",
            "description": "API版本号。例如: v2",
            "required": true,
            "type": "string",
            "pattern": ".*",
            "x-order": 1
          }
        ],
        "deprecated": false,
