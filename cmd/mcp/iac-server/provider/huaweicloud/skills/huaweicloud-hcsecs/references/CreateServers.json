{
  "name": "CreateServers",
  "summary": "创建云服务器_社区兼容",
  "tags": "生命周期管理",
  "productshort": "HCSECS",
  "region_id": "cn-north-4",
  "paths": {
    "/v2.1/{tenant_id}/servers": {
      "post": {
        "tags": [
          "生命周期管理"
        ],
        "summary": "创建云服务器_社区兼容",
        "description": "创建一台或多台弹性云服务器,兼容v2接口。\n\n1. 直接调用底座nova接口 /v2.0/{project_id}/servers创建虚拟机。\n\n2. 创建FIP由apicom调用vpc的接口(M版本不需要由ECS去下发创fip请求)。\n\n3. 支持批量创建虚拟机。\n\n4. 创建弹性云服务器接口别名:/v2/{tenant_id}/os-volumes_boot,该调用方式仅在OpenStack\nClient中使用,用户不推荐使用。",
        "operationId": "CreateServers",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "发送的实体的MIME类型,媒体类型可按照流类型的不同进行确定。",
            "required": true,
            "type": "string",
            "default": "application/json",
            "enum": [
              "application/json"
            ]
          },
          {
            "name": "Content-Length",
            "in": "header",
            "description": "请求body长度,单位为Byte。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "project id,项目编号。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,请参考《华为云Stack 8.6.1 API参考》的“ManageOne 8.6.1 API参考 >  ManageOne xxx OTenantSecurity服务API参考 > API参考 > Token > 获取用户Token”章节。",
            "required": true,
            "type": "string",
            "pattern": "[\\\\w\\\\-\\\\+=]*"
          },
          {
            "in": "body",
            "name": "ApicomCreateServersV2Req",
            "description": "This is a auto create Body Object",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ApicomCreateServersV2Req"
