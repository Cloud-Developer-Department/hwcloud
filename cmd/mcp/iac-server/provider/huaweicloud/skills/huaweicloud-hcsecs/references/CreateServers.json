  "definitions": {
    "ApicomCreateServersV2Resp": {
      "properties": {
        "server": {
          "description": "云服务器信息。",
          "$ref": "#/definitions/server_create_response"
        },
        "job_id": {
          "type": "string",
          "description": "任务ID。"
        }
      },
      "description": "This is a auto create Response Object"
    },
    "server_create_response": {
      "required": [
        "OS-DCF:diskConfig",
        "adminPass",
        "id",
        "links",
        "security_groups"
      ],
      "properties": {
        "OS-DCF:diskConfig": {
          "type": "string",
          "description": "扩展属性,磁盘配置方式。对镜像启动云服务器生效。 取值范围:AUTO:API使用单个分区构建目标磁盘大小的云服务器。 API会自动调整文件系统以适应整个分区。MANUAL:API使用源映像中的分区方案和文件系统构建服务器。如果目标磁盘较大,则API不分区剩余的磁盘空间。",
          "enum": [
            "AUTO",
            "MANUAL"
          ]
        },
        "id": {
          "type": "string",
          "description": "云服务器唯一标识ID。"
        },
        "links": {
          "type": "array",
          "description": "云服务器相关快捷链接信息。",
          "items": {
            "$ref": "#/definitions/links"
          }
        },
        "security_groups": {
          "type": "array",
          "description": "云服务器所属安全组列表。",
          "items": {
            "$ref": "#/definitions/security_groups_1"
          }
        },
        "adminPass": {
          "type": "string",
          "description": "云服务器系统默认密码,当前使用cloud-init的方式实现密码注入,该参数无效。"
        }
      },
      "description": "虚拟机信息。"
    },
    "personality_1": {
      "required": [
        "contents",
        "path"
      ],
      "properties": {
        "contents": {
          "type": "string",
          "description": "注入文件内容,需要进行base64格式编码。"
        },
        "path": {
          "type": "string",
          "description": "注入文件路径。 Linux系统请输入注入文件保存路径,例如 “/etc/foo.txt”。"
        }
      },
      "description": "文件注入相关信息。\n说明:\nLinux操作系统支持,Windows不支持。"
    },
    "links": {
      "required": [
        "href",
        "rel"
      ],
      "properties": {
        "href": {
          "type": "string",
          "description": "对应快捷链接。"
        },
        "rel": {
          "type": "string",
          "description": "快捷链接标记名称。",
          "enum": [
            "self",
            "bookmark",
            "alternate"
          ]
        }
      },
      "description": "相关快捷链接信息。"
    },
    "security_groups_1": {
      "properties": {
        "name": {
          "type": "string",
          "description": "安全组名称。"
        }
      },
      "description": "云服务器所属安全组列表。\n定弹性云服务器的安全组,默认为default。 指定network创建弹性云服务器时该字段有效。对于已存在端口,安全组请求无效。"
    },
    "networks": {
      "properties": {
        "uuid": {
          "type": "string",
          "description": "网络uuid。 没有指定port时必须指定。"
        },
        "port": {
          "type": "string",
          "description": "port uuid。 没有指定网络uuid时必须指定。"
        },
        "fixed_ip": {
          "type": "string",
          "description": "指定的IP地址。网络的三个参数(port、uuid和fixed_ip)中,port优先级最高;指定fixed_ip时必须指明uuid。"
        }
      },
      "description": "指定弹性云服务器的网卡信息。有多个租户网络时必须指定。若用户指定了多组网络参数,需保证各组参数都属于同一虚拟私有云(VPC)。"
    },
    "ApicomCreateServersV2Req": {
      "required": [
        "server"
      ],
      "properties": {
        "server": {
          "description": "弹性云服务器信息。",
          "$ref": "#/definitions/servers_create_native"
        },
        "os:scheduler_hints": {
          "description": "弹性云服务器调度信息。",
          "$ref": "#/definitions/os_scheduler_hints"
        }
      },
      "description": "This is a auto create Body Object"
    },
    "block_device_mapping_v2": {
      "required": [
        "source_type",
        "uuid"
      ],
      "properties": {
        "boot_index": {
          "type": "string",
          "description": "启动标识,“0”代表启动盘,“-1“代表非启动盘。说明:当卷设备的源头类型全为volume时,boot_index的值有一个为0。"
        },
        "destination_type": {
          "type": "string",
          "description": "卷设备的当前类型,当前只支持volume类型。"
        },
        "source_type": {
          "type": "string",
          "description": "卷设备的源头类型,当前只支持volume、image、snapshot类型。 当使用卷创建云服务器时,source_type设置为volume;当使用镜像创建云服务器时,source_type设置为image;当使用快照创建云服务器时,source_type设置为snapshot。说明:当卷设备的源头类型为snapshot时,且boot_index为0,则该快照对应的云硬盘必须为系统盘。"
        },
        "uuid": {
          "type": "string",
          "description": "卷的uuid,或者snapshot的uuid,source_type是image时为镜像的uuid。"
        },
        "volume_size": {
          "type": "integer",
          "format": "int32",
          "description": "卷大小,整数,在source_type是image,destination_type是volume的时候必选。单位为GB。"
        },
        "device_name": {
          "type": "string",
          "description": "已废弃,不需要配置。"
        },
        "delete_on_termination": {
          "type": "boolean",
          "description": "删除弹性云服务器时,是否删除卷,默认值false。"
        },
        "volume_type": {
          "type": "string",
          "description": "卷类型,在source_type是image,destination_type是volume时使用。"
        },
        "availability_zone": {
          "type": "string",
          "description": "创建磁盘失败,cinder获取az失败时需要传此参数。"
        }
      },
      "description": "指定弹性云服务器存储设备的v2接口。指定卷场景不能批创弹性云服务器。裸金属服务器场景不支持。"
    },
    "os_scheduler_hints": {
      "properties": {
        "group": {
          "type": "string",
          "description": "云服务器组ID,UUID格式。"
        }
      },
      "description": "云服务器调度信息。"
    },
    "servers_create_native": {
      "required": [
        "flavorRef",
        "imageRef",
        "name"
      ],
      "properties": {
        "availability_zone": {
          "type": "string",
          "description": "指定弹性云服务器所在的az和主机等信息。\n对于租户创虚拟机,此参数为必选值。\n取值格式如下:\n1.az \n2.az:host\n3.az:host:node\n4.az::node\n其中,指定host和node时用户需要具有管理员权限。\n创建弹性云服务器需要填入该参数。裸金属服务器场景仅支持指定az,不支持指定主机。"
        },
        "block_device_mapping_v2": {
          "type": "array",
          "description": "指定弹性云服务器存储设备的v2接口。指定卷场景不能批创弹性云服务器。裸金属服务器场景不支持。",
          "items": {
            "$ref": "#/definitions/block_device_mapping_v2"
          }
        },
        "flavorRef": {
          "type": "string",
          "description": "规格ID或URL。"
        },
        "imageRef": {
          "type": "string",
          "description": "镜像ID或者镜像资源的URL。"
        },
        "metadata": {
          "type": "object",
          "description": "弹性云服务器元数据。key的长度大于0小于256字节,value的长度大于等于0小于256字节。",
          "properties": {}
        },
        "name": {
          "type": "string",
          "description": "弹性云服务器名称,长度大于0小于256字节。",
          "minLength": 1,
          "maxLength": 255
        },
        "networks": {
          "type": "array",
          "description": "指定弹性云服务器的网卡信息。有多个租户网络时必须指定。若用户指定了多组网络参数,需保证各组参数都属于同一虚拟私有云(VPC)。",
          "items": {
            "$ref": "#/definitions/networks"
          }
        },
        "personality": {
          "type": "array",
          "description": "文件注入相关信息。",
          "items": {
            "$ref": "#/definitions/personality_1"
          }
        },
        "security_groups": {
          "type": "array",
          "description": "定弹性云服务器的安全组,默认为default。指定network创建弹性云服务器时该字段有效。如果已经存在一个端口,安全组请求无效。",
          "items": {
            "$ref": "#/definitions/security_groups_1"
          }
        },
        "user_data": {
          "type": "string",
          "description": "字符串长度小于65535,且必须是base64加密的。"
        },
        "adminPass": {
          "type": "string",
          "description": "虚拟机密码,当前使用cloud-init的方式实现密码注入,该参数无效。"
        },
        "config_drive": {
          "type": "string",
          "description": "开启后在弹性云服务器创建时挂载config_drive向弹性云服务器内部传递信息。 当前不支持该功能。"
        },
        "key_name": {
          "type": "string",
          "description": "指定keypair的名称。"
        },
        "return_reservation_id": {
          "type": "string",
          "description": "是否支持返回批量创建弹性云服务器的reservation_id。通过返回的reservation_id,可以过滤查询到本次创建的弹性云服务器。\ntrue,返回reservation_id。\nfalse,返回弹性云服务器信息。\n说明:批量创建弹性云服务器时,支持使用该字段。"
        },
        "min_count": {
          "type": "string",
          "description": "表示创建弹性云服务器最小数量。 默认值为1。 说明 指定镜像创建弹性云服务器时,支持使用该字段。",
          "default": "1"
        },
        "max_count": {
          "type": "string",
          "description": "表示创建弹性云服务器最大数量。 默认值与min_count的取值一致。 约束: 参数max_count的取值必须大于参数min_count的取值。 当min_count、max_count同时设置时,创弹性云服务器的数量取决于服务器的资源情况。根据资源情况,在min_count至max_count的取值范围内创建最大数量的弹性云服务器。 说明 指定镜像创建弹性云服务器时,支持使用该字段。"
        },
        "extra": {
          "type": "object",
          "description": "作为一个从 ECS-UI 到 nova 的数据传送通道。",
          "properties": {}
        },
        "OS-DCF:diskConfig": {
          "type": "string",
          "description": "diskConfig的方式,取值为AUTO、MANUAL。\nMANUAL,镜像空间不会扩展。\nAUTO,系统盘镜像空间会自动扩展为与flavor大小一致。当前不支持该功能。",
          "enum": [
            "AUTO",
            "MANUAL"
          ]
        }
      },
      "description": "弹性云服务器信息。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
