        "imageid"
      ],
      "properties": {
        "adminpass": {
          "type": "string",
          "description": "云服务器管理员账户的初始登录密码。\n其中,Windows管理员账户的用户名为Administrator。\n建议密码复杂度如下:长度为8-26位。密码至少必须包含大写字母、小写字母、数字和特殊字符(!@$%^-_=+[{}]:,./?)中的三种。 说明:Windows云服务器的密码不能包含用户名或用户名的逆序,不能包含用户名中超过两个连续字符的部分。adminpass和keyname不能同时有值。adminpass和keyname如果同时为空,则metadata中的user_data属性必须有值。"
        },
        "keyname": {
          "type": "string",
          "description": "密钥名称。"
        },
        "userid": {
          "type": "string",
          "description": "用户ID。说明:如果使用指定用户密钥方式切换操作系统,则该字段为必选字段,支持变更指定用户的密钥。"
        },
        "imageid": {
          "type": "string",
          "description": "切换系统所使用的新镜像的uuid。"
        },
        "metadata": {
          "description": "切换云服务器的元数据,参数类型为字典,参数Key、Value用户可自定义。",
          "$ref": "#/definitions/metadataChangeOsCloudinit"
        },
