            "description": "源规格的id。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
          },
          {
            "name": "source_flavor_name",
            "in": "query",
            "description": "源规格的name。",
            "required": false,
            "type": "string",
            "pattern": ".*"
