{
  "name": "ListExtServersDetails",
  "summary": "查询云服务器详情列表",
  "tags": "生命周期管理",
  "productshort": "HCSECS",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{tenant_id}/cloudservers/detail": {
      "get": {
        "tags": [
          "生命周期管理"
        ],
        "summary": "查询云服务器详情列表",
        "description": "根据用户请求条件从数据库筛选、查询所有的弹性云服务器,并关联相关表获取到弹性云服务器的详细信息。\n\n该接口支持查询弹性云服务器计费方式,以及是否被冻结。",
        "operationId": "ListExtServersDetails",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "发送的实体的MIME类型,媒体类型可按照流类型的不同进行确定。",
            "required": true,
            "type": "string",
            "default": "application/json",
            "enum": [
              "application/json"
            ]
          },
          {
            "name": "Content-Length",
            "in": "header",
            "description": "请求body长度,单位为Byte。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "project id,项目编号。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,请参考《华为云Stack 8.6.1 API参考》的“ManageOne 8.6.1 API参考 >  ManageOne xxx OTenantSecurity服务API参考 > API参考 > Token > 获取用户Token”章节。",
            "required": true,
            "type": "string",
            "pattern": "[\\\\w\\\\-\\\\+=]*",
            "x-order": 1
          },
          {
            "name": "offset",
            "in": "query",
            "description": "页码。\n取值大于等于0,0为特殊情况,取值为0或1时返回第1页。\n不传offset时,只返回count值。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "x-example": 1,
            "x-order": 2
          },
          {
            "name": "flavor",
            "in": "query",
            "description": "云服务器规格ID。",
            "required": false,
            "type": "string",
            "x-example": "c1.medium",
            "x-order": 3
          },
          {
            "name": "name",
            "in": "query",
            "description": "云服务器名称,匹配规则为模糊匹配。",
            "required": false,
            "type": "string",
            "x-example": "test",
            "x-order": 4
          },
          {
            "name": "status",
            "in": "query",
            "description": "云服务器状态。\n\n取值范围:\n\nACTIVE, BUILD,DELETED,ERROR,HARD_REBOOT,MIGRATING,REBOOT,RESIZE,REVERT_RESIZE,SHELVED,SHELVED_OFFLOADED,SHUTOFF,UNKNOWN,VERIFY_RESIZE\n\n只有管理员可以使用“deleted”状态过滤查询已经删除的弹性云服务器。",
            "required": false,
            "type": "string",
            "x-example": "ACTIVE",
            "x-order": 5
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询返回云服务器当前页面的大小。每页最多返回1000台云服务器的信息。",
            "required": false,
            "type": "integer",
            "default": 1000,
            "maximum": 1000,
            "minimum": 1,
            "format": "int32",
            "x-example": 100,
            "x-order": 6
          },
          {
            "name": "reservation_id",
            "in": "query",
            "description": "批量创建弹性云服务器时,指定返回的ID,用于查询本次批量创建的弹性云服务器。",
            "required": false,
            "type": "string",
            "x-example": "r-l0i0clt2",
            "x-order": 7
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "查询绑定某个企业项目的弹性云服务器。\n\n若需要查询当前用户所有企业项目绑定的弹性云服务,请传参all_granted_eps。",
            "required": false,
            "type": "string",
            "x-example": "441d5677-b76a-4dd4-a97a-ef7fd6336666",
            "x-order": 8
          },
          {
            "name": "not-tags",
            "in": "query",
            "description": "查询tag字段中不包含该值的云服务器。",
            "required": false,
            "type": "string",
            "x-example": "test",
            "x-order": 9
          },
          {
            "name": "tags",
            "in": "query",
            "description": "查询tag字段中包含该值的云服务器。",
            "required": false,
            "type": "string",
            "x-order": 10
          },
          {
            "name": "ip",
            "in": "query",
            "description": "IPv4地址过滤结果。",
            "required": false,
            "type": "string",
            "x-order": 11
          },
          {
            "name": "detail",
            "in": "query",
            "description": "一系列expect_fields的组合,取值范围:1,2,3,4,5。不传expect_fields或expect_fields值为空的情况下,默认值为4。",
            "required": false,
            "type": "string",
            "x-order": 12
          },
          {
            "name": "expect_fields",
            "in": "query",
            "description": "期望返回的信息,多个则用英文逗号隔开。\n取值范围:basic,volume,volume_detail,block_device,device_limit,scheduler_hints,addresses,flavor,flavor_detail,metadata,host_status,virtual_cipher_card_device",
            "required": false,
            "type": "string",
            "enum": [
              "basic",
              "volume",
              "volume_detail",
              "block_device",
              "device_limit",
              "scheduler_hints",
              "addresses",
              "flavor",
              "flavor_detail",
              "metadata",
              "host_status"
            ],
            "x-order": 13
          },
          {
            "name": "tenant_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "pattern": "[0-9a-f]{32}",
            "x-order": 14
          },
          {
            "name": "regex-tag",
            "in": "query",
            "description": "通过正则匹配服务器的标签来过滤服务器列表。",
            "required": false,
            "type": "string",
            "x-example": ".*tagxxx.*",
            "x-order": 15
          },
          {
            "name": "system_serial_number",
            "in": "query",
            "description": "通过system_serial_number查找云服务器列表",
            "required": false,
            "type": "string",
            "x-order": 16
          }
        ],
        "deprecated": false,
