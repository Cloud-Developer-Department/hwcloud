  "definitions": {
    "PipelineRunId": {
      "type": "object",
      "description": "流水线运行实例ID,[启动流水线](RunPipeline.xml)接口的返回值即为流水线运行实例ID。",
      "properties": {
        "pipeline_run_id": {
          "type": "string",
          "example": "1ee78c63431f48b49cd727b49d47a4be",
          "description": "**参数解释**:\n流水线运行实例ID,[启动流水线](RunPipeline.xml)接口的返回值即为流水线运行实例ID。\n**取值范围**:\n32位字符,仅由数字和字母组成。"
        }
      }
    },
    "RunPipelineDTO": {
      "type": "object",
      "description": "运行流水线请求体",
      "properties": {
        "sources": {
          "items": {
            "properties": {
              "type": {
                "type": "string",
                "example": "code",
                "description": "**参数解释**:\n流水线源类型,目前支持“code”、“artifact”等代码源类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
              },
              "params": {
                "properties": {
                  "git_type": {
                    "type": "string",
                    "example": "codehub",
                    "description": "**参数解释**:\n代码仓类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n- codehub。\n- gitee。\n- github。\n- gitcode。\n- gitlab。\n**默认取值**:\n不涉及。"
                  },
                  "alias": {
                    "type": "string",
                    "description": "**参数解释**:\n代码仓别名,用户自定义,用于多仓时帮助区分系统参数。例如:A_REPO_COMMIT_ID,B_REPO_COMMIT_ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
                  },
                  "codehub_id": {
                    "type": "string",
                    "example": 2111679719,
                    "description": "**参数解释**:\nCodeArts Repo代码仓ID。可以通过代码仓查询接口获取,代码仓的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
                  },
                  "default_branch": {
                    "type": "string",
                    "example": "master",
                    "description": "**参数解释**:\n流水线执行时代码仓默认分支。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
                  },
                  "git_url": {
                    "type": "string",
                    "example": "https://example.com/CloudPipelinezycs00001/2000.git",
                    "description": "**参数解释**:\nGit仓库https地址,例如https://example.com/CloudPipelinezycs00001/2000.git。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
                  },
                  "endpoint_id": {
                    "type": "string",
                    "example": null,
                    "description": "**参数解释**:\n代码源扩展点ID。可以通过[查询扩展点列表接口](ListEndpointsDetails.xml)获取,其中endpoints.uuid即为扩展点的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
                  },
                  "build_params": {
                    "properties": {
                      "build_type": {
                        "type": "string",
                        "example": "branch",
                        "description": "**参数解释**:\n代码仓触发类型,包含branch-分支触发,tag-标签触发等。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
                      },
                      "event_type": {
                        "type": "string",
                        "example": "Manual",
                        "description": "**参数解释**:\n流水线的触发方式。\n- Manual:手动触发。\n- Scheduler:定时任务。\n- MR:MR触发。\n- Push:Push事件触发。\n- CreateTag:Tag事件触发。\n- Issue:Issue触发。\n- Note:评论触发。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
                      },
                      "target_branch": {
                        "type": "string",
                        "example": "master",
                        "description": "**参数解释**:\n流水线触发运行分支。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
                      },
                      "tag": {
                        "type": "string",
                        "example": null,
                        "description": "**参数解释**:\n流水线触发运行的标签。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
                      }
                    },
                    "description": "**参数解释**:\n流水线具体构建参数。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
                    "required": [
                      "build_type"
                    ]
                  },
                  "change_request_ids": {
                    "type": "array",
                    "description": "**参数解释**:\n执行变更流水线变更ID列表。可以通过[查询变更列表](ListChangeRequests.xml)接口,其中data.id即为变更ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "description": "**参数解释**:\n流水线源相关参数。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
                "required": [
                  "git_type",
                  "git_url"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "type": "array",
          "description": "**参数解释**:\n代码源信息列表。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
        },
        "description": {
          "type": "string",
          "example": "版本发布",
          "description": "**参数解释**:\n流水线运行描述。\n**约束限制**:\n不涉及。\n**取值范围**:\n不超过1024字符。\n**默认取值**:\n不涉及。"
        },
        "variables": {
          "items": {
            "properties": {
              "name": {
                "type": "string",
                "example": "dfssda",
                "description": "**参数解释**:\n参数名。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
              },
              "value": {
                "type": "string",
                "example": "fsaafsd",
                "description": "**参数解释**:\n参数值。\n**约束限制**:\n不涉及。\n**取值范围**:\n不超过8192字符。\n**默认取值**:\n不涉及。"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "type": "array",
          "description": "**参数解释**:\n使用的自定义参数。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
        },
        "choose_jobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "1671505863593ad534b54-204e-4eff-8781-c6dfe3edd195"
          ],
          "description": "**参数解释**:\n流水线运行时选择的流水线任务。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
        },
        "choose_stages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "**参数解释**:\n选择的流水线阶段。优先级高于choose_jobs,即stage未选择时,无视choose_jobs中该stage下的job。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "Path-Project-Id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目ID",
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "Path-Pipeline-Id": {
      "name": "pipeline_id",
      "in": "path",
      "description": "流水线ID",
      "required": true,
      "type": "string",
      "maxLength": 32,
      "minLength": 32,
      "x-example": "8025ba36a87a4dd5af496708c2961817"
    }
  },
