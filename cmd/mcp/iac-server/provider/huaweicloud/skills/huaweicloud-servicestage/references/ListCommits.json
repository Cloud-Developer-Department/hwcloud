{
  "name": "ListCommits",
  "summary": "获取项目commit提交记录",
  "tags": "GIT仓库",
  "productshort": "ServiceStage",
  "region_id": "af-south-1",
  "paths": {
    "/v1/{project_id}/git/repos/{namespace}/{project}/commits": {
      "get": {
        "tags": [
          "GIT仓库"
        ],
        "summary": "获取项目commit提交记录",
        "description": "获取指定项目的最近10次commit提交记录。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ListCommits",
        "parameters": [
          {
            "$ref": "#/components/parameters/auth-token"
          },
          {
            "name": "X-Repo-Auth",
            "description": "授权名称。",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-example": "github-oauth"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "租户的project ID。",
            "schema": {
              "type": "string"
            },
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "description": "命名空间ID或者URL编码名称。",
            "schema": {
              "type": "string"
            },
            "x-example": ""
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "description": "仓库项目ID,如果含有“/”,需要将“/”替换为“:”。",
            "schema": {
              "type": "string"
            },
            "x-example": ""
          },
          {
            "name": "ref",
            "in": "query",
            "description": "分支名称或者tag名称,如果没有提供,使用默认分支。",
            "schema": {
              "type": "string"
            },
            "x-example": ""
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Commits"
                },
                "example": {
                  "commits": [
                    {
                      "sha": "ab37587f9e1ab7cf1021f4f0c017230dd615669b",
                      "message": "Updating README",
                      "authored_date": "2016-09-18T14:18:47Z"
                    },
                    {
                      "sha": "61377a1af934fa694653cfe110a7a143a4a9adc4",
                      "message": "Fix travis script",
                      "authored_date": "2016-09-18T13:29:18Z"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "错误的请求。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "err0401": {
                    "$ref": "#/components/examples/err0401"
                  },
                  "err0450": {
                    "$ref": "#/components/examples/err0450"
                  },
                  "err0451": {
                    "$ref": "#/components/examples/err0451"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "servicestage.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}