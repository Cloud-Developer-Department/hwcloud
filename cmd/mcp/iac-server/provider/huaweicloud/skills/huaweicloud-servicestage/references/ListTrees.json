{
  "name": "ListTrees",
  "summary": "获取仓库文件列表",
  "tags": "GIT仓库文件",
  "productshort": "ServiceStage",
  "region_id": "af-south-1",
  "paths": {
    "/v1/{project_id}/git/files/{namespace}/{project}/trees": {
      "get": {
        "tags": [
          "GIT仓库文件"
        ],
        "summary": "获取仓库文件列表",
        "description": "获取指定项目仓库的文件列表。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ListTrees",
        "parameters": [
          {
            "$ref": "#/components/parameters/auth-token"
          },
          {
            "name": "X-Repo-Auth",
            "description": "授权名称。",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-example": "github-oauth"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "租户的project ID。",
            "schema": {
              "type": "string"
            },
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "description": "命名空间ID或者URL编码名称。",
            "schema": {
              "type": "string"
            },
            "x-example": ""
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "description": "仓库项目ID,如果含有“/”,需要将“/”替换为“:”。",
            "schema": {
              "type": "string"
            },
            "x-example": ""
          },
          {
            "name": "ref",
            "description": "分支名称或者tag标签名称或者commit sha。",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-example": "cd51f3dfaxxxx17cb9c320d2b30e1542xxxxxxx"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trees"
                },
                "example": {
                  "paths": [
                    "src/test/pet.yaml",
                    "src/test/test.yaml"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "错误的请求。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "err0401": {
                    "$ref": "#/components/examples/err0401"
                  },
                  "err0450": {
                    "$ref": "#/components/examples/err0450"
                  },
                  "err0451": {
                    "$ref": "#/components/examples/err0451"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "servicestage.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}