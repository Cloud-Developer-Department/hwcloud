{
  "name": "ListProjects",
  "summary": "获取组织下所有项目",
  "tags": "GIT仓库",
  "productshort": "ServiceStage",
  "region_id": "af-south-1",
  "paths": {
    "/v1/{project_id}/git/repos/{namespace}/projects": {
      "get": {
        "tags": [
          "GIT仓库"
        ],
        "summary": "获取组织下所有项目",
        "description": "获取指定组织下的所有项目。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ListProjects",
        "parameters": [
          {
            "$ref": "#/components/parameters/auth-token"
          },
          {
            "name": "X-Repo-Auth",
            "in": "header",
            "required": true,
            "description": "授权名称。",
            "schema": {
              "type": "string"
            },
            "x-example": "github-oauth"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "租户的project ID。",
            "schema": {
              "type": "string"
            },
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "description": "命名空间ID或者URL编码名称。",
            "schema": {
              "type": "string"
            },
            "x-example": ""
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Projects"
                },
                "example": {
                  "projects": [
                    {
                      "id": "microservices",
                      "name": "microservices",
                      "clone_url": "https://demo@github.com/demo/microservices.git"
                    },
                    {
                      "id": "spring-music",
                      "name": "spring-music",
                      "clone_url": "https://demo@github.com/demo/spring-music.git"
                    },
                    {
                      "id": "springboot-webapp",
                      "name": "springboot-webapp",
                      "clone_url": "https://demo@github.com/demo/springboot-webapp.git"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "错误的请求。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "err0401": {
                    "$ref": "#/components/examples/err0401"
                  },
                  "err0450": {
                    "$ref": "#/components/examples/err0450"
                  },
                  "err0451": {
                    "$ref": "#/components/examples/err0451"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "servicestage.af-south-1.myhuaweicloud.com",
