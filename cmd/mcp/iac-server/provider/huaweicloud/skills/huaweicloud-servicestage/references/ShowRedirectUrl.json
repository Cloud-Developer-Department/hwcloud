{
  "name": "ShowRedirectUrl",
  "summary": "获取授权重定向URL",
  "tags": "GIT授权",
  "productshort": "ServiceStage",
  "region_id": "af-south-1",
  "paths": {
    "/v1/{project_id}/git/auths/{repo_type}/redirect": {
      "get": {
        "tags": [
          "GIT授权"
        ],
        "summary": "获取授权重定向URL",
        "description": "获取指定Git仓库类型的授权重定向URL。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ShowRedirectUrl",
        "parameters": [
          {
            "$ref": "#/components/parameters/auth-token"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "租户的project ID。",
            "schema": {
              "type": "string"
            },
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "repo_type",
            "in": "path",
            "required": true,
            "description": "仓库类型。\n取值范围:github、gitlab、gitee、bitbucket。",
            "schema": {
              "type": "string",
              "enum": [
                "github",
                "gitlab",
                "gitee",
                "bitbucket"
              ]
            },
            "x-example": "github"
          },
          {
            "name": "tag",
            "description": "站点标签。\n比如国际站的,?tag=intl。\n默认为空。",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "x-example": "intl"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizeUrl"
                }
              }
            }
          },
          "400": {
            "description": "错误的请求。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "err0401": {
                    "$ref": "#/components/examples/err0401"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "servicestage.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}