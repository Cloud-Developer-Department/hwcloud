          "GIT仓库"
        ],
        "summary": "通过clone url 获取仓库信息",
        "description": "通过指定的clone url 获取仓库信息。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ShowProjectDetail",
        "parameters": [
          {
            "$ref": "#/components/parameters/auth-token"
          },
          {
            "name": "X-Repo-Auth",
            "description": "授权名称。",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-example": "github-oauth"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "租户的project ID。",
            "schema": {
              "type": "string"
            },
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "clone_url",
            "description": "仓库克隆URL。",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-example": "https://hwstaff_xxx%252Ftestuser@codehub.devcloud.huaweicloud.com/test_cloud000100001/cas-javamvc1.git"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepoProject"
                },
                "example": {
                  "namespace_id": "c917125909af464692c98464d8bd155e",
                  "namespace": "test_cloud0001",
                  "project_id": "503918",
                  "project": "cas-javamvc1"
                }
              }
            }
          },
          "400": {
            "description": "错误的请求。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "err0401": {
                    "$ref": "#/components/examples/err0401"
                  },
                  "err0450": {
                    "$ref": "#/components/examples/err0450"
                  },
                  "err0451": {
                    "$ref": "#/components/examples/err0451"
                  },
                  "err0452": {
                    "$ref": "#/components/examples/err0452"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
