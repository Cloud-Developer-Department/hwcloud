{
  "name": "CreateOAuth",
  "summary": "创建OAuth授权",
  "tags": "GIT授权",
  "productshort": "ServiceStage",
  "region_id": "af-south-1",
  "paths": {
    "/v1/{project_id}/git/auths/{repo_type}/oauth": {
      "post": {
        "tags": [
          "GIT授权"
        ],
        "summary": "创建OAuth授权",
        "description": "创建指定Git仓库类型的OAuth授权。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "CreateOAuth",
        "parameters": [
          {
            "$ref": "#/components/parameters/auth-token"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "租户的project ID。",
            "schema": {
              "type": "string"
            },
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "repo_type",
            "in": "path",
            "required": true,
            "description": "仓库类型。\n支持OAuth授权的仓库类型有:github、gitlab、gitee、bitbucket。",
            "schema": {
              "type": "string",
              "enum": [
                "github",
                "gitlab",
                "gitee",
                "bitbucket"
              ]
            },
            "x-example": "github"
          },
          {
            "name": "tag",
            "description": "站点标签。\n比如国际站的,?tag=intl。\n默认为空。",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "x-example": "intl"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OAuth"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Authorization"
                }
              }
            }
          },
          "400": {
            "description": "错误的请求。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "err0400": {
                    "$ref": "#/components/examples/err0400"
                  },
                  "err0401": {
                    "$ref": "#/components/examples/err0401"
                  },
                  "err0402": {
                    "$ref": "#/components/examples/err0402"
                  },
                  "err0403": {
                    "$ref": "#/components/examples/err0403"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "servicestage.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "post",
  "uri": null
}