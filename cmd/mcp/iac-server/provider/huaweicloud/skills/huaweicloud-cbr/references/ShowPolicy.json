  "definitions": {
    "Policy": {
      "required": [
        "enabled",
        "id",
        "name",
        "operation_definition",
        "operation_type",
        "trigger"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "example": true,
          "description": "策略是否启用"
        },
        "id": {
          "type": "string",
          "description": "策略ID"
        },
        "name": {
          "type": "string",
          "example": "my_first_policy",
          "description": "策略名称"
        },
        "operation_definition": {
          "description": "策略属性",
          "$ref": "#/definitions/PolicyoODCreate"
        },
        "operation_type": {
          "type": "string",
          "description": "策略类型,例如 ‘backup’:自动备份",
          "enum": [
            "backup",
            "replication"
          ],
          "x-huawei-extraAnnotation": ""
        },
        "trigger": {
          "description": "策略时间调度规则",
          "$ref": "#/definitions/PolicyTriggerResp"
        },
        "associated_vaults": {
          "type": "array",
          "description": "关联的存储库",
          "items": {
            "$ref": "#/definitions/PolicyAssociateVault"
          }
        },
        "policy_type": {
          "type": "string",
          "example": "custom_policy",
          "description": "策略类型,取值范围如下:\n- custom_policy:普通用户策略\n- organization_policy_v1:老版本组织策略\n- organization_policy_v2:新版本组织策略\n- organization_policy_removed:退出组织的用户已绑定在存储库上的新版本组织策略(不自动解绑策略与存储库绑定关系,但是不能新绑定存储库)"
        }
      }
    },
    "PolicyTriggerResp": {
      "required": [
        "id",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "调度器id"
        },
        "name": {
          "type": "string",
          "description": "调度器名称"
        },
        "properties": {
          "description": "调度器属性",
          "$ref": "#/definitions/PolicyTriggerPropertiesResp"
        },
        "type": {
          "type": "string",
          "description": "调度器类型,目前只支持 time: 定时调度。",
          "enum": [
            "time"
          ],
          "x-huawei-extraAnnotation": ""
        }
      }
    },
    "PolicyTriggerPropertiesResp": {
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "type": "array",
          "description": "调度规则。限制24条规则。调度器的调度规则,可参照iCalendar RFC 2445规范中的事件规则,但仅支持FREQ、BYDAY、BYHOUR、BYMINUTE、INTERVAL等参数,其中FREQ仅支持WEEKLY和DAILY,BYDAY支持一周七天(MO、TU、WE、TH、FR、SA、SU),BYHOUR支持0-23小时,BYMINUTE支持0-59分钟,并且间隔不能小于一小时,一天最大24个时间点。例如,周一到周天,每天UTC时间的14:00调度,其规则为:'FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR,SA,SU;BYHOUR=14;BYMINUTE=00'。例如:某个地区的时间为 UTC+8,若在该地区每天14:00调度,则在14点基础上减8,其规则为'FREQ=DAILY;INTERVAL=1;BYHOUR=6;BYMINUTE=00'。",
          "items": {
            "type": "string",
            "description": ""
          },
          "x-admin": "False"
        },
        "start_time": {
          "type": "string",
          "description": "调度器开始时间,例如:\"2020-01-08 09:59:49\"",
          "x-huawei-extraAnnotation": ""
        }
      }
    },
    "PolicyCreateResp": {
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "description": "创建响应",
          "$ref": "#/definitions/Policy"
        }
      }
    },
    "PolicyoODCreate": {
      "properties": {
        "day_backups": {
          "type": "integer",
          "format": "int32",
          "description": "保留日备个数,该备份不受保留最大备份数限制。取值为0到100。若选择该参数,则timezone 也必选。",
          "minimum": 0,
          "maximum": 100,
          "x-huawei-extraAnnotation": ""
        },
        "destination_project_id": {
          "type": "string",
          "description": "复制的目标项目ID,仅在跨区域复制时才会使用并且必须指定。",
          "x-open-region-cloud": "hc,hk"
        },
        "destination_region": {
          "type": "string",
          "description": "复制的目标区域,仅在跨区域复制时才会使用并且必须指定。长度限制:0- 255,只能由字母、数字、“_”、“-”组成",
          "pattern": "^[a-zA-Z0-9._\\-]*$",
          "x-open-region-cloud": "hc,hk"
        },
        "enable_acceleration": {
          "type": "boolean",
          "description": "跨区域复制时,是否启用加速从而缩减复制的时间,如果不指定,默认不启用加速。",
          "x-open-region-cloud": "hc,hk"
        },
        "max_backups": {
          "type": "integer",
          "format": "int32",
          "description": "单个备份对象自动备份的最大备份数。取值为-1或0-99999。-1代表不按备份数清理。若该字段和retention_duration_days字段同时为空,备份会永久保留。",
          "minimum": 1,
          "maximum": 99999,
          "default": -1,
          "x-huawei-extraAnnotation": ""
        },
        "month_backups": {
          "type": "integer",
          "format": "int32",
          "description": "保留月备个数,该备份不受保留最大备份数限制。取值为0到100。若选择该参数,则timezone 也必选。",
          "minimum": 0,
          "maximum": 100,
          "x-huawei-extraAnnotation": ""
        },
        "retention_duration_days": {
          "type": "integer",
          "format": "int32",
          "description": "备份保留时长,单位天。最长支持99999天。-1代表不按时间清理。若该字段和max_backups 参数同时为空,备份会永久保留。",
          "minimum": 1,
          "maximum": 99999,
          "default": -1
        },
        "timezone": {
          "type": "string",
          "description": "用户所在时区,格式形如UTC+08:00, 若选择年备,月备,周备,日备中任一参数,则该参数不能为空。",
          "pattern": "'UTC([+-]{1,1}[0-9]{2,2}[:]{1,1}[0-9]{2,2})'",
          "x-huawei-extraAnnotation": ""
        },
        "week_backups": {
          "type": "integer",
          "format": "int32",
          "description": "保留周备个数,该备份不受保留最大备份数限制。取值为0到100。若选择该参数,则timezone 也必选。",
          "x-huawei-extraAnnotation": ""
        },
        "year_backups": {
          "type": "integer",
          "format": "int32",
          "description": "保留年备个数,该备份不受保留最大备份数限制。取值为0到100。若选择该参数,则timezone 也必选。",
          "minimum": 0,
          "maximum": 100,
          "x-huawei-extraAnnotation": ""
        },
        "full_backup_interval": {
          "type": "integer",
          "format": "int32",
          "description": "每间隔多少次执行一次全量备份,当取值为 -1 时,不执行全量备份。 \n最小值:-1 \n最大值:100",
          "minimum": -1,
          "maximum": 100
        }
      }
    },
    "PolicyAssociateVault": {
      "required": [
        "vault_id"
      ],
      "properties": {
        "destination_vault_id": {
          "type": "string",
          "description": "关联的远端存储库ID"
        },
        "vault_id": {
          "type": "string",
          "description": "存储库ID"
        }
      },
      "description": ""
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cbr.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
