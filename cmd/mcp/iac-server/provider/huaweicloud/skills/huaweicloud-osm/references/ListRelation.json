{
  "name": "ListRelation",
  "summary": "查询关联工单",
  "tags": "关联工单管理",
  "productshort": "OSM",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/servicerequest/cases/{case_id}/relations": {
      "get": {
        "tags": [
          "关联工单管理"
        ],
        "summary": "查询关联工单",
        "operationId": "ListRelation",
        "description": "查询工单的关联,返回关联工单的简要信息",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "case_id",
            "minLength": 1,
            "maxLength": 64,
            "in": "path",
            "description": "要关联的工单id",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "minLength": 1,
            "maxLength": 5000,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-order": 1
          },
          {
            "name": "X-Site",
            "in": "header",
            "description": "对接站点信息。\n\n0(中国站) 1(国际站),不填的话默认为0。",
            "required": false,
            "maximum": 1,
            "minimum": 0,
            "type": "integer",
            "x-example": 0,
            "x-order": 2
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言环境,值为通用的语言描述字符串,比如zh-cn等,默认为zh-cn。\n\n会根据语言环境对应展示一些国际化的信息,比如工单类型名称等。",
            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "zh-cn",
            "x-order": 3
          },
          {
            "name": "X-Time-Zone",
            "in": "header",
            "description": "环境时区,值为通用的时区描述字符串,比如GMT+8等,默认为GMT+8。\n\n涉及时间的数据会根据环境时区处理。",
            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "GMT+8",
            "x-order": 4
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回",
            "schema": {
              "$ref": "#/definitions/QueryCaseRelationResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CaseRealtionInfo": {
      "type": "object",
      "properties": {
        "case_id": {
          "minLength": 1,
          "maxLength": 64,
          "type": "string",
          "description": "工单id"
        },
        "simple_description": {
          "minLength": 1,
          "maxLength": 2000,
          "type": "string",
          "description": "简要描述"
        },
        "user_name": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string",
          "description": "提交人,即用户名称"
        }
      }
    },
    "QueryCaseRelationResponse": {
      "type": "object",
      "properties": {
        "case_relation_list": {
          "minItems": 0,
          "maxItems": 3,
          "description": "关联工单列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CaseRealtionInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "osm.cn-south-1.myhuaweicloud.cn",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}