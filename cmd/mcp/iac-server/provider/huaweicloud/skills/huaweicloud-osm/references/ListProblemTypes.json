{
  "name": "ListProblemTypes",
  "summary": "查询问题类型列表",
  "tags": "提单基础配置查询",
  "productshort": "OSM",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/servicerequest/config/problems": {
      "get": {
        "tags": [
          "提单基础配置查询"
        ],
        "summary": "查询问题类型列表",
        "description": "提交工单时,选择产品类型之后选择对应的问题列表",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "operationId": "ListProblemTypes",
        "parameters": [
          {
            "name": "product_category_id",
            "minLength": 1,
            "maxLength": 64,
            "description": "产品类型id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "minLength": 1,
            "maxLength": 5000,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-order": 1
          },
          {
            "name": "X-Site",
            "in": "header",
            "description": "对接站点信息。\n\n0(中国站) 1(国际站),不填的话默认为0。",
            "required": false,
            "maximum": 1,
            "minimum": 0,
            "type": "integer",
            "x-example": 0,
            "x-order": 2
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言环境,值为通用的语言描述字符串,比如zh-cn等,默认为zh-cn。\n\n会根据语言环境对应展示一些国际化的信息,比如工单类型名称等。",
            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "zh-cn",
            "x-order": 3
          },
          {
            "name": "X-Time-Zone",
            "in": "header",
            "description": "环境时区,值为通用的时区描述字符串,比如GMT+8等,默认为GMT+8。\n\n涉及时间的数据会根据环境时区处理。",
            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "GMT+8",
            "x-order": 4
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回200",
            "examples": {
              "application/json": {
                "total_count": 1,
                "incident_business_type_list": [
                  {
                    "business_type_id": "123",
                    "business_type_name": "活动咨询",
                    "can_use_support_plan": 0
                  },
                  {
                    "business_type_id": "124",
                    "business_type_name": "磁盘故障",
                    "can_use_support_plan": 1
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/IncidentBusinessTypeV2Rsp"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v2/servicerequest/config/problems",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "IncidentBusinessTypeV2Rsp": {
      "type": "object",
      "properties": {
        "total_count": {
          "description": "总数",
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer",
          "format": "int32"
        },
        "incident_business_type_list": {
          "minItems": 0,
          "maxItems": 65535,
          "description": "问题类型列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SimpleIncidentBusinessTypeV2"
          }
        }
      }
    },
    "SimpleIncidentBusinessTypeV2": {
      "type": "object",
      "properties": {
        "business_type_id": {
          "minLength": 1,
          "maxLength": 32,
          "description": "问题类型id",
          "type": "string"
        },
        "business_type_name": {
          "minLength": 1,
          "maxLength": 64,
          "description": "问题类型名称",
          "type": "string"
        },
        "case_type": {
          "minLength": 1,
          "maxLength": 1,
          "description": "对应的工单类型0咨询 5报障",
          "type": "string"
        },
        "can_use_support_plan": {
          "description": "是否可以使用支持计划",
          "type": "boolean"
        }
      }
    }
  },
  "version": "2.0",
