{
  "name": "ConfirmAuthorizations",
  "summary": "确认授权",
  "tags": "授权管理",
  "productshort": "OSM",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/servicerequest/authorizations/{authorization_id}": {
      "put": {
        "tags": [
          "授权管理"
        ],
        "summary": "确认授权",
        "description": "确认授权",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "operationId": "ConfirmAuthorizations",
        "parameters": [
          {
            "name": "authorization_id",
            "minLength": 1,
            "maxLength": 32,
            "description": "授权id",
            "type": "string",
            "in": "path",
            "required": true
          },
          {
            "in": "body",
            "description": "授权具体请求",
            "name": "ConfirmAuthorizationsRequestBody",
            "required": false,
            "schema": {
              "$ref": "#/definitions/AgreeTenantAuthorizationV2Req"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "minLength": 1,
            "maxLength": 5000,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-order": 1
          },
          {
            "name": "X-Site",
            "in": "header",
            "description": "对接站点信息。\n\n0(中国站) 1(国际站),不填的话默认为0。",
            "required": false,
            "maximum": 1,
            "minimum": 0,
            "type": "integer",
            "x-example": 0,
            "x-order": 2
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言环境,值为通用的语言描述字符串,比如zh-cn等,默认为zh-cn。\n\n会根据语言环境对应展示一些国际化的信息,比如工单类型名称等。",
            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "zh-cn",
            "x-order": 3
          },
          {
            "name": "X-Time-Zone",
            "in": "header",
            "description": "环境时区,值为通用的时区描述字符串,比如GMT+8等,默认为GMT+8。\n\n涉及时间的数据会根据环境时区处理。",
            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "GMT+8",
            "x-order": 4
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回200",
            "examples": {
              "application/json": {
                "auth_detail_list": [
                  {
                    "account": "root",
                    "auth_detail_id": 123,
                    "password": "123456",
                    "port": 22
                  },
                  {
                    "account": "root",
                    "auth_detail_id": 123,
                    "password": 123456,
                    "port": 1234
                  }
                ],
                "auth_effective_time": 1592795931000,
                "auth_expire_time": 1592795931000,
                "group_id": "123456",
                "agency_id": "123456"
              }
            },
            "schema": {
              "$ref": "#/definitions/ApiGatewayV2BaseResponse"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "PUT https://{endpoint}/v2/servicerequest/authorizations/Auth-123456?group_id=123",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "ApiGatewayV2BaseResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        }
      }
    },
    "TenantAgreeAuthDetailV2": {
      "type": "object",
      "required": [
        "auth_detail_id"
      ],
      "properties": {
        "port": {
          "description": "端口",
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 65535
        },
        "account": {
          "description": "账号",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "password": {
          "description": "密码",
          "type": "string",
          "minLength": 0,
          "maxLength": 10240
        },
        "auth_detail_id": {
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807,
          "description": "授权详情id",
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "AgreeTenantAuthorizationV2Req": {
      "type": "object",
      "properties": {
        "auth_detail_list": {
          "description": "授权详情列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/TenantAgreeAuthDetailV2"
          },
          "maxItems": 6,
          "minItems": 0
        },
        "auth_effective_time": {
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "授权生效时间",
          "type": "integer",
          "format": "int64"
        },
        "auth_expire_time": {
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "授权到期时间",
          "type": "integer",
          "format": "int64"
        },
        "group_id": {
          "description": "华为云IAM组id,操作查询同组其他工单时,该id必传",
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9]+$"
        },
        "agency_id": {
          "description": "委托id",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        }
      }
    }
  },
