            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "zh-cn",
            "x-order": 3
          },
          {
            "name": "X-Time-Zone",
            "in": "header",
            "description": "环境时区,值为通用的时区描述字符串,比如GMT+8等,默认为GMT+8。\n\n涉及时间的数据会根据环境时区处理。",
            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "GMT+8",
            "x-order": 4
