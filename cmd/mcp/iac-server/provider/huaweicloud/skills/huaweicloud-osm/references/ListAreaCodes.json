{
  "name": "ListAreaCodes",
  "summary": "查询国家码",
  "tags": "提单基础配置查询",
  "productshort": "OSM",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/servicerequest/config/area-codes": {
      "get": {
        "tags": [
          "提单基础配置查询"
        ],
        "summary": "查询国家码",
        "description": "查询国家码,用于提交工单页面填写联系方式使用",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "operationId": "ListAreaCodes",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "minLength": 1,
            "maxLength": 5000,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-order": 1
          },
          {
            "name": "X-Site",
            "in": "header",
            "description": "对接站点信息。\n\n0(中国站) 1(国际站),不填的话默认为0。",
            "required": false,
            "maximum": 1,
            "minimum": 0,
            "type": "integer",
            "x-example": 0,
            "x-order": 2
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言环境,值为通用的语言描述字符串,比如zh-cn等,默认为zh-cn。\n\n会根据语言环境对应展示一些国际化的信息,比如工单类型名称等。",
            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "zh-cn",
            "x-order": 3
          },
          {
            "name": "X-Time-Zone",
            "in": "header",
            "description": "环境时区,值为通用的时区描述字符串,比如GMT+8等,默认为GMT+8。\n\n涉及时间的数据会根据环境时区处理。",
            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "GMT+8",
            "x-order": 4
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回200",
            "examples": {
              "application/json": {
                "area_code_list": [
                  {
                    "id": 1,
                    "area_code": "86",
                    "area_name": "中国"
                  },
                  {
                    "id": 2,
                    "area_code": "354",
                    "area_name": "冰岛"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryAreaCodeV2Rsp"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v2/servicerequest/config/area-codes",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
