{
  "name": "ShowAccessoryLimits",
  "summary": "附件限制",
  "tags": "附件功能",
  "productshort": "OSM",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/servicerequest/accessorys/limits": {
      "get": {
        "tags": [
          "附件功能"
        ],
        "summary": "附件限制",
        "description": "查询附件的一下限制,比如大小,数量,文件类型",
        "operationId": "ShowAccessoryLimits",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "minLength": 1,
            "maxLength": 5000,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-order": 1
          },
          {
            "name": "X-Site",
            "in": "header",
            "description": "对接站点信息。\n\n0(中国站) 1(国际站),不填的话默认为0。",
            "required": false,
            "maximum": 1,
            "minimum": 0,
            "type": "integer",
            "x-example": 0,
            "x-order": 2
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言环境,值为通用的语言描述字符串,比如zh-cn等,默认为zh-cn。\n\n会根据语言环境对应展示一些国际化的信息,比如工单类型名称等。",
            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "zh-cn",
            "x-order": 3
          },
          {
            "name": "X-Time-Zone",
            "in": "header",
            "description": "环境时区,值为通用的时区描述字符串,比如GMT+8等,默认为GMT+8。\n\n涉及时间的数据会根据环境时区处理。",
            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "GMT+8",
            "x-order": 4
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "accessory_limit": {
                  "limit_count": 5,
                  "limit_size": 4,
                  "limit_file_type": "jpg"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryAccessoryLimitV2Rsp"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v2/servicerequest/accessorys/limits",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "AccessoryLimitVo": {
      "type": "object",
      "properties": {
        "limit_count": {
          "minLength": 1,
          "maxLength": 2,
          "description": "限制文件数量",
          "type": "string"
        },
        "limit_size": {
          "minLength": 1,
          "maxLength": 2,
          "description": "限制文件大小,单位是M",
          "type": "string"
        },
        "limit_file_type": {
          "minLength": 1,
          "maxLength": 256,
          "description": "限制文件类型",
          "type": "string"
        }
      }
    },
    "QueryAccessoryLimitV2Rsp": {
      "type": "object",
      "properties": {
        "accessory_limit": {
          "$ref": "#/definitions/AccessoryLimitVo"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "osm.cn-south-1.myhuaweicloud.cn",
