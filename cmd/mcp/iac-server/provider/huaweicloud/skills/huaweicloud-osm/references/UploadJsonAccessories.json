{
  "name": "UploadJsonAccessories",
  "summary": "上传附件",
  "tags": "附件功能",
  "productshort": "OSM",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/servicerequest/accessorys/json-format-content": {
      "post": {
        "tags": [
          "附件功能"
        ],
        "summary": "上传附件",
        "description": "上传附件给SDK使用,上传附件需要满足\"附件限制\"返回的关于大小等限制",
        "operationId": "UploadJsonAccessories",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "minLength": 1,
            "maxLength": 5000,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-order": 1
          },
          {
            "name": "X-Site",
            "in": "header",
            "description": "对接站点信息。\n\n0(中国站) 1(国际站),不填的话默认为0。",
            "required": false,
            "maximum": 1,
            "minimum": 0,
            "type": "integer",
            "x-example": 0,
            "x-order": 2
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言环境,值为通用的语言描述字符串,比如zh-cn等,默认为zh-cn。\n\n会根据语言环境对应展示一些国际化的信息,比如工单类型名称等。",
            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "zh-cn",
            "x-order": 3
          },
          {
            "name": "X-Time-Zone",
            "in": "header",
            "description": "环境时区,值为通用的时区描述字符串,比如GMT+8等,,默认为GMT+8。\n\n涉及时间的数据会根据环境时区处理。",
            "required": false,
            "minLength": 1,
            "maxLength": 32,
            "type": "string",
            "x-example": "GMT+8",
            "x-order": 4
          },
          {
            "in": "body",
            "name": "UploadJsonAccessoriesRequestBody",
            "description": "上传附件请求体",
            "required": false,
            "schema": {
              "$ref": "#/definitions/AccessoryJsonFormatReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "上传成功,返回附件的id",
            "examples": {
              "application/json": {
                "accessory_id": "123456"
              }
            },
            "schema": {
              "$ref": "#/definitions/AccessoryUploadV2Rsp"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "POST https://{endpoint}/v2/servicerequest/accessorys/json-format-content",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "AccessoryJsonFormatReq": {
      "type": "object",
      "required": [
        "accessory_data",
        "accessory_from",
        "accessory_name"
      ],
      "properties": {
        "accessory_name": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string",
          "description": "文件名称"
        },
        "accessory_from": {
          "minLength": 1,
          "maxLength": 32,
          "type": "string",
          "enum": [
            "incident",
            "message"
          ],
          "description": "文件来源,创建工单附件传incident,留言附件传message"
        },
        "upload_type": {
          "type": "integer",
          "format": "int32",
          "description": "上传类型,默认为0,markdown模式为1",
          "minimum": 0,
          "maximum": 1
        },
        "accessory_data": {
          "type": "string",
          "maxLength": 9223372036854775807,
          "minLength": 1,
          "description": "文件内容,Base64格式"
        }
      }
    },
    "AccessoryUploadV2Rsp": {
      "type": "object",
      "properties": {
        "accessory_id": {
          "minLength": 1,
          "maxLength": 64,
          "description": "附件id",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "osm.cn-south-1.myhuaweicloud.cn",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}