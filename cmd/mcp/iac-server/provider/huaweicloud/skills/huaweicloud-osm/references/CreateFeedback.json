            "required": true,
            "minLength": 1,
            "maxLength": 5000,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-order": 1
          },
          {
            "in": "body",
            "name": "CreateFeedbackRequestBody",
            "description": "创建举报反馈请求体",
            "required": false,
            "schema": {
              "$ref": "#/definitions/CreateFeedbackV2Req"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "response of 200",
            "schema": {
              "$ref": "#/definitions/ApiGatewayV2BaseResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ApiGatewayV2BaseResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        }
      }
    },
    "CreateFeedbackV2Req": {
      "type": "object",
      "required": [
        "contacts",
        "content",
        "files",
        "title",
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "example": "infringement",
          "description": "举报类型"
        },
        "title": {
          "minLength": 0,
          "maxLength": 2048,
          "example": "www.test.com",
          "type": "string",
          "description": "涉案的华为云产品或服务; 举报网址"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "example": "侵权详情说明或举报内容及说明",
          "description": "侵权详情说明或举报内容及说明"
        },
        "files": {
          "type": "array",
          "description": "相关证明附件列表",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "maxItems": 3,
          "minItems": 1,
          "example": [
            "相关证明附件列表"
          ]
        },
        "ip": {
          "description": "产权信息",
          "$ref": "#/definitions/IntellectualPropertyV2"
        },
        "contacts": {
          "description": "联系信息",
          "$ref": "#/definitions/ContactWayInfoV2"
        }
      }
    },
    "IntellectualPropertyV2": {
      "type": "object",
      "properties": {
        "ip_type": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "example": "copyright",
          "description": "知识产权类型,分:著作权-copyright、商标权-trademark、专利权-patent"
        },
        "ip_area": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "example": "中国",
          "description": "知识产权注册国家/地区"
        },
        "ip_number": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512,
          "example": "商标注册号/专利申请号",
          "description": "商标注册号/专利申请号"
        },
        "ip_content": {
          "type": "string",
          "minLength": 0,
          "maxLength": 5000,
          "example": "知识产权情况简述",
          "description": "知识产权情况简述"
        }
      }
    },
    "ContactWayInfoV2": {
      "type": "object",
      "required": [
        "id_files",
        "id_type",
        "mobile",
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "姓名或名称",
          "example": "name"
        },
        "mobile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "联系电话",
          "example": "188xxxx6587"
        },
        "mail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "联系邮箱",
          "example": "test@mail.com"
        },
        "area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "国家/地区",
          "example": "华南"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "地址",
          "example": "xxxxxxxxxxx"
        },
        "id_type": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 100,
          "description": "身份。企业 10;个人 20;授权代理人 21;律师 22;知识产权所有人 23",
          "example": 20
        },
        "company_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512,
          "description": "公司名称",
          "example": "xxxx"
        },
        "id_files": {
          "type": "array",
          "description": "身份证明附件列表,至少1个,最多3个",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 3,
          "minItems": 1
        },
        "other_way": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512,
          "description": "其他联系方式"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
