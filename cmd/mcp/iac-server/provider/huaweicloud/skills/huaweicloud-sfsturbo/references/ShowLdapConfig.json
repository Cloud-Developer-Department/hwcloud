{
  "name": "ShowLdapConfig",
  "summary": "查询LDAP的配置",
  "tags": "权限管理",
  "productshort": "SFSTurbo",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/sfs-turbo/shares/{share_id}/fs/ldap": {
      "get": {
        "summary": "查询LDAP的配置",
        "tags": [
          "权限管理"
        ],
        "description": "查询LDAP的配置。",
        "operationId": "ShowLdapConfig",
        "x-constraint": "该接口仅适用于NFS文件系统共享协议。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-version": "v1",
        "x-api-type": "open-api",
        "x-apiexplorer-hide": "false",
        "x-open-region-cloud": "hws,hws_hk,hcs",
        "parameters": [
          {
            "description": "账号的token",
            "in": "header",
            "name": "X-Auth-Token",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "description": "MIME类型",
            "in": "header",
            "name": "Content-Type",
            "required": true,
            "type": "string",
            "x-example": "application/json"
          },
          {
            "description": "项目ID",
            "in": "path",
            "name": "project_id",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "in": "path",
            "name": "share_id",
            "description": "文件系统ID",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID"
              }
            },
            "schema": {
              "$ref": "#/definitions/GetLdapConfigResponseBody"
            },
            "x-response-examples-description-1": "查询LDAP的配置的响应示例。",
            "x-response-examples-1": {
              "application/json": {
                "url": "ldap://192.168.xx.xx:60000",
                "base_dn": "dc=example,dc=com",
                "user_dn": "cn=admin,dc=example,dc=com",
                "vpc_id": "15e1a488-0ee5-4742-8fb7-168100000000",
                "backup_url": "ldap://192.168.xx.xx:60000",
                "schema": "RFC2307",
                "search_timeout": 20
              }
            }
          },
          "500": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "errCode": "SFS.TURBO.0005",
                "errMsg": "Internal server error"
              }
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "GetLdapConfigResponseBody": {
      "description": "LDAP配置信息",
      "properties": {
        "url": {
          "type": "string",
          "description": "LDAP服务器的url"
        },
        "base_dn": {
          "type": "string",
          "description": "数据库中的域"
        },
        "user_dn": {
          "type": "string",
          "description": "用户区别名"
        },
        "filter_condition": {
          "type": "string",
          "description": "过滤条件。保留字段,暂不支持"
        },
        "vpc_id": {
          "type": "string",
          "description": "保留字段,暂不支持",
          "example": "26f6b565-xxxx-XXXX-xxxx-03f0bd975433"
        },
        "backup_url": {
          "type": "string",
          "description": "LDAP备节点的url"
        },
        "schema": {
          "type": "string",
          "description": "LDAP的schema,不填写则默认为RFC2307"
        },
        "search_timeout": {
          "type": "integer",
          "description": "LDAP搜索的超时时间,单位为秒。不填写则默认为3秒"
        }
      },
      "type": "object"
    },
    "ErrorResp": {
      "description": "失败时返回的错误对象",
      "required": [
        "errCode",
        "errMsg"
      ],
      "properties": {
        "errCode": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "errMsg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "sfs-turbo.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}