  "definitions": {
    "ActionProgress": {
      "type": "object",
      "properties": {
        "CREATING": {
          "description": "创建文件系统的进度。",
          "type": "string"
        }
      }
    },
    "ShareInfoFeatures": {
      "type": "object",
      "description": "文件系统的特性支持情况。",
      "properties": {
        "backup": {
          "x-open-region-cloud": "hws,hws_hk,hws_eu",
          "type": "object",
          "$ref": "#/definitions/ShareInfoFeature",
          "description": "SFS Turbo文件系统是否支持备份。"
        }
      }
    },
    "ShareInfoFeature": {
      "type": "object",
      "description": "文件系统的特性支持情况。",
      "properties": {
        "is_support": {
          "type": "boolean",
          "description": "文件系统是否支持该特性"
        },
        "message": {
          "type": "string",
          "description": "文件系统是否支持该特性的详细信息"
        },
        "msg_code": {
          "type": "string",
          "description": "文件系统是否支持该特性的详细信息"
        }
      }
    },
    "ShareInfo": {
      "type": "object",
      "description": "文件系统详情",
      "properties": {
        "action_progress": {
          "$ref": "#/definitions/ActionProgress",
          "description": "SFS Turbo文件系统的创建任务进度。文件系统正在创建时,返回该字段;否则不返回。"
        },
        "version": {
          "description": "SFS Turbo文件系统的版本号。",
          "type": "string"
        },
        "avail_capacity": {
          "description": "SFS Turbo文件系统剩余容量,单位GB。",
          "type": "string"
        },
        "availability_zone": {
          "description": "SFS Turbo文件系统所在可用区编码。",
          "type": "string"
        },
        "az_name": {
          "description": "SFS Turbo文件系统所在可用区名称。",
          "type": "string"
        },
        "created_at": {
          "description": "创建时间。UTC时间,例如:2018-11-19T04:02:03",
          "format": "date-time",
          "type": "string"
        },
        "crypt_key_id": {
          "description": "用户指定的加密密钥ID,非加密盘时不返回。",
          "type": "string"
        },
        "expand_type": {
          "description": "如果是增强版文件系统,该字段返回bandwidth;如果是20MB/s/TiB、40MB/s/TiB、125MB/s/TiB、250MB/s/TiB、500MB/s/TiB、1000MB/s/TiB,该字段返回hpc;否则不返回。",
          "type": "string"
        },
        "export_location": {
          "description": "SFS Turbo文件系统的挂载端点。例如\"192.168.0.90:/\"。如果文件系统正在创建,该字段不返回。",
          "type": "string"
        },
        "id": {
          "description": "SFS Turbo的文件系统ID。",
          "type": "string"
        },
        "name": {
          "description": "创建时指定的SFS Turbo文件系统名称。",
          "type": "string"
        },
        "pay_model": {
          "description": "SFS Turbo文件系统的计费模式。'0'代表按需付费,'1'代表包周期计费。如果文件系统正在创建,该字段不返回。",
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        },
        "region": {
          "description": "SFS Turbo文件系统所在区域。",
          "type": "string"
        },
        "security_group_id": {
          "description": "用户指定的安全组ID。",
          "type": "string"
        },
        "share_proto": {
          "description": "SFS Turbo文件系统的协议类型,当前为NFS或 CIFS。",
          "type": "string"
        },
        "share_type": {
          "description": "SFS Turbo文件系统性能类型,包括“STANDARD”标准型和“PERFORMANCE”性能型。",
          "type": "string"
        },
        "size": {
          "description": "SFS Turbo文件系统总容量,单位GB。",
          "type": "string"
        },
        "status": {
          "description": "SFS Turbo文件系统的状态。'100'表示创建中,'200'表示可用,'303'表示创建失败,'800'表示实例被冻结。",
          "type": "string"
        },
        "sub_status": {
          "description": "SFS Turbo文件系统的子状态。当用户未对文件系统有修改类操作时,该字段不返回。\n'121'表示扩容中;'132'表示修改安全组中;'137'表示添加VPC中;'138'表示删除VPC中;'150'表示配置联动后端中;'151'表示删除联动后端配置中。\n'221'表示扩容成功;'232'表示修改安全组成功;'237'表示添加VPC成功;'238'表示删除VPC成功;'250'表示配置联动后端成功;'251'表示删除联动后端配置成功。\n'321'表示扩容失败;'332'表示修改安全组失败;'337'表示添加VPC失败;'338'表示删除VPC失败;'350'表示配置联动后端失败;'351'表示删除联动后端配置失败。",
          "type": "string"
        },
        "subnet_id": {
          "description": "用户指定的子网的网络ID。",
          "type": "string"
        },
        "vpc_id": {
          "description": "用户指定的VPC ID。",
          "type": "string"
        },
        "enterprise_project_id": {
          "description": "SFS Turbo文件系统绑定的企业项目ID。",
          "type": "string",
          "x-open-region-cloud": "hws,hws_hk,hws_eu,ctc,dt,sbc"
        },
        "tags": {
          "description": "tag标签的列表。",
          "items": {
            "$ref": "#/definitions/ResourceTag"
          },
          "type": "array"
        },
        "optional_endpoint": {
          "description": "可选的挂载IP地址。上一代文件系统规格类型不返回该字段。",
          "type": "string"
        },
        "hpc_bw": {
          "description": "文件系统的带宽规格。\n- \"20M\"表示20MB/s/TiB\n- \"40M\"表示40MB/s/TiB\n- \"125M\"表示125MB/s/TiB\n- \"250M\"表示250MB/s/TiB\n- \"500M\"表示500MB/s/TiB \n- \"1000M\"表示1000MB/s/TiB \n- \"2G\"、\"4G\"、\"8G\"、\"16G\"、\"24G\"、\"32G\"或\"48G\"表示HPC缓存型的带宽规格。",
          "type": "string",
          "x-open-region-cloud": "hws,hws_hk,hws_eu,dt,sbc"
        },
        "instanceId": {
          "description": "文件系统规格的节点id,为预留字段,不具备实际含义。",
          "type": "string"
        },
        "instanceType": {
          "description": "文件系统规格的节点类型,为预留字段,不具备实际含义。",
          "type": "string"
        },
        "statusDetail": {
          "description": "文件系统的请求ID,为预留字段,不具备实际含义。",
          "type": "string"
        },
        "features": {
          "description": "文件系统的特性支持情况。",
          "$ref": "#/definitions/ShareInfoFeatures",
          "x-open-region-cloud": "hws,hws_hk,hws_eu"
        }
      }
    },
    "ResourceTag": {
      "type": "object",
      "description": "resource_tag字段说明",
      "properties": {
        "key": {
          "description": "标签的键。\n\n最大长度128个字符。 \n\nkey不能为空,不能包含非打印字符ASCII(0-31),“=”,“*”,“<”,“>”,“\\”,“,”,“|”,“/”。只能包含大写字母、小写字母、数字,特殊字符\"-\"和\"_\"。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "description": "标签的值。\n\n每个值最大长度255个字符,可以为空字符串。\n\n不能包含非打印字符ASCII(0-31),“=”,“*”,“<”,“>”,“\\”,“,”,“|”,“/”。只能包含大写字母、小写字母、数字,特殊字符\"-\"和\"_\"。",
          "type": "string",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    "ListSharesResponseBody": {
      "type": "object",
      "properties": {
        "shares": {
          "description": "SFS Turbo文件系统的列表。",
          "items": {
            "type": "object",
            "$ref": "#/definitions/ShareInfo"
          },
          "type": "array"
        },
        "count": {
          "description": "SFS Turbo文件系统的数量。",
          "type": "integer"
        }
      }
    }
  },
