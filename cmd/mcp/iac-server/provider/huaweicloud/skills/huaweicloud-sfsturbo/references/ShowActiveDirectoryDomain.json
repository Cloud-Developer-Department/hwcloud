{
  "name": "ShowActiveDirectoryDomain",
  "summary": "查询AD域配置",
  "tags": "权限管理",
  "productshort": "SFSTurbo",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/sfs-turbo/shares/{share_id}/fs/active-directory-domain": {
      "get": {
        "summary": "查询AD域配置",
        "tags": [
          "权限管理"
        ],
        "description": "查询AD域配置。Active Directory域(简称:AD域)提供统一的身份认证和授权管理。通过将SFS Turbo文件系统的挂载点接入AD域内,您可以在AD域中实现文件系统用户身份的认证管理和文件级别的访问权限控制。",
        "operationId": "ShowActiveDirectoryDomain",
        "x-constraint": "该接口仅适用于SMB文件系统共享协议。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-apiexplorer-hide": "false",
        "x-open-region-cloud": "hws,hws_hk,hws_eu,hcs",
        "x-version": "v1",
        "parameters": [
          {
            "description": "账号的token",
            "in": "header",
            "name": "X-Auth-Token",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "description": "MIME类型",
            "in": "header",
            "name": "Content-Type",
            "required": true,
            "type": "string",
            "x-example": "application/json"
          },
          {
            "description": "项目ID",
            "in": "path",
            "name": "project_id",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "in": "path",
            "name": "share_id",
            "description": "文件系统ID",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID"
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowActiveDirectoryDomainResponseBody"
            }
          },
          "500": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "errCode": "SFS.TURBO.0005",
                "errMsg": "Internal server error"
              }
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID"
              }
            }
          }
        },
        "x-order": 10
      }
    }
  },
  "definitions": {
    "ErrorResp": {
      "description": "失败时返回的错误对象",
      "required": [
        "errCode",
        "errMsg"
      ],
      "properties": {
        "errCode": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "errMsg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    },
    "ShowActiveDirectoryDomainResponseBody": {
      "required": [
        "domain_name",
        "system_name",
        "dns_server",
        "organization_unit",
        "status"
      ],
      "description": "AD域配置信息",
      "properties": {
        "domain_name": {
          "type": "string",
          "description": "域控服务器的域名,在创建域服务器时指定",
          "example": "SFSTURBO.COM"
        },
        "system_name": {
          "type": "string",
          "description": "存储系统在AD域中的名称",
          "example": "sfs"
        },
        "dns_server": {
          "type": "array",
          "description": "DNS服务器IP地址,用于解析AD域的域名",
          "items": {
            "type": "string",
            "description": "DNS域名IP地址",
            "example": "192.168.xx.xx"
          }
        },
        "organization_unit": {
          "type": "string",
          "description": "域中包含的一类目录对象如用户、计算机、打印机等资源的总称,加入后将作为其中的一员。若不填,则默认加入到computers组织单元。",
          "example": "computers"
        },
        "vpc_id": {
          "type": "string",
          "description": "vpc的id",
          "example": "26f6b565-xxxx-XXXX-xxxx-03f0bd975433"
        },
        "status": {
          "type": "string",
          "description": "AD域当前状态信息",
          "enum": [
            "JOINING",
            "AVAILABLE",
            "EXITING",
            "FAILED"
          ]
        }
      }
    }
  },
  "version": "2.0",
