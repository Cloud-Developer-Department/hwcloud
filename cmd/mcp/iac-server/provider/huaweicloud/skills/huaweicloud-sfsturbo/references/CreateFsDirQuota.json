{
  "name": "CreateFsDirQuota",
  "summary": "创建目标文件夹配额",
  "tags": "目录管理",
  "productshort": "SFSTurbo",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/sfs-turbo/shares/{share_id}/fs/dir-quota": {
      "post": {
        "tags": [
          "目录管理"
        ],
        "operationId": "CreateFsDirQuota",
        "summary": "创建目标文件夹配额",
        "description": "创建目标文件夹配额。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-apiexplorer-hide": "false",
        "x-open-region-cloud": "hws,hws_hk,sbc,hcs",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "description": "账号的token",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "in": "header",
            "name": "Content-Type",
            "description": "MIME类型",
            "required": true,
            "type": "string",
            "x-example": "application/json"
          },
          {
            "in": "path",
            "name": "project_id",
            "description": "项目ID",
            "required": true,
            "type": "string"
          },
          {
            "in": "path",
            "name": "share_id",
            "description": "文件系统ID",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "CreateFsDirQuotaRequestBody",
            "description": "目标文件夹配额信息",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateFsDirQuotaRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "创建配额成功",
            "schema": {
              "$ref": "#/definitions/FsDirQuotaRespInfo"
            },
            "examples": {
              "application/json": {
                "path": "/data/test",
                "capacity": 1024,
                "inode": 100000
              }
            }
          },
          "400": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "errCode": "SFS.TURBO.0102",
                "errMsg": "Path is not directory"
              }
            }
          },
          "500": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "errCode": "SFS.TURBO.0005",
                "errMsg": "Internal server error"
              }
            }
          }
        },
        "x-request-examples-description-1": "创建目标文件夹配额,目录的全路径是“/data/test”,目录的容量大小是1024MB,目录的inode数量限制是100000。",
        "x-request-examples-1": {
          "path": "/data/test",
          "capacity": 1024,
          "inode": 100000
        },
        "x-order": 0
      }
    }
  },
  "definitions": {
    "ErrorResp": {
      "description": "失败时返回的错误对象",
      "required": [
        "errCode",
        "errMsg"
      ],
      "properties": {
        "errCode": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "errMsg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    },
    "FsDirQuotaRespInfo": {
      "description": "目录配额信息",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "description": "合法的已存在的目录的全路径",
          "type": "string"
        },
        "capacity": {
          "description": "目录的容量大小,单位:MB",
          "type": "integer"
        },
        "inode": {
          "description": "目录的inode数量限制",
          "type": "integer"
        },
        "used_capacity": {
          "description": "目录已使用的容量大小,单位:MB。仅SFSTurbo 20MB/s/TiB、40MB/s/TiB、125MB/s/TiB、250MB/s/TiB、500MB/s/TiB、1000MB/s/TiB返回该字段",
          "type": "integer"
        },
        "used_inode": {
          "description": "目录的已使用的inode数量。仅SFSTurbo 20MB/s/TiB、40MB/s/TiB、125MB/s/TiB、250MB/s/TiB、500MB/s/TiB、1000MB/s/TiB返回该字段",
          "type": "integer"
        }
      }
    },
    "CreateFsDirQuotaRequestBody": {
      "description": "目录配额信息",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "description": "合法的已存在的目录的全路径",
          "type": "string"
        },
        "capacity": {
          "description": "目录的容量大小,单位:MB; 不填写则默认为0,会导致数据无法写入目录; capacity和quota至少二选一。",
          "type": "integer"
        },
        "inode": {
          "description": "目录的inode数量限制; 不填写则默认为0,会导致数据无法写入目录; capacity和quota至少二选一。",
          "type": "integer"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
