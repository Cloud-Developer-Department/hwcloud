          "example": "ldap://192.168.xx.xx:60000"
        },
        "base_dn": {
          "type": "string",
          "description": "数据库中的域",
          "example": "dc=example,dc=com"
        },
        "user_dn": {
          "type": "string",
          "description": "用户区别名",
          "example": "cn=admin,dc=example,dc=com"
        },
        "password": {
          "type": "string",
          "description": "LDAP认证密码",
          "example": "pwdxxxxxx"
        },
        "vpc_id": {
          "type": "string",
          "description": "vpc的id",
          "example": "26f6b565-xxxx-XXXX-xxxx-03f0bd975433"
        },
        "filter_condition": {
          "type": "string",
          "description": "过滤条件。保留字段,暂不支持"
        },
        "backup_url": {
          "type": "string",
          "description": "LDAP备节点的url,固定格式为 ldap://{ip_address}:{port_number} 或 ldaps://{ip_address}:{port_number},例如ldap://192.168.xx.xx:60000",
          "example": "ldap://192.168.xx.xx:60000"
        },
        "schema": {
          "type": "string",
          "description": "LDAP的schema,不填写则默认为RFC2307"
        },
        "search_timeout": {
          "type": "integer",
          "format": "int32",
          "description": "LDAP搜索的超时时间,单位为秒。不填写则默认为3秒",
          "example": 10
        }
      },
      "type": "object"
    },
    "ErrorResp": {
      "description": "失败时返回的错误对象",
      "required": [
        "errCode",
        "errMsg"
      ],
      "properties": {
        "errCode": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
