  "definitions": {
    "ListSharesByTagResponseBody": {
      "type": "object",
      "description": "通过标签查询文件系统列表的响应体",
      "properties": {
        "resources": {
          "description": "通过标签查询文件系统的资源列表",
          "type": "array",
          "items": {
            "type": "object",
            "description": "资源列表",
            "$ref": "#/definitions/ListSharesByTagResource"
          }
        },
        "total_count": {
          "description": "返回的文件系统的总量",
          "type": "integer"
        }
      }
    },
    "Tag": {
      "type": "object",
      "description": "tag字段说明",
      "properties": {
        "key": {
          "description": "标签的键。\n\n最大长度128个字符。 key不能为空。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "values": {
          "description": "值列表。每个值最大长度255个字符,如果values为空列表,则表示匹配任意值value。value之间为或的关系。",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "maxItems": 10
        }
      },
      "required": [
        "key",
        "values"
      ]
    },
    "ErrorResp": {
      "description": "失败时返回的错误对象",
      "required": [
        "errCode",
        "errMsg"
      ],
      "properties": {
        "errCode": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "errMsg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    },
    "ListSharesByTagRequestBody": {
      "type": "object",
      "description": "通过标签查询文件系统列表的请求体",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "description": "通过标签查询文件系统列表的操作类型。仅支持取值为\"filter\" 或 \"count\"。",
          "type": "string",
          "enum": [
            "filter",
            "count"
          ],
          "example": "filter"
        },
        "limit": {
          "description": "设置返回的文件系统个数的最大值。",
          "type": "string",
          "example": 10
        },
        "offset": {
          "description": "设置返回的文件系统的偏移量",
          "type": "string",
          "example": 0
        },
        "without_any_tag": {
          "description": "不包含任意一个标签,该字段为true时查询所有不带标签的资源,此时忽略 “tags”字段。该字段为false或者未提供该参数时,该条件不生效,即返回所有资源或按\"tags\",\"matches\"等条件过滤。",
          "type": "boolean",
          "example": true
        },
        "tags": {
          "description": "包含标签,最多包含20个key,每个key下面的value最多20个,每个key对应的value可以为空数组但结构体不能缺失。key不能重复,同一个key中values不能重复。结果返回包含所有标签的资源列表,key之间是与的关系,key-value结构中value是或的关系。无tag过滤条件时返回全量数据。",
          "type": "array",
          "items": {
            "type": "object",
            "description": "包含标签",
            "$ref": "#/definitions/Tag"
          }
        },
        "matches": {
          "description": "搜索字段,key为要匹配的字段,仅支持取值“resource_name”。value为匹配的值,当value以“\\*”结尾时,为前缀搜索。例如:value值为“sfsturbo\\*”时,返回名称为“sfsturbo”开头的所有资源列表。",
          "type": "array",
          "items": {
            "type": "object",
            "description": "包含标签",
            "$ref": "#/definitions/ResourceTag"
          }
        }
      }
    },
    "ListSharesByTagResource": {
      "type": "object",
      "description": "资源详情",
      "properties": {
        "resource_id": {
          "description": "资源ID",
          "type": "string"
        },
        "resource_name": {
          "description": "资源名称",
          "type": "string"
        },
        "resource_detail": {
          "description": "资源详情",
          "type": "string"
        },
        "tags": {
          "description": "资源的标签列表",
          "type": "array",
          "items": {
            "type": "object",
            "description": "标签详情",
            "$ref": "#/definitions/ResourceTag"
          }
        }
      }
    },
    "ResourceTag": {
      "type": "object",
      "description": "resource_tag字段说明",
      "properties": {
        "key": {
          "description": "标签的键。\n\n最大长度128个字符。 \n\nkey不能为空,不能包含非打印字符ASCII(0-31),“=”,“*”,“<”,“>”,“\\”,“,”,“|”,“/”。只能包含大写字母、小写字母、数字,特殊字符\"-\"和\"_\"。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "description": "标签的值。\n\n每个值最大长度255个字符,可以为空字符串。\n\n不能包含非打印字符ASCII(0-31),“=”,“*”,“<”,“>”,“\\”,“,”,“|”,“/”。只能包含大写字母、小写字母、数字,特殊字符\"-\"和\"_\"。",
          "type": "string",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "required": [
        "key",
        "value"
      ]
    }
  },
