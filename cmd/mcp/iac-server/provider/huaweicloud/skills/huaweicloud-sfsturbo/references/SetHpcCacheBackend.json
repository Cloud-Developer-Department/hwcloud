  "definitions": {
    "ReqUpdateHpcCacheData": {
      "description": "后端挂载地址信息",
      "required": [
        "gc_time",
        "ck_time"
      ],
      "properties": {
        "gc_time": {
          "description": "冷数据淘汰时间。单位:小时。指定时间内线上缓存的数据如果没有被访问则会自动从缓存中删除。0表示数据不会因为时间原因自动从缓存中删除。",
          "type": "integer",
          "format": "int64"
        },
        "ck_time": {
          "description": "后端校验时间。单位:秒。指定时间间隔进行线上缓存文件与后端存储文件比较,存在变化则自动更新。0表示文件进行实时校验。",
          "type": "integer",
          "format": "int64"
        },
        "nas": {
          "description": "配置 nas 后端的信息",
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/ConfigNasTarget"
          }
        }
      }
    },
    "ErrorResp": {
      "description": "失败时返回的错误对象",
      "required": [
        "errCode",
        "errMsg"
      ],
      "properties": {
        "errCode": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "errMsg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    },
    "ReqConfigHpcCacheBackend": {
      "description": "hpc缓存型配置信息请求",
      "required": [
        "update_hpc_cache"
      ],
      "properties": {
        "update_hpc_cache": {
          "description": "后端挂载信息",
          "type": "object",
          "$ref": "#/definitions/ReqUpdateHpcCacheInfo"
        }
      }
    },
    "ConfigNasTarget": {
      "type": "object",
      "description": "配置 nas 后端信息",
      "properties": {
        "name": {
          "description": "nas 配置名",
          "type": "string"
        },
        "type": {
          "description": "nas 配置协议类型",
          "type": "string"
        },
        "url": {
          "description": "nas 配置 ip",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "url"
      ]
    },
    "ReqUpdateHpcCacheInfo": {
      "description": "后端挂载信息",
      "required": [
        "action",
        "data"
      ],
      "properties": {
        "action": {
          "description": "配置hpc缓存型的动作,如initialize_overlay",
          "type": "string"
        },
        "data": {
          "description": "hpc 缓存型后端配置信息",
          "type": "object",
          "$ref": "#/definitions/ReqUpdateHpcCacheData"
        }
      }
    }
  },
