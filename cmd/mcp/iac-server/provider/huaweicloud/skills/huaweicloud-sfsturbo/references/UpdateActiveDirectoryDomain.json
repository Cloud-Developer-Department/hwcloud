                "errCode": "SFS.TURBO.0001",
                "errMsg": "Incorrect account or password."
              }
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID"
              }
            }
          },
          "500": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "errCode": "SFS.TURBO.0005",
                "errMsg": "Internal server error"
              }
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID"
              }
            }
          }
        },
        "x-request-examples-url-1": "PUT HTTPS://{endpoint}/v1/{project_id}/sfs-turbo/shares/{share_id}/fs/active-directory-domain",
        "x-request-examples-1": {
          "service_account": "administrator",
          "password": "pwdxxxxx",
          "domain_name": "SFSTURBO.COM",
          "system_name": "sfs",
          "dns_server": "100.xxx:xxx"
        },
        "x-order": 11
      }
    }
  },
  "definitions": {
    "UpdateActiveDirectoryDomainRequestBody": {
      "required": [
        "domain_name",
        "system_name",
        "dns_server",
        "service_account",
        "password"
      ],
      "description": "AD域配置信息",
      "properties": {
        "service_account": {
          "type": "string",
          "description": "服务账号,在创建域服务器时指定,一般默认为administrator",
          "example": "administrator"
        },
        "password": {
          "type": "string",
          "description": "账号对应密码",
          "example": "pwdxxxxxx"
        },
        "domain_name": {
          "type": "string",
          "description": "域控服务器的域名,在创建域服务器时指定",
          "example": "SFSTURBO.COM"
        },
        "system_name": {
          "type": "string",
          "description": "存储系统在AD域中的名称",
          "example": "sfs"
        },
        "overwrite_same_account": {
          "type": "boolean",
          "description": "如果域控制器中已存在同系统名称的存储系统,开启该选项后,将覆盖原有的存储系统信息。",
          "example": true
        },
        "dns_server": {
          "type": "array",
          "description": "DNS服务器IP地址,用于解析AD域的域名",
          "items": {
            "type": "string",
            "description": "DNS域名IP地址,至少需要一个DNS域名IP地址,至多三个。第一个为主选DNS服务器,其余为备选。"
          }
        },
        "organization_unit": {
          "type": "string",
          "description": "域中包含的一类目录对象如用户、计算机、打印机等资源的总称,加入后将作为其中的一员。若不填,则默认加入到computers组织单元。",
          "example": "computers"
        },
        "vpc_id": {
          "type": "string",
          "description": "vpc的id",
          "example": "26f6b565-xxxx-XXXX-xxxx-03f0bd975433"
        }
      }
    },
    "ErrorResp": {
      "description": "失败时返回的错误对象",
      "required": [
        "errCode",
        "errMsg"
      ],
      "properties": {
        "errCode": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "errMsg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    },
    "UpdateActiveDirectoryDomainResponseBody": {
      "required": [
        "job_id"
      ],
      "description": "修改AD域响应体",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "修改AD域异步任务的id"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
