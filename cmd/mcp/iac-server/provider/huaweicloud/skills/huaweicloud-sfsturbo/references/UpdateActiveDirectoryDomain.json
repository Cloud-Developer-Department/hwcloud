{
  "name": "UpdateActiveDirectoryDomain",
  "summary": "修改AD域配置",
  "tags": "权限管理",
  "productshort": "SFSTurbo",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/sfs-turbo/shares/{share_id}/fs/active-directory-domain": {
      "put": {
        "summary": "修改AD域配置",
        "tags": [
          "权限管理"
        ],
        "description": "修改AD域配置。Active Directory域(简称:AD域)提供统一的身份认证和授权管理。通过将SFS Turbo文件系统的挂载点接入AD域内,您可以在AD域中实现文件系统用户身份的认证管理和文件级别的访问权限控制。",
        "operationId": "UpdateActiveDirectoryDomain",
        "x-constraint": "该接口仅适用于SMB文件系统共享协议。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-apiexplorer-hide": "false",
        "x-open-region-cloud": "hws,hws_hk,hws_eu,hcs",
        "x-version": "v1",
        "parameters": [
          {
            "description": "账号的token",
            "in": "header",
            "name": "X-Auth-Token",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "description": "MIME类型",
            "in": "header",
            "name": "Content-Type",
            "required": true,
            "type": "string",
            "x-example": "application/json"
          },
          {
            "description": "项目ID",
            "in": "path",
            "name": "project_id",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "in": "path",
            "name": "share_id",
            "description": "文件系统ID",
            "required": true,
            "type": "string"
          },
          {
            "description": "请求体",
            "in": "body",
            "name": "UpdateActiveDirectoryDomainRequestBody",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateActiveDirectoryDomainRequestBody"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "修改AD域配置请求下发成功",
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID"
              }
            },
            "schema": {
              "$ref": "#/definitions/UpdateActiveDirectoryDomainResponseBody"
            }
          },
          "400": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
