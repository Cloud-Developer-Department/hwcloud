{
  "name": "ListPermRules",
  "summary": "查询文件系统的权限规则列表",
  "tags": "权限管理",
  "productshort": "SFSTurbo",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/sfs-turbo/shares/{share_id}/fs/perm-rules": {
      "get": {
        "summary": "查询文件系统的权限规则列表",
        "tags": [
          "权限管理"
        ],
        "description": "查询文件系统的权限规则列表",
        "operationId": "ListPermRules",
        "x-constraint": "一个文件系统最多可以配置64条权限规则。\n该接口仅适用于NFS文件系统共享协议。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-apiexplorer-hide": "false",
        "parameters": [
          {
            "description": "账号的token",
            "in": "header",
            "name": "X-Auth-Token",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "description": "MIME类型",
            "in": "header",
            "name": "Content-Type",
            "required": true,
            "type": "string",
            "x-example": "application/json"
          },
          {
            "description": "项目ID",
            "in": "path",
            "name": "project_id",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "in": "path",
            "name": "share_id",
            "description": "文件系统ID",
            "required": true,
            "type": "string"
          },
          {
            "in": "query",
            "description": "返回的权限规则个数",
            "format": "int64",
            "maximum": 64,
            "minimum": 0,
            "name": "limit",
            "type": "integer",
            "x-example": 10
          },
          {
            "in": "query",
            "description": "返回的权限规则的偏移量",
            "format": "int64",
            "minimum": 0,
            "default": 0,
            "name": "offset",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "$ref": "#/definitions/ListPermRulesResponseBody"
            },
            "x-response-examples-description-1": "查询文件系统的权限规则列表的响应示例。",
            "x-response-examples-1": {
              "application/json": {
                "rules": [
                  {
                    "id": "1131ed520xxxxxxebedb6e57xxxxxxxx",
                    "ip_cidr": "192.168.xx.xx/16",
                    "rw_type": "rw",
                    "user_type": "no_root_squash"
                  },
                  {
                    "id": "1231ed520xxxxxxebedb6e57xxxxxxxx",
                    "ip_cidr": "192.32.xx.xx/16",
                    "rw_type": "rw",
                    "user_type": "no_root_squash"
                  }
                ]
              }
            }
          },
          "500": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "errCode": "SFS.TURBO.0005",
                "errMsg": "Internal server error"
              }
            }
          }
        },
        "x-request-examples-description-1": "文件系统ID为\"77ba6f4b-6365-4895-8dda-bc7142af4dde\",查询该文件系统的权限规则列表\n",
        "x-request-examples-url-1": "GET HTTPS://{endpoint}/v1/{project_id}/sfs-turbo/shares/77ba6f4b-6365-4895-8dda-bc7142af4dde/fs/perm-rules"
      }
    }
  },
  "definitions": {
    "ErrorResp": {
      "description": "失败时返回的错误对象",
      "required": [
        "errCode",
        "errMsg"
      ],
      "properties": {
        "errCode": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "errMsg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    },
    "OnePermRuleResponseInfo": {
      "required": [
        "id",
        "ip_cidr",
        "rw_type",
        "user_type"
      ],
      "description": "权限规格信息",
      "properties": {
        "id": {
          "type": "string",
          "description": "权限规格的id"
        },
        "ip_cidr": {
          "type": "string",
          "description": "授权对象的IP地址或网段"
        },
        "rw_type": {
          "type": "string",
          "description": "授权对象的读写权限 \n\n- rw:默认选项,以读写的方式共享 \n\n- ro:以只读的方式共享 \n\n- none: 没有权限"
        },
        "user_type": {
          "type": "string",
          "description": "授权对象的系统用户对文件系统的访问权限。取值如下:\n\n- no_root_squash:客户端使用的是root用户时,映射到NFS服务器的用户依然为root用户。\n\n- root_squash:客户端使用的是root用户时,映射到NFS服务器的用户为NFS的匿名用户(nfsnobody)。\n\n- all_squash:默认选项。所有访问NFS服务器的客户端的用户都映射为匿名用户。'"
        }
      }
    },
    "ListPermRulesResponseBody": {
      "description": "查询权限响应体",
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "description": "权限信息",
          "items": {
            "type": "object",
            "$ref": "#/definitions/OnePermRuleResponseInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "sfs-turbo.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
