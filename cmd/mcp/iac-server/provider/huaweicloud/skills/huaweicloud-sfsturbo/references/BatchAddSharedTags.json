{
  "name": "BatchAddSharedTags",
  "summary": "批量添加共享标签",
  "tags": "共享标签",
  "productshort": "SFSTurbo",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/sfs-turbo/{share_id}/tags/action": {
      "post": {
        "summary": "批量添加共享标签",
        "tags": [
          "共享标签"
        ],
        "description": "指定共享批量添加标签。\n\n一个共享上最多有20个标签。\n一个共享上的多个标签的key不允许重复。\n此接口为幂等接口:如果要添加的key在共享上已存在,则覆盖更新标签。",
        "operationId": "BatchAddSharedTags",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-apiexplorer-hide": "false",
        "parameters": [
          {
            "description": "账号的token",
            "in": "header",
            "name": "X-Auth-Token",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "description": "MIME类型",
            "in": "header",
            "name": "Content-Type",
            "required": true,
            "type": "string",
            "x-example": "application/json"
          },
          {
            "description": "项目ID",
            "in": "path",
            "name": "project_id",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "description": "共享ID",
            "in": "path",
            "name": "share_id",
            "required": true,
            "type": "string",
            "x-example": "b959dfbb-xxxx-XXXX-xxxx-8930ec3a87b7"
          },
          {
            "description": "批量添加共享标签请求体。",
            "in": "body",
            "name": "BatchAddSharedTagsRequestBody",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BatchAddSharedTagsRequestBody"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "批量添加共享标签成功"
          }
        },
        "x-request-examples-description-1": "批量添加共享标签,第一个标签的键为“key1”,值为“value1”;第二个标签的键为“key2”,值为“value1”。",
        "x-request-examples-1": {
          "action": "create",
          "tags": [
            {
              "key": "key1",
              "value": "value1"
            },
            {
              "key": "key2",
              "value": "value1"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "ResourceTag": {
      "type": "object",
      "description": "resource_tag字段说明",
      "properties": {
        "key": {
          "description": "标签的键。\n\n最大长度128个字符。 \n\nkey不能为空,不能包含非打印字符ASCII(0-31),“=”,“*”,“<”,“>”,“\\”,“,”,“|”,“/”。只能包含大写字母、小写字母、数字,特殊字符\"-\"和\"_\"。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "description": "标签的值。\n\n每个值最大长度255个字符,可以为空字符串。\n\n不能包含非打印字符ASCII(0-31),“=”,“*”,“<”,“>”,“\\”,“,”,“|”,“/”。只能包含大写字母、小写字母、数字,特殊字符\"-\"和\"_\"。",
          "type": "string",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    "BatchAddSharedTagsRequestBody": {
      "type": "object",
      "required": [
        "action",
        "tags"
      ],
      "properties": {
        "action": {
          "description": "操作标识,取值范围为:create。 为指定共享批量添加标签时使用create。",
          "type": "string",
          "enum": [
            "create"
          ]
        },
        "tags": {
          "description": "标签列表。",
          "items": {
            "type": "object",
            "description": "resource_tag字段说明",
            "$ref": "#/definitions/ResourceTag"
          },
          "type": "array"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "sfs-turbo.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}