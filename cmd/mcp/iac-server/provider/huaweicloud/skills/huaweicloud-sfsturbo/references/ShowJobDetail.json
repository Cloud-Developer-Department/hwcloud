            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID"
              }
            },
            "examples": {
              "application/json": {
                "job_id": "26f6b565-xxxx-XXXX-xxxx-03f0bd975433",
                "status": "success",
                "job_type": "bind_ldap",
                "begin_time": "2023-07-26 09:33:58",
