  },
  "definitions": {
    "GetSubJobDetail": {
      "description": "子任务详情",
      "required": [
        "share",
        "perm"
      ],
      "properties": {
        "status": {
          "description": "子任务的状态。success:成功。running:运行中。failed:失败。waiting:等待执行。",
          "type": "string",
          "example": "FAIL"
        },
        "job_id": {
          "description": "子任务的ID。",
          "type": "string",
          "example": "b959dfbb-xxxx-XXXX-xxxx-8930ec3a87b7"
        },
        "job_type": {
          "description": "子任务的类型。",
          "type": "string"
        },
        "begin_time": {
          "description": "子任务开始时间。UTC时间,格式:'2016-01-02 15:04:05'",
          "type": "string",
          "example": "2016-01-02 15:04:05"
        },
        "end_time": {
          "description": "子任务结束时间。UTC时间,格式:'2016-01-02 15:04:05'",
          "type": "string",
          "example": "2016-01-02 15:04:05"
        },
        "error_code": {
          "description": "子任务执行失败时的错误码",
          "type": "string",
          "example": "xxxxx"
        },
        "fail_reason": {
          "description": "子任务执行失败时的错误原因",
          "type": "string",
          "example": "xxxxx"
        }
      }
    },
    "ErrorResp": {
      "description": "失败时返回的错误对象",
      "required": [
        "errCode",
        "errMsg"
      ],
      "properties": {
        "errCode": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "errMsg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    },
    "ShowJobDetail": {
      "type": "object",
      "description": "任务详情。",
      "required": [
        "status",
        "job_id",
        "job_type",
        "begin_time",
        "end_time",
        "error_code",
        "fail_reason",
        "sub_jobs"
      ],
      "properties": {
        "status": {
          "description": "job的状态。success:成功。running:运行中。failed:失败。waiting:等待执行。",
          "type": "string",
          "enum": [
            "success",
            "failed",
            "waiting",
            "running"
          ]
        },
        "job_id": {
          "description": "job的ID。",
          "type": "string",
          "example": "b959dfbb-xxxx-XXXX-xxxx-8930ec3a87b7"
        },
        "job_type": {
          "description": "job的类型。",
          "type": "string",
          "example": "bind_ldap"
        },
        "begin_time": {
          "description": "job开始时间。UTC时间,格式:'2016-01-02 15:04:05'。",
          "type": "string",
          "example": "2016-01-02 15:04:05"
        },
        "end_time": {
          "description": "job结束时间。UTC时间,格式:'2016-01-02 15:04:05'。",
          "type": "string",
          "example": "2016-01-02 15:04:05"
        },
        "error_code": {
          "description": "job执行失败时的错误码。",
          "type": "string",
          "example": "SFS.TURBO.0005"
        },
        "fail_reason": {
          "description": "job执行失败时的错误原因。",
          "type": "string",
          "example": "server error"
        },
        "sub_jobs": {
          "description": "子任务列表。",
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/GetSubJobDetail"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "sfs-turbo.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
