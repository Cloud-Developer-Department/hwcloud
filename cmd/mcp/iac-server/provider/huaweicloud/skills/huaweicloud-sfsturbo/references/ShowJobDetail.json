            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "in": "header",
            "name": "Content-Type",
            "description": "MIME类型",
            "required": true,
            "type": "string",
