{
  "name": "ShowJobDetail",
  "summary": "查询job的状态详情",
  "tags": "任务管理",
  "productshort": "SFSTurbo",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/sfs-turbo/jobs/{job_id}": {
      "get": {
        "tags": [
          "任务管理"
        ],
        "operationId": "ShowJobDetail",
        "summary": "查询job的状态详情",
        "description": "用于查询SFS Turbo异步API的执行状态。例如:可使用调用创建并绑定LDAP配置接口时返回的jobId,通过该接口查询job的执行状态。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
