{
  "name": "ShowFsDirQuota",
  "summary": "查询目标文件夹配额",
  "tags": "目录管理",
  "productshort": "SFSTurbo",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/sfs-turbo/shares/{share_id}/fs/dir-quota": {
      "get": {
        "tags": [
          "目录管理"
        ],
        "operationId": "ShowFsDirQuota",
        "summary": "查询目标文件夹配额",
        "description": "查询目标文件夹配额。查询的used_capacity、used_inode数据可能有延迟。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-apiexplorer-hide": "false",
        "x-open-region-cloud": "hws,hws_hk,sbc,hcs",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "description": "账号的token",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "in": "header",
            "name": "Content-Type",
            "description": "MIME类型",
            "required": true,
            "type": "string",
            "x-example": "application/json"
          },
          {
            "in": "path",
            "name": "project_id",
            "description": "项目ID",
            "required": true,
            "type": "string"
          },
          {
            "in": "path",
            "name": "share_id",
            "description": "文件系统ID",
            "required": true,
            "type": "string"
          },
          {
            "in": "query",
            "name": "path",
            "description": "合法的已存在的目录的全路径",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询目录的配额信息成功",
            "schema": {
              "$ref": "#/definitions/ShowFsDirQuotaResp"
            },
            "examples": {
              "application/json": {
                "path": "/data/test",
                "capacity": 1024,
                "inode": 100000
              }
            }
          },
          "400": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "errCode": "SFS.TURBO.0102",
                "errMsg": "Path is not directory"
              }
            }
          },
          "500": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "errCode": "SFS.TURBO.0005",
                "errMsg": "Internal server error"
              }
            }
          }
        },
        "x-request-examples-description-1": "文件系统ID为\"77ba6f4b-6365-4895-8dda-bc7142af4ddw\",目录的全路径是“/data/test”,查询该目录的quota值\n",
        "x-request-examples-url-1": "GET HTTPS://{endpoint}/v1/{project_id}/sfs-turbo/shares/77ba6f4b-6365-4895-8dda-bc7142af4ddw/fs/dir-quota?path=/data/test",
        "x-order": 2
      }
    }
  },
  "definitions": {
    "ErrorResp": {
      "description": "失败时返回的错误对象",
      "required": [
        "errCode",
        "errMsg"
      ],
      "properties": {
        "errCode": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "errMsg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    },
    "ShowFsDirQuotaResp": {
      "description": "目录配额信息",
      "required": [
        "path",
        "capacity",
        "inode"
      ],
      "properties": {
        "path": {
          "description": "合法的已存在的目录的全路径",
          "type": "string"
        },
        "capacity": {
          "description": "目录的容量大小,单位:MB",
          "type": "integer"
        },
        "inode": {
          "description": "目录的inode数量限制",
          "type": "integer"
        },
        "used_capacity": {
          "description": "目录已使用的容量大小,单位:MB。仅SFSTurbo 20MB/s/TiB、40MB/s/TiB、125MB/s/TiB、250MB/s/TiB、500MB/s/TiB、1000MB/s/TiB返回该字段。数据可能有延迟。",
          "type": "integer"
        },
        "used_inode": {
          "description": "目录的已使用的inode数量。仅SFSTurbo 20MB/s/TiB、40MB/s/TiB、125MB/s/TiB、250MB/s/TiB、500MB/s/TiB、1000MB/s/TiB返回该字段。数据可能有延迟。",
          "type": "integer"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "sfs-turbo.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}