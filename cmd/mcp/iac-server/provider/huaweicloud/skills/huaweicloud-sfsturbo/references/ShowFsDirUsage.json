      "type": "object",
      "description": "目录资源使用情况",
      "required": [
        "dir_usage"
      ],
      "properties": {
        "dir_usage": {
          "type": "object",
          "description": "消息描述",
          "$ref": "#/definitions/FsDirUasge"
        }
      }
    },
    "FsDirUasge": {
      "type": "object",
      "description": "目录资源使用情况(包含子目录)",
      "required": [
        "used_capacity"
      ],
      "properties": {
        "used_capacity": {
          "description": "占用容量,单位:byte",
          "type": "integer",
          "format": "int64",
          "minimum": 0
