            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID"
              }
            }
          },
          "500": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "errCode": "SFS.TURBO.0005",
                "errMsg": "Internal server error"
              }
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID"
              }
            }
          }
        },
        "x-request-examples-description-1": "标准型文件系统ID为\"77ba6f4b-6365-4895-8dda-bc7142af4dde\",查询资源使用情况\n",
        "x-request-examples-url-1": "GET HTTPS://{endpoint}/v1/{project_id}/sfs-turbo/shares/77ba6f4b-6365-4895-8dda-bc7142af4dde/fs/dir-usage",
        "x-order": 7
      }
    }
  },
  "definitions": {
    "ErrorResp": {
      "description": "失败时返回的错误对象",
      "required": [
        "errCode",
        "errMsg"
