            "description": "账号的token",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "in": "header",
            "name": "Content-Type",
            "description": "MIME类型, application/json",
            "required": true,
            "type": "string",
            "x-example": "application/json"
          },
          {
            "in": "path",
            "name": "project_id",
            "description": "项目ID",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "in": "path",
            "name": "share_id",
            "description": "文件系统ID",
            "required": true,
            "type": "string",
            "x-example": "b959dfbb-xxxx-XXXX-xxxx-8930ec3a87b7"
          },
          {
            "in": "query",
            "name": "path",
            "description": "文件系统内合法的目录全路径",
            "required": true,
            "type": "string"
          }
