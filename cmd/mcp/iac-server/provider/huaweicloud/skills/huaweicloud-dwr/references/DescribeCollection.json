  "definitions": {
    "index_desc": {
      "type": "object",
      "required": [
        "index_name",
        "field_name",
        "index_params",
        "index_state"
      ],
      "properties": {
        "index_name": {
          "type": "string",
          "description": "**参数解释:**\n描述的索引名称。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "field_name": {
          "type": "string",
          "description": "**参数解释:**\n索引对应的字段名称。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "index_params": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "description": "**参数解释:**\n索引的参数信息。详情请查阅CreateIndex接口中 index_param结构中params字段的描述。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "index_state": {
          "type": "string",
          "description": "**参数解释:**\n索引状态。\n**约束限制:**\n不涉及。\n**取值范围:**\n-\"InProgress\":索引正在构建中或还未开始构建。\n-\"Finished\":索引构建完成。\n-\"Failed\":索引构建失败。\n**默认取值:**\n不涉及。"
        }
      }
    },
    "collection_base_info": {
      "type": "object",
      "required": [
        "store_name",
        "collection_name"
      ],
      "properties": {
        "store_name": {
          "type": "string",
          "description": "**参数解释:**\n知识仓实例名称,region内唯一。\n**约束限制:**\n长度范围为3到63个字符,支持小写字母、数字、中划线(-),第一个字符只能够是小写字母,中划线(-)不得出现在字符串末尾。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "collection_name": {
          "type": "string",
          "description": "**参数解释:**\ncollection名称。\n**约束限制:**\n可包含数字、字母和下划线 ( _ ) 。资源名称必须以字母或下划线  ( _ ) 开头。最大长度支持255。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        }
      }
    },
    "describe_collection_data": {
      "type": "object",
      "required": [
        "store_name",
        "collection_name",
        "fields"
      ],
      "properties": {
        "store_name": {
          "type": "string",
          "description": "**参数解释:**\n知识仓实例名称,region内唯一。\n**约束限制:**\n长度范围为3到63个字符,支持小写字母、数字、中划线(-),第一个字符只能够是小写字母,中划线(-)不得出现在字符串末尾。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "[a-zA-Z0-9_-]+"
        },
        "collection_name": {
          "type": "string",
          "description": "**参数解释:**\ncollection名称。\n**约束限制:**\n可包含数字、字母和下划线 (_)。资源名称必须以字母或下划线 (_) 开头。最大长度支持255。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "[a-zA-Z0-9_-]+"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field_data"
          },
          "description": "**参数解释:**\ncollection各个field信息。\n**约束限制:**\n不涉及。"
        },
        "load_state": {
          "description": "**参数解释:**\n标识当前Collection加载状态。\n**约束限制:**\n不涉及。\n**取值范围:**\n1、LoadStateLoaded:表示当前Collection已准备就绪,可正常使用。\n2、LoadStateLoading:表示当前Collection正在load。\n3、LoadStateNotLoad:表示collection未加载。\n**默认取值:**\n不涉及。",
          "enum": [
            "ready",
            "building",
            "none"
          ],
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "**参数解释:**\nCollection 的描述信息。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "pattern": "[a-zA-Z0-9_-]+",
          "minLength": 1,
          "maxLength": 512
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/index_desc"
          },
          "description": "**参数解释:**\n索引的配置信息。\n**约束限制:**\n不涉及。"
        },
        "entity_num": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释:**\ncollection中的entity数量。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "partitions_num": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释:**\ncollection中的partition数量。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "shards_num": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释:**\ncollection中的shard数量。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        }
      }
    },
    "field_data": {
      "type": "object",
      "description": "给一个collection设置的field字段",
      "required": [
        "field_name",
        "data_type",
        "primary_key",
        "partition_key"
      ],
      "properties": {
        "field_name": {
          "type": "string",
          "description": "**参数解释:**\n要在集合中创建的字段名称。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "pattern": "[a-zA-Z0-9_-]+",
          "minLength": 1,
          "maxLength": 255
        },
        "data_type": {
          "type": "string",
          "description": "**参数解释:**\n字段的数据类型。\n**约束限制:**\n不涉及。\n**取值范围:**\n“Bool”,“Int8”,“Int16”,“Int32”,“Int64”,“Float”,“String”,“Array”,“JSON”,\"FloatVector\", \"SparseFloatVector\"。\n**默认取值:**\n不涉及。",
          "enum": [
            "“Bool”",
            "“Int8”",
            "“Int16”",
            "“Int32”",
            "“Int64”",
            "“Float”",
            "“String”",
            "\"Array\"",
            "\"Map\""
          ]
        },
        "primary_key": {
          "type": "boolean",
          "description": "**参数解释:**\n是否是主键字段。\n**约束限制:**\n不涉及。\n**取值范围:**\ntrue:表示该列将被用作主键。\nfalse:表示该列不作为主键。\n**默认取值:**\n不涉及。"
        },
        "partition_key": {
          "type": "boolean",
          "description": "**参数解释:**\n是否是partition key。\n**约束限制:**\n不涉及。\n**取值范围:**\ntrue:表示该列将被用作分区键。\nfalse:表示该列不作为分区键。\n**默认取值:**\n不涉及。"
        },
        "dim": {
          "type": "string",
          "description": "**参数解释:**\n向量列的维度值。\n**约束限制:**\nfield的数据类型是FloatVector, SparseFloatVector时生效。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "max_length": {
          "type": "string",
          "description": "**参数解释:**\n字符串列设置的最大长度值。\n**约束限制:**\nfield的数据类型是String或者 Array 元素类型为String类型时生效。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "max_capacity": {
          "type": "string",
          "description": "**参数解释:**\n数组列设置的最大容量值。\n**约束限制:**\nfield的数据类型是 Array 类型时生效。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        }
      }
    },
    "describe_collection_respose": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "**参数解释:**\n返回码。参见错误码章节。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "message": {
          "type": "string",
          "description": "**参数解释:**\n描述信息。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "data": {
          "description": "**参数解释:**\n响应数据。\n**约束限制:**\n不涉及。",
          "$ref": "#/definitions/describe_collection_data"
        }
      }
    },
    "error_rsp": {
      "description": "失败时返回错误码",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "description": "**参数解释:**\n返回码。参见错误码章节。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "message": {
          "description": "**参数解释:**\n描述信息。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    }
  },
