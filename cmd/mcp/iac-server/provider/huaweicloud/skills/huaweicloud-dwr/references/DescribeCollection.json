{
  "name": "DescribeCollection",
  "summary": "查询collection",
  "tags": "集合接口",
  "productshort": "DWR",
  "region_id": "cn-north-9",
  "paths": {
    "/v1/collections/describe": {
      "post": {
        "x-support-sdk": "Y",
        "x-request-examples-text-1": {
          "store_name": "test-storename",
          "collection_name": "test-collection"
        },
        "x-request-examples-1": {
          "store_name": "test-storename",
          "collection_name": "test-collection"
        },
        "tags": [
          "集合接口"
        ],
        "summary": "查询collection",
        "description": "在知识仓实例下查询指定的collection的信息。",
        "operationId": "DescribeCollection",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "describe_collection_body",
            "in": "body",
            "required": true,
            "description": "指定store和collection名字",
            "schema": {
              "$ref": "#/definitions/collection_base_info"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "执行成功,返回指定store中指定collection信息",
            "schema": {
              "$ref": "#/definitions/describe_collection_respose"
            },
            "examples": {
              "application/json": {
                "code": "LMS.00000000",
                "data": {
                  "collection_name": "test-collection",
                  "description": "",
                  "entity_num": 0,
                  "fields": [
                    {
                      "data_type": "Int64",
                      "field_name": "pk",
                      "partition_key": false,
                      "primary_key": true
                    },
                    {
                      "data_type": "FloatVector",
                      "dim": "3",
                      "field_name": "vector",
                      "partition_key": false,
                      "primary_key": false
                    },
                    {
                      "data_type": "String",
                      "field_name": "scalar",
                      "max_length": "256",
                      "partition_key": false,
                      "primary_key": false
                    }
                  ],
                  "indexes": [
                    {
                      "field_name": "vector",
                      "index_name": "vector_index",
                      "index_params": {
                        "beamwidth": "4",
                        "encoding_type": "SQ",
                        "index_type": "HANNS",
                        "max_degree": "56",
                        "metric_type": "L2",
                        "search_list_size": "100"
                      },
                      "index_state": "Finished"
                    }
                  ],
                  "load_state": "LoadStateLoaded",
                  "partitions_num": 1,
                  "shards_num": 2,
                  "store_name": "test-storename"
                },
                "message": "describe collection success"
              }
            }
          },
          "400": {
            "description": "集合查询失败",
            "schema": {
              "$ref": "#/definitions/error_rsp"
            },
            "examples": {
              "application/json": {
                "code": "LMS.00003001",
                "message": "ErrCollectionNotFound: Collection not found"
              }
            }
          }
        },
