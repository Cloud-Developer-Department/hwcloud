        "x-request-examples-1": "GET /v3/{project_id}/actiontemplate/{template_name} HTTP/1.1 \nHost: dwr.cn-south-1.myhuaweicloud.com\nContent-Type: application/json \nContent-Length: length \nDate: date",
        "operationId": "ShowSystemTemplateDetail",
        "summary": "查询华为云内置算子模板信息",
