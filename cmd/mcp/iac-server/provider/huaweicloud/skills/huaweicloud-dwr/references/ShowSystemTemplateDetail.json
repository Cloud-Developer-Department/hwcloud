  "definitions": {
    "Input": {
      "description": "创建算子时用户可修改参数列表",
      "type": "object",
      "example": "[ \t{   \"parameter_name\": \"bucket\",  // 参数名 \t\t\"parameter_value\": \"\",      // 参数值,可不填。用于函数流在执行算子时根据参数类型自动传入 \t\t\"value_type\": \"\",          //  list类型的原子参数类型,只支持string,interger,float \t\t\"default\": \"\",             //  默认值。可在创建工作流实例时由外部输入替换 \t\t\"type\": \"string\",         //  可为string,integer,float,boolean,list,map。type为list类型时,value_type必填 \t\t\"label\": \"Body\",          //参数的标签。填写为body \t\t\"constraints\": {          //约束条件。具体类型可使用:valid_values,regex,invalid_values。参考refer链接里的填写方式 \t\t\t\"regex\": \".*\" \t\t}, \t\t\"invisible\": false,     //输入参数的invisible设置为true时,返回值为******。 \t\t\"description\": \"doc destination bucket name\"   // 参数描述 \t} ]",
      "required": [
        "parameter_name",
        "type"
      ],
      "properties": {
        "parameter_name": {
          "description": "输入参数名称,由小写字母、数字和中划线“-”组成",
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "type": {
          "description": "参数类型。可为string,integer,float,boolean,list,map。type为list类型时,value_type必填",
          "type": "string",
          "enum": [
            "string",
            "integer",
            "float",
            "boolean",
            "list",
            "map"
          ]
        },
        "value_type": {
          "description": "当列表或map作为输入项时,其中的元素类型。只支持原子类型。",
          "$ref": "#/definitions/InputParaValueType"
        },
        "template_parameter_name": {
          "type": "string",
          "description": "当多个相同action template在一个工作流时,增加字段做国际化。\n由小写字母、数字和中划线“-”组成",
          "minLength": 1,
          "maxLength": 20
        },
        "parameter_value": {
          "description": "参数值。",
          "$ref": "#/definitions/InputParaType"
        },
        "description": {
          "type": "string",
          "description": "参数项描述信息。",
          "minLength": 0,
          "maxLength": 2048
        },
        "default": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "默认值信息可在创建工作流实例时由外部输入替换;若未填写默认值,外部输入将必须填写这个参数的值。\n注:默认值的类型和定义的参数类型必须统一。如果出现不一致,解析器可能会进行自动转换而导致出现与预期不符合的情况。"
        },
        "label": {
          "type": "string",
          "description": "参数的标签,此处定义的标签可在创建堆栈时进行分类展示。",
          "minLength": 0,
          "maxLength": 64
        },
        "constraints": {
          "type": "object",
          "description": "约束条件有以下几种,一个输入参数对每一种条件都只能定义一个规则。约束的多个条件中只要有一条不满足,即将认定参数非法。\nequal:约定参数的value值必须等于特定值。\nvalid_values:参数的有效值,定义一个数组。\nregex:参数需要满足某个正则条件,必须是字符串类型才可以进行匹配。\ninvalid_values:参数的无效值范围,如果参数值定义在其中,将会认为无效而报错。"
        },
        "invisible": {
          "type": "boolean",
          "description": "输入参数的invisible设置为true时,返回值为******。"
        }
      }
    },
    "ProvidedAction": {
      "properties": {
        "template_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "算子模板名称。"
        },
        "category": {
          "type": "string",
          "description": "分类。默认分类为FileProcess,MediaProcess,ImageProcess,ContentReview,NotificationProcess,VoiceInteraction",
          "enum": [
            "FileProcess",
            "MediaProcess",
            "ImageProcess",
            "ContentReview",
            "NotificationProcess",
            "VoiceInteraction"
          ]
        },
        "create_time": {
          "type": "string",
          "description": "创建时间。",
          "minLength": 1,
          "maxLength": 64
        },
        "last_modify_time": {
          "type": "string",
          "description": "最近修改时间。",
          "minLength": 1,
          "maxLength": 64
        },
        "inputs": {
          "items": {
            "$ref": "#/definitions/Input"
          },
          "description": "可修改参数定义列表。",
          "type": "array"
        },
        "dynamic_source_definition": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "description": "可修改参数引用"
        },
        "need_policy": {
          "items": {
            "$ref": "#/definitions/Policy"
          },
          "description": "需要的权限。",
          "type": "array"
        },
        "provider_name": {
          "type": "string",
          "description": "算子提供方名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "is_uploaded_func_pkg": {
          "type": "boolean",
          "description": "是否上传了算子包"
        },
        "func_pkg_endpoint": {
          "type": "string",
          "description": "上传算子包的临时签名URL地址,用于上传算子包。",
          "minLength": 0,
          "maxLength": 512
        },
        "upload_func_pkg_size": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 104857600,
          "description": "上传算子包的大小。小于100M"
        },
        "upload_func_pkg_etag": {
          "type": "string",
          "description": "上传算子包的etag。"
        },
        "register_status": {
          "$ref": "#/definitions/PublicTemplateRegisterType"
        },
        "description": {
          "type": "string",
          "description": "描述。",
          "minLength": 0,
          "maxLength": 512
        },
        "function_template": {
          "type": "string",
          "description": "函数URN"
        },
        "provider_domainid": {
          "type": "string",
          "description": "算子提供方IAM DomainID"
        },
        "provider_userid": {
          "type": "string",
          "description": "算子提供方IAM UserID"
        }
      },
      "required": [
        "template_name",
        "category",
        "create_time",
        "dynamic_source_definition",
        "need_policy",
        "provider_name",
        "is_uploaded_func_pkg",
        "func_pkg_endpoint",
        "register_status",
        "function_template",
        "provider_domainid"
      ],
      "type": "object"
    },
    "InputParaValueType": {
      "type": "string",
      "description": "只支持string,integer,float",
      "enum": [
        "string",
        "integer",
        "float"
      ]
    },
    "InputParaType": {
      "description": "Input结构体参数类型。支持string,integer,float,boolean,list,map",
      "properties": {},
      "type": "string"
    },
    "ProvidedActions": {
      "type": "object",
      "properties": {
        "provided_actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProvidedAction"
          }
        }
      }
    },
    "Policy": {
      "properties": {
        "version": {
          "type": "string",
          "description": "权限版本号。\n\n1.0:系统预置的角色。以服务为粒度,提供有限的服务相关角色用于授权。\n\n1.1:策略。IAM最新提供的一种细粒度授权的能力,可以精确到具体服务的操作、资源以及请求条件等。"
        },
        "statement": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1,
          "description": "授权语句,描述自定义策略的具体内容。",
          "items": {
            "$ref": "#/definitions/Statement"
          }
        }
      },
      "type": "object"
    },
    "Statement": {
      "properties": {
        "action": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "description": "授权项。指对资源的具体操作权限,不超过100个。\n- 格式为:服务名:资源类型:操作,例:vpc:ports:create。\n- 服务名为产品名称,例如ecs、evs和vpc等,服务名仅支持小写。 资源类型和操作没有大小写,要求支持通配符号*,无需罗列全部授权项。\n- 当自定义策略为委托自定义策略时,该字段值为: \"Action\": [\"iam:agencies:assume\"]。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          }
        },
        "resource": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "description": "资源。数组长度不超过10,每个字符串长度不超过128,规则如下:\n- 可填 * 的五段式:::::,例:\"obs:::bucket:*\"。\n- region字段为*或用户可访问的region。service必须存在且resource属于对应service。\n- 当该自定义策略为委托自定义策略时,该字段类型为Object,值为:\"Resource\": {\"uri\": [\"/iam/agencies/07805acaba800fdd4fbdc00b8f888c7c\"]}。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          }
        }
      }
    },
    "BasicError": {
      "type": "object",
      "description": "错误信息",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误详细描述",
          "minLength": 1,
          "maxLength": 64
        },
        "error_code": {
          "type": "integer",
          "description": "简单错误码",
          "minimum": 100,
          "maximum": 599
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识ID",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "PublicTemplateRegisterType": {
      "properties": {},
      "type": "string",
      "description": "init_created新建,submit_approve等待审核,deprecate_approve申请禁用",
      "enum": [
        "init_created,submit_approve,deprecate_approve"
      ]
    }
  },
