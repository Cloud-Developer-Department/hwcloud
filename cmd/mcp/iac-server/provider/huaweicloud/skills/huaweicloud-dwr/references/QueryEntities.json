        "tags": [
          "向量entity接口"
        ],
        "summary": "标量查询",
        "description": "接口用于精确查找与查询条件完全匹配的向量,此操作使用指定的布尔表达式对标量字段进行筛选。",
        "operationId": "QueryEntities",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "query_entites_body",
            "in": "body",
            "required": true,
            "description": "数据查询信息",
            "schema": {
              "$ref": "#/definitions/query_entities_body"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "搜索成功",
            "schema": {
              "$ref": "#/definitions/query_entities_respose"
            },
            "examples": {
              "application/json": {
                "code": "LMS.00000000",
                "data": {
                  "entities": [
                    {
                      "pk": 1,
                      "scalar": "文档1",
                      "vector": [
                        0.324,
                        0.21,
                        0.2456
                      ]
                    },
                    {
                      "pk": 2,
                      "scalar": "文档4",
                      "vector": [
                        0.333,
                        0.222,
                        0.1116
                      ]
                    }
                  ]
                },
                "message": "query entities success"
              }
            }
          },
          "400": {
            "description": "搜索失败",
            "schema": {
              "$ref": "#/definitions/error_rsp"
            },
            "examples": {
              "application/json": {
                "code": "LMS.00004002",
                "message": "ErrInvalidSearchResult:Fail to parse search result"
              }
            }
          }
        },
        "x-order": 4
      }
    }
