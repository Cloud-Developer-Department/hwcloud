        "operationId": "CreateWorkflow",
        "summary": "创建工作流",
        "description": "本接口用于通过Body体直接创建工作流",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "description": "项目ID。",
            "in": "path",
            "required": true,
            "minLength": 1,
            "maxLength": 32,
            "type": "string"
          },
          {
            "name": "graph_name",
            "in": "path",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "工作流名称。名称必须以字母或数字开头,只能由字母、数字、下划线和中划线组成,长度小于等于64个字符,且不能重名"
          },
          {
            "in": "body",
            "name": "CreateWorkflowRequestBody",
            "description": "工作流创建请求Body体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateWorkflowRequestBody"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 16777216,
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(相应消息头中X-Subject-Token的值)。\n条件:匿名请求不需要带,其他请求必选。"
          }
        ],
        "responses": {
          "200": {
            "description": "工作流创建结果信息",
            "examples": {
