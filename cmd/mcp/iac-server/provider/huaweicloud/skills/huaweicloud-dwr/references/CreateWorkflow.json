          "type": "array"
        },
        "inputs": {
          "items": {
            "$ref": "#/definitions/Input"
          },
          "description": "工作流中用户可修改的参数项",
          "type": "array"
        },
        "description": {
          "type": "string",
          "description": "工作流的描述",
