    "State": {
      "type": "object",
      "description": "工作流中定义的每一个节点。",
      "required": [
        "type",
        "state_name"
      ],
      "properties": {
        "start": {
          "type": "boolean",
          "description": "标识开始的state,图中必须且只有一个start为true的state。",
          "readOnly": true,
          "example": ""
        },
        "type": {
          "type": "string",
          "description": "必须有TYPE,TYPE值必须是3种State(DELAY,OPERATION,END)中一种。",
          "enum": [
            "DELAY",
            "OPERATION",
            "END"
          ]
        },
        "payload_filter_in": {
          "type": "string",
          "description": "过滤输入参数,默认值是\"$\",表示不过滤。必须是合法的JSONPath格式。\n说明\nEND State没有payload_filter_in属性。",
          "minLength": 0,
          "maxLength": 512
        },
        "payload_filter_out": {
          "type": "string",
          "description": "过滤state的输出结果,默认值是\"$\",表示不过滤。\n必须是合法的JSONPath格式。\n说明\nEND State没有payload_filter_out属性。",
          "minLength": 0,
          "maxLength": 512
        },
        "state_name": {
          "type": "string",
          "description": "state的名字定义。\n由小写字母、数字和中划线“-”组成,长度为[1, 20]。",
          "pattern": "^[a-zA-Z0-9_-]{1,20}$"
        },
        "action_mode": {
          "type": "string",
          "description": "Action执行模式,支持串行,并行两种模式,默认串行\n\n最小长度:1\n\n最大长度:32\n\n枚举值:\n\nsequential\n\nparallel"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Action"
          },
          "description": "节点中要执行的操作列表"
        },
        "next_state": {
          "type": "string",
          "description": "创建工作流指定的下一个节点名称"
        },
        "time_delay": {
          "type": "integer",
          "format": "int32",
          "description": "当节点类型为事件延迟时填入需要延迟的时间,单位为秒"
        }
      }
    },
    "BasicError": {
      "type": "object",
      "description": "错误信息",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误详细描述",
