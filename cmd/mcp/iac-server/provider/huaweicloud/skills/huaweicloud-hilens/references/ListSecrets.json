{
  "name": "ListSecrets",
  "summary": "查询密钥列表",
  "tags": "密钥管理",
  "productshort": "HiLens",
  "region_id": "cn-north-4",
  "paths": {
    "/v3/{project_id}/ai-mgr/secrets": {
      "get": {
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "GET  https://{endpoint}/v3/{project_id}/ai-mgr/secrets",
        "x-request-examples-description-1": "获取密钥详情列表",
        "x-request-examples-text-1": "Request Header:\nContent-Type: application/json\nX-Auth-Token: MIINRwYJKoZIhvcNAQcCoIINODCCDTQCAQExDTALBglghkgBZQMEAgEwgguVBgkqhkiG...",
        "x-request-examples-1": "Request Header:\nContent-Type: application/json\nX-Auth-Token: MIINRwYJKoZIhvcNAQcCoIINODCCDTQCAQExDTALBglghkgBZQMEAgEwgguVBgkqhkiG...",
        "tags": [
          "密钥管理"
        ],
        "summary": "查询密钥列表",
        "description": "专业版HiLens控制台密钥管理,根据用户请求条件筛选,查询用户创建的 密钥信息,以列表形式返回。",
        "operationId": "ListSecrets",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户Token。获取方法请参见[获取Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。获取方法请参见[获取项目ID](hilens_07_0020.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询的起始位置,取值范围为非负整数,默认为0",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量,取值范围1~100,默认为100",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "name",
            "in": "query",
            "description": "设备名称,模糊匹配,只允许中文字符、英文字母、数字、下划线、中划线,最大长度64",
            "required": false,
            "type": "string"
          },
          {
            "name": "workspace_id",
            "in": "query",
            "description": "工作空间ID,默认为注册账号子账号的default工作空间,可通过专业版HiLens控制台展开工作空间列表获取到工作空间ID",
            "required": false,
            "type": "string"
          },
          {
            "name": "tags",
            "in": "query",
            "description": "标签的key和value通过点连接,多个标签通过逗号连接,如:tags=key1.value1,key2.value2",
            "required": false,
            "type": "string"
          },
          {
            "name": "provider",
            "in": "query",
            "description": "服务提供者:ief或hilens。不传会查询全部服务类型的设备列表",
            "required": false,
            "type": "string"
          },
          {
            "name": "sort",
            "in": "query",
            "description": "排序方式,可根据名称、创建时间、更新时间排序枚举值:name,created_at,updated_at。sort默认升序,如sort=name,降序:sort=name%3Adesc。不填默认为sort=created_at%3Adesc。",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "schema": {
              "$ref": "#/definitions/GetSecretListResponse"
            },
            "examples": {
              "application/json": {
                "count": "string",
                "data": [
                  {
                    "id": "string",
                    "name": "string",
                    "description": "string",
                    "workspace_id": "string",
                    "project_id": "string",
                    "created_at": "string",
                    "updated_at": "string",
                    "secrets": [
                      {
                        "key": "string",
                        "value": "string"
                      }
                    ],
                    "tags": [
                      {
                        "key": "string",
                        "value": "string"
                      }
                    ]
                  }
                ]
              }
            }
          },
          "401": {
            "description": "认证不通过"
          },
          "403": {
            "description": "拒绝执行请求"
          },
          "404": {
            "description": "请求的资源不存在"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    }
  },
  "definitions": {
    "SecretDetail": {
      "description": "查询密钥详情响应",
      "properties": {
        "id": {
          "type": "string",
          "description": "密钥ID"
        },
        "name": {
          "type": "string",
          "description": "密钥名称"
        },
        "description": {
          "type": "string",
          "description": "密钥描述"
        },
        "workspace_id": {
          "type": "string",
          "description": "工作空间ID"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID"
        },
        "created_at": {
          "type": "string",
          "description": "密钥创建时间"
        },
        "updated_at": {
          "type": "string",
          "description": "密钥更新时间"
        },
        "secrets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Secret"
          },
          "description": "密钥列表"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Tag"
          },
          "description": "标签列表"
        }
      }
    },
    "Tag": {
      "description": "标签",
      "properties": {
        "key": {
          "type": "string",
          "description": "标签key,最大长度36个字符。不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”"
        },
        "value": {
          "type": "string",
          "description": "标签value,每个值最大长度43个字符,删除时如果value有值按照key/value删除,如果value没值,则按照key删除。不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”"
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    "Secret": {
      "description": "密钥信息",
      "properties": {
        "key": {
          "type": "string",
          "description": "密钥key,最大长度63个字符。不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”"
        },
        "value": {
          "type": "string",
          "description": "密钥value,每个值最大长度10000个字符,删除时如果value有值按照key/value删除,如果value没值,则按照key删除。不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”"
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    "GetSecretListResponse": {
      "description": "查询密钥列表响应",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "数量"
        },
        "secrets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SecretDetail"
          },
          "description": "缪瑶详情列表"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hilens.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
