{
  "name": "UpdateNode",
  "summary": "更新设备信息",
  "tags": "设备管理",
  "productshort": "HiLens",
  "region_id": "cn-north-4",
  "paths": {
    "/v3/{project_id}/ai-mgr/nodes/{node_id}": {
      "put": {
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/{project_id}/ai-mgr/nodes/{node_id}",
        "x-request-examples-description-1": "更新设备的描述和标签",
        "x-request-examples-text-1": "Request Header:\nContent-Type: application/json\nX-Auth-Token: MIINRwYJKoZIhvcNAQcCoIINODCCDTQCAQExDTALBglghkgBZQMEAgEwgguVBgkqhkiG...\nRequest Body:\n{\n  \"node\": {\n    \"enable_gpu\": false,\n    \"enable_npu\": false,\n    \"npu_type\": \"null\",\n    \"description\": \"HiLens节点\",\n    \"tags\": [\n      {\n        \"key\": \"lI\",\n        \"value\": \"ss\"\n      }\n    ]\n  }\n}",
        "x-request-examples-1": "Request Header:\nContent-Type: application/json\nX-Auth-Token: MIINRwYJKoZIhvcNAQcCoIINODCCDTQCAQExDTALBglghkgBZQMEAgEwgguVBgkqhkiG...\nRequest Body:\n{\n  \"node\": {\n    \"enable_gpu\": false,\n    \"enable_npu\": false,\n    \"npu_type\": \"null\",\n    \"description\": \"HiLens节点\",\n    \"tags\": [\n      {\n        \"key\": \"lI\",\n        \"value\": \"ss\"\n      }\n    ]\n  }\n}",
        "tags": [
          "设备管理"
        ],
        "summary": "更新设备信息",
        "description": "更新设备日志配置,标签以及描述。",
        "operationId": "UpdateNode",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户Token。获取方法请参见[获取Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "updateNodeRequest",
            "description": "更新设备信息请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateNodeRequestBody"
            }
          },
          {
            "name": "node_id",
            "in": "path",
            "description": "设备ID,从专业版HiLens控制台设备管理[查询设备列表](ListNodeUsingGeT.xml)获取",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。获取方法请参见[获取项目ID](hilens_07_0020.xml)",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功"
          },
          "201": {
            "description": "创建成功"
          },
          "401": {
            "description": "认证不通过"
          },
          "403": {
            "description": "拒绝执行请求"
          },
          "404": {
            "description": "请求的资源不存在"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    }
  },
  "definitions": {
    "UpdateNodeReqDetail": {
      "properties": {
        "description": {
          "description": "设备描述,最大长度255,不允许^, ~, #, $, %, &, *, <, >, (, ), [, ], {, }, ', \", \\",
          "type": "string"
        },
        "log_configs": {
          "description": "设备日志配置",
          "type": "array",
          "items": {
            "$ref": "#/definitions/LogConfig"
          }
        },
        "tags": {
          "description": "设备标签,标签个数最多为20个",
          "type": "array",
          "items": {
            "$ref": "#/definitions/TagObject"
          }
        },
        "event_validity_period": {
          "type": "integer",
          "format": "int32",
          "description": "事件有效时间(单位:分钟)"
        },
        "enable_gpu": {
          "type": "boolean",
          "description": "是否开启gpu"
        },
        "enable_npu": {
          "type": "boolean",
          "description": "是否开启npu"
        },
        "npu_type": {
          "description": "npu类型,如果选择开启npu, 可设置类型Ascend 310/ Ascend 710, 如果选择开启gpu,请设置值为null。",
          "type": "string"
        }
      }
    },
    "LogConfig": {
      "properties": {
        "component": {
          "description": "app:应用日志。 system:系统的日志",
          "type": "string"
        },
        "level": {
          "description": "系统级日志可配置为/error/warning/info/debug ; 不传会默认为info。",
          "type": "string"
        },
        "rotate_num": {
          "description": "日志rotate个数,默认5,hilens取值范围1-30,ief取值范围1-10",
          "type": "integer",
          "format": "int32"
        },
        "rotate_period": {
          "description": "日志rotate周期,可选项,只支持ief:daily monthly weekly yearly.",
          "type": "string"
        },
        "size": {
          "description": "应用日志文件大小限制,单位MB,默认50,取值范围10-1000。",
          "type": "integer",
          "format": "int32"
        },
        "type": {
          "description": "- LTS 将日志发送到云日志服务(Log Tank Service,简称LTS)\n- local 本地日志",
          "type": "string"
        }
      },
      "title": "LogConfig",
      "description": "日志配置列表",
      "required": [
        "component",
        "type"
      ]
    },
    "UpdateNodeRequestBody": {
      "properties": {
        "node": {
          "$ref": "#/definitions/UpdateNodeReqDetail",
          "description": "更新设备信息请求体"
        }
      },
      "title": "updateNodeReqDetail",
      "required": [
        "node"
      ]
    },
    "TagObject": {
      "properties": {
        "key": {
          "description": "标签键,最大长度36个字符。不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”",
          "type": "string"
        },
        "value": {
          "description": "标签值,每个值最大长度43个字符,删除时如果value有值按照key/value删除,如果value没值,则按照key删除。不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”",
          "type": "string"
        }
      },
      "title": "Tag"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hilens.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "put",
  "uri": null
