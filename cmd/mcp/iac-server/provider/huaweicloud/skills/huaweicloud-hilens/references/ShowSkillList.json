        "x-request-examples-description-1": "获取技能列表",
        "x-request-examples-text-1": "Request Header:\nContent-Type: application/json\nX-Auth-Token: MIINRwYJKoZIhvcNAQcCoIINODCCDTQCAQExDTALBglghkgBZQMEAgEwgguVBgkqhkiG...",
        "x-request-examples-1": "Request Header:\nContent-Type: application/json\nX-Auth-Token: MIINRwYJKoZIhvcNAQcCoIINODCCDTQCAQExDTALBglghkgBZQMEAgEwgguVBgkqhkiG...",
        "tags": [
          "技能市场"
        ],
        "operationId": "ShowSkillList",
        "summary": "查询技能列表",
        "description": "获取技能列表。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。获取方法请参见[获取Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)",
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页显示的条目数量, 最大 100,默认值 10",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "查询的起始位置, 默认值 0",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "skill_name",
            "in": "query",
            "required": false,
            "description": "技能名称,支持模糊匹配。中英文、数字、下划线、中划线 长度[1-60]",
            "type": "string"
          },
          {
            "name": "skill_form",
            "in": "query",
            "required": false,
            "description": "技能形式,no_termplate不支持Modelbox部署模板,support_template支持Modelbox模板。",
            "type": "string"
          },
          {
            "name": "permission",
            "in": "query",
            "required": false,
            "description": "技能可见权限,支持公开可见public以及白名单whitelist",
            "type": "string"
          },
          {
            "name": "template_source",
            "in": "query",
            "required": false,
            "description": "技能来源,分别hilens,ma_pro,studio",
            "type": "string"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "技能审核状态状态,1表示审核通过,2表示审核不通过,0表示待审核",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "charge_model",
            "in": "query",
            "required": false,
            "description": "收费模式,0表示永久免费,1表示收费,2表示30天试用,3表示365天试用,4表示收费(永久使用)",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "platform",
            "in": "query",
            "required": false,
            "description": "技能操作系统平台,其值为:Linux,Android, iOS, LiteOS,Windows",
            "type": "string"
          },
          {
            "name": "chip",
            "in": "query",
            "required": false,
            "description": "技能芯片类型,其值为Ascend 310,Ascend 310(Atlas 200 DK),Arm,x86,3516CV500,3519AV100,3519V101,3516DV300,3516EV200,3516EV300,3518EV300",
            "type": "string"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "技能类型,lite表示使用于海思芯片的轻量型技能。standard表示标准技能。",
            "type": "string"
          },
          {
            "name": "charge_models",
            "in": "query",
            "required": false,
            "description": "收费模式多选,0表示永久免费,1表示收费,2表示30天试用,3表示365天试用,4表示收费(永久使用),分隔符为|,例如输入为1|2|3",
            "type": "string"
          },
          {
            "name": "device_types",
            "in": "query",
            "required": false,
            "description": "设备类型校验,允许输入多个设备类型,用|分隔,例如设备a|设备b。每种设备类型不允许#~^$%&*<>{}[]'|字符,长度1到100。最多50个设备类型",
            "type": "string"
          },
          {
            "name": "scenes",
            "in": "query",
            "required": false,
            "description": "技能适用场景,支持多选,分隔符|,例如场景a|场景b,每种场景不允许输入#~^$%&*<>{}\\\\[\\\\]'\\\\|等字符,长度100以内,最多20个设备类型。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "技能列表",
            "schema": {
              "$ref": "#/definitions/SkillInfoList"
