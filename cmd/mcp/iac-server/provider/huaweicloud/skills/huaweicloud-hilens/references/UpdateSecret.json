  "definitions": {
    "SecretRequestBody": {
      "description": "创建密钥或者更新密钥的请求体",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "工作空间ID。默认为default。"
        },
        "secret": {
          "description": "密钥信息",
          "$ref": "#/definitions/SecretObjectInSecretRequestBody"
        }
      },
      "required": [
        "secret"
      ]
    },
    "Tag": {
      "description": "标签",
      "properties": {
        "key": {
          "type": "string",
          "description": "标签key,最大长度36个字符。不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”"
        },
        "value": {
          "type": "string",
          "description": "标签value,每个值最大长度43个字符,删除时如果value有值按照key/value删除,如果value没值,则按照key删除。不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”"
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    "CreateUpdateSecretResp": {
      "description": "创建/更新密钥响应",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "工作空间ID"
        },
        "secret": {
          "type": "object",
          "description": "密钥",
          "properties": {
            "id": {
              "type": "string",
              "description": "密钥ID"
            },
            "name": {
              "type": "string",
              "description": "密钥名称"
            },
            "description": {
              "type": "string",
              "description": "密钥描述"
            },
            "project_id": {
              "type": "string",
              "description": "项目ID"
            },
            "created_at": {
              "type": "string",
              "description": "密钥创建时间"
            },
            "updated_at": {
              "type": "string",
              "description": "密钥更新时间"
            },
            "secrets": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Secret"
              },
              "description": "密钥列表"
            },
            "tags": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Tag"
              },
              "description": "标签列表"
            }
          }
        }
      }
    },
    "Secret": {
      "description": "密钥信息",
      "properties": {
        "key": {
          "type": "string",
          "description": "密钥key,最大长度63个字符。不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”"
        },
        "value": {
          "type": "string",
          "description": "密钥value,每个值最大长度10000个字符,删除时如果value有值按照key/value删除,如果value没值,则按照key删除。不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”"
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    "SecretObjectInSecretRequestBody": {
      "description": "创建密钥或者更更新密钥请求体中的secret对象",
      "required": [
        "name",
        "secrets",
        "tags"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "密钥名称,以小写英文字母开头,4-64位,可以使用小写英文、数字、中划线(-),不能以中划线结尾。"
        },
        "description": {
          "type": "string",
          "description": "密钥描述,最大长度255,不允许^ ~ # $ % & * < > ( ) [ ] { } ' \" \\。"
        },
        "secrets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Secret"
          },
          "description": "secrets是一个列表,由多个字典组成,数量上限为100个。字典的key和value均为字符串。key由大小写字母,中划线(`-`)开头,由数字、大小写字母、点号(`.`)、中划线(`-`)、下划线(`_`)组成,最小长度为1,最大长度63个字符, value不能含有字符不允许^ ~ # $ \\|% & < > ( ) [ ] { } ' \" \\,最大长度10000个字符。"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Tag"
          },
          "description": "tags是一个列表,由多个字典组成,数量上限为20个。字典的key和value均为字符串。key由数字、大小写字母、点号(`.`)、中划线(`-`)、下划线(`_`)组成,最小长度为1,最大长度36个字符, value由数字、大小写字母、点号(`.`)、中划线(`-`)、下划线(`_`), 斜线(`\\`)组成,最小长度为0,最大长度43个字符。"
        }
      }
    }
  },
