          "type": "string",
          "description": "必须要以/开头,构造结果为:协议类型://主机地址:端口路径"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "description": "探测的http端口,1到65535之间的整数"
        },
        "scheme": {
          "type": "string",
          "description": "协议类型,HTTP或HTTPS,默认HTTP"
        }
      },
      "title": "HttpGet",
      "required": [
        "path",
        "port"
      ]
    },
    "PodAffinity": {
      "properties": {
        "node_affinity": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MatchExpression"
          },
