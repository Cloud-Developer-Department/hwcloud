        "value_from": {
          "$ref": "#/definitions/ValueFrom",
          "description": "环境变量可使用配置项和密钥导入。value、value_from和field_path必须三选一使用"
        },
        "field_path": {
          "type": "string",
          "description": "该参数目前只支持赋值\"status.hostIP\",即引用边缘节点的IP地址作为环境变量。value、value_from和field_path必须三选一使用"
        }
      },
      "title": "Env",
      "required": [
        "name"
      ]
    },
    "Volume": {
      "properties": {
        "destination": {
          "type": "string",
          "description": "卷挂载路径,必须是合法的路径"
