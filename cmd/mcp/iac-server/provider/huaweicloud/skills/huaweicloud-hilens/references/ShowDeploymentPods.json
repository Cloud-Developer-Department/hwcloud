        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HostContainerPortMapping"
          },
          "description": "容器端口映射值"
        },
        "privileged": {
          "type": "boolean",
          "description": "是否启用特权容器,默认值false"
        },
        "readiness_probe": {
          "$ref": "#/definitions/Probe",
          "description": "探针配置"
        },
        "resources": {
          "$ref": "#/definitions/ResQuest",
          "description": "创建应用时使用的资源"
        },
        "version": {
          "type": "string",
          "description": "版本号,长度不操作128,支持大小写数字,下划线,点,中划线"
