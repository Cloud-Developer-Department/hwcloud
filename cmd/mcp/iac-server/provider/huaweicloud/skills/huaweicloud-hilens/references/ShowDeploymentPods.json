          "type": "integer",
          "format": "int64",
          "description": "容器端口,1到65535之间的整数"
        },
        "host_ip": {
          "type": "string",
          "description": "对应主机网卡地址,形如192.168.0.1"
        },
        "host_port": {
          "type": "integer",
          "format": "int64",
          "description": "主机端口,1到65535之间的整数,与主机端口范围二选一"
        },
        "host_port_range": {
          "$ref": "#/definitions/HostPortRange",
