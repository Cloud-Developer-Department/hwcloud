        },
        "pod_affinity": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MatchExpression"
          },
          "description": "Pod亲和规则"
        }
      },
      "title": "PodAffinity"
    },
    "MatchExpression": {
      "properties": {
        "key": {
          "type": "string",
          "description": "规则的标签"
        },
        "operator": {
          "type": "string",
          "description": "操作符,取值如下:\nIn:标签值需要在values的列表中\nNotIn:标签的值不在某个列表中\nExists:某个标签存在\nDoesNotExist:某个标签不存在\nGt:标签的值大于某个值(字符串比较)\n Lt:标签的值小于某个值(字符串比较)"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "一组标签值。 如果运算符为In或NotIn,则值数组必须非空。 如果运算符为Exists 或DoesNotExist,则值数组必须为空。 如果运算符是Gt或Lt,则值数组必须具有单个元素,该元素将被解释为整数"
        }
      },
      "title": "MatchExpression"
    },
    "Exec": {
      "properties": {
        "command": {
          "type": "string",
          "description": "探针执行命令,最大长度10240个字符。不允许^#~^$|%&*<>()'\"[]{}这些特殊字符"
        }
      },
      "title": "Exec",
      "required": [
        "command"
      ]
    },
    "Probe": {
      "properties": {
        "exec": {
          "$ref": "#/definitions/Exec",
          "description": "执行命令检查,与http_get二选一"
        },
        "http_get": {
          "$ref": "#/definitions/HttpGet",
          "description": "执行http探测"
        },
        "initial_delay_seconds": {
          "type": "integer",
          "format": "int64",
          "description": "表示从工作负载启动后从多久开始探测,大于0且不大于3600的整数,默认为10"
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "int64",
          "description": "表示探测超时时间,大于0且不大于3600的整数,默认为1"
        }
      },
      "title": "Probe"
    },
    "ResQuest": {
      "properties": {
        "limits": {
