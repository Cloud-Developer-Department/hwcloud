        },
        "channel_resources": {
          "description": "每增加一路所需要资源",
          "$ref": "#/definitions/ResQuest"
        },
        "skill_project_id": {
          "type": "string",
          "description": "技能管理ID,技能来源source是skill的时候,需要传入该ID"
        }
      },
      "title": "AppDef",
      "required": [
