  "definitions": {
    "NodeDetailResponse": {
      "description": "获取设备详情响应",
      "properties": {
        "id": {
          "description": "设备ID",
          "type": "string"
        },
        "arch": {
          "type": "string",
          "description": "设备架构"
        },
        "memory": {
          "type": "integer",
          "format": "int64",
          "description": "设备内存"
        },
        "name": {
          "description": "设备名称,只允许中文字符、英文字母、数字、下划线、中划线,最大长度64",
          "type": "string"
        },
        "description": {
          "description": "设备描述,最大长度255,不允许^, ~, #, $, %, &, *, <, >, (, ), [, ], {, }, ', \", \\",
          "type": "string"
        },
        "created_at": {
          "description": "产生时间,如2021-10-15 14:45:22 GMT+08:00",
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "description": "更新时间,如2021-10-15 14:45:22 GMT+08:00"
        },
        "user_name": {
          "type": "string",
          "description": "IAM用户名"
        },
        "cluster_id": {
          "description": "当该设备处于集群时,显示设备所属的集群ID",
          "type": "string"
        },
        "cluster_node_state": {
          "description": "设备所处集群状态,集群创建(cluster_create)、集群删除(cluster_delete)、添加集群工作节点设备(cluster_add_nodes)、删除集群工作节点设备(cluster_delete_node)、集群节点设备状态更新(cluster_node_state_update)",
          "type": "string"
        },
        "cluster_node_type": {
          "description": "当该设备处于集群时,显示所属的集群设备类型。\n- cluster_controller 控制设备\n- cluster_worker 工作设备",
          "type": "string"
        },
        "firmware_name": {
          "description": "固件名称。可包含大小写字母、数字、下划线、中划线,长度不超过60字符。必须以字母开头,字母或数字结尾",
          "type": "string"
        },
        "firmware_version": {
          "description": "固件版本。支持X.Y.Z格式。每一个子版本号不超过三位且为非负整数,禁止在数字前补0",
          "type": "string"
        },
        "upgrade_firmware_version": {
          "description": "固件正在升级的版本",
          "type": "string"
        },
        "firmware_status": {
          "description": "固件升级状态,1、2、3分别代表升级中,升级失败,升级成",
          "type": "string"
        },
        "firmware_upgrade_record": {
          "description": "该设备上升级过的固件记录",
          "$ref": "#/definitions/FirmwareUpdateRecordList"
        },
        "state": {
          "description": "设备状态:UNCONNECTED(未注册)、RUNNING(运行中)、FAIL(故障)、STOPPED(停用)、UPGRADING(升级中)、FREEZE(冻结)",
          "type": "string"
        },
        "type": {
          "description": "设备类型",
          "type": "string"
        },
        "active_status": {
          "description": "设备激活状态,未激活(INACTIVE)和已激活(ACTIVATED)",
          "type": "string"
        },
        "cpu": {
          "description": "设备CPU个数",
          "type": "integer",
          "format": "int32"
        },
        "gpu_num": {
          "description": "设备GPU个数",
          "type": "integer",
          "format": "int32"
        },
        "npu_num": {
          "description": "设备NPU个数",
          "type": "integer",
          "format": "int32"
        },
        "npu_type": {
          "type": "string",
          "description": "设备NPU类型"
        },
        "os_name": {
          "type": "string",
          "description": "设备操作系统名称"
        },
        "os_type": {
          "type": "string",
          "description": "设备操作系统类型"
        },
        "os_version": {
          "type": "string",
          "description": "设备操作系统版本"
        },
        "enable_container": {
          "type": "boolean",
          "description": "是否启用容器"
        },
        "enable_gpu": {
          "type": "boolean",
          "description": "是否启用GPU"
        },
        "enable_npu": {
          "type": "boolean",
          "description": "是否启用NPU"
        },
        "host_ips": {
          "description": "主机IP列表",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "description": "设备标签对列表",
          "properties": {
            "key": {
              "description": "标签键,最大长度36个字符。不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”",
              "type": "string"
            },
            "value": {
              "description": "标签值,每个值最大长度43个字符,删除时如果value有值按照key/value删除,如果value没值,则按照key删除。不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”",
              "type": "string"
            }
          }
        },
        "npu_info": {
          "type": "object",
          "description": "NPU信息"
        },
        "active_content": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "激活订单号列表"
        },
        "log_configs": {
          "description": "设备日志配置",
          "type": "array",
          "items": {
            "$ref": "#/definitions/LogConfig"
          }
        },
        "event_validity_period": {
          "type": "integer",
          "format": "int32",
          "description": "事件有效时间(单位:分钟)"
        }
      }
    },
    "LogConfig": {
      "properties": {
        "component": {
          "description": "app:应用日志。 system:系统的日志",
          "type": "string"
        },
        "level": {
          "description": "系统级日志可配置为/error/warning/info/debug ; 不传会默认为info。",
          "type": "string"
        },
        "rotate_num": {
          "description": "日志rotate个数,默认5,hilens取值范围1-30,ief取值范围1-10",
          "type": "integer",
          "format": "int32"
        },
        "rotate_period": {
          "description": "日志rotate周期,可选项,只支持ief:daily monthly weekly yearly.",
          "type": "string"
        },
        "size": {
          "description": "应用日志文件大小限制,单位MB,默认50,取值范围10-1000。",
          "type": "integer",
          "format": "int32"
        },
        "type": {
          "description": "- LTS 将日志发送到云日志服务(Log Tank Service,简称LTS)\n- local 本地日志",
          "type": "string"
        }
      },
      "title": "LogConfig",
      "description": "日志配置列表",
      "required": [
        "component",
        "type"
      ]
    },
    "FirmwareUpdateRecord": {
      "properties": {
        "firmware_name": {
          "description": "固件名称",
          "type": "string"
        },
        "firmware_version": {
          "description": "固件版本",
          "type": "string"
        },
        "firmware_size": {
          "description": "固件大小",
          "type": "integer",
          "format": "int32"
        },
        "firmware_upgrade_time": {
          "description": "固件升级时间",
          "type": "string"
        },
        "status": {
          "description": "固件升级状态",
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "FirmwareUpdateRecordList": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/definitions/FirmwareUpdateRecord"
      }
    }
  },
