{
  "name": "ShowNodes",
  "summary": "查询设备列表",
  "tags": "设备管理",
  "productshort": "HiLens",
  "region_id": "cn-north-4",
  "paths": {
    "/v3/{project_id}/ai-mgr/nodes": {
      "get": {
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc",
        "x-is-registered": "Y",
        "tags": [
          "设备管理"
        ],
        "summary": "查询设备列表",
        "description": "专业版HiLens控制台设备管理,根据用户请求条件筛选,查询用户注册的设备信息,以列表形式返回。",
        "operationId": "ShowNodes",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户Token。获取方法请参见[获取Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。获取方法请参见[获取项目ID](hilens_07_0020.xml)",
            "required": true,
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询的起始位置,取值范围为非负整数,默认为0",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量,取值范围1~100,默认为100",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "name",
            "in": "query",
            "description": "设备名称,模糊匹配,只允许中文字符、英文字母、数字、下划线、中划线,最大长度64",
            "required": false,
            "type": "string"
          },
          {
            "name": "workspace_id",
            "in": "query",
            "description": "工作空间ID,默认为注册账号/子账号的default工作空间,可通过专业版HiLens控制台展开工作空间列表获取到工作空间ID",
            "required": false,
            "type": "string"
          },
          {
            "name": "app_name",
            "in": "query",
            "description": "应用名称,模糊匹配,只允许英文小写字母、数字、中划线,最大长度32, 英文小写字母或数字开头和结尾",
            "required": false,
            "type": "string"
          },
          {
            "name": "tags",
            "in": "query",
            "description": "标签的key和value通过点连接,多个标签通过逗号连接,如:tags=key1.value1,key2.value2",
            "required": false,
            "type": "string"
          },
          {
            "name": "provider",
            "in": "query",
            "description": "服务提供者:ief或hilens。不传会查询全部服务类型的设备列表",
            "required": false,
            "type": "string"
          },
          {
            "name": "cluster_id",
            "in": "query",
            "description": "集群ID,若值为0会过滤出不隶属任何集群的设备",
            "required": false,
            "type": "string"
          },
          {
            "name": "status",
            "in": "query",
            "description": "状态",
            "required": false,
            "type": "string"
          },
          {
            "name": "active_status",
            "in": "query",
            "description": "设备激活状态,分别是未激活(INACTIVE)、已激活(ACTIVATED)、已到期(EXPIRED)",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "schema": {
              "$ref": "#/definitions/NodeArrayResponseBody"
            },
