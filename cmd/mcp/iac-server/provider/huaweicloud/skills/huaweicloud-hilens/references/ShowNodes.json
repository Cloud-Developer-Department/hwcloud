  },
  "definitions": {
    "NodeArrayResponseBody": {
      "properties": {
        "count": {
          "description": "满足条件的设备总数",
          "type": "integer",
          "format": "int32"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NodeResponse"
          }
        }
      }
    },
    "NodeResponse": {
      "description": "设备详情",
      "properties": {
        "id": {
          "description": "设备ID",
          "type": "string"
        },
        "name": {
          "description": "设备名称,只允许中文字符、英文字母、数字、下划线、中划线,最大长度64",
          "type": "string"
        },
        "description": {
          "description": "设备描述,最大长度255,不允许^, ~, #, $, %, &, *, <, >, (, ), [, ], {, }, ', \", \\",
          "type": "string"
        },
        "created_at": {
          "description": "产生时间,如2021-10-15 14:45:22 GMT+08:00",
          "type": "string"
        },
        "cluster_id": {
          "description": "当该设备处于集群时,显示设备所属的集群ID",
          "type": "string"
        },
        "cluster_node_state": {
          "description": "设备所处集群状态,集群创建(cluster_create)、集群删除(cluster_delete)、添加集群工作节点设备(cluster_add_nodes)、删除集群工作节点设备(cluster_delete_node)、集群节点设备状态更新(cluster_node_state_update)",
          "type": "string"
        },
        "cluster_node_type": {
          "description": "当该设备处于集群时,显示所属的集群设备类型。\n- cluster_controller 控制设备\n- cluster_worker 工作设备",
          "type": "string"
        },
        "firmware_name": {
          "description": "固件名称。可包含大小写字母、数字、下划线、中划线,长度不超过60字符。必须以字母开头,字母或数字结尾",
          "type": "string"
        },
        "upgrade_firmware_version": {
          "description": "固件正在升级的版本",
          "type": "string"
        },
        "firmware_status": {
          "description": "固件升级状态,1、2、3分别代表升级中,升级失败,升级成功",
          "type": "integer",
          "format": "int32"
        },
        "firmware_upgrade_record": {
          "description": "该设备上升级过的固件记录",
          "$ref": "#/definitions/FirmwareUpdateRecordList"
        },
        "state": {
          "description": "设备状态:UNCONNECTED(未注册)、RUNNING(运行中)、FAIL(故障)、STOPPED(停用)、UPGRADING(升级中)、FREEZE(冻结)",
          "type": "string"
        },
        "type": {
          "description": "设备类型",
          "type": "string"
        },
        "active_status": {
          "description": "设备激活状态,未激活(INACTIVE)和已激活(ACTIVATED)",
          "type": "string"
        },
        "cpu": {
          "description": "设备CPU个数",
          "type": "integer",
          "format": "int32"
        },
        "gpu_num": {
          "description": "设备GPU个数",
          "type": "integer",
          "format": "int32"
        },
        "npu_num": {
          "description": "设备NPU个数",
          "type": "integer",
          "format": "int32"
        },
        "host_ips": {
          "description": "主机IP列表",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "description": "设备标签对列表",
          "type": "Object"
        },
        "deployment_num": {
          "type": "integer",
          "format": "int32",
          "description": "节点中部署的数量"
        }
      }
    },
    "FirmwareUpdateRecord": {
      "properties": {
        "firmware_name": {
          "description": "固件名称",
          "type": "string"
        },
        "firmware_version": {
          "description": "固件版本",
          "type": "string"
        },
        "firmware_size": {
          "description": "固件大小",
          "type": "integer",
          "format": "int32"
        },
        "firmware_upgrade_time": {
          "description": "固件升级时间",
          "type": "string"
        },
        "status": {
          "description": "固件升级状态",
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "FirmwareUpdateRecordList": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/definitions/FirmwareUpdateRecord"
      }
    }
  },
  "version": "2.0",
  "parameters": {},
