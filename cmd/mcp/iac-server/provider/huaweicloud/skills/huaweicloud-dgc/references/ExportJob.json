{
  "name": "ExportJob",
  "summary": "导出作业",
  "tags": "作业相关的API",
  "productshort": "DGC",
  "region_id": "la-north-2",
  "paths": {
    "/v1/{project_id}/jobs/{job_name}/export": {
      "post": {
        "summary": "导出作业",
        "x-support-sdk": "Y",
