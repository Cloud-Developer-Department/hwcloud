          "作业相关的API"
        ],
        "operationId": "ExportJob",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间id",
            "required": false,
            "type": "string",
            "x-notgenerate": true
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号.",
            "required": true,
            "type": "string"
          },
          {
            "name": "job_name",
            "in": "path",
            "description": "作业名称.",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "请求body体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ExportJobReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success"
          }
        }
      }
    }
  },
  "definitions": {
    "ExportJobReq": {
      "properties": {
        "exportDepend": {
          "type": "boolean",
          "description": "是否导出作业依赖的脚本和资源,取值为true或者false,不传该值时,默认为true。"
        },
        "obsPath": {
          "type": "string",
          "description": "当导出到obs时,需要指定obs路径,样例:obs://test_bucket/job_nodes/"
        },
        "exportStatus": {
          "type": "string",
          "enum": [
            "SUBMIT",
            "DEVELOP"
          ],
          "description": "导出作业的状态,取值如下:\n- DEVELOP: 开发态,默认是开发态\n- SUBMIT: 提交态"
        }
      }
    }
  },
