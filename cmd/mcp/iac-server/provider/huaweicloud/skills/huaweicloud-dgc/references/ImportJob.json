{
  "name": "ImportJob",
  "summary": "导入作业",
  "tags": "作业相关的API",
  "productshort": "DGC",
  "region_id": "my-kualalumpur-1",
  "paths": {
    "/v1/{project_id}/jobs/import": {
      "post": {
        "summary": "导入作业",
        "x-support-sdk": "Y",
        "tags": [
          "作业相关的API"
        ],
        "operationId": "ImportJob",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间id",
            "required": false,
            "type": "string",
            "x-notgenerate": true
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号.",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "请求消息体.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ImportFileReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "schema": {
              "$ref": "#/definitions/ImportJobResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "JobApprover": {
      "properties": {
        "approverName": {
          "type": "string",
          "description": "审批人名称"
        }
      },
      "required": [
        "approverName"
      ]
    },
    "ImportFileReq": {
      "properties": {
        "path": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "description": "公共作业参数"
        },
        "sameNamePolicy": {
          "type": "string",
          "enum": [
            "SKIP",
            "OVERWRITE"
          ]
        },
        "jobsParam": {
          "type": "object",
          "description": "指定作业参数"
        },
        "executeUser": {
          "type": "string"
        },
        "targetStatus": {
          "type": "string",
          "description": "在开启审批开关后,需要填写该字段。表示创建作业的目标状态,有三种状态:SAVED、SUBMITTED和PRODUCTION,分别表示作业创建后是保存态,提交态,生产态",
          "enum": [
            "SAVED",
            "SUBMITTED",
            "PRODUCTION"
          ]
        },
        "approvers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JobApprover"
          },
          "description": "在开启审批开关后,需要填写该字段,表示作业审批人"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JobResourceInfo"
          },
          "description": "如需替换资源,需要填写该字段,包含替换的资源名和资源类型和替换后的资源名"
        }
      }
    },
    "ImportJobResp": {
      "properties": {
        "taskId": {
          "type": "string",
          "description": "任务id"
        }
      }
    },
    "JobResourceInfo": {
      "properties": {
        "name": {
          "type": "string",
          "description": "资源名"
        },
        "type": {
          "type": "string",
          "enum": [
            "DWS_CONNECTION",
            "DIS_STREAM",
            "CDM_CLUSTER",
            "MRS_CLUSTER",
            "MRS_HIVE_CONNECTION",
            "MRS_SPARK_CONNECTION",
            "GES_GRAPH",
            "ROMA_INSTANCE",
            "TICS_INSTANCE",
            "DRS_TASK"
          ],
          "description": "资源类型"
        },
        "replace": {
          "type": "string",
          "description": "替换后的资源名"
        }
      },
      "required": [
        "name",
        "type"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dayu-dlf.my-kualalumpur-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}