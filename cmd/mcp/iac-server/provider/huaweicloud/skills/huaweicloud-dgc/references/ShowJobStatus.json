{
  "name": "ShowJobStatus",
  "summary": "查询实时作业的运行状态",
  "tags": "作业相关的API",
  "productshort": "DGC",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/{project_id}/jobs/{job_name}/status": {
      "get": {
        "summary": "查询实时作业的运行状态",
        "x-support-sdk": "Y",
        "tags": [
          "作业相关的API"
        ],
        "operationId": "ShowJobStatus",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间id",
            "required": false,
            "type": "string",
            "x-notgenerate": true
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号.",
            "required": true,
            "type": "string"
          },
          {
            "name": "job_name",
            "in": "path",
            "description": "作业名称.",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "schema": {
              "$ref": "#/definitions/RealTimeJobStatusResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "RealTimeJobStatusResp": {
      "properties": {
        "name": {
          "type": "string",
          "description": "作业名称。"
        },
        "status": {
          "type": "string",
          "description": "作业状态:\n- STARTING:启动中\n- NORMAL:正常\n- EXCEPTION:异常\n- STOPPING: 停止中\n- STOPPED:停止\n- PAUSE: 暂停\n- ABNORMAL: 运行异常/失败\n- DISABLE: 节点禁用\n- OVERLOAD: 繁忙\n- INIT: 初始化",
          "enum": [
            "STARTING",
            "NORMAL",
            "EXCEPTION",
            "STOPPING",
            "STOPPED",
            "PAUSE",
            "ABNORMAL",
            "DISABLE",
            "OVERLOAD",
            "INIT"
          ]
        },
        "starttime": {
          "type": "string",
          "description": "开始时间。"
        },
        "endTime": {
          "type": "string",
          "description": "结束时间。"
        },
        "lastUpdateTime": {
          "type": "string",
          "description": "状态最后更新时间。"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RealTimeNodeStatus"
          }
        },
        "createUser": {
          "type": "string",
          "description": "创建人。"
        },
        "lastModifiyUser": {
          "type": "string",
          "description": "最后修改人。"
        }
      }
    },
    "RealTimeNodeStatus": {
      "properties": {
        "name": {
          "type": "string",
          "description": "节点名称。"
        },
        "status": {
          "type": "string",
          "enum": [
            "STARTING",
            "NORMAL",
            "EXCEPTION",
            "STOPPING",
            "STOPPED",
            "PAUSE",
            "ABNORMAL",
            "DISABLE",
            "OVERLOAD",
            "INIT"
          ],
          "description": "节点状态:\n- STARTING:启动中\n- NORMAL:正常\n- EXCEPTION:异常\n- STOPPING: 停止中\n- STOPPED:停止\n- PAUSE: 暂停\n- ABNORMAL: 运行异常/失败\n- DISABLE: 节点禁用\n- OVERLOAD: 繁忙\n- INIT: 初始化"
        },
        "logPath": {
          "type": "string",
          "description": "节点运行日志路径"
        },
        "nodeType": {
          "type": "string",
          "description": "节点类型",
          "enum": [
            "HiveSQL",
            "SparkSQL",
            "DWSSQL",
            "DLISQL",
            "Shell",
            "CDMJob",
            "DISTransferTask",
            "CSJob",
            "CloudTableManage",
            "OBSManager",
            "RESTAPI",
            "MachineLearning",
            "SMN",
            "MRSSpark",
            "MapReduce",
            "DLISpark"
          ]
        },
        "lastInstanceStatus": {
          "type": "string",
          "description": "上一次实例的执行状态。"
        },
        "speed": {
          "type": "double",
          "description": "写入速率。"
        },
        "runningData": {
          "type": "string",
          "description": "节点运行时内部存放的部分数据。"
        },
        "totalPutBytes": {
          "type": "long",
          "description": "写入(输出)的总字节数。"
        },
        "bufferRecords": {
          "type": "long",
          "description": "缓冲区中的记录数。"
        },
        "jobInstanceId": {
          "type": "long",
          "description": "节点实例Id。"
        },
        "extendCounter": {
          "type": "string",
          "description": "扩展计数器。"
        },
        "totalGetBytes": {
          "type": "long",
          "description": "读取(输入)的总字节数 。"
        },
        "totalPutRecords": {
          "type": "long",
          "description": "写入的总记录数。"
        },
        "totalGetRecords": {
          "type": "long",
          "description": "读取的总记录数。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dayu-dlf.cn-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}