{
  "name": "ListScriptResults",
  "summary": "查询脚本实例执行结果",
  "tags": "脚本相关的API",
  "productshort": "DGC",
  "region_id": "cn-north-2",
  "paths": {
    "/v1/{project_id}/scripts/{script_name}/instances/{instance_id}": {
      "get": {
        "tags": [
          "脚本相关的API"
        ],
        "summary": "查询脚本实例执行结果",
        "x-support-sdk": "Y",
        "operationId": "ListScriptResults",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间id",
            "required": false,
            "type": "string",
            "x-notgenerate": true
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号",
            "required": true,
            "type": "string",
            "x-order": 1
          },
          {
            "name": "script_name",
            "in": "path",
            "description": "脚本名称",
            "required": true,
            "type": "string",
            "x-order": 2
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "脚本实例id",
            "required": true,
            "type": "string",
            "x-order": 3
          }
        ],
        "responses": {
          "200": {
            "description": "execute Script result",
            "schema": {
              "$ref": "#/definitions/ScriptStatus"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ScriptStatus": {
      "properties": {
        "status": {
          "type": "string",
          "description": "执行状态。\n- LAUNCHING :提交中\n- RUNNING : 运行中\n- FINISHED:执行成功\n- FAILED:执行失败"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Result"
          },
          "description": "执行结果"
        },
        "message": {
          "type": "string",
          "description": "执行失败消息"
        }
      }
    },
    "Result": {
      "properties": {
        "message": {
          "type": "object",
          "description": "结果返回信息"
        },
        "schema": {
          "type": "object",
          "description": "元数据信息"
        },
        "rows": {
          "type": "object",
          "description": "每条结果的信息"
        },
        "rowCount": {
          "type": "integer",
          "format": "int64",
          "description": "结果行数"
        },
        "inputRowCount": {
          "type": "integer",
          "format": "int64",
          "description": "输入结果的行数。(dli等脚本执行会执行此结果)"
        },
        "resultCount": {
          "type": "integer",
          "format": "int64",
          "description": "结果行数。(dli等脚本执行会执行此结果)"
        },
        "duration": {
          "type": "number",
          "format": "float",
          "description": "脚本运行时间"
        },
        "rawResult": {
          "type": "object",
          "description": "脚本结果信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dayu-dlf.cn-north-2.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}