{
  "name": "ListResources",
  "summary": "查询资源列表",
  "tags": "资源相关的API",
  "productshort": "DGC",
  "region_id": "my-kualalumpur-1",
  "paths": {
    "/v1/{project_id}/resources": {
      "get": {
        "tags": [
          "资源相关的API"
        ],
        "operationId": "ListResources",
        "summary": "查询资源列表",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间id",
            "required": false,
            "type": "string",
            "x-notgenerate": true
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号.",
            "required": true,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "分页参数:每页限定数量",
            "required": false,
            "type": "integer",
            "default": 10
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页参数:页数",
            "required": false,
            "type": "integer",
            "default": 0
          },
          {
            "name": "resourceName",
            "in": "query",
            "description": "资源名称",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "schema": {
              "$ref": "#/definitions/ResourceList"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "resources": [
                  {
                    "id": "c96a71b4-f452-4733-ba03-652b5fdaa9c9",
                    "name": "mpreduce",
                    "type": "jar",
                    "location": "obs://myBucket/hadoop-mapreduce-examples-2.4.1.jar",
                    "depend_files": [
                      "obs://myBucket/depend1.jar",
                      "obs://myBucket/depend2.jar"
                    ],
                    "desc": "mpreduce jar",
                    "directory": "/resource"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DLF.3051",
                "error_msg": "The request parameter is invalid."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "description": "错误响应",
      "properties": {
        "errorCode": {
          "type": "string",
          "description": "错误码"
        },
        "errorMsg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "DependPackage": {
      "type": "object",
      "description": "依赖包信息",
      "properties": {
        "type": {
          "description": "文件类型",
          "type": "string"
        },
        "location": {
          "description": "文件路径",
          "type": "string"
        }
      }
    },
    "ResourceList": {
      "type": "object",
      "description": "资源列表",
      "properties": {
        "total": {
          "type": "integer",
          "description": "总的资源个数"
        },
        "resources": {
          "description": "资源列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceInfo"
          }
        }
      }
    },
    "ResourceInfo": {
      "properties": {
        "id": {
          "description": "资源id",
          "type": "string"
        },
        "name": {
          "description": "资源名称,只能包含英文字母、数字、中文字符、下划线或中划线。",
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "description": "资源类型:\n  - archive: 压缩包\n  - file: 文件\n  - jar: jar文件\n  - pyFile:python文件",
          "type": "string",
          "enum": [
            "archive",
            "file",
            "jar",
            "pyFile"
          ]
        },
        "location": {
          "type": "string",
          "description": "资源文件所在OBS路径",
          "example": "obs://myBucket/test.jar",
          "maxLength": 256
        },
        "dependFiles": {
          "description": "主Jar包所依赖的JAR包、properties文件",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "desc": {
          "type": "string",
          "description": "资源描述"
        },
        "directory": {
          "type": "string",
          "description": "资源所在目录"
        },
        "dependPackages": {
          "description": "主Jar包所依赖的JAR包、properties文件。同时存在dependFiles和dependPackages时,优先解析该字段。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/DependPackage"
          },
          "maxLength": 10240
        },
        "jobRelation": {
          "description": "通过jar包名称查询相关的job",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Relation"
          }
        }
      }
    },
    "Relation": {
      "type": "object",
      "description": "依赖的job信息",
      "properties": {
        "relationType": {
          "description": "依赖类型",
          "type": "string"
        },
        "taskName": {
          "description": "作业名称",
          "type": "string"
        },
        "taskId": {
          "description": "作业ID",
          "type": "integer",
          "format": "int64"
        },
        "scriptName": {
          "description": "脚本名称",
          "type": "string"
        },
        "scriptId": {
          "type": "string",
          "description": "脚本ID"
        },
        "userName": {
          "type": "string",
          "description": "用户名"
        },
        "version": {
          "type": "integer",
          "description": "版本号"
        },
        "relationId": {
          "type": "string",
          "description": "依赖类型ID"
        },
        "deleted": {
          "type": "boolean"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dayu-dlf.my-kualalumpur-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}