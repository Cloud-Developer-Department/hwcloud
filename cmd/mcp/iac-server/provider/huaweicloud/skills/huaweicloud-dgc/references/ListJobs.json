{
  "name": "ListJobs",
  "summary": "查询作业列表",
  "tags": "作业相关的API",
  "productshort": "DGC",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/{project_id}/jobs": {
      "get": {
        "summary": "查询作业列表",
        "description": "查询作业列表清单",
        "x-support-sdk": "Y",
        "tags": [
          "作业相关的API"
        ],
        "operationId": "ListJobs",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间id",
            "required": false,
            "type": "string",
            "x-notgenerate": true
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号.",
            "required": true,
            "type": "string",
            "x-order": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "分页参数:每页限定数量",
            "required": false,
            "type": "integer",
            "default": 10
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页参数:页数",
            "required": false,
            "type": "integer",
            "default": 0
          },
          {
            "name": "jobType",
            "in": "query",
            "description": "作业类型:\n - REAL_TIME: 实时处理 \n - BATCH: 批处理",
            "required": false,
            "type": "string",
            "enum": [
              "REAL_TIME",
              "BATCH"
            ],
            "default": "BATCH"
          },
          {
            "name": "jobName",
            "in": "query",
            "description": "作业名称",
            "required": false,
            "type": "string"
          },
          {
            "name": "tags",
            "in": "query",
            "description": "作业标签",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "schema": {
              "$ref": "#/definitions/ListJobResp"
            },
            "examples": {
              "application/json": {
                "jobs": [
                  {
                    "createTime": 1684979659000,
                    "createUser": "test_user",
                    "jobType": "BATCH",
                    "lastInstanceEndTime": 1687334412000,
                    "lastInstanceStatus": "success",
                    "lastUpdateTime": 1687265954000,
                    "lastUpdateUser": "test_user_1",
                    "name": "job_test",
                    "owner": "test_user",
                    "path": "/",
                    "priority": 0,
                    "singleNodeJobFlag": false,
                    "startTime": 1687265922000,
                    "status": "SCHEDULING"
                  },
                  {
                    "createTime": 1684979659000,
                    "createUser": "test_user_x",
                    "jobType": "BATCH",
                    "lastInstanceEndTime": 1687334412000,
                    "lastInstanceStatus": "success",
                    "lastUpdateTime": 1687265954000,
                    "lastUpdateUser": "test_user_y",
                    "name": "job_test_j",
                    "owner": "test_user_y",
                    "path": "/test/",
                    "priority": 0,
                    "singleNodeJobFlag": true,
                    "startTime": 1687265932000,
                    "status": "STOPPED"
                  }
                ],
                "total": 2
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DLF.3051",
                "error_msg": "The request parameter is invalid."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "description": "错误响应",
      "properties": {
        "errorCode": {
          "type": "string",
          "description": "错误码"
        },
        "errorMsg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "ListJobResp": {
      "properties": {
        "total": {
          "type": "integer",
          "description": "作业数量"
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JobResult"
          },
          "description": "作业信息"
        }
      },
      "required": [
        "total",
        "jobs"
      ]
    },
    "JobResult": {
      "properties": {
        "name": {
          "type": "string",
          "description": "作业名称"
        },
        "jobType": {
          "type": "string",
          "description": "作业类型"
        },
        "owner": {
          "type": "string",
          "description": "作业责任人,长度不能超过128个字符"
        },
        "priority": {
          "type": "integer",
          "default": 0,
          "description": "作业优先级,取值范围[0, 2],默认值是0。0代表高优先级,1代表中优先级,2代表低优先级"
        },
        "status": {
          "type": "string",
          "default": "作业状态",
          "enum": [
            "STARTING",
            "NORMAL",
            "EXCEPTION",
            "STOPPING",
            "STOPPED",
            "SCHEDULING",
            "PAUSED"
          ]
        },
        "createUser": {
          "type": "string",
          "description": "作业的创建者"
        },
        "createTime": {
          "type": "integer",
          "format": "int64",
          "description": "作业的创建时间"
        },
        "startTime": {
          "type": "integer",
          "format": "int64",
          "description": "作业的启动时间"
        },
        "endTime": {
          "type": "integer",
          "format": "int64",
          "description": "作业配置的结束时间"
        },
        "lastInstanceStatus": {
          "type": "string",
          "description": "作业最近一次运行实例状态,当jobType为BATCH时才有本字段"
        },
        "lastInstanceEndTime": {
          "type": "integer",
          "format": "int64",
          "description": "作业最近一次运行实例运行结束时间,当jobType为BATCH时才有本字段"
        },
        "lastUpdateTime": {
          "type": "integer",
          "format": "int64",
          "description": "作业最后一次更新时间"
        },
        "lastUpdateUser": {
          "type": "string",
          "description": "作业最后一次更新用户"
        },
        "path": {
          "type": "string",
          "description": "作业的路径"
        },
        "singleNodeJobFlag": {
          "type": "boolean",
          "description": "作业是否为单任务作业"
        },
        "flinkJobInfo": {
          "type": "string",
          "description": "flink作业信息"
        },
        "alarms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JobAlarm"
          },
          "description": "作业监控告警信息"
        }
      },
      "required": [
        "name",
        "jobType",
        "status",
        "createUser",
        "createTime"
      ]
    },
    "JobAlarm": {
      "properties": {
        "alarmType": {
          "type": "string",
          "description": "告警类型"
        },
        "topicUrn": {
          "type": "string"
        }
      },
      "required": [
        "alarmType",
        "topicUrn"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dayu-dlf.ap-southeast-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}