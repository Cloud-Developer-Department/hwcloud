{
  "name": "RegisterPort",
  "summary": "注册通道号",
  "tags": "智能信息服务号通道号",
  "productshort": "KooMessage",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aim-sa/ports": {
      "post": {
        "tags": [
          "AimSaPort"
        ],
        "summary": "注册通道号",
        "description": "注册通道号。",
        "operationId": "RegisterPort",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string"
          },
          {
            "in": "body",
            "name": "RegisterPortRequestBody",
            "description": "请求体。",
            "required": false,
            "schema": {
              "$ref": "#/definitions/RegisterPortRequestBody"
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "请求体参数类型,该字段必须设置为:application/json。",
            "required": true,
            "type": "string"
          }
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "responses": {
          "200": {
            "description": "返回信息。",
            "examples": {
              "application/json": {
                "data": {
                  "data": {
                    "port": "8822053111111",
                    "port_type": 1,
                    "sign": [
                      "华为云KooMessage"
                    ]
                  }
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/RegisterPortRsp"
            }
          },
          "400": {
            "description": "非法参数。",
            "schema": {
              "$ref": "#/definitions/AimSaErrorMsg"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/AimSaErrorMsg"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "Public",
        "x-request-examples-description-1": "注册智能信息服务号通道号。设置通道号为\"8822053111111\",普通类型,不校验签名。",
        "x-request-examples-url-1": "https://koomessage.myhuaweicloud.cn/v1/aim-sa/ports",
        "x-request-examples-1": {
          "port": "8822053111111",
          "sign": [
            "华为云KooMessage"
          ],
          "port_type": 1,
          "sign_check": 0,
          "authorization_files": [
            "3d214a61672846f88ad77597f935cccc:AimSauploadService/272957b708ac4891a6d5282ccd2175cccc.png"
          ]
        }
      }
    }
  },
  "definitions": {
    "RegisterPortResponseModel": {
      "properties": {
        "data": {
          "description": "返回数据。",
          "$ref": "#/definitions/RegisterResult"
        }
      },
      "description": "登记通道号返回体。"
    },
    "RegisterResult": {
      "properties": {
        "port": {
          "type": "string",
          "example": "1114",
          "description": "通道号。\n"
        },
        "port_type": {
          "type": "integer",
          "example": 1,
          "description": "通道号类型。\n- 1:普通\n- 3:前缀号段\n- 5:后缀号段\n"
        },
        "sign": {
          "type": "array",
          "example": "[test123]",
          "description": "签名列表,最大长度为5。",
          "items": {
            "type": "string",
            "example": "test124"
          },
          "maxItems": 5,
          "minItems": 0
        }
      },
      "description": "请求成功返回的数据。"
    },
    "AimSaErrorMsg": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果详情。"
        }
      }
    },
    "RegisterPortRsp": {
      "properties": {
        "data": {
          "$ref": "#/definitions/RegisterPortResponseModel"
        }
      }
    },
    "RegisterPortRequestBody": {
      "required": [
        "authorization_files",
        "port",
        "port_type",
        "sign",
        "sign_check"
      ],
      "properties": {
        "port": {
          "type": "string",
          "example": "6e954dcb2ab54763b0d85ffd6bdf1ae18",
          "description": "通道号。\n- port_type=5时 ,长度必须为5\n- port_type=1或3,长度在21位内\n",
          "minLength": 0,
          "maxLength": 21
        },
        "port_type": {
          "type": "integer",
          "example": 1,
          "description": "通道号类型。\n- 1:普通\n- 3:前缀号段\n- 5:后缀号段\n",
          "minimum": 1,
          "maximum": 5
        },
        "sign": {
          "type": "array",
          "example": [
            123
          ],
          "description": "签名列表,最大长度为5。单个签名长度为2-18。",
          "items": {
            "type": "string",
            "example": "123",
            "minLength": 2,
            "maxLength": 18
          },
          "maxItems": 5,
          "minItems": 0
        },
        "sign_check": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "是否需要校验。\n\n- 0:不校验 \n- 1:校验签名\n\n> 当port_type为3或者5时,sign_check必须为1。\n",
          "minimum": 0,
          "maximum": 1
        },
        "authorization_files": {
          "type": "array",
          "example": [
            "b16023e2e7c24418aa6b4e471d6b78b8:http://www.xxxx.com",
            "da916e86576d43f1895ffa0f233f5cb2:http://www.xxxx.com"
          ],
          "description": "授权证明图片资源,支持jpg、bmp、png和jpeg格式,全部图片总大小不超过4M,最多支持5张。参数格式为:*资源ID:资源URL*,样例:3d214a61672846f88ad77597f935cccc:AimSauploadService/272957b708ac4891a6d5282ccd2175cccc.png。\n> 资源ID与资源URL对应上传智能信息服务号图片资源API返回的resource_id和resource_url。",
          "items": {
            "type": "string",
            "example": "324"
          },
          "maxItems": 5,
          "minItems": 0
        }
      },
      "description": "通道号登记请求体。"
    }
  },
  "version": "2.0",
  "parameters": {},
