{
  "name": "ListAimCallbacks",
  "summary": "查询用户已注册回执接口",
  "tags": "智能信息回执",
  "productshort": "KooMessage",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aim/callbacks": {
      "get": {
        "tags": [
          "AIMCallBack"
        ],
        "summary": "查询用户已注册回执接口",
        "description": "用户注册回执接口之后,可以根据此接口查询所有已注册回执接口。",
        "operationId": "ListAimCallbacks",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          }
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "responses": {
          "200": {
            "description": "返回信息。",
            "examples": {
              "application/json": {
                "status": "200",
                "message": "success",
                "data": [
                  {
                    "id": "1865d1ac-fa0d-468d-a18e-e05b73705f57",
                    "callback_url": "https://www.xxxx.com/v1/send-resolve-status",
                    "url_type": 0
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListAimCallbacksRsp"
            }
          },
          "400": {
            "description": "非法参数。",
            "schema": {
              "$ref": "#/definitions/AimErrorMsg"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/AimErrorMsg"
            }
          }
        },
        "x-apigateway-cors": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-match-mode": "NORMAL",
        "x-apigateway-query-string-encode": "ENABLE",
        "x-apigateway-request-type": "public",
        "x-request-examples-description-1": "查询已上报回执接口",
        "x-request-examples-url-1": "https://koomessage.myhuaweicloud.cn/v1/aim/callbacks"
      }
    }
  },
  "definitions": {
    "ListAimCallbacksRsp": {
      "properties": {
        "status": {
          "type": "string",
          "example": "200",
          "description": "状态码。"
        },
        "message": {
          "type": "string",
          "example": "success",
          "description": "响应信息。"
        },
        "data": {
          "$ref": "#/definitions/ListAimCallbacksResponseMode"
        }
      }
    },
    "Callback": {
      "type": "object",
      "properties": {
        "callback_url": {
          "type": "string",
          "example": "https://localhost:8080/test",
          "description": "回调地址。"
        },
        "id": {
          "type": "string",
          "example": "1bf6bb05-faa0-4451-8512-80b8e40c8785",
          "description": "注册回调的唯一标识ID。"
        },
        "url_type": {
          "type": "integer",
          "description": "回调类型。\n\n- 0:智能信息单条发送回调\n- 1:模板状态回调\n- 2:智能信息批量发送回调\n"
        }
      },
      "description": "注册详情。"
    },
    "ListAimCallbacksResponseMode": {
      "type": "array",
      "description": "回调地址列表。",
      "items": {
        "$ref": "#/definitions/Callback"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "AimErrorMsg": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "结果状态码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果详情。"
        },
        "error_message": {
          "description": "结果详情。\n\n> 该字段在以后可能会废弃,建议使用error_msg字段对接。\n"
        }
      },
      "description": "错误模型。"
    }
  },
  "version": "2.0",
  "parameters": {},
