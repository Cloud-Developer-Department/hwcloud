          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量。",
            "required": false,
            "type": "integer",
            "default": 20,
            "maximum": 100,
            "minimum": 1
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string"
          }
