            "type": "string",
            "x-example": "2019-10-12T07:20:50Z"
          },
          {
            "name": "end_time",
            "in": "query",
            "required": false,
            "description": "智能信息基础版模板创建结束时间。 样例为:2019-10-12T07:20:50Z。\n\n> begin_time和end_time必须全部为空或全部不为空,并且begin_time不能大于end_time。\n",
            "type": "string",
            "x-example": "2019-10-12T07:20:50Z"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,表示从此偏移量开始查询,offset大于等于0。",
