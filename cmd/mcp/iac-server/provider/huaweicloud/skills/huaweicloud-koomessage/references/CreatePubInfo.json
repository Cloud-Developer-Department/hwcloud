            "pub_id": {
              "type": "string",
              "example": "5467ec75eb974f508cee2cee10a7d968",
              "description": "服务号ID。"
            },
            "menu_id": {
              "type": "string",
              "example": "3452ec75eb974f508cee2cee10a7d968",
              "description": "菜单ID。"
            },
            "portal_id": {
              "type": "string",
              "example": "5645ec75eb974f508cee2cee10a7d968",
              "description": "主页ID。"
            },
            "pub_name": {
              "type": "string",
              "example": "谷歌01通过",
              "description": "服务号名称。"
            }
          },
          "required": [
            "log_id"
          ]
        }
      },
      "description": "创建服务号的返回体。"
    },
    "PubInfoRequestBody": {
      "required": [
        "authorization_files",
        "logo_img",
        "pub_abstract",
        "pub_name"
      ],
      "properties": {
        "logo_img": {
          "type": "string",
          "example": "718ae5c3add041048ff00b3d00a23852",
          "description": "服务号LOGO图片ID。\n\n> 通过上传智能信息服务号图片资源接口上传LOGO图片后获得的图片resource_id。图片要求大于等于240*240且比例相同。\n",
          "minLength": 32,
          "maxLength": 32
        },
        "pub_name": {
          "type": "string",
          "example": "服务号名称",
          "description": "服务号名称。\n\n> 同一个企业下可以相同,不同企业下不能重复。\n",
          "minLength": 1,
          "maxLength": 15
        },
        "pub_abstract": {
          "type": "string",
          "example": "服务号简介",
          "description": "服务号简介。",
          "minLength": 1,
          "maxLength": 75
        },
        "pub_remark": {
          "type": "string",
          "example": "服务号备注",
          "description": "服务号备注。\n\n> 同一个企业下,服务号名称相同时该项必须不同。\n",
          "minLength": 1,
          "maxLength": 15
        },
        "auto_get_port": {
          "type": "integer",
          "example": 0,
          "description": "是否授权系统自动收集端口。 \n\n- 0:否\n- 1:是\n",
          "minimum": 0,
          "maximum": 1
        },
        "signs_for_auto_get_port": {
          "type": "array",
          "example": [
            ""
          ],
          "description": "自动收集端口使用的签名列表。\n\n> auto_get_port为1时,该字段为必填,每个签名长度为2-18个字符,每个服务号签名不可以重复。\n",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 18
          },
          "maxItems": 5,
          "minItems": 0
        },
        "areas_for_auto_get_port": {
          "type": "array",
          "example": [
            ""
          ],
          "description": "自动收集端口生效的地区列表。地区取值见《地区名称列表》。\n\n> auto_get_port为1时,该字段有效。不填则默认全国,不允许传入重叠地区。\n",
          "items": {
            "type": "string"
          }
        },
        "industry": {
          "type": "integer",
          "example": 1,
          "description": "从事行业,默认取服务号所属商家的行业分类。 \n- 1:金融理财 \n- 2:社交通讯 \n- 3:影音娱乐 \n- 4:旅游出行 \n- 5:购物 \n- 6:本地生活 \n- 7:运动健康 \n- 8:教育培训 \n- 9:新闻阅读 \n- 10:运营商 \n- 11:其他\n",
          "minimum": 1,
          "maximum": 11
        },
        "authorization_files": {
          "type": "array",
          "example": [
            "b16023e2e7c24418aa6b4e471d600001",
            "da916e86576d43f1895ffa0f23300001"
          ],
          "description": "授权证明图片ID,支持jpg、bmp、png和jpeg格式,全部图片总大小不超过4M,最多支持6张。\n\n> 参数值为上传智能信息服务号图片资源API返回的resource_id。\n",
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 0
        }
      },
      "description": "PubRequestBody"
    },
    "CreatePubFastappModel": {
      "required": [
        "deeplink",
        "depend_engine_version",
        "logo_img",
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "快应用名。\n\n> 长度范围为1-30个字符,中文占2个字符,英文占1个字符。\n",
          "pattern": "^((?![\\s\\*\\-]).){1,15}$"
        },
        "logo_img": {
          "type": "string",
          "description": "快应用LOGO图片资源ID。\n\n> 图片格式为jpg、bmp、jpeg,分辨率大于等于192*192,大小不超过4M。参数值为上传智能信息服务号图片资源API返回的resource_id。\n",
          "minLength": 32,
          "maxLength": 32
        },
        "description": {
          "type": "string",
          "description": "快应用描述。\n\n> 长度范围为1-38个字符,中文占2个字符,英文占1个字符。\n"
        },
        "deeplink": {
          "type": "string",
          "description": "快应用跳转链接。",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^hap://app/.*$"
        },
        "depend_engine_version": {
          "type": "string",
          "description": "快应用依赖引擎版本。\n\n> 长度范围为1-50个字符,中文占2个字符,英文占1个字符。\n"
        }
      },
      "description": "快应用模型。"
    },
    "MenusMode": {
      "required": [
        "menu_items"
      ],
      "properties": {
        "menu_items": {
          "type": "array",
          "description": "各子菜单项配置。\n",
          "items": {
            "$ref": "#/definitions/MenuItem"
          },
          "maxItems": 3,
          "minItems": 0
        }
      }
    }
  },
