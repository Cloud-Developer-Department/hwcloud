          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "example": "13300000001"
          }
        },
        "dync_params": {
          "description": "个性化动态参数数组。\n参数顺序按照模板创建时参数占位符的顺序传入,例如创建模板时设置动参有#p_1#、#p_2#、#p_3#,则传入的参数数组顺序第一个元素为#p_1#,第二个元素是#p_2#,第三个元素为#p_3#。\n",
          "type": "array",
          "items": {
            "$ref": "#/definitions/IndividualContentParam"
          }
        }
