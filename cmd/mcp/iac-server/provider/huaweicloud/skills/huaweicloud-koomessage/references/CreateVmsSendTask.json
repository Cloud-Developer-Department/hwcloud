        "mobiles": {
          "type": "array",
          "description": "群发手机号码列表,最多支持5000个号码。\n\n> 长度指的是单个号码的长度。\n> mobiles和individual_params字段只能二选一。\n",
          "items": {
            "type": "string",
            "example": "13300000001",
            "minLength": 1,
            "maxLength": 20
          },
          "maxItems": 5000,
          "minItems": 1
        },
        "dync_params": {
          "type": "array",
          "description": "群发动态参数数组。\n- 参数顺序按照模板创建时参数占位符的顺序传入,例如创建模板时设置动参有#p_1#、#p_2#、#p_3#,则传入的参数数组顺序第一个元素为#p_1#,第二个元素是#p_2#,第三个元素为#p_3#。\n- mobiles不填时,此字段被忽略。\n",
          "items": {
            "$ref": "#/definitions/ContentParam"
          },
          "maxItems": 100,
          "minItems": 1
        },
        "individual_params": {
          "type": "array",
          "description": "个性化手机号码及动态参数数组。\n\nmobiles和individual_params字段只能二选一。\n",
          "items": {
            "$ref": "#/definitions/IndividualParam"
          }
        },
        "exdata": {
          "type": "string",
          "example": "自己添加的说明",
          "description": "智能信息基础版扩展字段。",
          "minLength": 0,
          "maxLength": 256
        }
      },
      "description": "生成发送短信请求体。"
