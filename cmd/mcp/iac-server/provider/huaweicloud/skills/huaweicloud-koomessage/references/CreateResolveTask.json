  "definitions": {
    "CreateShortChainParam": {
      "type": "object",
      "required": [
        "cust_flag"
      ],
      "properties": {
        "cust_flag": {
          "type": "string",
          "example": "130****0001",
          "description": "创建解析任务时填写用户唯一标识,手机号码或者任何的唯一标识,唯一标识不超过64个字符。 发送智能信息时则必须填客户的手机号码。样例为:130****0001。",
          "maxLength": 64
        },
        "dync_params": {
          "type": "object",
          "description": "动态参数。\n\n> 使用动态参数模板时,aim_code_type字段只能为individual。\n",
          "additionalProperties": {
            "type": "string",
            "example": "param"
          }
        },
        "custom_url": {
          "type": "string",
          "example": "https://www.xxxx.com",
          "description": "自定义跳转地址。长度要求不超过256。\n> - 未填时,终端用户点击短信原文中的短链后,跳转智能信息模板H5页\n> - 已填时,终端用户点击短信原文中的短链后,跳转该字段对应的页面,填写时必须为http或https作为前缀\n> - 使用自定义跳转链接功能请联系KooMessage运营人员进行域名备案\n> - 自定义短码时即generation_type为2时不支持自定义跳转链接功能,传入的参数值无效\n",
          "pattern": "^http[s]{0,1}://([\\w-]+\\.)+[\\w-]+(/[\\w-./?%&=]*)?$"
        },
        "custom_short_code": {
          "description": "自定义短码,支持长度为3到10位的数字或大小写字母。样例为:aDC123。\n> 自定义短码时即generation_type为2时,此参数为必填。",
          "type": "string",
          "example": "abc12",
          "maxLength": 10,
          "minLength": 3
        }
      },
      "description": "生成短链的参数对象。"
    },
    "CreateResolveTaskParamMode": {
      "type": "object",
      "properties": {
        "cust_flag": {
          "type": "string",
          "example": "130****0001",
          "description": "创建解析任务时填写用户唯一标识,手机号码或者任何的唯一标识,唯一标识不超过64个字符。 发送智能信息时则必须填客户的手机号码。样例为:130****0001。"
        },
        "cust_id": {
          "type": "string",
          "example": "231724915a62455ca356e10a085c0000",
          "description": "租户ID。"
        },
        "dync_params": {
          "type": "object",
          "description": "动态参数。",
          "additionalProperties": {
            "type": "string"
          }
        },
        "custom_url": {
          "type": "string",
          "description": "自定义跳转地址。\n> - 未填时,终端用户点击访问短信原文中的短链,跳转智能信息H5页\n> - 已填时,终端用户点击访问短信原文中的短链,跳转客户填写的链接落地页,填写时必须为http或https作为前缀\n"
        },
        "aim_url": {
          "type": "string",
          "example": "aim6.cn/asides",
          "description": "完整的短链连接地址,通过自己的短信渠道发送时,需要把该短链添加到短信模板中,并确保发送短信时的签名与创建短链时的签名保持一致。样例:km2g.cn/PDiWqc。"
        },
        "aim_code": {
          "type": "string",
          "example": "asides",
          "description": "智能信息编码,样例:PDiWqc。"
        },
        "ext_data": {
          "type": "string",
          "description": "自定义扩展参数。\n\n>预留字段。\n"
        },
        "result_code": {
          "type": "string",
          "example": "0",
          "description": "短链申请结果返回码。\n- 0:成功\n- 非0:失败,具体请参见错误码\n"
        },
        "error_message": {
          "type": "string",
          "example": "成功",
          "description": "短链申请结果错误描述。\n"
        },
        "generate_date": {
          "type": "string",
          "example": "2019-10-12T07:20:50",
          "description": "短链生成时间。样例为:2019-10-12T07:20:50Z。"
        },
        "expire_date": {
          "type": "string",
          "example": "2019-10-12T07:20:50",
          "description": "短链到期时间。样例为:2019-10-12T07:20:50Z。"
        },
        "resolved_date": {
          "type": "string",
          "example": "2019-10-12T07:20:50",
          "description": "解析时间。样例为:2019-10-12T07:20:50Z。\n\n>预留字段。\n"
        },
        "resolved_times": {
          "type": "integer",
          "example": 1,
          "description": "短链实际解析次数。\n\n>预留字段。\n"
        },
        "custom_short_code": {
          "type": "string",
          "description": "自定义短码,支持长度为3到10位的数字或大小写字母。样例为:aDC123。"
        }
      },
      "description": "生成短链的响应参数对象。"
    },
    "AimErrorMsg": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "结果状态码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果详情。"
        },
        "error_message": {
          "description": "结果详情。\n\n> 该字段在以后可能会废弃,建议使用error_msg字段对接。\n"
        }
      },
      "description": "错误模型。"
    },
    "CreateResolveTaskRequestBody": {
      "required": [
        "aim_code_type",
        "expiration_time",
        "params",
        "resolving_times",
        "sms_signs",
        "tpl_id"
      ],
      "properties": {
        "tpl_id": {
          "type": "string",
          "example": "600000000",
          "description": "智能信息模板ID,由9位数字组成。",
          "minLength": 1,
          "maxLength": 9
        },
        "sms_signs": {
          "type": "array",
          "description": "短信签名列表,需要与最终发送短信的签名一致,才能解析。\n\n> 最多传入5个签名,单个签名内容不包括中括号。\n",
          "items": {
            "type": "string",
            "example": "华为云科技",
            "description": "短信签名。",
            "minLength": 1,
            "maxLength": 18
          },
          "maxItems": 5,
          "minItems": 1
        },
        "resolving_times": {
          "type": "integer",
          "example": 10000,
          "description": "短链最大解析次数。\n\n>个性化短链只支持最大解析数为1,设置其他值无效。\n>群发短链设置解析次数需要大于等于2。\n",
          "minimum": 1,
          "maximum": 10000000
        },
        "aim_code_type": {
          "type": "string",
          "example": "group",
          "description": "生成短链类型。\n\n- group:群发\n- individual:个性化\n\n> 使用动态参数模板时,该字段只能为individual。\n"
        },
        "generation_type": {
          "type": "string",
          "description": "生成短码方式。\n\n- 1:标准\n- 2:自定义\n\n> 默认1,即标准生成短码。\n"
        },
        "domain": {
          "type": "string",
          "example": "km2n.cn",
          "description": "自定义短链域名,由大小写字母和数字组成的二级域名。\n\n> generation_type为2时,此参数为必填。域名需要提前报备,请联系KooMessage运营人员进行域名报备,域名区分生成短码方式,如报备的是标准生成短码方式,则在自定义生成短码时不能使用此域名。\n",
          "maxLength": 100,
          "pattern": "[a-zA-Z0-9][-a-zA-Z0-9]{0,62}(\\.[a-zA-Z0-9][-a-zA-Z0-9]{0,62})+\\.?"
        },
        "expiration_time": {
          "type": "integer",
          "example": 7,
          "description": "失效时间(天)。aim_code_type为group时,取值范围为1~180;aim_code_type为individual个性化时,取值范围为1~7。\n\n> 失效时间精确到秒,例如参数设置为1,创建时间为2022-07-22 21:10:12,过期时间为2022-07-23 21:10:12。\n"
        },
        "params": {
          "type": "array",
          "description": "短链参数列表。一次请求最多生成100个短链。\n\n> 群发短链每次调用最多申请一条。\n",
          "items": {
            "$ref": "#/definitions/CreateShortChainParam"
          },
          "maxItems": 100
        }
      },
      "description": "生成短链请求体。"
    },
    "CreateResolveTaskRsp": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "example": "e5f475be-f30e-4e5d-85dc-8bd8ea88111b",
          "description": "任务ID。"
        },
        "tpl_id": {
          "type": "string",
          "example": "600000000",
          "description": "智能信息模板ID,由9位数字组成。"
        },
        "sms_signs": {
          "type": "array",
          "description": "短信签名列表。",
          "items": {
            "type": "string",
            "example": "华为云科技",
            "description": "短信签名。"
          }
        },
        "resolving_times": {
          "type": "integer",
          "example": 10000,
          "description": "用户创建时提交的最大解析次数。"
        },
        "resolved_times": {
          "type": "integer",
          "example": 10000,
          "description": "实际已解析数量统计。\n\n> 预留字段。\n"
        },
        "aim_code_type": {
          "type": "string",
          "example": "group",
          "description": "智能信息编码类型。\n- group:群发\n- individual:个性化\n"
        },
        "domain": {
          "type": "string",
          "example": "km2n.cn",
          "description": "自定义短链域名,由大小写字母和数字组成的二级域名。",
          "pattern": "[a-zA-Z0-9][-a-zA-Z0-9]{0,62}(\\.[a-zA-Z0-9][-a-zA-Z0-9]{0,62})+\\.?"
        },
        "expiration_time": {
          "type": "integer",
          "example": 7,
          "description": "失效时间(天)。"
        },
        "params": {
          "type": "array",
          "description": "短链列表。",
          "items": {
            "$ref": "#/definitions/CreateResolveTaskParamMode"
          },
          "maxItems": 100
        }
      },
      "description": "生成短链响应实体类。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "koomessage.myhuaweicloud.cn",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}