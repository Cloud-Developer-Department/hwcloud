{
  "name": "ListAimSendDetails",
  "summary": "查询智能信息发送明细",
  "tags": "智能信息发送",
  "productshort": "KooMessage",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aim/send-details": {
      "get": {
        "tags": [
          "AIMSendTask"
        ],
        "summary": "查询智能信息发送明细",
        "description": "根据用户提供的过滤条件查询发送明细列表,包括:发送任务ID、发送手机号码等。",
        "operationId": "ListAimSendDetails",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          {
            "name": "task_id",
            "in": "query",
            "description": "任务ID。",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 0
          },
          {
            "name": "tpl_id",
            "in": "query",
            "description": "智能信息模板ID。",
            "required": false,
            "type": "string",
            "maxLength": 9,
            "minLength": 0
          },
          {
            "name": "sms_sign",
            "in": "query",
            "description": "签名。",
            "required": false,
            "type": "string",
            "maxLength": 18,
            "minLength": 0
          },
          {
            "name": "cust_flag",
            "in": "query",
            "description": "创建解析任务时填写用户唯一标识。\n\n> 手机号码或者任何的唯一标识,唯一标识不超过64个字符。发送智能信息时则必须填客户的手机号码。此处为手机号。样例为:130****0001。\n",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          {
            "name": "begin_time",
            "in": "query",
            "description": "\n发送开始时间。格式为:2019-10-12T07:20:50Z。\n\n> 需同时传入end_time才能生效,单独传begin_time不会作为过滤条件。\n>\n> 仅支持查询最近1年内的发送明细。\n",
            "required": false,
            "type": "string",
            "maxLength": 30,
            "minLength": 0,
            "x-example": "2019-10-12T07:20:50Z"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "发送结束时间。格式为:2019-10-12T07:20:50Z。\n\n> 需同时传入begin_time才能生效,单独传end_time不会作为过滤条件。\n",
            "required": false,
            "type": "string",
            "maxLength": 30,
            "minLength": 0,
            "x-example": "2019-10-12T07:20:50Z"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,表示从此偏移量开始查询,offset大于等于0。\n\n>为提高查询效率,offset+limit须小于等于10000,超出范围查询为空。\n",
            "required": true,
            "type": "integer",
            "maximum": 1000000,
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量。\n",
            "required": true,
            "type": "integer",
            "maximum": 100,
            "minimum": 1
          }
        ],
        "responses": {
          "200": {
            "description": "返回信息。",
            "examples": {
              "application/json": {
                "send_details": [
                  {
                    "msg_id": "7e52e4fe-ef00-4826-84b6-756446c5cccc_595223901",
                    "task_id": "7cc198c3-91d3-425b-9226-54c27cd7cccc",
                    "task_name": "智能信息发送-动态参数",
                    "tpl_id": "600000001",
                    "tpl_name": "【测试市场案例】参数通知模板",
                    "cust_flag": "131****0000",
                    "send_account": "131****0000",
                    "send_status": "success",
                    "send_time": "2022-07-19T14:57:20Z",
                    "receive_time": "2022-07-19T14:57:31Z"
                  },
                  {
                    "msg_id": "7e52e4fe-ef00-4826-84b6-756446c5cccc_595223902",
                    "task_id": "7cc198c3-91d3-425b-9226-54c27cd7cccc",
                    "task_name": "智能信息发送-动态参数",
                    "tpl_id": "600000001",
                    "tpl_name": "【测试市场案例】参数通知模板",
                    "cust_flag": "131****0001",
                    "send_account": "131****0001",
                    "send_status": "success",
                    "send_time": "2022-07-19T14:57:20Z",
                    "receive_time": "2022-07-19T14:57:30Z"
                  }
                ],
                "page_info": {
                  "offset": 0,
                  "limit": 2,
                  "total": 2
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ListAimSendDetailsRsp"
            }
          },
          "400": {
            "description": "非法参数。",
            "schema": {
              "$ref": "#/definitions/AimErrorMsg"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/AimErrorMsg"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "根据发送任务ID查询智能信息发送明细。",
        "x-request-examples-url-1": "https://koomessage.myhuaweicloud.cn/v1/aim/send-details?task_id=7cc198c3-91d3-425b-9226-54c27cd7cccc&offset=0&limit=2"
      }
    }
  },
  "definitions": {
    "Page": {
      "properties": {
        "offset": {
          "type": "integer",
          "example": 1,
          "description": "偏移量,表示从此偏移量开始查询,offset大于等于0。"
        },
        "limit": {
          "type": "integer",
          "example": 20,
          "description": "每页显示的条目数量。"
        },
        "total": {
          "type": "integer",
          "example": 222,
          "description": "总条数。"
        }
      },
      "description": "分页信息。"
    },
    "ListAimSendDetailsRsp": {
      "type": "object",
      "properties": {
        "send_details": {
          "type": "array",
          "description": "查询发送明细结果集。",
          "items": {
            "$ref": "#/definitions/AIMSendDetail"
          }
        },
        "page_info": {
          "description": "分页信息。",
          "$ref": "#/definitions/Page"
        }
      },
      "description": "查询发送明细返回体。"
    },
    "AIMSendDetail": {
      "properties": {
        "msg_id": {
          "type": "string",
          "example": "28f61af50fc9452aa0ed5ea25c3cc3d3",
          "description": "发送明细的唯一标识ID。",
          "readOnly": true
        },
        "task_id": {
          "type": "string",
          "example": "1869bbfb86e148adbcc068af3793bf7d",
          "description": "任务ID。",
          "readOnly": true
        },
        "task_name": {
          "type": "string",
          "example": "智能信息发送测试ly-个性化",
          "description": "任务名称。",
          "readOnly": true
        },
        "tpl_id": {
          "type": "string",
          "example": "600057584",
          "description": "智能信息模板ID。"
        },
        "tpl_name": {
          "type": "string",
          "example": "【市场案例】通知模板",
          "description": "智能信息模板名称。"
        },
        "cust_flag": {
          "type": "string",
          "example": "130****0001",
          "description": "创建解析任务时填写用户唯一标识,手机号码或者任何的唯一标识,唯一标识不超过64个字符。发送智能信息时则必须填客户的手机号码。此处为手机号。样例为:130****0001。"
        },
        "send_account": {
          "type": "string",
          "example": "130****0001",
          "description": "发送的目标手机号。"
        },
        "send_status": {
          "type": "string",
          "example": "1",
          "description": "发送状态。\n- success:发送成功 \n- fail:发送失败 \n- sending:发送中\n"
        },
        "send_time": {
          "type": "string",
          "example": "2022-05-16T15:44:52Z",
          "description": "发送时间。"
        },
        "receive_time": {
          "type": "string",
          "example": "2022-05-16T15:44:52Z",
          "description": "接收时间。"
        },
        "result_code": {
          "type": "string",
          "description": "发送错误码。"
        }
      },
      "description": "短信发送明细。"
    },
    "AimErrorMsg": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "结果状态码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果详情。"
        },
        "error_message": {
          "description": "结果详情。\n\n> 该字段在以后可能会废弃,建议使用error_msg字段对接。\n"
        }
      },
      "description": "错误模型。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "koomessage.myhuaweicloud.cn",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}