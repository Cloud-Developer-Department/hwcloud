{
  "name": "AddCallBack",
  "summary": "注册智能信息回执URL",
  "tags": "智能信息回执",
  "productshort": "KooMessage",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aim/callbacks": {
      "post": {
        "tags": [
          "AIMCallBack"
        ],
        "summary": "注册智能信息回执URL",
        "description": "用户根据要求创建回执接口后,可以调用此接口进行注册,注意:此接口仅允许te_admin角色用户调用。",
        "operationId": "AddCallBack",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "请求体参数类型,该字段必须设置为:application/json。",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "AddCallbackRequestBody",
            "description": "回调地址。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AddCallbackRequestBody"
            }
          }
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "responses": {
          "200": {
            "description": "返回信息。\n",
            "examples": {
              "application/json": {
                "status": "200",
                "message": "success",
                "data": {
                  "id": "18d1bcad-4d13-4db1-bcdd-32565457cccc",
                  "callback_url": "https://www.xxxx.com/v1/send-resolve-status"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/AimCallbacksRsp"
            }
          },
          "400": {
            "description": "非法参数。",
            "schema": {
              "$ref": "#/definitions/AimErrorMsg"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/AimErrorMsg"
            }
          }
        },
        "x-apigateway-cors": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-match-mode": "NORMAL",
        "x-apigateway-query-string-encode": "ENABLE",
        "x-apigateway-request-type": "public",
        "x-request-examples-description-1": "注册回执-智能信息单条发送回执",
        "x-request-examples-url-1": "https://koomessage.myhuaweicloud.cn/v1/aim/callbacks",
        "x-request-examples-1": {
          "callback_url": "https://www.xxxx.com/v1/send-resolve-status",
          "url_type": 0
        },
        "x-request-examples-description-2": "注册回执-智能信息模板状态回执",
        "x-request-examples-url-2": "https://koomessage.myhuaweicloud.cn/v1/aim/callbacks",
        "x-request-examples-2": {
          "callback_url": "https://www.xxxx.com/v1/template-status",
          "url_type": 1
        },
        "x-request-examples-description-3": "注册回执-智能信息批量发送回执",
        "x-request-examples-url-3": "https://koomessage.myhuaweicloud.cn/v1/send-resolve-status",
        "x-request-examples-3": {
          "callback_url": "https://www.xxxx.com/v1/template-status",
          "url_type": 2
        }
      }
    }
  },
  "definitions": {
    "Callback": {
      "type": "object",
      "properties": {
        "callback_url": {
          "type": "string",
          "example": "https://localhost:8080/test",
          "description": "回调地址。"
        },
        "id": {
          "type": "string",
          "example": "1bf6bb05-faa0-4451-8512-80b8e40c8785",
          "description": "注册回调的唯一标识ID。"
        },
        "url_type": {
          "type": "integer",
          "description": "回调类型。\n\n- 0:智能信息单条发送回调\n- 1:模板状态回调\n- 2:智能信息批量发送回调\n"
        }
      },
      "description": "注册详情。"
    },
    "AddCallbackRequestBody": {
      "type": "object",
      "required": [
        "callback_url"
      ],
      "properties": {
        "callback_url": {
          "type": "string",
          "example": "https://localhost:8080/test",
          "description": "回调地址。\n\n> - 必须http或https开头,建议使用https\n> - 支持域名或公网IP回调地址,不支持私网IP回调地址\n",
          "minLength": 1,
          "maxLength": 1000
        },
        "url_type": {
          "type": "integer",
          "description": "回调类型。\n\n- 0:智能信息单条发送回调\n- 1:模板状态回调\n- 2:智能信息批量发送回调\n"
        }
      },
      "description": "回调地址请求体。"
    },
    "AimCallbacksRsp": {
      "properties": {
        "status": {
          "type": "string",
          "example": "200",
          "description": "状态码。"
        },
        "message": {
          "type": "string",
          "example": "success",
          "description": "响应信息。"
        },
        "data": {
          "$ref": "#/definitions/Callback"
        }
      }
    },
    "AimErrorMsg": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "结果状态码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果详情。"
        },
        "error_message": {
          "description": "结果详情。\n\n> 该字段在以后可能会废弃,建议使用error_msg字段对接。\n"
        }
      },
      "description": "错误模型。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "koomessage.myhuaweicloud.cn",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}