{
  "name": "ListAimResolveDetails",
  "summary": "查询解析明细",
  "tags": "智能信息解析",
  "productshort": "KooMessage",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aim/resolve-details": {
      "get": {
        "tags": [
          "AIMResolveTask"
        ],
        "summary": "查询解析明细",
        "description": "根据用户提供的过滤条件查询个性化解析明细,包括:发送任务ID、发送手机号码等。",
        "operationId": "ListAimResolveDetails",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          {
            "name": "task_id",
            "in": "query",
            "description": "解析任务ID或者发送任务ID。",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 0
          },
          {
            "name": "task_name",
            "in": "query",
            "description": "任务名称。",
            "required": false,
            "type": "string",
            "maxLength": 30,
            "minLength": 0
          },
          {
            "name": "tpl_id",
            "in": "query",
            "description": "智能信息模板ID。",
            "required": false,
            "type": "string",
            "maxLength": 9,
            "minLength": 0
          },
          {
            "name": "tpl_name",
            "in": "query",
            "description": "智能信息模板名称。",
            "required": false,
            "type": "string"
          },
          {
            "name": "cust_flag",
            "in": "query",
            "description": "创建解析任务时填写用户唯一标识,手机号码或者任何的唯一标识,唯一标识不超过64个字符。发送智能信息时则必须填客户的手机号码。此处为手机号。样例为:130****0001。",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          {
            "name": "sms_sign",
            "in": "query",
            "description": "签名。",
            "required": false,
            "type": "string",
            "maxLength": 18,
            "minLength": 0
          },
          {
            "name": "aim_url",
            "in": "query",
            "description": "智能信息短链,通过自己的短信渠道发送时,需要把该短链添加到短信模板中,并确保发送短信时的签名与创建短链时的签名保持一致。",
            "required": false,
            "type": "string",
            "maxLength": 100,
            "minLength": 0,
            "x-example": "6mnm.cn/Vlgy7U"
          },
          {
            "name": "resolved_status",
            "in": "query",
            "description": "解析状态。\n- success:解析成功 \n- fail:解析失败 \n- unresolved:未解析",
            "required": false,
            "type": "string"
          },
          {
            "name": "begin_time",
            "in": "query",
            "description": "短链创建开始时间。格式为:2019-10-12T07:20:50Z。\n\n> 需同时传入end_time才能生效,单独传begin_time不会作为过滤条件。缺省:查询最近二十四小时数据。\n>\n> 仅支持查询最近1年内创建的短链。\n",
            "required": false,
            "type": "string",
            "maxLength": 30,
            "minLength": 0,
            "x-example": "2019-10-12T07:20:50Z"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "短链创建结束时间。格式为:2019-10-12T07:20:50Z。\n\n> 需同时传入begin_time才能生效,单独传end_time不会作为过滤条件。缺省:查询最近二十四小时数据。\n",
            "required": false,
            "type": "string",
            "maxLength": 30,
            "minLength": 0,
            "x-example": "2019-10-12T07:20:50Z"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,表示从此偏移量开始查询,offset大于等于0。\n\n>为提高查询效率,offset+limit须小于等于10000,超出范围查询为空。\n",
            "required": true,
            "type": "integer",
            "maximum": 1000000,
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量。\n",
            "required": true,
            "type": "integer",
            "maximum": 100,
            "minimum": 1
          }
        ],
        "responses": {
          "200": {
            "description": "返回信息。",
            "examples": {
              "application/json": {
                "resolve_details": [
                  {
                    "resolve_id": "29ae28ea-0300-4da1-8e54-6c91319fcccc",
                    "task_id": "bf04fc77-12c8-408f-a584-cf3d3e91cccc",
                    "task_name": "ZF2",
                    "send_account": "myaccount",
                    "tpl_id": "600000001",
                    "tpl_name": "【测试】参数通知模板",
                    "cust_flag": "131****0000",
                    "aim_url": "km2g.cn/MzNkNP",
                    "result_code": "0",
                    "generate_date": "2022-07-19T08:44:04Z",
                    "expire_date": "2022-07-26T08:44:04Z",
                    "resolved_time": "2022-07-19T08:44:31Z",
                    "resolved_status": "success"
                  }
                ],
                "page_info": {
                  "offset": 0,
                  "limit": 1,
                  "total": 18
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ListAimResolveDetailsRsp"
            }
          },
          "400": {
            "description": "非法参数。",
            "schema": {
              "$ref": "#/definitions/AimErrorMsg"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/AimErrorMsg"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "根据模板ID查询解析任务明细。",
        "x-request-examples-url-1": "https://koomessage.myhuaweicloud.cn/v1/aim/resolve-details?tpl_id=606425661&offset=0&limit=1"
      }
    }
  },
