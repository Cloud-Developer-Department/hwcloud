                "page_info": {
                  "offset": 0,
                  "limit": 2,
                  "total": 80
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ListResolveTasksRsp"
            }
          },
          "400": {
            "description": "非法参数。",
            "schema": {
              "$ref": "#/definitions/AimErrorMsg"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/AimErrorMsg"
            }
          }
        },
        "x-request-examples-description-1": "查询所有解析任务",
        "x-request-examples-url-1": "https://koomessage.myhuaweicloud.com/v1/aim/resolve-tasks?offset=0&limit=2",
        "x-opseverity": "Info",
        "x-apigateway-request-type": "Public",
        "x-support-sdk": "Y",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "ListResolveTasksRsp": {
      "type": "object",
      "properties": {
        "resolve_tasks": {
          "type": "array",
          "description": "解析任务列表。",
          "items": {
            "$ref": "#/definitions/ListResolveTaskResult"
          }
        },
        "page_info": {
          "description": "分页信息。",
          "$ref": "#/definitions/Page"
        }
      },
      "description": "查询短链生成状态响应体。"
    },
    "ListResolveTaskResult": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "example": "e5f475be-f30e-4e5d-85dc-8bd8ea88111b",
          "description": "任务ID。"
        },
        "task_name": {
          "type": "string",
          "example": "ZF2",
          "description": "任务名称。"
        },
        "tpl_id": {
          "type": "string",
          "example": "600000000",
          "description": "智能信息模板ID,由9位数字组成。"
        },
        "sms_signs": {
          "type": "array",
          "description": "短信签名列表。",
          "items": {
            "type": "string",
            "example": "华为云科技",
            "description": "短信签名。"
          }
        },
        "resolving_times": {
          "type": "integer",
          "example": 10000,
          "description": "用户创建时提交的最大解析次数。"
        },
        "resolved_times": {
          "type": "integer",
          "example": 10000,
          "description": "实际已解析数量统计。\n"
        },
        "aim_code_type": {
          "type": "string",
          "example": "group",
          "description": "智能信息编码类型。\n- group:群发\n- individual:个性化\n"
        },
        "domain": {
          "type": "string",
          "example": "km2n.cn",
          "description": "自定义短链域名,由大小写字母和数字组成的二级域名。",
          "pattern": "[a-zA-Z0-9][-a-zA-Z0-9]{0,62}(\\.[a-zA-Z0-9][-a-zA-Z0-9]{0,62})+\\.?"
        },
        "expiration_time": {
          "type": "integer",
          "example": 7,
          "description": "失效时间(天)。"
        },
        "params": {
          "type": "array",
          "description": "短链列表。该列表中只会有一条短链记录,如果一个任务中生成多个短链,则需要客户端基于任务ID(task_id)自己去合并。\n\n> 建议使用查询解析明细接口查询此字段信息,未来版本有计划移除该字段。\n",
          "items": {
            "$ref": "#/definitions/ListResolveTaskResultParam"
          },
          "maxItems": 100
        }
      },
      "description": "生成短链响应实体类。"
    },
    "Page": {
      "properties": {
        "offset": {
          "type": "integer",
          "example": 1,
          "description": "偏移量,表示从此偏移量开始查询,offset大于等于0。"
        },
        "limit": {
          "type": "integer",
          "example": 20,
          "description": "每页显示的条目数量。"
        },
        "total": {
          "type": "integer",
          "example": 222,
          "description": "总条数。"
        }
      },
      "description": "分页信息。"
    },
    "ListResolveTaskResultParam": {
      "type": "object",
      "properties": {
        "cust_flag": {
          "type": "string",
          "example": "130****0001",
          "description": "创建解析任务时填写用户唯一标识,手机号码或者任何的唯一标识,唯一标识不超过64个字符。 发送智能信息时则必须填客户的手机号码。样例为:130****0001。"
        },
        "cust_id": {
          "type": "string",
          "example": "231724915a62455ca356e10a085c0000",
          "description": "租户ID。"
        },
        "dync_params": {
          "type": "object",
          "description": "动态参数。",
          "additionalProperties": {
            "type": "string"
          }
        },
        "custom_url": {
          "type": "string",
          "description": "自定义跳转地址。\n> - 未填时,终端用户点击访问短信原文中的短链,跳转智能信息H5页\n> - 已填时,终端用户点击访问短信原文中的短链,跳转客户填写的链接落地页,填写时必须为http或https作为前缀\n"
        },
        "aim_url": {
          "type": "string",
          "example": "aim6.cn/asides",
          "description": "完整的短链连接地址,通过自己的短信渠道发送时,需要把该短链添加到短信模板中,并确保发送短信时的签名与创建短链时的签名保持一致。样例:km2g.cn/PDiWqc。"
        },
        "aim_code": {
          "type": "string",
          "example": "asides",
          "description": "智能信息编码。样例:PDiWqc。"
        },
        "ext_data": {
          "type": "string",
          "description": "自定义扩展参数。\n\n>预留字段。\n"
        },
        "result_code": {
          "type": "string",
          "example": "0",
          "description": "短链申请结果返回码。\n- 0:成功\n- 非0:失败,具体请参见错误码\n"
        },
        "error_message": {
          "type": "string",
          "example": "成功",
          "description": "短链申请结果错误描述。\n"
        },
        "generate_date": {
          "type": "string",
          "example": "2019-10-12T07:20:50",
          "description": "短链生成时间。样例为:2019-10-12T07:20:50。"
        },
        "expire_date": {
          "type": "string",
          "example": "2019-10-12T07:20:50",
          "description": "短链到期时间。样例为:2019-10-12T07:20:50。"
        },
        "resolved_date": {
          "type": "string",
          "example": "2019-10-12T07:20:50",
          "description": "解析时间。样例为:2019-10-12T07:20:50。\n"
        },
        "resolved_times": {
          "type": "integer",
          "example": 1,
          "description": "短链实际解析次数。\n\n> 预留字段。\n"
        }
      },
      "description": "生成短链的响应参数对象。"
    },
    "AimErrorMsg": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "结果状态码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果详情。"
        },
        "error_message": {
          "description": "结果详情。\n\n> 该字段在以后可能会废弃,建议使用error_msg字段对接。\n"
        }
      },
      "description": "错误模型。"
    }
  },
