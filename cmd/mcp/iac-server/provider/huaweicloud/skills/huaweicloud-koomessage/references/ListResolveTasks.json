                        "result_code": "0",
                        "error_message": "-",
                        "generate_date": "2022-07-18T21:00:56",
                        "expire_date": "2022-07-25T21:00:56",
                        "resolved_date": "2022-07-21T11:43:00"
                      }
                    ]
                  },
                  {
                    "task_id": "30d6db9b-cc8a-4dc9-a314-d80d3fd0dbea",
                    "task_name": "ZFJ1",
                    "tpl_id": "600000001",
                    "sms_signs": [
                      "华为云KooMessage"
                    ],
                    "resolving_times": 1,
                    "resolved_times": 0,
                    "aim_code_type": "individual",
                    "domain": "km2g.cn",
                    "expiration_time": 7,
                    "params": [
                      {
                        "cust_flag": "131****0000",
                        "cust_id": "231724915a62455ca356e10a085ccccc",
                        "dync_params": {
                          "param3": "参数3",
                          "param4": "参数4",
                          "param1": "参数1",
                          "param2": "参数2"
                        },
                        "custom_url": "https://www.xxxx.com",
                        "aim_url": "km2g.cn/PDeag3",
