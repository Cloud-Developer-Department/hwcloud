{
  "name": "ListResolveTasks",
  "summary": "查询解析任务",
  "tags": "智能信息解析",
  "productshort": "KooMessage",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aim/resolve-tasks": {
      "get": {
        "tags": [
          "AIMResolveTask"
        ],
        "summary": "查询解析任务",
        "description": "创建解析任务后,客户可以查询解析任务状态信息。\n\n通过模板ID等过滤条件,查询解析任务列表。\n\n如需查询明细,建议使用查询解析明细接口。",
        "operationId": "ListResolveTasks",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "task_id",
            "in": "query",
            "description": "解析任务ID。",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 0
          },
          {
            "name": "task_name",
            "in": "query",
            "description": "任务名称。",
            "required": false,
            "type": "string",
            "maxLength": 30,
            "minLength": 0
          },
          {
            "name": "tpl_id",
            "in": "query",
            "description": "智能信息模板ID。",
            "required": false,
            "type": "string",
            "maxLength": 9,
            "minLength": 0,
            "pattern": "^[0-9]{9}$"
          },
          {
            "name": "tpl_name",
            "in": "query",
            "description": "智能信息模板名称。",
            "required": false,
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          {
            "name": "cust_flag",
            "in": "query",
            "description": "创建解析任务时填写用户唯一标识,手机号码或者任何的唯一标识,唯一标识不超过64个字符。 发送智能信息时则必须填客户的手机号码。样例为:130****0001。",
            "required": false,
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          {
            "name": "aim_url",
            "in": "query",
            "description": "完整的短链连接地址。样例:km2g.cn/PDiWqc。",
            "required": false,
            "type": "string"
          },
          {
            "name": "begin_time",
            "in": "query",
            "description": "\n智能信息解析任务创建开始时间。格式为:2019-10-12T07:20:50.522Z。\n\n> 需同时传入end_time才能生效,单独传begin_time不会作为过滤条件。\n>\n> 若不填,则默认查询24小时内创建的解析任务。\n>\n> 仅支持查询最近1年内创建的解析任务。\n",
            "required": false,
            "type": "string",
            "maxLength": 30,
            "minLength": 0,
            "x-example": "2019-10-12T07:20:50.52Z"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "\n智能信息解析任务创建结束时间。格式为:2019-10-12T07:20:50.522Z。\n\n> 需同时传入begin_time才能生效,单独传end_time不会作为过滤条件。\n>\n> 若不填,则默认查询24小时内创建的解析任务。\n",
            "required": false,
            "type": "string",
            "x-example": "2019-10-12T07:20:50.52Z"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,表示从此偏移量开始查询,offset大于等于0。\n\n>为提高查询效率,offset+limit须小于等于10000,超出范围查询为空。\n",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 1000000,
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量。\n",
            "required": false,
            "type": "integer",
            "default": 20,
            "maximum": 100,
            "minimum": 1
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "返回信息。",
            "examples": {
              "application/json": {
                "resolve_tasks": [
                  {
                    "task_id": "30d6db9b-cc8a-4dc9-a314-d80d3fd0dbea",
