{
  "name": "UploadMedia",
  "summary": "上传智能信息服务号图片资源",
  "tags": "一站式创建服务号",
  "productshort": "KooMessage",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aim-sa/media/upload": {
      "post": {
        "x-apigateway-request-type": "Public",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "上传智能信息服务号图片资源",
        "x-request-examples-url-1": "https://koomessage.myhuaweicloud.cn/v1/aim-sa/media/upload",
        "tags": [
          "AimSaPubUnify"
        ],
        "summary": "上传智能信息服务号图片资源",
        "description": "支持用户上传图片资源。",
        "operationId": "UploadMedia",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "description": "图片资源。\n\n> 文件格式与文件名后缀需保持一致,请勿修改原始文件后缀,否则导致资源上传失败。\n",
            "type": "file"
          },
          {
            "name": "file_type",
            "in": "formData",
            "required": true,
            "description": "文件类型。\n- PUB_LOGO:上传服务号LOGO。支持jpg、bmp、png和jpeg格式,分辨率大于等于240*240且比例为1:1,大小不超过100K。\n- BG_IMAGE:上传服务号主页背景图。支持jpg、bmp、png和jpeg格式,分辨率大于等于1440*810且比例为16:9,大小不超过4M。\n- FASTAPP_LOGO:上传快应用LOGO。支持jpg、bmp、png和jpeg格式,分辨率大于等于192*192且比例为1:1,大小不超过4M。\n- OTHER:上传授权证明和营业执照等\n",
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "返回信息。",
            "schema": {
              "$ref": "#/definitions/UploadMediaRsp"
            },
            "examples": {
              "application/json": {
                "data": {
                  "resource_id": "708feafdf1354805bd66e7fddc678dc3",
