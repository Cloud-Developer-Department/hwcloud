                  "auth_resource_url": "https://cn-north-4-km-aim-sa.obs.cn-north-4.myhuaweicloud.com:443/AimSauploadService/0ee8432935c84290bd67993ac7059ed720220530-141334%28WeLinkPC%29.png?AccessKeyId=2PPEAYTMASZKZJIIEMPR&Expires=1654661170&Signature=y9f8j54CiJKxVjveR2Klv7TGS%2BY%3D"
                }
              }
            }
          },
          "400": {
            "description": "非法参数。",
            "schema": {
              "$ref": "#/definitions/AimSaErrorMsg"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/AimSaErrorMsg"
            }
          }
        }
      }
    }
  },
