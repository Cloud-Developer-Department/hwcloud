      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果详情。"
        }
      }
    },
    "LockPortResponseModel": {
      "properties": {
        "message": {
          "type": "string",
          "example": "成功",
          "description": "信息。"
        }
      },
      "description": "通道号绑定服务号返回返回体。"
    },
    "LockPortRequestBody": {
      "required": [
        "ext_port_id",
        "port",
        "province",
        "pub_id",
        "sign"
      ],
      "properties": {
        "pub_id": {
          "type": "string",
          "example": "044c1bf88e391204c92746ee502109cb",
          "description": "服务号ID。",
          "minLength": 0,
          "maxLength": 32
        },
        "port": {
          "type": "string",
          "example": "port",
          "description": "通道号。\n- port_type=5时,长度必须为5\n- port_type=1或3,长度在21位内\n",
          "minLength": 0,
          "maxLength": 21
        },
        "province": {
          "type": "string",
          "example": "广东省",
          "description": "绑定的地区,不允许传入重叠地区。地区取值见《地区名称列表》。",
          "minLength": 0,
          "maxLength": 500
        },
        "sign": {
          "type": "array",
          "example": [
            "测试"
          ],
          "description": "绑定签名,必须是该端口号签名的子集。单个签名长度为2-18。",
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 0
        },
        "ext_port_id": {
          "type": "string",
          "example": "38083332fd3b472d929d2db28f915548",
          "description": "关联通道号ID,取通道号列表返回的ID。",
          "minLength": 32,
          "maxLength": 32
        }
      },
      "description": "通道号绑定服务号请求体。"
    },
    "LockPortRsp": {
      "properties": {
        "data": {
