{
  "name": "UpdateMenu",
  "summary": "修改智能信息服务号菜单",
  "tags": "智能信息服务号菜单",
  "productshort": "KooMessage",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aim-sa/menus/{menu_id}": {
      "put": {
        "tags": [
          "AimSaMenu"
        ],
        "summary": "修改智能信息服务号菜单",
        "description": "\n支持用户修改所属企业的指定菜单。",
        "operationId": "UpdateMenu",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "menu_id",
            "in": "path",
            "description": "菜单ID。",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 1
          },
          {
            "in": "body",
            "name": "updateMenuRequestBody",
            "description": "修改菜单请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateMenuRequestBody"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string"
          }
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "responses": {
          "200": {
            "description": "返回信息。",
            "examples": {
              "application/json": {
                "data": {
                  "menu_id": "34cffce987e64757bb9b711895714692",
                  "log_id": "6766"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/UpdateMenuRsp"
            }
          },
          "400": {
            "description": "非法参数。",
            "schema": {
              "$ref": "#/definitions/AimSaErrorMsg"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/AimSaErrorMsg"
            }
          }
        },
        "x-apigateway-request-type": "Public",
        "x-request-examples-description-1": "根据菜单ID修改智能信息服务号菜单。设置修改原因为\"业务调整\",修改或添加菜单。",
        "x-request-examples-url-1": "https://koomessage.myhuaweicloud.cn/v1/aim-sa/menus/34cffce987e64757bb9b711895714692",
        "x-request-examples-1": {
          "change_reason": "业务调整",
          "menu": {
            "menu_items": [
              {
                "action_type": "OPEN_APP",
                "name": "通过申请",
