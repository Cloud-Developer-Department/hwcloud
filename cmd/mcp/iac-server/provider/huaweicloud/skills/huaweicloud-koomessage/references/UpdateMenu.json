                  "x_package_names": "",
                  "browser_floor_url": "https://www.xxxx.com/"
                }
              },
              {
                "action_type": "OPEN_URL",
                "name": "打开链接",
                "sub_menu_items": [],
                "content": "https://www.xxxx.com/",
                "ext_msg": {
                  "web_title": "搜索",
                  "open_in_browser": "1"
                }
              },
              {
                "action_type": "OPEN_SUBMENU",
                "name": "通过菜单",
                "ext_msg": {},
                "sub_menu_items": [
                  {
                    "action_type": "OPEN_URL",
                    "name": "搜索一下",
                    "sub_menu_items": [],
                    "content": "https://www.xxxx.com/",
                    "ext_msg": {
                      "web_title": "url标题",
                      "open_in_browser": "1"
                    }
                  },
                  {
                    "action_type": "CALLING",
                    "name": "电一下",
                    "sub_menu_items": [],
                    "content": "131****0000",
                    "ext_msg": {}
                  },
                  {
                    "action_type": "OPEN_APP",
                    "name": "手机软件",
                    "sub_menu_items": [],
                    "content": "hap://app/xxxx.deeplink.xxxxx",
                    "ext_msg": {
                      "package_name": "开心消消乐",
                      "app_id": "appid",
                      "x_app_id": "xappid",
