          "file_stream": "data:video/mp4;base64,AAAAIGZ0eXBpc29tAAACAGlzb21pc28yYXZjMW1wNDEAADhJbW9vdgAAAGxtdmhkAAAAAAAAAAAAAAAAAAAD6AAAUoUAAQAAAQAAAAAAAAAAAAAAAAEAAAAAAAAAAAAA..."
        },
        "x-request-examples-description-3": "上传个人模板素材-缩略图(视频封面)。类型为\"thumbnail\",文件名称为\"template_thumbnail.jpg\"。",
        "x-request-examples-url-3": "https://koomessage.myhuaweicloud.cn/v1/aim/template-materials",
        "x-request-examples-3": {
          "resource_type": "thumbnail",
          "material_id": "b68de572-edd2-4c9e-8b34-8457a8e5cccc",
          "file_type": "stream",
          "file_name": "template_thumbnail.jpg",
          "file_stream": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAcAAAAD8CAYAAADg6nQRAAAAAXNSR0IArs4c6QAAIABJREFUeF7sveurbdu23dXHXPtxRBT8YBAUVBRRVAQ/iOIDDaigEPX6SMgDiSbRiy..."
        }
      }
    }
  },
  "definitions": {
    "UploadAimTemplateMaterialRequestBody": {
      "type": "object",
      "required": [
        "file_type",
        "resource_type"
      ],
      "properties": {
        "resource_type": {
          "type": "string",
          "description": "资源类型。\n\n- image:图片\n- video:视频\n- thumbnail:缩略图\n\n> 图片支持png、jpeg、jpg格式,最大2M;\n> 视频支持格式mp4,大小不超过7M,建议时长不超过33S;\n> 缩略图支持png、jpeg、jpg格式,大小不超过100K。\n",
          "minLength": 1,
          "maxLength": 16
        },
        "material_id": {
          "type": "string",
          "description": "素材ID。\n> resource_type=thumbnail时,material_id必填,填写内容为上传视频资源返回的material_id字段的值。\n",
          "minLength": 0,
          "maxLength": 36
        },
        "file_type": {
          "type": "string",
          "description": "文件类型。\n- url:资源为URL链接地址\n- stream:资源为多媒体资源文件流的BASE64编码,需要带资源类型前缀,样例:\"data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD/4gIoSUNDX1BST0ZJTEUAAQEAAAIYAAAAAAQwAABtbnRyUkdCIFhZWiAAAAAAAAAAAAAAAABhY3NwAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAQAA9tYAAQAAAADTLQ...\",样例过长,未显示全部\n",
          "minLength": 1,
          "maxLength": 16
        },
        "file_url": {
          "type": "string",
          "example": "https://icon-library.com/images/batman-icon/batman-icon-29.jpg",
          "description": "文件URL。\n\n> file_type=url时,file_url为必填。URL地址必须包含文件格式的后缀,例如:jpg、jpeg,大小写后缀都支持。\n",
          "maxLength": 1000,
          "pattern": "^http[s]{0,1}://([\\w-]+\\.)+[\\w-]+(/[\\w-./?%&=]*)?$"
        },
        "file_stream": {
          "type": "string",
          "description": "文件资源码流。\n\n> file_type=stream时,file_stream为必填。\n"
        },
        "image_rate": {
          "type": "string",
          "description": "图像比例。\n- oneToOne:指1:1比例\n- sixteenToNine:指16:9比例\n- threeToOne:指3:1比例\n- fortyEightToSixtyFive:指48:65比例\n- twentyOneToNine:指21:9比例\n- threeToFour:指3:4比例\n\n> resource type=image时,image_rate必填。\n",
          "maxLength": 32
        },
        "file_name": {
          "type": "string",
          "example": "batman-icon-29.jpg",
          "description": "文件名称。\n\n> file_type=stream时,file_name必填。\n",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "description": "描述。",
          "maxLength": 50
        }
      }
    },
    "UploadAimTemplateMaterialRsp": {
      "properties": {
        "status": {
          "type": "string",
          "example": "200",
          "description": "状态码。"
        },
        "message": {
          "type": "string",
          "example": "success",
          "description": "响应信息。"
        },
        "data": {
          "$ref": "#/definitions/UploadAimTemplateMaterialResponseMode"
        }
      }
    },
    "TemplateErrorMsg": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "结果状态码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果详情。"
        }
      },
      "description": "错误模型。"
    },
    "UploadAimTemplateMaterialResponseMode": {
      "properties": {
        "material_id": {
          "type": "string",
          "example": "c9a605cd-2e8c-4f1d-ba6f-e789f4cf116c",
          "description": "模板素材ID。"
        },
        "aim_resource_id": {
          "type": "string",
          "description": "资源ID。"
        }
      },
      "description": "上传模板素材响应体。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "koomessage.myhuaweicloud.cn",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}