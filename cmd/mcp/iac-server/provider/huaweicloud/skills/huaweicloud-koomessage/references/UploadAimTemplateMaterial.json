{
  "name": "UploadAimTemplateMaterial",
  "summary": "上传智能信息模板素材",
  "tags": "智能信息模板",
  "productshort": "KooMessage",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aim/template-materials": {
      "post": {
        "tags": [
          "AIMTemplate"
        ],
        "summary": "上传智能信息模板素材",
        "description": "支持用户上传模板使用的图片或者视频。\n\n> 单个租户资源空间为10GB,包括回收站内容,请及时清理无用资源,防止资源浪费。\n> 请求中所有字符串不允许携带“<”、“>”或多个空格。\n",
        "operationId": "UploadAimTemplateMaterial",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "UploadAimTemplateMaterialRequestBody",
            "description": "上传模板材料请求。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UploadAimTemplateMaterialRequestBody"
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "请求体参数类型,该字段必须设置为:application/json。",
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string"
          }
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "返回信息。",
            "examples": {
              "application/json": {
                "status": "200",
                "message": "success",
                "data": {
                  "material_id": "24267112-21d7-468f-aa58-eaf00af2d3b2",
                  "aim_resource_id": "123df45-fgfg3456-g34d"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/UploadAimTemplateMaterialRsp"
            }
          },
          "400": {
            "description": "非法参数。",
            "schema": {
              "$ref": "#/definitions/TemplateErrorMsg"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/TemplateErrorMsg"
            }
          }
        },
        "x-opseverity": "Info",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "Public",
        "x-request-examples-description-1": "上传个人模板素材-图片。类型为\"image\",文件名称为\"template_image.jpg\"。",
        "x-request-examples-url-1": "https://koomessage.myhuaweicloud.cn/v1/aim/template-materials",
        "x-request-examples-1": {
