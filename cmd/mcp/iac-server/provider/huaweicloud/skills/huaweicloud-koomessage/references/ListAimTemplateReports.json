{
  "name": "ListAimTemplateReports",
  "summary": "查询模板报表",
  "tags": "智能信息模板",
  "productshort": "KooMessage",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aim/template-reports/query": {
      "post": {
        "tags": [
          "AIMTemplate"
        ],
        "summary": "查询模板报表",
        "description": "根据用户指定过滤条件查询指定智能信息模板的解析次数。当日数据需要次日16:00之后才能查询到。",
        "operationId": "ListAimTemplateReports",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "请求体参数类型,该字段必须设置为:application/json。",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "ListAimTemplateReportsRequestBody",
            "description": "解析任务生成报文。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListAimTemplateReportsRequestBody"
            }
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "返回信息。",
            "examples": {
              "application/json": {
                "template_reports": [
                  {
                    "tpl_id": "600000001",
                    "start_time": "2022-06-30T00:00:00Z",
                    "resolving_times": 0,
                    "end_time": "2022-07-18T17:56:08Z",
                    "expose_uv": 3,
                    "expose_pv": 33,
                    "click_uv": 3,
                    "click_pv": 6
                  }
                ],
                "page_info": {
                  "offset": 0,
                  "limit": 10,
                  "total": 1
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/AIMTemplateReports"
            }
          },
          "400": {
            "description": "非法参数。",
            "schema": {
              "$ref": "#/definitions/AimErrorMsg"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/AimErrorMsg"
            }
          }
        },
        "x-request-examples-text-1": {
          "tpl_ids": [
            "600000001"
          ],
          "begin_time": "2022-06-01T07:20:50.522Z",
          "end_time": "2022-07-01T07:20:50.522Z",
          "offset": 0,
          "limit": 10
