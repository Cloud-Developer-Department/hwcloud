        "x-opseverity": "Info",
        "x-apigateway-request-type": "Public",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-description-1": "查询模板报表。模板ID为\"600000001\",查询时间范围从\"2022-06-01 07:20:50\" 到 \"2022-07-01 07:20:50\"。",
        "x-request-examples-url-1": "https://koomessage.myhuaweicloud.cn/v1/aim/template-reports/query",
        "x-request-examples-1": {
          "tpl_ids": [
            "600000001"
          ],
          "begin_time": "2022-06-01T07:20:50.522Z",
          "end_time": "2022-07-01T07:20:50.522Z",
          "offset": 0,
          "limit": 10
        }
      }
    }
  },
  "definitions": {
    "Page": {
      "properties": {
        "offset": {
          "type": "integer",
          "example": 1,
          "description": "偏移量,表示从此偏移量开始查询,offset大于等于0。"
        },
        "limit": {
          "type": "integer",
          "example": 20,
          "description": "每页显示的条目数量。"
        },
        "total": {
          "type": "integer",
          "example": 222,
          "description": "总条数。"
        }
      },
      "description": "分页信息。"
    },
    "ListAimTemplateReportsRequestBody": {
      "required": [
        "begin_time",
        "end_time",
        "tpl_ids"
      ],
      "properties": {
        "tpl_ids": {
          "type": "array",
          "example": [
            "600000001"
          ],
          "description": "智能信息模板ID列表,一次最多请求100个。\n",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1
        },
        "begin_time": {
          "type": "string",
          "example": "2019-10-12T07:20:50.52Z",
          "description": "模板报表查询开始时间。样例:2019-10-12T07:20:50.522Z。\n\n>开始时间和结束时间最多间隔90天,超出时间限制返回为空。\n",
          "minLength": 1,
          "maxLength": 30
        },
        "end_time": {
          "type": "string",
          "example": "2019-10-12T07:20:50.52Z",
          "description": "模板报表查询结束时间。样例:2019-10-12T07:20:50.522Z。\n\n>开始时间和结束时间最多间隔90天,超出时间限制返回为空。\n",
          "minLength": 1,
          "maxLength": 30
        },
        "offset": {
          "type": "integer",
          "example": 10,
          "description": "偏移量,表示从此偏移量开始查询,offset大于等于0。\n",
          "minimum": 0,
          "maximum": 2147483647
        },
        "limit": {
          "type": "integer",
          "example": 10,
          "description": "每页显示的条目数量。\n",
          "minimum": 1,
          "maximum": 100
        },
        "factory_type": {
          "type": "array",
          "description": "厂商类型。不填时默认全厂商。列举值:\"huawei\", \"vivo\", \"oppo\", \"xiaomi\", \"meizu\", \"samsung\"。\n",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "模板报表查询过滤条件。"
    },
    "AIMTemplateReports": {
      "properties": {
        "template_reports": {
          "type": "array",
          "description": "查询模板报表结果集。",
          "items": {
            "$ref": "#/definitions/AIMTemplateReport"
          }
        },
        "page_info": {
          "description": "分页信息。",
          "$ref": "#/definitions/Page"
        }
      },
      "description": "查询模板返回体。"
    },
    "AimErrorMsg": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "结果状态码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果详情。"
        },
        "error_message": {
          "description": "结果详情。\n\n> 该字段在以后可能会废弃,建议使用error_msg字段对接。\n"
        }
      },
      "description": "错误模型。"
    },
    "AIMTemplateReport": {
      "properties": {
        "tpl_id": {
          "type": "string",
          "example": "100001000",
          "description": "智能信息模板ID。"
        },
        "start_time": {
          "type": "string",
          "example": "1970-01-01T00:00:00Z",
          "description": "统计开始时间。样例为:1970-01-01T00:00:00Z。"
        },
        "resolving_times": {
          "type": "integer",
          "description": "实际已解析数。"
        },
        "end_time": {
          "type": "string",
          "example": "1970-01-01T00:00:00Z",
          "description": "统计结束时间。样例为:1970-01-01T00:00:00Z。"
        },
        "expose_uv": {
          "type": "integer",
          "format": "int64",
          "description": "消息曝光数。\n"
        },
        "expose_pv": {
          "type": "integer",
          "format": "int64",
          "description": "消息曝光次数。\n"
        },
        "click_uv": {
          "type": "integer",
          "format": "int64",
          "description": "消息点击数。\n"
        },
        "click_pv": {
          "type": "integer",
          "format": "int64",
          "description": "消息点击次数。\n"
        }
      },
      "description": "查询模板返回体。"
    }
  },
