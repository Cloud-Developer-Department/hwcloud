{
  "name": "SendAimBatchDifferentMessages",
  "summary": "发送分批短信",
  "tags": "短信发送",
  "productshort": "KooMessage",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aim/sms/diff-messages": {
      "post": {
        "x-request-examples-url-1": "https://koomessage.myhuaweicloud.cn/v1/aim/sms/diff-messages",
        "x-request-examples-text-1": {
          "channel_num": "882306284****",
          "taskName": "多模板API",
          "sms_content": [
