      },
      "description": "获取服务号详情返回体。"
    },
    "Page": {
      "properties": {
        "offset": {
          "type": "integer",
          "example": 1,
          "description": "偏移量,表示从此偏移量开始查询,offset大于等于0。"
        },
        "limit": {
          "type": "integer",
          "example": 20,
          "description": "每页显示的条目数量。"
        },
        "total": {
          "type": "integer",
