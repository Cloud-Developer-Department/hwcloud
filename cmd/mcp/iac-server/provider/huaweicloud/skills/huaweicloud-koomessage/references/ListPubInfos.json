        },
        "state": {
          "type": "integer",
          "example": 3,
          "description": "服务号状态。 \n- 1:未生效\n- 2:已生效\n- 3:已失效\n- 4:已冻结\n\n"
        },
        "online_time": {
          "type": "string",
          "example": "2020-06-03T09:05:51Z",
