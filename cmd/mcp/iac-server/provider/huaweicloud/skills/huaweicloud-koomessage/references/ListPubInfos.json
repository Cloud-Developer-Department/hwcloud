{
  "name": "ListPubInfos",
  "summary": "查询服务号列表",
  "tags": "智能信息服务号资料",
  "productshort": "KooMessage",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aim-sa/pubs": {
      "get": {
        "tags": [
          "AimSaPub"
        ],
        "summary": "查询服务号列表",
        "description": "\n支持根据用户提供的过滤条件查询服务号列表。",
        "operationId": "ListPubInfos",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "pub_name",
            "in": "query",
            "description": "服务号名称。",
            "required": false,
            "type": "string",
            "maxLength": 15,
            "minLength": 1
          },
          {
            "name": "state",
            "in": "query",
            "description": "服务号状态。 \n- 1:未生效 \n- 2:已生效 \n- 3:已失效 \n- 4:已冻结\n",
            "required": false,
            "type": "integer",
            "maximum": 4,
            "minimum": 1
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "开始上线时间,格式为:yyyy-MM-ddTHH:mm:ssZ。",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,表示从此偏移量开始查询,offset大于等于0。",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 214748364,
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量。",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 100,
            "minimum": 1
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "结束上线时间,格式为:yyyy-MM-ddTHH:mm:ssZ。",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "industry",
            "in": "query",
            "description": "服务号所属行业。\n- 1:金融理财\n- 2:社交通讯\n- 3:影音娱乐\n- 4:旅游出行\n- 5:购物\n- 6:本地生活\n- 7:运动健康\n- 8:教育培训\n- 9:新闻阅读\n- 10:运营商 \n- 11:其他\n",
            "required": false,
            "type": "string",
            "maximum": 11,
            "minimum": 1
          },
          {
            "name": "approve_state",
            "in": "query",
            "description": "审核状态。\n\n- 1:审核中\n- 2:审核通过\n- 3:驳回\n",
            "required": false,
            "type": "integer"
          }
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "responses": {
          "200": {
            "description": "返回信息。",
            "examples": {
              "data": {
                "page_info": {
                  "offset": 0,
                  "limit": 1,
                  "total": 143
                },
                "data": [
                  {
                    "pub_id": "9405df1846a348e0b997d855bf80acc7",
                    "company_id": "6b3dd34b00e94326908720fa97f2b132",
                    "pub_remark": "K歌",
                    "oper_time": "2022-06-01T15:03:36Z",
                    "state": 1,
                    "online_time": "2022-06-07T14:08:09Z",
                    "pub_name": "轰趴馆-K歌",
                    "logo_img": "ab44b435b7a442a59e199735a9e3ce26",
                    "logo_url": "AimSauploadService/1dc408cff6b147a690f19732a42731273.png",
                    "authorization_files": {
                      "63e2a3d465744bf69cf0321bd3e9bfb2": "AimSauploadService/75356fb37c5b4067ba691ea2026ec69e3.png"
                    },
                    "auto_get_port": 1,
                    "industry": 1,
                    "pub_abstract": "我来一首天籁吧"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListPubInfosRsp"
            }
          },
          "400": {
            "description": "非法参数。",
            "schema": {
              "$ref": "#/definitions/AimSaErrorMsg"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/AimSaErrorMsg"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "Public",
        "x-request-examples-description-1": "查询服务号列表",
        "x-request-examples-url-1": "https://koomessage.myhuaweicloud.cn/v1/aim-sa/pubs"
      }
    }
  },
