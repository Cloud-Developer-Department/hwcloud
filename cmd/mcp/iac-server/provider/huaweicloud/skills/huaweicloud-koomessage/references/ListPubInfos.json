        "auto_get_port": {
          "type": "integer",
          "example": 0,
          "description": "是否授权系统自动收集端口。 \n\n- 0:否 \n- 1:是\n\n"
        },
        "industry": {
          "type": "integer",
          "example": 0,
          "description": "从事行业,默认取服务号所属商家的行业分类。 \n- 1:金融理财 \n- 2:社交通讯 \n- 3:影音娱乐 \n- 4:旅游出行 \n- 5:购物 \n- 6:本地生活 \n- 7:运动健康 \n- 8:教育培训 \n- 9:新闻阅读 \n- 10:运营商 \n- 11:其他\n\n"
        },
        "pub_abstract": {
          "type": "string",
          "example": "综合管理中心简介",
          "description": "服务号简介。"
        },
        "signs_for_auto_get_port": {
          "type": "array",
          "description": "自动收集端口使用的签名列表。\n\n> auto_get_port为1时,该字段为必填,每个签名长度为2-18个字符,每个服务号签名不可以重复。\n",
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 0
        },
        "company_id": {
          "type": "string",
          "description": "企业ID。"
        },
        "pub_remark": {
          "type": "string",
          "description": "服务号备注。"
        },
        "approve_state": {
          "type": "integer",
          "example": 3,
          "description": "审核状态。\n- 1:审核中\n- 2:审核通过\n- 3:驳回\n"
        },
        "areas_for_auto_get_port": {
          "type": "array",
          "description": "自动收集端口生效的地区列表。地区取值见《地区名称列表》。\n",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "服务号详情。"
    },
    "ListPubInfosRsp": {
      "properties": {
