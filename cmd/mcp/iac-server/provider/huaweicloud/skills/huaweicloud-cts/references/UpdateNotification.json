  "definitions": {
    "Filter": {
      "description": "关键操作通知高级筛选条件。",
      "properties": {
        "condition": {
          "type": "string",
          "description": "多条件关系。\n- AND 表示所有过滤条件满足后生效。\n- OR 表示有任意一个条件满足时生效。",
          "enum": [
            "AND",
            "OR"
          ]
        },
        "is_support_filter": {
          "type": "boolean",
          "description": "是否打开高级筛选开关。"
        },
        "rule": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": "[“trace_rating != normal\", \"resource_id = xxx\"]",
          "description": "高级过滤条件规则,示例如下:\"key != value\",格式为:字段 规则 值。\n-字段取值范围:api_version,code,trace_rating,trace_type,resource_id,resource_name。\n-规则:!= 或 =。\n- 值:api_version正则约束:^(a-zA-Z0-9_-.){1,64}$;code:最小长度1,最大长度256;trace_rating枚举值:\"normal\", \"warning\", \"incident\";trace_type枚举值:\"ConsoleAction\", \"ApiCall\", \"SystemAction\";resource_id:最小长度1,最大长度350;resource_name:最小长度1,最大长度256"
        }
      },
      "required": [
        "condition",
        "is_support_filter",
        "rule"
      ]
    },
    "UpdateNotificationResponseBody": {
      "properties": {
        "notification_name": {
          "type": "string",
          "description": "标识关键操作名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "operation_type": {
          "type": "string",
          "description": "标识操作类型。\n目前支持的操作类型有完整类型(complete)和自定义类型(customized)。\n完整类型下,CTS发送通知的对象为已对接服务的所有事件。\n自定义类型下,CTS发送通知的对象是在operations列表中指定的事件。",
          "enum": [
            "customized",
            "complete"
          ]
        },
        "agency_name": {
          "type": "string",
          "description": "云服务委托名称。",
          "maxLength": 32,
          "minLength": 1,
          "example": "cts_admin_trust",
          "enum": [
            "cts_admin_trust"
          ]
        },
        "operations": {
          "$ref": "#/definitions/OperationsList"
        },
        "notify_user_list": {
          "$ref": "#/definitions/NotificationUserList"
        },
        "status": {
          "type": "string",
          "description": "标识关键操作通知状态,包括正常(enabled),停止(disabled)两种状态。",
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "topic_id": {
          "type": "string",
          "description": "消息通知服务的topic_urn或者函数工作流的func_urn。\n- 消息通知服务的topic_urn可以通过消息通知服务的查询主题列表API获取,示例:urn:smn:regionId:f96188c7ccaf4ffba0c9aa149ab2bd57:test_topic_v2。\n- 函数工作流的func_urn可以通过函数工作流的获取函数列表API获取,示例:urn:fss:xxxxxxxxx:7aad83af3e8d42e99ac194e8419e2c9b:function:default:test。",
          "minLength": 0,
          "maxLength": 128
        },
        "notification_id": {
          "type": "string",
          "description": "关键操作通知的唯一标识。",
          "minLength": 1,
          "maxLength": 40
        },
        "notification_type": {
          "type": "string",
          "description": "关键操作通知类型,根据topic_id区分为消息通知服务(smn)和函数工作流(fun)。",
          "enum": [
            "smn",
            "fun"
          ]
        },
        "project_id": {
          "type": "string",
          "description": "项目ID。",
          "minLength": 32,
          "maxLength": 32
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "description": "关键操作通知创建时间戳。",
          "minimum": 946656000000,
          "exclusiveMinimum": true,
          "exclusiveMaximum": true,
          "maximum": 4102416000000
        },
        "filter": {
          "description": "关键操作通知高级筛选条件。",
          "$ref": "#/definitions/Filter"
        }
      }
    },
    "OperationsList": {
      "description": "操作事件列表。",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Operations"
      }
    },
    "Operations": {
      "properties": {
        "service_type": {
          "type": "string",
          "description": "标识云服务类型。必须为已对接CTS的云服务的英文缩写,且服务类型一般为大写字母。\n已对接的云服务列表参见《云审计服务用户指南》“支持的服务”章节。",
          "minLength": 1,
          "maxLength": 64
        },
        "resource_type": {
          "type": "string",
          "description": "标识资源类型。",
          "minLength": 1,
          "maxLength": 64
        },
        "trace_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "标识事件名称。",
          "minItems": 1,
          "maxItems": 64
        }
      },
      "description": "操作事件列表,目前最多支持对100服务的1000个关键操作进行配置。",
      "required": [
        "service_type",
        "resource_type",
        "trace_names"
      ]
    },
    "NotificationUsers": {
      "description": "通知用户列表。",
      "properties": {
        "user_group": {
          "type": "string",
          "description": "IAM用户组。",
          "minLength": 1,
          "maxLength": 64
        },
        "user_list": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IAM用户。",
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "user_group",
        "user_list"
      ]
    },
    "FailedRsp": {
      "description": "失败时的返回对象。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码标识,CTS.XXX。",
          "type": "string",
          "minLength": 15,
          "maxLength": 15,
          "example": "CTS.0214"
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 0,
          "maxLength": 2048,
          "example": "The tracker does not exist."
        }
      }
    },
    "NotificationUserList": {
      "description": "通知用户列表,目前最多支持对10个用户组和50个用户发起的操作进行配置。",
      "type": "array",
      "items": {
        "$ref": "#/definitions/NotificationUsers"
      }
    },
    "UpdateNotificationRequestBody": {
      "properties": {
        "notification_name": {
          "type": "string",
          "description": "标识关键操作名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "operation_type": {
          "type": "string",
          "description": "标识操作类型。\n目前支持的操作类型有完整类型(complete)和自定义类型(customized)。\n完整类型下,CTS发送通知的对象为已对接服务的所有事件。\n自定义类型下,CTS发送通知的对象是在operations列表中指定的事件。",
          "enum": [
            "customized",
            "complete"
          ]
        },
        "agency_name": {
          "type": "string",
          "description": "云服务委托名称。\n参数值为\"cts_admin_trust\"时,修改追踪器会自动创建一个云服务委托:cts_admin_trust。",
          "maxLength": 32,
          "minLength": 1,
          "example": "cts_admin_trust",
          "enum": [
            "cts_admin_trust"
          ]
        },
        "operations": {
          "$ref": "#/definitions/OperationsList"
        },
        "notify_user_list": {
          "$ref": "#/definitions/NotificationUserList"
        },
        "status": {
          "type": "string",
          "description": "标识关键操作通知状态,包括正常(enabled),停止(disabled)两种状态。",
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "topic_id": {
          "type": "string",
          "description": "消息通知服务的topic_urn或者函数工作流的func_urn,当“status”字段为enabled时,该字段必填。\n- 消息通知服务的topic_urn可以通过消息通知服务的查询主题列表API获取,示例:urn:smn:regionId:f96188c7ccaf4ffba0c9aa149ab2bd57:test_topic_v2。\n- 函数工作流的func_urn可以通过函数工作流的获取函数列表API获取,示例:urn:fss:xxxxxxxxx:7aad83af3e8d42e99ac194e8419e2c9b:function:default:test。",
          "minLength": 0,
          "maxLength": 400
        },
        "notification_id": {
          "type": "string",
          "description": "关键操作通知id。",
          "minLength": 1,
          "maxLength": 40
        },
        "filter": {
          "description": "关键操作通知高级筛选条件。",
          "$ref": "#/definitions/Filter"
        }
      },
      "description": "修改关键操作通知规则的请求体。",
      "required": [
        "notification_name",
        "operation_type",
        "status",
        "notification_id"
      ]
    }
  },
