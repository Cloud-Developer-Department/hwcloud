{
  "name": "UpdateTracker",
  "summary": "修改追踪器",
  "tags": "追踪器管理",
  "productshort": "CTS",
  "region_id": "la-north-2",
  "paths": {
    "/v3/{project_id}/tracker": {
      "put": {
        "x-order": 2,
        "tags": [
          "追踪器管理"
        ],
        "summary": "修改追踪器",
        "description": "云审计服务支持修改已创建追踪器的配置项,包括OBS桶转储、关键事件通知、事件转储加密、通过LTS对管理类事件进行检索、事件文件完整性校验以及追踪器启停状态等相关参数,修改追踪器对已有的操作记录没有影响。修改追踪器完成后,系统立即以新的规则开始记录操作。",
        "operationId": "UpdateTracker",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,参见《云审计服务API参考》“获取账号ID和项目ID”章节。",
            "required": true,
            "type": "string",
            "maxLength": 40,
            "minLength": 15,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "in": "body",
            "name": "UpdateTrackerRequestBody",
            "description": "标示OBS桶名称,来自于OBS服务真实存在的桶。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateTrackerRequestBody"
            }
          }
        ],
        "x-request-examples-url-1": "PUT https://{endpoint}/v3/{project_id}/tracker",
        "x-request-examples-1": {
          "tracker_type": "system",
          "tracker_name": "system",
          "obs_info": {
            "is_obs_created": false,
            "bucket_name": "saveTraceBucketNew",
            "file_prefix_name": "2020_01_01"
          },
          "is_support_trace_files_encryption": false,
          "kms_id": "",
          "is_lts_enabled": false,
          "is_support_validate": false,
          "status": "disabled"
        },
        "x-request-examples-text-1": "{\n  \"tracker_type\": \"system\",\n  \"tracker_name\": \"system\",\n  \"obs_info\": {\n    \"is_obs_created\": false,\n    \"bucket_name\": \"test-data-tracker\",\n    \"file_prefix_name\": \"11\"\n},\n  \"is_lts_enabled\": false,\n  \"is_support_trace_files_encryption\": false,\n  \"kms_id\": \"\",\n  \"is_support_validate\": false,\n  \"status\": \"enabled\"\n}",
        "x-request-examples-description-1": "管理类追踪器修改样例。",
        "x-request-examples-2": {
          "tracker_type": "data",
          "tracker_name": "data-tracker-name",
          "obs_info": {
            "is_obs_created": false,
            "bucket_name": "saveTraceBucket",
            "file_prefix_name": "11",
            "bucket_lifecycle": 30
          },
          "is_lts_enabled": true,
          "data_bucket": {
            "data_event": [
              "READ",
              "WRITE"
            ]
          }
        },
        "x-request-examples-text-2": "{\n \"tracker_type\": \"data\",\n \"tracker_name\": \"data-tracker-name\",\n \"obs_info\": {\n    \"is_obs_created\": false,\n    \"bucket_name\": \"\",\n    \"file_prefix_name\": \"\",\n    \"bucket_lifecycle\": 60\n  },\n  \"is_lts_enabled\": true,\n  \"data_bucket\": {\n    \"data_event\": [\n      \"READ\",\n      \"WRITE\"\n    ]\n  }\n}",
        "x-request-examples-description-2": "数据类追踪器修改样例。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "cts_api_0322",
        "x-open-region-cloud": "hk,hc,hcso,g42",
        "responses": {
          "200": {
            "description": "请求正常。"
          },
          "400": {
            "description": "服务器未能处理请求。",
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          },
          "401": {
            "description": "请求鉴权校验失败,访问被拒绝。"
          },
          "403": {
            "description": "请求权限校验失败,访问被禁止。"
          },
          "404": {
            "description": "服务器无法找到被请求的资源。"
          },
          "500": {
            "description": "服务内部异常,请求未完成。"
          },
          "503": {
            "description": " 被请求的服务无效。建议直接修改该请求,不要重试该请求。"
          }
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "DataBucket": {
      "properties": {
        "data_bucket_name": {
          "type": "string",
          "maxLength": 63,
          "minLength": 3,
          "description": "数据类追踪器追踪对象的桶名。\n- 当启用或者停用数据类追踪器时,该参数为必选。\n- 管理类追踪器无此参数。\n- 追踪器一旦创建追踪桶无法修改。"
        },
        "data_event": {
          "type": "array",
          "maxItems": 2,
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "WRITE",
              "READ"
            ],
            "example": "WRITE"
          },
          "description": "数据类追踪器追踪的操作类型。\n- 当启用或者停用数据类追踪器时,该参数为必选。\n- 管理类追踪器无此参数。"
        }
      }
    },
    "ManagementEventSelector": {
      "type": "object",
      "description": "管理类事件选择器。",
      "properties": {
        "exclude_service": {
          "type": "array",
          "description": "标识不转储的云服务名称。\n目前只支持设置为KMS,表示屏蔽KMS服务的createDatakey事件。",
          "example": "",
          "items": {
            "example": "KMS",
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "minItems": 0,
          "maxItems": 10
        }
      }
    },
    "UpdateTrackerRequestBody": {
      "required": [
        "tracker_type",
        "tracker_name"
      ],
      "properties": {
        "tracker_type": {
          "description": "标识追踪器类型。\n目前支持系统追踪器类型有管理类追踪器(system)和数据类追踪器(data)。\n数据类追踪器和管理类追踪器共同参数有:is_lts_enabled, obs_info;\n管理类追踪器参数:is_support_trace_files_encryption, kms_id, is_support_validate, is_support_validate;\n数据类追踪器参数:tracker_name, data_bucket。",
          "type": "string",
          "enum": [
            "system",
            "data"
          ],
          "x-example": "system",
          "x-order": 1
        },
        "tracker_name": {
          "type": "string",
          "description": "标识追踪器名称。\n当\"tracker_type\"参数值为\"system\"时该参数为默认值\"system\"。\n当\"tracker_type\"参数值为\"data\"时该参数需要指定追踪器名称\"。",
          "maxLength": 64,
          "minLength": 1,
          "example": "data-tracker-name",
          "x-order": 2
        },
        "agency_name": {
          "type": "string",
          "description": "云服务委托名称。\n参数值为\"cts_admin_trust\"时,更新追踪器会自动创建一个云服务委托:cts_admin_trust。",
          "maxLength": 32,
          "minLength": 1,
          "example": "cts_admin_trust",
          "enum": [
            "cts_admin_trust"
          ]
        },
        "status": {
          "type": "string",
          "description": "标识追踪器状态,该接口中可修改的状态包括正常(enabled)和停止(disabled)。如果选择修改状态为停止,则修改成功后追踪器停止记录事件。",
          "enum": [
            "enabled",
            "disabled"
          ],
          "example": "disabled",
          "x-order": 3
        },
        "is_organization_tracker": {
          "type": "boolean",
          "description": "是否应用到我的组织。\n只针对管理类追踪器。设置为true时,ORG组织下所有成员当前区域的审计日志会转储到该追踪器配置的OBS桶或者LTS日志流,但是事件列表界面不支持查看其它组织成员的审计日志。",
          "default": false
        },
        "management_event_selector": {
          "$ref": "#/definitions/ManagementEventSelector"
        },
        "is_lts_enabled": {
          "type": "boolean",
          "description": "是否打开事件分析。",
          "example": true,
          "x-order": 4
        },
        "obs_info": {
          "$ref": "#/definitions/TrackerObsInfo",
          "description": "转储桶配置",
          "x-order": 5
        },
        "is_support_trace_files_encryption": {
          "type": "boolean",
          "description": "事件文件转储加密功能开关。\n当\"tracker_type\"参数值为\"system\"时该参数值有效。\n该参数必须与kms_id参数同时使用。",
          "example": true,
          "x-order": 6
        },
        "kms_id": {
          "type": "string",
          "description": "事件文件转储加密所采用的秘钥id(从KMS获取)。\n当\"tracker_type\"参数值为\"system\"时该参数值有效。\n当\"is_support_trace_files_encryption\"参数值为“是”时,此参数为必选项。",
          "maxLength": 200,
          "minLength": 0,
          "example": "13a4207c-7abe-4b68-8510-16b84c3b5504",
          "x-order": 7
        },
        "is_support_validate": {
          "type": "boolean",
          "description": "事件文件转储时是否打开事件文件校验。\n当\"tracker_type\"参数值为\"system\"时该参数值有效。",
          "example": true,
          "x-order": 8
        },
        "data_bucket": {
          "$ref": "#/definitions/DataBucket",
          "description": "追踪桶配置信息。\n当\"tracker_type\"参数值为\"data\"时该参数值有效。"
        }
      }
    },
    "TrackerObsInfo": {
      "description": "转储桶信息。",
      "properties": {
        "bucket_name": {
          "type": "string",
          "description": "标识OBS桶名称。由数字或字母开头,支持小写字母、数字、“-”、“.”,长度为3~63个字符。",
          "maxLength": 63,
          "minLength": 3,
          "example": "obs-f1da"
        },
        "file_prefix_name": {
          "type": "string",
          "description": "标识需要存储于OBS的日志文件前缀,0-9,a-z,A-Z,'-','.','_'长度为0~64字符。",
          "maxLength": 64,
          "minLength": 0,
          "example": "yO8Q"
        },
        "is_obs_created": {
          "type": "boolean",
          "description": "是否支持新建OBS桶。\n  值为“true”时,表示新创建OBS桶存储事件文件;\n  值为“false”时,选择已存在的OBS桶存储事件文件。",
          "example": "true"
        },
        "bucket_lifecycle": {
          "type": "integer",
          "description": "标识配置桶内对象存储周期。\n当\"tracker_type\"参数值为\"data\"时该参数值有效。",
          "minimum": 0,
          "maximum": 5000,
          "example": "30"
        },
        "compress_type": {
          "type": "string",
          "description": "压缩类型。包括不压缩(json),压缩(gzip)两种状态。默认为gzip格式。",
          "default": "gzip",
          "enum": [
            "gzip",
            "json"
          ]
        },
        "is_sort_by_service": {
          "type": "boolean",
          "description": "路径按云服务划分,打开后转储文件路径中将增加云服务名。默认为true。",
          "default": true
        }
      }
    },
    "FailedRsp": {
      "description": "失败时的返回对象。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码标识,CTS.XXX。",
          "type": "string",
          "minLength": 15,
          "maxLength": 15,
          "example": "CTS.0214"
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 0,
          "maxLength": 2048,
          "example": "The tracker does not exist."
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cts.la-north-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "put",
  "uri": null
}