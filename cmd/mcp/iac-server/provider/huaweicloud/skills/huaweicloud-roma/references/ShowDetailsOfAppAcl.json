{
  "name": "ShowDetailsOfAppAcl",
  "summary": "查看APP的访问控制详情",
  "tags": "客户端配置",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/apps/{app_id}/app-acl": {
      "get": {
        "summary": "查看APP的访问控制详情",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-order": 11,
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "description": "查看APP的访问控制详情。",
        "schemes": [
          "https"
        ],
        "tags": [
          "客户端配置"
        ],
        "operationId": "ShowDetailsOfAppAcl",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_app_id"
          }
        ],
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/AppAclInfo"
            },
            "examples": {
              "application/json": {
                "app_id": "9ed8b7fe84224de681e7d7a5587e76dc",
                "app_acl_type": "PERMIT",
                "app_acl_values": [
                  "192.168.0.1",
                  "192.168.0.5-192.168.0.10",
                  "192.168.0.100/28"
                ]
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:app_id. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3004",
                "error_msg": "App 9ed8b7fe84224de681e7d7a5587e76dc does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "AppAclInfo": {
      "properties": {
        "app_id": {
          "description": "APP编号",
          "type": "string"
        },
        "app_acl_type": {
          "description": "类型\n-  PERMIT (白名单类型)\n-  DENY (黑名单类型)",
          "type": "string"
        },
        "app_acl_values": {
          "type": "array",
          "description": "ACL策略值,支持IP、IP范围和CIDR方式。IP范围以英文中划线分隔。",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_app_id": {
      "name": "app_id",
      "in": "path",
      "type": "string",
      "description": "应用编号",
      "required": true,
      "x-example": "98df09fb-d459-4cbf-83a7-2b55ca6f3d5d",
      "pattern": "^[a-zA-Z0-9-_]{0,64}$"
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID",
      "required": true,
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
      "required": true,
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}