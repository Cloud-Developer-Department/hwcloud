    "LdApiParameter": {
      "description": "后端API请求参数",
      "required": [
        "name",
        "in"
      ],
      "properties": {
        "name": {
          "description": "参数名称:\n- 参数位于Headers、 Parameters时,用户自行定义,支持英文、数字、点、中划线、下划线,且需要英文开头,不区分大小写。\n- 参数位于Body时候,参数以application/json、application/xml、application/text为名,但实际是以请求body里的键值对作为参数名和参数值,比如请求消息样例,参数名为application/json,参数值为{\\\"table\\\":\\\"apic01\\\",\\\"id\\\":\\\"1\\\"},后端取table:apic01,id:1这两个键值对作为入参。\n- 注意:定义参数不要重名,否则会覆盖掉,当Headers、Parameters重复时候,Parameters会被覆盖,当Parameters和Body里的键值对重复时候,Parameters会被覆盖。",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z][a-zA-Z0-9._\\\\/-]{0,31}$"
        },
        "in": {
          "description": "该参数在调用API时候所放的位置:\n- Headers :放于请求头\n- Parameters :放于请求参数\n- Body:放于请求体",
          "type": "string",
          "enum": [
            "Headers",
            "Parameters",
            "Body"
          ]
        },
        "default": {
          "description": "参数默认值",
          "type": "string",
          "maxLength": 4000
        },
        "description": {
          "description": "参数描述\n\n不支持<,>字符",
          "type": "string",
          "minLength": 0,
          "maxLength": 255
        },
        "required": {
          "description": "参数是否必须。true:必须,false:不必须",
          "type": "boolean",
          "default": false
        }
      }
    },
