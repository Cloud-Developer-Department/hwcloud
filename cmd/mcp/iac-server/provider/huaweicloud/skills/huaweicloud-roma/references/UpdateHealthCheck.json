  "definitions": {
    "VpcHealthConfigInfo": {
      "description": "健康检查详情。",
      "allOf": [
        {
          "$ref": "#/definitions/VpcHealthConfig"
        },
        {
          "type": "object",
          "properties": {
            "vpc_channel_id": {
              "description": "VPC通道的编号",
              "type": "string"
            },
            "id": {
              "description": "健康检查的编号",
              "type": "string"
            },
            "create_time": {
              "description": "创建时间",
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "VpcHealthConfig": {
      "description": "健康检查详情。",
      "required": [
        "timeout"
      ],
      "allOf": [
        {
          "$ref": "#/definitions/VpcHealthConfigBase"
        },
        {
          "type": "object",
          "properties": {
            "timeout": {
              "description": "超时时间:检查期间,无响应的时间,单位为秒。必须小于time_interval字段取值。",
              "minimum": 2,
              "maximum": 30,
              "type": "integer",
              "format": "int32"
            }
          }
        }
      ]
    },
    "VpcHealthConfigBase": {
      "required": [
        "protocol",
        "threshold_normal",
        "threshold_abnormal",
        "time_interval"
      ],
      "properties": {
        "protocol": {
          "description": "使用以下协议,对VPC中主机执行健康检查:\n- TCP\n- HTTP\n- HTTPS",
          "enum": [
            "TCP",
            "HTTP",
            "HTTPS"
          ],
          "type": "string"
        },
        "path": {
          "description": "健康检查时的目标路径。protocol = http或https时必选",
          "type": "string"
        },
        "method": {
          "description": "健康检查时的请求方法",
          "enum": [
            "GET",
            "HEAD"
          ],
          "default": "GET",
          "type": "string"
        },
        "port": {
          "description": "健康检查的目标端口,缺少或port = 0时为VPC中主机的端口号。\n\n若此端口存在非0值,则使用此端口进行健康检查。",
          "minimum": 0,
          "maximum": 65535,
          "type": "integer",
          "format": "int32"
        },
        "threshold_normal": {
          "description": "正常阈值。判定VPC通道中主机正常的依据为:连续检查x成功,x为您设置的正常阈值。",
          "minimum": 1,
          "maximum": 10,
          "type": "integer",
          "format": "int32"
        },
        "threshold_abnormal": {
          "description": "异常阈值。判定VPC通道中主机异常的依据为:连续检查x失败,x为您设置的异常阈值。",
          "minimum": 1,
          "maximum": 10,
          "type": "integer",
          "format": "int32"
        },
        "time_interval": {
          "description": "间隔时间:连续两次检查的间隔时间,单位为秒。必须大于timeout字段取值。",
          "minimum": 5,
          "maximum": 300,
          "type": "integer",
          "format": "int32"
        },
        "http_code": {
          "description": "检查目标HTTP响应时,判断成功使用的HTTP响应码。取值范围为100到599之前的任意整数值,支持如下三种格式:\n- 多个值,如:200,201,202\n- 一系列值,如:200-299\n- 组合值,如:201,202,210-299\nprotocol = http时必选",
          "type": "string"
        },
        "enable_client_ssl": {
          "description": "是否开启双向认证。若开启,则使用实例配置中的backend_client_certificate配置项的证书",
          "type": "boolean",
          "default": false
        },
        "status": {
          "description": "健康检查状态\n  - 1:可用\n  - 2:不可用",
          "enum": [
            1,
            2
          ],
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    }
