{
  "name": "ShowDataourceDetail",
  "summary": "查询指定数据源",
  "tags": "数据源管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/fdi/instances/{instance_id}/datasources/{datasource_id}": {
      "get": {
        "tags": [
          "数据源管理"
        ],
        "operationId": "ShowDataourceDetail",
        "summary": "查询指定数据源",
        "description": "根据数据源id查询数据源",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "public",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/instance_id"
          },
          {
            "$ref": "#/parameters/datasource_id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/DataSourceRsp"
            }
          },
          "400": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorRsp404"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorRsp500"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "DataSourceRsp": {
      "description": "数据源",
      "properties": {
        "datasource_id": {
          "type": "string",
          "description": "数据源ID",
          "minLength": 4,
          "maxLength": 64,
          "example": "acb3b4049bb643e39ca12a87a735b34d"
        },
        "datasource_name": {
          "type": "string",
          "description": "数据源名称",
          "minLength": 4,
          "maxLength": 255,
          "example": "fdi_ds_y3k674"
        },
        "datasource_type": {
          "type": "string",
          "description": "数据源类型\n- DWS\n- MYSQL\n- KAFKA\n- API\n- OBS\n- SAP\n- MRSHBASE\n- MRSHDFS\n- MRSHIVE\n- WEBSOCKET\n- SQLSERVER\n- ORACLE\n- POSTGRESQL\n- REDIS\n- MONGODB\n- DIS\n- HL7\n- RABBITMQ\n- SNMP\n- IBMMQ\n- CUSTOMIZED (自定义类型)\n- ACTIVEMQ\n- ARTEMISMQ\n- FTP\n- HIVE\n- HANA\n- FIKAFKA\n- MRSKAFKA\n- FIHDFS\n- FIHIVE\n- GAUSS200\n- GAUSS100\n- LDAP\n- DB2\n- TAURUS",
          "enum": [
            "DWS",
            "MYSQL",
            "KAFKA",
            "API",
            "OBS",
            "SAP",
            "MRSHBASE",
            "MRSHDFS",
            "MRSHIVE",
            "WEBSOCKET",
            "SQLSERVER",
            "ORACLE",
            "POSTGRESQL",
            "REDIS",
            "MONGODB",
            "DIS",
            "HL7",
            "RABBITMQ",
            "SNMP",
            "IBMMQ",
            "CUSTOMIZED",
            "ACTIVEMQ",
            "ARTEMISMQ",
            "FTP",
            "HIVE",
            "HANA",
            "FIKAFKA",
            "MRSKAFKA",
            "FIHDFS",
            "FIHIVE",
            "GAUSS200",
            "GAUSS100",
            "LDAP",
            "DB2",
            "TAURUS"
          ],
          "minLength": 1,
          "maxLength": 32,
          "example": "MYSQL"
        },
        "vpc_id": {
          "type": "string",
          "description": "数据源所属虚拟私有云VpcId",
          "minLength": 4,
          "maxLength": 64,
          "example": "456a0f01-c250-49db-a401-d1b28ada1dbc"
        },
        "app_id": {
          "type": "string",
          "description": "数据源所属应用ID",
          "minLength": 4,
          "maxLength": 255,
          "example": "9dbd2cd2-9622-4a1b-ad47-31018cf44cbd"
        },
        "app_name": {
          "type": "string",
          "description": "数据源所属应用名称",
          "minLength": 4,
          "maxLength": 255,
          "example": "app-fdi-autotest-noOperation"
        },
        "instance_id": {
          "type": "string",
          "description": "数据源所属实例Id",
          "minLength": 4,
          "maxLength": 255,
          "example": "fae7ff6c-8e07-4cf8-9e67-589cab2f017c"
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "description": "数据源创建时间",
          "minimum": 0,
          "maximum": 99999999999999999,
          "example": 1602206622829
        },
        "update_time": {
          "type": "integer",
          "format": "int64",
          "description": "数据源修改时间",
          "minimum": 0,
          "maximum": 99999999999999999,
          "example": 1605119892050
        },
        "custom_plugin_id": {
          "type": "string",
          "description": "数据源所属连接器Id",
          "minLength": 0,
          "maxLength": 64,
          "example": "299ae55f-c97f-41ef-8989-0689f0e97572"
        },
        "content": {
          "description": "数据源详细信息",
          "$ref": "#/definitions/Content"
        },
        "description": {
          "type": "string",
          "description": "数据源描述",
          "minLength": 4,
          "maxLength": 2147483647,
          "example": "fdi_auto_test"
        },
        "app_permission": {
          "type": "array",
          "description": "集成应用权限信息\n- read (读权限)\n- access (调用权限)\n- delete (删除权限)\n- modify (修改权限)",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "read",
              "access",
              "delete",
              "modify"
            ]
          },
          "example": [
            "read",
            "access",
            "delete",
            "modify"
          ]
        }
      }
    },
    "ApiAuthDetail": {
      "description": "api鉴权字段",
      "properties": {
        "auth_method": {
          "type": "string",
          "description": "访问API服务的认证方式\n- none\n- basicauth\n- oauth2.0\n- hmac\n- secret\n- md5\n- apiGateway\n- keyTop\n- hikVision\n- huaweiNetworkManagement\n- liHe",
          "enum": [
            "none",
            "basicauth",
            "oauth2.0",
            "hmac",
            "secret",
            "md5",
            "apiGateway",
            "keyTop",
            "hikVision",
            "huaweiNetworkManagement",
            "liHe"
          ],
          "minLength": 0,
          "maxLength": 256,
          "example": "apiGateway"
        },
        "app_auth_type": {
          "type": "string",
          "description": "访问API服务的APP认证方式,认证方式为(apiGateway)时填写\n- default\n- secret\n- jwt",
          "enum": [
            "default",
            "secret",
            "jwt"
          ],
          "minLength": 0,
          "maxLength": 2000,
          "example": "default"
        },
        "user_name": {
          "type": "string",
          "description": "访问API服务的用户名\n- 认证方式为(lihe、huaweiNetworkManagement、basicauth)时填写",
          "minLength": 4,
          "maxLength": 2000,
          "example": "fditest"
        },
        "password": {
          "type": "string",
          "description": "访问API服务的密码\n- 认证方式为(lihe、huaweiNetworkManagement、basicauth、secret、md5、hmac)时填写",
          "minLength": 4,
          "maxLength": 2000
        },
        "app_key": {
          "type": "string",
          "description": "访问API服务的AppKey\n- 认证方式为(apiGateway、oauth2.0)时填写",
          "minLength": 0,
          "maxLength": 256,
          "example": "44f7ba81-18cb-430e-9815-aca2526da72f"
        },
        "app_secret": {
          "type": "string",
          "description": "访问API服务的AppSecret\n- 认证方式为(apiGateway、oauth2.0)时填写",
          "minLength": 0,
          "maxLength": 256,
          "example": "***"
        },
        "secret": {
          "type": "string",
          "description": "访问API服务的Secret\n- 认证方式为(KeyTop、HikVision、Secret、HMAC、MD5)时填写",
          "minLength": 0,
          "maxLength": 256,
          "example": "12345"
        },
        "alt_ip": {
          "type": "string",
          "description": "访问API服务的备用IP\n- 认证方式为(HuaweiNetworkManagement)时填写",
          "minLength": 0,
          "maxLength": 256,
          "example": "**.***.***.**"
        },
        "access_token_url": {
          "type": "string",
          "description": "访问API服务的AccessTokenUrl\n- 认证方式为(liHe、oauth2.0 huaweiNetworkManagement)时填写",
          "minLength": 0,
          "maxLength": 256,
          "example": "https://8af8c5285f724203ac676134dfca1716.apic.cn-north-7.huaweicloudapis.com/testvmall"
        },
        "client_id": {
          "type": "string",
          "description": "访问API服务的客户端标识\n- 认证方式为Oauth2时填写",
          "minLength": 0,
          "maxLength": 256,
          "example": "deeeeeeee"
        },
        "client_secret": {
          "type": "string",
          "description": "访问API服务的客户端密钥\n- 认证方式为Oauth2时填写",
          "minLength": 0,
          "maxLength": 256,
          "example": "deeeeeeee"
        },
        "scope": {
          "type": "string",
          "description": "访问API服务的Scope\n- 认证方式为(LiHe、Oauth2)时填写",
          "minLength": 0,
          "maxLength": 256,
          "example": "deeeeeeee"
        },
        "authorization": {
          "type": "string",
          "description": "访问API服务的Authorization\n- 认证方式为(LiHe)时填写",
          "minLength": 0,
          "maxLength": 256,
          "example": "hryrtrgrgrgrg"
        },
        "grant_type": {
          "type": "string",
          "description": "访问API服务的授权类型\n- 认证方式为(LiHe、Oauth2)时填写\n- client_credentials (oauth2.0使用)",
          "minLength": 0,
          "maxLength": 256,
          "example": "client_credentials"
        }
      }
    },
    "Content": {
      "properties": {
        "gauss100_version": {
          "type": "string",
          "description": "gauss100的版本号\n- V100R003C20\n- V300R001C00",
          "enum": [
            "V100R003C20",
            "V300R001C00"
          ],
          "minLength": 1,
          "maxLength": 64,
          "example": "V100R003C20"
        },
        "host": {
          "type": "string",
          "description": "主机IP地址\n- 数据源为DWS、HANA、RABBITMQ、SAP、SNMP、IBMMQ类型时需要配置。\n- 数据源为MYSQL、ORACLE、SQLSERVER、DB2、GAUSS200、GAUSS100、TAURUS、ARTEMISMQ、POSTGRESQL、HIVE类型且mode为default时需要配置。\n- 数据源为HL7类型且作为目标端(position为target)时需要配置。\n- 初始值为空,配置任务启动后生成host",
          "minLength": 4,
          "maxLength": 255
        },
        "port": {
          "type": "string",
          "description": "端口,端口号为0到65535\n- 数据源为DWS、HANA、RABBITMQ、SAP、SNMP、IBMMQ,obs类型时需要配置,\n- 数据源为MYSQL、ORACLE、SQLSERVER、DB2、GAUSS200、GAUSS100、TAURUS、ARTEMISMQ、POSTGRESQL、HIVE类型且mode为default时需要配置,\n- 数据源为HL7类型且作为目标端(position为target)时需要配置",
          "minLength": 1,
          "maxLength": 65535,
          "example": "3306"
        },
        "database_name": {
          "type": "string",
          "description": "数据库名称\n- 数据源为DWS、HANA、RABBITMQ、SAP、SNMP、IBMMQ,obs类型时需要配置,\n- 数据源为MYSQL、SQLSERVER、DB2、GAUSS200、GAUSS100、TAURUS、ARTEMISMQ、POSTGRESQL、HIVE类型且mode为default时需要配置,\n- 数据源为ORACLE类型且mode为(default、multiAddress)时需要配置",
          "minLength": 4,
          "maxLength": 2147483647,
          "example": "testfdi"
        },
        "redis_database": {
          "type": "string",
          "description": "REDIS数据源类型配置,数据库编号, 纯数字编码",
          "minLength": 1,
          "maxLength": 1000,
          "example": "123456"
        },
        "user_name": {
          "type": "string",
          "description": "访问服务的用户名\n- 数据源为MYSQL、DWS、FTP、ORACLE、MONGODB、HANA、SQLSERVER、DB2、GAUSS200、GAUSS100、TAURUS、ACTIVEMQ、ARTEMISMQ、POSTGRESQL、RABBITMQ、SAP、IBMMQ、HIVE类型时需要配置\n- 数据源为WEBSOCKET类型,认证方式(basicauth)时需要配置\n- 数据源为LDAP,安全认证类型(security_auth_type)为simple时需要配置",
          "minLength": 4,
          "maxLength": 2147483647,
          "example": "fditest"
        },
        "password": {
          "type": "string",
          "description": "访问服务的密码\n- 数据源为MYSQL、DWS、FTP、ORACLE、MONGODB、HANA、SQLSERVER、DB2、GAUSS200、GAUSS100、TAURUS、ACTIVEMQ、ARTEMISMQ、POSTGRESQL、RABBITMQ、SAP、IBMMQ、HIVE类型时需要配置\n- 数据源为WEBSOCKET,且认证方式(basicauth)时需要配置\n- 数据源为LDAP,且安全认证类型(security_auth_type)为simple时需要配置",
          "minLength": 4,
          "maxLength": 2147483647,
          "example": "123456"
        },
        "mode": {
          "type": "string",
          "description": "数据源连接模式\n- 数据源为DWS、MONGODB、REDIS、HANA时配置默认,\n- 数据源为MYSQL、SQLSERVER、DB2、GAUSS200、GAUSS100、TAURUS、POSTGRESQL、HIVE时配置(default,professional),\n- 数据源为ORACLE时配置专有的模式multiAddress\n- default (默认模式)\n- professional (专业模式)\n- multiAddress (多地址)",
          "enum": [
            "default",
            "professional",
            "multiAddress"
          ],
          "minLength": 4,
          "maxLength": 255,
          "example": "default"
        },
        "cdc_mode": {
          "type": "string",
          "description": "cdc模式,只有组合任务使用",
          "enum": [
            "xstream",
            "logminer"
          ],
          "minLength": 4,
          "maxLength": 10,
          "example": "logminer"
        },
        "multi_oracle_address": {
          "type": "array",
          "description": "ORACLE集群地址,当mode为multiAddress时需要配置",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/MultiOracleAddress"
          }
        },
        "oracle_service_name": {
          "type": "string",
          "description": "ORACLE集群服务名",
          "minLength": 4,
          "maxLength": 64,
          "example": "XE"
        },
        "ftp_connect_mode": {
          "type": "string",
          "description": "访问FTP服务的连接模式\n- active (主动模式)\n- passive (被动模式)",
          "enum": [
            "active",
            "passive"
          ],
          "minLength": 4,
          "maxLength": 2147483647,
          "example": "active"
        },
        "ftp_protocol": {
          "type": "string",
          "description": "访问FTP服务协议类型\n- sftp\n- ftp",
          "enum": [
            "sftp",
            "ftp"
          ],
          "minLength": 4,
          "maxLength": 2147483647,
          "example": "ftp"
        },
        "address": {
          "type": "string",
          "description": "地址\n- OBS (obs远端地址,obs数据源使用)\n- MONGODB (MONGODB数据源类型主机IP地址,多个IP:PORT, 使用\",\"隔开)\n- REDIS (redis服务地址,多个IP:PORT, 使用\",\"隔开)",
          "minLength": 0,
          "maxLength": 256,
          "example": "obs.sz-iep-1.hcs80-iep.com"
        },
        "ak": {
          "type": "string",
          "description": "Access Key ID\n- 数据源为OBS,DIS类型时需要配置",
          "minLength": 0,
          "maxLength": 256
        },
        "sk": {
          "type": "string",
          "description": "Secret Access Key\n- 数据源为OBS,DIS类型时需要配置",
          "minLength": 0,
          "maxLength": 256
        },
        "bucket_name": {
          "type": "string",
          "description": "桶名称,数据源为OBS时需要配置",
          "minLength": 0,
          "maxLength": 256,
          "example": "true"
        },
        "https": {
          "type": "boolean",
          "description": "是否使用https, 数据源为OBS时需要配置,一般默认使用",
          "minLength": 0,
          "maxLength": 10,
          "example": true
        },
        "url": {
          "type": "string",
          "description": "连接字符串,访问url\n- 数据源为API、LDAP、WEBSOCKE类型时需要配置,\n- 数据源为MYSQL、ORACLE、DB2、GAUSS200、GAUSS100、TAURUS、POSTGRESQL,且mode配置为professional专业时需要配置",
          "minLength": 0,
          "maxLength": 256,
          "example": "https://8af8c5285f724203ac676134dfca1716.apic.cn-north-7.huaweicloudapis.com/testvmall"
        },
        "api_method": {
          "type": "string",
          "description": "访问API请求方式\n- POST\n- PUT\n- DELETE\n- PATCH\n- GET",
          "enum": [
            "POST",
            "PUT",
            "DELETE",
            "PATCH",
            "GET"
          ],
          "minLength": 0,
          "maxLength": 10,
          "example": "POST"
        },
        "auth_method": {
          "type": "string",
          "description": "访问WEBSOCKET服务的认证方式\n- none\n- basicauth",
          "enum": [
            "none",
            "basicauth"
          ],
          "minLength": 0,
          "maxLength": 256,
          "example": "basicauth"
        },
        "api_auth_detail": {
          "description": "Api鉴权详细字段",
          "$ref": "#/definitions/ApiAuthDetail"
        },
        "broker": {
          "type": "string",
          "description": "KAFKA、ACTIVEMQ的服务器地址,多个IP:PORT, 使用\",\"分隔",
          "minLength": 0,
          "maxLength": 256
        },
        "ssl": {
          "type": "boolean",
          "description": "是否开启SSL认证\n- 连接MQS内网地址时,若MQS开启了SSL,请选择“是”",
          "example": true
        },
        "ssl_enable": {
          "type": "boolean",
          "description": "是否开启SSL认证\n- 数据源为KAFKA时需要配置,连接MQS内网地址时,若MQS同时开启了SSL与VPC内网明文访问,请选择“否”\n- 数据源为ARTEMISMQ、ACTIVEMQ、RABBITMQ、IBMMQ时需要配置,\n- 数据源为HL7时且作为源端时需要配置",
          "minLength": 0,
          "maxLength": 10,
          "example": true
        },
        "ssl_username": {
          "type": "string",
          "description": "SSL用户名/应用Key\n- 数据源为KAFKA且开启SSL认证时需要配置",
          "minLength": 0,
          "maxLength": 256,
          "example": "126715a2-8862-4e38-b353-668a20bf2261"
        },
        "ssl_password": {
          "type": "string",
          "description": "SSL密码/应用Secret\n- 数据源为KAFKA且开启SSL认证时需要配置",
          "minLength": 0,
          "maxLength": 256
        },
        "mongodb_auth_source": {
          "type": "string",
          "description": "MONGODB认证源",
          "minLength": 0,
          "maxLength": 60,
          "example": "admin"
        },
        "mongodb_cluster_enable": {
          "type": "boolean",
          "description": "MONGODB集群模式\n- true (集群模式)\n- false (非集群模式)",
          "minLength": 0,
          "maxLength": 256,
          "example": false
        },
        "mongodb_replica_set": {
          "type": "string",
          "description": "MONGODB副本集\n当MONGODB为非集群模式时配置",
          "minLength": 0,
          "maxLength": 256,
          "example": "test"
        },
        "encoding": {
          "type": "string",
          "description": "编码格式\n- 数据源为GAUSS200、GAUSS100、POSTGRESQL类型时配置\"big5\",\n- 数据源为MYSQL、TAURUS类型且mode为default时配置",
          "enum": [
            "big5",
            "dec8",
            "cp850",
            "hp8",
            "koi8r",
            "latin1",
            "latin2",
            "swe7",
            "ascii",
            "ujis",
            "sjis",
            "hebrew",
            "tis620",
            "koi8u",
            "gb2312",
            "greek",
            "cp1250",
            "gbk",
            "latin5",
            "armscii8",
            "utf8",
            "ucs2",
            "cp866",
            "keybcs2",
            "macce",
            "macroman",
            "cp852",
            "latin7",
            "utf8mb4",
            "cp1251",
            "utf16",
            "utf16le",
            "cp1256",
            "cp1257",
            "utf32",
            "binary",
            "geostd8",
            "cp932",
            "eucjpms",
            "gb18030"
          ],
          "minLength": 0,
          "maxLength": 10,
          "example": "big5"
        },
        "mysql_timeout": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 20000,
          "description": "MYSQL连接超时时间(秒)",
          "example": 1
        },
        "trust_store_password": {
          "type": "string",
          "description": "公钥库密码\n- 数据源类型为ACTIVEMQ、ARTEMISMQ、RABBITMQ、IBMMQ且开启SSL认证时需要配置\n- 数据源类为HL7且HL7为目标端(position为target)时,并且开启SSL认证时需要配置",
          "minLength": 0,
          "maxLength": 256,
          "example": "test"
        },
        "trust_store": {
          "type": "string",
