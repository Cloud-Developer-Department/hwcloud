  "definitions": {
    "AttachOrDetachDomainsReqBody": {
      "description": "证书批量绑定或解绑域名请求体",
      "required": [
        "domains"
      ],
      "properties": {
        "domains": {
          "description": "证书绑定或解绑域名列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/AttachOrDetachDomainInfo"
          }
        }
      }
    },
    "AttachOrDetachDomainInfo": {
      "description": "证书绑定或解绑域名信息。如果填了instance_id则只操作该实例下指定域名;如果不填instance_id则操作全局指定域名。",
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "description": "域名",
          "example": "apigtest.xxx.com"
        },
        "instance_ids": {
          "type": "array",
          "description": "实例ID集合",
          "items": {
            "type": "string"
          },
          "example": [
            "f0fa1789-3b76-433b-a787-9892951c620e",
            "7d39549681c54d968ec2910da9da95cd"
          ]
        },
        "verified_client_certificate_enabled": {
          "description": "是否开启客户端证书校验。当绑定证书存在trusted_root_ca时,默认开启;当绑定证书不存在trusted_root_ca时,默认关闭。",
          "type": "boolean",
          "example": false
        }
      }
    },
