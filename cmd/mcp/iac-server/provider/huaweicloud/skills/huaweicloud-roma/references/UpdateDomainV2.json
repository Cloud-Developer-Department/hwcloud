{
  "name": "UpdateDomainV2",
  "summary": "修改域名",
  "tags": "域名管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/api-groups/{group_id}/domains/{domain_id}": {
      "put": {
        "summary": "修改域名",
        "tags": [
          "域名管理"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-order": 3,
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "operationId": "UpdateDomainV2",
        "description": "修改绑定的域名所对应的配置信息。",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_group_id"
          },
          {
            "$ref": "#/parameters/apic_domain_id"
          },
          {
            "schema": {
              "$ref": "#/definitions/UrlDomainModify"
            },
            "in": "body",
            "name": "UpdateDomainV2RequestBody",
            "description": "修改域名的请求体",
            "required": true
          }
        ],
        "x-request-examples-description-1": "修改绑定的域名配置,最小SSL协议版本修改为TLSv1.2",
        "x-request-examples-1": {
          "min_ssl_version": "TLSv1.2"
        },
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/UrlDomainBaseInfo"
            },
            "examples": {
              "application/json": {
                "id": "0a515af69f4e4dcca84fbf85f68c0e27",
                "url_domain": "www.example.com",
                "status": 3,
                "min_ssl_version": "TLSv1.2",
                "is_http_redirect_to_https": false,
                "verified_client_certificate_enabled": false
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3474",
                "error_msg": "The API group ID in the URL does not match the API group to which the URL domain has been bound"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3020",
                "error_msg": "The URL domain does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "UrlDomainModify": {
      "required": [
        "min_ssl_version"
      ],
      "allOf": [
        {
          "$ref": "#/definitions/UrlDomainBase"
        },
        {
          "type": "object",
          "properties": {
            "verified_client_certificate_enabled": {
              "description": "是否开启客户端证书校验。只有绑定证书时,该参数才生效。当绑定证书存在trusted_root_ca时,默认开启;当绑定证书不存在trusted_root_ca时,默认关闭。",
              "type": "boolean",
              "default": false,
              "example": false
            }
          }
        }
      ]
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "UrlDomainBase": {
      "properties": {
        "min_ssl_version": {
          "description": "最小ssl协议版本号。支持TLSv1.1或TLSv1.2",
          "type": "string",
          "default": "TLSv1.1",
          "enum": [
            "TLSv1.1",
            "TLSv1.2"
          ],
          "example": "TLSv1.1"
        },
        "is_http_redirect_to_https": {
          "type": "boolean",
          "description": "是否开启http到https的重定向,false为关闭,true为开启,默认为false",
          "default": false,
          "example": true
        }
      }
    },
    "UrlDomainBaseInfo": {
      "required": [
        "id",
        "url_domain",
        "status",
        "min_ssl_version"
      ],
      "properties": {
        "url_domain": {
          "description": "自定义域名",
          "type": "string",
          "example": "www.example.com"
        },
        "id": {
          "description": "自定义域名的编号",
          "type": "string",
          "example": "b9be707660c5406394f8973e087bae20"
        },
        "status": {
          "description": "CNAME解析状态\n- 1: 未解析\n- 2: 解析中\n- 3: 解析成功\n- 4: 解析失败",
          "enum": [
            1,
            2,
            3,
            4
          ],
          "type": "integer",
          "format": "int32",
          "example": 3
        },
        "min_ssl_version": {
          "description": "支持的最小SSL版本",
          "type": "string",
          "example": "TLSv1.1"
        },
        "is_http_redirect_to_https": {
          "type": "boolean",
          "description": "是否开启http到https的重定向,false为关闭,true为开启,默认为false",
          "default": false,
          "example": true
        },
        "verified_client_certificate_enabled": {
          "description": "是否开启客户端证书校验。只有绑定证书时,该参数才生效。当绑定证书存在trusted_root_ca时,默认开启;当绑定证书不存在trusted_root_ca时,默认关闭。",
          "type": "boolean",
          "default": false,
          "example": false
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_domain_id": {
      "name": "domain_id",
      "in": "path",
      "type": "string",
      "description": "域名的编号",
      "required": true,
      "x-example": "f6bb84ccf1c34035878aa51b7253b21c"
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID",
      "required": true,
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
      "required": true,
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_group_id": {
      "name": "group_id",
      "in": "path",
      "type": "string",
      "description": "分组的编号",
      "required": true,
      "x-example": "c77f5e81d9cb4424bf704ef2b0ac7600"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "put",
  "uri": null
}