{
  "name": "ListDestinations",
  "summary": "查询目标数据源列表",
  "tags": "规则引擎",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/link/instances/{instance_id}/rules/{rule_id}/destinations": {
      "get": {
        "tags": [
          "规则引擎"
        ],
        "summary": "查询目标数据源列表",
        "operationId": "ListDestinations",
        "description": "查询目标数据源列表",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "public",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/instance_id"
          },
          {
            "$ref": "#/parameters/rule_id"
          },
          {
            "$ref": "#/parameters/limit"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,表示从此偏移量开始查询, offset大于等于0",
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 999999
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListDestinationsResponseBody"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ListDestinationsResponseBody": {
      "properties": {
        "total": {
          "type": "integer",
          "description": "总数",
          "minimum": 0,
          "maximum": 9999999999999999
        },
        "size": {
          "type": "integer",
          "description": "本次返回数量",
          "minimum": 0,
          "maximum": 999
        },
        "items": {
          "type": "array",
          "description": "目标数据源列表",
          "minItems": 0,
          "maxItems": 9999,
          "items": {
            "$ref": "#/definitions/Destination"
          }
        }
      }
    },
    "Error": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "系统错误码,针对4xx和5xx类HTTP错误码的详细错误码",
          "minLength": 0,
          "maxLength": 64
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 200
        },
        "request_id": {
          "type": "string",
          "description": "消息ID",
          "minLength": 0,
          "maxLength": 64
        }
      }
    },
    "Destination": {
      "example": {
        "destination_id": 27678,
        "destination_type": 7,
        "app_id": null,
        "destination_name": null,
        "topic": "8si8ST122893/in/214",
        "server": "server",
        "token": "token",
        "tag": "device",
        "mqs_sasl_ssl": "false",
        "user_name": null,
        "password": null
      },
      "properties": {
        "destination_id": {
          "type": "integer",
          "description": "目标数据源ID",
          "minimum": 1,
          "maximum": 999999999999999999
        },
        "destination_type": {
          "type": "integer",
          "format": "int32",
          "description": "操作类型,枚举值:0-目标端为本ROMA实例内MQS; 7-目标端为设备",
          "enum": [
            0,
            7
          ],
          "minimum": 0,
          "maximum": 10
        },
        "app_id": {
          "type": "string",
          "description": "应用ID,目标端为0时需明确对方的APP_ID",
          "minLength": 0,
          "maxLength": 64
        },
        "destination_name": {
          "type": "string",
          "description": "目标数据源名称",
          "minLength": 0,
          "maxLength": 64
        },
        "topic": {
          "type": "string",
          "description": "目标数据源主题",
          "minLength": 0,
          "maxLength": 64
        },
        "server": {
          "type": "string",
          "description": "目标端数据源服务",
          "minLength": 0,
          "maxLength": 200
        },
        "token": {
          "type": "string",
          "description": "目标端数据源token",
          "minLength": 0,
          "maxLength": 1000
        },
        "tag": {
          "type": "string",
          "description": "目标数据源标签",
          "minLength": 0,
          "maxLength": 200
        },
        "mqs_sasl_ssl": {
          "type": "boolean",
          "description": "目标端数据源MQS的SASL字段是否需要支持SSL加密"
        },
        "user_name": {
          "type": "string",
          "description": "目标数据源用户名",
          "minLength": 0,
          "maxLength": 80
        },
        "password": {
          "type": "string",
          "description": "目标数据源密码",
          "minLength": 0,
          "maxLength": 500
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方式请参见《ROMA Connect API参考》的“附录 > 获取项目ID”章节。",
      "type": "string",
      "required": true,
      "maxLength": 32,
      "minLength": 0
    },
    "rule_id": {
      "name": "rule_id",
      "in": "path",
      "description": "规则ID",
      "required": true,
      "type": "string",
      "maxLength": 20,
      "minLength": 0
    },
    "instance_id": {
      "name": "instance_id",
      "in": "path",
      "description": "实例ID",
      "type": "string",
      "required": true,
      "maxLength": 36,
      "minLength": 0
    },
    "limit": {
      "name": "limit",
      "in": "query",
      "description": "每页显示条目数量,最大数量999,超过999后只返回999",
      "type": "integer",
      "default": 10,
      "minimum": 0,
      "maximum": 999
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
