{
  "name": "ImportAsset",
  "summary": "导入资产",
  "tags": "ASSET_MANAGEMENT",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/instances/{instance_id}/assets/import": {
      "post": {
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "tags": [
          "ASSET_MANAGEMENT"
        ],
        "operationId": "ImportAsset",
        "summary": "导入资产",
        "description": "- 创建导入资产作业任务,资产版本和具体哪些资产从资产内容里读取\n- 最大支持100个应用和任务\n- 一个用户同一时刻只能创建一个资产导入作业任务,没有Running状态的作业任务存在",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 100000
          },
          {
            "type": "string",
            "name": "instance_id",
            "in": "path",
            "required": true,
            "minLength": 0,
            "maxLength": 64,
            "description": "实例ID"
          },
          {
            "type": "string",
            "name": "project_id",
            "in": "path",
            "required": true,
            "minLength": 0,
            "maxLength": 64,
            "description": "项目ID"
          },
          {
            "type": "file",
            "name": "ImportAssetRequestBody",
            "in": "formData",
            "required": true,
            "description": "资产压缩文件"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/AssetImportResp"
            },
            "examples": {
              "application/json": {
                "job_id": "ff8080814dbd65d7014dbe0d84db0013"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "ROMA.00000101",
                "error_msg": "error summary",
                "error_details": "some error details here",
                "request_id": "13760c1fe8655e61209b75665e9bef43"
              }
            }
          }
        },
        "x-apigateway-backend": {
          "httpEndpoints": {
            "address": "#roma-address#",
            "description": "",
            "method": "POST",
            "path": "/v2/{project_id}/instances/{instance_id}/assets/import",
            "scheme": "https",
            "timeout": 30000
          },
          "parameters": [
            {
              "description": "",
              "in": "PATH",
              "name": "instance_id",
              "origin": "REQUEST",
              "value": "instance_id"
            },
            {
              "description": "",
              "in": "PATH",
              "name": "project_id",
              "origin": "REQUEST",
              "value": "project_id"
            }
          ],
          "type": "HTTP"
        },
        "x-apigateway-cors": false,
        "x-apigateway-match-mode": "NORMAL",
        "x-apigateway-request-type": "public",
        "x-apigateway-ratelimit": "roma_asset_ratelimit",
        "x-support-sdk": "Y",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "ErrorResp": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "错误消息"
        },
        "error_details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "具体错误消息"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "请求处理ID"
        }
      },
      "example": {
        "error_code": "ROMA.00000101",
        "error_msg": "error summary",
        "error_details": "some error details here",
        "request_id": "13760c1fe8655e61209b75665e9bef43"
      }
    },
    "AssetImportResp": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "example": "ff8080814dbd65d7014dbe0d84db0013",
          "description": "资产导入作业的ID,可用于查询作业进度,获取导入作业进度"
        }
      }
    }
  },
  "version": "2.0",
