{
  "name": "ListSources",
  "summary": "查询源数据源列表",
  "tags": "规则引擎",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/link/instances/{instance_id}/rules/{rule_id}/sources": {
      "get": {
        "tags": [
          "规则引擎"
        ],
        "summary": "查询源数据源列表",
        "operationId": "ListSources",
        "description": "查询源数据源列表",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "public",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/instance_id"
          },
          {
            "$ref": "#/parameters/rule_id"
          },
          {
            "$ref": "#/parameters/limit"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,表示从此偏移量开始查询, offset大于等于0",
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 999999
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListSourcesResponseBody"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ListSourcesResponseBody": {
      "properties": {
        "total": {
          "type": "integer",
          "description": "总数",
          "minimum": 0,
          "maximum": 9999999999999999
        },
        "size": {
          "type": "integer",
          "description": "本次返回数量",
          "minimum": 0,
          "maximum": 999
        },
        "items": {
          "type": "array",
          "minItems": 0,
          "maxItems": 9999,
          "description": "数据源列表",
          "items": {
            "$ref": "#/definitions/Source"
          }
        }
      }
    },
    "Error": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "系统错误码,针对4xx和5xx类HTTP错误码的详细错误码",
          "minLength": 0,
          "maxLength": 64
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 200
        },
        "request_id": {
          "type": "string",
          "description": "消息ID",
          "minLength": 0,
          "maxLength": 64
        }
      }
    },
    "Source": {
      "example": {
        "source_id": 35296,
        "product_id": 122893,
        "device_id": 711568,
        "topic": "/v1/devices/214/datas",
        "device_name": "device",
        "product_name": "product",
        "is_base64": 0,
        "contain_device_info": 0
      },
      "properties": {
        "source_id": {
          "type": "integer",
          "description": "源数据源ID",
          "minimum": 1,
          "maximum": 999999999999999999
        },
        "product_id": {
          "type": "integer",
          "description": "产品ID",
          "minimum": 1,
          "maximum": 999999999999999999
        },
        "device_id": {
          "type": "integer",
          "description": "设备ID,不填为全部设备",
          "minimum": 1,
          "maximum": 999999999999999999
        },
        "topic": {
          "type": "string",
          "description": "主题,当设备ID为空时为产品级主题,设备ID不为空时为设备级主题",
          "minLength": 0,
          "maxLength": 200
        },
        "device_name": {
          "type": "string",
          "description": "设备名称",
          "minLength": 0,
          "maxLength": 64
        },
        "product_name": {
          "type": "string",
          "description": "产品名称",
          "minLength": 0,
          "maxLength": 64
        },
        "is_base64": {
          "type": "integer",
          "format": "int32",
          "description": "是否payload使用base64,0-是 1-否",
          "enum": [
            0,
            1
          ],
          "minimum": 0,
          "maximum": 10,
          "default": 1
        },
        "contain_device_info": {
          "type": "integer",
          "format": "int32",
          "description": "是否包含设备信息,0-是,1-否",
          "enum": [
            0,
            1
          ],
          "minimum": 0,
          "maximum": 10,
          "default": 1
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方式请参见《ROMA Connect API参考》的“附录 > 获取项目ID”章节。",
      "type": "string",
      "required": true,
      "maxLength": 32,
      "minLength": 0
    },
    "rule_id": {
      "name": "rule_id",
      "in": "path",
      "description": "规则ID",
      "required": true,
      "type": "string",
      "maxLength": 20,
      "minLength": 0
    },
    "instance_id": {
      "name": "instance_id",
      "in": "path",
      "description": "实例ID",
      "type": "string",
      "required": true,
      "maxLength": 36,
      "minLength": 0
    },
    "limit": {
      "name": "limit",
      "in": "query",
      "description": "每页显示条目数量,最大数量999,超过999后只返回999",
      "type": "integer",
      "default": 10,
      "minimum": 0,
      "maximum": 999
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}