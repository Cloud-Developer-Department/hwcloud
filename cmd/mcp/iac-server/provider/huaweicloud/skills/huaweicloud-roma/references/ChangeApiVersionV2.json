{
  "name": "ChangeApiVersionV2",
  "summary": "切换API版本",
  "tags": "API管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/apis/publish/{api_id}": {
      "put": {
        "summary": "切换API版本",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-order": 9,
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "tags": [
          "API管理"
        ],
        "description": "API每次发布时,会基于当前的API定义生成一个版本。版本记录了API发布时的各种定义及状态。\n\n多个版本之间可以进行随意切换。但一个API在一个环境上,只能有一个版本生效。",
        "operationId": "ChangeApiVersionV2",
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "required": true
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
            "x-example": "73d69ae0cfcf460190522d06b60f05ad",
            "required": true,
            "type": "string"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例编号",
            "x-example": "f0fa1789-3b76-433b-a787-9892951c620e",
            "required": true,
            "type": "string"
          },
          {
            "in": "path",
            "name": "api_id",
            "required": true,
            "description": "API的编号",
            "type": "string",
            "x-example": "5f918d104dc84480a75166ba99efff21"
          },
          {
            "in": "body",
            "name": "ChangeApiVersionV2RequestBody",
            "description": "API版本的编号",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ApiVersion"
            }
          }
        ],
        "x-request-examples-description-1": "切换API到指定的版本",
        "x-request-examples-1": {
          "version_id": "ee1a5a38d3d3493abf1dc4ed6cacfa0b"
        },
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/PublishResp"
            },
            "examples": {
              "application/json": {
                "publish_id": "9191cdb430724d4b8586ed7f1b962ca2",
                "api_id": "5f918d104dc84480a75166ba99efff21",
                "env_id": "DEFAULT_ENVIRONMENT_RELEASE_ID",
                "version_id": "ee1a5a38d3d3493abf1dc4ed6cacfa0b",
                "publish_time": "2020-08-03T03:27:49.483295655Z",
                "remark": ""
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2000",
                "error_msg": "Parameter error: Serialization error: unexpected end of JSON input"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3022",
                "error_msg": "The API version does not exist,id:ee1a5a38d3d3493abf1dc4ed6cacfa0b"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "PublishResp": {
      "properties": {
        "publish_id": {
          "description": "发布记录的ID",
          "type": "string",
          "example": "5b729aa252764739be2c37ef0d66dc63"
        },
        "api_id": {
          "description": "API编号",
          "type": "string",
          "example": "7addcd00cfab433984b1d8bf2fe08aaa"
        },
        "api_name": {
          "description": "API名称",
          "type": "string",
          "example": "api_name"
        },
        "env_id": {
          "description": "发布的环境编号",
          "type": "string",
          "example": "DEFAULT_ENVIRONMENT_RELEASE_ID"
        },
        "remark": {
          "description": "发布描述",
          "type": "string",
          "example": "string"
        },
        "publish_time": {
          "description": "发布时间",
          "type": "string",
          "format": "date-time",
          "example": "2018-07-26T13:18:04.1079916Z"
        },
        "version_id": {
          "description": "在线的版本号",
          "type": "string",
          "example": "3d9dcb733ba34352b0d02f85fd16b026"
        }
      }
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "ApiVersion": {
      "required": [
        "version_id"
      ],
      "properties": {
        "version_id": {
          "description": "API版本的编号",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "put",
  "uri": null
