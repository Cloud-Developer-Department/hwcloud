{
  "name": "UpdateEnvironmentV2",
  "summary": "修改环境",
  "tags": "环境管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/envs/{env_id}": {
      "put": {
        "summary": "修改环境",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-order": 2,
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "description": "修改指定环境的信息。其中可修改的属性为:name、remark,其它属性不可修改。",
        "schemes": [
          "https"
        ],
        "tags": [
          "环境管理"
        ],
        "operationId": "UpdateEnvironmentV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_env_id"
          },
          {
            "schema": {
              "$ref": "#/definitions/EnvCreate"
            },
            "in": "body",
            "name": "UpdateEnvironmentV2RequestBody",
            "description": "修改环境的请求体",
            "required": true
          }
        ],
        "x-request-examples-description-1": "修改指定环境的名称和描述信息",
        "x-request-examples-1": {
          "name": "DEV",
          "remark": "Development environment"
        },
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/EnvInfo"
            },
            "examples": {
              "application/json": {
                "create_time": "2020-07-31T06:41:43Z",
                "name": "DEV",
                "remark": "Development environment",
                "id": "7a1ad0c350844ee69479b47df9a881cb"
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:name. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3003",
                "error_msg": "Environment 7a1ad0c350844ee69479b47df9a881cb does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "EnvCreate": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "环境的名称,支持英文,数字,下划线,且只能以英文字母开头。",
          "maxLength": 64,
          "minLength": 3,
          "type": "string",
          "pattern": "^[a-zA-Z]{1,}([a-zA-Z0-9_])*$",
          "example": "DEV"
        },
        "remark": {
          "description": "描述信息\n> 中文字符必须为UTF-8或者unicode编码。",
          "maxLength": 255,
          "type": "string",
          "example": "开发环境"
        }
      }
    },
    "EnvInfo": {
      "properties": {
        "create_time": {
          "description": "创建时间",
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "description": "环境名称",
          "type": "string"
        },
        "remark": {
          "description": "描述信息",
          "type": "string"
        },
        "id": {
          "description": "环境编号",
          "type": "string"
        }
      }
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_env_id": {
      "name": "env_id",
      "in": "path",
      "type": "string",
      "description": "环境的ID",
      "required": true,
      "x-example": "7a1ad0c350844ee69479b47df9a881cb"
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID",
      "required": true,
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
      "required": true,
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "put",
  "uri": null
}