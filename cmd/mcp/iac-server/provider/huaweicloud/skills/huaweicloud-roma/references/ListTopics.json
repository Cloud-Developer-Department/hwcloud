{
  "name": "ListTopics",
  "summary": "查询设备主题",
  "tags": "设备管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/link/instances/{instance_id}/devices/{device_id}/topics": {
      "get": {
        "tags": [
          "设备管理"
        ],
        "summary": "查询设备主题",
        "operationId": "ListTopics",
        "description": "查询设备主题",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "public",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/instance_id"
          },
          {
            "$ref": "#/parameters/device_id"
          },
          {
            "$ref": "#/parameters/limit"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,表示从此偏移量开始查询, offset大于等于0",
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 999999
          },
          {
            "name": "name",
            "in": "query",
            "description": "topic名称",
            "type": "string",
            "minLength": 0,
            "maxLength": 100
          },
          {
            "name": "topic_permission",
            "in": "query",
            "description": "topic权限,0为发布,1为订阅",
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          {
            "name": "topic_type",
            "in": "query",
            "description": "topic类型,0为设备类topic,1为产品类topic",
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          {
            "name": "is_private",
            "in": "query",
            "description": "topic是否为自定义,0为基础topic,1为自定义topic",
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListTopicsResponseBody"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Error": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "系统错误码,针对4xx和5xx类HTTP错误码的详细错误码",
          "minLength": 0,
          "maxLength": 64
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 200
        },
        "request_id": {
          "type": "string",
          "description": "消息ID",
          "minLength": 0,
          "maxLength": 64
        }
      }
    },
    "ListTopicsResponseBody": {
      "properties": {
        "total": {
          "type": "integer",
          "description": "总数",
          "minimum": 1,
          "maximum": 99999
        },
        "size": {
          "type": "integer",
          "description": "本次返回数量",
          "minimum": 1,
          "maximum": 1000
        },
        "items": {
          "type": "array",
          "description": "主题列表",
          "minItems": 0,
          "maxItems": 9999,
          "items": {
            "$ref": "#/definitions/Topic"
          }
        }
      }
    },
    "Topic": {
      "example": {
        "id": 1528605,
        "name": "/v1/devices/device/datas",
        "description": "Device data report",
        "permission": 0,
        "isPrivate": 0
      },
      "properties": {
        "id": {
          "type": "integer",
          "description": "TOPIC的ID",
          "minimum": 1,
          "maximum": 999999999999999999
        },
        "name": {
          "description": "TOPIC的名称",
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "description": {
          "description": "TOPIC描述",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "permission": {
          "description": "TOPIC权限, 主题权限 0-发布 1-订阅",
          "type": "integer",
          "format": "int32",
          "enum": [
            0,
            1
          ],
          "minimum": 0,
          "maximum": 10
        },
        "is_private": {
          "type": "integer",
          "format": "int32",
          "description": "TOPIC类型 0-基础TOPIC 1-用户自定义TOPIC",
          "enum": [
            0,
            1
          ],
          "minimum": 0,
          "maximum": 10
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "device_id": {
      "name": "device_id",
      "in": "path",
      "description": "设备ID",
      "required": true,
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999999999999999
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方式请参见《ROMA Connect API参考》的“附录 > 获取项目ID”章节。",
      "type": "string",
      "required": true,
      "maxLength": 32,
      "minLength": 0
    },
    "instance_id": {
      "name": "instance_id",
      "in": "path",
      "description": "实例ID",
      "type": "string",
      "required": true,
      "maxLength": 36,
      "minLength": 0
    },
    "limit": {
      "name": "limit",
      "in": "query",
      "description": "每页显示条目数量,最大数量999,超过999后只返回999",
      "type": "integer",
      "default": 10,
      "minimum": 0,
      "maximum": 999
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}