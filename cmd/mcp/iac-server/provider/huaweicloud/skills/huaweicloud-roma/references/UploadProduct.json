{
  "name": "UploadProduct",
  "summary": "导入产品",
  "tags": "产品管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/link/instances/{instance_id}/products/import": {
      "post": {
        "tags": [
          "产品管理"
        ],
        "summary": "导入产品",
        "operationId": "UploadProduct",
        "description": "导入产品",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "public",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/instance_id"
          },
          {
            "in": "formData",
            "name": "file",
            "type": "file",
            "required": false,
            "description": "上传产品文件(.csv格式)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/BaseFileResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Error": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "系统错误码,针对4xx和5xx类HTTP错误码的详细错误码",
          "minLength": 0,
          "maxLength": 64
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 200
        },
        "request_id": {
          "type": "string",
          "description": "消息ID",
          "minLength": 0,
          "maxLength": 64
        }
      }
    },
    "BaseFileResponse": {
      "example": {
        "succ_num": 1,
        "fail_num": 4,
        "fail_objects_ids": []
      },
      "properties": {
        "succ_num": {
          "type": "integer",
          "description": "导入成功的产品数",
          "minimum": 0,
          "maximum": 500
        },
        "fail_num": {
          "type": "integer",
          "description": "导入失败的产品数",
          "minimum": 0,
          "maximum": 500
        },
        "fail_objects_ids": {
          "type": "array",
          "description": "导入失败的产品名称列表",
          "minItems": 0,
          "maxItems": 500,
          "items": {
            "type": "string",
            "description": "导入失败的产品名称",
            "maxLength": 10
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方式请参见《ROMA Connect API参考》的“附录 > 获取项目ID”章节。",
      "type": "string",
      "required": true,
      "maxLength": 32,
      "minLength": 0
    },
    "instance_id": {
      "name": "instance_id",
      "in": "path",
      "description": "实例ID",
      "type": "string",
      "required": true,
      "maxLength": 36,
      "minLength": 0
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}