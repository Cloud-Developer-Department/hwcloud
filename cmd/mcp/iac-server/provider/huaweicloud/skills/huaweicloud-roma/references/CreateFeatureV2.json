        },
        "name": {
          "description": "特性名称",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z_]{1,}$",
          "enum": [
            "lts",
            "gateway_responses",
            "ratelimit",
            "request_body_size",
            "backend_timeout",
            "app_token",
            "app_api_key",
            "app_basic",
            "app_secret",
            "app_jwt",
            "public_key",
            "backend_token_allow",
            "sign_basic",
            "multi_auth",
            "backend_client_certificate",
            "ssl_ciphers",
            "app_config",
            "green_tunnel",
            "app_route",
            "default_group_hide",
            "cascade",
            "sandbox",
            "livedata_config",
            "apiclient_first_use_x_hw_id",
            "cors",
            "api_task",
            "app_quota",
            "app_acl",
            "vpc_backup",
            "throttle_strategy",
            "kafka_log_plugin_options",
            "gzip",
            "js_invocable_cache_size"
          ]
        },
        "enable": {
          "description": "是否开启特性",
          "type": "boolean"
        },
        "config": {
          "description": "特性参数配置",
          "type": "string"
        },
        "instance_id": {
          "description": "实例编号",
          "type": "string"
        },
        "update_time": {
          "description": "实例特性更新时间",
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "FeatureToggleV2": {
      "required": [
        "enable",
        "name"
      ],
      "properties": {
        "name": {
          "description": "特性名称",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z_]{1,}$"
        },
        "enable": {
          "description": "是否开启特性",
          "type": "boolean"
        },
        "config": {
          "description": "特性参数配置",
          "type": "string"
        }
      }
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    }
