{
  "name": "ListDatasourceColumns",
  "summary": "获取数据源中某个表中所有字段",
  "tags": "数据源管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/fdi/instances/{instance_id}/datasources/{datasource_id}/columns": {
      "get": {
        "tags": [
          "数据源管理"
        ],
        "operationId": "ListDatasourceColumns",
        "summary": "获取数据源中某个表中所有字段",
        "description": "获取数据源中中某个表中所有字段",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "public",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/instance_id"
          },
          {
            "$ref": "#/parameters/datasource_id"
          },
          {
            "in": "query",
            "name": "position",
            "description": "数据源所在任务位置\n- SOURCE 数据源处于任务源端\n- TARGET 数据源处于任务目标端",
            "enum": [
              "SOURCE",
              "TARGET"
            ],
            "type": "string",
            "minLength": 0,
            "maxLength": 6,
            "required": true,
            "x-example": "SOURCE"
          },
          {
            "in": "query",
            "name": "db_name",
            "description": "数据库名称,只支持MRSHIVE,FIHIVE类型的数据源",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": false,
            "x-example": "TESTDB"
          },
          {
            "in": "query",
            "name": "table_name",
            "description": "字段所在的表名",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": false,
            "x-example": "TESTTABLE"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ColumnQueryResponse"
            }
          },
          "400": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorRsp404"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorRsp500"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ColumnQueryResponse": {
      "description": "表字段查询返回值",
      "properties": {
        "columns": {
          "type": "array",
          "description": "返回的实体对象",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "$ref": "#/definitions/ColumnInfo"
          }
        }
      }
    },
    "ErrorRsp500": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.9999"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "Network error."
        }
      }
    },
    "ColumnInfo": {
      "description": "表字段详情",
      "properties": {
        "field_name": {
          "type": "string",
          "description": "字段名称",
          "minLength": 0,
          "maxLength": 256,
          "example": "colA"
        },
        "field_type": {
          "type": "string",
          "description": "字段类型",
          "minLength": 0,
          "maxLength": 256,
          "example": "VARCHAR"
        },
        "field_length": {
          "type": "string",
          "description": "字段长度",
          "minimum": 0,
          "maximum": 200,
          "example": "10"
        },
        "null_able": {
          "type": "string",
          "description": "是否允许为空",
          "example": "1"
        },
        "is_partition": {
          "type": "boolean",
          "description": "是否是分区字段",
          "example": true
        },
        "primary": {
          "type": "string",
          "description": "是否是主键字段",
          "example": "0"
        },
        "unique": {
          "type": "string",
          "description": "是否是唯一键字段",
          "example": "0"
        },
        "decimal_digits": {
          "type": "string",
          "description": "小数部分位数,非数字类型返回null",
          "minimum": 0,
          "maximum": 200,
          "example": "5"
        }
      }
    },
    "ErrorRsp404": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.3081"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "The task does not exist."
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.xxxx"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "Failed to xxxx."
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方式请参见《ROMA Connect API参考》的“附录 > 获取项目ID”章节。",
      "type": "string",
      "required": true,
      "maxLength": 32,
      "minLength": 0
    },
    "datasource_id": {
      "name": "datasource_id",
      "in": "path",
      "description": "数据源ID",
      "type": "string",
      "required": true,
      "maxLength": 64,
      "minLength": 1,
      "x-example": "acb3b4049bb643e39ca12a87a735b34d"
    },
    "instance_id": {
      "name": "instance_id",
      "in": "path",
      "description": "实例ID",
      "type": "string",
      "required": true,
      "maxLength": 36,
      "minLength": 0
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}