          "type": "string",
          "description": "错误信息"
        }
      }
    },
    "CreateMqsInstanceTopicReq": {
      "type": "object",
      "properties": {
        "name": {
          "description": "topic名称,以字母开头,仅能包含数字,字母,下划线(_),中划线(-),长度3-200字符。",
          "type": "string"
        },
        "app_id": {
          "description": "集成应用key。",
          "type": "string"
        },
        "partition": {
          "description": "topic分区数,设置消费的并发数。\n\n取值范围:1-50。\n\n默认值:3。",
          "type": "integer"
        },
        "replication": {
          "description": "副本数,配置数据的可靠性。\n\n取值范围:1-3。\n\n默认值:3。\n\n> 体验版实例的副本数只能为1。",
          "type": "integer"
        },
        "access_policy": {
          "type": "string",
          "description": "权限类型。\n  - all:发布+订阅\n  - pub:发布\n  - sub:订阅",
          "enum": [
            "all",
            "pub",
            "sub"
          ]
        },
        "sync_message_flush": {
          "description": "是否使用同步落盘。默认值为false。同步落盘会导致性能降低。",
          "type": "boolean"
        },
        "sync_replication": {
          "description": "是否开启同步复制,开启后,客户端生产消息时相应的也要设置acks=-1,否则不生效,默认关闭。",
          "type": "boolean"
        },
        "retention_time": {
          "description": "消息老化时间。默认值为72。取值范围1~720,单位小时。",
          "type": "integer"
        },
        "tag": {
          "type": "string",
          "description": "权限类型对应的标签。\n\n当权限类型是all时,发布和订阅的标签用符号“&”隔开。\n\n当有多个标签时,标签用符号“||”隔开。"
        },
        "description": {
          "type": "string",
          "description": "描述。长度0-1000字符。"
        },
        "sensitive_word": {
          "type": "string",
          "description": "敏感字段。\n\n当有多个敏感字段时,敏感字段用符号“||”隔开。"
        }
      },
      "required": [
        "name",
        "app_id",
        "access_policy"
      ],
      "example": {
        "name": "topic-test-2",
        "app_id": "c5abd910-02b1-4bc4-b587-c3fe4c49dab9",
        "partition": 3,
        "access_policy": "all",
        "replication": 3,
