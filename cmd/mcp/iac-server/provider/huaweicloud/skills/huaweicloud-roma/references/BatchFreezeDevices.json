{
  "name": "BatchFreezeDevices",
  "summary": "设备批量下线",
  "tags": "设备管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/link/instances/{instance_id}/devices/force-offline": {
      "post": {
        "tags": [
          "设备管理"
        ],
        "summary": "设备批量下线",
        "operationId": "BatchFreezeDevices",
        "description": "设备批量下线",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "public",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/instance_id"
          },
          {
            "name": "BatchFreezeDevicesRequestBody",
            "in": "body",
            "description": "批量下线设备ID列表",
            "schema": {
              "$ref": "#/definitions/BatchFreezeDevicesRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/OfflineDevicesResponseBody"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Error": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "系统错误码,针对4xx和5xx类HTTP错误码的详细错误码",
          "minLength": 0,
          "maxLength": 64
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 200
        },
        "request_id": {
          "type": "string",
          "description": "消息ID",
          "minLength": 0,
          "maxLength": 64
        }
      }
    },
    "BatchFreezeDevicesRequestBody": {
      "example": {
        "device_ids": [
          10001,
          10002
        ]
      },
      "required": [
        "device_ids"
      ],
      "properties": {
        "device_ids": {
          "type": "array",
          "description": "设备ID列表,自动向下取整",
          "maxItems": 999999,
          "minItems": 0,
          "items": {
            "type": "integer",
            "description": "设备ID"
          }
        }
      }
    },
    "DeviceInfoSimple": {
      "properties": {
        "id": {
          "type": "integer",
          "description": "设备ID",
          "minimum": 1,
          "maximum": 999999999999999999
        },
        "device_name": {
          "type": "string",
          "description": "设备名称",
          "minLength": 0,
          "maxLength": 32
        },
        "device_id": {
          "type": "integer",
          "format": "int64",
          "description": "设备ID(兼容20.0)",
          "minimum": 1,
          "maximum": 99999999999999999
        }
      }
    },
    "OfflineDevicesResponseBody": {
      "example": {
        "success": {
          "id": 711554,
          "device_name": "success",
          "device_id": 711554
        },
        "failed": {
          "id": 711553,
          "device_name": "failed",
          "device_id": 711553
        }
      },
      "properties": {
        "success": {
          "type": "array",
          "description": "下线成功设备列表",
          "minItems": 0,
          "maxItems": 9999,
          "items": {
            "$ref": "#/definitions/DeviceInfoSimple"
          }
        },
        "failed": {
          "type": "array",
          "description": "下线失败设备列表",
          "minItems": 0,
          "maxItems": 9999,
          "items": {
            "$ref": "#/definitions/DeviceInfoSimple"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方式请参见《ROMA Connect API参考》的“附录 > 获取项目ID”章节。",
      "type": "string",
      "required": true,
      "maxLength": 32,
      "minLength": 0
    },
    "instance_id": {
      "name": "instance_id",
      "in": "path",
      "description": "实例ID",
      "type": "string",
      "required": true,
      "maxLength": 36,
      "minLength": 0
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}