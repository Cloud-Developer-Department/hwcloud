  "definitions": {
    "AuthorizerBase": {
      "required": [
        "name",
        "type",
        "authorizer_type",
        "authorizer_uri"
      ],
      "properties": {
        "name": {
          "description": "自定义认证的名称。\n长度为3 ~ 64位的字符串,字符串由中文、英文字母、数字、“_”组成,且只能以英文或中文开头。",
          "type": "string",
          "example": "Authorizer_demo"
        },
        "type": {
          "description": "自定义认证类型\n\n- FRONTEND:前端\n- BACKEND:后端",
          "enum": [
            "FRONTEND",
            "BACKEND"
          ],
          "type": "string",
          "example": "FRONTEND"
        },
        "authorizer_type": {
          "description": "自定义认证函数类型:\n- LD:自定义后端函数\n- FUNC:函数服务函数",
          "type": "string",
          "enum": [
            "LD",
            "FUNC"
          ],
          "example": "LD"
        },
        "authorizer_uri": {
          "description": "函数地址。\n\n注意:使用自定义后端的函数API,API请求方法必须为POST,且API状态必须为已部署。",
          "type": "string",
          "example": "'/test/ldapi'"
        },
        "authorizer_version": {
          "description": "函数版本。\n\n当函数别名URN和函数版本同时传入时,函数版本将被忽略,只会使用函数别名URN",
          "type": "string",
          "maxLength": 64,
          "example": "v1"
        },
        "authorizer_alias_uri": {
          "description": "函数别名地址。\n\n当函数别名URN和函数版本同时传入时,函数版本将被忽略,只会使用函数别名URN",
          "type": "string",
          "example": "urn:fss:xx-xxx-4:106506b9a92342df9a5025fc12351cfc:function:defau:apigDemo_1592617458814:!v1"
        },
        "identities": {
          "description": "认证来源",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Identity"
          }
        },
        "ttl": {
          "description": "缓存时间",
          "type": "integer",
          "format": "int32",
          "example": 5
        },
        "user_data": {
          "description": "用户数据",
          "type": "string",
          "example": "authorizer_test"
        },
        "ld_api_id": {
          "description": "自定义后端服务ID。\n\n自定义认证函数类型为LD时必填",
          "type": "string",
          "example": "2f808c7853804d1e8ad82ec72385b3fc"
        },
        "need_body": {
          "description": "是否发送body",
          "type": "boolean",
          "example": true
        }
      }
    },
    "Identity": {
      "required": [
        "name",
        "location"
      ],
      "properties": {
        "name": {
          "description": "参数名称。\n\n支持数字,英文,下划线,中划线,点,且只能以数字或英文开头。",
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,31}$",
          "example": "header"
        },
        "location": {
          "description": "参数位置",
          "enum": [
            "HEADER",
            "QUERY"
          ],
          "type": "string",
          "example": "HEADER"
        },
        "validation": {
          "description": "参数校验表达式,默认为null,不做校验",
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "AuthorizerResp": {
      "allOf": [
        {
          "$ref": "#/definitions/AuthorizerBase"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "自定义认证编号",
              "type": "string"
            },
            "create_time": {
              "type": "string",
              "description": "创建时间",
              "format": "date-time"
            },
            "roma_app_id": {
              "description": "自定义认证所属应用编号",
              "type": "string"
            },
            "roma_app_name": {
              "description": "自定义认证所属应用名称",
              "type": "string"
            }
          }
        }
      ]
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "AuthorizerCreate": {
      "allOf": [
        {
          "$ref": "#/definitions/AuthorizerBase"
        }
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID",
      "required": true,
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
      "required": true,
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}