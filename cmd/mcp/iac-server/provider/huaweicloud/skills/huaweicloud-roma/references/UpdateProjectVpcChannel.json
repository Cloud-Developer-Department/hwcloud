          "type": "integer",
          "format": "int32"
        },
        "is_backup": {
          "description": "是否备用节点。\n\n开启后对应后端服务为备用节点,仅当非备用节点全部故障时工作。\n\n实例需要升级到对应版本才支持此功能,若不支持请联系技术支持。",
          "type": "boolean",
          "default": false
        },
        "member_group_name": {
          "description": "后端服务器组名称。为后端服务地址选择服务器组,便于统一修改对应服务器组的后端地址。",
          "type": "string"
        },
        "status": {
          "description": "后端服务器状态\n  - 1:可用\n  - 2:不可用",
          "enum": [
            1,
            2
          ],
          "type": "integer",
          "format": "int32"
        },
        "port": {
          "description": "后端服务器端口",
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "format": "int32"
        }
      }
