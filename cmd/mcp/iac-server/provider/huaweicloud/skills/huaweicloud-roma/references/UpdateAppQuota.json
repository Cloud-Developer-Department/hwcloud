{
  "name": "UpdateAppQuota",
  "summary": "修改客户端配额",
  "tags": "客户端配额",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/app-quotas/{app_quota_id}": {
      "put": {
        "tags": [
          "客户端配额"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "x-order": 2,
        "operationId": "UpdateAppQuota",
        "summary": "修改客户端配额",
        "description": "修改客户端配额",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_app_quota_id"
          },
          {
            "name": "UpdateAppQuotaRequestBody",
            "required": true,
            "description": "更新客户端配额请求体",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/AppQuotaCreate"
            }
          }
        ],
        "x-request-examples-description-1": "修改指定客户端配额信息,修改访问次数限制和限定时间值",
        "x-request-examples-1": {
          "call_limits": 1000,
          "name": "ClientQuota_demo",
          "reset_time": "2020-09-20 00:00:00",
          "time_interval": 1,
          "time_unit": "DAY"
        },
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/AppQuotaInfo"
            },
            "examples": {
              "application/json": {
                "app_quota_id": "c900c5612dbe451bb43cbcc49cfaf2f3",
                "call_limits": 1000,
                "create_time": "2020-09-19T07:27:47Z",
                "name": "ClientQuota_demo",
                "reset_time": "2020-09-20 00:00:00",
                "time_interval": 1,
                "time_unit": "DAY"
              }
            }
          },
          "400": {
            "description": "Bad Request",
