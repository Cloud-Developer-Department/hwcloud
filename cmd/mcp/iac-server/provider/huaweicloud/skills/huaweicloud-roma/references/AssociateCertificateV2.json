{
  "name": "AssociateCertificateV2",
  "summary": "绑定域名证书",
  "tags": "域名管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/api-groups/{group_id}/domains/{domain_id}/certificate": {
      "post": {
        "summary": "绑定域名证书",
        "tags": [
          "域名管理"
        ],
        "description": "如果创建API时,“定义API请求”使用HTTPS请求协议,那么在独立域名中需要添加SSL证书。\n本章节主要介绍为特定域名绑定证书。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-order": 2,
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "operationId": "AssociateCertificateV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_group_id"
          },
          {
            "$ref": "#/parameters/apic_domain_id"
          },
          {
            "schema": {
              "$ref": "#/definitions/CertForm"
            },
            "in": "body",
            "name": "AssociateCertificateV2RequestBody",
            "description": "绑定域名证书的请求体",
            "required": true
          }
        ],
        "x-request-examples-description-1": "为已绑定的域名添加域名证书,证书可见范围为全局可见",
        "x-request-examples-1": {
          "name": "cert_demo",
          "private_key": "-----BEGIN PRIVATE KEY-----THIS IS YOUR PRIVATE KEY-----END PRIVATE KEY-----",
          "cert_content": "-----BEGIN CERTIFICATE-----THIS IS YOUR CERT CONTENT-----END CERTIFICATE-----"
        },
        "responses": {
          "201": {
            "schema": {
              "$ref": "#/definitions/UrlDomainCertInfo"
            },
            "examples": {
              "application/json": {
                "ssl_name": "cert_demo",
                "url_domain": "www.example.com",
                "ssl_id": "a27be832f2e9441c8127fe48e3b5ac67",
                "id": " f6bb84ccf1c34035878aa51b7253b21c",
                "status": 3
              }
            },
            "description": "Created"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:name. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3020",
                "error_msg": "The URL domain does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        },
        "schemes": [
          "https"
        ]
      }
    }
  },
  "definitions": {
    "SslInfo": {
      "properties": {
        "ssl_id": {
          "description": "SSL证书编号",
          "type": "string",
          "example": "ddsa83b07744e8eb1872d695ed4743b"
        },
        "ssl_name": {
          "description": "SSL证书名称",
          "type": "string",
          "example": "certificate"
        },
        "algorithm_type": {
          "type": "string",
          "description": "证书算法类型:\n- RSA\n- ECC\n- SM2",
          "enum": [
            "RSA",
            "ECC",
            "SM2"
          ],
          "example": "RSA"
        },
        "type": {
          "type": "string",
          "description": "证书可见范围:\n- instance:当前实例\n- global:全局",
          "default": "global",
          "enum": [
            "instance",
            "global"
          ],
          "example": "instance"
        }
      }
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "UrlDomainBaseInfo": {
      "required": [
        "id",
        "url_domain",
        "status",
        "min_ssl_version"
      ],
      "properties": {
        "url_domain": {
          "description": "自定义域名",
          "type": "string",
          "example": "www.example.com"
        },
        "id": {
          "description": "自定义域名的编号",
          "type": "string",
          "example": "b9be707660c5406394f8973e087bae20"
        },
        "status": {
          "description": "CNAME解析状态\n- 1: 未解析\n- 2: 解析中\n- 3: 解析成功\n- 4: 解析失败",
          "enum": [
            1,
            2,
            3,
            4
          ],
          "type": "integer",
          "format": "int32",
          "example": 3
        },
        "min_ssl_version": {
          "description": "支持的最小SSL版本",
          "type": "string",
          "example": "TLSv1.1"
        },
        "is_http_redirect_to_https": {
          "type": "boolean",
          "description": "是否开启http到https的重定向,false为关闭,true为开启,默认为false",
          "default": false,
          "example": true
        },
        "verified_client_certificate_enabled": {
          "description": "是否开启客户端证书校验。只有绑定证书时,该参数才生效。当绑定证书存在trusted_root_ca时,默认开启;当绑定证书不存在trusted_root_ca时,默认关闭。",
          "type": "boolean",
          "default": false,
          "example": false
        }
      }
    },
    "CertForm": {
      "description": "添加或编辑证书的请求体表单",
      "properties": {
        "name": {
          "type": "string",
          "description": "证书名称。长度为4 ~ 50位的字符串,字符串由中文、英文字母、数字、下划线组成,且只能以英文或中文开头。",
          "example": "cert_demo"
        },
        "cert_content": {
          "type": "string",
          "description": "证书内容",
          "example": "-----BEGIN CERTIFICATE-----THIS IS YOUR CERT CONTENT-----END CERTIFICATE-----"
        },
        "private_key": {
          "type": "string",
          "description": "证书私钥",
          "example": "-----BEGIN RSA PRIVATE KEY-----THIS IS YOUR PRIVATE KEY-----END RSA PRIVATE KEY-----"
        },
        "type": {
          "type": "string",
          "description": "证书可见范围",
          "default": "global",
          "enum": [
            "instance",
            "global"
          ],
          "example": "instance"
        },
        "instance_id": {
          "type": "string",
          "description": "所属实例ID,当type=instance时必填",
          "example": "f0fa1789-3b76-433b-a787-9892951c620e"
        },
        "trusted_root_ca": {
          "type": "string",
          "description": "信任的根证书CA",
          "example": "-----BEGIN CERTIFICATE-----THIS IS YOUR CERT CONTENT-----END CERTIFICATE-----"
        }
      },
      "required": [
        "name",
        "cert_content",
        "private_key"
      ]
    },
    "UrlDomainCertInfo": {
      "required": [
        "ssl_id",
        "ssl_name"
      ],
      "allOf": [
        {
          "$ref": "#/definitions/UrlDomainBaseInfo"
        },
        {
          "type": "object",
          "properties": {
            "ssl_name": {
              "description": "证书的名称",
              "type": "string",
              "example": "证书"
            },
            "ssl_id": {
              "description": "证书的编号",
              "type": "string",
              "example": "0a515af69f4e4dcca84fbf85f68c0e27"
            },
            "ssl_infos": {
              "description": "SSL证书列表",
              "type": "array",
              "items": {
                "$ref": "#/definitions/SslInfo"
              }
            }
          }
        }
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_domain_id": {
      "name": "domain_id",
      "in": "path",
      "type": "string",
      "description": "域名的编号",
      "required": true,
      "x-example": "f6bb84ccf1c34035878aa51b7253b21c"
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID",
      "required": true,
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
      "required": true,
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_group_id": {
      "name": "group_id",
      "in": "path",
      "type": "string",
      "description": "分组的编号",
      "required": true,
      "x-example": "c77f5e81d9cb4424bf704ef2b0ac7600"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}