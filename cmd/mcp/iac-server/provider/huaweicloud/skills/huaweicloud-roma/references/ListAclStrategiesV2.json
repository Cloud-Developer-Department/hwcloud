{
  "name": "ListAclStrategiesV2",
  "summary": "查看ACL策略列表",
  "tags": "ACL策略管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/acls": {
      "get": {
        "summary": "查看ACL策略列表",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-order": 6,
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "tags": [
          "ACL策略管理"
        ],
        "description": "查询所有的ACL策略列表。",
        "operationId": "ListAclStrategiesV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_offset"
          },
          {
            "$ref": "#/parameters/apic_limit"
          },
          {
            "in": "query",
            "name": "id",
            "description": "ACL策略编号。",
            "type": "string",
            "x-example": "7eb619ecf2a24943b099833cd24a01ba"
          },
          {
            "in": "query",
            "name": "name",
            "description": "ACL策略名称。",
            "type": "string",
            "x-example": "acl_demo"
          },
          {
            "in": "query",
            "name": "acl_type",
            "description": "类型\n- PERMIT (白名单类型)\n- DENY (黑名单类型)",
            "type": "string",
            "x-example": "PERMIT"
          },
          {
            "in": "query",
            "name": "entity_type",
            "description": "作用的对象类型:\n- IP\n- DOMAIN",
            "type": "string",
            "x-example": "IP"
          },
          {
            "in": "query",
            "name": "precise_search",
            "x-example": "name",
            "description": "指定需要精确匹配查找的参数名称,多个参数需要支持精确匹配时参数之间使用“,”隔开。\n\n目前仅支持name。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/ApiAclInfoPage"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "size": 1,
                "acls": [
                  {
                    "bind_num": 0,
                    "id": "7eb619ecf2a24943b099833cd24a01ba",
                    "acl_name": "acl_demo",
                    "entity_type": "IP",
                    "acl_type": "PERMIT",
                    "acl_value": "192.168.1.5,192.168.10.1",
                    "update_time": "2020-08-04T08:42:43Z"
                  }
                ]
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2011",
                "error_msg": "Invalid parameter value,parameterName:name. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3030",
                "error_msg": "The instance does not exist;id:f0fa1789-3b76-433b-a787-9892951c620e"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "BasePage": {
      "properties": {
        "size": {
          "description": "本次返回的列表长度",
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "description": "满足条件的记录数",
          "type": "integer",
          "format": "int64"
        }
      },
      "description": "分页基本信息",
      "required": [
        "size",
        "total"
      ]
    },
    "ApiAclInfoPage": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "acls": {
              "description": "本次查询返回的ACL策略列表",
              "type": "array",
              "items": {
                "$ref": "#/definitions/ApiAclInfoWithBindNum"
              }
            }
          }
        }
      ]
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "ApiAclInfoWithBindNum": {
      "title": "ApiAclInfoWithBindNum",
      "type": "object",
      "properties": {
        "acl_name": {
          "description": "ACL策略名称",
          "type": "string",
          "example": "acl_name"
        },
        "acl_type": {
          "type": "string",
          "description": "类型\n- PERMIT(白名单类型)\n- DENY(黑名单类型)"
        },
        "acl_value": {
          "description": "ACL策略的值",
          "type": "string",
          "example": "1.0.0.1"
        },
        "bind_num": {
          "description": "绑定的API数量",
          "type": "integer",
          "format": "int32",
          "example": 2
        },
        "entity_type": {
          "description": "对象类型\n- IP\n- DOMAIN",
          "type": "string",
          "example": "IP"
        },
        "id": {
          "type": "string",
          "description": "ACL策略编号",
          "example": "d402b35e10544280b1c50d741a28c995"
        },
        "update_time": {
          "description": "更新时间",
          "type": "string",
          "format": "date-time",
          "example": "2020-06-29T07:13:39.000Z"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_offset": {
      "name": "offset",
      "in": "query",
      "type": "integer",
      "description": "偏移量,表示从此偏移量开始查询,偏移量小于0时,自动转换为0",
      "format": "int64",
      "default": 0,
      "x-example": 1
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID",
      "required": true,
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
      "required": true,
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "apic_limit": {
      "name": "limit",
      "in": "query",
      "type": "integer",
      "description": "每页显示的条目数量",
      "format": "int32",
      "minimum": 1,
      "maximum": 500,
      "default": 20,
      "x-example": 10
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}