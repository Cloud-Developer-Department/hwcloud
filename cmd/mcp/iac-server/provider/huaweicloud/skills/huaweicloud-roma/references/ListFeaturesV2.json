{
  "name": "ListFeaturesV2",
  "summary": "查看实例特性列表",
  "tags": "实例特性管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/features": {
      "get": {
        "summary": "查看实例特性列表",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "x-order": 1,
        "description": "查看实例特性列表。注意:实例不支持以下特性的需要联系技术支持升级实例版本。\n\n支持配置的特性列表及特性配置请参考“附录 > 实例支持的APIC特性”",
        "schemes": [
          "https"
        ],
        "tags": [
          "实例特性管理"
        ],
        "operationId": "ListFeaturesV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_offset"
          },
          {
            "$ref": "#/parameters/apic_limit"
          }
        ],
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/FeatureInfoPageV2"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "size": 1,
                "features": [
                  {
                    "config": "on",
                    "enable": true,
                    "id": "db9a9260cd3e4a16a9b5747a65d3ffaa",
                    "instance_id": "f0fa1789-3b76-433b-a787-9892951c620e",
                    "name": "app_api_key",
                    "update_time": "2020-08-24T01:17:31.041984Z"
                  }
                ]
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:instance_id. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3030",
                "error_msg": "The instance does not exist;id:f0fa1789-3b76-433b-a787-9892951c620e"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "BasePage": {
      "properties": {
        "size": {
          "description": "本次返回的列表长度",
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "description": "满足条件的记录数",
          "type": "integer",
          "format": "int64"
        }
      },
      "description": "分页基本信息",
      "required": [
        "size",
        "total"
      ]
    },
    "FeatureInfoV2": {
      "properties": {
        "id": {
          "description": "特性编号",
          "type": "string"
        },
        "name": {
          "description": "特性名称",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z_]{1,}$",
          "enum": [
            "lts",
            "gateway_responses",
            "ratelimit",
            "request_body_size",
            "backend_timeout",
            "app_token",
            "app_api_key",
            "app_basic",
            "app_secret",
            "app_jwt",
            "public_key",
            "backend_token_allow",
            "sign_basic",
            "multi_auth",
            "backend_client_certificate",
            "ssl_ciphers",
            "app_config",
            "green_tunnel",
            "app_route",
            "default_group_hide",
            "cascade",
            "sandbox",
            "livedata_config",
            "apiclient_first_use_x_hw_id",
            "cors",
            "api_task",
            "app_quota",
            "app_acl",
            "vpc_backup",
            "throttle_strategy",
            "kafka_log_plugin_options",
            "gzip",
            "js_invocable_cache_size"
          ]
        },
        "enable": {
          "description": "是否开启特性",
          "type": "boolean"
        },
        "config": {
          "description": "特性参数配置",
          "type": "string"
        },
        "instance_id": {
          "description": "实例编号",
          "type": "string"
        },
        "update_time": {
          "description": "实例特性更新时间",
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "FeatureInfoPageV2": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "features": {
              "description": "实例特性列表",
              "type": "array",
              "items": {
                "$ref": "#/definitions/FeatureInfoV2"
              }
            }
          }
        }
      ]
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_offset": {
      "name": "offset",
      "in": "query",
      "type": "integer",
      "description": "偏移量,表示从此偏移量开始查询,偏移量小于0时,自动转换为0",
      "format": "int64",
      "default": 0,
      "x-example": 1
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID",
      "required": true,
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
      "required": true,
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "apic_limit": {
      "name": "limit",
      "in": "query",
      "type": "integer",
      "description": "每页显示的条目数量",
      "format": "int32",
      "minimum": 1,
      "maximum": 500,
      "default": 20,
      "x-example": 10
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}