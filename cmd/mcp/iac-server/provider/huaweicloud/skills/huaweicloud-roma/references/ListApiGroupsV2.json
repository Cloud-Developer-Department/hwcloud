{
  "name": "ListApiGroupsV2",
  "summary": "查询分组列表",
  "tags": "API分组管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/api-groups": {
      "get": {
        "summary": "查询分组列表",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-order": 5,
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "description": "查询API分组列表。\n\n如果是租户操作,则查询该租户下所有的分组;如果是管理员操作,则查询的是所有租户的分组。",
        "schemes": [
          "https"
        ],
        "tags": [
          "API分组管理"
        ],
        "operationId": "ListApiGroupsV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_offset"
          },
          {
            "$ref": "#/parameters/apic_limit"
          },
          {
            "in": "query",
            "name": "id",
            "x-example": "aa35dd27fcb9475f8b1b19669ba60309",
            "description": "API分组编号",
            "type": "string",
            "required": false
          },
          {
            "in": "query",
            "name": "name",
            "x-example": "api_group_name",
            "description": "API分组名称",
            "type": "string",
            "required": false
          },
          {
            "in": "query",
            "name": "roma_app_id",
            "x-example": "05b3f70a-59d7-42d7-9d96-e2da7b4c07d3",
            "description": "集成应用编号",
            "type": "string",
            "required": false
          },
          {
            "in": "query",
            "name": "precise_search",
            "description": "指定需要精确匹配查找的参数名称,多个参数需要支持精确匹配时参数之间使用“,”隔开。\n\n当前支持name,domain_name。",
            "type": "string",
            "x-example": "name"
          },
          {
            "in": "query",
            "name": "domain_name",
            "x-example": "test.com",
            "description": "域名",
            "type": "string",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/ApiGroupInfoPage"
            },
            "examples": {
              "application/json": {
                "total": 2,
                "size": 2,
                "groups": [
                  {
                    "update_time": "2020-07-31T06:55:55Z",
                    "name": "api_group_001",
                    "on_sell_status": 2,
                    "remark": "group1",
                    "sl_domains": [
                      "c77f5e81d9cb4424bf704ef2b0ac7600.apic.****.com",
                      "c77f5e81d9cb4424bf704ef2b0ac7600.apic.****.cn"
                    ],
                    "sl_domain": "c77f5e81d9cb4424bf704ef2b0ac7600.apic.****.com",
                    "id": "c77f5e81d9cb4424bf704ef2b0ac7600",
                    "register_time": "2020-07-31T06:55:55Z",
                    "status": 1,
                    "is_default": 2,
                    "version": "V1"
                  },
                  {
                    "update_time": "2020-06-24T15:29:42.421926Z",
                    "name": "api_group_002",
                    "on_sell_status": 2,
                    "remark": "group2",
                    "sl_domain": "02a8ab3cb2784de5a096852829671ae7.apic.****.com",
                    "sl_domains": [
                      "02a8ab3cb2784de5a096852829671ae7.apic.****.com",
                      "02a8ab3cb2784de5a096852829671ae7.apic.****.cn"
                    ],
                    "id": "02a8ab3cb2784de5a096852829671ae7",
                    "register_time": "2020-06-24T15:29:42.421926Z",
                    "status": 1,
                    "is_default": 2,
                    "version": "V1"
                  }
                ]
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:name. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3030",
                "error_msg": "The instance does not exist;id:f0fa1789-3b76-433b-a787-9892951c620ec"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ApiGroupCommonInfo": {
      "required": [
        "id",
        "name",
        "status",
        "sl_domain",
        "register_time",
        "update_time",
        "on_sell_status"
      ],
      "properties": {
        "id": {
          "description": "编号",
          "type": "string",
          "example": "aa35dd27fcb9475f8b1b19669ba60309"
        },
        "name": {
          "description": "API分组名称",
          "type": "string",
          "example": "api_group_001"
        },
        "status": {
          "description": "状态\n  - 1: 有效\n  - 2:  锁定",
          "enum": [
            1,
            2
          ],
          "type": "integer",
          "format": "int32",
          "example": 1
        },
        "sl_domain": {
          "description": "系统默认分配的子域名",
          "type": "string",
          "example": "aa35dd27fcb9475f8b1b19669ba60309.apic.****.com"
        },
        "register_time": {
          "description": "创建时间",
          "type": "string",
          "format": "date-time",
          "example": "2017-12-28T11:44:53.000Z"
        },
        "update_time": {
          "description": "最近修改时间",
          "type": "string",
          "format": "date-time",
          "example": "2017-12-28T11:49:01.048Z"
        },
        "on_sell_status": {
          "description": "是否已上架云市场:\n- 1:已上架\n- 2:未上架\n- 3:审核中\n\nROMA Connect暂未对接云市场,此字段默认返回2",
          "type": "integer",
          "format": "int32",
          "example": 2
        },
        "url_domains": {
          "description": "分组上绑定的独立域名列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/UrlDomain"
          }
        }
      }
    },
    "SslInfo": {
      "properties": {
        "ssl_id": {
          "description": "SSL证书编号",
          "type": "string",
          "example": "ddsa83b07744e8eb1872d695ed4743b"
        },
        "ssl_name": {
          "description": "SSL证书名称",
          "type": "string",
          "example": "certificate"
        },
        "algorithm_type": {
          "type": "string",
          "description": "证书算法类型:\n- RSA\n- ECC\n- SM2",
          "enum": [
            "RSA",
            "ECC",
            "SM2"
          ],
          "example": "RSA"
        },
        "type": {
          "type": "string",
          "description": "证书可见范围:\n- instance:当前实例\n- global:全局",
          "default": "global",
          "enum": [
            "instance",
            "global"
          ],
          "example": "instance"
        }
      }
    },
    "BasePage": {
      "properties": {
        "size": {
          "description": "本次返回的列表长度",
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "description": "满足条件的记录数",
          "type": "integer",
          "format": "int64"
        }
      },
      "description": "分页基本信息",
      "required": [
        "size",
        "total"
      ]
    },
    "UrlDomain": {
      "properties": {
        "id": {
          "description": "域名编号",
          "type": "string",
          "example": "e91b83b07744e8eb1872d695ed4743b"
        },
        "domain": {
          "description": "访问域名",
          "type": "string",
          "example": "domain.com"
        },
        "cname_status": {
          "description": "域名cname状态:\n- 1:未解析\n- 2:解析中\n- 3:解析成功\n- 4:解析失败",
          "type": "integer",
          "format": "int32",
          "example": 3
        },
        "ssl_id": {
          "description": "SSL证书编号",
          "type": "string",
          "example": "ddsa83b07744e8eb1872d695ed4743b"
        },
        "ssl_name": {
          "description": "SSL证书名称",
          "type": "string",
          "example": "certificate"
        },
        "min_ssl_version": {
          "description": "最小ssl协议版本号。支持TLSv1.1或TLSv1.2",
          "type": "string",
          "default": "TLSv1.1",
          "enum": [
            "TLSv1.1",
            "TLSv1.2"
          ],
          "example": "TLSv1.1"
        },
        "verified_client_certificate_enabled": {
          "description": "是否开启客户端证书校验。只有绑定证书时,该参数才生效。当绑定证书存在trusted_root_ca时,默认开启;当绑定证书不存在trusted_root_ca时,默认关闭。",
          "type": "boolean",
          "default": false,
          "example": false
        },
        "is_has_trusted_root_ca": {
          "description": "是否存在信任的根证书CA。当绑定证书存在trusted_root_ca时为true。",
          "type": "boolean",
          "default": false,
          "example": false
        },
        "ssl_infos": {
          "description": "SSL证书列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SslInfo"
          }
        }
      }
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "ApiGroupInfoPage": {
      "required": [
        "groups"
      ],
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "groups": {
              "description": "分组列表",
              "type": "array",
              "items": {
                "$ref": "#/definitions/ApiGroupInfo"
              }
            }
          }
        }
      ]
    },
    "ApiGroupInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/ApiGroupCommonInfo"
        },
        {
          "type": "object",
          "properties": {
            "sl_domains": {
              "description": "系统默认分配的子域名列表",
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "aa35dd27fcb9475f8b1b19669ba60309.apic.****.com",
                "aa35dd27fcb9475f8b1b19669ba60309.apic.****.cn"
              ]
            },
            "remark": {
              "description": "描述",
              "type": "string",
              "example": "分组1"
            },
            "call_limits": {
              "description": "流控时长内分组下的API的总访问次数限制,默认不限,请根据服务的负载能力自行设置\n\n暂不支持",
              "type": "integer",
              "format": "int32",
              "example": 200
            },
            "time_interval": {
              "description": "流控时长\n\n暂不支持",
              "type": "integer",
              "format": "int32",
              "example": 2
            },
            "time_unit": {
              "description": "流控的时间单位\n\n暂不支持",
              "type": "string",
              "example": "SECOND"
            },
            "is_default": {
              "description": "是否为默认分组",
              "type": "integer",
              "format": "int32",
              "example": 2
            },
            "version": {
              "description": "分组版本\n\n- V1:全局分组\n- V2:应用级分组",
              "type": "string",
              "example": "V2"
            },
            "roma_app_id": {
              "description": "分组归属的集成应用编号。\n\n分组版本V2时必填。",
              "type": "string",
              "example": "98df09fb-d459-4cbf-83a7-2b55ca6f3d5d"
            },
            "roma_app_name": {
              "description": "分组归属的集成应用名称",
              "type": "string",
              "example": "roma_app_demo"
            }
          }
        }
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_offset": {
      "name": "offset",
      "in": "query",
      "type": "integer",
      "description": "偏移量,表示从此偏移量开始查询,偏移量小于0时,自动转换为0",
      "format": "int64",
      "default": 0,
      "x-example": 1
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID",
      "required": true,
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
      "required": true,
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "apic_limit": {
      "name": "limit",
      "in": "query",
      "type": "integer",
      "description": "每页显示的条目数量",
      "format": "int32",
      "minimum": 1,
      "maximum": 500,
      "default": 20,
      "x-example": 10
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}