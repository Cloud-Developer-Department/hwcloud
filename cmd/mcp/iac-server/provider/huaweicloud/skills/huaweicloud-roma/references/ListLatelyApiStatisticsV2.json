          "description": "2xx响应码总次数",
          "type": "integer",
          "format": "int32"
        },
        "req_count4xx": {
          "description": "4xx响应码总次数",
          "type": "integer",
          "format": "int32"
        },
        "req_count5xx": {
          "description": "5xx响应码总次数",
          "type": "integer",
          "format": "int32"
        },
        "req_count_error": {
          "description": "错误次数",
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "NetworkTrafficStats": {
      "properties": {
        "output_throughput": {
          "description": "下行吞吐量(byte)",
          "type": "integer",
          "format": "int64"
        },
        "input_throughput": {
          "description": "上行吞吐量(byte)",
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "InnerLatencyStats": {
      "properties": {
        "max_inner_latency": {
          "description": "最大网关内部延时",
          "type": "integer",
          "format": "int32"
        },
        "avg_inner_latency": {
          "description": "平均网关内部延时",
          "type": "number",
          "format": "float"
        }
