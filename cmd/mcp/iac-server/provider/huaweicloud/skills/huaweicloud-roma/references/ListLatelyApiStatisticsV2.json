        {
          "$ref": "#/definitions/LatencyStats"
        },
        {
          "$ref": "#/definitions/RequestCountStats"
        },
        {
          "$ref": "#/definitions/InnerLatencyStats"
        },
        {
          "$ref": "#/definitions/BackendLatencyStats"
        },
        {
          "$ref": "#/definitions/NetworkTrafficStats"
        },
        {
          "type": "object",
          "properties": {
            "current_minute": {
              "description": "API访问的UTC时间戳",
              "type": "integer",
              "format": "int64"
            },
            "cycle": {
              "description": "查询统计周期",
              "type": "string",
              "enum": [
                "MINUTE",
                "HOUR",
                "DAY"
              ]
            },
            "api_id": {
              "description": "API编号",
              "type": "string"
            },
            "group_id": {
              "description": "API分组编号",
              "type": "string"
            },
            "provider": {
              "description": "API拥有者",
              "type": "string"
            },
            "req_time": {
              "description": "API请求时间",
              "type": "string",
              "format": "date-time"
            },
            "register_time": {
              "description": "记录时间",
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "type": "integer",
              "format": "int32",
              "description": "状态值:\n- 1:调度中,未上报CES\n- 2:已经成功上报CES\n\n预留字段,暂不支持",
              "enum": [
                1,
                2
              ]
            }
          }
        }
      ]
    },
    "LatencyStats": {
      "properties": {
        "max_latency": {
          "description": "最大延时",
          "type": "integer",
          "format": "int32"
        },
        "avg_latency": {
          "description": "平均延时",
          "type": "number",
          "format": "float"
        }
      }
    },
    "BackendLatencyStats": {
      "properties": {
        "max_backend_latency": {
          "description": "最大后端延时",
          "type": "integer",
          "format": "int32"
        },
        "avg_backend_latency": {
          "description": "平均后端延时",
          "type": "number",
          "format": "float"
        }
      }
    },
    "StatisticsApiResp": {
      "properties": {
        "code": {
          "description": "响应码",
          "type": "string"
        },
        "start_time": {
          "description": "开始时间的UTC的时间戳",
          "type": "integer",
          "format": "int64"
        },
        "end_time": {
          "description": "截止时间的UTC的时间戳",
          "type": "integer",
          "format": "int64"
        },
        "list": {
          "description": "统计指标的数据结构结构体",
          "type": "array",
          "items": {
            "$ref": "#/definitions/StatisticsAPI"
          }
        }
      }
    },
    "RequestCountStats": {
      "properties": {
        "req_count": {
          "description": "请求总次数",
          "type": "integer",
          "format": "int32"
        },
