{
  "name": "ListLatelyApiStatisticsV2",
  "summary": "API指标统计值查询-最近一段时间",
  "tags": "监控信息查询",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/statistics/api/latest": {
      "get": {
        "summary": "API指标统计值查询-最近一段时间",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-order": 1,
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud",
        "description": "根据API的id和最近的一段时间查询API被调用的次数,统计周期为1分钟。查询范围一小时以内,一分钟一个样本,其样本值为一分钟内的累计值。\n> 为了安全起见,在服务器上使用curl命令调用接口查询信息后,需要清理历史操作记录,包括但不限于“~/.bash_history”、“/var/log/messages”(如有)。",
        "schemes": [
          "https"
        ],
        "tags": [
          "监控信息查询"
        ],
        "operationId": "ListLatelyApiStatisticsV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "in": "query",
            "name": "api_id",
            "x-example": "39bce6d25a3f470e8cf7b2c97174f7d9",
            "description": "API的编号",
            "type": "string",
            "required": true
          },
          {
            "in": "query",
            "name": "duration",
            "x-example": "1h",
            "description": "最近统计时长,单位必须为h和m,比如1h和1m,分别代表最近1小时和最近1分钟",
            "type": "string",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/StatisticsApiResp"
            },
            "examples": {
              "application/json": {
                "code": "APIG.0000",
                "start_time": 1595573280,
                "end_time": 1595576820,
                "list": [
                  {
                    "api_id": "39bce6d25a3f470e8cf7b2c97174f7d9",
                    "avg_backend_latency": 2.71,
                    "avg_inner_latency": 1.57,
                    "avg_latency": 4.14,
                    "current_minute": 1595576640,
                    "cycle": "MINUTE",
                    "group_id": "d0fc4e40b7d1492cba802f667c7c7226",
                    "input_throughput": 1071,
                    "max_backend_latency": 6,
                    "max_inner_latency": 8,
                    "max_latency": 14,
                    "output_throughput": 3790,
                    "provider": "73d69ae0cfcf460190522d06b60f05ad",
                    "register_time": "2020-07-24 15:44:56",
                    "req_count": 7,
                    "req_count2xx": 0,
                    "req_count4xx": 6,
                    "req_count5xx": 1,
                    "req_count_error": 7,
                    "req_time": "2020-07-24 15:44:00",
                    "status": 1
                  }
                ]
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:api_id. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3002",
                "error_msg": "API 39bce6d25a3f470e8cf7b2c97174f7d9 does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "StatisticsAPI": {
