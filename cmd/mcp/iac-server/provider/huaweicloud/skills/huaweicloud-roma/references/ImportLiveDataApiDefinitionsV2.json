            "required": false,
            "description": "扩展信息导入模式\n- merge:当扩展信息定义冲突时,merge保留原有扩展信息\n- override:当扩展信息定义冲突时,override会覆盖原有扩展信息",
            "enum": [
              "merge",
              "override"
            ],
            "default": "merge"
          },
          {
            "name": "api_mode",
            "type": "string",
            "in": "formData",
            "required": false,
            "description": "导入模式\n- merge:当API信息定义冲突时,merge保留原有API信息\n- override:当API信息定义冲突时,override会覆盖原有API信息",
            "enum": [
              "merge",
              "override"
            ],
            "default": "merge"
          },
          {
            "name": "file_name",
            "in": "formData",
            "type": "file",
            "description": "导入自定义后端API的请求体,json或yaml格式的文件",
            "required": true
