{
  "name": "ListDatasourceTables",
  "summary": "获取数据源中所有的表",
  "tags": "数据源管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/fdi/instances/{instance_id}/datasources/{datasource_id}/tables": {
      "get": {
        "tags": [
          "数据源管理"
        ],
        "operationId": "ListDatasourceTables",
        "summary": "获取数据源中所有的表",
        "description": "获取数据源中所有的表",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "public",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/instance_id"
          },
          {
            "$ref": "#/parameters/datasource_id"
          },
          {
            "in": "query",
            "name": "position",
            "description": "数据源所在任务位置\n- SOURCE 数据源处于任务源端\n- TARGET 数据源处于任务目标端",
            "enum": [
              "SOURCE",
              "TARGET"
            ],
            "type": "string",
            "minLength": 0,
            "maxLength": 6,
            "required": true,
            "x-example": "SOURCE"
          },
          {
            "in": "query",
            "name": "db_name",
            "description": "数据库名称,只支持MRSHIVE,FIHIVE类型的数据源",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": false,
            "x-example": "TESTDB"
          },
          {
            "in": "query",
            "name": "db_schema",
            "description": "数据库模式,GAUSS100数据库使用",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": false,
            "x-example": "TESTSCHEMA"
          },
          {
            "in": "query",
            "name": "filter",
            "description": "表名模糊匹配过滤器",
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "required": false,
            "x-example": "TABLEA"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/TableResponse"
            }
          },
          "400": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorRsp404"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorRsp500"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "TableResponse": {
      "description": "数据库表名查询返回对象",
      "properties": {
        "tables": {
          "type": "array",
          "description": "数据源中所有的表名称",
          "minItems": 0,
          "maxItems": 2147483647,
          "items": {
            "type": "string"
          },
          "example": [
            "schemaA.tableA",
            "schemaB.tableB"
          ]
        }
      }
    },
    "ErrorRsp500": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.9999"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "Network error."
        }
      }
    },
    "ErrorRsp404": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.3081"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "The task does not exist."
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.xxxx"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "Failed to xxxx."
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方式请参见《ROMA Connect API参考》的“附录 > 获取项目ID”章节。",
      "type": "string",
      "required": true,
      "maxLength": 32,
      "minLength": 0
    },
    "datasource_id": {
      "name": "datasource_id",
      "in": "path",
      "description": "数据源ID",
      "type": "string",
      "required": true,
      "maxLength": 64,
      "minLength": 1,
      "x-example": "acb3b4049bb643e39ca12a87a735b34d"
    },
    "instance_id": {
      "name": "instance_id",
      "in": "path",
      "description": "实例ID",
      "type": "string",
      "required": true,
      "maxLength": 36,
      "minLength": 0
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}