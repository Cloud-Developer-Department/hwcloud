  "tags": "SSL证书管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/certificates": {
      "post": {
        "tags": [
          "SSL证书管理"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-order": 5,
        "x-open-region-cloud": "hc,hcso",
        "x-hybridcloud": true,
        "operationId": "CreateCertificateV2",
        "description": "创建SSL证书",
        "summary": "创建SSL证书",
        "parameters": [
          {
            "$ref": "#/parameters/apic_project_id"
