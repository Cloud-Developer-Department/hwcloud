  "definitions": {
    "CertificateDetailResp": {
      "allOf": [
        {
          "$ref": "#/definitions/CertBase"
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "format": "int32",
              "example": 3,
              "description": "版本"
            },
            "organization": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "hw"
              ],
              "description": "公司、组织"
            },
            "organizational_unit": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "IT"
              ],
              "description": "部门"
            },
            "locality": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "城市",
              "example": [
                "sz"
              ]
            },
            "state": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "gd"
              ],
              "description": "省份"
            },
            "country": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "CN"
              ],
              "description": "国家"
            },
            "not_before": {
              "type": "string",
              "format": "date-time",
              "example": "2019-10-30T11:15:45Z",
              "description": "有效期从"
            },
            "serial_number": {
              "type": "string",
              "example": "13010",
              "description": "序列号"
            },
            "issuer": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "SSL Inc"
              ],
              "description": "颁发者"
            }
          }
        }
      ]
    },
    "CertificateForm": {
      "description": "添加或编辑证书的请求体表单",
      "properties": {
        "name": {
          "type": "string",
          "description": "证书名称",
          "example": "cert_demo"
        },
        "cert_content": {
          "type": "string",
          "description": "证书内容",
          "example": "-----BEGIN CERTIFICATE-----THIS IS YOUR CERT CONTENT-----END CERTIFICATE-----"
        },
        "private_key": {
          "type": "string",
          "description": "证书私钥",
          "example": "-----BEGIN RSA PRIVATE KEY-----THIS IS YOUR PRIVATE KEY-----END RSA PRIVATE KEY-----"
        },
        "type": {
          "type": "string",
          "description": "证书可见范围:\n- instance\n- global\n\n编辑证书时不支持修改为其他可见范围",
          "default": "global",
          "enum": [
            "instance",
            "global"
          ],
          "example": "instance"
        },
        "instance_id": {
          "type": "string",
          "description": "所属实例ID,当type=instance时必填",
          "example": "f0fa1789-3b76-433b-a787-9892951c620e"
        },
        "trusted_root_ca": {
          "type": "string",
          "description": "信任的根证书CA",
          "example": "-----BEGIN CERTIFICATE-----THIS IS YOUR CERT CONTENT-----END CERTIFICATE-----"
        },
        "algorithm_type": {
          "type": "string",
          "description": "证书算法类型:\n- RSA\n- ECC\n- SM2",
          "enum": [
            "RSA",
            "ECC",
            "SM2"
          ],
          "example": "RSA"
        },
        "cert_content_sign": {
          "type": "string",
          "description": "签名类型证书内容,仅algorithm_type=SM2时必填",
          "maxLength": 8092
        },
        "private_key_sign": {
          "type": "string",
          "description": "签名类型私钥内容,仅algorithm_type=SM2时必填",
          "maxLength": 8092
        }
      },
      "required": [
        "name",
        "cert_content",
        "private_key"
      ]
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "CertBase": {
      "properties": {
        "id": {
          "type": "string",
          "example": "a27be832f2e9441c8127fe48e3b5ac67",
          "description": "证书ID"
        },
        "name": {
          "type": "string",
          "example": "cert_demo",
          "description": "证书名称"
        },
        "type": {
          "type": "string",
          "enum": [
            "global",
            "instance"
          ],
          "example": "instance",
          "description": "证书类型\n\n- global:全局证书\n- instance:实例证书"
        },
        "instance_id": {
          "type": "string",
          "example": "f0fa1789-3b76-433b-a787-9892951c620e",
          "description": "实例编码\n\n- `type`为`global`时,缺省为common\n- `type`为`instance`时,为实例编码"
        },
        "project_id": {
          "type": "string",
          "example": "73d69ae0cfcf460190522d06b60f05ad",
          "description": "租户项目编号"
        },
        "common_name": {
          "type": "string",
          "example": "apigtest.xxx.com",
          "description": "域名"
        },
        "san": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "apigtest.xxx.com",
            "*.san.com"
          ],
          "description": "san扩展域名"
        },
        "not_after": {
          "type": "string",
          "format": "date-time",
          "example": "2020-10-29T11:15:45Z",
          "description": "有效期到"
        },
        "signature_algorithm": {
          "type": "string",
          "example": "SHA256-RSA",
          "description": "签名算法"
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "example": "2020-01-01T00:00:00Z",
          "description": "创建时间"
        },
        "update_time": {
          "type": "string",
          "format": "date-time",
          "example": "2020-01-01T00:00:00Z",
          "description": "更新时间"
        },
        "algorithm_type": {
          "type": "string",
          "description": "证书算法类型:\n- RSA\n- ECC\n- SM2",
          "enum": [
            "RSA",
            "ECC",
            "SM2"
          ],
          "example": "RSA"
        },
        "is_has_trusted_root_ca": {
          "description": "是否存在信任的根证书CA。当绑定证书存在trusted_root_ca时为true。",
          "type": "boolean",
          "default": false,
          "example": false
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
      "required": true,
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
