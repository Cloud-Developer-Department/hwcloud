          "default": 1,
          "minimum": 1,
          "maximum": 10
        },
        "contain_device_info": {
          "type": "integer",
          "format": "int32",
          "enum": [
            0,
            1
          ],
          "description": "是否包含设备信息是否包含设备信息,0-是 1-否",
