          "description": "部署的环境编号",
          "type": "string"
        },
        "api_id": {
          "description": "部署的前端API编号",
          "type": "string"
        },
        "deploy_time": {
          "description": "部署时间",
          "type": "string",
          "format": "date-time"
        },
        "api_definition": {
          "description": "自定义后端API详情",
          "$ref": "#/definitions/LdApiInfo"
        }
      }
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "LdApiInfo": {
      "description": "后端API详情",
      "allOf": [
        {
          "$ref": "#/definitions/LdApiCreate"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "后端API编号",
              "type": "string"
            },
            "instance": {
              "description": "后端API所属实例编号",
              "type": "string"
            },
            "type": {
              "description": "后端API类型:\n- data:数据后端\n- function: 函数后端",
              "enum": [
                "data",
                "function"
              ],
              "type": "string"
            },
            "status": {
              "description": "后端API状态:\n- 1:待开发\n- 3:开发中\n- 4:已部署",
              "enum": [
                1,
                3,
                4
              ],
              "type": "integer",
              "format": "int32"
            },
            "created_time": {
              "description": "后端API创建时间",
              "type": "string",
              "format": "date-time"
            },
            "modified_time": {
              "description": "后端API修改时间",
              "type": "string",
              "format": "date-time"
            },
            "scripts": {
              "description": "后端API脚本信息",
              "type": "array",
              "items": {
                "$ref": "#/definitions/LdApiScript"
              }
            },
            "roma_app_name": {
              "description": "后端API归属的集成应用名称",
              "type": "string"
            }
          }
        }
      ]
    },
    "LdApiScript": {
      "allOf": [
        {
          "$ref": "#/definitions/LdApiScriptBase"
        },
        {
          "type": "object",
          "properties": {
            "created_time": {
              "description": "后端API脚本创建时间",
              "type": "string",
              "format": "date-time"
            },
            "modified_time": {
              "description": "后端API脚本修改时间",
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "LdApiCreate": {
      "required": [
        "name",
        "path",
        "method",
        "version",
        "content_type",
        "roma_app_id"
      ],
      "properties": {
        "name": {
          "description": "后端API名称。\n\n支持汉字、英文、数字、中划线、下划线、点、斜杠、中英文格式下的小括号和冒号、中文格式下的顿号,且只能以英文、汉字和数字开头。",
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^([a-zA-Z0-9]|[\\一-\\龥])([a-zA-Z0-9:._()\\\\//-]|[\\一-\\龥\\（\\）\\：\\、]){2,99}$"
        },
        "path": {
          "description": "后端API请求路径。\n\n支持英文、数字、中划线、下划线、点等,且以斜杠(/)开头。\n\n更新后端API时,status=4为后端API的已部署状态,该状态下后端API请求路径不能修改。",
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^\\\\/[\\\\/\\\\.a-zA-Z0-9_-]{1,255}$"
        },
        "method": {
          "description": "后端API请求方法。\n\n支持GET、PUT、POST、DELETE\n\n更新后端API时,status=4为后端API的已部署状态,该状态下后端API请求方法不能修改。",
          "enum": [
            "GET",
            "PUT",
            "POST",
            "DELETE"
          ],
          "type": "string"
        },
        "description": {
          "description": "后端API描述。\n\n不支持<,>字符",
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "version": {
          "description": "后端API版本\n\n支持英文,数字,下划线,中划线,点。",
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-zA-Z0-9_.-]{1,63}$"
        },
        "content_type": {
          "description": "后端API返回类型",
          "type": "string",
          "enum": [
            "json",
            "xml",
            "stream"
          ],
          "default": "json"
        },
        "api_signature_id": {
          "description": "后端API为签名认证时绑定的签名密钥编号",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9-_]{0,63}$"
        },
        "roma_app_id": {
          "description": "后端API归属的集成应用编号\n\n更新后端API时,status=4为后端API的已部署状态,该状态下后端API归属的集成应用编号不能修改。",
          "type": "string",
          "minLength": 1,
          "maxLength": 65,
          "pattern": "^[a-zA-Z0-9-_]{0,64}$"
        },
        "return_format": {
          "description": "API响应信息是否格式化\n\ntrue: 对响应信息进行格式化\n\nfalse:对响应信息格式化不进行格式化",
          "type": "boolean",
          "default": false
        },
        "parameters": {
          "description": "后端API的请求参数列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/LdApiParameter"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_ld_api_id": {
      "name": "ld_api_id",
