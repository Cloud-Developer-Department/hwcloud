    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
      "required": true,
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
