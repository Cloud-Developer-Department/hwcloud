  "definitions": {
    "LdApiScriptBase": {
      "required": [
        "content",
        "object_name"
      ],
      "properties": {
        "ds_id": {
          "description": "数据源编号,当api_type = data时,必选",
          "type": "string"
        },
        "ds_name": {
          "description": "数据源名称",
          "type": "string"
        },
        "ds_type": {
          "type": "string",
          "description": "数据源类型:\n\n- oracle:oracle数据源类型\n\n- mysql:mysql数据源类型\n\n- mongodb:mongodb数据源类型\n\n- redis:redis数据源类型\n\n- postgresql:postgresql/opengauss数据源类型\n\n- hive:hive数据源类型\n\n- mssql:sqlserver数据源类型\n\n- sqlserver:sqlserver数据源类型\n\n- dws:dws数据源类型\n\n- gauss100:gauss100数据源类型\n\n- zenith:zenith数据源类型",
          "enum": [
            "oracle",
            "mysql",
            "mongodb",
            "redis",
            "postgresql",
            "hive",
            "mssql",
            "sqlserver",
            "dws",
            "gauss100",
            "zenith"
          ]
        },
        "type": {
          "description": "脚本类型\n- SQL:sql语句\n- SP:存储过程",
          "type": "string"
        },
        "object_name": {
          "description": "返回对象。",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^([A-Za-z])([A-Za-z0-9_-]){0,31}$"
        },
        "content": {
          "description": "API脚本内容\n\n请对脚本进行base64编码",
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "enable_result_paging": {
          "description": "数据脚本是否结果分页,当api_type = data时有效",
          "type": "boolean",
          "default": false
        },
        "enable_preparestatement": {
          "description": "数据脚本是否预编译,当api_type = data时有效",
          "type": "boolean",
          "default": false
        }
      }
    },
    "LdApiDeploy": {
      "properties": {
        "ld_api_id": {
          "description": "后端API的编号",
          "type": "string",
          "example": "bd42841c20184da6bbf457c6d8a06e37"
        },
        "deploy_front_api": {
          "description": "是否自动发布API\n- true:部署完成后自动创建并发布前端API。此时auth_type,group_id,env_id,protocol必填。\n- false:部署完成后不创建前端API",
          "type": "boolean",
          "default": true
        },
        "auth_type": {
          "description": "认证方式\n- NONE:无认证\n- APP:APP认证\n- IAM:IAM认证\n- AUTHORIZER:自定义认证",
          "type": "string"
        },
        "authorizer_id": {
          "description": "自定义认证编号。\n\n认证方式auth_type = AUTHORIZER时必填",
          "type": "string"
        },
        "group_id": {
          "description": "部署的前端API分组编号",
          "type": "string"
        },
        "env_id": {
          "description": "部署的环境编号",
          "type": "string"
        },
        "protocol": {
          "description": "请求协议",
          "enum": [
            "HTTPS",
            "HTTP",
            "HTTPS&HTTP"
          ],
          "type": "string",
          "default": "HTTPS"
        },
        "backend_timeout": {
          "description": "超时时间",
          "type": "integer"
        },
        "path": {
          "description": "请求路径",
          "type": "string"
        },
        "method": {
          "description": "请求方式",
          "type": "string"
        },
        "cors": {
          "description": "是否支持跨域\n- true:支持\n- false:不支持",
          "type": "boolean",
          "default": false
        },
        "roma_app_id": {
          "description": "部署到前端的api归属的应用编号,与后端归属的应用编号保持一致",
          "type": "string"
        },
        "retry_count": {
          "description": "服务集成请求后端服务的重试次数,默认为-1,范围[-1,10]",
          "default": "-1",
          "type": "string",
          "example": "1"
        }
      }
    },
    "LdApiParameter": {
      "description": "后端API请求参数",
      "required": [
        "name",
        "in"
      ],
      "properties": {
        "name": {
          "description": "参数名称:\n- 参数位于Headers、 Parameters时,用户自行定义,支持英文、数字、点、中划线、下划线,且需要英文开头,不区分大小写。\n- 参数位于Body时候,参数以application/json、application/xml、application/text为名,但实际是以请求body里的键值对作为参数名和参数值,比如请求消息样例,参数名为application/json,参数值为{\\\"table\\\":\\\"apic01\\\",\\\"id\\\":\\\"1\\\"},后端取table:apic01,id:1这两个键值对作为入参。\n- 注意:定义参数不要重名,否则会覆盖掉,当Headers、Parameters重复时候,Parameters会被覆盖,当Parameters和Body里的键值对重复时候,Parameters会被覆盖。",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z][a-zA-Z0-9._\\\\/-]{0,31}$"
        },
        "in": {
          "description": "该参数在调用API时候所放的位置:\n- Headers :放于请求头\n- Parameters :放于请求参数\n- Body:放于请求体",
          "type": "string",
          "enum": [
            "Headers",
            "Parameters",
            "Body"
          ]
        },
        "default": {
          "description": "参数默认值",
          "type": "string",
          "maxLength": 4000
        },
        "description": {
          "description": "参数描述\n\n不支持<,>字符",
          "type": "string",
          "minLength": 0,
          "maxLength": 255
        },
        "required": {
          "description": "参数是否必须。true:必须,false:不必须",
          "type": "boolean",
          "default": false
        }
      }
    },
    "LdApiDeployHistoryInfo": {
      "properties": {
        "id": {
          "description": "部署的编号",
          "type": "string"
        },
        "ld_api_id": {
          "description": "部署的后端API编号",
          "type": "string"
        },
        "group_id": {
          "description": "部署的前端API分组编号",
          "type": "string"
