{
  "name": "ShowDetailsOfDomainNameCertificateV2",
  "summary": "查看域名证书",
  "tags": "域名管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/api-groups/{group_id}/domains/{domain_id}/certificate/{certificate_id}": {
      "get": {
        "summary": "查看域名证书",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-order": 5,
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "description": "查看域名下绑定的证书详情。",
        "schemes": [
          "https"
        ],
        "tags": [
          "域名管理"
        ],
        "operationId": "ShowDetailsOfDomainNameCertificateV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_group_id"
          },
          {
            "$ref": "#/parameters/apic_domain_id"
          },
          {
            "$ref": "#/parameters/apic_certificate_id"
          }
        ],
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/CertDetailResp"
            },
            "examples": {
              "application/json": {
                "serial_number": "219450666855693268010130472645821723203",
                "version": 3,
                "san": [
                  "www.company.com"
                ],
                "not_before": "2019-06-01T00:00:00Z",
                "issuer": [
                  "mkcert development CA"
                ],
                "not_after": "2030-08-04T07:41:19Z",
                "organization": [
                  "mkcert development certificate"
                ],
                "signature_algorithm": "SHA256-RSA",
                "organizational_unit": [
                  "Country\\\\DESKTOP-L2TFOFH"
                ]
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:domain_id. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3020",
                "error_msg": "The URL domain does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "CertBase": {
      "properties": {
        "id": {
          "type": "string",
          "example": "a27be832f2e9441c8127fe48e3b5ac67",
          "description": "证书ID"
        },
        "name": {
          "type": "string",
          "example": "cert_demo",
          "description": "证书名称"
        },
        "type": {
          "type": "string",
          "enum": [
            "global",
            "instance"
          ],
          "example": "instance",
          "description": "证书类型\n\n- global:全局证书\n- instance:实例证书"
        },
        "instance_id": {
          "type": "string",
          "example": "f0fa1789-3b76-433b-a787-9892951c620e",
          "description": "实例编码\n\n- `type`为`global`时,缺省为common\n- `type`为`instance`时,为实例编码"
        },
        "project_id": {
          "type": "string",
          "example": "73d69ae0cfcf460190522d06b60f05ad",
          "description": "租户项目编号"
        },
        "common_name": {
          "type": "string",
          "example": "apigtest.xxx.com",
          "description": "域名"
        },
        "san": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "apigtest.xxx.com",
            "*.san.com"
          ],
          "description": "san扩展域名"
        },
        "not_after": {
          "type": "string",
          "format": "date-time",
          "example": "2020-10-29T11:15:45Z",
          "description": "有效期到"
        },
        "signature_algorithm": {
          "type": "string",
          "example": "SHA256-RSA",
          "description": "签名算法"
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "example": "2020-01-01T00:00:00Z",
          "description": "创建时间"
        },
        "update_time": {
          "type": "string",
          "format": "date-time",
          "example": "2020-01-01T00:00:00Z",
          "description": "更新时间"
        },
        "algorithm_type": {
          "type": "string",
          "description": "证书算法类型:\n- RSA\n- ECC\n- SM2",
          "enum": [
            "RSA",
            "ECC",
            "SM2"
          ],
          "example": "RSA"
        },
        "is_has_trusted_root_ca": {
          "description": "是否存在信任的根证书CA。当绑定证书存在trusted_root_ca时为true。",
          "type": "boolean",
          "default": false,
          "example": false
        }
      }
    },
    "CertDetailResp": {
      "allOf": [
        {
          "$ref": "#/definitions/CertBase"
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "format": "int32",
              "example": 3,
              "description": "版本"
            },
            "organization": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "hw"
              ],
              "description": "公司、组织"
            },
            "organizational_unit": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "IT"
              ],
              "description": "部门"
            },
            "locality": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "城市",
              "example": [
                "sz"
              ]
            },
            "state": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "gd"
              ],
              "description": "省份"
            },
            "country": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "CN"
              ],
              "description": "国家"
            },
            "not_before": {
              "type": "string",
              "format": "date-time",
              "example": "2019-10-30T11:15:45Z",
              "description": "有效期从"
            },
            "serial_number": {
              "type": "string",
              "example": "13010",
              "description": "序列号"
            },
            "issuer": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "SSL Inc"
              ],
              "description": "颁发者"
            }
          }
        }
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_domain_id": {
      "name": "domain_id",
      "in": "path",
      "type": "string",
      "description": "域名的编号",
      "required": true,
      "x-example": "f6bb84ccf1c34035878aa51b7253b21c"
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID",
      "required": true,
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
      "required": true,
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_group_id": {
      "name": "group_id",
      "in": "path",
      "type": "string",
      "description": "分组的编号",
      "required": true,
      "x-example": "c77f5e81d9cb4424bf704ef2b0ac7600"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "apic_certificate_id": {
      "name": "certificate_id",
      "in": "path",
      "type": "string",
      "description": "证书的编号",
      "required": true,
      "x-example": "a27be832f2e9441c8127fe48e3b5ac67"
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}