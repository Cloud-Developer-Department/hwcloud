          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "ThrottleApiBinding": {
      "properties": {
        "publish_id": {
          "description": "API的发布记录编号",
          "type": "string"
        },
        "scope": {
          "description": "策略作用域,取值如下:\n- 1:整个API\n- 2: 单个用户\n- 3:单个APP\n\n目前只支持1",
          "enum": [
            1,
            2,
            3
          ],
          "type": "integer",
          "format": "int32"
        },
        "strategy_id": {
          "description": "流控策略的ID",
          "type": "string"
        },
        "apply_time": {
          "description": "绑定时间",
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "description": "绑定关系的ID",
          "type": "string"
        }
      }
    }
  },
