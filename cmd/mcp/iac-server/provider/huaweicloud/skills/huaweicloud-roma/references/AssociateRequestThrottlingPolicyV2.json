  "definitions": {
    "ThrottleApiBindingCreate": {
      "required": [
        "strategy_id",
        "publish_ids"
      ],
      "properties": {
        "strategy_id": {
          "description": "流控策略编号",
          "type": "string",
          "minLength": 1,
          "maxLength": 65,
          "pattern": "^[a-zA-Z0-9-_]{0,64}$",
          "example": "0325b6712d504614986822102262695d"
        },
        "publish_ids": {
          "description": "API的发布记录编号",
          "type": "array",
          "example": [
            "374a6d5a20c74ea182e119fce4556956",
            "65e6fe531ac34481ba369f0bc6f22057"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ThrottleApiBindingPage": {
      "properties": {
        "throttle_applys": {
          "description": "API与流控策略的绑定关系列表",
          "type": "array",
          "items": {
