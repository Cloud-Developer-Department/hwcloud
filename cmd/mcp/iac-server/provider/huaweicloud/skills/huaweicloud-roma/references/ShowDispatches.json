{
  "name": "ShowDispatches",
  "summary": "查询调度计划",
  "tags": "任务管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/fdi/instances/{instance_id}/tasks/{task_id}/dispatches": {
      "get": {
        "tags": [
          "任务管理"
        ],
        "operationId": "ShowDispatches",
        "summary": "查询调度计划",
        "description": "查询调度计划",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "public",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/instance_id"
          },
          {
            "$ref": "#/parameters/task_id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/TaskDispatchRsp"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/Rsp400"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/Rsp404"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorRsp500"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "TaskDispatchRsp": {
      "description": "查询调度计划的返回对象",
      "properties": {
        "dispatch_id": {
          "description": "调度计划ID",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "example": "63847a87c0484c4f880bfb5f529fa543"
        },
        "task_id": {
          "description": "调度计划关联的任务ID",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "example": "15366328208d4d77b76532fe9f4006a6"
        },
        "start_datetime": {
          "description": "调度计划的执行开始时间",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 99999999999999999,
          "example": 1605234403206
        },
        "period": {
          "description": "调度计划执行周期的时间单位,当使用cron表达式时,为空\n- MIN (分钟)\n- HOUR (小时)\n- DAY (日)\n- WEEK (周)\n- MON (月)",
          "type": "string",
          "enum": [
            "MIN",
            "HOUR",
            "DAY",
            "WEEK",
            "MON"
          ],
          "minLength": 0,
          "maxLength": 36,
          "example": "MIN"
        },
        "dispatch_interval": {
          "description": "调度计划的执行间隔时间周期",
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 59,
          "example": 1
        },
        "created_date": {
          "description": "调度计划的创建时间",
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 99999999999999999,
          "example": 1605234403206
        },
        "last_modified_date": {
          "description": "调度计划最近一次的修改时间",
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 99999999999999999,
          "example": 1605234403206
        },
        "remark": {
          "description": "调度计划的备注信息",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "test"
        },
        "use_quartz_cron": {
          "description": "调度计划是否使用cron表达式,允许如下值:\n- true (使用cron表达式)\n- false (不使用cron表达式)",
          "type": "boolean",
          "minLength": 4,
          "maxLength": 16,
          "example": false
        },
        "cron": {
          "description": "调度计划的cron表达式",
          "type": "string",
          "minLength": 8,
          "maxLength": 255,
          "example": "0 30 12 * * ?"
        }
      }
    },
    "ErrorRsp500": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.9999"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "Network error."
        }
      }
    },
    "Rsp404": {
      "description": "Not Found",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.xxxx"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "Failed to xxxx."
        }
      }
    },
    "Rsp400": {
      "description": "400返回错误码",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.xxxx"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "Failed to xxxx."
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方式请参见《ROMA Connect API参考》的“附录 > 获取项目ID”章节。",
      "type": "string",
      "required": true,
      "maxLength": 32,
      "minLength": 0
    },
    "instance_id": {
      "name": "instance_id",
      "in": "path",
      "description": "实例ID",
      "type": "string",
      "required": true,
      "maxLength": 36,
      "minLength": 0
    },
    "task_id": {
      "name": "task_id",
      "in": "path",
      "description": "任务ID",
      "type": "string",
      "required": true,
      "maxLength": 64,
      "minLength": 1
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}