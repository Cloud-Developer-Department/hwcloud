  "definitions": {
    "PluginCreate": {
      "required": [
        "plugin_name",
        "plugin_type",
        "plugin_scope",
        "plugin_content"
      ],
      "properties": {
        "plugin_name": {
          "type": "string",
          "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9_]|[\\一-\\龥]){2,254}$",
          "description": "插件名称。支持汉字,英文,数字,下划线,且只能以英文和汉字开头,3-255字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "example": "跨域插件"
        },
        "plugin_type": {
          "type": "string",
          "enum": [
            "cors",
            "set_resp_headers",
            "kafka_log",
            "breaker",
            "rate_limit",
