    "VpcMemberPage": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "members": {
              "description": "本次查询到的云服务器列表",
              "type": "array",
              "items": {
                "$ref": "#/definitions/VpcMemberInfo"
              }
            }
          }
        }
      ]
    },
    "MemberInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/MemberBase"
        },
        {
          "type": "object",
          "properties": {
            "ecs_id": {
              "description": "后端云服务器的编号。\n\n后端实例类型为ecs时必填,支持英文,数字,“-”,“_”,1 ~ 64字符。",
              "type": "string",
              "maxLength": 255
            },
            "ecs_name": {
              "description": "[后端云服务器的名称。]\n\n后端实例类型为ecs时必填,支持汉字,英文,数字,“-”,“_”,“.”,1 ~ 64字符。",
              "type": "string",
              "maxLength": 64
            }
          }
        }
      ]
    },
    "MemberBase": {
      "properties": {
        "host": {
          "description": "后端服务器地址\n\n后端实例类型为ip时必填",
          "type": "string",
          "maxLength": 64
        },
        "weight": {
          "description": "权重值。\n\n允许您对后端服务进行评级,权重值越大,转发到该云服务的请求数量越多。",
          "minimum": 0,
          "maximum": 10000,
          "type": "integer",
          "format": "int32"
        },
        "is_backup": {
          "description": "是否备用节点。\n\n开启后对应后端服务为备用节点,仅当非备用节点全部故障时工作。\n\n实例需要升级到对应版本才支持此功能,若不支持请联系技术支持。",
          "type": "boolean",
          "default": false
        },
        "member_group_name": {
          "description": "后端服务器组名称。为后端服务地址选择服务器组,便于统一修改对应服务器组的后端地址。",
          "type": "string"
        },
        "status": {
          "description": "后端服务器状态\n  - 1:可用\n  - 2:不可用",
          "enum": [
            1,
            2
          ],
          "type": "integer",
          "format": "int32"
        },
        "port": {
          "description": "后端服务器端口",
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "format": "int32"
        }
      }
    },
    "VpcMemberInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/MemberInfo"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "后端实例对象的编号",
              "type": "string"
            },
            "vpc_channel_id": {
              "description": "VPC通道的编号",
              "type": "string"
            },
            "create_time": {
              "description": "后端实例增加到VPC通道的时间",
              "type": "string",
              "format": "date-time"
            },
            "member_group_id": {
              "description": "后端服务器组编号",
              "type": "string"
            }
          }
        }
      ]
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "VpcMemberCreate": {
      "required": [
        "members"
      ],
      "properties": {
        "members": {
          "description": "后端实例列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MemberInfo"
          }
        }
      }
    }
