{
  "name": "ShowTask",
  "summary": "通过任务ID查询指定任务的信息",
  "tags": "任务管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/fdi/instances/{instance_id}/tasks/{task_id}": {
      "get": {
        "tags": [
          "任务管理"
        ],
        "operationId": "ShowTask",
        "summary": "通过任务ID查询指定任务的信息",
        "description": "通过任务ID查询指定任务的信息",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "public",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/instance_id"
          },
          {
            "$ref": "#/parameters/task_id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/TaskResponseV2"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorRsp404"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorRsp500"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "TaskResponseV2": {
      "description": "查询指定任务",
      "properties": {
        "task": {
          "$ref": "#/definitions/TaskBasicRsp"
        },
        "task_detail": {
          "description": "参数类型为string,参数结构参照附录中“数据集成参数说明>RawFormDataResponse”章节",
          "type": "string",
          "minLength": 1,
          "maxLength": 2147483647
        }
      }
    },
    "TaskBasicRsp": {
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务ID, 可为空",
          "minLength": 1,
          "maxLength": 64,
          "example": "15366328208d4d77b76532fe9f4006a6"
        },
        "task_name": {
          "type": "string",
          "description": "任务名称,只能以字母、数字为开头,包含字母、数字和 . _ -  3~100个字符",
          "minLength": 3,
          "maxLength": 100,
          "example": "fdi_task_v2mysql-tomysql"
        },
        "task_type": {
          "type": "string",
          "description": "任务类型\n- realtime (实时)\n- timing (定时)",
          "enum": [
            "realtime",
            "timing"
          ],
          "minLength": 1,
          "maxLength": 10,
          "example": "timing"
        },
        "status": {
          "type": "string",
          "description": "任务状态,\n- stop (0停止\\未启动)\n- running (1运行中)",
          "enum": [
            "stop",
            "running"
          ],
          "minimum": 0,
          "maximum": 1,
          "example": "stop"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID",
          "minLength": 1,
          "maxLength": 64,
          "example": "c53626012ba84727b938ca8bf03108ef"
        },
        "source_datasource_id": {
          "type": "string",
          "description": "源端数据源ID",
          "minLength": 1,
          "maxLength": 64,
          "example": "30969b205e8f4392a25fb321112d1753"
        },
        "target_datasource_id": {
          "type": "string",
          "description": "目标端数据源ID",
          "minLength": 1,
          "maxLength": 64,
          "example": "30969b205e8f4392a25fb321112d1753"
        },
        "source_datasource_name": {
          "type": "string",
          "description": "源端数据源的名称",
          "minLength": 1,
          "maxLength": 64,
          "example": "fdi_ds_testmysqlv2"
        },
        "target_datasource_name": {
          "type": "string",
          "description": "目标端数据源的名称",
          "minLength": 1,
          "maxLength": 64,
          "example": "fdi_ds_testmysqlv2"
        },
        "source_app_id": {
          "type": "string",
          "description": "源端数据源所属集成应用ID",
          "minLength": 1,
          "maxLength": 64,
          "example": "eaaa8ad0-f967-416a-ab73-d995ef656e89"
        },
        "target_app_id": {
          "type": "string",
          "description": "目标端数据源所属集成应用ID",
          "minLength": 1,
          "maxLength": 64,
          "example": "eaaa8ad0-f967-416a-ab73-d995ef656e89"
        },
        "source_app_name": {
          "type": "string",
          "description": "源端数据源所属集成应用名称",
          "minLength": 1,
          "maxLength": 64,
          "example": "app-testV2-interface"
        },
        "target_app_name": {
          "type": "string",
          "description": "目标端数据源所属集成应用名称",
          "minLength": 1,
          "maxLength": 64,
          "example": "app-testV2-interface"
        },
        "created_date": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间",
          "minimum": 0,
          "maximum": 99999999999999999999,
          "example": 1605288733684
        },
        "last_modified_date": {
          "description": "最近一次的修改时间",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 99999999999999999999,
          "example": 1605288733684
        },
        "description": {
          "type": "string",
          "description": "描述信息",
          "minLength": 1,
          "maxLength": 1024,
          "example": "crate task"
        },
        "task_tag": {
          "type": "string",
          "description": "任务标签,只能包含字母、数字、中划线、下划线",
          "minLength": 4,
          "maxLength": 64,
          "example": "fdi_autotest"
        }
      }
    },
    "ErrorRsp500": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.9999"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "Network error."
        }
      }
    },
    "ErrorRsp404": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.3081"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "The task does not exist."
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方式请参见《ROMA Connect API参考》的“附录 > 获取项目ID”章节。",
      "type": "string",
      "required": true,
      "maxLength": 32,
      "minLength": 0
    },
    "instance_id": {
      "name": "instance_id",
      "in": "path",
      "description": "实例ID",
      "type": "string",
      "required": true,
      "maxLength": 36,
      "minLength": 0
    },
    "task_id": {
      "name": "task_id",
      "in": "path",
      "description": "任务ID",
      "type": "string",
      "required": true,
      "maxLength": 64,
      "minLength": 1
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}