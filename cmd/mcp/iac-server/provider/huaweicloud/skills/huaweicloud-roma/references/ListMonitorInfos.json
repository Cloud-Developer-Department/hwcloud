{
  "name": "ListMonitorInfos",
  "summary": "任务监控信息列表查询",
  "tags": "任务监控管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/fdi/instances/{instance_id}/task-monitors": {
      "get": {
        "tags": [
          "任务监控管理"
        ],
        "operationId": "ListMonitorInfos",
        "summary": "任务监控信息列表查询",
        "description": "查询所有任务的监控信息",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "public",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/instance_id"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,表示从此偏移量开始查询, offset大于等于1",
            "type": "integer",
            "default": 1,
            "minimum": 1,
            "maximum": 999999
          },
          {
            "$ref": "#/parameters/limit"
          },
          {
            "name": "task_name",
            "in": "query",
            "description": "需要搜索的任务名称,支持模糊搜索,大小写敏感,非必填参数,如果为空,搜索所有任务",
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          {
            "name": "execute_status",
            "in": "query",
            "description": "需要搜索任务的执行状态, 只允许如下枚举值:UNSTARTED-未启动, WAITING-等待执行,RUNNING-执行中, SUCCESS-执行成功, CANCELLED-任务取消, ERROR-执行异常</br> 非必填参数,如果为空,搜索所有任务",
            "type": "string",
            "enum": [
              "UNSTARTED",
              "WAITING",
              "RUNNING",
              "SUCCESS",
              "CANCELLED",
              "ERROR"
            ],
            "maxLength": 10,
            "minLength": 0
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/TaskMonitorList"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorRsp400"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorRsp500"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorRsp400": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.3002"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "Invalid parameters."
        }
      }
    },
    "ErrorRsp500": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.9999"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "Network error."
        }
      }
    },
    "TaskMonitorInfo": {
      "description": "任务监控信息",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务ID",
          "minLength": 10,
          "maxLength": 40,
          "example": "id123456789"
        },
        "task_name": {
          "type": "string",
          "description": "任务名称",
          "minLength": 100,
          "maxLength": 3,
          "example": "fdi_task_name"
        },
        "task_type": {
          "type": "string",
          "description": "任务类型, 只允许两种类型:TIMING-定时任务, REALTIME-实时任务",
          "enum": [
            "TIMING",
            "REALTIME"
          ],
          "minLength": 10,
          "maxLength": 3,
          "example": "TIMING"
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "任务状态, 只允许两种类型:0-停止, 1-运行中",
          "enum": [
            0,
            1
          ],
          "minLength": 10,
          "maxLength": 3,
          "example": 0
        },
        "last_execute_time": {
          "type": "integer",
          "format": "int64",
          "description": "任务最近一次执行时间,格式timestamp(ms),使用UTC时区",
          "minimum": 1,
          "maximum": 999999999999999999,
          "example": 1603243428000
        },
        "use_quartz_cron": {
          "type": "boolean",
          "description": "任务是否使用Quartz表达式,只有定时任务才有该属性",
          "example": false
        },
        "cron": {
          "type": "string",
          "description": "CRON表达式,只有定时任务且use_quartz_cron为true时才有该属性",
          "minLength": 20,
          "maxLength": 3,
          "example": "0 */15 * * * ?"
        },
        "period": {
          "type": "string",
          "description": "调度周期的单位,如天,小时等,只有定时任务且use_quartz_cron为false时才有该属性,当前仅允许如下类型:MIN-分钟, HOUR-小时, DAY-天, WEEK-周, MON-月",
          "enum": [
            "MIN",
            "HOUR",
            "DAY",
            "WEEK",
            "MON"
          ],
          "minLength": 5,
          "maxLength": 3,
          "example": "DAY"
        },
        "dispatch_interval": {
          "type": "integer",
          "description": "调度周期,和period字段一起可以确定每隔多长时间调度一次,只有定时任务且use_quartz_cron为false时才有该属性",
          "minimum": 1,
          "maximum": 60,
          "example": 1
        },
        "position": {
          "type": "string",
          "description": "标识最近一次任务执行到哪一个阶段,允许如下值:ADAPTER-任务处于初始化阶段, READER-任务正在执行Reader读操作, WRITER-任务正在执行Writer写操作",
          "enum": [
            "ADAPTER",
            "READER",
            "WRITER"
          ],
          "minLength": 10,
          "maxLength": 3,
          "example": "READER"
        },
        "execute_status": {
          "type": "string",
          "description": "任务最近一次执行状态,允许如下值:UNSTARTED-未启动, WAITING-等待调度中, RUNNING-执行中, SUCCESS-执行成功, CANCELLED-任务取消, ERROR-执行异常",
          "enum": [
            "UNSTARTED",
            "WAITING",
            "RUNNING",
            "SUCCESS",
            "CANCELLED",
            "ERROR"
          ],
          "minLength": 10,
          "maxLength": 3,
          "example": "RUNNING"
        },
        "source_app_id": {
          "type": "string",
          "description": "任务源端数据源所属应用ID",
          "minLength": 1,
          "maxLength": 36,
          "example": "28f61af50fc9452aa0ed5ea25c3cc3d3"
        },
        "source_app_name": {
          "type": "string",
          "description": "任务源端数据源所属应用名称",
          "minLength": 1,
          "maxLength": 256,
          "example": "source-app"
        },
        "source_instance_id": {
          "type": "string",
          "description": "任务源端数据源所属实例ID",
          "minLength": 1,
          "maxLength": 60,
          "example": "source-instance"
        },
        "target_app_id": {
          "type": "string",
          "description": "任务目标端数据源所属应用ID",
          "minLength": 1,
          "maxLength": 36,
          "example": "28f61af50fc9452aa0ed5ea25c3cc3d3"
        },
        "target_app_name": {
          "type": "string",
          "description": "任务目标端数据源所属应用名称",
          "minLength": 1,
          "maxLength": 256,
          "example": "target-app"
        },
        "target_instance_id": {
          "type": "string",
          "description": "任务目标端数据源所属实例ID",
          "minLength": 1,
          "maxLength": 60,
          "example": "target-instance"
        },
        "ext_type": {
          "type": "string",
          "description": "任务扩展类型,当前如果是CDC组合任务,该字段为CDC,否则为null",
          "enum": [
            "CDC"
          ],
          "minLength": 1,
          "maxLength": 10,
          "example": "CDC"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "任务所属企业项目ID,默认为0",
          "minLength": 1,
          "maxLength": 60
        },
        "task_tag": {
          "type": "string",
          "description": "任务标签",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "TaskMonitorList": {
      "description": "任务监控信息列表",
      "properties": {
        "total": {
          "type": "integer",
          "description": "总数",
          "minimum": 1,
          "maximum": 99999
        },
        "size": {
          "type": "integer",
          "description": "当前页监控信息数量",
          "minimum": 1,
          "maximum": 99999
        },
        "entities": {
          "type": "array",
          "description": "任务监控信息当前页元素",
          "minItems": 1,
          "maxItems": 9999,
          "items": {
            "$ref": "#/definitions/TaskMonitorInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方式请参见《ROMA Connect API参考》的“附录 > 获取项目ID”章节。",
      "type": "string",
      "required": true,
      "maxLength": 32,
      "minLength": 0
    },
    "instance_id": {
      "name": "instance_id",
      "in": "path",
      "description": "实例ID",
      "type": "string",
      "required": true,
      "maxLength": 36,
      "minLength": 0
    },
    "limit": {
      "name": "limit",
      "in": "query",
      "description": "每页显示条目数量,最大数量999,超过999后只返回999",
      "type": "integer",
      "default": 10,
      "minimum": 0,
      "maximum": 999
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}