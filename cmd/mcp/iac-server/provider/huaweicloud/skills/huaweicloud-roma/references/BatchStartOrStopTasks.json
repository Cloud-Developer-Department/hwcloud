{
  "name": "BatchStartOrStopTasks",
  "summary": "批量启动\\停止任务",
  "tags": "任务管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/fdi/instances/{instance_id}/batch-operation/tasks": {
      "post": {
        "tags": [
          "任务管理"
        ],
        "operationId": "BatchStartOrStopTasks",
        "summary": "批量启动\\停止任务",
        "description": "批量启动\\停止任务",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "public",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/instance_id"
          },
          {
            "in": "body",
            "name": "BatchStartOrStopTasksRequestBody",
            "description": "Task object that needs to be start or stop",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OperateTasksBean"
            }
          }
        ],
        "x-request-examples-1": {
          "action_id": "start",
          "list": [
            {
              "task_id": "49460e99d597464d885f871dd6acc894"
            }
          ]
        },
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/BatchOperatorTaskResp"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorRsp400"
            },
            "examples": {
              "application/json": {
                "error_code": "FDI.3150",
                "error_msg": "The task list is empty."
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorRsp404"
            },
            "examples": {
              "application/json": {
                "error_code": "FDI.3083",
                "error_msg": "One or more scheduled tasks are not configured with scheduled plans."
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorRsp500"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "OperateTasksBean": {
      "properties": {
        "action_id": {
          "type": "string",
          "description": "操作类型\n- start (启动)\n- stop (停止)",
          "enum": [
            "start",
            "stop"
          ],
          "minLength": 1,
          "maxLength": 10,
          "example": "start"
        },
        "list": {
          "type": "array",
          "description": "需要启动或者停止的任务ID列表",
          "minItems": 1,
          "maxItems": 9999,
          "items": {
            "$ref": "#/definitions/TaskBean"
          }
        }
      },
      "type": "object",
      "required": [
        "action_id"
      ]
    },
    "TaskBeanFacade": {
      "description": "任务执行详情",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务ID",
          "minLength": 1,
          "maxLength": 64,
          "example": "15366328208d4d77b76532fe9f4006a6"
        },
        "task_name": {
          "type": "string",
          "description": "任务名称",
          "minLength": 1,
          "maxLength": 64,
          "example": "fdi_task_v2ftp_to_ftp"
        },
        "error_code": {
          "type": "string",
          "description": "失败的错误码",
          "minLength": 0,
          "maxLength": 64,
          "example": ""
        },
        "error_msg": {
          "type": "string",
          "description": "错误详情",
          "minLength": 1,
          "maxLength": 64,
          "example": ""
        }
      }
    },
    "BatchOperatorTaskResp": {
      "description": "批量操作任务的执行结果",
      "properties": {
        "success_count": {
          "description": "成功的个数",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 999999,
          "example": 1
        },
        "failure_count": {
          "description": "失败的个数",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 999999,
          "example": 1
        },
        "failure": {
          "description": "失败的详情",
          "type": "array",
          "minItems": 0,
          "maxItems": 999999,
          "items": {
            "$ref": "#/definitions/TaskBeanFacade"
          }
        },
        "success": {
          "description": "成功的任务信息",
          "type": "array",
          "minItems": 0,
          "maxItems": 999999,
          "items": {
            "$ref": "#/definitions/TaskBeanFacade"
          }
        }
      }
    },
    "ErrorRsp400": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.3002"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "Invalid parameters."
        }
      }
    },
    "ErrorRsp500": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.9999"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "Network error."
        }
      }
    },
    "ErrorRsp404": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "FDI.3081"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "The task does not exist."
        }
      }
    },
    "TaskBean": {
      "description": "批量启动\\停止任务的详情",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务ID, 可为空",
          "minLength": 1,
          "maxLength": 64,
          "example": "15366328208d4d77b76532fe9f4006a6"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方式请参见《ROMA Connect API参考》的“附录 > 获取项目ID”章节。",
      "type": "string",
      "required": true,
      "maxLength": 32,
      "minLength": 0
    },
    "instance_id": {
      "name": "instance_id",
      "in": "path",
      "description": "实例ID",
      "type": "string",
      "required": true,
      "maxLength": 36,
      "minLength": 0
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}