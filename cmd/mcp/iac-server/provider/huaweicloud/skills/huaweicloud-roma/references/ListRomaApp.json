{
  "name": "ListRomaApp",
  "summary": "查询应用列表",
  "tags": "APPLICATION_MANAGEMENT",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/instances/{instance_id}/apps": {
      "get": {
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "tags": [
          "APPLICATION_MANAGEMENT"
        ],
        "operationId": "ListRomaApp",
        "summary": "查询应用列表",
        "description": "查询应用列表,支持条件查询,所有条件是并且的关系",
        "parameters": [
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 100000
          },
          {
            "type": "string",
            "name": "instance_id",
            "in": "path",
            "required": true,
            "description": "实例ID",
            "minLength": 0,
            "maxLength": 64
          },
          {
            "type": "string",
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "项目ID",
            "minLength": 0,
            "maxLength": 64
          },
          {
            "type": "integer",
            "name": "offset",
            "in": "query",
            "default": 0,
            "minimum": 0,
            "maximum": 10000,
            "description": "偏移量,大于等于0"
          },
          {
            "type": "integer",
            "name": "limit",
            "in": "query",
            "default": 10,
            "maximum": 500,
            "minimum": 1,
            "description": "每页显示的条目数量"
          },
          {
            "type": "boolean",
            "name": "favorite",
            "in": "query",
            "description": "查询收藏的应用\n- 未提供时,查询当前用户有权限的所有应用\n- 为true时,获取收藏的应用\n- 为false时,获取未被收藏的应用"
          },
          {
            "type": "string",
            "name": "auth_role",
            "in": "query",
            "minLength": 0,
            "maxLength": 64,
            "description": "获取拥有指定权限应用"
          },
          {
            "type": "string",
            "name": "name",
            "in": "query",
            "minLength": 0,
            "maxLength": 256,
            "description": "应用名称,模糊匹配"
          },
          {
            "type": "boolean",
            "name": "owner",
            "in": "query",
            "description": "查询有权限访问的应用\n- 未提供时,查询当前用户有权限的所有应用\n- 为true时,查询当前用户创建的应用\n- 为false时,查询非当前用户创建的有权限的应用,比如其它人共享的应用"
          },
          {
            "type": "string",
            "name": "user_name",
            "in": "query",
            "minLength": 0,
            "maxLength": 64,
            "description": "从当前调用者有权限的所有应用中过滤出指定用户名有权限的应用"
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "schema": {
              "$ref": "#/definitions/ServerAppListResp"
            },
            "examples": {
              "application/json": {
                "total": "0,",
                "size": "0,",
                "apps": [
                  {
                    "id": "b2e6b145-4f3f-4a80-aa45-f4b8029f95a3",
                    "name": "AppName",
                    "remark": "应用示例描述备注"
                  }
                ],
                "roles": [
                  "read, access, delete, modify, admin,"
                ],
                "create_time": "2019-12-06T06:49:04Z",
                "update_time": "2019-12-06T06:49:04Z",
                "created_user": {
                  "user_id": "string",
                  "user_name": "string"
                },
                "last_updated_user": {
                  "user_id": "string",
                  "user_name": "string"
                },
                "owner": "true,",
                "key": "TEI95R8RZ2pIf8UM",
                "favorite": true
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "ROMA.00000101",
                "error_msg": "error summary",
                "error_details": "some error details here",
                "request_id": "13760c1fe8655e61209b75665e9bef43"
              }
            }
          }
        },
        "x-apigateway-backend": {
          "httpEndpoints": {
            "address": "#roma-address#",
            "description": "",
            "method": "GET",
            "path": "/v2/{project_id}/instances/{instance_id}/apps",
            "scheme": "https",
            "timeout": 30000
          },
          "parameters": [
            {
              "description": "",
              "in": "PATH",
              "name": "instance_id",
              "origin": "REQUEST",
              "value": "instance_id"
            },
            {
              "description": "",
              "in": "PATH",
              "name": "project_id",
              "origin": "REQUEST",
              "value": "project_id"
            }
          ],
          "type": "HTTP"
        },
        "x-apigateway-cors": false,
        "x-apigateway-match-mode": "NORMAL",
        "x-apigateway-request-type": "public",
        "x-support-sdk": "Y",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "AppRemark": {
      "type": "string",
      "description": "应用描述",
      "minLength": 0,
      "maxLength": 255,
      "example": "应用示例描述备注"
    },
    "ErrorResp": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "错误消息"
        },
        "error_details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "具体错误消息"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "请求处理ID"
        }
      },
      "example": {
        "error_code": "ROMA.00000101",
        "error_msg": "error summary",
        "error_details": "some error details here",
        "request_id": "13760c1fe8655e61209b75665e9bef43"
      }
    },
    "ServerAppListResp": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "description": "总的数量",
          "minimum": 1,
          "maximum": 10
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "当前页数量"
        },
        "apps": {
          "type": "array",
          "maxItems": 10,
          "minItems": 1,
          "description": "创建用户信息",
          "items": {
            "$ref": "#/definitions/ServerAppInfo"
          }
        }
      }
    },
    "AppKey": {
      "type": "string",
      "description": "应用认证访问KEY,未提供时随机生成\n- 字符集:支持中文、英文字母、数字、中划线、下划线、@号和点,以字母或中文或数字开头\n- 约束:实例下唯一",
      "minLength": 3,
      "maxLength": 200,
      "example": "TEI95R8RZ2pIf8UM"
    },
    "AppName": {
      "type": "string",
      "description": "应用名称\n- 字符集:支持中文、英文字母、数字、中划线、下划线、点、空格和中英文圆括号\n- 约束:实例下唯一",
      "minLength": 1,
      "maxLength": 256,
      "example": "AppName"
    },
    "AppFavorite": {
      "type": "boolean",
      "description": "是否收藏应用,收藏的应用会在列表里优先显示",
      "default": false
    },
    "AppUserRoles": {
      "type": "array",
      "items": {
        "type": "string",
        "minItems": 1,
        "enum": [
          "read",
          "access",
          "delete",
          "modify",
          "admin"
        ],
        "required": [
          "read"
        ]
      },
      "description": "应用权限角色\n- read:应用下资源只读权限,至少要存在此权限,包括API调试\n- access:应用下资源的访问管理权限\n- delete:应用下资源的删除权限\n- modify:应用下资源的修改权限,包括API发布、下线\n- admin:应用和应用下资源的权限\n- 仅提供admin时,会自动应用其它所有权限\n- 未提供read时会自动应用read权限",
      "example": [
        "read",
        "access",
        "delete",
        "modify",
        "admin"
      ]
    },
    "ServerAppInfo": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/AppId"
        },
        "name": {
          "$ref": "#/definitions/AppName"
        },
        "remark": {
          "$ref": "#/definitions/AppRemark"
        },
        "roles": {
          "$ref": "#/definitions/AppUserRoles"
        },
        "create_time": {
          "type": "string",
          "format": "dateTime",
          "minimum": 1,
          "maximum": 128,
          "example": "2019-12-06T06:49:04Z",
          "description": "创建UTC时间"
        },
        "update_time": {
          "type": "string",
          "format": "dateTime",
          "minimum": 1,
          "maximum": 128,
          "example": "2019-12-06T06:49:04Z",
          "description": "创建UTC时间"
        },
        "created_user": {
          "type": "object",
          "description": "创建用户信息",
          "properties": {
            "user_id": {
              "type": "string",
              "description": "创建应用的用户ID"
            },
            "user_name": {
              "type": "string",
              "description": "创建应用的用户名称"
            }
          }
        },
        "last_updated_user": {
          "type": "object",
          "description": "最后更新用户信息",
          "properties": {
            "user_id": {
              "type": "string",
              "description": "最后修改者的用户ID"
            },
            "user_name": {
              "type": "string",
              "description": "最后修改者的用户名"
            }
          }
        },
        "owner": {
          "type": "boolean",
          "description": "是否是应用拥有者"
        },
        "key": {
          "$ref": "#/definitions/AppKey"
        },
        "favorite": {
          "$ref": "#/definitions/AppFavorite"
        }
      }
    },
    "AppId": {
      "type": "string",
      "description": "应用ID",
      "example": "b2e6b145-4f3f-4a80-aa45-f4b8029f95a3"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}