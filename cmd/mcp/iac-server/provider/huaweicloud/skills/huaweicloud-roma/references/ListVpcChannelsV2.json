    "MemberGroupCreate": {
      "required": [
        "member_group_name"
      ],
      "properties": {
        "member_group_name": {
          "description": "VPC通道后端服务器组名称",
          "type": "string"
        },
        "member_group_remark": {
          "description": "VPC通道后端服务器组描述",
          "type": "string"
        },
        "member_group_weight": {
          "description": "VPC通道后端服务器组权重值。\n\n当前服务器组存在服务器且此权重值存在时,自动使用此权重值分配权重。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 100
        },
        "dict_code": {
          "description": "VPC通道后端服务器组的字典编码\n\n支持英文,数字,特殊字符(-_.)\n\n暂不支持",
          "type": "string",
          "pattern": "([a-zA-Z0-9._-]){2,63}$",
          "minLength": 3,
          "maxLength": 64
        },
        "microservice_version": {
          "description": "VPC通道后端服务器组的版本,仅VPC通道类型为微服务时支持。",
          "type": "string",
          "maxLength": 64
        },
        "microservice_port": {
          "description": "VPC通道后端服务器组的端口号,仅VPC通道类型为微服务时支持。端口号为0时后端服务器组下的所有地址沿用原来负载端口继承逻辑。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 65535,
          "example": 80
        },
        "microservice_labels": {
          "description": "VPC通道后端服务器组的标签,仅VPC通道类型为微服务时支持。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MicroserviceLabel"
          }
        }
      }
    },
    "MicroserviceLabel": {
      "required": [
        "label_name",
        "label_value"
      ],
      "properties": {
        "label_name": {
          "type": "string",
          "description": "标签名称。\n\n以字母或者数字开头和结尾,由字母、数字、连接符('-')、下划线('_')、点号('.')组成且63个字符之内。",
          "example": "clusterid",
          "pattern": "^[a-zA-Z0-9]$|(^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,61})[a-zA-Z0-9]$)",
          "minLength": 1,
          "maxLength": 63
        },
        "label_value": {
          "type": "string",
          "description": "标签值。\n\n以字母或者数字开头和结尾,由字母、数字、连接符('-')、下划线('_')、点号('.')组成且63个字符之内。",
          "example": "c429700c-5dc4-482a-9c0e-99f6c0635113",
          "pattern": "^[a-zA-Z0-9]$|(^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,61})[a-zA-Z0-9]$)",
          "minLength": 1,
          "maxLength": 63
        }
      }
    },
    "VpcBase": {
      "required": [
        "name",
        "port",
        "member_type",
        "balance_strategy"
      ],
      "properties": {
        "name": {
          "description": "VPC通道的名称。\n\n长度为3 ~ 64位的字符串,字符串由中文、英文字母、数字、中划线、下划线组成,且只能以英文或中文开头。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9-_]|[\\一-\\龥]){2,63}$"
        },
        "port": {
          "description": "VPC通道中主机的端口号。\n\n取值范围1 ~ 65535。",
          "type": "integer",
          "format": "int32"
        },
        "balance_strategy": {
          "description": "分发算法。\n- 1:加权轮询(wrr)\n- 2:加权最少连接(wleastconn)\n- 3:源地址哈希(source)\n- 4:URI哈希(uri)",
          "type": "integer",
          "format": "int32",
          "enum": [
            1,
            2,
            3,
            4
          ],
          "default": 1
        },
        "member_type": {
          "description": "VPC通道的成员类型。\n- ip\n- ecs",
          "type": "string",
          "enum": [
            "ip",
            "ecs"
          ],
          "default": "ecs"
        },
        "type": {
          "description": "vpc通道类型,默认为服务器类型。\n- 2:服务器类型\n- 3:微服务类型",
          "type": "integer",
          "enum": [
            2,
            3
          ],
          "default": 2,
          "example": 2
        },
        "dict_code": {
          "description": "VPC通道的字典编码\n\n支持英文,数字,特殊字符(-_.)\n\n暂不支持",
          "type": "string",
          "pattern": "([a-zA-Z0-9._-]){2,63}$",
          "minLength": 3,
          "maxLength": 64
        }
      }
    },
