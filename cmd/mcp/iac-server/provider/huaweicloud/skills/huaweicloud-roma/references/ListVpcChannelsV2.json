              "type": "string",
              "description": "注册中心地址",
              "example": "https://1.2.3.4:8888"
            },
            "cse_app_id": {
              "type": "string",
              "description": "微服务所属的应用",
              "example": "default"
            },
            "version": {
              "type": "string",
              "description": "微服务的版本,已废弃,通过后端服务器组中的版本承载。",
              "example": "v1",
              "maxLength": 64
            }
          }
        }
      ]
    },
    "VpcChannelInfo": {
      "allOf": [
