{
  "name": "ListAppQuotas",
  "summary": "获取客户端配额列表",
  "tags": "客户端配额",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/app-quotas": {
