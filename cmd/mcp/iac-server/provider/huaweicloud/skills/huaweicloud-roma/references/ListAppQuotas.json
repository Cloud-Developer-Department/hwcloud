        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-order": 5,
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "operationId": "ListAppQuotas",
        "summary": "获取客户端配额列表",
        "description": "获取客户端配额列表。支持根据名称模糊查询",
        "parameters": [
