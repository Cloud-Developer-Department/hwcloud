{
  "name": "ListEnvironmentVariablesV2",
  "summary": "查询变量列表",
  "tags": "环境变量管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/env-variables": {
      "get": {
        "summary": "查询变量列表",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-order": 4,
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "description": "查询分组下的所有环境变量的列表。",
        "schemes": [
          "https"
        ],
        "tags": [
          "环境变量管理"
        ],
        "operationId": "ListEnvironmentVariablesV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_offset"
          },
          {
            "$ref": "#/parameters/apic_limit"
          },
          {
            "name": "group_id",
            "in": "query",
            "type": "string",
            "description": "API分组编号",
            "required": true,
            "x-example": "57e7248244ee457cb0ddb64b012f4cbe"
          },
          {
            "name": "env_id",
            "in": "query",
            "type": "string",
            "description": "环境编号",
            "x-example": "57e7248244ee457cb0ddb64b012f4cbe"
          },
          {
            "name": "variable_name",
            "in": "query",
            "type": "string",
            "description": "变量名",
            "x-example": "variable_name"
          },
          {
            "name": "precise_search",
            "in": "query",
            "type": "string",
            "description": "指定需要精确匹配查找的参数名称,多个参数需要支持精确匹配时参数之间使用“,”隔开。\n\n目前仅支持variable_name。",
            "x-example": "name"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "variables": [
                  {
                    "variable_value": "8080",
                    "env_id": "cca3616af3684b329064b2a631cb3eeb",
                    "group_id": "73c58022f20d495aa18885d718647f09",
                    "id": "09ab8135722440b9bf5d107f2a09d409",
                    "variable_name": "port"
                  },
                  {
                    "variable_value": "192.168.1.5",
                    "env_id": "7a1ad0c350844ee69479b47df9a881cb",
                    "group_id": "c77f5e81d9cb4424bf704ef2b0ac7600",
                    "id": "25054838a624400bbf2267cf5b3a3f70",
                    "variable_name": "address"
                  }
                ],
                "total": 2,
                "size": 2
              }
            },
            "schema": {
              "$ref": "#/definitions/EnvVariablePageInfo"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.2012",
                "error_msg": "Invalid parameter value,parameterName:name. Please refer to the support documentation"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3030",
                "error_msg": "The instance does not exist;id:f0fa1789-3b76-433b-a787-9892951c620ec"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "BasePage": {
      "properties": {
        "size": {
          "description": "本次返回的列表长度",
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "description": "满足条件的记录数",
          "type": "integer",
          "format": "int64"
        }
      },
      "description": "分页基本信息",
      "required": [
        "size",
        "total"
      ]
    },
    "EnvVariableCreate": {
      "required": [
        "env_id",
        "group_id",
        "variable_name"
      ],
      "allOf": [
        {
          "$ref": "#/definitions/EnvVariableBase"
        },
        {
          "type": "object",
          "properties": {
            "env_id": {
              "description": "环境编号",
              "type": "string",
              "minLength": 1,
              "maxLength": 65,
              "pattern": "^[a-zA-Z0-9-_]{0,64}$",
              "example": "7a1ad0c350844ee69479b47df9a881cb"
            },
            "group_id": {
              "description": "API分组编号",
              "type": "string",
              "minLength": 1,
              "maxLength": 65,
              "pattern": "^[a-zA-Z0-9-_]{0,64}$",
              "example": "73c58022f20d495aa18885d718647f09"
            },
            "variable_name": {
              "description": "变量名,支持英文字母、数字、英文格式的下划线、中划线,必须以英文字母开头,3~32个字符。在API定义中等于#Name的值#部分(区分大小写),发布到环境里的API被变量值换。\n> 中文字符必须为UTF-8或者unicode编码。",
              "type": "string",
              "example": "address"
            }
          }
        }
      ]
    },
    "EnvVariableInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/EnvVariableCreate"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "环境变量编号",
              "type": "string"
            }
          }
        }
      ]
    },
    "EnvVariableBase": {
      "required": [
        "variable_value"
      ],
      "properties": {
        "variable_value": {
          "description": "变量值支持英文字母、数字、英文格式的下划线、中划线,斜线(/)、点、冒号,1 ~ 255个字符。",
          "type": "string",
          "example": "192.168.1.5"
        }
      }
    },
    "EnvVariablePageInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/BasePage"
        },
        {
          "type": "object",
          "properties": {
            "variables": {
              "description": "本次返回的环境变量列表",
              "type": "array",
              "items": {
                "$ref": "#/definitions/EnvVariableInfo"
              }
            }
          }
        }
      ]
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_offset": {
      "name": "offset",
      "in": "query",
      "type": "integer",
      "description": "偏移量,表示从此偏移量开始查询,偏移量小于0时,自动转换为0",
      "format": "int64",
      "default": 0,
      "x-example": 1
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID",
      "required": true,
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
      "required": true,
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "apic_limit": {
      "name": "limit",
      "in": "query",
      "type": "integer",
      "description": "每页显示的条目数量",
      "format": "int32",
      "minimum": 1,
      "maximum": 500,
      "default": 20,
      "x-example": 10
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}