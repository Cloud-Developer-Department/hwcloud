  "definitions": {
    "RespInstance": {
      "allOf": [
        {
          "$ref": "#/definitions/RespInstanceBase"
        },
        {
          "type": "object",
          "properties": {
            "description": {
              "description": "实例描述",
              "type": "string"
            },
            "vpc_id": {
              "description": "虚拟私有云ID。",
              "type": "string",
              "example": "0402ea19-5457-4032-9d1b-eb48b98f6c66"
            },
            "subnet_id": {
              "description": "子网的网络ID。",
              "type": "string",
              "example": "a3bd29e4-d5bc-414c-a79a-1f35ee4ead88"
            },
            "security_group_id": {
              "description": "实例所属的安全组。",
              "type": "string",
              "example": "4b95a790-5cfc-463d-8de5-42199e55371c"
            },
            "maintain_begin": {
              "description": "'维护时间窗开始时间。时间格式为 xx:00:00,xx取值为02,06,10,14,18,22。'\n\n'在这个时间段内,运维人员可以对该实例的节点进行维护操作。维护期间,业务可以正常使用,可能会发生闪断。维护操作通常几个月一次。'",
              "type": "string",
              "pattern": "^([0-1][0-9]|[2][0-4]):00:00$"
            },
            "maintain_end": {
              "description": "'维护时间窗结束时间。时间格式为 xx:00:00,与维护时间窗开始时间相差4个小时。'\n\n'在这个时间段内,运维人员可以对该实例的节点进行维护操作。维护期间,业务可以正常使用,可能会发生闪断。维护操作通常几个月一次'。",
              "type": "string",
              "pattern": "^([0-1][0-9]|[2][0-4]):00:00$"
            },
            "ingress_ip": {
              "description": "实例入口,虚拟私有云访问地址",
              "type": "string"
            },
            "user_id": {
              "description": "实例所属用户ID",
              "type": "string",
              "example": "e966ff7227ef4df49df7d57aaf00f8ed"
            },
            "nat_eip_ipv6_cidr": {
              "description": "出公网网段 (IPv6)  。\n\n当前仅部分region部分可用区支持IPv6",
              "type": "string",
              "example": "2407:c080:1200:436::/64"
            },
            "eip_ipv6_address": {
              "description": "弹性IP地址(IPv6)。\n\n当前仅部分region部分可用区支持IPv6",
              "type": "string",
              "example": "2407:c080:17ef:ffff::7924:2197"
            },
            "nat_eip_address": {
              "description": "实例出公网IP",
              "type": "string",
              "example": "10.10.10.156"
            },
            "bandwidth_size": {
              "description": "出公网带宽",
              "type": "integer",
              "example": 5
            },
            "available_zone_ids": {
              "description": "可用区",
              "type": "string"
            },
            "instance_version": {
              "description": "实例版本编号",
              "type": "string",
              "example": "acc6d368a3cb4d47840380bf62b0ab32"
            },
            "virsubnet_id": {
              "description": "子网的网络ID。\n\n暂不支持",
              "type": "string",
              "example": "a3bd29e4-d5bc-414c-a79a-1f35ee4ead88"
            },
            "roma_eip_address": {
              "description": "roma弹性公网IP。\n\n暂不支持",
              "type": "string"
            },
            "listeners": {
              "description": "监听信息,暂不支持",
              "type": "array",
              "items": {
                "$ref": "#/definitions/Listener"
              }
            },
            "supported_features": {
              "description": "实例支持的特性列表",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ingress_ip_v6": {
              "description": "实例入口(IPv6)\n\n当前仅部分region部分可用区支持IPv6",
              "type": "string"
            },
            "node_ips": {
              "$ref": "#/definitions/NodeIps"
            },
            "ingress_ips": {
              "description": "实例集群全量入口(多入口实例)",
              "type": "string",
              "example": "[192.168.0.1, 192.168.0.2]"
            },
            "cipher_type": {
              "description": "实例算法类型:\n- generalCipher:通用加密算法\n- SMCompatible:SM系列商密算法兼容\n- SMOnly:SM系列商密算法\n\n暂不支持",
              "enum": [
                "generalCipher",
                "SMCompatible",
                "SMOnly"
              ],
              "type": "string",
              "example": "generalCipher"
            }
          }
        }
      ]
    },
    "Backend": {
      "description": "后端服务定义",
      "properties": {
        "ip": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "后端主机地址列表"
        },
        "port": {
          "type": "integer",
          "description": "后端服务端口,不存在时使用监听器端口"
        },
        "health_check": {
          "$ref": "#/definitions/HealthCheck"
        }
      }
    },
    "NodeIps": {
      "description": "节点内部ip信息",
