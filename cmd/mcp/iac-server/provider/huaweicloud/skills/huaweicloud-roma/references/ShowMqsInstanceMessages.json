              },
              "partition": {
                "type": "integer",
                "description": "消息所在的分区。"
              },
              "key": {
                "type": "string",
                "description": "消息key。"
              },
              "value": {
                "type": "string",
                "description": "消息内容。"
              },
              "size": {
                "type": "integer",
                "format": "int64",
                "description": "消息大小。"
              },
              "timestamp": {
                "type": "integer",
                "format": "int64",
                "description": "topic名称。"
              },
              "huge_message": {
                "type": "boolean",
                "description": "大数据标识。"
              },
              "message_offset": {
                "type": "integer",
                "format": "int64",
                "description": "消息偏移量。"
              },
              "message_id": {
                "type": "string",
                "description": "消息ID。"
              },
              "app_id": {
                "type": "string",
                "description": "应用ID。"
              },
              "tag": {
                "type": "string",
                "description": "消息标签。"
              }
            }
          }
        },
        "total": {
