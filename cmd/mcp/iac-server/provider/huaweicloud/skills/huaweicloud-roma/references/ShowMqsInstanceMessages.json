{
  "name": "ShowMqsInstanceMessages",
  "summary": "查询消息",
  "tags": "消息管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/mqs/instances/{instance_id}/messages": {
      "get": {
        "tags": [
          "消息管理"
        ],
        "summary": "查询消息",
        "description": "查询消息的偏移量和消息内容。\n先根据时间戳查询消息的偏移量,再根据偏移量查询消息内容。",
        "operationId": "ShowMqsInstanceMessages",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "租户的项目ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "topic",
            "in": "query",
            "description": "topic名称。",
            "required": true,
            "type": "string"
          },
          {
            "name": "asc",
            "in": "query",
            "description": "是否按照时间排序。",
            "type": "boolean"
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "开始时间。Unix毫秒时间戳。\n查询消息偏移量时,为必选参数。",
            "required": true,
            "type": "string"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "结束时间。Unix毫秒时间戳。\n查询消息偏移量时,为必选参数。",
            "required": true,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询消息的数量。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询的偏移量。",
            "type": "string"
          },
          {
            "name": "download",
            "in": "query",
            "description": "是否下载。",
            "type": "boolean"
          },
          {
            "name": "message_offset",
            "in": "query",
            "description": "消息偏移量。\n查询消息内容时,为必选参数。\n若start_time、end_time参数不为空,该参数无效。",
            "type": "string"
          },
          {
            "name": "partition",
            "in": "query",
            "description": "分区。\n查询消息内容时,为必选参数。\n若start_time、end_time参数不为空,该参数无效。",
            "type": "string"
          },
          {
            "name": "key",
            "in": "query",
            "description": "消息key。",
            "type": "string"
          },
          {
            "name": "message_id",
            "in": "query",
            "description": "消息ID。",
            "type": "string"
          },
          {
            "name": "tag",
            "in": "query",
            "description": "消息标签。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ShowMqsInstanceMessagesResp"
            },
            "examples": {
              "application/json": {
                "messages": [
                  {
                    "topic": "topic-test",
                    "partition": 0,
                    "value": "hello world",
                    "size": 21,
                    "timestamp": 1607598463502,
                    "huge_message": false,
                    "message_offset": 4,
                    "message_id": "",
                    "app_id": "",
                    "tag": ""
                  }
                ],
                "total": 1,
                "size": 1
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/CommonErrResp"
            },
            "examples": {
              "application/json": {
                "error_code": 400,
                "error_msg": "Bad Request"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/CommonErrResp"
            },
            "examples": {
              "application/json": {
                "error_code": 403,
                "error_msg": "Forbidden"
              }
            }
          }
        },
        "x-hybridcloud": true,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-description-1": "查询消息偏移量。",
        "x-request-examples-url-1": "GET https://{endpoint}/v2/{project_id}/mqs/instances/{instance_id}/messages?asc=false&end_time=1608609032042&limit=10&offset=0&start_time=1608608432042&topic=topic-test-mqs",
        "x-request-examples-description-2": "查询消息内容。",
        "x-request-examples-url-2": "GET https://{endpoint}/v2/{project_id}/mqs/instances/{instance_id}/messagesdownload=false&message_offset=0&partition=0&topic=topic-test-mqs",
        "schemes": [
          "https"
        ],
        "x-apigateway-request-type": "public"
      }
    }
  },
  "definitions": {
    "CommonErrResp": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      }
    },
    "ShowMqsInstanceMessagesResp": {
      "type": "object",
