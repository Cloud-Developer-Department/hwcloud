{
  "name": "ListApiRuntimeDefinitionV2",
  "summary": "查询API运行时定义",
  "tags": "API管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/apis/runtime/{api_id}": {
      "get": {
        "summary": "查询API运行时定义",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-order": 13,
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "tags": [
          "API管理"
        ],
        "description": "查看指定的API在指定的环境上的运行时定义,默认查询RELEASE环境上的运行时定义。\n\nAPI的定义分为临时定义和运行时定义,分别代表如下含义:\n- 临时定义:API在编辑中的定义,表示用户最后一次编辑后的API的状态\n- 运行时定义:API在发布到某个环境时,对发布时的API的临时定义进行快照,固化出来的API的状态。\n\n访问某个环境上的API,其实访问的就是其运行时的定义",
        "operationId": "ListApiRuntimeDefinitionV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_api_id"
          },
          {
            "in": "query",
            "name": "env_id",
            "required": false,
            "description": "API的发布环境编号",
            "type": "string",
            "x-example": "DEFAULT_ENVIRONMENT_RELEASE_ID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ApiRuntimeDefinition"
            },
            "examples": {
              "application/json": {
                "name": "Api_http",
                "type": 1,
                "version": "V0.0.1",
                "req_protocol": "HTTPS",
                "req_method": "GET",
                "req_uri": "/test/http",
                "auth_type": "AUTHORIZER",
                "authorizer_id": "8d0443832a194eaa84244e0c1c1912ac",
                "auth_opt": {
                  "app_code_auth_type": "DISABLE"
                },
                "cors": false,
                "match_mode": "NORMAL",
                "backend_type": "HTTP",
                "remark": "Web backend Api",
                "group_id": "c77f5e81d9cb4424bf704ef2b0ac7600",
                "result_normal_sample": "Normal response example",
                "result_failure_sample": "Failure response example",
                "id": "5f918d104dc84480a75166ba99efff21",
                "group_name": "api_group_001",
                "run_env_id": "DEFAULT_ENVIRONMENT_RELEASE_ID",
                "run_env_name": "RELEASE",
                "publish_id": "9191cdb430724d4b8586ed7f1b962ca2",
                "sl_domain": "c77f5e81d9cb4424bf704ef2b0ac7600.apic.****.com",
                "sl_domains": [
                  "c77f5e81d9cb4424bf704ef2b0ac7600.apic.****.com",
                  "c77f5e81d9cb4424bf704ef2b0ac7600.apic.****.cn"
                ]
              }
            }
          },
          "401": {
            "description": "Unauthorized",
