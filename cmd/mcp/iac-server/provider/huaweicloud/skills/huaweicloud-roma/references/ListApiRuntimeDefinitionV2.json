                "$ref": "#/definitions/ReqParam"
              }
            }
          }
        }
      ]
    },
    "ReqParam": {
      "allOf": [
        {
          "$ref": "#/definitions/ReqParamBase"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "参数编号",
              "type": "string"
            }
          }
        }
      ]
    },
    "ApiBaseInfo": {
      "required": [
        "group_id",
        "name",
        "type",
        "req_protocol",
        "req_method",
        "req_uri",
        "auth_type",
        "backend_type"
      ],
      "properties": {
        "name": {
          "description": "API名称。\n\n支持汉字、英文、数字、中划线、下划线、点、斜杠、中英文格式下的小括号和冒号、中文格式下的顿号,且只能以英文、汉字和数字开头。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "pattern": "^([a-zA-Z0-9]|[\\一-\\龥])([a-zA-Z0-9:._()\\\\//-]|[\\一-\\龥\\（\\）\\：\\、]){2,254}$",
          "minLength": 3,
          "maxLength": 255,
          "example": "api_name"
        },
        "type": {
          "description": "API类型\n- 1:公有API\n- 2:私有API",
          "type": "integer",
          "format": "int32",
          "enum": [
            1,
            2
          ],
          "example": 1
        },
        "version": {
          "description": "API的版本",
          "maxLength": 16,
          "type": "string",
          "example": "v1"
        },
        "req_protocol": {
          "description": "API的请求协议\n- HTTP\n- HTTPS\n- BOTH:同时支持HTTP和HTTPS",
          "default": "HTTPS",
          "type": "string",
          "enum": [
            "HTTP",
            "HTTPS",
            "BOTH"
          ],
          "example": "HTTP"
        },
        "req_method": {
          "description": "API的请求方式",
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "HEAD",
            "PATCH",
            "OPTIONS",
            "ANY"
          ],
          "example": "GET"
        },
        "req_uri": {
          "description": "请求地址。可以包含请求参数,用{}标识,比如/getUserInfo/{userId},支持 * % - _ .等特殊字符,总长度不超过512,且满足URI规范。\n\n/apic/health_check为服务集成预置的健康检查路径,当req_method=GET时不支持req_uri=/apic/health_check。\n\n> 需要服从URI规范。",
          "type": "string",
          "example": "/test"
        },
        "auth_type": {
          "description": "API的认证方式\n- NONE:无认证\n- APP:APP认证\n- IAM:IAM认证\n- AUTHORIZER:自定义认证",
          "type": "string",
          "enum": [
            "NONE",
            "APP",
            "IAM",
            "AUTHORIZER"
          ],
          "example": "IAM"
        },
        "auth_opt": {
          "description": "认证方式参数",
          "$ref": "#/definitions/AuthOpt"
        },
        "cors": {
          "description": "是否支持跨域\n- TRUE:支持\n- FALSE:不支持",
          "default": false,
          "enum": [
            true,
            false
          ],
          "type": "boolean",
          "example": false
        },
        "match_mode": {
          "description": "API的匹配方式\n- SWA:前缀匹配\n- NORMAL:正常匹配(绝对匹配)\n默认:NORMAL",
          "type": "string",
          "enum": [
            "SWA",
            "NORMAL"
          ],
          "example": "NORMAL"
        },
        "backend_type": {
          "description": "后端类型\n- HTTP:web后端\n- FUNCTION:函数工作流\n- MOCK:模拟的后端\n\n仅控制默认后端类型,策略后端不受此字段控制",
          "type": "string",
          "enum": [
            "HTTP",
            "FUNCTION",
            "MOCK"
          ],
          "example": "HTTP"
        },
        "remark": {
          "description": "API描述。\n\n不允许带有<、>字符\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "minLength": 0,
          "maxLength": 1000,
          "example": "API描述"
        },
        "group_id": {
          "description": "API所属的分组编号",
          "type": "string",
          "minLength": 1,
          "maxLength": 65,
          "pattern": "^[a-zA-Z0-9-_]{0,64}$",
          "example": "b9be707660c5406394f8973e087bae20"
        },
        "body_remark": {
          "description": "API请求体描述,可以是请求体示例、媒体类型、参数等信息。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "maxLength": 20480,
          "example": "API请求体描述"
        },
        "result_normal_sample": {
          "description": "正常响应示例,描述API的正常返回信息。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "maxLength": 20480,
          "example": "正常响应示例"
        },
        "result_failure_sample": {
          "description": "失败返回示例,描述API的异常返回信息。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "maxLength": 20480,
          "example": "失败返回示例"
        },
        "authorizer_id": {
          "description": "前端自定义认证对象的ID",
          "type": "string",
          "minLength": 1,
          "maxLength": 65,
          "pattern": "^[a-zA-Z0-9-_]{0,64}$"
        },
        "tags": {
          "description": "标签。\n\n支持英文,数字,中文,特殊符号(-*#%.:_),且只能以中文或英文开头。\n\n默认支持10个标签,如需扩大配额请联系技术工程师修改API_TAG_NUM_LIMIT配置。",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([a-zA-Z]|[\\一-\\龥])([a-zA-Z0-9_-]|[\\一-\\龥]|[-*#%.:]){0,127}$",
            "minLength": 1,
            "maxLength": 128
          },
          "example": [
            "tag"
          ]
        },
        "response_id": {
          "description": "分组自定义响应ID\n\n暂不支持",
          "type": "string",
          "minLength": 1,
          "maxLength": 65,
          "pattern": "^[a-zA-Z0-9-_]{0,64}$"
        },
        "roma_app_id": {
          "description": "API归属的集成应用编号\n\nAPI分组为全局分组时或API绑定自定义域名时必填。",
          "type": "string",
          "minLength": 1,
          "maxLength": 65,
          "pattern": "^[a-zA-Z0-9-_]{0,64}$",
          "example": "98df09fb-d459-4cbf-83a7-2b55ca6f3d5d"
        },
        "domain_name": {
          "description": "API绑定的自定义域名,使用自定义域名时roma_app_id字段必填。",
          "type": "string",
          "maxLength": 255
        },
        "tag": {
          "description": "标签\n\n待废弃,优先使用tags字段",
          "type": "string",
          "maxLength": 255
        },
        "content_type": {
          "description": "请求内容格式类型:\n\napplication/json\napplication/xml\nmultipart/form-data\ntext/plain",
          "type": "string",
          "enum": [
            "application/json",
            "application/xml",
            "multipart/form-data",
            "text/plain"
          ]
        }
      }
    },
