{
  "name": "ShowDetailsOfRequestThrottlingPolicyV2",
  "summary": "查看流控策略详情",
  "tags": "流控策略管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/apic/instances/{instance_id}/throttles/{throttle_id}": {
      "get": {
        "summary": "查看流控策略详情",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-api-version": "v2",
        "x-order": 4,
        "x-hybridcloud": true,
        "x-open-region-cloud": "hc,hcso",
        "x-romaconnect-mode": "huaweicloud,hybrid,on-premise",
        "description": "查看指定流控策略的详细信息。",
        "schemes": [
          "https"
        ],
        "tags": [
          "流控策略管理"
        ],
        "operationId": "ShowDetailsOfRequestThrottlingPolicyV2",
        "parameters": [
          {
            "$ref": "#/parameters/apic_x_auth_token"
          },
          {
            "$ref": "#/parameters/apic_project_id"
          },
          {
            "$ref": "#/parameters/apic_instance_id"
          },
          {
            "$ref": "#/parameters/apic_throttle_id"
          }
        ],
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/ThrottlesInfo"
            },
            "examples": {
              "application/json": {
                "name": "throttle_demo",
                "create_time": "2020-07-31T08:44:02.205366118Z",
                "remark": "Throttling Policy 1",
                "type": 1,
                "time_interval": 1,
                "ip_call_limits": 600,
                "app_call_limits": 300,
                "time_unit": "SECOND",
                "api_call_limits": 800,
                "id": "3437448ad06f4e0c91a224183116e965",
                "user_call_limits": 0,
                "enable_adaptive_control": "FALSE",
                "bind_num": 0,
                "is_inclu_special_throttle": 2
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1002",
                "error_msg": "Incorrect token or token resolution failed"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.1005",
                "error_msg": "No permissions to request this method"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.3005",
                "error_msg": "Request throttling policy 3437448ad06f4e0c91a224183116e965 does not exist"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ResponseModel"
            },
            "examples": {
              "application/json": {
                "error_code": "APIG.9999",
                "error_msg": "System error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ThrottlesInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/ThrottleBaseInfo"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "流控策略的ID",
              "type": "string"
            },
            "bind_num": {
              "description": "流控绑定的API数量",
              "type": "integer",
              "format": "int32"
            },
            "is_inclu_special_throttle": {
              "description": "是否包含特殊流控配置\n- 1:包含\n- 2:不包含",
              "enum": [
                1,
                2
              ],
              "type": "integer",
              "format": "int32"
            },
            "create_time": {
              "description": "创建时间",
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "ResponseModel": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述"
        }
      }
    },
    "ThrottleBaseInfo": {
      "required": [
        "name",
        "api_call_limits",
        "time_interval",
        "time_unit"
      ],
      "properties": {
        "app_call_limits": {
          "description": "APP流量限制是指一个API在时长之内被每个APP访问的次数上限,该数值不超过用户流量限制值。输入的值不超过2147483647。正整数。",
          "type": "integer",
          "format": "int32",
          "example": 300
        },
        "name": {
          "description": "流控策略名称。支持汉字,英文,数字,下划线,且只能以英文和汉字开头,3 ~ 64字符。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "throttleName"
        },
        "time_unit": {
          "description": "流控的时间单位",
          "enum": [
            "SECOND",
            "MINUTE",
            "HOUR",
            "DAY"
          ],
          "type": "string",
          "example": "SECOND"
        },
        "remark": {
          "description": "流控策略描述字符长度不超过255。\n> 中文字符必须为UTF-8或者unicode编码。",
          "type": "string",
          "example": "API每秒800次,用户500次,APP300次,IP600次"
        },
        "api_call_limits": {
          "description": "API流量限制是指时长内一个API能够被访问的次数上限。该值不超过系统默认配额限制,系统默认配额为200tps,用户可根据实际情况修改该系统默认配额。输入的值不超过2147483647。正整数。",
          "type": "integer",
          "format": "int32",
          "example": 800
        },
        "type": {
          "description": "流控策略的类型\n- 1:基础,表示绑定到流控策略的单个API流控时间内能够被调用多少次。\n- 2:共享,表示绑定到流控策略的所有API流控时间内能够被调用多少次。",
          "enum": [
            1,
            2
          ],
          "type": "integer",
          "format": "int32",
          "example": 1
        },
        "enable_adaptive_control": {
          "description": "是否开启动态流控:\n- TRUE\n- FALSE\n\n暂不支持",
          "type": "string",
          "example": false
        },
        "user_call_limits": {
          "description": "用户流量限制是指一个API在时长之内每一个用户能访问的次数上限,该数值不超过API流量限制值。输入的值不超过2147483647。正整数。",
          "type": "integer",
          "format": "int32",
          "example": 500
        },
        "time_interval": {
          "description": "流量控制的时长单位。与“流量限制次数”配合使用,表示单位时间内的API请求次数上限。输入的值不超过2147483647。正整数。",
          "type": "integer",
          "format": "int32",
          "example": 1
        },
        "ip_call_limits": {
          "description": "源IP流量限制是指一个API在时长之内被每个IP访问的次数上限,该数值不超过API流量限制值。输入的值不超过2147483647。正整数。",
          "type": "integer",
          "format": "int32",
          "example": 600
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "apic_throttle_id": {
      "name": "throttle_id",
      "in": "path",
      "type": "string",
      "description": "流控策略的编号",
      "required": true,
      "x-example": "3437448ad06f4e0c91a224183116e965"
    },
    "apic_instance_id": {
      "name": "instance_id",
      "in": "path",
      "type": "string",
      "description": "实例ID",
      "required": true,
      "x-example": "f0fa1789-3b76-433b-a787-9892951c620e"
    },
    "apic_project_id": {
      "name": "project_id",
      "in": "path",
      "type": "string",
      "description": "项目ID,获取方式请参见API参考的“附录 > 获取项目ID”章节。",
      "required": true,
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "apic_x_auth_token": {
      "name": "X-Auth-Token",
      "in": "header",
      "type": "string",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}