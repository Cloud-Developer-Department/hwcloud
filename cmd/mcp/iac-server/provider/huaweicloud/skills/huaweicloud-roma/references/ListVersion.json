{
  "name": "ListVersion",
  "summary": "获取服务API版本列表",
  "tags": "PUBLIC_MANAGEMENT",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/": {
      "get": {
        "tags": [
          "PUBLIC_MANAGEMENT"
        ],
        "operationId": "ListVersion",
        "summary": "获取服务API版本列表",
        "description": "获取服务API版本列表,无需认证",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/VersionsResp"
            },
            "examples": {
              "application/json": {
                "versions": [
                  {
                    "min_version": "",
                    "links": null
                  },
                  {
                    "rel": "self",
                    "href": "https://roma.cn-north-4.myhuaweicloud.com/v1",
                    "id": "v1",
                    "updated": "2018-06-28T12:20:21Z",
                    "version": "",
                    "status": "SUPPORTED",
                    "min_version": "",
                    "links": [
                      {
                        "rel": "self",
                        "href": "https://roma.cn-north-4.myhuaweicloud.com/v2",
                        "id": "v2",
                        "updated": "2020-06-28T12:20:21Z",
                        "version": "",
                        "status": "CURRENT"
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "x-apigateway-backend": {
          "httpEndpoints": {
            "address": "#roma-address#",
            "description": "",
            "method": "GET",
            "path": "/",
            "scheme": "https",
            "timeout": 30000
          },
          "type": "HTTP"
        },
        "x-apigateway-cors": false,
        "x-apigateway-match-mode": "NORMAL",
        "x-apigateway-request-type": "public",
        "x-support-sdk": "N",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "Version": {
      "type": "object",
      "minimum": 1,
      "maximum": 128,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "API版本ID,如v1",
          "example": "v1"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "API的最大微版本号,不支持固定填空",
          "example": ""
        },
        "min_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "API的最小微版本号,不支持固定填空",
          "example": ""
        },
        "status": {
          "type": "string",
          "description": "API版本状态\n - 取值:\n   - CURRENT:主推版本\n   - SUPPORTED:老版本,仍继续支持\n   - DEPRECATED:废弃版本,后续可能会删除",
          "enum": [
            "CURRENT",
            "SUPPORTED",
            "DEPRECATED"
          ],
          "example": "SUPPORTED"
        },
        "updated": {
          "type": "number",
          "minimum": 1,
          "maximum": 128,
          "format": "dateTime",
          "description": "API版本发布UTC时间",
          "example": "2014-06-28T12:20:21Z"
        },
        "links": {
          "type": "array",
          "maxItems": 128,
          "description": "API版本URL地址",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "rel": {
                "type": "string",
                "description": "用途",
                "enum": [
                  "self"
                ],
                "example": "self"
              },
              "href": {
                "type": "string",
                "description": "该用途的URL",
                "example": "https://roma.cn-north-4.myhuaweicloud.com/v1"
              }
            }
          }
        }
      }
    },
    "VersionsResp": {
      "type": "object",
      "properties": {
        "versions": {
          "type": "array",
          "description": "服务的API版本信息列表",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/definitions/Version"
          }
        }
      },
      "example": {
        "versions": [
          {
            "min_version": "",
            "links": [
              {
                "rel": "self",
                "href": "https://roma.cn-north-4.myhuaweicloud.com/v1"
              }
            ],
            "id": "v1",
            "updated": "2018-06-28T12:20:21Z",
            "version": "",
            "status": "SUPPORTED"
          },
          {
            "min_version": "",
            "links": [
              {
                "rel": "self",
                "href": "https://roma.cn-north-4.myhuaweicloud.com/v2"
              }
            ],
            "id": "v2",
            "updated": "2020-06-28T12:20:21Z",
            "version": "",
            "status": "CURRENT"
          }
        ]
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
