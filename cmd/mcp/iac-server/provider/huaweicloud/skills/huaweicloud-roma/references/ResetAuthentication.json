{
  "name": "ResetAuthentication",
  "summary": "重置设备鉴权信息",
  "tags": "设备管理",
  "productshort": "ROMA",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/link/instances/{instance_id}/devices/{device_id}/authentication": {
      "put": {
        "tags": [
          "设备管理"
        ],
        "summary": "重置设备鉴权信息",
        "operationId": "ResetAuthentication",
        "description": "重置设备鉴权信息",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-request-type": "public",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/instance_id"
          },
          {
            "$ref": "#/parameters/device_id"
          },
          {
            "name": "ResetAuthenticationRequestBody",
            "in": "body",
            "description": "设备用户密码更新请求对象",
            "schema": {
              "$ref": "#/definitions/ResetAuthenticationRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Authentication"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ResetAuthenticationRequestBody": {
      "description": "设备用户密码更新请求",
      "example": {
        "user_name": "4F49B62DD19D46F296AD497C7E81B52E",
        "password": "Test1!"
      },
      "properties": {
        "user_name": {
          "type": "string",
          "description": "设备用户名,支持英文大小写、英文符号(-)及数字,长度限制10-50位,传参空,用户名不被重置",
          "minLength": 10,
          "maxLength": 50
        },
        "password": {
          "type": "string",
          "description": "设备密码,输入要求:至少1数字,1大写字母,1小写字母,1特殊字符(~!@#$%^&*()-_=+|[{}];:<>/?),长度8-32位,传参空,密码不被重置。当用户名与密码都为空时,密码重置,由系统生成。",
          "minLength": 8,
          "maxLength": 32
        }
      },
      "type": "object"
    },
    "Authentication": {
      "description": "鉴权",
      "example": {
        "user_name": "4MjxbCl4q461",
        "password": "*************"
      },
      "properties": {
        "user_name": {
          "type": "string",
          "description": "一型一密/一机一密的用户名",
          "minLength": 0,
          "maxLength": 64
        },
        "password": {
          "type": "string",
          "description": "一型一密/一机一密的密码,输入要求:至少1个数字,1个大写字母,1个小写字母,1个特殊字符(~!@#$%^&*()-_=+|[{}];:<>/?),长度8-32个字符",
          "minLength": 0,
          "maxLength": 64
        }
      }
    },
    "Error": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "系统错误码,针对4xx和5xx类HTTP错误码的详细错误码",
          "minLength": 0,
          "maxLength": 64
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 200
        },
        "request_id": {
          "type": "string",
          "description": "消息ID",
          "minLength": 0,
          "maxLength": 64
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "device_id": {
      "name": "device_id",
      "in": "path",
      "description": "设备ID",
      "required": true,
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999999999999999
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方式请参见《ROMA Connect API参考》的“附录 > 获取项目ID”章节。",
      "type": "string",
      "required": true,
      "maxLength": 32,
      "minLength": 0
    },
    "instance_id": {
      "name": "instance_id",
      "in": "path",
      "description": "实例ID",
      "type": "string",
      "required": true,
      "maxLength": 36,
      "minLength": 0
    }
  },
  "host": "roma.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "put",
  "uri": null
}