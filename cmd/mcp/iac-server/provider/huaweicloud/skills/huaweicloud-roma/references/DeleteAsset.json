            "required": true,
            "minLength": 1,
            "maxLength": 100000
          },
          {
            "type": "string",
            "name": "instance_id",
            "in": "path",
            "required": true,
            "minLength": 0,
            "maxLength": 64,
            "description": "实例ID"
          },
          {
            "type": "string",
            "name": "project_id",
            "in": "path",
            "required": true,
            "minLength": 0,
            "maxLength": 64,
            "description": "项目ID"
          },
          {
            "name": "DeleteAssetRequestBody",
            "in": "body",
            "required": true,
            "description": "指定删除应用和任务",
            "schema": {
              "$ref": "#/definitions/AssetOperateRequest"
            }
          }
        ],
        "responses": {
