          "description": "健康检查时的请求方法",
          "enum": [
            "GET",
            "HEAD"
          ],
          "default": "GET",
          "type": "string"
        },
        "port": {
          "description": "健康检查的目标端口,缺少或port = 0时为VPC中主机的端口号。\n\n若此端口存在非0值,则使用此端口进行健康检查。",
          "minimum": 0,
          "maximum": 65535,
          "type": "integer",
          "format": "int32"
        },
        "threshold_normal": {
          "description": "正常阈值。判定VPC通道中主机正常的依据为:连续检查x成功,x为您设置的正常阈值。",
          "minimum": 1,
          "maximum": 10,
          "type": "integer",
