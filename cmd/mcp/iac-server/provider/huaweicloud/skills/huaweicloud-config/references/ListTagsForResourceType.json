        "summary": "查询项目标签",
        "description": "查询租户在指定Project中实例类型的所有资源标签集合。标签管理服务需要能够列出当前租户全部已使用的资源标签集合,为各服务Console打资源标签和过滤实例时提供标签联想功能。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc,hk",
        "operationId": "ListTagsForResourceType",
        "parameters": [
          {
            "name": "resource_type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "config:policyAssignments",
                "config:aggregators",
                "config:aggregationAuthorizations"
              ]
            },
            "description": "资源类型"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1000,
              "minimum": 1,
              "maximum": 1000
            },
            "description": "查询记录数默认为1000,limit最多为1000,不能为负数,最小值为1"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
