{
  "name": "ShowBuiltInPolicyDefinition",
  "summary": "查询单个内置策略",
  "tags": "合规性",
  "productshort": "Config",
  "region_id": "eu-west-101",
  "paths": {
    "/v1/resource-manager/policy-definitions/{policy_definition_id}": {
      "get": {
        "tags": [
          "Policy"
        ],
        "security": [
          {
            "PkiTokenAuth": []
          }
        ],
        "summary": "查询单个内置策略",
        "description": "根据策略ID查询单个内置策略",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-publishpath": "rms_04_0502",
        "operationId": "ShowBuiltInPolicyDefinition",
        "parameters": [
          {
            "$ref": "#/components/parameters/AuthToken"
          },
          {
            "$ref": "#/components/parameters/PolicyDefinitionId"
          },
          {
            "name": "X-Language",
            "in": "header",
            "schema": {
              "type": "string",
              "default": "zh-cn"
            },
            "required": false,
            "description": "选择接口返回的信息的语言,默认为\"zh-cn\"中文"
          }
        ],
        "x-request-examples-url-1": "GET https://{endpoint}/v1/resource-manager/policy-definitions/5f8d5428ffeecc14f1fb5205",
        "x-request-examples-description-1": "",
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyDefinition"
                },
                "example": {
                  "id": "5f8d5428ffeecc14f1fb5205",
                  "name": "ecs-instance-no-public-ip",
                  "policy_type": "builtin",
                  "description": "ECS资源具有公网IP,视为“不合规”",
                  "policy_rule_type": "dsl",
                  "policy_rule": {
                    "allOf": [
                      {
                        "value": "${resource().provider}",
                        "comparator": "equals",
                        "pattern": "ecs"
                      },
                      {
                        "value": "${resource().type}",
                        "comparator": "equals",
                        "pattern": "cloudservers"
                      },
                      {
                        "value": "${length(filter(resource().properties.addresses, lambda x: equals(x.OsExtIpsType, 'floating')))}",
                        "comparator": "greater",
                        "pattern": 0
                      }
                    ]
                  },
                  "keywords": [
                    "ecs"
                  ],
                  "parameters": {}
                }
              }
            }
          },
          "400": {
            "description": "输入参数不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResp"
                }
              }
            }
          },
          "403": {
            "description": "用户认证失败或没有操作权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResp"
                }
              }
            }
          },
          "404": {
            "description": "策略未找到",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResp"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResp"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.0",
  "parameters": null,
  "host": "rms.eu-west-101.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}