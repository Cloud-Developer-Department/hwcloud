  "definitions": {
    "ClusterResponse": {
      "properties": {
        "uid": {
          "type": "string",
          "description": "集群ID"
        }
      },
      "description": "集群注册返回信息"
    },
    "RegisterCluster": {
      "type": "object",
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "资源类型。注册集群必须填写为Cluster。"
        },
        "apiVersion": {
          "type": "string",
          "description": "API版本信息。现版本仅为v1。"
        },
        "metadata": {
          "type": "object",
          "description": "集群元数据信息。",
          "properties": {
            "uid": {
              "type": "string",
              "description": "集群ID信息,仅在注册CCE导入集群时使用,其他类型集群无需填写。"
            },
            "name": {
              "type": "string",
              "description": "CCE集群填写CCE集群名称,其他类型集群自定义"
            },
            "labels": {
              "type": "object",
              "description": "标签信息。可为空,不为空时,必须满足kurbenetes label规范,最多可支持100个标签。",
              "additionalProperties": {
                "type": "string"
              }
            },
            "annotations": {
              "type": "object",
              "description": "集群annotations信息。\n附着集群必填一个kubeconfig字段,取值是kubeconfig文件的内容。kubeconfig文件获取方法请参见[获取KubeConfig文件](https://support.huaweicloud.com/usermanual-ucs/ucs_01_0138.html)",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "name"
          ]
        },
        "spec": {
          "type": "object",
          "description": "集群spec信息。",
          "properties": {
            "clusterGroupID": {
              "type": "string",
              "description": "容器舰队ID信息。"
            },
            "category": {
              "type": "string",
              "description": "集群类别,填写需要与provider和type对应,具体请参见[集群类别与类型说明](ucs_api_0024.xml)。"
            },
            "type": {
              "type": "string",
              "description": "集群类型,填写需要与category和provider对应,具体请参见[集群类别与类型说明](ucs_api_0024.xml)。"
            },
            "provider": {
              "type": "string",
              "description": "供应商,填写需要与category和type对应,具体请参见[集群类别与类型说明](ucs_api_0024.xml)。",
              "x-optional": true
            },
            "country": {
              "type": "string",
              "description": "所在国家代码,具体代码请参见[国家码](ucs_api_0022.xml)。",
              "x-optional": true
            },
            "city": {
              "type": "string",
              "description": "所在城市代码,具体代码请参见[城市码](ucs_api_0023.xml)。仅支持中国城市,其他国家无需填写。"
            },
            "region": {
              "type": "string",
              "description": "地域信息。仅在CCE导入集群注册时使用。可通过[获取未注册到UCS的CCE集群](ListManagedClusters.xml)接口的region字段获取。",
              "x-optional": true
            },
            "projectID": {
              "type": "string",
              "description": "项目ID信息。仅在CCE导入集群注册时使用。可通过[获取未注册到UCS的CCE集群](ListManagedClusters.xml)接口的projectID字段获取。"
            },
            "manageType": {
              "type": "string",
              "description": "集群管理类型信息。\n取值如下:\n- grouped:在舰队中纳管的集群\n- discrete:未加入舰队的集群"
            }
          },
          "required": [
            "category",
            "city",
            "country",
            "manageType",
            "provider",
            "type"
          ]
        }
      },
      "description": "集群信息,包括期望状态(例如同步模式),和集群状态(例如版本、Node状态信息及资源统计信息等)。"
    }
  },
