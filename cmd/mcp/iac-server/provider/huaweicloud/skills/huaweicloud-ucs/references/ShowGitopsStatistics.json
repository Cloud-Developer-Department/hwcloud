{
  "name": "ShowGitopsStatistics",
  "summary": "统计某个用户所有配置集合的运行状态",
  "tags": "配置管理",
  "productshort": "UCS",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/configsets/statistics": {
      "get": {
        "tags": [
          "配置管理"
        ],
        "summary": "统计某个用户所有配置集合的运行状态",
        "description": "统计某个用户所有配置集合的运行状态",
        "operationId": "ShowGitopsStatistics",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "分页获取列表时,页的大小,默认为-1",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页获取列表时,起始偏移量,默认为0",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "order_by",
            "in": "query",
            "description": "分页获取列表时,排序参数,支持create_at和update_at,默认create_at:\n- create_at:按创建时间排序\n- update_at:按更新时间排序",
            "required": false,
            "type": "string",
            "x-api-type": "open-api"
          },
          {
            "name": "order",
            "in": "query",
            "description": "分页获取列表时,排序方向,支持desc和asc,默认desc:\n- desc:降序排序\n- asc:升序排序",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "用户所有配置集合的运行状态的统计结果",
            "examples": {
              "application/json": {
                "overviewStatus": {
                  "configSetTotalNum": 1,
                  "failedStatusNum": 1
                },
                "items": [
                  {
                    "clusterID": "375f1918-5924-11ee-bfe7-0255ac1001b8",
                    "configSetTotalNum": 1,
                    "failedStatusNum": 1,
                    "sourceRepoNum": 1
                  },
                  {
                    "clusterID": "620a2278-568c-11ee-a207-0255ac10004d"
                  }
                ],
                "total": 2
              }
            },
            "schema": {
              "$ref": "#/definitions/ConfigSetStatisticsResponse"
            }
          },
          "400": {
            "description": "客户端请求错误,服务器无法执行请求",
            "schema": {
              "type": "string"
            }
          }
        },
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-order": 13
      }
    }
  },
  "definitions": {
    "ConfigSetStatisticsResponse": {
      "type": "object",
      "properties": {
        "overviewStatus": {
          "description": "所有集群中配置集合的状态总览",
          "$ref": "#/definitions/OverviewReconcileStatus"
        },
        "items": {
          "type": "array",
          "description": "每个集群的配置集合状态",
          "items": {
            "$ref": "#/definitions/ClusterReconcileStatus"
          }
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "所有页的结果的总数"
        }
      }
    },
    "OverviewReconcileStatus": {
      "type": "object",
      "properties": {
        "configSetTotalNum": {
          "type": "integer",
          "format": "int32",
          "description": "配置集合总数"
        },
        "healthStatusNum": {
          "type": "integer",
          "format": "int32",
          "description": "健康状态的配置集合数量"
        },
        "failedStatusNum": {
          "type": "integer",
          "format": "int32",
          "description": "失败状态的配置集合数量"
        },
        "unknownStatusNum": {
          "type": "integer",
          "format": "int32",
          "description": "未知状态的配置集合数量"
        },
        "progressingStatusNum": {
          "type": "integer",
          "format": "int32",
          "description": "正在处理中的配置集合数量"
        }
      }
    },
    "ClusterReconcileStatus": {
      "type": "object",
      "properties": {
        "clusterID": {
          "type": "string",
          "description": "集群id"
        },
        "configSetTotalNum": {
          "type": "integer",
          "format": "int32",
          "description": "集群中配置集合的总数"
        },
        "healthStatusNum": {
          "type": "integer",
          "format": "int32",
          "description": "健康状态的配置集合数量"
        },
        "failedStatusNum": {
          "type": "integer",
          "format": "int32",
          "description": "失败状态的配置集合数量"
        },
        "unknownStatusNum": {
          "type": "integer",
          "format": "int32",
          "description": "未知状态的配置集合数量"
        },
        "progressingStatusNum": {
          "type": "integer",
          "format": "int32",
          "description": "正在处理中的配置集合数量"
        },
        "k8sResourceNum": {
          "type": "integer",
          "format": "int32",
          "description": "与集群关联的Kubernetes资源数量"
        },
        "sourceRepoNum": {
          "type": "integer",
          "format": "int32",
          "description": "与集群关联的源代码仓库数量"
        }
      },
      "description": "针对单个特定集群的综合状态概览"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ucs.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}