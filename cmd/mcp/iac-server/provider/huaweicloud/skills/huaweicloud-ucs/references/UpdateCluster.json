  "definitions": {
    "WorkerConfig": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "format": "int32",
          "description": "节点个数"
        },
        "strategy": {
          "description": "节点更新策略",
          "$ref": "#/definitions/NodeUpgradeStrategy"
        }
      }
    },
    "UpdateClusterRequestBody": {
      "type": "object",
      "required": [
        "apiVersion",
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "API类型,固定值“Cluster”,该值不可修改。"
        },
        "apiVersion": {
          "type": "string",
          "description": "API版本,固定值“v1”,该值不可修改。"
        },
        "metadata": {
          "description": "集群的基本信息,为集合类的元素类型,包含一组由不同名称定义的属性。",
          "$ref": "#/definitions/UpdateObjectMeta"
        },
        "spec": {
          "description": "spec是集合类的元素类型,您对需要管理的集群对象进行详细描述的主体部分都在spec中给出。UCS通过spec的描述来创建或更新对象。",
          "$ref": "#/definitions/UpdateClusterSpec"
        }
      }
    },
    "NodeUpgradeStrategy": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "策略类型"
        },
        "rollingUpdate": {
          "description": "滚动更新",
          "$ref": "#/definitions/RollingUpdateNodeUpgradeStrategy"
        }
      },
      "description": "节点更新策略"
    },
    "UpdateClusterSpec": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string",
          "description": "集群所在国家信息"
        },
        "city": {
          "type": "string",
          "description": "集群所在城市信息"
        },
        "workerConfig": {
          "description": "工作节点配置,仅支持多云集群",
          "$ref": "#/definitions/WorkerConfig"
        }
      }
    },
    "RollingUpdateNodeUpgradeStrategy": {
      "type": "object",
      "properties": {
        "maxUnavailable": {
          "type": "object",
          "description": "最大不可用个数",
          "properties": {}
        },
        "maxSurge": {
          "type": "object",
          "description": "允许超出期望的最大个数",
          "properties": {}
        },
        "deletePolicy": {
          "type": "string",
          "description": "删除策略:Random、Oldest、Newest"
        }
      }
    },
    "UpdateObjectMeta": {
      "properties": {
        "annotations": {
          "type": "object",
          "description": "集群标注",
          "properties": {}
        }
      },
      "description": "Object Meta Data"
    }
  },
