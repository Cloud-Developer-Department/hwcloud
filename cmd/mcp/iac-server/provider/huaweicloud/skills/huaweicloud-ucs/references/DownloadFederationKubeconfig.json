  "tags": "容器舰队",
  "productshort": "UCS",
  "region_id": "cn-south-4",
  "paths": {
    "/v1/clustergroups/{clustergroupid}/kubeconfig": {
      "post": {
        "tags": [
          "容器舰队"
        ],
        "summary": "下载联邦kubeconfig",
        "description": "舰队开通联邦并且创建网络连接之后,可以使用此接口下载联邦的kubeconfig",
        "operationId": "DownloadFederationKubeconfig",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "clustergroupid",
            "in": "path",
            "description": "舰队id",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "DownloadFederationKubeconfigRequestBody",
            "description": "下载联邦kubeconfig的请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DownloadFederationKubeconfigRequestBody"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "身份认证信息",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "201": {
            "description": "kubeconfig文件",
            "examples": {
              "application/json": {
                "kind": "Config",
                "apiVersion": "v1",
                "clusters": [
                  {
                    "name": "cluster-demo",
                    "cluster": {
                      "server": "https://ip:port",
                      "certificate-authority-data": ""
                    }
                  }
                ],
                "users": [
                  {
                    "name": "user",
                    "user": {
                      "client-certificate-data": "",
                      "client-key-data": "",
                      "token": ""
                    }
                  }
                ],
                "contexts": [
                  {
                    "name": "demo",
                    "context": {
                      "cluster": "cluster-demo",
                      "user": "user"
                    }
                  }
                ],
                "current-context": "demo"
              }
            },
            "schema": {
              "$ref": "#/definitions/KubeConfig"
            }
          }
        },
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-is-support-cmc": "Y",
        "x-request-examples-description-1": "下载联邦kubeconfig",
        "x-request-examples-url-1": "POST https://ucs.myhuaweicloud.com/v1/clustergroups/{clustergroupid}/kubeconfig",
        "x-request-examples-1": {
          "duration": 30
        },
        "x-request-examples-text-1": {
          "duration": 30
        },
        "x-order": 15
      }
    }
  },
  "definitions": {
    "AuthInfo": {
      "type": "object",
      "properties": {
        "client-certificate-data": {
          "type": "string",
          "description": "客户端证书"
        },
        "client-key-data": {
          "type": "string",
          "description": "包含来自TLS客户端密钥文件的PEM编码数据"
        },
        "token": {
          "type": "string",
          "description": "身份验证令牌"
        }
      },
      "description": "用户认证信息"
    },
    "ClusterCert": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string",
          "description": "服务器地址"
        },
        "certificate-authority-data": {
          "type": "string",
          "description": "证书授权数据"
        },
        "insecure-skip-tls-verify": {
          "type": "string",
          "description": "不校验服务端证书"
        }
      }
    },
    "NamedContext": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "上下文的名称"
        },
        "context": {
          "type": "string",
          "description": "上下文信息"
        }
      },
      "description": "上下文"
    },
    "KubeConfig": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "API类型,固定值“Config”,该值不可修改"
        },
        "apiVersion": {
          "type": "string",
          "description": "API版本,固定值“v1”,该值不可修改"
        },
        "clusters": {
          "type": "array",
          "description": "集群列表",
          "items": {
            "$ref": "#/definitions/NamedCluster"
          }
        },
        "users": {
          "type": "array",
          "description": "存放了指定用户的一些证书信息和ClientKey信息",
          "items": {
            "$ref": "#/definitions/NamedAuthInfo"
          }
        },
        "contexts": {
          "type": "array",
          "description": "上下文列表",
          "items": {
            "$ref": "#/definitions/NamedContext"
          }
        },
        "current-context": {
          "type": "string",
          "description": "当前上下文"
        }
      }
    },
    "NamedCluster": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "集群名称"
        },
        "cluster": {
          "description": "集群信息",
          "$ref": "#/definitions/ClusterCert"
        }
      },
      "description": "集群信息"
    },
    "DownloadFederationKubeconfigRequestBody": {
      "type": "object",
      "required": [
        "duration"
      ],
      "properties": {
        "duration": {
          "type": "integer",
          "format": "int32",
          "description": "kubeconfig中证书的有效期",
          "minimum": 1,
          "maximum": 1825
        }
      },
      "description": "下载联邦证书的请求体"
    },
    "NamedAuthInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "用户名"
        },
        "user": {
          "description": "存放了指定用户的一些证书信息和ClientKey信息",
          "$ref": "#/definitions/AuthInfo"
        }
      }
    }
  },
