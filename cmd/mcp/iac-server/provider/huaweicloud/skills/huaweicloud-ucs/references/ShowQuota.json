{
  "name": "ShowQuota",
  "summary": "获取配额信息",
  "tags": "配额管理",
  "productshort": "UCS",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/maintenance/quota/{domainid}": {
      "get": {
        "tags": [
          "配额管理"
        ],
        "summary": "获取配额信息",
        "description": "获取UCS配额信息",
        "operationId": "ShowQuota",
        "parameters": [
          {
            "name": "domainid",
            "in": "path",
            "description": "账号id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "返回当前租户配额信息集合",
            "examples": {
              "application/json": {
                "quotas": {
                  "resources": [
                    {
                      "type": "cluster",
                      "quota": 75,
                      "used": 8,
                      "unit": "",
                      "min": 20,
                      "max": 100
                    },
                    {
                      "type": "clustergroup",
                      "quota": 50,
                      "used": 2,
                      "unit": "",
                      "min": 20,
                      "max": 100
                    },
                    {
                      "type": "rule",
                      "quota": 50,
                      "used": 1,
                      "unit": "",
                      "min": 20,
                      "max": 100
                    },
                    {
                      "type": "federation",
                      "quota": 10,
                      "used": 1,
                      "unit": "",
                      "min": 1,
                      "max": 50
                    }
                  ]
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonQuotaSet"
            }
          },
          "400": {
            "description": "客户端请求错误,服务器无法执行请求",
            "schema": {
              "type": "string"
            }
          },
          "403": {
            "description": "服务器拒绝执行请求",
            "schema": {
              "type": "string"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "type": "string"
            }
          }
        },
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-order": 42
      }
    }
  },
  "definitions": {
    "CommonQuotaSet": {
      "type": "object",
      "properties": {
        "quotas": {
          "description": "包含配额资源的集合",
          "$ref": "#/definitions/CommonQuotas"
        }
      }
    },
    "QuotaResource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "配额类型,取值范围:\n- cluster:集群类型配额\n- clustergroup:容器舰队类型配额\n- rule:规则类型配额\n- federation:联邦类型配额",
          "x-api-type": "open-api"
        },
        "quota": {
          "type": "string",
          "description": "配额的总值"
        },
        "used": {
          "type": "string",
          "description": "已使用配额"
        },
        "unit": {
          "type": "string",
          "description": "单位"
        },
        "min": {
          "type": "string",
          "description": "最小值"
        },
        "max": {
          "type": "string",
          "description": "最大值"
        }
      }
    },
    "CommonQuotas": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "description": "配额资源列表",
          "items": {
            "$ref": "#/definitions/QuotaResource"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ucs.myhuaweicloud.com",
