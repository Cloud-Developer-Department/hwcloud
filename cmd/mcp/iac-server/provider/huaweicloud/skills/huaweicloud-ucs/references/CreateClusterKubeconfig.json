{
  "name": "CreateClusterKubeconfig",
  "summary": "获取集群kubeconfig",
  "tags": "UCS集群",
  "productshort": "UCS",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/clusters/{clusterid}/kubeconfig": {
      "post": {
        "tags": [
          "UCS集群"
        ],
        "summary": "获取集群kubeconfig",
        "description": "获取集群kubeconfig",
        "operationId": "CreateClusterKubeconfig",
        "parameters": [
          {
            "name": "clusterid",
            "in": "path",
            "description": "集群id",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "身份认证信息,调用接口的认证方式分为Token和AK/SK两种,如果您使用的Token方式,此参数为必填,请填写Token的值",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "201": {
            "description": "获取到指定集群的kubeconfig",
            "examples": {
              "application/json": {
                "kind": "Config",
                "apiVersion": "v1",
                "clusters": [
                  {
                    "name": "internalCluster",
                    "cluster": {
                      "server": "https://192.168.0.18:5443",
                      "certificate-authority-data": "*****"
                    }
                  },
                  {
                    "name": "externalCluster",
                    "cluster": {
                      "server": "https://100.93.8.56:5443",
                      "insecure-skip-tls-verify": true
                    }
                  },
                  {
                    "name": "externalClusterTLSVerify",
                    "cluster": {
                      "server": "https://100.93.8.56:5443",
                      "certificate-authority-data": "******"
                    }
                  }
                ],
                "users": [
                  {
                    "name": "user",
                    "user": {
                      "client-certificate-data": "******",
                      "client-key-data": "******"
                    }
                  }
                ],
                "contexts": [
                  {
                    "name": "internal",
                    "context": {
                      "cluster": "internalCluster",
                      "user": "user"
                    }
                  },
                  {
                    "name": "external",
                    "context": {
                      "cluster": "externalCluster",
                      "user": "user"
                    }
                  },
                  {
                    "name": "externalTLSVerify",
                    "context": {
                      "cluster": "externalClusterTLSVerify",
                      "user": "user"
                    }
                  }
                ],
                "current-context": "external"
              }
            },
            "schema": {
              "$ref": "#/definitions/KubeConfig"
            }
          },
          "400": {
            "description": "客户端请求错误,服务器无法执行请求",
            "schema": {
              "type": "string"
            }
          },
          "404": {
            "description": "资源不存在",
            "schema": {
              "type": "string"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "type": "string"
            }
          }
        },
        "x-request-examples-url-1": "POST https://ucs.myhuaweicloud.com/v1/clusters/{clusterid}/kubeconfig",
        "x-request-examples-description-1": "获取指定集群的kubeconfig",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-order": 6
      }
    }
  },
  "definitions": {
    "AuthInfo": {
      "type": "object",
      "properties": {
        "client-certificate-data": {
          "type": "string",
          "description": "客户端证书"
        },
        "client-key-data": {
          "type": "string",
          "description": "包含来自TLS客户端密钥文件的PEM编码数据"
        },
        "token": {
          "type": "string",
          "description": "身份验证令牌"
        }
      },
      "description": "用户认证信息"
    },
    "Context": {
      "type": "object",
      "properties": {
        "cluster": {
          "type": "string",
          "description": "上下文cluster信息"
        },
        "user": {
          "type": "string",
          "description": "上下文user信息"
        }
      },
      "description": "上下文信息"
    },
    "ClusterCert": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string",
          "description": "服务器地址"
        },
        "certificate-authority-data": {
          "type": "string",
          "description": "证书授权数据"
        },
        "insecure-skip-tls-verify": {
          "type": "string",
          "description": "不校验服务端证书"
        }
      }
    },
    "NamedContext": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "上下文的名称"
        },
        "context": {
          "description": "上下文信息",
          "$ref": "#/definitions/Context"
        }
      },
      "description": "上下文"
    },
    "KubeConfig": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "API类型,固定值“Config”,该值不可修改"
        },
        "apiVersion": {
          "type": "string",
          "description": "API版本,固定值“v1”,该值不可修改"
        },
        "clusters": {
          "type": "array",
          "description": "集群列表",
          "items": {
            "$ref": "#/definitions/NamedCluster"
          }
        },
        "users": {
          "type": "array",
          "description": "存放了指定用户的一些证书信息和ClientKey信息",
          "items": {
            "$ref": "#/definitions/NamedAuthInfo"
          }
        },
        "contexts": {
          "type": "array",
          "description": "上下文列表",
          "items": {
            "$ref": "#/definitions/NamedContext"
          }
        },
        "current-context": {
          "type": "string",
          "description": "当前上下文"
        }
      }
    },
    "NamedCluster": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "集群名称"
        },
        "cluster": {
          "description": "集群信息",
          "$ref": "#/definitions/ClusterCert"
        }
      },
      "description": "集群信息"
    },
    "NamedAuthInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "用户名"
        },
        "user": {
          "description": "存放了指定用户的一些证书信息和ClientKey信息",
          "$ref": "#/definitions/AuthInfo"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ucs.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}