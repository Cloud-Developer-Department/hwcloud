{
  "name": "ListInstanceIpRule",
  "summary": "查询高防实例IP的转发规则列表",
  "tags": "DDoS高防-转发规则管理",
  "productshort": "AAD",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aad/instances/{instance_id}/{ip}/rules": {
      "get": {
        "x-iftype": "transfer-rule",
        "tags": [
          "DDoS高防-转发规则管理"
        ],
        "operationId": "ListInstanceIpRule",
        "summary": "查询高防实例IP的转发规则列表",
        "description": "查询高防实例IP的转发规则列表",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "token",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Content-Type",
            "minLength": 1,
            "maxLength": 128,
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "instance_id",
            "description": "实例Id",
            "minLength": 16,
            "maxLength": 64,
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "ip",
            "description": "单个 IP",
            "minLength": 1,
            "maxLength": 45,
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "限制条数",
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 1000
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "偏移量",
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        ],
        "responses": {
          "200": {
            "description": "高防实例IP的转发规则列表",
            "schema": {
              "$ref": "#/definitions/ListTransferRule"
            },
            "examples": {
              "application/json": {
                "total": 2,
                "rules": [
                  {
                    "rule_id": "81c8XXXX-XXXX-XXXX-XXXX11c9",
                    "forward_protocol": "tcp",
                    "forward_port": 31,
                    "source_port": 31,
                    "lb_method": "rr",
                    "source_ip": "4.0.1.1",
                    "status": 1
                  },
                  {
                    "rule_id": "ea86XXXX-XXXX-XXXX-XXXXfa13",
                    "forward_protocol": "tcp",
                    "forward_port": 61,
                    "source_port": 61,
                    "lb_method": "rr",
                    "source_ip": "6.0.1.1",
                    "status": 1
                  }
                ]
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "definitions": {
    "TransferRuleInfo": {
      "type": "object",
      "properties": {
        "rule_id": {
          "type": "string",
          "description": "转发规则名ID"
        },
        "forward_protocol": {
          "type": "string",
          "description": "转发协议,tcp或udp",
          "example": "tcp"
        },
        "forward_port": {
          "type": "integer",
          "format": "int32",
          "description": "转发端口",
          "minimum": 1,
          "maximum": 65536,
          "example": "8888"
        },
        "source_port": {
          "type": "integer",
          "format": "int32",
          "description": "源站端口",
          "minimum": 1,
          "maximum": 65536,
          "example": "8888"
        },
        "lb_method": {
          "type": "string",
          "description": "LVS转发规则",
          "example": "rr"
        },
        "source_ip": {
          "type": "string",
          "description": "源站IP,多个IP用逗号隔开,限制20个IP",
          "example": "1.1.1.1,2.2.2.2"
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "源站状态 1 正常,2 异常"
        }
      }
    },
    "ListTransferRule": {
      "type": "object",
      "description": "转发规则列表",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "转发规则总数"
        },
        "rules": {
          "type": "array",
          "description": "转发规则列表",
          "items": {
            "$ref": "#/definitions/TransferRuleInfo"
          }
        }
      },
      "example": {
        "total": 2,
        "rules": [
          {
            "rule_id": "81c8XXXX-XXXX-XXXX-XXXX11c9",
            "forward_protocol": "tcp",
            "forward_port": 31,
            "source_port": 31,
            "lb_method": "rr",
            "source_ip": "3.0.1.1",
            "status": 2
          },
          {
            "rule_id": "ea86XXXX-XXXX-XXXX-XXXXfa13",
            "forward_protocol": "tcp",
            "forward_port": 61,
            "source_port": 61,
            "lb_method": "rr",
            "source_ip": "6.0.1.1",
            "status": 2
          }
        ]
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "aad.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}