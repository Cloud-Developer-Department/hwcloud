          "type": "boolean",
          "description": "精准防护规则生效时间。true-自定义生效时间,false-立即生效"
        },
        "start": {
          "type": "integer",
          "format": "int64",
          "description": "精准防护规则生效的起始时间戳(秒)"
        },
        "terminal": {
          "type": "integer",
          "format": "int64",
          "description": "精准防护规则生效的终止时间戳(秒)"
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "description": "执行该规则的优先级,值越小,优先级越高。取值范围:0到1000。"
        },
        "conditions": {
          "items": {
            "$ref": "#/definitions/WafCustomCondition"
          },
          "type": "array",
          "description": "condition"
        },
        "action": {
          "$ref": "#/definitions/WafCustomRuleAction",
          "description": "action"
        },
        "domain_name": {
          "type": "string",
          "description": "域名"
        },
        "overseas_type": {
          "type": "integer",
          "format": "int32",
          "description": "防护区域,0-大陆,1-海外"
        }
      }
    },
    "WafCustomRuleAction": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "example": "block",
          "description": "防护动作。\n“block”:拦截。\n“pass”:放行。\n“log”:仅记录"
        }
      }
    }
