{
  "name": "BatchCreateInstanceIpRule",
  "summary": "批量创建高防实例IP的转发规则",
  "tags": "DDoS高防-转发规则管理",
  "productshort": "AAD",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/aad/instances/{instance_id}/{ip}/rules/batch-create": {
      "post": {
        "tags": [
          "DDoS高防-转发规则管理"
        ],
        "operationId": "BatchCreateInstanceIpRule",
        "summary": "批量创建高防实例IP的转发规则",
        "description": "批量创建高防实例IP的转发规则",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "token",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Content-Type",
            "minLength": 1,
            "maxLength": 128,
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "instance_id",
            "description": "实例Id",
            "minLength": 16,
            "maxLength": 64,
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "ip",
            "description": "单个 IP",
            "minLength": 1,
            "maxLength": 45,
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "BatchCreateInstanceIpRuleRequestBody",
            "in": "body",
            "description": "批量创建的转发规则信息",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BatchTransferRuleBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "批量创建转发规则响应",
            "schema": {
              "$ref": "#/definitions/CreateRuleResp"
            },
            "examples": {
              "application/json": {
                "success_num": 1
              }
            }
          },
          "400": {
            "description": "Error"
          }
        }
      }
    }
  },
  "definitions": {
    "TransferRuleBody": {
      "type": "object",
      "properties": {
        "forward_protocol": {
          "type": "string",
          "description": "转发协议,tcp或udp",
          "example": "tcp"
        },
        "forward_port": {
          "type": "integer",
          "format": "int32",
          "description": "转发端口",
          "minimum": 1,
          "maximum": 65536,
          "example": "8888"
        },
        "source_port": {
          "type": "integer",
          "format": "int32",
          "description": "源站端口",
          "minimum": 1,
          "maximum": 65536,
          "example": "8888"
        },
        "source_ip": {
          "type": "string",
          "description": "源站IP,多个IP用逗号隔开,限制20个IP",
          "minimum": 1,
          "maximum": 256,
          "example": "1.1.1.1,2.2.2.2"
        }
      }
    },
    "BatchTransferRuleBody": {
      "type": "object",
      "description": "批量转发规则",
      "properties": {
        "rules": {
          "type": "array",
          "description": "批量转发规则",
          "items": {
            "$ref": "#/definitions/TransferRuleBody"
          }
        }
      }
    },
    "CreateRuleResp": {
      "type": "object",
      "properties": {
        "success_num": {
          "type": "integer",
          "format": "int32",
          "description": "数量"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "aad.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}