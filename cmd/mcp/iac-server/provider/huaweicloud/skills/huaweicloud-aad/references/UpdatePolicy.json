{
  "name": "UpdatePolicy",
  "summary": "更新策略",
  "tags": "DDoS原生高级防护-策略管理",
  "productshort": "AAD",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/cnad/policies/{policy_id}": {
      "put": {
        "tags": [
          "DDoS原生高级防护-策略管理"
        ],
        "summary": "更新策略",
        "operationId": "UpdatePolicy",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "description": "更新策略",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Content-Type",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "policy_id",
            "in": "path",
            "description": "策略id",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 64
          },
          {
            "name": "UpdatePolicyRequestBody",
            "in": "body",
            "description": "更新策略的请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdatePolicyRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "definitions": {
    "UpdatePolicyRequestBody": {
      "type": "object",
      "description": "更新策略的请求体",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "策略名",
          "example": "name"
        },
        "threshold": {
          "type": "integer",
          "format": "int32",
          "description": "清洗阈值",
          "minimum": 100,
          "maximum": 1000,
          "example": 100
        },
        "description": {
          "type": "string",
          "description": "描述",
          "example": "描述",
          "minLength": 0,
          "maxLength": 255
        },
        "udp": {
          "type": "string",
          "description": "udp协议设置。block:封禁,unblock:不封禁,limiting:限速",
          "enum": [
            "block",
            "unblock",
            "limiting"
          ],
          "example": "block"
        },
        "tcp": {
          "type": "string",
          "description": "tcp协议设置。block:封禁,unblock:不封禁,limiting:限速",
          "enum": [
            "block",
            "unblock",
            "limiting"
          ],
          "example": "bloc"
        },
        "icmp": {
          "type": "string",
          "description": "icmp协议设置。block:封禁,unblock:不封禁,limiting:限速",
          "enum": [
            "block",
            "unblock",
            "limiting"
          ],
          "example": "block"
        },
        "other": {
          "type": "string",
          "description": "other协议设置。block:封禁,unblock:不封禁,limiting:限速",
          "enum": [
            "block",
            "unblock",
            "limiting"
          ],
          "example": "block"
        },
        "icmp_traffic_limiting": {
          "type": "integer",
          "format": "int64",
          "description": "icmp自定义限速值,icmp取值limiting情况下,如果该值为空表示不限速",
          "minimum": 1,
          "maximum": 2000000,
          "example": 100
        },
        "udp_traffic_limiting": {
          "type": "integer",
          "format": "int64",
          "description": "udp自定义限速值,udp取值limiting情况下,如果该值为空表示不限速",
          "minimum": 1,
          "maximum": 80000000,
          "example": 100
        },
        "udp_fragment_rate_limiting": {
          "type": "integer",
          "format": "int64",
          "description": "udp分片自定义限速值,udp取值limiting情况下,如果该值为空表示不限速",
          "minimum": 1,
          "maximum": 80000000,
          "example": 100
        },
        "other_traffic_limiting": {
          "type": "integer",
          "format": "int64",
          "description": "other自定义限速值,other取值limiting情况下,如果该值为空表示不限速",
          "minimum": 1,
          "maximum": 80000000,
          "example": 100
        },
        "tcp_traffic_limiting": {
          "type": "integer",
          "format": "int64",
          "description": "tcp自定义限速值,tcp取值limiting情况下,如果该值为空表示不限速",
          "minimum": 1,
          "maximum": 80000000,
          "example": 100
        },
        "tcp_fragment_rate_limiting": {
          "type": "integer",
          "format": "int64",
          "description": "tcp分片自定义限速值,tcp取值limiting情况下,如果该值为空表示不限速",
          "minimum": 1,
          "maximum": 80000000,
          "example": 100
        }
      },
      "example": {
        "name": "name",
        "udp": "block",
        "description": "",
        "threshold": 100,
        "icmp": "limiting",
        "other": "unblock",
        "tcp": "block",
        "icmp_traffic_limiting": 200
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "aad.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}