{
  "name": "ShowWafPolicy",
  "summary": "查询WEB防护策略配置",
  "tags": "DDoS高防-防护策略",
  "productshort": "AAD",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/aad/policies/waf": {
      "get": {
        "tags": [
          "DDoS高防-防护策略"
        ],
        "summary": "查询WEB防护策略配置",
        "description": "查询WEB防护策略配置",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ShowWafPolicy",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "token",
            "required": true,
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Content-Type",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "domain_name",
            "in": "query",
            "description": "域名",
            "required": true,
            "type": "string"
          },
          {
            "name": "overseas_type",
            "in": "query",
            "description": "防护区域,0-大陆,1-海外",
            "required": true,
            "type": "integer",
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/ShowWafPolicyDetailResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "WafPolicyOptions": {
      "type": "object",
      "properties": {
        "cc": {
          "type": "boolean",
          "description": "是否开启CC(频率控制)"
        },
        "custom": {
          "type": "boolean",
          "description": "是否开启精准访问防护"
        },
        "geoip": {
          "type": "boolean",
          "description": "是否开启区域封禁防护"
        },
        "whiteblackip": {
          "type": "boolean",
          "description": "是否开启黑白名单防护"
        },
        "modulex_enabled": {
          "type": "boolean",
          "description": "是否开启智能CC防护"
        }
      }
    },
    "ShowWafPolicyDetailResponse": {
      "type": "object",
      "required": [
        "domain_name",
        "overseas_type",
        "options",
        "level",
        "mode"
      ],
      "properties": {
        "domain_name": {
          "type": "string",
          "description": "域名(包含端口)"
        },
        "overseas_type": {
          "type": "integer",
          "format": "int32",
          "description": "0-中国大陆,1-中国大陆外"
        },
        "options": {
          "description": "防护设置。只传需要修改的字段",
          "$ref": "#/definitions/WafPolicyOptions"
        },
        "level": {
          "type": "integer",
          "format": "int32",
          "description": "智能CC防护等级:[0-宽松,1- 正常, 2- 严格]"
        },
        "mode": {
          "type": "integer",
          "format": "int32",
          "description": "智能CC模式:0-预警,1-防护"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "aad.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
