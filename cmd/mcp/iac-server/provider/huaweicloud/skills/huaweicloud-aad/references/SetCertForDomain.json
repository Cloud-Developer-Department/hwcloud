{
  "name": "SetCertForDomain",
  "summary": "上传/修改域名对应证书",
  "tags": "DDoS高防-域名管理",
  "productshort": "AAD",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/aad/external/domains/certificate": {
      "post": {
        "tags": [
          "DDoS高防-域名管理"
        ],
        "operationId": "SetCertForDomain",
        "summary": "上传/修改域名对应证书",
        "description": "上传/修改域名对应证书",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。 通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Content-Type",
            "minLength": 1,
            "maxLength": 128,
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,对应华为云控制台用户名->我的凭证->项目列表->项目ID",
            "required": true,
            "type": "string"
          },
          {
            "name": "CertificateBody",
            "in": "body",
            "description": "证书信息",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CertificateBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Error"
          }
        },
        "x-order": 4
      }
    }
  },
  "definitions": {
    "CertificateBody": {
      "type": "object",
      "required": [
        "op_type",
        "cert_name",
        "domain_id"
      ],
      "properties": {
        "op_type": {
          "type": "integer",
          "format": "int32",
          "description": "操作类型。0 - 上传, 1 - 更换",
          "example": 0
        },
        "cert_name": {
          "type": "string",
          "description": "证书名称",
          "example": "cert"
        },
        "cert_file": {
          "type": "string",
          "description": "证书文件。上传新证书(op_type为0)时必填,更换为已有证书(op_type为1)时置空",
          "example": "-----BEGIN CERTIFICATE----- xxxx -----END CERTIFICATE-----"
        },
        "cert_key_file": {
          "type": "string",
          "description": "私钥文件。上传新证书(op_type为0)时必填,更换为已有证书(op_type为1)时置空",
          "example": "-----BEGIN RSA PRIVATE KEY----- xxxx -----END RSA PRIVATE KEY-----"
        },
        "domain_id": {
          "type": "string",
          "description": "域名id",
          "example": "81c8xxxxxxxxxxxxxxxx11c9"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "aad.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}