{
  "name": "ModifyDomainWebSwitch",
  "summary": "修改域名WEB基础防护开关/CC防护开关",
  "tags": "DDoS高防-域名管理",
  "productshort": "AAD",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/{project_id}/aad/external/domains/switch": {
      "post": {
        "tags": [
          "DDoS高防-域名管理"
        ],
        "operationId": "ModifyDomainWebSwitch",
        "summary": "修改域名WEB基础防护开关/CC防护开关",
        "description": "修改域名WEB基础防护开关/CC防护开关",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。 通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Content-Type",
            "minLength": 1,
            "maxLength": 128,
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,对应华为云控制台用户名->我的凭证->项目列表->项目ID",
            "required": true,
            "type": "string"
          },
          {
            "name": "SwitchRequest",
            "in": "body",
            "description": "WEB防护开关信息",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CadDomainSwitchRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Error"
          }
        },
        "x-order": 5
      }
    }
  },
  "definitions": {
    "CadDomainSwitchRequest": {
      "type": "object",
      "required": [
        "domain_id",
        "waf_switch",
        "cc_switch"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "description": "域名id",
          "example": "81c8xxxxxxxxxxxxxxxx11c9"
        },
        "waf_switch": {
          "type": "integer",
          "format": "int32",
          "description": "是否开启WEB基础防护开关。0 - 开启, 1 - 关闭",
          "example": 0
        },
        "cc_switch": {
          "type": "integer",
          "format": "int32",
          "description": "是否开启CC防护开关。0 - 开启, 1 - 关闭。开启CC开关必须同时开启WEB基础防护开关",
          "example": 0
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "aad.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}