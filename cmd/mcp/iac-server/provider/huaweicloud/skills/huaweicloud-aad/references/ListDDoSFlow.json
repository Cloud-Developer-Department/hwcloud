{
  "name": "ListDDoSFlow",
  "summary": "查询DDoS攻击防护BPS/PPS流量",
  "tags": "DDoS高防-概览",
  "productshort": "AAD",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/aad/instances/{instance_id}/ddos-info/flow": {
      "get": {
        "tags": [
          "DDoS高防-概览"
        ],
        "operationId": "ListDDoSFlow",
        "summary": "查询DDoS攻击防护BPS/PPS流量",
        "description": "查询DDoS攻击防护BPS/PPS流量",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "token",
            "required": true,
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Content-Type",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID",
            "required": true,
            "type": "string"
          },
          {
            "name": "ip",
            "in": "query",
            "description": "高防IP",
            "required": true,
            "type": "string"
          },
          {
            "name": "type",
            "in": "query",
            "description": "请求类型 pps、bps",
            "required": true,
            "type": "string"
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "开始时间(毫秒时间戳)",
            "required": true,
            "type": "string"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "结束时间(毫秒时间戳)",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListDDoSFlowResponseBody"
            }
          },
          "400": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "FlowPps": {
      "type": "object",
      "properties": {
        "utime": {
          "type": "integer",
          "format": "int64",
          "example": 11,
          "description": "数据时间"
        },
        "attack_pps": {
          "type": "integer",
          "format": "int32",
          "example": 47,
          "description": "攻击包速率"
        },
        "normal_pps": {
          "type": "integer",
          "format": "int32",
          "example": 51,
          "description": "正常包速率"
        }
      }
    },
    "ListDDoSFlowResponseBody": {
      "type": "object",
      "properties": {
        "flow_bps": {
          "items": {
            "$ref": "#/definitions/FlowBps"
          },
          "type": "array",
          "description": "当请求type=bps时必返回"
        },
        "flow_pps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowPps"
          },
          "description": "当请求type=pps时必返回"
        }
      }
    },
    "FlowBps": {
      "type": "object",
      "properties": {
        "utime": {
          "type": "integer",
          "format": "int64",
          "example": 26,
          "description": "数据时间"
        },
        "attack_bps": {
          "type": "integer",
          "format": "int32",
          "example": 15,
          "description": "攻击流量"
        },
        "normal_bps": {
          "type": "integer",
          "format": "int32",
          "example": 53,
          "description": "正常流量"
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_description"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_description": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "aad.myhuaweicloud.com",
  "base_path": "/",
