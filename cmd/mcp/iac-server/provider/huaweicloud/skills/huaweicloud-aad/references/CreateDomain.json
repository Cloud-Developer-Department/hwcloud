{
  "name": "CreateDomain",
  "summary": "创建防护域名",
  "tags": "DDoS高防-域名管理",
  "productshort": "AAD",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/aad/external/domains": {
      "post": {
        "tags": [
          "DDoS高防-域名管理"
        ],
        "operationId": "CreateDomain",
        "summary": "创建防护域名",
        "description": "创建防护域名",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。 通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Content-Type",
            "minLength": 1,
            "maxLength": 128,
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,对应华为云控制台用户名->我的凭证->项目列表->项目ID",
            "required": true,
            "type": "string"
          },
          {
            "name": "HostBody",
            "in": "body",
            "description": "域名信息",
            "required": true,
            "schema": {
              "$ref": "#/definitions/HostBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HostInfo",
            "schema": {
              "$ref": "#/definitions/HostInfo"
            },
            "examples": {
              "application/json": {
                "domainId": "81c8xxxxxxxxxxxxxxxx11c9",
                "cname": "29xxxxxxxxxxxx1e.huaweisafedns.cn"
              }
            }
          },
          "400": {
            "description": "Error"
          }
        },
        "x-order": 3
      }
    }
  },
  "definitions": {
    "HostBody": {
      "type": "object",
      "required": [
        "domain_name",
        "vips",
        "real_server_type",
        "real_server",
        "enterprise_project_id"
      ],
      "properties": {
        "domain_name": {
          "type": "string",
          "description": "域名",
          "example": "example.com"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目id,与接入的高防实例所属企业项目保持一致。可在华为云EPS服务中查看企业项目id,default企业项目id为\"0\"。",
          "example": 0
        },
        "vips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "高防实例ip列表。多个高防实例ip必须属于同一企业项目。",
          "example": [
            "1.1.1.1"
          ]
        },
        "real_server_type": {
          "type": "integer",
          "format": "int32",
          "description": "源站类型。 0 - 源站IP, 1 - 源站域名。",
          "example": 0
        },
        "port_http": {
          "type": "array",
          "description": "HTTP端口,与port_https不能同时为空。DDoS高防支持的HTTP端口可在控制台查看。",
          "example": [
            80
          ],
          "items": {
            "type": "integer",
            "format": "int32"
          }
        },
        "port_https": {
          "type": "array",
          "description": "HTTPS端口,与port_http不能同时为空。DDoS高防支持的HTTPS端口可在控制台查看。",
          "example": [
            443
          ],
          "items": {
            "type": "integer",
            "format": "int32"
          }
        },
        "real_server": {
          "type": "string",
          "description": "源站ip/源站域名",
          "example": "1.1.1.1"
        }
      }
    },
    "HostInfo": {
      "type": "object",
      "required": [
        "cname",
        "domainId"
      ],
      "properties": {
        "cname": {
          "type": "string",
          "description": "高防提供的CNAME地址"
        },
        "domainId": {
          "type": "string",
          "description": "域名id"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "aad.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}