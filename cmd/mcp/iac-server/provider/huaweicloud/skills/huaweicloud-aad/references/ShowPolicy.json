{
  "name": "ShowPolicy",
  "summary": "查询策略详情",
  "tags": "DDoS原生高级防护-策略管理",
  "productshort": "AAD",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/cnad/policies/{policy_id}": {
      "get": {
        "tags": [
          "DDoS原生高级防护-策略管理"
        ],
        "summary": "查询策略详情",
        "operationId": "ShowPolicy",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "description": "查询策略详情",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Content-Type",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "policy_id",
            "in": "path",
            "description": "策略id",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 64
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/PolicyDetailResponse"
            },
            "examples": {
              "application/json": {
                "clean_threshold": 120,
                "id": "798d8975-f7cf-490f-b990-747ebaf41248",
                "name": "sadf",
                "package_id": "09b5ae8e-ae05-49ff-80fc-8bdf68c16499",
                "pop_policy": {
                  "block_location": [],
                  "block_protocol": [],
                  "bw_list": {
                    "black_ip_list": [],
                    "white_ip_list": []
                  },
                  "connection_protection": false,
                  "connection_protection_list": [],
                  "fingerprint_count": 0,
                  "if_exist_traffic": false,
                  "pop": "ALL",
                  "port_block_count": 0,
                  "watermark_count": 0
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "definitions": {
    "PolicyDetailResponse": {
      "type": "object",
      "required": [
        "id",
        "package_id",
        "name",
        "clean_threshold",
        "pop_policy"
      ],
      "description": "策略详情",
      "properties": {
        "id": {
          "type": "string",
          "description": "策略id",
          "example": "0c613ff9-2b63-4aa2-9333-e03541fe0d9a",
          "minLength": 32,
          "maxLength": 64
        },
        "package_id": {
          "type": "string",
          "description": "实例id",
          "example": "0c613ff9-2b63-4aa2-9333-e03541fe0d9a",
          "minLength": 32,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "策略名",
          "example": "name",
          "minLength": 0,
          "maxLength": 255
        },
        "clean_threshold": {
          "type": "integer",
          "format": "int32",
          "description": "清洗阈值",
          "minimum": 100,
          "maximum": 1000,
          "example": 100
        },
        "pop_policy": {
          "$ref": "#/definitions/PopPolicy"
        }
      },
      "example": {
        "clean_threshold": 120,
        "id": "3b31704b-9d9d-46a4-9081-fe2e6cb2737a",
        "name": "dsfa",
        "package_id": "09b5ae8e-ae05-49ff-80fc-8bdf68c16499",
        "pop_policy": {
          "block_location": [],
          "block_protocol": [
            "UDP"
          ],
          "bw_list": {
            "black_ip_list": [
              "12.3.3.3"
            ],
            "white_ip_list": []
          },
          "connection_protection": false,
          "connection_protection_list": [],
          "fingerprint_count": 1,
          "if_exist_traffic": false,
          "pop": "ALL",
          "port_block_count": 2,
          "watermark_count": 1
        }
      }
    },
    "PopPolicy": {
      "type": "object",
      "required": [
        "block_location",
        "block_protocol",
        "bw_list",
        "connection_protection",
        "connection_protection_list",
        "fingerprint_count",
        "port_block_count",
        "watermark_count",
        "if_exist_traffic",
        "pop"
      ],
      "description": "策略阈值详情",
      "properties": {
        "block_location": {
          "type": "array",
          "minItems": 0,
          "maxItems": 255,
          "description": "位置封禁列表",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "block_protocol": {
          "type": "array",
          "minItems": 0,
          "maxItems": 255,
          "description": "协议封禁列表",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "bw_list": {
          "$ref": "#/definitions/Bw"
        },
        "connection_protection": {
          "type": "boolean",
          "description": "是否开启连接防护",
          "example": false
        },
        "connection_protection_list": {
          "type": "array",
          "minItems": 0,
          "maxItems": 255,
          "description": "连接防护列表",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "fingerprint_count": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 255,
          "description": "指纹数"
        },
        "port_block_count": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 255,
          "description": "端口封禁数"
        },
        "watermark_count": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 255,
          "description": "水印数"
        },
        "if_exist_traffic": {
          "type": "boolean",
          "description": "是否存在流量",
          "example": false
        },
        "pop": {
          "type": "string",
          "enum": [
            "ALL"
          ],
          "description": "固定值ALL"
        }
      },
      "example": {
        "block_location": [],
        "block_protocol": [
          "UDP"
        ],
        "bw_list": {
          "black_ip_list": [
            "12.3.3.3"
          ],
          "white_ip_list": []
        },
        "connection_protection": false,
        "connection_protection_list": [],
        "fingerprint_count": 1,
        "if_exist_traffic": false,
        "pop": "ALL",
        "port_block_count": 2,
        "watermark_count": 1
      }
    },
    "Bw": {
      "type": "object",
      "required": [
        "black_ip_list",
        "white_ip_list"
      ],
      "description": "黑白名单详情",
      "properties": {
        "black_ip_list": {
          "type": "array",
          "minItems": 0,
          "maxItems": 255,
          "description": "黑名单列表",
          "items": {
            "type": "string",
            "minLength": 7,
            "maxLength": 128
          }
        },
        "white_ip_list": {
          "type": "array",
          "minItems": 0,
          "maxItems": 255,
          "description": "白名单列表",
          "items": {
            "type": "string",
            "minLength": 7,
            "maxLength": 128
          }
        }
      },
      "example": {
        "black_ip_list": [
          "12.3.3.3"
        ],
        "white_ip_list": [
          "12.3.3.4"
        ]
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "aad.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}