{
  "name": "ListPeak",
  "summary": "查询流量峰值、攻击计数",
  "tags": "DDoS高防-概览",
  "productshort": "AAD",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/aad/instances/{instance_id}/{ip}/ddos-statistics": {
      "get": {
        "tags": [
          "DDoS高防-概览"
        ],
        "summary": "查询流量峰值、攻击计数",
        "description": "查询流量峰值、攻击计数",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ListPeak",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "token",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Content-Type",
            "minLength": 1,
            "maxLength": 128,
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8",
            "x-example": "application/json;charset=utf8"
          },
          {
            "name": "instance_id",
            "description": "实例Id",
            "minLength": 16,
            "maxLength": 64,
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "ip",
            "description": "单个 IP",
            "minLength": 1,
            "maxLength": 45,
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "start_time",
            "description": "开始时间,毫秒时间戳",
            "in": "query",
            "type": "string",
            "required": true
          },
          {
            "name": "end_time",
            "description": "结束时间,毫秒时间戳",
            "in": "query",
            "type": "string",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "攻击流量峰值、攻击峰值时间、入流量峰值、攻击次数",
            "schema": {
              "$ref": "#/definitions/PeakResponse"
            },
            "examples": {
              "application/json": {
                "attack_kbps_peak": 200000000,
                "ddos_count": 24691,
                "in_kbps_peak": 0,
                "timestamp": 1671415200000,
                "vip": "100.10.10.10"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "PeakResponse": {
      "properties": {
        "attack_kbps_peak": {
          "description": "攻击峰值",
          "minimum": 0,
          "maximum": 100000000,
          "type": "number"
        },
        "in_kbps_peak": {
          "description": "流量峰值",
          "minimum": 0,
          "maximum": 100000000,
          "type": "number"
        },
        "ddos_count": {
          "description": "攻击次数",
          "minimum": 0,
          "maximum": 100000000,
          "type": "number"
        },
        "timestamp": {
          "description": "攻击峰值发生时间点",
          "minimum": 0,
          "maximum": 4803811200000,
          "type": "number"
        },
        "vip": {
          "type": "string",
          "description": "高防IP"
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "aad.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
