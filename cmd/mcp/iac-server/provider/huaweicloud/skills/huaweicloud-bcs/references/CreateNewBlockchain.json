{
  "name": "CreateNewBlockchain",
  "summary": "创建服务实例",
  "tags": "BCS管理",
  "productshort": "BCS",
  "region_id": "ap-southeast-4",
  "paths": {
    "/v2/{project_id}/blockchains": {
      "post": {
        "x-secnario": "hws",
        "x-api-type": "open",
        "tags": [
          "BCS管理"
        ],
        "summary": "创建服务实例",
        "description": "创建BCS服务实例,只支持按需创建",
        "operationId": "CreateNewBlockchain",
        "x-order": 1,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "从IAM服务获取的用户Token",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户从IAM申请到的项目ID,一般为32位字符串",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "CreateNewBlockchainRequestBody",
            "description": "requestBody",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "examples": {
              "application/json": {
                "blockchain_id": "12691561-a50d-5207-6041-7346c90d4499",
                "blockchain_name": "bcs-api",
                "operation_id": "BCSSVC01-03-1617158790255323683"
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateBlockchainRes"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "BCS.4006005",
                "error_msg": "keyType error, keyType: blok not supported"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": {
                "error_code": "BCS.4010401",
                "error_msg": "Incorrect token or token resolution failed"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error_code": "BCS.4030403",
                "error_msg": "No permissions to request this method"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "examples": {
              "application/json": {
                "error_code": "BCS.4040404",
                "error_msg": "Not Found:the url is not found"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "InternalServerError",
            "examples": {
              "application/json": {
                "error_code": "BCS.5000500",
                "error_msg": "Internal Server Error"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "CouchDb": {
      "type": "object",
      "description": "couchDB信息",
      "required": [
        "user_name",
        "password"
      ],
      "properties": {
        "user_name": {
          "type": "string",
          "description": "couchDB用户名"
        },
        "password": {
          "type": "string",
          "description": "couchDB密码"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误"
    },
    "ChannelInfoV2": {
      "type": "object",
      "required": [
        "name",
        "org_names"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "通道名"
        },
        "org_names": {
          "type": "array",
          "description": "通道中组织名",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "description": "通道描述"
        }
      }
    },
    "InvitorInfos": {
      "type": "object",
      "description": "邀请方信息",
      "required": [
        "tenant_id",
        "project_id",
        "blockchain_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "description": "邀请方租户ID"
        },
        "project_id": {
          "type": "string",
          "description": "邀请方项目ID"
        },
        "blockchain_id": {
          "type": "string",
          "description": "邀请方BCS服务实例ID"
        }
      }
    },
    "OrgPeer": {
      "type": "object",
      "required": [
        "name",
        "node_count"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "组织名称"
        },
        "node_count": {
          "type": "integer",
          "format": "int64",
          "description": "组织节点数"
        }
      }
    },
    "TurboInfo": {
      "type": "object",
      "description": "极速文件存储卷信息",
      "required": [
        "share_type",
        "type",
        "available_zone",
        "resource_spec_code"
      ],
      "properties": {
        "share_type": {
          "type": "string",
          "description": "共享方式,固定值为“STANDARD”"
        },
        "type": {
          "type": "string",
          "description": "类型,固定值为“efs-ha”"
        },
        "available_zone": {
          "type": "string",
          "description": "可用区,可填空字符串(\"\")。"
        },
        "resource_spec_code": {
          "type": "string",
          "description": "规格,固定值为“sfs.turbo.standard”"
        }
      }
    },
    "CreateBlockchainRes": {
      "type": "object",
      "properties": {
        "blockchain_id": {
          "type": "string",
          "description": "服务实例ID"
        },
        "blockchain_name": {
          "type": "string",
          "description": "服务实例名"
        },
        "operation_id": {
          "type": "string",
          "description": "操作ID"
        }
      }
    },
    "CCEClusterInfo": {
      "description": "使用已有CCE集群信息,说明:Fabric1.4版本服务仅支持1.15及以下版本集群",
      "properties": {
        "cluster_id": {
          "type": "string",
          "description": "集群ID"
        },
        "cluster_name": {
          "type": "string",
          "description": "集群名称"
        },
        "cluster_platform_type": {
          "type": "string",
          "description": "集群CPU架构类型:X86(VirtualMachine),ARM(ARM64)"
        }
      },
      "required": [
        "cluster_id",
        "cluster_name",
        "cluster_platform_type"
      ]
    },
    "CreateRequestBody": {
      "type": "object",
      "example": {
        "name": "bcs-test",
        "fabric_version": "2.2",
        "blockchain_type": "union",
        "consensus": "etcdraft",
        "version_type": 4,
        "sign_algorithm": "ECDSA",
        "enterprise_project_id": "0",
        "volume_type": "nfs",
        "evs_disk_type": "SATA",
        "org_disk_size": 100,
        "database_type": "goleveldb",
        "resource_password": "xxx",
        "orderer_node_number": 3,
        "use_eip": true,
        "bandwidth_size": 5,
        "cluster_type": "cce",
        "create_new_cluster": false,
        "cce_cluster_info": {
          "cluster_id": "5adc2ce2-9712-11ea-9535-0255ac100b0d",
          "cluster_name": "byl-1-15",
          "cluster_platform_type": "ARM64"
        },
        "cce_create_info": {
          "node_num": 1,
          "node_flavor": "Si1.xlarge.4.linux",
          "cce_flavor": "cce.s1.small",
          "init_node_pwd": "JDYkUzdOOUR0JEdyajFQV0tSWXNQRjZBZlhiSE5MVmpWV204V3M5alFMUXl4Z3dtOVNKb25xR0lIZWZaNUFReDVWeHNJa3gvb3JML2d1WjZyazNLQmNWczBpWVVFR2gw",
          "az": "cn-north-7a",
          "cluster_platform_type": "ARM64"
        },
        "ief_deploy_mode": 0,
        "ief_nodes_info": [
          {
            "status": "ACTIVE",
            "public_ip_address": "192.168.1.95",
            "id": "5700372e-49ef-4f4c-b433-11d95ad7acea"
          },
          {
            "status": "ACTIVE",
            "public_ip_address": "192.168.1.213",
            "id": "2455e71a-d806-4827-9cf4-81e1b3764681"
          }
        ],
        "peer_orgs": [
          {
            "name": "organization",
            "node_count": 2
          }
        ],
        "channels": [
          {
            "name": "channel",
            "org_names": [
              "organization"
            ],
            "description": ""
          }
        ],
        "block_info": {
          "batch_timeout": 2,
          "max_message_count": 500,
          "preferred_maxbytes": 2
        },
        "turbo_info": {
          "share_type": "STANDARD",
          "type": "efs-ha",
          "available_zone": "cn-north-7a",
          "resource_spec_code": "sfs.turbo.standard"
        }
      },
      "required": [
        "name",
        "enterprise_project_id",
        "resource_password",
        "create_new_cluster",
        "version_type",
        "cluster_type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "区块链服务名称,支持英文,数字,中文字符和中划线(-),不能以中划线(-)开头,长度4-24个字符。"
        },
        "version_type": {
          "type": "integer",
          "format": "int64",
          "description": "BCS服务版本类型,可选:。被邀请方创建时,和邀请方保持一致。",
          "x-isonline": true
        },
        "fabric_version": {
          "type": "string",
          "description": "Fabric版本,当前邀请方以及私有链的创建仅可选:2.2 ;被邀请方创建时,和邀请方保持一致,1.4版本服务仅支持1.15及以下版本集群. 默认值为2.2."
        },
        "blockchain_type": {
          "type": "string",
          "description": "区块链类型,默认私有链,可选:联盟链(union),私有链(private)。被邀请方创建时,和邀请方保持一致。"
        },
        "consensus": {
          "type": "string",
          "description": "BCS服务的共识策略,Fabric1.4版本可选:测试策略(solo)、快速拜占庭容错算法(SFLIC);Fabric2.2版本可选:raft共识算法(etcdraft)、快速拜占庭容错算法(SFLIC)。被邀请方创建时,和邀请方保持一致。"
        },
        "sign_algorithm": {
          "type": "string",
          "description": "BCS服务安全机制,可选:ECDSA(ECDSA),国密算法(sm2)"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "BCS服务所属企业项目ID",
          "x-isonline": true
        },
        "volume_type": {
          "type": "string",
          "description": "CCE集群存储卷类型,根据实际环境可选:云硬盘存储卷(evs),文件存储卷(nfs), 极速文件存储卷(efs)"
        },
        "evs_disk_type": {
          "type": "string",
          "description": "云硬盘存储卷类型,volume_type选择evs时必填,可选:普通I/O(SATA),高I/O(SAS),超高I/O(SSD)"
        },
        "org_disk_size": {
          "type": "integer",
          "format": "int64",
          "description": "节点组织存储容量,"
        },
        "database_type": {
          "type": "string",
          "description": "BCS服务数据库类型,包括文件数据库(goleveldb),NoSQL(couchdb),选择couchdb需要填写couchdb_info字段中的信息"
        },
        "resource_password": {
          "type": "string",
          "description": "BCS服务资源、区块链管理密码"
        },
        "orderer_node_number": {
          "type": "integer",
          "format": "int64",
          "description": "共识组织节点数,被邀请方创实例时可不填。购买fabric2.2服务时必填,若共识策略为Raft(CFT),节点数为3;若共识策略为快速拜占庭容错共识算法(FBFT),节点数为4。"
        },
        "use_eip": {
          "type": "boolean",
          "description": "是否使用集群节点弹性IP"
        },
        "bandwidth_size": {
          "type": "integer",
          "format": "int64",
          "description": "弹性IP带宽"
        },
        "cluster_type": {
          "type": "string",
          "description": "集群类型,可选:CCE集群 。"
        },
        "create_new_cluster": {
          "type": "boolean",
          "description": "是否创建新集群,使用已有集群需要填写cce_cluster_info字段中的信息,创建新集群需要填写cce_create_info字段中的信息"
        },
        "cce_cluster_info": {
          "$ref": "#/definitions/CCEClusterInfo"
        },
        "cce_create_info": {
          "$ref": "#/definitions/CCECreateInfo"
        },
        "ief_deploy_mode": {
          "type": "integer",
          "format": "int64",
          "description": "IEF集群部署方式,随机部署(0),组织节点绑定(1)。组织节点绑定模式时,peer_orgs 参数必填。组织名和IEF节点名必须一致。",
          "x-isonline": true
        },
        "ief_nodes_info": {
          "type": "array",
          "description": "IEF集群节点列表,使用边缘集群模式部署时必填。",
          "x-isonline": true,
          "items": {
            "$ref": "#/definitions/IEFNode"
          }
        },
        "peer_orgs": {
          "type": "array",
          "description": "节点组织列表。节点绑定模式中,组织名和IEF节点名必须一致。边缘集群模式时此字段必填。",
          "items": {
            "$ref": "#/definitions/OrgPeer"
          }
        },
        "channels": {
          "type": "array",
          "description": "通道列表",
          "items": {
            "$ref": "#/definitions/ChannelInfoV2"
          }
        },
        "couchdb_info": {
          "$ref": "#/definitions/CouchDb"
        },
        "turbo_info": {
          "$ref": "#/definitions/TurboInfo"
        },
        "block_info": {
          "type": "object",
          "description": "区块生成配置信息",
          "properties": {
            "batch_timeout": {
              "type": "integer",
              "format": "int64",
              "description": "区块产生时间(单位:秒),默认2秒"
            },
            "max_message_count": {
              "type": "integer",
              "format": "int64",
              "description": "区块包含交易数量,默认500"
            },
            "preferred_maxbytes": {
              "type": "integer",
              "format": "int64",
              "description": "区块容量(单位:MB),默认2MB"
            }
          }
        },
        "kafka_create_info": {
          "$ref": "#/definitions/KafkaCreateInfo"
        },
        "tc3_need": {
          "type": "boolean",
          "description": "是否添加可信计算平台",
          "x-isonline": true
        },
        "restful_api_support": {
          "type": "boolean",
          "description": "是否添加restful API支持",
          "x-isonline": true
        },
        "is_invitee": {
          "type": "boolean",
          "description": "是否是创建被邀请方BCS服务实例,创建被邀请方实例需要同时填写invitor_infos字段中的信息"
        },
        "invitor_infos": {
          "$ref": "#/definitions/InvitorInfos"
        }
      }
    },
    "CCECreateInfo": {
      "type": "object",
      "description": "创建新集群信息",
      "required": [
        "node_num",
        "node_flavor",
        "cce_flavor",
        "init_node_pwd",
        "az",
        "cluster_platform_type"
      ],
      "properties": {
        "node_num": {
          "type": "integer",
          "format": "int64",
          "description": "集群节点数"
        },
        "node_flavor": {
          "type": "string",
          "format": "int64",
          "description": "集群节点规格ID(支持的规格配置最小为4u8g)"
        },
        "cce_flavor": {
          "type": "string",
          "format": "int64",
          "description": "CCE集群规格"
        },
        "init_node_pwd": {
          "type": "string",
          "format": "int64",
          "description": "节点初始密码"
        },
        "az": {
          "type": "string",
          "format": "int64",
          "description": "可用区"
        },
        "cluster_platform_type": {
          "type": "string",
          "format": "int64",
          "description": "集群CPU架构类型:X86(VirtualMachine),ARM(ARM64)"
        }
      }
    },
    "IEFNode": {
      "type": "object",
      "required": [
        "id",
        "status",
        "public_ip_address"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "节点ID(注意:应填写IEF节点的ID信息)"
        },
        "status": {
          "type": "string",
          "description": "节点状态:\"ACTIVE\""
        },
        "public_ip_address": {
          "type": "string",
          "description": "节点公有IP(弹性IP)"
        }
      }
    },
    "KafkaCreateInfo": {
      "type": "object",
      "description": "kafka实例创建信息",
      "required": [
        "spec",
        "storage",
        "az"
      ],
      "properties": {
        "spec": {
          "type": "string",
          "description": "kafka实例规格,可选:mini:基准带宽100MB/s,small:基准带宽300MB/s,middle:基准带宽600MB/s,high:基准带宽1200MB/s"
        },
        "storage": {
          "type": "integer",
          "format": "int64",
          "description": "存储空间(单位:GB),至多9000,mini版至少300,small至少1200,middle至少2400,high至少4800"
        },
        "az": {
          "type": "string",
          "description": "kafka实例可用区"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "bcs.ap-southeast-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}