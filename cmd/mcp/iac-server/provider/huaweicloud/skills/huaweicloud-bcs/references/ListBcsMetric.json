{
  "name": "ListBcsMetric",
  "summary": "查询服务实例监控数据",
  "tags": "BCS监控",
  "productshort": "BCS",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/{project_id}/blockchains/{blockchain_id}/metric/list": {
      "post": {
        "x-secnario": "hws",
        "x-api-type": "open",
        "tags": [
          "BCS监控"
        ],
        "summary": "查询服务实例监控数据",
        "description": "该接口用于查询BCS服务的监控数据,可以指定相应的指标名称。",
        "operationId": "ListBcsMetric",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取。",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户从IAM申请到的projectid,一般为32位字符串。",
            "required": true,
            "type": "string"
          },
          {
            "name": "blockchain_id",
            "in": "path",
            "description": "区块链服务id",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "ListBcsMetricRequestBody",
            "description": "BCS服务监控数据查询请求结构。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListBcsMetricRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "examples": {
              "application/json": {
                "metrics": [
                  {
                    "metric": {
                      "namespace": "abc",
                      "metricName": "def",
                      "dimensions": [
                        {
                          "name": "ghi",
                          "value": "lmn"
                        }
                      ]
                    },
                    "dataPoints": [
                      {
                        "timestamp": 1467892800000,
                        "unit": "Percent",
                        "statistics": [
                          {
                            "statistic": "maximum",
                            "value": "23"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/MetricQueryItemResult"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "BCS.4001108",
                "error_msg": "metric names is wrong"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": {
                "error_code": "BCS.4010401",
                "error_msg": "Incorrect token or token resolution failed"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error_code": "BCS.4030403",
                "error_msg": "No permissions to request this method"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "examples": {
              "application/json": {
                "error_code": "BCS.4040404",
                "error_msg": "Not Found:the url is not found"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "InternalServerError",
            "examples": {
              "application/json": {
                "error_code": "BCS.5000500",
                "error_msg": "Internal Server Error"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "StatisticValue": {
      "type": "object",
      "properties": {
        "statistic": {
          "type": "string",
          "description": "统计方式。"
        },
        "value": {
          "type": "number",
          "format": "double",
          "description": "统计结果。"
        }
      },
      "description": "统计结果"
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误"
    },
    "MetricDemision": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "description": "命名空间"
        },
        "metricName": {
          "type": "string",
          "description": "指标名称"
        },
        "dimensions": {
          "type": "array",
          "description": "维度列表",
          "items": {
            "$ref": "#/definitions/Dimension"
          }
        }
      },
      "description": "指标描述信息"
    },
    "ListBcsMetricRequestBody": {
      "properties": {
        "metric_names": {
          "type": "array",
          "description": "指标列表 取值范围\ncpuUsage:CPU使用率\ndiskUsedRate:磁盘使用率\nmemUsedRate:物理内存使用率\nsendBytesRate:上行Bps\nrecvBytesRate:下行Bps\ncpuCoreLimit:CPU内核总量\ncpuCoreUsed:CPU内核占用\ntotalMem:物理内存总量\nfreeMem:可用物理内存\ndiskCapacity:磁盘空间容量\ndiskAvailableCapacity:可用磁盘空间\n默认值:前5项",
          "items": {
            "type": "string"
          }
        }
      },
      "example": {
        "metric_names": [
          "cpuUsage",
          "diskUsedRate"
        ]
      },
      "description": "BCS服务监控数据查询请求结构"
    },
    "MetricDataPoints": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "integer",
          "format": "int64",
          "description": "时间戳。"
        },
        "unit": {
          "type": "string",
          "description": "指标单位。"
        },
        "statistics": {
          "type": "array",
          "description": "统计方式。",
          "items": {
            "$ref": "#/definitions/StatisticValue"
          }
        }
      },
      "description": "查询结果要点"
    },
    "MetricQueryItemResult": {
      "properties": {
        "metrics": {
          "type": "array",
          "description": "指标对象列表。",
          "items": {
            "$ref": "#/definitions/MetricItemResultAPI"
          }
        }
      }
    },
    "MetricItemResultAPI": {
      "properties": {
        "metric": {
          "description": "指标描述信息",
          "$ref": "#/definitions/MetricDemision"
        },
        "dataPoints": {
          "type": "array",
          "description": "监控数据信息",
          "items": {
            "$ref": "#/definitions/MetricDataPoints"
          }
        }
      },
      "description": "监控数据信息"
    },
    "Dimension": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "维度名称。"
        },
        "value": {
          "type": "string",
          "description": "维度取值。"
        }
      },
      "description": "指标维度。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "bcs.cn-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}