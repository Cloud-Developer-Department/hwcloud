{
  "name": "DownloadBlockchainSdkConfig",
  "summary": "下载SDK配置",
  "tags": "BCS管理",
  "productshort": "BCS",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/{project_id}/blockchains/{blockchain_id}/sdk-cfg": {
      "post": {
        "x-secnario": "hws",
        "x-api-type": "open",
        "tags": [
          "BCS管理"
        ],
        "summary": "下载SDK配置",
        "description": "下载指定服务实例SDK配置文件",
        "operationId": "DownloadBlockchainSdkConfig",
        "x-order": 10,
        "produces": [
          "application/octet-stream"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "从IAM服务获取的用户Token",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户从IAM申请到的项目ID,一般为32位字符串",
            "required": true,
            "type": "string"
          },
          {
            "name": "blockchain_id",
            "in": "path",
            "description": "blockchainID",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "DownloadBlockchainSdkConfigRequestBody",
            "description": "requestBody",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CfgRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "schema": {
              "type": "file"
            },
            "examples": {
              "application/octet-stream": {
                "result": "success"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "BCS.4006005",
                "error_msg": "keyType error, keyType: blok not supported"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": {
                "error_code": "BCS.4010401",
                "error_msg": "Incorrect token or token resolution failed"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error_code": "BCS.4030403",
                "error_msg": "No permissions to request this method"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "examples": {
              "application/json": {
                "error_code": "BCS.4040404",
                "error_msg": "Not Found:the url is not found"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "InternalServerError",
            "examples": {
              "application/json": {
                "error_code": "BCS.5000500",
                "error_msg": "Internal Server Error"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误"
    },
    "CfgRequestBody": {
      "type": "object",
      "required": [
        "chaincode_name",
        "cert_path",
        "channel_name",
        "peer_orgs"
      ],
      "properties": {
        "chaincode_name": {
          "type": "string",
          "description": "链代码名称,以小写字母开头,支持小写字母和数字,长度6-25位"
        },
        "cert_path": {
          "type": "string",
          "description": "SDK配置文件存放路径"
        },
        "channel_name": {
          "type": "string",
          "description": "通道名称"
        },
        "peer_orgs": {
          "type": "object",
          "description": "key:组织名,value:该组织下需要下载的peer节点信息,peer节点请按照0,1,2的顺序升序填写",
          "additionalProperties": {
            "type": "array",
            "description": "节点名称+.+节点所在组织域名",
            "items": {
              "type": "string"
            }
          }
        },
        "union_info": {
          "type": "object",
          "description": "key:联盟成员名称,value:该联盟成员peer组织名称hash值数组",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "附加属性"
            }
          }
        },
        "is_multi_chan": {
          "type": "boolean",
          "description": "是否是多通道请求,如此处设成true则必须传入channel_chaincode,chaincode_name和channel_name设为空即可"
        },
        "channel_chaincode": {
          "type": "object",
          "description": "key:通道名称,value:该通道对应的链代码数组",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "附加属性"
            }
          }
        }
      },
      "example": {
        "chaincode_name": "chaincode",
        "cert_path": "/root",
        "channel_name": "channel",
        "peer_orgs": {
          "organization": [
            "peer-328000cb35d8971e0b0388f6182f95eaa4100784-0.peer-328000cb35d8971e0b0388f6182f95eaa4100784.default.svc.cluster.local",
            "peer-328000cb35d8971e0b0388f6182f95eaa4100784-1.peer-328000cb35d8971e0b0388f6182f95eaa4100784.default.svc.cluster.local"
          ]
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "bcs.ap-southeast-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}