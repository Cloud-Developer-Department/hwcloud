{
  "name": "DeleteBlockchain",
  "summary": "删除服务实例",
  "tags": "BCS管理",
  "productshort": "BCS",
  "region_id": "cn-east-2",
  "paths": {
    "/v2/{project_id}/blockchains/{blockchain_id}": {
      "delete": {
        "x-secnario": "hws",
        "x-api-type": "open",
        "tags": [
          "BCS管理"
        ],
        "summary": "删除服务实例",
        "description": "删除bcs实例。包周期实例不支持",
        "operationId": "DeleteBlockchain",
        "x-order": 19,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "租户从IAM申请到的项目ID,一般为32位字符串",
            "required": true,
            "type": "string"
          },
          {
            "name": "blockchain_id",
            "in": "path",
            "description": "bcs 服务id",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "帐号token",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1
          },
          {
            "name": "is_delete_storage",
            "in": "query",
            "description": "是否删除存储,IEF模式下不用填写",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "is_delete_obs",
            "in": "query",
            "description": "是否删除obs,IEF模式下不用填写",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "is_delete_resource",
            "in": "query",
            "description": "是否删除底层CCE资源,IEF模式下不用填写",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "is_delete_ief",
            "in": "query",
            "description": "是否删除底层依赖的IEF边缘节点资源,CCE模式下不用填写,IEF模式下必填",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "is_delete_lightpeer",
            "in": "query",
            "description": "CCE模式下选填:是否删除LightPeer轻节点插件使用的IEF边缘节点资源,若需要删除,则填写对应的IEF编译节点名称,否则无需填写。例如:is_delete_lightpeer=ief_node_name_1,ief_node_name_2",
            "required": false,
            "type": "string"
          },
          {
            "name": "ief_nodes_id",
            "in": "query",
            "description": "IEF模式下选填:若需要删除IEF边缘集群所使用的IEF边缘节点资源,则填写IEF节点的id,否则无需填写。例如:ief_nodes_id=1356f6f0-c448-4ec2-926f-c13b026369d9,0cdacbf9-2002-41e9-8123-2fa13e8d1449",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
