              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": {
                "error_code": "BCS.4010401",
                "error_msg": "Incorrect token or token resolution failed"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error_code": "BCS.4030403",
                "error_msg": "No permissions to request this method"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "examples": {
              "application/json": {
                "error_code": "BCS.4040404",
                "error_msg": "Not Found:the url is not found"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "InternalServerError",
            "examples": {
              "application/json": {
                "error_code": "BCS.5000500",
                "error_msg": "Internal Server Error"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-1": "{\n    \"type\": \"org\",\n    \"entity_name\": \"baas-agent\",\n    \"instance_name\": \"baas-agent-868946786c-sswcn\"\n}\n"
      }
    }
