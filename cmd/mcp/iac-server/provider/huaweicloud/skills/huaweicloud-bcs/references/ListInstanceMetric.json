              "$ref": "#/definitions/ListInstanceMetricRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "examples": {
              "application/json": {
                "metrics": [
                  {
                    "metric": {
                      "namespace": "abc",
                      "metricName": "def",
                      "dimensions": [
                        {
                          "name": "ghi",
                          "value": "lmn"
