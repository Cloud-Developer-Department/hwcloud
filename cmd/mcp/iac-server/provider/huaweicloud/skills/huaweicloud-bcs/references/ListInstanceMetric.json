  "definitions": {
    "StatisticValue": {
      "type": "object",
      "properties": {
        "statistic": {
          "type": "string",
          "description": "统计方式。"
        },
        "value": {
          "type": "number",
          "format": "double",
          "description": "统计结果。"
        }
      },
      "description": "统计结果"
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误"
    },
    "MetricDemision": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "description": "命名空间"
        },
        "metricName": {
          "type": "string",
          "description": "指标名称"
        },
        "dimensions": {
          "type": "array",
          "description": "维度列表",
          "items": {
            "$ref": "#/definitions/Dimension"
          }
        }
      },
      "description": "指标描述信息"
    },
    "MetricDataPoints": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "integer",
          "format": "int64",
          "description": "时间戳。"
        },
        "unit": {
          "type": "string",
          "description": "指标单位。"
        },
        "statistics": {
          "type": "array",
          "description": "统计方式。",
          "items": {
            "$ref": "#/definitions/StatisticValue"
          }
        }
      },
      "description": "查询结果要点"
    },
    "MetricQueryItemResult": {
      "properties": {
        "metrics": {
          "type": "array",
          "description": "指标对象列表。",
          "items": {
            "$ref": "#/definitions/MetricItemResultAPI"
          }
        }
      }
    },
    "MetricItemResultAPI": {
      "properties": {
        "metric": {
          "description": "指标描述信息",
          "$ref": "#/definitions/MetricDemision"
        },
        "dataPoints": {
          "type": "array",
          "description": "监控数据信息",
          "items": {
            "$ref": "#/definitions/MetricDataPoints"
          }
        }
      },
      "description": "监控数据信息"
    },
    "ListInstanceMetricRequestBody": {
      "required": [
        "type",
        "entity_name",
        "instance_name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "实体类型,[可选值如下:\norg(包括代理节点baas-agent、共识节点orderer、记账节点peer),\nplugin(插件)]\n默认为org"
        },
        "entity_name": {
          "type": "string",
          "description": "所属实体的名称,即区块链服务详情页面的“区块链实例”中各节点的名称(代理节点、共识节点、记账节点)"
        },
        "instance_name": {
          "type": "string",
          "description": "具体实例的名称。若当前区块链服务部署在CCE集群上,该名称为各节点对应的负载(pod)名称;若当前区块链服务部署在IEF集群上,可进入“智能边缘平台”服务,进入“边缘应用”->“容器应用”,查询负载名称。"
        }
      },
      "description": "BCS组织实例监控数据详情查询请求结构"
    },
    "Dimension": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "维度名称。"
        },
        "value": {
          "type": "string",
          "description": "维度取值。"
        }
      },
      "description": "指标维度。"
    }
  },
