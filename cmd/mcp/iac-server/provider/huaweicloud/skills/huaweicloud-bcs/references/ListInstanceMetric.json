        "tags": [
          "BCS监控"
        ],
        "summary": "查询BCS组织实例监控数据详情",
        "description": "该接口用于BCS组织实例监控数据详情。",
        "operationId": "ListInstanceMetric",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取。",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户从IAM申请到的projectid,一般为32位字符串。",
            "required": true,
            "type": "string"
          },
          {
            "name": "blockchain_id",
            "in": "path",
            "description": "区块链服务id。",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
