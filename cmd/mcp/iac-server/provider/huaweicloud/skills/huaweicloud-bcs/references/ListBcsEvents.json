{
  "name": "ListBcsEvents",
  "summary": "查询服务实例告警信息",
  "tags": "BCS监控",
  "productshort": "BCS",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/{project_id}/blockchains/{blockchain_id}/events": {
      "post": {
        "x-secnario": "hws",
        "x-api-type": "open",
        "tags": [
          "BCS监控"
        ],
        "summary": "查询服务实例告警信息",
        "description": "该接口用于查询BCS服务的事件、告警数据,可以指定查询时的过滤条件。",
        "operationId": "ListBcsEvents",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取。",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户从IAM申请到的projectid,一般为32位字符串。",
            "required": true,
            "type": "string"
          },
          {
            "name": "blockchain_id",
            "in": "path",
            "description": "区块链服务id",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "ListBcsEventsRequestBody",
            "description": "BCS服务监控数据查询请求结构。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListBcsEventRequestBody"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "查询类型。type=active_alert代表查询活动告警,type=history_alert代表查询历史告警。不传或者传其他值则返回指定查询条件的所有信息。",
            "type": "string",
            "enum": [
              "history_alert",
              "active_alert"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "examples": {
              "application/json": {
                "events": [
                  {
                    "annotations": {
                      "alarm_probableCause_zh_cn": "可能原因",
                      "message": "告警详情",
                      "alarm_fix_suggestion_zh_cn": "修复建议"
                    },
                    "attach_rule": {},
                    "ends_at": 0,
                    "id": "6775161208461480000",
                    "metadata": {
                      "event_type": "alarm",
                      "event_severity": "Major",
                      "resource_type": "blockchain",
                      "event_name": "test",
                      "resource_id": "d2e2deba-797d-872f-516c-9f96870be67e",
                      "resource_provider": "BCS"
                    },
                    "starts_at": 16377362908000,
                    "timeout": 60000
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/MetricQueryItemResult"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "BCS.4001108",
                "error_msg": "metric names is wrong"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": {
                "error_code": "BCS.4010401",
                "error_msg": "Incorrect token or token resolution failed"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error_code": "BCS.4030403",
                "error_msg": "No permissions to request this method"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "examples": {
              "application/json": {
                "error_code": "BCS.4040404",
                "error_msg": "Not Found:the url is not found"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "InternalServerError",
            "examples": {
              "application/json": {
                "error_code": "BCS.5000500",
                "error_msg": "Internal Server Error"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "StatisticValue": {
      "type": "object",
      "properties": {
        "statistic": {
          "type": "string",
          "description": "统计方式。"
        },
        "value": {
          "type": "number",
          "format": "double",
          "description": "统计结果。"
        }
      },
      "description": "统计结果"
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误"
    },
    "EventResultSort": {
      "type": "object",
      "description": "返回列表的排序方式,可以为空",
      "properties": {
        "order_by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "排序字段列表。会根据列表中定义顺序对返回列表最排序"
        },
        "order": {
          "type": "string",
          "description": "排序方式枚举值。asc代表正序,desc代表倒序",
          "enum": [
            "asc",
            "desc"
          ]
        }
      }
    },
    "MetricDemision": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "description": "命名空间"
        },
        "metricName": {
          "type": "string",
          "description": "指标名称"
        },
        "dimensions": {
          "type": "array",
          "description": "维度列表",
          "items": {
            "$ref": "#/definitions/Dimension"
          }
        }
      },
      "description": "指标描述信息"
    },
    "MetricDataPoints": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "integer",
          "format": "int64",
          "description": "时间戳。"
        },
        "unit": {
          "type": "string",
          "description": "指标单位。"
        },
        "statistics": {
          "type": "array",
          "description": "统计方式。",
          "items": {
            "$ref": "#/definitions/StatisticValue"
          }
        }
      },
      "description": "查询结果要点"
    },
    "MetricQueryItemResult": {
      "properties": {
        "metrics": {
          "type": "array",
          "description": "指标对象列表。",
          "items": {
            "$ref": "#/definitions/MetricItemResultAPI"
          }
        }
      }
    },
    "MetricItemResultAPI": {
      "properties": {
        "metric": {
          "description": "指标描述信息",
          "$ref": "#/definitions/MetricDemision"
        },
        "dataPoints": {
          "type": "array",
          "description": "监控数据信息",
          "items": {
            "$ref": "#/definitions/MetricDataPoints"
          }
        }
      },
      "description": "监控数据信息"
    },
    "EventMetadataRelation": {
      "type": "object",
      "description": "事件告警查询条件组合",
      "properties": {
        "key": {
          "type": "string",
          "description": "指定查询字段的key,对应metadata里面的key"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "查询条件中指定key的值"
        },
        "relation": {
          "type": "string",
          "description": "该条件与其他条件的组合方式",
          "enum": [
            "AND",
            "OR",
            "NOT"
          ]
        }
      }
    },
    "Dimension": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "维度名称。"
        },
        "value": {
          "type": "string",
          "description": "维度取值。"
        }
      },
      "description": "指标维度。"
    },
    "ListBcsEventRequestBody": {
      "type": "object",
      "description": "查询和统计事件告警请求体",
      "properties": {
        "time_range": {
          "type": "string",
          "description": "timeRange用于指标查询时间范围,主要用于解决客户端时间和服务端时间不一致情况下,查询最近N分钟的数据。另可用于精确查询某一段时间的数据。"
        },
        "step": {
          "type": "integer",
          "format": "int64",
          "description": "统计步长。毫秒数"
        },
        "search": {
          "type": "string",
          "description": "模糊查询匹配字段,可以为空"
        },
        "metadata_relation": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EventMetadataRelation"
          },
          "description": "查询条件组合,可以为空"
        },
        "sort": {
          "$ref": "#/definitions/EventResultSort"
        }
      },
      "required": [
        "time_range",
        "step"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
