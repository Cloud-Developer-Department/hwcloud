{
  "name": "ListEntityMetric",
  "summary": "查询BCS组织监控数据列表",
  "tags": "BCS监控",
  "productshort": "BCS",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/{project_id}/blockchains/{blockchain_id}/entity/metric/list": {
      "post": {
        "x-secnario": "hws",
        "x-api-type": "open",
        "tags": [
          "BCS监控"
        ],
        "summary": "查询BCS组织监控数据列表",
        "description": "该接口用于查询BCS组织的监控数据列表。",
        "operationId": "ListEntityMetric",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,通过调用IAM服务获取用户Token接口获取。",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户从IAM申请到的projectid,一般为32位字符串。",
            "required": true,
            "type": "string"
          },
          {
            "name": "blockchain_id",
            "in": "path",
            "description": "区块链服务id",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "ListEntityMetricRequestBody",
            "description": "查询组织监控数据列表所需参数。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListEntityMetricRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "examples": {
              "application/json": {
                "metrics": [
                  {
                    "dimensions": [
                      {
                        "name": "cluster",
                        "value": "abc"
                      }
                    ],
                    "values": [
                      {
                        "cpuUsage": "0.175",
                        "diskReadRate": "0",
                        "diskWriteRate": "0",
                        "memUsage": "1.252",
                        "recvBytesRate": "1703.617",
                        "sendBytesRate": "2438.85",
                        "filesystemUsage": "9.344"
                      }
                    ]
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/EntityMetricListResult"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "BCS.4004024",
                "error_msg": "invalid org name input"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": {
                "error_code": "BCS.4010401",
                "error_msg": "Incorrect token or token resolution failed"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error_code": "BCS.4030403",
                "error_msg": "No permissions to request this method"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "examples": {
              "application/json": {
                "error_code": "BCS.4040404",
                "error_msg": "Not Found:the url is not found"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "InternalServerError",
            "examples": {
              "application/json": {
                "error_code": "BCS.5000500",
                "error_msg": "Internal Server Error"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-1": "{\n    \"type\": \"org\",\n    \"entity_name\": \"baas-agent\"\n}\n"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误"
    },
    "EntityMetricList": {
      "type": "object",
      "properties": {
        "dimensions": {
          "type": "array",
          "description": "指标对象列表。",
          "items": {
            "$ref": "#/definitions/Dimension"
          }
        },
        "values": {
          "type": "array",
          "description": "监控数据列表项目。",
          "items": {
            "$ref": "#/definitions/EntityMetricListItem"
          }
        }
      },
      "description": "BCS组织维度监控数据列表结构"
    },
    "EntityMetricListItem": {
      "type": "object",
      "properties": {
        "cpuUsage": {
          "type": "string",
          "description": "cpu使用率"
        },
        "diskReadRate": {
          "type": "string",
          "description": "磁盘读取速率"
        },
        "diskWriteRate": {
          "type": "string",
          "description": "磁盘写入速率"
        },
        "memUsage": {
          "type": "string",
          "description": "物理内存使用率"
        },
        "recvBytesRate": {
          "type": "string",
          "description": "下行BPs"
        },
        "sendBytesRate": {
          "type": "string",
          "description": "上行BPs"
        },
        "filesystemUsage": {
          "type": "string",
          "description": "文件系统使用率"
        }
      },
      "description": "监控数据列表项目"
    },
    "ListEntityMetricRequestBody": {
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "实体类型,[可选值如下:\norg(节点组织),\nplugin(插件)]\n默认为org"
        },
        "entity_name": {
          "type": "string",
          "description": "具体实体的名称"
        }
      },
      "description": "BCS组织监控数据列表查询请求结构"
    },
    "Dimension": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "维度名称。"
        },
        "value": {
          "type": "string",
          "description": "维度取值。"
        }
      },
      "description": "指标维度。"
    },
    "EntityMetricListResult": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "description": "指标对象列表。",
          "items": {
            "$ref": "#/definitions/EntityMetricList"
          }
        }
      },
      "description": "BCS组织监控数据列表查询结果"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "bcs.cn-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}