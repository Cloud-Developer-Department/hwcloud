          "BCS管理"
        ],
        "summary": "下载证书",
        "description": "下载指定服务实例相关证书",
        "operationId": "DownloadBlockchainCert",
        "x-order": 9,
        "produces": [
          "application/octet-stream"
        ],
        "parameters": [
