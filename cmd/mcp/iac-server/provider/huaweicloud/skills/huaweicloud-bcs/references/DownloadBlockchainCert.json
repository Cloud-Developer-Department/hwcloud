            "name": "X-Auth-Token",
            "in": "header",
            "description": "从IAM服务获取的用户Token",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户从IAM申请到的项目ID,一般为32位字符串",
            "required": true,
            "type": "string"
          },
          {
            "name": "blockchain_id",
            "in": "path",
            "description": "blockchainID",
            "required": true,
            "type": "string"
          },
          {
            "name": "org_name",
            "in": "query",
            "description": "order或者peer组织名称",
            "required": true,
            "type": "string"
          },
          {
            "name": "cert_type",
            "in": "query",
            "description": "下载证书类别",
            "required": true,
            "type": "string",
            "enum": [
              "admin",
              "user",
              "ca"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
