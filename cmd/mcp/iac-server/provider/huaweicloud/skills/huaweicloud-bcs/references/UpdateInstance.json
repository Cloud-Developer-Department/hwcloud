{
  "name": "UpdateInstance",
  "summary": "修改服务实例",
  "tags": "BCS管理",
  "productshort": "BCS",
  "region_id": "cn-east-2",
  "paths": {
    "/v2/{project_id}/blockchains/{blockchain_id}": {
      "put": {
        "x-secnario": "hws",
        "x-api-type": "open",
        "tags": [
          "BCS管理"
        ],
        "summary": "修改服务实例",
        "description": "修改实例的节点、组织,目前仅支持添加、删除节点(IEF模式不支持添加、删除节点),添加、删除组织,共4种类型,每次操作只可以操作一种类型。此接口不支持包周期模式; 注意注册IEF节点时,IEF节点名称长度应该为4-24位的字符",
        "operationId": "UpdateInstance",
        "x-order": 4,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "租户从IAM申请到的项目ID,一般为32位字符串",
            "required": true,
            "type": "string"
          },
          {
            "name": "blockchain_id",
            "in": "path",
            "description": "bcs 服务id",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "帐号token",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1
          },
          {
            "in": "body",
            "name": "UpdateInstanceRequestBody",
            "description": "扩容组织节点配置",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateInstanceRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "examples": {
              "application/json": {
                "operation_id": "BCSSVC01-03-1617158790255323683"
              }
            },
            "schema": {
              "$ref": "#/definitions/OpIdRes"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "BCS.4006014",
                "error_msg": "Invalid Parameter quotasType : ecs"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized",
            "examples": {
              "application/json": {
                "error_code": "BCS.4010401",
                "error_msg": "Incorrect token or token resolution failed"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden",
            "examples": {
              "application/json": {
                "error_code": "BCS.4030403",
                "error_msg": "No permissions to request this method"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "examples": {
              "application/json": {
                "error_code": "BCS.4040404",
                "error_msg": "Not Found:the url is not found"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "InternalServerError",
            "examples": {
              "application/json": {
                "error_code": "BCS.5000500",
                "error_msg": "Internal Server Error"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "UpdateInstanceRequestBody": {
      "required": [
        "node_orgs"
      ],
      "properties": {
        "node_orgs": {
          "type": "array",
          "description": "添加节点的组织列表",
          "items": {
            "$ref": "#/definitions/NodeOrgs"
          }
        },
        "publicips": {
          "type": "array",
          "description": "ief添加组织时,ief节点信息。绑定模式的IEF服务,新增组织时,该字段必填",
          "items": {
            "$ref": "#/definitions/IefNodeinfo"
          }
        },
        "is_delete_org": {
          "type": "boolean",
          "description": "是否是删除组织"
        }
      },
      "description": "添加节点和添加组织,添加组织是需要提供pvc_name",
      "example": {
        "node_orgs": [
          {
            "name": "organization",
            "node_count": 1
          }
        ],
        "is_delete_org": false
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误"
    },
    "NodeOrgs": {
      "required": [
        "name",
        "node_count"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "组织名称,IEF节点绑定模式下组织名与IEF节点名称保持一致。支持英文,数字,中文字符和中划线(-), 不能以中划线(-)开头,长度4-24个字符"
        },
        "node_count": {
          "type": "integer",
          "format": "int64",
          "description": "组织目标节点数, 1-2的正整数"
        },
        "pvc_name": {
          "type": "string",
          "description": "pvc名称,添加组织时需要提供pvc_name。CCE模式必填",
          "x-isonline": true
        }
      },
      "description": "节点组织"
    },
    "OpIdRes": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "description": "操作记录id"
        }
      }
    },
    "IefNodeinfo": {
      "required": [
        "status",
        "public_ip_address",
        "id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "description": "节点状态,要使用此节点的话,该状态值必须为ACTIVE"
        },
        "public_ip_address": {
          "type": "string",
          "description": "节点IP,填写节点所在的EIP地址"
        },
        "id": {
          "type": "string",
          "description": "ief节点id值"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "bcs.cn-east-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "put",
  "uri": null
}