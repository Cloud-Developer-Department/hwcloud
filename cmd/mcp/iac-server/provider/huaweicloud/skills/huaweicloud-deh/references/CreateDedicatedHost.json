  "definitions": {
    "ResourceTag": {
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "键。\n长度不超过36个Unicode字符。\n不能为空。\n不能包含以下ASCII非打印字符:“=”,“*”,“<”,“>”,“\\”,“|”,“/”,“,”。",
          "minLength": 1,
          "maxLength": 36
        },
        "value": {
          "type": "string",
          "description": "值。\n长度不超过43个Unicode字符。\n不能包含以下ASCII非打印字符:“=”,“*”,“<”,“>”,“\\”,“|”,“/”,“,”。",
          "minLength": 0,
          "maxLength": 43
        }
      },
      "description": "专属主机标签结构体"
    },
    "ReqAllocateDeh": {
      "required": [
        "availability_zone",
        "host_type",
        "name",
        "quantity"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "专属主机名称。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "[\\一-\\龥a-zA-Z0-9-_.]+$"
        },
        "auto_placement": {
          "type": "string",
          "description": "在创建云服务器时(未指定专属主机ID),是否允许云服务器自动分配在一台可用的专属主机上。\n取值范围:“on”或“off”。\n默认值:“on”。",
          "enum": [
            "off",
            "on"
          ],
          "default": "on"
        },
        "availability_zone": {
          "type": "string",
          "description": "专属主机所属AZ。",
          "minLength": 1,
          "maxLength": 255
        },
        "host_type": {
          "type": "string",
          "description": "专属主机类型。"
        },
        "quantity": {
          "type": "integer",
          "format": "int32",
          "description": "待分配的专属主机数量。"
        },
        "tags": {
          "type": "array",
          "description": "专属主机标签列表。",
          "items": {
            "description": "",
            "$ref": "#/definitions/ResourceTag"
          }
        },
        "extend_param": {
          "description": "专属主机扩展属性。",
          "properties": {
            "charging_mode": {
              "type": "string",
              "description": "专属主机计费模式,不传该参数时默认为postPaid。\n- prePaid:包周期\n- postPaid:按需"
            },
            "period_type": {
              "type": "string",
              "description": "订购周期类型。\n- month:包月\n- year:包年"
            },
            "period_num": {
              "type": "integer",
              "description": "订购周期数,大于0的整数,当charging_mode为prePaid时生效,且该字段必选。"
            },
            "is_auto_pay": {
              "type": "boolean",
              "description": "是否自动支付。"
            },
            "is_auto_renew": {
              "type": "boolean",
              "description": "是否自动续费。"
            },
            "enterprise_project_id": {
              "type": "string",
              "description": "企业项目ID。"
            }
          }
        }
      },
      "description": "创建专属主机消息体。"
    },
    "RespAllocateDeh": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "分配专属主机的Job ID。"
        },
        "order_id": {
          "type": "string",
          "description": "分配包周期专属主机的订单ID。"
        }
      },
      "description": "创建专属主机返回消息体。"
    }
  },
