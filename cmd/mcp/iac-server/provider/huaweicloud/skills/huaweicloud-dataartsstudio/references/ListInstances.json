{
  "name": "ListInstances",
  "summary": "获取任务执行结果列表",
  "tags": "运维管理接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/quality/instances": {
      "get": {
        "tags": [
          "运维管理接口"
        ],
        "x-support-sdk": "Y",
        "summary": "获取任务执行结果列表",
        "description": "获取任务执行结果列表",
        "operationId": "ListInstances",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "只能获取所属project的任务执行结果列表",
            "required": true,
            "type": "string"
          },
          {
            "name": "workspace",
            "in": "header",
            "description": "DataArts Studio工作空间ID",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "token",
            "required": true,
            "type": "string"
          },
          {
            "name": "name",
            "in": "query",
            "description": "规则名称",
            "required": false,
            "type": "string"
          },
          {
            "name": "task_type",
            "in": "query",
            "description": "任务实例类型 QUALITY_TASK:质量作业 CONSISTENCY_TASK:对账作业",
            "required": false,
            "type": "string",
            "enum": [
              "QUALITY_TASK",
              "CONSISTENCY_TASK"
            ]
          },
          {
            "name": "run_status",
            "in": "query",
            "description": "状态, RUNNING:运行中,FAILED:失败,ALARMING:报警,SUCCESS:正常,SUSPENDING:暂停中,UNKNOWN:未定义",
            "required": false,
            "type": "string",
            "enum": [
              "SUCCESS",
              "FAILED",
              "RUNNING",
              "ALARMING"
            ]
          },
          {
            "name": "notify_status",
            "in": "query",
            "description": "通知状态 NOT_TRIGGERED:未触发,SUCCESS:成功,FAILED:失败",
            "required": false,
            "type": "string",
            "enum": [
              "SUCCESS",
              "FAILED",
              "NOT_TRIGGERED"
            ]
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "最近运行时间查询区间的开始时间,13位时间戳(精确到毫秒)",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "最近运行时间查询区间的结束时间,13位时间戳(精确到毫秒)",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量,最大值为100",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页偏移量",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "examples": {
              "response": {
                "count": 2,
                "resources": [
                  {
                    "id": 1012386207306600400,
                    "name": "test-1",
                    "task_id": 1012385458115825700,
                    "task_type": "QUALITY_TASK",
                    "run_status": "SUCCESS",
                    "notify_status": "NOT_TRIGGERED",
                    "start_time": 1661413281000,
                    "end_time": 1661413381000
                  },
                  {
                    "id": 1012386190504218600,
                    "name": "test-0",
                    "task_id": 1012386182149165000,
                    "task_type": "CONSISTENCY_TASK",
                    "run_status": "SUCCESS",
                    "notify_status": "NOT_TRIGGERED",
                    "start_time": 1661413277000,
                    "end_time": 1661413380000
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/InstanceListResponseVO"
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "$ref": "#/definitions/DqcErrorResponseVO"
            }
          },
          "500": {
            "description": "INTERNAL SERVER ERROR",
            "schema": {
              "$ref": "#/definitions/DqcErrorResponseVO"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "InstanceListResponseVO": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "个数"
        },
        "resources": {
          "type": "array",
          "description": "resources",
          "items": {
            "$ref": "#/definitions/InstanceOverviewVo"
          }
        }
      }
    },
    "InstanceOverviewVo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "example": 917924702629044224,
          "description": "id"
        },
        "name": {
          "type": "string",
          "example": "test-1",
          "description": "名称"
        },
        "task_id": {
          "type": "integer",
          "format": "int64",
          "example": 821057399736750081,
          "description": "task id"
        },
        "task_type": {
          "type": "string",
          "example": "QUALITY_TASK",
          "description": "QUALITY_TASK:质量作业,CONSISTENCY_TASK:对账作业"
        },
        "run_status": {
          "type": "string",
          "example": "SUCCESS",
          "description": "RUNNING:运行中,FAILED:失败,ALARMING:报警,SUCCESS:正常"
        },
        "notify_status": {
          "type": "string",
          "example": "SUCCESS",
          "description": "NOT_TRIGGERED:未触发,SUCCESS:成功,FAILED:失败"
        },
        "start_time": {
          "type": "integer",
          "format": "int64",
          "example": 1638891009000,
          "description": "开始时间"
        },
        "end_time": {
          "type": "integer",
          "format": "int64",
          "example": 1638891931000,
          "description": "结束时间"
        }
      }
    },
    "DqcErrorResponseVO": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码,如DQC.0000,请求处理成功"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      }
    }
  },
