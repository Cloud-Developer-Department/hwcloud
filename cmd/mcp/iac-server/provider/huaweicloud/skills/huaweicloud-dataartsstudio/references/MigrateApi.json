{
  "name": "MigrateApi",
  "summary": "批量移动api至新目录",
  "tags": "服务目录管理接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/service/servicecatalogs/apis/batch-move": {
      "post": {
        "tags": [
          "服务目录管理接口"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "dataservice-openapi",
        "summary": "批量移动api至新目录",
        "description": "批量移动api至新目录。",
        "operationId": "MigrateApi",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,使用[Token认证](dataartsstudio_02_0010.xml)时必选。通过调用“获取用户Token”接口获取响应消息头中X-Subject-Token的值。",
            "required": true,
            "type": "string"
          },
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "Dlm-Type",
            "in": "header",
            "description": "数据服务的版本类型,指定SHARED共享版或EXCLUSIVE专享版。",
            "required": false,
            "type": "string",
            "enum": [
              "SHARED",
              "EXCLUSIVE"
            ]
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "消息体的类型(格式),有Body体的情况下必选,没有Body体无需填写。如果请求消息体中含有中文字符,则需要通过charset=utf8指定中文字符集,例如取值为:application/json;charset=utf8。",
            "type": "string",
            "required": true,
            "default": "application/json"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "MigrateApiRequestBody",
            "in": "body",
            "description": "移动目录相关参数。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ApiMoveParaDTO"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Success。"
          },
          "400": {
            "description": "BadRequest。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DLS.1000",
          "minLength": 1,
          "maxLength": 128
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "process failed",
          "minLength": 1,
          "maxLength": 10240
        }
      }
    },
    "ApiMoveParaDTO": {
      "type": "object",
      "properties": {
        "target_pid": {
          "type": "string",
          "description": "父目录编号",
          "example": "8c9850726a1ee050be2b67e43c688870"
        },
        "apis": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "需要移动的目录",
          "example": [
            "fd0beac79418d65e3b3ed24a6e33b24b"
          ]
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
