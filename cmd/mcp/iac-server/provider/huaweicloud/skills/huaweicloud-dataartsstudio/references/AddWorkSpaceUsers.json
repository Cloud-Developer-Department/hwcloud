            "description": "IAM Token",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 4096
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目id",
            "pattern": "^[a-z0-9]{32}$"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "工作空间id",
            "pattern": "^[a-z0-9]{32}$"
          },
          {
            "name": "addUserParams",
            "in": "body",
            "required": true,
