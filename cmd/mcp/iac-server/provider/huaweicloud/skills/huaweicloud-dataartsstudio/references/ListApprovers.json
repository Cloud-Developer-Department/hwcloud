          "enum": [
            "BIZ_METRIC_OWNER",
            "APPROVER",
            "BIZ_METRIC_OWNER_AND_APPROVER"
          ]
        },
        "phone_number": {
          "type": "string",
          "description": "电话号码。"
        },
        "create_by": {
          "type": "string",
          "description": "创建人。"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间,格式遵循RFC3339,精确到秒,UTC时区,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z。"
        },
        "app_name": {
          "type": "string",
          "description": "业务系统名称。"
        },
        "topic_urn": {
          "type": "string",
          "description": "smn主题urn。"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID。"
        }
      }
    },
    "ListApproversResult": {
      "type": "object",
      "description": "审批人分页查询结果。",
      "properties": {
        "data": {
          "type": "object",
          "description": "data,统一的返回结果的最外层数据结构。",
          "properties": {
            "value": {
              "type": "object",
              "description": "value,统一的返回结果的外层数据结构。",
              "properties": {
                "total": {
                  "type": "integer",
                  "format": "int32",
                  "description": "总量。"
                },
                "records": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ApproverVO"
                  },
                  "description": "查询到的审批人对象(ApproverVO)数组。"
                }
              }
            }
          }
        }
      }
    }
