{
  "name": "AuthorizeApiToInstance",
  "summary": "批量授权API(专享版)",
  "tags": "API管理接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/service/apis/{api_id}/instances/{instance_id}/authorize": {
      "post": {
        "tags": [
          "API管理接口"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "dataservice-openapi",
        "summary": "批量授权API(专享版)",
        "description": "APP创建成功后,还不能访问API,如果想要访问某个API,需要将该API授权给APP。API主动授权成功后,在有效期内,APP即可访问该API。  \nAPI授权包含授权和续约两部分功能。  \n- 授权:授权会给予APP在有效期内访问API的权利。\n- 续约:续约会更新授权有效期,仅支持延长有效期,不能减少。",
        "operationId": "AuthorizeApiToInstance",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,使用[Token认证](dataartsstudio_02_0010.xml)时必选。通过调用“获取用户Token”接口获取响应消息头中X-Subject-Token的值。",
            "required": true,
            "type": "string"
          },
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "Dlm-Type",
            "in": "header",
            "description": "数据服务的版本类型,指定SHARED共享版或EXCLUSIVE专享版。",
            "required": false,
            "type": "string",
            "enum": [
              "SHARED",
              "EXCLUSIVE"
            ]
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "消息体的类型(格式),有Body体的情况下必选,没有Body体无需填写。如果请求消息体中含有中文字符,则需要通过charset=utf8指定中文字符集,例如取值为:application/json;charset=utf8。",
            "type": "string",
            "required": true,
            "default": "application/json"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "api_id",
            "in": "path",
            "description": "api编号。",
            "required": true,
            "type": "string"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "集群编号。",
            "required": true,
            "type": "string"
          },
          {
            "name": "AuthorizeApiToInstanceRequestBody",
            "in": "body",
            "description": "授权相关参数。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ApiParaForAuthorizeToInstance"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "操作API成功。"
          },
          "400": {
            "description": "BadRequest。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ApiParaForAuthorizeToInstance": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "description": "截止时间",
          "example": "2021-01-01T10:00:00.000Z"
        },
        "app_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "app编号列表",
