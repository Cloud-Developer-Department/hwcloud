            "908489209a320df61607355c57c82882"
          ]
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DLS.1000",
          "minLength": 1,
          "maxLength": 128
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "process failed",
          "minLength": 1,
          "maxLength": 10240
        }
      }
    }
  },
