{
  "name": "SearchAuthorizeApp",
  "summary": "查询API已授权的APP",
  "tags": "授权管理接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/service/authorize/apis/{api_id}": {
      "get": {
        "tags": [
          "授权管理接口"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "dataservice-openapi",
        "summary": "查询API已授权的APP",
        "description": "查询API已授权的APP。",
        "operationId": "SearchAuthorizeApp",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,使用[Token认证](dataartsstudio_02_0010.xml)时必选。通过调用“获取用户Token”接口获取响应消息头中X-Subject-Token的值。",
            "required": true,
            "type": "string"
          },
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "Dlm-Type",
            "in": "header",
            "description": "数据服务的版本类型,指定SHARED共享版或EXCLUSIVE专享版。",
            "required": false,
            "type": "string",
            "enum": [
              "SHARED",
              "EXCLUSIVE"
            ]
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "消息体的类型(格式),有Body体的情况下必选,没有Body体无需填写。如果请求消息体中含有中文字符,则需要通过charset=utf8指定中文字符集,例如取值为:application/json;charset=utf8。",
            "type": "string",
            "required": true,
            "default": "application/json"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "api_id",
            "in": "path",
            "description": "api编号。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询起始坐标, 即跳过前X条数据。仅支持0或limit的整数倍,不满足则向下取整。",
            "required": false,
            "type": "integer"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询条数, 即查询Y条数据。",
            "required": false,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "查询结果成功,API已授权的APP列表。",
            "schema": {
              "$ref": "#/definitions/ResultForGetAuthApp"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "records": [
                  {
                    "app_id": "908489209a320df61607355c57c82882",
                    "app_name": "app_demo",
                    "api_using_time": 1580452617000,
                    "approval_time": 1578897421000
                  }
                ]
              }
            }
          },
          "400": {
            "description": "BadRequest。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DLS.1000",
          "minLength": 1,
          "maxLength": 128
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "process failed",
          "minLength": 1,
          "maxLength": 10240
        }
      }
    },
    "StaticParam": {
      "type": "object",
      "description": "静态参数",
      "properties": {
        "para_name": {
          "type": "string",
          "description": "静态参数名",
          "example": "number"
        },
        "para_value": {
          "type": "string",
          "description": "静态参数值",
          "example": "999"
        }
      }
    },
    "ResultForGetAuthApp": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "description": "符合条件的APP总数",
          "example": 1
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RecordForGetAuthApp"
          },
          "description": "本次返回的APP列表"
        }
      }
    },
    "RecordForGetAuthApp": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string",
          "description": "应用编号",
          "example": "4bce159a5d8de655d568d0c9b89597d7"
        },
        "app_name": {
          "type": "string",
          "description": "应用名称",
          "example": "app_demo"
        },
        "instance_id": {
          "type": "string",
          "description": "集群实例id",
          "example": "APIG"
        },
        "instance_name": {
          "type": "string",
          "description": "集群实例名称",
          "example": "APIG"
        },
        "api_using_time": {
          "type": "integer",
          "format": "int64",
          "description": "使用截止时间",
          "example": 1580452617000
        },
        "approval_time": {
          "type": "integer",
          "format": "int64",
          "description": "授权时间",
          "example": 1578897421000
        },
        "relationship_type": {
          "type": "string",
          "description": "绑定关系",
          "enum": [
            "LINK_WAITING_CHECK",
            "LINKED",
            "OFFLINE_WAITING_CHECK",
            "RENEW_WAITING_CHECK"
          ],
          "example": "LINKED"
        },
        "static_params": {
          "type": "array",
          "description": "静态参数列表",
          "items": {
            "$ref": "#/definitions/StaticParam"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dayu.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
