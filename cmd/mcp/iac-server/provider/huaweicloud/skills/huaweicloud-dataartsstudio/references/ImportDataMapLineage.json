            }
          },
          "404": {
            "description": "Not Found。",
            "schema": {
              "$ref": "#/definitions/DlgErrorResponseVO"
            }
          },
          "500": {
            "description": "InternalServerError。",
            "schema": {
              "$ref": "#/definitions/DlgErrorResponseVO"
            }
          }
        },
        "deprecated": false
      }
