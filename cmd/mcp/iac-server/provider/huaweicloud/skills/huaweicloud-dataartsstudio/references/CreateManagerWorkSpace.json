            "maxLength": 4096
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目id",
            "pattern": "^[a-z0-9]{32}$"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "DataArtsStudio实例id",
            "pattern": "^[a-z0-9\\\\-]{32,36}$"
          },
          {
            "name": "createWorkspaceParams",
            "in": "body",
            "required": true,
            "description": "创建工作空间信息body",
            "schema": {
              "$ref": "#/definitions/CreateWorkspaceParams"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success,创建工作空间成功"
          },
          "400": {
            "$ref": "#/definitions/DayuException"
          },
          "500": {
            "$ref": "#/definitions/DayuException"
          }
        }
      }
    }
  },
