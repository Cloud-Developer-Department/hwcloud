  "definitions": {
    "ListRelationsResult": {
      "type": "object",
      "description": "查询关系,查询结果。",
      "properties": {
        "data": {
          "type": "object",
          "description": "data,统一的返回结果的最外层数据结构。",
          "properties": {
            "value": {
              "type": "object",
              "description": "value,统一的返回结果的外层数据结构。",
              "properties": {
                "total": {
                  "type": "integer",
                  "format": "int32",
                  "description": "总量。"
                },
                "records": {
                  "type": "array",
                  "description": "RelationVO信息。",
                  "items": {
                    "$ref": "#/definitions/RelationVO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "RelationType": {
      "type": "string",
      "description": "关系类型,只读。\n枚举值:\n  - ONE: 表示每条子(父)逻辑实体数据在父(子)逻辑实体中有且只有一条数据与之对应。\n  - ZERO_OR_ONE: 表示每条子(父)逻辑实体数据在父(子)逻辑实体中最多有一条数据与之对应。\n  - ZERO_OR_N: 表示每条子(父)逻辑实体数据在父(子)逻辑实体中可能有多条数据与之对应。\n  - ONE_OR_N: 表示每条子(父)逻辑实体数据在父(子)逻辑实体中至少有一条数据与之对应。",
      "readOnly": true,
      "enum": [
        "ONE",
        "ZERO_OR_ONE",
        "ZERO_OR_N",
        "ONE_OR_N"
      ]
    },
    "RelationVO": {
      "type": "object",
      "required": [
