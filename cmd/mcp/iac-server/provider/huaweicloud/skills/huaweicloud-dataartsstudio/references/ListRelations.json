  "version": "2.0",
  "parameters": {
    "limitParam": {
      "name": "limit",
      "in": "query",
      "description": "每页查询条数,即查询Y条数据。默认值50,取值范围[1,100]。",
      "required": false,
      "type": "integer",
      "format": "int32",
      "default": 50,
      "maximum": 100
    },
    "tenantIdParam": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
      "required": true,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "offsetParam": {
      "name": "offset",
      "in": "query",
      "description": "查询起始坐标,即跳过X条数据,仅支持0或limit的整数倍,不满足则向下取整,默认值0。",
      "required": false,
      "type": "integer",
      "format": "int32",
      "default": 0
    },
    "createByParam": {
      "name": "create_by",
      "in": "query",
      "description": "按创建者查询。",
      "required": false,
      "type": "string"
    },
    "nameParam": {
      "name": "name",
      "in": "query",
      "description": "按名称或编码模糊查询。",
      "required": false,
      "type": "string"
    },
    "workspaceParam": {
      "name": "workspace",
      "in": "header",
