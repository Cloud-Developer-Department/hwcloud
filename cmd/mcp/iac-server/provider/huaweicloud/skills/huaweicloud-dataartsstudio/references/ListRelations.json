      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "编码,ID字符串。"
        },
        "source_table_id": {
          "type": "string",
          "description": "源表ID,ID字符串。"
        },
        "target_table_id": {
          "type": "string",
