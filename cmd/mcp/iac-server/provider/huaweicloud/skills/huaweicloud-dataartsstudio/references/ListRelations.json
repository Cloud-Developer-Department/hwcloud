      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "tokenParam": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "IAM Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)\n使用Token认证时必选。",
      "required": true,
      "type": "string",
      "minLength": 0,
      "maxLength": 4096
    },
    "contextTypeParam": {
      "name": "Content-Type",
      "in": "header",
      "required": false,
      "description": "默认值:application/json;charset=UTF-8\n可选,有Body体的情况下必选,没有Body体则无需填写和校验。",
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "endTimeParam": {
      "name": "end_time",
      "in": "query",
      "description": "时间过滤右边界,与begin_time一起使用只支持时间范围过滤,单边过滤无效。格式遵循RFC3339,精确到秒,UTC时区,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z。",
      "required": false,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    }
  },
