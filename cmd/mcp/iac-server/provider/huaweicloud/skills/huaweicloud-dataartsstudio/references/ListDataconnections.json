{
  "name": "ListDataconnections",
  "summary": "查询数据连接列表",
  "tags": "数据连接管理接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/data-connections": {
      "get": {
        "x-is-registered": "Y",
        "tags": [
          "数据连接管理接口"
        ],
        "x-support-sdk": "Y",
        "summary": "查询数据连接列表",
        "description": "查询数据连接列表",
        "operationId": "ListDataconnections",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "IAM Token",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 4096
          },
          {
            "name": "workspace",
            "in": "header",
            "required": true,
            "description": "工作空间id",
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "required": true,
            "type": "string",
            "pattern": "^[a-z0-9]{32}$"
          },
          {
            "name": "name",
            "in": "query",
            "description": "数据连接名称",
            "required": false,
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-]{0,50}$"
          },
          {
            "name": "type",
            "in": "query",
            "description": "数据连接类型,有HIVE,MYSQL,ORALCLE,DWS,HBASE等。",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 32
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "数据条数限制",
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "偏移量",
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          }
        ],
        "responses": {
          "200": {
            "description": "Success,返回数据连接列表",
            "schema": {
              "$ref": "#/definitions/ApigDataSourcesDto"
            }
          },
          "400": {
            "$ref": "#/definitions/DayuException"
          },
          "500": {
            "$ref": "#/definitions/DayuException"
          }
        },
        "x-order": 6
      }
    }
  },
  "definitions": {
    "DayuException": {
      "type": "object",
      "description": "dayu异常返回体",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误信息",
          "maxLength": 1024,
          "minLength": 1
        },
        "error_code": {
          "type": "string",
          "description": "dayu异常码",
          "maxLength": 1024,
          "minLength": 1
        }
      }
    },
    "ApigDataSourceView": {
      "type": "object",
      "description": "数据连接结构体信息",
      "properties": {
        "dw_name": {
          "type": "string",
          "description": "数据连接名称",
          "maxLength": 128,
          "minLength": 1
        },
        "dw_type": {
          "type": "string",
          "description": "数据连接类型",
          "maxLength": 128,
          "minLength": 1
        },
        "create_user": {
          "type": "string",
          "description": "数据连接创建者",
          "maxLength": 128,
          "minLength": 1
        },
        "create_time": {
          "type": "number",
          "description": "数据连接创建时间,时间戳",
          "maximum": 9223372036854775807,
          "minimum": 0
        },
        "agent_id": {
          "type": "string",
          "description": "代理id",
          "maxLength": 128,
          "minLength": 1
        },
        "agent_name": {
          "type": "string",
          "description": "代理名称",
          "maxLength": 128,
          "minLength": 1
        },
        "dw_id": {
          "type": "string",
          "description": "数据连接id",
          "maxLength": 128,
          "minLength": 1
        },
        "qualified_name": {
          "type": "string",
          "description": "数据连接限定名称",
          "maxLength": 128,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "数据连接描述",
          "maxLength": 4096,
          "minLength": 1
        }
      }
    },
    "ApigDataSourcesDto": {
      "type": "object",
      "description": "获取数据连接列表返回信息",
      "properties": {
        "count": {
          "type": "integer",
          "description": "当前分页返回记录数",
          "minimum": 1,
          "maximum": 50
        },
        "max_records": {
          "type": "integer",
          "description": "返回记录总数,一个工作空间最多只能创建50条数据连接",
          "minimum": 50,
          "maximum": 50
        },
        "total_size": {
          "type": "integer",
          "description": "返回当前空间内创建连接的总数",
          "minimum": 0,
          "maximum": 1000
        },
        "data_connection_lists": {
          "type": "array",
          "description": "返回数据连接列表",
          "items": {
            "$ref": "#/definitions/ApigDataSourceView"
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
