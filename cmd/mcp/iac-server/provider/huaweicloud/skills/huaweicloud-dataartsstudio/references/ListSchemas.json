{
  "name": "ListSchemas",
  "summary": "获取schemas",
  "tags": "数据源元数据获取接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/{connection_id}/schemas": {
      "get": {
        "x-is-registered": "Y",
        "tags": [
          "数据源元数据获取接口"
        ],
        "x-support-sdk": "Y",
        "summary": "获取schemas",
        "description": "获取schemas,目前只有DWS和采用postgresql驱动的RDS数据源支持schema,请在调用前确认该数据源是否支持schema字段",
        "operationId": "ListSchemas",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "IAM Token",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 4096
          },
          {
            "name": "workspace",
            "in": "header",
            "required": true,
            "description": "数据所在空间的id值",
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目id",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "connection_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "数据连接id",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "database_name",
            "in": "query",
            "required": true,
            "description": "数据库名称",
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "数据条数限制",
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "偏移量",
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          }
        ],
        "responses": {
          "200": {
            "description": "Success,返回schemas列表",
            "examples": {
              "application/json": {
                "dw_id": "9b18c0ad6ef5404caef4e6cbaccdae6f",
                "database": "postgres",
                "schemas": [
                  {
                    "schema_name": "dm_autotest",
                    "description": ""
                  },
                  {
                    "schema_name": "dbadmin",
                    "description": ""
                  },
                  {
                    "schema_name": "public",
                    "description": "gs_roach_stop_backup"
                  },
                  {
                    "schema_name": "schame",
                    "description": ""
                  },
                  {
                    "schema_name": "utl_file",
                    "description": ""
                  },
                  {
                    "schema_name": "utl_raw",
                    "description": ""
                  }
                ],
                "total_count": 6
              }
            },
            "schema": {
              "$ref": "#/definitions/DataSchemasbody"
            }
          },
          "400": {
            "$ref": "#/definitions/DayuException"
          },
          "500": {
            "$ref": "#/definitions/DayuException"
          }
        }
      }
    }
  },
  "definitions": {
    "SchemasList": {
      "type": "object",
      "description": "schema信息",
      "properties": {
        "schema_name": {
          "type": "string",
          "description": "schema名称",
          "maxLength": 128,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "schema描述",
          "maxLength": 128,
          "minLength": 1
        }
      }
    },
    "DayuException": {
      "type": "object",
      "description": "dayu异常返回体",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误信息",
          "maxLength": 1024,
          "minLength": 1
        },
        "error_code": {
          "type": "string",
          "description": "dayu异常码",
          "maxLength": 1024,
          "minLength": 1
        }
      }
    },
    "DataSchemasbody": {
      "type": "object",
      "description": "schema返回列表信息",
      "properties": {
        "total_count": {
          "type": "integer",
          "description": "当前数据连接schema记录数",
          "maximum": 100,
          "minimum": 0
        },
        "dw_id": {
          "type": "string",
          "description": "数据连接id",
          "maxLength": 128,
          "minLength": 1
        },
        "database": {
          "type": "string",
          "description": "数据库名称",
          "maxLength": 128,
          "minLength": 1
        },
        "schemas": {
          "type": "array",
          "description": "schema列表",
          "items": {
            "$ref": "#/definitions/SchemasList"
          },
          "maxItems": 100,
          "minItems": 0
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dayu.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}