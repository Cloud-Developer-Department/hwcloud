{
  "name": "ImportCatalogs",
  "summary": "导入主题",
  "tags": "导入导出接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/design/catalogs/action": {
      "post": {
        "summary": "导入主题",
        "description": "用于导入主题。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "doc-open",
        "x-request-examples-description-1": "上传主题excel,通过form表单提交,file为具体excel文件。",
        "x-request-examples-url-1": "POST https://{endpoint}/v2/{project_id}/design/catalogs/action?action-id=start-import&skip_exist=false",
        "tags": [
          "导入导出接口"
        ],
        "operationId": "ImportCatalogs",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/tokenParam"
          },
          {
            "$ref": "#/parameters/workspaceParam"
          },
          {
            "$ref": "#/parameters/tenantIdParam"
          },
          {
            "$ref": "#/parameters/tenantXIdParam"
          },
          {
            "$ref": "#/parameters/contextTypeParam"
          },
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "type": "file",
            "description": "导入主题用的excel文件,大小必须小于4MB,且行数小于3000行。"
          },
          {
            "in": "query",
            "name": "action-id",
            "description": "需要执行的动作。\n枚举值:\n  - start-import: 开始导入",
            "required": true,
            "type": "string",
            "items": {
              "type": "string",
              "enum": [
                "start-import"
              ]
            }
          },
          {
            "in": "query",
            "name": "skip-exist",
            "description": "是否需要覆盖更新已有的主题。",
            "type": "boolean",
            "default": false
          }
        ],
        "responses": {
          "200": {
            "description": "Success,返回data数据是导入任务的uuid,可根据该uuid去查询导入结果。",
            "schema": {
              "$ref": "#/definitions/ExportDesignModelsResult"
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "$ref": "#/definitions/DsResponseVO"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/DsResponseVO"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/DsResponseVO"
            }
          }
        },
        "x-order": 1
      }
    }
  },
  "definitions": {
    "ExportDesignModelsResult": {
      "type": "object",
      "description": "Success,导出接口结果。",
      "properties": {
        "data": {
          "type": "object",
          "description": "返回的数据信息。",
          "properties": {
            "uuid": {
              "type": "string",
              "description": "导入接口返回的唯一标识。",
              "example": "fd653968-864b-45f6-9842-2b125d2dbfb8"
            }
          }
        }
      },
      "example": {
        "data": {
          "uuid": "fd653968-864b-45f6-9842-2b125d2dbfb9"
        }
      }
    },
    "DsResponseVO": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "返回的数据信息。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "tenantXIdParam": {
      "name": "X-Project-Id",
      "in": "header",
      "required": false,
      "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。\n\n多project场景采用AK/SK认证的接口请求,则该字段必选。",
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "tenantIdParam": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
      "required": true,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "tokenParam": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "IAM Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)\n使用Token认证时必选。",
      "required": true,
      "type": "string",
      "minLength": 0,
      "maxLength": 4096
    },
    "contextTypeParam": {
      "name": "Content-Type",
      "in": "header",
      "required": false,
      "description": "默认值:application/json;charset=UTF-8\n可选,有Body体的情况下必选,没有Body体则无需填写和校验。",
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "workspaceParam": {
      "name": "workspace",
      "in": "header",
      "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
      "required": true,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    }
  },
  "host": "dayu.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}