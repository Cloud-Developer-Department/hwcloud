        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "dataservice-openapi",
        "summary": "创建服务目录",
        "description": "创建服务目录。 根目录编号为0。",
        "operationId": "CreateServiceCatalog",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,使用[Token认证](dataartsstudio_02_0010.xml)时必选。通过调用“获取用户Token”接口获取响应消息头中X-Subject-Token的值。",
            "required": true,
            "type": "string"
          },
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "Dlm-Type",
            "in": "header",
            "description": "数据服务的版本类型,指定SHARED共享版或EXCLUSIVE专享版。",
            "required": false,
            "type": "string",
            "enum": [
              "SHARED",
              "EXCLUSIVE"
            ]
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "消息体的类型(格式),有Body体的情况下必选,没有Body体无需填写。如果请求消息体中含有中文字符,则需要通过charset=utf8指定中文字符集,例如取值为:application/json;charset=utf8。",
            "type": "string",
            "required": true,
            "default": "application/json"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "CreateServiceCatalogRequestBody",
            "in": "body",
            "description": "目录创建参数。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ApiCatalogCreateParaDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success。",
            "schema": {
              "$ref": "#/definitions/ResultForCatalog"
            },
            "examples": {
              "application/json": {
                "catalog_id": "2847131b4d5a26c5bd4bfd9d8f63f577",
                "name": "demo",
                "description": "this is a demo",
                "create_time": 1578284788000,
                "create_user": "张三",
                "update_time": 1578284788000,
                "update_user": "张三"
              }
            }
          },
          "400": {
            "description": "BadRequest。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
