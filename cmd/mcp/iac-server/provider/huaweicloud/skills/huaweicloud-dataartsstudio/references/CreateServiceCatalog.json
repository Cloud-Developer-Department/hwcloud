{
  "name": "CreateServiceCatalog",
  "summary": "创建服务目录",
  "tags": "服务目录管理接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/service/servicecatalogs": {
