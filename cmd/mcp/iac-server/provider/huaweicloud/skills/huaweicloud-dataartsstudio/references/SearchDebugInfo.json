              "$ref": "#/definitions/ApiPublishMessageDTO"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "publish_messages": [
                  {
                    "id": "343a6d4c0ad108376ebd060c9c33cc33",
                    "api_id": "47046fe7830c1be77cb0dc23bd86afa5",
                    "instance_id": "c2e27497562ed193583378e052248003",
                    "instance_name": "cluster_test_001",
                    "api_status": "API_STATUS_CREATED",
                    "api_debug": "API_DEBUG_WAITING"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "BadRequest。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ApiPublishDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "发布编号",
          "example": "343a6d4c0ad108376ebd060c9c33cc33"
        },
        "api_id": {
          "type": "string",
          "description": "api编号",
          "example": "47046fe7830c1be77cb0dc23bd86afa5"
        },
        "instance_id": {
          "type": "string",
          "description": "集群编号",
          "example": "c2e27497562ed193583378e052248003"
        },
        "instance_name": {
          "type": "string",
          "description": "集群名称",
          "example": "cluster_test_001"
        },
        "api_status": {
          "type": "string",
          "description": "api状态",
          "enum": [
            "API_STATUS_CREATED",
            "API_STATUS_PUBLISH_WAIT_REVIEW",
            "API_STATUS_PUBLISH_REJECT",
            "API_STATUS_PUBLISHED",
            "API_STATUS_WAITING_STOP",
            "API_STATUS_STOPPED",
            "API_STATUS_RECOVER_WAIT_REVIEW",
            "API_STATUS_WAITING_OFFLINE",
            "API_STATUS_OFFLINE"
          ]
        },
        "api_debug": {
          "type": "string",
          "description": "api调试状态",
          "enum": [
            "API_DEBUG_WAITING",
            "API_DEBUG_FAILED",
            "API_DEBUG_SUCCESS"
          ]
        }
      }
    },
    "ApiPublishMessageDTO": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "description": "总数",
          "example": 1
        },
        "publish_messages": {
          "description": "发布信息列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ApiPublishDTO"
          }
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DLS.1000",
          "minLength": 1,
          "maxLength": 128
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "process failed",
          "minLength": 1,
          "maxLength": 10240
        }
      }
    }
  },
