  "definitions": {
    "WorkspaceVO": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "编号,ID字符串。"
        },
        "name": {
          "type": "string",
          "description": "工作区名字。",
          "pattern": "^[\\一-\\龥a-zA-Z\\d_]*$",
          "maxLength": 250
        },
        "description": {
          "type": "string",
          "description": "描述。",
          "maxLength": 600
        },
        "is_physical": {
          "type": "boolean",
          "description": "是否为物理表。",
          "default": true
        },
        "frequent": {
          "type": "boolean",
          "description": "是否为常用。",
          "default": true
        },
        "top": {
          "type": "boolean",
          "description": "分层治理。",
          "default": true
        },
        "level": {
          "$ref": "#/definitions/ModelLevel"
        },
        "dw_type": {
          "$ref": "#/definitions/DwType"
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "readOnly": true,
          "description": "创建时间,只读,格式遵循RFC3339,精确到秒,UTC时区,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z。"
        },
        "update_time": {
          "type": "string",
          "format": "date-time",
          "readOnly": true,
          "description": "更新时间,只读,格式遵循RFC3339,精确到秒,UTC时区,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z。"
        },
        "create_by": {
          "type": "string",
          "description": "创建人。"
        },
        "update_by": {
          "type": "string",
          "description": "更新人。"
        },
        "type": {
          "type": "string",
          "enum": [
            "THIRD_NF",
            "DIMENSION"
          ],
          "description": "工作区类型枚举。\n枚举值:\n  - THIRD_NF: 关系建模\n  - DIMENSION: 维度建模"
        },
        "biz_catalog_ids": {
          "type": "string",
          "description": "关联的业务分层的ID列表 {\"l1Ids\":[],\"l2Ids\":[],\"l3Ids\":[]}。"
        },
        "databases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "数据库名称数组。"
        },
        "table_model_prefix": {
          "type": "string",
          "description": "模型校验前缀,长度不超过100,数字字母下划线组成,字母开头"
        }
      },
      "example": {
        "id": "953670725619867648",
        "name": "test",
        "description": "this is an example.",
        "is_physical": false,
        "frequent": false,
        "top": true,
        "level": null,
        "dw_type": "UNSPECIFIED",
        "create_time": "2022-03-16T15:06:59.333+08:00",
        "update_time": "2022-03-16T15:06:59.333+08:00",
        "create_by": "ei_dgc",
        "update_by": "ei_dgc",
        "type": "THIRD_NF",
        "biz_catalog_ids": null,
        "databases": null
      }
    },
    "BizTypeEnum": {
      "type": "string",
      "description": "业务实体类型。\n枚举值:\n - AGGREGATION_LOGIC_TABLE: 汇总表\n - ATOMIC_INDEX: 原子指标\n - ATOMIC_METRIC: 原子指标(新)\n - BIZ_CATALOG: 流程架构目录\n - BIZ_METRIC: 业务指标\n - CODE_TABLE: 码表\n - COMMON_CONDITION: 通用限定\n - COMPOSITE_METRIC: 复合指标(新)\n - COMPOUND_METRIC: 复合指标\n - CONDITION_GROUP: 限定分组\n - DEGENERATE_DIMENSION: 退化维度\n - DERIVATIVE_INDEX: 衍生指标\n - DERIVED_METRIC: 衍生指标(新)\n - DIMENSION: 维度\n - DIMENSION_ATTRIBUTE: 维度属性\n - DIMENSION_HIERARCHIES: 维度层级\n - DIMENSION_LOGIC_TABLE: 维度表\n - DIMENSION_TABLE_ATTRIBUTE: 维度属性\n - DIRECTORY: 目录\n - FACT_ATTRIBUTE: 事实表属性\n - FACT_DIMENSION: 事实表维度\n - FACT_LOGIC_TABLE: 事实表\n - FACT_MEASURE: 事实表度量\n - FUNCTION: 函数\n - INFO_ARCH: 信息架构(批量修改主题使用)\n - MODEL: 模型\n - QUALITY_RULE: 质量规则\n - SECRECY_LEVEL: 密级\n - STANDARD_ELEMENT: 数据标准\n - STANDARD_ELEMENT_TEMPLATE: 数据标准模板\n - SUBJECT: 主题\n - SUMMARY_DIMENSION_ATTRIBUTE: 汇总表维度属性\n - SUMMARY_INDEX: 汇总表指标属性\n - SUMMARY_TIME: 汇总表时间周期属性\n - TABLE_MODEL: 关系模型(逻辑模型/物理模型)\n - TABLE_MODEL_ATTRIBUTE: 关系模型属性(逻辑模型/物理模型)\n - TABLE_MODEL_LOGIC: 逻辑实体\n - TABLE_TYPE: 表类型\n - TAG: 标签\n - TIME_CONDITION: 时间限定",
      "enum": [
        "AGGREGATION_LOGIC_TABLE",
        "ATOMIC_INDEX",
        "ATOMIC_METRIC",
        "BIZ_CATALOG",
        "BIZ_METRIC",
        "CODE_TABLE",
        "COMMON_CONDITION",
        "COMPOSITE_METRIC",
        "COMPOUND_METRIC",
        "CONDITION_GROUP",
        "DEGENERATE_DIMENSION",
        "DERIVATIVE_INDEX",
        "DERIVED_METRIC",
        "DIMENSION",
        "DIMENSION_ATTRIBUTE",
        "DIMENSION_HIERARCHIES",
        "DIMENSION_LOGIC_TABLE",
        "DIMENSION_TABLE_ATTRIBUTE",
        "DIRECTORY",
        "FACT_ATTRIBUTE",
        "FACT_DIMENSION",
        "FACT_LOGIC_TABLE",
        "FACT_MEASURE",
        "FUNCTION",
        "INFO_ARCH",
        "MODEL",
        "QUALITY_RULE",
        "SECRECY_LEVEL",
        "STANDARD_ELEMENT",
        "STANDARD_ELEMENT_TEMPLATE",
        "SUBJECT",
        "SUMMARY_DIMENSION_ATTRIBUTE",
        "SUMMARY_INDEX",
        "SUMMARY_TIME",
        "TABLE_MODEL",
        "TABLE_MODEL_ATTRIBUTE",
        "TABLE_MODEL_LOGIC",
        "TABLE_TYPE",
        "TAG",
        "TIME_CONDITION"
      ],
      "example": "TABLE_MODE"
    },
    "AllModelStatisticVO": {
      "type": "object",
      "properties": {
        "frequent": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModelStatisticVO"
          },
          "description": "是否为常用。"
        },
        "top": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModelStatisticVO"
          },
          "description": "首层模型。"
        },
        "logic": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModelStatisticVO"
          },
          "description": "逻辑模型。"
        },
        "physical": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModelStatisticVO"
          },
          "description": "物理模型。"
        },
        "dwr": {
          "$ref": "#/definitions/ModelStatisticVO",
          "description": "DWR数据报告层。"
        },
        "dm": {
          "$ref": "#/definitions/ModelStatisticVO",
          "description": "DM数据整合层。"
        }
      }
    },
    "ModelLevel": {
      "type": "string",
      "description": "数据治理分层。\n枚举值:\n  - SDI: 贴源数据层\n  - DWI: 数据整合层\n  - DWR: 数据报告层\n  - DM:  数据集市层",
      "enum": [
        "SDI",
        "DWI",
        "DWR",
        "DM"
      ]
    },
    "DwType": {
      "type": "string",
      "description": "数据连接类型,对应表所在的数仓类型,取值可以为DLI、DWS、MRS_HIVE、POSTGRESQL、MRS_SPARK、CLICKHOUSE、MYSQL、ORACLE和DORIS等。",
      "example": "MRS_HIVE"
    },
    "CountAllModelsResult": {
      "type": "object",
      "description": "关系建模统计信息,统计结果。",
      "properties": {
        "data": {
          "type": "object",
          "description": "data,统一的返回结果的最外层数据结构。",
          "properties": {
            "value": {
              "type": "object",
              "description": "value,统一的返回结果的外层数据结构。",
              "$ref": "#/definitions/AllModelStatisticVO"
            }
          }
        }
      }
    },
    "ModelStatisticVO": {
      "type": "object",
      "properties": {
        "biz_type": {
          "$ref": "#/definitions/BizTypeEnum",
          "description": "业务类型。"
        },
        "level": {
          "$ref": "#/definitions/ModelLevel",
          "description": "模型层级。"
        },
        "db": {
          "type": "integer",
          "format": "int32",
          "description": "数据库。"
        },
        "tb": {
          "type": "integer",
          "format": "int32",
          "description": "数据表。"
        },
        "tb_published": {
          "type": "integer",
          "format": "int32",
          "description": "已发布的数据表。"
        },
        "fd": {
          "type": "integer",
          "format": "int32",
          "description": "字段。"
        },
        "fd_published": {
          "type": "integer",
          "format": "int32",
          "description": "已发布的字段。"
        },
        "st": {
          "type": "number",
          "format": "double",
          "description": "标准覆盖率。"
        },
        "st_published": {
          "type": "number",
          "format": "double",
          "description": "已发布的标准覆盖率。"
        },
        "model": {
          "$ref": "#/definitions/WorkspaceVO",
          "description": "模型。"
        }
      }
    }
  },
  "version": "2.0",
