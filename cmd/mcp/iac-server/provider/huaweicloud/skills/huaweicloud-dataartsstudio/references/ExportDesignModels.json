{
  "name": "ExportDesignModels",
  "summary": "导出业务数据",
  "tags": "导入导出接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/design/export-model": {
      "post": {
        "summary": "导出业务数据",
        "description": "根据请求参数,导出业务数据,可以导出:码表、数据标准、原子指标、衍生指标、复合指标、汇总表、业务指标、主题、流程、逻辑模型、物理模型、维度、事实表。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "doc-open",
        "x-request-examples-url-1": "POST https://{endpoint}/v2/{project_id}/design/export-model",
        "x-request-examples-description-1": "导出关系建模中,模型ID为1213499006739791872,表ID为1226583503525818368、1217121407599800322的业务数据。",
        "x-request-examples-1": {
          "asyn": "true",
          "type": "ER",
          "model_id": "1213499006739791872",
          "ids": [
            "1226583503525818368",
            "1217121407599800322"
          ]
        },
        "tags": [
          "导入导出接口"
        ],
        "operationId": "ExportDesignModels",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/tokenParam"
          },
          {
            "$ref": "#/parameters/workspaceParam"
          },
          {
            "$ref": "#/parameters/tenantIdParam"
          },
          {
            "$ref": "#/parameters/tenantXIdParam"
          },
          {
            "$ref": "#/parameters/contextTypeParam"
          },
          {
            "name": "ExportDesignModelsRequestBody",
            "required": true,
            "in": "body",
            "description": "导出参数。",
            "schema": {
              "$ref": "#/definitions/ExportParam"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/ExportDesignModelsResult"
            }
          },
          "400": {
            "$ref": "#/responses/400"
          },
          "401": {
            "$ref": "#/responses/401"
          },
          "403": {
            "$ref": "#/responses/403"
          }
        }
      }
    }
  },
  "definitions": {
    "ExportParam": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "导出对象ID的列表,如:某几个逻辑模型的ID,ID字符串。"
        },
        "asyn": {
          "type": "boolean",
          "description": "是否是异步操作导出,true:异步,false:同步。"
        },
        "type": {
          "type": "string",
          "description": "导出的业务类型:ER(关系建模),Directory_CodeTable(码表目录),Directory_Standard(标准目录),DIM(维度建模),codeTable(码表);dataStandard 数据标准;directory_id导出指定目录下的码表/数据标准;model_id,biz_catalog_id导出指定模型,目录下的业务表,import_bizcatalog导出流程架构,import_bizmetric导出业务指标。"
        },
        "directory_id": {
          "type": "string",
          "description": "所属目录ID,ID字符串。"
        },
        "biz_catalog_id": {
          "type": "string",
          "description": "所属业务分层的ID,ID字符串。"
        },
        "biz_catalog_id_list": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "所属业务分层的ID,ID字符串。"
          },
          "minItems": 1,
          "description": "所属的业务分层的ID列表。"
        },
        "model_id": {
          "type": "string",
          "description": "所属关系建模的模型ID,导出关系模型需要此参数,ID字符串。"
        }
      },
      "example": {
        "ids": [
          1160236484595425279,
          1160236484595425281
        ],
        "asyn": false,
        "type": "TABLE_MODEL",
        "directory_id": 1160236484595425280,
        "biz_catalog_id": 1160236484595425282,
        "biz_catalog_id_list": [
          1160236484595425283,
          1160236484595425284
        ],
        "model_id": 1160236484595425285
      }
    },
    "ExportDesignModelsResult": {
      "type": "object",
      "description": "Success,导出接口结果。",
      "properties": {
        "data": {
          "type": "object",
          "description": "返回的数据信息。",
          "properties": {
            "uuid": {
              "type": "string",
              "description": "导入接口返回的唯一标识。",
              "example": "fd653968-864b-45f6-9842-2b125d2dbfb8"
            }
          }
        }
      },
      "example": {
        "data": {
          "uuid": "fd653968-864b-45f6-9842-2b125d2dbfb9"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "tenantXIdParam": {
      "name": "X-Project-Id",
      "in": "header",
      "required": false,
      "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。\n\n多project场景采用AK/SK认证的接口请求,则该字段必选。",
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "tenantIdParam": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
      "required": true,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "tokenParam": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "IAM Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)\n使用Token认证时必选。",
      "required": true,
      "type": "string",
      "minLength": 0,
      "maxLength": 4096
    },
    "contextTypeParam": {
      "name": "Content-Type",
      "in": "header",
      "required": false,
      "description": "默认值:application/json;charset=UTF-8\n可选,有Body体的情况下必选,没有Body体则无需填写和校验。",
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "workspaceParam": {
      "name": "workspace",
      "in": "header",
      "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
      "required": true,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    }
  },
  "host": "dayu.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
