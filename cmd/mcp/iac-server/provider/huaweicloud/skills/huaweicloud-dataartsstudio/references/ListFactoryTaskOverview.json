{
  "name": "ListFactoryTaskOverview",
  "summary": "查询实例运行状态",
  "tags": "监控运维",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/factory/monitor/task-statistics-overview": {
      "get": {
        "tags": [
          "监控运维"
        ],
        "operationId": "ListFactoryTaskOverview",
        "x-apiexplorer-hide": "false",
        "summary": "查询实例运行状态",
        "description": "查询实例运行状态",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/tenantIdParam"
          },
          {
            "name": "workspace",
            "in": "header",
            "required": false,
            "description": "工作空间ID",
            "type": "string"
          },
          {
            "name": "x-Auth-Token",
            "in": "header",
            "required": false,
            "description": "使用Token认证时该字段必须",
            "type": "string"
          },
          {
            "name": "is_own",
            "in": "query",
            "required": false,
            "description": "是否查询当前用户的实例,默认为false,表示查询全部用户实例,为true时,表示查询当前用户的实例。",
            "type": "string"
          },
          {
            "name": "query_days",
            "in": "query",
            "required": false,
            "description": "查询的天数,取值范围为:today、yesterday、before_yesterday、all,默认为today,表示查询今天的数据,支持查询近7天的数据。\ntoday:查询当天的实例状态数量,\nyesterday:查询昨天的实例状态数量,\nbefore_yesterday:查询前天的实例状态数量,\nall:查询7天前到当天的实例状态总量。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "成功时,响应状态码为200",
            "schema": {
              "$ref": "#/definitions/ListFactoryTaskOverviewRes"
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DLF.20990",
                "error_msg": "Cannot perform the operation because the release package has been released."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DLS.1000",
          "minLength": 1,
          "maxLength": 128
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "process failed",
          "minLength": 1,
          "maxLength": 10240
        }
      }
    },
    "ListFactoryTaskOverviewRes": {
      "type": "object",
      "properties": {
        "fail_count": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "失败的实例数量"
        },
        "force_success_count": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "强制成功的实例数量"
        },
        "freeze_count": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "冻结的实例数量"
        },
        "ignore_success_count": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "忽略失败的实例数量"
        },
        "manual_stop_count": {
          "type": "integer",
          "format": "int32",
          "example": 6,
          "description": "取消的实例数量"
        },
        "pause_count": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "暂时的实例数量"
        },
        "running_count": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "运行中的实例数量"
        },
        "running_exception_count": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "异常的实例数量"
        },
        "skip_count": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "跳过的实例数量"
        },
        "success_count": {
          "type": "integer",
          "format": "int32",
          "example": 15,
          "description": "运行成功的实例数量"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "example": 21,
          "description": "实例总数"
        },
        "waiting_confirm_count": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "待确认执行的实例数量"
        },
        "waiting_count": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "等待运行的实例数量"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "tenantIdParam": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
      "required": true,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    }
  },
  "host": "dayu.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}