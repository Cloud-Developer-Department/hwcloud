{
  "name": "BatchSyncMetadata",
  "summary": "元数据实时同步接口(邀测)",
  "tags": "元数据实时同步",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/metadata/async-bulk": {
      "post": {
        "tags": [
          "元数据实时同步"
        ],
        "operationId": "BatchSyncMetadata",
        "x-support-sdk": "Y",
        "summary": "元数据实时同步接口(邀测)",
        "description": "元数据实时同步接口,支持批量。该接口功能处于邀测阶段,后续将随功能公测将逐步开放。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "IAM Token",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          },
          {
            "name": "MetaDataEventRequest",
            "in": "body",
            "description": "请求参数",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CatalogMetaDataEventRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/CatalogMetaDataEventResponse"
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "$ref": "#/definitions/DlgErrorResponseVO"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/DlgErrorResponseVO"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/DlgErrorResponseVO"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/DlgErrorResponseVO"
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "CatalogMetaDataEventRequest": {
      "type": "object",
      "description": "元数据实时同步的事件请求体",
      "properties": {
        "engine": {
          "type": "string",
          "description": "引擎服务名称,DLI DWS MRS",
          "enum": [
            "DLI",
            "MRS",
            "DWS"
          ]
        },
        "engine_version": {
          "type": "string",
          "description": "引擎版本信息",
          "minLength": 1,
          "maxLength": 30
        },
        "instance_id": {
          "type": "string",
          "description": "引擎的实例ID, MRS DWS必填",
          "minLength": 32,
          "maxLength": 36
        },
        "project_id": {
          "type": "string",
          "description": "项目ID,DLI必填",
          "minLength": 32,
          "maxLength": 36
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/CatalogMetaDataEventInfo"
          },
          "description": "资产信息"
        }
      },
      "example": {
        "engine": "MRS",
        "engine_version": "3.1.2",
        "instance_id": "4bacc6b5-9e94-4938-ac3f-3c3a7cd56c01",
        "events": [
          {
            "event_ts": 0,
            "event_type": "CreateTableEvent",
            "event_message": {
              "table": {
                "tableName": "testTb1"
              }
            }
          }
        ]
      },
      "title": "CatalogMetaDataEventRequest"
    },
    "CatalogMetaDataEventResponse": {
      "type": "object",
      "description": "元数据实时同步的结果",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "是否成功"
        }
      },
      "example": {
        "success": true
      }
    },
    "DlgErrorResponseVO": {
      "description": "请求失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "CatalogMetaDataEventInfo": {
      "type": "object",
      "description": "元数据实时同步的事件详细信息",
      "properties": {
        "event_ts": {
          "type": "integer",
          "format": "int64",
          "description": "事件发生时的时间戳"
        },
        "event_type": {
          "type": "string",
          "description": "事件类型",
          "enum": [
            "AddForeignKeyEvent",
            "AddNotNullConstraintEvent",
            "AddPrimaryKeyEvent",
            "AddUniqueConstraintEvent",
            "AlterDatabaseEvent",
            "AddPartitionEvent",
            "AlterPartitionEvent",
            "AlterTableEvent",
            "AlterCatalogEvent",
            "CreateCatalogEvent",
            "CreateDatabaseEvent",
            "CreateFunctionEvent",
            "CreateTableEvent",
            "DropConstraintEvent",
            "DropDatabaseEvent",
            "DropFunctionEvent",
            "DropPartitionEvent",
            "DropTableEvent",
            "DropCatalogEvent",
            "AddIndexEvent",
            "AlterIndexEvent",
            "DropIndexEvent",
            "AlterSchemaEvent",
            "CreateSchemaEvent",
            "DropSchemaEvent",
            "AlterColumnEvent",
            "AddColumnEvent",
            "DropColumnEvent",
            "AlterTriggerEvent",
            "AddTriggerEvent",
            "DropTriggerEvent"
          ]
        },
        "event_message": {
          "type": "object",
          "description": "事件消息,Map<String,Object>结构"
        }
      },
      "example": {
        "event_ts": 0,
        "event_type": "CreateTableEvent",
        "event_message": {
          "table": {
            "tableName": "testTb1"
          }
        }
      },
      "title": "CatalogMetaDataEventInfo"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dayu.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}