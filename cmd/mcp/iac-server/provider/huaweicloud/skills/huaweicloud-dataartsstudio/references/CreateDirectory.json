        "parent_id",
        "prev_id"
      ],
      "description": "目录。",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9_\\一-\\龥]*$",
          "description": "目录名称。"
        },
        "description": {
          "type": "string",
          "description": "描述。"
        },
        "type": {
          "type": "string",
          "enum": [
            "STANDARD_ELEMENT",
            "CODE"
          ],
          "description": "目录类型。\n枚举值:\n  - STANDARD_ELEMENT: 数据标准\n  - CODE: 码表"
        },
        "id": {
          "type": "string",
          "description": "ID,创建时可不传,更新时必填。填写String类型替代Long类型。"
        },
        "parent_id": {
          "type": "string",
          "description": "父目录ID,首层传null。填写String类型替代Long类型。"
        },
        "prev_id": {
          "type": "string",
          "description": "上个节点ID,首节点传null。填写String类型替代Long类型。"
        },
        "root_id": {
          "type": "string",
          "description": "根节点ID,根节点此ID为自身ID,只读。填写String类型替代Long类型。",
          "readOnly": true
        },
        "qualified_name": {
          "type": "string",
          "description": "目录的资产名称,只读。",
          "readOnly": true
        },
        "from_public": {
          "type": "boolean",
          "description": "是否来自公共层,只读。",
          "readOnly": true
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "readOnly": true,
          "description": "创建时间,只读,格式遵循RFC3339,精确到秒,UTC时区,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z。"
        },
        "update_time": {
          "type": "string",
          "format": "date-time",
          "readOnly": true,
          "description": "更新时间,只读,格式遵循RFC3339,精确到秒,UTC时区,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z。"
        },
        "create_by": {
          "type": "string",
          "description": "创建人,只读。",
          "readOnly": true
        },
        "update_by": {
          "type": "string",
          "description": "更新人,只读。",
          "readOnly": true
        },
        "ref_id": {
          "type": "string",
          "description": "关联的主题ID,ID字符串。"
        },
        "children": {
          "type": "array",
          "description": "子目录。",
          "items": {
            "$ref": "#/definitions/DirectoryVO"
          }
        }
      },
