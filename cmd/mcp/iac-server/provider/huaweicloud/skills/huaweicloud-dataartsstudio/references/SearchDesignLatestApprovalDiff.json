{
  "name": "SearchDesignLatestApprovalDiff",
  "summary": "获取下展信息与已发布实体的差异",
  "tags": "审批管理接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/design/approvals/business/{biz_id}/diff": {
      "get": {
        "summary": "获取下展信息与已发布实体的差异",
        "description": "当已发布的实体被编辑时,其会生成下展,该接口用于获取下展信息与已发布实体的差异。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "doc-open",
        "x-request-examples-url-1": "GET https://{endpoint}/v2/{project_id}/design/approvals/business/1217123755210469376/diff?biz_type=TABLE_MODEL",
        "x-request-examples-description-1": "获取关系建模中表ID为1217123755210469376的已发布实体与下展信息之间的差异信息。",
        "tags": [
          "审批管理接口"
        ],
        "operationId": "SearchDesignLatestApprovalDiff",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/tokenParam"
          },
          {
            "$ref": "#/parameters/workspaceParam"
          },
          {
            "$ref": "#/parameters/tenantIdParam"
          },
          {
            "$ref": "#/parameters/tenantXIdParam"
          },
          {
            "$ref": "#/parameters/contextTypeParam"
          },
          {
            "name": "biz_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "待比较下展的实体ID,ID字符串。"
          },
          {
            "name": "biz_type",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "待删除下展的实体类型。\n枚举值:\n  - ATOMIC_INDEX: 原子指标\n  - DERIVATIVE_INDEX: 衍生指标\n  - DIMENSION: 维度\n  - FACT_LOGIC_TABLE: 事实表\n  - TABLE_MODEL:关系建模:逻辑实体/物理表\n  - STANDARD_ELEMENT: 数据标准\n  - AGGREGATION_LOGIC_TABLE: 汇总表\n  - CODE_TABLE: 码表\n  - BIZ_METRIC: 业务指标\n  - COMPOUND_METRIC: 复合指标",
            "enum": [
              "ATOMIC_INDEX",
              "DERIVATIVE_INDEX",
              "DIMENSION",
              "FACT_LOGIC_TABLE",
              "TABLE_MODEL",
              "STANDARD_ELEMENT",
              "AGGREGATION_LOGIC_TABLE",
              "CODE_TABLE",
              "BIZ_METRIC",
              "COMPOUND_METRIC"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Success,返回data数据是PublishVersionVO数组,以及总数。",
            "schema": {
              "$ref": "#/definitions/PublishVersionVODetail"
            }
          },
          "400": {
            "$ref": "#/responses/400"
          },
          "401": {
            "$ref": "#/responses/401"
          },
          "403": {
            "$ref": "#/responses/403"
          }
        }
      }
    }
  },
