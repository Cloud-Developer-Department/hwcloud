        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "权限管理接口"
        ],
        "summary": "查询数据操作信息",
        "description": "查询数据操作信息",
        "operationId": "ListSecurityDatasourceActions",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/workspace"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "name": "parent_permission_set_id",
            "in": "query",
            "description": "父权限集ID。获取方法请参见[查询权限集列表](ListSecurityPermissionSets.xml)\n注意:\n* 当该值为0时,则所有库表均支持查询\n* 当该值为父权限集ID时,则基于父权限集中的权限查询",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "cluster_id",
            "in": "query",
            "description": "集群ID,获取方法请参见[查询单个数据连接信息](ShowDataconnection.xml)\n* 查询Hive和DWS数据源操作信息时该数值为必填项,当数据源为DLI时无需填写",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "datasource_type",
            "in": "query",
            "description": "数据源类型\n* HIVE数据源\n* DWS数据源\n* DLI数据源",
            "required": true,
            "type": "string",
            "enum": [
              "HIVE",
              "DWS",
              "DLI"
            ]
          },
          {
            "name": "database_name",
            "in": "query",
            "description": "数据库名\n`注意:该值作为查询关键字时,不能与url同时存在,需要指定其一进行查询`",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "schema_name",
            "in": "query",
