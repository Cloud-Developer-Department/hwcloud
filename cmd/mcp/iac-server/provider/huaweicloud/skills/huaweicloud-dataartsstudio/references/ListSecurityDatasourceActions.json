            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "table_name",
            "in": "query",
            "description": "数据表名称",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "column_name",
            "in": "query",
            "description": "数据字段名称",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "url",
            "in": "query",
            "description": "url路径名称\n`注意:该值作为查询关键字时,不能与database_name同时存在,需要指定其一进行查询`",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 65535
          }
        ],
        "x-request-examples-url-1": "/v1/0833a5737480d53b2f25c010dc1a7b88/security/permission-sets/datasource/actions?parent_permission_set_id=0&cluster_id=dc425074-26b3-479c-9e2f-b103c0cdd90f&datasource_type=HIVE&database_name=bigdatatest",
        "x-request-examples-1": {
          "parent_permission_set_id": "0",
          "cluster_id": "dc425074-26b3-479c-9e2f-b103c0cdd90f",
