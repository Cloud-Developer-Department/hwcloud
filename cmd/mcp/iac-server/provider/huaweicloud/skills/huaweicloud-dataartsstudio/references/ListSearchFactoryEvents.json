{
  "name": "ListSearchFactoryEvents",
  "summary": "查询事件列表",
  "tags": "基线运维",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/factory/aiops/{instance_id}/event": {
      "get": {
        "x-request-examples-url-1": "GET /v2/62099355b894428e8916573ae635f1f9/factory/aiops/65212faf-91e2-4914-a116-be71b1aaf49e/event",
        "x-request-examples-description-1": "查询事件列表。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "基线运维"
        ],
        "summary": "查询事件列表",
        "description": "查询事件列表。",
        "operationId": "ListSearchFactoryEvents",
        "parameters": [
          {
            "$ref": "#/parameters/tenantIdParam"
          },
          {
            "$ref": "#/parameters/instanceIdParam"
          },
          {
            "$ref": "#/parameters/tokenParam"
          },
          {
            "$ref": "#/parameters/tenantXIdParam"
          },
          {
            "$ref": "#/parameters/workspaceParam"
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": true,
            "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "name",
            "in": "query",
            "description": "基线任务名称。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          {
            "name": "task_name",
            "in": "query",
            "required": false,
            "description": "作业名称",
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "owner_name",
            "in": "query",
            "description": "责任人名称。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "事件类型: \n- ERROR: 出错\n- SLOW_DOWN: 变慢\n\n默认查询全部事件类型。",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "事件状态:\n- NEW_DISCOVERY: 新发现\n- PROCESSING: 处理中\n- RESTORED: 已恢复\n- IGNORED: 已忽略"
          },
          {
            "name": "order_by",
            "in": "query",
            "description": "排序规则,示例 happen_time_ms asc asc,表示按照优先级升序排序,有如下取值:\n- happen_time_ms asc asc: 按照触发事件升序。\n- happen_time_ms asc desc: 按照触发事件降序。\n 默认不排序。",
            "required": false,
            "type": "string",
            "minLength": 5,
            "maxLength": 128
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "创建时间检索区间,起始时间戳,单位毫秒。默认为当天0点0分0秒,当end_time有值时,该值不能为空。",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "创建时间检索区间,终止时间戳,单位毫秒。默认为当天23点59分59秒,当start_time有值时,该值不能为空,最大查询范围为180天。",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页列表的页数,默认值为1。取值范围大于等于1。",
            "required": false,
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "分页返回结果,指定每页最大记录数。范围[1,100]\n默认值:10",
            "required": false,
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10
          }
        ],
        "responses": {
          "200": {
            "description": "调用成功的响应体。",
            "schema": {
              "$ref": "#/definitions/EventSearchResultV2"
            },
            "examples": {
              "application/json": {
                "total": 38,
                "events": [
