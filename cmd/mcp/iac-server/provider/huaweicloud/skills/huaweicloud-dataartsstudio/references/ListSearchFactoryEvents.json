                    "type": "ERROR",
                    "status": "NEW_DISCOVERY",
                    "baseline_name": "4541_shell",
                    "task_name": "job_0047111_shell",
                    "task_id": "935332",
                    "task_version": 14,
                    "happen_time": 1765985208900,
                    "owner_name": "zhuangzhaodian"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "调用失败的返回体。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "examples": {
              "application/json": {
                "error_msg": "The value of parameter [workspace_id] does not exist, please check again its value.",
                "error_code": "DLF.21203"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "EventSearchResultV2": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "properties": {
              "id": {
                "type": "string",
                "example": "3826844370135172041",
                "description": "事件ID。"
              },
              "name": {
                "type": "string",
                "example": "shell_1215#Mon Dec 15 22:26:30 CST 2025#ERROR",
                "description": "事件名称。"
              },
              "type": {
                "type": "string",
                "example": "null",
                "description": "事件类型,取值为ERROR和SLOW_DOWN。"
              },
              "status": {
                "type": "string",
                "example": "null",
                "description": "事件状态,取值为NEW_DISCOVERY、PROCESSING、RESTORED和IGNORED。"
              },
              "baseline_name": {
                "type": "string",
                "example": "shell_1215",
                "description": "基线任务名称。"
              },
              "task_name": {
                "type": "string",
                "example": "job_0047111_shell",
                "description": "作业名称。"
              },
              "task_id": {
                "type": "string",
                "example": "935332",
                "description": "作业ID。"
              },
              "task_version": {
                "type": "integer",
                "format": "int32",
                "example": 14,
                "description": "作业版本号。"
              },
              "happen_time": {
                "type": "integer",
                "format": "int32",
                "example": 1765808790324,
                "description": "发生时间戳,单位毫秒。"
              },
              "owner_name": {
                "type": "string",
                "example": "ei_dlf_l00341563",
                "description": "责任人用户名称。"
              }
            }
          },
          "description": "事件。"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "example": 21,
          "description": "总数。"
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    }
