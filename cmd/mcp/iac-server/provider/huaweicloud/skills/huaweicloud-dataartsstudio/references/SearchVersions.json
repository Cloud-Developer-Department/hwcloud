{
  "name": "SearchVersions",
  "summary": "查找版本信息",
  "tags": "版本信息接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/design/versions": {
      "get": {
        "summary": "查找版本信息",
        "description": "通过名称、创建者、修改时间查找版本信息。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "doc-open",
        "x-request-examples-url-1": "GET https://{endpoint}/v2/{project_id}/design/versions?biz_id=1193199235202428928",
        "x-request-examples-description-1": "根据业务对象ID查找版本信息。",
        "tags": [
          "版本信息接口"
        ],
        "operationId": "SearchVersions",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/tokenParam"
          },
          {
            "$ref": "#/parameters/workspaceParam"
          },
          {
            "$ref": "#/parameters/tenantIdParam"
          },
          {
            "$ref": "#/parameters/tenantXIdParam"
          },
          {
            "$ref": "#/parameters/contextTypeParam"
          },
          {
            "$ref": "#/parameters/nameParam"
          },
          {
            "$ref": "#/parameters/createByParam"
          },
          {
            "$ref": "#/parameters/bizIdParam"
          },
          {
            "$ref": "#/parameters/bizTypeParam"
          },
          {
            "$ref": "#/parameters/beginTimeParam"
          },
          {
            "$ref": "#/parameters/endTimeParam"
          },
          {
            "$ref": "#/parameters/limitParam"
          },
          {
            "$ref": "#/parameters/offsetParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Success,返回data数据是PublishVersionVO数组,以及总数。",
            "schema": {
              "$ref": "#/definitions/PublishVersionVOSearchResult"
            }
          },
          "400": {
            "$ref": "#/responses/400"
          },
          "401": {
            "$ref": "#/responses/401"
          },
          "403": {
            "$ref": "#/responses/403"
          }
        }
      }
    }
  },
  "definitions": {
    "BizTypeEnum": {
      "type": "string",
      "description": "业务实体类型。\n枚举值:\n - AGGREGATION_LOGIC_TABLE: 汇总表\n - ATOMIC_INDEX: 原子指标\n - ATOMIC_METRIC: 原子指标(新)\n - BIZ_CATALOG: 流程架构目录\n - BIZ_METRIC: 业务指标\n - CODE_TABLE: 码表\n - COMMON_CONDITION: 通用限定\n - COMPOSITE_METRIC: 复合指标(新)\n - COMPOUND_METRIC: 复合指标\n - CONDITION_GROUP: 限定分组\n - DEGENERATE_DIMENSION: 退化维度\n - DERIVATIVE_INDEX: 衍生指标\n - DERIVED_METRIC: 衍生指标(新)\n - DIMENSION: 维度\n - DIMENSION_ATTRIBUTE: 维度属性\n - DIMENSION_HIERARCHIES: 维度层级\n - DIMENSION_LOGIC_TABLE: 维度表\n - DIMENSION_TABLE_ATTRIBUTE: 维度属性\n - DIRECTORY: 目录\n - FACT_ATTRIBUTE: 事实表属性\n - FACT_DIMENSION: 事实表维度\n - FACT_LOGIC_TABLE: 事实表\n - FACT_MEASURE: 事实表度量\n - FUNCTION: 函数\n - INFO_ARCH: 信息架构(批量修改主题使用)\n - MODEL: 模型\n - QUALITY_RULE: 质量规则\n - SECRECY_LEVEL: 密级\n - STANDARD_ELEMENT: 数据标准\n - STANDARD_ELEMENT_TEMPLATE: 数据标准模板\n - SUBJECT: 主题\n - SUMMARY_DIMENSION_ATTRIBUTE: 汇总表维度属性\n - SUMMARY_INDEX: 汇总表指标属性\n - SUMMARY_TIME: 汇总表时间周期属性\n - TABLE_MODEL: 关系模型(逻辑模型/物理模型)\n - TABLE_MODEL_ATTRIBUTE: 关系模型属性(逻辑模型/物理模型)\n - TABLE_MODEL_LOGIC: 逻辑实体\n - TABLE_TYPE: 表类型\n - TAG: 标签\n - TIME_CONDITION: 时间限定",
      "enum": [
        "AGGREGATION_LOGIC_TABLE",
        "ATOMIC_INDEX",
        "ATOMIC_METRIC",
        "BIZ_CATALOG",
        "BIZ_METRIC",
        "CODE_TABLE",
        "COMMON_CONDITION",
        "COMPOSITE_METRIC",
        "COMPOUND_METRIC",
        "CONDITION_GROUP",
        "DEGENERATE_DIMENSION",
        "DERIVATIVE_INDEX",
        "DERIVED_METRIC",
        "DIMENSION",
        "DIMENSION_ATTRIBUTE",
        "DIMENSION_HIERARCHIES",
        "DIMENSION_LOGIC_TABLE",
        "DIMENSION_TABLE_ATTRIBUTE",
        "DIRECTORY",
        "FACT_ATTRIBUTE",
        "FACT_DIMENSION",
        "FACT_LOGIC_TABLE",
        "FACT_MEASURE",
        "FUNCTION",
        "INFO_ARCH",
        "MODEL",
        "QUALITY_RULE",
        "SECRECY_LEVEL",
        "STANDARD_ELEMENT",
        "STANDARD_ELEMENT_TEMPLATE",
        "SUBJECT",
        "SUMMARY_DIMENSION_ATTRIBUTE",
        "SUMMARY_INDEX",
        "SUMMARY_TIME",
        "TABLE_MODEL",
        "TABLE_MODEL_ATTRIBUTE",
        "TABLE_MODEL_LOGIC",
        "TABLE_TYPE",
        "TAG",
        "TIME_CONDITION"
      ],
      "example": "TABLE_MODE"
    },
    "SyncStatusEnum": {
      "type": "string",
      "description": "同步状态。\n枚举值:\n  - NO_NEED: 未同步\n  - CREATE_SUCCESS: 创建成功\n  - CREATE_FAILED: 创建失败\n  - UPDATE_SUCCESS: 更新成功\n  - UPDATE_FAILED: 更新失败\n  - SUMMARY_SUCCESS: 整体成功\n  - SUMMARY_FAILED: 整体失败\n  - RUNNING: 整体运行\n  - OFFLINE: 已下线",
      "example": "CREATE_SUCCESS",
      "enum": [
        "NO_NEED",
        "CREATE_SUCCESS",
        "CREATE_FAILED",
        "UPDATE_SUCCESS",
        "UPDATE_FAILED",
        "SUMMARY_SUCCESS",
        "SUMMARY_FAILED",
        "RUNNING",
        "OFFLINE"
      ]
    },
    "PublishVersionVO": {
      "type": "object",
      "description": "版本信息。",
      "required": [
        "version_name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "版本ID,ID字符串。",
          "example": "1012308140932370432"
        },
        "version_name": {
          "type": "string",
          "description": "版本名称。",
          "pattern": "^[^\\\\<>]*$",
          "example": "性别_2022-08-25_10-31-08_575"
        },
        "version_tag": {
          "type": "string",
          "description": "版本标记,只读。",
          "readOnly": true,
          "example": "性别_2022-08-25_10-31-08_575"
        },
        "description": {
          "type": "string",
          "description": "版本描述。",
          "example": "这是版本的描述信息"
        },
        "biz_id": {
          "type": "string",
          "description": "业务对象ID,ID字符串。",
          "example": "1012307352952635392"
        },
        "biz_type": {
          "$ref": "#/definitions/BizTypeEnum"
        },
        "biz_info": {
          "type": "string",
          "description": "业务详情,只读。",
          "readOnly": true,
          "example": null
        },
        "biz_info_vo": {
          "type": "object",
          "description": "业务对象。",
          "example": null
        },
        "effect_objs": {
          "type": "string",
          "description": "影响信息,只读。",
          "readOnly": true,
          "example": null
        },
        "change_props": {
          "type": "string",
          "description": "变化信息,只读。",
          "readOnly": true,
          "example": null
        },
        "sql_ddl": {
          "type": "string",
          "description": "SQL脚本,只读。",
          "readOnly": true,
          "example": "ALTER TABLE test_table ADD COLUMN aa varchar(50);"
        },
        "physical_table": {
          "$ref": "#/definitions/SyncStatusEnum",
          "description": "生产环境创建表状态",
          "readOnly": true
        },
        "dev_physical_table": {
          "$ref": "#/definitions/SyncStatusEnum",
          "description": "开发环境创建表状态",
          "readOnly": true
        },
        "technical_asset": {
          "$ref": "#/definitions/SyncStatusEnum",
          "description": "技术资产同步状态,只读。",
          "readOnly": true
        },
        "business_asset": {
          "$ref": "#/definitions/SyncStatusEnum",
          "description": "业务资产同步状态,只读。",
          "readOnly": true
        },
        "meta_data_link": {
          "$ref": "#/definitions/SyncStatusEnum",
          "description": "资产关联状态,只读。",
          "readOnly": true
        },
        "data_quality": {
          "$ref": "#/definitions/SyncStatusEnum",
          "description": "质量作业状态,只读。",
          "readOnly": true
        },
        "dlf_task": {
          "$ref": "#/definitions/SyncStatusEnum",
          "description": "数据开发作业状态,只读。",
          "readOnly": true
        },
        "materialization": {
          "$ref": "#/definitions/SyncStatusEnum",
          "description": "码表数值落库状态,只读。",
          "readOnly": true
        },
        "publish_to_dlm": {
          "$ref": "#/definitions/SyncStatusEnum",
          "description": "DLM API生成状态,只读。",
          "readOnly": true
        },
        "biz_metric": {
          "$ref": "#/definitions/SyncStatusEnum",
          "description": "业务指标同步状态,只读。",
          "readOnly": true
        },
        "summary_status": {
          "$ref": "#/definitions/SyncStatusEnum",
          "description": "统一统计状态,只读。",
          "readOnly": true
        },
        "is_current_version": {
          "type": "boolean",
          "description": "是否为当前版本,只读。",
          "readOnly": true,
          "default": false,
          "example": false
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间,只读,格式遵循RFC3339,精确到秒,UTC时区,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z。",
          "readOnly": true,
          "example": "2022-08-25T10:31:09+08:00"
        },
        "create_by": {
          "type": "string",
          "description": "创建人,只读。",
          "readOnly": true,
          "example": "user_aaa"
        }
      }
    },
    "PublishVersionVOSearchResult": {
      "type": "object",
      "description": "版本的搜索结果,其中的对象是版本值对象(PublishVersionVO)。",
      "properties": {
        "data": {
          "type": "object",
          "description": "返回数据。",
          "properties": {
            "value": {
              "type": "object",
              "description": "返回的数据信息。",
              "properties": {
                "records": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/PublishVersionVO"
                  },
                  "description": "查询到的版本值对象(PublishVersionVO)数组。"
                },
                "total": {
                  "type": "integer",
                  "format": "int32",
                  "description": "符合搜索条件的记录总数。",
                  "example": 125
                }
              }
            }
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "limitParam": {
      "name": "limit",
      "in": "query",
      "description": "每页查询条数,即查询Y条数据。默认值50,取值范围[1,100]。",
      "required": false,
      "type": "integer",
      "format": "int32",
      "default": 50,
      "maximum": 100
    },
    "tenantIdParam": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
      "required": true,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "offsetParam": {
      "name": "offset",
      "in": "query",
      "description": "查询起始坐标,即跳过X条数据,仅支持0或limit的整数倍,不满足则向下取整,默认值0。",
      "required": false,
      "type": "integer",
      "format": "int32",
      "default": 0
    },
    "createByParam": {
      "name": "create_by",
      "in": "query",
      "description": "按创建者查询。",
      "required": false,
      "type": "string"
    },
    "nameParam": {
      "name": "name",
      "in": "query",
      "description": "按名称或编码模糊查询。",
      "required": false,
      "type": "string"
    },
    "workspaceParam": {
      "name": "workspace",
      "in": "header",
      "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
      "required": true,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "beginTimeParam": {
      "name": "begin_time",
      "in": "query",
      "description": "时间过滤左边界,与end_time一起使用,只支持时间范围过滤,单边过滤无效。格式遵循RFC3339,精确到秒,UTC时区,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z。",
      "required": false,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "tenantXIdParam": {
      "name": "X-Project-Id",
      "in": "header",
      "required": false,
      "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。\n\n多project场景采用AK/SK认证的接口请求,则该字段必选。",
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "tokenParam": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "IAM Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)\n使用Token认证时必选。",
      "required": true,
      "type": "string",
      "minLength": 0,
      "maxLength": 4096
    },
    "contextTypeParam": {
      "name": "Content-Type",
      "in": "header",
      "required": false,
      "description": "默认值:application/json;charset=UTF-8\n可选,有Body体的情况下必选,没有Body体则无需填写和校验。",
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "bizTypeParam": {
      "name": "biz_type",
      "in": "query",
      "description": "按业务类型查询,可选业务类型有:ATOMIC_INDEX(原子指标)、DERIVATIVE_INDEX(衍生指标)、DIMENSION(维度)、TIME_CONDITION(时间限定)、DIMENSION_LOGIC_TABLE(维度表)、FACT_LOGIC_TABLE(事实表)、AGGREGATION_LOGIC_TABLE(汇总表)、TABLE_MODEL(关系建模表)、CODE_TABLE(码表)、STANDARD_ELEMENT)(数据标准)、BIZ_METRIC(业务指标)、COMPOUND_METRIC(复合指标)、SUBJECT(主题)、ATOMIC_METRIC(原子指标(新))、DERIVED_METRIC(衍生指标(新))、COMPOSITE_METRIC(复合指标(新))。",
      "required": false,
      "type": "string"
    },
    "endTimeParam": {
      "name": "end_time",
      "in": "query",
      "description": "时间过滤右边界,与begin_time一起使用只支持时间范围过滤,单边过滤无效。格式遵循RFC3339,精确到秒,UTC时区,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z。",
      "required": false,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "bizIdParam": {
      "name": "biz_id",
      "in": "query",
      "required": false,
      "type": "string",
      "description": "业务定义ID,ID字符串。"
    }
  },
  "host": "dayu.ae-ad-1.myhuaweicloud.com",
