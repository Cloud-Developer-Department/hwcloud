  "definitions": {
    "CodeTableFieldVO": {
      "type": "object",
      "description": "码表属性信息。",
      "required": [
        "ordinal",
        "name_en",
        "name_ch",
        "data_type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "码表字段ID,ID字符串。"
        },
        "code_table_id": {
          "type": "string",
          "description": "所属码表ID,ID字符串。"
        },
        "ordinal": {
          "type": "integer",
          "description": "序号。"
        },
        "name_en": {
          "type": "string",
          "description": "字段名,英文。",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "maxLength": 600
        },
        "name_ch": {
          "type": "string",
          "description": "字段名,中文。",
          "pattern": "^[a-zA-Z\\一-\\龥][a-zA-Z0-9_\\一-\\龥\\-\\(\\)]*$",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 600,
          "description": "描述。"
        },
        "data_type": {
          "$ref": "#/definitions/DataType"
        },
        "domain_type": {
          "$ref": "#/definitions/DataTypeDomainEnum",
          "readOnly": true
        },
        "data_type_extend": {
          "type": "string",
          "description": "数据类型扩展字段。",
          "maxLength": 50
        },
        "is_unique_key": {
          "type": "boolean",
          "description": "是否唯一。",
          "default": false
        },
        "code_table_field_values": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CodeTableFieldValueVO"
          },
          "description": "码表属性值。"
        },
        "count_field_values": {
          "type": "integer",
          "format": "int32",
          "description": "码表属性值总数。"
        }
      }
    },
    "DataType": {
      "type": "string",
      "description": "字段类型。"
    },
    "UpdateCodeTableValuesResult": {
      "type": "object",
      "description": "编辑码表值返回结果。",
      "properties": {
        "data": {
          "type": "object",
          "description": "data,统一的返回结果的最外层数据结构。",
          "properties": {
            "value": {
              "description": "码表字段列表信息。",
              "type": "array",
              "items": {
                "$ref": "#/definitions/CodeTableFieldVO"
              }
            }
          }
        }
      }
    },
    "DataTypeDomainEnum": {
      "type": "string",
      "description": "字段类型所属域。\n枚举值:\n  - NUMBER: 数字类型\n  - STRING: 字符类型\n  - DATETIME: 日期类型\n  - BLOB: 大对象(BLOB)\n  - OTHER: 其它类型",
      "enum": [
        "NUMBER",
        "STRING",
        "DATETIME",
        "BLOB",
        "OTHER"
      ]
    },
    "CodeTableFieldValueUpdateVO": {
      "type": "object",
      "description": "码表属性值修改内容。",
      "properties": {
        "to_add": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CodeTableFieldVO"
          },
          "description": "新增码表属性、属性值列表。"
        },
        "to_modify": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CodeTableFieldVO"
          },
          "description": "编辑码表属性值列表。"
        },
        "to_remove": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CodeTableFieldVO"
          },
          "description": "删除码表属性ID列表。"
        }
      },
      "example": {
        "to_add": [
          {
            "id": "66980",
