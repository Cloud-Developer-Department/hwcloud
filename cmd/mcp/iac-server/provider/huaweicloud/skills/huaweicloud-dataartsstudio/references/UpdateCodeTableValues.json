                "fd_id": "66980",
                "fd_value": "aaa",
                "ordinal": 1
              }
            ],
            "count_field_values": null
          }
        ]
      }
    },
    "CodeTableFieldValueVO": {
      "type": "object",
      "description": "码表属性值。",
      "properties": {
        "id": {
          "type": "string",
          "description": "码表字段ID,ID字符串。"
        },
        "fd_id": {
          "type": "string",
          "description": "所属码表属性ID,ID字符串。"
        },
        "fd_value": {
          "type": "string",
          "default": "",
          "description": "码表属性值。"
        },
        "ordinal": {
          "type": "integer",
          "description": "序号。"
        },
        "description": {
          "type": "string",
          "maxLength": 600,
          "description": "描述。"
        }
      },
      "example": {
        "id": "14829936",
        "fd_id": "77534",
        "fd_value": "taxi",
        "ordinal": 1,
        "description": null
      }
    }
  },
