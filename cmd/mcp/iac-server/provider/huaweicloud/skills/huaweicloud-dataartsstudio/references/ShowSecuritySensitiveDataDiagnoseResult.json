{
  "name": "ShowSecuritySensitiveDataDiagnoseResult",
  "summary": "查询敏感数据保护模块诊断结果",
  "tags": "数据安全诊断接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/security/diagnose/sensitive-data": {
      "get": {
        "tags": [
          "数据安全诊断接口"
        ],
        "summary": "查询敏感数据保护模块诊断结果",
        "description": "查询敏感数据保护模块诊断结果",
        "operationId": "ShowSecuritySensitiveDataDiagnoseResult",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/workspace"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "x-request-examples-url-1": "/v1/0833a5737480d53b2f25c010dc1a7b88/security/diagnose/sensitive-data",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/SensitiveDataDiagnoseResult"
            },
            "examples": {
              "application/json": {
                "check_time": 1716435728000,
                "classification": {
                  "classification": true,
                  "result": "NO_RISK",
                  "security_level": true
                },
                "masking": {
                  "count": 0,
                  "result": "NO_RISK"
                },
                "rule": {
                  "abnormal_info": [
                    {
                      "level": "3",
                      "name": "yyy"
                    },
                    {
                      "level": "8",
                      "name": "高度绝密"
                    }
                  ],
                  "count": 2,
                  "result": "HIGH_RISK"
                },
                "scanning": false,
                "task_id": "695e9ea4dd864e55b5dbdd91ad61ebd0"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ClassificationResult": {
      "type": "object",
      "description": "数据分级分类诊断结果",
      "properties": {
        "result": {
          "$ref": "#/definitions/DiagnoseResult"
        },
        "security_level": {
          "type": "boolean",
          "description": "是否配置了密级"
        },
        "classification": {
          "type": "boolean",
          "description": "是否配置了分类"
        }
      }
    },
    "SecurityLevelInfo": {
      "type": "object",
      "description": "密级等级信息",
      "properties": {
        "name": {
          "type": "string",
          "description": "密级名称",
          "minLength": 1,
          "maxLength": 128
        },
        "level": {
          "type": "string",
          "description": "密级等级",
          "minLength": 1,
          "maxLength": 10
        }
      }
    },
    "SensitiveDataDiagnoseResult": {
      "type": "object",
      "description": "敏感数据保护诊断结果",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "诊断任务id",
          "minLength": 1,
          "maxLength": 128
        },
        "scanning": {
          "type": "boolean",
          "description": "是否正在扫描"
        },
        "check_time": {
          "type": "integer",
          "format": "int64",
          "description": "最新检测时间。",
          "minimum": 0,
          "maximum": 4070880010000
        },
        "classification": {
          "$ref": "#/definitions/ClassificationResult"
        },
        "rule": {
          "$ref": "#/definitions/IdentificationRuleResult"
        },
        "masking": {
          "$ref": "#/definitions/DataMaskingResult"
        }
      }
    },
    "DiagnoseResult": {
      "type": "string",
      "description": "检测结果\n* NO_RISK 无风险\n* MEDIUM_RISK 中风险\n* HIGH_RISK 高风险\n* NOT_SCANNED 未扫描",
      "enum": [
        "NO_RISK",
        "MEDIUM_RISK",
        "HIGH_RISK",
        "NOT_SCANNED"
      ]
    },
    "DataMaskingResult": {
      "type": "object",
      "description": "数据脱敏诊断结果",
      "properties": {
        "result": {
          "$ref": "#/definitions/DiagnoseResult"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "没有配置脱敏任务的表数量",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "IdentificationRuleResult": {
      "type": "object",
      "description": "敏感识别规则诊断结果",
      "properties": {
        "result": {
          "$ref": "#/definitions/DiagnoseResult"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "有风险的问题数量",
          "minimum": 0,
          "maximum": 2147483647
        },
        "abnormal_info": {
          "type": "array",
          "description": "没有配置识别规则的密级列表",
          "items": {
            "$ref": "#/definitions/SecurityLevelInfo"
          },
          "minItems": 0,
          "maxItems": 10
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "project id",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "token",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 10240
    },
    "workspace": {
      "name": "workspace",
      "in": "header",
      "description": "DataArts Studio工作空间ID",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "host": "dayu.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}