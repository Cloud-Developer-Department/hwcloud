    "PermissionActions": {
      "type": "string",
      "description": "HIVE数据源支持权限操作类型:\n  * `ALL` - 所有执行权限\n  * `SELECT` - 查询权限\n  * `UPDATE` - 更新权限\n  * `CREATE` - 创建权限\n  * `DROP` - drop操作权限\n  * `ALTER` - alter操作权限\n  * `INDEX` - 索引操作权限\n  * `READ` - 可读权限\n  * `WRITE` - 可写权限\n\nDLI数据源支持权限操作类型:\n  * `SELECT` - 查询权限\n  * `DROP` - drop操作权限\n  * `ALTER` - alter操作权限\n  * `INSERT` - 插入数据权限\n  * `CREATE_TABLE` - 创建表权限\n\nDWS数据源支持权限操作类型:\n  * `ALL` - 所有执行权限\n  * `SELECT` - 查询权限\n  * `UPDATE` - 更新权限\n  * `DROP` - drop操作权限\n  * `ALTER` - alter操作权限\n  * `INSERT` - 插入数据权限\n  * `CREATE_TABLE` - 创建表权限\n  * `DELETE` - 删除数据权限\n  * `CREATE_SCHEMA` - 创建schema权限",
      "minItems": 0,
      "maxItems": 100,
      "enum": [
        "ALL",
        "SELECT",
        "UPDATE",
        "CREATE",
        "DROP",
        "ALTER",
        "INDEX",
        "READ",
        "WRITE",
        "INSERT",
        "CREATE_TABLE",
        "DELETE",
        "CREATE_SCHEMA"
      ]
    },
