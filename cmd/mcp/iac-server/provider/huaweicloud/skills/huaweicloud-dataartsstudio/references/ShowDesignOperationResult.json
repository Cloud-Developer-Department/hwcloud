{
  "name": "ShowDesignOperationResult",
  "summary": "获取操作结果",
  "tags": "关系建模接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/design/operation-results": {
      "get": {
        "summary": "获取操作结果",
        "description": "获取批量操作的结果,如逻辑模型转物理模型和逆向数据库操作。",
        "tags": [
          "关系建模接口"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "doc-open",
        "operationId": "ShowDesignOperationResult",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/tokenParam"
          },
          {
            "$ref": "#/parameters/workspaceParam"
          },
          {
            "$ref": "#/parameters/tenantIdParam"
          },
          {
            "$ref": "#/parameters/tenantXIdParam"
          },
          {
            "$ref": "#/parameters/contextTypeParam"
          },
          {
            "$ref": "#/parameters/operationTypeParam"
          },
          {
            "$ref": "#/parameters/limitParam"
          },
          {
            "$ref": "#/parameters/offsetParam"
          },
          {
            "name": "operation_id",
            "in": "query",
            "description": "批量操作id,在逻辑模型转物理表时,填写的是逻辑模型的model_id,在逆向数据库时,填写的是目标模型的model_id。model_id可从接口[获取模型](ListWorkspaces.xml)中获取。",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success,返回data数据是 BatchOperationVO",
            "schema": {
              "$ref": "#/definitions/ShowOperationResultVO"
            }
          },
          "400": {
            "$ref": "#/responses/400"
          },
          "401": {
            "$ref": "#/responses/401"
          },
          "403": {
            "$ref": "#/responses/403"
          }
        }
      }
    }
  },
  "definitions": {
    "BatchOperationVO": {
      "type": "object",
      "description": "批量操作对象,只读。",
      "readOnly": true,
      "properties": {
        "id": {
          "type": "string",
          "description": "批量审批ID,ID字符串。"
        },
        "tenant_id": {
          "type": "string",
          "description": "项目ID。"
        },
        "group_id": {
          "type": "string",
          "description": "组ID,ID字符串。"
        },
        "biz_name": {
          "type": "string",
          "description": "业务名。"
        },
        "biz_id": {
          "type": "string",
          "description": "业务ID,ID字符串。"
        },
        "operation_status": {
          "type": "string",
          "description": "操作结果类型枚举。RUNNING(运行中)、SUCCESS(操作成功)、FAILED(操作失败)。\n枚举值:\n  - RUNNING: 运行中\n  - SUCCESS: 操作成功\n  - FAILED: 操作失败",
          "enum": [
            "RUNNING",
            "SUCCESS",
            "FAILED"
          ]
        },
        "operation_type": {
          "type": "string",
          "description": "类型。"
        },
        "biz_info": {
          "type": "string",
          "description": "业务详情。"
        },
        "create_by": {
          "type": "string",
          "description": "创建人。"
        },
        "remark": {
          "type": "string",
          "description": "remark信息。"
        },
        "total": {
          "type": "integer",
          "description": "总数。",
          "default": 0
        },
        "success": {
          "type": "integer",
          "description": "操作成功个数。",
          "default": 0
        },
        "failed": {
          "type": "integer",
          "description": "操作失败个数。",
          "default": 0
        },
        "rate": {
          "type": "string",
          "description": "当前进度。",
          "default": 0
        },
        "logs": {
          "type": "string",
          "description": "日志。"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BatchOperationVO"
          },
          "description": "分组信息。"
        }
      }
    },
    "ShowOperationResultVO": {
      "type": "object",
      "description": "查看逆向和逻辑模型转物理模型的转换结果。",
      "properties": {
        "data": {
          "type": "object",
          "description": "data,统一的返回结果的最外层数据结构。",
          "properties": {
            "value": {
              "type": "object",
              "description": "value,统一的返回结果的外层数据结构。",
              "$ref": "#/definitions/BatchOperationVO"
            }
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "limitParam": {
      "name": "limit",
      "in": "query",
      "description": "每页查询条数,即查询Y条数据。默认值50,取值范围[1,100]。",
      "required": false,
      "type": "integer",
      "format": "int32",
      "default": 50,
      "maximum": 100
    },
    "tenantIdParam": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
      "required": true,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "offsetParam": {
      "name": "offset",
      "in": "query",
      "description": "查询起始坐标,即跳过X条数据,仅支持0或limit的整数倍,不满足则向下取整,默认值0。",
      "required": false,
      "type": "integer",
      "format": "int32",
      "default": 0
    },
    "workspaceParam": {
      "name": "workspace",
      "in": "header",
      "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
      "required": true,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "tenantXIdParam": {
      "name": "X-Project-Id",
      "in": "header",
      "required": false,
      "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。\n\n多project场景采用AK/SK认证的接口请求,则该字段必选。",
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "tokenParam": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "IAM Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)\n使用Token认证时必选。",
      "required": true,
      "type": "string",
      "minLength": 0,
      "maxLength": 4096
    },
    "contextTypeParam": {
      "name": "Content-Type",
      "in": "header",
      "required": false,
      "description": "默认值:application/json;charset=UTF-8\n可选,有Body体的情况下必选,没有Body体则无需填写和校验。",
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "operationTypeParam": {
      "name": "operation_type",
      "in": "query",
      "description": "批量操作类型。\n枚举值:\n  - ER_REVERSE_DB: 关系建模逆向数据库\n  - TRANSFORM_LOGIC_MODEL: 逻辑模型转物理模型",
      "required": true,
      "type": "string",
      "enum": [
        "ER_REVERSE_DB",
        "TRANSFORM_LOGIC_MODEL"
      ]
    }
  },
  "host": "dayu.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}