          },
          {
            "$ref": "#/parameters/contextTypeParam"
          },
          {
            "name": "uuid",
            "in": "query",
            "type": "string",
            "required": true,
            "description": "请求导出接口时返回的uuid。"
          }
        ],
        "responses": {
          "200": {
            "description": "Success,返回data数据是DsProcessImportResultVO。",
            "schema": {
              "$ref": "#/definitions/DsExportResultVO"
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "$ref": "#/definitions/DsResponseVO"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/DsResponseVO"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/DsResponseVO"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "DsResponseVO": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "返回的数据信息。"
        }
      }
    },
    "DsExportResultVO": {
      "type": "object",
      "description": "导出返回结果。导出完成后返回二进制文件。",
      "properties": {
        "data": {
          "type": "object",
          "description": "导出结果对象。",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "importing",
                "fail",
                "success"
              ],
              "description": "标识本次导出的唯一值,用于查询导入结果。importing(导出中)、fail(导出失败)、success(导出成功)。\n枚举值:\n  - importing: 导出中\n  - fail: 导出失败\n  - success: 导出成功"
            },
            "group": {
              "$ref": "#/definitions/BatchOperationVO",
              "description": "分组信息,导出时可忽略。"
            },
            "rate": {
              "type": "string",
              "description": "当前进度。",
              "default": 0
            }
          }
        }
      },
      "example": {
        "data": {
          "status": "importing",
          "group": null,
          "rate": "0"
        }
      }
    },
    "BatchOperationVO": {
      "type": "object",
      "description": "批量操作对象,只读。",
      "readOnly": true,
      "properties": {
        "id": {
          "type": "string",
          "description": "批量审批ID,ID字符串。"
        },
        "tenant_id": {
