        },
        "remark": {
          "type": "string",
          "description": "remark信息。"
        },
        "total": {
          "type": "integer",
          "description": "总数。",
          "default": 0
        },
        "success": {
          "type": "integer",
          "description": "操作成功个数。",
          "default": 0
        },
        "failed": {
          "type": "integer",
          "description": "操作失败个数。",
          "default": 0
        },
        "rate": {
          "type": "string",
          "description": "当前进度。",
          "default": 0
        },
        "logs": {
          "type": "string",
          "description": "日志。"
        },
        "groups": {
          "type": "array",
