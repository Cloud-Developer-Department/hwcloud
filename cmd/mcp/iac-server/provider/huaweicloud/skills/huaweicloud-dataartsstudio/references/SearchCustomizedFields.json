              "description": "value,统一的返回结果的外层数据结构。",
              "properties": {
                "total": {
                  "type": "integer",
                  "format": "int32",
                  "description": "总量。"
                },
                "records": {
                  "type": "array",
                  "description": "CustomizedFieldsVO信息。",
                  "items": {
                    "$ref": "#/definitions/CustomizedFieldsVO"
                  }
                }
              }
            }
          }
        }
      }
    }
