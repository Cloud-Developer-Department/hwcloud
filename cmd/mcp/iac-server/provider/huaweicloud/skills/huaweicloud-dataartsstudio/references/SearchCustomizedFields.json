          "description": "编码,ID字符串。"
        },
        "name_ch": {
          "type": "string",
          "description": "自定义项中文名称。",
          "maxLength": 100
        },
        "name_en": {
          "type": "string",
          "description": "自定义项英文名称。",
          "maxLength": 100,
          "pattern": "^[a-zA-Z]+[a-zA-Z0-9:_\\s\\-]*$"
        },
        "not_null": {
          "type": "boolean",
          "description": "是否必填。"
        },
        "optional_values": {
          "type": "string",
          "description": "可选值。当可选值有多个时,用分号分隔。"
        },
        "type": {
          "type": "string",
          "enum": [
            "TABLE",
            "ATTRIBUTE",
            "SUBJECT",
            "METRIC"
          ],
          "description": "自定义项类型。\n枚举值:\n  - TABLE: 表自定义项\n  - ATTRIBUTE: 属性自定义项\n  - SUBJECT: 主题自定义项\n  - METRIC: 业务指标自定义项"
        },
        "ordinal": {
          "type": "integer",
          "description": "系统排序字段,新建、修改时不需要填写。"
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "自定义项描述。"
        },
        "create_by": {
          "type": "string",
          "readOnly": true,
          "description": "创建人,只读。"
        },
        "update_by": {
          "type": "string",
          "readOnly": true,
          "description": "更新人,只读。"
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "readOnly": true,
          "description": "创建时间,只读,格式遵循RFC3339,精确到秒,UTC时区,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z。"
        },
        "update_time": {
          "type": "string",
          "format": "date-time",
          "readOnly": true,
          "description": "更新时间,只读,格式遵循RFC3339,精确到秒,UTC时区,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z。"
        }
      }
    },
