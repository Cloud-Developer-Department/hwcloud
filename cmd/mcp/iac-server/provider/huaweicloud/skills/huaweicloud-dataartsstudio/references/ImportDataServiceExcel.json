{
  "name": "ImportDataServiceExcel",
  "summary": "导入包含API信息的excel文件",
  "tags": "API管理接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/service/import/excel": {
      "post": {
        "tags": [
          "API管理接口"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "dataservice-openapi",
        "summary": "导入包含API信息的excel文件",
        "description": "导入包含API信息的excel文件。",
        "operationId": "ImportDataServiceExcel",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,使用[Token认证](dataartsstudio_02_0010.xml)时必选。通过调用“获取用户Token”接口获取响应消息头中X-Subject-Token的值。",
            "required": true,
            "type": "string"
          },
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "Dlm-Type",
            "in": "header",
            "description": "数据服务的版本类型,指定SHARED共享版或EXCLUSIVE专享版。",
            "required": false,
            "type": "string",
            "enum": [
              "SHARED",
              "EXCLUSIVE"
            ]
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "消息体的类型(格式),此处为导入文件,取值为multipart/form-data。",
            "type": "string",
            "required": true,
            "default": "multipart/form-data"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "type": "file",
            "description": "导入包含api的excel文件,大小必须小于4MB。"
          }
        ],
        "x-request-examples-description-1": "上传api excel,通过form表单提交,file为具体excel文件。",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/{project_id}/service/import/excel",
        "responses": {
          "200": {
            "description": "导入excel成功。",
            "schema": {
              "$ref": "#/definitions/ExportResponseVO"
            },
            "examples": {
              "job_id": "252041f9838e8e5ea2e0e7317d5bcaf3"
            }
          },
          "400": {
            "description": "BadRequest。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DLS.1000",
          "minLength": 1,
          "maxLength": 128
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "process failed",
          "minLength": 1,
          "maxLength": 10240
        }
      }
    },
    "ExportResponseVO": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "返回的数据信息。",
          "example": "c45d49e062328b0287d7e3dd0b3941da"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dayu.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}