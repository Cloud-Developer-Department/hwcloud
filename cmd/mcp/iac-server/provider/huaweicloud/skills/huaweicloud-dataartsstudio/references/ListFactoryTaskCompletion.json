{
  "name": "ListFactoryTaskCompletion",
  "summary": "查询任务完成情况",
  "tags": "监控运维",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/factory/monitor/task-completion-data": {
      "get": {
        "tags": [
          "监控运维"
        ],
        "operationId": "ListFactoryTaskCompletion",
        "x-apiexplorer-hide": "false",
        "summary": "查询任务完成情况",
        "description": "查询任务完成情况",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/tenantIdParam"
          },
          {
            "name": "workspace",
            "in": "header",
            "required": false,
            "description": "工作空间ID",
            "type": "string"
          },
          {
            "name": "x-Auth-Token",
            "in": "header",
            "required": false,
            "description": "使用Token认证时该字段必须",
            "type": "string"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "查询任务的类型,默认为all,查询所有任务。\n类型有:Dummy、CDM Job、MRS Hive SQL、MRS Spark SQL、MRS Impala SQL、DLI SQL、DLI Spark、Python、DWS SQL、Shell、MRS ClickHouse、MRS HetuEngine",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "成功时,响应状态码为200",
            "schema": {
              "$ref": "#/definitions/ListFactoryTaskCompletionRes"
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DLF.20990",
                "error_msg": "Cannot perform the operation because the release package has been released."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ListFactoryTaskCompletionRes": {
      "type": "object",
      "properties": {
        "yesterday": {
          "items": {
            "properties": {
              "record_time": {
                "type": "integer",
                "format": "int64",
                "example": 1703779200000,
                "description": "整时的时间点"
              },
              "task_completion_num": {
                "type": "integer",
                "format": "int64",
                "example": 0,
                "description": "到当前时间点完成的任务数量"
              }
            }
          },
          "description": "昨天的任务信息",
          "type": "array"
        },
        "average": {
          "items": {
            "properties": {
              "record_time": {
                "type": "integer",
                "format": "int64",
                "example": 1703862000000,
                "description": "整时的时间点"
              },
              "task_completion_num": {
                "type": "integer",
                "format": "int64",
                "example": 40,
                "description": "到当前时间点完成的任务数量"
              }
            }
          },
          "description": "近7天的平均任务信息",
          "type": "array"
        },
        "today": {
          "items": {
            "properties": {
              "record_time": {
                "type": "integer",
                "format": "int64",
                "example": 1703822400000,
                "description": "整时的时间点"
              },
              "task_completion_num": {
                "type": "integer",
                "format": "int64",
                "example": 0,
                "description": "到当前时间点完成的任务数量"
              }
            }
          },
          "description": "当天的任务信息",
          "type": "array"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DLS.1000",
          "minLength": 1,
          "maxLength": 128
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "process failed",
          "minLength": 1,
          "maxLength": 10240
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "tenantIdParam": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
      "required": true,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    }
  },
  "host": "dayu.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}