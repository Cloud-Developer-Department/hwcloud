{
  "name": "ShowMessageDetail",
  "summary": "获取消息详情",
  "tags": "消息管理接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/service/messages/{message_id}": {
      "get": {
        "tags": [
          "消息管理接口"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "dataservice-openapi",
        "summary": "获取消息详情",
        "description": "获取消息详情。此功能仅用作信息详情展示,不用做业务处理,因此不展示编号等后台参数。",
        "operationId": "ShowMessageDetail",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,使用[Token认证](dataartsstudio_02_0010.xml)时必选。通过调用“获取用户Token”接口获取响应消息头中X-Subject-Token的值。",
            "required": true,
            "type": "string"
          },
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "Dlm-Type",
            "in": "header",
            "description": "数据服务的版本类型,指定SHARED共享版或EXCLUSIVE专享版。",
            "required": false,
            "type": "string",
            "enum": [
              "SHARED",
              "EXCLUSIVE"
            ]
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "消息体的类型(格式),有Body体的情况下必选,没有Body体无需填写。如果请求消息体中含有中文字符,则需要通过charset=utf8指定中文字符集,例如取值为:application/json;charset=utf8。",
            "type": "string",
            "required": true,
            "default": "application/json"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "message_id",
            "in": "path",
            "description": "消息信息id。",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success。",
            "schema": {
              "$ref": "#/definitions/RecordForApplyDetail"
            },
            "examples": {
              "application/json": {
                "id": null,
                "api_apply_status": "STATUS_TYPE_PASSED",
                "api_apply_type": "APPLY_TYPE_APPLY",
                "api_id": null,
                "api_name": "api_demo",
                "api_using_time": 1580452617000,
                "app_id": null,
                "app_name": "app_demo",
                "apply_time": 1578875421000,
                "approval_time": null,
                "approver_name": null,
                "comment": "通过",
                "user_name": "张三"
              }
            }
          },
          "400": {
            "description": "BadRequest。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
