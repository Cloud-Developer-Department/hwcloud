    "JobInstance": {
      "type": "object",
      "description": "作业实例信息",
      "properties": {
        "job_name": {
          "description": "作业名称。如果要查询指定批处理作业的实例列表,jobName就是批处理作业名。如果要查询实时作业下某个节点关联的子作业,jobName格式为[实时作业名称]_[节点名称]。",
          "type": "string"
        },
        "status": {
