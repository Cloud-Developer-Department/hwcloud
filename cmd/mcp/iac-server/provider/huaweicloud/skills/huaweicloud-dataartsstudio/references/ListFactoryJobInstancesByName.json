          "description": "作业实例运行时日志记录的实例名称, 非作业定义的名称",
          "type": "string"
        },
        "plan_time": {
          "description": "作业实例计划执行时间",
          "type": "integer",
          "format": "int64"
        },
        "start_time": {
          "description": "作业实例实际执行开始时间",
          "type": "integer",
          "format": "int64"
        },
        "end_time": {
          "description": "作业实例实际执行结束时间",
          "type": "integer",
          "format": "int64"
        },
        "execute_time": {
          "description": "执行耗时,单位:毫秒",
          "type": "integer",
          "format": "int64"
        },
        "instance_id": {
          "description": "作业实例id",
          "type": "integer",
          "format": "int64"
        },
        "instance_type": {
          "description": "作业实例类型",
          "type": "integer"
