          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目id",
            "pattern": "^[a-z0-9]{32}$"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "DataArtsStudio实例id",
            "pattern": "^[a-z0-9\\\\-]{32,36}$"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "分页记录数,默认20",
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "数据偏移量。默认0",
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 2147483647
          }
        ],
