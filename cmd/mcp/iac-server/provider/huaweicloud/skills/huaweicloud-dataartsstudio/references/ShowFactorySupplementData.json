  "definitions": {
    "SupplementDataResp": {
      "description": "This is a demo",
      "required": [
        "success",
        "total"
      ],
      "properties": {
        "msg": {
          "type": "string",
          "example": "success",
          "description": "success"
        },
        "rows": {
          "items": {
            "properties": {
              "end_date": {
                "type": "integer",
                "format": "int64",
                "example": 1691596799000,
                "description": "作业的开始日期 13位时间戳"
              },
              "job_list": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "job_0087"
                ],
                "description": "补数据作业名称,可能有依赖的作业,故会有多个作业的情况。"
              },
              "name": {
                "type": "string",
                "example": "P_job_0087_20230809_140427",
                "description": "补数据名称"
              },
              "parallel": {
                "type": "integer",
                "format": "int32",
                "example": 1,
                "description": "并行周期数,取值范围[1,5]"
              },
              "start_date": {
                "type": "integer",
                "format": "int64",
                "example": 1691510400000,
                "description": "作业的结束日期 13位时间戳"
              },
              "status": {
                "type": "string",
                "example": "SUCCESS",
                "description": "实例状态:SUCCESS:成功RUNNING :运行中CANCLE:取消"
              },
              "submitted_date": {
                "type": "integer",
                "format": "int64",
                "example": 1691560807214,
                "description": "作业提交时间,13位时间戳"
              },
              "supplement_data_instance_time": {
                "description": "支持补离散时间任务",
                "properties": {
                  "days": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "支持离散的天"
                  },
                  "time_of_day": {
                    "type": "string",
                    "description": "一天中的时间段"
                  }
                }
              },
              "supplement_data_run_time": {
                "description": "补数据时间段,当前仅支持每天,如果没有补数据时间,则默认为\"00:00-00:00”",
                "properties": {
                  "time_of_day": {
                    "type": "string",
                    "example": "00:00-00:00",
                    "description": "每天的可补数据时间段,如:每天的10点15分到23点30分,表示:10:15-23:30"
                  },
                  "day_of_week": {
                    "type": "string",
                    "description": "每周的星期几可以补数据,如:每周一,周三的每天10点15分到23点30分"
                  },
                  "day_of_month": {
                    "type": "string",
                    "description": "每个月的哪几天可以补数据,如每月1号,3号,表示:1,3"
                  }
                }
              },
              "type": {
                "type": "integer",
                "format": "int32",
                "example": 0,
                "description": "触发补数据的类型,取值范围[0, 1]。0代表作业监控界面触发的补数据,1代表恢复动作触发的补数据"
              },
              "user_name": {
                "type": "string",
                "example": "ei_dlf_l00341563",
                "description": "用户名称"
              }
            }
          },
          "description": "包含若干补数据实例信息",
          "type": "array"
        },
        "success": {
          "type": "boolean",
          "example": true,
          "description": "查询是否成功,取值为true或者false"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "example": 17,
          "description": "补数据实例数量"
        }
      },
      "type": "object"
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
