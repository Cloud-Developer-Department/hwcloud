        "create_by": {
          "type": "string",
          "description": "创建人"
        },
        "update_by": {
          "type": "string",
          "description": "更新人"
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "readOnly": true,
          "description": "创建时间"
        },
        "update_time": {
          "type": "string",
          "format": "date-time",
          "readOnly": true,
          "description": "更新时间,只读,格式遵循RFC3339,精确到秒,UTC时区,即yyyy-mm-ddTHH:MM:SSZ,如1970-01-01T00:00:00Z。"
        },
