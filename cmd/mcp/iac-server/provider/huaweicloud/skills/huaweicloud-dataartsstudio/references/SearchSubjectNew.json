        "data_owner": {
          "type": "string",
          "description": "数据owner。",
          "maxLength": 256,
          "pattern": "^[^\\\\<>]*$"
        },
        "data_owner_list": {
          "type": "string",
          "description": "数据所有者集合。",
          "pattern": "^[^\\\\<>]*$"
        },
        "data_department": {
          "type": "string",
          "description": "数据域。"
        },
        "path": {
          "type": "string",
          "description": "路径信息。"
        },
        "level": {
          "type": "integer",
          "description": "层级信息。"
        },
        "ordinal": {
          "type": "integer",
          "description": "序号。"
        },
        "owner": {
          "type": "string",
          "description": "责任人",
          "maxLength": 4000
        },
        "parent_id": {
          "type": "integer",
          "format": "int64",
          "description": "父目录ID,木有则为根目录,ID字符串。"
        },
        "swap_order_id": {
          "type": "integer",
          "format": "int64",
          "description": "同层排序,目标节点的ID,ID字符串。"
        },
        "id": {
          "type": "string",
          "description": "主题ID,ID字符串。"
        },
        "qualified_id": {
          "type": "string",
          "description": "认证ID,自动生成"
