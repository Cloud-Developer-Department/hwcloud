        "children": {
          "type": "array",
          "readOnly": true,
          "description": "下层子目录,只读。",
          "items": {
            "$ref": "#/definitions/CatalogVO"
          },
          "maxItems": 7
        },
        "self_defined_fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SelfDefinedFieldVO"
          },
          "maxItems": 10,
          "description": "属性自定义项。"
        },
        "relations": {
          "type": "array",
          "description": "关系",
          "items": {
            "$ref": "#/definitions/RelationVO"
          },
          "maxItems": 100
