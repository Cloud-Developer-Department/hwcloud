  "definitions": {
    "RelationType": {
      "type": "string",
      "description": "关系类型,只读。\n枚举值:\n  - ONE: 表示每条子(父)逻辑实体数据在父(子)逻辑实体中有且只有一条数据与之对应。\n  - ZERO_OR_ONE: 表示每条子(父)逻辑实体数据在父(子)逻辑实体中最多有一条数据与之对应。\n  - ZERO_OR_N: 表示每条子(父)逻辑实体数据在父(子)逻辑实体中可能有多条数据与之对应。\n  - ONE_OR_N: 表示每条子(父)逻辑实体数据在父(子)逻辑实体中至少有一条数据与之对应。",
      "readOnly": true,
      "enum": [
        "ONE",
        "ZERO_OR_ONE",
        "ZERO_OR_N",
        "ONE_OR_N"
      ]
    },
    "CatalogVO": {
      "type": "object",
      "description": "主题目录。",
      "required": [
        "name_ch",
        "level",
        "data_owner_list"
      ],
      "properties": {
        "name_ch": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\\\<>]*$",
          "description": "中文名称。"
        },
        "name_en": {
          "type": "string",
          "maxLength": 100,
          "description": "英文名称。",
          "pattern": "^[a-zA-Z\\d\\s&\\(\\)_\\-]*$"
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "描述信息。",
          "pattern": "^[^\\\\\\\\]*$"
        },
        "qualified_name": {
          "type": "string",
          "readOnly": true,
          "description": "对象标识。"
        },
        "guid": {
          "type": "string",
          "readOnly": true,
          "description": "guid,自动生成。"
        },
        "code": {
          "type": "string",
          "maxLength": 100,
          "description": "编码。",
          "pattern": "^[a-zA-Z\\d\\s&\\(\\)_\\-]*$"
        },
        "alias": {
          "type": "string",
          "maxLength": 200,
          "description": "别名。",
          "pattern": "^[^\\\\<>]*$"
        },
        "status": {
          "$ref": "#/definitions/BizStatusEnum"
        },
        "permission": {
          "type": "integer",
          "readOnly": true
        },
