{
  "name": "ListCatalogList",
  "summary": "获取当前目录下的目录列表(全量)",
  "tags": "服务目录管理接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/service/servicecatalogs/{catalog_id}/catalogs": {
