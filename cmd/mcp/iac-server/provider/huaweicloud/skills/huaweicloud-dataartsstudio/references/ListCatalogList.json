        "tags": [
          "服务目录管理接口"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "dataservice-openapi",
        "summary": "获取当前目录下的目录列表(全量)",
        "description": "获取当前目录下的目录列表(全量数据,不分页,推荐仅用于生成目录树等无法分页的场景)。",
        "operationId": "ListCatalogList",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,使用[Token认证](dataartsstudio_02_0010.xml)时必选。通过调用“获取用户Token”接口获取响应消息头中X-Subject-Token的值。",
            "required": true,
            "type": "string"
          },
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "Dlm-Type",
            "in": "header",
            "description": "数据服务的版本类型,指定SHARED共享版或EXCLUSIVE专享版。",
            "required": false,
            "type": "string",
            "enum": [
              "SHARED",
              "EXCLUSIVE"
            ]
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "消息体的类型(格式),有Body体的情况下必选,没有Body体无需填写。如果请求消息体中含有中文字符,则需要通过charset=utf8指定中文字符集,例如取值为:application/json;charset=utf8。",
            "type": "string",
            "required": true,
            "default": "application/json"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "catalog_id",
            "in": "path",
            "description": "目录编号。",
            "required": true,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "limit。",
            "type": "integer"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "offset。",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Success。",
            "schema": {
              "$ref": "#/definitions/ResultForGetOnlyCatalog"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "catalogs": [
                  {
                    "catalog_id": "2847131b4d5a26c5bd4bfd9d8f63f577",
                    "pid": "8c9850726a1ee050be2b67e43c688870",
                    "name": "demo",
                    "description": "this is a demo",
                    "api_catalog_type": "CATALOG",
                    "create_time": 1578284788000,
                    "create_user": "张三",
                    "update_time": 1578284788000,
                    "update_user": "张三"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "BadRequest。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DLS.1000",
          "minLength": 1,
          "maxLength": 128
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "process failed",
          "minLength": 1,
          "maxLength": 10240
        }
      }
    },
    "ResultForGetOnlyCatalog": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "description": "符合条件的数据总数",
          "example": 1
        },
        "catalogs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RecordForGetAllCatalog"
          },
          "description": "本次返回的APP列表"
        }
      }
    },
    "RecordForGetAllCatalog": {
      "type": "object",
      "properties": {
        "catalog_id": {
          "type": "string",
