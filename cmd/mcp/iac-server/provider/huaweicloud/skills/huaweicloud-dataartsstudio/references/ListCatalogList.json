        },
        "pid": {
          "type": "string",
          "description": "父目录编号",
          "example": "8c9850726a1ee050be2b67e43c688870"
        },
        "name": {
          "type": "string",
          "description": "名称",
          "example": "demo"
        },
        "description": {
          "type": "string",
          "description": "目录描述",
          "example": "this is a demo"
        },
        "api_catalog_type": {
          "type": "string",
          "description": "目录类型",
          "enum": [
            "CATALOG",
            "API"
          ]
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间",
          "example": 1578284788000
        },
        "create_user": {
          "type": "string",
          "description": "创建者",
          "example": "张三"
        },
        "update_time": {
          "type": "integer",
          "format": "int64",
          "description": "更新时间",
          "example": 1578284788000
        },
        "update_user": {
          "type": "string",
          "description": "更新者",
          "example": "张三"
        }
      }
    }
  },
  "version": "2.0",
