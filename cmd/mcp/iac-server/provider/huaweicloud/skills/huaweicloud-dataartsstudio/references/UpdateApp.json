{
  "name": "UpdateApp",
  "summary": "更新应用",
  "tags": "应用管理接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/service/apps/{app_id}": {
      "put": {
        "tags": [
          "应用管理接口"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "dataservice-openapi",
        "summary": "更新应用",
        "description": "更新应用。",
        "operationId": "UpdateApp",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,使用[Token认证](dataartsstudio_02_0010.xml)时必选。通过调用“获取用户Token”接口获取响应消息头中X-Subject-Token的值。",
            "required": true,
            "type": "string"
          },
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "Dlm-Type",
            "in": "header",
            "description": "数据服务的版本类型,指定SHARED共享版或EXCLUSIVE专享版。",
            "required": false,
            "type": "string",
            "enum": [
              "SHARED",
              "EXCLUSIVE"
            ]
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "消息体的类型(格式),有Body体的情况下必选,没有Body体无需填写。如果请求消息体中含有中文字符,则需要通过charset=utf8指定中文字符集,例如取值为:application/json;charset=utf8。",
            "type": "string",
            "required": true,
            "default": "application/json"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "app_id",
            "in": "path",
            "description": "应用编号。",
            "required": true,
            "type": "string"
          },
          {
            "name": "UpdateAppRequestBody",
            "in": "body",
            "description": "更新应用相关参数。",
            "schema": {
              "$ref": "#/definitions/AppUpdateDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success。",
            "schema": {
              "$ref": "#/definitions/AppReturnDTO"
            },
            "examples": {
              "application/json": {
                "id": "908489209a320df61607355c57c82882",
                "name": "app_test_001",
                "description": "This is the app's description.",
                "app_key": "fbbf9462bb434cb4a13ee7d2bb70c418",
                "app_secret": "c1245f01937442e098ffa6ff134cb3dc",
                "register_time": 1578284788000,
                "update_time": 1578284788000,
                "create_user": "create_user",
                "update_user": "update_user",
                "app_type": "APP"
              }
            }
          },
          "400": {
            "description": "BadRequest。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
