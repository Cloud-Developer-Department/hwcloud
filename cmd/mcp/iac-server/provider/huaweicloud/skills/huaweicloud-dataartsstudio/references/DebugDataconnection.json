{
  "name": "DebugDataconnection",
  "summary": "测试创建数据连接",
  "tags": "数据连接管理接口",
  "productshort": "DataArtsStudio",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/data-connections/validation": {
      "post": {
        "x-is-registered": "Y",
        "tags": [
          "数据连接管理接口"
        ],
        "x-support-sdk": "Y",
        "summary": "测试创建数据连接",
        "description": "测试创建数据连接",
        "operationId": "DebugDataconnection",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "IAM Token",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 4096
          },
          {
            "name": "workspace",
            "in": "header",
            "required": true,
            "description": "工作空间id",
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "in": "body",
            "name": "dataSourceVO",
            "description": "数据源连接信息",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ApigDataSourceVo"
            }
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "required": true,
            "type": "string",
            "pattern": "^[a-z0-9]{32}$"
          }
        ],
        "responses": {
          "200": {
            "description": "Success,测试创建数据连接成功"
          },
          "400": {
            "$ref": "#/definitions/DayuException"
          },
          "500": {
            "$ref": "#/definitions/DayuException"
          }
        },
        "x-order": 8
      }
    }
  },
  "definitions": {
    "ApigDataSourceVo": {
      "type": "object",
      "description": "创建据连接结构体信息",
      "required": [
        "dw_name",
        "dw_type",
        "dw_config"
      ],
      "properties": {
        "dw_name": {
          "type": "string",
          "description": "数据连接名称",
          "maxLength": 128,
          "minLength": 1
        },
        "dw_type": {
          "type": "string",
          "description": "数据连接类型",
          "maxLength": 128,
          "minLength": 1
        },
        "dw_config": {
          "type": "object",
          "description": "连接动态变化配置项,每种连接略有区别,建议在界面进行调试"
        },
        "agent_id": {
          "type": "string",
          "description": "代理id(若使用代理连接则必填)",
          "pattern": "^[a-z0-9\\-]{36}$"
        },
        "agent_name": {
          "type": "string",
          "description": "代理名称id(若使用代理连接则必填)",
          "maxLength": 128,
          "minLength": 1
        },
        "env_type": {
          "type": "integer",
          "description": "0:开发模式 1:生产模式。默认为0",
          "maximum": 1,
          "minimum": 0
        },
        "supportService": {
          "type": "integer",
          "description": "1:cdm 2:数据架构 4:数据开发 8:数据质量 16:数据目录 32:数据安全 64:数据服务",
          "maximum": 127,
          "minimum": 1
        },
        "dw_category": {
          "type": "string",
          "description": "标签信息",
          "maxLength": 128,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "连接描述信息",
          "maxLength": 4096,
          "minLength": 1
        }
      },
      "example": {
        "dw_config": {
          "cluster_id": "353ff458-a560-413e-9b84-33f930cb8057",
          "cluster_name": "mrs_3x_autotest_do_not_del",
          "ns_user_name": "xinfeng",
          "ns_password": "xxxx",
          "kms_id": "a721616c-9a12-47b1-a805-3cfcd3e63cd7",
          "kms_name": "KMS-1111"
        },
        "dw_type": "HBASE",
        "dw_name": "test_hbase_01",
        "agent_id": "91f81a12-75c5-43ce-aab8-7149ecef3b17",
        "agent_name": "cdm-4autotest-nodelete"
      }
    },
    "DayuException": {
      "type": "object",
      "description": "dayu异常返回体",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误信息",
          "maxLength": 1024,
          "minLength": 1
        },
        "error_code": {
          "type": "string",
          "description": "dayu异常码",
          "maxLength": 1024,
          "minLength": 1
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dayu.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}