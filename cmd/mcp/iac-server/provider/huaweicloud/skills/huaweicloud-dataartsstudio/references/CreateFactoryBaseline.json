  "definitions": {
    "PeriodObject": {
      "type": "object",
      "required": [
        "period_num",
        "period_time"
      ],
      "properties": {
        "period_num": {
          "type": "integer",
          "format": "int32",
          "description": "周期,取值为1到24。"
        },
        "period_time": {
          "type": "string",
          "description": "小时:分钟,样例:00:59"
        }
      }
    },
    "SmnTopicRequest": {
      "type": "object",
      "required": [
        "name",
        "urn",
        "notify_method",
        "max_send_times",
        "send_interval"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "null",
          "description": "主题名称。"
        },
        "urn": {
          "type": "string",
          "example": "null",
          "description": "smn urn,可以在SMN服务查看对应主题的urn。"
        },
        "notify_method": {
          "type": "string",
          "example": "DUTY_SCHEDULE",
          "description": "告警方式:主题、责任人、值班表和钉钉机器人,取值如下:\n- SUBJECT: 主题\n- OWNER: 责任人\n- DUTY_SCHEDULE: 值班表\n- DINGDING: 钉钉机器人"
        },
        "protocol": {
          "type": "string",
          "example": "[\"sms\",\"email\",\"callnotify\"]",
          "description": "告警协议:短信、邮件、电话,示例:[\"email\"] \"email\":邮件传输协议,\"sms\":短信传输协议,\"callnotify\":语音, \"dingding\":个人钉钉。"
        },
        "other_persons": {
          "type": "string",
          "example": "null",
          "description": "抄送人,示例:[\"lin\",\"hua\"]。"
        },
        "max_send_times": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "最大告警次数,取值为 [1, 50]。"
        },
        "send_interval": {
          "type": "integer",
          "format": "int32",
          "example": 60,
          "description": "告警间隔,取值为[5, 60],单位:分钟。"
        },
        "duty_schedule_name": {
          "type": "string",
          "example": "444",
          "description": "值班表名称。"
        },
        "smn_config_name": {
          "type": "string",
          "example": "null",
          "description": "机器人名称。"
        }
      }
    },
    "CreateBaselineRequest": {
      "type": "object",
      "required": [
        "workspace_id",
        "name",
        "owner_name",
        "type",
        "sla_task_ids",
        "priority",
        "buffer",
        "enable",
        "alarm_enable",
        "sign_enable",
        "sla_hour",
        "sla_min",
        "baseline_alarm_enable"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "example": "62fbba734e634c5087656fc3ff7adf34",
          "description": "工作空间ID。"
        },
        "name": {
          "type": "string",
          "example": "3333334454",
          "description": "基线任务名称。只能包含:英文字母、数字、中文、中划线、下划线和点号,且长度不超过128位。"
        },
        "owner_name": {
          "type": "string",
          "example": "zhuangzhaodian",
          "description": "责任人用户名称。"
        },
        "type": {
          "type": "string",
          "example": "DAY",
          "description": "基线任务类型。取值为 DAY和HOUR。"
        },
        "sla_task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "935280"
          ],
          "description": "保障作业ID列表。"
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "example": 3,
          "description": "优先级,取值范围是1到5。"
        },
        "buffer": {
          "type": "integer",
          "format": "int32",
          "example": 3600000,
          "description": "预警余量。单位毫秒,取值范围在0到86400000之间,且必须是整数分钟级别的毫秒。"
        },
        "enable": {
          "type": "boolean",
          "example": true,
          "description": "是否生效,取值为true或者false。默认为true。"
        },
        "alarm_enable": {
          "type": "boolean",
          "example": true,
          "description": "报警是否打开,取值为true或者false,默认为true。"
        },
        "sign_enable": {
          "type": "boolean",
          "example": false,
          "description": "基线签署是否打开,取值为true或者false。默认为false。"
        },
        "sla_hour": {
          "type": "string",
          "example": "00",
          "description": "天基线承诺小时。"
        },
        "sla_min": {
          "type": "string",
          "example": "00",
          "description": "天基线承诺分钟。"
        },
        "baseline_alarm_enable": {
          "type": "boolean",
          "example": true,
          "description": "基线报警是否打开,取值为true或者false。"
        },
        "smn_topics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SmnTopicRequest"
          },
          "description": "SMN主题列表。"
        },
        "event_smn_topics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SmnTopicRequest"
          },
          "description": "事件报警信息。"
        },
        "event_alarm": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [],
          "description": "事件告警开启类型,取值为ERROR:出错,SLOW_DOWN:变慢。"
        },
        "period": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PeriodObject"
          },
          "description": "当type取值为HOUR时,该值需要填写。"
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "tenantXIdParam": {
      "name": "X-Project-Id",
      "in": "header",
      "required": false,
      "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。\n\n多project场景采用AK/SK认证的接口请求,则该字段必选。",
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "tenantIdParam": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参见[项目ID和账号ID](projectid_accountid.xml)。",
      "required": true,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "tokenParam": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "IAM Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)\n使用Token认证时必选。",
      "required": true,
      "type": "string",
      "minLength": 0,
      "maxLength": 4096
    },
    "contextTypeParam": {
      "name": "Content-Type",
      "in": "header",
      "required": false,
      "description": "默认值:application/json;charset=UTF-8\n可选,有Body体的情况下必选,没有Body体则无需填写和校验。",
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "instanceIdParam": {
      "name": "instance_id",
      "in": "path",
      "required": true,
      "description": "DataArts Studio实例ID。",
      "type": "string"
    },
    "workspaceParam": {
      "name": "workspace",
      "in": "header",
      "description": "工作空间ID,获取方法请参见[实例ID和工作空间ID](dataartsstudio_02_0350.xml)。",
      "required": true,
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    }
  },
  "host": "dayu.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
