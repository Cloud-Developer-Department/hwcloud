{
  "name": "ShowLogConfig",
  "summary": "查询全量日志设置",
  "tags": "DDoS防护管理",
  "productshort": "Anti-DDoS",
  "region_id": "la-north-2",
  "paths": {
    "/v1/{project_id}/antiddos/lts-config": {
      "get": {
        "tags": [
          "DDoS防护管理"
        ],
        "summary": "查询全量日志设置",
        "operationId": "ShowLogConfig",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "description": "查询全量日志设置",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8",
            "description": "Content-Type请求头"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目id",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "examples": {
              "application/json": {
                "enabled": true,
                "lts_id_info": {
                  "lts_group_id": "3f664a8c-53bd-4f77-922d-xxxxxxxxxxxx",
                  "lts_attack_stream_id": "ea9ffec3-6fe4-4884-9dd0-xxxxxxxxxxxx"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/LtsConfigRequestAndResponse"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {}
          },
          "403": {
            "description": "Forbidden",
            "schema": {}
          },
          "404": {
            "description": "Not Found",
            "schema": {}
          }
        }
      }
    }
  },
  "definitions": {
    "LtsConfigRequestAndResponse": {
      "type": "object",
      "description": "日志配置请求",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "是否开启日志"
        },
        "lts_id_info": {
          "properties": {
            "lts_group_id": {
              "type": "string",
              "description": "日志组id"
            },
            "lts_attack_stream_id": {
              "type": "string",
              "description": "日志流id"
            }
          },
          "description": "日志信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "antiddos.la-north-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}