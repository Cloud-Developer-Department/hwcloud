    "TriggerBpsDict": {
      "type": "object",
      "required": [
        "traffic_pos_id",
        "traffic_per_second",
        "packet_per_second"
      ],
      "description": "流量限制列表",
      "properties": {
        "traffic_pos_id": {
          "type": "integer",
          "format": "int64",
          "description": "流量分段ID,取值范围:1:10M;2:30M;3:50M;4:70M;5:100M;6:150M;7:200M;8:250M;9:300M;10:500M;11:800M;88:1000M;99:默认防护。"
        },
        "traffic_per_second": {
          "type": "integer",
          "format": "int64",
          "description": "每秒流量(Mbit/s)阈值"
        },
        "packet_per_second": {
          "type": "integer",
          "format": "int64",
          "description": "每秒报文数(个/s)阈值"
        }
      }
    },
    "CleanLimitDict": {
      "type": "object",
      "required": [
        "cleaning_access_pos_id",
        "new_connection_limited",
        "total_connection_limited"
      ],
      "description": "连接数限制列表",
      "properties": {
        "cleaning_access_pos_id": {
          "type": "integer",
          "format": "int64",
          "description": "清洗时访问限制分段ID,取值范围:1:10M;2:30M;3:50M;4:70M;5:100M;6:150M;7:200M;8:250M;9:300M;10:500M;11:800M;88:1000M;99:默认防护。"
        },
        "new_connection_limited": {
          "type": "integer",
          "format": "int64",
          "description": "单一源IP新建连接个数"
        },
        "total_connection_limited": {
          "type": "integer",
          "format": "int64",
          "description": "单一源IP连接数总个数"
        }
      }
    },
    "TriggerQpsDict": {
      "type": "object",
      "required": [
        "http_request_pos_id",
        "http_packet_per_second"
      ],
      "description": "HTTP限制列表",
      "properties": {
        "http_request_pos_id": {
          "type": "integer",
          "format": "int64",
          "description": "HTTP请求数分段ID,固定值为1"
        },
        "http_packet_per_second": {
          "type": "integer",
          "format": "int64",
          "description": "每秒HTTP请求数(个/s)阈值"
        }
      }
    },
    "ExtendDDoSSet": {
      "type": "object",
      "required": [
