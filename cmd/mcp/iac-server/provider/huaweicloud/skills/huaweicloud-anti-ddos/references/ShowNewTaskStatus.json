{
  "name": "ShowNewTaskStatus",
  "summary": "查询Anti-DDoS任务",
  "tags": "DDoS任务管理",
  "productshort": "Anti-DDoS",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/{project_id}/query-task-status": {
      "get": {
        "tags": [
          "DDoS任务管理"
        ],
        "summary": "查询Anti-DDoS任务",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "description": "用户查询指定的Anti-DDoS防护配置任务,得到任务当前执行的状态。",
        "operationId": "ShowNewTaskStatus",
        "consumes": [
          "multipart/form-data",
          "application/x-www-form-urlencoded"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8",
            "minLength": 1,
            "maxLength": 255,
            "description": "Content-Type请求头"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目id",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "task_id",
            "in": "query",
            "description": "任务ID(非负整数)的字符串",
            "required": true,
            "minLength": 32,
            "maxLength": 64,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "examples": {
              "application/json": {
                "task_status": "success",
                "task_msg": ""
              }
            },
            "schema": {
              "$ref": "#/definitions/TaskStatusResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "TaskStatusResp": {
      "type": "object",
      "required": [
        "task_status",
        "task_msg"
      ],
      "description": "任务状态响应体",
      "properties": {
        "task_status": {
          "type": "string",
          "enum": [
            "success",
            "failed",
            "waiting",
            "running",
            "preprocess",
            "ready"
          ],
          "description": "任务状态,可选范围:\n- success: 表示成功\n- failed: 表示失败\n- waiting: 表示等待\n- running: 表示运行中\n- preprocess: 表示预处理\n- ready: 表示准备"
        },
        "task_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "任务的附加信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "antiddos.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}