{
  "name": "ListDailyReport",
  "summary": "查询指定EIP防护流量",
  "tags": "DDoS防护管理",
  "productshort": "Anti-DDoS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/{project_id}/antiddos/{floating_ip_id}/daily": {
      "get": {
        "tags": [
          "DDoS防护管理"
        ],
        "summary": "查询指定EIP防护流量",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "description": "查询指定EIP在过去24小时之内的防护流量信息,流量的间隔时间单位为5分钟。",
        "operationId": "ListDailyReport",
        "consumes": [
          "multipart/form-data",
          "application/x-www-form-urlencoded"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8",
            "minLength": 1,
            "maxLength": 255,
            "description": "Content-Type请求头"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目id",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "floating_ip_id",
            "in": "path",
            "description": "用户EIP对应的ID",
            "required": true,
            "minLength": 32,
            "maxLength": 64,
            "type": "string"
          },
          {
            "name": "ip",
            "in": "query",
            "description": "用户EIP",
            "required": false,
            "minLength": 7,
            "maxLength": 128,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "examples": {
              "application/json": {
                "data": [
                  {
                    "period_start": 1606188642720,
                    "bps_in": 0,
                    "bps_attack": 0,
                    "total_bps": 0,
                    "pps_in": 0,
                    "pps_attack": 0,
                    "total_pps": 0
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/DailyReport"
            }
          }
        },
        "x-order": 5
      }
    }
  },
  "definitions": {
    "DailyReport": {
      "type": "object",
      "required": [
        "data"
      ],
      "description": "EIP防护流量响应体",
      "properties": {
        "data": {
          "type": "array",
          "minItems": 288,
          "maxItems": 288,
          "description": "24小时内的流量数据",
          "items": {
            "$ref": "#/definitions/DailyData"
          }
        }
      }
    },
    "DailyData": {
      "type": "object",
      "required": [
        "period_start",
        "bps_in",
        "bps_attack",
        "total_bps",
        "pps_in",
        "pps_attack",
        "total_pps"
      ],
      "description": "EIP防护流量响应体",
      "properties": {
        "period_start": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 9999999999999,
          "description": "开始时间"
        },
        "bps_in": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "入流量(bit/s)"
        },
        "bps_attack": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "攻击流量(bit/s)"
        },
        "total_bps": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "总流量"
        },
        "pps_in": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "入报文速率(个/s)"
        },
        "pps_attack": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "攻击文速率(个/s)"
        },
        "total_pps": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "总报文速率"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "antiddos.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}