{
  "name": "ListQuota",
  "summary": "查询配额",
  "tags": "DDoS防护管理",
  "productshort": "Anti-DDoS",
  "region_id": "me-east-1",
  "paths": {
    "/v1/{project_id}/antiddos/quotas": {
      "get": {
        "tags": [
          "DDoS防护管理"
        ],
        "summary": "查询配额",
        "operationId": "ListQuota",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "description": "查询配额",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8",
            "description": "Content-Type请求头"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目id",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "ddos_quota": {
                  "current": 3,
                  "quota": 350
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/QuotaResponse"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {}
          },
          "403": {
            "description": "Forbidden",
            "schema": {}
          },
          "404": {
            "description": "Not Found",
            "schema": {}
          }
        }
      }
    }
  },
  "definitions": {
    "QuotaResponse": {
      "type": "object",
      "description": "配额",
      "properties": {
        "ddos_quota": {
          "description": "配额信息",
          "properties": {
            "current": {
              "type": "integer",
              "format": "int32",
              "description": "当前用户已使用配额"
            },
            "quota": {
              "type": "integer",
              "format": "int32",
              "description": "最大配额"
            }
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "antiddos.me-east-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
