          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目id",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
