  "definitions": {
    "UpdateAlertConfigRequestBody": {
      "type": "object",
      "required": [
        "display_name",
        "topic_urn",
        "warn_config"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "告警群组描述。"
        },
        "topic_urn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "告警群组的唯一标识。"
        },
        "warn_config": {
          "$ref": "#/definitions/WarnConfig"
        }
      },
      "example": {
        "display_name": "",
        "topic_urn": "8",
        "warn_config": {
          "antiDDoS": false,
          "back_doors": false,
          "bruce_force": false,
          "high_privilege": false,
          "remote_login": false,
          "send_frequency": 10,
          "waf": false,
          "weak_password": false
        }
      }
    },
    "WarnConfig": {
      "type": "object",
      "required": [
        "antiDDoS"
      ],
      "description": "告警配置信息。",
      "properties": {
        "antiDDoS": {
          "type": "boolean",
          "description": "DDoS攻击"
        },
        "back_doors": {
          "type": "boolean",
          "description": "网页后门"
        },
        "bruce_force": {
          "type": "boolean",
          "description": "暴力破解(系统登录,FTP,DB)"
        },
        "high_privilege": {
          "type": "boolean",
          "description": "数据库进程权限过高"
        },
        "remote_login": {
          "type": "boolean",
          "description": "异地登录提醒"
        },
        "send_frequency": {
          "type": "integer",
          "format": "int32",
          "enum": [
            0,
            1
          ],
          "description": "取值范围:\n- 0:表示每天一次\n- 1:表示半小时一次\n\n对于HID必选。"
        },
        "waf": {
          "type": "boolean",
          "description": "保留字段"
        },
        "weak_password": {
          "type": "boolean",
          "description": "弱口令(系统,数据库)"
        }
      }
    },
    "NormalResp": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg",
        "task_id"
      ],
      "description": "普通请求响应体",
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "内部错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "内部错误描述"
        }
      }
    }
  },
