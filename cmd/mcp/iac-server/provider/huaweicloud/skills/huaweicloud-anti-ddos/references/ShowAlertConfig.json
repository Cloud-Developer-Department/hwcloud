{
  "name": "ShowAlertConfig",
  "summary": "查询告警配置信息",
  "tags": "告警配置管理",
  "productshort": "Anti-DDoS",
  "region_id": "sa-brazil-1",
  "paths": {
    "/v2/{project_id}/warnalert/alertconfig/query": {
      "get": {
        "tags": [
          "告警配置管理"
        ],
        "summary": "查询告警配置信息",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "description": "查询用户配置信息,用户可以通过此接口查询是否接收某类告警,同时可以配置是手机短信还是电子邮件接收告警信息。",
        "operationId": "ShowAlertConfig",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8",
            "minLength": 1,
            "maxLength": 255,
            "description": "Content-Type请求头"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目id",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "examples": {
              "application/json": {
                "warn_config": {
                  "antiDDoS": false,
                  "bruce_force": false,
                  "remote_login": false,
                  "weak_password": false,
                  "high_privilege": false,
                  "back_doors": false,
                  "waf": false,
                  "send_frequency": 0
                },
                "topic_urn": null,
                "display_name": null
              }
            },
            "schema": {
              "$ref": "#/definitions/AlertConfigResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "AlertConfigResp": {
      "type": "object",
      "required": [
        "topic_urn",
        "display_name",
        "warn_config"
      ],
      "description": "任务状态响应体",
      "properties": {
        "topic_urn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "告警群组的唯一标识"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "告警群组描述"
        },
        "warn_config": {
          "type": "object",
          "required": [
            "antiDDoS"
          ],
          "description": "告警配置信息",
          "properties": {
            "antiDDoS": {
              "type": "boolean",
              "description": "DDoS攻击"
            },
            "back_doors": {
              "type": "boolean",
              "description": "网页后门"
            },
            "bruce_force": {
              "type": "boolean",
              "description": "暴力破解(系统登录,FTP,DB)"
            },
            "high_privilege": {
              "type": "boolean",
              "description": "数据库进程权限过高"
            },
            "remote_login": {
              "type": "boolean",
              "description": "异地登录提醒"
            },
            "send_frequency": {
              "type": "integer",
              "format": "int32",
              "enum": [
                0,
                1
              ],
              "description": "取值范围:\n- 0:表示每天一次\n- 1:表示半小时一次\n\n对于HID必选。"
            },
            "waf": {
              "type": "boolean",
              "description": "保留字段"
            },
            "weak_password": {
              "type": "boolean",
              "description": "弱口令(系统,数据库)"
            }
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "antiddos.sa-brazil-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}