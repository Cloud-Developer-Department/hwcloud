  "paths": {
    "/v1/{project_id}/qabots/{qabot_id}/requests": {
      "post": {
        "tags": [
          "其他问答API"
        ],
        "summary": "PostRequests",
        "description": "问答服务的输入为用户提问,输出是与输入最匹配的Top N(默认为top5)个知识点,知识点按得分从高到低排序。\n\n说明: \n返回知识点如果含有答案字段(answer),则表示返回匹配成功结果,如果没有答案字段,则表示推荐结果。",
        "operationId": "PostRequests",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "来自公有云的Project ID,用于资源隔离。",
            "required": true,
            "type": "string",
            "x-order": 1
          },
          {
            "name": "qabot_id",
            "in": "path",
            "description": "qabot编号,UUID格式,如:303a0a00-c88a-43e3-aa2f-d5b8b9832b02。",
            "required": true,
            "type": "string",
            "x-order": 2
          },
          {
            "in": "body",
            "name": "body",
            "description": "请求体。",
            "required": false,
            "schema": {
              "$ref": "#/definitions/PostOldRequestsReq"
            },
            "x-order": 3
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-order": 4
          }
        ],
        "deprecated": true,
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "request_id": "303a0a00-c88a",
                "question": "桌面云打不开",
                "answers": [
                  {
                    "qa_pair_id": "123",
                    "st_question": "桌面云打开不了",
                    "answer": "用户账号不对",
                    "score": 0.952,
                    "domain": "桌面云"
                  },
                  {
                    "qa_pair_id": "123",
                    "st_question": "桌面云打开不了了",
                    "answer": "用户账号不对",
                    "score": 0.901,
                    "domain": "桌面云"
                  },
                  {
                    "qa_pair_id": "123",
                    "st_question": "桌面云是啥",
                    "answer": "桌面云是可以远程办公的系统",
                    "score": 0.352,
                    "domain": "桌面云"
                  },
                  {
                    "qa_pair_id": "123",
                    "st_question": "电脑桌面打不开",
                    "answer": "请检查下显示器是否开启",
                    "score": 0.352,
                    "domain": "桌面云"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/PostRequestsResp"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "CBS.0022",
                "error_msg": "session_id can not be null"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          }
        },
        "x-name": "PostRequests",
        "x-constraint": "",
        "x-version": "v1",
        "x-scope": "Deprecated",
        "x-order": 2,
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "https://{endpoint}/v1/1604d8170cd84440a81281e5a3a04f8b/qabots/303a0a00-c88a-43e3-aa2f-d5b8b9832b02/requests",
        "x-request-examples-1": {
