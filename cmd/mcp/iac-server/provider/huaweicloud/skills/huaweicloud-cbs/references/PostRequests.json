  "definitions": {
    "PostRequestsResp": {
      "required": [
        "question",
        "request_id"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求ID。\n\n调用失败时无此字段。"
        },
        "question": {
          "type": "string",
          "description": "问题。\n\n调用失败时无此字段。"
        },
        "answers": {
          "type": "array",
          "description": "最相似的问题集。\n调用失败时无此字段。",
          "items": {
            "$ref": "#/definitions/Answers"
          }
        },
        "extends": {
          "description": "扩展参数项。\n调用失败时无此字段。",
          "$ref": "#/definitions/OldExtends"
        }
      },
      "description": ""
    },
    "OldExtends": {
      "properties": {
        "domains": {
          "type": "array",
          "description": "领域列表,多个领域用分号隔开。如果设置了领域且领域不为空,就从这些领域中匹配答案,否则就从该用户的全部知识库匹配答案。\n\n当前最多支持10个领域。\n",
          "items": {
            "type": "string",
            "description": ""
          },
          "maxItems": 10
        },
        "top": {
          "type": "integer",
          "description": "返回答案数量,默认为5,取值范围1~10。"
        }
      },
      "description": ""
    },
    "ErrorResp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码。\n调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      },
      "description": "Bad Request"
    },
    "Answers": {
      "properties": {
        "qa_pair_id": {
          "type": "string",
          "description": "Answers."
        },
        "st_question": {
          "type": "string",
          "description": "标准问题。"
        },
        "score": {
          "type": "number",
          "format": "double",
          "description": "相似度得分,精确到小数点后3位。"
        },
        "domain": {
          "type": "string",
          "description": "Domain."
        },
        "answer": {
          "type": "string",
          "description": "答案。"
        },
        "ex_questions": {
          "type": "array",
          "description": "扩展问。",
          "items": {
            "$ref": "#/definitions/ExQuestions"
          }
        }
      },
      "description": ""
    },
    "PostOldRequestsReq": {
      "required": [
        "question"
      ],
      "properties": {
        "extends": {
          "description": "扩展参数。",
          "$ref": "#/definitions/OldExtends"
        },
        "chat_enable": {
          "type": "boolean",
          "description": "默认false\ntrue:使用内部闲聊语料进行兜底\nfalse:不使用闲聊兜底",
          "default": false
        },
        "threshold_enable": {
          "type": "boolean",
          "description": "true:启动内部阈值 返回经过阈值处理之后的答案。\nfalse:不启用内部阈值 返回原答案。",
          "default": false
        },
        "user_id": {
          "type": "string",
          "description": "用户id,在日志中用于标识不通用户,可以为任意String"
        },
        "question": {
          "type": "string",
          "description": "用户输入"
        },
        "operate_type": {
          "type": "integer",
          "description": "调用接口时候传入,用以标记的问答的行为,默认为0,最终会展示在问答日志里。 0 用户输入 1 单击热点问题 3 单击推荐问题 4 单击问题提示"
        },
        "session_id": {
          "type": "string",
          "description": "会话标识符,UUID格式。如:c04e6f7b-61d7-4a2d-a0c8-f9ecd2f62359。\n\n每次对话开启,机器人创建会话id,下次请求中传入该id表示继续该轮对话,每轮会话有效时间为2分钟。\n若传入的会话id已过期或者为空,则机器人会重新创建新的会话id(重新创建会话id会消耗一定时间)。"
        }
      },
      "description": ""
    },
    "ExQuestions": {
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "string",
          "description": "扩展问题。"
        }
      },
      "description": ""
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cbs-ext.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
