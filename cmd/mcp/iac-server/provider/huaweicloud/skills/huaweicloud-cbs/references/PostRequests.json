        "x-request-examples-text-1": "{\n    \"user_id\": \"z00123456\",\n    \"session_id\": \"xxxxxxxxxxxxxxxxxx\",\n    \"operate_type\":3,      \n    \"question\": \"桌面云无法登陆\",\n    \"extends\":{\n\t\"domains\":[\"桌面云\"],\n\t\"top\":5\n    },\n    \"threshold_enable\":false,\n    \"chat_enable\":true\n}",
