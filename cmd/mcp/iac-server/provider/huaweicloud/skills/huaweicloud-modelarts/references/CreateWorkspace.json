{
  "name": "CreateWorkspace",
  "summary": "创建工作空间",
  "tags": "工作空间管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces": {
      "post": {
        "tags": [
          "工作空间管理"
        ],
        "summary": "创建工作空间",
        "description": "创建工作空间(\"default\"为系统预留的默认工作空间名称,不能使用)。",
        "operationId": "CreateWorkspace",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "in": "body",
            "name": "CreateWorkspaceRequestBody",
            "description": "创建工作空间的请求体参数。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateWorkspaceReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "创建工作空间成功的响应参数。",
            "examples": {
              "application/json": {
                "id": "**d05d1a553b4e188ea878e7dcb85e**",
                "name": "test-workspace",
                "description": "It is a test project'",
                "owner": "testUser",
                "create_time": 1470000020000,
                "update_time": 1470000030000,
                "enterprise_project_id": "***b0091-887f-4839-9929-cbc884f1e***",
                "enterprise_project_name": "test-eps",
                "auth_type": "public",
                "status": "NORMAL",
                "status_info": ""
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateWorkspaceResponseBody"
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "type": "string"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "type": "string"
            }
          },
          "500": {
            "description": "InternalServerError",
            "schema": {
              "type": "string"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc,fcs-super,hws_hk,hk",
        "x-is-registered": "Y",
        "x-publish-doc": "Y",
        "x-request-examples-description-1": "创建工作空间。设置工作空间名称为“test-workspace”,授权类型为“internal”,授权的IAM用户名称为“test”。",
        "x-request-examples-text-1": {
          "name": "test-workspace",
          "description": "It is a test project",
          "enterprise_project_id": "***b0091-887f-4839-9929-cbc884f1e***",
          "auth_type": "internal",
          "grants": [
            {
              "user_name": "test"
            }
          ]
        },
        "x-request-examples-1": {
          "name": "test-workspace",
          "description": "It is a test project",
          "enterprise_project_id": "***b0091-887f-4839-9929-cbc884f1e***",
          "auth_type": "internal",
          "grants": [
            {
              "user_name": "test"
            }
          ]
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v1/{project_id}/workspaces"
      }
    }
  },
  "definitions": {
    "CreateWorkspaceResponseBody": {
      "properties": {
        "owner": {
          "type": "string",
          "example": "testUser",
          "description": "创建者名称。"
        },
        "auth_type": {
          "type": "string",
          "example": "public",
          "description": "授权类型。默认值为PUBLIC。PUBLIC:租户内部公开访问。PRIVATE:仅创建者和主账号可访问。INTERNAL:创建者、主账号、指定IAM子账号可访问,需要与grants参数配合使用。"
        },
        "enterprise_project_id": {
          "type": "string",
          "example": "10eb0091-887f-4839-9929-cbc884f1e20e",
          "description": "企业项目ID。"
        },
        "update_time": {
          "type": "integer",
          "format": "int64",
          "example": 1470000020000,
          "description": "最后修改时间,UTC。"
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "example": 1470000020000,
          "description": "创建时间,UTC。"
        },
        "enterprise_project_name": {
          "type": "string",
          "example": "test-eps",
          "description": "企业项目名称。"
        },
        "name": {
          "type": "string",
          "example": "test-workspace",
          "description": "工作空间名称。"
        },
        "description": {
          "type": "string",
          "example": "It's a test project",
          "description": "工作空间描述。"
        },
        "id": {
          "type": "string",
          "example": "cfedf4a550124446a0c781c2deababe0",
          "description": "工作空间ID,系统生成的32位UUID,不带橫线。"
        },
        "status": {
          "type": "string",
          "example": "NORMAL",
          "description": "工作空间状态。\n- CREATE_FAILED:创建失败。\n- NORMAL:状态正常。\n- DELETING:正在删除。\n- DELETE_FAILED:删除失败。"
        },
        "status_info": {
          "type": "string",
          "description": "状态描述,默认为空。该字段会补充显示状态的详细信息。如删除失败时,可通过该字段查看删除失败的原因。"
        },
        "grants": {
          "type": "array",
          "description": "授权用户列表。默认为空。需要与“auth_type”参数配合使用,且仅当授权类型为“INTERNAL”时才会生效。",
          "items": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "string",
                "description": "用户ID,此参数与user_name必填一个。两者都填优先使用user_id。"
              },
              "user_name": {
                "type": "string",
                "description": "IAM用户名称。此参数与user_id必填一个。"
              }
            }
          }
        }
      }
    },
    "CreateWorkspaceReq": {
      "required": [
        "name"
      ],
      "properties": {
        "grants": {
          "type": "array",
          "description": "授权用户列表,默认为空。需要与“auth_type”参数配合使用,且仅当授权类型为“INTERNAL”时才会生效。",
          "items": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "string",
                "description": "IAM用户ID。此参数与user_name必填一个。两者都填优先使用user_id。"
              },
              "user_name": {
                "type": "string",
                "example": "my_iam_user",
                "description": "IAM用户名称。此参数与user_id必填一个。"
              },
              "user_type": {
                "type": "string",
                "description": "参数解释:\n授权用户类型。\n约束限制:\n如果是联邦用户或者委托用户的话必填。\n取值范围:\nIAM:IAM用户,\nFEDERATE:联邦用户,\nAGENCY:委托用户。\n默认取值:\nIAM。"
              }
            }
          }
        },
        "auth_type": {
          "type": "string",
          "example": "internal",
          "description": "授权类型。可选值有PUBLIC、PRIVATE、INTERNAL。默认值为PUBLIC。\n- PUBLIC:租户内部公开访问。\n- PRIVATE:仅创建者和主账号可访问。\n- INTERNAL:创建者、主账号、指定IAM子账号可访问,需要与grants参数配合使用。",
          "enum": [
            "PUBLIC",
            "PRIVATE",
            "INTERNAL"
          ]
        },
        "enterprise_project_id": {
          "type": "string",
          "example": "10eb0091-887f-4839-9929-cbc884f1e20e",
          "description": "企业项目ID。"
        },
        "name": {
          "type": "string",
          "example": "test-workspace",
          "description": "工作空间名称。长度限制为4-64字符,支持中文、大小写字母、数字、中划线和下划线。同时'default'为系统预留的默认工作空间名称,用户无法自己创建名为'default'的工作空间。"
        },
        "description": {
          "type": "string",
          "example": "It's a test project",
          "description": "工作空间描述,默认为空。长度限制为0-256字符。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "modelarts.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}