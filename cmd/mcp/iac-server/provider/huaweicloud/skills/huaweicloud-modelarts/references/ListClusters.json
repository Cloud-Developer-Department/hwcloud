{
  "name": "ListClusters",
  "summary": "查询专属资源池列表",
  "tags": "服务管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/clusters": {
      "get": {
        "tags": [
          "服务管理"
        ],
        "summary": "查询专属资源池列表",
        "description": "查询专属资源池列表。",
        "operationId": "ListClusters",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。",
            "required": true,
            "type": "string",
            "x-example": "eae4ac05e51643c8a8ad644eace39981"
          },
          {
            "name": "cluster_name",
            "in": "query",
            "description": "集群名称,默认不过滤集群名。",
            "required": false,
            "type": "string",
            "x-example": "clusterA"
          },
          {
            "name": "status",
            "in": "query",
            "description": "集群状态,默认不过滤状态。",
            "required": false,
            "type": "string",
            "x-example": "running"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页列表的起始页,默认为0。",
            "required": false,
            "type": "integer",
            "default": 0,
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "指定每一页返回的最大条目数,默认为1000。",
            "required": false,
            "type": "integer",
            "default": 1000,
            "x-example": 1000
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "指定排序字段,枚举值如下:\n- created_at: 创建时间,默认值。\n- cluster_name: 集群名称。",
            "required": false,
            "type": "string",
            "default": "created_at",
            "enum": [
              "created_at",
              "cluster_name"
            ],
            "x-example": "create_at"
          },
          {
            "name": "order",
            "in": "query",
            "description": "排序方式,枚举值如下:\n- asc: 递增排序\n- desc: 递减排序,默认值",
            "required": false,
            "type": "string",
            "default": "desc",
            "enum": [
              "asc",
              "desc"
            ],
            "x-example": "desc"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          }
        ],
        "responses": {
          "200": {
            "description": "服务部署规格列表。",
            "examples": {
              "application/json": {
                "total_count": 1,
                "count": 1,
                "clusters": [
                  {
                    "cluster_id": "ff808081673fbb3d01673fbb824d0000",
                    "cluster_name": "my-cluster",
                    "description": "",
                    "tenant": "tenant_id",
                    "project": "project_id",
                    "owner": "owner_id",
                    "created_at": 1574923077927,
                    "status": "running",
                    "nodes": {
                      "specification": "modelarts.vm.cpu.8ud",
                      "count": 1,
                      "available_count": 1
                    },
                    "allocatable_cpu_cores": 5.5,
                    "allocatable_memory": 4096,
                    "allocatable_gpus": 0.5
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/GetClustersResponse"
            }
          }
        },
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "x-publish-doc": "Y",
        "x-open-region-cloud": "hc",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/clusters"
      }
    }
  },
  "definitions": {
    "Cluster": {
      "properties": {
        "owner": {
          "type": "string",
          "example": "2a6dc83e4d4343e59ae317507c8bfcab",
          "description": "集群归属用户。"
        },
        "cluster_name": {
          "type": "string",
          "example": "aaaaaaa",
          "description": "集群名称。"
        },
        "period_num": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "对应订购周期的个数,仅当集群为包周期类型时返回。"
        },
        "created_at": {
          "type": "integer",
          "format": "int32",
          "example": 1574770228888.0,
          "description": "集群创建时间,距“1970.1.1 0:0:0 UTC”的毫秒数。"
        },
        "description": {
          "type": "string",
          "example": "info",
          "description": "集群备注。"
        },
        "project": {
          "type": "string",
          "example": "eae4ac05e51643c8a8ad644eace39981",
          "description": "集群归属项目。"
        },
        "allocatable_memory": {
          "type": "integer",
          "format": "float",
          "example": 1,
          "description": "可使用的内存数。"
        },
        "cluster_id": {
          "type": "string",
          "example": "2c9080046e8c18bd016e932357c6079b",
          "description": "集群ID。"
        },
        "nodes": {
          "$ref": "#/definitions/ClusterNode"
        },
        "allocatable_cpu_cores": {
          "type": "number",
          "format": "float",
          "example": 1.0,
          "description": "可使用的CPU核数。"
        },
        "product_id": {
          "type": "string",
          "example": "11212",
          "description": "产品ID,仅当集群为包周期类型时返回。"
        },
        "allocatable_gpus": {
          "type": "number",
          "format": "float",
          "example": 1.0,
          "description": "可使用的GPU核数。"
        },
        "order_id": {
          "type": "string",
          "example": "asddd",
          "description": "购买产品的订单ID,仅当集群为包周期类型时返回。"
        },
        "period_type": {
          "type": "string",
          "example": "year",
          "description": "订购周期类型,取值year或month,仅当集群为包周期类型时返回。",
          "enum": [
            "year",
            "month"
          ]
        },
        "tenant": {
          "type": "string",
          "example": "b575785bcece44beb23597770fb819f9",
          "description": "集群归属租户。"
        },
        "status": {
          "type": "string",
          "example": "deploying",
          "description": "集群状态,取值为:\n- deploying:部署中\n- running:运行中\n- concerning:告警\n- abnormal:异常",
          "enum": [
            "deploying",
            "running",
            "concerning",
            "abnormal"
          ]
        }
      },
      "description": "集群信息。",
      "type": "object"
    },
    "ClusterNode": {
      "properties": {
        "available_count": {
          "type": "integer",
          "example": 1,
          "description": "可用节点数。"
        },
        "count": {
          "type": "integer",
          "example": 1,
          "description": "节点数。"
        },
        "specification": {
          "type": "string",
          "example": "modelarts.vm.cpu.8ud",
          "description": "节点规格。"
        }
      },
      "description": "集群节点配置。"
    },
    "GetClustersResponse": {
      "properties": {
        "total_count": {
          "type": "integer",
          "example": 1,
          "description": "不分页的情况下符合查询条件的总集群数量。"
        },
        "count": {
          "type": "integer",
          "example": 1,
          "description": "当前查询结果的集群数量,不设置offset、limit查询参数时,count与total相同。"
        },
        "clusters": {
          "type": "array",
          "description": "查询到的集群列表。",
          "items": {
            "$ref": "#/definitions/Cluster"
          }
        }
      },
      "description": "专属资源池列表响应信息。"
    }
  },
  "version": "2.0",
  "parameters": {},
