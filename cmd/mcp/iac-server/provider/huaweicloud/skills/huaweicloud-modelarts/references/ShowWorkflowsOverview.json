      "in": "query",
      "required": false,
      "description": "工作空间ID。获取方法请参见[查询工作空间列表](ListWorkspace.xml)。未创建工作空间时默认值为“0”,存在创建并使用的工作空间,以实际取值为准。",
      "type": "string"
    },
    "search_type": {
      "name": "search_type",
      "in": "query",
      "required": false,
      "description": "过滤方式。可选值如下:\n- equal表示精确匹配。\n- contain表示模糊匹配。\n\n具体过滤的字段,由各个接口额外定义参数。例如Workflow支持按照名称(name)进行过滤,则相应的过滤字段为name。name=workflow&search_type=contain表示查询名称中含有Workflow字样的所有工作流。",
      "type": "string",
      "default": "contain",
      "enum": [
        "contain",
        "equal"
      ]
    },
    "workflow_description": {
      "name": "description",
      "in": "query",
      "type": "string",
      "description": "工作流描述信息。",
      "required": false
    },
    "projectIDParam": {
      "in": "path",
      "name": "project_id",
      "required": true,
      "type": "string",
      "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。"
    },
    "workflow_name": {
      "name": "name",
      "in": "query",
      "type": "string",
      "description": "工作流名称。填写1-64位,仅包含英文、数字、下划线(_)和中划线(-),并且以英文开头的名称。",
      "required": false
    }
