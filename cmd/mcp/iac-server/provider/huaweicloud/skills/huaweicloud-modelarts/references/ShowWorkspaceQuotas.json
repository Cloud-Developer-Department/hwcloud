{
  "name": "ShowWorkspaceQuotas",
  "summary": "查询工作空间配额",
  "tags": "工作空间管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces/{workspace_id}/quotas": {
      "get": {
        "tags": [
          "工作空间管理"
        ],
        "summary": "查询工作空间配额",
        "description": "查询工作空间配额。",
        "operationId": "ShowWorkspaceQuotas",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "工作空间ID。获取方法请参见[查询工作空间列表](ListWorkspace.xml)。未创建工作空间时默认值为“0”,存在创建并使用的工作空间,以实际取值为准。",
            "required": true,
            "type": "string",
            "x-example": "ccd05d1a553b4e188ea878e7dcb85e47"
          }
        ],
        "responses": {
          "200": {
            "description": "查询工作空间配额成功的响应参数。",
            "examples": {
              "application/json": {
                "quotas": [
                  {
                    "max_quota": 60000,
                    "update_time": 1470000020000,
                    "resource": "exemlProject.gpu_duration",
                    "used_quota": 5,
                    "quota": 10,
                    "min_quota": -1,
                    "name_cn": "自动学习(图像分类、物体检测、声音分类)训练时长",
                    "unit_cn": "分钟",
                    "name_en": "ExeMLtraining duration (image classification, object detection, and soundclassification)",
                    "unit_en": "minute"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ViewWorkspaceQuotasResponse"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/workspaces/ccd05d1a553b4e188ea878e7dcb85e47/quotas",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc,fcs-super,hws_hk,hk",
        "x-is-registered": "Y",
        "x-publish-doc": "Y"
      }
    }
  },
  "definitions": {
    "ViewWorkspaceQuotasResponse": {
      "properties": {
        "quotas": {
          "type": "array",
          "description": "工作空间配额数据。",
          "items": {
            "$ref": "#/definitions/WorkspaceQuotasResponse"
          }
        }
      }
    },
    "WorkspaceQuotasResponse": {
      "properties": {
        "max_quota": {
          "type": "integer",
          "example": 60000,
          "description": "配额允许设置的最大值。"
        },
        "update_time": {
          "type": "integer",
          "format": "int64",
          "example": 1470000020000,
          "description": "最后修改时间,UTC。如用户未修改过该资源配额,则该值默认为该工作空间的创建时间。"
        },
        "resource": {
          "type": "string",
          "example": "exemlProject.gpu_duration",
          "description": "资源的唯一标识。"
        },
        "quota": {
          "type": "integer",
          "example": 10,
          "description": "当前配额值。配额值为-1代表不限制配额。"
        },
        "min_quota": {
          "type": "integer",
          "example": -1,
          "description": "配额允许设置的最小值。"
        },
        "name_cn": {
          "type": "string",
          "example": "自动学习(图像分类、物体检测、声音分类)训练时长",
          "description": "配额名称[(中文)](tag:hc,hk)。"
        },
        "unit_cn": {
          "type": "string",
          "example": "分钟",
          "description": "数量单位[(中文)](tag:hc,hk)。"
        },
        "name_en": {
          "type": "string",
          "example": "ExeMLtraining duration (image classification, object detection, and soundclassification)",
          "description": "工作空间ID,系统生成的32位UUID,不带橫线。默认的工作空间id为'0'。"
        },
        "unit_en": {
          "type": "string",
          "example": "minute",
          "description": "数量单位(英文)。"
        },
        "used_quota": {
          "type": "integer",
          "format": "int32",
          "description": "已用配额值。当quota为-1(不限制配额)时,used_quota为null。"
        }
      },
      "description": "quotas属性列表"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "modelarts.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}