          "x-open-region-cloud": "hk,hc,hcso,hcs"
        },
        "rollingConfig": {
          "properties": {
            "strategy": {
              "type": "string",
              "description": "**参数解释**:滚动策略。\n**约束限制**:不涉及。\n**取值范围**:可选值如下:\n- RollingByNumber:表示按节点数量设置最大同时重置节点数量,例如10,表示单次最多重置10个节点\n- RollingByPercent:表示按百分比设置最大同时重置节点数量。例如10,表示单次最多重置10%的节点\n**默认取值**:不涉及。",
              "x-open-region-cloud": "hk,hc,hcso,hcs"
            },
            "maxUnavailable": {
              "type": "integer",
              "description": "**参数解释**:滚动重置的节点数量或者节点比例, 当strategy为RollingByNumber时,表示允许同时重置的节点数量, 当strategy为RollingByPercent时,表示允许同时重置的最大节点比例。\n**约束限制**:不涉及。\n**取值范围**:不涉及。\n**默认取值**:不涉及。",
              "x-open-region-cloud": "hk,hc,hcso,hcs"
            }
          },
          "required": [
            "strategy",
            "maxUnavailable"
          ],
          "description": "**参数解释**:节点重置是滚动配置。\n**约束限制**:不涉及。",
          "x-open-region-cloud": "hk,hc,hcso,hcs"
        },
        "nodeConfig": {
          "description": "**参数解释**:节点配置参数。\n**约束限制**:该参数待下线。超节点禁传此参数,非超节点亦不推荐传递此参数。重置配置参数会从节点所在的nodepool自动取值, 若需要重置时修改某参数, 可先修改nodepool相关参数, 再进行重置。",
          "x-open-region-cloud": "hk,hc,hcso,hcs",
          "properties": {
            "os": {
              "type": "string",
              "description": "**参数解释**:节点的镜像名称,如果不设置则取name字段的值\n**约束限制**:不涉及。",
              "x-open-region-cloud": "hk,hc,hcso,hcs"
            },
