{
  "name": "ListInferServiceTags",
  "summary": "查询某一类资源下的标签",
  "tags": "服务标签管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/modelarts-service-v2/tags": {
      "get": {
        "x-publishpath": "ListServiceTags-v2",
        "tags": [
          "服务标签管理"
        ],
        "summary": "查询某一类资源下的标签",
        "description": "该接口适用于需要获取用户当前项目中某一类资源(如指定的Service)的标签信息的场景,例如在资源管理和监控中,用户可以通过查询标签来了解各类资源的分类和属性。通过调用此接口,用户可以获取指定Service在所有工作空间中的标签列表,但无权限的工作空间标签数据将被过滤不返回。用户必须具有足够的权限,且目标资源需存在。查询成功后,返回指定Service的标签列表;若失败,返回具体的错误信息。常见异常包括权限验证错误、资源不存在错误和参数验证错误。",
        "operationId": "ListInferServiceTags",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。\n**约束限制:**\n不涉及。\n**取值范围:**\n账号的项目ID。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "**参数解释:**\n消息体的类型(格式)。\n**约束限制:**\n不涉及。\n**取值范围:**\n- application/json。\n- application/json;charset=utf-8。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token。通过调用IAM服务获取用户Token接口获取响应消息头中X-Subject-Token的值。获取方法请参见[获取IAM用户Token(使用密码)](modelarts_03_0004.xml)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "name": "workspace_id",
            "in": "query",
            "description": "**参数解释:**\n工作空间ID,workspaceId将会被设置为null。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询项目下指定资源类型的所有标签,正常返回。",
            "examples": {
              "application/json": {
                "tags": [
                  {
                    "key": "model_version",
                    "values": [
                      "0.1",
                      "0.2"
                    ]
                  },
                  {
                    "key": "conda_version",
                    "values": [
                      "10.2",
                      "11.0"
                    ]
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/CombineInferTmsTagsResponse"
            }
          },
          "400": {
            "description": "参数非法。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "权限不足。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-api-type": "open-api",
        "x-publish-doc": "Y",
        "x-request-examples-url-1": "https://{endpoint}/v2/{project_id}/modelarts-service-v2/tags",
        "x-request-examples-description-1": "查询某一类资源下的标签。\n",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hk,hc,hcs,hcs_sm,fcs,hcso",
        "x-is-registered": "Y",
        "x-order": 3
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "description": "请求失败时返回的错误对象。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:ModelArts错误码。\n**取值范围**:不涉及。"
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释**:具体错误信息。\n**取值范围**:不涉及。"
        }
      }
    },
    "CombineInferTmsTags": {
      "type": "object",
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n标签的key。\n**取值范围:**\n不涉及。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)(?<!\\s)$"
        },
        "values": {
          "type": "array",
          "description": "**参数解释:**\n相同key的标签value合并后的列表。\n**取值范围:**\n不涉及。",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "description": "多标签相同key合并value的数据结构。",
      "example": {
        "key": "model_version",
        "values": [
          "0.1",
          "0.2"
        ]
      }
    },
    "CombineInferTmsTagsResponse": {
      "type": "object",
      "required": [
        "tags"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "description": "**参数解释:**\n标签的融合结构,相同key合并。",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/CombineInferTmsTags"
          },
          "maxItems": 200,
          "minItems": 0
        }
      },
      "description": "将相同key的标签value去重合并后的返回数据结构。",
      "example": {
        "tags": [
          {
            "key": "model_version",
            "values": [
              "0.1",
              "0.2"
            ]
          },
          {
            "key": "conda_version",
            "values": [
              "10.2",
              "11.0"
            ]
          }
        ]
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "modelarts.af-north-1.myhuaweicloud.com",
