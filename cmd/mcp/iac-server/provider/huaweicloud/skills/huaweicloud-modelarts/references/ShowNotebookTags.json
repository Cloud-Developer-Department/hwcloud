{
  "name": "ShowNotebookTags",
  "summary": "查询Notebook资源类型下的标签",
  "tags": "开发环境管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/notebooks/tags": {
      "get": {
        "x-api-type": "open-api",
        "x-publish-doc": "Y",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/notebooks/tags",
        "x-admin": "N",
        "x-apiexplorer-hide": "N",
        "x-apigateway-request-type": "Public",
        "x-internal": "N",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc",
        "x-is-registered": "Y",
        "tags": [
          "Notebook标签管理"
        ],
        "summary": "查询Notebook资源类型下的标签",
        "description": "查询Notebook资源类型下的标签接口用于获取用户当前project下Notebook实例的标签信息。该接口适用于以下场景:用户需要管理或统计Notebook资源时,可通过此接口查询特定标签或所有标签的Notebook实例。使用该接口的前提条件是用户已登录系统并具有访问权限,同时可指定工作空间或默认查询所有工作空间。调用该接口后,系统将返回指定Notebook实例的标签列表,包括标签名称、标签值等信息。若用户无权限,则返回相应的异常信息。",
        "operationId": "ShowNotebookTags",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "**参数解释**:用户项目ID,获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。\n**约束限制**:不涉及。\n**取值范围**:不涉及。\n**默认取值**:不涉及。"
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "description": "**参数解释**:工作空间ID。获取方法请参见[查询工作空间列表](ListWorkspace.xml)。未创建工作空间时默认值为“0”,存在创建并使用的工作空间,以实际取值为准。\n**约束限制**:不涉及。\n**取值范围**:不涉及。\n**默认取值**:0。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询项目下Notebook实例类型下的标签,正常返回。",
            "schema": {
              "$ref": "#/definitions/CombineTmsTagsResponse"
            },
            "examples": {
              "application/json": {
                "tags": [
                  {
                    "key": "model_version",
                    "values": [
                      "0.1",
                      "0.2"
                    ]
                  },
                  {
                    "key": "conda_version",
                    "values": [
                      "10.2",
                      "11.0"
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数非法。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "权限不足。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "description": "请求失败时返回的错误对象。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:ModelArts错误码。\n**取值范围**:不涉及。"
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释**:具体错误信息。\n**取值范围**:不涉及。"
        }
      }
    },
    "CombineTmsTags": {
      "type": "object",
      "description": "多标签相同key合并value的数据结构。",
      "example": {
        "key": "model_version",
        "values": [
          "0.1",
          "0.2"
        ]
      },
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释**:标签的key。\n**取值范围**:长度限制为128个字符,支持任意语种字母、数字、空格,以及_ . : = + - @特殊字符,但首尾不能含有空格,不能以_sys_开头。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)(?<!\\s)$"
        },
        "values": {
          "type": "array",
          "description": "**参数解释**:相同key的标签value合并后的列表。",
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$"
        }
      }
    },
    "CombineTmsTagsResponse": {
      "type": "object",
      "description": "将相同key的标签value去重合并后的返回数据结构。",
      "example": {
        "tags": [
          {
            "key": "model_version",
            "values": [
              "0.1",
              "0.2"
            ]
          },
          {
            "key": "conda_version",
            "values": [
              "10.2",
              "11.0"
            ]
          }
        ]
      },
      "required": [
        "tags"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 200,
          "items": {
            "$ref": "#/definitions/CombineTmsTags"
          },
          "description": "**参数解释**:标签的融合结构,相同key合并。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "modelarts.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}