    "ServerOsRequest": {
      "type": "object",
      "description": "Lite Server操作系统镜像相关操作请求体。",
      "properties": {
        "admin_pass": {
          "type": "string",
          "description": "**参数解释**:用于登录服务器密码。注意弹性云服务器和裸金属服务器admin_pass和key_pair_name必须二选一,超节点不支持admin_pass。\n**约束限制**:密码规则:\n- 长度为8至26个\n- 至少包含大写字母、小写字母、数字及特殊符号(!@%-_=+[{}]:,./?)中的3种\n- 不能与用户名或倒序的用户名相同\n- 不能包含root或administrator及其逆序\n**取值范围**:不涉及\n**默认取值**:不涉及",
          "pattern": "^.{8,26}$"
        },
        "key_pair_name": {
          "type": "string",
          "description": "**参数解释**:服务器登录密钥对名称。注意admin_pass和key_pair_name必须二选一。\n**约束限制**:不涉及。\n**取值范围**:不涉及\n**默认取值**:不涉及",
          "pattern": "^[-_.a-zA-Z0-9]{1,64}$"
        },
        "image_id": {
          "type": "string",
          "description": "**参数解释**:镜像ID,切换操作系统场景,该参数必填。\n**约束限制**:不涉及。\n**取值范围**:不涉及\n**默认取值**:不涉及",
          "example": "32c85a96-1627-4328-8825-58a68dd09a60",
          "minLength": 36,
          "maxLength": 36
        },
