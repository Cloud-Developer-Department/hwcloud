{
  "name": "ListEventCategories",
  "summary": "获取事件类型列表",
  "tags": "训练管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/training-event-categories": {
      "get": {
        "tags": [
          "训练作业管理"
        ],
        "summary": "获取事件类型列表",
        "description": "获取事件类型列表接口用于获取训练管理中支持的事件类型列表。\n该接口适用于以下场景:当用户需要了解训练管理中支持的事件类型,以便在创建或管理训练任务时进行相关配置时,可以通过此接口获取事件类型列表。使用该接口的前提条件是用户已登录且具有访问训练管理的权限。获取操作完成后,响应消息体中将包含所有支持的事件类型及其描述。若用户无权限访问或系统中无事件类型信息,接口将返回相应的错误信息。",
        "operationId": "ListEventCategories",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。\n**约束限制**:1 - 64字符,字母、数字和中划线。\n**取值范围**:不涉及。\n**默认取值**:不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "name": "flavor_type",
            "in": "query",
            "description": "**参数解释**:规格类型\n**约束限制**:不涉及。\n**取值范围**:可选值如下:\n- CPU\n- GPU\n- Ascend\n\n**默认取值**:不涉及。",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "event-categories": [
                  {
                    "id": "JobStarted",
                    "name": "JobStarted",
                    "description": "Job started.",
                    "notification": true
                  },
                  {
                    "id": "JobCompleted",
                    "name": "JobCompleted",
                    "description": "Job completed.",
                    "notification": true
                  },
                  {
                    "id": "JobFailed",
                    "name": "JobFailed",
                    "description": "Job failed.",
                    "notification": true
                  },
                  {
                    "id": "JobTerminated",
                    "name": "JobTerminated",
                    "description": "Job terminated.",
                    "notification": false
                  },
                  {
                    "id": "JobRestarted",
                    "name": "JobRestarted",
                    "description": "Job restarted.",
                    "notification": false
                  },
                  {
                    "id": "JobHanged",
                    "name": "JobHanged",
                    "description": "Job hanged.",
                    "notification": true
                  },
                  {
                    "id": "JobPreempted",
                    "name": "JobPreempted",
                    "description": "Job preempted.",
                    "notification": false
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListEventCategories"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-publish-doc": "Y",
        "x-open-region-cloud": "hws,hws_hk,hc,hk",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "ListEventCategories": {
      "type": "object",
      "properties": {
        "event-categories": {
          "type": "array",
          "description": "**参数解释**:事件类型。",
          "items": {
            "$ref": "#/definitions/EventCategoriesResp"
          }
        }
      },
      "description": "事件类型列表"
    },
    "EventCategoriesResp": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "**参数解释**:事件类型id。\n**取值范围**:枚举值如下:\n- JobStarted:作业开始\n- JobCompleted:作业结束\n- JobFailed:作业失败\n- JobTerminated:作业终止\n- JobRestarted:作业重启\n- JobHanged:作业疑似卡死\n- JobPreempted:作业抢占"
        },
        "name": {
          "type": "string",
          "description": "**参数解释**:事件类型名称。\n**取值范围**:不涉及。"
        },
        "description": {
          "type": "string",
          "description": "**参数解释**:事件类型描述。\n**取值范围**:不涉及。"
        },
        "notification": {
          "type": "boolean",
          "description": "**参数解释**:是否通知。\n**取值范围**:\n- true:通知\n- false:不通知"
        }
      },
      "description": "事件类型"
    }
  },
  "version": "2.0",
