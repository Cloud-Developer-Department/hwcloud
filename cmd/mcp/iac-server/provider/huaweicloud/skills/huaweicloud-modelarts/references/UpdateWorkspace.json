{
  "name": "UpdateWorkspace",
  "summary": "修改工作空间",
  "tags": "工作空间管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces/{workspace_id}": {
      "put": {
        "tags": [
          "工作空间管理"
        ],
        "summary": "修改工作空间",
        "description": "修改工作空间。",
        "operationId": "UpdateWorkspace",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "工作空间ID。获取方法请参见[查询工作空间列表](ListWorkspace.xml)。未创建工作空间时默认值为“0”,存在创建并使用的工作空间,以实际取值为准。",
            "required": true,
            "type": "string",
            "x-example": "ccd05d1a553b4e188ea878e7dcb85e47"
          },
          {
            "in": "body",
            "name": "UpdateWorkspaceRequestBody",
            "description": "修改工作空间的请求体参数。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateWorkspaceReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "修改工作空间成功的响应参数。",
            "examples": {
              "application/json": {
                "workspace_id": "***05d1a553b4e188ea878e7dcb85***"
              }
            },
            "schema": {
              "$ref": "#/definitions/UpdateWorkspaceResponseBody"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc,fcs-super,hws_hk,hk",
        "x-is-registered": "Y",
        "x-publish-doc": "Y",
        "x-request-examples-text-1": {
          "name": "my_workspace",
          "description": "It is my workspace",
          "auth_type": "INTERNAL",
          "grants": [
            {
              "user_name": "my_iam_user"
            }
          ]
        },
        "x-request-examples-1": {
          "name": "my_workspace",
          "description": "It is my workspace",
          "auth_type": "INTERNAL",
          "grants": [
            {
              "user_name": "my_iam_user"
            }
          ]
        },
        "x-request-examples-url-1": "PUT https://{endpoint}/v1/{project_id}/workspaces/ccd05d1a553b4e188ea878e7dcb85e47"
      }
    }
  },
  "definitions": {
    "UpdateWorkspaceReq": {
      "properties": {
        "grants": {
          "type": "array",
          "description": "训练作业使用的数据集。不可与data_url或dataset_id/dataset_version_id同时使用。",
          "items": {
            "properties": {
              "user_id": {
                "type": "string",
                "description": "IAM用户ID。此参数与user_name必填一个。两者都填优先使用user_id。"
              },
              "user_name": {
                "type": "string",
                "description": "IAM用户名称。此参数与user_id必填一个。"
              },
              "user_type": {
                "type": "string",
                "description": "参数解释:\n授权用户类型。\n约束限制:\n如果是联邦用户或者委托用户的话必填。\n取值范围:\nIAM:IAM用户,\nFEDERATE:联邦用户,\nAGENCY:委托用户。\n默认取值:\nIAM。"
              }
            }
          }
        },
        "auth_type": {
          "type": "string",
          "example": "internal",
          "description": "授权类型。可选值有PUBLIC、PRIVATE、INTERNAL。默认值为PUBLIC。\n- PUBLIC:租户内部公开访问。\n- PRIVATE:仅创建者和主账号可访问。\n- INTERNAL:创建者、主账号、指定IAM子账号可访问,需要与grants参数配合使用。",
          "enum": [
            "PUBLIC",
            "PRIVATE",
            "INTERNAL"
          ]
        },
        "name": {
          "type": "string",
          "example": "test-workspace",
          "description": "工作空间名称。长度限制为4-64字符,支持中文、大小写字母、数字、中划线和下划线。同时'default'为系统预留的默认工作空间名称,用户无法自己创建名为'default'的工作空间。"
        },
        "description": {
          "type": "string",
          "example": "It's a test project",
          "description": "工作空间描述,默认为空。长度限制为0-256字符。"
        }
      }
    },
    "UpdateWorkspaceResponseBody": {
      "properties": {
        "workspace_id": {
          "type": "string",
          "example": "ccd05d1a553b4e188ea878e7dcb85e47",
          "description": "工作空间ID。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "modelarts.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
