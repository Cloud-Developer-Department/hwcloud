{
  "name": "ShowTrainingQuotas",
  "summary": "获取训练配额",
  "tags": "训练管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/training-quotas": {
      "get": {
        "tags": [
          "训练作业管理"
        ],
        "summary": "获取训练配额",
        "description": "获取训练配额接口用于查询用户在ModelArts服务中的训练资源配额信息。\n该接口适用于以下场景:当用户需要了解当前可用的训练资源配额,以便合理规划和管理训练任务时,可以通过此接口获取配额详情。使用该接口的前提条件是用户已登录并具有查看配额的权限。响应消息体中包含用户已创建的训练作业个数、剩余可创建个数等。若用户无权限或配额信息为空,接口将返回相应的错误信息或空列表。",
        "operationId": "ShowTrainingQuotas",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。\n**约束限制**:1 - 64字符,字母、数字和中划线。\n**取值范围**:不涉及。\n**默认取值**:不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "name": "user_id",
            "in": "query",
            "description": "**参数解释**:用户ID。\n**约束限制**:不涉及。\n**取值范围**:不涉及。\n**默认取值**:不涉及。",
            "required": false,
            "type": "string"
          },
          {
            "name": "resource",
            "in": "query",
            "description": "**参数解释**:配额的资源类型。\n**约束限制**:当前支持的传参:job-num(作业个数的配额)。\n**取值范围**:不涉及。\n**默认取值**:不涉及。",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "训练作业配额响应体",
            "examples": {
              "application/json": {
                "quotas": [
                  {
                    "resource": "job-num",
                    "quota": 10000,
                    "used": 25
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/TrainingQuotaListResponse"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-request-examples-url-1": "GET https://endpoint/v2/{project_id}/training-quotas?user_id=fa412c98-6d94-42a2-891a-99cd1da93916&resource=job-num",
        "x-api-type": "open-api",
        "x-publish-doc": "Y",
        "x-open-region-cloud": "hws,hws_hk,hc,hk",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "TrainingQuotaListResponse": {
      "type": "object",
      "properties": {
        "quotas": {
          "type": "array",
          "description": "**参数解释**:训练作业配额组。",
          "items": {
            "$ref": "#/definitions/TrainingQuotaResponse"
          }
        }
      },
      "description": "**参数解释**:训练用户配额响应体。"
    },
    "TrainingQuotaResponse": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "description": "**参数解释**:配额的资源类型,当前支持:job-num,作业的个数配额。\n**取值范围**:不涉及。"
        },
        "quota": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:配额个数。\n**取值范围**:不涉及。"
        },
        "used": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:已使用的个数。\n**取值范围**:不涉及。"
        }
      },
      "description": "**参数解释**:训练用户配额响应体。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "modelarts.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}