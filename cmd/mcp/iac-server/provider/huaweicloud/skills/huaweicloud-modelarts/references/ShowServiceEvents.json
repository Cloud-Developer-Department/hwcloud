  "definitions": {
    "Events": {
      "properties": {
        "event_type": {
          "type": "string",
          "example": "normal",
          "description": "事件类型,取值为:\n- normal:正常事件\n- abnormal:异常事件",
          "enum": [
            "normal",
            "abnormal"
          ]
        },
        "event_info": {
          "type": "string",
          "example": "info",
          "description": "事件信息,当前主要描述部署过程5个阶段的信息,后续可根据情况继续补充。这5个阶段分别是构建镜像、准备环境、调度资源、拉取镜像、启动模型。"
        },
        "occur_time": {
          "type": "number",
          "example": 1574770228888.0,
          "description": "事件发生时间,距“1970.1.1 0:0:0 UTC”的毫秒数。"
        }
      },
