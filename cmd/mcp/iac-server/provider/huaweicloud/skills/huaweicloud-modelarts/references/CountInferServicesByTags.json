      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:ModelArts错误码。\n**取值范围**:不涉及。"
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释**:具体错误信息。\n**取值范围**:不涉及。"
        }
      }
    },
    "CombineInferTmsTags": {
      "type": "object",
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n标签的key。\n**取值范围:**\n不涉及。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)(?<!\\s)$"
        },
        "values": {
          "type": "array",
          "description": "**参数解释:**\n相同key的标签value合并后的列表。\n**取值范围:**\n不涉及。",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "description": "多标签相同key合并value的数据结构。",
      "example": {
        "key": "model_version",
        "values": [
          "0.1",
          "0.2"
        ]
      }
    },
    "TmsMatch": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
