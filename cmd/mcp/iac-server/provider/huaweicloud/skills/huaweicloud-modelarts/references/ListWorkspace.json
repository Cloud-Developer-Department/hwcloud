{
  "name": "ListWorkspace",
  "summary": "查询工作空间列表",
  "tags": "工作空间管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces": {
      "get": {
        "tags": [
          "工作空间管理"
        ],
        "summary": "查询工作空间列表",
        "description": "查询工作空间列表,响应消息体中包含详细信息。",
        "operationId": "ListWorkspace",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页列表的起始页,默认为'0'。",
            "required": false,
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "指定每一页返回的最大条目数,默认为'1000'。",
            "required": false,
            "type": "integer",
            "default": 1000,
            "minimum": 1,
            "x-example": 1000
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "指定排序字段,可选'name'、'update_time'、'status',默认是'name'。",
            "required": false,
            "type": "string",
            "default": "name",
            "enum": [
              "name",
              "update_time",
              "status"
            ],
            "x-example": "name"
          },
          {
            "name": "order",
            "in": "query",
            "description": "可选值。'asc'为递增排序。'desc'为递减排序,默认为'desc'。",
            "required": false,
            "type": "string",
            "default": "desc",
            "enum": [
              "asc",
              "desc"
            ],
            "x-example": "asc"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目id,指定此参数会只返回该企业项目id下的工作空间。默认显示所有工作空间。",
            "required": false,
            "type": "string",
            "x-example": "0"
          },
          {
            "name": "name",
            "in": "query",
            "description": "工作空间名称查询参数,指定此参数会模糊查询该名称的工作空间。默认显示所有工作空间。",
            "required": false,
            "type": "string",
            "x-example": "default"
          },
          {
            "name": "filter_accessible",
            "in": "query",
            "description": "该参数用于筛选可访问的工作空间。指定该参数为true,则会筛选掉当前用户无权限访问的工作空间。该参数默认为false,即为显示所有工作空间。",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-example": false
          }
        ],
        "responses": {
          "200": {
            "description": "查询工作空间列表成功的响应参数。",
            "examples": {
              "application/json": {
                "total_count": 10,
                "count": 1,
                "workspaces": [
                  {
                    "id": 0,
                    "name": "default",
                    "description": "",
                    "owner": "testUser",
                    "enterprise_project_id": "***b0091-887f-4839-9929-cbc884f1e***",
                    "enterprise_project_name": "default",
                    "auth_type": "public",
                    "create_time": 1460000010000,
                    "update_time": 1460000010000,
                    "status": "NORMAL",
                    "status_info": ""
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListWorkspaceResponseBody"
            }
          },
          "400": {
            "description": "BadRequest",
            "schema": {
              "type": "string"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "type": "string"
            }
          },
          "500": {
            "description": "InternalServerError",
            "schema": {
              "type": "string"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/workspaces?limit=2&offset=3&sort_by=name&order=desc&enterprise_project_id=0",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc,fcs-super,hws_hk,hk",
        "x-is-registered": "Y",
        "x-publish-doc": "Y"
      }
    }
  },
  "definitions": {
    "WorkspaceResponse": {
      "properties": {
        "owner": {
          "type": "string",
          "example": "testUser",
          "description": "创建者名称。"
        },
        "auth_type": {
          "type": "string",
          "example": "public",
          "description": "授权类型。默认值为PUBLIC。\n- PUBLIC:租户内部公开访问。\n- PRIVATE:仅创建者和主账号可访问。\n- INTERNAL:创建者、主账号、指定IAM子账号可访问,需要与grants参数配合使用。"
        },
        "enterprise_project_id": {
          "type": "string",
          "example": "10eb0091-887f-4839-9929-cbc884f1e20e",
          "description": "企业项目ID。"
        },
        "update_time": {
          "type": "integer",
          "format": "int64",
          "example": 1460000010000,
          "description": "最后修改时间,UTC。"
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "example": 1460000010000,
          "description": "创建时间,UTC。"
        },
        "enterprise_project_name": {
          "type": "string",
          "example": "1",
          "description": "企业项目名称。"
        },
        "name": {
          "type": "string",
          "example": "default",
          "description": "工作空间名称。"
        },
        "description": {
          "type": "string",
          "example": "工作空间描述",
          "description": "工作空间描述。"
        },
        "id": {
          "type": "string",
          "example": "0",
          "description": "工作空间ID,系统生成的32位UUID,不带橫线。默认的工作空间id为'0'。"
        },
        "status": {
          "type": "string",
          "example": "NORMAL",
          "description": "工作空间状态。\n- CREATE_FAILED:创建失败。\n- NORMAL:状态正常。\n- DELETING:正在删除。\n- DELETE_FAILED:删除失败。"
        },
        "status_info": {
          "type": "string",
          "description": "状态描述,默认为空。该字段会补充显示状态的详细信息。如删除失败时,可通过该字段查看删除失败的原因。"
        }
      }
    },
    "ListWorkspaceResponseBody": {
      "properties": {
        "total_count": {
          "type": "integer",
          "example": 10,
          "description": "工作空间的总数。"
        },
        "count": {
          "type": "integer",
          "example": 2,
          "description": "此次请求返回的工作空间个数。"
        },
        "workspaces": {
          "type": "array",
          "description": "workspace属性列表。",
          "items": {
            "$ref": "#/definitions/WorkspaceResponse"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "modelarts.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}