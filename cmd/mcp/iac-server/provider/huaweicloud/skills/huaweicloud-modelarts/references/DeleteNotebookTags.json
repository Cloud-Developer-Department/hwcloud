    "DeleteTmsTagsRequest": {
      "type": "object",
      "description": "删除资源标签结构体,支持批量删除。",
      "required": [
        "tags"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "description": "**参数解释**:要删除的标签列表。\n**约束限制**:不涉及。",
          "minItems": 0,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/TmsTag"
          }
        }
      }
    },
    "TmsTag": {
      "type": "object",
      "description": "TMS的标签结构体。",
      "example": {
        "key": "test",
        "value": "service-gpu"
      },
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释**:TMS标签的key。\n**约束限制**:长度限制为128个字符,支持任意语种字母、数字、空格,以及_ . : = + - @特殊字符,但首尾不能含有空格,不能以_sys_开头。\n**取值范围**:不涉及。\n**默认取值**:不涉及。",
          "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)(?<!\\s)$",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "description": "**参数解释**:TMS标签的value。\n**约束限制**:长度限制为255个字符,支持任意语种字母、数字、空格,以及_ . : / = + - @特殊字符。\n**取值范围**:不涉及。\n**默认取值**:不涉及。",
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$",
          "minLength": 0,
          "maxLength": 255
        }
      }
    }
  },
