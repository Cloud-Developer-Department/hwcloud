        ],
        "summary": "创建训练作业标签",
        "description": "创建训练作业标签,支持批量添加,当添加的标签key已存在,则覆盖该标签的value。",
        "operationId": "CreateTrainJobTags",
        "parameters": [
          {
            "$ref": "#/parameters/projectId"
          },
          {
            "$ref": "#/parameters/trainingJobIDParam"
          },
          {
            "name": "tags",
            "in": "body",
