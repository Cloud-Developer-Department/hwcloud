  "definitions": {
    "CreateTmsTagsResponse": {
      "type": "object",
      "properties": {
        "tags": {
          "type": "array",
          "description": "**参数解释**:TMS标签列表。",
          "items": {
            "$ref": "#/definitions/TmsTagResp"
          }
        }
      },
      "description": "创建训练作业标签返回。"
    },
    "TmsTagResp": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释**:TMS标签的key。\n**取值范围**:不涉及。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)(?<!\\s)$"
        },
        "value": {
          "type": "string",
          "description": "**参数解释**:TMS标签的value。\n**取值范围**:不涉及。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$"
        }
      },
      "description": "TMS的标签结构体。",
      "example": {
        "key": "test",
        "value": "service-gpu"
      }
    },
    "CreateTmsTagsRequest": {
      "type": "object",
      "description": "给资源添加标签请求体。",
      "required": [
        "tags"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "description": "**参数解释**:TMS标签列表。\n**约束限制**:不涉及。",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/TmsTag"
          }
        }
      }
    },
    "TmsTag": {
      "type": "object",
      "description": "TMS的标签结构体。",
      "example": {
        "key": "test",
        "value": "service-gpu"
      },
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释**:TMS标签的key。\n**约束限制**:长度限制为128个字符,支持任意语种字母、数字、空格,以及_ . : = + - @特殊字符,但首尾不能含有空格,不能以_sys_开头。\n**取值范围**:不涉及。\n**默认取值**:不涉及。",
          "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)(?<!\\s)$",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "description": "**参数解释**:TMS标签的value。\n**约束限制**:长度限制为255个字符,支持任意语种字母、数字、空格,以及_ . : / = + - @特殊字符。\n**取值范围**:不涉及。\n**默认取值**:不涉及。",
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$",
          "minLength": 0,
          "maxLength": 255
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "trainingJobIDParam": {
      "in": "path",
      "name": "training_job_id",
      "required": true,
      "type": "string",
      "description": "训练作业ID。获取方法请参见[查询训练作业列表](ListTrainingJobs.xml)。"
    },
    "projectId": {
      "name": "project_id",
      "in": "path",
      "description": "**参数解释**:用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。\n**约束限制**:1 - 64字符,字母、数字和中划线。\n**取值范围**:不涉及。\n**默认取值**:不涉及。",
      "required": true,
      "type": "string"
    }
  },
