        "pool_name",
        "nodes"
      ],
      "properties": {
        "pool_name": {
          "type": "string",
          "description": "集群名称,集群名称必须在外层pool_name中"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AffinityNodeInfo"
          },
