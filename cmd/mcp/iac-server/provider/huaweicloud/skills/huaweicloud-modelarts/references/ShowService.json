{
  "name": "ShowService",
  "summary": "查询服务详情",
  "tags": "服务管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/services/{service_id}": {
      "get": {
        "tags": [
          "服务管理"
        ],
        "summary": "查询服务详情",
        "description": "查询模型服务详情,根据服务ID查询服务详情。",
        "operationId": "ShowService",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。",
            "required": true,
            "type": "string",
            "x-example": "eae4ac05e51643c8a8ad644eace39981"
          },
          {
            "name": "service_id",
            "in": "path",
            "description": "服务ID,在创建服务时即可在返回体中获取,也可通过查询服务列表接口获取当前用户拥有的服务,其中service_id字段即为服务ID。",
            "required": true,
            "type": "string",
            "x-example": "a6f49042-771c-451a-bb53-e175fc7d95cf"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          }
        ],
        "responses": {
          "200": {
            "description": "服务详情",
            "examples": {
              "application/json": {
                "service_id": "f76f20ba-78f5-44e8-893a-37c8c600c02f",
                "service_name": "service-demo",
                "tenant": "xxxxx",
                "project": "xxxxx",
                "owner": "xxxxx",
                "publish_at": 1585809231902,
                "update_time": 1585809358259,
                "infer_type": "real-time",
                "status": "running",
                "progress": 100,
                "access_address": "https://xxxxx.apigw.xxxxx.com/v1/infers/088458d9-5755-4110-97d8-1d21065ea10b/f76f20ba-78f5-44e8-893a-37c8c600c02f",
                "cluster_id": "088458d9-5755-4110-97d8-1d21065ea10b",
                "workspace_id": "0",
                "additional_properties": {},
                "is_shared": false,
                "invocation_times": 0,
                "failed_times": 0,
                "shared_count": 0,
                "operation_time": 1586249085447,
                "config": [
                  {
                    "model_id": "044ebf3d-8bf4-48df-bf40-bad0e664c1e2",
                    "model_name": "jar-model",
                    "model_version": "1.0.1",
                    "specification": "custom",
                    "custom_spec": {},
                    "status": "notReady",
                    "weight": 100,
                    "instance_count": 1,
                    "scaling": false,
                    "envs": {},
                    "additional_properties": {},
                    "support_debug": false
                  }
                ],
                "transition_at": 1585809231902,
                "is_free": false
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryServiceDetailResponse"
            }
          }
        },
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "x-publish-doc": "Y",
        "x-open-region-cloud": "hk,hc,fcs,fcs-super",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/services/{service_id}"
      }
    }
  },
