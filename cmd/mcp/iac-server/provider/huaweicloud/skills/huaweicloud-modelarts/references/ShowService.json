        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "description": "节点亲和的方式,required表示强亲和,服务实例只能调度到指定节点,指定节点不存在则失败。preferred表示弱亲和,服务实例倾向于调度到指定节点,指定节点不满足调度条件,则会调度到其他节点。"
        },
        "pool_infos": {
          "type": "array",
