  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "description": "请求失败时返回的错误对象。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:ModelArts错误码。\n**取值范围**:不涉及。"
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释**:具体错误信息。\n**取值范围**:不涉及。"
        }
      }
    },
    "EngineAndRuntimesResponse": {
      "type": "object",
      "description": "AI引擎及运行镜像响应体。",
      "required": [
        "ai_engine",
        "runtimes",
        "request_mode",
        "arch",
        "status_list"
      ],
      "properties": {
        "ai_engine": {
          "type": "string",
          "description": "AI引擎类型,目前共有以下几种类型:\n- TensorFlow\n- PyTorch\n- MindSpore\n- XGBoost\n- Scikit_Learn\n- Spark_MLlib"
        },
        "runtimes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "运行镜像,如pytorch_1.8.0-cuda_10.2-py_3.7-ubuntu_18.04-x86_64"
        },
        "request_mode": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "请求模式,AI引擎支持部署为同步在线服务或异步在线服务。\n- sync:同步在线服务\n- async:异步在线服务"
        },
        "accelerators": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Accelerator"
          },
          "description": "AI引擎可使用的加速卡。"
        },
        "arch": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "AI引擎架构,目前共两种:\n- x86_64\n- aarch64"
        },
        "status_list": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "AI引擎状态,目前共三种:\n- normal  (正常)\n- deleted (已下线)\n- deleting (下线中)"
        },
        "image_source": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "镜像来源,目前共两种:\n- base_image (基础镜像)\n- uniform_image (统一镜像)"
        }
      }
    },
    "EngineAndRuntimesPageResponse": {
      "type": "object",
      "description": "引擎和模型分页响应参数。",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "不分页的情况下符合查询条件的总数量。",
          "example": 1,
          "minimum": 0,
          "maximum": 1000
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "当前查询结果的数量,不设置offset、limit查询参数时,count与total相同。",
          "example": 1,
          "minimum": 0,
          "maximum": 1000
        },
        "engine_runtimes": {
          "items": {
            "$ref": "#/definitions/EngineAndRuntimesResponse"
          },
          "description": "引擎运行环境。",
          "type": "array"
        }
      }
    },
    "Accelerator": {
      "type": "object",
      "description": "加速卡",
      "properties": {
        "type": {
          "type": "string",
          "description": "加速卡类型,目前共三种:\n- npu\n- gpu\n- none"
        },
        "name": {
          "type": "string",
          "description": "加速卡名称,如SNT9B。"
        },
        "cuda_version": {
          "type": "string",
          "description": "cuda驱动版本。"
        },
        "driver_version_section": {
          "type": "string",
          "description": "驱动版本集合。"
        }
      }
    }
  },
