              "action": "modelarts:trainJob:get"
            }
          ]
        },
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-publish-doc": "Y",
        "x-open-region-cloud": "hk,hc,hws_hk",
        "x-is-registered": "Y"
      }
    }
  },
