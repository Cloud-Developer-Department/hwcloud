  "paths": {
    "/v1/{project_id}/workspaces/{workspace_id}/auth": {
      "post": {
        "tags": [
          "工作空间管理"
        ],
        "summary": "鉴权能否使用当前工作空间资源",
        "description": "鉴权能否使用当前工作空间资源接口用于验证用户是否有权限访问和使用当前工作空间中的资源。该接口适用于以下场景:当用户尝试访问或操作工作空间中的资源时,系统需要确认用户是否具有相应的权限。使用该接口的前提条件是用户已登录且工作空间已存在。鉴权成功后,用户可以正常访问和使用工作空间资源;若鉴权失败,接口将返回相应的错误信息,如用户无权限或工作空间不存在等。",
        "operationId": "ValidateAuthorization",
        "parameters": [
          {
            "in": "body",
            "name": "ValidateAuthorizationRequestBody",
            "description": "工作空间鉴权请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ValidateAuthorizationRequestBody"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**: 调用接口的认证方式分为Token和AK/SK两种,如果您使用的Token方式,此参数为必填,请填写Token的值,获取方式请参见[获取token](modelarts_03_0004.xml)。 \n**约束限制**: 不涉及。 \n**取值范围**: 不涉及。 \n**默认取值**: 不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "**参数解释**:工作空间ID。获取方法请参见[查询工作空间列表](ListWorkspace.xml)。未创建工作空间时默认值为“0”,存在创建并使用的工作空间,以实际取值为准。\n**约束限制**:不涉及。\n**取值范围**:不涉及。\n**默认取值**:0。",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。\n**约束限制**:1 - 64字符,字母、数字和中划线。\n**取值范围**:不涉及。\n**默认取值**:不涉及。",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "工作空间鉴权响应体",
            "examples": {
              "application/json": {
                "results": [
                  {
                    "action": "modelarts:trainJob:get",
                    "verdict": "allow",
                    "action_id": "cf6ad5b9_bd73_4354_b663_364348597e29"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ValidateAuthResultsListResp"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v1/{projectId}/workspaces/{workspaceId}/auth",
        "x-request-examples-description-1": "鉴权当前用户是否可以在当前工作空间下执行此操作",
        "x-request-examples-text-1": {
          "requests": [
            {
              "action_id": "cf6ad5b9_bd73_4354_b663_364348597e29",
              "action": "modelarts:trainJob:get"
            }
          ]
        },
        "x-request-examples-1": {
