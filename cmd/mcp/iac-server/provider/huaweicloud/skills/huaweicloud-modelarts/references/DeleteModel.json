{
  "name": "DeleteModel",
  "summary": "删除AI应用",
  "tags": "AI应用管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/models/{model_id}": {
      "delete": {
        "tags": [
          "AI应用管理"
        ],
        "summary": "删除AI应用",
        "description": "删除AI应用,根据AI应用ID删除指定AI应用,cascade取值为true时除了删除AI应用ID指定的AI应用,还会删除其他与指定AI应用同名不同版本的AI应用;默认只删除当前AI应用ID所对应的AI应用。",
        "operationId": "DeleteModel",
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "description": "需要删除的AI应用ID。",
            "required": true,
            "type": "string",
            "x-example": "be5f9ed6-be9c-4fb1-a952-27b19dbc9a94"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。",
            "required": true,
            "type": "string",
            "x-example": "0500cb339e00d3262f37c01db69d3e61"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "cascade",
            "in": "query",
            "description": "是否级联删除。默认为false,只删除当前模型ID所对应的模型。取值为true时除了删除模型ID指定的模型,还会删除与指定模型同名不同版本的所有模型。一次最多删除20个模型,超过的模型不删除。",
            "required": false,
            "type": "boolean",
            "default": false
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功或者失败的提示信息。",
            "examples": {
              "application/json": {
                "delete_success_list": [
                  "10eb0091-887f-4839-9929-cbc884f1e20e"
                ],
                "delete_failed_list": [
                  {
                    "error_msg": "Failed to delete model, model(759645d9-3672-4db1-bb6d-49ed58b84e10) already deploy service.",
                    "error_code": "ModelArts.3009",
                    "model_id": "e527d311-a947-46da-a6e0-66c49945dfaa"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/DeleteModelResponse"
            }
          }
        },
        "x-request-examples-url-1": "DELETE https://{endpoint}/v1/{project_id}/models/{model_id}",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "x-publish-doc": "Y",
        "x-open-region-cloud": "hk,hc,fcs,fcs-super"
      }
    }
  },
  "definitions": {
    "DeleteModelResponseFailedList": {
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "删除该模型失败的错误提示信息。"
        },
        "error_code": {
          "type": "string",
          "description": "删除该模型失败的错误码。"
        },
        "model_id": {
          "type": "string",
          "description": "删除失败的模型id。"
        }
      }
    },
    "DeleteModelResponse": {
