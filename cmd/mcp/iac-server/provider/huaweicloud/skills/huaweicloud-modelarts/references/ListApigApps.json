{
  "name": "ListApigApps",
  "summary": "获取APP列表",
  "tags": "APP认证管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/app-auth/apps": {
      "get": {
        "x-api-type": "open-api",
        "x-publish-doc": "Y",
        "tags": [
          "APP认证管理"
        ],
        "summary": "获取APP列表",
        "description": "获取APIG APP基本信息列表,用户只能获取自己创建的APP信息。",
        "operationId": "ListApigApps",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "消息体的类型。设置为text/plain,返回临时预览链接。设置为application/octet-stream,返回临时下载链接。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户token。",
            "required": true,
            "type": "string"
          },
          {
            "name": "app_name",
            "in": "query",
            "description": "APP名称。",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "分页展示时,一页展示多少项。默认为1000。",
            "required": false,
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页展示时,从第几页开始。默认为0。",
            "required": false,
            "type": "string"
          },
          {
            "name": "order",
            "in": "query",
            "description": "返回的APP列表排序方式,可选值包括asc、desc。默认为asc。",
            "required": false,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID。获取方法请参见[获取项目ID](modelarts_03_0147.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "返回的APP列表按何属性排序,可选值包括app_name、created_at、updated_at。默认为name。",
            "required": false,
            "type": "string"
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "description": "工作空间ID。获取方法请参见[查询工作空间列表](ListWorkspace.xml)。未创建工作空间时默认值为“0”,存在创建并使用的工作空间,以实际取值为准。",
            "type": "string"
          },
          {
            "name": "iphertext_enabled",
            "in": "query",
            "required": false,
            "description": "是否明文展示appsecret。",
            "type": "boolean"
          },
          {
            "name": "app_ids",
            "in": "query",
            "required": false,
            "description": "需要明文展示的app_id集合。",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "responses": {
