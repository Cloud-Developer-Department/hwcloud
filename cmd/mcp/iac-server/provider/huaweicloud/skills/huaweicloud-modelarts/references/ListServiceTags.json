{
  "name": "ListServiceTags",
  "summary": "查询推理服务标签",
  "tags": "服务管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/services/tms/tags": {
      "get": {
        "x-publish-doc": "Y",
        "x-admin": "N",
        "x-apiexplorer-hide": "N",
        "x-apigateway-request-type": "Public",
        "x-internal": "N",
        "x-support-sdk": "N",
        "x-open-region-cloud": "hk,hc",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/services/tms/tags",
        "tags": [
          "服务管理"
        ],
        "summary": "查询推理服务标签",
        "description": "查询当前项目下的推理服务标签,默认查询所有工作空间,无权限不返回标签数据。",
        "operationId": "ListServiceTags",
        "parameters": [
          {
            "$ref": "#/parameters/projectId"
          },
          {
            "$ref": "#/parameters/headerToken"
          },
          {
            "$ref": "#/parameters/contentType"
          }
        ],
        "responses": {
          "200": {
            "description": "查询项目下service资源类型的所有标签,正常返回。",
            "schema": {
              "$ref": "#/definitions/CombineTmsTagsResponse"
            },
            "examples": {
              "application/json": {
                "tags": [
                  {
                    "key": "model_version",
                    "values": [
                      "0.1",
                      "0.2"
                    ]
                  },
                  {
                    "key": "conda_version",
                    "values": [
                      "10.2",
                      "11.0"
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数非法。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "权限不足。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "description": "请求失败时返回的错误对象。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:ModelArts错误码。\n**取值范围**:不涉及。"
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释**:具体错误信息。\n**取值范围**:不涉及。"
        }
      }
    },
    "CombineTmsTags": {
      "type": "object",
      "description": "多标签相同key合并value的数据结构。",
      "example": {
        "key": "model_version",
        "values": [
          "0.1",
          "0.2"
        ]
      },
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释**:标签的key。\n**取值范围**:长度限制为128个字符,支持任意语种字母、数字、空格,以及_ . : = + - @特殊字符,但首尾不能含有空格,不能以_sys_开头。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)(?<!\\s)$"
        },
        "values": {
          "type": "array",
          "description": "**参数解释**:相同key的标签value合并后的列表。",
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$"
        }
      }
    },
    "CombineTmsTagsResponse": {
      "type": "object",
      "description": "将相同key的标签value去重合并后的返回数据结构。",
      "example": {
        "tags": [
          {
            "key": "model_version",
            "values": [
              "0.1",
              "0.2"
            ]
          },
          {
            "key": "conda_version",
            "values": [
              "10.2",
              "11.0"
            ]
          }
        ]
      },
      "required": [
        "tags"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 200,
          "items": {
            "$ref": "#/definitions/CombineTmsTags"
          },
          "description": "**参数解释**:标签的融合结构,相同key合并。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "projectId": {
      "name": "project_id",
      "in": "path",
      "description": "**参数解释**:用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。\n**约束限制**:1 - 64字符,字母、数字和中划线。\n**取值范围**:不涉及。\n**默认取值**:不涉及。",
      "required": true,
      "type": "string"
    },
    "contentType": {
      "name": "Content-Type",
      "in": "header",
      "description": "该字段内容填为“application/json;charset=utf8。",
      "required": true,
      "type": "string"
    },
    "headerToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数解释**:用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n**约束限制**:不涉及。\n**取值范围**:不涉及。\n**默认取值**:不涉及。",
      "required": true,
      "type": "string"
    }
  },
  "host": "modelarts.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}