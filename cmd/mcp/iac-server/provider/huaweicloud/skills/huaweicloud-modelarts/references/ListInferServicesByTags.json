{
  "name": "ListInferServicesByTags",
  "summary": "通过标签反查资源列表",
  "tags": "服务标签管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/modelarts-service-v2/resource-instances/filter": {
      "post": {
        "tags": [
          "服务标签管理"
        ],
        "summary": "通过标签反查资源列表",
        "description": "该接口适用于需要根据标签或资源名称查找相关资源的场景,例如在资源管理和搜索中,用户可以通过指定标签或进行模糊查询来查找符合特定条件的资源。通过调用此接口,用户可以基于多个标签或资源名称进行精确或模糊查询,若不传标签则返回所有资源。用户必须具有足够的权限,且目标资源需存在。查询成功后,返回符合条件的资源列表;若失败,返回具体的错误信息。常见异常包括权限验证错误、资源不存在错误和参数验证错误。",
        "operationId": "ListInferServicesByTags",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。\n**约束限制:**\n不涉及。\n**取值范围:**\n账号的项目ID。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数解释:**\n指定返回的最大条目数。\n**约束限制:**\n不涉及。\n**取值范围:**\n[1,500]\n**默认取值:**\n10。",
            "required": false,
            "type": "integer",
            "default": 1000,
            "maximum": 1000,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数解释:**\n分页列表查询的偏移量。\n**约束限制:**\noffset必须是limit的整数倍。\n**取值范围:**\n不涉及。\n**默认取值:**\n0。",
            "required": false,
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "format": "int32"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "**参数解释:**\n消息体的类型(格式)。\n**约束限制:**\n不涉及。\n**取值范围:**\n- application/json。\n- application/json;charset=utf-8。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token。通过调用IAM服务获取用户Token接口获取响应消息头中X-Subject-Token的值。获取方法请参见[获取IAM用户Token(使用密码)](modelarts_03_0004.xml)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "ListInferServicesByTagsRequestBody",
            "description": "**参数解释:**\n通过标签查询资源结构体。\n**约束限制:**\n不涉及。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/QueryTmsResourceRequest"
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "description": "**参数解释:**\n工作空间ID,workspaceId将会被设置为null。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "正常查询返回。",
            "examples": {
              "application/json": {
                "resources": [
                  {
                    "resource_id": "6efce7bf-677d-400f-b451-3543ed997a24",
                    "resource_name": "service-79ca",
                    "tags": [
                      {
                        "key": "model_version",
                        "value": "0.1"
                      },
                      {
                        "key": "gpu_type",
                        "value": "v100"
                      }
                    ]
                  }
                ],
                "total_count": 1000
              }
            },
            "schema": {
              "$ref": "#/definitions/ListTmsResourceResponse"
            }
          },
          "400": {
            "description": "参数非法。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "权限不足。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "资源未找到。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-api-type": "open-api",
        "x-publish-doc": "Y",
        "x-request-examples-url-1": "https://{endpoint}/v2/{project_id}/modelarts-service-v2/resource-instances/filter",
        "x-request-examples-text-1": {
          "matches": [
            {
              "key": "resource_name",
              "value": "resource1"
            }
          ],
          "tags": [
            {
              "key": "key1",
              "values": [
                "*value1",
                "value2"
              ]
            }
          ]
        },
        "x-request-examples-1": {
          "matches": [
            {
              "key": "resource_name",
              "value": "resource1"
            }
          ],
          "tags": [
            {
              "key": "key1",
              "values": [
                "*value1",
                "value2"
              ]
            }
          ]
        },
        "x-request-examples-description-1": "通过标签resource_name反查资源列表,匹配资源名称中有resource1的资源,注:模糊匹配。\n",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hk,hc,hcs,hcs_sm,fcs,hcso",
        "x-is-registered": "Y",
        "x-order": 4
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "description": "请求失败时返回的错误对象。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:ModelArts错误码。\n**取值范围**:不涉及。"
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释**:具体错误信息。\n**取值范围**:不涉及。"
        }
      }
    },
    "CombineInferTmsTags": {
      "type": "object",
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n标签的key。\n**取值范围:**\n不涉及。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)(?<!\\s)$"
        },
        "values": {
          "type": "array",
          "description": "**参数解释:**\n相同key的标签value合并后的列表。\n**取值范围:**\n不涉及。",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "description": "多标签相同key合并value的数据结构。",
      "example": {
        "key": "model_version",
        "values": [
          "0.1",
          "0.2"
        ]
      }
    },
    "TmsResource": {
      "type": "object",
      "required": [
        "resource_detail",
        "resource_id",
        "resource_name",
        "tags"
      ],
      "properties": {
        "resource_detail": {
          "type": "object",
          "description": "**参数解释:**\n资源详情,用于扩展,默认为空。\n**取值范围:**\n不涉及",
          "properties": {}
        },
        "resource_id": {
          "type": "string",
          "description": "**参数解释:**\n资源ID。\n**取值范围:**\n不涉及",
          "maxLength": 255
        },
        "resource_name": {
          "type": "string",
          "description": "**参数解释:**\n资源名称。\n**取值范围:**\n不涉及",
          "maxLength": 255
        },
        "tags": {
          "type": "array",
          "description": "**参数解释:**\n当前资源的所有标签。\n**取值范围:**\n不涉及",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/InferTmsTag"
          },
          "maxItems": 20,
          "minItems": 0
        }
      },
      "description": "根据条件查询得到的TMS返回数据结构。",
      "example": {
        "resource_id": "6efce7bf-677d-400f-b451-3543ed997a24",
        "resource_name": "service-79ca",
        "tags": [
          {
            "key": "model_version",
            "value": "0.1"
          },
          {
            "key": "gpu_type",
            "value": "v100"
          }
        ]
      }
    },
    "QueryTmsResourceRequest": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "example": "",
          "description": "**参数解释:**\n匹配项,目前只支持资源名称的模糊匹配。\n**约束限制:**\n不涉及。",
          "items": {
            "$ref": "#/definitions/TmsMatch"
          },
          "maxItems": 1
        },
        "tags": {
          "type": "array",
          "description": "**参数解释:**\n标签匹配项,只支持多个标签与操作,不携带表示查询所有资源。\n**约束限制:**\n不涉及。",
          "items": {
            "$ref": "#/definitions/CombineInferTmsTags"
          },
          "maxItems": 20,
          "minItems": 1
        },
        "without_any_tag": {
          "type": "boolean",
          "description": "**参数解释:**\n是否只查询没有打标签的资源。\n**约束限制:**\n不涉及。\n**取值范围:**\ntrue:只查询没有打标签的资源。\nfalse:查询所有资源。\n**默认取值:**\n不涉及。"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释:**\n指定每一页返回的最大条目数。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n10。"
        },
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释:**\n分页列表的起始页。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n0。"
        }
      },
      "description": "查询TMS资源请求体"
    },
    "TmsMatch": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n匹配项名称,目前只支持resource_name。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "maxLength": 32
        },
        "value": {
          "type": "string",
          "description": "**参数解释:**\n匹配项的值,不区分大小写,key为resource_name时使用模糊查询,匹配资源名称。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "description": "Tms通过标签查询资源时,传入的特殊key-value匹配项,目前只支持传入资源名称进行模糊查询。"
    },
    "ListTmsResourceResponse": {
      "type": "object",
      "required": [
        "resources",
        "total_count"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "description": "**参数解释:**\n通过标签反查出来的资源列表。",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/TmsResource"
          },
          "maxItems": 1000,
          "minItems": 0
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释:**\n总记录数。\n**取值范围:**\n不涉及",
          "minimum": 0
        }
      },
      "description": "通过tms标签查询资源列表的返回体。"
    },
    "InferTmsTag": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n标签键字段。\n**约束限制:**\n不涉及。\n**取值范围:**\n长度为1~128,标签的键可以包含任意语种字母、数字、空格,以及_ . : = + - @特殊字符,但首尾不能含有空格,不能以_sys_开头。\n**默认取值:**\n不涉及。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)(?<!\\s)$"
        },
        "value": {
          "type": "string",
          "description": "**参数解释:**\n标签值字段。\n**约束限制:**\n字母、数字、下划线、点、斜杠、等号、加号、减号和@符号。\n**取值范围:**\n长度为0~255。\n**默认取值:**\n不涉及。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$"
        }
      },
      "description": "**参数解释:**\nTms的标签结构体。\n**取值范围:**\n不涉及。",
      "example": {
        "key": "test",
        "value": "service-gpu"
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "modelarts.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}