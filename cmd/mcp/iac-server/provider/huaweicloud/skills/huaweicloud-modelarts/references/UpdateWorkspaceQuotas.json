{
  "name": "UpdateWorkspaceQuotas",
  "summary": "修改工作空间配额",
  "tags": "工作空间管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces/{workspace_id}/quotas": {
      "put": {
        "tags": [
          "工作空间管理"
        ],
        "summary": "修改工作空间配额",
        "description": "修改工作空间配额。",
        "operationId": "UpdateWorkspaceQuotas",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "工作空间ID。获取方法请参见[查询工作空间列表](ListWorkspace.xml)。未创建工作空间时默认值为“0”,存在创建并使用的工作空间,以实际取值为准。",
            "required": true,
            "type": "string",
            "x-example": "ccd05d1a553b4e188ea878e7dcb85e47"
          },
          {
            "in": "body",
            "name": "UpdateWorkspaceQuotasRequestBody",
            "description": "修改工作空间配额的请求体参数。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateWorkspaceQuotasReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "修改工作空间配额成功的响应参数。",
            "examples": {
              "application/json": {
                "quotas": [
                  {
                    "max_quota": 60000,
                    "update_time": 1574339372000,
                    "resource": "exemlProject.gpu_duration",
                    "quota": 20,
                    "min_quota": -1,
                    "name_cn": "自动学习(图像分类、物体检测、声音分类)训练时长",
                    "unit_cn": "分钟",
                    "name_en": "ExeML training duration (image classification, object detection, and sound classification)",
                    "unit_en": "minute"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/UpdateWorkspaceQuotasResponseBody"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc,fcs-super,hws_hk,hk",
        "x-is-registered": "Y",
        "x-publish-doc": "Y",
        "x-request-examples-text-1": {
          "quotas": [
            {
              "resource": "exemlProject.gpu_duration",
              "quota": 10
            }
          ]
        },
        "x-request-examples-1": {
          "quotas": [
            {
              "resource": "exemlProject.gpu_duration",
              "quota": 10
            }
          ]
        },
        "x-request-examples-url-1": "PUT https://{endpoint}/v1/{project_id}/workspaces/ccd05d1a553b4e188ea878e7dcb85e47/quotas"
      }
    }
  },
  "definitions": {
    "UpdateWorkspaceQuotasReq": {
      "required": [
        "quotas"
      ],
      "properties": {
        "quotas": {
          "type": "array",
          "description": "工作空间配额数据。",
          "items": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "example": "exemlProject.gpu_duration",
                "description": "资源标识。"
              },
              "quota": {
                "type": "integer",
                "example": 10,
                "description": "要修改的配额值。配额值为正整数或-1,-1代表不限制配额。配额值范围不能超过配额的最大值与最小值。可通过调用查询工作空间配额接口查询配额的最大值。"
              }
            },
            "required": [
              "quota",
              "resource"
            ]
          }
        }
      }
    },
    "UpdateWorkspaceQuotasResponseBody": {
      "properties": {
        "quotas": {
          "type": "array",
          "description": "工作空间配额数据。",
          "items": {
            "$ref": "#/definitions/WorkspaceQuotasUpdateResponse"
          }
        }
      }
    },
    "WorkspaceQuotasUpdateResponse": {
      "properties": {
        "max_quota": {
          "type": "integer",
          "example": 60000,
          "description": "配额允许设置的最大值。"
        },
        "update_time": {
          "type": "integer",
          "format": "int64",
          "example": 1470000020000,
          "description": "最后修改时间,UTC。如用户未修改过该资源配额,则该值默认为该工作空间的创建时间。"
        },
        "resource": {
          "type": "string",
          "example": "exemlProject.gpu_duration",
          "description": "资源的唯一标识。"
        },
        "quota": {
          "type": "integer",
          "example": 10,
          "description": "当前配额值。配额值为-1代表不限制配额。"
        },
        "min_quota": {
          "type": "integer",
          "example": -1,
          "description": "配额允许设置的最小值。"
        },
        "name_cn": {
          "type": "string",
          "example": "自动学习(图像分类、物体检测、声音分类)训练时长",
          "description": "配额名称(中文)。"
        },
        "unit_cn": {
          "type": "string",
          "example": "分钟",
          "description": "数量单位(中文)。"
        },
        "name_en": {
          "type": "string",
          "example": "ExeMLtraining duration (image classification, object detection, and soundclassification)",
          "description": "工作空间ID,系统生成的32位UUID,不带橫线。默认的工作空间id为'0'。"
        },
        "unit_en": {
          "type": "string",
          "example": "minute",
          "description": "数量单位(英文)。"
        }
      },
      "description": "quotas属性列表。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "modelarts.af-north-1.myhuaweicloud.com",
