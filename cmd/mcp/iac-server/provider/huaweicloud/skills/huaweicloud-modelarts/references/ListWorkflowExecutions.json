        "updated_at": {
          "type": "string",
          "description": "**参数解释**:Execution执行的更新时间。\n**取值范围**:不涉及。",
          "example": "2020-12-28T14:44:01.118131+08:00",
          "readOnly": true
        },
        "duration": {
          "type": "integer",
          "description": "**参数解释**:Execution执行的运行时长。\n**取值范围**:不涉及。",
          "example": 1000
        },
        "type": {
          "type": "string",
          "description": "**参数解释**:节点的类型。\n**取值范围**:枚举值如下:\n- job:训练\n- labeling:标注\n- release_dataset:数据集发布\n- model:模型发布\n- service:服务部署\n- mrs_job:MRS作业\n- dataset_import:数据集导入\n- create_dataset:创建数据集",
          "enum": [
            "traning_job"
          ],
          "example": "training_job",
          "x-open-region-cloud": "hc,hcs,fcs"
        },
        "instance_id": {
          "type": "string",
          "description": "**参数解释**:实例ID。\n**取值范围**:不涉及。"
        },
        "status": {
          "type": "string",
          "description": "**参数解释**:节点的状态。\n**取值范围**:枚举值如下:\n- init:初始化\n- wait_inputs:等待输入\n- pending:等待\n- creating:创建中\n- created:创建成功\n- create_failed:创建失败\n- running:运行中\n- stopping:停止中\n- stopped:停止\n- timeout:超时\n- completed:完成\n- failed:失败\n- hold:暂停\n- skipped:跳过",
          "enum": [
            "init",
            "wait_inputs",
            "pending",
            "creating",
            "created",
            "create_failed",
            "running",
            "stopping",
            "stopped",
            "timeout",
            "completed",
            "failed",
            "hold",
            "skipped"
          ],
          "x-open-region-cloud": "hc,hcs,fcs"
        },
        "inputs": {
          "type": "array",
          "description": "**参数解释**:节点的输入项。",
          "items": {
            "$ref": "#/definitions/JobInputResp"
          }
        },
        "outputs": {
          "type": "array",
          "description": "**参数解释**:节点的输出项。",
          "items": {
            "$ref": "#/definitions/JobOutputResp"
          }
        },
        "step_uuid": {
          "type": "string",
          "description": "**参数解释**:节点的UUID,唯一性标识。\n**取值范围**:不涉及。"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "**参数解释**:节点的属性。"
        },
        "events": {
