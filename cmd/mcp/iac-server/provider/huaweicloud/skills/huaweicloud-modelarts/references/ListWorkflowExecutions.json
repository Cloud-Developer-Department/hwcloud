  "definitions": {
    "StepExecutionResp": {
      "properties": {
        "step_name": {
          "type": "string",
          "description": "**参数解释**:节点的名称,在一个DAG中唯一。\n**取值范围**:不涉及。",
          "example": "MyStep",
          "maxLength": 64,
          "minLength": 1
        },
        "execution_name": {
          "type": "string",
          "description": "**参数解释**:执行记录的名称。\n**取值范围**:不涉及。",
