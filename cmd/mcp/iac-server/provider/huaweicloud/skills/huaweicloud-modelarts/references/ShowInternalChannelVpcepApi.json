  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/internal-channel-info": {
      "get": {
        "x-api-type": "open-api",
        "x-publish-doc": "Y",
        "x-open-region-cloud": "hk,hc",
        "x-request-examples-url-1": "/v1/b722xxxxxxxxxxxxxxxxxxxxxxeb4674/internal-channel-info",
        "x-request-examples-description-1": "获取VPC访问通道信息",
        "tags": [
          "服务管理"
        ],
        "operationId": "ShowInternalChannelVpcepApi",
        "summary": "查询推理VPC访问通道信息的API",
        "description": "该接口用于查询推理VPC访问通道。",
        "x-is-registered": "Y",
        "x-support-sdk": "N",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户token。",
            "type": "string",
            "minLength": 0,
            "maxLength": 2147483647
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,64}$",
            "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。"
          }
        ],
        "responses": {
          "200": {
            "description": "获取推理VPC访问通道信息。",
            "schema": {
              "$ref": "#/definitions/InternalChannelResponse"
            },
            "examples": {
              "application/json": {
                "dns_domain_name": "xxx.xxx.com",
                "vpcep_info": [
                  {
                    "vpcep_service_id": "2275xxxx-c96f-4xxx-820c-c7xxxxxa7899",
                    "vpcep_service_name": "cn-nxxxx-x.vpcepname.2275xxxx-c96f-4xxx-820c-c7xxxxxa7899",
                    "service_port": 443
                  }
                ]
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "链路追踪ID。",
                "type": "string"
              }
            }
          },
          "401": {
            "description": "鉴权失败",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            },
            "examples": {
              "application/json": {
                "error_code": "ModelArts.0203",
                "error_msg": "Invalid token."
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "链路追踪ID",
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "InternalChannelResponse": {
      "type": "object",
      "properties": {
        "dns_domain_name": {
          "description": "页面调用指南展示的访问域名,可用于添加内网DNS解析。",
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "vpcep_info": {
          "description": "检索到的VPC访问通道信息。",
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/InternalChannelDetail"
          }
        }
      }
    },
    "InternalChannelDetail": {
      "type": "object",
      "properties": {
        "vpcep_service_id": {
          "description": "VPC访问通道vpcep终端节点服务ID。",
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "vpcep_service_name": {
          "description": "VPC访问通道vpcep终端节点服务名称。",
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "service_port": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 65535,
          "description": "VPC访问通道的端口。",
          "example": 443
        }
      }
    },
    "ErrorResponseBody": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "服务内部错误码。",
          "type": "string",
          "pattern": "^ModelArts.\\d{4}$",
          "example": "ModelArts.0101"
        },
        "error_msg": {
          "description": "错误信息。",
          "type": "string",
          "minLength": 0,
          "maxLength": 4096,
          "example": "The request param is invalid."
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "modelarts.af-north-1.myhuaweicloud.com",
