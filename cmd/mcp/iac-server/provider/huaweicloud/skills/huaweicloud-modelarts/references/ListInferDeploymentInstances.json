            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数解释:**\n指定每一页返回的最大条目数。\n**约束限制:**\n不涉及。\n**取值范围:**\n[1,500]\n**默认取值:**\n10。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 500
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数解释:**\n分页列表的起始页。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n0。",
            "required": false,
            "type": "string"
          },
          {
            "name": "pod_name",
            "in": "query",
            "required": false,
            "description": "**参数解释:**\npod名字。\n**取值范围:**\n不涉及。",
            "type": "string"
          }
        ],
