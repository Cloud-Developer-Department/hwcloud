  "paths": {
    "/v2/{project_id}/services/{id}/deployments/{name}/instances": {
      "get": {
        "tags": [
          "服务部署实例管理"
        ],
        "summary": "查询服务部署实例列表",
        "description": "本接口用于查询当前租户的服务部署实例列表,并支持根据服务部署实例的状态进行筛选,包括运行中和已删除状态,同时支持分页和关键词筛选。适用于需要管理和监控服务实例状态的场景。调用此接口前,确保已具备相应的查询权限,并提供可选的筛选条件和分页参数。返回的列表将包含每个服务部署实例的基本信息,如部署名字、最新更新时间、状态等。如果当前租户没有符合条件的服务实例或提供的参数无效,将返回空列表或相应的异常信息,提示用户检查输入数据的有效性和权限。",
        "operationId": "ListInferDeploymentInstances",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。\n**约束限制:**\n不涉及。\n**取值范围:**\n账号的项目ID。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "**参数解释:**\n服务唯一id"
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "**参数解释:**\n服务部署名字,可以为all"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token。通过调用IAM服务获取用户Token接口获取响应消息头中X-Subject-Token的值。获取方法请参见[获取IAM用户Token(使用密码)](modelarts_03_0004.xml)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string"
          },
          {
