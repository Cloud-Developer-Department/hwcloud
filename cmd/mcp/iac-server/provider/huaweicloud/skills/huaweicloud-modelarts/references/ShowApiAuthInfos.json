{
  "name": "ShowApiAuthInfos",
  "summary": "获取API授权关系列表",
  "tags": "APP认证管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/services/{service_id}/app-auth-apis/{api_id}/api-auths": {
      "get": {
        "x-api-type": "open-api",
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/services/{service_id}/app-auth-apis/{api_id}/api-auths",
        "x-publish-doc": "Y",
        "x-open-region-cloud": "hk,hc",
        "x-is-registered": "Y",
        "tags": [
          "APP认证管理"
        ],
        "summary": "获取API授权关系列表",
        "description": "获取指定的API与APP授权关系列表,API的认证方式必须是APP认证,管理员可以获取所有API的授权信息,普通用户只能获取自己有访问权限的服务下的API的授权信息。",
        "operationId": "ShowApiAuthInfos",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "分页展示时,一页展示多少项。默认为1000。",
            "type": "string",
            "default": 1000
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "分页展示时,从第几页开始。默认为0。",
            "type": "string",
            "default": 0
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。"
          },
          {
            "name": "service_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "服务ID。"
          },
          {
            "name": "api_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "API编号。"
          },
          {
            "name": "app_name",
            "in": "query",
            "required": false,
            "description": "APP名称,支持模糊查找。",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "返回的APP列表排序方式,可选值包括asc、desc。默认为asc。",
            "type": "string",
            "default": "asc"
          },
          {
            "name": "show_only",
            "in": "query",
            "required": false,
            "description": "APP信息。枚举值如下:\n- AUTH:只显示已授权的APP信息。\n- UNAUTH:只显示未授权的APP信息。\n默认为空,即显示全部可见的APP信息。",
            "type": "string",
            "enum": [
              "AUTH",
              "UNAUTH"
            ]
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "description": "返回的APP列表按何属性排序。枚举值如下:\n- app_name:应用名称。\n- created_at:应用创建时间。\n- updated_at:应用更新时间。\n默认为app_name。",
            "type": "string",
            "default": "app_name",
            "enum": [
              "app_name",
              "created_at",
              "updated_at"
            ]
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "description": "工作空间ID。获取方法请参见[查询工作空间列表](ListWorkspace.xml)。未创建工作空间时默认值为“0”,存在创建并使用的工作空间,以实际取值为准。",
            "type": "string"
          },
          {
            "name": "iphertext_enabled",
            "in": "query",
            "required": false,
            "description": "是否明文展示appsecret。",
            "type": "boolean"
          },
          {
            "name": "app_ids",
            "in": "query",
            "required": false,
            "description": "明文展示的app_id集合。",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ApiAuthInfosResponse"
            },
            "examples": {
              "application/json": {
                "auths": [
                  {
                    "app": {
                      "app_id": "fb1a9eadd87b48abbd74b8ba1755dffd",
                      "app_name": "app_13e0",
                      "app_remark": "ds",
                      "app_key": "b11ae87581b04b5284aa92b0d4ae332c",
                      "app_secret": "cb5d1b57368b4f129b635332a03bf0e3",
                      "user_id": "04f258c8fb00d42a1f65c00df88cc4dc",
                      "project_id": "04f258c84780d5a52f3bc00dc15aa5e7",
                      "app_type": "APIG",
                      "app_codes": [
                        "53a7c6de82be4671b93414adf98c1c507d5cef29fbdd48d88a4dddb668b0f0ad"
                      ],
                      "created_at": 1683173880900,
                      "updated_at": 1700531228874,
                      "bounded_api_count": 28
                    },
                    "authed": true
                  }
                ],
                "count": 1,
                "total_count": 1
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
