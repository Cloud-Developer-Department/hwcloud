        "tags": [
          "训练作业管理"
        ],
        "summary": "创建训练作业镜像保存任务",
        "description": "创建训练作业镜像保存任务。",
        "operationId": "CreateSaveImageJob",
        "parameters": [
          {
            "$ref": "#/parameters/projectIDParam"
          },
          {
            "$ref": "#/parameters/trainingJobIDParam"
          },
          {
            "$ref": "#/parameters/taskIDParam"
          },
          {
            "name": "CreateSaveImageJobRequestBody",
            "in": "body",
            "description": "镜像保存任务的请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ImageSaveJob"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "create image save job successfully",
            "schema": {
              "$ref": "#/definitions/ImageSaveJobResponse"
            },
            "examples": {
              "application/json": {
                "name": "imagesave",
                "namespace": "dev",
                "tag": 0.1,
                "description": "hello world!",
                "status": "ACTIVE",
                "message": "building",
                "create_time": 1686718209968
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ImageSaveJobResponse": {
      "allOf": [
        {
          "$ref": "#/definitions/ImageSaveJob"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "镜像状态。枚举值如下:\n- INIT:初始化。\n- CREATING:镜像保存中,此时训练作业不可用。\n- CREATE_FAILED:镜像保存失败。\n- ACTIVE:镜像保存成功,保存的镜像可以在SWR控制台查看,同时可以基于保存的镜像创建训练作业。"
            },
            "message": {
              "type": "string",
              "description": "镜像创建的时间,UTC毫秒。"
            },
            "create_time": {
              "type": "integer",
              "format": "int64",
              "description": "镜像保存操作过程中,展示构建信息。"
            }
          }
        }
      ]
    },
    "ImageSaveJob": {
      "type": "object",
      "properties": {
        "name": {
          "description": "镜像名称,长度限制512个字符,支持小写字母、数字、中划线、下划线和点。",
          "type": "string",
          "pattern": "^[a-z0-9._-]{1,512}$",
          "example": "imagesave"
        },
        "namespace": {
          "description": "镜像所属组织,可以在SWR控制台“组织管理”创建和查看。",
          "type": "string",
          "example": "dev"
        },
        "tag": {
          "description": "镜像tag,长度限制64个字符, 支持大小写字母、数字、中划线、下划线和点。",
          "type": "string",
          "pattern": "^[a-z0-9._-]{1,64}$",
          "example": 0.1
        },
        "description": {
          "description": "该镜像所对应的描述信息,长度限制512个字符。",
          "type": "string",
          "minLength": 0,
          "maxLength": 512,
          "example": "hello world!"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "trainingJobIDParam": {
      "in": "path",
      "name": "training_job_id",
      "required": true,
      "type": "string",
      "description": "训练作业ID。获取方法请参见[查询训练作业列表](ListTrainingJobs.xml)。"
    },
    "taskIDParam": {
      "in": "path",
      "name": "task_id",
      "required": true,
      "type": "string",
      "description": "训练作业的任务名称。可从训练作业详情中的status.tasks字段中获取。"
    },
    "projectIDParam": {
      "in": "path",
      "name": "project_id",
      "required": true,
      "type": "string",
      "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。"
    }
  },
  "host": "modelarts.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
