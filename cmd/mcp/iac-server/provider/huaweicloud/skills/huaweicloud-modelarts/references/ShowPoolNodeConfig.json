                "description": "This field is the request ID number for task tracking. Format is request_uuid-timestamp-hostname."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "NodeconfigMeta": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "**参数解释**: 固定为node-config。\n**取值范围**: 不涉及。",
          "x-open-region-cloud": "hc,hk"
        }
      }
    },
    "NodeconfigSpec": {
      "type": "object",
      "required": [
        "configs"
      ],
      "properties": {
        "configs": {
          "type": "object",
          "description": "**参数解释**: 节点自定义配置;当前支持节点绑核、是否启用缓存清理、是否启用透明大页。\n\"configs\": {\n\t\t\t\"cpu_manager\": {\n\t\t\t\t\"mode\": \"static/none\" //static为启用绑核, none为不启用绑核\n\t\t\t},\n\t\t\t\"drop_cache\": {\n\t\t\t\t\"mode\": \"enable/disable\" // enable启用缓存清理\n\t\t\t},\n\t\t\t\"transparent_hugepage\": {\n\t\t\t\t\"mode\": \"always/madvise/never\" // always为启用透明大页,never为关闭透明大页,madvice交给系统选择。\n\t\t\t}\n}",
          "x-open-region-cloud": "hc,hk"
        }
      }
    },
    "NodeConfig": {
      "type": "object",
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec",
        "status"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "description": "**参数解释**: 固定为v2。\n**取值范围**: 不涉及。",
          "x-open-region-cloud": "hc,hk"
        },
        "kind": {
          "type": "string",
          "description": "**参数解释**: 固定为NodeConfig。\n**取值范围**: 不涉及。",
          "x-open-region-cloud": "hc,hk"
        },
        "metadata": {
          "$ref": "#/definitions/NodeconfigMeta",
          "description": "**参数解释**: 资源池节点的metadata信息。"
        },
        "spec": {
          "$ref": "#/definitions/NodeconfigSpec",
          "description": "**参数解释**: 资源池节点的规格信息。"
        },
        "status": {
          "$ref": "#/definitions/NodeconfigStatus",
          "description": "**参数解释**: 资源池节点的状态信息。"
        }
      },
      "example": "{     \"apiVersion\": \"v2\",     \"kind\": \"NodeConfig\",     \"metadata\": {         \"name\": \"node-config\"     },     \"spec\": {         \"configs\": {             \"cpu_manager\": {                 \"mode\": \"static/none\"             },             \"drop_cache\": {                 \"mode\": \"enable/disable\"             },             \"transparent_hugepage\": {                 \"mode\": \"always/madvise/never\"             }         }     },     \"status\": {         \"phase\": \"Updating\"     } }"
    },
    "NodeconfigStatus": {
      "type": "object",
      "required": [
        "phase"
      ],
      "properties": {
        "phase": {
          "description": "**参数解释**: 插件实例的状态。\n**取值范围**: 可选值如下:\n- Pending:安装中,表示插件正在安装中。\n- Running:运行中,表示插件全部实例状态都在运行中,插件正常使用。\n- Updating:升级中,表示插件正在更新中。\n- Abnormal:不可用,表示插件状态异常,插件不可使用。可单击状态查看失败原因。\n- Deleting:删除中,表示插件正在删除中。",
          "type": "string",
          "enum": [
            "Pending",
            "Updating",
            "Running",
            "Abnormal",
            "Deleting"
          ],
          "x-open-region-cloud": "hc,hk"
        }
      }
    },
    "ErrorRsp": {
