        "summary": "创建AI应用",
        "description": "导入元模型创建AI应用。\n执行代码、模型需先上传至OBS(训练作业生成的模型已默认存储到OBS)。",
        "operationId": "CreateModel",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。",
            "required": true,
            "type": "string",
            "x-example": "0500cb339e00d3262f37c01db69d3e61"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "in": "body",
            "name": "CreateModelRequestBody",
            "description": "创建模型的请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateModelRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "模型创建成功。",
            "examples": {
              "application/json": {
                "model_id": "7feb7235-ed9c-48ae-9833-2876b2458445"
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateModelResponse"
            }
          }
        },
        "x-request-examples-description-1": "创建AI应用。设置AI应用名称为“mnist”,版本为“1.0.0”,类型为“TensorFlow”,模型文件来源于OBS桶。",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "x-publish-doc": "Y",
        "x-open-region-cloud": "hk,hc,fcs",
        "x-request-examples-text-1": {
