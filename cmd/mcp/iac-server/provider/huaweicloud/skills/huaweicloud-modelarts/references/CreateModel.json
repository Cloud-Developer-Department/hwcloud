  },
  "definitions": {
    "ModelTemplate": {
      "type": "object",
      "description": "模板的相关配置项。",
      "required": [
        "template_inputs",
        "template_id"
      ],
      "properties": {
        "infer_format": {
          "type": "string",
          "description": "输入输出模式id,提供时覆盖模板中的内置输入输出模式。"
        },
        "template_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CreateModelRequestTemplateInput"
          },
          "description": "模板输入项配置,即配置模型的源路径。"
        },
        "template_id": {
          "type": "string",
          "description": "所使用的模板id,模板中会内置一个输入输出模式。"
        }
      }
    },
    "Packages": {
      "type": "object",
      "required": [
        "package_name"
      ],
      "properties": {
        "package_version": {
          "type": "string",
          "description": "依赖包版本。不填时默认安装最新版本。不能含有中文及特殊字符&!'\"<>=。"
        },
        "package_name": {
          "type": "string",
          "description": "依赖包名称。请确保包名正确且存在。不能含有中文及特殊字符&!'\"<>=。"
        },
        "restraint": {
          "type": "string",
          "description": "版本限制条件,当且仅当package_version存在时必填,取值包含:\n- EXACT:和指定的版本完全一致。\n- ATLEAST:不低于指定的版本。\n- ATMOST:不高于指定的版本。",
          "enum": [
            "EXACT",
            "ATLEAST",
            "ATMOST"
          ]
        }
      }
    },
    "GuideDoc": {
      "type": "object",
      "required": [
        "doc_name",
        "doc_url"
      ],
      "properties": {
        "doc_url": {
          "type": "string",
          "example": "http://some_safe_host",
          "description": "文档http(s)链接。"
        },
        "doc_name": {
          "type": "string",
          "example": "使用样例",
          "description": "文档名称,支持1-48位可见字符(含中文),只能以英文大小写字母或者中文字符开头,名称可以包含字母、中文、数字、中划线、下划线。"
        }
      }
    },
    "CreateModelRequestModelApis": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "description": "请求协议,可选HTTP和HTTPS。"
        },
        "method": {
          "type": "string",
          "description": "请求方法,可选post、get。",
          "enum": [
            "post",
            "get"
          ]
        },
        "input_params": {
          "$ref": "#/definitions/ModelInOutputParams"
        },
        "output_params": {
          "$ref": "#/definitions/ModelInOutputParams"
        },
        "url": {
          "type": "string",
          "description": "推理请求URL路径"
        }
      },
      "description": "模型所有的apis入参出参信息"
    },
    "CreateModelResponse": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "example": "10eb0091-887f-4839-9929-cbc884f1e20e",
          "description": "模型id。"
        }
      },
      "description": "创建模型成功的响应。"
    },
    "CreateModelRequestInferParams": {
      "properties": {
        "protocol": {
          "type": "string",
          "description": "请求协议,可选HTTP和HTTPS。"
        },
        "min": {
          "type": "number",
          "description": "参数的最小值。当param_type为int或float时可选填,默认为空。"
        },
        "method": {
          "type": "string",
          "description": "请求方法,可选“post”、“get”。",
          "enum": [
            "post",
            "get"
          ]
        },
        "max": {
          "type": "number",
          "description": "参数的最大值。当param_type为int或float时可选填,默认为空。"
        },
        "param_desc": {
          "type": "string",
          "description": "参数描述,建议长度设置不超过100个字符,默认为空。"
        },
        "param_name": {
          "type": "string",
          "description": "参数名,建议长度设置不超过64个字符。"
        },
        "url": {
          "type": "string",
          "description": "api代表的url路径。"
        },
        "param_type": {
          "type": "string",
          "description": "参数类型,取值可选int/string/float/timestamp/date/file。",
          "enum": [
            "int",
            "string",
            "number",
            "array",
            "object",
            "file"
          ]
        }
      },
      "description": "模型推理参数",
      "required": [
        "protocol",
        "method",
        "param_name",
        "url",
        "param_type"
      ]
    },
    "CreateModelRequestTemplateInput": {
      "type": "object",
      "required": [
        "input",
        "input_id"
      ],
      "properties": {
        "input": {
          "type": "string",
          "description": "模板输入路径,可以是obs文件路径,obs目录路径,使用多输入项的模板创建模型时,如果模板定义的目标路径input_properties是一样的,则此处输入的obs目录或者obs文件不能重名,否则会覆盖。"
        },
        "input_id": {
          "type": "string",
          "description": "输入项id,从模板详情中获取。"
        }
      }
    },
    "ModelInOutputParams": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "example": "object",
          "description": "JSON Schema中表示类型的字段,可选object。",
          "enum": [
            "object"
          ]
        },
        "properties": {
          "$ref": "#/definitions/ParamsData"
        }
      },
      "description": "apis中的输入输出参数,以JSON Schema格式描述。"
    },
    "ModelDependencies": {
      "type": "object",
      "required": [
        "installer",
        "packages"
      ],
      "properties": {
        "installer": {
          "type": "string",
          "description": "安装方式,当前只支持pip。",
          "enum": [
            "pip"
          ]
        },
        "packages": {
          "type": "array",
          "description": "依赖包集合。",
          "items": {
            "$ref": "#/definitions/Packages"
          }
        }
      },
      "description": "运行代码及模型需安装的包列表。"
    },
    "CreateModelRequest": {
      "properties": {
        "model_docs": {
          "type": "array",
          "description": "模型说明文档列表,最多三篇。**公共参数**",
          "items": {
            "$ref": "#/definitions/GuideDoc"
          },
          "maxItems": 3,
          "minItems": 0
        },
        "template": {
          "description": "模板的相关配置项。使用模板导入模型(即model_type为Template)时必选。**模板参数**",
          "$ref": "#/definitions/ModelTemplate"
        },
        "model_version": {
          "type": "string",
          "description": "模型版本,格式需为“数值.数值.数值”,其中数值为1-2位正整数, 注意:版本不可以出现例如01.01.01等以0开头的版本号形式。**公共参数**",
          "pattern": "^(\\d\\.|[1-9]\\d\\.){2}(\\d|([1-9]\\d))$"
        },
        "source_job_version": {
          "type": "string",
          "description": "来源训练作业的版本,模型是从训练作业产生的可填写,用于溯源;如模型是从第三方元模型导入,则为空。默认值为空。**非模板参数**"
        },
        "source_location": {
          "type": "string",
          "description": "模型所在的OBS路径或SWR镜像地址。",
          "pattern": "http[s]?://[^/]+/.+|^[a-zA-Z0-9.:_-]+/[a-z0-9._-]+/[a-zA-Z0-9._-]+:[a-zA-Z0-9._-]+"
        },
        "source_copy": {
          "type": "string",
          "description": "镜像复制开关,仅当“model_type”为“Image”时有效。\n\n取值范围:\n\n- true:默认值,复制镜像模式,无法极速创建AI应用,SWR源目录中的镜像更改或删除不影响服务部署。\n- false:不复制镜像模式,可极速创建AI应用,更改或删除SWR源目录中的镜像会影响服务部署。"
        },
        "initial_config": {
          "type": "string",
          "description": "模型配置文件转成的字符串。建议通过配置文件initial_config来提供“apis”、“dependencies”、“input_params”、“output_params”、\"health\"、\"readiness_health\"、\"startup_health\"等字段的信息。**非模板参数**"
        },
        "execution_code": {
          "type": "string",
          "description": "执行代码存放的OBS地址,默认值为空,名称固定为“customize_service.py”。推理代码文件需存放在模型“model”目录。该字段不需要填,系统也能自动识别出model目录下的推理代码。**公共参数**",
          "x-apiexplorer-hide": true
        },
        "source_job_id": {
          "type": "string",
          "description": "来源训练作业的ID,模型是从训练作业产生的可填写,用于溯源;如模型是从第三方元模型导入,则为空。默认值为空。**非模板参数**"
        },
        "model_type": {
          "type": "string",
          "description": "模型类型,取值为TensorFlow/Image/PyTorch/Template/MindSpore,从配置文件读取。**公共参数**",
          "enum": [
            "TensorFlow",
            "MXNet",
            "Caffe",
            "Spark_MLlib",
            "Scikit_Learn",
            "XGBoost",
            "Image",
            "PyTorch",
            "Template"
          ]
        },
        "output_params": {
          "type": "array",
          "description": "模型的输出参数集,默认为空,params结构如表 params结构所示。从配置文件的apis读取,用户提供“initial_config”字段即可,可不填该字段。**非模板参数**",
          "items": {
            "$ref": "#/definitions/CreateModelRequestInferParams"
          }
        },
        "description": {
          "type": "string",
          "description": "模型备注信息,1-100位长度,不能包含&!'\"<>=。**公共参数**",
          "pattern": "^[^&!'\"<>=]{1,100}$"
        },
        "runtime": {
          "type": "string",
          "description": "模型运行时环境,runtime可选值与model_type相关,详细见[推理支持的常用引擎及其Runtime](https://support.huaweicloud.com/usermanual-standard-modelarts/inference-modelarts-0003.html#section2)。",
          "enum": [
            "python2.7",
            "python3.6"
          ]
        },
        "model_metrics": {
          "type": "string",
          "description": "模型精度信息,从配置文件读取,可不填。**非模板参数**"
        },
        "source_type": {
          "type": "string",
          "description": "模型来源的类型,当前仅可取值“auto”,用于区分通过自动学习部署过来的模型(不提供模型下载功能);用户通过训练作业和其他方式部署的模型不设置此值。默认值为空。**非模板参数**",
          "enum": [
            "auto"
          ],
          "x-apiexplorer-hide": true
        },
        "dependencies": {
          "type": "array",
          "description": "推理代码及模型需安装的包,默认为空。从配置文件读取,可不填。**非模板参数**",
          "items": {
            "$ref": "#/definitions/ModelDependencies"
          }
        },
        "workspace_id": {
          "type": "string",
          "description": "工作空间ID。获取方法请参见[查询工作空间列表](ListWorkspace.xml)。未创建工作空间时默认值为“0”,存在创建并使用的工作空间,以实际取值为准。",
          "default": "0"
        },
        "model_algorithm": {
          "type": "string",
          "description": "模型算法,从配置文件读取,可不填。如:“predict_analysis”、“object_detection ”、“image_classification”。**非模板参数**"
        },
        "apis": {
          "type": "array",
          "description": "模型所有的apis入参出参信息,从配置文件中解析出来的,可不填。**非模板参数**",
          "items": {
            "$ref": "#/definitions/CreateModelRequestModelApis"
          }
        },
        "model_name": {
          "type": "string",
          "description": "模型名称,支持1-64位可见字符(含中文),名称可以包含字母、中文、数字、中划线、下划线。**公共参数**",
          "minLength": 1,
          "maxLength": 64
        },
        "install_type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "部署类型,只支持小写。可选real-time、edge、batch,默认为[\"real-time\",\"edge\",\"batch\"]。"
        },
        "input_params": {
          "type": "array",
          "description": "模型的输入参数集,默认为空,params结构如表 params结构所示。从配置文件的apis读取,用户提供“initial_config”字段即可,可不填该字段。**非模板参数**",
          "items": {
            "$ref": "#/definitions/CreateModelRequestInferParams"
          }
        }
      },
      "description": "创建模型的请求体参数信息。",
      "required": [
        "model_version",
        "source_location",
        "model_type",
        "model_name"
      ],
      "type": "object"
    },
    "ParamsData": {
      "type": "object",
      "description": "JSON Schema中表示对象元素的properties字段,可在其中定义参数,包括参数名及其类型。",
      "example": {
        "images": {
          "type": "file"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "modelarts.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}