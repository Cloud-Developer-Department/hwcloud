                    "is_free": false,
                    "over_quota": false,
                    "extend_params": 1
                  },
                  {
                    "specification": "modelarts.vm.gpu.pnt004",
                    "billing_spec": "modelarts.vm.gpu.pnt004",
                    "category": "GPU",
                    "cpu_info": {
                      "arch": "x86",
                      "cpu": 8.0
                    },
                    "memory_info": {
                      "unit": "GB",
                      "memory": 32
                    },
                    "gpu_info": {
                      "unit": "GB",
                      "brand": "NVIDIA",
