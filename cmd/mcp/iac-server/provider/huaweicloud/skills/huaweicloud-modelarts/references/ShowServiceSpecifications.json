                    "display_en": "CPU: 8 vCPUs | 32 GiB GPU:Pnt004",
                    "display_cn": "CPU:8 Core 32 GiB GPU:1 * Pnt004",
                    "is_open": true,
                    "spec_status": "normal",
                    "is_free": false,
                    "over_quota": false,
                    "extend_params": 1
                  },
                  {
                    "specification": "modelarts.vm.ai1.snt3",
                    "billing_spec": "modelarts.vm.ai1.snt3",
                    "category": "NPU",
                    "cpu_info": {
                      "arch": "x86",
                      "cpu": 2.0
                    },
                    "memory_info": {
                      "unit": "GB",
