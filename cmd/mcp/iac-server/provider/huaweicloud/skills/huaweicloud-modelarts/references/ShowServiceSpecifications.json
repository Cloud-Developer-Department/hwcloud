                    },
                    "npu_info": {
                      "unit": "MB",
                      "npu": 0,
                      "memory": 0
                    },
                    "display_en": "CPU: 2 vCPUs | 8 GiB",
                    "display_cn": "CPU: 2 Core 8 GiB",
                    "is_open": true,
