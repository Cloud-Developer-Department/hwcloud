{
  "name": "ShowServiceSpecifications",
  "summary": "查询支持的服务部署规格",
  "tags": "服务管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/services/specifications": {
      "get": {
        "x-api-type": "open-api",
        "tags": [
          "服务管理"
        ],
        "summary": "查询支持的服务部署规格",
        "description": "查询支持的服务部署规格列表。",
        "operationId": "ShowServiceSpecifications",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。",
            "required": true,
            "type": "string",
            "x-example": "eae4ac05e51643c8a8ad644eace39981"
          },
          {
            "name": "is_personal_cluster",
            "in": "query",
            "description": "是否查询专属资源池支持的服务部署规格列表,默认为false。",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-example": false
          },
          {
            "name": "infer_type",
            "in": "query",
            "description": "推理方式,枚举值如下:\n- real-time:在线服务,默认值\n- batch:批量服务\n- edge: 边缘服务",
            "required": false,
            "type": "string",
            "default": "real-time",
            "enum": [
              "real-time",
              "batch",
              "edge"
            ],
            "x-example": "real-time"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "指定每一页返回的最大条目数,默认为1000。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "返回数据的起始偏移量,默认为0。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "服务部署规格列表。",
            "examples": {
              "application/json": {
                "total_count": 3,
                "count": 3,
                "specifications": [
                  {
