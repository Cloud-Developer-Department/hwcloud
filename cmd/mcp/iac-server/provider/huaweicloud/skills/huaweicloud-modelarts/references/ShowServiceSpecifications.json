        },
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "x-publish-doc": "Y",
        "x-open-region-cloud": "hk,hc,fcs,fcs-super",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/services/specifications"
      }
    }
  },
  "definitions": {
    "CpuInfo": {
      "properties": {
        "arch": {
          "type": "string",
          "example": "x86",
          "description": "架构类型。"
        },
        "cpu": {
          "type": "number",
          "example": 1.0,
          "description": "CPU核心数。"
        }
      }
    },
    "Specification": {
      "properties": {
        "is_open": {
          "type": "boolean",
          "example": true,
          "description": "是否开放此规格,默认是true;取值为false时,用户需要提工单申请才可使用此规格。",
          "default": true
        },
        "spec_status": {
          "type": "string",
          "example": "normal",
          "description": "规格状态,取值为:\n- normal:正常。\n- sellout:售罄,售罄时无法使用此规格部署服务。",
          "enum": [
            "normal",
            "sellout"
          ]
        },
        "specification": {
          "type": "string",
          "example": "modelarts.vm.cpu.2u",
          "description": "规格的唯一标识。"
        },
        "billing_spec": {
          "type": "string",
          "example": "modelarts.vm.cpu.2u",
          "description": "计费对应规格的唯一标识。"
        },
        "category": {
          "type": "string",
          "example": "CPU",
          "description": "规格类型。"
        },
        "cpu_info": {
          "type": "object",
          "description": "规格的CPU信息。",
          "$ref": "#/definitions/CpuInfo"
        },
        "memory_info": {
          "type": "object",
          "description": "规格的内存信息。",
          "$ref": "#/definitions/MemoryInfo"
        },
        "gpu_info": {
          "type": "object",
          "description": "规格的GPU信息。",
          "$ref": "#/definitions/GpuInfo"
        },
        "npu_info": {
          "type": "object",
          "description": "规格的NPU信息。",
          "$ref": "#/definitions/NpuInfo"
        },
        "source_type": {
          "type": "string",
          "example": "auto",
          "description": "此规格应用于模型的类型,取值为空或auto,默认为空,代表是用户自己产生的模型;取值为auto时,代表是自动学习训练的模型,计费方式有差别。"
        },
        "is_free": {
          "type": "boolean",
          "description": "当前规格是否是免费规格,“true”表示是免费规格。"
        },
        "over_quota": {
          "type": "boolean",
          "description": "当前规格是否超过可用配额,“true”表示超过可用配额。"
        },
        "extend_params": {
          "type": "integer",
          "format": "int32",
          "description": "计费因子。"
        },
        "display_en": {
          "type": "string",
          "description": "规格的英文描述。"
        },
        "display_cn": {
          "type": "string",
          "description": "规格的中文描述。"
        }
      },
      "description": "服务部署规格。",
      "type": "object"
    },
    "Specifications": {
      "properties": {
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "部署服务规格总数。"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "当前列表的规格数量。"
        },
        "specifications": {
          "type": "array",
          "description": "支持的服务部署规格列表。",
          "items": {
            "$ref": "#/definitions/Specification"
          }
        }
      },
      "description": "服务部署规格列表。"
    },
    "NpuInfo": {
      "properties": {
        "brand": {
          "type": "string",
          "example": "Ascend",
          "description": "品牌。"
        },
        "version": {
          "type": "string",
          "example": "Snt3",
          "description": "卡类型。"
        },
        "unit": {
          "type": "string",
          "example": "MB",
          "description": "单位。"
        },
        "memory": {
          "type": "integer",
          "example": 1024,
          "description": "卡内存大小。"
        },
        "npu": {
          "type": "integer",
          "example": 1,
          "description": "NPU数。"
        }
      }
    },
    "GpuInfo": {
      "properties": {
        "brand": {
          "type": "string",
          "example": "NVIDIA",
          "description": "品牌。"
        },
        "version": {
          "type": "string",
          "example": "T4",
          "description": "卡类型。"
        },
        "unit": {
          "type": "string",
          "example": "MB",
          "description": "单位。"
        },
        "memory": {
          "type": "integer",
          "example": 1024,
          "description": "卡内存大小。"
        },
        "gpu": {
          "type": "number",
          "example": 1.0,
          "description": "GPU数。"
        }
      }
    },
    "MemoryInfo": {
      "properties": {
        "unit": {
          "type": "string",
          "example": "MB",
          "description": "单位。"
        },
        "memory": {
          "type": "integer",
          "example": 1024,
          "description": "内存大小。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "modelarts.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
