{
  "name": "ListServices",
  "summary": "查询服务列表",
  "tags": "服务管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/services": {
      "get": {
        "tags": [
          "服务管理"
        ],
        "summary": "查询服务列表",
        "description": "查询模型服务列表。",
        "operationId": "ListServices",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。",
            "required": true,
            "type": "string",
            "x-example": "eae4ac05e51643c8a8ad644eace39981"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "service_id",
            "in": "query",
            "description": "服务ID,在创建服务时即可在返回体中获取,也可通过查询服务列表接口获取当前用户拥有的服务,其中service_id字段即为服务ID。默认不过滤服务ID。",
            "required": false,
            "type": "string",
            "x-example": "a6f49042-771c-451a-bb53-e175fc7d95cf"
          },
          {
            "name": "service_name",
            "in": "query",
            "description": "服务名称,由用户创建时指定,默认不过滤服务名。",
            "required": false,
            "type": "string",
            "x-example": "service"
          },
          {
            "name": "model_id",
            "in": "query",
            "description": "模型ID,在创建AI应用时即可在返回体中获取,也可通过查询AI应用列表接口获取当前用户拥有的AI应用,其中model_id字段即为模型ID。默认不过滤模型ID。",
            "required": false,
            "type": "string",
            "x-example": "ab0de459-cfd7-45fa-813c-92416b4fe77c"
          },
          {
            "name": "workspace_id",
            "in": "query",
            "description": "工作空间ID。获取方法请参见[查询工作空间列表](ListWorkspace.xml)。未创建工作空间时默认值为“0”,存在创建并使用的工作空间,以实际取值为准。",
            "required": false,
            "type": "string",
            "x-example": 0
          },
          {
            "name": "infer_type",
            "in": "query",
            "description": "推理方式,默认不过滤推理方式。取值包含:\n- real-time:在线服务\n- batch:批量服务\n- edge: 边缘服务",
            "required": false,
            "type": "string",
            "enum": [
              "real-time",
              "batch",
              "edge"
            ],
            "x-example": "real-time"
          },
          {
            "name": "status",
            "in": "query",
            "description": "服务状态,默认不过滤服务状态,取值包含:\n- running:运行中,服务正常运行。\n- deploying:部署中,服务正在部署,包含打镜像和调度资源部署。\n- concerning:告警,后端实例部分存在异常。\n- failed:失败,服务部署失败,失败原因可以看事件和日志标签页。\n- stopped:停止。\n- finished:只有批量服务会有这个状态,表示运行完成。\n- stopping: 停止中。\n- deleting: 删除中。\n- pending: 待启动,仅在线有这个状态。\n- waiting: 资源排队中,仅在线服务有这个状态。",
            "required": false,
            "type": "string",
            "enum": [
              "running",
              "deploying",
              "concerning",
              "failed",
              "stopped",
              "finished"
            ],
            "x-example": "running"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页列表的起始页,默认为0。",
            "required": false,
            "type": "integer",
            "default": 0,
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "指定每一页返回的最大条目数,默认为1000。",
            "required": false,
            "type": "integer",
            "default": 1000,
            "x-example": 1000
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "指定排序字段,枚举值如下:\n- publish_at: 服务发布时间,默认值\n- service_name: 服务名称\n- transition_at:更新时间",
            "required": false,
            "type": "string",
            "default": "publish_at",
            "enum": [
              "publish_at",
              "service_name"
            ],
            "x-example": "publish_at"
          },
          {
            "name": "order",
            "in": "query",
            "description": "排序方式,枚举值如下:\n- asc : 递增排序\n- desc: 递减排序,默认值",
            "required": false,
            "type": "string",
            "default": "desc",
            "enum": [
              "asc",
              "desc"
            ],
            "x-example": "desc"
          },
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "description": "标签,默认不过滤标签。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "服务列表",
            "examples": {
              "application/json": {
                "total_count": 1,
                "count": 1,
                "services": [
                  {
                    "failed_times": 1,
                    "owner": "b575785bcece44beb23597770fb819f9",
                    "infer_type": "real-time",
                    "service_name": "mnist",
                    "description": "",
                    "project": "b575785bcece44beb23597770fb819f9",
                    "invocation_times": 50,
                    "publish_at": 1243143243,
                    "workspace_id": 0,
                    "is_shared": false,
                    "service_id": "195c1f2d-136d-40af-a0f3-db5717d2634a",
                    "shared_count": 0,
                    "tenant": "b575785bcece44beb23597770fb819f9",
                    "status": "running"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListServicesResponse"
            }
          }
        },
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "x-publish-doc": "Y",
        "x-open-region-cloud": "hk,hc,fcs,fcs-super",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/services"
      }
    }
  },
  "definitions": {
    "ListServicesResponse": {
      "properties": {
        "total_count": {
          "type": "integer",
          "example": 1,
          "description": "不分页的情况下符合查询条件的总服务数量。"
        },
        "count": {
          "type": "integer",
          "example": 1,
          "description": "当前查询结果的服务数量,不设置offset、limit查询参数时,count与total相同。"
        },
        "services": {
          "type": "array",
          "description": "查询到的服务集合。",
          "items": {
            "$ref": "#/definitions/ListServices"
          }
        }
      },
      "description": "查询模型服务列表成功的响应。"
    },
    "ListServices": {
      "properties": {
        "failed_times": {
          "type": "integer",
          "format": "int64",
          "example": 0.0,
          "description": "服务调用失败次数。"
        },
        "owner": {
          "type": "string",
          "example": "eae4ac05e51643c8a8ad644eace39981",
          "description": "服务归属用户。"
        },
        "due_time": {
          "type": "number",
          "example": 1574771643518.0,
          "description": "在线服务自动停止时间,距“1970.1.1 0:0:0 UTC”毫秒数,未配置自动停止则不返回。"
        },
        "finished_time": {
          "type": "number",
          "example": 1574771643518.0,
          "description": "批量服务完成时间,距“1970.1.1 0:0:0 UTC”的毫秒数;仅当服务是批量服务时返回。"
        },
        "infer_type": {
          "type": "string",
          "example": "real-time",
          "description": "推理方式,取值包含:\n- real-time:在线服务\n- batch:批量服务\n- edge:边缘服务",
          "enum": [
            "real-time",
            "batch",
            "edge"
          ]
        },
        "service_name": {
          "type": "string",
          "example": "service-1234",
          "description": "服务名称。"
        },
        "description": {
          "type": "string",
          "example": "list services",
          "description": "服务描述。"
        },
        "project": {
          "type": "string",
          "example": "eae4ac05e51643c8a8ad644eace39981",
          "description": "服务归属项目。"
        },
        "invocation_times": {
          "type": "integer",
          "format": "int64",
          "example": 100.0,
          "description": "服务的总调用次数。"
        },
        "publish_at": {
          "type": "integer",
          "format": "int64",
          "example": 1574770228888.0,
          "description": "服务最新的发布时间,距“1970.1.1 0:0:0 UTC”的毫秒数。"
        },
        "workspace_id": {
          "type": "string",
          "example": "0",
          "description": "工作空间ID。"
        },
        "schedule": {
          "type": "array",
          "description": "服务调度配置,未配置则不返回。",
          "items": {
            "$ref": "#/definitions/Schedule"
          }
        },
        "start_time": {
          "type": "number",
          "example": 1574773828880.0,
          "description": "批量服务启动时间,距“1970.1.1 0:0:0 UTC”的毫秒数;仅当服务是批量服务时返回。"
        },
        "operation_time": {
          "type": "number",
          "example": 1574771643518.0,
          "description": "当前请求的操作时间。"
        },
        "is_shared": {
          "type": "boolean",
          "example": false,
          "description": "是否是订阅的服务。True表示为订阅服务。"
        },
        "service_id": {
          "type": "string",
          "example": "de70af4c-332b-41de-9f19-9e45c86e486f",
          "description": "服务ID。"
        },
        "progress": {
          "type": "integer",
          "example": 100,
          "description": "部署进度,当状态是deploying时返回。"
        },
        "shared_count": {
          "type": "number",
          "example": 0.0,
          "description": "订阅的服务数。"
        },
        "tenant": {
          "type": "string",
          "example": "xxx-user",
          "description": "服务归属租户。"
        },
        "status": {
          "type": "string",
          "example": "running",
          "description": "服务状态,取值包含:\n- running:运行中,服务正常运行。\n- deploying:部署中,服务正在部署,包含打镜像和调度资源部署。\n- concerning:告警,后端实例部分存在异常。\n- failed:失败,服务部署失败,失败原因可以看事件和日志标签页。\n- stopped:停止。\n- finished:只有批量服务会有这个状态,表示运行完成。",
          "enum": [
            "running",
            "deploying",
            "concerning",
            "failed",
            "stopped",
            "finished"
          ]
        },
        "is_opened_sample_collection": {
          "type": "string",
          "description": "是否打开数据采集,默认“false”。"
        },
        "transition_at": {
          "type": "number",
          "example": 1574771643518.0,
          "description": "服务状态转化时间。"
        },
        "is_free": {
          "type": "boolean",
          "description": "服务是否是免费规格类型。"
        },
        "additional_properties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "服务附加属性,未配置则不返回。"
        }
      },
      "description": "查询服务列表的服务结构。",
      "type": "object"
    },
    "Schedule": {
      "properties": {
        "duration": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "对应时间单位的数值,比如2小时后停止,则time_unit填HOURS,duration填2。"
        },
        "time_unit": {
          "type": "string",
          "example": "HOURS",
          "description": "调度时间单位,可选DAYS/HOURS/MINUTES。"
        },
        "type": {
          "type": "string",
          "example": "stop",
          "description": "调度类型,当前仅支持取值为stop,即运行指定时间后自动停止。"
        }
      },
      "description": "服务调度配置。",
      "required": [
        "duration",
        "time_unit",
        "type"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "modelarts.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}