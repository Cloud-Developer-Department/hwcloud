{
  "name": "ShowInferServiceTags",
  "summary": "查询资源标签",
  "tags": "服务标签管理",
  "productshort": "ModelArts",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/modelarts-service-v2/{resource_id}/tags": {
      "get": {
        "tags": [
          "服务标签管理"
        ],
        "summary": "查询资源标签",
        "description": "该接口适用于需要获取资源(如模型、数据集、服务等)的标签信息的场景,例如在资源管理或分类中,用户可以通过查询标签来了解资源的用途、状态或其他属性。通过调用此接口,用户可以通过资源ID获取指定资源的所有标签列表。用户必须具有足够的权限,且目标资源需存在。查询成功后,返回资源的标签列表;若失败,返回具体的错误信息。常见异常包括权限验证错误、资源不存在错误和参数验证错误。",
        "operationId": "ShowInferServiceTags",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n用户项目ID。获取方法请参见[获取项目ID和名称](modelarts_03_0147.xml)。\n**约束限制:**\n不涉及。\n**取值范围:**\n账号的项目ID。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "name": "resource_id",
            "in": "path",
            "description": "**参数解释:**\n待创建标签的资源ID。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "**参数解释:**\n消息体的类型(格式)。\n**约束限制:**\n不涉及。\n**取值范围:**\n- application/json。\n- application/json;charset=utf-8。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token。通过调用IAM服务获取用户Token接口获取响应消息头中X-Subject-Token的值。获取方法请参见[获取IAM用户Token(使用密码)](modelarts_03_0004.xml)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string"
          },
          {
            "name": "workspace_id",
            "in": "query",
            "description": "**参数解释:**\n工作空间ID,workspaceId将会被设置为null。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "正常查询返回。",
            "examples": {
              "application/json": {
                "tags": [
                  {
                    "key": "test",
                    "value": "service-gpu"
                  },
                  {
                    "key": "model_version",
                    "value": "0.1"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ResourceTagsResponse"
            }
          },
          "400": {
            "description": "请求参数不合法。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "鉴权非法。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "权限不足。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "资源未找到。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-api-type": "open-api",
        "x-publish-doc": "Y",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hk,hc,hcs,hcs_sm,fcs,hcso",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "https://{endpoint}/v2/{project_id}/service/a55eba18-1ebf-4e9a-8229-d2d3b593a3dc/tags",
        "x-request-examples-description-1": "查询资源标签。",
        "x-order": 2
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "description": "请求失败时返回的错误对象。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:ModelArts错误码。\n**取值范围**:不涉及。"
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释**:具体错误信息。\n**取值范围**:不涉及。"
        }
      }
    },
    "ResourceTagsResponse": {
      "type": "object",
      "required": [
        "tags"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "description": "**参数解释:**\n资源标签返回列表。",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/InferTmsTag"
          },
          "maxItems": 10,
          "minItems": 0
        }
      },
      "description": "查询资源标签的返回数据。"
    },
    "InferTmsTag": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n标签键字段。\n**约束限制:**\n不涉及。\n**取值范围:**\n长度为1~128,标签的键可以包含任意语种字母、数字、空格,以及_ . : = + - @特殊字符,但首尾不能含有空格,不能以_sys_开头。\n**默认取值:**\n不涉及。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)(?<!\\s)$"
        },
        "value": {
          "type": "string",
          "description": "**参数解释:**\n标签值字段。\n**约束限制:**\n字母、数字、下划线、点、斜杠、等号、加号、减号和@符号。\n**取值范围:**\n长度为0~255。\n**默认取值:**\n不涉及。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$"
        }
      },
      "description": "**参数解释:**\nTms的标签结构体。\n**取值范围:**\n不涉及。",
      "example": {
        "key": "test",
        "value": "service-gpu"
      }
    }
  },
  "version": "2.0",
  "parameters": {},
