  "definitions": {
    "SmsTemplateVariableAttrReq": {
      "title": "SmsTemplateVariableAttrReq",
      "type": "object",
      "required": [
        "variable_index",
        "variable_type"
      ],
      "properties": {
        "variable_desc": {
          "type": "string",
          "description": "变量说明,当变量类型为TEXT时,必填",
          "minLength": 0,
          "maxLength": 100,
          "example": "test"
        },
        "variable_index": {
          "type": "integer",
          "format": "int32",
          "description": "变量索引,对应模板内容变量索引",
          "minimum": 1,
          "maximum": 20,
          "example": 1
        },
        "variable_type": {
          "type": "string",
          "pattern": "PHONE|CHARDIGIT|DATETIME|MONEY|TEXT|NEWTEXT|LONGTEXT",
          "description": "变量类型,目前支持:PHONE|CHARDIGIT|DATETIME|MONEY|TEXT|NEWTEXT|LONGTEXT",
          "example": "TEXT"
        }
      }
    },
    "ApiTemplateResponse": {
      "properties": {
        "id": {
          "type": "string",
          "description": "模板主键ID",
          "minLength": 1,
          "maxLength": 64,
          "x-example": "460a2427-37eb-4229-bee9-0eba4d8a897f"
        },
        "template_name": {
          "type": "string",
          "description": "模板名称",
          "minLength": 1,
          "maxLength": 128,
          "example": "auto_test789"
        }
      },
      "title": "ApiTemplateResponse"
    },
    "SmsTemplateReq": {
      "title": "SmsTemplateReq",
      "x-imports": "com.fasterxml.jackson.annotation.JsonAlias;",
      "required": [
        "app_id",
        "template_content",
        "template_name",
        "template_type",
        "region"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "description": "应用主键ID",
          "minLength": 1,
          "maxLength": 64,
          "example": "9e61f59c-1a6b-4ee5-9651-5bca450694b3"
        },
        "brackets": {
          "type": "string",
          "description": "中括号类型。支持枚举值:\n1. CN: 中文类型\n2. GB: 英文类型",
          "minLength": 1,
          "maxLength": 16,
          "example": "GB"
        },
        "region": {
          "type": "string",
          "description": "地域\n1. cn:国内\n2. intl:",
          "minLength": 1,
          "maxLength": 16,
          "x-annotations": [
            "@NotBlank",
            "@JsonAlias({\"location\", \"region\"})"
          ],
          "example": "cn"
        },
        "send_country": {
          "type": "array",
          "description": "发送国家id列表,只有地域为国际时,该字段有效",
          "items": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 2147483647
          },
          "minItems": 0,
          "maxItems": 3,
          "example": ""
        },
        "sign_id": {
          "type": "string",
          "description": "签名主键ID,只有地域为国内时,该字段有效",
          "minLength": 1,
          "maxLength": 64,
          "example": "******10-c3fb-427e-965c-a98ae844c5bd"
        },
        "template_content": {
          "type": "string",
          "description": "模板内容",
          "minLength": 1,
          "maxLength": 500,
          "example": "test"
        },
        "template_desc": {
          "type": "string",
          "description": "模板描述",
          "minLength": 0,
          "maxLength": 500,
          "example": "test"
        },
        "template_name": {
          "type": "string",
          "description": "模板名称",
          "minLength": 1,
          "maxLength": 128,
          "example": "auto_test789"
        },
        "template_type": {
          "type": "string",
          "description": "模板类型。只有地域为国内时,该字段有效。支持枚举值:\n1. VERIFY_CODE_TYPE: 验证码类\n2. PROMOTION_TYPE: 推广类\n3. NOTIFY_TYPE: 通知类",
          "minLength": 1,
          "maxLength": 32,
          "example": "NOTIFY_TYPE"
        },
        "universal_template": {
          "type": "integer",
          "format": "int32",
          "description": "是否为通用模板\n1. 0: 非通用模板\n2. 1: 通用模板",
          "minimum": 1,
          "maximum": 2147483647,
          "example": 0
        },
        "variable_attributes": {
          "type": "array",
          "description": "模板参数",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/SmsTemplateVariableAttrReq"
          }
        },
        "flow_status": {
          "type": "string",
          "description": "流程状态\n1. Pending: 待提交\n2. Reviewing: 待审核\n3. Disable:停用",
          "pattern": "(Pending|Reviewing|Disable)",
          "example": "Pending"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
