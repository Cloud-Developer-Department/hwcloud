  "definitions": {
    "ErrorResponse": {
      "properties": {
        "error_code": {
          "type": "string",
          "example": "CC.00000000",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "网络繁忙,请稍后再试",
          "description": "错误描述"
        }
      }
    },
    "Ruleset": {
      "description": "创建规则集信息",
      "required": [
        "project_id",
        "template_name",
        "language",
        "rule_ids",
        "is_default"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "description": "项目ID",
          "example": "24b97ef1e7a042fb912625b14c8e99f0",
          "minLength": 1,
          "maxLength": 50
        },
        "template_name": {
          "type": "string",
          "description": "新规则集名称",
          "example": "自定义test",
          "minLength": 1,
          "maxLength": 500
        },
        "language": {
          "type": "string",
          "description": "规则集语言",
          "example": "cpp",
          "minLength": 1,
          "maxLength": 128
        },
        "is_default": {
          "type": "string",
          "description": "如果有基于的规则集则是1,没有基于的规则集则是0",
          "example": "0",
          "minLength": 1,
          "maxLength": 1
        },
        "rule_ids": {
          "type": "string",
          "description": "新启用规则ids",
          "example": "8139,8138",
          "minLength": 1,
          "maxLength": 4000
        },
        "uncheck_ids": {
          "type": "string",
          "description": "新关闭规则id",
          "example": "1101,1102",
          "minLength": 1,
          "maxLength": 4000
        },
        "template_id": {
          "type": "string",
          "description": "规则集ID",
          "example": "da303d80d2594faca60dbcc2e29c18aa",
          "minLength": 1,
          "maxLength": 50
        },
        "custom_attributes": {
          "type": "array",
          "description": "自定义规则参数项,支持修改规则阈值",
          "items": {
            "$ref": "#/definitions/CustomAttributes"
          }
        }
      }
    },
    "RuleConfig": {
      "properties": {
        "id": {
          "type": "integer",
          "example": 251,
          "description": "规则配置ID"
        },
        "rule_id": {
          "type": "integer",
          "example": 11707,
          "description": "规则ID"
        },
        "default_value": {
          "type": "string",
          "example": 20,
          "description": "默认值"
        },
        "option_value": {
          "type": "string",
          "example": 10,
          "description": "当前"
        },
        "option_key": {
          "type": "string",
          "example": "threshold",
          "description": "当前规则配置项key"
        },
        "option_name": {
          "type": "string",
          "example": "threshold",
          "description": "当前规则配置项名称"
        },
        "template_id": {
          "type": "string",
          "example": "99f573075fe24e769ad96c676511c823",
          "description": "规则集id"
        },
        "description": {
          "type": "string",
          "example": "代码复杂度超过阈值,则会被识别为超大圈复杂度,与圈复杂度统计区别在于统计SWITCH的时候,只统计SWITCH的个数,不统计case,default,必填",
          "description": "描述"
        }
      }
    },
    "RulesetRes": {
      "required": [
        "template_id"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "example": "9e16b*********9471ce5d",
          "description": "规则集ID"
        }
      }
    },
    "CustomAttributesRule": {
      "properties": {
        "rule_id": {
          "type": "string",
          "description": "规则ID",
          "example": 11712
        },
        "value": {
          "type": "string",
          "description": "attribute的问题级别,0致命,1严重,2一般,3提示",
          "example": 2
        },
        "rule_config_list": {
          "type": "array",
          "description": "规则阈值详细",
          "items": {
            "$ref": "#/definitions/RuleConfig"
          }
        }
      }
    },
    "CustomAttributes": {
      "properties": {
        "attribute": {
          "type": "string",
          "description": "配置项属性,severity:为问题级别",
          "example": "severity"
        },
        "rules": {
          "type": "array",
          "description": "规则详细",
          "items": {
            "$ref": "#/definitions/CustomAttributesRule"
          }
        }
      }
    }
  },
