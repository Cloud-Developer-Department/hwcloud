{
  "name": "CreateTaskMultipartFile",
  "summary": "创建上传分片文件任务",
  "tags": "二进制成分分析",
  "productshort": "DevSecurity",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/sbc/task/multipart/create": {
      "post": {
        "tags": [
          "SBC"
        ],
        "summary": "创建上传分片文件任务",
        "description": "因文件上传系统大小限制,用户需要对待上传文件进行分片,调用接口上传分片文件后执行二进制成分分析扫描任务。\n具体步骤如下:\n1. 调用创建上传分片文件任务接口,从返回结果中获取到upload_id。\n2. 调用上传分片文件接口,入参填入文件分片相关参数以及upload_id。\n3. 调用结束上传分片文件任务接口,通知服务后台合并分片后的文件。\n4. 调用创建二进制成分分析扫描任务接口执行二进制成分分析扫描任务。",
        "operationId": "CreateTaskMultipartFile",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "认证Token",
            "required": true,
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "请求类型",
            "required": true,
            "type": "string",
            "x-example": "application/json"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方式请参见[获取项目ID](devsecurity_03_0019.xml)。",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 32
          },
          {
            "in": "body",
            "name": "CreateTaskMultipartFileRequestBody",
            "description": "创建上传分片文件任务对象",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateTaskMultipartFileRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "响应体",
            "examples": {
              "application/json": {
                "data": {
                  "upload_id": "00000000000000000000000000000000",
                  "file_path": "/secbinarycheck/pre-signed/2024/01/01/00000000-0000-0000-0000-000000000000",
                  "file_name": "test"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/TaskMultipartFileRspBody"
            }
          },
          "400": {
            "description": "错误响应体",
            "schema": {
