            }
          },
          "429": {
            "description": "错误响应体",
            "schema": {
              "$ref": "#/definitions/ErrorRspBody"
            }
          }
        },
        "x-api-type": "open-api",
        "x-open-region-cloud": "hws,hcs,fcs",
        "x-is-registered": "Y",
        "x-support-sdk": "N",
        "x-api-framework": "RestfulAPI",
        "x-api-position": "Region_ZONE",
        "x-api-user": "IAM_User",
        "x-sec-authority-parameter-url": "project_id",
        "x-sec-auditlog": "Y",
        "x-sec-upload-download": 0,
        "x-api-highrisk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/{project_id}/sbc/task/multipart/create",
        "x-request-examples-1": {
          "file_name": "test"
        }
      }
    }
  },
