{
  "name": "UploadTaskMultipartFile",
  "summary": "上传分片文件",
  "tags": "二进制成分分析",
  "productshort": "DevSecurity",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/sbc/task/multipart": {
      "post": {
        "tags": [
          "SBC"
        ],
        "summary": "上传分片文件",
        "description": "上传分片文件",
        "operationId": "UploadTaskMultipartFile",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "认证Token",
            "required": true,
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "请求类型",
            "required": true,
            "type": "string",
            "x-example": "application/json"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "用户项目ID,获取方式请参见[获取项目ID](devsecurity_03_0019.xml)。",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 32
          },
          {
            "name": "upload_id",
            "in": "formData",
            "description": "文件分片ID,通过“创建上传分片文件任务”接口获取响应中的upload_id字段值。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "file_path",
            "in": "formData",
            "description": "文件路径",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "file_name",
            "in": "formData",
            "description": "文件名称",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "part_number",
            "in": "formData",
            "description": "文件分段号",
            "required": true,
            "type": "integer",
            "maximum": 10000,
            "minimum": 1
          },
          {
            "name": "part_size",
            "in": "formData",
            "description": "文件分段大小",
            "required": true,
            "type": "integer",
            "maximum": 2147483647,
            "minimum": 1
          },
          {
            "name": "file",
            "in": "formData",
            "description": "文件分段号对应的分片文件",
            "required": true,
            "type": "file"
          }
        ],
        "responses": {
          "200": {
            "description": "响应体",
            "examples": {
              "application/json": {
                "data": {
                  "upload_id": "00000000000000000000000000000000",
                  "file_path": "/secbinarycheck/pre-signed/2024/01/01/00000000-0000-0000-0000-000000000000",
                  "file_name": "test",
                  "part_number": 1
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/TaskMultipartFileRspBody"
            }
          },
          "400": {
            "description": "错误响应体",
            "schema": {
              "$ref": "#/definitions/ErrorRspBody"
            }
          },
          "401": {
            "description": "错误响应体",
            "schema": {
              "$ref": "#/definitions/ErrorRspBody"
            }
          },
          "429": {
            "description": "错误响应体",
            "schema": {
              "$ref": "#/definitions/ErrorRspBody"
            }
          }
        },
        "x-api-type": "open-api",
        "x-open-region-cloud": "hws,hcs,fcs",
        "x-is-registered": "Y",
        "x-support-sdk": "N",
        "x-api-framework": "RestfulAPI",
        "x-api-position": "Region_ZONE",
        "x-api-user": "IAM_User",
        "x-sec-authority-parameter-url": "project_id",
        "x-sec-authority-parameter-body": "upload_id,file_path,file_name",
        "x-sec-auditlog": "Y",
        "x-sec-upload-download": 1,
        "x-api-highrisk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/{project_id}/sbc/task/multipart",
        "x-request-examples-1": {
          "upload_id": "00000000000000000000000000000000",
          "file_path": "/secbinarycheck/pre-signed/2024/01/01/00000000-0000-0000-0000-000000000000",
          "file_name": "test",
          "part_number": 1,
          "part_size": 100,
          "file": "testfile"
        }
      }
    }
  },
  "definitions": {
    "ErrorRspBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回错误对象"
    },
    "TaskMultipartFileRspBody": {
      "properties": {
        "data": {
          "type": "object",
          "description": "响应内容",
          "properties": {
            "file_path": {
              "type": "string",
              "example": "/",
              "description": "文件路径",
              "minLength": 1,
              "maxLength": 128
            },
            "file_name": {
              "type": "string",
              "example": "filename.txt",
              "description": "文件名称",
              "minLength": 1,
              "maxLength": 128
            },
            "upload_id": {
              "type": "string",
              "example": "0",
              "description": "文件分片ID",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      },
      "description": "分片文件响应对象"
    }
  },
