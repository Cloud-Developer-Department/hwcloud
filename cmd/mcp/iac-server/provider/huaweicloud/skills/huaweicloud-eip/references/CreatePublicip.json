  "definitions": {
    "CreatePublicipRequestBody": {
      "description": "创建弹性公网IP并绑定带宽的请求参数",
      "required": [
        "bandwidth",
        "publicip"
      ],
      "properties": {
        "bandwidth": {
          "description": "带宽对象",
          "$ref": "#/definitions/CreatePublicipBandwidthOption"
        },
        "enterprise_project_id": {
          "type": "string",
          "maxLength": 36,
          "minLength": 0,
          "default": 0,
          "description": "企业项目ID。最大长度36字节,带“-”连字符的UUID格式,或者是字符串“0”。\n 创建弹性公网IP时,给弹性公网IP绑定企业项目ID。\n 不指定该参数时,默认值是 0"
        },
        "publicip": {
          "description": "弹性公网IP对象",
          "$ref": "#/definitions/CreatePublicipOption"
        }
      }
    },
    "PublicipCreateResp": {
      "properties": {
        "bandwidth_size": {
          "type": "integer",
          "format": "int32",
          "description": "带宽大小,单位为Mbit/s。"
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "弹性公网IP申请时间(UTC时间)"
        },
        "id": {
          "type": "string",
          "maxLength": 36,
          "description": "弹性公网IP唯一标识"
        },
        "public_ip_address": {
          "type": "string",
          "maxLength": 15,
          "description": "IPv4时是申请到的弹性公网IP地址,IPv6时是IPv6地址对应的IPv4地址"
        },
        "status": {
          "type": "string",
          "enum": [
            "FREEZED",
            "BIND_ERROR",
            "BINDING",
            "PENDING_DELETE",
            "PENDING_CREATE",
            "NOTIFYING",
            "NOTIFY_DELETE",
            "PENDING_UPDATE",
            "DOWN",
            "ACTIVE",
            "ELB",
            "ERROR",
            "VPN"
          ],
          "description": "功能说明:弹性公网IP的状态\n 取值范围:冻结FREEZED,绑定失败BIND_ERROR,绑定中BINDING,释放中PENDING_DELETE, 创建中PENDING_CREATE,创建中NOTIFYING,释放中NOTIFY_DELETE,更新中PENDING_UPDATE, 未绑定DOWN ,绑定ACTIVE,绑定ELB,绑定VPN,失败ERROR。"
        },
        "tenant_id": {
          "type": "string",
          "maxLength": 36,
          "description": "项目ID"
        },
        "type": {
          "type": "string",
          "maxLength": 36,
          "description": "功能说明:弹性IP弹性公网IP的类型\n 取值范围:5_telcom(电信),5_union(联通),5_bgp(全动态BGP),5_sbgp(静态BGP),5_ipv6\n 东北-大连:5_telcom、5_union\n 华南-广州:5_bgp、5_sbgp\n 华东-上海二:5_bgp、5_sbgp\n 华北-北京一:5_bgp、5_sbgp、5_ipv6\n 亚太-香港:5_bgp\n 亚太-曼谷:5_bgp\n 亚太-新加坡:5_bgp\n 非洲-约翰内斯堡:5_bgp\n 西南-贵阳一:5_bgp、5_sbgp\n 华北-北京四:5_bgp、5_sbgp\n 约束:必须是系统具体支持的类型publicip_id为IPv4端口,所以\"publicip_type\"字段未给定时,默认为5_bgp。"
        },
        "public_ipv6_address": {
          "type": "string",
          "maxLength": 39,
          "description": "IPv4时无此字段,IPv6时为申请到的弹性公网IP地址"
        },
        "ip_version": {
          "type": "integer",
          "format": "int32",
          "enum": [
            4,
            6
          ],
          "description": "IP版本信息,取值范围是4和6"
        },
        "enterprise_project_id": {
          "type": "string",
          "maxLength": 36,
          "description": "企业项目ID。最大长度36字节,带“-”连字符的UUID格式,或者是字符串“0”。\n 创建弹性公网IP时,给弹性公网IP绑定企业项目ID。"
        },
        "alias": {
          "type": "string",
          "maxLength": 64,
          "description": "功能说明:弹性公网IP名称\n取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)"
        }
      },
      "description": "弹性公网IP对象"
    },
    "CreatePublicipOption": {
      "required": [
        "type"
      ],
      "properties": {
        "ip_address": {
          "type": "string",
          "maxLength": 15,
          "description": "功能说明:希望申请到的弹性公网IP的地址,不指定时由系统自动分配\n 约束:必须为IP地址格式,且必须在可用地址池范围内"
        },
        "type": {
          "type": "string",
          "description": "功能说明:弹性公网IP的类型\n 取值范围:5_telcom(电信),5_union(联通),5_bgp(全动态BGP),5_sbgp(静态BGP),5_ipv6\n 东北-大连:5_telcom、5_union\n 华南-广州:5_bgp、5_sbgp\n 华东-上海二:5_bgp、5_sbgp\n 华北-北京一:5_bgp、5_sbgp、5_ipv6\n 亚太-香港:5_bgp\n 亚太-曼谷:5_bgp\n 亚太-新加坡:5_bgp\n 非洲-约翰内斯堡:5_bgp\n 西南-贵阳一:5_bgp、5_sbgp\n 华北-北京四:5_bgp、5_sbgp\n 约束:必须是系统具体支持的类型。\n publicip_id为IPv4端口,所以\"publicip_type\"字段未给定时,默认为5_bgp。"
        },
        "ip_version": {
          "type": "integer",
          "format": "int32",
          "enum": [
            4,
            6
          ],
          "default": 4,
          "description": "功能说明:弹性IP弹性公网IP的版本\n 取值范围:4、6,分别表示创建ipv4和ipv6\n 约束:必须是系统具体支持的类型\n 不填或空字符串时,默认创建ipv4"
        },
        "alias": {
          "type": "string",
          "maxLength": 64,
          "description": "功能说明:弹性公网IP名称\n取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)"
        },
        "port_id": {
          "type": "string",
          "maxLength": 36,
          "description": "功能说明:端口id\n 约束:必须是存在的端口id,如果该端口不存在或端口已绑定EIP则会提示出错。"
        }
      },
      "description": "创建弹性公网IP的IP对象"
    },
    "CreatePublicipBandwidthOption": {
      "required": [
        "share_type"
      ],
      "properties": {
        "charge_mode": {
          "type": "string",
          "enum": [
            "bandwidth",
            "traffic"
          ],
          "default": "bandwidth",
          "description": "功能说明:按流量计费还是按带宽计费。\n取值范围:bandwidth,traffic。\n 不填或为空时默认是bandwidth。\n 其中IPv6国外默认是bandwidth,国内默认是traffic。取值为traffic,表示流量计费。"
        },
        "id": {
          "type": "string",
          "maxLength": 36,
          "description": "功能说明:带宽ID\n 创建WHOLE类型带宽的弹性公网IP时可以指定之前的共享带宽创建\n 取值范围:WHOLE类型的带宽ID"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "功能说明:带宽名称\n 取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)\n 如果share_type是PER,该参数必须带,如果share_type是WHOLE并且id有值,该参数会忽略。"
        },
        "share_type": {
          "type": "string",
          "enum": [
            "WHOLE",
            "PER"
          ],
          "description": "功能说明:带宽类型\n取值范围:PER,WHOLE(PER为独占带宽,WHOLE是共享带宽)。\n约束:该字段为WHOLE时,必须指定带宽ID。"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "功能说明:带宽大小\n 取值范围:默认1Mbit/s~2000Mbit/s(具体范围以各区域配置为准,请参见控制台对应页面显示)。\n 约束:share_type是PER,该参数必须带,如果share_type是WHOLE并且id有值,该参数会忽略。\n 注意:调整带宽时的最小单位会根据带宽范围不同存在差异。\n 小于等于300Mbit/s:默认最小单位为1Mbit/s。\n 300Mbit/s~1000Mbit/s:默认最小单位为50Mbit/s。\n 大于1000Mbit/s:默认最小单位为500Mbit/s。"
        }
      },
      "description": "创建弹性公网IP时,携带的待绑定带宽信息"
    },
    "CreatePublicipResponseBody": {
      "required": [
        "publicip"
      ],
      "properties": {
        "publicip": {
          "description": "弹性公网IP对象",
          "$ref": "#/definitions/PublicipCreateResp"
        }
      },
      "description": "创建弹性公网IP的响应体"
    },
    "FailedRsp": {
      "properties": {
        "message": {
          "description": "服务异常错误信息描述",
          "type": "string",
          "maxLength": 256,
          "minLength": 0
        },
        "code": {
          "description": "服务异常错误信息编码",
          "type": "string",
          "maxLength": 36,
          "minLength": 0
        }
      },
      "description": "服务异常时返回的异常信息"
    }
  },
