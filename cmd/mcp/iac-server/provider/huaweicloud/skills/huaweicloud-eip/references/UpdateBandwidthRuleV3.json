  "definitions": {
    "BandwidthRuleDict": {
      "description": "带宽分组规则字段",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "- 功能说明:带宽组规则唯一标识"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "- 功能说明:带宽规则名称\n- 取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)"
        },
        "description": {
          "type": "string",
          "description": "- 功能说明:带宽规则说明\n- 取值范围:1-255个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)"
        },
        "bandwidth_id": {
          "type": "string",
          "format": "uuid",
          "description": "- 功能说明:带宽唯一标识"
        },
        "admin_state_up": {
          "type": "boolean",
          "default": true,
          "description": "- 功能说明:配置状态,为False时配置不生效。"
        },
        "egress_size": {
          "type": "integer",
          "description": "- 功能说明:出网带宽最大值,单位M bps\n- 取值范围[0,n],其中n为所属带宽的带宽大小(size字段)。0表示设置为最大带宽。"
        },
        "egress_guarented_size": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "- 功能说明:出网保底带宽大小,单位M bps。\n- 取值范围[0,x],其中x为所属带宽剩余的保障额。"
        },
        "publicip_info": {
          "type": "array",
          "description": "- 功能说明:带宽对应的弹性公网IP信息\n- 约束与限制:WHOLE类型的带宽支持多个弹性公网IP,PER类型的带宽只能对应一个弹性公网IP",
          "items": {
            "$ref": "#/definitions/PublicipInfoDict"
          }
        }
      }
    },
    "PublicipInfoDict": {
      "description": "带宽绑定的公网IP信息",
      "properties": {
        "publicip_address": {
          "type": "string",
          "format": "ipv4",
          "description": "- 功能说明:弹性公网IP或者IPv6端口的地址"
        },
        "publicip_id": {
          "type": "string",
          "format": "uuid",
          "description": "- 功能说明:带宽对应的弹性公网IP或者IPv6端口的唯一标识"
        },
        "publicip_type": {
          "type": "string",
          "maxLength": 36,
          "description": "- 功能说明:弹性公网IP的类型\n\n- \n\n- \n\n- \n\n- \n- 取值范围:5_bgp(全动态BGP),5_sbgp(静态BGP),5_youxuanbgp(优选BGP)\n   - 华南-广州:5_bgp、5_sbgp\n   - 华东-上海一:5_bgp、5_sbgp\n   - 华东-上海二:5_bgp、5_sbgp\n   - 华北-北京一:5_bgp、5_sbgp\n   - 中国-香港:5_bgp、5_youxuanbgp\n   - 亚太-曼谷:5_bgp\n   - 亚太-新加坡:5_bgp\n   - 非洲-约翰内斯堡:5_bgp\n   - 西南-贵阳一:5_sbgp\n   - 华北-北京四:5_bgp、5_sbgp\n   - 拉美-圣地亚哥:5_bgp\n   - 拉美-圣保罗一:5_bgp\n   - 拉美-墨西哥城一:5_bgp\n   - 拉美-布宜诺斯艾利一:5_bgp\n   - 拉美-利马一:5_bgp\n   - 拉美-圣地亚哥二: 5_bgp\n \n - 约束与限制:\n    - 必须是系统具体支持的类型。\n    - publicip_id为IPv4端口,所以\"type\"字段未给定时,默认为5_bgp。"
        },
        "publicipv6_address": {
          "type": "string",
          "format": "ipv6",
          "description": "- 功能说明:IPv4时无此字段,IPv6时为申请到的弹性公网IP地址"
        },
        "ip_version": {
          "type": "integer",
          "format": "int32",
          "enum": [
            4,
            6
          ],
          "description": "- IP版本信息\n- 取值范围:\n  - 4:IPv4\n  - 6:IPv6"
        }
      }
