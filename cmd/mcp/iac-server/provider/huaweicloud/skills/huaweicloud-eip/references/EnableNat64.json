  "definitions": {
    "ShowPublicIpResp": {
      "required": [
        "publicip",
        "request_id"
      ],
      "properties": {
        "publicip": {
          "description": "弹性公网IP对象",
          "$ref": "#/definitions/PublicipResp"
        },
        "request_id": {
          "type": "string",
          "description": "本次请求编号",
          "pattern": "[A-Za-z0-9]{8}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{12}",
          "example": "4a06c169-cc67-4d94-a786-2d70ef09b100"
        }
      }
    },
    "VnicResp": {
      "description": "弹性公网IP中的vnic对象,存储绑定PORT的相关信息",
      "properties": {
        "private_ip_address": {
          "type": "string",
          "description": "- 功能说明:PORT的内网地址",
          "maxLength": 36,
          "minLength": 0,
          "example": "192.168.8.6"
        },
        "device_id": {
          "type": "string",
          "description": "- 功能说明:PORT的device_id\n- 约束:存在PORT时,此字段associate_instance_id相同,都为实例ID",
          "maxLength": 36,
          "minLength": 0,
          "example": "20d99608-4595-4420-8499-c7549136eb38"
        },
        "device_owner": {
          "type": "string",
          "description": "- 功能说明:PORT的device_owner\n- 约束:存在PORT时,此字段和associate_instance_type都可区分实例类型",
          "maxLength": 36,
          "minLength": 0,
          "example": "PORT"
        },
        "vtep": {
          "type": "string",
          "description": "- 功能说明:VTEP IP",
          "maxLength": 36,
          "minLength": 0
        },
        "vni": {
          "type": "string",
          "description": "- 功能说明:VXLAN ID",
          "maxLength": 36,
          "minLength": 0
        },
        "vpc_id": {
          "type": "string",
          "description": "- 功能说明:PORT所在VPC的ID",
          "pattern": "[A-Za-z0-9]{8}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{12}",
          "maxLength": 36,
          "minLength": 36,
          "example": "f1469b4a-df0b-4a98-a538-bb7de91cf493"
        },
        "port_id": {
          "type": "string",
          "description": "- 功能说明:PORT的唯一标识",
          "pattern": "[A-Za-z0-9]{8}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{12}",
          "maxLength": 36,
          "minLength": 36,
          "example": "4e146838-6abc-4f34-a9cd-c25f8b73173b"
        },
        "port_profile": {
          "type": "string",
          "description": "- 功能说明:端口profile信息",
          "maxLength": 256,
          "minLength": 0
        },
        "mac": {
          "type": "string",
          "description": "- 功能说明:PORT的MAC信息",
          "maxLength": 36,
          "minLength": 0,
          "example": "00:01:6C:06:A6:29"
        },
        "instance_id": {
          "type": "string",
          "description": "- 功能说明:PORT的使用者,不同于device_id的归属者。举例:vip port的device_owner为vip,但是这个port实际使用者可能是虚机或其他",
          "maxLength": 36,
          "minLength": 0,
          "example": "cff40e5e-4473-4b1e-95f2-7366077bf097"
        },
        "instance_type": {
          "type": "string",
          "description": "- 功能说明:标记PORT使用者,与instance_id组合使用",
          "maxLength": 36,
          "minLength": 0,
          "example": "PORT"
        }
      }
    },
    "BandwidthResp": {
      "description": "弹性公网IP中的bandwidth对象,存储公网IP绑定的带宽信息",
      "properties": {
        "id": {
          "type": "string",
          "description": "- 功能说明:带宽ID",
          "pattern": "[A-Za-z0-9]{8}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{12}",
          "maxLength": 36,
          "minLength": 36,
          "example": "cff40e5e-4473-4b1e-95f2-7366077bf097"
        },
        "size": {
          "type": "integer",
          "description": "- 功能说明:带宽大小",
          "maximum": 2000,
          "minimum": 0,
          "example": 100
        },
        "share_type": {
          "type": "string",
          "description": "- 功能说明:类型\n \"WHOLE\"为共享带宽,\"PER\"为独占带宽",
          "maxLength": 36,
          "minLength": 0,
          "example": "PER"
        },
        "charge_mode": {
          "type": "string",
          "description": "- 功能说明:带宽计费模式",
          "maxLength": 36,
          "minLength": 0,
          "example": "bandwidth"
        },
        "name": {
          "type": "string",
          "description": "- 功能说明:带宽名称",
          "maxLength": 255,
          "minLength": 0,
          "example": "bandwidth-test"
        },
        "billing_info": {
          "type": "string",
          "description": "- 功能说明:带宽的订单信息",
          "maxLength": 1024,
          "minLength": 0,
          "example": "billing info"
        }
      }
    },
    "PublicipResp": {
      "description": "弹性公网IP对象返回模板",
      "properties": {
        "id": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP的唯一标识",
          "pattern": "[A-Za-z0-9]{8}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{12}",
          "maxLength": 36,
          "minLength": 36,
          "example": "f1469b4a-df0b-4a98-a538-bb7de91cf493"
        },
        "project_id": {
          "type": "string",
          "description": "- 功能说明:项目ID",
          "maxLength": 32,
          "minLength": 32,
          "pattern": "[A-Za-z0-9]{8}-[A-Za-z0-9]{32}",
          "example": "bead5977497440f893309e6a4ac11933"
        },
        "ip_version": {
          "type": "integer",
          "format": "int32",
          "description": "- 功能说明: 弹性公网IP版本号\n- 取值范围: 4、6\n  - 4表示公网IP地址为public_ip_address地址\n  - 6表示公网IP地址为public_ipv6_address地址",
          "enum": [
            4,
            6
          ],
          "maximum": 6,
          "minimum": 4
        },
        "public_ip_address": {
          "type": "string",
          "description": "- 功能说明: 弹性公网IPv4地址",
          "maxLength": 64,
          "minLength": 0,
          "example": "192.168.9.8"
        },
        "public_ipv6_address": {
          "type": "string",
          "description": "- 功能说明: 弹性公网IPv6地址",
          "maxLength": 64,
          "minLength": 0,
          "example": "00-01-6C-06-A6-29"
        },
        "status": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP的状态\n- 取值范围:FREEZED,DOWN,ACTIVE,ERROR。\n  - FREEZED表示弹性公网IP处于冻结状态\n  - DOWN表示弹性公网IP未绑定实例\n  - ACTIVE表示弹性公网IP绑定实例,正在使用中\n  - ERROR表示弹性公网IP状态异常",
          "enum": [
            "FREEZED",
            "DOWN",
            "ACTIVE",
            "ERROR"
          ],
          "maxLength": 16,
          "minLength": 0
        },
        "description": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP的描述信息\n- 约束:用户以自定义方式标识资源,系统不感知",
          "maxLength": 1024,
          "minLength": 0,
          "example": "publicip description"
        },
        "created_at": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP的创建时间\n- 约束:UTC时间格式(2018-12-25T10:07:24Z)",
          "maxLength": 64,
          "minLength": 0,
          "example": "2021-05-26T12:00:02Z"
        },
        "updated_at": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP最近的更新时间\n- 约束:UTC时间格式(2018-12-25T10:09:20Z)",
          "maxLength": 64,
          "minLength": 0,
          "example": "2021-05-26T12:01:50Z"
        },
        "type": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP的类型\n- 取值范围:EIP,DUALSTACK",
          "enum": [
            "EIP",
            "DUALSTACK"
          ],
          "maxLength": 36,
          "minLength": 0
        },
        "vnic": {
          "description": "- 功能说明:弹性公网IP绑定实例有PORT时,PORT的相关信息\n- 约束:若绑定的实例不依赖PORT,该对象为null",
          "$ref": "#/definitions/VnicResp"
        },
        "bandwidth": {
          "description": "- 功能说明:弹性公网IP绑定的带宽信息",
          "$ref": "#/definitions/BandwidthResp"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP的企业项目ID",
          "maxLength": 32,
          "minLength": 32,
          "example": "bead5977497440f893309e6a4ac11933"
        },
        "billing_info": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP的订单信息\n- 约束:包周期才会有订单信息,按需资源此字段为空",
          "maxLength": 1024,
          "minLength": 0,
          "example": "billinginfo"
        },
        "lock_status": {
          "type": "string",
          "description": "- 功能说明:记录弹性公网IP当前的冻结状态\n- 约束:metadata类型,标识欠费冻结、公安冻结",
          "maxLength": 36,
          "minLength": 0,
          "example": "lock-status-test"
        },
        "associate_instance_type": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP绑定的实例类型\n- 取值范围:PORT、NATGW、ELB、ELBV1、VPN",
          "enum": [
            "PORT",
            "NATGW",
            "ELB",
            "ELBV1",
            "VPN"
          ],
          "maxLength": 36,
          "minLength": 0
        },
        "associate_instance_id": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP绑定的实例ID",
          "maxLength": 36,
          "minLength": 0,
          "example": "20d99608-4595-4420-8499-c7549136eb38"
        },
        "publicip_pool_id": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP所属网络的ID。publicip_pool_name对应的网络ID",
          "pattern": "[A-Za-z0-9]{8}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{12}",
          "maxLength": 36,
          "minLength": 36,
          "example": "4e146838-6abc-4f34-a9cd-c25f8b73173b"
        },
        "publicip_pool_name": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP的网络类型,\n包括公共池类型,如5_bgp/5_sbgp...,和用户购买的专属池。专属池见publcip_pool相关接口",
          "maxLength": 128,
          "minLength": 0,
          "example": "5_telcom"
        },
        "alias": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP别名",
          "maxLength": 255,
          "minLength": 0,
          "example": "publicipname"
        },
        "public_border_group": {
          "type": "string",
          "description": "- 功能说明:中心还是边缘。中心CENTER,边缘为各边缘az名称",
          "maxLength": 64,
          "minLength": 0,
          "example": "center"
        }
      }
    }
  },
