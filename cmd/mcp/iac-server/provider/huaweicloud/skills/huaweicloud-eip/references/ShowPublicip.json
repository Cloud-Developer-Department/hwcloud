          "maxLength": 64,
          "minLength": 0
        },
        "vpc_id": {
          "type": "string",
          "description": "功能说明:虚拟私有云ID",
          "maxLength": 36,
          "minLength": 0
        },
        "port_id": {
          "type": "string",
          "description": "功能说明:端口ID",
          "maxLength": 36,
          "minLength": 0
        },
        "port_profile": {
          "type": "string",
          "description": "功能说明:端口profile信息",
          "maxLength": 256,
          "minLength": 0
        },
        "mac": {
          "type": "string",
          "description": "功能说明:端口MAC地址\n约束:由系统分配,不支持指定",
          "maxLength": 64,
          "minLength": 0
        },
        "vtep": {
          "type": "string",
          "description": "功能说明:VTEP IP",
          "maxLength": 36,
          "minLength": 0
        },
        "vni": {
          "type": "string",
          "description": "功能说明:VXLAN ID",
          "maxLength": 36,
          "minLength": 0
        },
        "instance_id": {
          "type": "string",
          "description": "功能说明:端口所属实例ID,例如RDS实例ID\n约束:不支持设置和更新,由系统自动维护",
          "maxLength": 36,
          "minLength": 0
        },
        "instance_type": {
          "type": "string",
          "description": "功能说明:端口所属实例类型,例如“RDS”\n约束:不支持设置和更新,由系统自动维护",
          "maxLength": 36,
          "minLength": 0
        }
      }
    },
