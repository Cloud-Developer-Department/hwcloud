          "maxLength": 36,
          "minLength": 0
        },
        "lock_status": {
          "description": "公网IP加锁状态, eg:\"POLICE,LOCKED\"。POLICE-公安冻结;LOCKED-普通冻结;普通冻结细分状态:ARREAR-欠费;DELABLE-可删除;",
          "type": "string",
          "maxLength": 36,
          "minLength": 0
