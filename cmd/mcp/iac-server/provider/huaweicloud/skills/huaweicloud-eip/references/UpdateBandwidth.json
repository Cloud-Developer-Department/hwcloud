  "definitions": {
    "UpdateBandwidthOption": {
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "取值范围:1-64,支持数字、字母、中文、_(下划线)、-(中划线),为空表示不修改名称\n 功能说明:带宽名称\n 约束:name、size必须有一个参数有值"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "取值范围:默认1Mbit/s~2000Mbit/s(具体范围以各区域配置为准,请参见控制台对应页面显示),不带此参数时表示不修改大小\n 功能说明:带宽大小,单位Mbit/s。\n 约束:name、size必须有一个参数有值\n 如果传入的参数为小数(如 10.2)或者字符类型(如“10”),会自动强制转换为整数。\n 约束:name、size必须要有一个参数有值。\n 调整带宽时的最小单位会根据带宽范围不同存在差异:\n 小于等于300Mbit/s:默认最小单位为1Mbit/s。\n 300Mbit/s~1000Mbit/s:默认最小单位为50Mbit/s。\n 大于1000Mbit/s:默认最小单位为500Mbit/s。"
        },
        "charge_mode": {
          "type": "string",
          "enum": [
            "bandwidth",
            "traffic",
            "95peak_plus"
          ],
          "description": "功能说明:按流量计费,按带宽计费还是按增强型95计费。\n 取值范围:bandwidth,traffic,95peak_plus(按增强型95计费)不返回或者为空时表示是bandwidth。\n 约束:只有共享带宽支持95peak_plus(按增强型95计费),按增强型95计费时需要指定保底百分比,默认是20%。"
        }
      },
      "description": "更新带宽对象(三个参数不能全为空)"
    },
    "PublicipInfoResp": {
      "description": "PublicipInfo对象",
      "properties": {
        "publicip_address": {
          "type": "string",
          "maxLength": 15,
          "description": "功能说明:弹性公网IP或者IPv6端口的地址"
        },
        "publicip_id": {
          "type": "string",
          "maxLength": 36,
          "description": "功能说明:带宽对应的弹性公网IP或者IPv6端口的唯一标识"
        },
        "publicip_type": {
          "type": "string",
          "maxLength": 36,
          "description": "功能说明:弹性公网IP或者IPv6端口的类型\n 取值范围:5_telcom(电信),5_union(联通),5_bgp(全动态BGP),5_sbgp(静态BGP),5_ipv6\n 东北-大连:5_telcom、5_union\n 华南-广州:5_bgp、5_sbgp\n 华东-上海二:5_bgp、5_sbgp\n 华北-北京一:5_bgp、5_sbgp、5_ipv6\n 亚太-香港:5_bgp\n 亚太-曼谷:5_bgp\n 亚太-新加坡:5_bgp\n 非洲-约翰内斯堡:5_bgp\n 西南-贵阳一:5_bgp、5_sbgp\n 华北-北京四:5_bgp、5_sbgp\n 约束:必须是系统具体支持的类型"
        },
        "publicipv6_address": {
          "type": "string",
          "maxLength": 39,
          "description": "功能说明:IPv4时无此字段,IPv6时为申请到的弹性公网IP地址"
        },
        "ip_version": {
          "type": "integer",
          "format": "int32",
          "enum": [
            4,
            6
          ],
          "description": "IP版本信息\n 取值范围:\n 4:IPv4\n 6:IPv6"
        }
      }
    },
    "BandWidthRules": {
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 36,
          "description": "带宽规则ID"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "description": "带宽规则名称"
        },
        "admin_state_up": {
          "type": "boolean",
          "description": "配置状态,为False时配置不生效。"
        },
        "egress_size": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "出网带宽最大值,单位M bps。取值范围[0,n],其中n为所属带宽的带宽大小(size字段)。0表示设置为最大带宽。"
        },
        "egress_guarented_size": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "出网保障带宽大小,单位M bps。取值范围[0,x],其中x为所属带宽剩余的保障额。"
        },
        "publicip_info": {
          "type": "array",
          "description": "功能说明:带宽对应的弹性公网IP信息\n 约束:WHOLE类型的带宽支持多个弹性公网IP,PER类型的带宽只能对应一个弹性公网IP",
          "items": {
            "$ref": "#/definitions/PublicipInfoResp"
          }
        }
      },
      "description": "带宽规则对象"
    },
    "BandwidthResp": {
      "description": "带宽对象",
      "properties": {
        "bandwidth_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "功能说明:带宽类型,共享带宽默认为share。\n 取值范围:share,bgp,telcom,sbgp等。\n share:共享带宽\n bgp:动态bgp\n telcom :联通\n sbgp:静态bgp"
        },
        "billing_info": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "功能说明:账单信息\n 如果billinginfo不为空,说明是包周期的带宽"
        },
        "charge_mode": {
          "type": "string",
          "enum": [
            "bandwidth",
            "traffic",
            "95peak_plus"
          ],
          "description": "功能说明:按流量计费,按带宽计费还是按增强型95计费。\n 取值范围:bandwidth,traffic,95peak_plus(按增强型95计费)不返回或者为空时表示是bandwidth。\n 约束:只有共享带宽支持95peak_plus(按增强型95计费),按增强型95计费时需要指定保底百分比,默认是20%。"
        },
        "id": {
          "type": "string",
          "maxLength": 36,
          "description": "功能说明:带宽唯一标识"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "功能说明:带宽名称\n 取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)"
        },
        "publicip_info": {
          "type": "array",
          "description": "功能说明:带宽对应的弹性公网IP信息\n 约束:WHOLE类型的带宽支持多个弹性公网IP,PER类型的带宽只能对应一个弹性公网IP",
          "items": {
            "$ref": "#/definitions/PublicipInfoResp"
          }
        },
        "share_type": {
          "type": "string",
          "enum": [
            "WHOLE",
            "PER"
          ],
          "description": "功能说明:带宽类型,标识是否是共享带宽\n 取值范围:WHOLE,PER\n WHOLE表示共享带宽;PER,表示独享带宽"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "功能说明:带宽大小\n 取值范围:默认5Mbit/s~2000Mbit/s(具体范围以各区域配置为准,请参见控制台对应页面显示)。"
        },
        "tenant_id": {
          "type": "string",
          "maxLength": 36,
          "description": "功能说明:用户所属租户ID"
        },
        "enterprise_project_id": {
          "type": "string",
          "maxLength": 36,
          "description": "企业项目ID。最大长度36字节,带“-”连字符的UUID格式,或者是字符串“0”。\n 创建带宽时,给带宽绑定企业项目ID。"
        },
        "status": {
          "type": "string",
          "enum": [
            "FREEZED",
            "NORMAL"
          ],
          "description": "功能说明:带宽的状态\n 取值范围:\n FREEZED:冻结\n NORMAL:正常"
        },
        "enable_bandwidth_rules": {
          "type": "boolean",
          "description": "功能说明:是否开启企业级qos,仅共享带宽支持开启。(该字段仅在上海1局点返回)"
        },
        "rule_quota": {
          "type": "integer",
          "maximum": 1024,
          "minimum": 0,
          "description": "功能说明:带宽支持的最大分组规则数。(该字段仅在上海1局点返回)"
        },
        "bandwidth_rules": {
          "type": "array",
          "description": "功能说明:带宽规则对象(该字段仅在上海1局点返回)",
          "items": {
            "$ref": "#/definitions/BandWidthRules"
          }
        },
        "created_at": {
          "type": "string",
          "description": "功能说明:资源创建时间,UTC时间\n 格式: yyyy-MM-ddTHH:mm:ss"
        },
        "updated_at": {
          "type": "string",
          "description": "功能说明:资源更新时间,UTC时间\n 格式: yyyy-MM-ddTHH:mm:ss"
        },
        "public_border_group": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "功能说明:表示中心站点资源或者边缘站点资源\n取值范围: center、边缘站点名称\n约束:共享带宽只能绑定与该字段相同的publicip"
        }
      }
    },
    "BandwidthResponseBody": {
      "required": [
        "bandwidth"
      ],
      "properties": {
        "bandwidth": {
          "description": "带宽对象",
          "$ref": "#/definitions/BandwidthResp"
        }
      },
      "description": "带宽对象详情"
    },
    "UpdateBandwidthRequestBody": {
      "description": "更新带宽对象的请求体(name,size必须有一个参数)",
      "required": [
        "bandwidth"
      ],
      "properties": {
        "bandwidth": {
          "description": "带宽对象",
          "$ref": "#/definitions/UpdateBandwidthOption"
        }
      }
    },
    "FailedRsp": {
      "properties": {
        "message": {
          "description": "服务异常错误信息描述",
          "type": "string",
          "maxLength": 256,
          "minLength": 0
        },
        "code": {
          "description": "服务异常错误信息编码",
          "type": "string",
          "maxLength": 36,
          "minLength": 0
        }
      },
      "description": "服务异常时返回的异常信息"
    }
  },
