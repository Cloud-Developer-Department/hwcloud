  "definitions": {
    "PublicipInstanceResp": {
      "description": "公网IP字段信息",
      "properties": {
        "id": {
          "type": "string",
          "description": "功能说明:弹性公网IP唯一标识",
          "maxLength": 36,
          "minLength": 0
        },
        "project_id": {
          "type": "string",
          "description": "功能说明:项目ID",
          "maxLength": 32,
          "minLength": 0
        },
        "ip_version": {
          "type": "integer",
          "format": "int32",
          "enum": [
            4,
            6
          ],
          "description": "功能说明:IP版本信息\n取值范围:4表示公网IP地址为public_ip_address地址;6表示公网IP地址为public_ipv6_address地址\""
        },
        "public_ip_address": {
          "type": "string",
          "format": "ipv4",
          "description": "功能说明:弹性公网IP或者IPv6端口的地址",
          "maxLength": 36,
          "minLength": 0
        },
        "public_ipv6_address": {
          "type": "string",
          "format": "ipv6",
          "description": "功能说明:IPv4时无此字段,IPv6时为申请到的弹性公网IP地址",
          "maxLength": 64,
          "minLength": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "FREEZED",
            "BIND_ERROR",
            "BINDING",
            "PENDING_DELETE",
            "PENDING_CREATE",
            "NOTIFYING",
            "NOTIFY_DELETE",
            "PENDING_UPDATE",
            "DOWN",
            "ACTIVE",
            "ELB",
            "ERROR",
            "VPN"
          ],
          "description": "功能说明:弹性公网IP的状态\n 取值范围:冻结FREEZED,绑定失败BIND_ERROR,绑定中BINDING,释放中PENDING_DELETE, 创建中PENDING_CREATE,创建中NOTIFYING,释放中NOTIFY_DELETE,更新中PENDING_UPDATE, 未绑定DOWN ,绑定ACTIVE,绑定ELB,绑定VPN,失败ERROR。"
        },
        "description": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1,
          "description": "功能说明:弹性公网IP描述信息\n约束:用户以自定义方式标识资源,系统不感知"
        },
        "public_border_group": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "功能说明:表示中心站点资源或者边缘站点资源\n取值范围: center、边缘站点名称\n约束:publicip只能绑定该字段相同的资源"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "功能说明:资源创建UTC时间\n格式:yyyy-MM-ddTHH:mm:ssZ"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "功能说明:资源更新UTC时间\n格式:yyyy-MM-ddTHH:mm:ssZ"
        },
        "type": {
          "type": "string",
          "maxLength": 36,
          "minLength": 1,
          "enum": [
            "EIP",
            "DUALSTACK",
            "DUALSTACK_SUBNET"
          ],
          "description": "功能说明:弹性公网IP类型"
        },
        "vnic": {
          "description": "功能说明:公网IP绑定实例有PORT时,PORT的相关信息\n约束:若绑定的实例不依赖PORT,该对象为null",
          "$ref": "#/definitions/VnicInfo"
        },
        "bandwidth": {
          "description": "功能说明:公网IP绑定带宽信息",
          "$ref": "#/definitions/PublicipBandwidthInfo"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "功能说明:企业项目ID。最大长度36字节,带“-”连字符的UUID格式,或者是字符串“0”。创建弹性公网IP时,给弹性公网IP绑定企业项目ID。",
          "maxLength": 36,
          "minLength": 0
        },
        "billing_info": {
          "type": "string",
          "description": "功能说明:公网IP的订单信息\n约束:包周期才会有订单信息,按需资源此字段为空",
          "maxLength": 256,
          "minLength": 0
        },
        "lock_status": {
          "type": "string",
          "description": "功能说明:记录公网IP当前的冻结状态\n约束:metadata类型,标识欠费冻结、公安冻结\n取值范围:police,locked",
          "maxLength": 64,
          "minLength": 0
        },
        "associate_instance_type": {
          "type": "string",
          "description": "功能说明:公网IP绑定的实例类型\n取值范围:PORT、NATGW、ELB、ELBV1、VPN、null",
          "enum": [
            "PORT",
            "NATGW",
            "ELB",
            "ELBV1",
            "VPN"
          ],
          "maxLength": 64,
          "minLength": 0
        },
        "associate_instance_id": {
          "type": "string",
          "description": "功能说明:公网IP绑定的实例ID",
          "maxLength": 64,
          "minLength": 0
        },
        "publicip_pool_id": {
          "type": "string",
          "description": "功能说明:公网IP所属网络的ID。publicip_pool_name对应的网络ID",
          "maxLength": 36,
          "minLength": 0
        },
        "publicip_pool_name": {
          "type": "string",
          "description": "功能说明:弹性公网IP的网络类型, 包括公共池类型,如5_bgp/5_sbgp...,和用户购买的专属池。\n专属池见publcip_pool相关接口",
          "maxLength": 64,
          "minLength": 0
        },
        "alias": {
          "type": "string",
          "description": "功能说明:弹性公网IP名称",
          "maxLength": 64,
          "minLength": 0
        }
      }
    },
    "AssociatePublicipsOption": {
      "required": [
        "associate_instance_type",
        "associate_instance_id"
      ],
      "properties": {
        "associate_instance_type": {
          "type": "string",
          "description": "功能说明:端口所属实例类型\n取值范围:PORT、NATGW、VPN、ELB\n约束:associate_instance_type和associate_instance_id都不为空时表示绑定实例\n约束:associate_instance_type字段不允许为空\n约束:双栈公网IP不允许修改绑定的实例",
          "enum": [
            "PORT",
            "NATGW",
            "VPN",
            "ELB"
          ],
          "maxLength": 36,
          "minLength": 0
        },
        "associate_instance_id": {
          "type": "string",
          "description": "功能说明:端口所属实例ID,例如RDS实例ID\n约束:associate_instance_type和associate_instance_id都不为空时表示绑定实例;\n约束:associate_instance_id不允许为空\n约束:双栈公网IP不允许修改绑定的实例",
          "maxLength": 36,
          "minLength": 0
        }
      }
    },
    "PublicipBandwidthInfo": {
      "description": "公网IP绑定的带宽信息",
      "properties": {
        "id": {
          "type": "string",
          "description": "带宽ID",
          "maxLength": 36,
          "minLength": 0
        },
        "size": {
          "type": "integer",
          "description": "功能描述:带宽大小\n取值范围:默认5Mbit/s~2000Mbit/s",
          "maximum": 99999,
          "minimum": 0
        },
        "share_type": {
          "type": "string",
          "description": "功能说明:带宽类型,标识是否是共享带宽\n取值范围:PER,WHOLE。\n  PER:独享带宽\n  WHOLE:共享带宽\n约束:其中IPv6暂不支持WHOLE类型带宽。",
          "maxLength": 36,
          "minLength": 0
        },
        "charge_mode": {
          "type": "string",
          "description": "功能说明:按流量计费还是按带宽计费\n取值范围:\nbandwidth:按带宽计费\ntraffic:按流量计费\n95peak_plus:按增强型95计费",
          "maxLength": 36,
          "minLength": 0
        },
        "name": {
          "type": "string",
          "description": "功能说明:带宽名称\n取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)",
          "maxLength": 64,
          "minLength": 0
        },
        "billing_info": {
          "type": "string",
          "description": "功能说明:账单信息。如果billinginfo不为空,说明是包周期的带宽",
          "maxLength": 256,
          "minLength": 0
        }
      }
    },
    "VnicInfo": {
      "description": "公网IP中的vnic对象,存储绑定PORT的相关信息",
      "properties": {
        "private_ip_address": {
          "type": "string",
          "description": "功能说明:私网IP地址",
          "maxLength": 36,
          "minLength": 0
        },
        "device_id": {
          "type": "string",
          "description": "功能说明:端口所属设备ID\n约束:不支持设置和更新,由系统自动维护",
          "maxLength": 36,
          "minLength": 0
        },
        "device_owner": {
          "type": "string",
          "description": "功能说明:设备所属\n取值范围:合法设备所属,如network:dhcp、network:VIP_PORT、network:router_interface_distributed、network:router_centralized_snat\n约束:不支持设置和更新,由系统自动维护",
          "maxLength": 64,
          "minLength": 0
        },
        "vpc_id": {
          "type": "string",
          "description": "功能说明:虚拟私有云ID",
          "maxLength": 36,
          "minLength": 0
        },
        "port_id": {
          "type": "string",
          "description": "功能说明:端口ID",
          "maxLength": 36,
          "minLength": 0
        },
        "port_profile": {
          "type": "string",
          "description": "功能说明:端口profile信息",
          "maxLength": 256,
          "minLength": 0
        },
        "mac": {
          "type": "string",
          "description": "功能说明:端口MAC地址\n约束:由系统分配,不支持指定",
          "maxLength": 64,
          "minLength": 0
        },
        "vtep": {
          "type": "string",
          "description": "功能说明:VTEP IP",
          "maxLength": 36,
          "minLength": 0
        },
        "vni": {
          "type": "string",
          "description": "功能说明:VXLAN ID",
          "maxLength": 36,
          "minLength": 0
        },
        "instance_id": {
          "type": "string",
          "description": "功能说明:端口所属实例ID,例如RDS实例ID\n约束:不支持设置和更新,由系统自动维护",
          "maxLength": 36,
          "minLength": 0
        },
        "instance_type": {
          "type": "string",
          "description": "功能说明:端口所属实例类型,例如“RDS”\n约束:不支持设置和更新,由系统自动维护",
          "maxLength": 36,
          "minLength": 0
        }
      }
    },
    "AssociatePublicipResponseBody": {
      "required": [
        "publicip"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "本次请求的编号",
          "maxLength": 36,
          "minLength": 0
        },
        "publicip": {
          "description": "绑定弹性公网IP的返回对象",
          "$ref": "#/definitions/PublicipInstanceResp"
        }
      }
    },
    "AssociatePublicipsRequestBody": {
      "required": [
        "publicip"
      ],
      "description": "绑定弹性公网IP的请求体",
      "example": {
        "publicip": {
          "associate_instance_id": "921b9dc7-8151-41e1-b83c-d50fe959592a",
          "associate_instance_type": "PORT"
        }
      },
      "properties": {
        "publicip": {
          "description": "弹性公网IP对象",
          "$ref": "#/definitions/AssociatePublicipsOption"
        }
      }
    },
    "FailedRsp": {
      "properties": {
        "request_id": {
          "description": "本次请求的编号",
          "type": "string",
          "maxLength": 36,
          "minLength": 0
        },
        "error_msg": {
          "description": "服务异常错误信息描述",
          "type": "string",
          "maxLength": 1024,
          "minLength": 0
        },
        "error_code": {
          "description": "服务异常错误信息编码",
          "type": "string",
          "maxLength": 64,
          "minLength": 0
        }
      },
      "description": "服务异常时返回的异常信息"
    }
  },
