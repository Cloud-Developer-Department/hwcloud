  "definitions": {
    "BatchCreateSharedBandwidthResponseBody": {
      "required": [
        "bandwidths"
      ],
      "properties": {
        "bandwidths": {
          "type": "array",
          "description": "批创的带宽对象的列表",
          "items": {
            "description": "带宽对象",
            "$ref": "#/definitions/BatchBandwidthResp"
          }
        }
      },
      "description": "批量创建响应体"
    },
    "BatchCreateBandwidthOption": {
      "required": [
        "count",
        "name",
        "size"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "description": "取值范围:正整数\n 功能说明:批创的共享带宽的个数\n 说明: 如果传入的参数为小数(如 2.2)或者字符类型(如“2”),会自动强制转换为整数。"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "取值范围:1-64,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)\n 功能说明:带宽名称"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "功能说明:带宽大小。共享带宽的大小有最小值限制,默认为2M,可能因局点不同而不同。\n 取值范围:默认5Mbit/s~2000Mbit/s(具体范围以各区域配置为准,请参见控制台对应页面显示)。\n 注意:调整带宽时的最小单位会根据带宽范围不同存在差异。\n 小于等于300Mbit/s:默认最小单位为1Mbit/s。\n 300Mbit/s~1000Mbit/s:默认最小单位为50Mbit/s。\n 大于1000Mbit/s:默认最小单位为500Mbit/s。"
        },
        "public_border_group": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "功能说明:表示中心站点资源或者边缘站点资源\n取值范围: center、边缘站点名称\n约束:共享带宽只能插入与该字段相同的publicip"
        }
      },
      "description": "带宽对象"
    },
    "BatchBandwidthResp": {
      "description": "带宽对象",
      "properties": {
        "bandwidth_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "功能说明:带宽类型,共享带宽默认为share。\n 取值范围:share,bgp,telcom,sbgp等。\n share:共享带宽\n bgp:动态bgp\n telcom :联通\n sbgp:静态bgp"
        },
        "billing_info": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "功能说明:账单信息\n 如果billing_info不为空,说明是包周期的带宽"
        },
        "charge_mode": {
          "type": "string",
          "enum": [
            "bandwidth",
            "traffic",
            "95peak_plus"
          ],
          "description": "功能说明:按流量计费,按带宽计费还是按增强型95计费。\n 取值范围:bandwidth,traffic,95peak_plus(按增强型95计费)不返回或者为空时表示是bandwidth。\n 约束:只有共享带宽支持95peak_plus(按增强型95计费),按增强型95计费时需要指定保底百分比,默认是20%。"
        },
        "id": {
          "type": "string",
          "maxLength": 36,
          "description": "功能说明:带宽唯一标识"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "功能说明:带宽名称\n 取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)"
        },
        "publicip_info": {
          "type": "array",
          "description": "功能说明:带宽对应的弹性公网IP信息\n 约束:WHOLE类型的带宽支持多个弹性公网IP,PER类型的带宽只能对应一个弹性公网IP",
          "items": {
            "$ref": "#/definitions/PublicipInfoResp"
          }
        },
        "share_type": {
          "type": "string",
          "enum": [
            "WHOLE",
            "PER"
          ],
          "description": "功能说明:带宽类型,标识是否是共享带宽\n 取值范围:WHOLE,PER\n WHOLE表示共享带宽;PER,表示独享带宽"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "功能说明:带宽大小\n 取值范围:默认5Mbit/s~2000Mbit/s(具体范围以各区域配置为准,请参见控制台对应页面显示)。"
        },
        "tenant_id": {
          "type": "string",
          "maxLength": 36,
          "description": "功能说明:用户所属租户ID"
        },
        "status": {
          "type": "string",
          "enum": [
            "FREEZED",
            "NORMAL"
          ],
          "description": "功能说明:带宽的状态\n 取值范围:\n FREEZED:冻结\n NORMAL:正常"
        },
        "public_border_group": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "功能说明:表示中心站点资源或者边缘站点资源\n取值范围: center、边缘站点名称\n约束:共享带宽只能插入与该字段相同的publicip"
        }
      }
    },
    "PublicipInfoResp": {
      "description": "PublicipInfo对象",
      "properties": {
        "publicip_address": {
          "type": "string",
          "maxLength": 15,
          "description": "功能说明:弹性公网IP或者IPv6端口的地址"
        },
        "publicip_id": {
          "type": "string",
          "maxLength": 36,
          "description": "功能说明:带宽对应的弹性公网IP或者IPv6端口的唯一标识"
        },
        "publicip_type": {
          "type": "string",
          "maxLength": 36,
          "description": "功能说明:弹性公网IP或者IPv6端口的类型\n 取值范围:5_telcom(电信),5_union(联通),5_bgp(全动态BGP),5_sbgp(静态BGP),5_ipv6\n 东北-大连:5_telcom、5_union\n 华南-广州:5_bgp、5_sbgp\n 华东-上海二:5_bgp、5_sbgp\n 华北-北京一:5_bgp、5_sbgp、5_ipv6\n 亚太-香港:5_bgp\n 亚太-曼谷:5_bgp\n 亚太-新加坡:5_bgp\n 非洲-约翰内斯堡:5_bgp\n 西南-贵阳一:5_bgp、5_sbgp\n 华北-北京四:5_bgp、5_sbgp\n 约束:必须是系统具体支持的类型"
        },
        "publicipv6_address": {
          "type": "string",
          "maxLength": 39,
          "description": "功能说明:IPv4时无此字段,IPv6时为申请到的弹性公网IP地址"
        },
        "ip_version": {
          "type": "integer",
          "format": "int32",
          "enum": [
            4,
            6
          ],
          "description": "IP版本信息\n 取值范围:\n 4:IPv4\n 6:IPv6"
        }
      }
    },
    "BatchCreateBandwidthRequestBody": {
      "description": "批量创建带宽的请求体",
      "required": [
        "bandwidth"
      ],
      "properties": {
        "bandwidth": {
          "description": "带宽对象",
          "$ref": "#/definitions/BatchCreateBandwidthOption"
        }
      }
    },
    "FailedRsp": {
      "properties": {
        "message": {
          "description": "服务异常错误信息描述",
          "type": "string",
          "maxLength": 256,
          "minLength": 0
        },
        "code": {
          "description": "服务异常错误信息编码",
          "type": "string",
          "maxLength": 36,
          "minLength": 0
        }
      },
      "description": "服务异常时返回的异常信息"
    }
  },
