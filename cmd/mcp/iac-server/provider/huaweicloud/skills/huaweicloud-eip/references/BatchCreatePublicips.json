    "BatchBandwidth": {
      "required": [
        "size"
      ],
      "properties": {
        "charge_mode": {
          "type": "string",
          "example": "bandwidth",
          "description": "- 功能说明:按流量计费还是按带宽计费。其中IPv6国外默认是bandwidth,国内默认是traffic。取值为traffic,表示流量计费。",
          "enum": [
            "bandwidth",
            "traffic"
          ]
        },
        "name": {
          "type": "string",
          "description": "- 功能说明:带宽名称\n- 取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)\n- 约束:如果share_type是PER,该参数必须带,如果share_type是WHOLE并且id有值,该参数会忽略。",
          "minLength": 1,
          "maxLength": 64
        },
        "share_type": {
          "type": "string",
          "example": "PER",
          "description": "- 功能说明:带宽类型\n- 取值范围:PER,WHOLE。其中IPv6暂不支持WHOLE类型带宽。",
          "enum": [
            "PER",
            "WHOLE"
          ]
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "example": 5,
          "description": "- 功能说明:带宽大小\n- 取值范围:默认1Mbit/s~2000Mbit/s(具体范围以各区域配置为准,请参见控制台对应页面显示)。\n- 约束:share_type是PER,该参数必须带,如果share_type是WHOLE并且id有值,该参数会忽略。\n- 注意:调整带宽时的最小单位会根据带宽范围不同存在差异。\n  - 小于等于300Mbit/s:默认最小单位为1Mbit/s。\n  - 300Mbit/s~1000Mbit/s:默认最小单位为50Mbit/s。\n  - 大于1000Mbit/s:默认最小单位为500Mbit/s。"
        },
        "id": {
          "type": "string",
          "description": "- 功能说明:带宽ID,创建WHOLE类型带宽的弹性公网IP时可以指定之前的共享带宽创建\n- 取值范围:WHOLE类型的带宽ID"
        }
      },
      "description": "带宽信息"
    },
