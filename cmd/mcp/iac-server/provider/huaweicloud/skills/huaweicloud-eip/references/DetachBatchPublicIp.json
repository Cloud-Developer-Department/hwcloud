          "minLength": 0,
          "example": "cff40e5e-4473-4b1e-95f2-7366077bf097"
        },
        "instance_type": {
          "type": "string",
          "description": "- 功能说明:标记PORT使用者,与instance_id组合使用",
          "maxLength": 36,
          "minLength": 0,
          "example": "PORT"
        }
      }
