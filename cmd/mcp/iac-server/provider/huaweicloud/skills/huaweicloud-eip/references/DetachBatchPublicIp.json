        "mac": {
          "type": "string",
          "description": "- 功能说明:PORT的MAC信息",
          "maxLength": 36,
          "minLength": 0,
          "example": "00:01:6C:06:A6:29"
        },
        "instance_id": {
          "type": "string",
          "description": "- 功能说明:PORT的使用者,不同于device_id的归属者。举例:vip port的device_owner为vip,但是这个port实际使用者可能是虚机或其他",
