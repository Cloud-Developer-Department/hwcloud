    "PublicipResp": {
      "description": "弹性公网IP对象返回模板",
      "properties": {
        "id": {
          "type": "string",
          "description": "- 功能说明:弹性公网IP的唯一标识",
          "pattern": "[A-Za-z0-9]{8}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{12}",
          "maxLength": 36,
          "minLength": 36,
