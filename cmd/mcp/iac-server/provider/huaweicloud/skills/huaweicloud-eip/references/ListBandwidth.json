            "type": "string",
            "x-order": 10
          },
          {
            "name": "billing_info",
            "in": "query",
            "description": "- 功能说明:根据计费信息过滤",
            "required": false,
            "type": "string",
            "x-order": 11
          },
          {
            "name": "tags",
            "in": "query",
            "description": "- 功能说明:根据标签过滤",
