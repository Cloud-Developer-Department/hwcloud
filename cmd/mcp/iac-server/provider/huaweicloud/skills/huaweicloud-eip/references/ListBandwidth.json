  "definitions": {
    "PublicipInfoResponseBody": {
      "type": "object",
      "properties": {
        "publicip_address": {
          "type": "string",
          "description": "- 功能说明:弹性公网IPV4或IPv6的公网地址",
          "format": "ipv4"
        },
        "publicip_id": {
          "maxLength": 36,
          "minLength": 1,
          "type": "string",
          "description": "- 功能说明:带宽对应的弹性公网IPV4或IPv6的唯一标识",
          "format": "uuid"
        },
        "publicip_type": {
          "type": "string",
          "maxLength": 36,
          "description": "- 功能说明:EIP的类型\n\n- \n\n- \n\n- \n\n- \n- 取值范围:5_bgp(全动态BGP),5_sbgp(静态BGP),5_youxuanbgp(优选BGP)\n   - 华南-广州:5_bgp、5_sbgp\n   - 华东-上海一:5_bgp、5_sbgp\n   - 华东-上海二:5_bgp、5_sbgp\n   - 华北-北京一:5_bgp、5_sbgp\n   - 中国-香港:5_bgp、5_youxuanbgp\n   - 亚太-曼谷:5_bgp\n   - 亚太-新加坡:5_bgp\n   - 非洲-约翰内斯堡:5_bgp\n   - 西南-贵阳一:5_sbgp\n   - 华北-北京四:5_bgp、5_sbgp\n   - 拉美-圣地亚哥:5_bgp\n   - 拉美-圣保罗一:5_bgp\n   - 拉美-墨西哥城一:5_bgp\n   - 拉美-布宜诺斯艾利一:5_bgp\n   - 拉美-利马一:5_bgp\n   - 拉美-圣地亚哥二: 5_bgp\n \n - 约束:\n    - 必须是系统具体支持的类型。\n    - publicip_id为IPv4端口,所以\"type\"字段未给定时,默认为5_bgp。"
        },
        "publicipv6_address": {
          "type": "string",
          "description": "- 功能说明:IPv4时无此字段,IPv6时为申请到的弹性公网IP地址",
          "format": "ipv6"
        },
        "ip_version": {
          "type": "integer",
          "description": "- 功能说明:IP版本信息\n- 取值范围:\n 4:IPv4;\n 6:IPv6",
          "format": "int32",
          "enum": [
            4,
            6
          ]
        }
      },
      "description": "PublicipInfo对象"
    },
    "BandWidthRules": {
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 36,
          "description": "- 功能说明:带宽规则ID"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "description": "- 功能说明:带宽规则名称"
        },
        "admin_state_up": {
          "type": "boolean",
          "description": "- 功能说明:配置状态,为False时配置不生效。"
        },
        "egress_size": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "- 功能说明:出网带宽最大值,单位Mbps\n- 取值范围[0,n],其中n为所属带宽的带宽大小(size字段)。0表示设置为最大带宽"
        },
        "egress_guarented_size": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "- 功能说明:出网保障带宽大小,单位Mbps\n- 取值范围[0,x],其中x为所属带宽剩余的保障额"
        },
        "publicip_info": {
          "type": "array",
          "description": "- 功能说明:带宽对应的弹性公网IP信息\n- 约束:WHOLE类型的带宽支持多个弹性公网IP,PER类型的带宽只能对应一个弹性公网IP",
          "items": {
            "$ref": "#/definitions/PublicipInfoResponseBody"
          }
        }
      },
      "description": "带宽规则对象"
    },
    "BandwidthResponseBody": {
      "type": "object",
      "properties": {
        "admin_state": {
          "type": "string",
          "description": "- 功能说明:带宽状态\n- 取值范围:normal,freezed",
          "example": "NORMAL"
        },
        "ingress_size": {
          "type": "integer",
          "description": "- 功能说明:入网大小,单位Mbit/s",
          "example": 100
        },
        "rule_quota": {
          "type": "integer",
          "description": "- 功能说明:规则数值,最低阈值可调节",
          "example": 5
        },
        "ratio_95peak_plus": {
          "type": "integer",
          "description": "- 功能说明:增强型95带宽保底率,最低保底率为20",
          "example": 20
        },
        "enable_bandwidth_rules": {
          "type": "boolean",
          "description": "- 功能说明:带宽分组使能,表明开启带宽分组限速功能。",
          "example": false
        },
        "bandwidth_rules": {
          "type": "array",
          "description": "- 功能说明:带宽规则对象(该字段仅在上海1局点返回)",
          "items": {
            "$ref": "#/definitions/BandWidthRules"
          },
          "example": [],
          "x-open-region-cloud": "hc,hk"
        },
        "public_border_group": {
          "type": "string",
          "description": "- 功能说明:带宽AZ属性,表征中心和边缘。中心带宽默认为center",
          "example": "CENTER"
        },
        "bandwidth_type": {
          "maxLength": 36,
          "minLength": 1,
          "type": "string",
          "description": "- 功能说明:带宽类型,共享带宽默认为share。\n- 取值范围:share,bgp,telcom,sbgp等。\n share:共享带宽;\n bgp:动态bgp;\n telcom :联通;\n sbgp:静态bgp。"
        },
        "billinginfo": {
          "maxLength": 255,
          "minLength": 0,
          "type": "string",
          "description": "- 功能说明:账单信息,"
        },
        "id": {
          "maxLength": 36,
          "minLength": 1,
          "type": "string",
          "description": "- 功能说明:带宽唯一标识",
          "format": "uuid"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
          "description": "- 功能说明:带宽名称\n- 取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)"
        },
        "publicip_info": {
          "type": "array",
          "description": "- 功能说明:带宽对应的弹性公网IP信息\n- 约束:WHOLE类型的带宽支持多个弹性公网IP,PER类型的带宽只能对应一个弹性公网IP",
          "items": {
            "$ref": "#/definitions/PublicipInfoResponseBody"
          }
        },
        "type": {
          "type": "string",
          "description": "- 功能说明:带宽类型,标识是否是共享带宽\n- 取值范围:WHOLE,PER。\n WHOLE表示共享带宽;PER表示独享带宽",
          "enum": [
            "WHOLE",
            "PER"
          ]
        },
        "size": {
          "maximum": 2000,
          "minimum": 5,
          "type": "integer",
          "description": "- 功能说明:带宽大小\n- 取值范围:默认5Mbit/s~2000Mbit/s(具体范围以各区域配置为准,请参见控制台对应页面显示)。",
          "format": "int32"
        },
        "project_id": {
          "type": "string",
          "description": "- 功能说明:用户所属项目ID",
          "format": "uuid"
        },
        "tags": {
          "type": "array",
          "description": "- 功能说明:\"公网EIP标签\"",
          "items": {
            "type": "string"
          },
          "example": []
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "- 功能说明:资源创建时间,采用UTC时间,格式:YYYY-MM-DDTHH:MM:SS"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "- 功能说明:资源更新时间,采用UTC时间,格式:YYYY-MM-DDTHH:MM:SS"
        }
      },
      "description": "带宽对象"
    },
    "PageInfoOption": {
      "description": "分页页码信息",
      "properties": {
        "previous_marker": {
          "type": "string",
          "description": "翻页时,作为前一页的marker取值",
          "maxLength": 36,
