          "type": "number",
          "format": "double",
          "description": "迁移速率,单位:Mbit/s",
          "maximum": 10000,
          "minimum": 0
        },
        "compress_rate": {
          "type": "number",
          "format": "double",
          "description": "压缩率",
          "maximum": 10000,
          "minimum": 0
        },
        "error_json": {
          "type": "string",
          "description": "错误信息",
          "maxLength": 1024,
          "minLength": 0
