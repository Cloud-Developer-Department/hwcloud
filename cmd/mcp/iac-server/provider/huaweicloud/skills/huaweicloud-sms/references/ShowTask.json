  "definitions": {
    "TaskResponseBody": {
      "required": [
        "target_server"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "任务名称(用户自定义)",
          "maxLength": 255,
          "minLength": 0
        },
        "type": {
          "type": "string",
          "description": "任务类型,创建时必选,更新时可选\nMIGRATE_FILE:文件级迁移\nMIGRATE_BLOCK:块级迁移",
          "enum": [
            "MIGRATE_FILE",
            "MIGRATE_BLOCK"
          ],
          "maxLength": 255,
          "minLength": 0
        },
        "os_type": {
          "type": "string",
          "description": "操作系统类型,分为WINDOWS和LINUX,创建时必选,更新时可选",
          "enum": [
            "WINDOWS",
            "LINUX"
          ]
        },
        "id": {
          "type": "string",
          "description": "迁移任务ID",
          "maxLength": 255,
          "minLength": 0
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "description": "进程优先级\n\n0:低\n\n1:标准(默认)\n\n2:高",
          "enum": [
            0,
            1,
            2
          ],
          "maximum": 2,
          "minimum": 0
        },
        "speed_limit": {
          "type": "integer",
          "description": "迁移限速",
          "format": "int32",
          "minimum": 0,
          "maximum": 65535
        },
        "region_id": {
          "type": "string",
          "description": "目的端服务器的区域ID",
          "maxLength": 255,
          "minLength": 0
        },
        "start_target_server": {
          "type": "boolean",
          "description": "迁移完成后是否启动目的端服务器\n\ntrue:启动\n\nfalse:停止",
          "default": true
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID",
          "maxLength": 255,
          "minLength": 1
        },
        "migration_ip": {
          "type": "string",
          "description": "目的端服务器的IP地址。\n\n公网迁移时请填写弹性IP地址\n\n专线迁移时请填写私有IP地址",
          "maxLength": 255,
          "minLength": 0
        },
        "region_name": {
          "type": "string",
          "description": "目的端服务器的区域名称",
          "maxLength": 255,
          "minLength": 0
        },
        "project_name": {
          "type": "string",
          "description": "目的端服务器所在项目名称",
          "maxLength": 255,
          "minLength": 0
        },
        "project_id": {
          "type": "string",
          "description": "目的端服务器所在项目ID",
          "maxLength": 255,
          "minLength": 0
        },
        "vm_template_id": {
          "type": "string",
          "description": "模板ID",
          "maxLength": 255,
          "minLength": 0
        },
        "source_server": {
          "$ref": "#/definitions/SourceServerResponse"
        },
        "target_server": {
          "$ref": "#/definitions/TaskTargetServer"
        },
        "state": {
          "type": "string",
          "description": "迁移任务状态\nREADY: 准备就绪\nRUNNING: 迁移中\nSYNCING: 同步中\nMIGRATE_SUCCESS: 迁移成功\nSYNC_SUCCESS: 同步成功\nMIGRATE_FAIL: 失败\nSYNC_FAIL: 同步失败\nABORTING: 中止中\nABORT: 中止\nSKIPPING: 跳过中\nDELETING: 删除中\nRESETING: 回滚中",
          "enum": [
            "READY",
            "RUNNING",
            "SYNCING",
            "MIGRATE_SUCCESS",
            "SYNC_SUCCESS",
            "MIGRATE_FAIL",
            "SYNC_FAIL",
            "ABORTING",
            "ABORT",
            "SKIPPING",
            "DELETING",
            "RESETING"
          ]
        },
        "estimate_complete_time": {
          "type": "integer",
          "format": "int64",
          "description": "预估完成时间",
          "maximum": 9223372036854775807,
          "minimum": 0
        },
        "connected": {
          "type": "boolean",
          "description": "连接状态"
        },
        "create_date": {
          "type": "integer",
          "format": "int64",
