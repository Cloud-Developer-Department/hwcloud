        "agent_cpu_usage": {
          "type": "number",
          "format": "double",
          "description": "Agent的CPU使用率,单位是百分比",
          "minimum": 0,
          "maximum": 100,
          "example": 10.0
        },
        "total_mem_usage": {
          "type": "number",
          "format": "double",
          "description": "主机的内存使用值,单位是MB",
          "minimum": 0,
          "maximum": 1048576.0,
          "example": 500.0
        },
        "agent_mem_usage": {
          "type": "number",
          "format": "double",
          "description": "Agent的内存使用值,单位是MB",
          "minimum": 0,
          "maximum": 1048576.0,
          "example": 100.0
        },
        "total_disk_io": {
          "type": "number",
          "format": "double",
          "description": "主机的磁盘I/O值,单位是Mbit/s",
          "minimum": 0,
          "maximum": 10000.0,
          "example": 1000.0
        },
        "agent_disk_io": {
          "type": "number",
          "format": "double",
          "description": "Agent的磁盘I/O值,单位是Mbit/s",
          "minimum": 0,
          "maximum": 10000.0,
          "example": 100.0
        },
