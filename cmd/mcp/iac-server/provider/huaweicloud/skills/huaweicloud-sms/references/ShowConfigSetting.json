    "ConfigSettingResponseBody": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务ID",
          "minLength": 0,
          "maxLength": 100
        },
        "migrate_type": {
          "type": "string",
          "description": "迁移类型\nWINDOWS_MIGRATE_BLOCK: windows块级迁移\nLINUX_MIGRATE_FILE: linux文件级迁移\nLINUX_MIGRATE_BLOCK: linux块级迁移",
          "enum": [
            "WINDOWS_MIGRATE_BLOCK",
            "LINUX_MIGRATE_FILE",
            "LINUX_MIGRATE_BLOCK"
          ]
        },
        "configurations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ConfigBody"
          },
          "description": "配置项的具体配置信息",
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "task_id",
        "migrate_type"
      ],
      "description": "查询配置资源成功"
    },
    "ErrorMsg": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "maxLength": 255,
          "minLength": 0
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息",
          "maxLength": 1024,
          "minLength": 0
        }
      },
      "description": "错误信息"
    },
    "ConfigBody": {
      "type": "object",
      "description": "配置参数body",
      "required": [
        "config_key",
        "config_value"
      ],
      "properties": {
        "config_key": {
          "type": "string",
          "description": "配置类型\nMIGRATE_EXCLUDE_DIR: 迁移时设定的不迁移目录\nSYNC_EXCLUDE_DIR: 同步时设定的不同步目录\nONLY_SYNC_DIR: 同步时设定的同步目录\nCONSISTENCY_DIR: 一致性校验的目录\nCONSISTENCY_DIR_ILLEGAL: 一致性校验后非法目录\nLINUX_BLOCK_COMPRESS_THREAD_NUM: linux块迁移压缩线程个数\nMIGRATE_DST_IP: 迁移目的ip\nLINUX_BLOCK_CACHE_SIZE: linux块迁移缓存大小\nLINUX_CPU_LIMIT: linux的cpu限制\nLINUX_MEM_LIMIT: linux的内存限制\nLINUX_IO_LIMIT: linux的IO限制\nNUM_PROCESS_MIGRATE: 迁移进程数\nNUM_PROCESS_SYNC: 同步进程数\nCONSISTENCY_RECHECK: 一致性校验再检\nCONSISTENCY_MODE: 一致性校验模式\nDYNAMIC_PORT: 动态端口",
          "enum": [
            "MIGRATE_EXCLUDE_DIR",
            "SYNC_EXCLUDE_DIR",
            "ONLY_SYNC_DIR",
            "CONSISTENCY_DIR",
            "CONSISTENCY_DIR_ILLEGAL",
            "LINUX_BLOCK_COMPRESS_THREAD_NUM",
            "MIGRATE_DST_IP",
            "LINUX_BLOCK_CACHE_SIZE",
            "LINUX_CPU_LIMIT",
            "LINUX_MEM_LIMIT",
            "LINUX_IO_LIMIT",
            "NUM_PROCESS_MIGRATE",
            "NUM_PROCESS_SYNC",
            "CONSISTENCY_RECHECK",
            "CONSISTENCY_MODE",
            "DYNAMIC_PORT"
          ]
        },
        "config_value": {
          "type": "string",
          "description": "具体配置参数字段,保存于数据库,最终在agent端进行解析",
          "minLength": 0,
          "maxLength": 1024
        },
        "config_status": {
          "type": "string",
          "description": "描述配置状态的保留字段",
          "minLength": 0,
          "maxLength": 255
        }
      }
    }
  },
