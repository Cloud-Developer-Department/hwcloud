  "definitions": {
    "PostMigProjectBody": {
      "required": [
        "name",
        "region",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "迁移项目名称",
          "maxLength": 100,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "迁移项目描述",
          "maxLength": 255,
          "minLength": 0
        },
        "isdefault": {
          "type": "boolean",
          "description": "是否为默认模板",
          "default": false
        },
        "region": {
          "type": "string",
          "description": "区域名称",
          "maxLength": 100,
          "minLength": 0
        },
        "start_target_server": {
          "type": "boolean",
          "description": "迁移后是否启动目的端虚拟机",
          "default": "true"
        },
        "speed_limit": {
          "type": "integer",
          "format": "int32",
          "description": "限制迁移速率,单位:Mbps。0表示不限速",
          "maximum": 1000,
          "minimum": 0,
          "default": 0
        },
        "use_public_ip": {
          "type": "boolean",
          "description": "是否使用公网IP迁移",
          "default": true
        },
        "exist_server": {
          "type": "boolean",
          "description": "是否是已经存在的服务器",
          "default": true
        },
        "type": {
          "type": "string",
          "description": "迁移项目类型\nMIGRATE_BLOCK:块级迁移\nMIGRATE_FILE:文件级迁移",
          "enum": [
            "MIGRATE_BLOCK",
            "MIGRATE_FILE"
          ],
          "maxLength": 255,
          "minLength": 0
        },
        "enterprise_project": {
          "type": "string",
          "description": "企业项目名称",
          "default": "default",
          "maxLength": 255,
          "minLength": 0
        },
        "syncing": {
          "type": "boolean",
          "description": "首次复制或者同步后 是否继续持续同步",
          "default": false
        },
        "start_network_check": {
          "type": "boolean",
          "description": "是否启动网络质量检测"
        }
      },
      "description": "SMS迁移项目信息",
      "type": "object"
    },
