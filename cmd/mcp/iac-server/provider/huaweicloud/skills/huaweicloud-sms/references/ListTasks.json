{
  "name": "ListTasks",
  "summary": "查询迁移任务列表",
  "tags": "任务管理",
  "productshort": "SMS",
  "region_id": "cn-north-4",
  "paths": {
    "/v3/tasks": {
      "get": {
        "x-open-region-cloud": "hc,hk",
        "tags": [
          "任务管理"
        ],
        "summary": "查询迁移任务列表",
        "description": "在设置目的端后,主机迁移服务会自动创建迁移任务,使用该接口可以查询迁移任务列表。",
        "operationId": "ListTasks",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。  \n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-order": 1,
            "x-annotations": "",
            "maxLength": 16384,
            "minLength": 1
          },
          {
            "name": "state",
            "in": "query",
            "description": "迁移任务状态\nREADY:准备就绪\nRUNNING:迁移中\nSYNCING:同步中\nMIGRATE_SUCCESS:迁移成功\nMIGRATE_FAIL:迁移失败\nABORTING:中止中\nABORT:中止\nDELETING::删除中\nSYNC_F_ROLLBACKING:同步失败回滚中\nSYNC_F_ROLLBACK_SUCCESS:同步失败回滚成功",
            "required": false,
            "type": "string",
            "enum": [
              "READY",
              "RUNNING",
              "SYNCING",
              "MIGRATE_SUCCESS",
              "MIGRATE_FAIL",
              "ABORTING",
              "ABORT",
              "DELETING",
              "SYNC_F_ROLLBACKING",
              "SYNC_F_ROLLBACK_SUCCESS"
            ],
            "x-order": 2,
            "x-annotations": ""
          },
          {
            "name": "name",
            "in": "query",
            "description": "任务的名称",
            "required": false,
            "type": "string",
            "x-order": 3,
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "id",
            "in": "query",
            "description": "任务的ID",
            "required": false,
            "type": "string",
            "x-order": 4,
            "maxLength": 36,
            "minLength": 1
          },
          {
            "name": "source_server_id",
            "in": "query",
            "description": "源端服务器的ID",
            "required": false,
            "type": "string",
            "x-order": 5,
            "maxLength": 36,
            "minLength": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每一页记录的任务数量",
            "required": false,
            "type": "integer",
            "format": "int32",
            "x-order": 6,
            "default": 100,
            "maximum": 200,
            "minimum": 0
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量",
            "required": false,
            "type": "integer",
            "format": "int32",
            "x-order": 7,
            "default": 0,
            "maximum": 65535,
            "minimum": 0
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "需要查询的企业项目ID",
            "required": false,
            "type": "string",
