  "definitions": {
    "NetworkCheckInfoRequestBody": {
      "type": "object",
      "required": [
        "network_delay",
        "network_jitter",
        "migration_speed",
        "loss_percentage",
        "cpu_usage",
        "mem_usage",
        "evaluation_result"
      ],
      "properties": {
        "domain_connectivity": {
          "type": "boolean",
          "description": "域名连通性"
        },
        "destination_connectivity": {
          "type": "boolean",
          "description": "目的端连通性"
        },
        "network_delay": {
          "type": "number",
          "format": "double",
          "description": "网络时延(ms)",
          "example": 20.0,
          "minimum": 0,
          "maximum": 10000.0
        },
        "network_jitter": {
          "type": "number",
          "format": "double",
          "description": "网络抖动(ms)",
          "example": 10.0,
          "minimum": 0,
          "maximum": 10000
        },
        "migration_speed": {
          "type": "number",
          "format": "double",
          "description": "带宽速率(Mbit/s)",
          "example": 500.0,
          "minimum": 0,
          "maximum": 10000
        },
        "loss_percentage": {
          "type": "number",
          "format": "double",
          "description": "丢包率(%)",
          "example": 0.0,
          "minimum": 0,
          "maximum": 100
        },
        "cpu_usage": {
          "type": "number",
          "format": "double",
          "description": "CPU占用率(%)",
          "example": 30.0,
          "minimum": 0,
          "maximum": 100
        },
        "mem_usage": {
          "type": "number",
          "format": "double",
          "description": "内存占用率(%)",
          "example": 20.0,
          "minimum": 0,
          "maximum": 100
        },
        "evaluation_result": {
          "type": "string",
          "description": "评估结果",
          "example": "1:1:1",
          "minLength": 5,
          "maxLength": 9
        }
      }
    },
    "CloneServerBrief": {
      "properties": {
        "vm_id": {
          "type": "string",
          "description": "克隆服务器ID",
          "maxLength": 255,
          "minLength": 0
        },
        "name": {
          "type": "string",
          "description": "克隆虚拟机的名称",
          "maxLength": 255,
          "minLength": 0
        }
      },
      "description": "克隆服务器基本信息"
    },
    "SubTaskAssociatedWithTask": {
      "properties": {
        "id": {
          "type": "integer",
          "description": "子任务ID",
          "maximum": 9223372036854775807,
          "minimum": 0,
          "format": "int64"
        },
        "name": {
          "type": "string",
          "description": "子任务名称",
          "maxLength": 255,
          "minLength": 0
        },
        "progress": {
          "type": "integer",
          "description": "子任务的进度,取值为0-100之间的整数",
          "maximum": 100,
          "minimum": 0,
          "format": "int32"
        },
        "start_date": {
          "type": "integer",
          "format": "int64",
          "description": "子任务开始时间",
          "maximum": 9223372036854775807,
          "minimum": 0
        },
        "end_date": {
          "type": "integer",
          "format": "int64",
          "description": "子任务结束时间(如果子任务还没有结束,则为空)",
          "maximum": 9223372036854775807,
          "minimum": 0
        },
        "process_trace": {
          "type": "string",
          "description": "迁移或同步时,具体的迁移详情",
          "minLength": 0,
          "maxLength": 2048
        }
      },
      "description": "任务关联的子任务信息"
    },
    "SourceServerAssociatedWithTask": {
      "required": [
        "name",
        "ip",
        "os_type",
        "agent_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "源端在SMS数据库中的ID",
          "maxLength": 255,
          "minLength": 0
        },
        "ip": {
          "type": "string",
          "description": "源端服务器ip,注册源端时必选,更新非必选",
          "maxLength": 255,
          "minLength": 0
        },
        "name": {
          "type": "string",
          "description": "用来区分不同源端服务器的名称",
          "maxLength": 255,
          "minLength": 0
        },
        "os_type": {
          "type": "string",
          "description": "源端服务器的OS类型,分为Windows和Linux,注册必选,更新非必选",
          "enum": [
            "WINDOWS",
            "LINUX"
          ],
          "maxLength": 255,
          "minLength": 0
        },
        "os_version": {
          "type": "string",
          "description": "操作系统版本,注册必选,更新非必选",
          "maxLength": 255,
          "minLength": 0
        },
        "oem_system": {
          "type": "boolean",
          "description": "是否是OEM操作系统(Windows)"
        },
        "state": {
          "type": "string",
          "description": "当前源端服务器状态\nunavailable:环境校验不通过\nwaiting:等待\ninitialize:初始化\nreplicate:复制\nsyncing:持续同步\nstopping:暂停中\nstopped:已暂停\nskipping:跳过中\ndeleting:删除中\nclearing: 清理快照资源中\ncleared:清理快照资源完成\nclearfailed:清理快照资源失败\npremigready:迁移演练就绪\npremiged:迁移演练完成\npremigfailed:迁移演练失败\ncloning:等待克隆完成\ncutovering:启动目的端中\nfinished:启动目的端完成\nerror:错误",
          "enum": [
            "unavailable",
            "waiting",
            "initialize",
            "replicate",
            "syncing",
            "stopping",
            "stopped",
            "skipping",
            "deleting",
            "clearing",
            "cleared",
            "clearfailed",
            "premigready",
            "premiged",
            "premigfailed",
            "cloning",
            "cutovering",
            "finished",
            "error"
          ]
        }
      },
      "description": "任务关联的源端信息"
    },
    "TasksResponse": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "符合要求的任务数量,不受分页影响",
          "maximum": 2147483647,
          "minimum": 0
        },
        "tasks": {
          "type": "array",
          "description": "查询到的任务列表",
          "items": {
            "$ref": "#/definitions/TasksResponseBody"
          },
          "maxItems": 65535,
          "minItems": 0
        }
      },
      "description": "批量查询任务",
      "type": "object"
    },
    "Forbiddenstatus": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "SMS.9004",
          "minLength": 0,
          "maxLength": 255,
          "description": "错误代码"
        },
        "error_msg": {
          "type": "string",
          "example": "The current account does not have the permission to execute policy. You do not have permission to perform action XXX on resource XXX.",
          "minLength": 0,
          "maxLength": 255,
          "description": "错误信息"
        },
        "encoded_authorization_message": {
          "type": "string",
          "example": "XXXXXX",
          "minLength": 0,
          "maxLength": 65535,
          "description": "加密授权信息"
        },
        "error_param": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "example": "XXXXXX",
            "minLength": 0,
            "maxLength": 65535
          },
          "example": [
            "You do not have permission to perform action XXX on resource XXX."
          ],
          "description": "错误参数"
        },
        "details": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "properties": {
              "error_code": {
                "type": "string",
                "example": "SMS.9004",
                "minLength": 0,
                "maxLength": 65535,
                "description": "SMS错误代码"
              },
              "error_msg": {
                "type": "string",
                "example": "You do not have permission to perform action XXX on resource XXX.",
                "minLength": 0,
                "maxLength": 65535,
                "description": "SMS错误信息"
              }
            }
          },
          "description": "详细错误信息"
        }
      },
      "description": "接口请求鉴权失败时返回的response body格式"
    },
    "TargetServerAssociatedWithTask": {
      "properties": {
        "id": {
          "type": "string",
          "description": "目的端在SMS数据库中的ID",
          "maxLength": 255,
          "minLength": 0
        },
        "vm_id": {
          "type": "string",
          "description": "目的端虚机ID",
          "maxLength": 255,
          "minLength": 0
        },
        "name": {
          "type": "string",
          "description": "目的端服务器名称",
          "maxLength": 255,
          "minLength": 0
        },
        "ip": {
          "type": "string",
          "description": "目的端服务器IP",
          "maxLength": 255,
          "minLength": 0
        },
        "os_type": {
          "type": "string",
          "description": "目的端服务器的OS类型\nWINDOWS:WINDOWS系统\nLINUX:LINUX系统\n",
          "enum": [
            "WINDOWS",
            "LINUX"
          ],
          "maxLength": 255,
          "minLength": 0
        },
        "os_version": {
          "type": "string",
          "description": "操作系统版本",
          "maxLength": 255,
          "minLength": 0
        }
      },
      "description": "任务关联的目的端信息"
    },
    "ConfigBody": {
      "type": "object",
      "description": "配置参数body",
      "required": [
        "config_key",
        "config_value"
      ],
      "properties": {
        "config_key": {
          "type": "string",
          "description": "配置类型\nMIGRATE_EXCLUDE_DIR: 迁移时设定的不迁移目录\nSYNC_EXCLUDE_DIR: 同步时设定的不同步目录\nONLY_SYNC_DIR: 同步时设定的同步目录\nCONSISTENCY_DIR: 一致性校验的目录\nCONSISTENCY_DIR_ILLEGAL: 一致性校验后非法目录\nLINUX_BLOCK_COMPRESS_THREAD_NUM: linux块迁移压缩线程个数\nMIGRATE_DST_IP: 迁移目的ip\nLINUX_BLOCK_CACHE_SIZE: linux块迁移缓存大小\nLINUX_CPU_LIMIT: linux的cpu限制\nLINUX_MEM_LIMIT: linux的内存限制\nLINUX_IO_LIMIT: linux的IO限制\nNUM_PROCESS_MIGRATE: 迁移进程数\nNUM_PROCESS_SYNC: 同步进程数\nCONSISTENCY_RECHECK: 一致性校验再检\nCONSISTENCY_MODE: 一致性校验模式\nDYNAMIC_PORT: 动态端口\nINSTALL_PWD_AGENT: 是否安装密码重置插件,取值\"true\"表示安装,默认为\"true\"",
          "enum": [
            "MIGRATE_EXCLUDE_DIR",
            "SYNC_EXCLUDE_DIR",
            "ONLY_SYNC_DIR",
            "CONSISTENCY_DIR",
            "CONSISTENCY_DIR_ILLEGAL",
            "LINUX_BLOCK_COMPRESS_THREAD_NUM",
            "MIGRATE_DST_IP",
            "LINUX_BLOCK_CACHE_SIZE",
            "LINUX_CPU_LIMIT",
            "LINUX_MEM_LIMIT",
            "LINUX_IO_LIMIT",
            "NUM_PROCESS_MIGRATE",
            "NUM_PROCESS_SYNC",
            "CONSISTENCY_RECHECK",
            "CONSISTENCY_MODE",
            "DYNAMIC_PORT"
          ]
        },
        "config_value": {
          "type": "string",
          "description": "具体配置参数字段,保存于数据库,最终在agent端进行解析",
          "minLength": 0,
          "maxLength": 1024
        },
        "config_status": {
          "type": "string",
          "description": "描述配置状态的保留字段",
          "minLength": 0,
          "maxLength": 255
        }
      }
    },
    "TasksResponseBody": {
      "properties": {
        "id": {
          "type": "string",
          "description": "迁移任务ID",
          "maxLength": 255,
          "minLength": 0
        },
        "name": {
          "type": "string",
          "description": "任务名称(用户自定义)",
          "maxLength": 255,
          "minLength": 0
        },
        "type": {
          "type": "string",
          "description": "任务类型,创建时必选,更新时可选\nMIGRATE_FILE:文件级迁移\nMIGRATE_BLOCK:块级迁移",
          "enum": [
            "MIGRATE_FILE",
            "MIGRATE_BLOCK"
          ],
          "maxLength": 255,
          "minLength": 0
        },
        "os_type": {
          "type": "string",
          "description": "操作系统类型,分为WINDOWS和LINUX,创建时必选,更新时可选",
          "enum": [
            "WINDOWS",
            "LINUX"
          ],
          "maxLength": 255,
          "minLength": 0
        },
        "state": {
          "type": "string",
          "description": "迁移任务状态\nREADY: 准备就绪\nRUNNING: 迁移中\nSYNCING: 同步中\nMIGRATE_SUCCESS: 迁移成功\nSYNC_SUCCESS: 同步成功\nMIGRATE_FAIL: 失败\nSYNC_FAIL: 同步失败\nABORTING: 中止中\nABORT: 中止\nSKIPPING: 跳过中\nDELETING: 删除中\nRESETING: 回滚中",
          "enum": [
            "READY",
            "RUNNING",
            "SYNCING",
            "MIGRATE_SUCCESS",
            "SYNC_SUCCESS",
            "MIGRATE_FAIL",
            "SYNC_FAIL",
            "ABORTING",
            "ABORT",
            "SKIPPING",
            "DELETING",
            "RESETING"
          ]
        },
        "estimate_complete_time": {
          "type": "integer",
          "format": "int64",
          "description": "预估完成时间",
          "maximum": 9223372036854775807,
          "minimum": 0
        },
        "create_date": {
          "type": "integer",
          "format": "int64",
          "description": "任务创建时间",
          "maximum": 9223372036854775807,
          "minimum": 0
        },
        "priority": {
