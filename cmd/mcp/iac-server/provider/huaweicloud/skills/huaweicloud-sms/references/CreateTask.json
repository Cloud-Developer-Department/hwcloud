    "PostTask": {
      "required": [
        "name",
        "type",
        "source_server",
        "target_server",
        "region_name",
        "region_id",
        "project_name",
        "project_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "任务名称,只能由中文字符、英文字母、数字、下划线、短横线组成",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_\\-\\一-\\龥]{1,64}$"
        },
        "type": {
          "type": "string",
          "description": "任务类型\nMIGRATE_FILE:文件级迁移\nMIGRATE_BLOCK:块级迁移",
          "enum": [
            "MIGRATE_FILE",
            "MIGRATE_BLOCK"
          ]
        },
        "start_target_server": {
          "type": "boolean",
          "description": "迁移后是否启动目的端虚拟机",
          "default": true
        },
        "auto_start": {
          "type": "boolean",
          "description": "是否自动启动"
        },
        "os_type": {
          "type": "string",
          "description": "操作系统类型\nWINDOWS:Windows系统类型\nLINUX:Linux系统类型",
          "enum": [
            "WINDOWS",
            "LINUX"
          ]
        },
        "source_server": {
          "$ref": "#/definitions/SourceServerByTask",
          "description": "源端主机应存在,且处于连接状态,且没有创建迁移任务"
        },
        "target_server": {
          "$ref": "#/definitions/TargetServerByTask"
        },
        "migration_ip": {
          "type": "string",
          "description": "迁移IP,如果是自动创建虚拟机,不需要此参数。\nuse_ipv6是false时,migration_ip应满足ipv4的格式标准;use_ipv6是true时,migration_ip应满足ipv6的格式标准。",
          "maxLength": 255,
          "minLength": 0
        },
        "region_name": {
          "type": "string",
          "description": "region的名称",
          "maxLength": 255,
          "minLength": 0
        },
        "region_id": {
          "type": "string",
          "description": "region ID",
          "maxLength": 255,
          "minLength": 0
        },
        "project_name": {
          "type": "string",
          "description": "项目名称",
          "maxLength": 255,
          "minLength": 0
        },
        "project_id": {
          "type": "string",
          "description": "项目ID",
          "maxLength": 255,
          "minLength": 0
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "description": "优先级。默认为1",
          "maximum": 65535,
          "minimum": 0
        },
        "vm_template_id": {
          "type": "string",
          "description": "自动创建虚拟机使用模板",
          "maxLength": 100,
          "minLength": 0
        },
        "clonevm_template_id": {
          "type": "string",
          "description": "克隆服务器模板ID",
          "minLength": 0,
          "maxLength": 100
        },
        "use_public_ip": {
          "type": "boolean",
          "description": "是否使用公网ip",
          "default": true
        },
        "use_ipv6": {
          "type": "boolean",
          "description": "是否使用ipv6",
          "default": false
        },
        "syncing": {
          "type": "boolean",
          "description": "复制或者同步后是否会继续持续同步,不添加则默认是false",
          "default": false
        },
        "exist_server": {
          "type": "boolean",
          "description": "是否存在服务,如果存在,则创建任务"
        },
        "start_network_check": {
          "type": "boolean",
          "description": "是否开启网络检测"
        },
        "speed_limit": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1000,
          "description": "迁移速率限制值",
          "example": 100,
          "default": 0
        },
        "over_speed_threshold": {
          "type": "number",
          "format": "double",
          "description": "停止迁移的超速阈值。 是一个迁移速率的保护机制,超出该阈值会停止任务。它主要用于控制迁移过程中资源(特别是网络带宽)的消耗,确保系统的整体性能不受单一迁移任务影响 单位是百分比",
          "example": 50.0,
          "minimum": 10,
          "maximum": 100,
          "default": 10
        },
        "is_need_consistency_check": {
          "type": "boolean",
          "description": "是否进行一致性校验"
        },
        "need_migration_test": {
          "type": "boolean",
          "description": "是否开启迁移演练"
        }
      },
      "description": "创建任务的参数",
      "type": "object"
    },
