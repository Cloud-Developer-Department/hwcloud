          "type": "string",
          "description": "名称",
          "maxLength": 255,
          "minLength": 0
        },
        "vm_id": {
          "type": "string",
          "description": "虚拟机ID",
          "maxLength": 255,
          "minLength": 0
        },
        "volume_groups": {
