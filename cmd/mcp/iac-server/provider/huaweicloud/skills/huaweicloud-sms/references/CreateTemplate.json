          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "properties": {
              "error_code": {
                "type": "string",
                "example": "SMS.9004",
                "minLength": 0,
                "maxLength": 65535,
                "description": "SMS错误代码"
              },
              "error_msg": {
                "type": "string",
                "example": "You do not have permission to perform action XXX on resource XXX.",
                "minLength": 0,
                "maxLength": 65535,
                "description": "SMS错误信息"
              }
            }
          },
          "description": "详细错误信息"
        }
      },
      "description": "接口请求鉴权失败时返回的response body格式"
    },
    "VpcObject": {
      "properties": {
        "id": {
          "type": "string",
          "description": "虚拟私有云ID,如果是自动创建,填“autoCreate”",
          "maxLength": 255,
          "minLength": 1
        },
        "name": {
          "type": "string",
          "description": "虚拟私有云名称",
          "maxLength": 255,
          "minLength": 1
        },
        "cidr": {
          "type": "string",
          "description": "VPC的网段,默认192.168.0.0/16",
          "maxLength": 255,
          "minLength": 1
        }
      },
      "description": "vpc对象",
      "type": "object"
    },
    "CreateTemplateResp": {
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "服务端返回的新添加的模板的ID",
          "maxLength": 255,
          "minLength": 0
        }
      },
      "description": "创建模板响应",
      "type": "object"
    },
    "CreateTemplateReq": {
      "required": [
        "template"
      ],
      "properties": {
        "template": {
          "description": "模板信息",
          "$ref": "#/definitions/TemplateRequest"
        }
      },
      "description": "This is a auto create Body Object"
    },
    "PublicIp": {
      "required": [
        "type",
        "bandwidth_size"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "弹性公网IP类型,默认为5_bgp。\n详细类型请参考EIP服务API文档中“查询弹性公网IP详情”部分,查看响应参数的中type字段描述",
          "maxLength": 255,
          "minLength": 0
        },
        "bandwidth_size": {
          "type": "integer",
          "format": "int32",
          "description": "带宽大小,单位:Mbit/s。\n调整带宽时的最小单位会根据带宽范围不同存在差异。\n小于等于300Mbit/s,默认最小单位为1Mbit/s。300Mbit/s~1000Mbit/s,默认最小单位为50Mbit/s。大于1000Mbit/s:默认最小单位为500Mbit/s。",
          "minimum": 1,
          "maximum": 2000,
          "x-annotations": "如果share_type是PER,该参数必选项;如果share_type是WHOLE并且ID有值,该参数会忽略。"
        },
        "bandwidth_share_type": {
          "type": "string",
          "description": "带宽共享类型(长文本信息,非枚举数据,来源于EIP服务)\n详细类型请参考EIP服务API文档中“查询弹性公网IP详情”部分,查看响应参数的中bandwidth_share_type字段描述",
          "maxLength": 255,
          "minLength": 0
        }
      },
      "description": "公网ip",
      "type": "object"
    },
    "TemplateDisk": {
      "required": [
        "index",
        "name",
        "disktype",
        "size"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "磁盘ID",
          "maximum": 9223372036854775807,
          "minimum": 0
        },
        "index": {
          "type": "integer",
          "format": "int32",
          "description": "磁盘序号,从0开始",
          "maximum": 2147483647,
          "minimum": 0
        },
        "name": {
          "type": "string",
          "description": "磁盘名称",
          "maxLength": 255,
          "minLength": 0
        },
        "disktype": {
          "type": "string",
          "description": "磁盘类型,同volumetype字段(非枚举数据,来源于EVS服务)\n详细类型请参考EIP服务API文档中“查询单个云硬盘详情”部分,查看响应参数的中volume_type字段描述",
          "maxLength": 255,
          "minLength": 0
        },
        "size": {
          "type": "integer",
          "format": "int64",
          "description": "磁盘大小,单位:GB",
          "maximum": 9223372036854775807,
          "minimum": 0
        },
        "device_use": {
          "type": "string",
          "description": "磁盘使用",
          "maxLength": 255,
          "minLength": 0
        }
      },
      "description": "磁盘模板",
      "type": "object"
    },
    "Nics": {
      "required": [
        "id",
        "name",
        "cidr"
      ],
      "properties": {
        "id": {
          "type": "string",
