  "definitions": {
    "TemplateRequest": {
      "properties": {
        "name": {
          "type": "string",
          "description": "模板名称\n仅由中文字符、下划线、短横线、数字、英文大小写字母组成",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "[\\一-\\龥-_0-9a-zA-Z]*"
        },
        "is_template": {
          "type": "boolean",
          "description": "是否是通用模板,如果模板关联一个任务,则不算通用模板"
        },
        "region": {
          "type": "string",
          "description": "Region信息",
          "maxLength": 255,
          "minLength": 0
        },
        "projectid": {
          "type": "string",
          "description": "项目ID",
          "maxLength": 255,
          "minLength": 0
        },
        "target_server_name": {
          "type": "string",
          "description": "目标端服务器名称",
          "maxLength": 255,
          "minLength": 0
        },
        "availability_zone": {
          "type": "string",
          "description": "可用区",
          "maxLength": 255,
          "minLength": 0
        },
        "volumetype": {
          "type": "string",
          "description": "磁盘类型\n(非枚举数据,来源于EVS服务)\n常见类型如:SAS:串行连接SCSI,SSD:固态硬盘,SATA:串口硬盘等。\n详细类型请参考EIP服务API文档中“查询单个云硬盘详情”部分,查看响应参数的中volume_type字段描述",
          "minLength": 0,
          "maxLength": 255
        },
        "flavor": {
          "type": "string",
          "description": "虚拟机规格",
          "maxLength": 65535,
          "minLength": 0
        },
        "vpc": {
          "$ref": "#/definitions/VpcObject"
        },
        "nics": {
          "type": "array",
          "description": "网卡信息,支持多个网卡,如果是自动创建,只填一个,ID使用“autoCreate”",
          "items": {
            "$ref": "#/definitions/Nics"
          },
          "maxItems": 65535,
          "minItems": 0
        },
        "security_groups": {
          "type": "array",
          "description": "安全组,支持多个安全组,如果是自动创建,只填一个,ID使用“autoCreate”",
          "items": {
            "$ref": "#/definitions/SgObject"
          },
          "maxItems": 65535,
          "minItems": 0
        },
        "publicip": {
          "$ref": "#/definitions/PublicIp"
        },
        "disk": {
          "type": "array",
          "description": "磁盘信息",
          "items": {
            "$ref": "#/definitions/TemplateDisk"
          },
          "maxItems": 65535,
          "minItems": 0
        },
        "data_volume_type": {
          "type": "string",
          "description": "数据盘磁盘类型\n(非枚举数据,来源于EVS服务)\n常见类型如:SAS:串行连接SCSI,SSD:固态硬盘,SATA:串口硬盘等。\n详细类型请参考EIP服务API文档中“查询单个云硬盘详情”部分,查看响应参数的中volume_type字段描述",
          "minLength": 0,
          "maxLength": 255
        },
        "target_password": {
          "type": "string",
          "description": "目的端密码",
          "maxLength": 1024,
          "minLength": 0
        },
        "image_id": {
          "type": "string",
          "description": "新建目的虚拟机用户选择的镜像版本Id值",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "description": "自动创建虚拟机模板",
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Forbiddenstatus": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "SMS.9004",
          "minLength": 0,
          "maxLength": 255,
          "description": "错误代码"
        },
        "error_msg": {
          "type": "string",
          "example": "The current account does not have the permission to execute policy. You do not have permission to perform action XXX on resource XXX.",
          "minLength": 0,
          "maxLength": 255,
          "description": "错误信息"
        },
        "encoded_authorization_message": {
          "type": "string",
          "example": "XXXXXX",
          "minLength": 0,
          "maxLength": 65535,
          "description": "加密授权信息"
        },
        "error_param": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "example": "XXXXXX",
            "minLength": 0,
            "maxLength": 65535
          },
          "example": [
            "You do not have permission to perform action XXX on resource XXX."
