          "maxLength": 255,
          "minLength": 0
        },
        "ip": {
          "type": "string",
          "description": "虚拟机IP地址,如果没有这个字段,自动分配IP",
          "maxLength": 255,
          "minLength": 0
        }
      },
      "description": "网卡资源"
