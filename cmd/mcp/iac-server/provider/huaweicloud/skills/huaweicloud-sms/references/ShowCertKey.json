            "required": true,
            "type": "string",
            "x-order": 1,
            "maxLength": 16384,
            "minLength": 1
          },
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "迁移任务ID",
            "maxLength": 36,
            "minLength": 1
