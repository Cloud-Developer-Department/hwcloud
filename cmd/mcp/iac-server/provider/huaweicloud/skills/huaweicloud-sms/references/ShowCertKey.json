                "target_mgmt_cert": "-----BEGIN CERTIFICATE-----\n********************************\n-----END CERTIFICATE-----\n",
                "target_mgmt_private_key": "-----BEGIN RSA PRIVATE KEY-----\n********************************\n-----END RSA PRIVATE KEY-----\n",
                "target_data_cert": "-----BEGIN CERTIFICATE-----\n********************************\n-----END CERTIFICATE-----\n",
