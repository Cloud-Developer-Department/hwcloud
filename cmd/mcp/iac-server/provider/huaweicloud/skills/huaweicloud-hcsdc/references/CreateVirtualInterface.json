  "definitions": {
    "createVirtualInterfaceReq": {
      "required": [
        "virtual_interface"
      ],
      "properties": {
        "virtual_interface": {
          "$ref": "#/definitions/createVirtualInterfaceReqBody"
        }
      }
    },
    "link_infos": {
      "required": [
        "hosting_id",
        "interface_group_id",
        "local_gateway_v4_ip",
        "remote_gateway_v4_ip",
        "vlan"
      ],
      "properties": {
        "interface_group_id": {
          "type": "string",
          "description": "接口组ID。如果填写link_infos,此项必填,但必须要有对应的pre_config。"
        },
        "hosting_id": {
          "type": "string",
          "description": "所用hosting专线的id。如果填写link_infos,此项必填,但必须要有对应的pre_config。"
        },
        "vlan": {
          "type": "integer",
          "format": "int32",
          "description": "L3GW TOR和云外设备的互联vlan。如果填写link_infos,此项必填,但必须要有对应的pre_config。范围[1, 4063]。"
        },
        "remote_gateway_v4_ip": {
          "type": "string",
          "description": "远端网关IPV4地址。如果填写link_infos,此项必填,但必须要有对应的pre_config。"
        },
        "local_gateway_v4_ip": {
          "type": "string",
          "description": "本端网关IPV4地址。如果填写link_infos,此项必填,但必须要有对应的pre_config。"
        },
        "remote_gateway_v6_ip": {
          "type": "string",
          "description": "远端网关IPV6地址。如填写,需要和对应preconfig内的值相同,否则报错。"
        },
        "local_gateway_v6_ip": {
          "type": "string",
          "description": "本端网关IPV6地址。如填写,需要和对应preconfig内的值相同,否则报错。"
        },
        "bgp_asn": {
          "type": "integer",
          "description": "云外设备的BGP邻居的AS号,整数形式。取值范围0-4294967295,其中1-4294967295为有效AS号,0为不指定。与bgp_asn_dot不能同时指定。如填写,需要和对应preconfig内的值相同,否则报错。"
        },
        "bgp_asn_dot": {
          "type": "string",
          "description": "云外设备的BGP邻居的AS号,点分X.Y形式。X的取值范围为1至65535,Y的取值范围为0至65535。null为不指定。如填写,需要和对应preconfig内的值相同,否则报错。"
        },
        "bgp_md5": {
          "type": "string",
          "description": "BGP邻居的MD5密码。如填写,需要和对应preconfig内的值相同,否则报错。"
        }
      }
    },
    "createVirtualInterfaceResp": {
      "required": [
        "virtual_interface"
      ],
      "properties": {
        "virtual_interface": {
          "$ref": "#/definitions/createVirtualInterfaceRespBody"
        }
      }
    },
    "createVirtualInterfaceReqBody": {
      "required": [
        "direct_connect_id",
        "vgw_id"
      ],
      "properties": {
        "admin_state_up": {
          "type": "boolean",
          "description": "资源的管理状态,处于打开(true)或关闭(false)。"
        },
        "bgp_asn": {
          "type": "integer",
          "description": "BGP的AS号。"
        },
        "bgp_md5": {
          "type": "string",
          "description": "BGP的鉴权key。"
        },
        "description": {
          "type": "string",
          "description": "对该资源的自定义描述。",
          "maxLength": 128
        },
        "direct_connect_id": {
          "type": "string",
          "description": "云专线的ID。"
        },
        "local_gateway_v4_ips": {
          "type": "array",
          "description": "虚拟网关的本地地址列表。如果选填,需要和vlan以及remote_gateway_v4_ip同时填写。",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string",
          "description": "资源的自定义名称。",
          "maxLength": 64
        },
        "remote_ep_group_id": {
          "type": "string",
          "description": "端口组ID,该端口组包含了远端网络的cidr。remote_ep_group_id与高可用属性(ha_group_id/priority)不能同时指定,且必须指定其中一类属性。"
        },
        "ha_group_id": {
          "type": "string",
          "description": "高可用组ID,与priority共同使用。remote_ep_group_id与高可用属性(ha_group_id/priority)不能同时指定,且必须指定其中一类属性。"
        },
        "priority": {
          "type": "string",
          "description": "虚拟接口在高可用组内的优先级,与ha_group_id共同使用。remote_ep_group_id与高可用属性(ha_group_id/priority)不能同时指定,且必须指定其中一类属性。当前支持的优先级有:高(high)、低(low)。"
        },
        "remote_gateway_v4_ip": {
          "type": "string",
          "description": "远端网关地址。如果选填,需要和local_gateway_v4_ips以及vlan同时填写。"
        },
        "route_mode": {
          "type": "string",
          "description": "路由模式。有效值为static,bgp。"
        },
        "service_type": {
          "type": "string",
          "description": "接入服务类型。有效值为vpc,public service,vpc and public service。"
        },
        "tenant_id": {
          "type": "string",
          "description": "项目ID。"
        },
        "type": {
          "type": "string",
          "description": "虚拟接口类型,有效值为private,public。"
        },
        "vgw_id": {
          "type": "string",
          "description": "虚拟网关ID。"
        },
        "vlan": {
          "type": "integer",
          "format": "int32",
          "description": "虚拟接口vlan。范围1-4096。如果选填,需要和local_gateway_v4_ips以及remote_gateway_v4_ip同时填写。"
        },
        "link_infos": {
          "type": "array",
          "description": "增强型云服务L3GW和PE之间的互联信息。L3GW如果选择自动分配互联信息,不需要带此字段。若填写,则hosting_id,vlan,interface_group_id,remote_gateway_v4_ip,local_gateway_v4_ip必填。",
          "items": {
            "$ref": "#/definitions/link_infos"
          }
        },
        "interface_group_id": {
          "type": "string",
          "description": "接口组ID。"
        },
        "local_gateway_v6_ip": {
          "type": "string",
          "description": "虚拟接口的IPv6地址。"
        },
        "remote_gateway_v6_ip": {
          "type": "string",
          "description": "远端网关的IPv6地址。"
        }
      }
    },
