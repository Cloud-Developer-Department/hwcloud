        "name": {
          "type": "string",
          "description": "资源的自定义名称。",
          "maxLength": 64
        },
        "remote_ep_group_id": {
          "type": "string",
          "description": "端口组ID,该端口组包含了远端网络的cidr。当虚拟接口正在使用remote_ep_group_id时,不能指定高可用属性(ha_group_id/priority)。若需要将虚拟接口从使用remote_ep_group_id变为使用高可用属性,需指定高可用属性的同时指定remote_ep_group_id为空。"
        },
        "ha_group_id": {
          "type": "string",
          "description": "高可用组ID,与priority共同使用。当虚拟接口正在使用高可用属性(ha_group_id/priority)时,不能指定remote_ep_group_id。若需要将虚拟接口从使用高可用属性变为使用remote_ep_group_id,需指定remote_ep_group_id的同时指定高可用属性为空。"
        },
        "priority": {
          "type": "string",
          "description": "虚拟接口在高可用组内的优先级,与ha_group_id共同使用。当虚拟接口正在使用高可用属性(ha_group_id/priority)时,不能指定remote_ep_group_id。若需要将虚拟接口从使用高可用属性变为使用remote_ep_group_id,需指定remote_ep_group_id的同时指定高可用属性为空。当前支持的优先级有:高(high)、低(low)。"
        }
      }
    },
