        },
        "location": {
          "$ref": "#/definitions/Location"
        },
        "preNodeNames": {
          "type": "string",
          "description": "本节点依赖的前一个节点名称"
        },
        "condition": {
          "type": "array",
          "description": "节点执行条件",
          "items": {
            "$ref": "#/definitions/Condition"
          }
        },
        "nodeProperties": {
          "type": "string",
          "description": "节点的属性"
        },
        "pollingInterval": {
          "type": "integer",
          "description": "轮询节点执行结果时间间隔"
        },
        "maxExecutionTime": {
          "type": "integer",
          "description": "节点最大执行时间"
        },
        "retryTimes": {
          "type": "integer",
          "description": "节点失败重试次数"
        },
        "retryInterval": {
          "type": "integer",
          "description": "失败重试时间间隔"
        },
        "failPolicy": {
          "type": "string",
          "description": "作业失败策略",
          "enum": [
            "FAIL",
            "IGNORE",
            "SUSPEND"
          ]
        },
        "eventTrigger": {
          "$ref": "#/definitions/Event"
        },
        "cronTrigger": {
          "$ref": "#/definitions/Cron"
        }
      }
    },
    "Cron": {
