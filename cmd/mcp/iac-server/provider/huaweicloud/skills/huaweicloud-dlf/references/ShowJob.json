        "lastUpdateUser": {
          "type": "string"
        },
        "basicConfig": {
          "$ref": "#/definitions/BasicInfo"
        }
      }
    },
    "Location": {
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      }
    },
    "DependJob": {
      "properties": {
        "jobs": {
          "type": "array",
