          "description": "依赖的作业名称列表,必须依赖已存在的作业."
        },
        "dependPeriod": {
          "type": "string",
          "description": "依赖周期"
        },
        "dependFailPolicy": {
          "type": "string",
          "enum": [
            "FAIL",
            "IGNORE",
            "SUSPEND"
          ],
          "description": "依赖作业任务执行失败处理策略"
