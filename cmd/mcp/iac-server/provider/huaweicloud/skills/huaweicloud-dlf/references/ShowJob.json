            "SparkSQL",
            "DWSSQL",
            "DLISQL",
            "Shell",
            "CDMJob",
            "DISTransferTask",
            "CSJob",
            "CloudTableManage",
            "OBSManager",
            "RESTAPI",
            "MachineLearning",
            "SMN",
            "MRSSpark",
            "MapReduce",
            "DLISpark"
