{
  "name": "ShowJob",
  "summary": "查询作业详情",
  "tags": "作业相关的API",
  "productshort": "DLF",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/{project_id}/jobs/{job_name}": {
      "get": {
        "summary": "查询作业详情",
        "x-support-sdk": "Y",
        "tags": [
          "作业相关的API"
        ],
        "operationId": "ShowJob",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "workspace",
            "in": "header",
            "description": "工作空间id",
            "required": false,
            "type": "string",
            "x-notgenerate": true
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号.",
            "required": true,
            "type": "string"
          },
          {
            "name": "job_name",
            "in": "path",
            "description": "作业名称.",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "schema": {
              "$ref": "#/definitions/JobInfo"
            }
          }
        }
      }
    }
  },
  "definitions": {
