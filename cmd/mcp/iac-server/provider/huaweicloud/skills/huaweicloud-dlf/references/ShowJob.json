        },
        "executeUser": {
          "type": "string",
          "description": "作业执行用户"
        },
        "instanceTimeout": {
          "type": "integer",
          "description": "实例超时时间"
        },
        "customFields": {
          "type": "object",
          "description": "用户自定义属性字段"
        }
      }
