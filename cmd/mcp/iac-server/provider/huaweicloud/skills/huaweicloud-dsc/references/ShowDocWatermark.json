{
  "name": "ShowDocWatermark",
  "summary": "文档提取暗水印",
  "tags": "文档水印",
  "productshort": "DSC",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/sdg/doc/watermark/extract": {
      "post": {
        "x-hybridcloud": "true",
        "x-apiErrorCodes": "[]",
        "x-request-examples-url-1": "POST /v1/{project_id}/sdg/doc/watermark/extract",
        "x-request-examples-description-1": "> 通过form表单提交请求,其中file为具体文件",
        "x-request-examples-text-1": {
          "file": "testMarked.doc",
          "doc_type": "WORD"
        },
        "x-request-examples-1": {
          "file": "testMarked.doc",
          "doc_type": "WORD"
        },
        "tags": [
          "文档水印"
        ],
        "summary": "文档提取暗水印",
        "description": "对已嵌入文字暗水印的WORD(.docx),PPT(.pptx),EXCEL(.xlsx),PDF(.pdf)类型的文档进行文字暗水印提取,用户以formData的格式传入待提取水印的文件,DSC服务以JSON的格式返回从文档里提取的出的文字暗水印内容。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "operationId": "ShowDocWatermark",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 32,
            "x-example": "05c214d53400d5c52fe7c00b83c93dsc"
          },
          {
            "name": "doc_type",
            "in": "formData",
            "description": "待提取水印的文档类型",
            "required": true,
            "type": "string",
            "enum": [
              "WORD",
              "EXCEL",
              "PDF",
              "PPT"
            ],
            "x-example": "EXCEL"
          },
          {
            "name": "file_password",
            "in": "formData",
            "description": "解密文件的密码, 最大支持长度256。如果Office文档有读密码或域控的权限密码,请输入读密码,或者有读权限的域控密码。",
            "required": false,
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "x-example": "password"
          },
          {
            "name": "file",
            "in": "formData",
            "description": "上传要提取水印的文档",
            "required": true,
            "type": "file",
            "x-example": "file"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。通过调用IAM服务“获取用户Token接口”获取(响应消息头中X-Subject-Token的值)",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "examples": {
              "application/json": {
                "watermark": "mark!"
              }
            },
            "schema": {
              "$ref": "#/definitions/PicutureWaterMark"
            }
          },
          "400": {
            "description": "无效请求",
            "examples": {
              "application/json": {
                "error_code": "DSC.00000007",
                "error_msg": "File format error"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorReturnInfo"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "PicutureWaterMark": {
      "required": [
        "watermark"
      ],
      "properties": {
        "watermark": {
          "type": "string",
          "description": "暗水印内容,长度不超过32个字节"
        }
      }
    },
    "ErrorReturnInfo": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "sdg.cn-east-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}