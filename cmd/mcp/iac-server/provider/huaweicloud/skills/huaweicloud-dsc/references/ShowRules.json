{
  "name": "ShowRules",
  "summary": "查看规则列表",
  "tags": "敏感数据发现",
  "productshort": "DSC",
  "region_id": "cn-south-1",
  "paths": {
    "/v1/{project_id}/sdg/server/scan/rules": {
      "get": {
        "x-request-examples-description-1": "查询扫描规则列表",
        "x-request-examples-url-1": "GET /v1/{project_id}/sdg/server/scan/rules",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "tags": [
          "敏感数据发现"
        ],
        "summary": "查看规则列表",
        "description": "查询扫描规则列表,返回扫描规则总数和扫描规则列表",
        "operationId": "ShowRules",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "required": true,
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "页码",
            "required": false,
            "type": "integer",
            "default": 0,
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "分页大小",
            "required": false,
            "type": "integer",
            "default": 100,
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "examples": {
              "application/json": {
                "total": 1,
                "rules": [
                  {
                    "category": "BUILT_SELF",
                    "delete_allowed": true,
                    "group_names": "xxxx",
                    "id": "xxxxxxxxxxxx",
                    "logic_operator": "AND",
                    "min_match": 1,
                    "risk_level": 1,
                    "rule_content": "xxxx",
                    "rule_desc": "xxxx",
                    "rule_name": "xxxx",
                    "rule_type": "KEYWORD",
                    "selected": true
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ResponseRules"
            }
          },
          "400": {
            "description": "无效请求",
            "examples": {
              "application/json": {
                "error_code": "dsc.40000011",
                "error_msg": "Invalid parameter"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorReturnInfo"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ResponseRules": {
      "type": "object",
      "properties": {
        "rules": {
          "description": "规则列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResponseRule"
          }
        },
        "total": {
          "description": "规则总数",
          "type": "integer",
          "format": "int32"
        }
      },
      "title": "ResponseRules"
    },
    "ResponseRule": {
      "description": "扫描规则",
      "type": "object",
      "properties": {
        "category": {
          "description": "规则类别,内置规则(BUILT_IN)或自建规则(BUILT_SELF)",
          "type": "string",
          "enum": [
            "BUILT_IN",
            "BUILT_SELF"
          ]
        },
        "delete_allowed": {
          "description": "是否允许删除",
          "type": "boolean"
        },
        "group_names": {
          "description": "相关的规则组",
          "type": "string"
        },
        "id": {
          "description": "规则ID",
          "type": "string"
        },
        "logic_operator": {
          "description": "逻辑运算符,\"AND\",\"OR\",\"REGEX\"",
          "type": "string"
        },
        "min_match": {
          "description": "最小匹配次数",
          "type": "integer",
          "format": "int32"
        },
        "risk_level": {
          "description": "风险等级",
          "type": "integer",
          "format": "int32"
        },
        "rule_content": {
          "description": "规则内容",
          "type": "string"
        },
        "rule_desc": {
          "description": "规则描述",
          "type": "string"
        },
        "rule_name": {
          "description": "规则名称",
          "type": "string"
        },
        "rule_type": {
          "description": "规则类型,关键字(KEYWORD)、正则表达式(REGEX)或自然语言(NLP)",
          "type": "string",
          "enum": [
            "KEYWORD",
            "REGEX",
            "NLP"
          ]
        },
        "selected": {
          "description": "是否可选",
          "type": "boolean"
        }
      },
      "title": "ResponseRule"
    },
    "ErrorReturnInfo": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "sdg.cn-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}