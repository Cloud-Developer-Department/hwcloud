{
  "name": "CreateImageWatermark",
  "summary": "图片嵌入暗水印",
  "tags": "图片水印",
  "productshort": "DSC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/image/watermark/embed": {
      "post": {
        "x-hybridcloud": "true",
        "x-apiErrorCodes": "[]",
        "x-request-examples-1": {
          "blind_watermark": "testWaterMark",
          "file": "test.PNG"
        },
        "x-request-examples-url-1": "POST /v1/{project_id}/image/watermark/embed HTTP/1.1",
        "x-request-examples-description-1": "> 通过form表单提交,file为具体文件。",
        "x-request-examples-text-1": {
          "blind_watermark": "testWaterMark",
          "file": "test.PNG"
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "tags": [
          "图片水印"
        ],
        "summary": "图片嵌入暗水印",
        "description": "对图片嵌入文字暗水印或者图片暗水印,用户以formData的格式传入待加水印图片和水印相关信息,DSC服务对图片加完水印后返回给用户已嵌入水印的图片二进制流,目前支持的图片格式为:*.jpg, *.jpeg, *.jpe, *.png, *.bmp, *.dib, *.rle, *.tiff, *.tif, *.ppm, *.webp, *.tga, *.tpic, *.gif。",
        "operationId": "CreateImageWatermark",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "项目ID",
            "type": "string",
            "maxLength": 32,
            "minLength": 32
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。通过调用IAM服务“获取用户Token接口”获取(响应消息头中X-Subject-Token的值)",
            "type": "string"
          },
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "description": "要添加水印的图片文件,添加的图片短边尺寸需要超过512像素。",
            "type": "file"
          },
          {
            "name": "blind_watermark",
            "in": "formData",
            "required": false,
            "description": "待嵌入的文字暗水印内容,长度不超过32个字符。当前仅支持数字及英文大小写。与图片暗水印image_watermark二选一填充。",
            "type": "string",
            "minLength": 0,
            "maxLength": 32
          },
          {
            "name": "image_watermark",
            "in": "formData",
            "required": false,
            "description": "待嵌入的图片暗水印文件,与文字暗水印 blind_watermark 二选一填充。",
            "type": "file"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "examples": {
              "application/octet-stream": "{\"Watermarked image\"}"
            },
            "schema": {
              "type": "string",
              "format": "binary"
            }
          },
          "400": {
            "description": "无效请求",
            "examples": {
              "application/json": {
                "error_code": "DSC.00000007",
                "error_msg": "File format error"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorReturnInfo"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorReturnInfo": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "sdg.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
