        "summary": "图片嵌入暗水印(文件地址版本)",
        "description": "对指定存储地址信息(目前支持华为云OBS)的图片嵌入文字暗水印或者图片暗水印,已嵌入的水印的图片将存放在用户指定的位置(目前支持华为云OBS),支持的图片格式为:*.jpg, *.jpeg, *.jpe, *.png, *.bmp, *.dib, *.rle, *.tiff, *.tif, *.ppm, *.webp, *.tga, *.tpic, *.gif。",
        "operationId": "CreateImageWatermarkByAddress",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "项目ID",
            "type": "string",
            "maxLength": 32,
            "minLength": 32
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。通过调用IAM服务“获取用户Token接口”获取(响应消息头中X-Subject-Token的值)",
            "type": "string"
          },
          {
            "name": "CreateImageWatermarkByAddressRequestBody",
            "in": "body",
            "required": true,
            "description": "图片地址嵌入水印请求体",
            "schema": {
              "$ref": "#/definitions/CreateImageWatermarkByAddressRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "examples": {
              "application/json": {
                "region_id": "xx-xx-1",
                "watermarked_file": "obs://hwbucket/test.png"
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateImageWatermarkByAddressResponseBody"
            }
          },
          "400": {
            "description": "无效请求",
            "examples": {
              "application/json": {
                "error_code": "DSC.00000007",
                "error_msg": "File format error"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorReturnInfo"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CreateImageWatermarkByAddressResponseBody": {
      "properties": {
        "region_id": {
          "type": "string",
          "description": "当前项目所在region的id,如:xx-xx-1。"
        },
        "watermarked_file": {
          "type": "string",
          "description": "添加水印后的OBS图片地址,当前只支持华为云OBS文件,格式为 **obs://bucket/object** ,其中bucket为和当前项目处于同一区域的OBS桶名称,object为对象全路径名。例如:**obs://hwbucket/hwinfo/hw.png**,其中obs://表示OBS存储,hwbucket为桶名,hwinfo/hw.png为对象全路径名。"
        }
      },
      "required": [
        "region_id",
        "watermarked_file"
      ]
    },
    "CreateImageWatermarkByAddressRequestBody": {
      "properties": {
        "region_id": {
          "type": "string",
          "description": "当前项目所在region的id,如:xx-xx-1。"
        },
        "src_file": {
          "type": "string",
          "description": "待加暗水印的图片地址,当前只支持华为云OBS文件,格式为 **obs://bucket/object** ,其中bucket为和当前项目处于同一区域的OBS桶名称,object为对象全路径名。例如:**obs://hwbucket/hwinfo/hw.png**,其中obs://表示OBS存储,hwbucket为桶名,hwinfo/hw.png为对象全路径名。"
        },
        "blind_watermark": {
          "type": "string",
          "description": "待嵌入的文字暗水印内容,长度不超过32个字符。当前仅支持数字及英文大小写。与图片暗水印image_watermark二选一。",
          "minLength": 0,
          "maxLength": 32
        },
        "image_watermark": {
          "type": "string",
          "description": "待嵌入的图片暗水印地址,格式要求同src_file字段,与文字暗水印 blind_watermark 二选一,都填写时,生效image_watermark。"
        },
        "dst_file": {
          "type": "string",
          "description": "添加水印后的图片存放的地址,格式要求同src_file字段,不设置时,默认取src_file的值,即添加水印后覆盖原文件。"
        }
      },
      "required": [
        "region_id",
        "src_file"
      ]
    },
    "ErrorReturnInfo": {
      "properties": {
