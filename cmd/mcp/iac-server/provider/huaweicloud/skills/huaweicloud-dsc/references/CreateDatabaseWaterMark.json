              "type": "object"
            }
          }
        }
      }
    },
    "EmbeddedDatabaseWatermark": {
      "example": "watermark_content:\"watermark\" watermark_key:\"key\" columns:{} data:{}",
      "required": [
        "watermark_content",
        "watermark_key",
        "columns",
        "data"
      ],
      "properties": {
        "watermark_content": {
          "type": "string",
          "description": "添加水印的内容"
        },
        "watermark_key": {
          "type": "string",
          "description": "水印密钥"
        },
        "columns": {
          "type": "array",
          "description": "字段类型列表,最大长度100。使用时,至少包含两个字段,一个“primary_key”为true表示主键,一个为false用来嵌入水印",
          "items": {
            "$ref": "#/definitions/Columns"
          }
        },
        "data": {
          "description": "嵌入可提取水印的行数限制1500-50000行。内容建议:数据具有随机性,内容重复率低",
          "items": {
            "type": "object",
            "additionalProperties": {
              "description": "待加水印的数据",
              "type": "object"
            }
          },
          "type": "array"
        }
      }
    },
    "Columns": {
      "description": "字段类型列表,最大长度100",
      "required": [
        "name",
        "type",
        "primary_key"
      ],
      "example": "name:\"col1\" type:\"INTEGER\" primary_key:false",
      "properties": {
        "name": {
          "description": "数据的字段名称,最大支持长度256",
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "type": {
          "description": "数据的字段类型",
          "type": "string",
          "enum": [
            "INTEGER",
            "STRING",
            "DOUBLE"
          ]
        },
        "primary_key": {
          "description": "标记该字段是否为主键。true为主键,表示用来定位水印位置;false为非主键,将在该列嵌入/提取水印内容。字段类型列表中可同时包含多个为true或为false的字段",
          "type": "boolean"
        }
      }
    },
    "ErrorReturnInfo": {
