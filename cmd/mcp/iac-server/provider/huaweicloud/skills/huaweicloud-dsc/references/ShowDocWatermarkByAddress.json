{
  "name": "ShowDocWatermarkByAddress",
  "summary": "文档提取暗水印(文档地址版本)",
  "tags": "文档水印",
  "productshort": "DSC",
  "region_id": "cn-southwest-2",
  "paths": {
    "/v1/{project_id}/doc-address/watermark/extract": {
      "post": {
        "x-apiErrorCodes": "[]",
        "x-request-examples-url-1": "POST /v1/{project_id}/doc-address/watermark/extract",
        "x-request-examples-text-1": {
          "region_id": "xx-xx-1",
          "src_file": "obs://hwbucket/hwinfo/hw.docx",
          "doc_type": "WORD"
        },
        "x-request-examples-1": {
          "region_id": "xx-xx-1",
          "src_file": "obs://hwbucket/hwinfo/hw.docx",
          "doc_type": "WORD"
        },
        "tags": [
          "文档水印"
        ],
        "summary": "文档提取暗水印(文档地址版本)",
        "description": "支持对已嵌入文字暗水印的WORD(.docx),PPT(.pptx),EXCEL(.xlsx),PDF(.pdf)类型的文档进行水印提取,用户传入待提取水印的文档地址(目前支持OBS),DSC服务以JSON的格式返回从文档里提取的出的文字暗水印内容。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "operationId": "ShowDocWatermarkByAddress",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 32,
            "x-example": "05c214d53400d5c52fe7c00b83c93dsc"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。通过调用IAM服务“获取用户Token接口”获取(响应消息头中X-Subject-Token的值)",
            "type": "string"
          },
          {
            "name": "ShowDocWatermarkByAddressRequestBody",
            "in": "body",
            "description": "提取OBS文档水印请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ShowDocWatermarkByAddressRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "examples": {
              "application/json": {
                "watermark": "blind_watermark"
              }
            },
            "schema": {
              "$ref": "#/definitions/PicutureWaterMark"
            }
          },
          "400": {
            "description": "无效请求",
            "examples": {
              "application/json": {
                "error_code": "DSC.00000007",
                "error_msg": "File format error"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorReturnInfo"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ShowDocWatermarkByAddressRequestBody": {
      "properties": {
        "region_id": {
          "type": "string",
          "description": "项目所在region的id,如:xx-xx-1。"
        },
        "doc_type": {
          "type": "string",
          "description": "待提取水印的文档类型",
          "enum": [
            "WORD",
            "EXCEL",
            "PDF",
            "PPT"
          ]
        },
        "src_file": {
          "type": "string",
          "description": "待提取文字暗水印的文档的地址,当前只支持华为云OBS对象,格式为 **obs://bucket/object** ,其中bucket为和当前项目处于同一区域的OBS桶名称,object为对象全路径名。例如:**obs://hwbucket/hwinfo/hw.doc**,其中obs://表示OBS存储,hwbucket为桶名,hwinfo/hw.doc为对象全路径名。"
        },
        "file_password": {
          "type": "string",
          "description": "解密文件的密码, 最大支持长度256。如果Office文档有读密码或域控的权限密码,请输入读密码,或者有读权限的域控密码。",
          "minLength": 0,
          "maxLength": 256
        }
      },
      "required": [
        "region_id",
        "doc_type",
        "src_file"
      ]
    },
    "PicutureWaterMark": {
      "required": [
        "watermark"
      ],
      "properties": {
        "watermark": {
          "type": "string",
          "description": "暗水印内容,长度不超过32个字节"
        }
      }
    },
    "ErrorReturnInfo": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "sdg.cn-southwest-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}