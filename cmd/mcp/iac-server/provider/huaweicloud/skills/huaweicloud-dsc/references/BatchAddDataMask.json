  "definitions": {
    "MaskStrategies": {
      "required": [
        "name",
        "algorithm"
      ],
      "description": "脱敏策略列表,每个策略对应一个字段,脱敏策略数最多100个。详情见“动态脱敏策略配置”。",
      "properties": {
        "name": {
          "type": "string",
          "description": "需要脱敏的字段名称,最大支持长度256。"
        },
        "algorithm": {
          "type": "string",
          "description": "脱敏算法名称,详情见附录\"动态脱敏策略配置\"。",
          "enum": [
            "SHA256",
            "SHA512",
            "AES",
            "PRESNM",
            "MASKNM",
            "PRESXY",
            "MASKXY",
            "SYMBOL",
            "KEYWORD",
            "NUMERIC"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "description": "脱敏算法参数,详情见附录\"动态脱敏策略配置\"。"
        }
      }
    },
    "DynamicDataMask": {
      "properties": {
        "mask_strategies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MaskStrategies"
          },
          "description": "脱敏策略列表,每一个策略对应一个字段,脱敏策略数最多100个。"
        },
        "data": {
          "type": "array",
          "description": "数据列表。",
          "items": {
            "type": "object",
            "additionalProperties": {
              "description": "待脱敏的数据",
              "type": "object"
            }
          },
          "maxItems": 2000,
          "minItems": 0
        }
      },
      "required": [
        "mask_strategies",
        "data"
      ]
    },
    "MaskedData": {
      "properties": {
        "masked_data": {
          "description": "脱敏后的数据的数据列表,结构与请求中结构相同",
          "items": {
            "type": "object",
            "additionalProperties": {
              "description": "脱敏后的数据",
              "type": "object"
            }
          },
          "type": "array"
        }
      },
      "required": [
        "masked_data"
      ]
    },
    "ErrorReturnInfo": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ]
    }
