{
  "name": "CreateDocWatermark",
  "summary": "文档嵌入水印",
  "tags": "文档水印",
  "productshort": "DSC",
  "region_id": "ap-southeast-2",
  "paths": {
    "/v1/{project_id}/sdg/doc/watermark/embed": {
      "post": {
        "x-hybridcloud": "true",
        "x-apiErrorCodes": "[]",
        "x-request-examples-url-1": "POST /v1/{project_id}/sdg/doc/watermark/embed",
        "x-request-examples-description-1": "> 通过form表单提交请求,其中file是具体文件。",
        "x-request-examples-text-1": {
          "file": "test.doc",
          "doc_type": "WORD",
          "opacity": "0.1",
          "font_size": "30",
          "rotation": "45",
          "blind_watermark": "blind_watermark",
          "visible_watermark": "visible_watermark"
        },
        "x-request-examples-1": {
          "file": "test.doc",
          "doc_type": "WORD",
          "opacity": "0.1",
          "font_size": "30",
          "rotation": "45",
          "blind_watermark": "blind_watermark",
          "visible_watermark": "visible_watermark"
        },
        "tags": [
          "文档水印"
        ],
        "summary": "文档嵌入水印",
        "description": "对WORD(.docx),PPT(.pptx),EXCEL(.xlsx),PDF(.pdf) 类型的文件嵌入文字暗水印、文字明水印或者图片明水印,用户以formData的格式传入待加水印的文件和水印相关信息,DSC服务给文件加完水印后返回给用户已嵌入水印的文件的二进制流。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "operationId": "CreateDocWatermark",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "doc_type",
            "in": "formData",
            "description": "要嵌入水印的文档类型",
            "required": true,
            "type": "string",
            "enum": [
              "WORD",
              "EXCEL",
              "PDF",
              "PPT"
            ],
            "x-example": "EXCEL"
          },
          {
            "name": "file_password",
            "in": "formData",
            "description": "输入文件有密码时,读取文件的密码, 最大支持长度256。如果Office文档有读密码或域控的权限密码,请输入读密码,或者有读权限的域控密码。",
            "required": false,
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "x-example": "password"
          },
          {
            "name": "marked_file_password",
            "in": "formData",
            "required": false,
            "description": "添加水印后给文件设置密码, 最大支持长度256。默认不加文档密码。",
            "type": "string"
          },
          {
            "name": "readonly_password",
            "in": "formData",
            "required": false,
            "description": "添加水印后给文件设置只读密码, 最大支持长度256。默认不加只读密码。",
            "type": "string"
          },
          {
            "name": "visible_watermark",
            "in": "formData",
            "description": "明水印内容,与“blind_watermark”字段至少有一个不为空",
            "required": false,
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "x-example": "watermark"
          },
          {
            "name": "font_size",
            "in": "formData",
            "description": "明水印字体大小,取值为[1,100],默认值50",
            "required": false,
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "x-example": "50"
          },
          {
            "name": "rotation",
            "in": "formData",
            "description": "明水印旋转角度,逆时针方向,取值为[0,90],默认值45",
            "required": false,
            "type": "string",
            "maxLength": 90,
            "minLength": 0,
            "x-example": "45"
          },
          {
            "name": "opacity",
            "in": "formData",
            "description": "明水印的透明度,取值[0,1],默认值为0.3;",
            "required": false,
            "type": "string",
            "maxLength": 8,
            "minLength": 0,
            "x-example": "0.3"
          },
          {
            "name": "blind_watermark",
            "in": "formData",
            "description": "暗水印内容,与“visible_watermark”字段至少有一个不为空",
            "required": false,
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "x-example": "blind watermark"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 32,
            "x-example": "05c214d53400d5c52fe7c00b83c93dsc"
          },
          {
            "name": "file",
            "in": "formData",
            "description": "要添加水印的文档",
            "required": true,
            "type": "file",
            "x-example": "file"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。通过调用IAM服务“获取用户Token接口”获取(响应消息头中X-Subject-Token的值)",
            "type": "string"
          },
          {
            "name": "image_mark",
            "in": "formData",
            "required": false,
            "description": "图形水印的字节流。图形文件的格式必须为“png”或“jpg”,否则返回参数错误;图像文件大小不超过1MB;在分段的请求体“Content-Disposition”部分,参数“name”的值必须为“image_mark”。",
            "type": "file"
          },
          {
            "name": "visible_type",
            "in": "formData",
            "required": false,
            "description": "该字段为空时,默认为**TEXT**类型。\n\n当该字段为**IMAGE**时:\n- 请求的表单中必须包含名为“image”的图像文件,图像格式必须为“png”或“jpg”,否则返回参数错误;\n- 图像文件大小不超过1MB;\n- “visible_watermark”,“font_size”,“rotation”和“opacity”字段无效。",
            "enum": [
              "TEXT",
              "IMAGE"
            ],
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "examples": {
              "application/octet-stream": "{\"Watermarked document\"}"
            },
            "schema": {
              "type": "string",
              "format": "binary"
            }
          },
          "400": {
            "description": "无效请求",
            "examples": {
              "application/json": {
                "error_code": "DSC.00000007 ",
                "error_msg": "File format error"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorReturnInfo"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorReturnInfo": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "sdg.ap-southeast-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}