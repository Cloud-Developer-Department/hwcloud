{
  "name": "ShowImageWatermarkByAddress",
  "summary": "提取图片中的文字暗水印(文件地址版本)",
  "tags": "图片水印",
  "productshort": "DSC",
  "region_id": "cn-north-9",
  "paths": {
    "/v1/{project_id}/image-address/watermark/extract": {
      "post": {
        "x-apiErrorCodes": "[]",
        "x-request-examples-url-1": "POST /v1/{project_id}/image-address/watermark/extract HTTP/1.1",
        "x-request-examples-text-1": {
          "region_id": "xx-xx-1",
          "src_file": "obs://hwbucket/hwinfo/hw.png"
        },
        "x-request-examples-1": {
          "region_id": "xx-xx-1",
          "src_file": "obs://hwbucket/hwinfo/hw.png"
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "tags": [
          "图片水印"
        ],
        "summary": "提取图片中的文字暗水印(文件地址版本)",
        "description": "对指定存储地址信息(目前支持华为云OBS)的已嵌入文字暗水印的图片提取文字暗水印,支持的图片格式为:*.jpg, *.jpeg, *.jpe, *.png, *.bmp, *.dib, *.rle, *.tiff, *.tif, *.ppm, *.webp, *.tga, *.tpic, *.gif。",
        "operationId": "ShowImageWatermarkByAddress",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "项目ID",
            "type": "string",
            "maxLength": 32,
            "minLength": 32
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。通过调用IAM服务“获取用户Token接口”获取(响应消息头中X-Subject-Token的值)",
            "type": "string"
          },
          {
            "name": "ShowImageWatermarkByAddressRequestBody",
            "in": "body",
            "required": true,
            "description": "图片提取文字暗水印请求体",
            "schema": {
              "$ref": "#/definitions/ShowImageWatermarkByAddressRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "schema": {
              "$ref": "#/definitions/PicutureWaterMark"
            },
            "examples": {
              "application/json": {
                "watermark": "mark!"
              }
            }
          },
          "400": {
            "description": "无效请求",
            "examples": {
              "application/json": {
                "error_code": "DSC.00000007 ",
                "error_msg": "File format error"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorReturnInfo"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ShowImageWatermarkByAddressRequestBody": {
      "properties": {
        "region_id": {
          "type": "string",
          "description": "项目所在region的id,如:xx-xx-1。"
        },
        "src_file": {
          "type": "string",
          "description": "待提取文字暗水印的图片地址,当前只支持华为云OBS,格式为 **obs://bucket/object** ,其中bucket为和当前项目处于同一区域的OBS桶名称,object为对象全路径名。例如:**obs://hwbucket/hwinfo/hw.png**,其中obs://表示OBS存储,hwbucket为桶名,hwinfo/hw.png为对象全路径名。"
        },
        "mark_len": {
          "type": "integer",
          "format": "int32",
          "description": "指定待提取水印的长度,最小0,最大32.。设置后可以提升水印提取性能。",
          "minimum": 0,
          "maximum": 32
        }
      },
      "required": [
        "region_id",
        "src_file"
      ]
    },
    "PicutureWaterMark": {
      "required": [
        "watermark"
      ],
      "properties": {
        "watermark": {
          "type": "string",
          "description": "暗水印内容,长度不超过32个字节"
        }
      }
    },
    "ErrorReturnInfo": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ]
    }
  },
  "version": "2.0",
