  "definitions": {
    "ScanJob": {
      "properties": {
        "id": {
          "type": "string",
          "description": "任务ID"
        },
        "name": {
          "type": "string",
          "description": "任务名称"
        },
        "rule_groups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "任务使用的规则组"
        },
        "cycle": {
          "type": "string",
          "description": "任务执行方式",
          "enum": [
            "ONCE",
            "DAY",
            "WEEK",
            "MONTH"
          ]
        },
        "status": {
          "type": "string",
          "description": "任务当前状态",
          "enum": [
            "INIT",
            "WAITING",
            "RUNNING",
            "FAILED",
            "STOPPED",
            "FINISHED",
            "TERMINATED"
          ]
        },
        "last_run_time": {
          "type": "integer",
          "format": "int64",
          "description": "任务上一次执行时间"
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "description": "任务创建时间"
        },
        "last_scan_risk": {
          "type": "string",
          "description": "任务上一次扫描风险等级结果"
        },
        "use_nlp": {
          "type": "boolean",
          "description": "是否使用了NLP进行扫描"
        },
        "open": {
          "type": "boolean",
          "description": "任务开启状态"
        },
        "topic_urn": {
          "type": "string",
          "description": "SMN服务通知主题"
        },
        "start_time": {
          "type": "integer",
          "format": "int64",
          "description": "任务启动时间"
        }
      }
    },
    "ErrorReturnInfo": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ]
    },
    "ScanJobListResponse": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ScanJob"
          },
          "description": "本次返回的扫描任务列表"
        },
        "total": {
          "type": "integer",
          "format": "int64",
          "description": "任务总数"
        }
      }
    }
  },
