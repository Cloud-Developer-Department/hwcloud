  "definitions": {
    "AudioModerationResult": {
      "properties": {
        "job_id": {
          "type": "string",
          "example": "01655654400_ad96b30f58cc40e8968e53f1f1e80021",
          "description": "作业id"
        },
        "status": {
          "type": "string",
          "example": "succeeded",
          "description": "作业状态,可取值有:\nrunning: 正在运行\nsucceeded: 运行成功\nfailed: 运行失败",
          "enum": [
            "running",
            "succeeded",
            "failed"
          ]
        },
        "result": {
          "properties": {
            "suggestion": {
              "type": "string",
              "example": "block",
              "description": "音频审核结果是否通过。\nblock:包含敏感信息,不通过\npass:不包含敏感信息,通过\nreview:需要人工复检",
              "enum": [
                "block",
                "pass",
                "review"
              ]
            },
            "details": {
              "items": {
                "$ref": "#/definitions/AudioModerationResultDetail"
              },
              "type": "array",
              "description": "审核详情"
            },
            "audio_text": {
              "type": "string",
              "example": "国家主席习近平十号在青岛会见白俄罗斯总统卢卡申科,习近平指出在双方共同努力下中白全面战略伙伴关系迈入相互信任合作共赢的新阶段,我和总统先生达成的合作共识得到有效落实双方领域各层级交流合作达到历史最高水平,两国人民共享合作成果带来的获得感不断增强近平强调,中国视白俄罗斯为共建一带一路的重要合作伙伴赞赏白方积极参与,几年来中白共建一带一路合作全面发力多点突破纵深推进成果显著",
              "description": "音频文本内容"
            }
          },
          "description": "作业审核结果,当作业状态为succeeded时存在"
        },
        "request_params": {
          "properties": {
            "event_type": {
              "type": "string",
              "example": "default",
              "description": "创建作业时传的event_type参数"
            },
            "data": {
              "properties": {
                "url": {
                  "type": "string",
                  "example": "https://audio-annotation-1251671073.cos.ap-shanghai.myqcloud.com/0171ac03ecd5e93e66c62896f2c21db1_125.wav"
                }
              },
              "description": "创建作业时传的data参数"
            },
            "callback": {
              "type": "string",
              "example": "http://10.154.237.177:8848/v2/integration/moderation/callback",
              "description": "创建作业时传的callback参数"
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "porn",
                "ad"
              ],
              "description": "创建作业时传的categories参数"
            }
          },
          "description": "作业创建参数"
        },
        "create_time": {
          "type": "string",
          "example": "2022-06-20 11:05:29",
          "description": "作业创建时间"
        },
        "update_time": {
          "type": "string",
          "example": "2022-06-20 11:07:08",
          "description": "作业更新时间"
        },
        "request_id": {
          "type": "string",
          "example": "2419446b1fe14203f64e4018d12db3dd",
          "description": "本次请求的唯一标识,用于问题排查,建议保存。",
          "minLength": 2,
          "maxLength": 64
        }
      },
      "required": [
        "job_id",
        "status",
        "request_params",
        "create_time",
        "update_time",
        "request_id"
      ]
    },
    "AudioModerationResultDetail": {
      "properties": {
        "start_time": {
          "type": "number",
          "format": "float",
          "example": 0,
          "description": "音频片段开始时间"
        },
        "suggestion": {
          "type": "string",
          "example": "block",
          "description": "音频片段审核处理建议:\nblock:包含敏感信息,不通过\nreview:需要人工复检",
          "enum": [
            "block",
            "review"
          ]
        },
        "end_time": {
          "type": "number",
          "format": "float",
          "example": 10,
          "description": "音频片段结束时间"
        },
        "label": {
          "type": "string",
          "example": "politics",
          "description": "音频片段标签"
        },
        "audio_text": {
          "type": "string",
          "example": "国家主席习近平十号在青岛会见白俄罗斯总统卢卡申科,习近平指出在双方共同努力下中白",
          "description": "音频片段文本内容"
        },
        "segments": {
          "items": {
            "$ref": "#/definitions/VideoModerationDetailSegment"
          },
          "type": "array",
          "description": "命中的风险片段信息列表,如果命中语义算法模型,则该字段不会存在"
        }
      }
    },
