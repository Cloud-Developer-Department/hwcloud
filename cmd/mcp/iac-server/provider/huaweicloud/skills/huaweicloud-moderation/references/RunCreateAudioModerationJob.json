          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "调用失败时的错误信息。\n\n调用成功时无此字段。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    }
