  "productshort": "Moderation",
  "region_id": "cn-north-1",
  "paths": {
    "/v3/{project_id}/moderation/video/jobs": {
      "post": {
        "tags": [
          "视频内容审核"
        ],
        "operationId": "RunCreateVideoModerationJob",
        "summary": "创建视频内容审核作业",
        "description": "创建视频内容审核作业,创建成功会将作业ID返回给用户",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "用户的project_id 登陆华为云 -> 用户中心 -> 我的凭证 -> api凭证 即可查看对应区域的项目ID。"
          },
          {
            "in": "body",
            "name": "RunVideoModerationRequestBody",
            "description": "视频内容审核请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/VideoCreateRequest"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。 通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应体",
            "schema": {
              "$ref": "#/definitions/VideoCreateResponse"
            },
            "examples": {
              "application/json": {
                "job_id": "01661356800_7c0fe871f80543358917e4faebca4a48",
                "request_id": "07490f57ac5e034c077ab25b5f9e1da5"
              }
            }
          },
          "400": {
            "description": "失败响应体",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "AIS.0401",
                "error_msg": "The input parameter event_type is incorrect."
              }
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v3/{project_id}/moderation/video/jobs",
        "x-request-examples-text-1": {
          "data": {
            "url": "https://xxxx",
            "frame_interval": 5
          },
          "event_type": "default",
          "image_categories": [
            "porn",
            "politics",
            "terrorism",
            "image_text"
          ],
          "audio_categories": [
            "porn",
            "ad",
            "politics",
            "moan",
            "abuse"
          ],
          "callback": "http://xxxx"
        },
        "x-request-examples-1": {
          "data": {
            "url": "https://xxxx",
            "frame_interval": 5
          },
          "event_type": "default",
          "image_categories": [
            "porn",
            "politics",
            "terrorism",
            "image_text"
          ],
          "audio_categories": [
            "porn",
            "ad",
            "politics",
            "moan",
            "abuse"
          ],
          "callback": "http://xxxx"
        }
      }
    }
  },
  "definitions": {
    "VideoCreateResponse": {
      "description": "音频内容审核请求体",
      "properties": {
        "request_id": {
          "type": "string",
          "description": "本次请求的唯一标识,用于问题排查,建议保存。"
        },
        "job_id": {
          "type": "string",
          "description": "作业唯一标识。"
        }
      },
      "type": "object"
    },
    "VideoCreateRequest": {
      "properties": {
        "data": {
          "description": "视频数据输入",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "example": "https://xxxx",
              "description": "视频url地址"
            },
            "frame_interval": {
              "type": "integer",
              "format": "int32",
              "example": 5,
              "description": "截帧频率间隔,单位为秒,取值范围为1~60s;若不传递默认5s截帧一次"
            },
            "language": {
              "type": "string",
              "description": "支持的语言,默认为zh\nzh:中文",
              "example": "zh",
              "enum": [
                "zh"
              ]
            }
          }
        },
        "biz_type": {
          "type": "string",
          "description": "用户在控制台界面创建的biz_type名称,如果请求参数中传了biz_type则优先使用biz_type;如果用户没传biz_type则event_type和image_categories必须传。",
          "x-open-region-cloud": "hc"
        },
        "event_type": {
          "type": "string",
          "example": "default",
          "description": "事件类型,可选值如下:\ndefault:默认事件",
          "enum": [
            "default"
          ]
        },
        "image_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "example": "",
            "enum": [
              "porn",
              "politics",
              "terrorism",
              "image_text"
            ]
          },
          "example": "[\"porn\",\"politics\",\"terrorism\",\"image_text\"]",
          "description": "视频中画面需要检测的风险类型,列表不能为空。\nterrorism:涉政暴恐内容的检测\nporn:鉴黄内容的检测\npolitics:政治敏感人物内容的检测\nimage_text:图文违规内容的检测(检测图片中出现的广告、色情、暴恐、涉政的文字违规内容以及二维码内容)"
        },
        "audio_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "example": "",
            "enum": [
              "porn",
              "ad",
              "politics",
              "moan",
              "abuse"
            ]
          },
          "example": "[\"porn\",\"ad\",\"politics\",\"moan\",\"abuse\"]",
          "description": "视频中音频需要检测的风险类型,不传或为空时表示不审核音频维度。\npolitics: 涉政检测\nporn:涉黄检测\nad: 广告检测\nmoan: 娇喘检测\nabuse: 辱骂检测"
        },
        "callback": {
          "type": "string",
          "example": "http://xxxx",
          "description": "回调http接口:当该字段非空时,服务将根据该字段回调通知用户审核结果。"
        },
        "seed": {
          "type": "string",
          "description": "用于回调通知时校验请求由华为云内容安全服务发起,由您自定义。随机字符串,由英文字母、数字、下划线组成,不超过64个字符。\n说明:当seed非空时,headers中将包含X-Auth-Signature字段,字段的值使用HmacSHA256算法生成,待加密字符串由create_time、job_id、request_id、seed按照顺序拼接而成,密钥为seed。"
        }
      },
      "type": "object",
      "required": [
        "data"
      ]
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "调用失败时的错误码,具体请参见错误码。\n\n调用成功时无此字段。",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "调用失败时的错误信息。\n\n调用成功时无此字段。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "moderation.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
