{
  "name": "CheckImageModeration",
  "summary": "图像内容审核",
  "tags": "图像内容审核",
  "productshort": "Moderation",
  "region_id": "cn-east-3",
  "paths": {
    "/v3/{project_id}/moderation/image": {
      "post": {
        "tags": [
          "图像内容审核"
        ],
        "operationId": "CheckImageModeration",
        "summary": "图像内容审核",
        "description": "分析并识别用户上传的图像内容是否有敏感内容(如涉及暴恐元素、涉黄内容等),并将识别结果返回给用户。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "用户的project_id 登陆华为云 -> 用户中心 -> 我的凭证 -> api凭证 即可查看对应区域的项目ID。"
          },
          {
            "in": "body",
            "name": "RunImageModerationRequestBody",
            "description": "图像内容审核请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ImageDetectionReq"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。 通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string"
          },
          {
            "name": "Enterprise-Project-Id",
            "in": "header",
            "description": "企业项目ID。Moderation支持通过企业项目管理(EPS)对不同用户组和用户的资源使用,进行分账。\n获取方法:进入“[企业项目管理](https://console.huaweicloud.com/eps/?region=cn-north-4#/projects/list)”页面,单击企业项目名称,在企业项目详情页获取Enterprise-Project-Id(企业项目ID)。\n企业项目创建步骤请参见用户指南。\n> 说明:\n创建企业项目后,在传参时,有以下三类场景。\n- 携带正确的ID,正常使用Moderation服务,账单的企业项目会被分类到企业ID对应的企业项目中。\n- 携带格式正确但不存在的ID,正常使用Moderation服务,账单的企业项目会显示对应不存在的企业项目ID。\n- 不携带ID或格式错误ID(包含特殊字符等),正常使用Moderation服务,账单的企业项目会被分类到\"default\"中。",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应体",
            "schema": {
              "$ref": "#/definitions/ImageDetectionResponse"
            },
            "examples": {
              "application/json": {
                "request_id": "53f9719c3730d1169e47403d5c8a9473",
                "result": {
                  "category": "porn",
                  "details": [
                    {
                      "category": "porn",
                      "confidence": 0.9934315,
                      "label": "sexy_female",
                      "suggestion": "review"
                    },
                    {
                      "category": "porn",
                      "confidence": 0.99798274,
                      "label": "intimacy",
                      "suggestion": "review"
                    }
                  ],
                  "suggestion": "review"
                }
              }
            }
          },
          "400": {
            "description": "失败响应响应体",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "AIS.0402",
                "error_msg": "The image format is not supported."
              }
            }
          }
        },
        "x-request-examples-url-2": "POST https://{endpoint}/v3/{project_id}/moderation/image",
        "x-request-examples-description-2": "使用图片的url",
        "x-request-examples-text-2": {
          "event_type": "head_image",
          "url": "http://club2.autoimg.cn/album/g26/M05/9D/FF/userphotos/2022/08/08/07/500_ChsEdmLwSaKAO3IGAAUykD3c3jA252.jpg",
          "categories": [
            "porn",
            "terrorism"
          ],
          "image_text_config": {
            "black_glossary_names": [
              "test"
            ]
          }
        },
        "x-request-examples-2": {
          "event_type": "head_image",
          "url": "http://club2.autoimg.cn/album/g26/M05/9D/FF/userphotos/2022/08/08/07/500_ChsEdmLwSaKAO3IGAAUykD3c3jA252.jpg",
          "categories": [
            "porn",
            "terrorism"
          ],
          "image_text_config": {
            "black_glossary_names": [
              "test"
            ]
          }
        },
        "x-request-examples-description-1": "使用图片的BASE64编码",
        "x-request-examples-text-1": {
          "event_type": "head_image",
          "image": "/9j/4AAQSkZJRgABAgEASABIAAD/4RFZRXhpZgAATU0AKgAAAAgABwESAAMAAAABAAEAAAEaAAUAAAABAAAAYgEbAAUAAAABAAAA...",
          "categories": [
            "porn",
            "terrorism"
          ],
          "image_text_config": {
            "black_glossary_names": [
              "test"
            ]
          }
        },
        "x-request-examples-1": {
          "event_type": "head_image",
          "image": "/9j/4AAQSkZJRgABAgEASABIAAD/4RFZRXhpZgAATU0AKgAAAAgABwESAAMAAAABAAEAAAEaAAUAAAABAAAAYgEbAAUAAAABAAAA...",
          "categories": [
            "porn",
            "terrorism"
          ],
          "image_text_config": {
            "black_glossary_names": [
              "test"
            ]
          }
        },
        "x-request-examples-image-1": "{\n  \"event_type\": \"comment\",\n  \"categories\":[\"porn\", \"image_text\"],\n  \"image_text_config\":{\n    \"black_glossary_names\":[\"xxx\"]\n    \"white_glossary_names\":[\"xxx\"]\n  },\n  \"data\": {\n    \"image\": \"base64编码\",\n    \"url\" : \"https://BucketName.obs.myhuaweicloud.com/ObjectName.jpg\",\n  }\n}\n",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/{project_id}/moderation/image",
        "x-request-examples-url-3": "POST https://{endpoint}/v3/{project_id}/moderation/image",
        "x-request-examples-description-3": "使用bizType请求",
        "x-request-examples-text-3": {
          "url": "http://club2.autoimg.cn/album/g26/M05/9D/FF/userphotos/2022/08/08/07/500_ChsEdmLwSaKAO3IGAAUykD3c3jA252.jpg",
          "biz_type": "test-type"
        },
        "x-request-examples-3": {
          "url": "http://club2.autoimg.cn/album/g26/M05/9D/FF/userphotos/2022/08/08/07/500_ChsEdmLwSaKAO3IGAAUykD3c3jA252.jpg",
          "biz_type": "test-type"
        }
      }
    }
  },
  "definitions": {
    "ImgTextConfig": {
      "properties": {
        "black_glossary_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "检测时使用的自定义黑名单词库列表。"
        },
        "white_glossary_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "检测时使用的自定义白名单词库列表。"
        }
      },
      "type": "object",
      "description": "图文审核场景的黑白词库传入参数设置。"
    },
    "ImageDetectionResultDetail": {
      "properties": {
        "suggestion": {
          "type": "string",
          "description": "审核结果是否通过。\nblock:包含敏感信息,不通过\nreview:需要人工复检"
        },
        "category": {
          "type": "string",
          "description": "检测结果的一级标签。\n支持category列表如下:\nterrorism: 暴恐\nporn: 色情\nimage_text: 图文审核"
        },
        "confidence": {
          "type": "number",
          "format": "float",
          "description": "置信度,可选值在0-1之间,值越大,可信度越高。"
        },
        "face_location": {
          "$ref": "#/definitions/FaceLocationDetail",
          "description": "人物位置信息,该数组有四个值,分别代表左上角的坐标和右下角的坐标。例如[207,522,340,567],207代表的是左上角的横坐标,522代表左上角的纵坐标,340代表的是右下角的横坐标,567代表的是右下角的纵坐标。"
        },
        "qr_location": {
          "$ref": "#/definitions/QRLocationDetail",
          "x-open-region-cloud": "hc",
          "description": "二维码位置信息,该数组有四个值,分别代表左上角的坐标和右下角的坐标。例如[207,522,340,567],207代表的是左上角的横坐标,522代表左上角的纵坐标,340代表的是右下角的横坐标,567代表的是右下角的纵坐标。"
        },
        "qr_content": {
          "type": "string",
          "description": "图片中二维码指向的链接,当请求参数categories中包含image_text时存在。",
          "x-open-region-cloud": "hc"
        },
        "segments": {
          "items": {
            "$ref": "#/definitions/OCRTextDetail"
          },
          "description": "image_text场景下命中的文本片段。",
          "x-open-region-cloud": "hc",
          "type": "array"
        },
        "label": {
          "type": "string",
          "description": "识别的详细标签。"
        }
      },
      "description": "返回结果的详细内容。",
      "required": [
        "suggestion",
        "category",
        "confidence"
      ]
    },
    "ImageDetectionReq": {
      "description": "图像内容审核请求体",
      "properties": {
        "event_type": {
          "type": "string",
          "description": "事件类型。\n可选值如下:\nhead_image:头像\nalbum:相册\ndynamic:动态\narticle:帖子\ncomment:评论\nroom_cover:房间封面\ngroup_message:群聊图片\nmessage:私聊图片\nproduct:商品图片",
          "example": "comment"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "检测场景。可添加的检测场景如下:\n- terrorism:暴恐元素的检测。\n- porn:涉黄元素的检测。\n- image_text:广告图文的检测。\n- politics: 涉政人物的检测。\n- 可通过配置上述场景,来完对应场景元素的检测。\n> 每个检测场景的检测次数会分类统计。"
        },
        "image_text_config": {
          "$ref": "#/definitions/ImgTextConfig",
          "description": "图文审核黑白词库配置。",
          "x-open-region-cloud": "hc"
        },
        "url": {
          "type": "string",
          "description": "图片url, 与image二选一,目前支持:\n- 公网HTTP/HTTPS URL",
          "example": "http://xxxxxx.com/qweqeqeqzzxfdwef.jpg"
        },
        "image": {
          "type": "string",
          "description": "与url二选一,图片文件Base64编码字符串,要求base64编码后大小不超过10M,支持JPG/PNG/JPEG/WEBP/GIF/TIFF/TIF/HEIF等格式。",
          "example": ""
        },
        "biz_type": {
          "type": "string",
          "description": "自定义审核策略名称,可在控制台配置;如果请求参数中传了biz_type则优先使用biz_type,如果用户没传biz_type则event_type和categories必须传。",
          "example": "test_type",
          "x-open-region-cloud": "hc"
        },
        "language": {
          "type": "string",
          "description": "可指定图片中文字语种类型",
          "example": "zh",
          "enum": [
            "zh"
          ]
        }
      },
      "type": "object"
    },
    "ImageDetectionResponse": {
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "example": "58e7d9c7-3456-4ba1-80df-6f25506bc4df",
          "description": "本次请求的唯一标识,用于问题排查,建议保存。"
        },
        "result": {
          "description": "调用成功时表示调用结果。 调用失败时无此字段。",
          "$ref": "#/definitions/ImageDetectionResult"
        }
      },
      "type": "object",
      "required": [
        "request_id"
      ]
    },
    "FaceLocationDetail": {
      "properties": {
        "top_left_x": {
          "type": "integer",
          "format": "int32",
          "description": "检测出人脸的左上角横坐标。"
        },
        "top_left_y": {
          "type": "integer",
          "format": "int32",
          "description": "检测出人脸的左上角纵坐标。"
        },
        "bottom_right_x": {
          "type": "integer",
          "format": "int32",
          "description": "检测出人脸的右下角横坐标。"
        },
        "bottom_right_y": {
          "type": "integer",
          "format": "int32",
          "description": "检测出人脸的右下角纵坐标。"
        }
      },
      "type": "object"
    },
    "ImageDetectionResult": {
      "properties": {
        "suggestion": {
          "type": "string",
          "description": "审核结果是否通过。\n\nblock:包含敏感信息,不通过\n\npass:不包含敏感信息,通过\n\nreview:需要人工复检",
          "example": "block"
        },
        "category": {
          "type": "string",
          "description": "检测结果的一级标签。\n支持category列表如下:\nterrorism: 暴恐\nporn: 色情\nimage_text: 图文审核",
          "example": "porn"
        },
        "details": {
          "items": {
            "$ref": "#/definitions/ImageDetectionResultDetail"
          },
          "description": "检测详情",
          "type": "array"
        },
        "ocr_text": {
          "type": "string",
          "description": "图文审核检测出的文本,只有在category参数配置image_text且检测出文本时展示该字段。",
          "x-open-region-cloud": "hc"
        }
      },
      "type": "object"
    },
    "QRLocationDetail": {
      "properties": {
        "top_left_x": {
          "type": "integer",
          "format": "int32",
          "description": "检测出的二维码左上角横坐标。"
        },
        "top_left_y": {
          "type": "integer",
          "format": "int32",
          "description": "检测出的二维码左上角纵坐标。"
        },
        "bottom_right_x": {
          "type": "integer",
          "format": "int32",
          "description": "检测出的二维码右下角横坐标。"
        },
        "bottom_right_y": {
          "type": "integer",
          "format": "int32",
          "description": "检测出的二维码右下角纵坐标。"
        }
      },
      "type": "object"
    },
    "OCRTextDetail": {
      "properties": {
        "segment": {
          "type": "string",
          "description": "命中的风险片段"
        },
        "glossary_name": {
          "type": "string",
          "description": "命中的自定义词库名称。\n命中自定义词库时,才会返回当前字段。"
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "调用失败时的错误码,具体请参见错误码。\n\n调用成功时无此字段。",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "调用失败时的错误信息。\n\n调用成功时无此字段。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "moderation.cn-east-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
