  "definitions": {
    "Vpc": {
      "properties": {
        "id": {
          "type": "string",
          "description": "虚拟私有云的ID。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "name": {
          "type": "string",
          "description": "虚拟私有云名称\n\n取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)\n\n约束:同一个帐号下的名称不能重复"
        },
        "cidr": {
          "type": "string",
          "description": "虚拟私有云下可用子网的范围\n\n取值范围:\n10.0.0.0/8~24\n172.16.0.0/12~24\n192.168.0.0/16~24\n\n约束:必须是cidr格式,例如:192.168.0.0/16"
        },
        "mode": {
          "type": "string",
          "description": "虚拟私有云的模式。"
        },
        "subnet_num": {
          "type": "integer",
          "format": "int32",
          "description": "子网的数目。"
        }
      },
      "description": "虚拟私有云的数据对象。"
    },
    "CreateVpcRequestBody": {
      "required": [
        "vpc"
      ],
      "properties": {
        "vpc": {
          "description": "创建虚拟私有云的请求体。",
          "$ref": "#/definitions/CreateVpcOption"
        }
      },
      "description": ""
    },
    "VpcResponse": {
      "properties": {
        "vpc": {
          "description": "虚拟私有云。",
          "$ref": "#/definitions/Vpc"
        }
      },
      "description": ""
    },
    "CreateVpcOption": {
      "required": [
        "cidr",
        "mode",
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "虚拟私有云名称\n\n取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)\n\n约束:同一个帐号下的名称不能重复",
          "pattern": "^[a-zA-Z0-9_\\一-\\龥-.]{1,64}$"
        },
        "cidr": {
          "type": "string",
          "example": "192.168.0.0/16",
          "description": "虚拟私有云下可用子网的范围。\n\n约束:\nSYSTEM模式,cidr取值范围:10.0.0.0/8~10.255.0.0/16或者172.16.0.0/12 ~ 172.31.0.0/16或者192.168.0.0/16 。"
        },
        "mode": {
          "type": "string",
          "description": "虚拟私有云的模式,支持的取值范围如下:\n\nSYSTEM:该类型网络,系统会自动按照实际需要创建足够的子网。\nCUSTOMER:该类型网络,用户需要完全按照自己站点的需要,去申请足够的子网。"
        }
      },
      "description": "虚拟私有云的请求数据对象。"
    }
  },
  "version": "2.0",
