          "description": "弹性公网IP的地址。"
        },
        "private_ip_address": {
          "type": "string",
          "example": "192.168.0.212",
          "description": "绑定弹性公网IP的私有IP地址。"
        },
        "create_time": {
          "type": "string",
          "example": "2019-05-07 07:38:37",
          "description": "创建时间。"
        },
        "bandwidth_id": {
          "type": "string",
          "example": "2c3a040c-7b4e-41a1-8b77-26ea7fe61548",
          "description": "带宽的ID。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "bandwidth_name": {
          "type": "string",
          "example": "edgeCloud_chengdu_CMCC-bandwidth-98f7",
          "description": "带宽的名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "bandwidth_share_type": {
          "type": "string",
          "example": "PER",
          "description": "带宽的类型。"
        },
        "bandwidth_size": {
          "type": "integer",
          "format": "int32",
          "example": 5,
          "description": "带宽的大小。",
          "minimum": 300,
          "maximum": 2000
        },
        "ip_version": {
          "type": "integer",
          "format": "int32",
          "description": "IP版本的信息。"
        },
        "site_id": {
          "type": "string",
          "example": "e3b52316-05be-11ea-bc35-286ed488d287",
          "description": "子网所属的站点ID。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "site_info": {
          "type": "string",
          "example": "中国/华中地区/湖北/武汉市",
          "description": "子网所属的站点信息。"
