{
  "name": "CreateDeployment",
  "summary": "创建部署计划",
  "tags": "边缘业务",
  "productshort": "IEC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/deployments": {
      "post": {
        "tags": [
          "边缘业务"
        ],
        "summary": "创建部署计划",
        "description": "为方便您的统一管理,以及跨边缘站点管理资源,IEC基于业务场景角度,定义了边缘业务。\n边缘业务即为逻辑层面的一套资源管理集合。这里的资源主要是指计算实例,包含实例规格、镜像、硬盘、网络等方面。通过指定计算实例的数量、调度策略以及区域分布等形成一套管理集合。[了解更多](https://support.huaweicloud.com/usermanual-iec/iec_02_0301.html)\n\n创建一个部署计划并执行,即可创建一个边缘业务。\n\n- 边缘业务下实例分布取决于部署计划的实例分布与调度策略。\n- 边缘业务下实例名称、规格、镜像等参数取决于部署计划配置计算实例字段。",
        "operationId": "CreateDeployment",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-order": 1
          },
          {
            "in": "body",
            "name": "CreateDeploymentRequestBody",
            "description": "待部署的边缘业务信息。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateDeploymentRequestBody"
            },
            "x-order": 2
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "id": "87b9a88c-499d-11eb-8a8a-fa1640495574",
                "locations": [
                  {
                    "site_id": "74a75ed3-cfb9-11ea-a0c3-fa1640495574",
                    "area": "north",
                    "province": "shaanxi",
                    "city": "xi'an",
                    "operator": "bgp",
                    "pool_id": "5_bgp_edgecloud-site4_0",
                    "stack_count": 1,
                    "city_short_name": ""
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateDeploymentResponseBody"
            }
          }
        },
        "deprecated": false,
        "x-name": "创建部署计划",
        "x-constraint": "",
        "x-version": "v1",
        "x-scope": "Commercial",
        "x-order": 1,
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/deployments",
        "x-request-examples-1": {
          "edgecloud": {
            "stack": {
              "name": "stack-fo09",
              "resources": [
                {
                  "name": "edgeinstance1",
                  "image_ref": "00000000-0000-0000-0000-000000000002",
                  "flavor_ref": "c6.large.2",
                  "net_config": {
                    "vpc_id": "4a6d9663-475f-11eb-aa7c-fa16406a65c4",
                    "nic_num": 1
                  },
                  "count": 1,
                  "root_volume": {
                    "volume_type": "SATA",
                    "size": 100
                  },
                  "security_groups": [
                    {
                      "id": "153133f5-2b16-11eb-a594-fa16408859a1"
                    }
                  ],
                  "user_data": "IyEvYmluL2Jhc2gKZWNobyAncm9vdDokNiQzOEVORTckaTJ6Li9ibzZMUGlUT3VFVE5KbmxNdC9yMmJSNlhyOC81S3BndWtNU0xhLmhiVlFJNkY3T25sUS5ucVM0SXpmVEhSU0ZHN3lBeHBiakxlNkUwYjE1YjEnIHwgY2hwYXNzd2QgLWU7"
                }
              ]
            },
            "coverage": {
              "coverage_level": "city",
              "coverage_policy": "centralize",
              "coverage_sites": [
                {
                  "site": "xi'an",
                  "demands": [
                    {
                      "demand_count": 1
                    }
                  ]
                }
              ]
            },
            "name": "edgecloud1"
          }
        },
        "x-request-examples-text-1": "",
        "x-publishpath": "",
        "x-hybridcloud": "false",
        "x-source": "",
        "x-first-open-time": "",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc",
        "x-apiexplorer-hide": "",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "CreateDeploymentRequestBody": {
      "required": [
        "edgecloud"
      ],
      "properties": {
        "edgecloud": {
          "description": "待部署的边缘业务。",
          "$ref": "#/definitions/EdgeCloudOption"
        }
      },
      "description": "创建部署计划请求体"
    },
    "DataVolume": {
      "required": [
        "size",
        "volume_type"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "format": "int32",
          "example": 100,
          "description": "数据盘大小,容量单位为GB,输入大小范围为[1,500]。",
          "minimum": 1,
          "maximum": 500
        },
        "volume_type": {
          "type": "string",
          "example": "SATA",
          "description": "边缘实例数据盘对应的磁盘类型,需要与站点所提供的磁盘类型相匹配。"
        }
      },
      "description": "数据盘参数"
    },
    "CoverageSite": {
      "required": [
        "demands",
        "site"
      ],
      "properties": {
        "site": {
          "type": "string",
          "example": "wuhan",
          "description": "站点名称。\n具体信息可通过调用“查询边缘站点列表”来查询(注意:本字段区分大小写)。"
        },
        "demands": {
          "type": "array",
          "example": "[{\"operator\":\"chinamobile\",\"demand_count\":1}]",
          "description": "租户需求数量列表。表示租户发放资源站点的运营商和发放的资源组的数量。",
          "items": {
            "description": "",
            "$ref": "#/definitions/Demand"
          }
        }
      },
      "description": "站点覆盖策略"
    },
    "NetConfig": {
      "required": [
        "nic_num",
        "vpc_id"
      ],
      "properties": {
        "vpc_id": {
          "type": "string",
          "example": "d0272146-f6d8-4e3c-a1dc-196ec4a2f848",
          "description": "边缘网络ID。\n\n约束:\n- 创建边缘业务仅支持使用系统规划的虚拟私有云。"
        },
        "nic_num": {
          "type": "integer",
          "format": "int32",
          "example": 2,
          "description": "边缘实例绑定的网卡数量。\n\n约束:一台边缘实例最少绑定一张网卡,最多绑定8张网卡。",
          "minimum": 1,
          "maximum": 8
        },
        "allowed_address_pairs": {
          "type": "array",
          "description": "- 功能说明:IP/Mac对列表\n- 约束:\n    IP地址不允许为 “0.0.0.0/0”\n    如果allowed_address_pairs配置地址池较大的CIDR(掩码小于24位),建议为该port配置一个单独的安全组。\n    如果allowed_address_pairs为“1.1.1.1/0”,表示关闭源目地址检查开关",
          "items": {
            "description": "",
            "$ref": "#/definitions/AllowedAddressPair"
          }
        }
      },
      "description": ""
    },
    "AllowedAddressPair": {
      "required": [
        "ip_address"
      ],
      "properties": {
        "ip_address": {
          "type": "string",
          "description": "- 功能说明:IP地址\n- 约束:\n    IP地址不支持“0.0.0.0/0”\n    如果allowed_address_pairs配置地址池较大的CIDR(掩码小于24位),建议为该port配置一个单独的安全组。\n    如果allowed_address_pairs的IP地址为“1.1.1.1/0”,表示关闭源目地址检查开关。"
        },
        "mac_address": {
          "type": "string",
          "description": "MAC地址"
        }
      },
      "description": "IP/Mac对象"
    },
    "EdgeCloudOption": {
      "required": [
        "coverage",
        "stack"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "edgecloud1",
          "description": "边缘业务名称。\n取值范围:只能由中文字符、大小写英文字母、数字及中划线、下划线组成,且长度为[1-32]个字符。",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_.\\一-\\龥-]*$"
        },
        "id": {
          "type": "string",
          "description": "已有边缘业务ID,该参数用于扩容边缘业务场景。\n>-  id与name不可同时为空,同时有值时部署计划无效;\n- 通过id扩容场景要求区域分布层级与原边缘业务一致;\n- 区域分布层级为站点级的边缘业务不支持扩容。"
        },
        "description": {
          "type": "string",
          "example": "this is an edgecloud",
          "description": "描述,缺省值为空字符串。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^[^<>]*$"
        },
        "coverage": {
          "description": "边缘业务实例分布策略。",
          "$ref": "#/definitions/Coverage"
        },
        "stack": {
          "example": "{\"name\":\"stack1\",\"resources\":[{\"name\":\"ecs01\",\"image_ref\":\"d0272146-f6d8-4e3c-a1dc-196ec4a2f848\",\"flavor_ref\":\"6\",\"net_config\":{\"vpc_id\":\"d0272146-f6d8-4e3c-a1dc-196ec4a2f848\",\"subnets\":[{\"id\":\"d0272146-f6d8-4e3c-a1dc-196ec4a2f848\"}],\"nic_num\":2},\"bandwidth\":{\"sharetype\":\"WHOLE\"},\"root_volume\":{\"volume_type\":\"SAS\",\"size\":40},\"data_volumes\":[{\"volume_type\":\"SATA\",\"size\":100}],\"count\":1,\"security_groups\":[{\"id\":\"d0272146-f6d8-4e3c-a1dc-196ec4a2f848\"}],\"edge_scenes\":\"LIVE_ACCELERATION\",\"user_data\":\"IyEvYmluL2Jhc2gKZWNobyAnc...\"}]}",
          "description": "边缘业务资源组配置模板,边缘业务中的计算实例将根据该参数信息创建。",
          "$ref": "#/definitions/Stack"
        }
      },
      "description": "边缘业务对象"
    },
    "RootVolume": {
      "required": [
        "size",
        "volume_type"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "format": "int32",
          "example": 40,
          "description": "系统盘大小,容量单位为GB,输入大小范围为[40,100]。",
          "minimum": 40,
          "maximum": 100
        },
        "volume_type": {
          "type": "string",
          "example": "SAS",
          "description": "边缘实例系统盘对应的磁盘类型,需要与站点所提供的磁盘类型相匹配。"
        }
      },
      "description": "系统盘参数"
    },
    "Resource": {
      "required": [
        "flavor_ref",
        "image_ref",
        "name",
        "net_config",
        "root_volume"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "ecs01",
          "description": "边缘实例名称。\n取值范围: 只能由中文字符、英文字母 (大小写)、数字及“_”、“-”、“.” 组成。 创建的边缘实例数量(count字段对应的值)大于1时,为区分不同边缘实例,创建过程中系统会自动在名称后加“-000x”的类似标记。 \n>  华为云边缘实例内部主机名 (hostname)命名规则遵循RFC 952和RFC 1123命名规范,建议使用a-zA-z或0-9以及中划线'-'组成的名称命名,' _' 将在边缘实例内部默认转化为'-'。",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_.\\一-\\龥-]*$"
        },
        "with_prefix": {
          "type": "boolean",
          "description": "是否自动添加名称前缀。\n- with_prefix为false时不拼接IEC前缀\n- with_prefix不传或者传true时拼自动IEC前缀\n\n以name为iec为例:\n不添加前缀时实例名称为:iec-0001\n自动添加前缀实例名称为:IEC-ZS01-iec-0001\n0001为创建边缘业务时根据实例个数自动添加的编号",
          "default": true,
          "x-admin": "False",
          "x-internal": "False"
        },
        "image_ref": {
          "type": "string",
          "example": "d0272146-f6d8-4e3c-a1dc-196ec4a2f848",
          "description": "待发放边缘实例的系统镜像,需要指定已创建镜像的ID。\n> 镜像的ID可以从控制台或者参考本文档的“查询边镜像列表”的章节获取。"
        },
        "flavor_ref": {
          "type": "string",
          "description": "边缘实例的系统规格的ID。"
        },
        "admin_pass": {
          "type": "string",
          "description": "如果需要使用密码方式登录边缘实例,可使用admin_pass字段指定边缘实例管理员帐户初始登录密码。其中,Linux管理员帐户为root,Windows管理员帐户为Administrator。\n\n密码复杂度要求:\n- 长度为8-26位。\n- 密码至少必须包含大写字母、小写字母、数字和特殊字符(!@$%^-_=+[{}]:,./?)中的三种。\n- 密码不能包含用户名或用户名的逆序。\n- Windows系统密码不能包含用户名或用户名的逆序,不能包含用户名中超过两个连续字符的部分。\n\n>   目前边缘实例不支持创建后设置密码,不设置此参数会导致实例无法登录。",
          "minLength": 8,
          "maxLength": 26
        },
        "key_name": {
          "type": "string",
          "example": "test-pk1",
          "description": "密钥对名称。"
        },
        "net_config": {
          "description": "实例的边缘网络配置。\n包含了边缘网络的网段信息和子网数目信息。",
          "$ref": "#/definitions/NetConfig"
        },
        "bandwidth": {
          "description": "实例的带宽参数。\nIEC服务现在提供共享带宽服务,暂不支持其他类型带宽。\n> 创建边缘业务时指定实例同步创建EIP则需通过此参数指定。",
          "$ref": "#/definitions/BandwidthConfig"
        },
        "root_volume": {
          "description": "边缘实例对应系统盘相关配置。",
          "$ref": "#/definitions/RootVolume"
        },
        "data_volumes": {
          "type": "array",
          "description": "边缘实例对应数据盘相关配置。每一个数据结构代表一块待创建的数据盘。\n\n约束:目前边缘实例最多可挂载2块数据盘",
          "items": {
            "description": "",
            "$ref": "#/definitions/DataVolume"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "边缘实例数量。\n不传该字段时默认取值为1。"
        },
        "security_groups": {
          "type": "array",
          "description": "边缘业务对应安全组信息。",
          "items": {
            "description": "",
            "$ref": "#/definitions/SecurityGroupOption"
          }
        },
        "user_data": {
          "type": "string",
          "example": "IyEvYmluL2Jhc2gKZWNobyAnc...",
          "description": "创建边缘实例过程中注入用户数据。支持注入文本、文本文件或gzip文件。\n更多关于待注入用户数据的信息,请参见《弹性云服务器用户指南 》的“[用户数据注入](https://support.huaweicloud.com/usermanual-ecs/zh-cn_topic_0032380449.html)”章节。"
        }
      },
      "description": "边缘资源对象"
    },
    "CreateDeploymentResponseBody": {
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "部署计划ID。"
        },
        "locations": {
          "type": "array",
          "description": "部署位置信息列表。",
          "items": {
            "description": "",
            "$ref": "#/definitions/Location"
          }
        }
      },
      "description": "创建部署计划响应体。"
    },
    "Demand": {
      "required": [
        "demand_count"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "example": "chinamobile",
          "description": "所属运营商。"
        },
        "demand_count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "站点需要发放的资源(组)总数。 \n> 实际发放实例数量为count*demand_count。",
          "minimum": 1,
          "maximum": 10
        },
        "pool_id": {
          "type": "string",
          "description": "线路ID。\n多线路场景下,将在该线路下创建弹性公网IP。\n> 覆盖规则为省级/大区时不支持指定线路ID创建边缘业务。"
        },
        "bandwidth_type": {
          "type": "string",
          "description": "带宽类型。 如果当前带宽类型下没有带宽,自动在该带宽类型下创建带宽"
        },
        "pool_id_v6": {
          "type": "string",
          "description": "指定IPv6线路,使用该线路下的子网分配IPv6端口。\n如果该线路下没有关联启用IPv6的子网,则创建新的子网。"
        },
        "ipv6_bandwidth_enable": {
          "type": "boolean",
          "description": "使用IPv6带宽。\n边缘实例是否开启IPv6公网访问能力。如果该IPv6线路没有可用的带宽,则创建新的带宽。"
        },
        "ipv6_bandwidth_type": {
          "type": "string",
          "description": "带宽类型。 \n边缘实例开启IPv6访问公网能力后,如果当前带宽类型下没有带宽,自动在该带宽类型下创建带宽"
        }
      },
      "description": "租户需求"
    },
    "Stack": {
      "required": [
        "name",
        "resources"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "stack1",
          "description": "边缘资源组名称。\n取值范围:只能由中文字符、大小写英文字母、数字及中划线、下划线组成,且长度为[1-48]个字符。",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_.\\一-\\龥-]*$"
        },
        "resources": {
          "type": "array",
          "example": "[{\"name\":\"ecs01\",\"image_ref\":\"d0272146-f6d8-4e3c-a1dc-196ec4a2f848\",\"flavor_ref\":\"6\",\"net_config\":{\"vpc_id\":\"d0272146-f6d8-4e3c-a1dc-196ec4a2f848\",\"subnets\":[{\"id\":\"d0272146-f6d8-4e3c-a1dc-196ec4a2f848\"}],\"nic_num\":2},\"bandwidth\":{\"sharetype\":\"WHOLE\"},\"root_volume\":{\"volume_type\":\"SAS\",\"size\":40},\"data_volumes\":[{\"volume_type\":\"SATA\",\"size\":100}],\"count\":1,\"security_groups\":[{\"id\":\"d0272146-f6d8-4e3c-a1dc-196ec4a2f848\"}],\"edge_scenes\":\"LIVE_ACCELERATION\",\"user_data\":\"IyEvYmluL2Jhc2gKZWNobyAnc...\"}]",
          "description": "边缘业务的堆栈,即为资源组。",
          "items": {
            "description": "",
            "$ref": "#/definitions/Resource"
          }
        }
      },
      "description": "边缘资源组对象"
    },
    "Location": {
      "properties": {
        "site_id": {
          "type": "string",
          "description": "站点ID。"
        },
        "area": {
          "type": "string",
          "example": "north-east",
          "description": "所在大区。"
        },
        "province": {
          "type": "string",
          "example": "heilongjiang",
          "description": "所属省份英文名称。\n大小写通用,皆支持"
        },
        "city": {
          "type": "string",
          "example": "wuhan",
          "description": "所在城市英文名称。"
        },
        "operator": {
          "type": "string",
          "description": "所属运营商。",
          "enum": [
            "chinamobile",
            "chinaunicom",
            "chinatelecom"
          ]
        },
        "pool_id": {
          "type": "string",
          "description": "线路ID。多线路场景下,创建的弹性公网IP在该线路下。"
        },
        "stack_count": {
          "type": "integer",
          "format": "int32",
          "example": 4,
          "description": "站点需要发放的资源(组)总数。"
        },
        "city_short_name": {
          "type": "string",
          "description": "城市简称。"
        },
        "ipv6_enable": {
          "type": "boolean",
