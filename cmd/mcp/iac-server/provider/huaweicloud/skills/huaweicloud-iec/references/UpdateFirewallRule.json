  "definitions": {
    "UpdateFirewallRuleResp": {
      "required": [
        "egress_firewall_policy",
        "id",
        "ingress_firewall_policy",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "example": "c2c5234b-67ff-11ea-a41a-00e04c9bd2a3",
          "description": "网络ACL ID",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "status": {
          "type": "string",
          "example": "INACTIVE",
          "description": "网络ACL状态。",
          "enum": [
            "INACTIVE"
          ]
        },
        "egress_firewall_policy": {
          "description": "出方向网络ACL策略返回体,当该返回体有值时,则ingress_firewall_policy为{}",
          "$ref": "#/definitions/FirewallPolicy"
        },
        "ingress_firewall_policy": {
          "description": "入方向网络ACL策略返回体,当该返回体有值时,则egress_firewall_policy为{}",
          "$ref": "#/definitions/FirewallPolicy"
        }
      },
      "description": ""
    },
    "FirewallRule": {
      "required": [
        "action",
        "destination_ip_address",
        "destination_port",
        "enabled",
        "id",
        "ip_version",
        "name",
        "operate_type",
        "protocol",
        "source_ip_address",
        "source_port"
      ],
      "properties": {
        "action": {
          "type": "string",
          "example": "allow",
          "description": "策略是否允许\n\n取值范围:allow,deny,reject",
          "enum": [
            "allow",
            "deny",
            "reject"
          ]
        },
        "description": {
          "type": "string",
          "example": "testt",
          "description": "网络ACL规则描述。",
          "minLength": 0,
          "maxLength": 64
        },
        "destination_ip_address": {
          "type": "string",
          "example": "0.0.0.0/12",
          "description": "目的地IP地址,IPv4或IPv6的CIDR格式"
        },
        "destination_port": {
          "type": "string",
          "description": "目的地端口范围\n\n取值范围:整数,比如80,或者以\"-\"隔开的范围,比如80-90"
        },
        "enabled": {
          "type": "boolean",
          "description": "网络ACL规则使能开关。\n\n取值范围:true,false",
          "default": true
        },
        "id": {
          "type": "string",
          "example": "5cb41787-6804-11ea-a41a-00e04c9bd2a3",
          "description": "网络ACL规则ID。\n\n进行更新规则时,如果operate_type为add,则该值为空。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "ip_version": {
          "type": "integer",
          "format": "int32",
          "example": 4,
          "description": "IP协议版本\n\n取值范围:4、6"
        },
        "name": {
          "type": "string",
          "example": "testt",
          "description": "网络ACL规则名称。",
          "minLength": 0,
          "maxLength": 64
        },
        "operate_type": {
          "type": "string",
          "example": "normal",
          "description": "网络ACL规则操作状态,作为请求时取值为\"add\"/\"modify\"/\"delete\",作为返回值时为\"normal\"。\n当请求更新规则时,本参数值为delete时,除id之外,本请求体其他参数均可为空。",
          "enum": [
            "add",
            "modify",
            "delete"
          ]
        },
        "protocol": {
          "type": "string",
          "example": "tcp",
          "description": "IP协议,为any时代表所有协议\n\n取值范围:icmp,tcp,udp,any",
          "enum": [
            "icmp",
            "tcp",
            "udp",
            "any "
          ]
        },
        "source_ip_address": {
          "type": "string",
          "example": "0.0.0.0/24",
          "description": "源IP地址,IPv4或IPv6的CIDR格式"
        },
        "source_port": {
          "type": "string",
          "description": "源地端口范围\n\n取值范围:整数,比如80,或者以\"-\"隔开的范围,比如80-90"
        }
      },
      "description": "网络ACL规则。"
    },
    "FirewallPolicy": {
      "required": [
        "firewall_rules",
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "网络ACL策略ID。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "name": {
          "type": "string",
          "description": "网络ACL策略名称。",
          "minLength": 0,
          "maxLength": 64
        },
        "firewall_rules": {
          "type": "array",
          "description": "网络ACL规则列表对象。",
          "items": {
            "description": "",
            "$ref": "#/definitions/FirewallRule"
          },
          "maxItems": 1,
          "minItems": 0
        },
        "insert_after": {
          "type": "string",
          "description": "ACL规则ID,表示在此ACL规则之后添加ACL规则",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "insert_before": {
          "type": "string",
          "description": "ACL规则ID,表示在此ACL规则之前添加ACL规则",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        }
      },
      "description": "网络ACL策略。"
    },
    "UpdateFirewallRuleRequestBody": {
      "properties": {
        "firewall": {
          "description": "防火墙",
          "$ref": "#/definitions/UpdateFirewallRuleOption"
        }
      },
      "description": "更新防火墙规则请求体"
    },
    "UpdateFirewallRuleResponseBody": {
      "required": [
        "firewall"
      ],
      "properties": {
        "firewall": {
          "description": "更新网络ACL返回体,当更新操作为delete时,返回体中的policy策略中不再包含任何firewall_rule,只包含策略ID。",
          "$ref": "#/definitions/UpdateFirewallRuleResp"
        }
      },
      "description": "更新网络ACL规则返回体。"
    },
    "UpdateFirewallRuleOption": {
      "required": [
        "egress_firewall_policy",
        "ingress_firewall_policy"
      ],
      "properties": {
        "egress_firewall_policy": {
          "description": "出方向防火墙策略,不能与ingress_firewall_policy同时存在",
          "$ref": "#/definitions/FirewallPolicy"
        },
        "ingress_firewall_policy": {
          "description": "入方向防火墙策略,不能与egress_firewall_policy同时存在",
          "$ref": "#/definitions/FirewallPolicy"
        }
      },
      "description": "更新防火墙规则的参数"
    }
  },
