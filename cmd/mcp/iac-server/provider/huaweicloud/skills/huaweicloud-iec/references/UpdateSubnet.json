  "definitions": {
    "UpdateSubnetRequestBody": {
      "properties": {
        "subnet": {
          "description": "更新子网的结构体。",
          "$ref": "#/definitions/UpdateSubnetOption"
        }
      },
      "description": "更新子网的请求体。"
    },
    "UpdateSubnetResponseBody": {
      "properties": {
        "subnet": {
          "description": "子网对象",
          "$ref": "#/definitions/UpdateSubnetResponseObject"
        }
      },
      "description": "更新子网响应体"
    },
    "UpdateSubnetOption": {
      "properties": {
        "name": {
          "type": "string",
          "description": "子网名称\n\n取值范围:0-64,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)"
        },
        "dhcp_enable": {
          "type": "boolean",
          "example": true,
          "description": "子网是否开启dhcp功能\n\n取值范围:true(开启),false(关闭)\n\n约束:不填时默认为true。当设置为false时,会导致新创建的实例无法获取IP地址,cloudinit无法注入帐号密码,请谨慎操作。"
        },
        "primary_dns": {
          "type": "string",
          "example": "4.4.4.4",
          "description": "子网dns服务器地址1\n\n约束:ip格式"
        },
        "secondary_dns": {
          "type": "string",
          "example": " 4.4.4.4",
          "description": "子网dns服务器地址2\n\n约束:ip格式"
        },
        "dnsList": {
          "type": "array",
          "description": "子网dns服务器地址的集合;如果想使用两个以上dns服务器,请使用该字段。\n\n约束:是子网dns服务器地址1跟子网dns服务器地址2的合集的父集",
          "items": {
            "type": "string",
            "description": ""
          },
          "minItems": 0
        },
        "ipv6_enable": {
          "type": "boolean",
          "description": "是否创建IPv6子网\n\n取值范围:\n - true:开启\n - false:关闭\n\n约束:\n  1、若该字段为true,则pool_id字段必填;若该字段为false,则pool_id字段不生效。\n  2、子网开启IPv6后不支持关闭。"
        },
        "pool_id": {
          "type": "string",
          "description": "IPv6线路ID。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        }
      },
      "description": "更新子网的结构体。"
    },
    "UpdateSubnetResponseObject": {
      "properties": {
        "id": {
          "type": "string",
          "description": "子网ID",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "status": {
          "type": "string",
          "description": "子网的状态\n\n取值范围:\n- ACTIVE:表示子网已挂载到ROUTER上\n- UNKNOWN:表示子网还未挂载到ROUTER上\n- ERROR:表示子网状态故障",
          "enum": [
            "ACTIVE",
            "UNKNOWN",
            "ERROR  "
          ]
        },
        "ipv6_enable": {
          "type": "boolean",
          "description": "是否开启IPv6"
        },
        "neutron_subnet_id_v6": {
          "type": "string",
          "description": "对应IPv6子网(OpenStack Neutron接口)id,如果子网为IPv4子网,则不返回此参数。"
        }
      },
      "description": "更新子网响应对象"
    }
