  "definitions": {
    "FirewallRule": {
      "required": [
        "action",
        "destination_ip_address",
        "destination_port",
        "enabled",
        "id",
        "ip_version",
        "name",
        "operate_type",
        "protocol",
        "source_ip_address",
        "source_port"
      ],
      "properties": {
        "action": {
          "type": "string",
          "example": "allow",
          "description": "策略是否允许\n\n取值范围:allow,deny,reject",
          "enum": [
            "allow",
            "deny",
            "reject"
          ]
        },
        "description": {
          "type": "string",
          "example": "testt",
          "description": "网络ACL规则描述。",
          "minLength": 0,
          "maxLength": 64
        },
        "destination_ip_address": {
          "type": "string",
          "example": "0.0.0.0/12",
          "description": "目的地IP地址,IPv4或IPv6的CIDR格式"
        },
        "destination_port": {
          "type": "string",
          "description": "目的地端口范围\n\n取值范围:整数,比如80,或者以\"-\"隔开的范围,比如80-90"
        },
        "enabled": {
          "type": "boolean",
          "description": "网络ACL规则使能开关。\n\n取值范围:true,false",
          "default": true
        },
        "id": {
          "type": "string",
          "example": "5cb41787-6804-11ea-a41a-00e04c9bd2a3",
          "description": "网络ACL规则ID。\n\n进行更新规则时,如果operate_type为add,则该值为空。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "ip_version": {
          "type": "integer",
          "format": "int32",
          "example": 4,
          "description": "IP协议版本\n\n取值范围:4、6"
        },
        "name": {
          "type": "string",
          "example": "testt",
          "description": "网络ACL规则名称。",
          "minLength": 0,
          "maxLength": 64
        },
        "operate_type": {
          "type": "string",
          "example": "normal",
          "description": "网络ACL规则操作状态,作为请求时取值为\"add\"/\"modify\"/\"delete\",作为返回值时为\"normal\"。\n当请求更新规则时,本参数值为delete时,除id之外,本请求体其他参数均可为空。",
          "enum": [
            "add",
            "modify",
            "delete"
          ]
        },
        "protocol": {
          "type": "string",
          "example": "tcp",
          "description": "IP协议,为any时代表所有协议\n\n取值范围:icmp,tcp,udp,any",
          "enum": [
            "icmp",
            "tcp",
            "udp",
            "any "
          ]
        },
        "source_ip_address": {
          "type": "string",
          "example": "0.0.0.0/24",
          "description": "源IP地址,IPv4或IPv6的CIDR格式"
        },
        "source_port": {
          "type": "string",
          "description": "源地端口范围\n\n取值范围:整数,比如80,或者以\"-\"隔开的范围,比如80-90"
        }
      },
      "description": "网络ACL规则。"
    },
    "Firewall": {
      "properties": {
        "id": {
          "type": "string",
          "example": "abbd0eb8-6821-11ea-bf82-00e04c9bd2a3",
          "description": "网络ACL ID",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "name": {
          "type": "string",
          "example": "ceshichuangjian234-asfsdfg",
          "description": "网络ACL名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "admin_state_up": {
          "type": "boolean",
          "description": "网络ACL使能开关。\n\n取值范围:true(开启),false(关闭)。默认为true",
          "default": true
        },
        "status": {
          "type": "string",
          "example": "INACTIVE",
          "description": "网络ACL状态。\n\n取值范围:INACTIVE",
          "enum": [
            "INACTIVE"
          ]
        },
        "description": {
          "type": "string",
          "example": "vvvvvvvvvvvvvvvvv",
          "description": "网络ACL描述。",
          "minLength": 0,
          "maxLength": 64
        },
        "domain_id": {
          "type": "string",
          "example": "2b76febbe5d34eac85d26435c1f15809",
          "description": "租户domainID",
          "minLength": 0,
          "maxLength": 36
        },
        "egress_firewall_policy": {
          "description": "出方向网络ACL策略。\n创建或查询防火墙列表时只返回ACL策略ID。",
          "$ref": "#/definitions/FirewallPolicy"
        },
        "egress_firewall_rule_count": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "出方向网络ACL规则个数。"
        },
        "ingress_firewall_policy": {
          "description": "入方向网络ACL策略。\n创建或查询防火墙列表时只返回ACL策略ID。",
          "$ref": "#/definitions/FirewallPolicy"
        },
        "ingress_firewall_rule_count": {
          "type": "integer",
          "format": "int32",
          "description": "入方向网络ACL规则个数。"
        }
      },
      "description": "防火墙对象"
    },
    "FirewallResponseBody": {
      "required": [
        "firewall"
      ],
      "properties": {
        "firewall": {
          "description": "网络ACL对象。",
          "$ref": "#/definitions/Firewall"
        }
      },
      "description": "网络ACL。"
    },
    "FirewallPolicy": {
      "required": [
        "firewall_rules",
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "网络ACL策略ID。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "name": {
          "type": "string",
          "description": "网络ACL策略名称。",
          "minLength": 0,
          "maxLength": 64
        },
        "firewall_rules": {
          "type": "array",
          "description": "网络ACL规则列表对象。",
          "items": {
            "description": "",
            "$ref": "#/definitions/FirewallRule"
          },
          "maxItems": 1,
          "minItems": 0
        },
        "insert_after": {
          "type": "string",
          "description": "ACL规则ID,表示在此ACL规则之后添加ACL规则",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "insert_before": {
          "type": "string",
          "description": "ACL规则ID,表示在此ACL规则之前添加ACL规则",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        }
      },
      "description": "网络ACL策略。"
    }
  },
