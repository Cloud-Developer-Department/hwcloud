  "definitions": {
    "Routetable": {
      "properties": {
        "id": {
          "type": "string",
          "description": "路由表ID\n\n取值范围:标准UUID",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "name": {
          "type": "string",
          "description": "路由表名称\n\n取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)",
          "pattern": "^[a-zA-Z0-9_\\一-\\龥-.]{1,64}$"
        },
        "subnets": {
          "type": "array",
          "description": "路由表所关联的子网\n\n约束:只能关联路由表所属VPC下的子网",
          "items": {
            "description": "",
            "$ref": "#/definitions/BaseId"
          }
        },
        "vpc_id": {
          "type": "string",
          "description": "路由表所在的虚拟私有云ID",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "domain_id": {
          "type": "string",
          "description": "帐号ID",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "description": {
          "type": "string",
          "description": "路由表描述信息\n\n取值范围:0-255个字符,不能包含“<”和“>”"
        },
        "default": {
          "type": "boolean",
          "description": "是否为默认路由表\n\n取值范围:true表示默认路由表;false表示自定义路由表"
        }
      },
      "description": "路由表详情"
    },
    "BaseId": {
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "对象ID,uuid。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        }
      },
      "description": "ID对象"
    },
    "RoutetableResponseBody": {
      "properties": {
