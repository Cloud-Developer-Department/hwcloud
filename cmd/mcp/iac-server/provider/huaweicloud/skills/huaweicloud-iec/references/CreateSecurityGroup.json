  "definitions": {
    "CreateSecurityGroupRequestBody": {
      "required": [
        "security_group"
      ],
      "properties": {
        "security_group": {
          "description": "创建安全组参数。",
          "$ref": "#/definitions/CreateSecurityGroupOption"
        }
      },
      "description": "创建安全组请求体。"
    },
    "CreateSecurityGroupOption": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "sg002",
          "description": "安全组的名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "description": "安全组的描述。非必填项,默认值为空。",
          "minLength": 0,
          "maxLength": 64
        }
      },
      "description": "创建安全组参数。"
    },
    "SecurityGroupRule": {
      "properties": {
        "id": {
          "type": "string",
          "example": "99d9d709-8478-4b46-9f3f-2206b1023fd3",
          "description": "安全组规则的ID。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "description": {
          "type": "string",
          "example": "for test",
          "description": "安全组规则描述信息。",
          "minLength": 0,
          "maxLength": 64
        },
        "security_group_id": {
          "type": "string",
          "description": "安全组ID。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "direction": {
          "type": "string",
          "example": "egress",
          "description": "出入控制方向。\n\n取值范围:\n - egress:出方向\n - ingress:入方向",
          "enum": [
            "ingress",
            "egress"
          ]
        },
        "ethertype": {
          "type": "string",
          "example": "IPv4",
          "description": "IP协议类型。\n\n取值范围:IPv4,IPv6\n\n约束:不填默认值为IPv4",
          "enum": [
            "IPv4"
          ]
        },
        "protocol": {
          "type": "string",
          "example": "TCP",
          "description": "协议类型。\n\n取值范围:icmp、tcp、udp、icmpv6等\n\n约束:为空表示支持所有协议"
        },
        "port_range_min": {
          "type": "string",
          "description": "起始端口值。\n\n取值范围:1~65535\n\n约束:取值不能大于port_range_max的值,为空表示所有端口"
        },
        "port_range_max": {
          "type": "string",
          "description": "结束端口值。\n\n取值范围:1~65535\n\n约束:取值不能小于port_range_min的值,为空表示所有端口。"
        },
        "remote_group_id": {
          "type": "string",
          "description": "对端安全组ID。\n\n约束:和remote_ip_prefix互斥 ,remote_group_id与remote_ip_prefix必须存在一个",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "remote_ip_prefix": {
          "type": "string",
          "description": "远端IP地址,当direction是egress时为虚拟机访问端的地址,当direction是ingress时为访问虚拟机的地址。\n\n取值范围:IP地址,或者cidr格式\n\n约束:和remote_group_id互斥"
        },
        "action": {
          "type": "string",
          "description": "安全组规则生效策略 \n取值范围:allow 允许,deny 拒绝 \n约束:默认值为allow",
          "default": "allow",
          "x-admin": "False"
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "description": "规则在安全组中的优先级\n取值范围:1~100,1代表最高优先级\n 约束:默认值为1",
          "x-admin": "False"
        }
      },
      "description": "安全组规则。"
    },
    "SecurityGroup": {
      "properties": {
        "id": {
          "type": "string",
          "example": "99d9d709-8478-4b46-9f3f-2206b1023fd3",
          "description": "安全组的ID。UUID",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "name": {
          "type": "string",
          "example": "sg002",
          "description": "安全组的名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "description": "安全组的描述。",
          "minLength": 0,
          "maxLength": 64
        },
        "security_group_rules": {
          "type": "array",
          "description": "安全组规则列表。",
          "items": {
            "description": "",
            "$ref": "#/definitions/SecurityGroupRule"
          },
          "minItems": 0
        }
      },
      "description": "安全组数据对象"
    },
