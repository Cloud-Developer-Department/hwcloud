  "definitions": {
    "ListSubnetsResponseBody": {
      "properties": {
        "subnets": {
          "type": "array",
          "description": "子网数组。",
          "items": {
            "description": "",
            "$ref": "#/definitions/Subnet"
          },
          "minItems": 0
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "子网数目。"
        }
      },
      "description": "查询返回的子网列表。"
    },
    "Subnet": {
      "properties": {
        "id": {
          "type": "string",
          "example": "99d9d709-8478-4b46-9f3f-2206b1023fd3",
          "description": "子网的ID。"
        },
        "name": {
          "type": "string",
          "description": "子网名称\n\n取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)",
          "pattern": "^[a-zA-Z0-9_\\一-\\龥-.]{1,64}$"
        },
        "cidr": {
          "type": "string",
          "description": "子网的网段\n\n取值范围:必须在vpc对应cidr范围内\n\n约束:必须是cidr格式。掩码长度不能大于28"
        },
        "dnsList": {
          "type": "array",
          "description": "子网dns服务器地址列表",
          "items": {
            "type": "string",
            "description": ""
          },
          "minItems": 0
        },
        "gateway_ip": {
          "type": "string",
          "example": "172.168.1.1",
          "description": "子网的网关\n\n取值范围:子网网段中的IP地址\n\n约束:必须是ip格式"
        },
        "dhcp_enable": {
          "type": "boolean",
          "example": true,
          "description": "子网是否开启dhcp功能"
        },
        "primary_dns": {
          "type": "string",
          "example": "10.2.3.21",
          "description": "子网dns服务器地址1"
        },
        "secondary_dns": {
          "type": "string",
          "example": "10.32.54.2",
          "description": "子网dns服务器地址2"
        },
        "status": {
          "type": "string",
          "example": "ACTIVE",
          "description": "子网的状态\n\n取值范围:\n- ACTIVE:表示子网已挂载到ROUTER上\n- UNKNOWN:表示子网还未挂载到ROUTER上\n- ERROR:表示子网状态故障",
          "enum": [
            "ACTIVE",
            "UNKNOWN",
            "ERROR"
          ]
        },
        "vpc_id": {
          "type": "string",
          "description": "虚拟私有云ID。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "site_id": {
          "type": "string",
          "description": "子网所属的站点ID。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "site_info": {
          "type": "string",
          "example": "中国/华中地区/湖北/武汉市  ",
          "description": "子网所属的站点信息。"
        },
        "neutron_network_id": {
          "type": "string",
          "description": "对应网络(OpenStack Neutron接口) id。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "neutron_subnet_id": {
          "type": "string",
          "description": "对应子网(OpenStack Neutron接口) id。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "cidr_v6": {
          "type": "string",
          "description": "IPv6子网的网段,如果子网为IPv4子网,则不返回此参数"
        },
        "ipv6_enable": {
          "type": "boolean",
          "description": "是否是IPv6子网\n\n取值范围:true,false"
        },
        "pool_id": {
          "type": "string",
          "description": "IPv6线路ID,如果子网为IPv4子网,则不返回此参数。",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "neutron_subnet_id_v6": {
          "type": "string",
          "description": "对应IPv6子网(OpenStack Neutron接口)id,如果子网为IPv4子网,则不返回此参数。"
        },
        "gateway_ip_v6": {
          "type": "string",
          "description": "IPv6子网的网关,如果子网为IPv4子网,则不返回此参数。"
        }
      },
      "description": "子网对象。"
    }
  },
