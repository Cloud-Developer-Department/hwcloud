                "count": 1,
                "edgeclouds": [
                  {
                    "id": "27101e92-49a7-11eb-8a8a-fa1640495574",
                    "name": "edgecloud1",
                    "coverage": {
                      "coverage_policy": "centralize",
                      "coverage_level": "city",
                      "coverage_sites": [
                        {
                          "site": "xi'an",
