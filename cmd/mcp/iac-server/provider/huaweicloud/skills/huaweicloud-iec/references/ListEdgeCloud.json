  "definitions": {
    "ListEdgeCloudsResponseBody": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "边缘业务数量。"
        },
        "edgeclouds": {
          "type": "array",
          "description": "边缘业务列表。",
          "items": {
            "description": "",
            "$ref": "#/definitions/EdgeCloud"
          }
        }
      },
      "description": "查询边缘业务列表响应体"
    },
    "EdgeCloud": {
      "properties": {
        "id": {
          "type": "string",
          "example": "c0272146-f6d8-4e3c-a1dc-196ec4a2f848",
          "description": "边缘业务ID。"
        },
        "name": {
          "type": "string",
          "example": "edgecloud1",
          "description": "边缘业务名称。\n取值范围:只能由中文字符、大小写英文字母、数字及中划线、下划线组成,且长度为[1-32]个字符。"
        },
        "description": {
          "type": "string",
          "example": "this is a edgecouloud",
          "description": "边缘业务描述。最大支持255字节。"
        },
        "coverage": {
          "description": "边缘业务覆盖策略",
          "$ref": "#/definitions/CoverageResp"
        },
        "failed_num": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "创建失败的虚拟机"
        },
        "status": {
          "type": "string",
          "example": "creating",
          "description": "边缘业务状态,现存状态有:\n- creating/scheduling/updating:部署中\n- inService:运行中\n- failed:创建失败\n- deleting:删除中\n- delFailed:删除失败"
        },
        "success_num": {
          "type": "integer",
          "format": "int32",
          "example": 3,
          "description": "成功创建的虚拟机"
        },
        "edge_regions": {
          "type": "integer",
          "format": "int32",
          "description": "边缘业务支持的边缘区域数目。"
        }
      },
      "description": "边缘业务对象"
    },
    "DemandResp": {
      "required": [
        "demand_count"
      ],
      "properties": {
        "demand_count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "站点需要发放的资源(组)总数。 \n> 实际发放实例数量为count*demand_count。",
          "minimum": 1,
          "maximum": 10
        },
        "pool_id_v6": {
          "type": "string",
          "description": "指定IPv6线路,使用该线路下的子网分配IPv6端口。\n如果该线路下没有关联启用IPv6的子网,则创建新的子网。"
        },
        "ipv6_bandwidth_enable": {
          "type": "boolean",
          "description": "使用IPv6带宽。\n边缘实例是否开启IPv6公网访问能力。如果该IPv6线路下没有带宽,则创建新的带宽。"
        }
      },
      "description": "租户需求"
    },
    "CoverageSiteResp": {
      "required": [
        "demands",
        "site"
      ],
      "properties": {
        "site": {
          "type": "string",
          "example": "wuhan",
          "description": "站点名称。\n具体信息可通过调用“查询边缘站点列表”来查询(注意:本字段区分大小写)。"
        },
        "demands": {
          "type": "array",
          "description": "租户需求数量列表。表示租户发放资源站点的运营商和发放的资源组的数量。",
          "items": {
            "description": "",
            "$ref": "#/definitions/DemandResp"
          }
        },
        "i18n_site": {
          "type": "string",
          "description": "覆盖区域的国际化信息。"
        }
      },
      "description": "站点覆盖策略"
    },
    "CoverageResp": {
      "required": [
        "coverage_level",
        "coverage_policy",
        "coverage_sites"
      ],
      "properties": {
        "coverage_policy": {
          "type": "string",
          "example": "centralize",
          "description": "区域调度策略,只支持centralize/discrete。\n\n- centralize:代表城市集中策略,指定该策略,边缘业务创建时会保证将所有实例都发放在同一个站点。\n- discrete:代表城市分散,指定该策略,边缘业务创建时,尽量保证所有实例都分散发放在不同站点。"
        },
        "coverage_level": {
          "type": "string",
          "example": "city",
          "description": "区域分布层级,只支持area/prov/city/site。\n\n- area:大区,用户的资源会在指定大区下发放。\n- prov:省份,用户的资源会在指定省份下发放。\n- city:城市,用户的资源会在指定城市下发放。\n- site:站点级别。\n\n约束:\n\n站点层级,coverage_policy上仅支持'centralize',coverage_sites中'site'字段仅支持使用ID(站点ID,通过“查询边缘站点列表”获取),不支持name。"
        },
        "coverage_sites": {
          "type": "array",
          "description": "区域及购买数量列表。",
          "items": {
            "description": "",
            "$ref": "#/definitions/CoverageSiteResp"
          }
        }
      },
      "description": "覆盖策略对象"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iecs.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}