{
  "name": "CreateKeypair",
  "summary": "创建和导入密钥",
  "tags": "密钥对",
  "productshort": "IEC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/os-keypairs": {
      "post": {
        "tags": [
          "密钥对"
        ],
        "summary": "创建和导入密钥",
        "description": "创建SSH密钥,或把公钥导入系统,生成密钥对。\n\n创建SSH密钥成功后,请把响应数据中的私钥内容保存到本地文件,用户使用该私钥登录边缘实例。为保证边缘实例安全,私钥数据只能读取一次,请妥善保管。",
        "operationId": "CreateKeypair",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-order": 1
          },
          {
            "in": "body",
            "name": "CreateKeypairRequestBody",
            "description": "创建密钥的请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateKeypairRequestBody"
            },
            "x-order": 2,
            "x-open-region-cloud": ""
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "examples": {
              "application/json": {
                "name": "PK",
                "public_key": "ssh-rsa  Generated-by-Nova\n",
                "private_key": "string",
                "user_id": "dc36c78ad96f42e394f3221bf7c17166",
                "fingerprint": "SHA256:vqILnOoQ+aRoQLylIwFcCAxETrLqvUBJEznlGqndwNY"
              }
            },
            "schema": {
              "$ref": "#/definitions/Keypair"
            }
          }
        },
        "deprecated": false,
        "x-name": "创建和导入密钥",
        "x-constraint": "- 当前支持的加解密算法为:\n  SSH-2 (RSA,1024)\n  SSH-2 (RSA,2048)\n  SSH-2 (RSA,4096)",
        "x-version": "v1",
        "x-scope": "Commercial",
        "x-order": 32,
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/os-keypairs",
        "x-request-examples-1": {
          "name": "PK",
          "public_key": "ssh-rsa  Generated-by-Nova\n"
        },
        "x-request-examples-text-1": "{\n  \"name\": \"PK\",\n  \"public_key\": \"ssh-rsa  Generated-by-Nova\\n\"\n}",
        "x-publishpath": "",
        "x-hybridcloud": "",
        "x-source": "",
        "x-first-open-time": "",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc",
        "x-apiexplorer-hide": "",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "CreateKeypairRequestBody": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "PK",
          "description": "密钥对名称。\n新创建的密钥名称不能和已有密钥名称相同。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_.\\一-\\龥-]*$"
        },
        "public_key": {
          "type": "string",
          "example": "ssh-rsa  Generated-by-Nova\\n",
          "description": "导入的公钥信息。\n建议导入的公钥长度不大于1024字节。\n> 长度超过1024字节会导致边缘实例注入该密钥失败。"
        }
      },
      "description": "创建秘钥对请求体。"
    },
    "Keypair": {
      "properties": {
        "name": {
          "type": "string",
          "example": "PK",
          "description": "密钥对名称。"
        },
        "public_key": {
          "type": "string",
          "example": "ssh-rsa  Generated-by-Nova\\n",
          "description": "公钥。"
        },
        "private_key": {
          "type": "string",
          "description": "私钥。"
        },
        "user_id": {
          "type": "string",
          "example": "dc36c78ad96f42e394f3221bf7c17166",
          "description": "用户ID。"
        },
        "fingerprint": {
          "type": "string",
          "example": "SHA256:vqILnOoQ+aRoQLylIwFcCAxETrLqvUBJEznlGqndwNY",
          "description": "指纹。"
        }
      },
      "description": "秘钥对对象"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iecs.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
