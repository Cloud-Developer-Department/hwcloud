  "definitions": {
    "Route": {
      "properties": {
        "type": {
          "type": "string",
          "description": "路由的类型\n\n取值范围:\n    1)ecs:弹性云服务器\n    2)vip:虚拟IP\n    3)local:系统路由,不可修改和删除",
          "enum": [
            "ecs",
            "vip",
            "local"
          ]
        },
        "destination": {
          "type": "string",
          "example": " 0.0.0.0/0",
          "description": "路由的目的网段\n\n约束:合法的CIDR格式"
        },
        "nexthop": {
          "type": "string",
          "description": "路由下一跳对象的ID\n\n取值范围:\n    1)当type为ecs时,传入ecs实例ID;\n    2)当type为vip时,取值为vip对应的IP地址;"
        },
        "description": {
          "type": "string",
          "description": "路由的描述信息\n\n取值范围:0-255个字符,不能包含“<”和“>”"
        }
      },
      "description": "路由对象"
    },
    "RouteOption": {
      "required": [
        "destination",
        "nexthop",
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "路由的类型\n\n取值范围:\n    1)ecs:弹性云服务器\n    2)vip:虚拟IP",
          "enum": [
            "ecs",
            "vip",
            "cc",
            "igw"
          ]
        },
        "destination": {
          "type": "string",
          "example": " 0.0.0.0/0",
          "description": "路由的目的网段\n\n约束:合法的CIDR格式, 目的地址不可更新"
        },
        "nexthop": {
          "type": "string",
          "description": "路由下一跳对象的ID\n\n取值范围:\n    1)当type为ecs时,传入ecs实例ID;\n    2)当type为vip时,取值为vip的ip地址;"
        },
        "description": {
          "type": "string",
          "description": "路由的描述信息\n\n取值范围:0-255个字符,不能包含“<”和“>”",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "description": "路由对象"
    },
    "UpdateRoutesRequestBody": {
      "required": [
        "routes"
      ],
      "properties": {
        "routes": {
          "type": "array",
          "description": "待更新的路由信息",
          "items": {
            "description": "",
            "$ref": "#/definitions/RouteOption"
          }
        }
      },
      "description": "更新路由请求体"
    },
    "RoutesResponseBody": {
      "properties": {
        "routes": {
          "type": "array",
          "description": "路由列表",
          "items": {
            "description": "",
            "$ref": "#/definitions/Route"
          }
        }
      },
      "description": "路由响应体"
    }
  },
