  "definitions": {
    "CreatePortRequestBody": {
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "description": "创建端口参数。",
          "$ref": "#/definitions/CreatePortOption"
        }
      },
      "description": "创建端口请求体"
    },
    "CreatePortOption": {
      "required": [
        "device_owner",
        "network_id"
      ],
      "properties": {
        "device_owner": {
          "type": "string",
          "example": "neutron:VIP_PORT",
          "description": "端口设备所属。\n\n取值范围:目前只支持指定\"neutron:VIP_PORT\",neutron:VIP_PORT表示创建的是VIP",
          "enum": [
            "neutron:VIP_PORT"
          ]
        },
        "network_id": {
          "type": "string",
          "example": "14ab4bac-9dce-467d-b4f6-6bd0c645eba0",
          "description": "端口所属网络的ID。\n\n约束:必须是存在的网络ID。",
          "minLength": 1,
          "maxLength": 36
        },
        "fixed_ips": {
          "type": "array",
          "description": "端口IP\n\n约束:一个端口只支持一个fixed_ip,且不支持更新。",
          "items": {
            "description": "",
            "$ref": "#/definitions/FixedIp"
          }
        }
      },
      "description": "创建端口参数对象。"
    },
    "FixedIp": {
      "properties": {
        "subnet_id": {
          "type": "string",
          "description": "所属子网ID",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        },
        "ip_address": {
          "type": "string",
          "example": "192.168.0.4",
          "description": "端口IP地址",
          "pattern": "^[a-z0-9]{8}(-[a-z0-9]{4}){3}-[a-z0-9]{12}$"
        }
      },
      "description": "私有IP对象"
    },
    "Port": {
      "properties": {
        "id": {
          "type": "string",
          "description": "端口唯一标识"
        },
        "name": {
          "type": "string",
          "description": "端口名称\n\n取值:默认为空,最大长度不超过255"
        },
        "status": {
          "type": "string",
          "description": "端口状态,Hana硬直通虚拟机端口状态总为DOWN\n\n取值范围:ACTIVE、BUILD、DOWN",
          "enum": [
            "ACTIVE",
            "BUILD",
            "DOWN"
          ]
        },
        "admin_state_up": {
          "type": "boolean",
          "description": "管理状态\n\n约束:只支持true,默认为true"
        },
        "fixed_ips": {
          "type": "array",
          "description": "端口IP。\n\n约束:一个端口只支持一个fixed_ip,且不支持更新。",
          "items": {
            "description": "",
            "$ref": "#/definitions/FixedIp"
          },
          "minItems": 0
        },
        "mac_address": {
          "type": "string",
          "description": "端口MAC地址\n\n约束:由系统分配,不支持指定"
        },
        "network_id": {
          "type": "string",
          "description": "端口所属网络的ID\n\n约束:必须是存在的网络ID"
        },
        "device_id": {
          "type": "string",
          "description": "端口所属设备ID\n\n约束:不支持设置和更新,由系统自动维护"
        },
        "device_owner": {
          "type": "string",
          "description": "设备所属(DHCP/Router/ lb/Nova)\n\n约束:不支持设置和更新,由系统自动维护"
        },
        "security_groups": {
          "type": "array",
          "description": "安全组的UUID(扩展属性)",
          "items": {
            "type": "string",
            "description": ""
          },
          "minItems": 0
        },
        "extra_dhcp_opts": {
          "type": "array",
          "description": "DHCP的扩展属性。",
          "items": {
            "description": "",
            "$ref": "#/definitions/ExtraDhcpOption"
          }
        },
        "allowed_address_pairs": {
          "type": "array",
          "description": "- 功能说明:IP/Mac对列表,allow_address_pair参见表3。\n- 约束:\n  IP地址不允许为 “0.0.0.0/0”\n  如果allowed_address_pairs配置地址池较大的CIDR(掩码小于24位),建议为该port配置一个单独的安全组。\n  如果allowed_address_pairs的IP地址为“1.1.1.1/0”,表示关闭源目地址检查开关。",
          "items": {
            "description": "",
            "$ref": "#/definitions/AllowedAddressPair"
          }
        },
        "site_id": {
          "type": "string",
          "description": "站点ID"
        },
        "dns_assignment": {
          "type": "array",
          "description": "主网卡默认内网域名信息\n\n约束:不支持设置和更新,由系统自动维护",
          "items": {
            "description": "",
            "$ref": "#/definitions/DnsAssignment"
          }
        },
        "dns_name": {
          "type": "string",
          "description": "主网卡默认内网DNS名称\n\n约束:不支持设置和更新,由系统自动维护"
        },
        "ipv6_bandwidth_id": {
          "type": "string",
          "description": "IPv6带宽ID"
        },
        "binding:profile": {
          "type": "object",
          "description": "功能说明:提供用户设置自定义信息(扩展属性)"
        }
      },
      "description": "端口的字典对象。"
    },
    "AllowedAddressPair": {
      "required": [
        "ip_address"
      ],
      "properties": {
        "ip_address": {
          "type": "string",
          "description": "- 功能说明:IP地址\n- 约束:\n    IP地址不支持“0.0.0.0/0”\n    如果allowed_address_pairs配置地址池较大的CIDR(掩码小于24位),建议为该port配置一个单独的安全组。\n    如果allowed_address_pairs的IP地址为“1.1.1.1/0”,表示关闭源目地址检查开关。"
        },
        "mac_address": {
          "type": "string",
          "description": "MAC地址"
        }
      },
      "description": "IP/Mac对象"
    },
    "CreatePortResponseBody": {
      "properties": {
        "port": {
          "description": "端口对象。",
          "$ref": "#/definitions/Port"
        }
      },
      "description": "创建端口响应体。"
    },
    "DnsAssignment": {
      "properties": {
        "fqdn": {
          "type": "string",
          "description": "端口内网fqdn"
        },
        "hostname": {
          "type": "string",
          "description": "端口hostname"
        },
        "ip_address": {
          "type": "string",
          "description": "端口IP地址"
        }
      },
      "description": "DNS配置"
    },
    "ExtraDhcpOption": {
      "properties": {
        "opt_name": {
          "type": "string",
          "description": "Option名称"
        },
        "opt_value": {
          "type": "string",
          "description": "Option值"
        }
      },
      "description": "DHCP扩展属性"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iecs.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}