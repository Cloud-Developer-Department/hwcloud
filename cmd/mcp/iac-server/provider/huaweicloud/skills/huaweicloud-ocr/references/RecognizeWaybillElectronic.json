  "definitions": {
    "WaybillElectronicResult": {
      "properties": {
        "code": {
          "type": "string",
          "description": "三段码。"
        },
        "receiver_name": {
          "type": "string",
          "description": "收件人姓名。"
        },
        "receiver_phone": {
          "type": "string",
          "description": "收件人电话。"
        },
        "receiver_address": {
          "type": "string",
          "description": "收件人地址。"
        },
        "sender_name": {
          "type": "string",
          "description": "寄件人姓名。"
        },
        "sender_phone": {
          "type": "string",
          "description": "寄件人电话。"
        },
        "sender_address": {
          "type": "string",
          "description": "寄件人地址。"
        },
        "waybill_number": {
          "type": "string",
          "description": "条形码运单号。"
        },
        "confidence": {
          "type": "object",
          "description": "相关字段的置信度信息,取值范围0~1。\n置信度越大,表示本次识别的对应字段的可靠性越高,在统计意义上,置信度越大,准确率越高。\n置信度由算法给出,不直接等价于对应字段的准确率。"
        }
      }
    },
    "WaybillElectronicResponseBody": {
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "description": "调用成功时表示调用结果。\n调用失败时无此字段。",
          "$ref": "#/definitions/WaybillElectronicResult"
        }
      }
    },
    "WaybillElectronicRequestBody": {
      "properties": {
        "image": {
          "type": "string",
          "description": "与url二选一。\n\n图片的Base64编码,要求单个图片其对应的Base64编码不超过10MB。文件在Base64编码后会大于文件原本大小,请注意做好边界判断,建议文件大小不超过7MB。\n图片最小边不小于15px,最长边不超过8192px,支持JPEG、JPG、PNG、BMP、TIFF格式。"
        },
        "url": {
          "type": "string",
          "description": "与image二选一。\n\n单个图片其对应的Base64编码不超过10MB。文件在Base64编码后会大于文件原本大小,请注意做好边界判断,建议文件大小不超过7MB。\n图片最小边不小于15px,最长边不超过8192px,支持JPEG、JPG、PNG、BMP、TIFF格式。\n图片的URL路径,目前支持:\n- 公网http/https url\n- OBS提供的url,使用OBS数据需要进行授权。包括对服务授权、临时授权、匿名公开授权,详情参见[配置OBS访问权限](https://support.huaweicloud.com/api-ocr/ocr_03_0132.html)。\n> 说明:\n- 接口响应时间依赖于图片的下载时间,如果图片下载时间过长,会返回接口调用失败。\n- 请保证被检测图片所在的存储服务稳定可靠,推荐使用OBS服务存储图片数据。\n- url中不能存在中文字符,若存在,中文需要进行utf8编码。"
        }
      }
    },
    "WaybillElectronicErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参见错误码。\n调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      },
      "description": ""
    }
  },
