        },
        "deprecated": false,
        "x-name": "网络图片识别",
        "x-order": 1,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-open-region-cloud": "hc,hk",
        "x-request-examples-url-1": "POST https://{endpoint}/v2/{project_id}/ocr/web-image",
        "x-request-examples-1": {
