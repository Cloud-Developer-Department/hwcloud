        "x-request-examples-description-2": "传入网络图片的url进行文字识别,识别过程校验图片倾斜角度,判断待识别字体类型,并校验图片是否包含联系人信息"
      }
    }
  },
  "definitions": {
    "WebImageExtractedData": {
      "properties": {
        "contact_info": {
          "type": "object",
          "description": "该字段表示提取的联系人信息,包括:姓名、联系电话、省市区以及详细地址。\n若入参extract_type列表中无该字段,则此字段不存在。",
          "$ref": "#/definitions/WebImageContactInfo"
        },
        "image_size": {
          "type": "object",
          "description": "该字段表示返回图片宽高信息。\n如入参extract_type列表中无该字段,则此字段不存在。",
          "$ref": "#/definitions/WebImageImageSize"
        }
      },
      "description": ""
    },
    "WebImageContactInfo": {
      "properties": {
        "name": {
          "type": "string",
          "description": "传入contact_info时的返回,为姓名。"
        },
        "phone": {
          "type": "string",
          "description": "传入contact_info时的返回,联系电话。"
        },
        "province": {
          "type": "string",
          "description": "传入contact_info时的返回,省。"
        },
        "city": {
          "type": "string",
          "description": "传入contact_info时的返回,市。"
        },
        "district": {
          "type": "string",
          "description": "传入contact_info时的返回,县区。"
        },
        "detail_address": {
          "type": "string",
          "description": "传入contact_info时的返回,详细地址(不含省市区)。"
        }
      },
      "description": ""
    },
    "WebImageImageSize": {
      "properties": {
        "height": {
          "type": "integer",
          "format": "int32",
          "description": "传入image_size时的返回,为图像高度。"
        },
        "width": {
          "type": "integer",
          "format": "int32",
          "description": "传入image_size时的返回,为图像宽度。"
        }
      },
      "description": ""
    },
    "WebImageResponseBody": {
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "description": "调用成功时表示调用结果。\n\n调用失败时无此字段。",
          "$ref": "#/definitions/WebImageResult"
        }
      },
      "description": ""
    },
    "WebImageResult": {
      "required": [
        "words_block_count",
        "words_block_list",
        "extracted_data"
      ],
      "properties": {
        "words_block_count": {
          "type": "integer",
          "format": "int32",
          "description": "代表检测识别出来的文字块数目。"
        },
        "words_block_list": {
          "type": "array",
          "description": "识别文字块列表,输出顺序从左到右,从上到下。",
          "items": {
            "$ref": "#/definitions/WebImageWordsBlockList"
          }
        },
        "extracted_data": {
          "type": "object",
          "description": "提取出的结构化JSON结果,该字典内的key值与入参列表extract_type的值一致,目前仅支持联系人信息提取,亦即key值为\"contact_info\"的字段。\n若入参extract_type为空列表或该字段缺失时,不进行提取,此字段为空。",
          "$ref": "#/definitions/WebImageExtractedData"
        }
      },
      "description": ""
    },
    "WebImageWordsBlockList": {
      "properties": {
        "words": {
          "type": "string",
          "description": "文字块识别结果。"
        },
        "confidence": {
          "type": "number",
          "format": "float",
          "description": "相关字段的置信度信息,置信度越大,表示本次识别的对应字段的可靠性越高,在统计意义上,置信度越大,准确率越高。\n置信度由算法给出,不直接等价于对应字段的准确率。"
        },
        "location": {
          "type": "array",
          "description": "文字块的区域位置信息,列表形式,包含文字区域四个顶点的二维坐标(x,y);坐标原点为图片左上角,x轴沿水平方向,y轴沿竖直方向。",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "description": "文字块的区域位置信息。"
            }
          }
        },
        "font_list": {
          "type": "array",
          "description": "文字块所属字体类型,列表形式,表示与文字块的文字最接近的字体类型。",
          "items": {
            "type": "string"
          }
        },
        "font_scores": {
          "type": "array",
          "description": "文字块所属字体类型的概率,列表形式,与font_list一一对应,表示文字块的文字属于某种字体类型的概率。",
          "items": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "description": ""
    },
    "WebImageRequestBody": {
      "properties": {
        "image": {
          "type": "string",
          "description": "与url二选一。\n\n图片的Base64编码,要求单个图片其对应的Base64编码不超过10MB。文件在Base64编码后会大于文件原本大小,请注意做好边界判断,建议文件大小不超过7MB。\n图片最小边不小于15px,最长边不超过30000px,支持JPEG、JPG、PNG、BMP、TIFF、GIF、WEBP格式。\n\n图片文件Base64编码字符串,点击[这里](https://support.huaweicloud.com/ocr_faq/ocr_01_0032.html)查看详细获取方式。"
        },
        "url": {
          "type": "string",
          "description": "与image二选一。\n\n单个图片其对应的Base64编码不超过10MB。文件在Base64编码后会大于文件原本大小,请注意做好边界判断,建议文件大小不超过7MB。\n图片最小边不小于15px,最长边不超过30000px,支持JPEG、JPG、PNG、BMP、TIFF、GIF、WEBP格式。\n图片的URL路径,目前支持:\n- 公网http/https url\n- OBS提供的url,使用OBS数据需要进行授权。包括对服务授权、临时授权、匿名公开授权,详情参见[配置OBS访问权限](https://support.huaweicloud.com/api-ocr/ocr_03_0132.html)。 \n> 说明:\n- 接口响应时间依赖于图片的下载时间,如果图片下载时间过长,会返回接口调用失败。\n- 请保证被检测图片所在的存储服务稳定可靠,推荐使用OBS服务存储图片数据。\n- url中不能存在中文字符,若存在,中文需要进行utf8编码。"
        },
        "detect_direction": {
          "type": "boolean",
          "description": "图片朝向检测开关,可选值包括:\n- true:检测图片朝向;\n- false:不检测图片朝向。\n\n> 说明:\n- 支持任意角度的图片朝向检测。未传入该参数时默认为false,即不检测图片朝向。"
        },
        "extract_type": {
          "type": "array",
          "description": "结构化数据提取参数列表,目前只支持联系人信息、图像宽高,其入参值分别为\"contact_info\",\"image_size\",若该字段为空列表或缺失该字段,默认不提取。",
          "items": {
            "type": "string"
          }
        },
        "detect_font": {
          "type": "boolean",
          "description": "为Boolean类型,若不传该字段,默认不检测切片字体,为True时,将检测切片的字体类型,并返回最相似的5种字体名称。"
        },
        "detect_text_direction": {
          "type": "boolean",
          "description": "为Boolean类型,若不传该字段,默认为True,即检测每个字段的文字方向。为False时,则不检测文字方向。若图片中所有文字方向均是水平朝上时,建议将该值设为False,即不检测文字方向。"
        }
      },
      "description": ""
    },
    "WebImageErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参见错误码。\n调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      },
      "description": ""
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ocr.la-south-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}