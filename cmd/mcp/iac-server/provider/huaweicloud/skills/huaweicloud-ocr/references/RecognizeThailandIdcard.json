          "type": "string",
          "description": "泰文有效期。"
        },
        "date_of_expiry_en": {
          "type": "string",
          "description": "英文有效期。"
        },
        "serial_number": {
          "type": "string",
          "description": "序列号。"
        },
        "card_number": {
          "type": "string",
          "description": "身份证反面卡号。"
        },
        "laser_number": {
          "type": "string",
          "description": "激光码。"
        },
        "confidence": {
          "description": "相关字段的置信度信息,取值范围0~1。\n置信度越大,表示本次识别的对应字段的可靠性越高,在统计意义上,置信度越大,准确率越高。\n置信度由算法给出,不直接等价于对应字段的准确率。",
          "$ref": "#/definitions/ThailandIdcardConfidence"
        },
        "portrait_image": {
          "type": "string",
          "description": "头像的base64编码。\n当输入参数“return_portrait_image”为“true”时,才返回该参数。"
        },
        "portrait_location": {
          "type": "array",
          "description": "头像在原图上的位置。\n当输入参数“return_portrait_location”为“true”时,才返回该参数。以列表形式显示,包含头像区域四个顶点的二维坐标(x,y),坐标原点为图片左上角,x轴沿水平方向,y轴沿竖直方向",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "description": "头像在原图上的位置"
            }
          }
        },
        "idcard_type": {
          "type": "string",
          "description": "身份证的类型。取值如下所示:\n- normal:身份证原件\n- copy:复印的身份证\n- screen:屏幕翻拍\n当输入参数“return_idcard_type”为“true”时,才返回该参数。"
        },
        "text_location": {
          "type": "object",
          "description": "对应所有在原图上识别到的字段位置信息,包含所有文字区域四个顶点的二维坐标(x,y)。采用图像坐标系,坐标原点为图片左上角,x轴沿水平方向,y轴沿竖直方向。",
          "properties": {}
        }
      }
    },
    "ThailandIdcardErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
