  "definitions": {
    "BankReceiptDict": {
      "properties": {
        "kv_pair_count": {
          "type": "integer",
          "format": "int32",
          "description": "键值对数量"
        },
        "bank_receipt_location": {
          "type": "array",
          "description": "银行回单的区域位置信息,列表形式,包含文字区域四个顶点的二维坐标(x,y);坐标原点为图片左上角,x轴沿水平方向,y轴沿竖直方向。",
          "items": {
            "type": "array",
            "description": "银行回单的区域位置信息。",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        },
        "kv_pair_list": {
          "type": "array",
          "description": "键值对识别结果列表。",
          "items": {
            "$ref": "#/definitions/BankReceiptKvPair"
          }
        }
      }
    },
    "BankReceiptKvPair": {
      "properties": {
        "key": {
          "type": "string",
          "description": "key-value对(键值对)中的key,例如\"币别:人民币\"中的\"币别\"。"
        },
        "value": {
          "type": "string",
          "description": "key-value对(键值对)中的value,例如\"币别:人民币\"中的“人民币”"
        }
      }
    },
    "BankReceiptRequestBody": {
      "properties": {
        "data": {
          "type": "string",
          "description": "该参数与url二选一。\n\n图片的Base64编码,要求单个图片、PDF文件其对应的Base64编码不超过10MB。文件在Base64编码后会大于文件原本大小,请注意做好边界判断,建议文件大小不超过7MB。\n图像尺寸不小于15×15像素,最长边不超过8192像素,支持JPG/PNG/BMP/TIFF/PDF格式。 PDF以200dpi的分辨率转为图像进行识别,需符合上述图像尺寸规定。若PDF有多页,当前仅对第1页进行识别。"
        },
        "url": {
          "type": "string",
          "description": "与data二选一。\n\n单个图片、PDF文件其对应的Base64编码不超过10MB。文件在Base64编码后会大于文件原本大小,请注意做好边界判断,建议文件大小不超过7MB。\n图像尺寸不小于15×15像素,最长边不超过8192像素,支持JPG/PNG/BMP/TIFF/PDF格式。\n图片的URL路径,目前支持:\n- 公网http/https url\n- OBS提供的url,使用OBS数据需要进行授权。包括对服务授权、临时授权、匿名公开授权,详情参见[配置OBS访问权限](https://support.huaweicloud.com/api-ocr/ocr_03_0132.html)。\n> 说明:\n- 接口响应时间依赖于图片的下载时间,如果图片下载时间过长,会返回接口调用失败。\n- 请保证被检测图片所在的存储服务稳定可靠,推荐使用OBS服务存储图片数据。\n- url中不能存在中文字符,若存在,中文需要进行utf8编码。"
        },
        "page_num": {
          "type": "integer",
          "format": "int32",
          "description": "指定PDF页码识别。传入该参数时,则识别指定页码的内容。如果不传该参数,则默认识别第1页,该参数仅在文件为PDF格式时有效。"
        },
        "single_orientation_mode": {
          "type": "boolean",
          "description": "单朝向模式开关。可选值包括:\n- true:打开单朝向模式。\n- false:关闭单朝向模式。\n\n图片文字方向一致时,打开该开关可提升识别精度;图片文字方向不一致时,关闭该开关可支持多朝向文字识别。未传入该参数时默认为\"true\",既默认图片中的文字方向为单朝向。"
        },
        "erase_seal": {
          "type": "boolean",
          "description": "是否打开印章擦除功能。可选值包括:\n- true:打开印章擦除功能。\n- false:关闭印章擦除功能。\n\n开启后,可提升印章遮挡区域的文字识别精度。"
        }
      },
      "description": ""
    },
    "BankReceiptErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参见错误码。\n调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      },
      "description": ""
    },
    "BankReceiptResult": {
      "properties": {
        "bank_receipt_count": {
          "type": "integer",
          "format": "int32",
          "description": "银行回单数量"
        },
        "bank_receipt_list": {
          "type": "array",
          "description": "银行回单键值对提取结果。",
          "items": {
            "$ref": "#/definitions/BankReceiptDict"
          }
        }
      }
    },
    "BankReceiptResponseBody": {
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "description": "调用成功时表示调用结果。\n调用失败时无此字段。",
          "$ref": "#/definitions/BankReceiptResult"
        }
      },
      "description": ""
    }
  },
