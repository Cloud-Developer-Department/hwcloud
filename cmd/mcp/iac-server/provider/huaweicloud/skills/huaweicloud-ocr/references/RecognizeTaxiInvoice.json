  "definitions": {
    "TaxiInvoiceResult": {
      "properties": {
        "location": {
          "type": "string",
          "description": "归属地区。"
        },
        "code": {
          "type": "string",
          "description": "发票代码。"
        },
        "number": {
          "type": "string",
          "description": "发票号码。"
        },
        "phone_number": {
          "type": "string",
          "description": "电话(包括电话、监督电话)。"
        },
        "company": {
          "type": "string",
          "description": "单位。"
        },
        "taxi_number": {
          "type": "string",
          "description": "车号。"
        },
        "certificate_number": {
          "type": "string",
          "description": "证号。"
        },
        "identification_number": {
          "type": "string",
          "description": "识别编号。"
        },
        "date": {
          "type": "string",
          "description": "开票日期。"
        },
        "boarding_time": {
          "type": "string",
          "description": "上车时间。"
        },
        "alighting_time": {
          "type": "string",
          "description": "下车时间。"
        },
        "time": {
          "type": "string",
          "description": "时间(起止时间、上下车时间)。"
        },
        "unit_price": {
          "type": "string",
          "description": "单价。"
        },
        "distance": {
          "type": "string",
          "description": "总里程。"
        },
        "waiting_time": {
          "type": "string",
          "description": "等候时间。"
        },
        "fare": {
          "type": "string",
          "description": "金额。"
        },
        "fuel_oil_surcharge": {
          "type": "string",
          "description": "燃油附加费。"
        },
        "call_service_surcharge": {
          "type": "string",
          "description": "电调费(预约费)。"
        },
        "total": {
          "type": "string",
          "description": "实收金额。"
        },
        "confidence": {
          "type": "object",
          "description": "相关字段的置信度信息,置信度越大,表示本次识别的对应字段的可靠性越高,在统计意义上,置信度越大,准确率越高。\n置信度由算法给出,不直接等价于对应字段的准确率。",
          "properties": {}
        },
        "text_location": {
          "type": "object",
          "description": "对应所有在原图上识别到的字段位置信息,包含所有文字区域四个顶点的二维坐标(x,y)。采用图像坐标系,坐标原点为图片左上角,x轴沿水平方向,y轴沿竖直方向。",
          "properties": {}
        }
      }
    },
    "TaxiInvoiceResponseBody": {
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "description": "调用成功时表示调用结果。\n\n调用失败时无此字段。",
          "$ref": "#/definitions/TaxiInvoiceResult"
        }
      },
      "description": ""
    },
    "TaxiInvoiceRequestBody": {
      "properties": {
        "image": {
          "type": "string",
          "description": "与url二选一。\n\n图片的Base64编码,要求单个图片其对应的Base64编码不超过10MB。文件在Base64编码后会大于文件原本大小,请注意做好边界判断,建议文件大小不超过7MB。\n图片最小边不小于15px,最长边不超过4096px,支持JPEG、JPG、PNG、BMP、TIFF格式。\n\n图片文件Base64编码字符串,点击[这里](https://support.huaweicloud.com/ocr_faq/ocr_01_0032.html)查看详细获取方式。"
        },
        "url": {
          "type": "string",
          "description": "与image二选一。\n\n单个图片其对应的Base64编码不超过10MB。文件在Base64编码后会大于文件原本大小,请注意做好边界判断,建议文件大小不超过7MB。\n图片最小边不小于15px,最长边不超过4096px,支持JPEG、JPG、PNG、BMP、TIFF格式。\n图片的URL路径,目前支持:\n- 公网http/https url\n- OBS提供的url,使用OBS数据需要进行授权。包括对服务授权、临时授权、匿名公开授权,详情参见[配置OBS访问权限](https://support.huaweicloud.com/api-ocr/ocr_03_0132.html)。\n> 说明:\n- 接口响应时间依赖于图片的下载时间,如果图片下载时间过长,会返回接口调用失败。\n- 请保证被检测图片所在的存储服务稳定可靠,推荐使用OBS服务存储图片数据。\n- url中不能存在中文字符,若存在,中文需要进行utf8编码。"
        },
        "return_text_location": {
          "type": "boolean",
          "description": "识别到的文字块的区域位置信息。可选值包括:\n\n- true:返回各个文字块区域\n\n- false:不返回各个文字块区域\n\n如果无该参数,系统默认不返回文字块区域。如果输入参数不是Boolean类型,则会报非法参数错误。"
        }
      },
      "description": ""
    },
    "TaxiInvoiceErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参见错误码。\n调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      },
      "description": ""
    }
