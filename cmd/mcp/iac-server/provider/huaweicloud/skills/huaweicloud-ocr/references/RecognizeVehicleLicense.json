        },
        "remarks": {
          "type": "string",
          "description": "备注。"
        },
        "inspection_record": {
          "type": "string",
          "description": "检验记录。"
        },
        "code_number": {
          "type": "string",
          "description": "条码号。"
        },
        "text_location": {
          "type": "object",
          "description": "文本框在原图位置。输出左上、右上、右下、左下四个点坐标。\n\n当“return_text_location”设置为“true”时才返回。",
