          "description": "整备质量。"
        },
        "approved_load": {
          "type": "string",
          "description": "核定载质量。"
        },
        "dimension": {
          "type": "string",
          "description": "外廓尺寸。"
        },
        "traction_mass": {
          "type": "string",
