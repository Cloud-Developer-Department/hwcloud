          "type": "string",
          "description": "车票持有人姓名。"
        },
        "log_id": {
          "type": "string",
          "description": "车票最下方的序列号。"
        },
        "sale_location": {
          "type": "string",
          "description": "车票售票地点。"
        },
        "invoice_style": {
          "type": "string",
          "description": "类型。包含以下几种类型:\n- paper:纸质火车票\n- electronic:铁路电子客票\n- refund_old:退票费报销凭证\n- refund_new:纸质火车票退票凭证 \n- refund_electronic:铁路电子客票退票凭证"
        },
        "issue_date": {
          "type": "string",
          "description": "开票时间"
        },
        "discount_mark": {
          "type": "string",
          "description": "打折标识"
        },
        "serial_number": {
          "type": "string",
          "description": "电子客票号"
        },
        "tax_amount": {
          "type": "string",
          "description": "税金价格"
        },
        "tax_rate": {
          "type": "string",
          "description": "税率"
        },
        "air_conditioning": {
          "type": "string",
          "description": "是否是空调车厢"
        },
        "original_invoice_number": {
          "type": "string",
          "description": "原发票号码"
        },
        "unified_social_credit_code": {
          "type": "string",
          "description": "统一社会信用号码"
        },
        "buyer_name": {
          "type": "string",
          "description": "购买方名称"
        },
        "total_amount_excluding_tax": {
          "type": "string",
          "description": "不含税价格"
        },
