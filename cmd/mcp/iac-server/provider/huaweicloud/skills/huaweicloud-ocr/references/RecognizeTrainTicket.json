          "description": "是否有印章,True表示有印章,False表示不含印章,字段默认为False"
        },
        "title": {
          "type": "string",
          "description": "标题"
        },
        "area": {
          "type": "string",
          "description": "地区"
        },
        "receipt_number": {
          "type": "string",
