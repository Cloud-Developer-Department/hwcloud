{
  "name": "ShowTasks",
  "summary": "获取网站扫描任务详情",
  "tags": "网站任务管理",
  "productshort": "CodeArtsInspector",
  "region_id": "cn-north-4",
  "paths": {
    "/{project_id}/webscan/tasks": {
      "get": {
        "tags": [
          "web_tasks"
        ],
        "summary": "获取网站扫描任务详情",
        "description": "获取网站漏洞扫描任务详情",
        "operationId": "ShowTasks",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 102400
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "用户的project_id,获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-vss/vss_api_04_019.html)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 32
          },
          {
            "name": "task_id",
            "in": "query",
            "description": "任务ID",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 50,
            "x-example": "017281b97c9845b08174895992ba179643028"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ShowTasksResponseBody"
            },
            "examples": {
              "application/json": {
                "task_id": "017281b97c9845b08174895992ba179643028",
                "task_name": "测试任务1",
                "url": "https://127.0.0.1:8080",
                "task_type": "normal",
                "domain_name": "127.0.0.1:8080",
                "task_settings": {
                  "task_config": {
                    "scan_mode": "normal",
                    "port_scan": false,
                    "weak_pwd_scan": false,
                    "cve_check": false,
                    "text_check": false,
                    "picture_check": false,
                    "malicious_code": false,
                    "malicious_link": false
                  }
                },
                "create_time": "2021-09-18 16:26:24",
                "start_time": "2021-09-18 16:26:24",
                "end_time": "2021-09-18 17:00:00",
                "task_status": "success",
                "progress": 100,
                "reason": "Successful. Your website is very safe!",
                "pack_num": 5,
                "score": 100,
                "safe_level": "safety",
                "statistics": {
                  "high": 0,
                  "middle": 0,
                  "low": 0,
                  "hint": 0
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "418": {
            "description": "I'm a teapot",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v3/{project_id}/webscan/tasks?task_id=017281b97c9845b08174895992ba179643028"
      }
    }
  },
  "definitions": {
    "ShowTasksResponseBody": {
      "allOf": [
        {
          "$ref": "#/definitions/TaskInfos"
        },
        {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "description": "任务ID",
              "minLength": 32,
              "maxLength": 50,
              "example": "017281b97c9845b08174895992ba179643028"
            },
            "domain_name": {
              "type": "string",
              "description": "网站域名",
              "minLength": 1,
              "maxLength": 256,
              "example": "127.0.0.1:8080"
            },
            "task_settings": {
              "description": "扫描任务设置",
              "$ref": "#/definitions/TaskSettings"
            },
            "create_time": {
              "type": "string",
              "description": "创建任务的时间",
              "minLength": 0,
              "maxLength": 19,
              "example": "2021-09-18 16:26:24"
            },
            "start_time": {
              "type": "string",
              "description": "任务启动的时间",
              "minLength": 0,
              "maxLength": 19,
              "example": "2021-09-18 16:26:24"
            },
            "end_time": {
              "type": "string",
              "description": "任务结束的时间",
              "minLength": 0,
              "maxLength": 19,
              "example": "2021-09-18 17:00:00"
            },
            "task_status": {
              "type": "string",
              "description": "任务状态:\n  * running - 正在运行\n  * success - 成功\n  * canceled - 已取消\n  * waiting - 正在等待\n  * ready - 已就绪,排队中\n  * failure - 失败\n",
              "enum": [
                "running",
                "success",
                "canceled",
                "waiting",
                "ready",
                "failure"
              ],
              "example": "waiting"
            },
            "schedule_status": {
              "type": "string",
              "description": "监测任务状态:\n  * running - 正在运行\n  * waiting - 正在等待\n  * finished - 已完成\n",
              "enum": [
                "running",
                "waiting",
                "finished"
              ]
            },
            "progress": {
              "type": "integer",
              "format": "int32",
              "description": "任务进度",
              "minimum": 0,
              "maximum": 100
            },
            "reason": {
              "type": "string",
              "description": "任务状态描述",
              "minLength": 0,
              "maxLength": 128,
              "example": "Wait for the result."
            },
            "pack_num": {
              "type": "integer",
              "format": "int64",
              "description": "包总数",
              "minimum": 0,
              "maximum": 100000
            },
            "score": {
              "type": "integer",
              "format": "int32",
              "description": "安全分数",
              "minimum": 0,
              "maximum": 100
            },
            "safe_level": {
              "type": "string",
              "description": "安全等级:\n  * safety - 安全\n  * average - 中风险\n  * highrisk - 高风险\n",
              "enum": [
                "safety",
                "average",
                "highrisk"
              ]
            },
            "statistics": {
              "description": "漏洞风险等级统计",
              "$ref": "#/definitions/VulnsLevel"
            }
          }
        }
      ]
    },
    "TaskSettings": {
      "properties": {
        "timer": {
          "type": "string",
          "description": "普通任务的定时启动时间",
          "minLength": 0,
          "maxLength": 19,
          "example": "2021-09-18 16:26:24"
        },
        "trigger_time": {
          "type": "string",
          "description": "监测任务的定时触发时间",
          "minLength": 0,
          "maxLength": 19,
          "example": "2021-09-18 16:26:24"
        },
        "task_period": {
          "type": "string",
          "description": "监测任务的定时触发周期:\n  * everyday - 每日\n  * threedays - 每三天\n  * everyweek - 每星期\n  * everymonth - 每月\n",
          "enum": [
            "everyday",
            "threedays",
            "everyweek",
            "everymonth"
          ]
        },
        "task_config": {
          "type": "object",
          "description": "扫描任务配置",
          "properties": {
            "scan_mode": {
              "type": "string",
              "description": "扫描模式:\n  * fast - 快速扫描\n  * normal - 标准扫描\n  * deep - 深度扫描\n",
              "enum": [
                "fast",
                "normal",
                "deep"
              ],
              "default": "normal"
            },
            "port_scan": {
              "type": "boolean",
              "description": "是否进行端口扫描",
              "default": true
            },
            "weak_pwd_scan": {
              "type": "boolean",
              "description": "是否进行弱密码扫描",
              "default": true
            },
            "cve_check": {
              "type": "boolean",
              "description": "是否进行CVE漏洞扫描",
              "default": true
            },
            "text_check": {
              "type": "boolean",
              "description": "是否进行网站内容合规文字检测",
              "default": true
            },
            "picture_check": {
              "type": "boolean",
              "description": "是否进行网站内容合规图片检测",
              "default": false
            },
            "malicious_code": {
              "type": "boolean",
              "description": "是否进行网站挂马检测",
              "default": false
            },
            "malicious_link": {
              "type": "boolean",
              "description": "是否进行链接健康检测(死链、暗链、恶意外链)",
              "default": false
            }
          }
        }
      }
    },
    "ErrorResponseBody": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 0,
          "maxLength": 50,
          "example": "VSS.00006016"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 256,
          "example": "Invalid domain parameter."
        }
      }
    },
    "TaskInfos": {
      "required": [
        "task_name",
        "url"
      ],
      "properties": {
        "task_name": {
          "type": "string",
          "description": "任务名称",
          "minLength": 1,
          "maxLength": 16,
          "example": "测试任务1"
        },
        "url": {
          "type": "string",
          "description": "待扫描的目标网址",
          "minLength": 1,
          "maxLength": 256,
          "example": "https://127.0.0.1:8080"
        },
        "task_type": {
          "type": "string",
          "description": "扫描任务类型:\n  * normal - 普通任务\n  * monitor - 监测任务\n",
          "enum": [
            "normal",
            "monitor"
          ],
          "default": "normal"
        }
      }
    },
    "VulnsLevel": {
      "properties": {
        "high": {
          "type": "integer",
          "format": "int32",
          "description": "高危漏洞数",
          "minimum": 0,
          "maximum": 1000
        },
        "middle": {
          "type": "integer",
          "format": "int32",
          "description": "中危漏洞数",
          "minimum": 0,
          "maximum": 1000
        },
        "low": {
          "type": "integer",
          "format": "int32",
          "description": "低危漏洞数",
          "minimum": 0,
          "maximum": 1000
        },
        "hint": {
          "type": "integer",
          "format": "int32",
          "description": "提示危漏洞数",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "vss.myhuaweicloud.com",
  "base_path": "/v3",
  "info_version": "v3",
  "method": "get",
  "uri": null
}