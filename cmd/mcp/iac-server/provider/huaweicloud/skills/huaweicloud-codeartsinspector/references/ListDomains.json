{
  "name": "ListDomains",
  "summary": "获取网站资产",
  "tags": "网站管理",
  "productshort": "CodeArtsInspector",
  "region_id": "cn-north-4",
  "paths": {
    "/{project_id}/webscan/domains": {
      "get": {
        "tags": [
          "websites"
        ],
        "summary": "获取网站资产",
        "description": "获取租户的所有网站资产",
        "operationId": "ListDomains",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 102400
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "用户的project_id,获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-vss/vss_api_04_019.html)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 32
          },
          {
            "name": "domain_id",
            "in": "query",
            "description": "网站域名ID",
            "required": false,
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "x-example": "2ec0993b8572455aacf14b6f9288b167"
          },
          {
            "name": "auth_status",
            "in": "query",
            "description": "网站域名的认证状态:\n  * unauth - 未认证\n  * auth - 已认证\n  * invalid - 认证文件无效\n  * manual - 人工认证\n  * skip - 免认证\n",
            "required": false,
            "type": "string",
            "enum": [
              "unauth",
              "auth",
              "invalid",
              "manual",
              "skip"
            ],
            "x-example": "auth"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页查询,偏移量,表示从此偏移量开始查询",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 10000,
            "default": 0,
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "分页查询,每页显示的条目数量",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 10000,
            "default": 5,
            "x-example": 10
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListDomainsResponseBody"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "top_level_domain_num": 1,
                "domains": [
                  {
                    "domain_id": "2ec0993b8572455aacf14b6f9288b167",
                    "top_level_domain_id": "e38db200a348414f9c8df6418dab0765",
                    "domain_name": "127.0.0.1:8080",
                    "alias": "网站资产1",
                    "create_time": "2021-09-18 16:26:24",
                    "auth_status": "auth",
                    "protocol_type": "https://",
                    "high": 0,
                    "middle": 1,
                    "low": 0,
                    "hint": 2
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "418": {
            "description": "I'm a teapot",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v3/{project_id}/webscan/domains"
      }
    }
  },
  "definitions": {
    "ListDomainsResponseBody": {
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "网站域名总数",
          "minimum": 0,
          "maximum": 1000,
          "example": 5
        },
        "top_level_domain_num": {
          "type": "integer",
          "format": "int32",
          "description": "网站一级域名总数",
          "minimum": 0,
          "maximum": 1000,
          "example": 3
        },
        "domains": {
          "type": "array",
          "description": "网站域名列表",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/DomainItem"
          }
        }
      }
    },
    "DomainItem": {
      "allOf": [
        {
          "$ref": "#/definitions/VulnsLevel"
        },
        {
          "type": "object",
          "properties": {
            "domain_id": {
              "type": "string",
              "description": "网站域名ID",
              "minLength": 32,
              "maxLength": 32,
              "example": "2ec0993b8572455aacf14b6f9288b167"
            },
            "top_level_domain_id": {
              "type": "string",
              "description": "一级域名ID",
              "minLength": 32,
              "maxLength": 32,
              "example": "e38db200a348414f9c8df6418dab0765"
            },
            "domain_name": {
              "type": "string",
              "description": "网站域名",
              "minLength": 1,
              "maxLength": 256,
              "example": "127.0.0.1:8080"
            },
            "alias": {
              "type": "string",
              "description": "网站域名的别名",
              "minLength": 1,
              "maxLength": 50,
              "example": "网站域名资产1"
            },
            "create_time": {
              "type": "string",
              "description": "创建网站域名资产的时间",
              "minLength": 0,
              "maxLength": 19,
              "example": "2021-09-18 16:26:24"
            },
            "auth_status": {
              "type": "string",
              "description": "网站域名的认证状态:\n  * unauth - 未认证\n  * auth - 已认证\n  * invalid - 认证文件无效\n  * manual - 人工认证\n  * skip - 免认证\n",
              "enum": [
                "unauth",
                "auth",
                "invalid",
                "manual",
                "skip"
              ]
            },
            "protocol_type": {
              "type": "string",
              "description": "协议类型:\n  * http:// - HTTP\n  * https:// - HTTPS\n",
              "enum": [
                "http://",
                "https://"
              ]
            }
          }
        }
      ]
    },
    "ErrorResponseBody": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 0,
          "maxLength": 50,
          "example": "VSS.00006016"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 0,
          "maxLength": 256,
          "example": "Invalid domain parameter."
        }
      }
    },
    "VulnsLevel": {
      "properties": {
        "high": {
          "type": "integer",
          "format": "int32",
          "description": "高危漏洞数",
          "minimum": 0,
          "maximum": 1000
        },
        "middle": {
          "type": "integer",
          "format": "int32",
          "description": "中危漏洞数",
          "minimum": 0,
          "maximum": 1000
        },
        "low": {
          "type": "integer",
          "format": "int32",
          "description": "低危漏洞数",
          "minimum": 0,
          "maximum": 1000
        },
        "hint": {
          "type": "integer",
          "format": "int32",
          "description": "提示危漏洞数",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  },
  "version": "2.0",
