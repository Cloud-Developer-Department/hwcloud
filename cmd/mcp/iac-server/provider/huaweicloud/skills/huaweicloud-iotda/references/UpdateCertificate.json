{
  "name": "UpdateCertificate",
  "summary": "更新CA证书",
  "tags": "设备CA证书管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/certificates/{certificate_id}": {
      "put": {
        "tags": [
          "CertificateManagement"
        ],
        "summary": "更新CA证书",
        "description": "应用服务器可调用此接口在物联网平台上更新CA证书。仅标准版实例、企业版实例支持该接口调用,基础版不支持。",
        "operationId": "UpdateCertificate",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0079.html#section1) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "certificate_id",
            "in": "path",
            "description": "CA证书ID,在上传CA证书时由平台分配的唯一标识。",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "pattern": "^[a-f0-9-]{1,36}$",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "in": "body",
            "name": "updateCertificateRequestBody",
            "description": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateCertificateDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "examples": {
              "application/json": {
                "certificate_id": "string",
                "cn_name": "string",
                "owner": "string",
                "status": true,
                "verify_code": "string",
                "provision_enable": true,
                "template_id": "61c970ce2d63eb6ee655dbf0",
                "create_date": "20191212T121212Z",
                "effective_date": "20191212T121212Z",
                "expiry_date": "20221212T121212Z"
              }
            },
            "schema": {
              "$ref": "#/definitions/CertificatesRspDTO"
            },
            "x-SuccessCode": true
          },
          "400": {
            "description": "Bad Request",
            "x-Error": [
              "IOTDA.000006",
              "IOTDA.014320"
            ]
          },
          "403": {
            "description": "Forbidden",
            "x-Error": [
              "IOTDA.014319"
            ]
          },
          "404": {
            "description": "Not Found",
            "x-Error": [
              "IOTDA.014306"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IOTDA.000020"
            ]
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-apig-name": "IoTDA_API",
        "x-returnType": "ResponseEntity<CertificatesRspDTO>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/certificates/{certificate_id}"
      }
    }
  },
  "definitions": {
    "CertificatesRspDTO": {
      "type": "object",
      "properties": {
        "certificate_id": {
          "type": "string",
          "description": "CA证书ID,在上传CA证书时由平台分配的唯一标识。"
        },
        "cn_name": {
          "type": "string",
          "description": "CA证书CN名称。",
          "x-isSensitive": true
        },
        "owner": {
          "type": "string",
          "description": "CA证书所有者。",
          "x-isSensitive": true
        },
        "status": {
          "type": "boolean",
          "description": "CA证书验证状态。true代表证书已通过验证,可进行设备证书认证接入。false代表证书未通过验证。",
          "x-isSensitive": true
        },
        "verify_code": {
          "type": "string",
          "description": "CA证书验证码。",
          "x-isSensitive": true
        },
        "provision_enable": {
          "type": "boolean",
          "description": "是否开启自注册能力,当为true时该功能必须配合自注册模板使用,true:是,false:否。"
        },
        "template_id": {
          "type": "string",
          "description": "绑定的自注册模板ID。"
        },
        "ocsp_enable": {
          "type": "boolean",
          "description": "是否开启该CA证书下的设备证书OCSP校验,当为true且设备证书信息中包含OCSP url时则平台会校验证书的状态,当证书状态为revoked时平台会拒绝设备连接,true:开启,false:关闭。"
        },
        "ocsp_server_ca_id": {
          "description": "ocsp服务器端CA证书id,仅当ocsp服务器开启SSL时配置,平台使用该CA证书认证ocsp服务器。",
          "type": "string",
          "example": "b8bcc4e2f8594d2ba59c7fc28ef8d547"
        },
        "ocsp_ssl_enable": {
          "description": "ocsp服务器是否开启SSL加密,开启后必须配置OCSP服务器CA证书。",
          "type": "boolean"
        },
        "create_date": {
          "type": "string",
          "example": "20191212T121212Z",
          "description": "创建证书日期。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "x-isSensitive": true
        },
        "effective_date": {
          "type": "string",
          "example": "20191212T121212Z",
          "description": "CA证书生效日期。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "x-isSensitive": true
        },
        "expiry_date": {
          "type": "string",
          "example": "20221212T121212Z",
          "description": "CA证书失效日期。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "x-isSensitive": true
        }
      }
    },
    "UpdateCertificateDTO": {
      "type": "object",
      "properties": {
        "provision_enable": {
          "type": "boolean",
          "example": true,
          "description": "是否开启自注册能力,当为true时该功能必须配合预调配功能使用,true:是,false:否。"
        },
        "template_id": {
          "type": "string",
          "example": "61c970ce2d63eb6ee655dbf0",
          "description": "预调配模板ID,该CA证书绑定的预调配模板id,当该字段传null时表示解除绑定关系。",
          "pattern": "^[a-fA-F0-9]{24}$"
        },
        "ocsp_enable": {
          "type": "boolean",
          "description": "是否开启该CA证书下的设备证书OCSP校验,当为true且设备证书信息中包含OCSP url时则平台会校验证书的状态,当证书状态为revoked时平台会拒绝设备连接,true:开启,false:关闭。",
          "default": false,
          "example": true
        },
        "ocsp_ssl_enable": {
          "description": "访问ocsp服务器是否开启SSL,开启后必须配置服务器CA证书校验。",
          "type": "boolean",
          "default": true
        },
        "ocsp_server_ca_id": {
          "description": "ocsp服务器端CA证书id,当ocsp服务器为https协议时需要配置,否则认证失败。",
          "type": "string",
          "pattern": "^[a-f0-9-]{1,36}$",
          "example": "b8bcc4e2f8594d2ba59c7fc28ef8d547"
        }
      },
      "title": "更新CA证书结构体",
      "description": "更新CA证书结构体。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "put",
  "uri": null
}