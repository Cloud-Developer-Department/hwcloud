{
  "name": "ShowHarmonySoftBus",
  "summary": "查询鸿蒙软总线",
  "tags": "鸿蒙软总线管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/harmony-soft-bus/{bus_id}": {
      "get": {
        "tags": [
          "HarmonySoftBus"
        ],
        "summary": "查询鸿蒙软总线",
        "description": "应用服务器可调用此接口查询指定ID的鸿蒙软总线。",
        "operationId": "ShowHarmonySoftBus",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html)。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数说明**:用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "huaweicloud"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "bus_id",
            "in": "path",
            "description": "**参数说明**:鸿蒙软总线ID,用于唯一标识一个鸿蒙软总线,在创建鸿蒙软总线时由物联网平台分配。\n**取值范围**:长度不超过36,十六进制字符串和连接符(-)的组合。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9-]{1,36}$"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "bus_id": "04ed32dc1b0025b52fe3c01a27c2babc",
                "bus_name": "BusA",
                "app_id": "jeQDJQZltU8iKgFFoW060F5SGZka",
                "group_id": "04ed32dc1b0025b52fe3c01a27c2b0a8",
                "status": "Synchronized"
              }
            },
            "schema": {
              "$ref": "#/definitions/HarmonySoftBusResponseDTO"
            }
          },
          "404": {
            "description": "Not Found",
            "x-Error": [
              "IOTDA.006004"
            ]
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-externalAPI": false,
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-returnType": "ResponseEntity<HarmonySoftBusResponseDTO>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/harmony-soft-bus/{bus_id}"
      }
    }
  },
  "definitions": {
    "HarmonySoftBusResponseDTO": {
      "type": "object",
      "properties": {
        "bus_id": {
          "type": "string",
          "example": "04ed32dc1b0025b52fe3c01a27c2babc",
          "description": "鸿蒙软总线ID,用于唯一标识一个鸿蒙软总线,在创建鸿蒙软总线时由物联网平台分配。"
        },
        "bus_name": {
          "type": "string",
          "example": "GroupA",
          "description": "鸿蒙软总线名称,单个资源空间下不可重复。"
        },
        "group_id": {
          "type": "string",
          "example": "04ed32dc1b0025b52fe3c01a27c2b0a8",
          "description": "设备组ID。"
        },
        "app_id": {
          "type": "string",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka",
          "description": "**参数说明**:资源空间ID。此参数为非必选参数,存在多资源空间的用户需要使用该接口时,建议携带该参数指定创建的设备组归属到哪个资源空间下,否则创建的设备组将会归属到[默认资源空间](https://support.huaweicloud.com/usermanual-iothub/iot_01_0006.html#section0)下。\n**取值范围**:长度不超过36,只允许字母、数字、下划线(_)、连接符(-)的组合。"
        },
        "status": {
          "type": "string",
          "example": "Synchronized",
          "description": "鸿蒙软总线组信息同步状态,结果范围:Synchronized,Synchronizing,ToBeSynchronized\n- Synchronized:已同步。\n- Synchronizing:同步中。\n- ToBeSynchronized:待同步。"
        }
      },
      "title": "鸿蒙软总线组信息结构体",
      "description": "鸿蒙软总线信息结构体,创建、查询鸿蒙软总线时返回"
    }
  },
  "version": "2.0",
