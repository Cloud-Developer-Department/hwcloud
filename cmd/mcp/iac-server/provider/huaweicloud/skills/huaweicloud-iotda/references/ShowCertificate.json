{
  "name": "ShowCertificate",
  "summary": "查询CA证书",
  "tags": "设备CA证书管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/certificates/{certificate_id}": {
      "get": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "tags": [
          "CertificateManagement"
        ],
        "operationId": "ShowCertificate",
        "x-externalAPI": true,
        "x-interfaceRisk": "HIGH",
        "x-iftype": "OpenAPI_new",
        "summary": "查询CA证书",
        "description": "应用服务器可调用此接口在物联网平台查询CA证书",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Sp-Auth-Token",
            "in": "header",
            "description": "Sp用户Token。通过调用IoBPS服务获取SP用户Token",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "chinatelecom"
          },
          {
            "name": "Stage-Auth-Token",
            "in": "header",
            "description": "Stage用户的Token, 仅提供给IoStage服务使用",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "stage"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "certificate_id",
            "in": "path",
            "description": "设备CA证书ID,在上传设备CA证书时由平台分配的唯一标识。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[a-f0-9-]{1,36}$",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          }
        ],
        "x-returnType": "ResponseEntity<CertificateDetailRspDTO>",
        "responses": {
          "200": {
            "description": "Successful response",
            "x-SuccessCode": true,
