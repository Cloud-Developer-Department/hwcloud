  "definitions": {
    "DeviceGroupResponseDTO": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string",
          "example": "04ed32dc1b0025b52fe3c01a27c2babc",
          "description": "设备组ID,用于唯一标识一个设备组,在创建设备组时由物联网平台分配。",
          "x-isSensitive": true
        },
        "name": {
          "type": "string",
          "example": "GroupA",
          "description": "设备组名称,单个资源空间下不可重复。",
          "x-isSensitive": true
        },
        "description": {
          "type": "string",
          "example": "群组A",
          "description": "设备组描述。",
          "x-isSensitive": true
        },
        "super_group_id": {
          "type": "string",
          "example": "04ed32dc1b0025b52fe3c01a27c2b0a8",
          "description": "父设备组ID,该设备组的父设备组ID。",
          "x-isSensitive": true
        },
        "group_type": {
          "type": "string",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka",
          "description": "设备组类型,分为动态设备组和静态设备组两种",
          "pattern": "DYNAMIC|STATIC"
        },
        "dynamic_group_rule": {
          "type": "string",
          "example": "device_id = 'testDeviceId' and node_id = 'testNodeId'",
          "description": "动态设备组规则",
          "pattern": "^[一-龥a-zA-Z0-9_?'#()., &%@!*=<>:-]{1,200}$"
        }
      },
      "title": "设备组信息结构体",
      "description": "设备组信息结构体,创建、查询、修改设备组时返回"
    },
    "AddDeviceGroupDTO": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "GroupA",
          "description": "**参数说明**:设备组名称,单个资源空间下不可重复。\n**取值范围**:长度不超过64,只允许中文、字母、数字、以及_? '#().,&%@!-等字符的组合。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[\\一-\\龥a-zA-Z0-9_? '#()\\.,&%@!-]*$"
        },
        "description": {
          "type": "string",
          "example": "群组A",
          "description": "**参数说明**:设备组描述。\n**取值范围**:长度不超过64,只允许中文、字母、数字、以及_? '#().,&%@!-等字符的组合。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[\\一-\\龥a-zA-Z0-9_? '#()\\.,&%@!-]*$",
          "x-isSensitive": true
        },
        "super_group_id": {
          "type": "string",
          "example": "04ed32dc1b0025b52fe3c01a27c2b0a8",
          "description": "**参数说明**:父设备组ID,携带该参数时表示在该设备组下创建一个子设备组,动态群组不支持该参数。\n**取值范围**:长度不超过36,十六进制字符串和连接符(-)的组合。",
          "pattern": "^[a-fA-F0-9-]{1,36}$"
        },
        "app_id": {
          "type": "string",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka",
          "description": "**参数说明**:资源空间ID。此参数为非必选参数,存在多资源空间的用户需要使用该接口时,建议携带该参数指定创建的设备组归属到哪个资源空间下,否则创建的设备组将会归属到[默认资源空间](https://support.huaweicloud.com/usermanual-iothub/iot_01_0006.html#section0)下。\n**取值范围**:长度不超过36,只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$"
        },
        "group_type": {
          "type": "string",
          "example": "STATIC",
          "description": "**参数说明**:设备组类型,默认为静态设备组;当设备组类型为动态设备组时,需要填写动态设备组组规则",
          "pattern": "DYNAMIC|STATIC"
        },
        "dynamic_group_rule": {
          "type": "string",
          "example": "device_id = 'testDeviceId' and node_id = 'testNodeId'",
          "description": "**参数说明**:动态设备组规则语法和高级搜索保持一致,只需要填写where 子句内容,其余子句无需填写,todo补充说明",
          "pattern": "^[一-龥a-zA-Z0-9_?'#()., &%@!*=<>:-]{1,200}$"
        }
      },
      "title": "创建设备组请求结构体",
      "description": "创建设备组请求结构体"
    }
  },
