{
  "name": "CreateOtaPackage",
  "summary": "创建OTA升级包",
  "tags": "OTA升级包管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/ota-upgrades/packages": {
      "post": {
        "tags": [
          "OtaPackageManagement"
        ],
        "summary": "创建OTA升级包",
        "description": "用户可调用此接口创建升级包关联OBS对象\n使用前提:使用该API需要您授权设备接入服务(IoTDA)的实例访问对象存储服务(OBS)以及 密钥管理服务(KMS Administrator)的权限。在“[统一身份认证服务(IAM)](https://console.huaweicloud.com/iam) - 委托”中将委托名称为iotda_admin_trust的委托授权KMS Administrator和OBS OperateAccess",
        "operationId": "CreateOtaPackage",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID。",
            "required": false,
            "type": "string",
            "pattern": "[a-f0-9-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "in": "body",
            "name": "CreateOtaPackageRequestBody",
            "description": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateOtaPackage"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "examples": {
              "application/json": {
                "package_id": "28f61af50fc9452aa0ed5ea25c3cc3d3",
                "app_id": "61f7e74d036aca5be29e1ed4",
                "package_type": "firmwarePackage",
                "product_id": "5ba24f5ebbe8f56f5a14f605",
                "version": "V2.0",
                "support_source_versions": [
                  "V1.0",
                  "V1.1"
                ],
                "description": "package for version V1.0 and V1.1",
                "custom_info": "更新了XX功能,修复了XXXX问题",
                "create_time": "20230211T121212Z",
                "file_location": {
                  "obs_location": {
                    "region_name": "cn-north-4",
                    "bucket_name": "abc",
                    "object_key": "bbb/upgrade.bin"
                  }
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/OtaPackageInfoDetail"
            },
            "x-SuccessCode": true
          },
          "400": {
            "description": "Bad Request",
            "x-Error": [
              "IOTDA.019304",
              "IOTDA.013000"
            ]
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden",
            "x-Error": [
              "IOTDA.019303"
            ]
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apig-name": "IoTDA_API",
        "x-iftype": "OpenAPI_new",
        "x-returnType": "ResponseEntity<OtaPackageInfoDetail>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/ota-upgrades/packages",
        "x-request-examples-description-1": "上传固件包",
        "x-request-examples-text-1": {
          "app_id": "61f7e74d036aca5be29e1ed4",
          "package_type": "firmwarePackage",
          "product_id": "5ba24f5ebbe8f56f5a14f605",
          "version": "V2.0",
          "description": "package v2.0",
          "custom_info": "更新了XX功能,修复了XXXX问题",
          "file_location": {
            "obs_location": {
              "region_name": "cn-north-4",
              "bucket_name": "abc",
              "object_key": "bbb/upgrade.bin"
            }
          }
        },
        "x-request-examples-url-2": "POST https://{endpoint}/v5/iot/{project_id}/ota-upgrades/packages",
        "x-request-examples-description-2": "上传固件包-差分包场景",
        "x-request-examples-text-2": {
          "app_id": "61f7e74d036aca5be29e1ed4",
          "package_type": "firmwarePackage",
          "product_id": "5ba24f5ebbe8f56f5a14f605",
          "version": "V2.0",
          "support_source_versions": [
            "V1.0",
            "V1.1"
          ],
          "description": "package for version V1.0 and V1.1",
          "custom_info": "更新了XX功能,修复了XXXX问题",
          "file_location": {
            "obs_location": {
              "region_name": "cn-north-4",
              "bucket_name": "abc",
              "object_key": "bbb/upgrade.bin"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "OtaPackageInfoDetail": {
      "allOf": [
        {
          "$ref": "#/definitions/OtaPackageInfo"
        },
        {
          "type": "object",
          "properties": {
            "file_location": {
              "description": "升级包的位置",
              "$ref": "#/definitions/FileLocation"
            }
          }
        }
      ],
      "description": "设备升级包详情信息"
    },
    "CreateOtaPackage": {
      "type": "object",
      "required": [
        "app_id",
        "file_location",
        "package_type",
        "product_id",
        "version"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "example": "61f7e74d036aca5be29e1ed4",
          "description": "**参数说明**:资源空间ID。存在多资源空间的用户需要使用该接口时,建议携带该参数指定创建的升级包归属到哪个资源空间下。\n**取值范围**:长度不超过36,只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$"
        },
        "package_type": {
          "type": "string",
          "example": "firmwarePackage",
          "description": "**参数说明**:升级包类型。\n**取值范围**:软件包必须设置为:softwarePackage,固件包必须设置为:firmwarePackage, 模块包必须设置为:modulePackage。",
          "pattern": "(firmwarePackage|softwarePackage|modulePackage)"
        },
        "product_id": {
          "type": "string",
          "example": "5ba24f5ebbe8f56f5a14f605",
          "description": "**参数说明**:设备关联的产品ID,用于唯一标识一个产品模型,创建产品后获得。方法请参见 [创建产品](https://support.huaweicloud.com/api-iothub/iot_06_v5_0050.html)。\n**取值范围**:长度不超过36,只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$"
        },
        "module_name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.\\-]{1,64}$",
          "example": "MCU",
          "description": "**参数说明**:OTA模块名称,产品下唯一且不可修改。当package_type为modulePackage时,支持该参数\n**取值范围**:长度不超过64,只允许英文字母、数字、下划线(_)、连接符(-)、英文点(.)的组合。"
        },
        "version": {
          "type": "string",
          "example": "V2.0",
          "description": "**参数说明**:升级包版本号。\n**取值范围**:长度不超过256,只允许字母、数字、下划线(_)、连接符(-)、英文点(.)的组合。",
          "pattern": "^[a-zA-Z0-9_.\\-]{1,256}$"
        },
        "support_source_versions": {
          "type": "array",
          "example": [
            "V1.0",
            "V1.1"
          ],
          "description": "**参数说明**:支持用于升级此版本包的设备源版本号列表。最多支持20个源版本号。\n**取值范围**:源版本号列表,源版本号只允许字母、数字、下划线(_)、连接符(-)、英文点(.)的组合。",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.\\-]{1,256}$"
          },
          "maxItems": 20
        },
        "description": {
          "type": "string",
          "example": "package for version V1.0 and V1.1",
          "description": "**参数说明**:用于描述升级包的功能等信息。\n**取值范围**:长度不超过1024。",
          "maxLength": 1024
        },
        "custom_info": {
          "type": "string",
          "example": "更新了XX功能,修复了XXXX问题",
          "description": "**参数说明**:推送给设备的自定义信息。添加该升级包完成,并创建升级任务后,物联网平台向设备下发升级通知时,会下发该自定义信息给设备。\n**取值范围**:长度不超过4096。",
          "maxLength": 4096
        },
        "file_location": {
          "description": "升级包的位置",
          "$ref": "#/definitions/FileLocation"
        }
      },
      "title": "添加升级包关联到OBS对象",
      "description": "添加升级包关联到OBS对象结构体"
    },
    "ObsLocation": {
      "type": "object",
      "required": [
        "bucket_name",
        "object_key",
        "region_name"
      ],
      "properties": {
        "region_name": {
          "type": "string",
          "example": "cn-north-4",
          "description": "**参数说明**:OBS所在区域。您可以从[地区和终端节点](https://developer.huaweicloud.com/endpoint?OBS)中查询服务的终端节点。\n**取值范围**:长度不超过256,只允许字母、数字、连接符(-)的组合。",
          "pattern": "^[a-zA-Z0-9-]{1,256}$"
        },
        "bucket_name": {
          "type": "string",
          "example": "abc",
          "description": "**参数说明**:OBS桶名称。\n**取值范围**:长度最小为3,最大为63,只允许小写字母、数字、连接符(-)、英文点(.)的组合。",
          "pattern": "^[a-z0-9.-]{3,63}$"
        },
        "object_key": {
          "type": "string",
          "example": "bbb/upgrade.bin",
          "description": "**参数说明**:OBS对象名称(包含文件夹路径)。\n**取值范围**:长度不超过1024。",
          "minLength": 1,
          "maxLength": 1024
        },
        "sign_method": {
          "type": "string",
          "example": "SHA256",
          "description": "**参数说明**:\n**取值范围**:只支持SHA256,不携带默认为SHA256。",
          "pattern": "(SHA256|MD5)"
        },
        "sign": {
          "type": "string",
          "example": "595124473f866b033dfa1f7e831c8c99a12f6143f392dfa996a819010842c99d",
          "description": "**参数说明**:SHA256算法计算出的升级包签名值。添加该升级包完成,并创建升级任务后,物联网平台向设备下发升级通知时,会下发该签名给设备。\n**取值范围**:长度为64,只允许大小写字母a到f、数字的组合。",
          "pattern": "^(?:[a-fA-F0-9]{32}|[a-fA-F0-9]{64})$"
        }
      },
      "description": "升级包在OBS的位置"
    },
    "OtaPackageInfo": {
      "properties": {
        "package_id": {
          "type": "string",
          "example": "28f61af50fc9452aa0ed5ea25c3cc3d3",
          "description": "**参数说明**:升级包ID,用于唯一标识一个升级包。由物联网平台分配获得。\n**取值范围**:长度不超过36,只允许字母、数字、连接符(-)的组合。"
        },
        "app_id": {
          "type": "string",
          "example": "61f7e74d036aca5be29e1ed4",
          "description": "**参数说明**:资源空间ID。\n**取值范围**:长度不超过36,只允许字母、数字、下划线(_)、连接符(-)的组合。"
        },
        "package_type": {
          "type": "string",
          "example": "firmwarePackage",
          "description": "**参数说明**:升级包类型。\n**取值范围**:软件包必须设置为:softwarePackage,固件包必须设置为:firmwarePackage。"
        },
        "product_id": {
          "type": "string",
          "example": "5ba24f5ebbe8f56f5a14f605",
          "description": "**参数说明**:设备关联的产品ID,用于唯一标识一个产品模型,创建产品后获得。方法请参见 [创建产品](https://support.huaweicloud.com/api-iothub/iot_06_v5_0050.html)。\n**取值范围**:长度不超过36,只允许字母、数字、下划线(_)、连接符(-)的组合。"
        },
        "product_name": {
          "type": "string",
          "description": "设备关联的产品名称",
          "example": "Thermometer"
        },
        "module_name": {
          "type": "string",
          "description": "**参数说明**:OTA模块名称,产品下唯一且不可修改。\n**取值范围**:长度不超过64,号只允许字母、数字、下划线(_)、连接符(-)、英文点(.)的组合。",
          "example": "MCU"
        },
        "version": {
          "type": "string",
          "example": "V2.0",
          "description": "**参数说明**:升级包版本号。\n**取值范围**:长度不超过256,只允许字母、数字、下划线(_)、连接符(-)、英文点(.)的组合。"
        },
        "support_source_versions": {
          "type": "array",
          "description": "**参数说明**:支持用于升级此版本包的设备源版本号列表。最多支持20个源版本号。\n**取值范围**:源版本号列表,源版本号只允许字母、数字、下划线(_)、连接符(-)、英文点(.)的组合。",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "example": "package for version V1.0 and V1.1",
          "description": "**参数说明**:用于描述升级包的功能等信息。\n**取值范围**:长度不超过1024。"
        },
        "custom_info": {
          "type": "string",
          "example": "更新了XX功能,修复了XXXX问题",
          "description": "**参数说明**:推送给设备的自定义信息。添加该升级包完成,并创建升级任务后,物联网平台向设备下发升级通知时,会下发该自定义信息给设备。\n**取值范围**:长度不超过4096。"
        },
        "create_time": {
          "type": "string",
          "example": "20230211T121212Z",
          "description": "软固件包上传到物联网平台的时间,格式:\"yyyyMMdd'T'HHmmss'Z'\"。"
        }
      },
      "description": "设备升级包信息"
    },
    "FileLocation": {
      "type": "object",
      "properties": {
        "obs_location": {
          "description": "升级包关联OBS对象位置",
          "$ref": "#/definitions/ObsLocation"
        }
      },
      "description": "升级包的位置"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "post",
  "uri": null
}