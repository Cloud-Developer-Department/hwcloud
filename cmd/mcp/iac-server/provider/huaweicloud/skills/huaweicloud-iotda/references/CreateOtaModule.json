{
  "name": "CreateOtaModule",
  "summary": "创建OTA模块",
  "tags": "OTA模块管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/ota-upgrades/modules": {
      "post": {
        "tags": [
          "OtaModuleManagement"
        ],
        "summary": "创建OTA模块",
        "description": "用户可调用此接口创建产品的OTA模块,同一产品下最多自定义10个OTA模块。",
        "operationId": "CreateOtaModule",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0079.html#section1) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "CreateOtaModuleRequestBody",
            "in": "body",
            "description": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateOtaModule"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/OtaModuleInfo"
            },
            "x-SuccessCode": true,
            "examples": {
              "application/json": {
                "module_id": "28f61af50fc9452aa0ed5ea25c3cc3d3",
                "app_id": "61f7e74d036aca5be29e1ed4",
                "product_id": "5ba24f5ebbe8f56f5a14f605",
                "product_name": "Thermometer",
                "module_name": "MCU",
                "alias_name": "微控制单元",
                "description": "微控制单元固件模块",
                "create_time": "20230211T121212Z"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "x-Error": [
              "IOTDA.019304",
              "IOTDA.013000"
            ]
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden",
            "x-Error": [
              "IOTDA.019303"
            ]
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-returnType": "ResponseEntity<OtaModuleInfo>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/ota-upgrades/modules",
        "x-request-examples-description-1": "创建OTA模块。",
        "x-request-examples-text-1": {
          "app_id": "61f7e74d036aca5be29e1ed4",
          "product_id": "5ba24f5ebbe8f56f5a14f605",
          "module_name": "MCU",
          "alias_name": "微控制单元",
          "description": "微控制单元固件模块"
        }
      }
    }
  },
  "definitions": {
    "OtaModuleInfo": {
      "title": "OTA模块对象",
      "description": "OTA模块信息",
      "properties": {
        "module_id": {
          "type": "string",
          "description": "OTA模块ID",
          "example": "28f61af50fc9452aa0ed5ea25c3cc3d3"
        },
        "app_id": {
          "type": "string",
          "description": "资源空间ID",
          "example": "61f7e74d036aca5be29e1ed4"
        },
        "product_id": {
          "type": "string",
          "description": "OTA模块关联的产品ID",
          "example": "5ba24f5ebbe8f56f5a14f605"
        },
        "product_name": {
          "type": "string",
          "description": "OTA模块关联的产品名称",
          "example": "Thermometer"
        },
        "module_name": {
          "type": "string",
          "description": "OTA模块名称。",
          "example": "MCU"
        },
        "alias_name": {
          "type": "string",
          "example": "微控制单元",
          "description": "OTA模块别名"
        },
        "description": {
          "description": "用于描述模块的功能等信息",
          "type": "string",
          "example": "MCU模块"
        },
        "create_time": {
          "type": "string",
          "description": "创建OTA模块的时间,格式:\"yyyyMMdd'T'HHmmss'Z'\"。",
          "example": "20230211T121212Z"
        }
      }
    },
    "CreateOtaModule": {
      "title": "添加OTA模块对象",
      "description": "添OTA模块对象结构体",
      "type": "object",
      "required": [
        "app_id",
        "product_id",
        "module_name"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "example": "61f7e74d036aca5be29e1ed4",
          "description": "**参数说明**:资源空间ID。存在多资源空间的用户需要使用该接口时,建议携带该参数指定创建的升级包归属到哪个资源空间下。\n**取值范围**:长度不超过36,只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$"
        },
        "product_id": {
          "type": "string",
          "example": "5ba24f5ebbe8f56f5a14f605",
          "description": "**参数说明**:设备关联的产品ID,用于唯一标识一个产品模型,创建产品后获得。方法请参见 [创建产品](https://support.huaweicloud.com/api-iothub/iot_06_v5_0050.html)。\n**取值范围**:长度不超过36,只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$"
        },
        "module_name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.\\-]{1,64}$",
          "example": "MCU",
          "description": "**参数说明**:OTA模块名称,产品下唯一且不可修改。\n**取值范围**:长度不超过64,只允许英文字母、数字、下划线(_)、连接符(-)、英文点(.)的组合。"
        },
        "alias_name": {
          "type": "string",
          "pattern": "^[\\一-\\龥a-zA-Z0-9_.\\-]{1,64}$",
          "example": "微控制单元",
          "description": "**参数说明**:OTA模块别名。\n**取值范围**:长度不超过64,只允许中文、英文字母、数字、下划线(_)、连接符(-)、英文点(.)的组合。"
        },
        "description": {
          "type": "string",
          "example": "微控制单元固件模块",
          "description": "**参数说明**:用于描述模块的功能等信息。\n**取值范围**:长度不超过1024。",
          "maxLength": 1024
        }
      }
    }
  },
