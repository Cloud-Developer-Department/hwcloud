{
  "name": "ShowDeviceCertificate",
  "summary": "查询设备证书",
  "tags": "设备证书",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/device-certificates/{certificate_id}": {
      "get": {
        "tags": [
          "DeviceCertificate"
        ],
        "summary": "查询设备证书",
        "description": "应用服务器可调用此接口在物联网平台更新一个设备证书状态。",
        "operationId": "ShowDeviceCertificate",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数说明**:用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "huaweicloud"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0121.html) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "certificate_id",
            "in": "path",
            "description": "**参数说明**:设备证书ID,用于唯一标识一个设备证书。在注册设备证书时由物联网平台分配获得。",
            "required": true,
            "type": "string",
            "pattern": "^[a-f0-9-]{1,36}$"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "certificate_id": "75a0c144-7c3c-4dac-9fd6-8c63dd9e969d",
                "common_name": "iot_device",
                "expiry_date": "20230810T070547Z",
                "fingerprint": "4838A6CCBC582DC22647005FBDFB2B110632DDDA5FCFB55B3307C122EFC2D1BA",
                "status": "ACTIVE",
                "certificate_pem": "-----BEGIN CERTIFICATE-----****-----END CERTIFICATE-----"
              }
            },
            "schema": {
              "$ref": "#/definitions/DeviceCertificateBase"
            }
          },
          "404": {
            "description": "Not Found",
            "x-Error": [
              "IOTDA.015500"
            ]
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-apig-name": "IoTDA_OpenAPI",
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-returnType": "ResponseEntity<DeviceCertificateBase>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/device-certificates/{certificate_id}"
      }
    }
  },
  "definitions": {
    "DeviceCertificateBase": {
      "type": "object",
      "properties": {
        "certificate_id": {
          "type": "string",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka",
          "description": "**参数说明**:设备证书ID。用来唯一标识一个设备证书",
          "pattern": "^[a-fA-F0-9]{24}$"
        },
        "common_name": {
          "type": "string",
          "example": "GlobalSign RSA OV SSL CA 2018",
          "description": "**参数说明**:设备证书通用名称。"
        },
        "expiry_date": {
          "type": "string",
          "example": "20230810T070547Z",
          "description": "**参数说明**:设备证书过期时间。"
        },
        "fingerprint": {
          "type": "string",
          "example": "4838A6CCBC582DC22647005FBDFB2B110632DDDA5FCFB55B3307C122EFC2D1BA",
          "description": "**参数说明**:设备证书SHA256指纹。"
        },
        "status": {
          "type": "string",
          "example": "ACTIVE",
          "description": "**参数说明**:设备证书状态,默认状态为激活\n- ACTIVE:激活状态。\n- INACTIVE:停用状态。"
        },
        "certificate_pem": {
          "type": "string",
          "description": "**参数说明**:设备证书PEM格式内容。"
        }
      },
      "title": "设备证书详情结构体",
      "description": "设备证书详情结构体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "get",
  "uri": null
}