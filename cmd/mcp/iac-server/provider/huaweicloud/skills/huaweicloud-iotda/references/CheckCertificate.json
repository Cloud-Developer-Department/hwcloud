{
  "name": "CheckCertificate",
  "summary": "验证设备CA证书",
  "tags": "设备CA证书管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/certificates/{certificate_id}/action": {
      "post": {
        "tags": [
          "CertificateManagement"
        ],
        "summary": "验证设备CA证书",
        "description": "应用服务器可调用此接口在物联网平台验证设备的CA证书,目的是为了验证用户持有设备CA证书的私钥",
        "operationId": "CheckCertificate",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Sp-Auth-Token",
            "in": "header",
            "description": "Sp用户Token。通过调用IoBPS服务获取SP用户Token",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "chinatelecom"
          },
          {
            "name": "Stage-Auth-Token",
            "in": "header",
            "description": "Stage用户的Token, 仅提供给IoStage服务使用",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "stage"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "certificate_id",
            "in": "path",
            "description": "设备CA证书ID,在上传设备CA证书时由平台分配的唯一标识。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[a-f0-9-]{1,36}$",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "action_id",
            "in": "query",
            "description": "对证书执行的操作,当前仅支持verify:校验证书",
            "required": true,
            "type": "string",
            "pattern": "(verify)"
          },
          {
            "in": "body",
            "name": "checkCertificateRequestBody",
            "description": "certificate",
            "required": true,
            "schema": {
              "$ref": "#/definitions/VerifyCertificateDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "string"
            },
            "x-SuccessCode": true
          },
          "400": {
            "description": "Bad Request",
            "x-Error": [
              "IOTDA.014301",
              "IOTDA.014307",
              "IOTDA.014308"
            ]
          },
          "403": {
            "description": "Forbidden",
            "x-Error": [
              "IOTDA.000021",
              "IOTDA.001006",
              "IOTDA.001007",
              "IOTDA.000022"
            ]
          },
          "404": {
            "description": "Not Found",
            "x-Error": [
              "IOTDA.014306"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IOTDA.000020"
            ]
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "iot_06_v5_0016",
        "x-externalAPI": true,
        "x-iftype": "OpenAPI_new",
        "x-returnType": "ResponseEntity<Void>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/certificates/{certificate_id}/action",
        "x-request-examples-1": {
