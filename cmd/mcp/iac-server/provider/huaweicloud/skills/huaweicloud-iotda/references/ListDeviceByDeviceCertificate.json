  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/device-certificates/{certificate_id}/list-device": {
      "post": {
        "tags": [
          "DeviceCertificate"
        ],
        "summary": "查询使用指定设备证书的设备列表",
        "description": "应用服务器可调用此接口在物联网平台查询使用指定设备证书的设备列表。",
        "operationId": "ListDeviceByDeviceCertificate",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数说明**:用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "huaweicloud"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0121.html) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "in": "body",
            "name": "ListDeviceByDeviceCertificateRequestBody",
            "description": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListDeviceRequest"
            }
          },
          {
            "name": "certificate_id",
            "in": "path",
            "description": "**参数说明**:设备证书ID,用于唯一标识一个设备证书。在注册设备证书时由物联网平台分配获得。",
            "required": true,
            "type": "string",
            "pattern": "^[a-f0-9-]{1,36}$"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "devices": [
                  {
                    "device_id": "04ed32dc1b0025b52fe3c01a27c2babc",
                    "app_id": "jeQDJQZltU8iKgFFoW060F5SGZka",
                    "node_id": "ABC123456789",
                    "gateway_id": "d4922d8a-6c8e-4396-852c-164aefa6638f",
                    "device_name": "dianadevice",
                    "product_id": "b640f4c203b7910fc3cbd446ed437cbd"
                  }
                ],
                "page": {
                  "count": 1,
                  "marker": "66178add3b98944277731d0a"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ListDeviceSimpleResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "x-Error": [
              "IOTDA.015500"
            ]
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-apig-name": "IoTDA_OpenAPI",
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-returnType": "ResponseEntity<ListDeviceSimpleResponse>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/device-certificates/{certificate_id}/list-device",
        "x-request-examples-description-1": "查询使用指定设备证书的设备列表",
        "x-request-examples-text-1": {
          "limit": 10,
          "marker": "ffffffffffffffffffffffff",
          "offset": 0
        }
      }
    }
  },
  "definitions": {
    "ListDeviceSimpleResponse": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "description": "设备证书列表",
          "items": {
            "$ref": "#/definitions/DeviceSimple"
          }
        },
        "page": {
          "description": "查询结果的分页信息。",
          "$ref": "#/definitions/Page"
        }
      },
      "title": "设备证书详情结构体",
      "description": "设备证书详情结构体"
    },
    "Page": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 100,
          "description": "满足查询条件的记录总数。"
        },
        "marker": {
          "type": "string",
          "example": "5c8f3d2d3df1f10d803adbda",
          "description": "本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。"
        }
      },
      "title": "查询批量响应的分页结构体",
      "description": "查询批量分页结构体,定义了分页页码、每页记录数、记录总数、该页记录的最大Id。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    },
    "DeviceSimple": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka",
          "description": "资源空间ID。",
          "x-isSensitive": true
        },
        "device_id": {
          "type": "string",
          "example": "d4922d8a-6c8e-4396-852c-164aefa6638f",
          "description": "设备ID,用于唯一标识一个设备。在注册设备时直接指定,或者由物联网平台分配获得。由物联网平台分配时,生成规则为\"product_id\" + \"_\" + \"node_id\"拼接而成。",
          "x-isSensitive": true
        },
        "node_id": {
          "type": "string",
          "example": "ABC123456789",
          "description": "设备标识码,通常使用IMEI、MAC地址或Serial No作为node_id。",
          "x-isSensitive": true
        },
        "gateway_id": {
          "type": "string",
          "example": "d4922d8a-6c8e-4396-852c-164aefa6638f",
          "description": "网关ID,用于标识设备所属的父设备,即父设备的设备ID。当设备是直连设备时,gateway_id与设备的device_id一致。当设备是非直连设备时,gateway_id为设备所关联的父设备的device_id。",
          "x-isSensitive": true
        },
        "device_name": {
          "type": "string",
          "example": "dianadevice",
          "description": "设备名称。",
          "x-isSensitive": true
        },
        "product_id": {
          "type": "string",
          "example": "b640f4c203b7910fc3cbd446ed437cbd",
          "description": "设备关联的产品ID,用于唯一标识一个产品模型。",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$",
          "x-isSensitive": true
        }
      },
      "title": "设备简单信息结构体",
      "description": "设备简单信息结构体"
    },
    "ListDeviceRequest": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "**参数说明**:分页查询时每页显示的记录数。\n**取值范围**:1-50的整数,默认值为10。",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "marker": {
          "type": "string",
          "description": "**参数说明**:上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。\n**取值范围**:长度为24的十六进制字符串,默认值为ffffffffffffffffffffffff。",
          "pattern": "^[a-fA-F0-9]{24}$",
          "default": "ffffffffffffffffffffffff"
        },
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "**参数说明**:表示从marker后偏移offset条记录开始查询。默认为0,取值范围为0-500的整数。当offset为0时,表示从marker后第一条记录开始输出。限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。\n**取值范围**:0-500的整数,默认为0。",
          "minimum": 0,
          "maximum": 500,
          "default": 0
        }
      },
      "title": "查询指定设备证书的设备列表结构体",
      "description": "查询指定设备证书的设备列表结构体。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    }
  },
