{
  "name": "ShowDeviceProxy",
  "summary": "查询设备代理详情",
  "tags": "设备代理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/device-proxies/{proxy_id}": {
      "get": {
        "tags": [
          "DeviceProxy"
        ],
        "summary": "查询设备代理详情",
        "description": "应用服务器可调用此接口查询物联网平台中指定设备代理的详细信息。",
        "operationId": "ShowDeviceProxy",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0121.html) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "proxy_id",
            "in": "path",
            "description": "**参数说明**:设备代理ID,用于唯一标识一个设备代理。在注册设备代理时由物联网平台分配获得。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9-]{36}$"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "proxy_id": "04ed32dc1b0025b52fe3c01a27c2babc",
                "proxy_name": "testAPP01",
                "app_id": "jeQDJQZltU8iKgFFoW060F5SGZka",
                "proxy_devices": [
                  "d4922d8a-6c8e-4396-852c-164aefa6638f",
                  "d4922d8a-6c8e-4396-852c-164aefa6638g"
                ],
                "effective_time_range": {
                  "start_time": "20200812T121212Z",
                  "end_time": "20210812T121212Z"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryDeviceProxyBase"
            }
          },
          "400": {
            "description": "Bad Request",
            "x-Error": [
              "IOTDA.015100"
            ]
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden",
            "x-Error": [
              "IOTDA.015101",
              "IOTDA.015102",
              "IOTDA.015103",
              "IOTDA.015104"
            ]
          },
          "404": {
            "description": "Not Found",
            "x-Error": [
              "IOTDA.015105"
            ]
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-apig-name": "IoTDA_API",
        "x-iftype": "OpenAPI_new",
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity",
        "x-returnType": "ResponseEntity<QueryDeviceProxyBase>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/device-proxies/{proxy_id}"
      }
    }
  },
  "definitions": {
    "QueryDeviceProxyBase": {
      "type": "object",
      "properties": {
        "proxy_id": {
          "type": "string",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka",
          "description": "**参数说明**:代理ID。用来唯一标识一个代理规则",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$"
        },
        "proxy_name": {
          "type": "string",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka",
          "description": "**参数说明**:设备代理名称"
        },
        "proxy_devices": {
          "type": "array",
          "example": [
            "d4922d8a-6c8e-4396-852c-164aefa6638f",
            "d4922d8a-6c8e-4396-852c-164aefa6638g"
          ],
          "description": "**参数说明**:代理设备组,组内所有设备共享网关权限,即组内任意一个网关下的子设备可以通过组里任意一个网关上线然后进行数据上报。",
          "items": {
            "type": "string"
          }
        },
        "effective_time_range": {
          "description": "**参数说明**:设备代理规则有效期",
          "$ref": "#/definitions/EffectiveTimeRangeResponseDTO"
        },
        "app_id": {
          "type": "string",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka",
          "description": "**参数说明**:资源空间ID。",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$"
        }
      },
      "title": "查询设备代理结构体",
      "description": "设备代理的基本信息。"
    },
    "EffectiveTimeRangeResponseDTO": {
      "type": "object",
      "required": [
        "end_time",
        "start_time"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "example": "20200812T121212Z",
          "description": "设备代理开始生效的时间,使用UTC时区,格式:yyyyMMdd'T'HHmmss'Z'"
        },
        "end_time": {
          "type": "string",
          "example": "20200812T121212Z",
          "description": "设备代理失效的时间,必须大于start_time,使用UTC时区,格式:yyyyMMdd'T'HHmmss'Z'"
        }
      },
      "x-serialVersionUID": "4654150370649286626"
    }
  },
