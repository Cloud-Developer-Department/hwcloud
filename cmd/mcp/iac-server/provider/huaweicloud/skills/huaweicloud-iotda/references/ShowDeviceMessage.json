{
  "name": "ShowDeviceMessage",
  "summary": "查询指定消息id的消息",
  "tags": "设备消息",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/devices/{device_id}/messages/{message_id}": {
      "get": {
        "tags": [
          "MessageManagement"
        ],
        "summary": "查询指定消息id的消息",
        "description": "应用服务器可调用此接口查询平台下发给设备的指定消息id的消息。",
        "operationId": "ShowDeviceMessage",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "device_id",
            "in": "path",
            "description": "**参数说明**:下发消息的设备ID,用于唯一标识一个设备,在注册设备时由物联网平台分配获得。\n**取值范围**:长度不超过128,只允许字母、数字、下划线(_)、连接符(-)的组合。",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0121.html) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "message_id",
            "in": "path",
            "description": "**参数说明**:下发消息的消息ID,用于唯一标识一个消息,在消息下发时由物联网平台分配获得。\n**取值范围**:长度不超过100,只允许字母、数字、下划线(_)、连接符(-)的组合。",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "message_id": "b1224afb-e9f0-4916-8220-b6bab568e888",
                "name": "message_name",
                "message": "string",
                "topic": "string",
                "status": "PENDING",
                "created_time": "20151212T121212Z",
                "finished_time": "20151212T121212Z"
              }
            },
            "schema": {
              "$ref": "#/definitions/DeviceMessage"
            },
            "x-SuccessCode": true
          },
          "403": {
            "description": "Forbidden",
            "x-Error": [
              "IOTDA.000021",
              "IOTDA.001006",
              "IOTDA.000022",
              "IOTDA.014018"
            ]
          },
          "404": {
            "description": "Not Found",
            "x-Error": [
              "IOTDA.014000"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IOTDA.000001",
              "IOTDA.000020"
            ]
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "iot_06_v5_0057",
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-returnType": "ResponseEntity<DeviceMessage>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/devices/{device_id}/messages/{message_id}",
        "x-request-examples-description-1": "查询指定的消息详情。"
      }
    }
  },
  "definitions": {
    "DeviceMessage": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "example": "b1224afb-e9f0-4916-8220-b6bab568e888",
          "description": "设备消息ID,用于唯一标识一条消息,在下发设备消息时由物联网平台分配获得。"
        },
        "name": {
          "type": "string",
          "example": "message_name",
          "description": "消息名称,在下发消息时由用户指定。"
        },
        "message": {
          "type": "object",
          "example": "HelloWorld",
          "description": "消息内容。",
          "properties": {}
        },
        "encoding": {
          "type": "string",
          "description": "消息内容编码格式,取值范围none|base64,默认值none, base64格式仅支持透传。"
        },
        "payload_format": {
          "type": "string",
          "description": "有效负载格式,在消息内容编码格式为none时有效,取值范围standard|raw,默认值standard(平台封装的标准格式),取值为raw时直接将消息内容作为有效负载下发。"
        },
        "topic": {
          "type": "string",
          "description": "消息topic"
        },
        "properties": {
          "description": "消息下行到设备的属性参数。",
          "$ref": "#/definitions/PropertiesDTO"
        },
        "status": {
          "type": "string",
          "example": "PENDING",
          "description": "消息状态,包含PENDING,DELIVERED,FAILED和TIMEOUT,PENDING指设备不在线,消息被缓存起来,等设备上线之后下发; DELIVERED指消息发送成功;FAILED消息发送失败;TIMEOUT指消息在平台默认时间内(1天)还没有下发送给设备,则平台会将消息设置为超时,状态为TIMEOUT。"
        },
        "error_info": {
          "description": "消息下发失败信息。",
          "$ref": "#/definitions/ErrorInfoDTO"
        },
        "created_time": {
          "type": "string",
          "example": "20151212T121212Z",
          "description": "消息的创建时间,\"yyyyMMdd'T'HHmmss'Z'\"格式的UTC字符串。"
        },
        "finished_time": {
          "type": "string",
          "example": "20151212T121212Z",
          "description": "消息结束时间, \"yyyyMMdd'T'HHmmss'Z'\"格式的UTC字符串,包含消息转换到DELIVERED和TIMEOUT两个状态的时间。"
        }
      },
      "title": "DeviceMessage 查询设备消息返回的具体消息结构体V5"
    },
    "ErrorInfoDTO": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "IOTDA.014112",
          "description": "**参数说明**:异常信息错误码,包含IOTDA.014016和IOTDA.014112。IOTDA.014016表示设备不在线;IOTDA.014112表示设备没有订阅topic。"
        },
        "error_msg": {
          "type": "string",
          "example": "Send to device failed, device not subscribe topic.",
          "description": "**参数说明**:异常信息说明,包含设备不在线和设备没有订阅topic说明。"
        }
      },
      "title": "异常信息结构体",
      "description": "异常信息"
    },
    "PropertiesDTO": {
      "type": "object",
      "properties": {
        "correlation_data": {
          "type": "string",
          "example": "d4922d8a-6c8e-4396-852c-164aefa6638q",
          "description": "**参数说明**:MQTT 5.0版本请求和响应模式中的相关数据,可选。用户可以通过该参数配置MQTT协议请求和响应模式中的相关数据。\n**取值范围**:长度不超过128,只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "pattern": "^[a-zA-Z0-9_-]{0,128}$"
        },
        "response_topic": {
          "type": "string",
          "example": "/device/message/response",
          "description": "**参数说明**:MQTT 5.0版本请求和响应模式中的响应主题,可选。用户可以通过该参数配置MQTT协议请求和响应模式中的响应主题。\n**取值范围**:长度不超过128, 只允许字母、数字、以及_-?=$#+/等字符的组合。",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_?=$#+/-]{0,128}$"
        },
        "user_properties": {
          "type": "array",
          "description": "**参数说明**:用户自定义属性,可选。用户可以通过该参数配置用户自定义属性。可以配置的最大自定义属性数量为20。",
          "items": {
            "$ref": "#/definitions/UserPropDTO"
          },
          "x-maxLength": 20,
          "x-minLength": 0
        }
      },
      "title": "属性数据结构体",
      "description": "属性数据",
      "x-imports": "java.util.List"
    },
    "UserPropDTO": {
      "type": "object",
      "properties": {
        "prop_key": {
          "type": "string",
          "example": "propKey1",
          "description": "**参数说明**:用户自定义属性键。\n**取值范围**:长度不超过128,只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "pattern": "^[a-zA-Z0-9_-]{0,128}$"
        },
        "prop_value": {
          "type": "string",
          "example": "propValue1",
          "description": "**参数说明**:用户自定义属性值。\n**取值范围**:长度不超过128,只允许中文、字母、数字、以及_? '#().,&%@!-等字符的组合。",
          "pattern": "^[\\一-\\龥a-zA-Z0-9_?'#()\\.,&%@!-]{0,128}$"
        }
      },
      "title": "用户自定义属性结构体",
      "description": "用户自定义属性"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "get",
  "uri": null
}