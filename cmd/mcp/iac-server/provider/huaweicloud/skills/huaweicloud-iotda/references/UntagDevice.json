        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apig-name": "IoTDA_API",
        "x-publishpath": "iot_06_v5_0010",
        "x-externalAPI": true,
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity;",
        "x-returnType": "ResponseEntity<Void>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/tags/unbind-resource",
        "x-request-examples-text-1": "{\n  \"resource_type\": \"device\",\n  \"resource_id\": \"d4922d8a\",\n  \"tag_keys\": [\n    \"string\"\n  ]\n}"
      }
    }
  },
  "definitions": {
    "UnbindTagsDTO": {
      "type": "object",
      "required": [
        "resource_id",
        "resource_type",
        "tag_keys"
      ],
      "properties": {
        "resource_type": {
          "type": "string",
          "example": "device",
          "description": "**参数说明**:要绑定标签的资源类型。\n**取值范围**:\n- device:设备。",
          "pattern": "(device)"
        },
        "resource_id": {
          "type": "string",
          "example": "d4922d8a",
          "description": "**参数说明**:要绑定标签的资源id。例如,资源类型为device,那么对应的资源id就是device_id。\n**取值范围**:长度不超过128,只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "tag_keys": {
          "type": "array",
          "description": "**参数说明**:指定资源要解绑的标签键列表,标签键列表中各项之间不允许重复,不能填写不存在的标签键值\n**取值范围**:标签键长度不超过64,只允许中文、字母、数字、以及_.-等字符的组合。",
          "items": {
            "type": "string",
            "description": "标签键,在同一资源下标签键唯一。"
          },
          "x-maxLength": 10,
          "x-minLength": 1,
          "x-annotations": [
            "@PatternInList(regexp = \"^[\\\\一-\\\\龥a-zA-Z0-9_.-]{1,64}$\")"
          ]
        }
      },
      "title": "解绑标签请求结构体",
      "description": "创建标签请求结构体。",
      "x-imports": "com.huawei.m2m.validator.PatternInList"
    }
  },
