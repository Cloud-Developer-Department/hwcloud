{
  "name": "UploadBatchTaskFile",
  "summary": "上传批量任务文件",
  "tags": "批量任务的文件管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/batchtask-files": {
      "post": {
        "tags": [
          "BatchTaskFile"
        ],
        "summary": "上传批量任务文件",
        "description": "应用服务器可调用此接口上传批量任务文件,用于创建批量任务。当前支持批量创建设备任务、批量删除设备任务、批量冻结设备任务、批量解冻设备任务的文件上传。\n- [批量注册设备模板](https://developer.obs.cn-north-4.myhuaweicloud.com/template/BatchCreateDevices_Template.xlsx)\n\n\n- [批量删除设备模板](https://developer.obs.cn-north-4.myhuaweicloud.com/template/BatchDeleteDevices_Template.xlsx)\n\n\n- [批量冻结设备模板](https://developer.obs.cn-north-4.myhuaweicloud.com/template/BatchFreezeDevices_Template.xlsx)\n\n\n- [批量解冻设备模板](https://developer.obs.cn-north-4.myhuaweicloud.com/template/BatchUnfreezeDevices_Template.xlsx)",
        "operationId": "UploadBatchTaskFile",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID。",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "pattern": "[a-f0-9-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "file",
            "in": "formData",
            "description": "**参数说明**:上传批量任务文件。\n**取值范围**:当前仅支持xlsx/xls文件格式,且文件最大行数为30000行。",
            "required": true,
            "type": "file"
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "examples": {
              "application/json": {
                "file_id": "0c3c77dd-42a2-4309-9e10-da2e8bf64ac3",
                "file_name": "BatchCreateDevices_test01.xlsx",
                "upload_time": "20200617T081608Z"
              }
            },
            "schema": {
              "$ref": "#/definitions/BatchTaskFile"
            }
          },
          "400": {
            "description": "BAD REQUEST",
            "x-Error": [
              "IOTDA.014602",
              "IOTDA.014603",
              "IOTDA.014604",
              "IOTDA.014605",
              "IOTDA.014606"
            ]
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "FORBIDDEN",
            "x-Error": [
              "IOTDA.000021",
              "IOTDA.000022",
              "IOTDA.001006",
              "IOTDA.014601"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IOTDA.000020"
            ]
          }
        },
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity",
        "x-support-sdk": "Y",
        "x-support-file": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "iot_06_v5_0021",
        "x-externalAPI": true,
        "x-iftype": "OpenAPI_new",
        "x-returnType": "ResponseEntity<BatchTaskFile>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/batchtask-files"
      }
    }
  },
  "definitions": {
    "BatchTaskFile": {
      "type": "object",
      "properties": {
        "file_id": {
          "type": "string",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka",
          "description": "上传的批量任务文件ID,由平台自动生成。",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "file_name": {
          "type": "string",
          "example": "testFile01",
          "description": "上传的批量任务文件名称。",
          "minLength": 1,
          "maxLength": 60
        },
        "upload_time": {
          "type": "string",
          "example": "20190303T081011Z",
          "description": "在物联网平台上传文件的时间。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "pattern": "^[TZ0-9_-]{1,16}$"
        }
      },
      "title": "查询上传的批量任务文件结构体。",
      "description": "查询上传的批量任务文件结构体。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
