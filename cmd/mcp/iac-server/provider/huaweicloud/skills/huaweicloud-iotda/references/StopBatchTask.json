  "paths": {
    "/v5/iot/{project_id}/batchtasks/{task_id}/stop": {
      "post": {
        "tags": [
          "BatchTask"
        ],
        "summary": "停止批量任务",
        "description": "应用服务器可调用此接口停止批量任务,目前只支持task_type为firmwareUpgrade,softwareUpgrade。如果task_id对应任务已经完成(成功、失败、部分成功,已经停止)或正在停止中,则不可以调用该接口。如果请求Body为{},则调用该接口后会停止所有正在执行中、等待中和失败待重试状态的子任务。",
        "operationId": "StopBatchTask",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID。",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "pattern": "[a-f0-9-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "task_id",
            "in": "path",
            "description": "**参数说明**:批量任务ID,创建批量任务时由物联网平台分配获得。\n**取值范围**:长度不超过24,只允许小写字母a到f、数字的组合。",
            "required": true,
            "type": "string",
            "pattern": "^[a-f0-9]{1,24}$"
          },
          {
