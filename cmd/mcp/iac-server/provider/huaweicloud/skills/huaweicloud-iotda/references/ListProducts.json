{
  "name": "ListProducts",
  "summary": "查询产品列表",
  "tags": "产品管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/products": {
      "get": {
        "tags": [
          "ProductManagement"
        ],
        "summary": "查询产品列表",
        "description": "应用服务器可调用此接口查询已导入物联网平台的产品模型信息列表,了解产品模型的概要信息。",
        "operationId": "ListProducts",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数说明**:分页查询时每页显示的记录数。\n**取值范围**:1-50的整数,默认值为10。",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "**参数说明**:上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。\n**取值范围**:长度为24的十六进制字符串,默认值为ffffffffffffffffffffffff。",
            "required": false,
            "type": "string",
            "default": "ffffffffffffffffffffffff",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          {
            "name": "app_id",
            "in": "query",
            "description": "**参数说明**:资源空间ID。此参数为非必选参数,存在多资源空间的用户需要使用该接口时,可以携带该参数查询指定资源空间下的产品列表,不携带该参数则会查询该用户下所有产品列表。\n**取值范围**:长度不超过36,只允许字母、数字、下划线(_)、连接符(-)的组合。",
            "required": false,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,36}$"
          },
          {
            "name": "product_name",
            "in": "query",
            "type": "string",
            "description": "**参数说明**:产品名称。\n**取值范围**:长度不超过64,只允许中文、字母、数字、以及_?'#().,&%@!-等字符的组合。",
            "x-annotations": [
              "@Pattern(regexp = \"^[\\一-\\龥a-zA-Z0-9_?'#().,&%@!-]{1,64}$\")"
            ]
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数说明**:表示从marker后偏移offset条记录开始查询。当offset为0时,表示从marker后第一条记录开始输出。限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。\n**取值范围**:0-500的整数,默认为0。",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 500,
            "minimum": 0,
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "examples": {
              "application/json": {
                "products": [
                  {
                    "app_id": "jeQDJQZltU8iKgFFoW060F5SGZka",
                    "app_name": "testAPP01",
                    "product_id": "5ba24f5ebbe8f56f5a14f605",
                    "name": "Thermometer",
                    "device_type": "Thermometer",
                    "protocol_type": "MQTT",
                    "data_format": "json",
                    "manufacturer_name": "ABC",
                    "industry": "smartCity",
                    "description": "this is a thermometer produced by Huawei",
                    "create_time": "20190303T081011Z"
                  }
                ],
                "page": {
                  "count": 10,
                  "marker": "5c90fa7d3c4e4405e8525079"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ProductSummarys"
            },
            "x-SuccessCode": true
          },
          "403": {
            "description": "FORBIDDEN",
            "x-Error": [
              "IOTDA.001006",
              "IOTDA.001007",
              "IOTDA.000022"
            ]
          }
        },
        "x-iftype": "OpenAPI_new",
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity;",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "iot_06_v5_0080",
        "x-externalAPI": true,
        "x-returnType": "ResponseEntity<ProductSummarys>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/products"
      }
    }
  },
  "definitions": {
    "ProductSummarys": {
      "type": "object",
      "properties": {
        "products": {
          "type": "array",
          "description": "产品信息列表。",
          "items": {
            "$ref": "#/definitions/ProductSummary"
          },
          "x-isSensitive": true
        },
        "page": {
          "description": "查询结果的分页信息。",
          "$ref": "#/definitions/Page"
        }
      },
      "title": "产品概要列表",
      "description": "产品概要列表。"
    },
    "Page": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 100,
          "description": "满足查询条件的记录总数。"
        },
        "marker": {
          "type": "string",
          "example": "5c8f3d2d3df1f10d803adbda",
          "description": "本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。"
        }
      },
      "title": "查询批量响应的分页结构体",
      "description": "查询批量分页结构体,定义了分页页码、每页记录数、记录总数、该页记录的最大Id。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    },
    "ProductSummary": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka",
          "description": "资源空间ID。"
        },
        "app_name": {
          "type": "string",
          "example": "testAPP01",
          "description": "资源空间名称。"
        },
        "product_id": {
          "type": "string",
          "example": "5ba24f5ebbe8f56f5a14f605",
          "description": "产品ID,用于唯一标识一个产品,在物联网平台创建产品后由平台分配获得。"
        },
        "name": {
          "type": "string",
          "example": "Thermometer",
          "description": "产品名称。"
        },
        "device_type": {
          "type": "string",
          "example": "Thermometer",
          "description": "设备类型。"
        },
        "protocol_type": {
          "type": "string",
          "example": "MQTT",
          "description": "设备使用的协议类型。取值范围:MQTT,CoAP,HTTP,HTTPS,Modbus,ONVIF, OPC-UA,OPC-DA,Other,TCP,UDP。"
        },
        "data_format": {
          "type": "string",
          "example": "json",
          "description": "设备上报数据的格式,取值范围:json,binary。"
        },
        "manufacturer_name": {
          "type": "string",
          "example": "ABC",
          "description": "厂商名称。"
        },
        "industry": {
          "type": "string",
          "example": "smartCity",
          "description": "设备所属行业。"
        },
        "description": {
          "type": "string",
          "example": "this is a thermometer produced by Huawei",
          "description": "产品的描述信息。"
        },
        "create_time": {
          "type": "string",
          "example": "20190303T081011Z",
          "description": "在物联网平台创建产品的时间,格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。"
        }
      },
      "title": "产品概要信息",
      "description": "产品概要信息。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
