{
  "name": "ListSecurityProfiles",
  "summary": "查询安全态势感知配置信息列表",
  "tags": "安全态势感知配置管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/security-profiles": {
      "get": {
        "tags": [
          "SecurityProfileManagement"
        ],
        "summary": "查询安全态势感知配置信息列表",
        "description": "接口说明:应用服务器调用该接口查询安全态势感知配置列表。",
        "operationId": "ListSecurityProfiles",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html)。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数说明**:用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "huaweicloud"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "security_type",
            "in": "query",
            "description": "**参数说明**:具体安全态势感知配置项名称。",
            "required": false,
            "type": "string",
            "pattern": "(DEVICE_MEMORY_CHECK|DEVICE_PORT_CHECK|DEVICE_CPU_USAGE_CHECK|DEVICE_DISK_SPACE_CHECK|DEVICE_BATTERY_PERCENTAGE_CHECK|DEVICE_LOGIN_LOCAL_CHECK|DEVICE_MALICIOUS_IP_CHECK|DEVICE_LOGIN_BRUTE_FORCE_CHECK|DEVICE_FILE_TAMPER_CHECK|INSECURE_TLS_PROTOCOL_CHECK|INSECURE_CIPHER_SUITE_CHECK|CONNECT_MULTIPLE_TIMES_CHECK|SECRET_COMPLEXITY_CHECK|TLS_CONNECT_CHECK|DEVICE_AUTH_FAIL_CHECK|DEVICE_OFFLINE_CHECK)"
          },
          {
            "name": "target_type",
            "in": "query",
            "description": "**参数说明**:绑定资源类型,当前仅支持产品。",
            "required": false,
            "type": "string",
            "pattern": "(PRODUCT)"
          },
          {
            "name": "target_id",
            "in": "query",
            "description": "**参数说明**:绑定资源ID。必须配合target_type一起使用,target_type为PRODUCT时,target_id格式为:资源空间ID:产品ID",
            "required": false,
            "type": "string",
            "pattern": "^[a-zA-Z0-9:_-]{1,128}$"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数说明**:分页查询时每页显示的记录数。\n**取值范围**:1-50的整数,默认值为10。",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "**参数说明**:上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。\n**取值范围**:长度为24的十六进制字符串,默认值为ffffffffffffffffffffffff。",
            "required": false,
            "type": "string",
            "default": "ffffffffffffffffffffffff",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数说明**:表示从marker后偏移offset条记录开始查询。当offset为0时,表示从marker后第一条记录开始输出。限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。\n**取值范围**:0-500的整数,默认为0。",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 500,
            "minimum": 0,
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "security_profiles": [
                  {
                    "profile_id": "04ed32dc1b0025b52fe3c01a27c2babc",
                    "security_type": "DEVICE_MEMORY_CHECK",
                    "alarm_level": "CRITICAL",
                    "security_level": "BASIC_SECURITY",
                    "enable": true,
                    "profile": [
                      {
                        "key": "memory_threshold",
                        "value": 80
                      }
                    ],
                    "profile_targets": {
                      "target_type": "PRODUCT",
                      "target_ids": [
                        "1d7616926636486cb05120018018cafc:67443bd4ad7db3647deb4f7a"
                      ]
                    }
                  }
                ],
                "page": {
                  "count": 10,
                  "marker": "5c90fa7d3c4e4405e8525079"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ListSecurityProfilesDTO"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-returnType": "ResponseEntity<ListSecurityProfilesDTO>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/security-profiles?security_type={security_type}",
        "x-request-examples-description-1": "查询租户下指定security_type类型的安全态势感知配置列表",
        "x-order": 0
      }
    }
  },
  "definitions": {
    "SecurityTarget": {
      "type": "object",
      "properties": {
        "target_type": {
          "type": "string",
          "description": "安全态势感知配置绑定的对象,目前仅支持PRODUCT产品级别,仅对设备级别的安全态势感知项生效。",
          "pattern": "(PRODUCT)"
        },
        "target_ids": {
          "type": "array",
          "description": "绑定对象id列表,target_type为PRODUCT时,由于产品ID在不同资源空间下可以重复,target_id格式为:资源空间ID:产品ID;资源空间ID与产品ID使用冒号拼接而成。",
          "items": {
            "type": "string"
          },
          "x-maxLength": 20,
          "x-minLength": 1,
          "x-annotations": [
            "@PatternInList(regexp = \"^[a-zA-Z0-9:_-]{1,128}$\")"
          ]
        }
      },
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern;javax.validation.Valid;com.huawei.m2m.validator.PatternInList;"
    },
    "SecurityProfileDTO": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": "string",
          "description": "安全态势感知配置id"
        },
        "security_type": {
          "type": "string",
          "description": "安全态势感知配置类型"
        },
        "alarm_level": {
          "type": "string",
          "description": "安全态势感知告警级别,CRITICAL:严重告警,MAJOR:重要告警,MINOR:一般告警"
        },
        "security_level": {
          "type": "string",
          "description": "安全态势感知项所属安全风险级别;BASIC_SECURITY:基础安全,ADVANCE_SECURITY:高级安全,ULTIMATE_SECURITY:极致安全"
        },
        "enable": {
          "type": "boolean",
          "description": "安全态势感知项是否开启"
        },
        "profile": {
          "type": "array",
          "description": "安全态势感知项配置结构体,用于设备侧检测项下发给设备",
          "items": {
            "$ref": "#/definitions/SecurityProfile"
          }
        },
        "profile_targets": {
          "description": "安全态势感知配置绑定对象结构体",
          "$ref": "#/definitions/SecurityTarget"
        }
      },
      "title": "安全态势感知配置结构体",
      "description": "安全态势感知配置"
    },
    "Page": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 100,
          "description": "满足查询条件的记录总数。"
        },
        "marker": {
          "type": "string",
          "example": "5c8f3d2d3df1f10d803adbda",
          "description": "本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。"
        }
      },
      "title": "查询批量响应的分页结构体",
      "description": "查询批量分页结构体,定义了分页页码、每页记录数、记录总数、该页记录的最大Id。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    },
    "SecurityProfile": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "安全态势感知项配置值名称"
        },
        "value": {
          "type": "object",
          "description": "安全态势感知项配置值,数据格式参考创建安全态势感知接口说明",
          "properties": {}
        }
      }
    },
    "ListSecurityProfilesDTO": {
      "type": "object",
      "properties": {
        "security_profiles": {
          "type": "array",
          "description": "安全态势感知配置信息列表。",
          "items": {
            "$ref": "#/definitions/SecurityProfileDTO"
          }
        },
        "page": {
          "$ref": "#/definitions/Page"
        }
      },
      "title": "安全态势感知配置列表",
      "description": "安全态势感知配置列表。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "get",
  "uri": null
}