  "definitions": {
    "PolicyTargetBase": {
      "type": "object",
      "required": [
        "target_id",
        "target_type"
      ],
      "properties": {
        "target_type": {
          "type": "string",
          "example": "device",
          "description": "**参数说明**:策略绑定的目标类型。\n**取值范围**:device|product|app,device表示设备,product表示产品,app表示整个资源空间。",
          "pattern": "(device|product|app)"
        },
        "target_id": {
          "type": "string",
          "example": "myDeviceId",
          "description": "策略绑定的目标ID"
        }
      },
      "title": "策略目标",
      "description": "策略目标",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern;javax.validation.Valid;"
    },
    "ShowTargetsInDevicePolicyRequestBody": {
      "type": "object",
      "properties": {
        "target_type": {
          "type": "string",
          "example": "product",
          "description": "**参数说明**:策略绑定的目标类型。\n**取值范围**:device|product|app,device表示设备,product表示产品,app表示整个资源空间。",
          "pattern": "(device|product|app)"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "**参数说明**:分页查询时每页显示的记录数。\n**取值范围**:1-50的整数,默认值为10。",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "marker": {
          "type": "string",
          "description": "**参数说明**:上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。\n**取值范围**:长度为24的十六进制字符串,默认值为ffffffffffffffffffffffff。",
          "pattern": "^[a-fA-F0-9]{24}$",
          "default": "ffffffffffffffffffffffff"
        },
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "**参数说明**:表示从marker后偏移offset条记录开始查询。默认为0,取值范围为0-500的整数。当offset为0时,表示从marker后第一条记录开始输出。限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。\n**取值范围**:0-500的整数,默认为0。",
          "minimum": 0,
          "maximum": 500,
          "default": 0
        }
      },
      "title": "策略目标查询请求结构体",
      "description": "策略目标查询请求结构体",
      "x-imports": "com.huawei.m2m.validator.PatternInList"
    },
    "Page": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 100,
          "description": "满足查询条件的记录总数。"
        },
        "marker": {
          "type": "string",
          "example": "5c8f3d2d3df1f10d803adbda",
          "description": "本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。"
        }
      },
      "title": "查询批量响应的分页结构体",
      "description": "查询批量分页结构体,定义了分页页码、每页记录数、记录总数、该页记录的最大Id。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    },
    "PolicyTargetResponse": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "array",
          "description": "策略绑定信息列表。",
          "items": {
            "$ref": "#/definitions/PolicyTargetBase"
          },
          "x-isSensitive": true
        },
        "page": {
          "description": "查询结果的分页信息。",
          "$ref": "#/definitions/Page"
        }
      }
    }
  },
