{
  "name": "ShowTargetsInDevicePolicy",
  "summary": "查询设备策略绑定的目标列表",
  "tags": "设备策略管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/device-policies/{policy_id}/list-targets": {
      "post": {
        "tags": [
          "PolicyManagement"
        ],
        "summary": "查询设备策略绑定的目标列表",
        "description": "应用服务器可调用此接口在物联网平台上查询指定策略ID下绑定的目标列表。",
        "operationId": "ShowTargetsInDevicePolicy",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0079.html#section1) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "policy_id",
            "in": "path",
            "description": "策略ID",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          {
            "in": "body",
            "name": "ShowTargetsInDevicePolicyRequestBody",
            "description": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ShowTargetsInDevicePolicyRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "targets": [
                  {
                    "target_type": "device",
                    "target_id": "64a7ba7ef9cb063d27e16b97_123456"
                  }
                ],
                "page": {
                  "marker": "5c90fa7d3c4e4405e8525079",
                  "count": 10
                }
              }
