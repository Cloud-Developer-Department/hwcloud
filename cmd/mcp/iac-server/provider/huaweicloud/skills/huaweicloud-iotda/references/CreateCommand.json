        "x-is-registered": "Y",
        "x-publishpath": "iot_06_v5_0038",
        "x-imports": "java.util.concurrent.CompletableFuture;",
        "x-iftype": "OpenAPI_new",
        "x-returnType": "CompletableFuture<DeviceCommandResponse>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/devices/{device_id}/commands",
        "x-request-examples-description-1": "创建命令,命令名为ON_OFF,命令为ON。",
        "x-request-examples-1": {
