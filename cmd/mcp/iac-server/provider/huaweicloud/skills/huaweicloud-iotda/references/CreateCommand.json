  },
  "definitions": {
    "DeviceCommandRequest": {
      "type": "object",
      "required": [
        "paras"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "example": "sensor",
          "description": "**参数说明**:设备命令所属的设备服务ID,在设备关联的产品模型中定义。\n**取值范围**:长度不超过64的字符串。",
          "maxLength": 64,
          "x-NotEmpty": false
        },
        "command_name": {
          "type": "string",
          "example": "ON_OFF",
          "description": "**参数说明**:设备命令名称,在设备关联的产品模型中定义。\n**取值范围**:长度不超过128的字符串。",
          "maxLength": 128,
          "x-NotEmpty": true
        },
        "paras": {
          "type": "object",
          "example": {
            "value": "ON"
          },
          "description": "**参数说明**:设备执行的命令,Json格式,里面是一个个键值对,如果serviceId不为空,每个键都是profile中命令的参数名(paraName);如果serviceId为空则由用户自定义命令格式。设备命令示例:{\"value\":\"1\"},具体格式需要应用和设备约定。此参数仅支持Json格式,暂不支持字符串。",
          "properties": {},
          "x-NotEmpty": true
        }
      },
      "title": "DeviceCommandRequest 创建设备命令的请求对象"
    },
    "DeviceCommandResponse": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "example": "b1224afb-e9f0-4916-8220-b6bab568e888",
          "description": "设备命令ID,用于唯一标识一条命令,在下发设备命令时由物联网平台分配获得。",
          "x-NotEmpty": false
        },
        "response": {
          "type": "object",
          "example": {
            "result_code": 0,
            "response_name": "COMMAND_RESPONSE",
            "paras": {
              "result": "success"
            }
          },
          "description": "设备上报的命令执行结果。Json格式,具体格式需要应用和设备约定。",
          "x-NotEmpty": false
        },
        "error_code": {
          "type": "string",
          "example": "IOTDA.014111",
          "description": "命令下发异常错误码。",
          "x-NotEmpty": false
        },
        "error_msg": {
          "type": "string",
          "example": "Command request timed out. Check whether the device returns a response within the specified time after receiving the request.",
          "description": "命令下发异常错误信息。",
          "x-NotEmpty": false,
          "properties": {}
        }
      },
      "title": "DeviceCommandResponse 创建设备命令返回结构体V5"
    }
