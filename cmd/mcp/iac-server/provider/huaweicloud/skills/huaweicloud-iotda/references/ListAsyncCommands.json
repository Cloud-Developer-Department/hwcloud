{
  "name": "ListAsyncCommands",
  "summary": "查询设备下队列中的命令",
  "tags": "设备异步命令",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/devices/{device_id}/async-commands": {
      "get": {
        "tags": [
          "AsyncCommandManagement"
        ],
        "summary": "查询设备下队列中的命令",
        "description": "查询设备下队列中的命令(处理中的命令),包含PENDING、SENT、DELIVERED三种状态,注意:DELIVERED状态的命令经过系统设定的一段时间(具体以系统配置为准)仍然没有更新,就会从队列中移除,变为历史命令。",
        "operationId": "ListAsyncCommands",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "device_id",
            "in": "path",
            "description": "**参数说明**:下发命令的设备ID,用于唯一标识一个设备,在注册设备时由物联网平台分配获得。\n**取值范围**:长度不超过128,只允许字母、数字、下划线(_)、连接符(-)的组合。",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0079.html#section1) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数说明**:分页查询时每页显示的记录数,默认值为10,取值范围为1-50的整数。",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "**参数说明**:上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。",
            "required": false,
            "type": "string",
            "default": "ffffffffffffffffffffffff",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数说明**:表示从marker后偏移offset条记录开始查询。默认为0,取值范围为0-500的整数。当offset为0时,表示从marker后第一条记录开始输出。限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 500,
            "minimum": 0,
            "format": "int32"
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "**参数说明**:查询命令下发时间在startTime之后的记录,格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
            "required": false,
            "type": "string",
            "pattern": "^[0-9]{8}[T]{1}[0-9]{6}[Z]{1}$"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "**参数说明**:查询命令下发时间在endTime之前的记录,格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
            "required": false,
            "type": "string",
            "pattern": "^[0-9]{8}[T]{1}[0-9]{6}[Z]{1}$"
          },
          {
            "name": "status",
            "in": "query",
            "description": "**参数说明**:命令状态。",
            "required": false,
            "type": "string",
            "pattern": "(PENDING|SENT|DELIVERED)"
          },
          {
            "name": "command_name",
            "in": "query",
            "description": "**参数说明**:命令名称。",
            "required": false,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "commands": [
                  {
                    "device_id": "d4922d8a-6c8e-4396-852c-164aefa6638f",
                    "command_id": "b1224afb-e9f0-4916-8220-b6bab568e888",
                    "service_id": "Switch",
                    "command_name": "ON_OFF",
                    "expire_time": 0,
                    "status": "PENDING",
                    "created_time": "20151212T121212Z",
                    "sent_time": "20151212T121212Z",
                    "delivered_time": "20151212T131212Z",
                    "send_strategy": "immediately",
                    "response_time": "20151212T131212Z"
                  }
                ],
                "page": {
                  "count": 100,
                  "marker": "5c8f3d2d3df1f10d803adbda"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryAsyncQueueCommandResponse"
            },
            "x-SuccessCode": true
          },
          "400": {
            "description": "Bad Request",
            "x-Error": [
              "IOTDM.000009",
              "IOTDM.000010"
            ]
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden",
            "x-Error": [
              "IOTDM.001006"
            ]
          },
          "404": {
            "description": "Not Found",
            "x-Error": [
              "IOTDM.014000"
            ]
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-iftype": "OpenAPI_new",
        "x-returnType": "ResponseEntity<QueryAsyncQueueCommandResponse>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/devices/{device_id}/async-commands",
        "x-request-examples-description-1": "查询设备下队列中的命令。"
      }
    }
  },
  "definitions": {
    "QueryAsyncQueueCommandResponse": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "description": "设备队列命令列表。",
          "items": {
            "$ref": "#/definitions/AsyncDeviceListCommand"
          }
        },
        "page": {
          "description": "查询结果的分页信息。",
          "$ref": "#/definitions/QueueCommandPage"
        }
      },
      "title": "QueryAsyncQueueCommandResponse 查询设备队列中的命令返回结构体V5"
    },
    "QueueCommandPage": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 100,
          "description": "满足查询条件的记录总数。"
        },
        "marker": {
          "type": "string",
          "example": "5c8f3d2d3df1f10d803adbda",
          "description": "本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。"
        }
      },
      "title": "查询批量队列命令响应的分页结构体",
      "description": "查询批量分页结构体,定义了分页页码、每页记录数、记录总数、该页记录的最大Id。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    },
    "AsyncDeviceListCommand": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "example": "d4922d8a-6c8e-4396-852c-164aefa6638f",
          "description": "设备ID,用于唯一标识一个设备,在注册设备时由物联网平台分配获得。"
        },
        "command_id": {
          "type": "string",
          "example": "b1224afb-e9f0-4916-8220-b6bab568e888",
          "description": "设备命令ID,用于唯一标识一条命令,在下发设备命令时由物联网平台分配获得。"
        },
        "service_id": {
          "type": "string",
          "example": "Switch",
          "description": "设备命令所属的设备服务ID,在设备关联的产品模型中定义。"
        },
        "command_name": {
          "type": "string",
          "example": "ON_OFF",
          "description": "设备命令名称,在设备关联的产品模型中定义。"
        },
        "expire_time": {
          "type": "integer",
          "format": "int32",
          "description": "物联网平台缓存命令的时长, 单位秒。"
        },
        "status": {
          "type": "string",
          "example": "PENDING",
          "description": "下发命令的状态。\n·PENDING表示未下发,在物联网平台缓存着\n·EXPIRED表示命令已经过期,即缓存的时间超过设定的expire_time\n·SENT表示命令正在下发\n·DELIVERED表示命令已送达设备\n·SUCCESSFUL表示命令已经成功执行\n·FAILED表示命令执行失败\n·TIMEOUT表示命令下发之后,没有收到设备确认或者响应结果一定时间后超时"
        },
        "created_time": {
          "type": "string",
          "example": "20151212T121212Z",
          "description": "命令的创建时间,\"yyyyMMdd'T'HHmmss'Z'\"格式的UTC字符串。"
        },
        "sent_time": {
          "type": "string",
          "example": "20151212T121212Z",
          "description": "物联网平台发送命令的时间,如果命令是立即下发, 则该时间与命令创建时间一致, 如果是缓存命令, 则是命令实际下发的时间。\"yyyyMMdd'T'HHmmss'Z'\"格式的UTC字符串。"
        },
        "delivered_time": {
          "type": "string",
          "example": "20151212T131212Z",
          "description": "物联网平台将命令送达到设备的时间,\"yyyyMMdd'T'HHmmss'Z'\"格式的UTC字符串。"
        },
        "send_strategy": {
          "type": "string",
          "example": "immediately",
          "description": "下发策略, immediately表示立即下发,delay表示缓存起来,等数据上报或者设备上线之后下发。"
        },
        "response_time": {
          "type": "string",
          "example": "20151212T131212Z",
          "description": "设备响应命令的时间,\"yyyyMMdd'T'HHmmss'Z'\"格式的UTC字符串。"
        }
      },
      "title": "AsyncDeviceListCommand 查询设备异步命令返回结构体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "get",
  "uri": null
}