          "pattern": "^[a-zA-Z0-9_-]{1,36}$",
          "example": "adadd5cb-6383-4b5b-a65c-f8c92fdf3c34"
        },
        "policy_name": {
          "type": "string",
          "description": "**参数说明**:数据流转积压策略名称。\n**取值范围**:长度不超过256,只允许中文、字母、数字、以及_?'#().,&%@!-等字符的组合。",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[\\一-\\龥a-zA-Z0-9_?'#()\\.,&%@!-]*$",
          "example": "policyName"
        },
        "description": {
          "type": "string",
          "description": "**参数说明**:用户自定义的数据流转积压策略描述。\n**取值范围**:长度不超过256,只允许中文、字母、数字、以及_?'#().,&%@!-等字符的组合。",
