{
  "name": "ListResourcesByTags",
  "summary": "按标签查询资源",
  "tags": "标签管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/tags/query-resources": {
      "post": {
        "tags": [
          "TagManagement"
        ],
        "summary": "按标签查询资源",
        "description": "应用服务器可调用此接口查询绑定了指定标签的资源。当前支持标签的资源有Device(设备)。",
        "operationId": "ListResourcesByTags",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数说明**:分页查询时每页显示的记录数。\n**取值范围**:1-50的整数,默认值为10。",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "**参数说明**:上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。\n**取值范围**:长度为24的十六进制字符串,默认值为ffffffffffffffffffffffff。",
            "required": false,
            "type": "string",
            "default": "ffffffffffffffffffffffff",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数说明**:表示从marker后偏移offset条记录开始查询。当offset为0时,表示从marker后第一条记录开始输出。限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。\n**取值范围**:0-500的整数,默认为0。",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 500,
            "minimum": 0,
            "format": "int32"
          },
          {
            "in": "body",
            "name": "ListResourcesByTagsRequestBody",
            "description": "请求结构体,见请求结构体说明",
            "required": false,
            "schema": {
              "$ref": "#/definitions/QueryResourceByTagsDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "resources": [
                  {
                    "resource_id": "d4922d8a"
                  }
                ],
                "page": {
                  "count": 10,
                  "marker": "5c90fa7d3c4e4405e8525079"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ResourcesDTO"
            },
            "x-SuccessCode": true
          },
          "400": {
            "description": "Bad Request",
            "x-Error": [
              "IOTDA.004004"
            ]
          },
          "403": {
            "description": "Forbidden",
            "x-Error": [
              "IOTDA.000021",
              "IOTDA.001006",
              "IOTDA.000022"
            ]
          },
          "404": {
            "description": "Not Found",
            "x-Error": [
              "IOTDA.004000"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IOTDA.000001",
              "IOTDA.000020"
            ]
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apig-name": "IoTDA_API",
        "x-publishpath": "iot_06_v5_0030",
        "x-externalAPI": true,
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity;",
        "x-returnType": "ResponseEntity<ResourcesDTO>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/tags/query-resources",
        "x-request-examples-1": {
          "resource_type": "device",
          "tags": [
            {
              "tag_key": "testTagName",
              "tag_value": "testTagValue"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "QueryResourceByTagsDTO": {
      "type": "object",
      "required": [
        "resource_type",
        "tags"
      ],
      "properties": {
        "resource_type": {
          "type": "string",
          "example": "device",
          "description": "**参数说明**:要查询的资源类型,当前支持设备(device)。",
          "pattern": "(device)"
        },
        "tags": {
          "type": "array",
          "description": "**参数说明**:标签列表,支持按照标签key和value组合查询,传入的多个标签之间是或的关系。",
          "items": {
            "$ref": "#/definitions/TagV5DTO"
          },
          "x-maxLength": 10,
          "x-minLength": 1
        }
      },
      "title": "按标签查询资源请求结构体",
      "description": "按标签查询资源请求结构体。"
    },
    "TagV5DTO": {
      "type": "object",
      "required": [
        "tag_key"
      ],
      "properties": {
        "tag_key": {
          "type": "string",
          "example": "testTagName",
          "description": "**参数说明**:标签键,在同一资源下标签键唯一。绑定资源时,如果设置的键已存在,则将覆盖之前的标签值。如果设置的键值不存在,则新增标签。\n**取值范围**:长度不超过64,只允许中文、字母、数字、以及_.-等字符的组合。",
          "pattern": "^[\\一-\\龥a-zA-Z0-9_.-]{1,64}$"
        },
        "tag_value": {
          "type": "string",
          "example": "testTagValue",
          "description": "**参数说明**:标签值。\n**取值范围**:长度不超过128,只允许中文、字母、数字、以及_.-等字符的组合。",
          "pattern": "^[\\一-\\龥a-zA-Z0-9_.-]{1,128}$"
        }
      },
      "title": "标签结构体",
      "description": "标签结构体。"
    },
    "Page": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 100,
          "description": "满足查询条件的记录总数。"
        },
        "marker": {
          "type": "string",
          "example": "5c8f3d2d3df1f10d803adbda",
          "description": "本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。"
        }
      },
      "title": "查询批量响应的分页结构体",
      "description": "查询批量分页结构体,定义了分页页码、每页记录数、记录总数、该页记录的最大Id。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    },
    "ResourcesDTO": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "description": "资源列表。",
          "items": {
            "$ref": "#/definitions/ResourceDTO"
          },
          "x-isSensitive": true
        },
        "page": {
          "description": "查询结果的分页信息。",
          "$ref": "#/definitions/Page"
        }
      },
      "title": "按标签查询资源响应结构体",
      "description": "按标签查询资源响应结构体。"
    },
    "ResourceDTO": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string",
          "example": "d4922d8a",
          "description": "资源id。例如,要查询的资源类型为device,那么对应的资源id就是device_id。"
        }
      },
      "title": "资源结构体",
      "description": "资源结构体。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "post",
  "uri": null
}