{
  "name": "ListCertificates",
  "summary": "获取设备CA证书列表",
  "tags": "设备CA证书管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/certificates": {
      "get": {
        "tags": [
          "CertificateManagement"
        ],
        "summary": "获取设备CA证书列表",
        "description": "应用服务器可调用此接口在物联网平台获取设备CA证书列表",
        "operationId": "ListCertificates",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Sp-Auth-Token",
            "in": "header",
            "description": "Sp用户Token。通过调用IoBPS服务获取SP用户Token",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "chinatelecom"
          },
          {
            "name": "Stage-Auth-Token",
            "in": "header",
            "description": "Stage用户的Token, 仅提供给IoStage服务使用",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "stage"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "app_id",
            "in": "query",
            "description": "资源空间ID。此参数为非必选参数,存在多资源空间的用户需要使用该接口时,可以携带该参数查询指定资源空间下的证书列表,不携带该参数则会查询该用户下所有证书列表。",
            "required": false,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,36}$"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "分页查询时每页显示的记录数,默认值为10,取值范围为1-50的整数。",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。",
            "required": false,
            "type": "string",
            "default": "ffffffffffffffffffffffffffffffffffff",
            "pattern": "^[a-zA-Z0-9_-]{1,36}$"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "表示从marker后偏移offset条记录开始查询。默认为0,取值范围为0-500的整数。当offset为0时,表示从marker后第一条记录开始输出。限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 500,
            "minimum": 0,
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "certificates": [
                  {
                    "certificate_id": "string",
                    "cn_name": "string",
                    "owner": "string",
                    "status": true,
                    "verify_code": "string",
                    "provision_enable": true,
                    "template_id": "61c970ce2d63eb6ee655dbf0",
                    "create_date": "20191212T121212Z",
                    "effective_date": "20191212T121212Z",
                    "expiry_date": "20221212T121212Z"
                  }
                ],
                "page": {
                  "count": 100,
                  "marker": "5c8f3d2d3df1f10d803adbda"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/GetCertificatesRsp"
            },
            "x-SuccessCode": true
          },
          "403": {
            "description": "Forbidden",
            "x-Error": [
              "IOTDA.000021",
              "IOTDA.001006",
              "IOTDA.001007",
              "IOTDA.000022"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IOTDA.000020"
            ]
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "iot_06_v5_0099",
        "x-externalAPI": true,
        "x-iftype": "OpenAPI_new",
        "x-returnType": "ResponseEntity<GetCertificatesRsp>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/certificates"
      }
    }
  },
  "definitions": {
    "CertificatesRspDTO": {
      "type": "object",
      "properties": {
        "certificate_id": {
          "type": "string",
          "description": "CA证书ID,在上传CA证书时由平台分配的唯一标识。"
        },
        "cn_name": {
          "type": "string",
          "description": "CA证书CN名称。",
          "x-isSensitive": true
        },
        "owner": {
          "type": "string",
          "description": "CA证书所有者。",
          "x-isSensitive": true
        },
        "status": {
          "type": "boolean",
          "description": "CA证书验证状态。true代表证书已通过验证,可进行设备证书认证接入。false代表证书未通过验证。",
          "x-isSensitive": true
        },
        "verify_code": {
          "type": "string",
          "description": "CA证书验证码。",
          "x-isSensitive": true
        },
        "provision_enable": {
          "type": "boolean",
          "description": "是否开启自注册能力,当为true时该功能必须配合自注册模板使用,true:是,false:否。"
        },
        "template_id": {
          "type": "string",
          "description": "绑定的自注册模板ID。"
        },
        "ocsp_enable": {
          "type": "boolean",
          "description": "是否开启该CA证书下的设备证书OCSP校验,当为true且设备证书信息中包含OCSP url时则平台会校验证书的状态,当证书状态为revoked时平台会拒绝设备连接,true:开启,false:关闭。"
        },
        "ocsp_server_ca_id": {
          "description": "ocsp服务器端CA证书id,仅当ocsp服务器开启SSL时配置,平台使用该CA证书认证ocsp服务器。",
          "type": "string",
          "example": "b8bcc4e2f8594d2ba59c7fc28ef8d547"
        },
        "ocsp_ssl_enable": {
          "description": "ocsp服务器是否开启SSL加密,开启后必须配置OCSP服务器CA证书。",
          "type": "boolean"
        },
        "create_date": {
          "type": "string",
          "example": "20191212T121212Z",
          "description": "创建证书日期。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "x-isSensitive": true
        },
        "effective_date": {
          "type": "string",
          "example": "20191212T121212Z",
          "description": "CA证书生效日期。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "x-isSensitive": true
        },
        "expiry_date": {
          "type": "string",
          "example": "20221212T121212Z",
          "description": "CA证书失效日期。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "x-isSensitive": true
        }
      }
    },
    "Page": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 100,
          "description": "满足查询条件的记录总数。"
        },
        "marker": {
          "type": "string",
          "example": "5c8f3d2d3df1f10d803adbda",
          "description": "本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。"
        }
      },
      "title": "查询批量响应的分页结构体",
      "description": "查询批量分页结构体,定义了分页页码、每页记录数、记录总数、该页记录的最大Id。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    },
    "GetCertificatesRsp": {
      "type": "object",
      "properties": {
        "certificates": {
          "type": "array",
          "description": "证书列表。",
          "items": {
            "$ref": "#/definitions/CertificatesRspDTO"
          },
          "x-isSensitive": true
        },
        "page": {
          "description": "查询结果的分页信息。",
          "$ref": "#/definitions/Page"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "get",
  "uri": null
}