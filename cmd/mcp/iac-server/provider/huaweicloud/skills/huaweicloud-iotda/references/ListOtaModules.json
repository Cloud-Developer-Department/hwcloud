{
  "name": "ListOtaModules",
  "summary": "查询OTA模块列表",
  "tags": "OTA模块管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/ota-upgrades/modules": {
      "get": {
        "tags": [
          "OtaModuleManagement"
        ],
        "operationId": "ListOtaModules",
        "x-imports": [
          "org.springframework.web.bind.annotation.ModelAttribute",
          "jakarta.validation.Valid",
          "org.springframework.http.ResponseEntity"
        ],
        "summary": "查询OTA模块列表",
        "description": "用户可调用此接口查询指定产品的OTA模块列表",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0079.html#section1) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "app_id",
            "in": "query",
            "description": "**参数说明**:资源空间ID。存在多资源空间的用户需要使用该接口时,建议携带该参数指定查询指定资源空间的升级包列表。\n**取值范围**:长度不超过36,只允许字母、数字、下划线(_)、连接符(-)的组合。",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,36}$"
          },
          {
            "name": "product_id",
            "in": "query",
            "description": "**参数说明**:设备关联的产品ID,用于唯一标识一个产品模型,创建产品后获得。方法请参见 [创建产品](https://support.huaweicloud.com/api-iothub/iot_06_v5_0050.html)。\n**取值范围**:长度不超过36,只允许字母、数字、下划线(_)、连接符(-)的组合。",
            "required": false,
            "pattern": "^[a-zA-Z0-9_-]{1,36}$",
            "type": "string"
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 50,
            "default": 10,
            "description": "**参数说明**:分页查询时每页显示的记录数。\n**取值范围**:1-50的整数,默认值为10。"
          },
          {
            "in": "query",
            "name": "marker",
            "required": false,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$",
            "default": "ffffffffffffffffffffffff",
            "description": "**参数说明**:上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。\n**取值范围**:长度为24的十六进制字符串,默认值为ffffffffffffffffffffffff。"
          },
          {
            "in": "query",
            "name": "offset",
            "description": "**参数说明**:表示从marker后偏移offset条记录开始查询。默认为0,取值范围为0-500的整数。当offset为0时,表示从marker后第一条记录开始输出。限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。 \n**取值范围**:0-500的整数,默认为0。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 500,
            "minimum": 0
          }
        ],
        "x-returnType": "ResponseEntity<OtaModuleInfos>",
        "responses": {
          "200": {
            "description": "OK",
            "x-SuccessCode": true,
            "schema": {
              "$ref": "#/definitions/OtaModuleInfos"
            },
            "examples": {
              "application/json": {
                "modules": [
                  {
                    "module_id": "28f61af50fc9452aa0ed5ea25c3cc3d3",
                    "app_id": "61f7e74d036aca5be29e1ed4",
                    "product_id": "5ba24f5ebbe8f56f5a14f605",
                    "product_name": "Thermometer",
                    "module_name": "MCU",
                    "alias_name": "微控制单元",
                    "description": "微控制单元固件模块",
                    "create_time": "20230211T121212Z"
                  }
                ],
                "page": {
                  "count": 10,
                  "marker": "5c90fa7d3c4e4405e8525079"
                }
              }
            }
          },
          "400": {
            "description": "BAD REQUEST"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "FORBIDDEN"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/ota-upgrades/modules",
        "x-request-examples-description-1": "列表查询OTA模块。"
      }
    }
  },
  "definitions": {
    "OtaModuleInfo": {
      "title": "OTA模块对象",
      "description": "OTA模块信息",
      "properties": {
        "module_id": {
          "type": "string",
          "description": "OTA模块ID",
          "example": "28f61af50fc9452aa0ed5ea25c3cc3d3"
        },
        "app_id": {
          "type": "string",
          "description": "资源空间ID",
          "example": "61f7e74d036aca5be29e1ed4"
        },
        "product_id": {
          "type": "string",
          "description": "OTA模块关联的产品ID",
          "example": "5ba24f5ebbe8f56f5a14f605"
        },
        "product_name": {
          "type": "string",
          "description": "OTA模块关联的产品名称",
          "example": "Thermometer"
        },
        "module_name": {
          "type": "string",
          "description": "OTA模块名称。",
          "example": "MCU"
        },
        "alias_name": {
          "type": "string",
          "example": "微控制单元",
          "description": "OTA模块别名"
        },
        "description": {
          "description": "用于描述模块的功能等信息",
          "type": "string",
          "example": "MCU模块"
        },
        "create_time": {
          "type": "string",
          "description": "创建OTA模块的时间,格式:\"yyyyMMdd'T'HHmmss'Z'\"。",
          "example": "20230211T121212Z"
        }
      }
    },
    "PageInfo": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 10,
          "description": "满足查询条件的记录总数。"
        },
        "marker": {
          "type": "string",
          "example": "5c90fa7d3c4e4405e8525079",
          "description": "本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。"
        }
      },
      "description": "查询批量分页结构体,定义了分页页码、每页记录数、记录总数、该页记录的最大Id。"
    },
    "OtaModuleInfos": {
      "title": "批量查询OTA模块对象",
      "description": "批量查询模块信息结果",
      "required": [
        "page"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "description": "模块列表",
          "items": {
            "$ref": "#/definitions/OtaModuleInfo"
          }
        },
        "page": {
          "$ref": "#/definitions/PageInfo"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "get",
  "uri": null
}