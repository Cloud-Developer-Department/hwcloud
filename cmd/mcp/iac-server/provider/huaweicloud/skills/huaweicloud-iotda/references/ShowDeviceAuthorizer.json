{
  "name": "ShowDeviceAuthorizer",
  "summary": "查询自定义鉴权详情",
  "tags": "自定义鉴权",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/device-authorizers/{authorizer_id}": {
      "get": {
        "tags": [
          "DeviceAuthorizer"
        ],
        "summary": "查询自定义鉴权详情",
        "description": "应用服务器可调用此接口在物联网平台查询指定自定义鉴权ID的详细信息。",
        "operationId": "ShowDeviceAuthorizer",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0079.html#section1) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "authorizer_id",
            "in": "path",
            "description": "自定义鉴权ID",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9-]{36}$"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "authorizer_id": "5c90fa7d3c4e4405e8525079",
                "authorizer_name": "myTest",
                "func_name": "mqtt_auth",
                "func_urn": "urn:fss:cn-north-5:d92d9c5eb8e347b5bb31ecfe5bc0c4e1:function:default:mqtt_auth:latest",
                "signing_enable": true,
                "signing_token": "string",
                "signing_public_key": "string",
                "default_authorizer": false,
                "status": "ACTIVE",
                "cache_enable": false,
                "create_time": "20231031T070547Z",
                "update_time": "20231031T070547Z"
              }
            },
            "schema": {
              "$ref": "#/definitions/DeviceAuthorizerBase"
            }
          },
          "404": {
            "description": "Not Found",
            "x-Error": [
              "IOTDA.015202"
            ]
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-apig-name": "IoTDA_API",
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-returnType": "ResponseEntity<DeviceAuthorizerBase>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/device-authorizers/{authorizer_id}",
        "x-request-examples-description-1": "查询指定id的自定义鉴权详情"
      }
    }
  },
  "definitions": {
    "DeviceAuthorizerBase": {
      "type": "object",
      "properties": {
        "authorizer_id": {
          "type": "string",
          "example": "61c42b5db8e64206a656202a",
          "description": "**参数说明**:自定义鉴权ID。"
        },
        "authorizer_name": {
          "type": "string",
          "example": "myTest",
          "description": "**参数说明**:自定义鉴权器名称,同一租户下的自定义鉴权器名称不能重复。\n**取值范围**:长度不超过128,只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "func_name": {
          "type": "string",
          "example": "mqtt_auth",
          "description": "**参数说明**:函数名称。",
          "minLength": 0,
          "maxLength": 65535
        },
        "func_urn": {
          "type": "string",
          "example": "urn:fss:cn-north-5:d92d9c5eb8e347b5bb31ecfe5bc0c4e1:function:default:mqtt_auth:latest",
          "description": "**参数说明**:函数的URN(Uniform Resource Name),唯一标识函数,即自定义鉴权器对应的处理函数地址。",
          "minLength": 0,
          "maxLength": 65535
        },
        "signing_enable": {
          "type": "boolean",
          "example": true,
          "description": "**参数说明**:是否启动签名校验,启动签名校验后不满足签名要求的鉴权信息将被拒绝,以减少无效的函数调用。推荐用户进行安全的签名校验,默认开启。",
          "default": true
        },
        "signing_token": {
          "type": "string",
          "example": "string",
          "description": "**参数说明**:签名校验的Key值,开启签名校验时使用。\n**取值范围**:长度不超过128,只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "signing_public_key": {
          "type": "string",
          "example": "string",
          "description": "**参数说明**:签名校验的公钥,开启签名校验时使用。用于认证设备携带的签名信息是否正确。",
          "minLength": 0,
          "maxLength": 65535
        },
        "default_authorizer": {
          "type": "boolean",
          "example": false,
          "description": "**参数说明**:是否为默认的鉴权方式,默认为false。",
          "default": false
        },
        "status": {
          "type": "string",
          "example": "ACTIVE",
          "description": "**参数说明**:是否激活该鉴权方式\n- ACTIVE:该鉴权为激活状态。\n- INACTIVE:该鉴权为停用状态。",
          "pattern": "(ACTIVE|INACTIVE)",
          "default": "INACTIVE"
        },
        "cache_enable": {
          "type": "boolean",
          "example": false,
          "description": "**参数说明**:是否开启缓存,默认为false,设备为true时,当设备入参(username,clientId,password,以及证书信息,函数urn)不变时,当缓存结果存在时,将直接使用缓存结果,建议在调试时设置为false,生产时设置为true,避免频繁调用函数。",
          "default": false
        },
        "create_time": {
          "type": "string",
          "example": "20231031T081011Z",
          "description": "在物联网平台进行自定义鉴权相关操作的时间。格式:yyyyMMdd'T'HHmmss'Z',如:20151212T121212Z。"
        },
        "update_time": {
          "type": "string",
          "example": "20231031T081011Z",
          "description": "在物联网平台更新自定义鉴权相关操作的时间。格式:yyyyMMdd'T'HHmmss'Z',如:20151212T121212Z。"
        }
      },
      "title": "自定义鉴权详情返回结构体。",
      "description": "自定义鉴权详情返回结构体。"
    }
  },
  "version": "2.0",
  "parameters": {},
