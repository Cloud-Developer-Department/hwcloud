          "minLength": 1,
          "maxLength": 256
        },
        "desired": {
          "description": "用户最近一次对设备下发的预期数据,Json格式,里面是一个个键值对,每个键都是产品模型中属性的参数名(property_name)。",
          "$ref": "#/definitions/DeviceShadowProperties"
        },
        "reported": {
          "description": "设备最近一次上报的属性数据,Json格式,里面是一个个键值对,每个键都是产品模型中属性的参数名(property_name)。",
          "$ref": "#/definitions/DeviceShadowProperties"
        },
        "version": {
          "type": "integer",
          "format": "int64",
          "example": 1,
          "description": "设备影子的版本,携带该参数时平台会校验值必须等于当前影子版本,初始从0开始。"
        }
