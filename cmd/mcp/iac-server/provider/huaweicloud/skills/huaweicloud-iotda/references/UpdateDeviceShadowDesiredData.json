          "properties": {}
        },
        "event_time": {
          "type": "string",
          "example": "20151212T121212Z",
          "description": "事件操作时间,格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "maxLength": 256
        }
      },
      "title": "设备影子数据属性结构体",
      "description": "设备影子数据属性结构体。"
    },
