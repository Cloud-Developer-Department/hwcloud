{
  "name": "ListDeviceCertificate",
  "summary": "查询设备证书列表",
  "tags": "设备证书",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/device-certificates": {
      "get": {
        "tags": [
          "DeviceCertificate"
        ],
        "summary": "查询设备证书列表",
        "description": "应用服务器可调用此接口在物联网平台查询设备证书列表。",
        "operationId": "ListDeviceCertificate",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数说明**:用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "huaweicloud"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0121.html) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "common_name",
            "in": "query",
            "description": "**参数说明**:证书通用名称,支持前缀模糊查询。\n**取值范围**:长度不超过32,只允许字母、数字、下划线(_)、连接符(-)以及(? '#()\\.,&%@!*)等字符的组合。",
            "required": false,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_? '#()\\.,&%@!-*]{4,32}$"
          },
          {
            "name": "fingerprint",
            "in": "query",
            "description": "**参数说明**:证书指纹。\n**取值范围**:长度为40的十六进制字符串或者长度为64的十六进制字符串。",
            "required": false,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40}$|^[a-fA-F0-9]{64}$"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数说明**:分页查询时每页显示的记录数。\n**取值范围**:1-50的整数,默认值为10。",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "**参数说明**:上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。\n**取值范围**:长度为24的十六进制字符串,默认值为ffffffffffffffffffffffff。",
            "required": false,
            "type": "string",
            "default": "ffffffffffffffffffffffff",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数说明**:表示从marker后偏移offset条记录开始查询。默认为0,取值范围为0-500的整数。当offset为0时,表示从marker后第一条记录开始输出。限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。\n**取值范围**:0-500的整数,默认为0。",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 500,
            "minimum": 0,
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "device_certificates": [
                  {
                    "certificate_id": "75a0c144-7c3c-4dac-9fd6-8c63dd9e969d",
                    "common_name": "iot_device",
                    "expiry_date": "20230810T070547Z",
                    "fingerprint": "4838A6CCBC582DC22647005FBDFB2B110632DDDA5FCFB55B3307C122EFC2D1BA",
                    "status": "ACTIVE"
                  }
                ],
                "page": {
                  "count": 1,
                  "marker": "66178add3b98944277731d0a"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ListDeviceCertificatesResponse"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-apig-name": "IoTDA_OpenAPI",
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-returnType": "ResponseEntity<ListDeviceCertificatesResponse>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/device-certificates"
      }
    }
  },
  "definitions": {
    "ListDeviceCertificatesResponse": {
      "type": "object",
      "properties": {
        "device_certificates": {
          "type": "array",
          "description": "设备证书列表",
          "items": {
            "$ref": "#/definitions/DeviceCertificateSimple"
          }
        },
        "page": {
          "description": "查询结果的分页信息。",
          "$ref": "#/definitions/Page"
        }
      },
      "title": "设备证书详情结构体",
      "description": "设备证书详情结构体"
    },
    "Page": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 100,
          "description": "满足查询条件的记录总数。"
        },
        "marker": {
          "type": "string",
          "example": "5c8f3d2d3df1f10d803adbda",
          "description": "本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。"
        }
      },
      "title": "查询批量响应的分页结构体",
      "description": "查询批量分页结构体,定义了分页页码、每页记录数、记录总数、该页记录的最大Id。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    },
    "DeviceCertificateSimple": {
      "type": "object",
      "properties": {
        "certificate_id": {
          "type": "string",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka",
          "description": "**参数说明**:设备证书ID。用来唯一标识一个设备证书",
          "pattern": "^[a-fA-F0-9]{24}$"
        },
        "common_name": {
          "type": "string",
          "example": "GlobalSign RSA OV SSL CA 2018",
          "description": "**参数说明**:设备证书通用名称。"
        },
        "expiry_date": {
          "type": "string",
          "description": "**参数说明**:设备证书过期时间。"
        },
        "fingerprint": {
          "type": "string",
          "description": "**参数说明**:设备证书SHA256指纹。"
        },
        "status": {
          "type": "string",
          "example": "ACTIVE",
          "description": "**参数说明**:设备证书状态,默认状态为激活\n- ACTIVE:激活状态。\n- INACTIVE:停用状态。"
        }
      },
      "title": "设备证书结构体",
      "description": "设备证书结构体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "get",
  "uri": null
}