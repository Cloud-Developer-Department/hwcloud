{
  "name": "ListServerCertificate",
  "summary": "获取服务器证书列表",
  "tags": "服务器证书管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/server-certificates": {
      "get": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-iftype": "OpenAPI_new",
        "x-apig-name": "IoTDA_OpenAPI",
        "tags": [
          "ServerCertificateManagement"
        ],
        "operationId": "ListServerCertificate",
        "x-externalAPI": false,
        "x-imports": [
          "org.springframework.web.bind.annotation.ModelAttribute",
          "jakarta.validation.Valid",
          "org.springframework.http.ResponseEntity"
        ],
        "summary": "获取服务器证书列表",
        "description": "应用服务器可调用此接口在物联网平台上获取服务器证书列表",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0079.html#section1) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "分页查询时每页显示的记录数,默认值为10,取值范围为1-50的整数。",
            "required": false,
            "minimum": 1,
            "maximum": 50,
            "type": "integer",
            "format": "int32",
            "default": 10
          },
          {
            "name": "marker",
            "in": "query",
            "description": "上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。",
            "required": false,
            "pattern": "^[a-zA-Z0-9_-]{1,36}$",
            "default": "ffffffffffffffffffffffffffffffffffff",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "表示从marker后偏移offset条记录开始查询。默认为0,取值范围为0-500的整数。当offset为0时,表示从marker后第一条记录开始输出。限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 500,
            "minimum": 0
          }
        ],
        "x-returnType": "ResponseEntity<ListServerCertificateDTO>",
        "responses": {
          "201": {
            "description": "Created",
            "x-SuccessCode": true,
            "examples": {
              "application/json": {
                "server_certificate_id": "60f8c49169d4840337930a4b",
                "common_name": "iotda",
                "effective_date": "20251212T121212Z",
                "expiry_date": "20301212T121212Z",
                "certificate_owner": "CN=Huawei Cloud Core Network Product CA, O=Huawei, C=CN",
                "certificate_issuer": "CN=Huawei Cloud Core Network Product CA, O=Huawei, C=CN"
              }
            },
            "schema": {
              "$ref": "#/definitions/ListServerCertificateDTO"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IOTDA.000020"
            ]
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/server-certificates",
        "x-request-examples-description-1": "获取服务器证书列表。"
      }
    }
  },
  "definitions": {
    "ServerCertificateDTO": {
      "description": "服务器证书结构体。",
      "title": "服务器证书结构体。",
      "type": "object",
      "properties": {
        "server_certificate_id": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$",
          "description": "唯一标识ID",
          "example": "5c90fa7d3c4e4405e8525079"
        },
        "common_name": {
          "description": "**参数说明**:证书通用名",
          "type": "string"
        },
        "effective_date": {
          "type": "string",
          "description": "证书生效日期。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "example": "20191212T121212Z"
        },
        "expiry_date": {
          "type": "string",
          "description": "证书失效日期。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "example": "20221212T121212Z"
        },
        "certificate_owner": {
          "type": "string",
          "description": "证书所有者。",
          "example": "CN=Huawei Cloud Core Network Product CA, O=Huawei, C=CN"
        },
        "certificate_issuer": {
          "type": "string",
          "description": "证书颁发者。",
          "example": "CN=Huawei Cloud Core Network Product CA, O=Huawei, C=CN"
        }
      }
    },
    "ListServerCertificateDTO": {
      "description": "域配置结构体",
      "type": "object",
      "properties": {
        "server_certificates": {
          "type": "array",
          "description": "**参数说明**:服务端证书列表。",
          "items": {
            "$ref": "#/definitions/ServerCertificateDTO"
          }
        },
        "page": {
          "description": "查询结果的分页信息。",
          "$ref": "#/definitions/Page"
        }
      }
    },
    "Page": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 100,
          "description": "满足查询条件的记录总数。"
        },
        "marker": {
          "type": "string",
          "example": "5c8f3d2d3df1f10d803adbda",
          "description": "本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。"
        }
      },
      "title": "查询批量响应的分页结构体",
      "description": "查询批量分页结构体,定义了分页页码、每页记录数、记录总数、该页记录的最大Id。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    }
  },
  "version": "2.0",
  "parameters": {},
