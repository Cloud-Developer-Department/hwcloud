              "IOTDA.003000",
              "IOTDA.014000"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IOTDA.000001"
            ]
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apig-name": "IoTDA_API",
        "x-publishpath": "iot_06_v5_0070",
        "x-externalAPI": true,
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-iftype": "OpenAPI_new",
        "x-returnType": "ResponseEntity<Void>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/device-group/{group_id}/action?action_id=addDevice&device_id=yourDeviceId",
        "x-request-examples-description-1": "添加设备到设备组",
        "x-request-examples-url-2": "POST https://{endpoint}/v5/iot/{project_id}/device-group/{group_id}/action?action_id=removeDevice&device_id=yourDeviceId",
        "x-request-examples-description-2": "从设备组中移除设备"
      }
    }
  },
