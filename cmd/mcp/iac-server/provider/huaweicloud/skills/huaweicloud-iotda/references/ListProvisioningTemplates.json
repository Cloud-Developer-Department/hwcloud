{
  "name": "ListProvisioningTemplates",
  "summary": "查询预调配模板列表",
  "tags": "预调配模板管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/provisioning-templates": {
      "get": {
        "tags": [
          "ProvisioningTemplateManagement"
        ],
        "summary": "查询预调配模板列表",
        "description": "应用服务器可调用此接口在物联网平台查询预调配模板列表。",
        "operationId": "ListProvisioningTemplates",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0079.html#section1) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "template_name",
            "in": "query",
            "description": "**参数说明**:预调配模板名称。\n**取值范围**:长度不超过128,只允许中文、字母、数字、下划线(_)、连接符(-)的组合。",
            "required": false,
            "type": "string",
            "pattern": "^[\\一-\\龥a-zA-Z0-9_-]{1,128}$"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数说明**:分页查询时每页显示的记录数。\n**取值范围**:1-50的整数,默认值为10。",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "**参数说明**:上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。\n**取值范围**:长度为24的十六进制字符串,默认值为ffffffffffffffffffffffff。",
            "required": false,
            "type": "string",
            "default": "ffffffffffffffffffffffff",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数说明**:表示从marker后偏移offset条记录开始查询。默认为0,取值范围为0-500的整数。当offset为0时,表示从marker后第一条记录开始输出。限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。\n**取值范围**:0-500的整数,默认为0。",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 500,
            "minimum": 0,
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "templates": [
                  {
                    "template_id": "5c90fa7d3c4e4405e8525079",
                    "template_name": "myTemplate",
                    "description": "myTemplate",
                    "create_time": "20230810T070547Z",
                    "update_time": "20230810T070547Z"
                  }
                ],
                "page": {
                  "count": 10,
                  "marker": "5c90fa7d3c4e4405e8525079"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ProvisioningTemplates"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-apig-name": "IoTDA_API",
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-returnType": "ResponseEntity<ProvisioningTemplates>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/provisioning-templates?template_name={template_name}",
        "x-request-examples-description-1": "查询租户下的预调配模板列表"
      }
    }
  },
  "definitions": {
    "ProvisioningTemplateSimple": {
      "type": "object",
      "properties": {
        "template_id": {
          "type": "string",
          "example": "61c42b5db8e64206a656202a",
          "description": "**参数说明**:预调配模板ID。",
          "pattern": "^[a-fA-F0-9]{24}$"
        },
        "template_name": {
          "type": "string",
          "example": "myTemplate",
          "description": "**参数说明**:预调配模板名称。\n**取值范围**:长度不超过128,只允许中文、字母、数字、下划线(_)、连接符(-)的组合。"
        },
        "description": {
          "type": "string",
          "example": "myTemplate",
          "description": "**参数说明**:预调配模板的描述信息。\n**取值范围**:长度不超过2048,只允许中文、字母、数字、以及_?'#().,&%@!-等字符的组合",
          "maxLength": 2048
        },
        "create_time": {
          "type": "string",
          "example": "20190303T081011Z",
          "description": "在物联网平台创建预调配模板的时间。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。"
        },
        "update_time": {
          "type": "string",
          "example": "20190303T081011Z",
          "description": "在物联网平台更新预调配模板的时间。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。"
        }
      },
      "title": "预调配模板返回结构体",
      "description": "预调配模板返回结构体。"
    },
    "Page": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 100,
          "description": "满足查询条件的记录总数。"
        },
        "marker": {
          "type": "string",
          "example": "5c8f3d2d3df1f10d803adbda",
          "description": "本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。"
        }
      },
      "title": "查询批量响应的分页结构体",
      "description": "查询批量分页结构体,定义了分页页码、每页记录数、记录总数、该页记录的最大Id。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    },
    "ProvisioningTemplates": {
      "type": "object",
      "properties": {
        "templates": {
          "type": "array",
          "description": "**参数说明**:预调配模板详情。",
          "items": {
            "$ref": "#/definitions/ProvisioningTemplateSimple"
          }
        },
        "page": {
          "description": "查询结果的分页信息。",
          "$ref": "#/definitions/Page"
        }
      },
      "title": "预调配模板列表。",
      "description": "预调配模板列表。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "get",
  "uri": null
