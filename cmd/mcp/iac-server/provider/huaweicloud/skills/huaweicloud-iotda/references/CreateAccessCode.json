  "paths": {
    "/v5/iot/{project_id}/auth/accesscode": {
      "post": {
        "tags": [
          "AccessCodeManagement"
        ],
        "summary": "生成接入凭证",
        "description": "接入凭证是用于客户端使用AMQP等协议与平台建链的一个认证凭据。只保留一条记录,如果重复调用只会重置接入凭证,使得之前的失效。",
        "operationId": "CreateAccessCode",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "in": "body",
            "name": "CreateAccessCodeRequestBody",
            "description": "生成接入凭证的请求结构体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateAccessCodeRequestBody"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "examples": {
              "application/json": {
                "access_key": "examples",
                "access_code": "examples"
              }
            },
            "schema": {
              "$ref": "#/definitions/AccessCodeDTO"
            },
            "x-SuccessCode": true
          },
          "403": {
            "description": "FORBIDDEN",
            "x-Error": [
              "IOTDA.000021",
              "IOTDA.000023"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IOTDA.000020"
            ]
          }
        },
        "x-iftype": "OpenAPI_new",
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "iot_06_v5_0111",
        "x-returnType": "ResponseEntity<AccessCodeDTO>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/auth/accesscode",
        "x-request-examples-1": {
          "type": "AMQP"
        }
      }
    }
  },
  "definitions": {
    "CreateAccessCodeRequestBody": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "example": "AMQP",
          "description": "**参数说明**:接入凭证类型,默认为AMQP的接入凭证类型。\n**取值范围**:\n- [AMQP,MQTT]",
          "minLength": 0,
          "maxLength": 16,
          "pattern": "(AMQP|MQTT)"
        },
        "force_disconnect": {
          "type": "boolean",
          "description": "**参数说明**: 是否将AMQP/MQTT连接断开",
          "example": true,
          "default": false
        }
      },
      "title": "生成接入凭证结构体",
