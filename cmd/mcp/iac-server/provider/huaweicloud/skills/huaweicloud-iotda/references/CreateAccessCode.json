          "minLength": 0,
          "maxLength": 8
        },
        "access_code": {
          "type": "string",
          "example": "examples code",
          "description": "接入凭证。",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "title": "接入凭证结构体",
