  "definitions": {
    "ServerCertificateConfig": {
      "description": "服务端证书配置结构体",
      "title": "创建服务端证书配置请求体。",
      "type": "object",
      "properties": {
        "ocsp_stapling_enable": {
          "description": "是否开启服务端OCSP装订",
          "type": "boolean",
          "default": false
        },
        "ocsp_server_ca_id": {
          "description": "ocsp服务器端CA证书id,仅当ocsp服务器为https协议时支持配置。",
          "type": "string",
          "pattern": "^[a-f0-9-]{1,36}$",
          "example": "5c90fa7d3c4e4405e8525079"
        },
        "ocsp_ssl_enable": {
          "description": "访问ocsp服务器是否开启SSL",
          "type": "boolean",
          "default": true
        }
      }
    },
    "CreateDomainConfigurationDTO": {
      "description": "创建域配置请求体。",
      "title": "创建域配置请求体。",
      "type": "object",
      "required": [
        "domain_name",
        "access_protocol",
        "server_certificate_id"
      ],
      "properties": {
        "domain_name": {
          "description": "**参数说明**:自定义域名",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "example": "iotda-device.cn-north-4.myhuaweicloud.com"
        },
        "access_protocol": {
          "description": "**参数说明**:接入协议,当前仅支持Device-MQTTS:设备接入MQTTS场景",
          "type": "string",
          "pattern": "Device-MQTTS",
          "example": "Device-MQTTS"
        },
        "server_certificate_id": {
          "description": "**参数说明**:自定义服务端证书ID",
          "type": "string",
          "pattern": "^[a-f0-9-]{1,36}$",
          "example": "5c90fa7d3c4e4405e8525079"
        },
        "server_certificate_config": {
          "description": "**参数说明**:服务端证书配置。",
          "$ref": "#/definitions/ServerCertificateConfig"
        }
      }
    },
    "DomainConfigurationDTO": {
      "description": "域配置结构体",
      "type": "object",
      "properties": {
        "configuration_id": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$",
          "description": "域配置唯一标识ID",
          "example": "5c90fa7d3c4e4405e8525079"
        },
        "domain_name": {
          "description": "**参数说明**:自定义域名",
          "type": "string",
          "example": "iotda-device.cn-north-4.myhuaweicloud.com"
        },
        "access_protocol": {
          "description": "**参数说明**:应用协议场景,当前仅支持Device-MQTTS:设备接入MQTTS场景",
          "type": "string",
          "pattern": "Device-MQTTS",
          "example": "Device-MQTTS"
        },
        "server_certificate_id": {
          "description": "**参数说明**:自定义服务端证书ID",
          "type": "string",
          "pattern": "^[a-f0-9-]{1,36}$",
          "example": "5c90fa7d3c4e4405e8525079"
        },
        "server_certificate_config": {
          "description": "**参数说明**:服务端证书配置。",
          "$ref": "#/definitions/ServerCertificateConfig"
        }
      }
    }
