{
  "name": "AddQueue",
  "summary": "创建AMQP队列",
  "tags": "AMQP队列管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/amqp-queues": {
      "post": {
        "tags": [
          "AmqpQueueManagement"
        ],
        "summary": "创建AMQP队列",
        "description": "应用服务器可调用此接口在物联网平台创建一个AMQP队列。每个租户只能创建100个队列,若超过规格,则创建失败,若队列名称与已有的队列名称相同,则创建失败。",
        "operationId": "AddQueue",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "in": "body",
            "name": "addQueueReQuestBody",
            "description": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/QueueInfo"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "examples": {
              "application/json": {
                "queue_id": "d4922d8a-6c8e-4396-852c-164aefa6638f",
                "queue_name": "myQueue0",
                "create_time": "20190303T081011Z",
                "last_modify_time": "20190303T081011Z"
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryQueueBase"
            }
          },
          "400": {
            "description": "Bad Request",
            "x-Error": [
              "IOTDA.016000"
            ]
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden",
            "x-Error": [
              "IOTDA.016001"
            ]
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "iot_06_v5_0103",
        "x-returnType": "ResponseEntity<QueryQueueBase>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/amqp-queues",
        "x-request-examples-1": {
          "queue_name": "myQueue0"
        }
      }
    }
  },
  "definitions": {
    "QueryQueueBase": {
      "type": "object",
      "properties": {
        "queue_id": {
          "type": "string",
          "example": "d4922d8a-6c8e-4396-852c-164aefa6638f",
          "description": "队列ID,用于唯一标识一个队列。",
          "pattern": "^[a-zA-Z0-9_-]{36}$"
        },
        "queue_name": {
          "type": "string",
          "example": "testQueue",
          "description": "队列名称,同一租户不允许重复。",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^([0-9a-zA-Z-_.:]+)$"
        },
        "create_time": {
          "type": "string",
          "example": "20190303T081011Z",
          "description": "在物联网平台创建队列的时间。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。"
        },
        "last_modify_time": {
          "type": "string",
          "example": "20190303T081011Z",
          "description": "在物联网平台最后修改队列的时间。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。"
        }
      },
      "title": "队列信信息结构体",
      "description": "队列信息结构体,返回基本信息。"
    },
    "QueueInfo": {
      "type": "object",
      "required": [
        "queue_name"
      ],
      "properties": {
        "queue_name": {
          "type": "string",
          "example": "testQueue",
          "description": "**参数说明**:队列名称,同一租户不允许重复。\n**取值范围**:长度不低于8不超过128,只允许字母、数字、下划线(_)、连接符(-)、间隔号(.)、冒号(:)的组合。",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^([0-9a-zA-Z-_.:]+)$"
        }
      },
      "title": "添加时队列结构体",
      "description": "添加时队列结构体。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern;javax.validation.Valid;"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "post",
  "uri": null
}