{
  "name": "AddCertificate",
  "summary": "上传设备CA证书",
  "tags": "设备CA证书管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/certificates": {
      "post": {
        "tags": [
          "CertificateManagement"
        ],
        "summary": "上传设备CA证书",
        "description": "应用服务器可调用此接口在物联网平台上传设备CA证书",
        "operationId": "AddCertificate",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Sp-Auth-Token",
            "in": "header",
            "description": "Sp用户Token。通过调用IoBPS服务获取SP用户Token",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "chinatelecom"
          },
          {
            "name": "Stage-Auth-Token",
            "in": "header",
            "description": "Stage用户的Token, 仅提供给IoStage服务使用",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "stage"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "in": "body",
            "name": "addCertificateRequestBody",
            "description": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateCertificateDTO"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "examples": {
              "application/json": {
                "certificate_id": "string",
                "cn_name": "string",
                "owner": "string",
                "status": true,
                "verify_code": "string",
                "provision_enable": true,
                "template_id": "61c970ce2d63eb6ee655dbf0",
                "create_date": "20191212T121212Z",
                "effective_date": "20191212T121212Z",
                "expiry_date": "20221212T121212Z"
              }
            },
            "schema": {
              "$ref": "#/definitions/CertificatesRspDTO"
            },
            "x-SuccessCode": true
          },
          "400": {
            "description": "Bad Request",
            "x-Error": [
              "IOTDA.014300",
              "IOTDA.014301",
              "IOTDA.014302",
              "IOTDA.014303",
              "IOTDA.014309"
            ]
          },
          "403": {
            "description": "Forbidden",
            "x-Error": [
              "IOTDA.000021",
              "IOTDA.001006",
              "IOTDA.001007",
              "IOTDA.001005",
              "IOTDA.000022"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IOTDA.000020"
            ]
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "iot_06_v5_0014",
        "x-externalAPI": true,
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity",
        "x-iftype": "OpenAPI_new",
        "x-returnType": "ResponseEntity<CertificatesRspDTO>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/certificates",
        "x-request-examples-1": {
          "app_id": "jeQDJQZltU8iKgFFoW060F5SGZka"
        }
      }
    }
  },
  "definitions": {
    "CreateCertificateDTO": {
      "type": "object",
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "string",
          "example": "-----BEGIN CERTIFICATE-----\nMIID2TCCAsGgAwIBAgIJAOEDEgVdVMn9MA0GCSqGSIb3DQEBCwUAMIGCMQswCQYD\nVQQGEwJDTjERMA8GA1UECAwIR3VhbmRvbmcxETAPBgNVBAcMCFNoZW56aGVuMQ8w\nDQYDVQQKDAZIdWF3ZWkxDDAKBgNVBAsMA2lvdDESMBAGA1UEAwwJMTIzNDU2Nzg5\nMRowGAYJKoZIhvcNAQkBFgtkamthQHFxLmNvbTAeFw0xOTEyMTkxMzE1MjZaFw0y\nMjEwMDgxMzE1MjZaMIGCMQswCQYDVQQGEwJDTjERMA8GA1UECAwIR3VhbmRvbmcx\nETAPBgNVBAcMCFNoZW56aGVuMQ8wDQYDVQQKDAZIdWF3ZWkxDDAKBgNVBAsMA2lv\ndDESMBAGA1UEAwwJMTIzNDU2Nzg5MRowGAYJKoZIhvcNAQkBFgtkamthQHFxLmNv\nbTCCASIwDQYJKoZIhvcNAQEBBQADggEPADCCAQoCggEBAM72QUzoadvLfxGjt3UF\noZ4MJbblqnRbouO4KpOVHBXyS2yQVl4CWWMhLh4pp2efNUSqKuXHjY3r68PquyNn\nYk8zO59zVc7JHvjGkBvo7DgPRAhEKPLJIpRzkmlCBbxwTNCjc3FovGb/sHHNlpGn\ncCKUzMfPGNZuBiuemskuEXL/eMHxDPbXYWn4Wq0wt+28PKUL5jybY7nsXSNnmAPF\nTO0CAmq0meUukubT/jHDCQ78ihQ/iqw1RNq88aCqRleoHiGg5nWkjL+05GXqUrqV\nVnZNL+YqcXzuVMs5XgyhNM2AsuH2g3D8ZuF6Dj9qY1n/v/Cp/DGpxP3A74SlplnF\nD/0CAwEAAaNQME4wHQYDVR0OBBYEFAVPWVtpTdO6KQnmVrrNlMguWNR7MB8GA1Ud\nIwQYMBaAFAVPWVtpTdO6KQnmVrrNlMguWNR7MAwGA1UdEwQFMAMBAf8wDQYJKoZI\nhvcNAQELBQADggEBAE40ViqK+UaEn++Xq6f4Cmeg3JqYHu47v9RIAASNihYRBQ/r\n3RE7Af3GqjIO5nMJJuCMzdcoAU8N9KwkgXD+GLR9fYLEoEmq5CrhgaGDsCi85vCs\nmWhj5z8r5TG207xpmvH2KT447dnG+chMBE594ma85dCv+0mCDrqNToElipgT8+rY\nAYVClnIt3kbsTg1vSRNHadd+TpgRVxJZBF0fHcCAyc/2f3UJgPYNWShIetHM6BdI\n3fZ4H+eeHPjagm5kzmffli1cUv2/N+1hKUvcI4uFCqEwZRFtp90RyIbxUfQwi+Cs\nXVnwV+BZS5qD9bTcfxZMXhuVRwO/5xWYMYPN1uY=\n-----END CERTIFICATE-----",
          "description": "证书内容信息。",
          "minLength": 1,
          "maxLength": 65535,
          "x-isSensitive": true
        },
        "app_id": {
          "type": "string",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka",
          "description": "资源空间ID。此参数为非必选参数,存在多资源空间的用户需要使用该接口时,建议携带该参数指定创建的证书归属到哪个资源空间下,否则创建的证书将会归属到[默认资源空间](https://support.huaweicloud.com/usermanual-iothub/iot_01_0006.html#section0)下。",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$"
        }
      },
      "title": "创建CA证书结构体",
      "description": "创建CA证书结构体。",
      "x-imports": "javax.validation.constraints.Size;javax.validation.constraints.NotNull;javax.validation.constraints.Pattern"
    },
    "CertificatesRspDTO": {
      "type": "object",
      "properties": {
        "certificate_id": {
          "type": "string",
          "description": "CA证书ID,在上传CA证书时由平台分配的唯一标识。"
        },
        "cn_name": {
          "type": "string",
          "description": "CA证书CN名称。",
          "x-isSensitive": true
        },
        "owner": {
          "type": "string",
          "description": "CA证书所有者。",
          "x-isSensitive": true
        },
        "status": {
          "type": "boolean",
          "description": "CA证书验证状态。true代表证书已通过验证,可进行设备证书认证接入。false代表证书未通过验证。",
          "x-isSensitive": true
        },
        "verify_code": {
          "type": "string",
          "description": "CA证书验证码。",
          "x-isSensitive": true
        },
        "provision_enable": {
          "type": "boolean",
          "description": "是否开启自注册能力,当为true时该功能必须配合自注册模板使用,true:是,false:否。"
        },
        "template_id": {
          "type": "string",
          "description": "绑定的自注册模板ID。"
        },
        "ocsp_enable": {
          "type": "boolean",
          "description": "是否开启该CA证书下的设备证书OCSP校验,当为true且设备证书信息中包含OCSP url时则平台会校验证书的状态,当证书状态为revoked时平台会拒绝设备连接,true:开启,false:关闭。"
        },
        "ocsp_server_ca_id": {
          "description": "ocsp服务器端CA证书id,仅当ocsp服务器开启SSL时配置,平台使用该CA证书认证ocsp服务器。",
          "type": "string",
          "example": "b8bcc4e2f8594d2ba59c7fc28ef8d547"
        },
        "ocsp_ssl_enable": {
          "description": "ocsp服务器是否开启SSL加密,开启后必须配置OCSP服务器CA证书。",
          "type": "boolean"
        },
        "create_date": {
          "type": "string",
          "example": "20191212T121212Z",
          "description": "创建证书日期。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "x-isSensitive": true
        },
        "effective_date": {
          "type": "string",
          "example": "20191212T121212Z",
          "description": "CA证书生效日期。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "x-isSensitive": true
        },
        "expiry_date": {
          "type": "string",
          "example": "20221212T121212Z",
          "description": "CA证书失效日期。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "x-isSensitive": true
        }
      }
    }
  },
