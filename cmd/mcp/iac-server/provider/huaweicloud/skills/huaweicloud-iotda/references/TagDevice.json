{
  "name": "TagDevice",
  "summary": "绑定标签",
  "tags": "标签管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/tags/bind-resource": {
      "post": {
        "tags": [
          "TagManagement"
        ],
        "summary": "绑定标签",
        "description": "应用服务器可调用此接口为指定资源绑定标签。当前支持标签的资源有Device(设备)。",
        "operationId": "TagDevice",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "in": "body",
            "name": "TagDeviceRequestBody",
            "description": "**参数说明**:请求结构体,见请求结构体说明",
            "required": false,
            "schema": {
              "$ref": "#/definitions/BindTagsDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "string"
            },
            "x-SuccessCode": true
          },
          "400": {
            "description": "Bad Request",
            "x-Error": [
              "IOTDA.004002",
              "IOTDA.004004"
            ]
          },
          "403": {
            "description": "Forbidden",
            "x-Error": [
              "IOTDA.000021",
              "IOTDA.004001",
              "IOTDA.001006",
              "IOTDA.000022"
            ]
          },
          "404": {
            "description": "Not Found",
            "x-Error": [
              "IOTDA.004000"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IOTDA.000020"
            ]
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apig-name": "IoTDA_API",
        "x-publishpath": "iot_06_v5_0009",
        "x-externalAPI": true,
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity;",
        "x-Note": "iot_前缀的为系统预留标签,用户不能使用;一个资源最多只能绑定10个标签。",
        "x-returnType": "ResponseEntity<Void>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/tags/bind-resource",
        "x-request-examples-1": {
          "resource_type": "device",
          "resource_id": "d4922d8a",
          "tags": [
            {
              "tag_key": "testTagName",
              "tag_value": "testTagValue"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "BindTagsDTO": {
      "type": "object",
      "required": [
        "resource_id",
        "resource_type",
        "tags"
      ],
      "properties": {
        "resource_type": {
          "type": "string",
          "example": "device",
          "description": "**参数说明**:要绑定标签的资源类型。\n**取值范围**:\n- device:设备。",
          "pattern": "(device)"
        },
        "resource_id": {
          "type": "string",
          "example": "d4922d8a",
          "description": "**参数说明**:要绑定标签的资源id。例如,资源类型为device,那么对应的资源id就是device_id。\n**取值范围**:长度不超过128,只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "tags": {
          "type": "array",
          "description": "**参数说明**:要绑定到指定资源的标签列表,标签列表中各项标签键值之间不允许重复,一个资源最多可以绑定10个标签。",
          "items": {
            "$ref": "#/definitions/TagV5DTO"
          },
          "x-maxLength": 10,
          "x-minLength": 1
        }
      },
      "title": "绑定标签请求结构体",
      "description": "创建标签请求结构体。"
    },
    "TagV5DTO": {
      "type": "object",
      "required": [
        "tag_key"
      ],
      "properties": {
        "tag_key": {
          "type": "string",
          "example": "testTagName",
          "description": "**参数说明**:标签键,在同一资源下标签键唯一。绑定资源时,如果设置的键已存在,则将覆盖之前的标签值。如果设置的键值不存在,则新增标签。\n**取值范围**:长度不超过64,只允许中文、字母、数字、以及_.-等字符的组合。",
          "pattern": "^[\\一-\\龥a-zA-Z0-9_.-]{1,64}$"
        },
        "tag_value": {
          "type": "string",
          "example": "testTagValue",
          "description": "**参数说明**:标签值。\n**取值范围**:长度不超过128,只允许中文、字母、数字、以及_.-等字符的组合。",
          "pattern": "^[\\一-\\龥a-zA-Z0-9_.-]{1,128}$"
        }
      },
      "title": "标签结构体",
      "description": "标签结构体。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "post",
  "uri": null
}