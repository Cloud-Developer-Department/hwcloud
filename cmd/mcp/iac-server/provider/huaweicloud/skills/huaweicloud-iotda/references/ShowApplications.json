{
  "name": "ShowApplications",
  "summary": "查询资源空间列表",
  "tags": "资源空间管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/apps": {
      "get": {
        "tags": [
          "ApplicationManagement"
        ],
        "summary": "查询资源空间列表",
        "description": "资源空间对应的是物联网平台原有的应用,在物联网平台的含义与应用一致,只是变更了名称。应用服务器可以调用此接口查询资源空间列表。",
        "operationId": "ShowApplications",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 0,
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "default_app",
            "in": "query",
            "description": "**参数说明**:默认资源空间标识,不携带则查询所有资源空间。\n**取值范围**:\n- true:查询默认资源空间。\n- false:查询非默认资源空间。",
            "required": false,
            "type": "boolean",
            "x-example": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "examples": {
              "application/json": {
                "applications": [
                  {
                    "app_id": "0ab87ceecbfc49acbcc8d5acdef3c68c",
                    "app_name": "testApp",
                    "create_time": "20151212T121212Z",
                    "default_app": true
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ApplicationsDTO"
            },
            "x-SuccessCode": true
          },
          "403": {
            "description": "FORBIDDEN",
            "x-Error": [
              "IOTDA.000021"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IOTDA.000020"
            ]
          }
        },
        "x-iftype": "OpenAPI_new",
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "iot_06_v5_6011",
        "x-returnType": "ResponseEntity<ApplicationsDTO>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/apps"
      }
    }
  },
