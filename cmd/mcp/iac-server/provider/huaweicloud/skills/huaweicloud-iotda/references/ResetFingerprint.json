{
  "name": "ResetFingerprint",
  "summary": "重置设备指纹",
  "tags": "设备管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/devices/{device_id}/reset-fingerprint": {
      "post": {
        "tags": [
          "DeviceManagement"
        ],
        "summary": "重置设备指纹",
        "description": "应用服务器可调用此接口重置设备指纹。携带指定设备指纹时将之重置为指定值;不携带时将之置空,后续设备第一次接入时,该设备指纹的值将设置为第一次接入时的证书指纹。",
        "operationId": "ResetFingerprint",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "device_id",
            "in": "path",
            "description": "**参数说明**:设备ID,用于唯一标识一个设备。在注册设备时直接指定,或者由物联网平台分配获得。由物联网平台分配时,生成规则为\"product_id\" + \"_\" + \"node_id\"拼接而成。\n**取值范围**:长度不超过128,只允许字母、数字、下划线(_)、连接符(-)的组合。",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$"
          },
          {
            "in": "body",
            "name": "ResetFingerprintRequestBody",
            "description": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ResetFingerprint"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "device_id": "d4922d8a-6c8e-4396-852c-164aefa6638f",
                "fingerprint": "dc0f****f22f"
              }
            },
            "schema": {
              "$ref": "#/definitions/DeviceFingerprint"
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "iot_06_v5_0196",
        "x-apig-name": "IoTDA_API",
        "x-externalAPI": true,
        "x-interfaceRisk": "HIGH",
        "x-iftype": "OpenAPI_new",
        "x-returnType": "ResponseEntity<DeviceFingerprint>",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/devices/{device_id}/reset-fingerprint",
        "x-request-examples-1": {
          "fingerprint": "dc0f1016f495157344ac5f1296335cff725ef22f"
        }
      }
    }
  },
  "definitions": {
    "ResetFingerprint": {
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string",
          "example": "dc0f1016f495157344ac5f1296335cff725ef22f",
          "description": "**参数说明**:设备指纹。设置该字段时平台将设备指纹重置为指定值;不携带时将之置空,后续设备第一次接入时,该设备指纹的值将设置为第一次接入时的证书指纹。\n**取值范围**:长度为40的十六进制字符串或者长度为64的十六进制字符串。",
          "pattern": "^[a-fA-F0-9]{40}$|^[a-fA-F0-9]{64}$",
          "x-sensitive": true
        },
        "force_disconnect": {
          "type": "boolean",
          "example": false,
          "description": "**参数说明**:是否强制断开设备的连接,当前仅限长连接。默认值false。",
          "default": false
        },
        "fingerprint_type": {
          "description": "**参数说明**:重置设备证书指纹的的类型。\n**取值范围**:\n- PRIMARY:重置主指纹。设备证书鉴权优先使用的指纹,当设备接入物联网平台时,平台将优先使用主指纹进行校验。\n- SECONDARY:重置辅指纹。设备的备用指纹,当主指纹校验不通过时,会启用辅指纹校验,辅指纹与主指纹有相同的效力。",
          "pattern": "PRIMARY|SECONDARY",
          "type": "string",
          "example": "PRIMARY",
          "default": "PRIMARY"
        }
      },
      "title": "重置设备指纹请求结构体"
    },
    "DeviceFingerprint": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "example": "d4922d8a-6c8e-4396-852c-164aefa6638f",
          "description": "设备ID,用于唯一标识一个设备。在注册设备时直接指定,或者由物联网平台分配获得。由物联网平台分配时,生成规则为\"product_id\" + \"_\" + \"node_id\"拼接而成。",
          "maxLength": 256,
          "x-isSensitive": true
        },
        "fingerprint": {
          "type": "string",
          "example": "dc0f1016f495157344ac5f1296335cff725ef22f",
          "description": "设备指纹。",
          "pattern": "^[a-fA-F0-9]{40}$|^[a-fA-F0-9]{64}$",
          "x-isSensitive": true
        },
        "fingerprint_type": {
          "description": "**参数说明**:重置设备证书指纹的的类型。\n**取值范围**:\n- PRIMARY:重置主指纹。\n- SECONDARY:重置辅指纹。",
          "pattern": "PRIMARY|SECONDARY",
          "type": "string",
          "example": "PRIMARY",
          "default": "PRIMARY"
        }
      },
      "title": "重置设备指纹响应结构体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "post",
  "uri": null
}