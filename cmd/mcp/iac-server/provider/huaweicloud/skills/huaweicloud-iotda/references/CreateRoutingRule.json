          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\一-\\龥a-zA-Z0-9_?'#()\\.,&%@!-]*$"
        },
        "description": {
          "type": "string",
          "example": "description",
          "description": "**参数说明**:用户自定义的规则描述。",
          "minLength": 1,
          "maxLength": 256
        },
        "subject": {
          "description": "**参数说明**:资源事件信息。",
          "$ref": "#/definitions/RoutingRuleSubject"
        },
        "app_type": {
          "type": "string",
          "example": "GLOBAL",
          "description": "**参数说明**:租户规则的生效范围,默认GLOBAL,。\n**取值范围**:\n- GLOBAL:生效范围为租户级。\n- APP:生效范围为资源空间级。如果类型为APP,创建的规则生效范围为携带的app_id指定的资源空间,不携带app_id则创建规则生效范围为[默认资源空间](https://support.huaweicloud.com/usermanual-iothub/iot_01_0006.html#section0)。",
          "pattern": "(GLOBAL|APP)"
        },
        "app_id": {
          "type": "string",
          "example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0",
          "description": "**参数说明**:资源空间ID。。\n**取值范围**:长度不超过36,只允许字母、数字、下划线(_)、连接符(-)的组合。",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$"
        },
        "select": {
