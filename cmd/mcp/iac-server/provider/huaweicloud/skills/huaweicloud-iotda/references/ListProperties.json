{
  "name": "ListProperties",
  "summary": "查询设备属性",
  "tags": "设备属性",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/devices/{device_id}/properties": {
      "get": {
        "tags": [
          "PropertiesManagement"
        ],
        "summary": "查询设备属性",
        "description": "设备的产品模型中定义了物联网平台可向设备下发的属性,应用服务器可调用此接口向设备发送指令用以查询设备的实时属性, 并由设备将属性查询的结果同步返回给应用服务器。\n注意:此接口适用于MQTT设备,暂不支持NB-IoT设备。",
        "operationId": "ListProperties",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "description": "**参数说明**:下发属性的设备ID,用于唯一标识一个设备,在注册设备时由物联网平台分配获得。\n**取值范围**:长度不超过128,只允许字母、数字、下划线(_)、连接符(-)的组合。",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0121.html) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "service_id",
            "in": "query",
            "description": "**参数说明**:设备的服务ID,在设备关联的产品模型中定义。",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "request_id": "b1224afb-e9f0-4916-8220-b6bab568e888",
                "response": {
                  "services": {
                    "serviceId": "Temperature",
                    "properties": {
                      "PhV_phsA": "1",
                      "PhV_phsB": "2"
                    },
                    "eventTime": "20190606T121212Z"
                  }
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/DevicePropertiesQueryResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "x-Error": [
              "IOTDA.014112"
            ]
          },
          "403": {
            "description": "Forbidden",
            "x-Error": [
              "IOTDA.000021",
              "IOTDA.014016",
              "IOTDA.001006",
              "IOTDA.000022",
              "IOTDA.014018"
            ]
          },
          "404": {
            "description": "Not Found",
            "x-Error": [
              "IOTDA.014000",
              "IOTDA.014103"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IOTDA.000001",
              "IOTDA.000020"
            ]
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "iot_06_v5_0034",
        "x-imports": "java.util.concurrent.CompletableFuture;",
        "x-returnType": "CompletableFuture<DevicePropertiesQueryResponse>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/devices/{device_id}/properties?service_id=Temperature",
        "x-request-examples-description-1": "查询设备属性,查询指定设备的服务为Temperature的所有属性。"
      }
    }
  },
  "definitions": {
    "DevicePropertiesQueryResponse": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "example": "b1224afb-e9f0-4916-8220-b6bab568e888",
