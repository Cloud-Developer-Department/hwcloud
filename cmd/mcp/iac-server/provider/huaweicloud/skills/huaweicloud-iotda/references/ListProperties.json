                },
                "eventTime": "20190606T121212Z"
              }
            ]
          },
          "description": "设备上报的属性执行结果。Json格式,具体格式需要应用和设备约定。",
          "x-NotEmpty": false
        },
        "error_code": {
          "type": "string",
