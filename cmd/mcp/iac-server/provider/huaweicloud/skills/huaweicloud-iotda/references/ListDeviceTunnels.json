{
  "name": "ListDeviceTunnels",
  "summary": "查询设备所有隧道",
  "tags": "设备隧道管理",
  "productshort": "IoTDA",
  "region_id": "af-south-1",
  "paths": {
    "/v5/iot/{project_id}/tunnels": {
      "get": {
        "tags": [
          "TunnelManagement"
        ],
        "summary": "查询设备所有隧道",
        "description": "用户可通过该接口查询某项目下的所有设备隧道,以实现对设备管理。应用服务器可通过此接口向平台查询设备隧道建立的情况。\n- 该API接口在基础版不支持。\n- 具体应用可见“设备远程登录”功能,请参见[设备远程登录](https://support.huaweicloud.com/usermanual-iothub/iot_01_00301.html)。",
        "operationId": "ListDeviceTunnels",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0121.html) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "name": "device_id",
            "in": "query",
            "description": "**参数说明**:设备ID",
            "required": false,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          }
        ],
        "responses": {
          "200": {
            "description": "查询设备所有隧道信息成功",
            "x-SuccessCode": true,
            "examples": {
              "application/json": {
                "tunnels": [
                  {
                    "tunnel_id": "d144a524-1997-4b99-94bf-f27128da8a34"
                  }
                ],
                "device_id": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0",
                "create_time": "20190303T081011Z",
                "closed_time": "20190303T081011Z",
                "status": "CLOSED",
                "source_connect_state": {
                  "last_update_time": "20190303T081011Z",
                  "status": "CONNECTED"
                },
                "device_connect_state": {
                  "last_update_time": "20190303T081011Z",
                  "status": "CONNECTED"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryTunnels"
            }
          },
          "400": {
            "description": "输入参数不正确",
            "x-Error": [
              "IOTDA.000006"
            ]
          },
          "403": {
            "description": "鉴权认证失败",
            "x-Error": [
              "IOTDA.021102"
            ]
          }
        },
        "x-iftype": "OpenAPI_new",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-returnType": "ResponseEntity<QueryTunnels>",
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/tunnels",
        "x-request-examples-description-1": "列表查询设备隧道。"
      }
    }
  },
  "definitions": {
    "TunnelInfo": {
      "properties": {
        "tunnel_id": {
          "type": "string",
          "example": "d144a524-1997-4b99-94bf-f27128da8a34",
          "description": "隧道ID",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "device_id": {
          "type": "string",
          "example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0",
          "description": "设备ID",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "create_time": {
          "type": "string",
          "example": "20190303T081011Z",
          "description": "隧道创建时间。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "pattern": "^[0-9TZ]{16}$"
        },
        "closed_time": {
          "type": "string",
          "example": "20190303T081011Z",
          "description": "隧道更新时间。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "pattern": "^[0-9TZ]{16}$"
        },
        "status": {
          "type": "string",
          "example": "CLOSED",
          "description": "隧道状态 CLOSED | OPEN",
          "pattern": "^[a-zA-Z]{1,16}$"
        },
        "source_connect_state": {
          "description": "访问端(console)状态",
          "$ref": "#/definitions/ConnectState"
        },
        "device_connect_state": {
          "description": "设备端状态",
          "$ref": "#/definitions/ConnectState"
        }
      },
      "description": "隧道信息"
    },
    "ConnectState": {
      "type": "object",
      "properties": {
        "last_update_time": {
          "type": "string",
          "example": "20190303T081011Z",
          "description": "隧道最近一次状态更新时间。格式:yyyyMMdd'T'HHmmss'Z',如20151212T121212Z。",
          "pattern": "^[0-9TZ]{16}$"
        },
        "status": {
          "type": "string",
          "example": "CONNECTED",
          "description": "客户端连接状态 CONNECTED | DISCONNECTED",
          "pattern": "^[a-zA-Z]{1,16}$"
        }
      },
      "description": "连接端状态"
    },
    "QueryTunnels": {
      "type": "object",
      "properties": {
        "tunnels": {
          "type": "array",
          "description": "隧道信息列表。",
          "items": {
            "$ref": "#/definitions/TunnelInfo"
          },
          "maxItems": 100,
          "minItems": 0
        }
      }
    }
  },
