  "paths": {
    "/v5/iot/{project_id}/export-tasks": {
      "post": {
        "operationId": "CreateExportTask",
        "tags": [
          "ExportTasks"
        ],
        "summary": "创建导出任务",
        "description": "应用服务器可调用此接口创建资源导出任务。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-externalAPI": true,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "Instance-Id",
            "in": "header",
            "description": "**参数说明**:实例ID。物理多租下各实例的唯一标识,建议携带该参数,在使用专业版时必须携带该参数。您可以在IoTDA管理控制台界面,选择左侧导航栏“总览”页签查看当前实例的ID,具体获取方式请参考[查看实例详情](https://support.huaweicloud.com/usermanual-iothub/iot_01_0079.html#section1) 。",
            "required": false,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
          },
          {
            "in": "body",
            "name": "CreateExportTasksRequestBody",
            "description": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AddExportTask"
            }
          }
        ],
        "x-returnType": "ResponseEntity<ExportTask>",
        "responses": {
          "201": {
            "description": "Created",
            "x-SuccessCode": true,
