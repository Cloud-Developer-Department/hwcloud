          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v5/iot/{project_id}/export-tasks",
        "x-request-examples-description-1": "创建导出任务。",
        "x-request-examples-text-1": {
          "resource_type": "BatchTask",
          "resource_condition": {
            "task_id": "5f433ce0c24389024365fdfa"
          },
          "export_format": "xls",
          "app_type": "APP",
          "app_id": "jeQDJQZltU8iKgFFoW060F5SGZka"
