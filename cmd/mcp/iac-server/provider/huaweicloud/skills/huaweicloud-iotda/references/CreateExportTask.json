      }
    }
  },
  "definitions": {
    "AddExportTask": {
      "title": "创建导出任务结构体",
      "type": "object",
      "description": "创建导出任务结构体。",
      "required": [
        "resource_type",
        "resource_condition"
      ],
      "properties": {
        "resource_type": {
          "type": "string",
          "description": "导出源资源类型,支持批量任务导出类型BatchTask。",
          "pattern": "(BatchTask|Device|DevicePropertyHistory|MessageTraceData)",
          "example": "BatchTask"
        },
        "resource_condition": {
          "description": "资源过滤条件,Json 格式,里面是(K,V)键值对,当resource_type为BatchTask时填写填写key为task_id,value为BatchTask的task_id(task_id从批量任务接口获得)。",
          "type": "object",
          "example": {
            "task_id": "5f433ce0c24389024365fdfa"
          }
        },
        "export_format": {
          "type": "string",
          "description": "导出格式,目前仅支持xls格式,默认格式为xls.(注意下载的文件已使用zip打包,后缀为'.zip',此处格式指的导出内容承载格式)",
          "pattern": "(xls)",
          "example": "xls"
        },
        "app_type": {
          "type": "string",
          "description": "租户规则的生效范围,默认GLOBAL,取值如下:\n- GLOBAL:生效范围为租户级\n- APP:生效范围为应用级,如果类型为APP,需要携带app_id,如果不带,生效范围为defaultApp。",
          "pattern": "(GLOBAL|APP)",
          "example": "GLOBAL"
        },
        "app_id": {
          "type": "string",
          "description": "应用ID。此参数为非必选参数,用于兼容平台老用户存在多应用的场景。存在多应用的用户需要使用该接口时,必须携带该参数指定创建的规则归属到哪个应用下,否则接口会提示错误。如果用户存在多应用,同时又不想携带该参数,可以联系华为技术支持对用户数据做应用合并。",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka"
        }
      }
    },
    "ExportTask": {
      "title": "导出任务信息",
      "type": "object",
      "description": "导出任务信息。",
      "properties": {
        "export_task_id": {
          "type": "string",
          "description": "导出任务唯一id。",
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka"
        },
        "resource_type": {
          "type": "string",
          "description": "导出源资源类型,支持批量任务导出类型BatchTask。",
          "pattern": "(BatchTask|Device|DevicePropertyHistory|MessageTraceData)",
          "example": "BatchTask"
        },
        "resource_condition": {
          "description": "资源过滤条件,Json格式,里面是(K,V)键值对,当resource_type为BatchTask时填写填写key为task_id,value为BatchTask的task_id(task_id从批量任务接口获得)。",
          "type": "object",
          "example": {
            "task_id": "32822e5744a45ede319d2c50"
          }
        },
        "export_format": {
          "type": "string",
          "description": "导出格式,目前xls格式。",
          "pattern": "(xls)",
          "example": "xls"
        },
        "status": {
          "type": "string",
          "description": "任务状态,状态分别有:Processing:执行中,Success:成功,Failed:失败。",
          "example": "Processing"
        },
        "export_count": {
          "type": "integer",
          "format": "int64",
          "description": "已导出的资源数量。",
          "example": 10000
        },
        "progress": {
          "type": "integer",
          "description": "导出任务的执行进度,取值范围为1-100,当100表示进度为100%,任务完成。",
          "example": 98
        },
        "create_time": {
          "x-isSensitive": true,
          "description": "在物联网平台创建产品的时间,格式:yyyy-MM-dd'T'HH:mm:ss.SSS'Z',如2020-08-12T12:12:12.333Z。",
          "type": "string",
          "example": "2020-08-12T12:12:12.333Z"
        },
        "end_time": {
          "x-isSensitive": true,
          "description": "导出任务的执行结束时间,格式:yyyy-MM-dd'T'HH:mm:ss.SSS'Z',如2020-08-12T12:12:12.333Z。",
          "type": "string",
          "example": "2020-08-12T12:12:12.333Z"
        },
        "app_type": {
          "type": "string",
          "description": "租户规则的生效范围,默认GLOBAL,取值如下:\n- GLOBAL:生效范围为租户级\n- APP:生效范围为应用级,如果类型为APP,需要携带app_id,如果不带,生效范围为defaultApp。",
          "pattern": "(GLOBAL|APP)"
        },
        "app_id": {
          "type": "string",
          "description": "应用ID。此参数为非必选参数,用于兼容平台老用户存在多应用的场景。存在多应用的用户需要使用该接口时,必须携带该参数指定创建的规则归属到哪个应用下,否则接口会提示错误。如果用户存在多应用,同时又不想携带该参数,可以联系华为技术支持对用户数据做应用合并。",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda.af-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "post",
  "uri": null
}