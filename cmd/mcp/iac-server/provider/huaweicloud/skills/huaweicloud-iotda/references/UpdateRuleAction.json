        "domain": {
          "type": "string",
          "description": "**参数说明**:服务对应的域名",
          "pattern": "^([a-zA-Z0-9]([a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9.])?)+[a-zA-Z0-9]{2,6}$"
        }
      },
      "title": "NetAddress",
      "description": "网络地址信息。"
    },
