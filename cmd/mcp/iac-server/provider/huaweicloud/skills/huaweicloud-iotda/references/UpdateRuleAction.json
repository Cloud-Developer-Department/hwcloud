  "definitions": {
    "DmsKafkaForwarding": {
      "type": "object",
      "required": [
        "addresses",
        "project_id",
        "region_name",
        "topic"
      ],
      "properties": {
        "region_name": {
          "type": "string",
          "example": "region_name",
          "description": "**参数说明**:Kafka服务对应的region区域",
          "minLength": 1,
          "maxLength": 256
        },
        "project_id": {
          "type": "string",
          "example": "project_id",
          "description": "**参数说明**:Kafka服务对应的projectId信息",
          "minLength": 1,
          "maxLength": 256
        },
        "addresses": {
          "type": "array",
          "description": "**参数说明**:转发kafka消息对应的地址列表",
          "items": {
            "$ref": "#/definitions/NetAddress"
          },
          "maxItems": 20
        },
        "topic": {
          "type": "string",
          "example": "topic",
          "description": "**参数说明**:转发kafka消息关联的topic信息。",
          "minLength": 1,
          "maxLength": 256
        },
        "username": {
          "type": "string",
          "example": "username",
          "description": "**参数说明**:转发kafka关联的用户名信息。",
          "minLength": 1,
          "maxLength": 256
        },
        "password": {
          "type": "string",
          "example": "password",
          "description": "**参数说明**:转发kafka关联的密码信息。",
          "minLength": 1,
          "maxLength": 256,
          "x-sensitive": true
        },
        "mechanism": {
          "type": "string",
          "description": "**参数说明**:转发kafka关联的SASL认证机制。\n**取值范围**:\n- PAAS:明文传输,此模式下为非数据加密传输模式,数据传输不安全,建议您使用更安全的数据加密模式。\n- PLAIN:SASL/PLAIN模式。需要填写对应的用户名密码信息。一种简单的用户名密码校验机制,在SASL_PLAINTEXT场景下,不建议使用。\n- SCRAM-SHA-512:SASL/SCRAM-SHA-512模式。需要填写对应的用户名密码信息。采用哈希算法对用户名与密码生成凭证,进行身份校验的安全认证机制,比PLAIN机制安全性更高。",
          "pattern": "(PAAS|PLAIN|SCRAM-SHA-512)",
          "example": "SCRAM-SHA-512"
        },
        "security_protocol": {
          "type": "string",
          "description": "**参数说明**:kafka传输安全协议,此字段不填默认为SASL_SSL。当mechanism为PAAS或不填时,该字段不生效。\n**取值范围**:\n- SASL_SSL:采用SSL证书进行加密传输,支持帐号密码认证,安全性更高。\n- SASL_PLAINTEXT:明文传输,支持帐号密码认证,性能更好,建议mechanism使用SCRAM-SHA-512机制。",
          "pattern": "(SASL_SSL|SASL_PLAINTEXT)",
          "example": "SASL_SSL"
        }
      },
      "title": "转发kafka消息内容",
      "description": "转发kafka消息结构",
      "x-onlyCustomAnnotation": true,
      "x-annotations": [
        "@JsonInclude(JsonInclude.Include.NON_NULL)",
        "@JsonIgnoreProperties(ignoreUnknown = true)"
      ],
      "x-imports": [
        "com.fasterxml.jackson.annotation.JsonInclude",
        "com.fasterxml.jackson.annotation.JsonIgnoreProperties"
      ]
    },
    "ColumnMapping": {
      "type": "object",
      "required": [
        "column_name",
        "json_key"
      ],
      "properties": {
        "column_name": {
          "type": "string",
