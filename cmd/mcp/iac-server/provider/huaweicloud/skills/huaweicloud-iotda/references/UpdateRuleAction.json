      },
      "title": "数据库的列和流转数据的对应关系",
      "description": "数据库的列和流转数据的对应关系。"
    },
    "NetAddress": {
      "type": "object",
      "properties": {
        "ip": {
          "type": "string",
          "description": "**参数说明**:服务的对应IP",
          "pattern": "^((25[0-5])|(2[0-4]\\d)|(1\\d\\d)|([1-9]\\d)|\\d)(\\.((25[0-5])|(2[0-4]\\d)|(1\\d\\d)|([1-9]\\d)|\\d)){3}$"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "description": "**参数说明**:服务对应端口",
          "maximum": 65535
