    "ObsForwarding": {
      "type": "object",
      "required": [
        "bucket_name",
        "project_id",
        "region_name"
      ],
      "properties": {
        "region_name": {
          "type": "string",
          "example": "region_name",
          "description": "**参数说明**:OBS服务对应的region区域",
          "minLength": 1,
          "maxLength": 256
        },
        "project_id": {
          "type": "string",
          "example": "project_id",
          "description": "**参数说明**:OBS服务对应的projectId信息",
          "minLength": 1,
          "maxLength": 256
        },
        "bucket_name": {
          "type": "string",
          "example": "bucket_name",
          "description": "**参数说明**:OBS服务对应的桶名称",
          "minLength": 1,
          "maxLength": 256
        },
        "location": {
          "type": "string",
          "example": "location",
          "description": "**参数说明**:OBS服务对应桶的区域",
          "minLength": 1,
          "maxLength": 256
        },
        "file_path": {
          "type": "string",
          "example": "device_property_report/{YYYY}/{MM}/{DD}/{HH}",
          "description": "**参数说明**:OBS服务中存储通道文件的自定义目录,多级目录可用(/)进行分隔,不可以斜杠(/)开头或结尾,不能包含两个以上相邻的斜杠(/)\n**取值范围**: 英文字母(a-zA-Z)、数字(0-9)、下划线(_)、中划线(-)、斜杠(/)和大括号({}),最大字符长度256个字符。其中大括号只能用于对应模板参数。\n**模板参数**: \n  - \\{YYYY\\} 年\n  - \\{MM\\} 月\n  - \\{DD\\} 日\n  - \\{HH\\} 小时\n  - \\{appId\\} 应用ID\n  - \\{deviceId\\} 设备ID\n  例如:自定义目录结构为\\{YYYY\\}/\\{MM\\}/\\{DD\\}/\\{HH\\},则会在转发数据时,根据当前时间往对应的目录结构2021>08>11>09下生成对应的数据。",
          "pattern": "^(?!/)(?![a-zA-Z0-9_/\\-{}]{1,256}(//))[a-zA-Z0-9_/\\-{}]{1,256}(?<!/)$"
        }
      },
      "title": "OBS服务配置信息",
      "description": "服务配置信息",
      "x-onlyCustomAnnotation": true,
      "x-annotations": [
        "@JsonInclude(JsonInclude.Include.NON_NULL)",
        "@JsonIgnoreProperties(ignoreUnknown = true)"
      ],
      "x-imports": [
        "com.fasterxml.jackson.annotation.JsonInclude",
        "com.fasterxml.jackson.annotation.JsonIgnoreProperties"
      ]
    },
