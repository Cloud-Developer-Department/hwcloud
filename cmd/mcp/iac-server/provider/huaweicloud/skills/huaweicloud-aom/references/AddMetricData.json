        "tags": [
          "监控"
        ],
        "operationId": "AddMetricData",
        "summary": "添加监控数据",
        "description": "该接口用于向服务端添加一条或多条监控数据。",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "租户从IAM申请到的projectid,一般为32位字符串。",
            "required": true,
            "type": "string"
          },
          {
            "name": "MetricDataParam",
            "description": "指标参数信息。",
            "in": "body",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/MetricDataItem"
              }
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "从IAM服务获取的用户Token。",
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "指定类型为application/json。",
            "type": "string",
            "enum": [
              "application/json"
            ]
          }
        ],
        "x-request-examples-1": [
          {
            "metric": {
              "namespace": "NOPAAS.ESC",
              "dimensions": [
                {
                  "name": "instance_id",
                  "value": "instance-101"
                }
              ]
            },
            "values": [
              {
                "unit": "percent",
                "metric_name": "cpu_util",
                "type": "int",
                "value": 35
              }
            ],
            "collect_time": 1467787152000
          }
        ],
        "responses": {
          "200": {
            "description": "OK 请求响应成功。",
            "examples": {
              "application/json": {
                "errorCode": "SVCSTG_AMS_2000000",
                "errorMessage": "success"
              }
            },
            "schema": {
              "$ref": "#/definitions/AccessAPIResultInfo"
            }
          },
          "400": {
            "description": "BadRequest 非法请求。建议直接修改该请求,不要重试该请求。",
            "schema": {
              "type": "string"
            }
          },
          "401": {
            "description": "Unauthorized  在客户端提供认证信息后,返回该状态码,表明服务端指出客户端所提供的认证信息不正确或非法。",
            "schema": {
              "type": "string"
            }
          },
          "403": {
            "description": "Forbidden 请求被拒绝访问。返回该状态码,表明请求能够到达服务端,且服务端能够理解用户请求,但是拒绝做更多的事情,因为该请求被设置为拒绝访问,建议直接修改该请求,不要重试该请求。",
            "schema": {
              "type": "string"
            }
