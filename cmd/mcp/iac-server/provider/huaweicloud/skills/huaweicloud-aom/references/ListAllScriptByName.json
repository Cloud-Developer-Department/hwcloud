  "definitions": {
    "SearchScriptsRequestBody": {
      "properties": {
        "name": {
          "type": "string",
          "description": "查询接收的参数,版本管理时,name为脚本名称(版本管理查询时name不能为空),脚本管理页面查询时,name为接收模糊查询的参数,name是null,表示查询所有默认脚本。",
          "minLength": 0,
          "maxLength": 128
        },
        "is_default": {
          "type": "string",
          "description": "查询规则,如果是类型为default,则为模糊查询和脚本管理主页展示,no_default为版本管理。",
          "minLength": 0,
          "maxLength": 16
        },
        "create_by": {
          "type": "string",
          "description": "创建人,默认按照创建人搜索脚本。",
          "minLength": 1,
          "maxLength": 64
        },
        "script_id": {
          "type": "string",
          "description": "版本管理时需要查询的脚本id。",
          "minLength": 1,
          "maxLength": 64
        },
        "page_num": {
          "type": "integer",
          "format": "int32",
          "description": "page_num为正整数。",
          "minimum": 1,
          "maximum": 100
        },
        "page_size": {
          "type": "integer",
          "format": "int32",
          "description": "每页显示的条数,默认值是10。",
          "minimum": 1,
          "maximum": 1000
        },
        "project_id": {
          "type": "string",
          "description": "项目id。",
          "minLength": 32,
          "maxLength": 32
        },
        "order_by_column": {
          "type": "string",
          "description": "需要排序的字段(默认为更新时间),支持字段有name,create_time和update_time。",
          "minLength": 1,
          "maxLength": 16
        },
        "sort_order": {
          "type": "string",
          "description": "排序规则(默认降序) 传入升序或降序,升序:ASC,降序:DESC。",
          "minLength": 1,
          "maxLength": 16
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目id,根据企业项目id搜索。",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "type": "object",
      "required": [
        "script_id",
        "order_by_column",
        "sort_order"
      ]
    },
    "Script": {
      "type": "object",
      "description": "脚本的基本信息。",
      "required": [
        "name",
        "script_language"
      ],
      "properties": {
        "approve_info": {
          "description": "审批信息",
          "$ref": "#/definitions/ApproveInfo"
        },
        "create_by": {
          "type": "string",
          "example": "chenkaiyuan",
          "description": "创建人,比如为:张三",
          "minLength": 1,
          "maxLength": 64
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "example": 1654589712420,
          "description": "创建时间",
          "minimum": 0,
          "maximum": 9999999999999
        },
        "description": {
          "type": "string",
          "example": "",
          "description": "脚本描述,脚本描述,对脚本进行描述,最大长度为1000",
          "minLength": 0,
          "maxLength": 1000
        },
        "enterprise_project_id": {
          "type": "string",
          "example": 0,
          "description": "企业项目id",
          "minLength": 1,
          "maxLength": 64
        },
        "id": {
          "type": "string",
          "example": "9f8d509c-7e9e-4eed-8d3f-5f1fad6ebb7d",
          "description": "脚本id,根据UUID.randomUUID生成。",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "example": "zzy",
          "description": "脚本名称,支持数字,下划线,大小写字母 ,中文",
          "minLength": 1,
          "maxLength": 64
        },
        "online_exist_status": {
          "type": "boolean",
          "example": true,
          "description": "脚本中是否有已上线的版本,true表示有已上线的版本,false表示没有已上线的版本"
        },
        "online_id": {
          "type": "string",
          "example": "e0051a84-1fcf-40d9-b156-8db6cae7b021",
          "description": "已上线版本id",
          "minLength": 1,
          "maxLength": 64
        },
        "project_id": {
          "type": "string",
          "example": "2a473356cca5487f8373be891bffc1cf",
          "description": "租户从IAM申请到的projectid,一般为32位字符串",
          "minLength": 32,
          "maxLength": 32
        },
        "rate_control": {
          "description": "执行策略",
          "$ref": "#/definitions/RateControl"
        },
        "script_language": {
          "type": "string",
          "example": "SHELL BAT PYTHON POWER_SHELL",
          "description": "脚本语言,目前支持四种,分别是:SHELL BAT PYTHON POWER_SHELL",
          "minLength": 1,
          "maxLength": 16
        },
        "update_by": {
          "type": "string",
          "example": "kaifatest",
          "description": "修改人",
          "minLength": 1,
          "maxLength": 64
        },
        "update_time": {
          "type": "integer",
          "format": "int64",
          "example": 1655275622146,
          "description": "实体的最后更新时间戳。 注意:执行创建/修改/删除操作时,update_time将更新。",
          "minimum": 0,
          "maximum": 9999999999999
        }
      }
    },
    "ApproveInfo": {
      "properties": {
        "topic_selected": {
          "type": "string",
          "description": "审批人主题选择。",
          "minLength": 1,
          "maxLength": 2048
        },
        "need_approve": {
          "type": "boolean",
          "description": "是否审核,默认是不审核,true,false。",
          "example": true
        },
        "smn_urn_list": {
          "type": "string",
          "description": "审批主题urn集合。",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "description": "审批信息",
      "type": "object"
    },
    "PageResultScript": {
      "required": [
        "elements",
        "total_elements"
      ],
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Script"
          },
          "description": "查询结果集合。",
          "minItems": 0,
          "maxItems": 9999999
        },
        "total_elements": {
          "type": "integer",
          "format": "int32",
          "description": "查询到的结果数量。",
          "minimum": 0,
          "maximum": 99999999
        }
      },
      "type": "object"
    },
    "RateControl": {
      "properties": {
        "have_rate_control": {
          "type": "boolean",
          "description": "是否分批发布,默认值是false。",
          "example": true
        },
        "time_delay": {
          "type": "integer",
          "format": "int32",
          "description": "每批间隔。",
          "minimum": 1,
          "maximum": 60
        },
        "max": {
          "type": "integer",
          "format": "int32",
          "description": "每批支持的最大实例数。",
          "minimum": 0,
          "maximum": 100
        }
      },
      "type": "object"
    },
    "ErrorResult": {
      "description": "错误查询返回结果",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码。",
          "example": "AOM.0403",
          "minLength": 1,
          "maxLength": 32
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败响应信息描述。",
          "example": "Forbidden",
          "minLength": 1,
          "maxLength": 1024
        },
        "http_code": {
          "type": "integer",
          "format": "int32",
          "description": "Http返回码",
          "example": "",
          "minimum": 1,
          "maximum": 999
        }
      },
      "required": [
        "error_code",
        "error_msg",
        "http_code"
      ],
      "type": "object"
    }
  },
