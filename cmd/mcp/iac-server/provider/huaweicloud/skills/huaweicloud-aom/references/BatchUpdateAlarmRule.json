        "summary": "批量更新Prometheus监控告警规则",
        "description": "该接口用于批量启停Prometheus监控告警规则、批量修改Prometheus监控告警规则的告警行动规则。",
        "operationId": "BatchUpdateAlarmRule",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID,可以从控制台获取,也可以从调用API处获取。获取方式请参见:[获取项目ID](aom_04_0024.xml)。"
          },
          {
            "name": "action",
            "in": "query",
            "required": true,
            "description": "批量操作action:\n\n- enable:批量启动Prometheus监控告警规则\n- disable:批量停止Prometheus监控告警规则\n- BATCH_UPDATE_ACTION_RULE:批量修改Prometheus监控告警规则的告警行动规则",
            "type": "string"
          },
          {
            "name": "BatchUpdateAlarmRuleRequestBody",
            "in": "body",
