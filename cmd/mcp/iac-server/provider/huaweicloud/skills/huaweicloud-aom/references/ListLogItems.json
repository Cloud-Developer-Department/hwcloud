        "summary": "查询日志",
        "operationId": "ListLogItems",
        "description": "该接口用于查询不同维度(例如集群、IP、应用等)下的日志内容,支持分页查询。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户从IAM申请到的projectid,一般为32位字符串。"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "从IAM服务获取的用户Token。",
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "指定类型为application/json。",
            "type": "string",
            "enum": [
              "application/json"
            ]
          },
          {
            "name": "ListLogItemsRequestBody",
            "in": "body",
            "required": true,
            "description": "查询不同维度日志请求体。",
            "schema": {
              "$ref": "#/definitions/QueryBodyParam"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": true,
            "description": "日志接口调用方式,当值为\"querylogs\"时接口功能为查询日志内容。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK 请求响应成功。",
            "schema": {
              "$ref": "#/definitions/ResponseInfo"
            },
            "examples": {
              "application/json": {
                "errorCode": "SVCSTG.ALS.200.200",
                "errorMessage": "Query data success",
                "result": [
                  {
                    "data": [
                      {
                        "appName": "axxs0712",
                        "category": "apx",
                        "clusterId": "c6xxxx7c-54cd-11e8-8055-025xxx1e40",
                        "collectTime": 153900000983,
                        "containerName": "contsssner-0",
                        "hostIP": "1xx.xxx.0.1xxx",
                        "hostId": "c11xxxxx11-0000b-4925-bef4-d0xxxx9b0",
                        "hostName": "1x2.168.0.xxx",
                        "lineNum": "1xxx23xxxxxx2VW5xxxxxx0ZWdlcg==",
                        "logContent": "warn:2018/10/09 06:57:01 helloworld.go:108: the main processis running now.",
                        "logContentSize": null,
                        "loghash": "4xxxxx0d40a83c17f262540xxxxxxxxfeaa30eb",
                        "nameSpace": "default",
                        "pathFile": "/xxx/xxx/xxx/xxx/xxx/xxx.trxe",
                        "podName": "axxx12-7xxf884-qxxwp",
                        "serviceID": ""
                      }
                    ],
                    "total": 5000
                  }
                ]
              }
            }
          },
          "400": {
            "description": "BadRequest 非法请求。建议直接修改该请求,不要重试该请求。",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            }
          },
          "401": {
            "description": "Unauthorized  在客户端提供认证信息后,返回该状态码,表明服务端指出客户端所提供的认证信息不正确或非法。",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            }
          },
          "403": {
            "description": "Forbidden 请求被拒绝访问。返回该状态码,表明请求能够到达服务端,且服务端能够理解用户请求,但是拒绝做更多的事情,因为该请求被设置为拒绝访问,建议直接修改该请求,不要重试该请求。",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            }
          },
          "500": {
            "description": "InternalServerError 表明服务端能被请求访问到,但是不能理解用户的请求。",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            }
          },
          "503": {
            "description": "ServiceUnavailable 被请求的服务无效。建议直接修改该请求,不要重试该请求。",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "SearchKey": {
      "description": "日志过滤条件集合,不同日志来源所需字段不同。",
      "properties": {
        "appName": {
          "type": "string",
          "description": "应用名称。"
        },
        "clusterId": {
          "type": "string",
          "description": "CCE集群ID。"
        },
        "hostIP": {
          "type": "string",
          "description": "日志所在虚拟机IP。"
        },
        "nameSpace": {
          "type": "string",
          "description": "CCE容器集群的命名空间。"
        },
        "pathFile": {
          "type": "string",
          "description": "日志文件名称。"
        },
        "podName": {
          "type": "string",
          "description": "容器实例名称。"
        }
      },
      "required": [
        "clusterId"
      ]
    },
    "ResponseInfo": {
      "properties": {
        "errorCode": {
          "type": "string",
          "description": "响应码,SVCSTG_AMS_2000000代表正常返回。"
        },
        "errorMessage": {
          "type": "string",
          "description": "响应信息描述。"
        },
        "result": {
          "description": "查询结果元数据信息,包括返回总数及结果。",
          "type": "string"
        }
      }
    },
    "ErrorMessage": {
      "properties": {
        "errorCode": {
          "type": "string",
          "description": "响应码。"
        },
        "errorMessage": {
          "type": "string",
          "description": "响应信息描述。"
        }
      }
    },
    "QueryBodyParam": {
      "properties": {
        "category": {
          "type": "string",
          "description": "取值范围 app_log,node _log,custom_log 日志类型字段:app_log:应用日志 node_log:主机日志 custom_log:自定义配置路径日志。"
        },
        "endTime": {
          "type": "integer",
          "format": "int64",
          "description": "搜索结束时间(UTC时间,毫秒级)。"
        },
        "hideSyslog": {
          "type": "integer",
          "format": "int32",
          "description": "取值范围 0、1 。搜索时是否隐藏系统日志,默认0为隐藏1为显示。"
        },
        "keyWord": {
          "type": "string",
          "description": "1.支持关键词精确搜索。关键词指相邻两个分词符之间的单词。\n2.支持关键词模糊匹配搜索,例如输入“RROR”或“ERRO?”或“*ROR*”或“ERR*”或“ER*OR”。\n3.支持短语精确搜索,例如输入“Start to refresh alm Statistic”。\n4.支持关键词的“与”、“或”组合搜索。格式为“query&&logs”或“query||logs”。\n说明:\n当前默认分词符有\n\n, '\";=()[]{}@&<>/:\\n\\t\\r"
        },
        "lineNum": {
          "type": "string",
          "description": "日志单行序列号第一次查询时不需要此参数,后续分页查询时需要使用可从上次查询的返回信息中获取."
        },
        "pageSize/size": {
          "type": "string",
          "description": "表示每次查询的日志条数不填时默认为5000,建议您设置为100。\n第一次查询时使用pageSize 后续分页查询时使用size。"
        },
        "searchKey": {
          "$ref": "#/definitions/SearchKey"
        },
        "startTime": {
          "type": "integer",
          "format": "int64",
          "description": "搜索起始时间(UTC时间,毫秒级)。"
        },
        "type": {
          "type": "string",
          "description": "表示此次查询为分页查询,第一次查询时不需要此参数,后续分页查询时需要使用。"
        },
        "isDesc": {
          "type": "boolean",
          "description": "标识按照lineNum升序查询还是降序查询。\n\ntrue:降序(lineNum由大到小:时间从新到老)。\n\nfalse:升序(lineNum由小到大:即时间从老到新)。"
        }
      },
      "required": [
        "category",
        "endTime",
        "searchKey",
        "startTime"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
