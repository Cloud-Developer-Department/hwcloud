    "BizAppParam": {
      "properties": {
        "description": {
          "type": "string",
          "description": "应用描述",
          "minLength": 0,
          "maxLength": 255
        },
        "display_name": {
          "type": "string",
          "description": "应用名称.字符集长度2-64,仅支持字符集:中文字符、英文字母、数字、下划线、中划线、点",
          "minLength": 2,
          "maxLength": 64
        },
        "eps_id": {
          "type": "string",
          "description": "应用关联的企业项目id。企业级用户必传",
          "pattern": "^[a-zA-Z0-9\\-]{36}$"
        },
        "name": {
          "type": "string",
          "description": "唯一标识.字符集长度2-64,仅支持字符集:英文字母、数字、下划线、中划线、点",
          "pattern": "^[a-zA-Z0-9\\-]{32,36}$"
        },
        "register_type": {
          "type": "string",
          "description": "前端默认是CONSOLE,不需要传参。rest接口无参数是API,有参数只能是:SERVICE_DISCOVERY",
          "enum": [
            "API",
            "CONSOLESERVICE_DISCOVERY"
          ]
        }
      },
      "example": {
        "description": "应用信息",
        "display_name": "example1",
        "eps_id": 0,
        "name": "example1",
        "register_type": "CONSOLE"
