  "definitions": {
    "WorkflowExecutionBrief": {
      "description": "函数流执行概要信息",
      "properties": {
        "workflow_id": {
          "type": "string",
          "description": "流程定义ID",
          "minLength": 1,
          "maxLength": 64,
          "example": "48aff955-ea10-4ffd-b426-190bc192dc14"
        },
        "execution_id": {
          "type": "string",
          "description": "流程执行实例ID",
          "minLength": 1,
          "maxLength": 64,
          "example": "48aff955-ea10-4ffd-b426-190bc192dc14"
        },
        "status": {
          "type": "string",
          "description": "流程实例执行状态",
          "minLength": 1,
          "maxLength": 32,
          "example": "success,fail,running,timeout,cancel"
        },
        "begin_time": {
          "type": "integer",
          "format": "int64",
          "description": "流程实例创建时间,格式:UTC时间戳",
          "example": "2021-01-01T00:00:00Z",
          "minimum": 0,
          "maximum": 9999999999999
        },
        "end_time": {
          "type": "integer",
          "format": "int64",
          "description": "流程实例结束时间,格式:UTC时间戳",
          "example": "2021-01-01T00:00:00Z",
          "minimum": 0,
          "maximum": 9999999999999
        },
        "last_update_time": {
          "type": "integer",
          "format": "int64",
          "description": "流程实例上次更新时间,格式:UTC时间戳",
          "example": "2021-01-01T00:00:00Z",
          "minimum": 0,
          "maximum": 9999999999999
        },
        "created_by": {
          "type": "string",
          "description": "流程实例创建者",
          "minLength": 1,
          "maxLength": 32,
          "example": "admin"
        },
        "approve_user_name_list": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": "审批人列表",
          "minItems": 0,
          "maxItems": 200
        },
        "execution_result_list": {
          "items": {
            "$ref": "#/definitions/execution_result_list"
          },
          "description": "执行记录",
          "type": "array",
          "minItems": 1,
          "maxItems": 200
        },
        "project_id": {
          "type": "string",
          "example": "2a473356cca5487f8373be891bffc1cf",
          "description": "租户从IAM申请到的projectid,一般为32位字符串。",
          "minLength": 32,
          "maxLength": 32
