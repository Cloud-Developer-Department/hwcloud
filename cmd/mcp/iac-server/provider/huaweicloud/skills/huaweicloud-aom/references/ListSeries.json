{
  "name": "ListSeries",
  "summary": "查询时间序列",
  "tags": "监控",
  "productshort": "AOM",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/series": {
      "post": {
        "x-api-type": "open-api",
        "x-request-examples-url-1": "https://{Endpoint}/v2/{project_id}/series",
        "x-request-examples-description-1": "通过namespace+metric_name查询系统当前可监控的时间序列列表",
        "x-request-examples-text-1": {
          "series": [
            {
              "namespace": "PAAS.CONTAINER",
              "metric_name": "aom_process_cpu_usage"
            }
          ]
        },
        "x-hybridcloud": true,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "tags": [
          "监控"
        ],
        "operationId": "ListSeries",
        "summary": "查询时间序列",
        "description": "该接口用于查询系统当前可监控的时间序列列表,可以指定时间序列命名空间、名称、维度、所属资源的编号(格式为:resType_resId),分页查询的起始位置和返回的最大记录条数。",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "租户从IAM申请到的projectid,一般为32位字符串。",
            "type": "string",
            "required": true
          },
          {
            "name": "limit",
            "in": "query",
            "description": "用于限制本次返回的结果数据条数。\n取值范围(0,1000],默认值为1000。",
            "required": false,
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页查询起始位置,为非负整数。",
            "required": false,
            "type": "string"
          },
          {
            "name": "ListSeriesRequestBody",
            "in": "body",
            "description": "时间序列查询参数。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SeriesAPIQueryItemParam"
            }
          }
        ],
        "x-request-examples-1": {
          "series": [
            {
              "namespace": "PAAS.CONTAINER",
              "metric_name": "aom_process_cpu_usage"
            }
          ]
        },
        "responses": {
          "200": {
            "description": "OK 请求执行完成。",
            "examples": {
              "application/json": {
                "meta_data": {
                  "count": 1,
                  "offset": null,
                  "total": 1,
                  "nextToken": 0
                },
                "series": [
                  {
                    "namespace": "PAAS.CONTAINER",
                    "metric_name": "cpuUsage",
                    "unit": "Percent",
                    "dimensions": [
                      {
                        "name": "appName",
                        "value": "appValue"
                      }
                    ],
                    "dimension_value_hash": null
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/SeriesQueryResult"
            }
          },
          "400": {
            "description": "BadRequest 非法请求。建议直接修改该请求,不要重试该请求。",
            "examples": {
              "application/json": {
                "error_code": "AOM.04007101",
                "error_msg": "Invalid namespace",
                "error_type": "BAD_REQUEST",
                "trace_id": ""
              }
            },
            "schema": {
              "$ref": "#/definitions/FailedRsp"
            }
          },
          "401": {
            "description": "Unauthorized  在客户端提供认证信息后,返回该状态码,表明服务端指出客户端所提供的认证信息不正确或非法。"
          },
          "403": {
            "description": "Forbidden 请求被拒绝访问。返回该状态码,表明请求能够到达服务端,且服务端能够理解用户请求,但是拒绝做更多的事情,因为该请求被设置为拒绝访问,建议直接修改该请求,不要重试该请求。"
          },
          "500": {
            "description": "InternalServerError 表明服务端能被请求访问到,但是不能理解用户的请求。"
          },
          "503": {
            "description": "ServiceUnavailable 被请求的服务无效。建议直接修改该请求,不要重试该请求。"
          }
        }
      }
    }
  },
  "definitions": {
    "MetaDataSeries": {
      "description": "查询结果元数据信息,包括分页信息等。",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "当前返回结果条数。",
          "format": "int32"
        },
        "offset": {
          "type": "integer",
          "description": "下一个开始的标记,用于分页,null表示无更多数据。"
        },
        "total": {
          "type": "integer",
          "description": "总条数。",
          "format": "int32"
        },
        "nextToken": {
          "type": "integer",
          "description": "偏移量。",
          "format": "int32"
        }
      }
    },
    "DimensionSeries": {
      "description": "时间序列维度列表。",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "维度名称。"
        },
        "value": {
          "type": "string",
          "description": "维度取值。"
        }
      }
    },
    "QuerySeriesOptionParam": {
      "description": "参数项。",
      "properties": {
        "namespace": {
          "type": "string",
          "description": "时间序列命名空间。取值范围:PAAS.CONTAINER、PAAS.NODE、PAAS.SLA、PAAS.AGGR、CUSTOMMETRICS等。PAAS.CONTAINER:应用时间序列命名空间;PAAS.NODE:节点时间序列命名空间;PAAS.SLA:SLA时间序列命名空间;PAAS.AGGR:集群时间序列命名空间;CUSTOMMETRICS:自定义时间序列命名空间。"
        },
        "metric_name": {
          "type": "string",
          "description": "时间序列名称,名称长度取值范围为1~255个字符。取值范围:AOM提供的基础时间序列名称,cpuUsage、cpuCoreUsed等:cpuUsage:cpu使用率;cpuCoreUsed:cpu内核占用;用户上报的自定义时间序列名称。"
        },
        "dimensions": {
          "type": "array",
          "description": "时间序列维度列表。可通过/v2/{project_id}/series接口中namespace+metric_name,查询当前监控的时间序列名称的时间序列维度列表。",
          "items": {
            "$ref": "#/definitions/DimensionSeries"
          }
        }
      },
      "required": [
        "namespace"
      ],
      "type": "object"
    },
    "SeriesQueryItemResult": {
      "description": "维度信息。",
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "description": "命名空间。"
        },
        "dimensions": {
          "type": "array",
          "description": "维度列表。",
          "items": {
            "$ref": "#/definitions/DimensionSeries"
          }
        },
        "metric_name": {
          "type": "string",
          "description": "时间序列名称。"
        },
        "unit": {
          "type": "string",
          "description": "时间序列单位。"
        },
        "dimension_value_hash": {
          "type": "string",
          "description": "时间序列哈希值。"
        }
      }
    },
    "SeriesAPIQueryItemParam": {
      "description": "时间序列查询参数详情。",
      "type": "object",
      "required": [
        "series"
      ],
      "properties": {
        "series": {
          "type": "array",
          "description": "通过该数组传递的参数信息进行时间序列查询。",
          "items": {
            "$ref": "#/definitions/QuerySeriesOptionParam"
          }
        }
      }
    },
    "SeriesQueryResult": {
      "description": "时间序列查询结果。",
      "type": "object",
      "properties": {
        "series": {
          "type": "array",
          "description": "时间序列对象列表。",
          "items": {
            "$ref": "#/definitions/SeriesQueryItemResult"
          }
        },
        "meta_data": {
          "description": "查询结果元数据信息,包括分页信息等。",
          "$ref": "#/definitions/MetaDataSeries"
        }
      }
    },
    "FailedRsp": {
      "description": "失败时的返回对象。",
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息描述。"
        },
        "error_type": {
          "type": "string",
          "description": "错误类型。"
        },
        "trace_id": {
          "type": "string",
          "description": "请求id"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
