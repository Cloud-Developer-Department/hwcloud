  "definitions": {
    "AppNameRule": {
      "description": "服务命名部分,数组中有多个对象时表示将每个对象抽取到的字符串拼接作为服务的名称。\nnameType取值cmdLine时args格式为[\"start\",\"end\"],表示抽取命令行中start、end之间的字符。\nnameType取值cmdLine时args格式为[\"aa\"],表示抽取环境变量名为aa对应的环境变量值。\nnameType取值str时,args格式为[\"fix\"],表示服务名称最后拼接固定文字fix。\nnameType取值cmdLineHash时,args格式为[\"0001\"],value格式为[\"ser\"],表示当启动命令是0001时,服务名称为ser。",
      "properties": {
        "nameType": {
          "type": "string",
          "description": "取值类型。从cmdLineHash、cmdLine、env、str里面选取。",
          "example": "cmdLineHash"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "输入值。",
          "example": [
            "/opt/********* -DNFW=icagent"
          ]
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "服务名(仅nameType为cmdLineHash时填写)。",
          "example": "aicagentserver"
        }
      },
      "required": [
        "nameType",
        "args"
      ],
      "type": "object"
    },
    "DiscoveryRule": {
      "description": "规则发现部分,数组中有多个对象时表示需要同时满足所有条件的进程才会被匹配到。\ncheckType为cmdLine时checkMode填contain,checkContent格式为[“xxx”]表示进程命令行参数中需要包含xxx。checkType为env时checkMode填contain,checkContent格式为 [\"k1\",\"v1\"]表示进程环境变量中需要包含名为k1值为v1的环境变量。checkType为scope时checkMode填equals,checkContent格式为节点ID数组[\"hostId1”,”hostId2”],表示规则仅会在这些节点上生效(如果不指定节点范围,规则将下发到该项目所有的节点)。",
      "properties": {
        "checkContent": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "匹配值。",
          "example": "-DNFW=icagent"
        },
        "checkMode": {
          "type": "string",
          "description": "匹配条件。contain、equals",
          "example": "contain"
        },
        "checkType": {
          "type": "string",
          "description": "匹配类型。cmdLine、env、scope",
          "example": "cmdLine"
        }
      },
      "required": [
        "checkContent",
        "checkMode",
        "checkType"
      ],
      "type": "object"
    },
    "LogPathRule": {
      "description": "日志路径配置规则。\n当cmdLineHash为固定字符串时,指定日志路径或者日志文件。否则只采集进程当前打开的以.log和.trace结尾的文件。nameType取值cmdLineHash时,args格式为[\"00001\"],value格式为[\"/xxx/xx.log\"],表示当启动命令是00001时,日志路径为/xxx/xx.log。",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "命令行。",
          "example": "[]"
        },
        "nameType": {
          "type": "string",
          "description": "取值类型。\ncmdLineHash",
          "example": "\"\""
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "日志路径。",
          "example": "[]"
        }
      },
      "required": [
        "args",
        "nameType",
        "value"
      ]
    },
    "NameRule": {
      "description": "服务发现规则命名部分。",
      "properties": {
        "appNameRule": {
          "items": {
            "$ref": "#/definitions/AppNameRule"
          },
          "description": "服务命名部分,数组中有多个对象时表示将每个对象抽取到的字符串拼接作为服务的名称。\nnameType取值cmdLine时args格式为[\"start\",\"end\"],表示抽取命令行中start、end之间的字符。\nnameType取值cmdLine时args格式为[\"aa\"],表示抽取环境变量名为aa对应的环境变量值。\nnameType取值str时,args格式为[\"fix\"],表示服务名称最后拼接固定文字fix。\nnameType取值cmdLineHash时,args格式为[\"0001\"],value格式为[\"ser\"],表示当启动命令是0001时,服务名称为ser。",
          "type": "array"
        },
        "applicationNameRule": {
          "items": {
            "$ref": "#/definitions/ApplicationNameRule"
          },
          "description": "应用命名部分。\nnameType取值cmdLine时args格式为[\"start\",\"end\"],表示抽取命令行中start、end之间的字符。\nnameType取值cmdLine时args格式为 [\"aa\"],表示抽取环境变量名为aa对应的环境变量值。\nnameType取值str时,args格式为[\"fix\"],表示服务名称最后拼接固定文字fix。\nnameType取值cmdLineHash时,args格式为[\"0001\"],value格式为[\"ser\"],表示当启动命令是0001时,应用名称为ser。",
          "type": "array"
        }
      },
      "required": [
        "appNameRule",
        "applicationNameRule"
      ],
      "type": "object"
    },
    "AppRulesSpec": {
      "description": "规则详情。",
      "properties": {
        "appType": {
          "type": "string",
          "description": "服务类型,用于标记服务的分类,仅用于规则分类和界面展示。可以填写任意字段,如按技术栈分类可填写Java,Python。按作用分类可填写collector(采集),database(数据库)等。",
          "example": "\"\""
        },
        "attrList": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "属性列表(暂不使用,可不传)。\ncmdLine、env",
          "example": [
            "cmdLine"
          ]
        },
        "detectLog": {
          "type": "string",
          "description": "是否开启日志采集。\ntrue、false",
          "example": "true"
        },
        "discoveryRule": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DiscoveryRule"
          },
          "description": "规则发现部分,数组中有多个对象时表示需要同时满足所有条件的进程才会被匹配到。\ncheckType为cmdLine时checkMode填contain,checkContent格式为[\"xxx\"]表示进程命令行参数中需要包含xxx。checkType为env时checkMode填contain,checkContent格式为 [\"k1\",\"v1\"]表示进程环境变量中需要包含名为k1值为v1的环境变量。checkType为scope时checkMode填equals,checkContent格式为节点ID数组[\"hostId1\",\"hostId2\"],表示规则仅会在这些节点上生效(如果不指定节点范围,规则将下发到该项目所有的节点)。"
        },
        "isDefaultRule": {
          "type": "string",
          "description": "是否为默认规则。\ntrue、false",
          "example": "true"
        },
        "isDetect": {
          "type": "string",
          "description": "是否为规则预探测场景(预探测场景不会保存规则,仅用于规则下发之前验证该规则能否有效发现节点上的进程)。true、false",
          "example": true
        },
        "logFileFix": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "日志文件的后缀。\nlog、trace、out",
          "example": [
            "log",
            "trace",
            "out"
          ]
        },
        "logPathRule": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LogPathRule"
          },
          "description": "日志路径配置规则。\n当cmdLineHash为固定字符串时,指定日志路径或者日志文件。否则只采集进程当前打开的以.log和.trace结尾的文件。nameType取值cmdLineHash时,args格式为[\"00001\"],value格式为[\"/xxx/xx.log\"],表示当启动命令是00001时,日志路径为/xxx/xx.log。"
        },
        "nameRule": {
          "$ref": "#/definitions/NameRule",
          "description": "发现上来的服务、应用的命名规则。"
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "description": "规则优先级。1~9999的整数字符串,默认取值为9999",
          "example": 9999
        },
        "dataSource": {
          "type": "string",
          "description": "数据源"
        },
        "editable": {
          "type": "string",
          "description": "是否支持编辑 true、false",
          "example": "true"
        },
        "aom_metric_relabel_configs": {
          "type": "object",
          "description": "指标配置"
        }
      },
      "required": [
        "appType",
        "detectLog",
        "discoveryRule",
        "isDefaultRule",
        "isDetect",
        "logFileFix",
        "nameRule",
        "priority"
      ],
      "type": "object"
    },
    "ServicesDiscoveryResultInfo": {
      "properties": {
        "errorCode": {
          "type": "string",
          "description": "响应码。",
          "example": "SVCSTG.INV.2000000"
        },
        "errorMessage": {
          "type": "string",
          "description": "响应信息描述。",
          "example": "null"
        },
        "responseStatus": {
          "type": "integer",
          "format": "int32",
          "description": "响应状态码(不再使用)。"
        },
        "id": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "服务发现规则id列表,多AZ配置同步时使用。"
        },
        "results": {
          "type": "array",
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "description": "服务发现规则详细信息列表。"
        }
      }
    },
    "ApplicationNameRule": {
      "description": "应用命名部分。\nnameType取值cmdLine时args格式为[\"start\",\"end\"],表示抽取命令行中start、end之间的字符。\nnameType取值cmdLine时args格式为 [\"aa\"],表示抽取环境变量名为aa对应的环境变量值。\nnameType取值str时,args格式为[\"fix\"],表示服务名称最后拼接固定文字fix。\nnameType取值cmdLineHash时,args格式为[\"0001\"],value格式为[\"ser\"],表示当启动命令是0001时,应用名称为ser。",
      "properties": {
        "nameType": {
          "type": "string",
          "description": "取值类型。\n从cmdLineHash、cmdLine、env、str里面选取。",
          "example": "cmdLineHash"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "输入值。",
          "example": "/opt/*********** -DNFW=icagent"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "服务名(仅nameType为cmdLineHash时填写)。",
          "example": "aicagent"
        }
      },
      "required": [
        "nameType",
        "args"
      ]
    },
    "AppRulesBody": {
      "properties": {
        "appRules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AppRules"
          },
          "description": "服务参数。"
        }
      },
      "type": "object"
    },
    "AppRules": {
      "description": "服务参数。",
      "properties": {
        "createTime": {
          "type": "string",
          "description": "规则创建时间(创建时不传,修改时传查询返回的createTime)。",
          "default": "1599098476654"
        },
        "enable": {
          "type": "boolean",
          "description": "true、false 规则是否启用。",
          "example": "true"
        },
        "eventName": {
          "type": "string",
          "description": "aom_inventory_rules_event规则事件名称,对于服务发现固定为\"aom_inventory_rules_event\"。",
          "example": "aom_inventory_rules_event"
        },
        "hostid": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "主机ID(暂不使用,传空即可)。",
          "example": "[]"
        },
        "id": {
          "type": "string",
          "description": "创建时填空,修改时填规则ID。",
          "example": "302367e04c0b"
        },
        "name": {
          "type": "string",
          "description": "规则名称。\n字符长度为4到63位,以小写字母a-z开头,只能包含0-9/a-z/-,不能以-结尾。",
          "example": "icagent"
        },
        "projectid": {
          "type": "string",
          "description": "租户从IAM申请到的projectid,一般为32位字符串。",
          "example": "be891bffc1cf"
        },
        "spec": {
          "$ref": "#/definitions/AppRulesSpec"
        },
        "desc": {
          "type": "string",
          "description": "自定义描述信息"
        }
      },
      "required": [
        "enable",
        "eventName",
        "id",
        "name",
        "projectid",
        "spec"
      ],
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "aom.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
