        "summary": "添加或修改服务发现规则",
        "tags": [
          "监控"
        ],
        "operationId": "AddOrUpdateServiceDiscoveryRules",
        "description": "该接口用于添加或修改一条或多条服务发现规则。同一projectid下可添加的规则上限为100条。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户从IAM申请到的projectid,一般为32位字符串。"
          },
          {
            "name": "appRules",
            "in": "body",
            "required": false,
            "description": "服务参数。",
            "schema": {
              "$ref": "#/definitions/AppRulesBody"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "从IAM服务获取的用户Token。",
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "指定类型为application/json。",
            "type": "string",
            "enum": [
              "application/json"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK 请求响应成功。",
            "schema": {
              "$ref": "#/definitions/ServicesDiscoveryResultInfo"
            },
