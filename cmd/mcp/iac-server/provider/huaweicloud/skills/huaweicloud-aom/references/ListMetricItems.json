{
  "name": "ListMetricItems",
  "summary": "查询指标",
  "tags": "监控",
  "productshort": "AOM",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/ams/metrics": {
      "post": {
        "x-request-examples-url-2": "https://{Endpoint}/v1/{project_id}/ams/metrics?type=inventory",
        "x-request-examples-description-2": "通过inventoryId查询指标列表。",
        "x-request-examples-text-2": {
          "inventoryId": "application_xxxxxxxx-xxxx-xxxx-xxxx-xxxxx3fee10"
        },
        "x-request-examples-2": {
          "inventoryId": "application_xxxxxxxx-xxxx-xxxx-xxxx-xxxxx3fee10"
        },
        "x-request-examples-description-1": "通过namespace+appName+clusterName查询指标列表。",
        "x-request-examples-url-1": "https://{Endpoint}/v1/{project_id}/ams/metrics",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-text-1": {
          "metricItems": [
            {
              "namespace": "PAAS.CONTAINER",
              "dimensions": [
                {
                  "name": "appName",
                  "value": "aomApp"
                },
                {
                  "name": "clusterName",
                  "value": "aomCluster"
                }
              ]
            }
          ]
        },
        "x-hybridcloud": true,
        "tags": [
          "监控"
        ],
        "operationId": "ListMetricItems",
        "summary": "查询指标",
        "description": "该接口用于查询系统当前可监控的指标列表,可以指定指标命名空间、指标名称、维度、所属资源的编号(格式为:resType_resId),分页查询的起始位置和返回的最大记录条数。",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "租户从IAM申请到的projectid,一般为32位字符串。",
            "type": "string",
            "required": true
          },
          {
            "name": "type",
            "in": "query",
            "description": "指标查询方式。",
            "type": "string",
            "required": false
          },
          {
            "name": "limit",
            "in": "query",
            "description": "用于限制本次返回的结果数据条数。\n取值范围(0,1000],默认值为1000。",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 4
          },
          {
            "name": "start",
            "in": "query",
            "description": "分页查询起始位置,为非负整数。",
            "required": false,
            "type": "string"
          },
          {
            "name": "queryItemParam",
            "in": "body",
            "description": "指标查询参数。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/MetricAPIQueryItemParam"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "从IAM服务获取的用户Token。",
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "指定类型为application/json。",
            "type": "string",
            "enum": [
              "application/json"
            ]
          }
        ],
        "x-request-examples-1": {
          "metricItems": [
            {
              "namespace": "PAAS.CONTAINER",
              "dimensions": [
                {
                  "name": "appName",
                  "value": "aomApp"
                },
                {
                  "name": "clusterName",
                  "value": "aomCluster"
                }
              ]
            }
          ]
        },
        "responses": {
          "200": {
            "description": "OK 请求执行完成。",
            "examples": {
              "application/json": {
                "errorCode": "SVCSTG_AMS_2000000",
                "errorMessage": "success",
                "metaData": {
                  "count": 1,
                  "offset": 1,
                  "nextToken": null,
                  "total": 1
                },
                "metrics": [
                  {
                    "namespace": "PAAS.CONTAINER",
                    "metricName": "aom_process_cpu_usage",
                    "unit": "Percent",
                    "dimensions": [
                      {
                        "name": "appName",
                        "value": "aomApp"
                      }
                    ]
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/MetricAPIQueryItemResult"
            }
          },
          "400": {
            "description": "BadRequest 非法请求。建议直接修改该请求,不要重试该请求。",
            "schema": {
              "type": "string"
            }
          },
          "401": {
            "description": "Unauthorized  在客户端提供认证信息后,返回该状态码,表明服务端指出客户端所提供的认证信息不正确或非法。",
            "schema": {
              "type": "string"
            }
          },
          "403": {
            "description": "Forbidden 请求被拒绝访问。返回该状态码,表明请求能够到达服务端,且服务端能够理解用户请求,但是拒绝做更多的事情,因为该请求被设置为拒绝访问,建议直接修改该请求,不要重试该请求。",
            "schema": {
              "type": "string"
            }
          },
          "500": {
            "description": "InternalServerError  表明服务端能被请求访问到,但是不能理解用户的请求。",
            "schema": {
              "type": "string"
            }
          },
          "503": {
            "description": "ServiceUnavailable 被请求的服务无效。建议直接修改该请求,不要重试该请求。",
            "schema": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "MetaDataSeries": {
      "description": "查询结果元数据信息,包括分页信息等。",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "当前返回结果条数。",
          "format": "int32"
        },
        "offset": {
          "type": "integer",
          "description": "下一个开始的标记,用于分页,null表示无更多数据。"
        },
        "total": {
          "type": "integer",
          "description": "总条数。",
          "format": "int32"
        },
        "nextToken": {
          "type": "integer",
          "description": "偏移量。",
          "format": "int32"
        }
      }
    },
    "QueryMetricItemOptionParam": {
      "description": "参数项。",
      "properties": {
        "dimensions": {
          "type": "array",
          "description": "指标维度列表。",
          "items": {
            "$ref": "#/definitions/Dimension"
          }
        },
        "metricName": {
          "type": "string",
          "description": "指标名称。名称长度取值范围为1~255个字符。取值范围:AOM提供的基础指标,cpuUsage、cpuCoreUsed等。cpuUsage:cpu使用率;cpuCoreUsed:cpu内核占用;用户上报的自定义指标名称。"
        },
        "namespace": {
          "type": "string",
          "description": "指标命名空间。取值范围:PAAS.CONTAINER:组件指标、实例指标、进程指标和容器指标的命名空间,PAAS.NODE: 主机指标、网络指标、磁盘指标和文件系统指标的命名空间,PAAS.SLA:SLA指标的命名空间,PAAS.AGGR:集群指标的命名空间,CUSTOMMETRICS:默认的自定义指标的命名空间。",
          "enum": [
            "PAAS.CONTAINER",
            "PAAS.NODE",
            "PAAS.SLA",
            "PAAS.AGGR",
            "CUSTOMMETRICS"
          ]
        }
      },
      "required": [
        "namespace"
      ],
      "type": "object"
    },
    "MetricAPIQueryItemParam": {
      "description": "指标查询参数详情。",
      "type": "object",
      "properties": {
        "inventoryId": {
          "type": "string",
          "description": "资源编号,格式为resType_resId。其中resType部分的枚举值为:host,application,instance, container,process,network,storage, volume。当URI参数中的type取值为“inventory”时,通过该参数查询关联的指标,不再使用metricItems数组中的信息。"
        },
        "metricItems": {
          "type": "array",
          "description": "当URI参数中的type取值不为“inventory”时,就通过该数组传递的参数信息进行指标查询。",
          "items": {
            "$ref": "#/definitions/QueryMetricItemOptionParam"
          }
        }
      }
    },
    "MetricAPIQueryItemResult": {
      "description": "指标查询结果。",
      "properties": {
        "metaData": {
          "$ref": "#/definitions/MetaDataSeries"
        },
        "metrics": {
          "type": "array",
          "description": "指标对象列表。",
          "items": {
            "$ref": "#/definitions/MetricItemResultAPI"
          }
        }
      }
    },
    "MetricItemResultAPI": {
      "description": "维度信息。",
      "properties": {
        "dimensions": {
          "type": "array",
          "description": "指标维度列表。",
          "items": {
            "$ref": "#/definitions/Dimension"
          }
        },
        "dimensionvaluehash": {
          "type": "string",
          "description": "指标哈希值。"
        },
        "metricName": {
          "type": "string",
          "description": "指标名称。"
        },
        "namespace": {
          "type": "string",
          "description": "命名空间。"
        },
        "unit": {
          "type": "string",
          "description": "指标单位。"
        }
      }
    },
    "Dimension": {
      "description": "指标维度。",
      "properties": {
        "name": {
          "type": "string",
          "description": "维度名称。"
        },
        "value": {
          "type": "string",
          "description": "维度取值。"
        }
      },
      "required": [
        "name",
        "value"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "aom.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}