          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "从IAM服务获取的用户Token。获取方式请参见:[获取Token](aom_04_0059.xml)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "消息体的类型(格式)。指定类型为“application/json”。",
            "type": "string",
            "enum": [
              "application/json"
            ]
          },
          {
