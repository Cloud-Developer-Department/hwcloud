  "definitions": {
    "SmnTopics": {
      "type": "object",
      "description": "smn主题相关信息",
      "required": [
        "name",
        "push_policy",
        "topic_urn"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "description": "Topic的显示名,推送邮件消息时,作为邮件发件人显示。显示名的长度为192byte或64个中文。默认值为空。",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "创建topic的名字。Topic名称只能包含大写字母、小写字母、数字、-和_,且必须由大写字母、小写字母或数字开头,长度为1到255个字符。",
          "minLength": 1,
          "maxLength": 255
        },
        "push_policy": {
          "type": "integer",
          "format": "int32",
          "description": "SMN消息推送策略。取值为0或1",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "topic中订阅者的状态。0:主题已删除或主题下订阅列表为空。1:主题下的订阅列表存在状态为“已订阅”的订阅信息。2:主题下的订阅信息状态处于“未订阅”或“已取消”。",
          "enum": [
            0,
            1,
            2
          ]
        },
        "topic_urn": {
          "type": "string",
          "description": "Topic的唯一的资源标识。",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "ActionRule": {
      "required": [
        "rule_name",
        "project_id",
        "user_name",
        "type",
        "notification_template",
        "smn_topics"
      ],
      "properties": {
        "rule_name": {
          "type": "string",
          "description": "规则名称\n只含有汉字数字、字母、下划线,不能以下划线等特殊符号开头和结尾,长度为 1 - 100",
          "minLength": 1,
          "maxLength": 100
        },
        "project_id": {
          "type": "string",
          "description": "项目ID",
          "minLength": 32,
          "maxLength": 32
        },
        "user_name": {
          "type": "string",
          "description": "子账号名称",
          "minLength": 1,
          "maxLength": 100
        },
        "desc": {
          "type": "string",
          "description": "规则描述。规则描述长度为0到1024个字符,并且只能是数字、字母、特殊字符(_*)、空格和中文组成,不能以下划线开头和结尾。",
          "minLength": 0,
          "maxLength": 1024
        },
        "type": {
          "type": "string",
          "description": "规则类型。\"1\":通知,\"2\":用户",
          "minLength": 1,
          "maxLength": 1,
          "enum": [
            "1",
            "2"
          ]
        },
        "notification_template": {
          "type": "string",
          "description": "消息模板",
          "minLength": 1,
          "maxLength": 100
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间",
          "minimum": 0,
          "maximum": 9999999999999
        },
        "update_time": {
          "type": "integer",
          "format": "int64",
          "description": "修改时间",
          "minimum": 0,
          "maximum": 9999999999999
        },
        "time_zone": {
          "type": "string",
          "description": "时区",
          "minLength": 1,
          "maxLength": 100
        },
        "smn_topics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SmnTopics"
          },
          "description": "SMN主题信息,不能大于5",
          "maxItems": 5,
          "minItems": 1
        }
      },
      "type": "object",
      "description": "告警行动规则"
    },
