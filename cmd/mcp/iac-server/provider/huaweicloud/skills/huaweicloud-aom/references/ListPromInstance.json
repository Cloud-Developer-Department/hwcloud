        "x-order": 3,
        "x-api-type": "open-api",
        "operationId": "ListPromInstance",
        "summary": "查询Prometheus实例",
        "description": "该接口用于查询Prometheus实例。",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "description": "租户从IAM申请到的projectid,一般为32位字符串。",
            "required": true,
            "type": "string"
          },
          {
            "name": "prom_id",
            "in": "query",
            "required": false,
            "description": "Prometheus实例id(prom_id与prom_type同时存在时,仅prom_id生效)。",
            "type": "string"
          },
          {
            "name": "prom_type",
            "in": "query",
            "required": false,
            "description": "Prometheus实例类型(暂时不支持VPC、KUBERNETES)。",
            "type": "string",
            "enum": [
              "default",
              "ECS",
              "VPC",
              "CCE",
              "REMOTE_WRITE",
              "KUBERNETES",
              "CLOUD_SERVICE",
              "ACROSS_ACCOUNT"
            ]
          },
          {
            "name": "cce_cluster_enable",
            "in": "query",
            "required": false,
            "description": "cce集群开关。",
            "type": "string",
            "enum": [
              "true",
              "false"
            ]
          },
          {
            "name": "prom_status",
            "in": "query",
            "required": false,
            "description": "Prometheus实例状态。",
            "type": "string",
            "enum": [
              "DELETED",
              "NORMAL",
              "ALL"
            ]
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "从IAM服务获取的用户Token。"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "指定类型为application/json。",
            "type": "string"
          },
          {
            "name": "Enterprise-Project-Id",
            "in": "header",
            "required": true,
            "description": "企业项目id。\n- 查询单个企业项目下实例,填写企业项目id。\n- 查询所有企业项目下实例,填写“all_granted_eps”。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK 请求响应成功。",
            "examples": {
              "application/json": {
                "prometheus": [
                  {
                    "deleted_time": 0,
                    "enterprise_project_id": "0",
                    "project_id": "2a4***56cc***7f837***891***c1cf",
                    "prom_create_timestamp": 1691718171483,
                    "prom_id": "08****2a-8**b-4**5-b**1-d1********79",
                    "prom_name": "aom_prometheus",
                    "prom_spec_config": {
                      "prom_http_api_endpoint": "aom-internal.cn-****-*.***.com:***/v1/2a4***56cc***7f837***891***c1cf/08****2a-8**b-4**5-b**1-d1********79",
                      "region_id": "cn-****-*",
                      "remote_read_url": "aom-internal.cn-****-*.***.com:***/v1/2a4***56cc***7f837***891***c1cf/08****2a-8**b-4**5-b**1-d1********79/api/v1/read",
                      "remote_write_url": "aom-internal.cn-****-*.***.com:***/v1/2a4***56cc***7f837***891***c1cf/08****2a-8**b-4**5-b**1-d1********79/push"
                    },
                    "prom_type": "CCE",
                    "prom_update_timestamp": 1691718171483
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/PromInstanceEpsResult"
            }
          }
        },
        "schemes": [
          "https"
        ],
        "tags": [
          "Prometheus实例"
        ]
      }
    }
