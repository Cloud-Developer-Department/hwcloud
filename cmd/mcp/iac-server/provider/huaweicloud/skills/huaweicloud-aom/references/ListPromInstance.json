{
  "name": "ListPromInstance",
  "summary": "查询Prometheus实例",
  "tags": "Prometheus实例",
  "productshort": "AOM",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/aom/prometheus": {
      "get": {
        "x-request-examples-url-1": "https://{Endpoint}/v1/{project_id}/aom/prometheus",
        "x-request-examples-description-1": "查询Prometheus实例。",
