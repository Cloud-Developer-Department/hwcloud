  "definitions": {
    "Response": {
      "type": "object",
      "properties": {
        "state": {
          "type": "boolean",
          "description": "执行状态:\n- true:成功下发任务。\n- false:失败下发任务。"
        }
      }
    },
    "NoPrivilegeException": {
      "properties": {
        "error_code": {
          "type": "string",
          "example": "AOM.32000002",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "No permission.",
          "description": "错误信息",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "PluginInstallBasicParam": {
      "type": "object",
      "example": {
        "install_version": "string",
        "domain_ak": "string",
        "domain_sk": "string"
      },
      "properties": {
        "install_version": {
          "type": "string",
          "description": "指定安装的ICAgent版本。"
        },
        "domain_ak": {
          "type": "string",
          "description": "IAM账号AK,选填。."
        },
        "domain_sk": {
          "type": "string",
          "description": "IAM账号SK,选填。"
        }
      }
    },
    "ParamException": {
      "properties": {
        "error_code": {
          "type": "string",
          "example": "AOM.32000003",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "Invalid parameter.",
          "description": "错误信息",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "AgentBatchImportParamNew": {
      "type": "object",
      "required": [
        "agent_import_param_list",
        "proxy_region_id",
        "installer_agent_id",
        "version",
        "public_net_flag"
      ],
      "properties": {
        "agent_import_param_list": {
          "type": "array",
          "description": "导入待安装UniAgent的机器参数列表。",
          "items": {
            "$ref": "#/definitions/AgentImportParamNew"
          }
        },
        "proxy_region_id": {
          "type": "integer",
          "description": "代理区域ID:\n- 直连接入填0。\n- 代理接入填实际代理区域ID。",
          "format": "int32"
        },
        "installer_agent_id": {
          "type": "string",
          "description": "安装机(代理机)的agent ID。"
        },
        "icagent_install_flag": {
          "type": "boolean",
          "description": "是否需要安装ICAgent插件:\n- true:安装ICAgent插件。默认安装最新版本的ICAgent插件。\n- false:不安装ICAgent插件。"
        },
        "plugin_install_base_param": {
          "description": "插件安装基础信息:\n- 当icagent_install_flag设置为true:如果没传入该信息,默认安装最新版本ICAgent插件;如果传入该信息,则安装指定版本的ICAgent插件。\n- 当icagent_install_flag设置为false:无论是否传入该信息,都不安装ICAgent插件。",
          "$ref": "#/definitions/PluginInstallBasicParam"
        },
        "version": {
          "type": "string",
          "description": "待安装的UniAgent版本号。"
        },
        "public_net_flag": {
          "type": "boolean",
          "description": "是否公网接入:\n- true:公网接入设置。\n- false:代理接入设置。"
        }
      }
    },
    "AgentImportParamNew": {
      "type": "object",
      "required": [
        "password",
        "inner_ip",
        "port",
        "account",
        "os_type"
      ],
      "properties": {
        "password": {
          "type": "string",
          "description": "机器登录密码。"
        },
        "agent_id": {
          "type": "string",
          "description": "agent唯一值,重复导入时需要传递。"
        },
        "inner_ip": {
          "type": "string",
          "description": "机器IP。"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "description": "机器登录端口,默认22。"
        },
        "account": {
          "type": "string",
          "description": "机器ssh账号。"
        },
        "os_type": {
          "type": "string",
          "description": "机器操作系统类型。"
        },
        "vpc_id": {
          "type": "string",
          "description": "机器所属VPC ID。"
        },
        "coc_cmdb_id": {
          "type": "string",
          "description": "外来唯一标识,COC用。"
        }
      }
    }
  },
