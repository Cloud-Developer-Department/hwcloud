        "tags": [
          "UniAgent管理"
        ],
        "summary": "下发批量安装UniAgent任务",
        "operationId": "BatchImportAgent",
        "description": "该接口用于下发批量安装UniAgent任务。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户从IAM申请到的projectid,一般为32位字符串。",
            "minLength": 32,
            "maxLength": 32
          },
          {
            "name": "region",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "region id,例如:cn-north-7"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "从IAM服务获取的用户Token。",
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "指定类型为application/json。",
            "type": "string",
            "enum": [
              "application/json"
            ]
          },
          {
            "name": "BatchImportAgentRequestBody",
            "in": "body",
            "description": "导入安装UniAgent的机器信息。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AgentBatchImportParamNew"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK 请求响应成功。",
            "examples": {
              "application/json": {
                "state": true
              }
            },
            "schema": {
              "$ref": "#/definitions/Response"
