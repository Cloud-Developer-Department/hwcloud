  "definitions": {
    "WordInfo": {
      "properties": {
        "start_time": {
          "type": "integer",
          "format": "int32",
          "example": 150,
          "description": "起始时间"
        },
        "end_time": {
          "type": "integer",
          "format": "int32",
          "example": 540,
          "description": "结束时间"
        },
        "word": {
          "type": "string",
          "example": "华为",
          "description": "分词"
        }
      },
      "description": ""
    },
    "AnalysisInfoResult": {
      "properties": {
        "role": {
          "type": "string",
          "description": "角色类型, 目前仅支持 AGENT(座席), USER(用户)。"
        },
        "emotion": {
          "type": "string",
          "description": "情绪类型,目前支持NORMAL(正常),ANGRY(愤怒),UNKNOWN(未知)。\n在识别配置中emotion为true时存在。"
        },
        "speed": {
          "type": "number",
          "format": "float",
          "description": "语速信息,单位是\"每秒字数\"。\n在识别配置中speed为true时存在。"
        }
      }
    },
    "ErrorResp": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码。\n调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      }
    },
    "GetTranscriberJobResp": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "录音文件识别任务标识符。\n\n使用“callback_url”回调url时,该字段会随结果发送至用户服务器。\n使用get接口查询,不会出现该字段"
        },
        "status": {
          "type": "string",
          "description": "当前识别状态。具体状态如下所示:\n\nWAITING 等待识别。\nFINISHED 识别已经完成。\nERROR 识别过程中发生错误。"
        },
        "create_time": {
          "type": "string",
          "description": "任务创建时间, 遵循 RFC 3339格式。\n格式示例:2018-12-04T13:10:29.310Z。"
        },
        "start_time": {
          "type": "string",
          "description": "开始识别时间, 遵循 RFC 3339格式。\n当status为FINISHED或ERROR时存在。\n格式示例:2018-12-04T13:10:29.310Z。"
        },
        "finish_time": {
          "type": "string",
          "description": "识别完成时间, 遵循 RFC 3339格式。\n当status为FINISHED或ERROR时存在。\n格式示例:2018-12-04T13:10:29.310Z。\n"
        },
        "segments": {
          "type": "array",
          "description": "转写结果, 多句结果的数组。\n",
          "items": {
            "$ref": "#/definitions/Segment"
          }
        },
        "audio_duration": {
          "type": "integer",
          "format": "int32",
          "description": "音频时长,单位ms"
        }
      }
    },
    "TranscriberResult": {
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "识别结果文本。"
        },
        "analysis_info": {
          "description": "每一句的质检分析结果对象 。\n仅在识别配置中的need_analysis_info不为null时存在该返回结果。",
          "$ref": "#/definitions/AnalysisInfoResult"
        },
        "word_info": {
          "type": "array",
          "description": "分词输出列表",
          "items": {
            "description": "分词信息",
            "$ref": "#/definitions/WordInfo"
          }
        }
      }
    },
    "Segment": {
      "required": [
        "end_time",
        "result",
        "start_time"
      ],
      "properties": {
        "start_time": {
          "type": "integer",
          "format": "int32",
          "description": "一句的起始时间戳,单位ms。"
        },
        "end_time": {
          "type": "integer",
          "format": "int32",
          "description": "一句的结束时间戳,单位ms。"
        },
        "result": {
          "description": "调用成功表示识别结果,调用失败时无此字段。",
          "$ref": "#/definitions/TranscriberResult"
        }
      }
    }
  },
