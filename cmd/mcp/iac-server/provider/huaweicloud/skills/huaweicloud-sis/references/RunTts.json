  "definitions": {
    "PostCustomTTSReq": {
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "待合成的文本,文本长度限制小于500字符。",
          "minLength": 1,
          "maxLength": 500
        },
        "config": {
          "description": "语音合成配置信息。",
          "$ref": "#/definitions/TtsConfig"
        }
      },
      "description": ""
    },
    "PostCustomTTSResp": {
      "required": [
        "trace_id"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "description": "服务内部的令牌,可用于在日志中追溯具体流程。\n\n在某些错误情况下可能没有此令牌字符串。"
        },
        "result": {
          "description": "调用成功表示识别结果,调用失败时无此字段。",
          "$ref": "#/definitions/CustomResult"
        }
      },
      "description": "语音合成响应消息体。"
    },
    "CustomResult": {
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "string",
          "description": "语音数据, Base64编码格式返回。"
        }
      },
      "description": "调用成功表示识别结果,调用失败时无此字段。"
    },
    "TtsConfig": {
      "properties": {
        "audio_format": {
          "type": "string",
          "description": "语音格式头:wav、mp3、pcm。\n默认:wav",
          "minLength": 1,
          "maxLength": 500,
          "enum": [
            "wav",
            "mp3",
            "pcm"
          ],
          "default": "wav"
        },
        "sample_rate": {
          "type": "string",
          "description": "采样率:16000、8000\n默认:8000",
          "enum": [
            "16000",
            "8000"
          ],
          "default": "16000"
        },
        "property": {
          "type": "string",
          "description": "语音合成特征字符串,组成形式为{language}_{speaker}_{domain},即“语种_人员标识_领域”。发音人分为普通发音人和精品发音人。\n\n普通发音人每100字计一次调用,取值范围如下: \n\nchinese_xiaoqi_common  小琪,标准女声发音人。\n\nchinese_xiaoyu_common  小宇,标准男声发音人。\n\nchinese_xiaoyan_common  小燕,温柔女声发音人。\n\nchinese_xiaowang_common  小王,童声发音人。\n\nchinese_xiaowen_common   小雯,柔美女声发音人。\n\nchinese_xiaojing_common 小婧,俏皮女声发音人。\n\nchinese_xiaosong_common  小宋,激昂男声发音人。\n\nchinese_xiaoxia_common   小夏,热情女声发音人。\n\nchinese_xiaodai_common   小呆,呆萌童声发音人。\n\nchinese_xiaoqian_common  小倩,成熟女声发音人。\n\nenglish_cameal_common    cameal,柔美女声英文发音人。\n\n\n精品发音人每50字计一次调用,区域仅支持cn-north-4,cn-east-3,暂时不支持音高调节,取值范围如下:\n\nchinese_huaxiaoxia_common  华小夏,热情女声发音人。\n\nchinese_huaxiaogang_common  华晓刚,利落男声发音人。\n\nchinese_huaxiaolu_common  华小璐,知性女声发音人。\n\nchinese_huaxiaoshu_common  华小舒,舒缓女声发音人。\n\nchinese_huaxiaowei_common  华小唯,嗲柔女声发音人。\n\nchinese_huaxiaoliang_common  华小靓,嘹亮女声发音人。\n\nchinese_huaxiaodong_common  华晓东,成熟男声发音人。\n\nchinese_huaxiaoyan_common  华小颜,严厉女声发音人。\n\nchinese_huaxiaoxuan_common  华小萱,台湾女声发音人。\n\nchinese_huaxiaowen_common  华小雯,柔美女声发音人。\n\nchinese_huaxiaoyang_common  华晓阳,朝气男声发音人。\n\nchinese_huaxiaomin_common  华小闽,闽南女声发音人。\n\nchinese_huanvxia_literature 华女侠,武侠女生发音人,只支持16k的采样率。\n\nchinese_huaxiaoxuan_literature 华晓悬,悬疑男声发音人,只支持16k的采样率。\n\nchinese_huaxiaomei_common 华小美,温柔女声发音人。\n\nchinese_huaxiaofei_common 华小飞,朝气男声发音人。\n\nchinese_huaxiaolong_common 华小龙,朝气男声发音人。\n\nchinese_huaxiaorui_common 华小蕊,知性女声发音人。\n\nchinese_huaxiaoru_common 华小汝,柔美女声发音人(中英混)。\n\nchinese_huaxiaohan_common 华小涵,知性女声发音人(中英混)。\n\nchinese_huaxiaoning_common 华小宁,沉稳男声发言人(中英混)。\n\nchinese_huaxiaozhen_common 华小珍,温柔女声发音人(中英混)。\n\nchinese_huaxiaoman_common 华小曼,温柔女声发音人(中英混)。\n\nchinese_huaxiaofang_common 华小芳,朝气女声发音人(中英混)。\n\nchinese_huaxiaojun_common 华小筠,成熟女声发音人(中英混)。\n\nenglish_alvin_common alvin,成熟男声纯英文发音人。\n\nenglish_amy_common amy amy,成熟女声纯英文发音人。\n\n默认:chinese_xiaoyan_common",
          "enum": [
            "chinese_xiaoqi_common",
            "chinese_xiaoyu_common",
            "chinese_xiaoyan_common",
            "chinese_xiaoxia_common",
            "chinese_xiaodai_common",
            "chinese_xiaoqian_common",
            "chinese_xiaowang_common",
            "chinese_xiaowen_common",
            "chinese_xiaojing_common",
            "chinese_xiaosong_common",
            "english_cameal_common",
            "chinese_huaxiaoxia_common",
            "chinese_huaxiaogang_common",
            "chinese_huaxiaolu_common",
            "chinese_huaxiaoshu_common",
            "chinese_huaxiaowei_common",
            "chinese_huaxiaoliang_common",
            "chinese_huaxiaodong_common",
            "chinese_huaxiaoyan_common",
            "chinese_huaxiaoxuan_common",
            "chinese_huaxiaowen_common",
            "chinese_huaxiaoyang_common",
            "chinese_huaxiaomin_common",
            "chinese_huanvxia_literature",
            "chinese_huaxiaoxuan_literature",
            "chinese_huaxiaomei_common",
            "chinese_huaxiaofei_common",
            "chinese_huaxiaolong_common",
            "chinese_huaxiaorui_common",
            "chinese_huaxiaoru_common",
            "chinese_huaxiaohan_common",
            "chinese_huaxiaoning_common",
            "chinese_huaxiaozhen_common",
            "chinese_huaxiaoman_common",
            "chinese_huaxiaofang_common",
            "chinese_huaxiaojun_common",
            "english_alvin_common",
            "english_amy_common"
          ],
          "default": "chinese_xiaoyan_common"
        },
        "speed": {
          "type": "integer",
          "format": "int32",
          "description": "语速。\n取值范围:[-500,500]\n\n默认值:0",
          "minimum": -500,
          "maximum": 500,
          "default": 0
        },
        "pitch": {
          "type": "integer",
          "format": "int32",
          "description": "音高。\n取值范围: [-500,500]\n\n默认值:0",
          "minimum": -500,
          "maximum": 500,
          "default": 0
        },
        "volume": {
          "type": "integer",
          "format": "int32",
          "description": "音量。\n取值范围:[0, 100]\n\n默认值:50",
          "minimum": 0,
          "maximum": 100,
          "default": 50
        }
      },
      "description": "语音合成配置数据结构。"
    },
    "TtsErrorResp": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码。\n调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      },
      "description": "错误响应消息体。"
    }
