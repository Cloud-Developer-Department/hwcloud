  "definitions": {
    "WordInfo": {
      "properties": {
        "start_time": {
          "type": "integer",
          "format": "int32",
          "example": 150,
          "description": "起始时间"
        },
        "end_time": {
          "type": "integer",
          "format": "int32",
          "example": 540,
          "description": "结束时间"
        },
        "word": {
          "type": "string",
          "example": "华为",
          "description": "分词"
        }
      },
      "description": ""
    },
    "Config": {
      "required": [
        "audio_format",
        "property"
      ],
      "properties": {
        "audio_format": {
          "type": "string",
          "description": "支持语音的格式。\n\naudio_format取值范围:\n\npcm16k16bit  16k16bit单通道录音数据。\n\npcm8k16bit   8k16bit单通道录音数据。\n\nulaw16k8bit  16k8bit ulaw 单通道录音数据。\n\nulaw8k8bit   8k8bit ulaw 单通道录音数据。\n\nalaw16k8bit  16k8bit alaw 单通道录音数据。\n\nalaw8k8bit   8k8bit alaw 单通道录音数据。\n\nmp3  mp3格式音频。目前仅支持单通道的音频。\n\naac  aac格式音频。目前仅支持单通道的音频。\n\nwav  带wav封装头的格式,从封装头中自动确定格式,目前仅支持8k/16k采样率、单通道、pcm, alaw, ulaw三种编码格式\n\namr  AMR窄带(8k) 压缩录音数据。\n\namrwb  AMR 宽带(16k) 压缩录音数据。\n\nauto 由引擎自动判断音频数据的格式并解码,支持自动判断wav,mp3,amr/amrwb,aac,m4a,wma格式",
          "enum": [
            "pcm16k16bit",
            "pcm8k16bit",
            "ulaw16k8bit",
            "ulaw8k8bit",
            "alaw16k8bit",
            "alaw8k8bit",
            "mp3",
            "aac",
            "wav",
            "amr",
            "amrwb",
            "auto"
          ],
          "default": "pcm16k16bit"
        },
        "property": {
          "type": "string",
          "description": "所使用的模型特征串。通常是 “语种_采样率_领域”的形式。\n\n采样率需要与音频采样率保持一致。\n\n当前支持如下模型特征串:\n\nchinese_16k_general  支持采样率为16k的中文普通话语音识别,同时可识别一些简单的方言。格式仅支持pcm16k16bit、mp3、wav,区域仅支持cn-north-4。\n\nchinese_16k_travel 支持采样率为16k的中文普通话语音识别,采用新一代端到端识别算法,并针对网约车质检场景进行了优化。格式仅支持pcm16k16bit、mp3、wav和aac,区域支持cn-east-3和cn-north-4(强烈推荐使用)。\n\nchinese_8k_common  支持采样率为8k的中文普通话语音识别。\n\nchinese_16k_common  支持采样率为16k的中文普通话语音识别。\n\nsichuan_16k_common  支持采样率为16k的中文普通话与四川话方言识别。区域仅支持cn-north-4。\n\ncantonese_16k_common  支持采样率为16k的粤语方言识别。区域仅支持cn-north-4。\n\nshanghai_16k_common  支持采样率为16k的上海话方言识别,区域仅支持cn-north-4。\n\nenglish_8k_common  支持采样率为16k的英文识别,区域仅支持cn-east-3,格式仅支持wav。\n\nenglish_16k_common  支持采样率为16k的英文识别,区域仅支持cn-east-3,格式仅支持wav。",
          "enum": [
            "chinese_16k_general",
            "chinese_16k_travel",
            "chinese_8k_common",
            "chinese_16k_common",
            "sichuan_16k_common",
            "cantonese_16k_common",
            "shanghai_16k_common",
            "english_8k_common",
            "english_16k_common"
          ],
          "default": "chinese_16k_common"
        },
        "add_punc": {
          "type": "string",
          "description": "表示是否在识别结果中添加标点,取值为“yes”和“no”,缺省为“no”。",
          "enum": [
            "yes",
            "no"
          ],
          "default": "no"
        },
        "vocabulary_id": {
          "type": "string",
          "description": "热词表id,不使用则不填写。"
        },
        "digit_norm": {
          "type": "string",
          "description": "表示是否将语音中的数字识别为阿拉伯数字,取值为“yes” 和 “no”,缺省为“yes”。",
          "enum": [
            "yes",
            "no"
          ],
          "default": "yes"
        },
        "need_word_info": {
          "type": "string",
          "description": "表示是否在识别结果中输出分词结果信息,取值为“yes”和“no”,默认为“no”。",
          "enum": [
            "yes",
            "no"
          ],
          "default": "no"
        },
        "auto_language_detect": {
          "type": "string",
          "description": "表示是否开启普英方自动识别,取值为“yes”和“no”,默认为“no”。",
          "enum": [
            "yes",
            "no"
          ],
          "default": "no"
        }
      }
    },
    "PostShortAudioReq": {
      "required": [
        "config",
        "data"
      ],
      "properties": {
        "config": {
          "description": "配置信息。",
          "$ref": "#/definitions/Config"
        },
        "data": {
          "type": "string",
          "description": "语音数据,base64编码,要求base64编码后大小不超过4M,音频时长不超过1分钟。"
        }
      }
    },
    "PostShortAudioResp": {
      "required": [
        "result",
        "trace_id"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "description": "服务内部的令牌,可用于在日志中追溯具体流程,调用失败无此字段。\n\n在某些错误情况下可能没有此令牌字符串。"
        },
        "result": {
          "description": "调用成功表示识别结果,调用失败时无此字段。",
          "$ref": "#/definitions/Result"
        }
      }
    },
    "ErrorResp": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码。\n调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      }
    },
    "Result": {
      "required": [
        "score",
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "调用成功表示识别出的内容。"
        },
        "score": {
          "type": "number",
          "format": "float",
          "description": "调用成功表示识别出的置信度,取值范围:0~1。"
        },
        "word_info": {
          "type": "array",
          "description": "分词信息列表",
          "items": {
            "description": "",
            "$ref": "#/definitions/WordInfo"
          }
        }
      }
    }
  },
