{
  "name": "RecognizeFlashAsr",
  "summary": "录音文件识别极速版",
  "tags": "语音识别接口",
  "productshort": "SIS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/{project_id}/asr/flash": {
      "post": {
        "tags": [
          "语音识别接口"
        ],
        "summary": "录音文件识别极速版",
        "description": "极速版ASR(Restful API 接口, 适用于音频(文件大小<=100M,语音时长<=30分钟)文件的同步识别。\n此接口以POST方式一次性上传整个音频或从华为OBS中下载音频, 识别结果将在请求响应中即刻返回,用于语音文件极速转写,质检分析的离线场景。",
        "operationId": "RecognizeFlashAsr",
        "consumes": [],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "华为云用户的Project ID,用于资源隔离。",
            "required": true,
            "type": "string",
            "x-order": 1
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "华为云用户Token,用于鉴权",
            "required": true,
            "type": "string",
            "x-order": 2
          },
          {
            "name": "property",
            "in": "query",
            "description": "所使用的模型特征串。通常是 “语种_采样率_领域”的形式。\n采样率需要与音频采样率保持一致。\n当前支持如下模型特征串:\nchinese_8k_common\nchinese_16k_conversation",
            "required": true,
            "type": "string",
            "default": "chinese_8k_common",
            "enum": [
              "chinese_8k_common",
              "chinese_16k_conversation"
            ],
            "x-order": 3
          },
          {
            "name": "audio_format",
            "in": "query",
            "description": "音频格式,audio_format取值范围:\nwav,mp3,m4a,aac,opus",
            "required": true,
            "type": "string",
            "default": "wav",
            "enum": [
              "wav",
              "mp3",
              "m4a",
              "aac",
              "opus"
            ],
            "x-example": "wav",
            "x-order": 4
          },
          {
            "name": "obs_bucket_name",
            "in": "query",
            "description": "obs桶名",
            "required": true,
            "type": "string",
            "x-order": 5
          },
          {
            "name": "obs_object_key",
            "in": "query",
            "description": "obs对象key,经过urlencode编码,长度不超过1024个字符",
            "required": true,
            "type": "string",
            "x-order": 6
          },
          {
            "name": "add_punc",
            "in": "query",
            "description": "是否加标点, 可以为 yes, 默认no",
            "required": false,
            "type": "string",
            "default": "no",
            "enum": [
              "yes",
              "no"
            ],
            "x-example": "no",
            "x-order": 7
          },
          {
            "name": "digit_norm",
            "in": "query",
            "description": "是否将音频中的数字使用阿拉伯数字的形式呈现,取值为yes,no,默认为yes",
            "required": false,
            "type": "string",
            "default": "yes",
            "enum": [
              "yes",
              "no"
            ],
            "x-example": "yes",
            "x-order": 8
          },
          {
            "name": "need_word_info",
            "in": "query",
            "description": "表示是否在识别结果中输出分词结果信息,取值为yes,no,默认no",
            "required": false,
            "type": "string",
            "default": "no",
            "enum": [
              "yes",
              "no"
            ],
            "x-example": "no",
            "x-order": 9
          },
          {
            "name": "vocabulary_id",
            "in": "query",
            "description": "热词表id",
            "required": false,
            "type": "string",
            "x-example": "4c111ee8-fbd6-4a73-941a-9f869c6c56f5",
            "x-order": 10
          },
          {
            "name": "first_channel_only",
            "in": "query",
            "description": "表示是否在识别中只识别首个声道的音频数据,取值为“yes”和“no”,默认为“no”。",
            "required": false,
            "type": "string",
            "default": "no",
            "enum": [
              "yes",
              "no"
            ],
            "x-example": "no",
            "x-order": 11
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "trace_id": "567e8537-a89c-13c3-a882-826321939651",
                "audio_duration": 1310,
                "flash_result": [
                  {
                    "channel_id": 0,
                    "sentences": [
                      {
                        "start_time": 560,
                        "end_time": 1320,
                        "result": {
                          "text": "北京你好",
                          "score": 0.831,
                          "word_info": [
                            {
                              "word": "北京",
                              "start_time": 560,
                              "end_time": 890
                            },
                            {
                              "word": "你好",
                              "start_time": 920,
                              "end_time": 1310
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/PostFlashAsrResp"
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "SIS.0032",
                "error_msg": "property is invalid"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          }
        },
        "deprecated": false,
        "x-name": "录音文件识别极速版",
        "x-constraint": "",
        "x-scope": "TechnicalPreview",
        "x-order": 4,
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "https://{endpoint}/v1/{{project_id}}/asr/flash?property=chinese_8k_common&audio_format=wav&add_punc=yes&digit_norm=yes&need_word_info=yes&vocabulary_id=4c111ee8-fbd6-4a73-941a-9f869c6c56f5&obs_bucket_name=test&obs_object_key=test/test.wav",
        "x-request-examples-1": "",
        "x-request-examples-text-1": "",
        "x-publishpath": "",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc",
        "x-apiexplorer-hide": "N",
        "x-is-registered": "Y",
        "x-apiErrorCodes": [
          {
            "errorCode": "SIS.0002",
            "httpStatus": "400",
            "errorMessage": "认证失败",
            "errorDescription": "认证失败,检查Token是否正确",
            "solution": "检查Token是否正确,使用正确的Token重新尝试。",
            "errorDescriptionEn": "",
            "solutionEn": ""
          },
          {
            "errorCode": "SIS.0032",
            "httpStatus": "400",
            "errorMessage": "请求参数异常",
            "errorDescription": "请求参数异常,请检查所有请求参数是否正确",
            "solution": "请求参数异常,请检查所有请求参数是否正确",
            "errorDescriptionEn": "",
            "solutionEn": ""
          },
          {
            "errorCode": "SIS.0003",
            "httpStatus": "500",
            "errorMessage": "内部服务异常",
            "errorDescription": "内部服务异常",
            "solution": "请联系服务管理员。",
            "errorDescriptionEn": "",
            "solutionEn": ""
          }
        ]
      }
    }
  },
  "definitions": {
    "WordInfo": {
      "properties": {
        "start_time": {
          "type": "integer",
          "format": "int32",
          "example": 150,
          "description": "起始时间"
        },
        "end_time": {
          "type": "integer",
          "format": "int32",
          "example": 540,
          "description": "结束时间"
        },
        "word": {
          "type": "string",
          "example": "华为",
          "description": "分词"
        }
      },
      "description": ""
    },
    "ErrorResp": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码。\n调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      }
    },
    "Sentences": {
      "properties": {
        "end_time": {
          "type": "integer",
          "format": "int32",
          "example": 1320,
          "description": "分句结果信息"
        },
        "result": {
          "description": "分句结果信息",
          "$ref": "#/definitions/FlashScoreResult"
        },
        "start_time": {
          "type": "integer",
          "format": "int32",
          "example": 560,
          "description": "一句话开始时间,单位毫秒"
        }
      },
      "description": ""
    },
    "FlashScoreResult": {
      "required": [
        "score",
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "调用成功表示识别出的内容。"
        },
        "score": {
          "type": "number",
          "format": "double",
          "description": "调用成功表示识别出的置信度,取值范围:0~1。"
        },
        "word_info": {
          "type": "array",
          "description": "分词信息列表",
          "items": {
            "description": "",
            "$ref": "#/definitions/WordInfo"
          }
        }
      }
    },
    "FlashResult": {
      "properties": {
        "channel_id": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "音频声道id"
        },
        "sentences": {
          "type": "array",
          "example": "[{\"start_time\":560,\"end_time\":1320,\"result\":{\"text\":\"北京你好\",\"score\":0.831,\"word_info\":[{\"word\":\"北京\",\"start_time\":560,\"end_time\":890},{\"word\":\"你好\",\"start_time\":920,\"end_time\":1310}]}}]",
          "description": "分句结果",
          "items": {
            "description": "",
            "$ref": "#/definitions/Sentences"
          }
        }
      },
      "description": ""
    },
    "PostFlashAsrResp": {
      "required": [
        "audio_duration",
        "flash_result",
        "trace_id"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "description": "服务内部的令牌,可用于在日志中追溯具体调用流程"
        },
        "audio_duration": {
          "type": "integer",
          "format": "int32",
          "description": "音频时长"
        },
        "flash_result": {
          "type": "array",
          "description": "识别结果",
          "items": {
            "description": "",
            "$ref": "#/definitions/FlashResult"
          }
        }
      },
      "description": ""
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "sis-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
