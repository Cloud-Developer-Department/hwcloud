  "definitions": {
    "GenerateSpeechRsp": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string",
          "description": "服务内部的令牌,可用于在日志中追溯具体流程。"
        },
        "result": {
          "description": "调用成功表示识别结果,调用失败时无此字段。",
          "properties": {
            "data": {
              "type": "string",
              "description": "语音数据,Base64编码格式返回。"
            }
          }
        }
      }
    },
    "vcsErrorResp": {
      "type": "object",
      "description": "Internal Server Error",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码。\n调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      }
    },
    "GenerateSpeechRequestBody": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "待合成的文本,文本长度不大于300字符。"
        },
        "config": {
          "description": "语音合成配置信息。",
          "properties": {
            "audio_format": {
              "type": "string",
              "description": "语音格式头:wav、mp3、pcm。\n默认:wav"
            },
            "sample_rate": {
              "type": "string",
              "description": "采样率:8kHz、16kHz、24kHz。\n默认:24kHz"
            },
            "voice_name": {
              "type": "string",
              "description": "音色名称。"
            },
            "speed": {
              "type": "integer",
              "format": "int32",
              "description": "语速:-500~500。\n默认:0"
            },
            "pitch": {
              "type": "integer",
              "format": "int32",
              "description": "音高:-500~500。\n默认:0"
            },
            "volume": {
              "type": "integer",
              "format": "int32",
              "description": "音量:0~100。\n默认:50"
            }
          },
          "required": [
            "voice_name"
          ]
        }
      },
      "required": [
        "text",
        "config"
      ]
    }
