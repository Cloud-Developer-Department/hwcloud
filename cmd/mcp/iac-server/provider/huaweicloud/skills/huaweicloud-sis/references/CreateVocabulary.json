    "PostCreateVocabReq": {
      "required": [
        "contents",
        "language",
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "热词表名,不可重复。内容限制为字母,数字,下中划线和井号,长度不超过32字节。",
          "minLength": 1,
          "maxLength": 32
        },
        "description": {
          "type": "string",
          "description": "热词表描述,长度不超过255字节。",
          "minLength": 0,
          "maxLength": 255
        },
        "language": {
          "type": "string",
          "description": "热词表语言类型。\n\nlanguage取值范围:\nchinese_mandarin  汉语普通话",
          "enum": [
            "chinese_mandarin"
          ],
          "default": "chinese_mandarin"
        },
        "contents": {
          "type": "array",
          "description": "支持中英混编热词,单个热词只能由英文字母和unicode编码的汉字组成,不能有其他符号,包括空格。\n阿拉伯数字需写成汉字或英文(如“一”、“one”)。\n\n单词库支持热词数上限1024。\n单个热词长度上限32字节。",
          "items": {
            "type": "string",
            "description": "",
            "minLength": 1,
            "maxLength": 32
          },
          "maxItems": 1024,
          "minItems": 1
        }
      },
      "description": ""
    },
