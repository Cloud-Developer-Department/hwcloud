{
  "name": "CreateVoice",
  "summary": "注册接口",
  "tags": "声音复刻接口",
  "productshort": "SIS",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/vcs/voices": {
      "post": {
        "tags": [
          "声音复刻接口"
        ],
        "x-apiexplorer-hide": "N",
        "x-open-region-cloud": "hc",
        "x-support-sdk": "Y",
        "x-request-examples-url-1": "https://{endpoint}//v1/{project_id}/vcs/voices",
        "x-request-examples-text-1": {
          "config": {
            "voice_name": "test_001",
            "language": "chinese"
          },
          "data": "d+++++++"
        },
        "x-request-examples-1": {
          "config": {
            "voice_name": "test_001",
            "language": "chinese"
          },
          "data": "d+++++++"
        },
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "summary": "注册接口",
        "description": "客户上传一段录音,并指定voice_name,在系统中注册声音。",
        "operationId": "CreateVoice",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "来自公有云的Project ID,用于资源隔离。"
          },
          {
            "name": "CreateVoiceRequestBody",
            "in": "body",
            "required": true,
            "description": "请求体",
            "schema": {
              "$ref": "#/definitions/RegisterVoiceReq"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "注册声音成功",
            "schema": {
              "$ref": "#/definitions/RegisterVoiceResponseBody"
            },
            "examples": {
              "application/json": {
                "trace_id": "567e8537-a89c-13c3-a882-826321939651",
                "result": {
                  "voice_name": "chinese_xiaoming_xxxxxxxxxx"
                }
              }
            }
          },
          "400": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/vcsErrorResp"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/vcsErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "SIS.0101",
                "error_msg": "auth failed, please check if token correct"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/vcsErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "SIS.0100",
                "error_msg": "inner service exception"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "RegisterVoiceReq": {
      "type": "object",
      "required": [
        "config",
        "data"
      ],
      "properties": {
        "config": {
          "description": "配置信息",
          "required": [
            "voice_name"
          ],
          "properties": {
            "voice_name": {
              "type": "string",
              "description": "注册声音的名称,不能以数字、下划线开头。仅包含大、小写英文字母、数字和下划线,且长度不超过20个字符。一个project id下的声音名称不能重复。"
            },
            "language": {
              "type": "string",
              "description": "data中语音数据的语种,取值chinese、english。\n默认是chinese。"
            }
          }
        },
        "data": {
          "type": "string",
          "description": "录音数据,使用base64编码,大小不超过6MB。支持wav、mp3、m4a格式,采样率不小于16kHz,时长在5-25秒,支持单、双通道。"
        }
      }
    },
    "RegisterVoiceResponseBody": {
      "type": "object",
      "required": [
        "trace_id",
        "result"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "description": "服务内部的令牌,可用于在日志中追溯具体流程。"
        },
        "result": {
          "type": "object",
          "description": "注册声音响应。",
          "properties": {
            "voice_name": {
              "type": "string",
              "description": "注册声音的名称。"
            }
          }
        }
      }
    },
    "vcsErrorResp": {
      "type": "object",
      "description": "Internal Server Error",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码。\n调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "sis-ext.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}