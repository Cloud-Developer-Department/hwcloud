{
  "name": "ListVoices",
  "summary": "查询接口",
  "tags": "声音复刻接口",
  "productshort": "SIS",
  "region_id": "me-east-1",
  "paths": {
    "/v1/{project_id}/vcs/voices": {
      "get": {
        "tags": [
          "声音复刻接口"
        ],
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/vcs/voices?offset=0&limit=10",
        "x-request-examples-text-1": "Request Header:\nContent-Type: application/json\nX-Auth-Token: MIINRwYJKoZIhvcNAQcCoIINODCCDTQCAQExDTALBglghkgBZQMEAgEwgguVBgkqhkiG...",
        "x-request-examples-1": "Request Header:\nContent-Type: application/json\nX-Auth-Token: MIINRwYJKoZIhvcNAQcCoIINODCCDTQCAQExDTALBglghkgBZQMEAgEwgguVBgkqhkiG...",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc",
        "x-apiexplorer-hide": "N",
        "summary": "查询接口",
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "description": "查询已注册的声音列表。",
        "operationId": "ListVoices",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "来自公有云的Project ID,用于资源隔离。"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "华为云用户Token,用于鉴权",
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "description": "查询已注册的声音列表,每页查询显示的条目数量,默认:10",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "required": true,
            "description": "查询已注册的声音列表,页码偏移量,表示从此页码偏移量开始查询,offset大于等于0, 默认:0",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询注册声音成功。",
            "schema": {
              "$ref": "#/definitions/VoiceList"
            },
            "examples": {
              "application/json": {
                "trace_id": "567e8537-a89c-13c3-a882-826321939651",
                "result": {
                  "voices": [
                    {
                      "voice_name": "chinese_xiaoming_001",
                      "language": "chinese"
                    },
                    {
                      "voice_name": "chinese_xiaoming_002",
                      "language": "chinese"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/vcsErrorResp"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/vcsErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "SIS.0101",
                "error_msg": "auth failed, please check if token correct"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "vcsErrorResp": {
      "type": "object",
      "description": "Internal Server Error",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码。\n调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      }
    },
    "VoiceList": {
      "type": "object",
      "required": [
        "trace_id"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "description": "服务内部的令牌,可用于在日志中追溯具体流程,调用失败无此字段。\n\n在某些错误情况下可能没有此令牌字符串。"
        },
        "result": {
          "description": "注册成功的声音列表,调用失败时无此字段。",
          "properties": {
            "voices": {
              "type": "array",
              "items": {
                "properties": {
                  "voice_name": {
                    "type": "string",
                    "description": "注册成功的声音名称。"
                  },
                  "language": {
                    "type": "string",
                    "description": "注册成功的声音语种。"
                  }
                }
              },
              "description": "声色列表"
            }
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
