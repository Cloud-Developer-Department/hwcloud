  "definitions": {
    "LtslogInfo": {
      "type": "object",
      "description": "**参数解释**:\nLTS日志信息。\n**取值范围**:\n不涉及。",
      "properties": {
        "status": {
          "type": "string",
          "description": "**参数解释**:\n配置状态。\n**取值范围**:\n- OPEN:开启。\n- CLOSE:关闭。",
          "example": "OPEN"
        },
        "id": {
          "type": "string",
          "description": "**参数解释**:\n日志ID。\n**取值范围**:\n不涉及。",
          "example": "c0c4e5f2-9b2a-4b47-a649-baf40b33e2e0"
        },
        "log_type": {
          "type": "string",
          "description": "**参数解释**:\n日志类型。\n**取值范围**:\n- messages:系统日志。\n- expand:扩容日志。\n- roach-controller:roach服务端日志。\n- audit:审计日志。\n- gtm:gtm日志。\n- roach-agent:roach客户端日志。\n- cms:cms日志。\n- CN:dws-CN节点日志。\n- upgrade: 升级日志。\n- DN: dws-DN节点日志。",
          "example": "messages"
        },
        "log_desc": {
          "type": "string",
          "description": "**参数解释**:\n日志描述。\n**取值范围**:\n不涉及。",
          "example": "operating system messages log"
        },
        "access_url": {
          "type": "string",
          "description": "**参数解释**:\nLTS日志访问URL。\n**取值范围**:\n不涉及。",
          "example": "/lts/?region=cn-north-7&locale=#/cts/logEventsLeftMenu/events"
        }
      },
      "required": [
        "status",
        "id",
        "log_type",
        "log_desc",
        "access_url"
      ]
    },
    "ListLtslogBody": {
      "type": "object",
      "description": "**参数解释**:\n获取LTS日志列表。\n**取值范围**:\n不涉及。",
      "properties": {
        "access_status": {
          "description": "**参数解释**:\n日志开启状态。\n**取值范围**:\n- OPEN:开启。\n- CLOSE:关闭。\n- DELETE:集群已删除。",
          "type": "string",
          "example": "OPEN"
        },
        "lts_access_list": {
          "description": "**参数解释**:\nLTS日志列表。\n**取值范围**:\n不涉及。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/LtslogInfo"
          }
        },
        "count": {
          "description": "**参数解释**:\n总数量。\n**取值范围**:\n大于等于0。",
          "type": "integer"
        }
      }
