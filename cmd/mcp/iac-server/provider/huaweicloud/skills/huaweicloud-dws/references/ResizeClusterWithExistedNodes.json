  "definitions": {
    "ResizeClusterWithExistedNodesRequestBody": {
      "type": "object",
      "description": "**参数解释**:\n节点扩容请求。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
      "properties": {
        "scale_out": {
          "description": "**参数解释**:\n扩容对象。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "$ref": "#/definitions/ScaleOut"
        },
        "force_backup": {
          "description": "**参数解释**:\n是否强制备份。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "type": "boolean"
        },
        "mode": {
          "description": "**参数解释**:\n扩容模式,不传默认离线read-only。\n**约束限制**:\n在线模式在大部分低版本集群不支持,请在联系运维人员确认后方才可用。\n**取值范围**:\nread-only:离线模式\ninsert:在线模式\n**默认取值**:\n不涉及。",
          "type": "string"
        },
        "logical_cluster_name": {
          "description": "**参数解释**:\n逻辑集群名称。\n**约束限制**:\n不涉及。\n**取值范围**:\n非逻辑集群模式下该字段不填,逻辑集群模式下不传默认elastic_group。\n**默认取值**:\nelastic_group",
          "type": "string"
        },
        "expand_with_existed_node": {
          "description": "**参数解释**:\n是否是使用已添加的空闲节点进行扩容。\n**约束限制**:\n不涉及。\n**取值范围**:\ntrue:使用空闲节点扩容\nfalse:不使用空闲节点扩容\n**默认取值**:\nfalse",
          "type": "boolean"
        },
        "auto_redistribute": {
          "description": "**参数解释**:\n扩容完成后是否自动启动重分布,默认true。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\ntrue",
          "type": "boolean"
        },
        "redis_conf": {
          "description": "**参数解释**:\n重分布配置信息。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "$ref": "#/definitions/RedisConfReq"
        }
      },
      "required": [
        "scale_out",
        "expand_with_existed_node"
      ]
    },
    "ScaleOut": {
      "description": "**参数解释**:\n扩容集群详情。\n**取值范围**:\n不涉及。",
      "properties": {
        "count": {
          "format": "int32",
          "description": "**参数解释**:\n扩容节点数。\n**取值范围**:\n大于等于3。",
          "type": "integer",
          "example": 3
        },
        "subnet_id": {
          "description": "**参数解释**:\n子网ID。\n**取值范围**:\n同VPC下有效的子网ID。",
          "type": "string"
        }
      },
      "required": [
        "count"
      ]
    },
    "RedisConfReq": {
      "type": "object",
      "description": "重分布配置请求信息",
      "properties": {
        "redis_mode": {
          "description": "**参数解释**:\n重分布模式,不同模式对业务影响不同,修改建议联系运维人员评估后再决定。\n**约束限制**:\n必须是有效的dws集群ID。\n**取值范围**:\nonline或offLine:在线模式。\noffline或offLine:离线模式。\n**默认取值**:\noffLine",
          "type": "string"
        },
        "parallel_jobs": {
          "description": "**参数解释**:\n并行作业数量,默认4。\n**约束限制**:\n不涉及。\n**取值范围**:\n1~200\n**默认取值**:\n4",
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "redis_mode",
        "parallel_jobs"
      ]
    },
