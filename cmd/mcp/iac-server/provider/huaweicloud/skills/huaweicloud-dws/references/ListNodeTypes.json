  "definitions": {
    "NodeTypeElasticVolumeSpecs": {
      "description": "**参数解释**:\n如果规格为弹性容量规格,则该属性为规格典配的弹性容量信息,包括存储类型、最小容量、最大容量以及步长信息,如果为固定存储规格,则该属性为null。\n**取值范围**:\n不涉及。",
      "properties": {
        "type": {
          "description": "**参数解释**:\n云盘存储类型。\n**取值范围**:\n- SATA:普通IO。\n- SAS:高IO。\n- SSD:超高IO。\n- ESSD:极速型SSD。\n- GPSSD:通用型SSD。",
          "type": "string"
        },
        "step": {
          "description": "**参数解释**:\n云盘容量调整步长。\n**取值范围**:\n不涉及。",
          "type": "integer",
          "format": "int32"
        },
        "min_size": {
          "description": "**参数解释**:\n云盘支持的最小容量。\n**取值范围**:\n不涉及。",
          "type": "integer"
        },
        "max_size": {
          "description": "**参数解释**:\n云盘支持的最大容量。\n**取值范围**:\n不涉及。",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "step",
        "min_size",
        "max_size"
      ],
      "type": "object"
    },
    "ListNodeTypesResponseBody": {
      "description": "**参数解释**:\n规格信息对象。\n**取值范围**:\n不涉及。",
      "properties": {
        "node_types": {
          "description": "**参数解释**:\n可用的规格列表。\n**取值范围**:\n非空对象列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/NodeTypes"
          }
        },
        "count": {
          "description": "**参数解释**:\n规格总数\n**取值范围**:\n大于等于0的正整数。",
          "type": "integer"
        }
      },
      "required": [
        "node_types",
        "count"
      ],
      "type": "object"
    },
    "NodeTypeDatastores": {
      "description": "**参数解释**:\n内核版本信息。\n**取值范围**:\n数字、小数点,格式一般如 9.1.0、9.1.1.100。",
      "properties": {
        "version": {
          "description": "**参数解释**:\n内核版本号。\n**取值范围**:\n数字、小数点,格式一般如 9.1.0、9.1.1.100。",
          "type": "string"
        },
        "attachments": {
          "description": "**参数解释**:\n内核版本附加信息。\n**取值范围**:\n不涉及。",
          "properties": {
            "min_cn": {
              "description": "**参数解释**:\n内核版本支持的最小CN。\n**取值范围**:\n大于0的正整数。",
              "type": "integer",
              "format": "int32"
            },
            "max_cn": {
              "description": "**参数解释**:\n内核版本支持的最大CN。\n**取值范围**:\n大于0的正整数。",
              "type": "integer",
              "format": "int32"
            }
          }
        },
        "role": {
          "type": "string",
          "description": "**参数解释**:\n版本类型。\n**取值范围**:\n- STABLE:稳定版\n- PREVIEW:预览版"
        }
      },
      "required": [
        "version"
      ],
      "type": "object"
    },
    "NodeTypes": {
      "description": "**参数解释**:\n节点规格对象。\n**取值范围**:\n不涉及。",
      "properties": {
        "spec_name": {
          "description": "**参数解释**:\n规格名称。\n**取值范围**:\n字母、数字、小数点、下划线、短横线。",
          "type": "string"
        },
        "detail": {
          "description": "**参数解释**:\n规格详细信息。\n**取值范围**:\n不涉及。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Detail"
          }
        },
        "id": {
          "description": "**参数解释**:\n规格ID。\n**取值范围**:\n一般为UUID。",
          "type": "string"
        },
        "datastore_type": {
          "description": "**参数解释**:\n产品类型。\n**取值范围**:\n- dws:云数仓。\n- hybrid:实时数仓。",
          "type": "string"
        },
        "architecture": {
          "description": "**参数解释**:\n架构类型。\n**取值范围**:\n- x86。\n- arm。",
          "type": "string"
        },
        "available_zones": {
          "description": "**参数解释**:\n支持的可用区及状态信息。\n**取值范围**:\n不涉及。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/NodeTypeAvailableZones"
          }
        },
        "ram": {
          "description": "**参数解释**:\n内存大小。单位:GB。\n**取值范围**:\n大于0的正整数。",
          "type": "integer"
        },
        "vcpus": {
          "description": "**参数解释**:\nCPU数量。\n**取值范围**:\n大于0的正整数。",
          "type": "integer"
        },
        "datastores": {
          "description": "**参数解释**:\n内核版本信息。\n**取值范围**:\n不涉及。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/NodeTypeDatastores"
          }
        },
        "volume": {
          "description": "**参数解释**:\n固定存储容量规格的存储容量信息。\n**取值范围**:\n如果规格为固定存储容量规格,则该属性为规格典配的存储容量信息,如果为弹性存储规格,则该属性为null。",
          "$ref": "#/definitions/VolumeResp"
        },
        "elastic_volume_specs": {
          "description": "**参数解释**:\n弹性容量规格的规格容量信息。\n**取值范围**:\n如果规格为弹性容量规格,则该属性为规格典配的弹性容量信息,包括存储类型、最小容量、最大容量以及步长信息,如果为固定存储规格,则该属性为null。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/NodeTypeElasticVolumeSpecs"
          }
        }
      },
      "required": [
        "spec_name",
        "detail",
        "id",
        "datastore_type",
        "architecture",
        "available_zones",
        "ram",
        "vcpus",
        "datastores",
        "volume",
        "elastic_volume_specs"
      ],
      "type": "object"
    },
    "NodeTypeAvailableZones": {
      "description": "**参数解释**:\n规格支持的可用区及状态信息。\n**取值范围**:\n不涉及。",
      "properties": {
        "code": {
          "description": "**参数解释**:\n可用区ID。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "status": {
          "description": "**参数解释**:\n规格可用状态。\n**取值范围**:\n- normal:可用\n- sellout:售罄\n- abandon:不可用",
          "type": "string"
        }
      },
      "required": [
        "code",
        "status"
      ],
      "type": "object"
    },
    "VolumeResp": {
      "type": "object",
      "description": "**参数解释**:\n如果规格为固定存储容量规格,则该属性为规格典配的存储容量信息,如果为弹性存储规格,则该属性为null。\n**取值范围**:\n不涉及。",
      "properties": {
        "type": {
          "type": "string",
          "description": "**参数解释**:\n磁盘类型,仅支持SSD。\n**取值范围**:\n仅支持SSD。"
        },
        "size": {
          "type": "integer",
          "description": "**参数解释**:\n磁盘可用容量。\n**取值范围**:\n仅支持SSD。"
        }
      },
      "required": [
        "type",
        "size"
      ]
    },
    "Detail": {
      "description": "**参数解释**:\n规格详细信息。\n**取值范围**:\n不涉及。",
      "properties": {
        "type": {
          "description": "**参数解释**:\n属性类型。\n**取值范围**:\n- vCPU:CPU核心数。\n- SATA:普通IO。\n- SAS:高IO。\n- SSD:超高IO。\n- ESSD:极速型SSD。\n- GPSSD:通用型SSD。\n- LOCAL_DISK:本地盘。\n- mem:内存大小。",
          "type": "string"
        },
        "value": {
          "description": "**参数解释**:\n属性值。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "unit": {
          "description": "**参数解释**:\n属性单位。\n**取值范围**:\n当type为SATA、SAS、SSD、ESSD时,表示磁盘单位GB",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dws.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
