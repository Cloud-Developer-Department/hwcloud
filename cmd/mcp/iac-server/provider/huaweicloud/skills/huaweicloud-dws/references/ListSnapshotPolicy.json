  "definitions": {
    "BackupStrategyDetail": {
      "description": "**参数解释**:\n备份策略详细信息。\n**取值范围**:\n不涉及。",
      "properties": {
        "policy_id": {
          "description": "**参数解释**:\n策略ID。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "policy_name": {
          "description": "**参数解释**:\n策略名称。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "backup_strategy": {
          "description": "**参数解释**:\n执行策略,一般为crontab表达式。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "backup_type": {
          "description": "**参数解释**:\n备份类型。\n**取值范围**:\n- full: 全量。\n- increment: 增量。",
          "type": "string"
        },
        "backup_level": {
          "description": "**参数解释**:\n备份级别。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "next_fire_time": {
          "description": "**参数解释**:\n下次触发时间(预估,与其它任务冲突时不执行)。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "update_time": {
          "description": "**参数解释**:\n更新时间。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "time_zone_offset": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n时区偏移量(相比UTC时间)。\n**取值范围**:\n0~23"
        },
        "backup_database": {
          "type": "string",
          "description": "**参数解释**:\n备份的数据库。\n**取值范围**:\n不涉及。",
          "example": "postgres"
        },
        "backup_schema_list": {
          "type": "string",
          "description": "**参数解释**:\n备份的数据库模式列表。\n**取值范围**:\n不涉及。",
          "example": "[\"public\",\"test\"]"
        },
        "backup_table_list": {
          "type": "string",
          "description": "**参数解释**:\n备份的数据库表列表。\n**取值范围**:\n不涉及。",
          "example": "[\"t1\",\"t2\",\"t3\"]"
        }
      },
      "type": "object"
    },
    "SnapshotPolicy": {
      "description": "**参数解释**:\n备份策略列表。\n**取值范围**:\n不涉及。",
      "properties": {
        "keep_day": {
          "description": "**参数解释**:\n保留天数。\n**取值范围**:\n大于等于0。",
          "type": "integer",
          "format": "int32"
        },
        "backup_strategies": {
          "description": "**参数解释**:\n备份策略列表。\n**取值范围**:\n不涉及。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/BackupStrategyDetail"
          }
        },
        "device_name": {
          "description": "**参数解释**:\n备份设备,一般为OBS。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "server_ips": {
          "description": "**参数解释**:\n服务IP。\n**取值范围**:\n不涉及。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "server_port": {
          "description": "**参数解释**:\n服务端口。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "backup_param": {
          "description": "**参数解释**:\n备份参数。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "auto_backup": {
          "type": "boolean",
          "description": "**参数解释**:\n自动备份开关状态。\n**取值范围**:\ntrue:已开启自动备份选项;\nfalse:已关闭自动备份选项;"
        },
        "backup_strategy_cluster_type_limit_num": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n此策略下集群级快照最大数量。\n**取值范围**:\n大于等于0。"
        },
        "backup_strategy_schema_type_limit_num": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n此策略下schema级快照最大数量。\n**取值范围**:\n大于等于0。"
        }
      },
      "type": "object"
    }
  },
