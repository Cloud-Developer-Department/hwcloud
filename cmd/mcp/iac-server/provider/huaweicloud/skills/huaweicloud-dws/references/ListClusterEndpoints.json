  "definitions": {
    "ConnectionInfoResponse": {
      "type": "object",
      "description": "**参数解释**:\n集群连接信息对象。\n**取值范围**:\n不涉及。",
      "properties": {
        "public_endpoints": {
          "description": "**参数解释**:\n公网连接信息,含公网域名、公网IP等,如果多个节点均绑定了公网IP只会显示其中一个。\n**取值范围**:\n不涉及。",
          "$ref": "#/definitions/PublicEndpointResponse"
        },
        "private_endpoints": {
          "description": "**参数解释**:\n公网连接信息。\n**取值范围**:\n不涉及。",
          "$ref": "#/definitions/PrivateEndpointResponse"
        },
        "public_ip_infos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PublicIpInfoResponse"
          },
          "description": "**参数解释**:\n公网IP详细信息,显示每个节点当前是否绑定公网IP及对应状态。\n**取值范围**:\n不涉及。"
        }
      }
    },
    "PublicEndpointResponse": {
      "type": "object",
      "description": "**参数解释**:\n公网域名、公网IP信息对象。\n**取值范围**:\n不涉及。",
      "properties": {
        "ip": {
          "type": "string",
          "example": "100.94.87.101",
          "description": "**参数解释**:\n公网IP信息。\n**取值范围**:\n不涉及。"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "example": 8000,
          "description": "**参数解释**:\n端口信息,创建集群时如果未指定端口则默认8000。\n**取值范围**:\n不涉及。"
        },
        "enabled": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n当前局点是否支持公网域名。\n**取值范围**:\n不涉及。"
        },
        "ip_id": {
          "type": "string",
          "example": "76d86659-a1d8-421d-969e-da97af4fde34",
          "description": "**参数解释**:\n公网IP的ID。\n**取值范围**:\n不涉及。"
        },
        "ip_bandwidth": {
          "type": "string",
          "example": "1",
          "description": "**参数解释**:\n公网IP的带宽信息。\n**取值范围**:\n不涉及。"
        },
        "domain_name": {
          "type": "string",
          "example": "domain751",
          "description": "**参数解释**:\n公网域名子域名信息。\n**取值范围**:\n不涉及。"
        },
        "domain_name_suffix": {
          "type": "string",
          "example": ".dws205.dwscloud.com",
          "description": "**参数解释**:\n公网域名后缀信息。\n**取值范围**:\n不涉及。"
        },
        "zone_name": {
          "type": "string",
          "example": ".dws205.dwscloud.com",
          "description": "**参数解释**:\n公网域名后缀信息。\n**取值范围**:\n不涉及。"
        },
        "domain_name_ttl": {
          "type": "integer",
          "format": "int32",
          "example": 300,
          "description": "**参数解释**:\n公网域名TTL。\n**取值范围**:\n不涉及。"
        },
        "domain_name_status": {
          "type": "string",
          "example": "ACTIVE",
          "description": "**参数解释**:\n公网域名状态。\n**取值范围**:\n- ACTIVE:正常\n- PENDING_CREATE:创建中\n- PENDING_UPDATE:更新中\n- PENDING_DELETE:删除中\n- PENDING_FREEZE:冻结中\n- FREEZE:冻结\n- ILLEGAL:违规冻结\n- POLICE:公安冻结\n- PENDING_DISABLE:暂停中\n- DISABLE:暂停\n- ERROR:失败"
        },
        "ip_status": {
          "type": "string",
          "example": "ACTIVE",
          "description": "**参数解释**:\n公网IP状态。\n**取值范围**:\n- FREEZED:冻结\n- BIND_ERROR:绑定失败\n- BINDING:绑定中\n- PENDING_DELETE:释放中\n- PENDING_CREATE:创建中\n- NOTIFYING:创建中\n- NOTIFY_DELETE:释放中\n- PENDING_UPDATE:更新中\n- DOWN:未绑定\n- ACTIVE:绑定\n- ELB:绑定ELB\n- VPN:绑定VPN\n- ERROR:失败"
        }
      }
    },
    "PrivateEndpointResponse": {
      "type": "object",
      "description": "**参数解释**:\n内网域名信息。\n**取值范围**:\n不涉及。",
      "properties": {
        "ip": {
          "type": "string",
          "example": "192.168.200.145,192.168.200.32,192.168.200.169",
          "description": "**参数解释**:\n内网IP信息,多个IP逗号分割。\n**取值范围**:\n不涉及。"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "example": 8000,
          "description": "**参数解释**:\n端口信息。\n**取值范围**:\n8000~30000"
        },
        "domain_name": {
          "type": "string",
          "example": "domain75175",
          "description": "**参数解释**:\n子域名前缀。\n**取值范围**:\n不涉及。"
        },
        "domain_name_suffix": {
          "type": "string",
          "example": ".dws.dwscloud.com",
          "description": "**参数解释**:\n子域名后缀。\n**取值范围**:\n不涉及。"
        },
        "zone_name": {
          "type": "string",
          "example": ".dws.dwscloud.com",
          "description": "**参数解释**:\n子域名信息。\n**取值范围**:\n不涉及。"
        },
        "domain_name_ttl": {
          "type": "integer",
          "format": "int32",
          "example": 300,
          "description": "**参数解释**:\n内网域名TTL。\n**取值范围**:\n不涉及。"
        },
        "domain_name_status": {
          "type": "string",
          "example": "ACTIVE",
          "description": "**参数解释**:\n内网域名状态。\n**取值范围**:\n- ACTIVE:正常\n- PENDING_CREATE:创建中\n- PENDING_UPDATE:更新中\n- PENDING_DELETE:删除中\n- PENDING_FREEZE:冻结中\n- FREEZE:冻结\n- ILLEGAL:违规冻结\n- POLICE:公安冻结\n- PENDING_DISABLE:暂停中\n- DISABLE:暂停\n- ERROR:失败"
        },
        "elb_ip": {
          "type": "string",
          "example": "192.168.200.120",
          "description": "**参数解释**:\nELB的内网IP信息。\n**取值范围**:\n不涉及。"
        },
        "bind_manage_ip_status": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "**参数解释**:\nIP绑定状态。\n**取值范围**:\n- 0:未绑定\n- 1:已绑定\n- 2:绑定中"
        }
      }
    },
    "PublicIpInfoResponse": {
      "type": "object",
      "description": "**参数解释**:\n公网IP信息详情。\n**取值范围**:\n不涉及。",
      "properties": {
        "id": {
          "type": "string",
          "example": "",
          "description": "**参数解释**:\n公网IP的ID。\n**取值范围**:\n不涉及。"
        },
        "address": {
          "type": "string",
          "example": "",
          "description": "**参数解释**:\n公网IP。\n**取值范围**:\n合法的公网IPV4地址。"
        },
        "status": {
          "type": "string",
          "example": "null",
          "description": "**参数解释**:\n公网IP状态。\n**取值范围**:\n- FREEZED:冻结\n- BIND_ERROR:绑定失败\n- BINDING:绑定中\n- PENDING_DELETE:释放中\n- PENDING_CREATE:创建中\n- NOTIFYING:创建中\n- NOTIFY_DELETE:释放中\n- PENDING_UPDATE:更新中\n- DOWN:未绑定\n- ACTIVE:绑定\n- ELB:绑定ELB\n- VPN:绑定VPN\n- ERROR:失败"
        },
        "instance_id": {
          "type": "string",
          "example": "064edaf0-775b-4337-86c5-900d73d0c969",
          "description": "**参数解释**:\n绑定的DWS集群的节点ID。\n**取值范围**:\n不涉及。"
        },
        "instance_name": {
          "type": "string",
          "example": "cluster_751-dws-cn-cn-2-1",
          "description": "**参数解释**:\n绑定的DWS集群的节点名称。\n**取值范围**:\n不涉及。"
        },
        "bandwidth_size": {
          "type": "string",
          "example": "null",
          "description": "**参数解释**:\n公网IP带宽信息。\n**取值范围**:\n不涉及。"
        }
      }
    }
  },
