{
  "name": "UpdateDeviceChannel",
  "summary": "更新GB/T28181设备通道信息",
  "tags": "设备管理",
  "productshort": "VIS",
  "region_id": "cn-east-2",
  "paths": {
    "/v1/{project_id}/devices/{device_id}/channels/{channel_id}": {
      "put": {
        "tags": [
          "设备管理"
        ],
        "summary": "更新GB/T28181设备通道信息",
        "description": "该接口用于GB/T28181设备进行“视频邀约”和“取消邀约”,配置优先使用TCP传输的配置。",
        "operationId": "UpdateDeviceChannel",
        "consumes": [],
        "produces": [],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-constraint": "GB/T28181设备通道视频流名称后缀不允许修改。",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "name": "device_id",
            "in": "path",
            "description": "设备ID",
            "required": true,
            "type": "string",
            "x-example": "device123123***f"
          },
          {
            "name": "channel_id",
            "in": "path",
            "description": "通道ID",
            "required": true,
            "type": "string",
            "x-example": "chanadfasdf"
          },
          {
            "name": "UpdateDeviceChannelRequest",
            "in": "body",
            "description": "更新设备通道信息请求体\"",
            "required": false,
            "schema": {
              "$ref": "#/definitions/UpdateDeviceChannelRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "正常",
            "examples": {
              "application/json": {
                "result": "success"
              }
            },
            "schema": {
              "$ref": "#/definitions/UpdateResponse"
            }
          },
          "400": {
            "description": "请求错误",
            "examples": {
              "application/json": {
                "error_msg": "The device is not successfully registered or is offline.",
                "error_code": "VIS.0312"
              }
            }
          }
        },
        "deprecated": false,
        "x-name": "更新GB/T28181设备通道信息",
        "x-request-examples-url-1": "PUT /v1/3266392d188c47d09948b1**********/devices/device123123sadf/channels/chanadfasdf",
        "x-request-examples-1": {
          "state": "ACTIVE"
        }
      }
    }
  },
  "definitions": {
    "UpdateDeviceChannelRequestBody": {
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "STOPPED"
          ],
          "example": "ACTIVE",
          "description": "视频流状态。\n- ACTIVE:进行视频邀约。\n- STOPPED:断开视频。\n\n不区分大小写。"
        },
        "tcp_priority": {
          "type": "string",
          "enum": [
            true,
            false
          ],
          "example": "",
          "description": "是否优先使用TCP传输的配置。\n- TRUE:如果IPC设备支持TCP协议传输,通道进行视频邀约时优先使用TCP协议接入到VIS服务中。\n- FALSE:IPC设备通道进行视频邀约时优先使用UDP协议接入到VIS服务中。NVR设备通道暂时不支持配置相关配置。\n\n默认值FALSE。"
        }
      }
    },
    "UpdateResponse": {
      "properties": {
        "result": {
          "type": "string",
          "example": "success",
          "description": "处理成功时返回"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-vis/vis_03_0005.html)",
      "minLength": 32,
      "maxLength": 32,
      "required": true,
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "普通租户的token。",
      "required": true,
      "minLength": 1,
      "maxLength": 10240,
      "type": "string"
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    }
  },
  "host": "vis.cn-east-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}