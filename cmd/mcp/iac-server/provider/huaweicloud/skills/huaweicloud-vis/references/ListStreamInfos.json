{
  "name": "ListStreamInfos",
  "summary": "获取视频流信息",
  "tags": "视频流管理",
  "productshort": "VIS",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/streams/{stream_name}": {
      "get": {
        "tags": [
          "视频流管理"
        ],
        "summary": "获取视频流信息",
        "description": "此接口用于获取指定视频流的详细信息。\n\n说明:Stream_Flow_Info中部分字段数据暂时无法提供,数据内容无意义。",
        "operationId": "ListStreamInfos",
        "consumes": [],
        "produces": [],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "name": "stream_name",
            "in": "path",
            "description": "视频流名称",
            "required": true,
            "type": "string",
            "x-example": "stream****"
          }
        ],
        "responses": {
          "200": {
            "description": "正常",
            "examples": {
              "application/json": {
                "access_type": "RTMP",
                "updated_at": "2018-12-25T12:59:37Z",
                "share_type": "PUBLIC",
                "stream_id": "stream-0P5g9fQ2",
                "access_key": "ALKJOWLKJSDNFGO******KSJDF",
                "name": "stream_test1",
                "description": "",
                "state": "ACTIVE",
                "tag": [
                  {
                    "key": "group",
                    "value": "number1"
                  }
                ],
                "retention": {
                  "bucket": "iva-ly-test",
                  "path": "testRetention/",
                  "timezone": "GMT+08:00",
                  "retention_in_hour": 1,
                  "retention_forever": false,
                  "store_type": "OBS",
                  "slice_in_minute": 5,
                  "state": "ACTIVE"
                },
                "stream_flow_info": {
                  "bw_out": "100 Kb/s",
                  "bw_in": "100 Kb/s",
                  "bytes_out": "131.469 MB",
                  "bw_video": "100 Kb/s",
                  "bytes_in": "110.28 MB",
                  "num_play_clients": 2,
                  "bw_audio": "100 Kb/s",
                  "is_publishing": true,
                  "meta": {
                    "video": {
                      "codec": "H264",
                      "width": 400,
                      "height": 600
                    }
                  }
                },
                "encode_type": "H264"
              }
            },
            "schema": {
              "$ref": "#/definitions/GetStreamInfoResponseBody"
            }
          },
          "400": {
            "description": "请求错误",
            "examples": {
              "application/json": {
                "error_msg": "The entered stream ID does not exist.",
                "error_code": "VIS.0202"
              }
            }
          }
        },
        "deprecated": false,
        "x-name": "获取视频流信息",
        "x-request-examples-url-1": "GET /v1/3266392d188c47d09948b1**********/streams/stream1"
      }
    }
  },
  "definitions": {
    "StreamTag": {
      "properties": {
        "key": {
          "type": "string",
          "example": "group",
          "description": "标签的键。最大长度为36个UNICODE字符(一-鿿),可以包含大小写字母、数字、中划线(-)或者下划线(_),不能包含其他的特殊字符。"
        },
        "value": {
          "type": "string",
          "example": "number1",
          "description": "标签的值。最大长度为43个UNICODE字符(一-鿿),可以包含大小写字母、数字、点(.)、中划线(-)或者下划线(_),不能包含其他的特殊字符,也可以为空字符串。"
        }
      }
    },
    "Video": {
      "properties": {
        "video": {
          "$ref": "#/definitions/VideoInfo",
          "description": "推流视频流视频相关数据。"
        }
      }
    },
    "VideoInfo": {
      "properties": {
        "codec": {
          "type": "string",
          "example": "H264",
          "description": "视频编码格式。"
        },
        "width": {
          "type": "string",
          "example": "400",
          "description": "视频分辨率水平方向像素。"
        },
        "height": {
          "type": "string",
          "example": "600",
          "description": "视频分辨率垂直方向像素。"
        }
      }
    },
    "GetStreamInfoResponseBody": {
      "properties": {
        "access_type": {
          "type": "string",
          "example": "RTMP",
          "description": "视频接入类型(例如HTTP-FLV、RTMP、GB/T28181)。"
        },
        "updated_at": {
          "type": "string",
          "example": "2018-12-25T12:59:37Z",
          "description": "视频流更新时间。"
        },
        "share_type": {
          "type": "string",
          "example": "PUBLIC",
          "description": "视频流共享类型。\n- PRIVATE:非共享。\n- PUBLIC:共享。"
        },
        "stream_id": {
          "type": "string",
          "example": "stream-0P5g9fQ2",
          "description": "视频流ID。"
        },
        "access_key": {
          "type": "string",
          "example": "ALKJOWLKJSDNFGO******KSJDF",
          "description": "RTMP视频流的密钥。接入类型(access_type)为RTMP时,才有该参数。"
        },
        "url": {
          "type": "string",
          "example": "https://xxxxxxxx.com/live",
          "description": "HTTP-FLV视频流的地址。接入类型(access_type)为HTTP-FLV时,才有该参数。"
        },
        "transfer_protocol": {
          "type": "string",
          "example": "TCP",
          "description": "GB视频传输协议(TCP|UDP)。只有当视频接入类型为GB/T28181时,才有该参数。"
        },
        "name": {
          "type": "string",
          "example": "channel_9812399046132*****",
          "description": "视频流名称。"
        },
        "created_at": {
          "type": "string",
          "example": "2019-01-28T07:57:21Z",
          "description": "视频流创建时间。"
        },
        "description": {
          "type": "string",
          "example": "",
          "description": "视频流描述信息。"
        },
        "state": {
          "type": "string",
          "example": "STOPPED",
          "description": "视频流状态。\n- ACTIVE:表示已激活。\n- STOPPED:表示已停用。\n\n默认为STOPPED。"
        },
        "tag": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StreamTag"
          },
          "description": "和视频流关联的标签。"
        },
        "retention": {
          "description": "视频转储信息。",
          "$ref": "#/definitions/retention"
        },
        "stream_flow_info": {
          "description": "视频流详细信息。",
          "$ref": "#/definitions/Stream_Flow_Info"
        },
        "encode_type": {
          "type": "string",
          "example": "H264",
          "description": "视频流编码格式。"
        },
        "retention_state": {
          "type": "string",
          "example": "STOPPED",
          "description": "按视频流转储状态过滤,可选值如下。\n- ACTIVE:表示已启用转储。\n- STOPPED:表示未启用转储。\n\n不区分大小写。"
        }
      }
    },
    "retention": {
      "properties": {
        "retention_in_hour": {
          "type": "integer",
          "example": 1,
          "description": "保存时长,以小时为单位。"
        },
        "Retention_forever": {
          "type": "boolean",
          "example": "false",
          "description": "是否永久保存。"
        },
        "store_type": {
          "type": "string",
          "example": "obs",
          "description": "转储位置,可为“obs”,即存储到华为云对象存储OBS上。"
        },
        "bucket": {
          "type": "string",
          "example": "iva-ly-test",
          "description": "OBS桶名。"
        },
        "path": {
          "type": "string",
          "example": "testRetention/***",
          "description": "OBS目录。"
        },
        "timezone": {
          "type": "string",
          "example": "GMT+08:00",
          "description": "时区信息。"
        },
        "slice_in_minute": {
          "type": "integer",
          "example": 5,
          "description": "分片长度,以分钟为单位。取值范围为1~60,默认为5。"
        }
      }
    },
    "Stream_Flow_Info": {
      "properties": {
        "is_publishing": {
          "type": "boolean",
          "example": true,
          "description": "视频流是否在推流/拉流。\n- RTMP类型: 表示是否正在推流。\n- HTTP-FLV类型: 表示是否正在从URL中拉取视频数据。"
        },
        "bw_out": {
          "type": "string",
          "example": "0 Kb/s",
          "description": "出流带宽。 正在推流(即is_publishing为true)时会返回该字段。\n\n注:暂时无法提供该数据,数据内容无意义。"
        },
        "bw_in": {
          "type": "string",
          "example": "102.883 Kb/s",
          "description": "推流码率。正在推流(即is_publishing为true)时会返回该字段。"
        },
        "bw_video": {
          "type": "string",
          "example": "102.883 Kb/s",
          "description": "视频带宽。正在推流(即is_publishing为true)时会返回该字段。\n\n注:暂时无法提供该数据,数据内容无意义。"
        },
        "bw_audio": {
          "type": "string",
          "example": "0 Kb/s",
          "description": "音频带宽。正在推流(即is_publishing为true)时会返回该字段。\n\n注:暂时无法提供该数据,数据内容无意义。"
        },
        "bytes_out": {
          "type": "string",
          "example": "15.775 GB",
          "description": "出流总量。\n\n注:暂时无法提供该数据,数据内容无意义。"
        },
        "bytes_in": {
          "type": "string",
          "example": "17.412 GB",
          "description": "入流总量。\n\n注:暂时无法提供该数据,数据内容无意义。"
        },
        "num_play_clients": {
          "type": "string",
          "example": "0",
          "description": "正在拉取该视频流数据的客户端数量。正在推流(即is_publishing为true)时会返回该字段。"
        },
        "meta": {
          "description": "实时推流视频流元数据。正在推流(即is_publishing为true)时会返回该字段。",
          "$ref": "#/definitions/Video"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-vis/vis_03_0005.html)",
      "minLength": 32,
      "maxLength": 32,
      "required": true,
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "普通租户的token。",
      "required": true,
      "minLength": 1,
      "maxLength": 10240,
      "type": "string"
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    }
  },
  "host": "vis.cn-east-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}