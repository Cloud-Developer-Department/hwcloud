{
  "name": "ListBucket",
  "summary": "获取桶信息列表",
  "tags": "obs桶策略管理",
  "productshort": "VIS",
  "region_id": "cn-south-1",
  "paths": {
    "/v1/{project_id}/buckets": {
      "get": {
        "tags": [
          "obs桶策略管理"
        ],
        "summary": "获取桶信息列表",
        "description": "此接口用于用户获取桶信息列表,桶信息中包含两个字段,分别是桶名称和桶授权信息。",
        "operationId": "ListBucket",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "name": "offset",
            "in": "query",
            "default": 0,
            "minimum": 0,
            "maximum": 100000,
            "description": "查询的开始位置,取值范围为0~100000,默认值为0。如果offset超过数据总条数,则结果返回空列表。",
            "required": false,
            "type": "integer",
            "x-example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "default": 10,
            "minimum": 1,
            "maximum": 100,
            "description": "返回结果的最大条目数,取值范围为1~100,默认值为10。",
            "required": false,
            "type": "integer",
            "x-example": 5
          }
        ],
        "responses": {
          "200": {
            "description": "正常",
            "examples": {
              "application/json": {
                "count": 30,
                "buckets": [
                  {
                    "bucket": "bucketName1",
                    "authorized": true
                  },
                  {
                    "bucket": "bucketName2",
                    "authorized": false
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/PolicyResponse"
            }
          },
          "400": {
            "description": "请求错误。具体返回错误码请参考错误码说明"
          },
          "401": {
            "description": "鉴权失败"
          },
          "403": {
            "description": "没有操作权限"
          },
          "404": {
            "description": "找不到资源或没有开通服务"
          },
          "500": {
            "description": "服务内部错误"
          },
          "503": {
            "description": "服务不可用"
          }
        },
        "deprecated": false,
        "x-name": "获取桶信息列表",
        "x-request-examples-url-1": "GET /v1/0572be6bdf80d4ad2f0******/buckets"
      }
    }
  },
  "definitions": {
    "PolicyResponseList": {
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 3,
          "maxLength": 63,
          "example": "bucketName",
          "description": "桶名称"
        },
        "authorized": {
          "type": "boolean",
          "enum": [
            true,
            false
          ],
          "example": true,
          "description": "桶授权信息,表示桶是否已经进行了授权"
        }
      }
    },
    "PolicyResponse": {
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "example": 30,
          "description": "桶列表总数"
        },
        "buckets": {
          "$ref": "#/definitions/PolicyResponseList",
          "description": "桶列表信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-vis/vis_03_0005.html)",
      "minLength": 32,
      "maxLength": 32,
      "required": true,
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "普通租户的token。",
      "required": true,
      "minLength": 1,
      "maxLength": 10240,
      "type": "string"
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    }
  },
  "host": "vis.cn-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}