  "definitions": {
    "NVRChannels": {
      "properties": {
        "channel_id": {
          "type": "string",
          "example": "921740312913240*****",
          "description": "通道ID。"
        },
        "stream_id": {
          "type": "string",
          "example": "stream-0P5g9fQ2",
          "description": "通道关联的视频流ID。"
        },
        "stream_name": {
          "type": "string",
          "example": "channel_9217403129**********_9217403129**********",
          "description": "通道关联的视频流名称。"
        },
        "suffix": {
          "type": "string",
          "example": "aaa",
          "description": "视频流名称后缀。"
        },
        "invitation_status": {
          "type": "string",
          "example": "INVITING",
          "description": "邀约状态。\n- UNREGISTERED:未注册。\n- ONLINE:未邀约。\n- INVITING:正在邀约。\n- INVITE_SUCCESS:邀约成功。\n- CANCELING:正在取消。\n- TEMPORARY_OFFLINE:暂时掉线。\n- OFFLINE:已下线。"
        },
        "tcp_priority": {
          "type": "string",
          "example": "TRUE",
          "description": "是否配置通道优先选择TCP协议传输。\n- TRUE:是。\n- FALSE:否。\n\n默认值FALSE。"
        },
        "tcp_support": {
          "type": "string",
          "example": "TRUE",
          "description": "通道是否支持TCP协议传输。取值范围如下。\n- TRUE:是。\n- FALSE:否。\n\n默认值FALSE。"
        },
        "created_at": {
          "type": "string",
          "example": "2018-09-30T03:59:08Z",
          "description": "通道注册时间,格式为:YYYY-MM-DDTHH:MM:SSZ(UTC时间)。"
        },
        "updated_at": {
          "type": "string",
          "example": "2018-09-30T03:59:08Z",
          "description": "通道更新时间,格式为:YYYY-MM-DDTHH:MM:SSZ(UTC时间)。"
        }
      }
    },
    "GetNVRChannelResponseBody": {
      "properties": {
        "channels_query": {
          "type": "string",
          "example": "IDEL",
          "description": "设备通道更新状态。\n- IDEL:表示设备通道列表未进行更新,或者更新失败。\n- QUERYING:表示设备通道列表更新中。\n- QUERIED:表示设备通道列表更新成功。"
        },
        "device_id": {
          "type": "string",
          "example": "3402000000**********",
          "description": "设备ID。"
        },
        "state": {
          "type": "string",
          "example": "UNREGISTERED",
          "description": "设备状态。"
        },
        "type": {
          "type": "string",
          "example": "NVR",
          "description": "设备类型。"
        },
        "username": {
          "type": "string",
          "example": "0000",
          "description": "设备注册时所使用的GB/T28181用户名。"
        },
        "suffix": {
          "type": "string",
          "example": "aaa",
          "description": "视频流名称后缀。"
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NVRChannels"
          },
          "description": "通道列表详情。"
        },
        "description": {
          "type": "string",
          "example": "",
          "description": "描述信息。"
        },
        "created_at": {
          "type": "string",
          "example": "",
          "description": "设备注册时间。"
        },
        "updated_at": {
          "type": "string",
          "example": "",
          "description": "更新时间。"
        }
      }
    }
  },
