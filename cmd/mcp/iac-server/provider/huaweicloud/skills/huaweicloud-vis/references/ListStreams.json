{
  "name": "ListStreams",
  "summary": "获取视频流列表",
  "tags": "视频流管理",
  "productshort": "VIS",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/{project_id}/streams": {
      "get": {
        "tags": [
          "视频流管理"
        ],
        "summary": "获取视频流列表",
        "description": "此接口用于获取所有视频流的详细信息。",
        "operationId": "ListStreams",
        "consumes": [],
        "produces": [],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询的开始位置,取值范围为0~100000,必须与limit一起使用。与limit同时缺省时,返回所有结果。该参数适用于所有查询列表的接口。如果offset超过数据总条数,则结果返回空列表。",
            "required": false,
            "type": "integer",
            "x-example": "1"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "返回结果的最大条目数,取值范围为1~1000,必须与offset一起使用。与offset同时缺省时,返回所有结果。该参数适用于所有查询列表的接口。",
            "required": false,
            "type": "integer",
            "x-example": "23"
          },
          {
            "name": "sort",
            "in": "query",
            "description": "返回结果的排序规则。\n- ASC:表示升序。\n- DESC:表示降序。\n\n默认为ASC,需要有offset和limit参数,sort参数才会生效。",
            "required": false,
            "type": "string",
            "x-example": "ASC"
          },
          {
            "name": "order_by",
            "in": "query",
            "description": "选择按一个字段排序,可选值如下。\n- encode_type:视频流编码格式。\n- access_type:视频接入类型。\n- share_type:视频流共享类型。\n- created_at:视频流创建时间。\n- name:视频流名字。\n- state:视频流状态。\n- retention_state:视频流转储状态。\n\n默认为created_at,按照创建时间排序。需要有offset和limit参数,order_by参数才会生效。",
            "required": false,
            "type": "string",
            "x-example": "encode_type"
          },
          {
            "name": "name",
            "in": "query",
            "description": "按照视频流名称过滤,支持模糊查询。",
            "required": false,
            "type": "string",
            "x-example": "String**"
          },
          {
            "name": "stream_state",
            "in": "query",
            "description": "按视频流状态过滤,可选值如下。\n- ACTIVE:表示已激活。\n- STOPPED:表示未激活。\n\n不区分大小写。",
            "required": false,
            "type": "string",
            "x-example": "ACTIVE"
          },
          {
            "name": "retention_state",
            "in": "query",
            "description": "按视频流转储状态过滤,可选值如下。\n- ACTIVE:表示已启用转储。\n- STOPPED:表示未启用转储。\n\n不区分大小写。",
            "required": false,
            "type": "string",
            "x-example": "STOPPED"
          }
        ],
        "responses": {
          "200": {
            "description": "正常",
            "examples": {
              "application/json": [
                {
                  "access_type": "RTMP",
                  "updated_at": "2018-12-25T12:59:37Z",
                  "share_type": "PUBLIC",
                  "stream_id": "stream-0BOPSRsT",
                  "access_key": "ALKJOWLKJSDNFGO******KSJDF",
                  "name": "stream_test1",
                  "created_at": "2018-12-25T12:59:37Z",
                  "description": "",
                  "state": "ACTIVE",
                  "retention_state": "ACTIVE",
                  "tag": [
                    {
                      "key": "group"
                    },
                    {
                      "value": "number1"
                    }
                  ],
                  "retention": {
                    "bucket": "iva-ly-test",
                    "path": "testRetention",
                    "timezone": "GMT+08:00",
                    "retention_in_hour": 1,
                    "retention_forever": false,
                    "store_type": "OBS",
                    "slice_in_minute": 5
                  },
                  "encode_type": "H264"
                },
                {
                  "access_type": "HTTP-FLV",
                  "updated_at": "2018-12-25T12:59:37Z",
                  "share_type": "PUBLIC",
                  "stream_id": "stream-9IzU3TdL",
                  "url": "https://xxxxxxxx.com/live",
                  "name": "RTMP******",
                  "created_at": "2018-12-25T12:59:37Z",
                  "description": "",
                  "state": "ACTIVE",
                  "retention_state": "ACTIVE",
                  "tag": [
                    {
                      "key": "group",
                      "value": "number1"
                    }
                  ],
                  "retention": {
                    "bucket": "iva-ly-test",
                    "path": "testRetention/",
                    "timezone": "GMT+08:00",
                    "retention_in_hour": 1,
                    "retention_forever": false,
                    "store_type": "OBS",
                    "slice_in_minute": 5
                  },
                  "encode_type": "H264"
                },
                {
                  "access_type": "GB/T28181",
                  "updated_at": "2018-12-25T10:52:00Z",
                  "share_type": "PUBLIC",
                  "stream_id": "stream-0P5g9fQ2",
                  "access_key": "0000",
                  "name": "channel_9339084235132000****",
                  "created_at": "2018-12-25T10:52:00Z",
                  "description": "",
                  "state": "STOPPED",
                  "retention_state": "STOPPED",
                  "tag": [],
                  "encode_type": "H265"
                }
              ]
            },
            "schema": {
              "$ref": "#/definitions/StreamResponseList"
            }
          },
          "400": {
            "description": "请求错误",
            "examples": {
              "application/json": {
                "error_msg": "Invalid request parameter, url can not be null or empty when access type is HTTP-FLV.",
                "error_code": "VIS.0005"
              }
            }
          }
        },
        "deprecated": false,
        "x-name": "获取视频流列表",
        "x-request-examples-url-1": "GET /v1/3266392d188c47d09948b1**********/streams"
      }
    }
  },
  "definitions": {
    "StreamResponseList": {
      "properties": {
        "stream_id": {
          "type": "string",
          "example": "stream-0P5g9fQ2",
          "description": "视频流ID。"
        },
        "name": {
          "type": "string",
          "example": "stream_test1",
          "description": "视频流名称。"
        },
        "encode_type": {
          "type": "string",
          "example": "H264",
          "description": "视频流编码格式。"
        },
        "access_type": {
          "type": "string",
          "example": "RTMP",
          "description": "视频接入类型。"
        },
        "access_key": {
          "type": "string",
          "example": "ALKJOWLKJSDNFGO******KSJDF",
          "description": "RTMP视频流的密钥。接入类型(access_type)为RTMP时,才有该参数。"
        },
        "url": {
          "type": "string",
          "example": " https://xxxxxxxx.com/live",
          "description": "HTTP-FLV视频流的地址。接入类型(access_type)为HTTP-FLV时,才有该参数。"
        },
        "transfer_protocol": {
          "type": "string",
          "example": "streamtngw6xsj",
          "description": "GB视频传输协议(TCP|UDP)。只有当视频介入类型为GB/T28181时,才有该参数。"
        },
        "share_type": {
          "type": "string",
          "example": "PUBLIC",
          "description": "视频流共享类型。\n- PRIVATE:非共享。\n- PUBLIC:共享。"
        },
        "state": {
          "type": "string",
          "example": "ACTIVE",
          "description": "视频流状态。\n- ACTIVE:表示已激活。\n- STOPPED:表示已停用。"
        },
        "retention": {
          "$ref": "#/definitions/retention",
          "description": "视频流转储信息。"
        },
        "retention_state": {
          "type": "string",
          "example": "ACTIVE",
          "description": "按视频流转储状态过滤,可选值如下。\n- ACTIVE:表示已启用转储。\n- STOPPED:表示未启用转储。\n\n不区分大小写。"
        },
        "created_at": {
          "type": "string",
          "example": "2018-12-25T12:59:37Z",
          "description": "视频流创建时间。"
        },
        "updated_at": {
          "type": "string",
          "example": "2018-12-25T12:59:37Z",
          "description": "视频流更新时间。"
        }
      }
    },
    "retention": {
      "properties": {
        "retention_in_hour": {
          "type": "integer",
          "example": 1,
          "description": "保存时长,以小时为单位。"
        },
        "Retention_forever": {
          "type": "boolean",
          "example": "false",
          "description": "是否永久保存。"
        },
        "store_type": {
          "type": "string",
          "example": "obs",
          "description": "转储位置,可为“obs”,即存储到华为云对象存储OBS上。"
        },
        "bucket": {
          "type": "string",
          "example": "iva-ly-test",
          "description": "OBS桶名。"
        },
        "path": {
          "type": "string",
          "example": "testRetention/***",
          "description": "OBS目录。"
        },
        "timezone": {
          "type": "string",
          "example": "GMT+08:00",
          "description": "时区信息。"
        },
        "slice_in_minute": {
          "type": "integer",
          "example": 5,
          "description": "分片长度,以分钟为单位。取值范围为1~60,默认为5。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-vis/vis_03_0005.html)",
      "minLength": 32,
      "maxLength": 32,
      "required": true,
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "普通租户的token。",
      "required": true,
      "minLength": 1,
      "maxLength": 10240,
      "type": "string"
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    }
  },
  "host": "vis.cn-north-1.myhuaweicloud.com",
