{
  "name": "CreateDeviceChannel",
  "summary": "创建GB/T28181设备通道",
  "tags": "设备管理",
  "productshort": "VIS",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/devices": {
      "post": {
        "tags": [
          "设备管理"
        ],
        "summary": "创建GB/T28181设备通道",
        "description": "此接口用于创建GB/T28181设备(摄像头、网络硬盘录像机等)通道。创建成功之后,自动为GB/T28181设备生成设备ID,以及选择关联的GB/T28181凭证。用户在设备注册时使用该设备ID与凭证,作为设备的用户名以及认证ID址。",
        "operationId": "CreateDeviceChannel",
        "consumes": [],
        "produces": [],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "name": "CreateDeviceChannelRequest",
            "in": "body",
            "description": "创建设备通道请求体\"",
            "required": false,
            "schema": {
              "$ref": "#/definitions/CreateDeviceChannelRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "正常",
            "examples": {
              "application/json": {
                "device_id_list": [
                  "34020000001300******",
                  "34020000001300******"
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateDeviceChannelResponseBody"
            }
          },
          "400": {
            "description": "请求错误",
            "examples": {
              "application/json": {
                "error_msg": "The username of GB28181 password is not found.",
                "error_code": "VIS.0102"
              }
            }
          }
        },
        "deprecated": false,
        "x-name": "创建GB/T28181设备通道",
        "x-request-examples-url-1": "POST /v1/3266392d188c47d09948b1**********/devices",
        "x-request-examples-1": {
          "type": "IPC",
          "username": "0000",
          "quantity": 2,
          "suffix": "abc",
          "description": "description for device"
        }
      }
    }
  },
  "definitions": {
    "CreateDeviceChannelRequestBody": {
      "required": [
        "type",
        "username"
      ],
      "properties": {
        "type": {
          "type": "string",
          "example": "IPC",
          "description": "设备类型,目前仅支持IPC和NVR类型的设备,不区分大小写。"
        },
        "username": {
          "type": "string",
          "example": "0000",
          "description": "关联的GB/T28181设备密码对应的用户名。"
        },
        "quantity": {
          "type": "integer",
          "example": "2",
          "description": "创建设备的个数。最小值为1,最大值为用户当前可以创建设备的剩余配额,不填该参数时默认值为1。"
        },
        "description": {
          "type": "string",
          "example": "description for device",
          "description": "设备的描述,可填字符串最大长度为500。"
        },
        "suffix": {
          "type": "string",
          "example": "abc",
          "description": "设备通道关联的视频流名称后缀。国标设备注册后,会自动创建该设备关联的视频流,视频流的名称可以添加suffix字段作为名称后缀以帮助用户更好区分不同的视频流。后缀长度为0位到30位之间(长度为0时表示不设置后缀),可以包含字母、数字、中划线(-)或者下划线(_),不能包含其他的特殊字符。"
        },
        "auto_invite": {
          "type": "boolean",
          "example": "true",
          "description": "是否开启自动邀约,取值范围如下。\n- true:表示开启自动邀约,设备注册上线后,自动发起视频邀约。\n- false:表示不开启自动邀约。当type字段为IPC时生效。\n\n默认值为false。"
        }
      }
    },
    "CreateDeviceChannelResponseBody": {
      "properties": {
        "device_id_list": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "创建成功的设备ID列表。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-vis/vis_03_0005.html)",
      "minLength": 32,
      "maxLength": 32,
      "required": true,
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "普通租户的token。",
      "required": true,
      "minLength": 1,
      "maxLength": 10240,
      "type": "string"
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    }
  },
  "host": "vis.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}