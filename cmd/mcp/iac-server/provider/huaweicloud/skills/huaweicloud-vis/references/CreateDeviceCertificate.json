  "definitions": {
    "CreateDeviceCertificate": {
      "required": [
        "username",
        "password"
      ],
      "properties": {
        "username": {
          "type": "string",
          "example": "0000",
          "description": "凭证用户名,全局唯一。\n- 当type为NORMAL(非匿名)时,该参数必选。\n- 当type为ANONYMOUS(匿名)时,该参数被忽略。长度为1~32,可以包含字母、数字,不能包含其他的特殊字符。"
        },
        "type": {
          "type": "string",
          "example": "NORMAL",
          "description": "凭证类型,可选值如下。\n- NORMAL:非匿名,表示当使用该凭证作为设备凭证时,使用凭证指定的username作为用户名。\n- ANONYMOUS:匿名,表示当使用该凭证作为设备凭证时,使用设备的ID作为用户名。\n\n不区分大小写,该参数默认值为NORMAL。"
        },
        "password": {
          "type": "string",
          "example": "123us****",
          "description": "凭证密码。长度为8位~32位的字符串,至少包含以下三种字符:大写字母、小写字母、数字和特殊字符(@#_-*)。密码不能与凭证用户名相同,也不能与用户名的倒序相同。"
        },
        "description": {
          "type": "string",
          "example": "",
          "description": "凭证描述,长度不超过500个字符。"
        }
      }
    },
    "CreateDeviceCertificateResponseBody": {
      "properties": {
        "username": {
          "type": "string",
          "example": "0000",
          "description": "凭证用户名。"
        },
        "description": {
          "type": "string",
          "example": "this is for device",
          "description": "凭证描述。"
        },
        "type": {
          "type": "string",
          "example": "normal",
          "description": "凭证类型。"
        },
        "created_at": {
          "type": "string",
          "example": "2018-10-25T11:45:01Z",
          "description": "凭证创建时间。"
        },
        "updated_at": {
          "type": "string",
          "example": "2018-10-25T11:45:01Z",
          "description": "凭证更新时间。"
        }
      }
    }
  },
