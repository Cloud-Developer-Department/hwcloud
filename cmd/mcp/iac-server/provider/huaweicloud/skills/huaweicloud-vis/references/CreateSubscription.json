{
  "name": "CreateSubscription",
  "summary": "开通服务",
  "tags": "服务开通管理",
  "productshort": "VIS",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/{project_id}/subscription": {
      "post": {
        "tags": [
          "服务开通管理"
        ],
        "summary": "开通服务",
        "description": "此接口用于用户申请开通视频接入服务",
        "operationId": "CreateSubscription",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-constraint": "目前\"华北-北京一\"和\"华东-上海二\"区域不支持新用户开通",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          }
        ],
        "responses": {
          "201": {
            "description": "正常",
            "examples": {
              "application/json": {
                "user_id": "******6045184a8194e021113e******",
                "sip_ip": "10.95.144.***",
                "sip_port": "5080",
                "quota": {
                  "consecutive_access_time": {
                    "total": 120,
                    "used": 0
                  },
                  "password": {
                    "total": 10,
                    "used": 0
                  },
                  "random_access_time": {
                    "total": 240,
                    "used": 0
                  },
                  "stream": {
                    "total": 50,
                    "used": 0
                  },
                  "active_stream": {
                    "total": 10,
                    "used": 0
                  },
                  "device": {
                    "total": 50,
                    "used": 0
                  },
                  "aksk": {
                    "total": 10,
                    "used": 0
                  },
                  "http_num": {
                    "total": 10,
                    "used": 0
                  },
                  "http_active_num": {
                    "total": 5,
                    "used": 0
                  },
                  "rtmp_num": {
                    "total": 0,
                    "used": 0
                  }
                },
                "created_at": "2018-10-25T03:06:10Z",
                "is_subscribed": true
              }
            },
            "schema": {
              "$ref": "#/definitions/SubscriptionResponse"
            }
          },
          "400": {
            "description": "请求错误",
            "examples": {
              "application/json": {
                "error_msg": "You have already subscribed to VIS.",
                "error_code": "VIS.0018"
              }
            }
          }
        },
        "deprecated": false,
        "x-name": "开通服务",
        "x-request-examples-url-1": "POST /v1/3266392d188c47d09948b1**********/subscription"
      }
    }
  },
  "definitions": {
    "Active_StreamInfo": {
      "properties": {
        "total": {
          "type": "integer",
          "example": 200,
          "description": "可激活视频流总配额量。"
        },
        "used": {
          "type": "integer",
          "example": 4,
          "description": "视频流已激活量。"
        }
      }
    },
    "StreamInfo": {
      "properties": {
        "total": {
          "type": "integer",
          "example": 100000,
          "description": "视频流总配额量。"
        },
        "used": {
          "type": "integer",
          "example": 8,
          "description": "视频流已创建量。"
        }
      }
    },
    "AKSKInfo": {
      "properties": {
        "total": {
          "type": "integer",
          "example": 10,
          "description": "AKSK凭证总配额量。"
        },
        "used": {
          "type": "integer",
          "example": 6,
          "description": "AKSK凭证已创建量。"
        }
      }
    },
    "DeviceInfo": {
      "properties": {
        "total": {
          "type": "integer",
          "example": 100000,
          "description": "设备总配额量。"
        },
        "used": {
          "type": "integer",
          "example": 0,
          "description": "设备已创建量。"
        }
      }
    },
    "Random_Access_TimeInfo": {
      "properties": {
        "total": {
          "type": "integer",
          "example": 240,
          "description": "GB/T28181设备随机接入的总时长。"
        },
        "used": {
          "type": "integer",
          "example": 240,
          "description": "GB/T28181设备随机已接入的时长。"
        }
      }
    },
    "SubscriptionResponse": {
      "properties": {
        "user_id": {
          "type": "string",
          "example": "******6045184a8194e021113e******",
          "description": "用户ID。"
        },
        "sip_ip": {
          "type": "string",
          "example": "10.**.144.***",
          "description": "SIP服务器地址,VIS对外提供的设备注册地址。"
        },
        "sip_port": {
          "type": "string",
          "example": "5080",
          "description": "SIP服务器端口,VIS对外提供的设备注册端口,固定为5080。"
        },
        "quota": {
          "$ref": "#/definitions/quotaInfo"
        },
        "created_at": {
          "type": "string",
          "example": "2018-10-25T03:06:10Z",
          "description": "创建时间,格式为:YYYY-MM-DDTHH:MM:SSZ(UTC时间)。"
        },
        "is_subscribed": {
          "type": "boolean",
          "example": "true",
          "description": "用户是否开通服务。\n- true:表示开通。\n- false:表示未开通。"
        }
      }
    },
    "HttpInfo": {
      "properties": {
        "total": {
          "type": "integer",
          "example": 10,
          "description": "http_flv总配额数量"
        },
        "used": {
          "type": "integer",
          "example": 5,
          "description": "http_flv已创建数量"
        }
      }
    },
    "HttpActiveInfo": {
      "properties": {
        "total": {
          "type": "integer",
          "example": 10,
          "description": "http_flv激活总配额数量"
        },
        "used": {
          "type": "integer",
          "example": 5,
          "description": "http_flv已激活数量"
        }
      }
    },
    "Consecutive_Access_TimeInfo": {
      "properties": {
        "total": {
          "type": "integer",
          "example": 120,
          "description": "设备连续接入的总时长。"
        },
        "used": {
          "type": "integer",
          "example": 120,
          "description": "设备已使用的时长。"
        }
      }
    },
    "RtmpInfo": {
      "properties": {
        "total": {
          "type": "integer",
          "example": 10,
          "description": "rtmp总配额数量"
        },
        "used": {
          "type": "integer",
          "example": 5,
          "description": "rtmp已创建数量"
        }
      }
    },
    "PassWordInfo": {
      "properties": {
        "total": {
          "type": "integer",
          "example": 10,
          "description": "GB/T28181凭证总配额量。"
        },
        "used": {
          "type": "integer",
          "example": 2,
          "description": "GB/T28181凭证已创建量。"
        }
      }
    },
    "quotaInfo": {
      "properties": {
        "password": {
          "$ref": "#/definitions/PassWordInfo",
          "description": "GB/T28181凭证配额信息。"
        },
        "consecutive_access_time": {
          "$ref": "#/definitions/Consecutive_Access_TimeInfo",
          "description": "GB/T28181设备连续接入时长的配额信息。"
        },
        "random_access_time": {
          "$ref": "#/definitions/Random_Access_TimeInfo",
          "description": "GB/T28181设备随机接入时长的配额信息。"
        },
        "stream": {
          "$ref": "#/definitions/StreamInfo",
          "description": "视频流配额信息。"
        },
        "active_stream": {
          "$ref": "#/definitions/Active_StreamInfo",
          "description": "激活视频流配额信息。"
        },
        "device": {
          "$ref": "#/definitions/DeviceInfo",
          "description": "设备配额信息。"
        },
        "aksk": {
          "$ref": "#/definitions/AKSKInfo",
          "description": "AKSK凭证配额信息。"
        },
        "http_num": {
          "$ref": "#/definitions/HttpInfo",
          "description": "http_flv配额信息。"
        },
        "http_active_num": {
          "$ref": "#/definitions/HttpActiveInfo",
          "description": "http_flv激活配额信息。"
        },
        "rtmp_num": {
          "$ref": "#/definitions/RtmpInfo",
          "description": "rtmp配额信息。"
        }
      },
      "description": "开通服务返回的quota体。"
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-vis/vis_03_0005.html)",
      "minLength": 32,
      "maxLength": 32,
      "required": true,
      "type": "string"
    },
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "普通租户的token。",
      "required": true,
      "minLength": 1,
      "maxLength": 10240,
      "type": "string"
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    }
  },
  "host": "vis.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}