{
  "name": "CreateAkskCertificate",
  "summary": "创建AK/SK凭证",
  "tags": "凭证管理",
  "productshort": "VIS",
  "region_id": "cn-east-2",
  "paths": {
    "/v1/{project_id}/credentials/aksks": {
      "post": {
        "tags": [
          "凭证管理"
        ],
        "summary": "创建AK/SK凭证",
        "description": "该接口用于创建AK/SK凭证,AK/SK用于RTMP视频流推流时的鉴权。",
        "operationId": "CreateAkskCertificate",
        "consumes": [],
        "produces": [],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "in": "body",
            "name": "CreateAKSKCertificate",
            "description": "更新设备凭证请求体",
            "required": false,
            "schema": {
              "$ref": "#/definitions/CreateAKSKCertificate"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "正常",
            "examples": {
              "application/json": {
                "name": "aksk_1",
                "access_key": "ALKJOWLKJSDNFGO******KSJDF",
                "secret_key": "TT1S1HXRQVS8ADCW9J**********Q68YOJREADUHAL9BUR0LVYWWUSGM********",
                "description": "this is for RTMP",
                "created_at": "2018-10-25T11:45:01Z",
                "updated_at": "2018-10-25T11:45:01Z"
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateAKSKCertificateResponseBody"
            }
          },
          "400": {
            "description": "请求错误",
            "examples": {
              "application/json": {
                "error_msg": "The request param is wrong, name contains illegal characters",
                "error_code": "VIS.0005"
              }
            }
          }
        },
        "deprecated": false,
        "x-name": "创建AK/SK凭证",
        "x-request-examples-url-1": "POST /v1/3266392d188c47d09948b1**********/credentials/aksks",
        "x-request-examples-1": {
          "name": "aksk_1",
          "description": "this is for RTMP"
        }
      }
    }
  },
  "definitions": {
    "CreateAKSKCertificateResponseBody": {
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9\\-_]*",
          "minLength": 1,
          "maxLength": 32,
          "example": "aksk_1",
          "description": "凭证名称。"
        },
        "access_key": {
          "type": "string",
          "example": "ALKJOWLKJSDNFGO******KSJDF",
          "description": "凭证AK。"
        },
        "secret_key": {
          "type": "string",
          "example": "TT1S1HXRQVS8ADCW9J**********Q68YOJREADUHAL9BUR0LVYWWUSGM********",
          "description": "凭证SK。"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "example": "this is for RTMP",
          "description": "凭证描述。"
        },
        "created_at": {
          "type": "string",
          "example": "2018-10-25T11:45:01Z",
          "description": "凭证创建时间。"
        },
        "updated_at": {
          "type": "string",
          "example": "2018-10-25T11:45:01Z",
          "description": "凭证更新时间。"
        }
      }
    },
    "CreateAKSKCertificate": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "aksk_1",
          "description": "凭证名称。长度为1~32,可以包含字母、数字、中划线(-)或者下划线(_),不能包含其他的特殊字符。"
        },
        "description": {
          "type": "string",
          "example": "this is for RTMP",
          "description": "凭证描述,字符串最大长度为500。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-vis/vis_03_0005.html)",
      "minLength": 32,
      "maxLength": 32,
      "required": true,
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "普通租户的token。",
      "required": true,
      "minLength": 1,
      "maxLength": 10240,
      "type": "string"
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-example": "20191115T033655Z"
    }
  },
  "host": "vis.cn-east-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
