{
  "name": "ListDevices",
  "summary": "获取设备列表",
  "tags": "设备管理",
  "productshort": "VIS",
  "region_id": "cn-south-1",
  "paths": {
    "/v1/{project_id}/devices": {
      "get": {
        "tags": [
          "设备管理"
        ],
        "summary": "获取设备列表",
        "description": "此接口用于获取已经注册成功的GB/T28181设备列表。",
        "operationId": "ListDevices",
        "consumes": [],
        "produces": [],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询的开始位置,取值范围为1~100000,必须与limit一起使用。与limit同时缺省时,返回所有结果。该参数适用于所有查询列表的接口。如果offset超过数据总条数,则结果返回空列表。",
            "required": false,
            "type": "integer",
            "x-example": "22"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "返回结果的最大条目数,取值范围为1~1000,必须与offset一起使用。与offset同时缺省时,返回所有结果。该参数适用于所有查询列表的接口。",
            "required": false,
            "type": "integer",
            "x-example": "33"
          },
          {
            "name": "sort",
            "in": "query",
            "description": "返回结果的排序规则。\n- ASC:表示升序。\n- DESC:表示降序。\n\n默认为ASC,需要有offset和limit参数,sort参数才会生效。",
            "required": false,
            "type": "string",
            "x-example": "ASC"
          },
          {
            "name": "order_by",
            "in": "query",
            "description": "排序的字段,取值范围。\n- username:用户名。\n- device_id:设备Id。\n- created_at:视频流创建时间。\n- updated_at:最后更新时间。\n\n默认值为created_at,即按照创建时间排序。需要配置offset和limit参数,order_by参数才会生效。",
            "required": false,
            "type": "string",
            "x-example": "device_id"
          },
          {
            "name": "device_id",
            "in": "query",
            "description": "按照设备ID过滤,支持模糊查询。",
            "required": false,
            "type": "string",
            "x-example": "3402000000**********"
          },
          {
            "name": "type",
            "in": "query",
            "description": "按照设备类型过滤,可选参数为IPC。",
            "required": false,
            "type": "string",
            "x-example": "IPC"
          },
          {
            "name": "state",
            "in": "query",
            "description": "按照设备状态过滤,取值范围。\n- UNREGISTERED:未注册。\n- ONLINE:未邀约。\n- OFFLINE:已下线。\n\n不区分大小写。",
            "required": false,
            "type": "string",
            "x-example": "UNREGISTERED"
          }
        ],
        "responses": {
          "200": {
            "description": "正常",
            "examples": {
              "application/json": [
                {
                  "channels_query": "QUERIED",
                  "device_id": "238**527801180000***",
                  "updated_at": "2019-04-17T14:30:02Z",
                  "channels": [
                    {
                      "device_id": "238825***801180000***",
                      "stream_name": "channel_23882527801180******",
                      "updated_at": "2019-04-17T12:26:24Z",
                      "stream_id": "stream-0P5g9fQ2",
                      "invitation_status": "OFFLINE",
                      "tcp_priority": "FALSE",
                      "tcp_support": "FALSE",
                      "access_strategy": {
                        "start_time": "10:40",
                        "periodicity": "DAY",
                        "end_time": "12:00",
                        "total_length": 10,
                        "state": "STOPPED",
                        "random_strategy": "RANDOM"
                      },
                      "created_at": "2019-04-16T01:43:11Z",
                      "suffix": "xc",
                      "channel_id": "34020000001310******"
                    }
                  ],
                  "created_at": "2019-04-15T09:37:58Z",
                  "description": null,
                  "state": "OFFLINE",
                  "type": "NVR",
                  "suffix": null,
                  "username": "user****"
                }
              ]
            },
            "schema": {
              "$ref": "#/definitions/GetDeviceListResponseBody"
            }
          },
          "400": {
            "description": "请求错误",
            "examples": {
              "application/json": {
                "error_msg": "Invalid request parameter, offset should be in range [0, 100000].",
                "error_code": "VIS.0005"
              }
            }
          }
        },
        "deprecated": false,
        "x-name": "获取设备列表",
        "x-request-examples-url-1": "GET /v1/3266392d188c47d09948b1**********/devices"
      }
    }
  },
  "definitions": {
    "Channels": {
      "properties": {
        "device_id": {
          "type": "string",
          "example": "3402000000**********",
          "description": "设备ID。"
        },
        "channel_id": {
          "type": "string",
          "example": "3402000000**********",
          "description": "通道ID。"
        },
        "stream_id": {
          "type": "string",
          "example": "stream-0P5g9fQ2",
          "description": "通道关联的视频流ID。"
        },
        "stream_name": {
          "type": "string",
          "example": "channel_2388252780**********_3402000000**********",
          "description": "通道关联的视频流名称。"
        },
        "suffix": {
          "type": "string",
          "example": "xc",
          "description": "视频流名称后缀。"
        },
        "invitation_status": {
          "type": "string",
          "example": "OFFLINE",
          "description": "邀约状态如下。\n- UNREGISTERED:未注册。\n- ONLINE:未邀约。\n- INVITING:正在邀约。\n- INVITE_SUCCESS:邀约成功。\n- CANCELING:正在取消。\n- TEMPORARY_OFFLINE:暂时掉线。\n- OFFLINE:已下线。"
        },
        "tcp_priority": {
          "type": "string",
          "example": "FALSE",
          "description": "是否配置通道优先选择TCP协议传输。取值范围如下。\n- TRUE:是。\n- FALSE:否。\n\n默认值FALSE。"
        },
        "tcp_support": {
          "type": "string",
          "example": "FALSE",
          "description": "通道是否支持TCP协议传输。取值范围如下。\n- TRUE:是。\n- FALSE:否。\n\n默认值FALSE。"
        },
        "created_at": {
          "type": "string",
          "example": "2019-04-17T12:26:24Z",
          "description": "通道注册时间,格式为:YYYY-MM-DDTHH:MM:SSZ(UTC时间)。"
        },
        "updated_at": {
          "type": "string",
          "example": "2019-04-16T01:43:11Z",
          "description": "通道更新时间,格式为:YYYY-MM-DDTHH:MM:SSZ(UTC时间)。"
        },
        "access_strategy": {
          "type": "array",
          "$ref": "#/definitions/Access_Strategy",
          "description": "视频定时接入策略。"
        }
      }
    },
    "GetDeviceListResponseBody": {
      "properties": {
        "channels_query": {
          "type": "string",
          "example": "QUERIED",
          "description": "设备通道更新状态。\n- IDEL:表示设备通道列表未进行更新,或者更新失败。\n- QUERYING:表示设备通道列表更新中。\n- QUERIED:表示设备通道列表更新成功。"
        },
        "device_id": {
          "type": "string",
          "example": "3402000000**********",
          "description": "设备ID。"
        },
        "state": {
          "type": "string",
          "example": "UNREGISTERED",
          "description": "设备状态。"
        },
        "type": {
          "type": "string",
          "example": "NVR",
          "description": "设备类型。"
        },
        "username": {
          "type": "string",
          "example": "2388252780**********",
          "description": "设备注册时所使用的GB/T28181用户名。"
        },
        "suffix": {
          "type": "string",
          "example": null,
          "description": "视频流名称后缀。"
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Channels"
          },
          "description": "通道列表详情。"
        },
        "description": {
          "type": "string",
          "example": "",
          "description": "描述信息。"
        },
        "created_at": {
          "type": "string",
          "example": "2019-04-15T09:37:58Z",
          "description": "设备注册时间。"
        },
        "updated_at": {
          "type": "string",
          "example": "2019-04-17T14:30:02Z",
          "description": "更新时间。"
        },
        "auto_invite": {
          "type": "boolean",
          "example": true,
          "description": "自动邀约。"
        }
      }
    },
    "Access_Strategy": {
      "properties": {
        "start_time": {
          "type": "string",
          "example": "10:40",
          "description": "接入策略开始时间,格式为HH:MM(UTC+8)。"
        },
        "end_time": {
          "type": "string",
          "example": "12:00",
          "description": "接入策略结束时间,格式为HH:MM(UTC+8)。"
        },
        "periodicity": {
          "type": "string",
          "example": "DAY",
          "description": "接入周期类型。\n- ONCE:执行一次。\n- DAY:每天执行。"
        },
        "total_length": {
          "type": "string",
          "example": "10",
          "description": "接入总时长,以分钟为单位。"
        },
        "state": {
          "type": "string",
          "example": "STOPPED",
          "description": "当前接入策略启用状态如下。\n- STOPPED:已停用。\n- ACTIVE:已启用。"
        },
        "random_strategy": {
          "type": "string",
          "example": "RANDOM",
          "description": "接入类型。\n- RANDOM:随机接入。\n- CONSECUTIVE:连续接入。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
