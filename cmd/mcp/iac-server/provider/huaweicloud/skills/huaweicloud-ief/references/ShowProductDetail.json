  "tags": "批量节点管理",
  "productshort": "IEF",
  "region_id": "cn-east-2",
  "paths": {
    "/v2/{project_id}/productmgr/products/{product_id}": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "批量节点管理"
        ],
        "summary": "查询批量节点注册作业详情",
        "description": "查询批量节点注册作业详情。该接口无法查询产品证书文件",
        "operationId": "ShowProductDetail",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "批量节点注册作业ID"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/IEF-Instance-Id"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "$ref": "#/definitions/ProductDetail"
            },
            "examples": {
              "application/json": {
                "product": {
                  "id": "52b7e862-7b86-4b4d-b805-f580c4a25b0b",
                  "name": "a",
                  "description": "",
                  "attributes": {},
                  "project_id": "ed202955e111444e8ced21a1bd75fc59",
                  "created_at": 1667214079
                }
              }
            }
          }
        },
        "x-order": 3
      }
    }
  },
  "definitions": {
    "ProductAttributes": {
      "type": "object",
      "description": "产品属性",
      "properties": {
        "value": {
          "type": "string",
          "description": "产品属性值"
        },
        "metadata": {
          "description": "产品属性值基本信息",
          "$ref": "#/definitions/ProductMetadata"
        }
      }
    },
    "ProductMetadata": {
      "type": "object",
      "description": "产品属性值基本信息",
      "properties": {
        "type": {
          "type": "string",
          "description": "产品属性值类型"
        }
      }
    },
    "Product": {
      "type": "object",
      "description": "产品详情",
      "required": [
        "name",
        "project_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "产品id"
        },
        "name": {
          "type": "string",
          "description": "产品名称"
        },
        "description": {
          "type": "string",
          "description": "产品描述"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ProductAttributes"
          },
          "description": "产品属性值"
        },
        "project_id": {
          "type": "string",
          "description": "产品所属账号的项目ID"
        },
        "created_at": {
          "type": "integer",
          "format": "int32",
          "description": "产品创建时间"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Attributes"
          },
          "description": "产品标签"
        }
      }
    },
    "Attributes": {
      "description": "节点属性",
      "properties": {
        "key": {
          "type": "string",
          "description": "节点属性的key值,长度取值范围为1~128, 仅允许大小写英文字母、数字、下划线、中划线"
        },
        "value": {
          "type": "string",
          "description": "节点属性的value值,长度取值范围为1~256, 仅允许大小写英文字母、数字、下划线、中划线"
        }
      }
    },
    "ProductDetail": {
      "type": "object",
      "description": "产品作业详情",
      "properties": {
        "product": {
          "description": "产品作业详情",
          "$ref": "#/definitions/Product"
        }
      }
    }
