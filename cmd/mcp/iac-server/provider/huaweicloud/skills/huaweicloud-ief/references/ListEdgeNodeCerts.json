            }
          }
        }
      }
    }
  },
  "definitions": {
    "EdgeNodeCert": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "节点上已关联的应用证书和设备证书的数目"
        },
        "node_certs": {
          "items": {
            "$ref": "#/definitions/NodeCert"
          },
          "type": "array",
          "description": "节点上的证书列表"
        }
      },
      "required": [
        "count",
        "node_certs"
      ]
    },
    "NodeCert": {
      "properties": {
        "id": {
          "type": "string",
          "description": "证书id"
        },
        "name": {
          "type": "string",
          "description": "证书名称"
        },
        "description": {
          "type": "string",
          "description": "证书的描述"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "证书的创建时间"
        },
        "node_id": {
          "type": "string",
          "description": "节点id"
        },
        "type": {
          "type": "string",
          "description": "证书类型,包含:\n- system:创建节点时会默认创建一套系统证书\n- application:应用证书\n- device:设备证书"
        },
        "serial_num": {
          "type": "string",
          "description": "证书序列号"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),默认取值为“application/json”",
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "IEF-Instance-Id": {
      "in": "header",
      "required": false,
      "description": "铂金版实例ID,专业版实例为空值",
      "type": "string",
      "name": "ief-instance-id"
    }
  },
  "host": "ief.cn-east-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
