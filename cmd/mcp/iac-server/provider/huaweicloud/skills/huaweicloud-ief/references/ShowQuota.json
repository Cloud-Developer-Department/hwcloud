{
  "name": "ShowQuota",
  "summary": "查询IEF服务下的资源配额",
  "tags": "配额管理",
  "productshort": "IEF",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/{project_id}/edgemgr/quotas": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "配额管理"
        ],
        "summary": "查询IEF服务下的资源配额",
        "operationId": "ShowQuota",
        "consumes": [
          "application/json"
        ],
        "description": "查询IEF服务下的资源配额",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "types",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "查询配额的资源类型,支持填写:\n- edge_node: 边缘节点\n- node_cert: 边缘节点证书\n- edge_group: 边缘节点组\n- group_cert: 边缘节点组证书\n- application: 应用模板\n- deployment: 容器应用\n- device_template: 终端设备模板\n- device: 终端设备\n- app_version: 应用模板的版本\n- tag: 标签 \n- configmap: 配置项\n- secret: 密钥\n- ief_instance: 铂金版实例\n- service: 服务网格\n- gateway: 服务网关"
          },
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/IEF-Instance-Id"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "$ref": "#/definitions/QuotaResp"
            },
            "examples": {
              "application/json": {
                "quotas": {
                  "resources": [
                    {
                      "used": 7,
                      "min": -1,
                      "max": 1000000,
                      "quota": 50,
                      "project_id": "xxx",
                      "type": "edge_node"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "QuotaResp": {
      "type": "object",
      "description": "资源配额",
      "properties": {
        "quotas": {
          "description": "资源配额",
          "$ref": "#/definitions/QuotaResourceList"
        }
      }
    },
    "QuotaResourceList": {
      "type": "object",
      "description": "资源列表",
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/QuotaResource"
          },
          "description": "资源列表"
        }
      }
    },
    "QuotaResource": {
      "type": "object",
      "description": "资源配置",
      "properties": {
        "used": {
          "type": "integer",
          "format": "int32",
          "description": "已创建的资源个数"
        },
        "min": {
          "type": "integer",
          "format": "int32",
          "description": "最少可创建的资源个数"
        },
        "max": {
          "type": "integer",
          "format": "int32",
          "description": "最多可创建的资源个数"
        },
        "quota": {
          "type": "integer",
          "format": "int32",
          "description": "资源配额限制"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID"
        },
        "type": {
          "type": "string",
          "description": "查询配额的资源类型,支持填写:\n- edge_node: 边缘节点\n- node_cert: 边缘节点证书\n- edge_group: 边缘节点组\n- group_cert: 边缘节点组证书\n- application: 应用模板\n- deployment: 容器应用\n- device_template: 终端设备模板\n- device: 终端设备\n- app_version: 应用模板的版本\n- tag: 标签 \n- configmap: 配置项\n- secret: 密钥\n- ief_instance: 铂金版实例\n- service: 服务网格\n- gateway: 服务网关"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),默认取值为“application/json”",
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "IEF-Instance-Id": {
      "in": "header",
      "required": false,
      "description": "铂金版实例ID,专业版实例为空值",
      "type": "string",
      "name": "ief-instance-id"
    }
  },
  "host": "ief.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}