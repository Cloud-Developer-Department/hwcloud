{
  "name": "ListAppVersions",
  "summary": "查询应用模板版本列表",
  "tags": "应用模板管理",
  "productshort": "IEF",
  "region_id": "cn-north-1",
  "paths": {
    "/v2/{project_id}/edgemgr/apps/{app_id}/versions": {
      "get": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "ief_02_0051",
        "tags": [
          "应用模板管理"
        ],
        "summary": "查询应用模板版本列表",
        "description": "查询应用模板版本列表",
        "operationId": "ListAppVersions",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/IEF-Instance-Id"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "app_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "应用模板ID"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页显示的条目数量,取值范围1~1000,默认为1000",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "查询的起始位置,取值范围为非负整数,默认为0",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "schema": {
              "$ref": "#/definitions/VersionListResp"
            },
            "examples": {
              "application/json": {
                "count": 1,
                "versions": [
                  {
                    "envs": [],
                    "created_at": "2018-07-26T07:31:29+08:00",
                    "updated_at": null,
                    "version": "v1",
                    "image_url": "busybox:latest",
                    "volumes": [],
                    "npu_type": "",
                    "readiness_probe": null,
                    "configs": {
                      "host_network": true,
                      "restart_policy": "Always",
                      "privileged": false
                    },
                    "project_id": "{project_id}",
                    "liveness_probe": null,
                    "id": "bc35aaff-bdd8-49e8-ace0-a25be2b09380",
                    "resources": {
                      "requests": {
                        "cpu": 0.25,
                        "memory": 512
                      },
                      "limits": {
                        "cpu": 1,
                        "memory": 512
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "HttpGetDetail": {
      "description": "执行http探测",
      "properties": {
        "path": {
          "type": "string",
          "description": "必须要以/开头,构造结果为:协议类型://主机地址:端口路径"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "description": "探测的http端口,1到65535之间的整数"
        },
        "host": {
          "type": "string",
          "description": "请求的主机地址,默认为容器IP"
        },
        "scheme": {
          "type": "string",
          "description": "协议类型,HTTP或HTTPS,默认HTTP"
        }
      },
      "required": [
        "path",
        "port"
      ]
    },
    "ValueFrom": {
      "properties": {
        "secret": {
          "$ref": "#/definitions/Secrets"
        },
        "configmap": {
          "$ref": "#/definitions/ConfigsMap"
        }
      }
    },
    "ConfigsMap": {
      "description": "环境变量引用配置项时使用。",
      "properties": {
        "name": {
          "type": "string",
          "description": "配置项的名称"
        },
        "key": {
          "type": "string",
          "description": "配置项的属性名"
        }
      },
      "required": [
        "name",
        "key"
      ]
    },
    "VersionListResp": {
      "description": "应用模板版本",
      "properties": {
        "versions": {
          "items": {
            "$ref": "#/definitions/AppVersionDetail"
          },
          "description": "app详情",
          "type": "array"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "满足条件的应用版本个数"
        }
      },
      "required": [
        "versions",
        "count"
      ]
    },
    "Ports": {
      "description": "容器端口映射值",
      "properties": {
        "container_port": {
          "type": "integer",
          "format": "int32",
          "description": "构成一堆映射的容器端口"
        },
        "host_port": {
          "type": "integer",
          "format": "int32",
          "description": "构成一对映射的物理机对应网卡端口"
        },
        "host_ip": {
          "type": "string",
          "description": "对应网卡地址"
        }
      }
    },
    "Secrets": {
      "description": "环境变量引用密钥时使用。使用ValueFrom时,secret与configmap必须二选一。",
      "properties": {
        "name": {
          "type": "string",
          "description": "密钥的名称"
        },
        "key": {
          "type": "string",
          "description": "密钥的属性名"
        }
      },
      "required": [
        "name",
        "key"
      ]
    },
    "Env": {
      "description": "环境变量",
      "properties": {
        "name": {
          "type": "string",
          "description": "环境变量的key,由大小写字母或下划线开头,由数字、大小写字母、下划线组成,最大长度2048个字符,不允许重复"
        },
        "value": {
          "type": "string",
          "description": "环境变量的value,最大长度20480个字符。value、value_from和field_path必须三选一使用。"
        },
        "value_from": {
          "description": "环境变量可使用配置项和密钥导入",
          "$ref": "#/definitions/ValueFrom"
        },
        "field_path": {
          "type": "string",
          "description": "该参数目前只支持赋值\"status.hostIP\",即引用边缘节点的IP地址作为环境变量。"
        }
      },
      "required": [
        "name"
      ]
    },
    "ProbeDetail": {
      "properties": {
        "exec_command": {
          "type": "string",
          "description": "执行探测的命令行命令,长度1-10240内的字符串"
        },
        "http_get": {
          "description": "执行http探测",
          "$ref": "#/definitions/HttpGetDetail"
        },
        "initial_delay_seconds": {
          "type": "integer",
          "format": "int32",
          "description": "表示从工作负载启动后从多久开始探测,大于0且不大于3600的整数,默认为10"
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "int32",
          "description": "表示探测超时时间,大于0且不大于3600的整数,默认为1"
        }
      },
      "description": "探针配置"
    },
    "Volumes": {
      "description": "卷配置",
      "properties": {
        "name": {
          "type": "string",
          "description": "卷名称,小写字母或数字,最长63个字符"
        },
        "type": {
          "type": "string",
          "description": "卷的类型,支持configMap,secret,emptyDir,hostPath"
        },
        "source": {
          "type": "string",
          "description": "卷来源,type为hostPath时输入路径,要求以/开头,后面可包含中划线,反斜杠,下划线,点号,字母,数字; secret时输入secret名称,configMap时输入configMap名称,emptyDir时输入disk或memory"
        },
        "destination": {
          "type": "string",
          "description": "卷挂载路径,必须是合法的路径"
        },
        "read_only": {
          "type": "boolean",
          "description": "读写权限,configMap和secret类型只支持读权限"
        },
        "default_mode": {
          "type": "integer",
          "format": "int32",
          "description": "挂载的文件权限,仅configMap和secret类型生效,填写值为十进制表示的linux文件权限,默认为420(对应权限644)"
        }
      },
      "required": [
        "name",
        "type",
        "source",
        "destination"
      ],
      "type": "object"
    },
    "AppConfigs": {
      "description": "应用模板网络参数配置",
      "properties": {
        "privileged": {
          "type": "boolean",
          "description": "默认为false,表示是否开启特权模式"
        },
        "run_as_user": {
          "type": "integer",
          "description": "容器运行用户ID,输入范围为0~65534的整数"
        },
        "host_network": {
          "type": "boolean",
          "description": "默认为true,其中true表示主机网络,而false表示端口映射"
        },
        "restart_policy": {
          "type": "string",
          "description": "应用实例重启模式:\n- Always:当容器终止退出后,总是重启容器\n- Onfailure:容器异常退出(退出码非0)时才重启容器\n- Never:容器终止退出后,不重启容器"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Ports"
          },
          "description": "容器端口映射值"
        },
        "host_pid": {
          "type": "boolean",
          "description": "应用实例是否与主机共PID命名空间,默认值false"
        },
        "dns_policy": {
          "type": "string",
          "description": "应用实例DNS策略,可选值Default、ClusterFirst、ClusterFirstWithHostNet,默认为Default。应用实例启用主机网络时只能选填Default、ClusterFirstWithHostNet,不启用主机网络时只能选填Default、ClusterFirst"
        }
      },
      "type": "object"
    },
    "AppVersionDetail": {
      "description": "app详情",
      "properties": {
        "id": {
          "type": "string",
          "description": "应用版本ID"
        },
        "version": {
          "type": "string",
          "description": "应用版本号"
        },
        "created_at": {
          "type": "string",
          "description": "创建时间"
        },
        "updated_at": {
          "type": "string",
          "description": "更新时间\n只有更新后才会出现该字段"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID"
        },
        "image_url": {
          "type": "string",
          "description": "镜像存储地址"
        },
        "envs": {
          "items": {
            "$ref": "#/definitions/Env"
          },
          "description": "环境变量",
          "type": "array"
        },
        "volumes": {
          "items": {
            "$ref": "#/definitions/Volumes"
          },
          "description": "卷配置",
          "type": "array"
        },
        "configs": {
          "description": "容器特殊参数",
          "$ref": "#/definitions/AppConfigs"
        },
        "resources": {
          "$ref": "#/definitions/Resources"
        },
        "arch": {
          "type": "string",
          "description": "架构"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "启动命令"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "参数"
        },
        "liveness_probe": {
          "description": "工作负载存活探针",
          "$ref": "#/definitions/ProbeDetail"
        },
        "readiness_probe": {
          "description": "工作负载业务探针",
          "$ref": "#/definitions/ProbeDetail"
        },
        "npu_type": {
          "type": "string",
          "description": "NPU类型,支持D310、D310B,支持填写:\n- D310:D310类型\n- D310B:D310B类型\n- 不填表示为D310类型。"
        }
      },
      "required": [
        "envs",
        "volumes"
      ],
      "type": "object"
    },
    "Resources": {
      "description": "容器使用的资源",
      "properties": {
        "limits": {
          "description": "允许容器使用的最大资源",
          "$ref": "#/definitions/LimitsRequests"
        },
        "requests": {
          "description": "容器需要使用的最小资源",
          "$ref": "#/definitions/LimitsRequests"
        }
      }
    },
    "LimitsRequests": {
      "description": "资源配置限制",
      "properties": {
        "cpu": {
          "type": "number",
          "format": "float",
          "description": "cpu核数,大于等于0.01,最大1000;请求不需要带单位"
        },
        "memory": {
          "type": "number",
          "format": "float",
          "description": "内存大小,单位兆,大于等于0.01,最大1024000。注意:内存的limits值最小为4;请求不需要带单位"
        },
        "gpu": {
          "type": "number",
          "format": "float",
          "description": "Gpu显存大小,单位兆,大于等于0.01,最大1024000;请求不需要带单位"
        },
        "npu": {
          "type": "integer",
          "description": "Npu个数,大于0,最大1000;请求不需要带单位"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),默认取值为“application/json”",
      "type": "string"
    },
    "IEF-Instance-Id": {
      "in": "header",
      "required": false,
      "description": "铂金版实例ID,专业版实例为空值",
      "type": "string",
      "name": "ief-instance-id"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "ief.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}