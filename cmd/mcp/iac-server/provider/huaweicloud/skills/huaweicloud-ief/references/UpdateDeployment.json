  "definitions": {
    "ConfigsMap": {
      "description": "环境变量引用配置项时使用。",
      "properties": {
        "name": {
          "type": "string",
          "description": "配置项的名称"
        },
        "key": {
          "type": "string",
          "description": "配置项的属性名"
        }
      },
      "required": [
        "name",
        "key"
      ]
    },
    "DeploymentUpdateResp": {
      "description": "部署参数配置",
      "properties": {
        "id": {
          "type": "string",
          "description": "应用部署uuid"
        },
        "name": {
          "type": "string",
          "description": "应用部署名称,只允许英文小写字母、数字、中划线,最大长度32, 英文小写字母或数字开头和结尾"
        },
        "replicas": {
          "type": "integer",
          "format": "int32",
          "description": "应用部署总副本数"
        },
        "ready_replicas": {
          "type": "integer",
          "format": "int32",
          "description": "应用部署正常副本数"
        },
        "description": {
          "type": "string",
          "description": "应用部署描述,最大长度255,不允许^ ~ # $ % & * < > ( ) [ ] { } ' \" \\"
        },
        "group_id": {
          "type": "string",
          "description": "应用部署到指定节点组,与node_ids二选一"
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "应用部署到指定节点,当前只支持一个边缘节点"
        },
        "tags": {
          "items": {
            "$ref": "#/definitions/Attributes"
          },
          "description": "节点属性",
          "type": "array"
        },
        "api_version": {
          "type": "string",
          "description": "应用部署版本"
        },
        "source": {
          "type": "string",
          "description": "应用部署来源:边缘市场(iem)或自定义(userdefined)"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID"
        },
        "created_at": {
          "type": "string",
          "description": "应用部署创建时间"
        },
        "updated_at": {
          "type": "string",
          "description": "应用部署更新时间"
        },
        "template": {
          "$ref": "#/definitions/PodRequest"
        },
        "state": {
          "type": "string",
          "description": "应用状态,仅包括冻结(FREEZE)、删除中(PENDING_DELETE)、删除失败(DELETE_FAILED),保留字段"
        },
        "source_id": {
          "type": "string",
          "description": "预留字段"
        }
      },
      "required": [
        "id",
        "name",
        "node_ids",
        "template"
      ]
    },
    "MatchExpression": {
      "description": "匹配规则表达式",
      "properties": {
        "key": {
          "type": "string",
          "description": "规则的标签"
        },
        "operator": {
          "type": "string",
          "description": "操作符,取值如下:\n- In:标签值需要在values的列表中\n- NotIn:标签的值不在某个列表中\n- Exists:某个标签存在\n- DoesNotExist:某个标签不存在\n- Gt:标签的值大于某个值(字符串比较)\n- Lt:标签的值小于某个值(字符串比较)"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "一组标签值。\n- 如果运算符为In或NotIn,则值数组必须非空。\n- 如果运算符为Exists 或DoesNotExist,则值数组必须为空。\n- 如果运算符是Gt或Lt,则值数组必须具有单个元素,该元素将被解释为整数。"
        }
      }
    },
    "Exec": {
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "description": "探针执行命令,最大长度10240个字符"
        }
      }
    },
    "Secrets": {
      "description": "环境变量引用密钥时使用。使用ValueFrom时,secret与configmap必须二选一。",
      "properties": {
        "name": {
          "type": "string",
          "description": "密钥的名称"
        },
        "key": {
          "type": "string",
          "description": "密钥的属性名"
        }
      },
      "required": [
        "name",
        "key"
      ]
    },
    "LabelSelector": {
      "description": "标签选择器",
      "properties": {
        "matchExpressions": {
          "items": {
            "$ref": "#/definitions/MatchExpression"
          },
          "description": "匹配规则表达式",
          "type": "array"
        },
        "matchLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "匹配的标签,格式为key:value键值对。\n单个键值对相当于matchExpressions的一个元素,key字段为key,操作符为In,values数组中只有value。"
        }
      }
    },
    "PreferredSchedulingTerm": {
      "description": "优先使用定义的规则调度,且不会影响已经在节点上运行的Pod。即优先选择调度到满足规则的节点,但也可能会调度到不满足规则的节点。",
      "properties": {
        "preference": {
          "description": "与相应权重关联的节点选择器项。",
          "properties": {
            "matchExpressions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/MatchExpression"
              },
              "description": "匹配规则表达式"
            }
          }
        },
        "weight": {
          "type": "integer",
          "format": "int32",
          "description": "权重,范围为1-100"
        }
      }
    },
    "UpdatePodDeployment": {
      "description": "应用部署全量替换修改,应用更新时调用",
      "required": [
        "template"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "format": "int32",
          "description": "应用部署副本数"
        },
        "template": {
          "$ref": "#/definitions/PodRequest"
        }
      },
      "type": "object"
    },
    "Volumes": {
      "description": "卷配置",
      "properties": {
        "name": {
          "type": "string",
          "description": "卷名称,小写字母或数字,最长63个字符"
        },
        "type": {
          "type": "string",
          "description": "卷的类型,支持configMap,secret,emptyDir,hostPath"
        },
        "source": {
          "type": "string",
          "description": "卷来源,type为hostPath时输入路径,要求以/开头,后面可包含中划线,反斜杠,下划线,点号,字母,数字; secret时输入secret名称,configMap时输入configMap名称,emptyDir时输入disk或memory"
        },
        "destination": {
          "type": "string",
          "description": "卷挂载路径,必须是合法的路径"
        },
        "read_only": {
          "type": "boolean",
          "description": "读写权限,configMap和secret类型只支持读权限"
        },
        "default_mode": {
          "type": "integer",
          "format": "int32",
          "description": "挂载的文件权限,仅configMap和secret类型生效,填写值为十进制表示的linux文件权限,默认为420(对应权限644)"
        }
      },
      "required": [
        "name",
        "type",
        "source",
        "destination"
      ],
      "type": "object"
    },
    "PodRequest": {
      "description": "应用部署模板",
      "properties": {
        "configs": {
          "$ref": "#/definitions/PodConfigs"
        },
        "affinity": {
          "$ref": "#/definitions/Affinity"
        },
        "init_containers": {
          "items": {
            "$ref": "#/definitions/ContainerDef"
          },
          "type": "array",
          "description": "应用部署init业务容器"
        },
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContainerDef"
          },
          "description": "应用部署业务容器"
        }
      },
      "required": [
        "configs",
        "containers"
      ]
    },
    "PodConfigs": {
      "description": "应用实例配置",
      "properties": {
        "host_network": {
          "type": "boolean",
          "description": "应用实例是否启用主机网络,不启用则使用端口映射,默认值false"
        },
        "host_pid": {
          "type": "boolean",
          "description": "应用实例是否与主机共PID命名空间,默认值false"
        },
        "migration": {
          "type": "boolean",
          "description": "应用实例故障是否迁移,指定节点组部署时必选,默认值false"
        },
        "restart_policy": {
          "type": "string",
          "description": "应用实例重启策略,可选值Always、OnFailure、Never"
        },
        "toleration_seconds": {
          "type": "integer",
          "format": "int32",
          "description": "应用实例故障容忍时间,容忍时间到达后迁移应用实例,只在指定节点组部署时生效"
        },
        "dns_policy": {
          "type": "string",
          "description": "应用实例DNS策略,可选值Default、ClusterFirst、ClusterFirstWithHostNet,默认为Default。应用实例启用主机网络时只能选填Default、ClusterFirstWithHostNet,不启用主机网络时只能选填Default、ClusterFirst"
        }
      },
      "required": [
        "restart_policy"
      ],
      "type": "object"
    },
    "WeightPodAffinityTerms": {
      "description": "优先使用定义的规则调度,且不会影响已经在节点上运行的Pod。即优先选择调度到满足规则的节点,但也可能会调度到不满足规则的节点。",
      "properties": {
        "podAffinityTerm": {
          "description": "Pod亲和规则",
          "properties": {
            "labelSelector": {
              "$ref": "#/definitions/LabelSelector"
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "命名空间"
            },
            "topologyKey": {
              "type": "string",
              "description": "拓扑标签。先圈定topologyKey指定的范围,然后再选择labelSelector定义的内容,即亲和调度只会在有topologyKey指定的标签节点上调度。"
            }
          }
        },
        "weight": {
          "type": "integer",
          "format": "int32",
          "description": "权重,范围为1-100"
        }
      }
    },
    "ErrorResponseBody": {
      "description": "响应Body参数",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述信息"
        }
      }
    },
    "ContainerDef": {
      "properties": {
        "name": {
          "type": "string",
