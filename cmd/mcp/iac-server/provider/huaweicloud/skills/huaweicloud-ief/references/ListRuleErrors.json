{
  "name": "ListRuleErrors",
  "summary": "查询规则错误列表",
  "tags": "规则管理",
  "productshort": "IEF",
  "region_id": "cn-north-1",
  "paths": {
    "/v2/{project_id}/routemgr/rules/{rule_id}/errors": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc,hk",
        "tags": [
          "规则管理"
        ],
        "summary": "查询规则错误列表",
        "description": "查询特定规则下的所有错误列表",
        "operationId": "ListRuleErrors",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/IEF-Instance-Id"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "rule_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "规则ID"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "查询返回记录的数量限制",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "偏移量,表示查询该偏移量后面的记录",
            "type": "integer",
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "count": 0,
                "errors": []
              }
            }
          },
          "401": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResp": {
      "required": [
        "count",
        "errors"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "description": "满足条件的错误个数"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Error"
          },
          "description": "错误列表"
        }
      }
    },
    "Error": {
      "required": [
        "detail",
        "ief_instance_id",
        "project_id",
        "rule_id",
        "time"
      ],
      "properties": {
        "detail": {
          "type": "string",
          "description": "错误详情"
        },
        "ief_instance_id": {
          "type": "string",
          "description": "铂金版实例ID,如果为空则表示是专业版实例。"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID"
        },
        "rule_id": {
          "type": "string",
          "description": "规则ID"
        },
        "time": {
          "type": "string",
          "description": "错误发生的时间"
        }
      }
    },
    "ErrorResponseBody": {
      "description": "响应Body参数",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),默认取值为“application/json”",
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "IEF-Instance-Id": {
      "in": "header",
      "required": false,
      "description": "铂金版实例ID,专业版实例为空值",
      "type": "string",
      "name": "ief-instance-id"
    }
  },
  "host": "ief.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}