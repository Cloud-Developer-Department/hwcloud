  "tags": "边缘节点管理",
  "productshort": "IEF",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/{project_id}/edgemgr/nodes/{node_id}/devices": {
      "put": {
        "x-request-examples-description-1": "添加边缘节点的终端设备,输入设备ID。",
        "x-support-sdk": "Y",
        "x-request-examples-text-1": {
          "devices": {
            "added": {
              "relation": "This_is_a_test_relation",
              "comment": "This is a test comment",
              "device_ids": [
                "c59d8205-e786-4455-8883-12578a34ae90"
              ]
            }
          }
        },
        "x-request-examples-1": {
          "devices": {
            "added": {
              "relation": "This_is_a_test_relation",
              "comment": "This is a test comment",
              "device_ids": [
                "c59d8205-e786-4455-8883-12578a34ae90"
              ]
            }
          }
        },
        "x-is-registered": "Y",
        "x-publishpath": "ief_02_0097",
        "tags": [
          "边缘节点管理"
        ],
        "summary": "更新边缘节点的终端设备",
        "description": "添加或删除边缘节点的终端设备",
        "operationId": "UpdateEdgeNodeDevice",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "节点ID"
          },
          {
            "name": "devices",
            "in": "body",
            "required": true,
            "description": "终端设备信息",
            "schema": {
              "$ref": "#/definitions/Devices"
            }
          },
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/IEF-Instance-Id"
          }
        ],
        "responses": {
          "200": {
            "description": "更新成功",
            "schema": {
              "$ref": "#/definitions/EdgeNodeDevice"
            },
            "examples": {
              "application/json": {
                "delete_connector": false,
                "deploy_connector": false,
                "deployment_id": "",
                "update_devices": {
                  "added": {
                    "comment": "This is a test comment",
                    "device_ids": [
                      "114a9718-052d-4152-a4f5-cd7ab84e6fad"
                    ],
                    "relation": "This_is_a_test_relation"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "DeviceInfos": {
      "description": "关联设备信息",
      "properties": {
        "relation": {
          "type": "string",
          "description": "设备和节点关系的名称,只允许中文字符、英文字母、数字、下划线、中划线,最大长度64"
        },
        "comment": {
          "type": "string",
          "description": "设备和节点关系的描述,最大长度64,不允许^ ~ # $ % & * < > ( ) [ ] { } ' \" \\"
        },
        "device_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "设备ID列表"
        }
      },
      "required": [
        "relation",
        "device_ids"
      ]
    },
    "NodeDevice": {
      "description": "边缘节点的终端设备信息",
      "properties": {
        "added": {
          "description": "要加入的终端设备详情",
          "$ref": "#/definitions/DeviceInfos"
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "要解绑的终端设备ID"
        }
      }
    },
    "EdgeNodeDevice": {
      "properties": {
        "delete_connector": {
          "type": "boolean",
          "description": "工业终端设备预留字段"
        },
        "deploy_connector": {
          "type": "boolean",
          "description": "工业终端设备预留字段"
        },
        "deployment_id": {
          "type": "string",
          "description": "工业终端设备预留字段"
        },
        "update_devices": {
          "$ref": "#/definitions/NodeDevice"
        }
      },
      "required": [
        "update_devices"
      ]
    },
    "Devices": {
      "description": "终端设备属性",
      "properties": {
        "devices": {
          "description": "终端设备信息",
          "properties": {
            "added": {
              "description": "要加入的终端设备详情",
              "properties": {
                "relation": {
                  "type": "string",
                  "description": "终端设备和节点关系的名称,只允许中文字符、英文字母、数字、下划线、中划线,最大长度64"
                },
                "comment": {
                  "type": "string",
                  "description": "终端设备和节点关系的描述,最大长度64,不允许^ ~ # $ % & * < > ( ) [ ] { } ' \" \\"
                },
                "device_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "终端设备ID列表"
                }
              },
              "required": [
                "device_ids"
              ]
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "要解绑的终端设备ID"
            }
          }
        }
      },
      "required": [
        "devices"
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),默认取值为“application/json”",
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "IEF-Instance-Id": {
      "in": "header",
      "required": false,
      "description": "铂金版实例ID,专业版实例为空值",
      "type": "string",
      "name": "ief-instance-id"
    }
  },
  "host": "ief.cn-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}