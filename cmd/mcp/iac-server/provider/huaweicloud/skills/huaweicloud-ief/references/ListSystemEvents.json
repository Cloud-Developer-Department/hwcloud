  "definitions": {
    "Event": {
      "type": "object",
      "description": "系统订阅事件基本信息",
      "properties": {
        "id": {
          "type": "string",
          "description": "系统订阅事件ID"
        },
        "name": {
          "type": "string",
          "description": "系统订阅事件名称。只允许小写英文字符、数字、下划线、中划线,最大长度64,同一个账号中创建的系统订阅和消息规则名唯一"
        },
        "project_id": {
          "type": "string",
          "description": "系统订阅事件所属项目ID"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "更新时间"
        },
        "description": {
          "type": "string",
          "description": "描述,最大长度255,不允许^~#$%&*<>()[]{}'\"\\"
        },
        "in_using": {
          "type": "boolean",
          "description": "是否启用系统订阅规则,默认为true(启用)"
        },
        "events": {
          "type": "string",
          "description": "系统订阅事件主题。每个主题由“{边缘资源}/{操作}”组成,多个主题使用逗号(,)进行分隔,支持如下主题:\n- edgeNode/offline:节点离线\n- edgeNode/online:节点上线\n- edgeNode/all:节点离线+节点上线\n- deployment/created:容器应用创建\n- deployment/updated:容器应用更新\n- deployment/deleted:容器应用删除\n- deployment/all:容器应用创建+更新+删除\n- instance/created:应用实例创建\n- instance/updated:应用实例更新\n- instance/deleted:应用实例删除\n- instance/all:应用实例创建+更新+删除"
        },
        "target": {
          "$ref": "#/definitions/EndpointObjResp",
          "description": "目的端点"
        },
        "target_resource": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "目的端点资源属性"
        },
        "success_messages": {
          "type": "integer",
          "format": "int32",
          "description": "成功次数"
        },
        "fail_messages": {
          "type": "integer",
          "format": "int32",
          "description": "失败次数"
        },
        "delete_at": {
          "type": "integer",
          "format": "int32",
          "description": "删除时间"
        }
      }
    },
    "EventListResponse": {
      "type": "object",
      "description": "系统订阅列表返回体",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "数目"
        },
        "systemevents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Event"
          },
          "description": "系统订阅详情列表"
        }
      }
    },
    "EndpointObjResp": {
      "description": "端点详情",
      "properties": {
        "created_at": {
          "type": "string",
          "description": "创建时间"
        },
        "description": {
          "type": "string",
          "description": "端点描述,最大长度255,不允许^~#$%&*<>()[]{}'\"\\"
        },
        "id": {
          "type": "string",
          "description": "端点ID"
        },
        "ief_instance_id": {
          "type": "string",
          "description": "铂金版实例ID,如果为空则表示是专业版实例。"
        },
        "is_shared": {
          "type": "boolean",
          "description": "是否共享"
        },
        "name": {
          "type": "string",
          "description": "端点名称,只允许中文字符、英文字符、数字、下划线、中划线,最大长度64\n同一个账号中创建的端点名唯一"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "description": "端点的属性,端点需要对外展示的属性,示例:\n- dis:\n{\"domain_id\":\"user's domain id\"}\n- servicebus:\n{\"service_port\":8080}\n- apigw:\n{\"domain_id\":\"user's domain id\"}"
        },
        "type": {
          "type": "string",
          "description": "端点类型。枚举值:\n- dis\n- servicebus\n- apigw"
        },
        "updated_at": {
          "type": "string",
          "description": "更新时间"
        }
      },
      "required": [
        "created_at",
        "description",
        "id",
        "ief_instance_id",
        "is_shared",
        "name",
        "project_id",
        "properties",
        "type",
        "updated_at"
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),默认取值为“application/json”",
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "IEF-Instance-Id": {
      "in": "header",
      "required": false,
      "description": "铂金版实例ID,专业版实例为空值",
      "type": "string",
      "name": "ief-instance-id"
    }
  },
  "host": "ief.cn-east-2.myhuaweicloud.com",
  "base_path": "/",
