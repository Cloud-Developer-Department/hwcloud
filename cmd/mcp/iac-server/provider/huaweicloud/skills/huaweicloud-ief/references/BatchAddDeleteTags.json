{
  "name": "BatchAddDeleteTags",
  "summary": "批量添加删除资源标签",
  "tags": "标签管理",
  "productshort": "IEF",
  "region_id": "cn-north-1",
  "paths": {
    "/v2/{project_id}/{resource_type}/{resource_id}/tags/action": {
      "post": {
        "x-request-examples-description-1": "批量添加资源标签,其中一个标签键为“a”,值为“b”。",
        "x-request-examples-text-1": {
          "action": "create",
          "tags": [
            {
              "key": "a",
              "value": "b"
            }
          ]
        },
        "x-request-examples-1": {
          "action": "create",
          "tags": [
            {
              "key": "a",
              "value": "b"
            }
          ]
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "ief_02_0073",
        "tags": [
          "标签管理"
        ],
        "summary": "批量添加删除资源标签",
        "description": "为指定实例批量添加或删除标签。\n一个资源上最多有20个标签。\n\n说明:\n- 此接口为幂等接口,创建时如果请求体中存在重复key则报错。\n- 创建时不允许设置重复key数据,如果数据库已存在该key,就覆盖value的值。\n- 删除时不对标签字符集范围做校验,如果删除的标签不存在,默认处理成功。删除时tags结构体不能缺失,key不能为空,或者空字符串。",
        "operationId": "BatchAddDeleteTags",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/IEF-Instance-Id"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "resource_type",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "资源类型\n- ief-edge_node\n- ief-deployment\n- ief-application\n- ief-device"
          },
          {
            "name": "resource_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "资源ID"
          },
          {
            "name": "tags",
            "in": "body",
            "required": false,
            "description": "标签列表",
            "schema": {
              "$ref": "#/definitions/BachTags"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ResourceTag": {
      "description": "标签属性",
      "properties": {
        "key": {
          "type": "string",
          "description": "键。最大长度36个unicode字符。\n不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”。"
        },
        "value": {
          "type": "string",
          "description": "值。每个值最大长度43个unicode字符,删除时如果value有值按照key/value删除,如果value没值,则按照key删除。\n不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”。"
        }
      },
      "type": "object"
    },
    "BachTags": {
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceTag"
          },
          "description": "标签列表"
        },
        "action": {
          "type": "string",
          "description": "操作标识:仅限于create(创建)、delete(删除)"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),默认取值为“application/json”",
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "IEF-Instance-Id": {
      "in": "header",
      "required": false,
      "description": "铂金版实例ID,专业版实例为空值",
      "type": "string",
      "name": "ief-instance-id"
    }
  },
  "host": "ief.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}