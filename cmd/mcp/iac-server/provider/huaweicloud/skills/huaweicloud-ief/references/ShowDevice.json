{
  "name": "ShowDevice",
  "summary": "查询终端设备详情",
  "tags": "终端设备管理",
  "productshort": "IEF",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/{project_id}/edgemgr/devices/{device_id}": {
      "get": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "ief_02_0029",
        "tags": [
          "终端设备管理"
        ],
        "summary": "查询终端设备详情",
        "description": "该API用于查询终端设备详情。",
        "operationId": "ShowDevice",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/IEF-Instance-Id"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "终端设备ID"
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "schema": {
              "$ref": "#/definitions/CreateDevicesResp"
            },
            "examples": {
              "application/json": {
                "device": {
                  "id": "1398f13d-f24d-4de4-8cd3-5905db1d6d9f",
                  "name": "device",
                  "access_protocol": "",
                  "project_id": "05e1aef9040010e22fccc009adecb056",
                  "description": "new description",
                  "created_at": "2020-09-23T02:00:22.858736Z",
                  "updated_at": "2020-09-23T02:12:46Z",
                  "access_config": {},
                  "attributes": {},
                  "connection_type": "edge"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ExceptedActual": {
      "description": "动态属性",
      "properties": {
        "value": {
          "type": "string",
          "description": "动态属性的初始值,最大长度512,value允许英文字母、数字、下划线、中划线、点、逗号、冒号、/、@、+、?、^、=、%、&、~、#、!、*"
        }
      }
    },
    "ValueInTwinResponse": {
      "description": "终端设备静态属性信息",
      "properties": {
        "excepted": {
          "description": "动态属性的期望信息",
          "$ref": "#/definitions/ExceptedActual"
        },
        "actual": {
          "description": "动态属性的实际信息",
          "$ref": "#/definitions/ExceptedActual"
        },
        "metadata": {
          "description": "动态属性的元数据信息",
          "$ref": "#/definitions/Metadata"
        },
        "optional": {
          "type": "boolean",
          "description": "标识属性是否可选,默认为true,继承模板的属性默认为false"
        }
      }
    },
    "CreateDevicesResp": {
      "description": "终端设备属性",
      "properties": {
        "device": {
          "$ref": "#/definitions/Device"
        }
      },
      "required": [
        "device"
      ]
    },
    "ValueInPropertyVisitors": {
      "properties": {
        "register_type": {
          "description": "寄存器类型,value值字段可选为CoilsRegisters、HoldingRegisters、DiscreteInputsRegisters、InputRegisters",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "access_mode": {
          "description": "访问模式,value值字段可选为r和r/w",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "register_index": {
          "description": "寄存器偏移地址,value值字段取值范围0-65535",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "register_num": {
          "description": "寄存器个数",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "scale_index": {
          "description": "缩放因子",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "original_datatype": {
          "description": "原始数据类型",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "expected_datatype": {
          "description": "期望数据类型",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "is_registerswap": {
          "description": "是否交换寄存器顺序",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "is_swap": {
          "description": "是否交换高低字节",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "sample_interval": {
          "description": "数据采集间隔,取值范围为1-3600",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "data_min": {
          "description": "原始数据值区间最小值,与原始数据类型关联",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "data_max": {
          "description": "原始数据值区间最大值,与原始数据类型关联",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "node_id": {
          "description": "节点id",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "browse_name": {
          "description": "节点名称",
          "$ref": "#/definitions/ValueInAttributes"
        }
      },
      "description": "孪生属性配置,与access_protocol关联。"
    },
    "Device": {
      "description": "终端设备属性",
      "properties": {
        "id": {
          "type": "string",
          "description": "终端设备ID,只允许英文字母、数字、下划线、中划线,必须以英文字母和数字开头,长度限制为24~64之间"
        },
        "name": {
          "type": "string",
          "description": "终端设备名称,只允许中文字符、英文字母、数字、下划线、中划线,长度限制为1~64"
        },
        "access_protocol": {
          "type": "string",
          "description": "访问协议,有如下选项:\n- userdefine:自定义协议\n- modbus:modbus协议\n- opc-ua:opc-ua协议\n默认为userdefine"
        },
        "description": {
          "type": "string",
          "description": "终端设备描述,最大长度255,不允许^ ~ # $ % & * < > ( ) [ ] { } ' \" \\"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID"
        },
        "created_at": {
          "type": "string",
          "description": "创建时间"
        },
        "updated_at": {
          "type": "string",
          "description": "更新时间"
        },
        "attributes": {
          "additionalProperties": {
            "$ref": "#/definitions/ValueInAttributes"
          },
          "type": "object",
          "description": "终端设备静态属性信息"
        },
        "connection_type": {
          "type": "string",
          "description": "连接类型,默认为edge"
        },
        "twin": {
          "additionalProperties": {
            "$ref": "#/definitions/ValueInTwinResponse"
          },
          "description": "终端设备孪生属性信息",
          "type": "object"
        },
        "access_config": {
          "$ref": "#/definitions/AccessConfig"
        },
        "property_visitors": {
          "additionalProperties": {
            "$ref": "#/definitions/ValueInPropertyVisitors"
          },
          "description": "孪生属性配置",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "access_protocol",
        "description",
        "project_id",
        "created_at",
        "updated_at",
        "attributes",
        "connection_type",
        "twin",
        "access_config",
        "property_visitors"
      ]
    },
    "AccessConfig": {
      "properties": {
        "protocol_type": {
          "description": "设备访问类型,包含:\n- userdefine:自定义访问协议\n- TCP:modbus访问协议中的一种访问形式\n- RTU:modbus访问协议中的一种访问形式\n- opc-ua:opc-ua访问协议",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "protocol_name": {
          "description": "设备访问名称",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "slave_id": {
          "description": "Modbus设备访问id(0-255)",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "ip": {
          "description": "TCP传输模式下访问ip地址(标准ipv4地址)",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "port": {
          "description": "TCP传输模式下访问端口(0-65535)",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "serial_port": {
          "description": "RTU传输模式下串口配置",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "baud_rate": {
          "description": "RTU传输模式下波特率配置,value值字段可选50、75、110、150、200、300、1200、1800、2400、9600、19200、38400、57600、115200",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "data_bits": {
          "description": "RTU传输模式下数据位配置,value值字段包括5、6、7、8",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "stop_bits": {
          "description": "RTU传输模式下停止位配置,value值字段包含1、2",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "parity_bits": {
          "description": "RTU传输模式下校验位配置,value值字段可选为none、odd、even",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "url": {
          "description": "OPC-UA协议下访问url地址",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "sec_mode": {
          "description": "OPC-UA协议下访问安全模式",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "sec_policy": {
          "description": "OPC-UA协议下访问安全策略",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "auth_type": {
          "description": "OPC-UA协议下访问认证类型,value值字段可选为0、1、2、3",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "username": {
          "description": "OPC-UA协议下,采用密码认证时用户名字段",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "password": {
          "description": "OPC-UA协议下,采用密码认证时密码字段",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "private_key": {
          "description": "OPC-UA协议下,采用证书认证时私钥字段,value字段为base64格式",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "certificate": {
          "description": "OPC-UA协议下,采用证书认证时证书字段,value字段为base64格式",
          "$ref": "#/definitions/ValueInAttributes"
        },
        "timeout": {
          "description": "OPC-UA协议下访问超时配置,默认为5s",
          "$ref": "#/definitions/ValueInAttributes"
        }
      },
      "description": "访问配置,与access_protocol直接关联",
      "required": [
        "protocol_type"
      ]
    },
    "ValueInAttributes": {
      "properties": {
        "value": {
          "type": "string",
          "description": "value 最大长度512,value允许英文字母、数字、下划线、中划线、点、逗号、冒号、/、@、+、?、^、=、%、&、~、#、!、*"
        },
        "optional": {
          "type": "boolean",
          "description": "标识属性是否可选,默认为true"
        },
        "metadata": {
          "description": "静态属性的元数据信息,默认为{\"type\": \"string\"}",
          "$ref": "#/definitions/Metadata"
        }
      },
      "description": "静态属性",
      "required": [
        "value"
      ]
    },
    "Metadata": {
      "description": "静态属性的元数据信息,默认为{\"type\": \"string\"}",
      "properties": {
        "type": {
          "type": "string",
          "description": "属性类型标识,string|int|float|boolean(boolean类型为true或false),默认为string"
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),默认取值为“application/json”",
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "IEF-Instance-Id": {
      "in": "header",
      "required": false,
      "description": "铂金版实例ID,专业版实例为空值",
      "type": "string",
      "name": "ief-instance-id"
    }
  },
  "host": "ief.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}