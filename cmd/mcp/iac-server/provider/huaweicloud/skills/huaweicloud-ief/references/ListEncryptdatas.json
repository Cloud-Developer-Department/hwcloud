  "definitions": {
    "EncryptDataItem": {
      "properties": {
        "name": {
          "type": "string",
          "description": "加密数据项键名,小写英文字母、数字、中划线,以小写字母或数字开头,最大长度为32个字符,不能为空"
        },
        "value": {
          "type": "string",
          "description": "加密数据项键值"
        },
        "is_encrypted": {
          "type": "boolean",
          "description": "加密数据项键值是否已加密,默认为true"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object",
      "description": "加密数据项配置"
    },
    "EncryptDataListResp": {
      "properties": {
        "encrypt_datas": {
          "items": {
            "$ref": "#/definitions/EncryptData"
          },
          "type": "array",
          "description": "加密数据列表详情"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "加密数据总数"
        }
      },
      "required": [
        "encrypt_data",
        "count"
      ],
      "type": "object",
      "description": "加密数据列表返回"
    },
    "EncryptData": {
      "properties": {
        "id": {
          "type": "string",
          "description": "加密数据ID"
        },
        "name": {
          "type": "string",
          "description": "加密数据名称"
        },
        "description": {
          "type": "string",
          "description": "加密数据描述"
        },
        "config": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EncryptDataItem"
          },
          "description": "加密数据项配置"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID"
        },
        "ief_instance_id": {
          "type": "string",
          "description": "铂金版实例ID,专业版实例为default"
        },
        "domain_id": {
          "type": "string",
          "description": "租户账户ID"
        },
        "created_time": {
          "type": "integer",
          "format": "int64",
          "description": "加密数据创建时间"
        },
        "updated_time": {
          "type": "integer",
          "format": "int64",
          "description": "加密数据更新时间"
        }
