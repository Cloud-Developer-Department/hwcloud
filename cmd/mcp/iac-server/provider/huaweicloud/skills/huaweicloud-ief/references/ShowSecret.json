{
  "name": "ShowSecret",
  "summary": "查询密钥详情",
  "tags": "密钥管理",
  "productshort": "IEF",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/{project_id}/edgemgr/secrets/{secret_id}": {
      "get": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "ief_02_0094",
        "tags": [
          "密钥管理"
        ],
        "summary": "查询密钥详情",
        "description": "查询一个密钥详情",
        "operationId": "ShowSecret",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/IEF-Instance-Id"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "secret_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "密钥ID"
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "schema": {
              "$ref": "#/definitions/SecretResp"
            },
            "examples": {
              "application/json": {
                "secret": {
                  "id": "12ns9eb6cc0d49a0941df2f31283mds8 ",
                  "name": "test-secret",
                  "description": "this is a test secret",
                  "secrets": {
                    "key1": "val-1",
                    "key2": "val-2"
                  },
                  "project_id": "d16e6eb6cc0d49a0941df2f31285757a",
                  "created_at": "2018-07-16T13:41:25.347335",
                  "updated_at": "2018-07-18T13:41:25.347335",
                  "type": "Opaque"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "SecretDetailResp": {
      "description": "密钥",
      "properties": {
        "id": {
          "type": "string",
          "description": "密钥ID"
        },
        "name": {
          "type": "string",
          "description": "密钥名称,以小写英文字母开头,4-64位,可以使用小写英文、数字、中划线(-),不能以中划线结尾"
        },
        "description": {
          "type": "string",
          "description": "密钥描述,最大长度255,不允许^ ~ # $ % & * < > ( ) [ ] { } ' \" \\"
        },
        "secrets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "secrets是一个字典,由多个键值对组成,json化后最大总长度为1048576,key和value均为字符串。键值对中key由大小写字母或中划线开头,由数字、大小写字母、点号(.)、中划线(-)、下划线(_)组成,最小长度为1,最大长度63个字符, 键值对中的value必须为base64字符。\n注:secrets字典的长度即字典转为标准的字符串后的长度,例如字典{\"a\": \"b\"}转为标准字符串后为'{\"a\": \"b\"}',长度为10"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID"
        },
        "created_at": {
          "type": "string",
          "description": "创建时间"
        },
        "updated_at": {
          "type": "string",
          "description": "更新时间"
        },
        "type": {
          "type": "string",
          "description": "密钥类型,目前只支持“Opaque”类型"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "secrets",
        "project_id",
        "created_at",
        "updated_at",
        "type"
      ]
    },
    "SecretResp": {
      "description": "密钥。",
      "properties": {
        "secret": {
          "$ref": "#/definitions/SecretDetailResp"
        }
      },
      "required": [
        "secret"
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),默认取值为“application/json”",
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "IEF-Instance-Id": {
      "in": "header",
      "required": false,
      "description": "铂金版实例ID,专业版实例为空值",
      "type": "string",
      "name": "ief-instance-id"
    }
  },
  "host": "ief.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}