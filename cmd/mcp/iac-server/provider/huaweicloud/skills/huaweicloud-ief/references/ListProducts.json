          "type": "string",
          "description": "产品属性值类型"
        }
      }
    },
    "Product": {
      "type": "object",
      "description": "产品详情",
      "required": [
        "name",
        "project_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "产品id"
        },
        "name": {
          "type": "string",
          "description": "产品名称"
        },
        "description": {
          "type": "string",
          "description": "产品描述"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ProductAttributes"
          },
          "description": "产品属性值"
        },
        "project_id": {
          "type": "string",
          "description": "产品所属账号的项目ID"
        },
        "created_at": {
          "type": "integer",
          "format": "int32",
