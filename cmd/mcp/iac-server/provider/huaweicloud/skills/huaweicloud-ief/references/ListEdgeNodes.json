{
  "name": "ListEdgeNodes",
  "summary": "查询边缘节点列表",
  "tags": "边缘节点管理",
  "productshort": "IEF",
  "region_id": "cn-east-3",
  "paths": {
    "/v2/{project_id}/edgemgr/nodes": {
      "get": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "ief_02_0021",
        "tags": [
          "边缘节点管理"
        ],
        "summary": "查询边缘节点列表",
        "description": "该API用于查询边缘节点。\n- 如果不携带任何检索参数,将返回该租户的所有边缘节点信息。\n- app_name和tags不支持复合查询,如果同时存在则返回tags查询结果,可以同时携带多个其他检索参数,可同时生效。",
        "operationId": "ListEdgeNodes",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/IEF-Instance-Id"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "边缘节点名称,模糊匹配",
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页显示的条目数量,取值范围1~1000,默认为500",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "查询的起始位置,取值范围为非负整数,默认为0",
            "type": "string"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "显示的条目排列顺序,使用:分隔参考值和顺序,\n如sort=created_at%3Adesc表示根据创建时间逆序排列",
            "type": "string"
          },
          {
            "name": "device_id",
            "in": "query",
            "required": false,
            "description": "按终端设备ID查找",
            "type": "string"
          },
          {
            "name": "device_name",
            "in": "query",
            "required": false,
            "description": "按绑定终端设备名称查找",
            "type": "string"
          },
          {
            "name": "app_name",
            "in": "query",
            "required": false,
            "description": "按应用名称查找",
            "type": "string"
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "按边缘节点状态查找,节点状态可选项:\n- RUNNING:运行中\n- FAIL:故障\n- UPGRADING:升级中\n- STOPPED:已停用\n- UNCONNECTED:未纳管",
            "type": "string",
            "enum": [
              "RUNNING",
              "FAIL",
              "FREEZE",
              "UPGRADING",
              "STOPPED",
              "UNCONNECTED"
            ]
          },
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "description": "标签的key和value通过点连接,\n多个标签通过逗号连接,如:tags=key1.value1,key2.value2",
            "type": "string"
          },
          {
            "name": "group_id",
            "in": "query",
            "required": false,
            "description": "按边缘节点组ID查找。仅支持在铂金版实例中使用",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "响应参数",
