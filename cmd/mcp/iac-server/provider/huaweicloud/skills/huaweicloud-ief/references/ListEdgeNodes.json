  "definitions": {
    "DeviceInfos": {
      "description": "关联设备信息",
      "properties": {
        "relation": {
          "type": "string",
          "description": "设备和节点关系的名称,只允许中文字符、英文字母、数字、下划线、中划线,最大长度64"
        },
        "comment": {
          "type": "string",
          "description": "设备和节点关系的描述,最大长度64,不允许^ ~ # $ % & * < > ( ) [ ] { } ' \" \\"
        },
        "device_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "设备ID列表"
        }
      },
      "required": [
        "relation",
        "device_ids"
      ]
    },
    "EdgeNodes": {
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EdgeNodeResp"
          },
          "description": "边缘节点列表"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "满足条件的边缘节点个数"
        }
      },
      "required": [
        "nodes"
      ]
    },
    "StateDetails": {
      "type": "object",
      "description": "IEC/IES节点状态详情",
      "properties": {
        "register_stat": {
          "type": "string",
          "description": "IEC/IES节点注册状态"
        },
        "purchase_stat": {
          "type": "string",
          "description": "IEC/IES节点状态"
        },
        "purchase_error": {
          "type": "string",
          "description": "IEC/IES节点错误信息"
        }
      }
    },
    "ResourceTag": {
      "description": "标签属性",
      "properties": {
        "key": {
          "type": "string",
          "description": "键。最大长度36个unicode字符。\n不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”。"
        },
        "value": {
          "type": "string",
          "description": "值。每个值最大长度43个unicode字符,删除时如果value有值按照key/value删除,如果value没值,则按照key删除。\n不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”。"
        }
      },
      "type": "object"
    },
    "Attributes": {
      "description": "节点属性",
      "properties": {
        "key": {
          "type": "string",
          "description": "节点属性的key值,长度取值范围为1~128, 仅允许大小写英文字母、数字、下划线、中划线"
        },
        "value": {
          "type": "string",
          "description": "节点属性的value值,长度取值范围为1~256, 仅允许大小写英文字母、数字、下划线、中划线"
        }
      }
    },
    "NtpConfigs": {
      "description": "ntp配置",
      "properties": {
        "ntp_enabled": {
          "type": "boolean",
          "description": "ntp服务是否开启"
        },
        "ntp_servers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ntp server地址"
        }
      },
      "type": "object"
    },
    "Nics": {
      "properties": {
        "interface": {
          "type": "string",
          "description": "边缘节点网卡名称"
        },
        "ip": {
          "type": "string",
          "description": "上述网卡对应的IPv4地址"
        }
      }
    },
    "GpuInfo": {
      "properties": {
        "name": {
          "type": "string",
          "description": "GPU名称"
        },
        "type": {
          "type": "string",
          "description": "GPU类型"
        },
        "capacity": {
          "type": "string",
          "description": "GPU memory大小,单位MB"
        }
      }
