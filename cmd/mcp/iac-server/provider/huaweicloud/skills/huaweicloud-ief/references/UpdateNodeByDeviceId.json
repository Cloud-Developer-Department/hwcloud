        "x-support-sdk": "Y",
        "x-request-examples-text-1": {
          "nodes": {
            "added": {
              "node_ids": [
                "592ede18-d030-4cc1-afb8-34ac1bae47f6"
              ],
              "relation": "abcd",
              "comment": "hello world"
            },
            "removed": []
