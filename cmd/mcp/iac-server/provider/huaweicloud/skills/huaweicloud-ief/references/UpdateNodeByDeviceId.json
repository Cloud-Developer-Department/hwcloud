        "tags": [
          "终端设备管理"
        ],
        "summary": "更新终端设备的边缘节点",
        "description": "该API用于更新终端设备的边缘节点。功能与更新边缘节点的终端设备相同,推荐使用更新边缘节点的终端设备。",
        "operationId": "UpdateNodeByDeviceId",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/IEF-Instance-Id"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "设备ID"
          },
          {
            "name": "node",
            "in": "body",
            "required": true,
            "description": "节点信息",
            "schema": {
              "$ref": "#/definitions/EdgeNodeUpdateByDevice"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "更新成功",
            "schema": {
              "$ref": "#/definitions/EdgeNodeDeviceResp"
            },
            "examples": {
              "application/json": {
                "update_nodes": {
                  "removed": [],
                  "added": {
                    "comment": "hello world",
                    "relation": "abcd",
                    "node_ids": [
                      "592ede18-d030-4cc1-afb8-34ac1bae47f6"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "EdgeNodeUpdateByDevice": {
      "description": "边缘节点的终端设备信息",
      "properties": {
        "nodes": {
          "$ref": "#/definitions/NodeUpdateByDevice"
        }
      },
      "required": [
        "nodes"
      ]
    },
    "EdgeNodeDeviceResp": {
      "description": "边缘节点的终端设备信息",
      "properties": {
        "update_nodes": {
          "$ref": "#/definitions/NodeUpdateByDevice"
        }
      },
      "required": [
        "update_nodes"
      ]
    },
    "NodeUpdateByDevice": {
      "description": "边缘节点的终端设备信息",
      "properties": {
        "added": {
          "$ref": "#/definitions/NodeDeviceInfos"
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "要解绑的终端设备ID"
        }
      }
    },
    "NodeDeviceInfos": {
      "description": "要加入的节点详情",
      "properties": {
        "relation": {
          "type": "string",
          "description": "终端设备和节点关系的名称,只允许中文字符、英文字母、数字、下划线、中划线,最大长度64"
        },
        "comment": {
          "type": "string",
          "description": "终端设备和节点关系的描述,最大长度64,不允许^ ~ # $ % & * < > ( ) [ ] { } ' \" \\"
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "节点ID列表,一个设备只可以被绑定于一个边缘节点。"
        }
      },
      "required": [
        "node_ids"
      ],
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),默认取值为“application/json”",
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "IEF-Instance-Id": {
      "in": "header",
      "required": false,
      "description": "铂金版实例ID,专业版实例为空值",
      "type": "string",
      "name": "ief-instance-id"
    }
  },
  "host": "ief.cn-south-1.myhuaweicloud.com",
  "base_path": "/",
