          "$ref": "#/definitions/EventCreateDetail"
        }
      }
    },
    "EndpointResource": {
      "type": "object",
      "description": "消息端点资源属性",
      "properties": {
        "resource": {
          "type": "string",
          "description": "消息端点资源。 示例:- dis: {\"channel\": \"dis channel name\"} - servicebus: {\"path\": \"/request path\"} - apigw: {\"resource\": \"http://ssss.com\"} - eventbus: {\"topic\": \"/xxxx\"}"
        }
      }
    },
    "Event": {
      "type": "object",
      "description": "系统订阅事件基本信息",
      "properties": {
        "id": {
          "type": "string",
          "description": "系统订阅事件ID"
        },
        "name": {
          "type": "string",
          "description": "系统订阅事件名称。只允许小写英文字符、数字、下划线、中划线,最大长度64,同一个账号中创建的系统订阅和消息规则名唯一"
        },
        "project_id": {
          "type": "string",
          "description": "系统订阅事件所属项目ID"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "更新时间"
        },
        "description": {
          "type": "string",
          "description": "描述,最大长度255,不允许^~#$%&*<>()[]{}'\"\\"
        },
        "in_using": {
          "type": "boolean",
          "description": "是否启用系统订阅规则,默认为true(启用)"
        },
        "events": {
          "type": "string",
          "description": "系统订阅事件主题。每个主题由“{边缘资源}/{操作}”组成,多个主题使用逗号(,)进行分隔,支持如下主题:\n- edgeNode/offline:节点离线\n- edgeNode/online:节点上线\n- edgeNode/all:节点离线+节点上线\n- deployment/created:容器应用创建\n- deployment/updated:容器应用更新\n- deployment/deleted:容器应用删除\n- deployment/all:容器应用创建+更新+删除\n- instance/created:应用实例创建\n- instance/updated:应用实例更新\n- instance/deleted:应用实例删除\n- instance/all:应用实例创建+更新+删除"
        },
        "target": {
          "$ref": "#/definitions/EndpointObjResp",
          "description": "目的端点"
        },
        "target_resource": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "目的端点资源属性"
        },
        "success_messages": {
          "type": "integer",
          "format": "int32",
          "description": "成功次数"
        },
        "fail_messages": {
          "type": "integer",
          "format": "int32",
          "description": "失败次数"
        },
        "delete_at": {
          "type": "integer",
          "format": "int32",
          "description": "删除时间"
        }
      }
    },
    "EventDetailResponse": {
      "type": "object",
      "properties": {
        "systemevent": {
          "$ref": "#/definitions/Event",
          "description": "系统订阅详情"
        }
      },
      "description": "系统订阅详情返回体"
    },
    "EventCreateDetail": {
      "type": "object",
      "description": "系统订阅创建配置",
      "properties": {
        "name": {
          "type": "string",
          "description": "系统订阅名称。只允许小写英文字符、数字、下划线、中划线,最大长度64,同一个账号中创建的系统订阅和消息规则名唯一"
        },
        "description": {
          "type": "string",
          "description": "描述。最大长度255,不允许^~#$%&*<>()[]{}'\"\\"
        },
        "events": {
          "type": "string",
          "description": "系统订阅主题。每个主题由“{边缘资源}/{操作}”组成,多个主题使用逗号(,)进行分隔,支持如下主题:\n- edgeNode/offline:节点离线\n- edgeNode/online:节点上线\n- edgeNode/all:节点离线+节点上线\n- deployment/created:容器应用创建\n- deployment/updated:容器应用更新\n- deployment/deleted:容器应用删除\n- deployment/all:容器应用创建+更新+删除\n- instance/created:应用实例创建\n- instance/updated:应用实例更新\n- instance/deleted:应用实例删除\n- instance/all:应用实例创建+更新+删除"
        },
        "target": {
          "type": "string",
          "description": "目的端点ID"
        },
        "target_resource": {
          "description": "目的端点资源",
          "$ref": "#/definitions/EndpointResource"
        }
      }
    },
    "EndpointObjResp": {
      "description": "端点详情",
      "properties": {
        "created_at": {
          "type": "string",
          "description": "创建时间"
        },
        "description": {
          "type": "string",
          "description": "端点描述,最大长度255,不允许^~#$%&*<>()[]{}'\"\\"
        },
        "id": {
          "type": "string",
          "description": "端点ID"
        },
        "ief_instance_id": {
          "type": "string",
          "description": "铂金版实例ID,如果为空则表示是专业版实例。"
        },
        "is_shared": {
          "type": "boolean",
          "description": "是否共享"
        },
        "name": {
          "type": "string",
          "description": "端点名称,只允许中文字符、英文字符、数字、下划线、中划线,最大长度64\n同一个账号中创建的端点名唯一"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "description": "端点的属性,端点需要对外展示的属性,示例:\n- dis:\n{\"domain_id\":\"user's domain id\"}\n- servicebus:\n{\"service_port\":8080}\n- apigw:\n{\"domain_id\":\"user's domain id\"}"
        },
        "type": {
          "type": "string",
          "description": "端点类型。枚举值:\n- dis\n- servicebus\n- apigw"
        },
        "updated_at": {
          "type": "string",
          "description": "更新时间"
        }
      },
      "required": [
        "created_at",
        "description",
        "id",
        "ief_instance_id",
        "is_shared",
        "name",
        "project_id",
        "properties",
        "type",
        "updated_at"
      ]
    }
