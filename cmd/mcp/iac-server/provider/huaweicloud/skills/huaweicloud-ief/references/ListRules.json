  "definitions": {
    "RuleResponse": {
      "description": "规则配置",
      "properties": {
        "created_at": {
          "type": "string",
          "description": "创建时间"
        },
        "description": {
          "type": "string",
          "description": "规则描述,最大长度255,不允许^~#$%&*<>()[]{}'\"\\"
        },
        "fail_messages": {
          "type": "integer",
          "format": "int32",
          "description": "转发失败的消息数"
        },
        "id": {
          "type": "string",
          "description": "规则ID"
        },
        "ief_instance_id": {
          "type": "string",
          "description": "铂金版实例ID,如果为空则表示是专业版实例。"
        },
        "in_using": {
          "type": "boolean",
          "description": "是否启用规则,默认为true(启用)"
        },
        "name": {
          "type": "string",
          "description": "规则名称,只允许中文字符、英文字符、数字、下划线、中划线,最大长度64\n同一个账号中创建的规则名唯一"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID"
        },
        "source": {
          "$ref": "#/definitions/EndpointObjResp"
        },
        "source_resource": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "源端点资源。示例:\n- rest: {\"path\":\"\\<standard uri format\\>\"}\n- eventbus: {\"topic\":\"\\<project id\\>/nodes/\\<node id\\>/user/\\<租户自定义且满足eventbus topic要求的字符串\\>\",\"node_id\":\"\\<node id\\>\"}"
        },
        "target": {
          "$ref": "#/definitions/EndpointObjResp"
        },
        "target_resource": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "目的端点资源,示例:\n- dis: {\"channel\": \"dis channel name\"}\n- servicebus: {\"path\": \"/request path\"}\n- apigw: {\"resource\": \"http://ssss.com\"}\n- eventbus: {\"topic\": \"/xxxx\"}"
        },
        "updated_at": {
          "type": "string",
          "description": "更新时间"
        },
        "success_messages": {
          "type": "integer",
          "format": "int32",
          "description": "转发成功的消息数"
        }
      },
      "required": [
        "name",
        "project_id",
        "source",
        "source_resource",
        "target",
        "target_resource",
        "updated_at",
        "success_messages"
      ]
    },
    "Rules": {
      "properties": {
        "rules": {
          "items": {
            "$ref": "#/definitions/RuleResponse"
          },
          "description": "规则配置",
          "type": "array"
        },
        "count": {
          "type": "integer",
          "format": "int64",
          "description": "满足条件的规则个数"
        }
      },
      "required": [
        "rules",
        "count"
      ]
    },
    "EndpointObjResp": {
      "description": "端点详情",
      "properties": {
        "created_at": {
          "type": "string",
          "description": "创建时间"
        },
        "description": {
          "type": "string",
          "description": "端点描述,最大长度255,不允许^~#$%&*<>()[]{}'\"\\"
        },
        "id": {
          "type": "string",
          "description": "端点ID"
        },
        "ief_instance_id": {
          "type": "string",
          "description": "铂金版实例ID,如果为空则表示是专业版实例。"
        },
        "is_shared": {
          "type": "boolean",
          "description": "是否共享"
        },
        "name": {
          "type": "string",
          "description": "端点名称,只允许中文字符、英文字符、数字、下划线、中划线,最大长度64\n同一个账号中创建的端点名唯一"
        },
        "project_id": {
          "type": "string",
          "description": "项目ID"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "description": "端点的属性,端点需要对外展示的属性,示例:\n- dis:\n{\"domain_id\":\"user's domain id\"}\n- servicebus:\n{\"service_port\":8080}\n- apigw:\n{\"domain_id\":\"user's domain id\"}"
        },
        "type": {
          "type": "string",
          "description": "端点类型。枚举值:\n- dis\n- servicebus\n- apigw"
        },
        "updated_at": {
          "type": "string",
          "description": "更新时间"
        }
      },
      "required": [
        "created_at",
        "description",
        "id",
        "ief_instance_id",
        "is_shared",
        "name",
        "project_id",
        "properties",
        "type",
        "updated_at"
      ]
    }
  },
