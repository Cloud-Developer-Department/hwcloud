        "x-is-registered": "Y",
        "x-publishpath": "ief_02_0072",
        "tags": [
          "标签管理"
        ],
        "summary": "查询资源实例",
        "description": "使用标签过滤实例",
        "operationId": "ListResourceByTags",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/IEF-Instance-Id"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "resource_type",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "资源类型\n- ief-edge_node\n- ief-deployment\n- ief-application\n- ief-device"
          },
          {
            "name": "ListResourceByTags",
            "in": "body",
