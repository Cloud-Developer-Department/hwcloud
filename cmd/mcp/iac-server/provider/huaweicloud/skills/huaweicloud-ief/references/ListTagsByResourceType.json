{
  "name": "ListTagsByResourceType",
  "summary": "查询项目标签",
  "tags": "标签管理",
  "productshort": "IEF",
  "region_id": "cn-east-3",
  "paths": {
    "/v2/{project_id}/{resource_type}/tags": {
      "get": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "ief_02_0077",
        "tags": [
          "标签管理"
        ],
        "summary": "查询项目标签",
        "description": "查询指定项目中实例类型的所有资源标签集合",
        "operationId": "ListTagsByResourceType",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/IEF-Instance-Id"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "resource_type",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "资源类型\n- ief-edge_node\n- ief-deployment\n- ief-application\n- ief-device"
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "schema": {
              "$ref": "#/definitions/TagListResp"
            },
            "examples": {
              "application/json": {
                "count": 5,
                "tags": [
                  {
                    "values": [
                      "hwg"
                    ],
                    "key": "deployer"
                  },
                  {
                    "values": [
                      "batchjob"
                    ],
                    "key": "batchjob"
                  },
                  {
                    "values": [
                      "2"
                    ],
                    "key": "2"
                  },
                  {
                    "values": [
                      "bbb"
                    ],
                    "key": "aaa"
                  },
                  {
                    "values": [
                      "autotest"
                    ],
                    "key": "autotest"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Tag": {
      "description": "标签属性",
      "properties": {
        "key": {
          "type": "string",
          "description": "标签key值,长度取值范围为1~36, 仅允许大小写英文字母、数字、下划线、中划线"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "标签value值,长度取值范围为0~43, 仅允许大小写英文字母、数字、下划线、中划线"
        }
      },
      "required": [
        "key"
      ]
    },
    "TagListResp": {
      "properties": {
        "tags": {
          "items": {
            "$ref": "#/definitions/Tag"
          },
          "description": "标签列表",
          "type": "array"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "标签数量"
        }
      },
      "required": [
        "tags"
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),默认取值为“application/json”",
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "IEF-Instance-Id": {
      "in": "header",
      "required": false,
      "description": "铂金版实例ID,专业版实例为空值",
      "type": "string",
      "name": "ief-instance-id"
    }
  },
  "host": "ief.cn-east-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}