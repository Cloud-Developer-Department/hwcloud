  "definitions": {
    "HttpGetDetail": {
      "description": "执行http探测",
      "properties": {
        "path": {
          "type": "string",
          "description": "必须要以/开头,构造结果为:协议类型://主机地址:端口路径"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "description": "探测的http端口,1到65535之间的整数"
        },
        "host": {
          "type": "string",
          "description": "请求的主机地址,默认为容器IP"
        },
        "scheme": {
          "type": "string",
          "description": "协议类型,HTTP或HTTPS,默认HTTP"
        }
      },
      "required": [
        "path",
        "port"
      ]
    },
    "ListPodResponse": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "应用实例总数"
        },
        "pods": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PodResp"
          },
          "description": "应用实例列表"
        }
      },
      "required": [
        "count",
        "pods"
      ]
    },
    "HostContainerPort": {
      "description": "容器端口映射值",
      "properties": {
        "container_port": {
          "type": "integer",
          "format": "int32",
          "description": "构成一堆映射的容器端口"
        },
        "host_port": {
          "type": "integer",
          "format": "int32",
          "description": "构成一对映射的物理机对应网卡端口"
        },
        "host_ip": {
          "type": "string",
          "description": "对应网卡地址"
        }
      },
      "required": [
        "container_port"
      ]
    },
    "Exec": {
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "description": "探针执行命令,最大长度10240个字符"
        }
      }
    },
    "ContainerResp": {
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "容器启动参数,字符总长度最大为65536"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "容器启动命令,字符总长度最大为65536。\ncommand支持使用数组定义多条命令,但在IEF控制台界面只会显示第一条命令。"
        },
        "name": {
          "type": "string",
          "description": "容器名称,只允许英文小写字母、数字、中划线,最大长度32, 英文小写字母或数字开头和结尾"
        },
        "envs": {
          "items": {
            "$ref": "#/definitions/EnvPods"
          },
          "description": "环境变量",
          "type": "array"
        },
        "image_url": {
          "type": "string",
          "description": "容器镜像URL"
        },
        "version": {
          "type": "string",
          "description": "容器镜像版本"
        },
        "liveness_probe": {
          "$ref": "#/definitions/Probe"
        },
        "readiness_probe": {
          "$ref": "#/definitions/Probe"
        },
        "ports": {
          "items": {
            "$ref": "#/definitions/HostContainerPort"
          },
          "description": "容器端口映射值",
          "type": "array"
        },
        "resources": {
          "$ref": "#/definitions/DeploymentResources"
        },
        "volumes": {
          "items": {
            "$ref": "#/definitions/Volumes"
          },
          "description": "卷配置",
          "type": "array"
        },
        "restarts": {
          "type": "integer",
          "format": "int64",
          "description": "容器重启次数"
        },
        "message": {
          "type": "string",
          "description": "容器故障详情"
        },
        "reason": {
          "type": "string",
          "description": "容器故障原因"
        },
        "is_ready": {
          "type": "string",
          "description": "健康检查结果"
        },
        "privileged": {
          "type": "boolean",
          "description": "是否启用特权容器,默认值false"
        },
        "container_id": {
          "type": "string",
          "description": "容器ID"
        },
        "state": {
          "type": "string",
          "description": "容器状态"
        },
        "npu_type": {
          "type": "string",
          "description": "NPU类型,支持D310、D310B,支持填写:\n- D310:D310类型\n- D310B:D310B类型\n- 不填表示为D310类型。"
        }
      },
      "required": [
        "name",
        "image_url"
      ],
      "type": "object"
    },
    "Probe": {
      "properties": {
        "exec": {
          "description": "执行命令检查,与http_get二选一",
          "$ref": "#/definitions/Exec"
        },
        "http_get": {
          "description": "执行http探测",
          "$ref": "#/definitions/HttpGetDetail"
        },
        "initial_delay_seconds": {
          "type": "integer",
          "format": "int32",
          "description": "表示从工作负载启动后从多久开始探测,大于0且不大于3600的整数,默认为10"
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "int32",
          "description": "表示探测超时时间,大于0且不大于3600的整数,默认为1"
        }
      },
      "description": "探针配置"
    },
    "DeploymentResources": {
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "- 允许容器使用的最大资源,key值支持填写:cpu, memory, gpu, npu。\n- 申请NPU资源时可填写指定的NPU芯片类型,支持填写:D310、D310B。注意:key值填写为npu时,默认使用npu_type字段指定的芯片类型。如果npu_type字段为空,默认使用D310芯片类型。"
        },
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "- 容器需要使用的最小资源,key值支持填写:cpu, memory, gpu, npu\n- 申请NPU资源时可填写指定的NPU芯片类型,支持填写:D310、D310B。注意:key值填写为npu时,默认使用npu_type字段指定的芯片类型。如果npu_type字段为空,默认使用D310芯片类型。"
        }
      },
      "description": "创建容器时使用的资源",
      "type": "object"
    },
    "EnvPods": {
      "description": "环境变量",
      "properties": {
        "name": {
          "type": "string",
          "description": "环境变量的key,由大小写字母或下划线开头,由数字、大小写字母、下划线组成,最大长度2048个字符,不允许重复"
        },
        "value": {
          "type": "string",
          "description": "环境变量的value,最大长度20480个字符。value、value_from和field_path必须三选一使用。"
        }
      },
      "required": [
        "name"
      ]
    },
    "Volumes": {
      "description": "卷配置",
      "properties": {
        "name": {
          "type": "string",
          "description": "卷名称,小写字母或数字,最长63个字符"
        },
        "type": {
          "type": "string",
          "description": "卷的类型,支持configMap,secret,emptyDir,hostPath"
        },
        "source": {
          "type": "string",
          "description": "卷来源,type为hostPath时输入路径,要求以/开头,后面可包含中划线,反斜杠,下划线,点号,字母,数字; secret时输入secret名称,configMap时输入configMap名称,emptyDir时输入disk或memory"
        },
        "destination": {
          "type": "string",
          "description": "卷挂载路径,必须是合法的路径"
        },
        "read_only": {
          "type": "boolean",
          "description": "读写权限,configMap和secret类型只支持读权限"
        },
        "default_mode": {
          "type": "integer",
          "format": "int32",
          "description": "挂载的文件权限,仅configMap和secret类型生效,填写值为十进制表示的linux文件权限,默认为420(对应权限644)"
        }
      },
      "required": [
        "name",
        "type",
        "source",
        "destination"
      ],
      "type": "object"
    },
    "PodConfigs": {
      "description": "应用实例配置",
      "properties": {
        "host_network": {
          "type": "boolean",
          "description": "应用实例是否启用主机网络,不启用则使用端口映射,默认值false"
        },
        "host_pid": {
          "type": "boolean",
          "description": "应用实例是否与主机共PID命名空间,默认值false"
        },
        "migration": {
          "type": "boolean",
          "description": "应用实例故障是否迁移,指定节点组部署时必选,默认值false"
        },
        "restart_policy": {
          "type": "string",
          "description": "应用实例重启策略,可选值Always、OnFailure、Never"
        },
        "toleration_seconds": {
          "type": "integer",
          "format": "int32",
          "description": "应用实例故障容忍时间,容忍时间到达后迁移应用实例,只在指定节点组部署时生效"
        },
        "dns_policy": {
          "type": "string",
          "description": "应用实例DNS策略,可选值Default、ClusterFirst、ClusterFirstWithHostNet,默认为Default。应用实例启用主机网络时只能选填Default、ClusterFirstWithHostNet,不启用主机网络时只能选填Default、ClusterFirst"
        }
      },
      "required": [
        "restart_policy"
      ],
      "type": "object"
    },
    "PodResp": {
      "properties": {
        "id": {
          "type": "string",
          "example": "3e64d98a-37c5-43a6-9bfe-052b9083e362",
