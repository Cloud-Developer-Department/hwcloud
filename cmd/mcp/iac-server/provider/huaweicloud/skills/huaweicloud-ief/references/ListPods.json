        },
        "name": {
          "type": "string",
          "example": "app-test-69f9dc4b67-wfwn6",
          "description": "应用实例名称"
        },
        "configs": {
          "$ref": "#/definitions/PodConfigs"
        },
        "init_containers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContainerResp"
          },
          "description": "应用实例init容器"
        },
        "containers": {
          "items": {
            "$ref": "#/definitions/ContainerResp"
          },
          "description": "应用实例业务容器",
          "type": "array"
        },
        "node_id": {
          "type": "string",
          "example": "ff5f5129-f53f-4129-9f7f-ca7837063b5f",
          "description": "应用实例所在节点"
        },
        "deployment_id": {
          "type": "string",
          "description": "应用ID"
        },
        "project_id": {
          "type": "string",
          "example": "bcd83056c918480f8f190844bd425b23",
          "description": "项目ID"
        },
        "reason": {
          "type": "string",
          "description": "应用实例故障原因"
        },
        "message": {
          "type": "string",
          "description": "应用实例故障详情"
        },
        "created_at": {
          "type": "string",
          "example": "2019-10-10T02:24:02.325Z",
          "description": "应用实例创建时间"
        },
        "state": {
          "type": "string",
          "example": "RUNNING",
          "description": "应用实例状态:\n- RUNNING:实例运行中\n- PENDING:实例等待创建\n- SUCCEEDED:实例执行成功\n- FAILED:实例运行失败\n- CREATE_FAIL:实例创建失败\n- TERMINATING:实例终止中\n- PENDING_DELETE:实例等待删除\n- DELETE_FAILED:实例删除失败\n- FREEZE:实例冻结\n- UNKNOWN:实例状态未知"
        }
      },
      "required": [
        "id",
        "name",
        "configs",
        "containers",
        "node_id",
        "deployment_id",
        "project_id",
        "reason",
        "message",
        "created_at",
        "state"
      ],
      "type": "object"
    },
    "ErrorResponseBody": {
      "description": "响应Body参数",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述信息"
        }
      }
    }
  },
  "version": "2.0",
