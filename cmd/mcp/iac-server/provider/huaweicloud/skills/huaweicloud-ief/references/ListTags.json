{
  "name": "ListTags",
  "summary": "查询资源标签",
  "tags": "标签管理",
  "productshort": "IEF",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/{project_id}/{resource_type}/{resource_id}/tags": {
      "get": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-publishpath": "ief_02_0076",
        "tags": [
          "标签管理"
        ],
        "summary": "查询资源标签",
        "description": "查询指定实例的标签信息",
        "operationId": "ListTags",
        "parameters": [
          {
            "$ref": "#/parameters/Content-Type"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/IEF-Instance-Id"
          },
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "in": "path",
            "name": "resource_id",
            "required": true,
            "type": "string",
            "description": "资源ID"
          },
          {
            "in": "path",
            "name": "resource_type",
            "required": true,
            "type": "string",
            "description": "资源类型\n1. ief-edge_node\n2. ief-deployment\n3. ief-application\n4. ief-device"
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "schema": {
              "$ref": "#/definitions/TagResp"
            },
            "examples": {
              "application/json": {
                "tags": [
                  {
                    "value": "",
                    "key": "testtest"
                  },
                  {
                    "value": "",
                    "key": "test"
                  }
                ],
                "count": 0
              }
            }
          }
        },
        "schemes": [
          "https"
        ],
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ]
      }
    }
  },
  "definitions": {
    "TagResp": {
      "properties": {
        "tags": {
          "items": {
            "$ref": "#/definitions/ResourceTag"
          },
          "description": "标签属性",
          "type": "array"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "标签数量"
        }
      },
      "required": [
        "tags",
        "count"
      ]
    },
    "ResourceTag": {
      "description": "标签属性",
      "properties": {
        "key": {
          "type": "string",
          "description": "键。最大长度36个unicode字符。\n不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”。"
        },
        "value": {
          "type": "string",
          "description": "值。每个值最大长度43个unicode字符,删除时如果value有值按照key/value删除,如果value没值,则按照key删除。\n不能为空,只能包含大小写字母,数字,中划线“-”,下划线“_”。"
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {
    "Content-Type": {
      "name": "Content-Type",
      "in": "header",
      "required": true,
      "description": "消息体的类型(格式),默认取值为“application/json”",
      "type": "string"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "IEF-Instance-Id": {
      "in": "header",
      "required": false,
      "description": "铂金版实例ID,专业版实例为空值",
      "type": "string",
      "name": "ief-instance-id"
    }
  },
  "host": "ief.cn-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}