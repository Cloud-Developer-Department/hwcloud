        },
        "ports": {
          "items": {
            "$ref": "#/definitions/SvcPort"
          },
          "description": "服务需要暴露的端口列表",
          "type": "array"
        },
        "selector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "标签选择器,将选择具有指定Label标签的Pod作为管理范围"
        },
        "type": {
          "type": "string",
          "description": "服务的类型"
        }
      },
      "required": [
        "selector"
      ]
