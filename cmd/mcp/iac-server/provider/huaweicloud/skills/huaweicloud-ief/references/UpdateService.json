        }
      },
      "required": [
        "meta_data",
        "spec"
      ]
    },
    "SvcPort": {
      "description": "服务需要暴露的端口列表",
      "properties": {
        "name": {
          "type": "string",
          "description": "服务端口必须进行命名,而且名称只允许是{protocol}-{suffix}这种格式,其中{protocol}可以是tcp、http等,IEF根据在端口上定义的协议来提供对应的路由能力。例如“name:http-0”和“name:tcp-0”是合法的端口名,“name:http2forecast”是非法的端口号。"
        },
        "node_port": {
          "type": "string",
          "description": "当spec.type=NodePort时,指定映射到物理机的端口号"
        },
        "port": {
          "type": "string",
          "description": "服务监听的端口号"
        },
        "protocol": {
          "type": "string",
          "description": "具体的协议,比如TCP"
        },
        "target_port": {
          "type": "string",
          "description": "需要转发到后端Pod的端口号"
        }
      }
    },
    "ServiceResp": {
      "description": "服务详情",
      "properties": {
