  "definitions": {
    "DiskSetAutoExpansionPolicy": {
      "required": [
        "instance_id"
      ],
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string",
          "description": "**参数解释:**\n实例ID。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "threshold": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释:**\n触发自动扩容阈值,只支持输入80、85和90。默认阈值为90,即当已使用存储空间达到总存储空间的90%时就会触发扩容。集群实例的自动扩容阈值指的是每个shard。\n**约束限制:**\n只支持输入80、85和90。\n**取值范围:**\n80、85和90\n**默认取值:**\n90。"
        },
        "step": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释:**\n扩容步长(s%),默认为10,支持输入10、15和20。当触发自动扩容的时候,自动扩容当前存储空间的s%(非10倍数向上取整。小数点后四舍五入,默认一次最小10G,账户余额不足时,会导致包年包月实例扩容失败)。\n**约束限制:**\n只支持输入10、15和20。\n**取值范围:**\n10、15和20。\n**默认取值:**\n10。"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释:**\n最大扩容上限,即当自动扩容达到上限后不再触发自动扩容。\n**约束限制:**\n实例规格小于8U时,自动扩容上限为5000GB;大于等于8U时,自动扩容上限为10000GB。\n**取值范围:**\n实例规格小于8U时,自动扩容上限为5000GB;大于等于8U时,自动扩容上限为10000GB。\n**默认取值:**\n5000。"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "SetAutoEnlargePoliciesRequestBody": {
      "required": [
        "policies"
      ],
      "type": "object",
      "properties": {
        "switch_option": {
          "type": "string",
          "enum": [
            true,
            false
          ],
          "description": "**参数解释:**\n自动扩容开关。\n**约束限制:**\n不涉及。\n**取值范围:**\n- on:开启磁盘自动扩容策略。\n- off: 关闭磁盘自动扩容策略。\n**默认取值:**\non。",
          "example": false
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DiskSetAutoExpansionPolicy"
          },
          "description": "**参数解释:**\n磁盘自动扩容策略。\n**约束限制:**\n最大支持设置10个实例的策略。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。\n**参数解释:**\n不涉及。"
        }
      }
    }
  },
