  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "SetAuditlogPolicyRequestBody": {
      "required": [
        "keep_days"
      ],
      "properties": {
        "keep_days": {
          "type": "integer",
          "description": "审计日志保存天数,取值范围0,7~732。\n- 取值0,表示关闭审计日志策略。\n- 取值7~732,表示开启审计日志策略,并设置审计日志保存天数为该值。"
        },
        "reserve_auditlogs": {
          "type": "string",
          "description": "仅关闭审计日志策略时有效。\n- true(默认),表示关闭审计日志策略的同时,保留历史审计日志。\n- false,表示关闭审计日志策略的同时,删除已有的历史审计日志。"
        },
        "audit_scope": {
          "type": "string",
          "description": "仅打开审计日志策略时有效,并且为空时,默认全部。审计范围。请输入数据库或集合名称,多个库或集合请用英文逗号分隔。若名称中有英文逗号,请在逗号前添加“$”符号,用以区分分隔符。"
        },
        "audit_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "仅打开审计日志策略时有效,并且为空时,默认全部。审计类型。支持insert,delete,update,query等。"
        }
      }
    }
  },
