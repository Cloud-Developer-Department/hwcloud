            "type": "string",
            "x-example": "befb1cfe1f96403780396b0c54f85d11in02"
          },
          {
            "name": "backup_id",
            "in": "query",
            "description": "备份ID。",
            "required": true,
            "type": "string",
            "x-example": "afbf982b46ca421e9118f7db916058b5br02"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
