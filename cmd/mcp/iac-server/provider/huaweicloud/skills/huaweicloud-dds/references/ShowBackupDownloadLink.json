            },
            "examples": {
              "application/json": {
                "files": [
                  {
                    "name": "c0c9f155c7b7423a9d30f0175998b63bbr02.xxx",
                    "size": 2803,
                    "download_link": "https://obs.domainname.com/rdsbucket.username.1/xxxxxx",
