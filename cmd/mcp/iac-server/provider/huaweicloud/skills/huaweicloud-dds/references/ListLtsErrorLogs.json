{
  "name": "ListLtsErrorLogs",
  "summary": "查询数据库错误日志",
  "tags": "获取日志信息",
  "productshort": "DDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3.1/{project_id}/instances/{instance_id}/error-logs": {
      "post": {
        "tags": [
          "获取日志信息"
        ],
        "operationId": "ListLtsErrorLogs",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-open-region-cloud": "hc,hk",
        "summary": "查询数据库错误日志",
        "description": "查询数据库错误日志信息。",
        "x-constraint": "- 不支持使用 &&、||、AND、OR、NOT、*、?、:、>、<、=、>=、<= 这些关键字来搜索日志。\n- 每页查询最大限制100条,日志最多保存30天。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID,可以调用“[查询实例列表和详情](x-wc://file=zh-cn_topic_0000001369935045.xml)”接口获取。如果未申请实例,可以调用“[创建实例](x-wc://file=zh-cn_topic_0000001369734929.xml)”接口创建。",
            "required": true,
            "type": "string",
            "x-example": "520c58ba00a3497e97ce0b9604874dd6in02"
          },
          {
            "name": "ListLtsErrorLogsRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListLtsErrorLogsRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ListLtsErrorLogsResponseBody"
            },
            "examples": {
              "application/json": {
                "error_logs": [
                  {
                    "node_name": "Test_replica_node_2",
                    "node_id": "dbd0b65ed0c34125a0b04d4e5ba67e66no02",
                    "raw_message": "W NETWORK  [ShardServerCatalogCacheLoader-214] Unable to reach primary for set shard_2",
                    "severity": "Warning",
                    "log_time": "2023-01-09T12:55:39.398+0000",
                    "line_num": "1595659490239433659"
                  }
                ]
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "POST https://{endpoint}/v3.1/0483b6b16e954cb88930a360d2c4e663/instances/6ade8143870047b8999aba8f1891b48ein02/error-logs",
        "x-request-examples-1": {
          "start_time": "2023-01-06T10:41:14+0800",
          "end_time": "2023-01-09T13:41:14+0800",
          "limit": 100,
          "line_num": "1595659490239433658",
          "severity": "Warning",
          "search_type": "backwards",
          "node_id": "dbd0b65ed0c34125a0b04d4e5ba67e66no02",
          "keywords": [
            "Unable",
            "NETWORK"
          ]
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "ListLtsErrorLogsResponseBody": {
      "required": [
        "error_logs"
      ],
      "properties": {
        "error_logs": {
          "description": "错误日志具体信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ErrorLogDetail"
          }
        }
      }
    },
    "ListLtsErrorLogsRequestBody": {
      "required": [
        "start_time",
        "end_time",
        "limit"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "description": "开始时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。注:开始时间不得早于当前时间30天。"
        },
        "end_time": {
          "type": "string",
          "description": "结束时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。注:结束时间不能晚于当前时间。"
        },
        "limit": {
          "type": "integer",
          "description": "表示每次查询的日志条数,最大限制100条。"
        },
        "line_num": {
          "type": "string",
          "description": "日志单行序列号,第一次查询时不需要此参数,下一页查询时需要使用,可从上一次查询的返回信息中获取。\n说明:当次查询从line_num的下一条日志开始查询,不包含当前line_num日志。"
        },
        "severity": {
          "type": "string",
          "description": "日志级别,取空值表示查询所有日志级别。",
          "enum": [
            "Warning",
            "Error"
          ]
        },
        "search_type": {
          "type": "string",
          "description": "日志查询方式,需结合line_num使用, 以line_num的日志为起始点:\n- 取值\"backwards\"时,表示查询上一页limit大小的日志\n- 取值\"forwards\"时,表示查询下一页limit大小的日志\n- 不传默认\"forwards\"",
          "enum": [
            "backwards",
            "forwards"
          ]
        },
        "node_id": {
          "type": "string",
          "description": "节点ID,取空值,表示查询实例下所有允许查询的节点。\n使用请参考《DDS API参考》的“查询实例列表和详情”响应消息表“nodes 数据结构说明”的“id”。允许查询的节点如下:\n- 集群实例下面的 shard节点\n- 副本集、单节点实例下面的所有节点"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "根据多个关键字搜索日志全文,表示同时匹配所有关键字。\n- 只支持关键字前缀模糊搜索,最多支持10个关键字。\n- 每个关键字最大长度不超过512个字符。"
        }
      }
    },
    "ErrorLogDetail": {
      "required": [
        "node_name",
        "node_id",
        "raw_message",
        "severity",
        "log_time",
        "line_num"
      ],
      "properties": {
        "node_name": {
          "type": "string",
          "description": "节点名称。",
          "example": "Test_replica_node_2"
        },
        "node_id": {
          "type": "string",
          "description": "节点ID。",
          "example": "dbd0b65ed0c34125a0b04d4e5ba67e66no02"
        },
        "raw_message": {
          "type": "string",
          "description": "描述信息。",
          "example": "Failed to unlock lock with ts:1231423533643 caused by."
        },
        "severity": {
          "type": "string",
          "description": "日志级别。",
          "example": "Warning"
        },
        "log_time": {
          "type": "string",
          "description": "日志产生时间,UTC时间。\n格式为“yyyy-mm-ddThh:mm:ssZ”。 其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。",
          "example": "2020-11-15T22:49:38.643000Z"
        },
        "line_num": {
          "type": "string",
          "description": "日志单行序列号。",
          "example": "1595659490239433658"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}