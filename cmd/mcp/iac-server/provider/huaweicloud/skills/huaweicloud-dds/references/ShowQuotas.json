{
  "name": "ShowQuotas",
  "summary": "查询配额",
  "tags": "配额管理",
  "productshort": "DDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/quotas": {
      "get": {
        "tags": [
          "配额管理"
        ],
        "operationId": "ShowQuotas",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-open-region-cloud": "hc,hk",
        "summary": "查询配额",
        "description": "查询单租户在DDS服务下的资源配额,包括单节点实例配额、副本集实例配额、集群实例配额等。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ShowQuotasResponseBody"
            },
            "examples": {
              "application/json": {
                "quotas": {
                  "resources": [
                    {
                      "type": "instance",
                      "mode": "Sharding",
                      "quota": 80,
                      "used": 6
                    },
                    {
                      "type": "instance",
                      "mode": "ReplicaSet",
                      "quota": 80,
                      "used": 9
                    },
                    {
                      "type": "instance",
                      "mode": "Single",
                      "quota": 1000,
                      "used": 5
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "查询配额",
        "x-request-examples-url-1": "GET https://dds.ap-southeast-1.myhuaweicloud.com/v3/0549b4a43100d4f32f51c01c2fe4acdb/quotas"
      }
    }
  },
  "definitions": {
    "ShowQuotasResponseBody": {
      "required": [
        "quotas"
      ],
      "properties": {
        "quotas": {
          "type": "object",
          "description": "配额信息。",
          "$ref": "#/definitions/ShowResourcesListResponseBody"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "ShowResourcesListResponseBody": {
      "required": [
        "resources"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "description": "资源列表对象。",
          "items": {
            "$ref": "#/definitions/ShowResourcesDetailResponseBody"
          }
        }
      }
    },
    "ShowResourcesDetailResponseBody": {
      "required": [
        "type",
        "mode",
        "quota",
        "used"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "配额资源类型,当前配额类型仅支持实例类型(instance)。"
        },
        "mode": {
          "type": "string",
          "description": "实例类型:\n- 若值为“Single”,则表示单节点实例配额信息。\n- 若值为“ReplicaSet”,则表示副本集实例配额信息。\n- 若值为“Sharding”,则表示集群实例配额信息。"
        },
        "quota": {
          "type": "integer",
          "description": "当前配额值。"
        },
        "used": {
          "type": "integer",
          "description": "已使用的资源数。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}