{
  "name": "ResizeInstance",
  "summary": "变更实例规格",
  "tags": "实例管理",
  "productshort": "DDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/resize": {
      "post": {
        "tags": [
          "实例管理"
        ],
        "operationId": "ResizeInstance",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-open-region-cloud": "hc,hk",
        "summary": "变更实例规格",
        "description": "变更实例的规格。",
        "x-constraint": "- 该接口既支持包年包月实例,也支持按需实例。\n- 需要改变的规格不能与原规格一样。\n- 实例状态仅为“normal”时,可以变更实例规格。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID,可以调用“查询实例列表和详情”接口获取。如果未申请实例,可以调用“创建实例”接口创建。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein02"
          },
          {
            "name": "ResizeInstanceRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ResizeInstanceRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ResizeInstanceResponseBody"
            },
            "examples": {
              "application/json": {
                "job_id": "04efe8e2-9255-44ae-a98b-d87cae411890"
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "变更集群实例下mongos节点的规格:",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/054e292c9880d4992f02c0196d3eain02/resize",
        "x-request-examples-1": {
          "resize": {
            "target_type": "mongos",
            "target_id": "a742c13a284949adad177672e8a0f01cno02",
            "target_spec_code": "dds.mongodb.c6.large.4.mongos"
          }
        },
        "x-request-examples-description-2": "变更集群实例下shard组的规格:",
        "x-request-examples-url-2": "POST https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/054e292c9880d4992f02c0196d3eain02/resize",
        "x-request-examples-2": {
          "resize": {
            "target_type": "shard",
            "target_id": "aeeb40a704904977ad78993d138ec942gr02",
            "target_spec_code": "dds.mongodb.c6.large.4.shard"
          }
        },
        "x-request-examples-description-3": "变更副本集或单节点实例的规格:",
        "x-request-examples-url-3": "POST https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/054e292c9880d4992f02c0196d3eain02/resize",
        "x-request-examples-3": {
          "resize": {
            "target_id": "aeeb40a704904977ad78993d138ec942in02",
            "target_spec_code": "dds.mongodb.c6.medium.4.repset"
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "ResizeInstanceOption": {
      "required": [
        "target_spec_code"
      ],
      "properties": {
        "target_type": {
          "type": "string",
          "description": "对象类型。\n- 对于集群实例,该参数为必选。变更mongos节点规格时,取值为“mongos”;变更单个shard组规格、或者批量变更多个shard组规格时,取值为“shard”,变更config组规格时,取值为\"config\"。\n- 对于副本集实例,不传该参数。变更readonly节点规格时,取值为“readonly”。\n- 对于单节点实例,不传该参数。",
          "enum": [
            "mongos",
            "shard",
            "config",
            "readonly"
          ]
        },
        "target_id": {
          "type": "string",
          "description": "待变更规格的节点ID或实例ID,可以调用“查询实例列表和详情”接口获取。如果未申请实例,可以调用“创建实例”接口创建。\n- 对于集群实例,变更mongos节点规格时,取值为mongos节点ID;变更单个shard组规格时,取值为shard组ID;批量变更多个shard组规格时,不传该参数;变更config组规格时,取值为config组的ID。\n- 对于副本集实例,取值为相应的实例ID。变更readonly节点规格时,取值为readonly节点ID。\n- 对于单节点实例,取值为相应的实例ID。"
        },
        "target_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "待变更规格的节点组ID列表,可以调用“查询实例列表和详情”接口获取。如果未申请实例,可以调用“创建实例”接口创建。\n- 对于集群实例,变更mongos节点规格时,不传该参数;变更单个shard组规格时,不传该参数;变更config组规格时,不传该参数;批量变更多个shard组规格时,取值为相应的多个shard组ID,最多支持16个shard组批量变更。\n- 对于副本集实例,不传该参数。\n- 对于单节点实例,不传该参数。"
        },
        "target_spec_code": {
          "type": "string",
          "description": "变更至新规格的资源规格编码。"
        }
      }
    },
    "ResizeInstanceResponseBody": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID。",
          "example": "6ad4eb1f-73bd-4876-aa31-aa9a1e41c4bc"
        },
        "order_id": {
          "type": "string",
          "description": "订单ID,仅变更包年包月实例的规格时返回该参数。",
          "example": "CS20070721568OVO9"
        }
      }
    },
    "ResizeInstanceRequestBody": {
      "required": [
        "resize"
      ],
      "properties": {
        "resize": {
          "description": "目标规格信息。",
          "$ref": "#/definitions/ResizeInstanceOption"
        },
        "is_auto_pay": {
          "type": "boolean",
          "description": "变更包年包月实例规格时可指定,表示是否自动从账户中支付,此字段不影响自动续订的支付方式。\n- 对于降低规格场景,该字段无效。\n- 对于扩大规格场景:\n  - true,表示自动从账户中支付。\n  - false,表示手动从账户中支付,默认为该方式。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}