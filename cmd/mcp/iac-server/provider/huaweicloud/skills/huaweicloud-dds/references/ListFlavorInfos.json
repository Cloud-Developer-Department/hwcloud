{
  "name": "ListFlavorInfos",
  "summary": "查询数据库规格",
  "tags": "引擎版本和规格",
  "productshort": "DDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3.1/{project_id}/flavors": {
      "get": {
        "tags": [
          "引擎版本和规格"
        ],
        "operationId": "ListFlavorInfos",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-open-region-cloud": "hc,hk",
        "summary": "查询数据库规格",
        "description": "查询指定条件下的实例规格信息。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "engine_name",
            "in": "query",
            "description": "数据库版本类型。取值为“DDS-Community”。",
            "type": "string",
            "enum": [
              "DDS-Community",
              "DDS-Enhanced"
            ],
            "x-example": "DDS-Community"
          },
          {
            "name": "engine_version",
            "in": "query",
            "description": "数据库版本号。",
            "type": "string",
            "x-example": "3.4"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "索引位置,偏移量。\n  - 从第一条数据偏移offset条数据后开始查询,默认为0(偏移0条数据,表示从第一条数据开始查询)。\n  - 取值必须为数字,不能为负数。",
            "type": "integer",
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询规格信息上限值。\n  - 取值范围: 1~100。\n  - 不传该参数时,默认查询前100条规格信息。",
            "type": "integer",
            "x-example": 100
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ListFlavorInfoResponseBody"
            },
            "examples": {
              "application/json": {
                "total_count": 5,
                "flavors": [
                  {
                    "engine_name": "DDS-Community",
                    "type": "mongos",
                    "vcpus": "1",
                    "ram": "4",
                    "spec_code": "dds.mongodb.c6.medium.4.mongos",
                    "engine_versions": [
                      "3.4",
                      "4.0"
                    ]
                  },
                  {
                    "engine_name": "DDS-Community",
                    "type": "shard",
                    "vcpus": "4",
                    "ram": "8",
                    "spec_code": "dds.mongodb.c6.xlarge.2.shard",
                    "engine_versions": [
                      "3.4",
                      "4.0"
                    ]
                  },
                  {
                    "engine_name": "DDS-Community",
                    "type": "config",
                    "vcpus": "2",
                    "ram": "4",
                    "spec_code": "dds.mongodb.c6.large.2.config",
                    "engine_versions": [
                      "3.4"
                    ]
                  },
                  {
                    "engine_name": "DDS-Community",
                    "type": "replica",
                    "vcpus": "1",
                    "ram": "4",
                    "spec_code": "dds.mongodb.c6.medium.4.repset",
                    "engine_versions": [
                      "3.4",
                      "4.0"
                    ]
                  },
                  {
                    "engine_name": "DDS-Community",
                    "type": "single",
                    "vcpus": "16",
                    "ram": "64",
                    "spec_code": "dds.mongodb.c6.4xlarge.4.single",
                    "engine_versions": [
                      "3.4",
                      "4.0"
                    ]
                  }
                ]
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v3.1/054e292c9880d4992f02c0196d3ea468/flavors?engine_name=DDS-Community&engine_version=3.4&offset=1&limit=20"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "FlavorInfo": {
      "description": "规格信息。",
      "required": [
        "engine_name",
        "type",
        "vcpus",
        "ram",
        "spec_code",
        "az_status",
        "engine_versions"
      ],
      "properties": {
        "engine_name": {
          "type": "string",
          "description": "引擎名称。",
          "example": "DDS-Community"
        },
        "type": {
          "type": "string",
          "example": "mongos",
          "description": "节点类型。文档数据库包含以下几种节点类型:\n- mongos\n- shard\n- config\n- replica\n- single\n- readonly"
        },
        "vcpus": {
          "type": "string",
          "description": "CPU核数。",
          "example": "2"
        },
        "ram": {
          "type": "string",
          "description": "内存大小,单位为兆字节。",
          "example": 4
        },
        "spec_code": {
          "type": "string",
          "description": "资源规格编码。例如:dds.mongodb.c6.xlarge.2.shard。\n\n- “dds”表示文档数据库服务产品。\n- “c6.xlarge.2”表示节点性能规格,为高内存类型。\n- “shard”表示节点类型。",
          "example": "dds.mongodb.c6.xlarge.2.shard"
        },
        "az_status": {
          "description": "'支持该规格的可用区ID。'\n示例:[\"cn-east-2a\",\"cn-east-2b\",\"cn-east-2c\"]。",
          "type": "object"
        },
        "engine_versions": {
          "description": "数据库版本号列表。针对DDS引擎的mongos节点,例如:{\"3.4\", \"4.0\"}",
          "type": "array",
          "items": {
            "description": "数据库版本号。",
            "type": "string"
          }
        }
      }
    },
    "ListFlavorInfoResponseBody": {
      "required": [
        "flavors",
        "total_count"
      ],
      "properties": {
        "total_count": {
          "type": "integer",
          "example": 10,
          "description": "总记录数。"
        },
        "flavors": {
          "description": "实例规格信息列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlavorInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}