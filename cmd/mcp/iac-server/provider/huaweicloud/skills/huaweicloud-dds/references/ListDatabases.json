{
  "name": "ListDatabases",
  "summary": "查询数据库列表",
  "tags": "管理数据库和用户",
  "productshort": "DDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/databases": {
      "get": {
        "tags": [
          "管理数据库和用户"
        ],
        "operationId": "ListDatabases",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-open-region-cloud": "hc,hk",
        "summary": "查询数据库列表",
        "description": "查询数据库列表。",
        "x-constraint": "- 该接口只支持DDS社区版。\n- 实例在创建、规格变更、修改端口、冻结、重启等以及状态非“normal”时,不允许执行该操作。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID,可以调用“查询实例列表和详情”接口获取。如果未申请实例,可以调用“创建实例”接口创建。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein02"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "索引位置偏移量。\n取值大于或等于0。不传该参数时,查询偏移量默认为0。",
            "type": "integer"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询实例个数上限值。\n取值范围:1~100。不传该参数时,默认查询前100条实例信息。",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/QueryDataBasesResponseBody"
            },
            "examples": {
              "examples": {
                "application/json": {
                  "databases": [
                    {
                      "name": [
                        "dds-test"
                      ],
                      "data_size": [
                        3593
                      ],
                      "storage_size": [
                        256
                      ],
                      "collection_num": 5
                    }
                  ],
                  "total_count": 1
                }
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/3527b6b16e7639b88930a360d2c4in02/databases?offset=0&limit=100"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "DatabaseInfoItem": {
      "properties": {
        "name": {
          "type": "string",
          "description": "数据库名称, config admin 库不做展示。"
        },
        "data_size": {
          "type": "string",
          "description": "数据库存储大小(以GB为单位),保留两位小数。 存储大小: 实际磁盘上占用的物理空间大小,包括数据文件、日志文件、索引文件等。"
        },
        "storage_size": {
          "type": "string",
          "description": "数据库逻辑大小 (以GB为单位),保留两位小数。 逻辑大小指的是数据库中实际存储的数据大小,不包括索引大小、日志大小等。"
        },
        "collection_num": {
          "type": "integer",
          "description": "数据库中的集合数。"
        }
      }
    },
    "QueryDataBasesResponseBody": {
      "required": [
        "databases",
        "total_count"
      ],
      "properties": {
        "databases": {
          "description": "数据库列表信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/DatabaseInfoItem"
          }
        },
        "total_count": {
          "type": "integer",
          "description": "数据库列表总数。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}