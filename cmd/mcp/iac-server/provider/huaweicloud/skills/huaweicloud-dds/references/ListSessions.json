        "type",
        "cost_time",
        "plan_summary",
        "host",
        "client",
        "description",
        "namespace"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "会话ID。"
        },
        "active": {
          "type": "boolean",
          "description": "当前会话是否活跃。\n取值为“true”,表示活跃。\n取值为“false”,表示不活跃。"
        },
        "operation": {
          "type": "string",
          "description": "操作。"
        },
        "type": {
          "type": "string",
