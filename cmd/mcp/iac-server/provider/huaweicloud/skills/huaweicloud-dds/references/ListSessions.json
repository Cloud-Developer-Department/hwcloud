{
  "name": "ListSessions",
  "summary": "查询实例节点会话",
  "tags": "连接管理",
  "productshort": "DDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/nodes/{node_id}/sessions": {
      "get": {
        "tags": [
          "连接管理"
        ],
        "summary": "查询实例节点会话",
        "description": "查询实例节点会话。",
        "operationId": "ListSessions",
        "x-open-region-cloud": "hc,hk",
        "x-constraint": "- 支持3.4及以上版本的社区版实例。",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "租户在某一region下的project ID。",
            "type": "string"
          },
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "description": "节点ID。允许查询的节点如下:\n集群下面的 mongos节点以及\n副本集、单节点实例下面的所有节点。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "索引位置,偏移量。\n从第一条数据偏移offset条数据后开始查询,默认为0(偏移0条数据,表示从第一条数据开始查询),必须为数字,不能为负数。",
            "type": "integer"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "查询记录数。取值范围[1, 20],默认10 (表示返回10条数据)。",
            "type": "integer"
          },
          {
            "name": "plan_summary",
            "in": "query",
            "required": false,
            "description": "执行计划描述。取空值表示查询所有语句类型,也可指定执行计划,例如:\nCOLLSCAN\nIXSCAN\nFETCH\nSORT\nLIMIT\nSKIP\nCOUNT\nCOUNT_SCAN\nTEXT\nPROJECTION 等",
            "type": "string"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "操作类型。取空值表示查询所有操作类型。也可指定操作类型,例如:\nnone\nupdate\ninsert\nquery\ncommand\ngetmore\nremove\nkillcursors等",
            "type": "string"
          },
          {
            "name": "namespace",
            "in": "query",
            "required": false,
            "description": "命名空间。取空值表示查询所有命名空间。也可根据当前业务进行指定。",
            "type": "string"
          },
          {
            "name": "cost_time",
            "in": "query",
            "required": false,
            "description": "运行时间,单位为 us。取空值表示查询所有的运行时间。也可根据当前业务需要进行配置,表示查询超出 cost_time 的会话。",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ListSessionsResponseBody"
            },
