        },
        "client": {
          "type": "string",
          "description": "客户端地址。"
        },
        "description": {
          "type": "string",
          "description": "连接描述。"
        },
        "namespace": {
          "type": "string",
          "description": "命名空间。"
        },
        "db": {
          "type": "string",
          "description": "正在操作的数据库名称。"
        },
        "user": {
          "type": "string",
          "description": "用户名称。仅支持4.2及以上版本,如果无法显示该字段,请升级内核版本。"
        }
      }
