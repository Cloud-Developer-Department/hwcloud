{
  "name": "ListScheduledTasks",
  "summary": "查询定时任务",
  "tags": "任务管理",
  "productshort": "DDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/scheduled-jobs": {
      "get": {
        "x-request-examples-url-1": "GET https://gaussdb-nosql.cn-north-7.myhuaweicloud.com/v3/b02ce40e8cb84a8e980fdb11fac657db/scheduled-jobs",
        "tags": [
          "任务管理"
        ],
        "summary": "查询定时任务",
        "description": "根据指定条件查询定时任务列表。",
        "operationId": "ListScheduledTasks",
        "x-open-region-cloud": "hc,hk",
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "实例所属的项目Id。"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户认证Token。",
            "type": "string"
          },
          {
            "name": "job_name",
            "in": "query",
            "required": false,
            "description": "任务名称,默认为空。对应取值如下:\n\"RESIZE_FLAVOR\":变更实例的CPU和内存规格",
            "type": "string"
          },
          {
            "name": "job_status",
            "in": "query",
            "required": false,
            "description": "任务执行状态,默认为空。 取值:\n- 值为\"Pending\",表示任务未执行。\n- 值为\"Running\",表示任务正在执行。\n- 值为\"Completed\",表示任务执行成功。\n- 值为\"Failed\",表示任务执行失败。\n- 值为\"Canceled\",表示任务取消执行。",
            "type": "string"
          },
          {
            "name": "instance_id",
            "in": "query",
            "required": false,
            "description": "实例ID,不传该值默认查所有符合条件的实例。",
            "type": "string"
          },
          {
            "name": "start_time",
            "in": "query",
            "required": false,
            "description": "任务创建起始时间,格式为\"yyyy-mm-ddThh:mm:ssZ\"。 其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100,不传默认为当前时间前七天。",
            "type": "string"
          },
          {
            "name": "end_time",
            "in": "query",
            "required": false,
            "description": "任务创建结束时间,格式为\"yyyy-mm-ddThh:mm:ssZ\"。 其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100,不传默认为当前时间。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0。",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "查询记录数。不传该参数时,默认为10,取值范围1-100。",
            "type": "integer",
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/ScheduledTasksRsp"
            },
            "examples": {
              "application/json": {
                "total_count": 1,
                "schedules": [
                  {
                    "job_id": "3861199d-c196-4791-bcd0-b45fde754f50",
                    "job_name": "RESIZE_FLAVOR",
                    "job_status": "Pending",
                    "instance_id": "a2b33e2077ee41e397e57cd2f022b72fin02",
                    "instance_name": "dds-zzx-recover",
                    "instance_status": "normal",
                    "create_time": "2019-05-26T10:41:14+0000",
                    "start_time": "2019-05-26T10:41:14+0000",
                    "end_time": "2019-05-26T12:51:14+0000"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ScheduledTasksRsp": {
      "type": "object",
      "properties": {
        "total_count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "记录数量"
        },
        "schedules": {
          "items": {
            "properties": {
              "job_id": {
                "type": "string",
                "example": "3861199d-c196-4791-bcd0-b45fde754f50",
                "description": "任务ID。"
              },
              "job_name": {
                "type": "string",
                "example": "RESIZE_FLAVOR",
                "description": "任务名称。对应取值如下:\n\n \"RESIZE_FLAVOR\":变更实例的CPU和内存规格"
              },
              "job_status": {
                "type": "string",
                "example": "Pending",
                "description": "任务执行状态。 取值:\n\n值为\"Running\",表示任务正在执行。\n\n值为\"Completed\",表示任务执行成功。\n\n值为\"Failed\",表示任务执行失败。\n\n值为\"Pending\",表示任务未执行。"
              },
              "instance_id": {
                "type": "string",
                "example": "a2b33e2077ee41e397e57cd2f022b72fin02",
                "description": "实例ID。"
              },
              "instance_name": {
                "type": "string",
                "example": "dds-zzx-recover",
                "description": "实例名称。"
              },
              "instance_status": {
                "type": "string",
                "example": "normal",
                "description": "实例状态。 取值:\n\n值为“createfail”,表示实例创建失败。\n\n值为“creating”,表示实例创建中。\n\n值为“normal”,表示实例正常。\n\n值为“abnormal”,表示实例异常。\n\n值为“deleted”,表示实例已删除。"
              },
              "create_time": {
                "type": "string",
                "example": "2019-05-26T10:41:14+0000",
                "description": "任务创建时间,格式为\"yyyy-mm-ddThh:mm:ssZ\"。 其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
              },
              "start_time": {
                "type": "string",
                "example": "2019-05-26T10:41:14+0000",
                "description": "任务开始时间,格式为\"yyyy-mm-ddThh:mm:ssZ\"。 其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
              },
              "end_time": {
                "type": "string",
                "example": "2019-05-26T12:51:14+0000",
                "description": "任务结束时间,格式为\"yyyy-mm-ddThh:mm:ssZ\"。 其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
              }
            }
          },
          "description": "任务详情",
          "type": "array"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
