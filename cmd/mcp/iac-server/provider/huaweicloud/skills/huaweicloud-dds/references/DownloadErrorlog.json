{
  "name": "DownloadErrorlog",
  "summary": "获取错误日志下载链接",
  "tags": "获取日志信息",
  "productshort": "DDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/errorlog-download": {
      "post": {
        "tags": [
          "获取日志信息"
        ],
        "operationId": "DownloadErrorlog",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-open-region-cloud": "hc,hk",
        "summary": "获取错误日志下载链接",
        "description": "获取错误日志下载链接。",
        "x-constraint": "- 错误日志下载链接在更新时间后 15分钟内有效。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID,可以调用“查询实例列表和详情”接口获取。如果未申请实例,可以调用“创建实例”接口创建。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein02"
          },
          {
            "name": "DownloadErrorlogRequestBody:",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DownloadErrorlogRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/DownloadErrorResponse"
            },
            "examples": {
              "application/json": {
                "list": [
                  {
                    "node_name": "node_1",
                    "file_name": "054bc9c1f680d55c1f36c006e5a9f67b_errorlog_download_20200515080614589",
                    "status": "SUCCESS",
                    "file_size": "0",
                    "file_link": "https://rdsbucket.opxxx.svc.rds.xxxxx.cnxianhz1.ur.obs.cn-xianhz-1.myhuaweicloud.com:443/054bc9c1f680d55c1f36c006e5a9f67b_errorlog_download_20200515080614589?AWSAccessKeyId=1BQ38TBCQHAVQXBUMUTC&Expires=1589530200&response-cache-control=no-cache%2Cno-store&Signature=Fgi4%2BLOJ9frAXyOkz5hRoW5O%2BUM%3D",
                    "update_at": 1589529991385
                  }
                ],
                "status": "FINISH",
                "count": 1
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "DownloadErrorlogRequestBody": {
      "properties": {
        "file_name_list": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "- 需要下载的文件的文件名列表。"
        },
        "node_id_list": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "节点ID列表,取空值,表示查询实例下所有允许查询的节点。使用请参考《DDS API参考》的“查询实例列表和详情”响应消息表“nodes 数据结构说明”的“id”。允许查询的节点如下:\n- 集群下面的mongos、shard、config节点\n- 副本集、单节点下面的所有节点"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "DownloadErrorResponse": {
      "required": [
        "list",
        "status",
        "count"
      ],
      "properties": {
        "list": {
          "description": "具体信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/DownloadSlowlogResult"
          }
        },
        "status": {
          "description": "错误日志下载链接生成状态。\n- FINISH,表示下载链接已经生成完成。\n- CREATING,表示正在生成文件,准备下载链接。\n- FAILED,表示存在日志文件准备失败。",
          "type": "string"
        },
        "count": {
          "description": "错误日志链接数量。",
          "type": "integer"
        }
      }
    },
    "DownloadSlowlogResult": {
      "required": [
        "node_name",
        "file_name",
        "status",
        "file_size",
        "file_link",
        "update_at"
      ],
      "properties": {
        "node_name": {
          "type": "string",
          "description": "节点名称。",
          "example": "Test_replica_node_2"
        },
        "file_name": {
          "type": "string",
          "description": "生成的下载文件名。",
          "example": "testDb"
        },
        "status": {
          "type": "string",
          "description": "当前链接的生成状态。\n- SUCCESS,表示下载链接已经生成完成。\n- EXPORTING,表示正在生成文件,准备下载链接。\n- FAILED,表示存在日志文件准备失败。",
          "example": "SUCCESS"
        },
        "file_size": {
          "type": "string",
          "description": "文件大小,单位为 KB。",
          "example": "10"
        },
        "file_link": {
          "type": "string",
          "description": "下载链接。注意:下载链接在更新时间的 15分钟内有效,超出时间会重新获取。",
          "example": "https://rdsbucket.opxxx.svc.rds.xxxxx.cnxianhz1.ur.obs.cn-xianhz-1.myhuaweicloud.com:443/054bc9c1f680d55c1f36c006e5a9f67b_slowlog_download_20200515080614589?AWSAccessKeyId=1BQ38TBCQHAVQXBUMUTC&Expires=1589530200&response-cache-control=no-cache%2Cno-store&Signature=Fgi4%2BLOJ9frAXyOkz5hRoW5O%2BUM%3D"
        },
        "update_at": {
          "type": "integer",
          "format": "int64",
          "description": "更新时间。",
          "example": 1589529991385
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}