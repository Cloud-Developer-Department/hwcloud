    "NodeItem": {
      "description": "实例节点信息。",
      "required": [
        "id",
        "name",
        "status",
        "role",
        "private_ip",
        "public_ip",
        "spec_code",
        "availability_zone"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "节点ID。",
          "example": "5b0fda418d9f4b51b0d188732aaf992fno01"
        },
        "name": {
          "type": "string",
          "description": "节点名称。",
          "example": "mysql_node1"
        },
        "status": {
          "type": "string",
          "description": "节点状态。",
          "example": "normal"
        },
        "role": {
          "type": "string",
          "description": "节点角色。\n取值:\n- master,mongos节点返回该值。\n- Primary,shard组主节点、config组主节点、副本集主节点、单节点返回该值。\n- Secondary,shard组备节点、config组备节点、副本集备节点返回该值。\n- Hidden,shard组隐藏节点、config组隐藏节点、副本集隐藏节点返回该值。\n- unknown,节点异常时返回该值。",
          "example": "master"
        },
        "private_ip": {
          "type": "string",
          "description": "节点内网IP。该参数仅针对集群实例的mongos节点、副本集实例、以及单节点实例有效,且在弹性云服务器创建成功后参数值存在,否则,值为\"\"。"
        },
        "public_ip": {
          "type": "string",
          "description": "绑定的外网IP。该参数值为\"\"。该参数仅针对集群实例的mongos节点、副本集实例的主节点和备节点、以及单节点实例有效。"
        },
        "spec_code": {
          "type": "string",
          "description": "资源规格编码。"
        },
        "availability_zone": {
          "type": "string",
          "description": "可用区。",
          "example": "az1"
        },
        "nat_gateway_id": {
          "type": "string",
          "description": "**参数解释:**\n公网NAT网关实例的ID。可以调用“查询公网NAT网关列表”接口获取。\n**取值范围:**\n不涉及。",
          "example": "cda3a125-2406-456c-a11f-598e10578541"
        },
        "external_service_port": {
          "type": "integer",
          "description": "**参数解释:**\n弹性公网IP对外提供服务的端口号。\n**取值范围:**\n1~65535。",
          "example": 8635
        }
      }
    },
    "DatastoreItem": {
      "required": [
        "type",
        "version",
        "patch_available",
        "whole_version"
      ],
      "description": "数据库信息。",
      "properties": {
        "type": {
          "type": "string",
          "description": "数据库引擎。"
        },
        "version": {
          "type": "string",
          "description": "数据库版本号。"
        },
        "patch_available": {
          "type": "boolean",
          "description": "是否有补丁版本的数据库支持升级,返回true时可以通过升级补丁接口进行数据库升级,否则不允许升级补丁。"
        },
        "whole_version": {
          "type": "string",
          "description": "数据库的完整版本号。"
        }
      }
    },
    "GroupResponseItem": {
      "description": "实例组信息。",
      "required": [
        "type",
        "id",
        "name",
        "status",
        "volume",
        "nodes"
      ],
      "properties": {
