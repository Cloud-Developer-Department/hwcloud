{
  "name": "ListInstances",
  "summary": "查询实例列表和详情",
  "tags": "实例管理",
  "productshort": "DDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances": {
      "get": {
        "tags": [
          "实例管理"
        ],
        "operationId": "ListInstances",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-open-region-cloud": "hc,hk",
        "summary": "查询实例列表和详情",
        "description": "根据指定条件查询实例列表和详情。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "id",
            "in": "query",
            "description": "实例ID,可以调用“查询实例列表和详情”接口获取。如果未申请实例,可以调用“创建实例”接口创建。",
            "type": "string"
          },
          {
            "name": "name",
            "in": "query",
            "description": "实例名称。\n如果name以“*”起始,表示按照“*”后面的值模糊匹配,否则,按照实际填写的name精确匹配查询。\n- “*”为系统保留字符,不能只传入该字符。",
            "type": "string"
          },
          {
            "name": "mode",
            "in": "query",
            "description": "实例类型。\n- 取值为“Sharding”,表示集群实例。\n- 取值为“ReplicaSet”,表示副本集实例。\n- 取值为“Single”,表示单节点实例。",
            "type": "string",
            "enum": [
              "Sharding",
              "ReplicaSet",
              "Single"
            ]
          },
          {
            "name": "datastore_type",
            "in": "query",
            "description": "数据库版本类型。取值为“DDS-Community”。",
            "type": "string",
            "enum": [
              "DDS-Community",
              "DDS-Enhanced"
            ]
          },
          {
            "name": "vpc_id",
            "in": "query",
            "description": "虚拟私有云ID。可登录虚拟私有云控制台界面,获取DDS实例所在虚拟私有云的ID。",
            "type": "string"
          },
          {
            "name": "subnet_id",
            "in": "query",
            "description": "子网的网络ID。可登录虚拟私有云控制台界面,获取DDS实例所在虚拟私有云下子网的网络ID。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "索引位置偏移量,表示从指定project ID下最新的实例创建时间开始,按时间的先后顺序偏移offset条数据后查询对应的实例信息。\n取值大于或等于0。不传该参数时,查询偏移量默认为0,表示从最新的实例创建时间对应的实例开始查询。",
            "type": "integer"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询实例个数上限值。\n取值范围:1~100。不传该参数时,默认查询前100条实例信息。",
            "type": "integer"
          },
          {
            "name": "tags",
            "in": "query",
            "description": "根据实例标签键值对进行查询。{key}表示标签键,{value}表示标签值,最多包含20组。key不可以为空或重复,value可以为空。如果同时使用多个标签键值对进行查询,中间使用逗号分隔开,表示查询同时包含指定标签键值对的实例。",
            "type": "string",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ListInstancesResponseBody"
            },
