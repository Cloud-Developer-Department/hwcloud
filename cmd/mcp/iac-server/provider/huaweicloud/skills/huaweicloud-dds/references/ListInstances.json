        },
        "name": {
          "type": "string",
          "description": "组名称。节点类型为shard和config时,该参数有效。",
          "example": "mysql_node1"
        },
        "status": {
          "type": "string",
          "description": "组状态。节点类型为shard和config时,该参数有效。"
        },
        "volume": {
          "description": "volume信息。节点类型为shard、config、replica、single时,该参数有效。",
          "$ref": "#/definitions/Volume"
        },
        "nodes": {
          "description": "节点信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/NodeItem"
          }
        }
      }
    },
