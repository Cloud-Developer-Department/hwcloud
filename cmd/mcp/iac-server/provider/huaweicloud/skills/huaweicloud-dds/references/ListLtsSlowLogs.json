{
  "name": "ListLtsSlowLogs",
  "summary": "查询数据库慢日志",
  "tags": "获取日志信息",
  "productshort": "DDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3.1/{project_id}/instances/{instance_id}/slow-logs": {
      "post": {
        "tags": [
          "获取日志信息"
        ],
        "operationId": "ListLtsSlowLogs",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-open-region-cloud": "hc,hk",
        "summary": "查询数据库慢日志",
        "description": "查询数据库慢日志信息,支持关键字、数据库表名等搜索功能。",
        "x-constraint": "- 如果原始日志中本身包含关键字(&&、||、AND、OR、NOT、*、?、:、>、<、=、>=、<=),则不支持使用这些关键字来搜索日志。\n- 每页查询最大限制100条。\n- 慢日志最多保存30天。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n从IAM服务获取的用户Token。请参考“认证鉴权”。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n租户在某一Region下的项目ID。请参考“获取项目ID”章节获取项目编号。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "**参数解释:**\n实例ID,可以调用“查询实例列表和详情-QueryingInstancesandDetails”接口获取。如果未申请实例,可以调用“创建实例-CreatingaDBInstance”接口创建。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "91f020b75c1c4bdd8d83933033ff9308in02"
          },
          {
            "name": "ListLtsSlowLogsRequestBody:",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListLtsSlowLogsRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ListLtsSlowLogsResponseBody"
            },
            "examples": {
              "application/json": {
                "slow_logs": [
                  {
                    "node_name": "Test_replica_node_2",
                    "node_id": "dbd0b65ed0c34125a0b04d4e5ba67e66no02",
                    "whole_message": "{\"responseLength\": 230, \"ts\": {\"$date\": 1605480486800}, \"ninserted\": 1, \"locks\": {\"oplog\": {\"acquireCount\": {\"w\": 1}}, \"Global\": {\"acquireCount\": {\"r\": 3, \"w\": 2}}, \"Collection\": {\"acquireCount\": {\"w\": 2}}, \"Database\": {\"acquireCount\": {\"w\": 3}}}, \"numYield\": 0, \"ns\": \"geographySpace.tiles\"}",
                    "operate_type": "query",
                    "cost_time": 60,
                    "lock_time": 10,
                    "docs_returned": 0,
                    "docs_scanned": 0,
                    "database": "testDb",
                    "collection": "testCollection",
                    "log_time": "2022-09-15T22:49:38.643000Z",
                    "line_num": "1595659490239433659"
                  }
                ]
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "POST https://{endpoint}/v3.1/0483b6b16e954cb88930a360d2c4e663/instances/6ade8143870047b8999aba8f1891b48ein02/slow-logs",
        "x-request-examples-1": {
          "start_time": "2022-09-06T10:41:14+0800",
          "end_time": "2022-09-16T10:41:14+0800",
          "limit": 100,
          "line_num": "1595659490239433658",
          "operate_type": "query",
          "node_id": "dbd0b65ed0c34125a0b04d4e5ba67e66no02",
          "keywords": [
            "log",
            "test"
          ],
          "database_keywords": [
            "testDB"
          ],
          "collection_keywords": [
            "testCollection"
          ],
          "max_cost_time": 100,
          "min_cost_time": 50
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "ListLtsSlowLogsResponseBody": {
      "required": [
        "slow_logs"
      ],
      "properties": {
        "slow_logs": {
          "description": "慢日志具体信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SlowLogDetail"
          }
        }
      }
    },
    "SlowLogDetail": {
      "required": [
        "node_name",
        "node_id",
        "whole_message",
        "operate_type",
        "cost_time",
        "lock_time",
        "docs_returned",
        "docs_scanned",
        "database",
        "collection",
        "log_time",
        "line_num"
      ],
      "properties": {
        "node_name": {
          "type": "string",
          "description": "节点名称。",
          "example": "Test_replica_node_2"
        },
        "node_id": {
          "type": "string",
          "description": "节点ID。",
          "example": "dbd0b65ed0c34125a0b04d4e5ba67e66no02"
        },
        "whole_message": {
          "type": "string",
          "description": "执行语句。",
          "example": "testDb"
        },
        "operate_type": {
          "type": "string",
          "description": "语句类型。",
          "example": "query"
        },
        "cost_time": {
          "type": "integer",
          "description": "执行时间。单位:ms",
          "example": 60
        },
        "lock_time": {
          "type": "integer",
          "description": "等待锁时间。单位:us",
          "example": 10
        },
        "docs_returned": {
          "type": "integer",
          "description": "返回的文档数。",
          "example": 0
        },
        "docs_scanned": {
          "type": "integer",
          "description": "扫描的文档数。",
          "example": 0
        },
        "database": {
          "type": "string",
          "description": "日志所属的数据库库名。",
          "example": "geography"
        },
        "collection": {
          "type": "string",
          "description": "日志所属的数据库表名。",
          "example": "testDb"
        },
        "log_time": {
          "type": "string",
          "description": "日志产生时间,UTC时间。\n格式为“yyyy-mm-ddThh:mm:ssZ”。 其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。",
          "example": "2020-11-15T22:49:38.643000Z"
        },
        "line_num": {
          "type": "string",
          "description": "日志单行序列号",
          "example": "1595659490239433658"
        }
      }
    },
    "ListLtsSlowLogsRequestBody": {
      "required": [
        "start_time",
        "end_time",
        "limit"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "description": "开始时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。\n**注意:**\n开始时间不得早于当前时间30天。"
        },
        "end_time": {
          "type": "string",
          "description": "结束时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。\n**说明:**\n结束时间不能晚于当前时间。"
        },
        "limit": {
          "type": "integer",
          "description": "表示每次查询的日志条数,最大限制100条。"
        },
        "line_num": {
          "type": "string",
          "description": "日志单行序列号,第一次查询时不需要此参数,下一次查询时需要使用,可从上一次查询的返回信息中获取。\n说明:当次查询从line_num的下一条日志开始查询,不包含当前line_num日志。"
        },
        "operate_type": {
          "type": "string",
          "description": "语句类型,取空值,表示查询所有语句类型。",
          "enum": [
            "insert",
            "query",
            "update",
            "remove",
            "getmore",
            "command",
            "killcursors"
          ]
        },
        "node_id": {
          "type": "string",
          "description": "节点ID,取空值,表示查询实例下所有允许查询的节点。\n使用请参考《DDS API参考》的“查询实例列表和详情”响应消息表“nodes 数据结构说明”的“id”。\n允许查询的节点如下:\n- 集群实例下面的 shard节点\n- 副本集、单节点实例下面的所有节点"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "根据多个关键字搜索日志全文,表示同时匹配所有关键字。\n- 只支持关键字前缀模糊搜索,最多支持10个关键字。\n- 每个关键字最大长度不超过512个字符。"
        },
        "database_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "根据多个数据库表名关键字模糊搜索日志,表示匹配至少一个关键字。\n- 只支持关键字前缀模糊搜索,最多支持10个关键字。\n- 每个关键字最大长度不超过64个字符。"
        },
        "collection_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "根据多个数据库表名关键字模糊搜索日志,表示匹配至少一个关键字。\n- 只支持关键字前缀模糊搜索,最多支持10个关键字。\n- 每个关键字最大长度不超过128个字符。"
        },
        "max_cost_time": {
          "type": "integer",
          "description": "支持根据最大执行时间范围查找日志。\n单位:ms"
        },
        "min_cost_time": {
          "type": "integer",
          "description": "支持根据最小执行时间范围查找日志。\n单位:ms"
        }
      }
    }
  },
