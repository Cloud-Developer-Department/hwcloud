  "definitions": {
    "ResizeInstanceVolumeRequestBody": {
      "required": [
        "volume"
      ],
      "properties": {
        "volume": {
          "description": "volume请求详细信息。",
          "$ref": "#/definitions/ResizeInstanceVolumeOption"
        },
        "is_auto_pay": {
          "type": "boolean",
          "description": "扩容包年包月实例的存储容量时可指定,表示是否自动从账户中支付,此字段不影响自动续订的支付方式。\n- true,表示自动从账户中支付。\n- false,表示手动从账户中支付,默认为该方式。"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "ResizeInstanceVolumeOption": {
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "type": "string",
          "description": "待扩容到的磁盘容量。取值为10的整数倍,并且大于当前磁盘容量。\n- 对于集群实例,表示扩容到的单个shard组的磁盘容量。取值范围:10GB~2000GB。\n- 对于副本集实例,表示扩容到的实例的磁盘容量,取值范围:10GB~2000GB。\n- 对于单节点实例,表示扩容到的实例的磁盘容量,取值范围:10GB~1000GB。"
        },
        "group_id": {
          "type": "string",
          "description": "角色组ID。\n- 对于集群实例,该参数为shard组ID。\n- 对于副本集和单节点实例,不传该参数。"
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "副本集只读节点磁盘扩容时,需要传入该参数,当前list只支持传入一个元素。"
        }
      }
    },
    "ResizeInstanceVolumeResponseBody": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "工作流ID。",
          "example": "6ad4eb1f-73bd-4876-aa31-aa9a1e41c4bc"
        },
        "order_id": {
          "type": "string",
          "description": "订单ID,仅扩容包年包月实例的存储容量时返回该参数。",
          "example": "CS20070721568OVO9"
        }
      }
    }
  },
