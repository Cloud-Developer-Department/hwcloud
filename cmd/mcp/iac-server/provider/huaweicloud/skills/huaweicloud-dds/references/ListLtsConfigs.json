{
  "name": "ListLtsConfigs",
  "summary": "查询LTS日志配置信息",
  "tags": "实例管理",
  "productshort": "DDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/logs/lts-configs": {
      "get": {
        "tags": [
          "实例管理"
        ],
        "operationId": "ListLtsConfigs",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-open-region-cloud": "hc,hk",
        "x-apigateway-ratelimit": "dds_default_policy",
        "summary": "查询LTS日志配置信息",
        "description": "查询LTS日志配置信息。",
        "x-constraint": "当前只支持审计日志。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。请参考[获取项目ID](https://support.huaweicloud.com/api-dds/dds_projectid.html)章节获取项目编号。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0(偏移0条数据,表示从第一条数据开始查询),必须为数字,不能为负数。",
            "required": false,
            "type": "integer",
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询记录数。取值范围:0~50。不传该参数时,默认查询前50条实例的云服务日志配置信息。",
            "required": false,
            "type": "integer",
            "x-example": 10
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ListLtsLogPolicyRespondBody"
            },
            "examples": {
              "application/json": {
                "total_count": 1,
                "instance_lts_configs": [
                  {
                    "instance": {
                      "id": "520c58ba00a3497e97ce0b9604874dd6in02",
                      "name": "dds-1f84",
                      "mode": "Single",
                      "datastore": {
                        "type": "mongodb",
                        "version": 4.0
                      },
                      "status": "normal",
                      "enterprise_project_id": "0",
                      "actions": [
                        "OPS_AUDIT_LOG"
                      ]
                    },
                    "lts_configs": [
                      {
                        "log_type": "audit_log",
                        "lts_group_id": "ec6dc499-1a63-4229-a0c2-a2afa8bcfc95",
                        "lts_stream_id": "cae69d2e-378b-41dd-b3c9-3ca1cd5335bc",
                        "enabled": true
                      }
                    ]
                  }
                ]
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "获取前10个实例的LTS配置",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/619d3e78f61b4be68bc5aa0b59edcf7b/instances/logs/lts-configs?offset=0&limit=10"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "ListLtsLogPolicyRespondBody": {
      "required": [
        "instance_lts_configs",
        "total_count"
      ],
      "properties": {
        "instance_lts_configs": {
          "type": "array",
          "description": "每个实例的LTS日志配置信息和实例简要信息。",
          "items": {
            "type": "object",
            "description": "LTS日志配置信息只会出现已经配置过的日志类型。",
            "properties": {
              "instance": {
                "type": "object",
                "description": "实例的简要信息。",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "实例ID。",
                    "example": "520c58ba00a3497e97ce0b9604874dd6in02"
                  },
                  "name": {
                    "type": "string",
                    "description": "实例名字。",
                    "example": "dds-1f84"
                  },
                  "mode": {
                    "type": "string",
                    "description": "实例类型,对应单节点,副本集,集群三种。",
                    "enum": [
                      "Single",
                      "Replica",
                      "Sharding"
                    ]
                  },
                  "datastore": {
                    "type": "object",
                    "description": "实例的数据库引擎和版本。",
                    "properties": {
                      "type": {
                        "type": "string",
                        "description": "数据库引擎,值为mongodb。",
                        "enum": [
                          "mongodb"
                        ]
                      },
                      "version": {
                        "type": "string",
                        "description": "数据库大版本。",
                        "example": "4.0"
                      }
                    }
                  },
                  "status": {
                    "type": "string",
                    "description": "实例状态。",
                    "example": "normal"
                  },
                  "enterprise_project_id": {
                    "type": "string",
                    "description": "实例归属的企业项目ID,如果是default企业项目,值为0,如果是其他企业项目,请参考企业项目相关内容。",
                    "example": "0"
                  },
                  "actions": {
                    "type": "array",
                    "description": "实例所有正在执行的动作。",
                    "items": {
                      "type": "string",
                      "description": "实例正在执行的动作。",
                      "example": "OPS_AUDIT_LOG"
                    }
                  }
                }
              },
              "lts_configs": {
                "type": "array",
                "description": "LTS日志配置明细。从未设置LTS日志流,不返回该字段。",
                "items": {
                  "type": "object",
                  "properties": {
                    "log_type": {
                      "$ref": "#/definitions/LtsLogType"
                    },
                    "lts_group_id": {
                      "type": "string",
                      "description": "云日志服务LTS日志组ID。",
                      "example": "ec6dc499-1a63-4229-a0c2-a2afa8bcfc95"
                    },
                    "lts_stream_id": {
                      "type": "string",
                      "description": "云日志服务LTS日志流ID。",
                      "example": "cae69d2e-378b-41dd-b3c9-3ca1cd5335bc"
                    },
                    "enabled": {
                      "type": "boolean",
                      "description": "是否上传。"
                    }
                  }
                }
              }
            }
          }
        },
        "total_count": {
          "type": "integer",
          "description": "全部可查询的云服务日志配置结果个数,等于所有DDS实例的个数。",
          "example": 1
        }
      }
    },
    "LtsLogType": {
      "type": "string",
      "description": "LTS日志类型,不能为空,具有以下日志类型。\n- audit_log",
      "example": "audit_log",
      "enum": [
        "audit_log"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}