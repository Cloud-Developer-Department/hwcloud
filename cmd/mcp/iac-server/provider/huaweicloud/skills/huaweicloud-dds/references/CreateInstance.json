  "definitions": {
    "Datastore": {
      "required": [
        "type",
        "version",
        "storage_engine"
      ],
      "description": "数据库信息。",
      "properties": {
        "type": {
          "type": "string",
          "description": "数据库版本类型。取值“DDS-Community”。",
          "enum": [
            "DDS-Community"
          ]
        },
        "version": {
          "type": "string",
          "description": "数据库版本。支持3.4及以上版本。取值为“3.4”、“4.0”、“4.2”、“4.4”、“5.0”。"
        },
        "storage_engine": {
          "type": "string",
          "description": "存储引擎。支持WiredTiger存储引擎。取值为“wiredTiger”。",
          "enum": [
            "wiredTiger",
            "rocksDB"
          ]
        }
      }
    },
    "CreateInstanceFlavorOption": {
      "required": [
        "type",
        "num",
        "spec_code"
      ],
      "description": "实例规格详情。",
      "properties": {
        "type": {
          "type": "string",
          "description": "节点类型。\n取值:\n  - 集群实例包含mongos、shard和config节点,各节点下该参数取值分别为“mongos”、“shard”和“config”。\n  - 副本集实例下该参数取值为“replica”。\n  - 单节点实例下该参数取值为“single”。",
          "enum": [
            "mongos",
            "shard",
            "config",
            "replica",
            "single"
          ]
        },
        "num": {
          "type": "string",
          "description": "节点数量。\n取值:\n  - 集群实例下“mongos”类型的节点数量可取2~16。\n  - 集群实例下“shard”类型的组数量可取2~16。\n  - “shard”类型的组数量可取2~16。\n  - “config”类型的组数量只能取1。\n  - “replica”类型的组数量可取3,5,7。\n  - “single”类型的节点数量只能取1。"
        },
        "storage": {
          "type": "string",
          "description": "磁盘类型。\n取值:ULTRAHIGH,表示SSD。\n  - 对于集群实例的shard和config节点、副本集、以及单节点实例,该参数有效。mongos节点不涉及选择磁盘,该参数无意义。"
        },
        "size": {
          "type": "string",
          "description": "磁盘大小。\n取值:必须为10的整数倍。单位为GB。\n  - 对于集群实例,shard组可取10GB~2000GB,config组仅可取20GB。mongos节点不涉及选择磁盘,该参数无意义。\n  - 对于副本集实例,可取10GB~2000GB。\n  - 对于单节点实例,可取10GB~1000GB。"
        },
        "spec_code": {
          "type": "string",
          "description": "资源规格编码"
        }
      }
    },
    "CreateInstanceConfigurationsOption": {
      "required": [
        "type",
        "configuration_id"
      ],
      "description": "参数组配置信息。",
      "properties": {
        "type": {
          "type": "string",
          "description": "节点类型。\n取值:\n  - 集群实例包含mongos、shard和config节点,各节点下该参数取值分别为“mongos”、“shard”和“config”。\n  - 副本集实例下该参数取值为“replica”。\n  - 单节点实例下该参数取值为“single”。",
          "enum": [
            "mongos",
            "shard",
            "config",
            "replica",
            "single"
          ]
        },
        "configuration_id": {
          "type": "string",
          "description": "参数组id。"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "CreateInstanceResponseBody": {
      "properties": {
        "id": {
          "type": "string",
          "description": "实例ID。"
        },
        "datastore": {
          "description": "数据库信息,与请求参数相同。",
          "$ref": "#/definitions/Datastore"
        },
        "name": {
          "type": "string",
          "description": "实例名称,与请求参数相同。"
        },
        "created": {
          "type": "string",
          "description": "创建时间为本地时间,格式为“yyyy-mm-dd hh:mm:ss”。"
        },
        "status": {
          "type": "string",
          "description": "实例状态,取值为“creating”。"
        },
        "region": {
          "type": "string",
          "description": "区域ID,与请求参数相同。"
        },
        "availability_zone": {
          "type": "string",
          "description": "可用区ID,与请求参数相同。",
          "example": "az1"
        },
        "vpc_id": {
          "type": "string",
          "description": "虚拟私有云ID,与请求参数相同。"
        },
        "subnet_id": {
          "type": "string",
          "description": "子网ID,与请求参数相同。"
        },
        "security_group_id": {
          "type": "string",
          "description": "实例所属的安全组ID,与请求参数相同。"
        },
        "port": {
          "type": "integer",
          "format": "int64",
          "description": "数据库访问端口。"
        },
        "disk_encryption_id": {
          "type": "string",
          "description": "磁盘加密的密钥ID,与请求参数相同。"
        },
        "mode": {
          "type": "string",
          "description": "实例类型,与请求参数相同。"
        },
        "configurations": {
          "type": "array",
          "description": "参数组配置信息。",
          "items": {
            "$ref": "#/definitions/CreateInstanceConfigurationsOption"
          }
        },
        "flavor": {
          "type": "array",
          "description": "实例规格详情,与请求参数相同。",
          "items": {
            "$ref": "#/definitions/CreateInstanceFlavorOption"
          }
        },
        "backup_strategy": {
          "description": "高级备份策略,与请求参数相同。",
          "$ref": "#/definitions/BackupStrategy"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。取值为“0”,表示为default企业项目。"
        },
        "ssl_option": {
          "type": "string",
          "description": "SSL开关选项,与请求参数相同。"
        },
        "dss_pool_id": {
          "type": "string",
          "description": "专属存储池ID。"
        },
        "job_id": {
          "type": "string",
          "description": "创建实例的工作流ID。"
        },
        "tags": {
          "type": "array",
          "description": "标签列表,与请求参数相同。",
          "items": {
            "$ref": "#/definitions/TagWithKeyValue"
          }
        },
        "order_id": {
          "type": "string",
          "description": "创建实例的订单ID,仅创建包年包月实例时返回该参数。"
        },
        "charge_info": {
          "$ref": "#/definitions/ChargeInfoResult"
        }
      }
    },
    "ChargeInfoResult": {
      "description": "付费方式信息,与请求参数相同。",
      "properties": {
        "charge_mode": {
          "type": "string",
          "description": "计费模式。\n取值范围:\n  - prePaid:预付费,即包年/包月。\n  - postPaid:后付费,即按需付费。",
          "example": "prePaid"
        },
        "period_type": {
          "type": "string",
          "description": "订购周期类型。\n“charge_mode”为“prePaid”时生效,且为必选值。\n取值范围:\n  - month:包月。\n  - year:包年。",
          "example": "month"
        },
        "period_num": {
          "type": "integer",
          "description": "“charge_mode”为“prePaid”时生效,且为必选值,指定订购的时间。\n取值范围:\n  - 当“period_type”为“month”时,取值为1~9。\n  - 当“period_type”为“year”时,取值为1~3",
          "example": 1
        },
        "is_auto_renew": {
          "type": "boolean",
          "description": "创建包周期实例时可指定,表示是否自动续订,续订的周期和原周期相同,且续订时会自动支付。\n取值范围:\n  - true,表示自动续订。\n  - false,表示不自动续订,默认为该方式。",
          "example": true
        },
        "is_auto_pay": {
          "type": "boolean",
          "description": "创建包周期实例时可指定,表示是否自动从账户中支付,该字段不影响自动续订的支付方式。\n取值范围:\n  - true,表示自动从账户中支付\n  - false,表示手动从账户中支付,默认为该支付方式。",
          "example": false
        }
      }
    },
    "CreateInstanceRequestBody": {
      "description": "实例信息。",
      "required": [
        "name",
        "datastore",
        "region",
        "availability_zone",
        "vpc_id",
        "subnet_id",
        "security_group_id",
        "mode",
        "flavor"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "实例名称。用于表示实例的名称,用于表示实例的名称,允许和已有名称重复。\n取值范围:长度为4~64位,必须以字母开头(A~Z或a~z),区分大小写,可以包含字母、数字(0~9)、中划线(-)或者下划线(_),不能包含其他特殊字符。"
        },
        "datastore": {
          "$ref": "#/definitions/Datastore",
          "description": "数据库信息。"
        },
        "region": {
          "type": "string",
          "description": "- 区域ID\n- 取值:非空。"
        },
        "availability_zone": {
          "type": "string",
          "description": "可用区ID。非专属云用户可以选择多个AZ,创建跨AZ的集群。专属云用户暂不支持创建跨AZ的集群。取值:非空,请参见[地区和终端节点](https://developer.huaweicloud.com/endpoint)。",
          "example": "az1"
        },
        "vpc_id": {
          "type": "string",
          "description": "虚拟私有云ID。获取方法请参见《虚拟私有云API参考》中“VPC”的内容。\n取值:非空,字符长度校验,严格UUID正则校验。"
        },
        "subnet_id": {
          "type": "string",
          "description": "子网ID。获取方法请参见《虚拟私有云API参考》中“子网”的内容。"
        },
        "security_group_id": {
          "type": "string",
          "description": "指定实例所属的安全组ID。\n获取方法请参见《虚拟私有云API参考》中“安全组”的内容。"
        },
        "port": {
          "type": "string",
          "description": "数据库访问端口。\n取值范围:2100~9500,以及27017、27018、27019。\n不传该参数时,创建实例的访问端口默认为8635。"
        },
        "password": {
          "type": "string",
          "description": "数据库密码。\n取值范围:长度为8~32位,必须是大写字母(A~Z)、小写字母(a~z)、数字(0~9)、特殊字符~!@#%^*-_=+?的组合。\n建议您输入高强度密码,以提高安全性,防止出现密码被暴力破解等安全风险。"
        },
        "disk_encryption_id": {
          "type": "string",
          "description": "磁盘加密时的密钥ID,严格UUID正则校验。\n不传该参数时,表示不进行磁盘加密。"
        },
        "mode": {
          "type": "string",
          "description": "实例类型。支持集群、副本集、以及单节点。\n取值\n  - Sharding\n  - ReplicaSet\n  - Single"
        },
        "configurations": {
          "type": "array",
          "description": "参数组配置信息。",
          "items": {
            "$ref": "#/definitions/CreateInstanceConfigurationsOption"
          }
        },
        "flavor": {
          "type": "array",
          "description": "实例规格详情。",
          "items": {
            "$ref": "#/definitions/CreateInstanceFlavorOption"
          }
        },
        "backup_strategy": {
          "$ref": "#/definitions/BackupStrategy"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。"
        },
        "ssl_option": {
          "type": "string",
          "description": "SSL开关选项。\n取值:\n- 取“0”,表示DDS实例默认不启用SSL连接。\n- 取“1”,表示DDS实例默认启用SSL连接。\n- 不传该参数时,默认启用SSL连接。"
        },
        "dss_pool_id": {
          "type": "string",
          "description": "Dec用户专属存储ID,默认为空。仅Dec用户支持该参数。",
          "example": "f5f84ed7-6f19-4bd4-99d7-b450ad6cc4df"
        },
        "server_group_policies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "创建新实例设置云服务器组关联的策略名称列表,仅专属云创建实例时有效。\n取值\n   - 取“anti-affinity”,表示DDS实例开启反亲和部署,反亲和部署是出于高可用性考虑,将您的Primary、Secondary和Hidden节点分别创建在不同的物理机上。当前仅支持该值,不传该值默认不开启反亲和部署。",
          "example": [
            "anti-affinity"
          ]
        },
        "tags": {
          "type": "array",
          "description": "标签列表。单个实例总标签数上限20个。",
          "items": {
            "$ref": "#/definitions/TagWithKeyValue"
          }
        },
        "charge_info": {
          "$ref": "#/definitions/ChargeInfoOption"
        }
      }
    },
    "TagWithKeyValue": {
      "required": [
        "key",
        "value"
      ],
      "description": "键值对标签。",
      "properties": {
        "key": {
          "type": "string",
          "description": "标签键。最大长度36个unicode字符。\n\nkey不能为空,不能为空字符串,不能重复。字符集:A-Z,a-z ,\n0-9,‘-’,‘_’,UNICODE字符(\\一-\\鿿)。"
        },
        "value": {
          "type": "string",
          "description": "标签值。最大长度43个unicode字符。\n可以为空字符串。 字符集:A-Z,a-z , 0-9,‘.’,‘-’,‘_’,UNICODE字符(\\一-\\鿿)。"
        }
      }
    },
    "ChargeInfoOption": {
      "required": [
        "charge_mode"
      ],
      "description": "计费类型信息,支持包年包月和按需计费,默认为按需计费。",
      "properties": {
        "charge_mode": {
          "type": "string",
          "description": "计费模式。\n取值范围:\n  - prePaid:预付费,即包年/包月。\n  - postPaid:后付费,即按需付费。",
          "example": "prePaid"
        },
        "period_type": {
          "type": "string",
          "description": "订购周期类型。\n“charge_mode”为“prePaid”时生效,且为必选值。\n取值范围:\n  - month:包月。\n  - year:包年。",
          "example": "month"
        },
        "period_num": {
          "type": "integer",
          "description": "“charge_mode”为“prePaid”时生效,且为必选值,指定订购的时间。\n取值范围:\n  - 当“period_type”为“month”时,取值为1~9。\n  - 当“period_type”为“year”时,取值为1~3",
          "example": 1
        },
        "is_auto_renew": {
          "type": "boolean",
          "description": "创建包周期实例时可指定,表示是否自动续订,续订的周期和原周期相同,且续订时会自动支付。\n取值范围:\n  - true,表示自动续订。\n  - false,表示不自动续订,默认为该方式。",
          "example": true
        },
        "is_auto_pay": {
          "type": "boolean",
          "description": "创建包周期实例时可指定,表示是否自动从账户中支付,该字段不影响自动续订的支付方式。\n取值范围:\n  - true,表示自动从账户中支付\n  - false,表示手动从账户中支付,默认为该支付方式。",
          "example": false
        }
      }
    },
    "BackupStrategy": {
      "required": [
        "start_time"
      ],
      "description": "高级备份策略。",
      "properties": {
        "start_time": {
          "type": "string",
          "description": "备份时间段。自动备份将在该时间段内触发。\n取值范围:非空,格式必须为hh:mm-HH:MM且有效,当前时间指UTC时间。\n  - HH取值必须比hh大1。\n  - mm和MM取值必须相同,且取值必须为00、15、30或45。",
          "example": "23:00-00:00"
        },
        "keep_days": {
          "type": "string",
          "description": "指定已生成的备份文件可以保存的天数。\n取值范围:0~732。\n  - 取0值,表示不设置自动备份策略。\n  - 不传该参数,默认开启自动备份策略,备份文件默认保存7天。",
          "minimum": 0,
          "maximum": 732
        }
      }
    }
  },
