        "x-constraint": "创建中、已删除、冻结状态的实例不支持该操作。\n最大支持100条数据。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。请参考[获取项目ID](https://support.huaweicloud.com/api-dds/dds_projectid.html)章节获取项目编号。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "UpdateLtsConfigRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateLtsConfigRequestBody"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted."
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "为实例审计日志配置LTS服务",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/619d3e78f61b4be68bc5aa0b59edcf7b/instances/logs/lts-configs",
        "x-request-examples-1": {
          "lts_configs": [
            {
              "instance_id": "520c58ba00a3497e97ce0b9604874dd6in02",
              "log_type": "audit_log",
              "lts_group_id": "ec6dc499-1a63-4229-a0c2-a2afa8bcfc95",
              "lts_stream_id": "cae69d2e-378b-41dd-b3c9-3ca1cd5335bc"
            }
          ]
        }
      }
    }
