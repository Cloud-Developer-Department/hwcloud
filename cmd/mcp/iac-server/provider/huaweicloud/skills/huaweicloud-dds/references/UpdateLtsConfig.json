      "enum": [
        "audit_log"
      ]
    },
    "UpdateLtsConfigRequestBody": {
      "required": [
        "lts_configs"
      ],
      "properties": {
        "lts_configs": {
          "type": "array",
          "description": "每个Item是实例需要设置的LTS策略。",
          "items": {
            "type": "object",
