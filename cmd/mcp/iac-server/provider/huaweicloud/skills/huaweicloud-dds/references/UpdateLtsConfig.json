              "instance_id",
              "log_type",
              "lts_group_id",
              "lts_stream_id"
            ],
            "properties": {
              "instance_id": {
                "type": "string",
                "description": "实例ID,可以调用“[查询实例列表和详情](x-wc://file=zh-cn_topic_0000001369935045.xml)”接口获取。如果未申请实例,可以调用“[创建实例](x-wc://file=zh-cn_topic_0000001369734929.xml)”接口创建。",
                "example": "520c58ba00a3497e97ce0b9604874dd6in02"
              },
              "log_type": {
                "$ref": "#/definitions/LtsLogType"
              },
              "lts_group_id": {
                "type": "string",
                "description": "LTS日志组ID。可通过云日志服务-“查询账号下所有日志组”API接口获取。",
                "example": "ec6dc499-1a63-4229-a0c2-a2afa8bcfc95"
              },
              "lts_stream_id": {
                "type": "string",
                "description": "LTS日志流ID。可通过云日志服务-“查询指定日志组下的所有日志流”API接口获取。",
                "example": "cae69d2e-378b-41dd-b3c9-3ca1cd5335bc"
              }
            }
          }
        }
      }
    }
