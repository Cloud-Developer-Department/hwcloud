                  "type": "String"
                },
                {
                  "column_family_name": "cfname2",
                  "column_name": "VALUE",
                  "value": "datavalue2",
                  "type": "String"
                }
              ]
            }
          }
        },
        "x-request-examples-description-2": "添加CloudTable OpenTSDB转储任务",
        "x-request-examples-url-2": "POST https://{Endpoint}/v2/{project_id}/streams/{stream_name}/transfer-tasks",
        "x-request-examples-2": {
          "destination_type": "CLOUDTABLE",
          "cloudtable_destination_descriptor": {
            "task_name": "opentsdbtask",
            "consumer_strategy": "LATEST",
            "agency_name": "dis_admin_agency",
            "cloudtable_cluster_name": "cloudtablecluster",
            "cloudtable_cluster_id": "b8c095e2-db5f-4732-8a1d-eacd662e35dc",
            "retry_duration": 1800,
            "obs_backup_bucket_path": "obsbackupbucket",
            "backup_file_prefix": "",
            "opentsdb_schema": [
              {
                "metric": [
                  {
                    "type": "Constant",
                    "value": "age"
                  }
                ],
                "timestamp": {
                  "value": "date",
                  "type": "String",
                  "format": "yyyy/MM/dd HH:mm:ss"
                },
                "value": {
                  "value": "value",
                  "type": "Bigint"
                },
                "tags": [
                  {
                    "name": "name",
                    "value": "name",
                    "type": "Bigint"
                  }
                ]
              }
            ]
          }
        },
        "x-support-sdk": "N",
        "tags": [
          "转储任务管理"
        ],
        "description": "本接口用于添加CloudTable转储任务。",
        "operationId": "CreateCloudTableTransferTask",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "summary": "添加CloudTable转储任务",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
            "x-order": 2
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          },
          {
            "name": "stream_name",
            "in": "path",
            "x-example": "new-stream",
            "description": "已创建的通道名称。",
            "required": true,
            "type": "string",
            "maxLength": 60
          },
          {
            "name": "CreateCloudTableTransferTaskRequestBody",
            "in": "body",
            "description": "CreateCloudTableTransferTaskRequestBody",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateCloudTableTransferTaskReq"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "正常返回"
          }
        },
        "security": [
          {
            "aksk": []
          }
        ],
        "x-version": "v2"
      }
