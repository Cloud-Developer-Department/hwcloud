{
  "name": "CreateCloudTableTransferTask",
  "summary": "添加CloudTable转储任务",
  "tags": "转储任务管理",
  "productshort": "DIS",
  "region_id": "cn-east-2",
  "paths": {
    "/v2/{project_id}/streams/{stream_name}/transfer-tasks": {
      "post": {
        "x-scope": "Commercial",
        "x-request-examples-description-1": "添加CloudTable HBase转储任务",
        "x-request-examples-url-1": "POST https://{Endpoint}/v2/{project_id}/streams/{stream_name}/transfer-tasks",
        "x-request-examples-1": {
          "destination_type": "CLOUDTABLE",
          "cloudtable_destination_descriptor": {
            "task_name": "hbasetask",
            "consumer_strategy": "TRIM_HORIZON",
            "agency_name": "dis_admin_agency",
            "cloudtable_cluster_name": "cloudtablecluster",
            "cloudtable_cluster_id": "b8c095e2-db5f-4732-8a1d-eacd662e35dc",
            "cloudtable_table_name": "cloudtabletable",
            "cloudtable_row_key_delimiter": "|",
            "retry_duration": 1800,
            "obs_backup_bucket_path": "obsbackupbucket",
            "backup_file_prefix": "",
            "cloudtable_schema": {
              "row_key": [
                {
                  "value": "datavalue",
