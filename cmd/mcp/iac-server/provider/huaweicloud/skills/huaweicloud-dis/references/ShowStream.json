                "partitions": [
                  {
                    "status": "ACTIVE",
                    "partition_id": "shardId-0000000000",
                    "hash_range": "[0 : 9223372036854775807]",
                    "sequence_number_range": "[289911 : 289927]"
                  }
                ],
                "has_more_partitions": false
              }
            },
            "schema": {
              "$ref": "#/definitions/DescribeStreamResult"
            }
          }
        },
        "security": [
          {
            "aksk": []
          }
        ],
        "x-version": "v2",
        "x-scope": "Commercial",
        "x-order": 4
      }
    }
  },
  "definitions": {
    "UpdatePartitionCount": {
      "properties": {
        "create_timestamp": {
          "type": "integer",
          "description": "扩缩容操作执行时间戳,13位时间戳。",
          "format": "int64"
        },
        "src_partition_count": {
          "type": "integer",
          "description": "扩缩容操作前分区数量。"
        },
        "target_partition_count": {
          "type": "integer",
          "description": "扩缩容操作后分区数量。"
        },
        "result_code": {
          "type": "integer",
          "description": "扩缩容操作响应码。"
        },
        "result_msg": {
          "type": "integer",
          "description": "扩缩容操作响应信息。"
        },
        "auto_scale": {
          "type": "boolean",
          "description": "本次扩缩容操作是否为自动扩缩容。\n\n- true:自动扩缩容。\n- false:手动扩缩容。"
        }
      }
    },
    "Tag": {
      "properties": {
        "key": {
          "type": "string",
          "example": "key1",
          "description": "键。\n\n- 不能为空。\n\n- 对于同一资源键值唯一。\n\n- 字符集:A-Z,a-z , 0-9,‘-’,‘_’,UNICODE字符(\\一-\\鿿)。",
          "minLength": 1,
          "maxLength": 36
        },
        "value": {
          "type": "string",
          "example": "value1",
          "description": "值。\n\n- 长度不超过43个字符。\n\n- 字符集:A-Z,a-z , 0-9,‘.’,‘-’,‘_’,UNICODE字符(\\一-\\鿿)。\n\n- 只能包含数字、字母、中划线“-”、下划线“_”。",
          "minLength": 0,
          "maxLength": 43
        }
      },
      "description": "标签对象。"
    },
    "SysTag": {
      "properties": {
        "key": {
          "type": "string",
          "example": "_sys_enterprise_project_id",
          "description": "键。\n\n- 不能为空。\n\n- 值必须为_sys_enterprise_project_id。",
          "enum": [
            "_sys_enterprise_project_id"
          ]
        },
        "value": {
          "type": "string",
          "example": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
          "description": "值。\n\n- 对应的是企业项目ID,需要在企业管理页面获取。\n\n- 36位UUID。"
        }
      }
    },
    "CSVProperties": {
      "properties": {
        "delimiter": {
          "type": "string",
          "example": ",",
          "description": "数据分隔符。"
        }
      },
      "description": "CSV 格式数据的相关属性,比如分隔符 delimiter"
    },
    "DescribeStreamResult": {
      "properties": {
        "stream_name": {
          "type": "string",
          "description": "通道名称。"
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "description": "通道创建的时间,13位时间戳。"
        },
        "last_modified_time": {
          "type": "integer",
          "format": "int64",
          "description": "通道最近一次修改的时间,13位时间戳。"
        },
        "status": {
          "type": "string",
          "description": "通道的当前状态。\n\n- CREATING:创建中\n- RUNNING:运行中\n- TERMINATING:删除中\n- TERMINATED:已删除",
          "enum": [
            "CREATING",
            "RUNNING",
            "TERMINATING",
            "FROZEN"
          ],
          "format": "int32"
        },
        "stream_type": {
          "type": "string",
          "description": "通道类型。\n\n- COMMON:普通通道,表示1MB带宽。\n- ADVANCED:高级通道,表示5MB带宽。",
          "enum": [
            "COMMON",
            "ADVANCED"
          ]
        },
        "partitions": {
          "type": "array",
          "description": "通道的分区列表。",
          "items": {
            "$ref": "#/definitions/PartitionResult"
          }
        },
        "has_more_partitions": {
          "type": "boolean",
          "description": "是否还有更多满足请求条件的分区。\n\n- 是:true。\n- 否:false。"
        },
        "retention_period": {
          "type": "integer",
          "description": "数据保留时长,单位是小时。",
          "format": "int32"
        },
        "stream_id": {
          "type": "string",
          "description": "通道唯一标示符。"
        },
        "data_type": {
          "type": "string",
          "description": "源数据类型。\n\n- BLOB:存储在数据库管理系统中的一组二进制数据。\n- JSON:一种开放的文件格式,以易读的文字为基础,用来传输由属性值或者序列性的值组成的数据对象。\n- CSV:纯文本形式存储的表格数据,分隔符默认采用逗号。\n\n缺省值:BLOB。",
          "enum": [
            "BLOB",
            "JSON",
            "CSV"
          ],
          "format": "int32"
        },
        "data_schema": {
          "type": "string",
          "description": "用于描述用户JSON、CSV格式的源数据结构,采用Avro Schema的语法描述。Avro介绍您也可以点击[这里](http://avro.apache.org/docs/current/#schemas)查看。",
          "format": "int32"
        },
        "compression_format": {
          "type": "string",
          "description": "数据的压缩类型,目前支持:\n\n- snappy\n\n- gzip\n\n- zip\n\n默认不压缩。",
          "enum": [
            "snappy",
            "gzip",
            "zip"
          ],
          "format": "int32"
        },
        "csv_properties": {
          "$ref": "#/definitions/CSVProperties"
        },
        "writable_partition_count": {
          "type": "integer",
          "description": "可写分区总数量(只包含ACTIVE状态的分区)。"
        },
        "readable_partition_count": {
          "type": "integer",
          "description": "可读分区总数量(包含ACTIVE与DELETED状态的分区)。"
        },
        "update_partition_counts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UpdatePartitionCount"
          },
          "description": "扩缩容操作记录列表。"
        },
        "tags": {
          "type": "array",
          "description": "通道的标签列表。",
          "items": {
            "$ref": "#/definitions/Tag"
          }
        },
        "sys_tags": {
          "type": "array",
          "description": "通道的企业项目。",
          "items": {
            "$ref": "#/definitions/SysTag"
          }
        },
        "auto_scale_enabled": {
          "type": "boolean",
          "description": "是否开启自动扩缩容。\n\n- true:开启自动扩缩容。\n- false:关闭自动扩缩容。\n\n默认不开启。"
        },
        "auto_scale_min_partition_count": {
          "type": "integer",
          "description": "当自动扩缩容启用时,自动缩容的最小分片数。"
        },
        "auto_scale_max_partition_count": {
          "type": "integer",
          "description": "当自动扩缩容启用时,自动扩容的最大分片数。"
        }
      },
      "xml": {
        "name": "DescribeStreamResult"
      }
    },
    "PartitionResult": {
      "properties": {
        "status": {
          "type": "string",
          "description": "分区的当前状态。\n\n- CREATING:创建中\n- ACTIVE:可用\n- DELETED:删除中\n- EXPIRED:已过期",
          "enum": [
            "CREATING",
            "ACTIVE",
            "DELETED",
            "EXPIRED"
          ]
        },
        "partition_id": {
          "type": "string",
          "description": "分区的唯一标识符。"
        },
        "hash_range": {
          "type": "string",
          "description": "分区的可能哈希键值范围。"
        },
        "sequence_number_range": {
          "type": "string",
          "description": "分区的序列号范围。"
        },
        "parent_partitions": {
          "type": "string",
          "description": "父分区。"
        }
      }
    }
  },
