        "x-request-examples-1": "",
        "x-source": "SelfDeveloped",
        "x-support-sdk": "Y",
        "tags": [
          "通道管理"
        ],
        "summary": "查看通道详情",
        "description": "本接口用于查询指定通道的详情。",
        "operationId": "ShowStream",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
            "x-order": 2
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          },
          {
            "name": "stream_name",
            "in": "path",
            "description": "需要查询的通道名称。",
            "required": true,
            "type": "string",
            "maxLength": 60,
            "x-example": "new-stream"
