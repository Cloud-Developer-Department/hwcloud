        "action_type": {
          "type": "string",
          "description": "授权操作类型。\n\n- putRecords:上传数据。\n- getRecords:下载数据。",
          "enum": [
            "putRecords",
            "getRecords"
          ]
        },
        "effect": {
          "type": "string",
          "description": "授权影响类型。\n\n- accept:允许该授权操作。",
          "enum": [
            "accept"
          ]
        }
      },
      "xml": {
        "name": "PrincipalRule"
      }
    },
    "ListPoliciesResult": {
      "type": "object",
      "properties": {
        "stream_id": {
          "type": "string",
          "description": "通道唯一标识符。"
        },
        "rules": {
          "type": "array",
          "description": "通道授权信息列表。",
          "items": {
            "$ref": "#/definitions/PrincipalRule",
            "type": "object"
          }
        }
      },
      "xml": {
        "name": "ListStreamsResult"
      }
    }
