{
  "name": "ShowPartitionMetrics",
  "summary": "查询分区监控",
  "tags": "监控管理",
  "productshort": "DIS",
  "region_id": "cn-east-3",
  "paths": {
    "/v2/{project_id}/streams/{stream_name}/partitions/{partition_id}/metrics": {
      "get": {
        "x-scope": "Commercial",
        "x-request-examples-description-1": "查询分区监控数据",
        "x-request-examples-url-1": "GET https://{Endpoint}/v2/{project_id}/streams/{stream_name}/partitions/{partition_id}/metrics",
        "x-request-examples-1": "",
        "x-source": "SelfDeveloped",
        "x-timeout": "60s",
        "x-support-sdk": "Y",
        "x-version": "v2",
        "tags": [
          "监控管理"
        ],
        "summary": "查询分区监控",
        "description": "本接口用于查询通道指定分区的监控数据。",
        "operationId": "ShowPartitionMetrics",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID。",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "stream_name",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "通道名称。",
            "maxLength": 60,
            "x-example": "new-stream"
          },
          {
            "name": "partition_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "分区编号。\n可定义为如下两种样式:\n- shardId-0000000000\n- 0\n比如一个通道有三个分区,那么分区标识符分别为0, 1, 2,或者shardId-0000000000, shardId-0000000001, shardId-0000000002",
            "x-example": 0
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "description": "分区监控指标。(label与label_list必须二选一,label_list与label同时存在时,以label_list为准)\n\n- total_put_bytes_per_partition:分区总输入流量(Byte)\n- total_get_bytes_per_partition:分区总输出流量(Byte)\n- total_put_records_per_partition:分区总输入记录数(个)\n- total_get_records_per_partition:分区总输出记录数(个)",
            "enum": [
              "total_put_bytes_per_partition",
              "total_get_bytes_per_partition",
              "total_put_records_per_partition",
              "total_get_records_per_partition"
            ],
            "type": "string"
          },
          {
            "name": "label_list",
            "in": "query",
            "required": false,
            "description": "使用label用逗号拼接组成,用于批量查询多个label的指标。(label与label_list必须二选一,label_list与label同时存在时,以label_list为准)",
            "type": "string"
          },
          {
            "name": "start_time",
            "in": "query",
            "required": true,
            "description": "监控开始时间点,10位时间戳。",
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "end_time",
            "in": "query",
            "required": true,
            "description": "监控结束时间点,10位时间戳。",
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          }
        ],
        "responses": {
          "200": {
            "description": "正常返回",
            "schema": {
              "$ref": "#/definitions/GetPartitionMetricsResult"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Metrics": {
      "description": "数据对象。",
      "properties": {
        "dataPoints": {
          "type": "array",
          "description": "监控数据。",
          "items": {
            "$ref": "#/definitions/DataPoint"
          }
        },
        "label": {
          "type": "string",
          "description": "监控指标。"
        }
      }
    },
    "DataPoint": {
      "description": "监控数据。",
      "properties": {
        "timestamp": {
          "type": "integer",
          "description": "时间戳。",
          "format": "int64"
        },
        "value": {
          "type": "integer",
          "description": "时间戳对应的监控值。",
          "format": "int64"
        }
      }
    },
    "GetPartitionMetricsResult": {
      "properties": {
        "metrics": {
          "$ref": "#/definitions/Metrics"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dis.cn-east-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}