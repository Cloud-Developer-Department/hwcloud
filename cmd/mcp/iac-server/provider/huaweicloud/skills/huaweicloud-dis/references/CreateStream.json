          "minLength": 1,
          "maxLength": 36
        },
        "value": {
          "type": "string",
          "example": "value1",
          "description": "值。\n\n- 长度不超过43个字符。\n\n- 字符集:A-Z,a-z , 0-9,‘.’,‘-’,‘_’,UNICODE字符(\\一-\\鿿)。\n\n- 只能包含数字、字母、中划线“-”、下划线“_”。",
          "minLength": 0,
          "maxLength": 43
        }
      },
      "description": "标签对象。"
    },
    "SysTag": {
      "properties": {
        "key": {
          "type": "string",
          "example": "_sys_enterprise_project_id",
          "description": "键。\n\n- 不能为空。\n\n- 值必须为_sys_enterprise_project_id。",
          "enum": [
            "_sys_enterprise_project_id"
          ]
        },
        "value": {
          "type": "string",
          "example": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
          "description": "值。\n\n- 对应的是企业项目ID,需要在企业管理页面获取。\n\n- 36位UUID。"
        }
      }
