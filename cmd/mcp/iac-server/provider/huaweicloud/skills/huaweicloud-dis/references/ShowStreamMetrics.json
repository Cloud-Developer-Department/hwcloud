{
  "name": "ShowStreamMetrics",
  "summary": "查询通道监控",
  "tags": "监控管理",
  "productshort": "DIS",
  "region_id": "ap-southeast-2",
  "paths": {
    "/v2/{project_id}/streams/{stream_name}/metrics": {
      "get": {
        "x-scope": "Commercial",
        "x-request-examples-description-1": "查询通道监控数据",
        "x-request-examples-url-1": "GET https://{Endpoint}/v2/{project_id}/streams/{stream_name}/metrics",
        "x-request-examples-1": "",
        "x-source": "SelfDeveloped",
        "x-timeout": "60s",
        "x-support-sdk": "Y",
        "x-version": "v2",
        "tags": [
          "监控管理"
        ],
        "summary": "查询通道监控",
        "description": "本接口用于查询指定通道的监控数据。",
        "operationId": "ShowStreamMetrics",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID。",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "stream_name",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "通道名称。",
            "maxLength": 60,
            "x-example": "new-stream"
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "description": "通道监控指标。(label与label_list必须二选一,label_list与label同时存在时,以label_list为准)\n\n- total_put_bytes_per_stream:总输入流量(Byte)\n- total_get_bytes_per_stream:总输出流量(Byte)\n- total_put_records_per_stream:总输入记录数(个)\n- total_get_records_per_stream:总输出记录数(个)\n- total_put_req_latency:上传请求平均处理时间(毫秒)\n- total_get_req_latency:下载请求平均处理时间(毫秒)\n- total_put_req_suc_per_stream:上传请求成功次数(个)\n- total_get_req_suc_per_stream:下载请求成功次数(个)\n- traffic_control_put:因流控拒绝的上传请求次数 (个)\n- traffic_control_get:因流控拒绝的下载请求次数 (个)",
            "enum": [
              "total_put_bytes_per_stream",
              "total_get_bytes_per_stream",
              "total_put_records_per_stream",
              "total_get_records_per_stream",
              "total_put_req_latency",
              "total_get_req_latency",
              "total_put_req_suc_per_stream",
              "total_get_req_suc_per_stream",
              "traffic_control_put",
              "traffic_control_get"
            ],
            "type": "string"
          },
          {
            "name": "label_list",
            "in": "query",
            "required": false,
            "description": "使用label用逗号拼接组成,用于批量查询多个label的指标。(label与label_list必须二选一,label_list与label同时存在时,以label_list为准)",
            "type": "string"
          },
          {
            "name": "start_time",
            "in": "query",
            "required": true,
            "description": "监控开始时间点,10位时间戳。",
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "end_time",
            "in": "query",
            "required": true,
            "description": "监控结束时间点,10位时间戳。",
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          }
        ],
        "responses": {
          "200": {
            "description": "正常返回",
            "schema": {
              "$ref": "#/definitions/GetStreamMetricsResult"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Metrics": {
      "description": "数据对象。",
      "properties": {
        "dataPoints": {
          "type": "array",
          "description": "监控数据。",
          "items": {
            "$ref": "#/definitions/DataPoint"
          }
        },
        "label": {
          "type": "string",
          "description": "监控指标。"
        }
      }
    },
    "DataPoint": {
      "description": "监控数据。",
      "properties": {
        "timestamp": {
          "type": "integer",
          "description": "时间戳。",
          "format": "int64"
        },
        "value": {
          "type": "integer",
          "description": "时间戳对应的监控值。",
          "format": "int64"
        }
      }
    },
    "GetStreamMetricsResult": {
      "properties": {
        "metrics": {
          "$ref": "#/definitions/Metrics"
        },
        "metrics_list": {
          "type": "array",
          "description": "监控数据对象列表。",
          "items": {
            "$ref": "#/definitions/Metrics"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dis.ap-southeast-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}