{
  "name": "ListTransferTasks",
  "summary": "查询转储任务列表",
  "tags": "转储任务管理",
  "productshort": "DIS",
  "region_id": "cn-east-2",
  "paths": {
    "/v2/{project_id}/streams/{stream_name}/transfer-tasks": {
      "get": {
        "x-version": "v2",
        "x-scope": "Commercial",
        "x-request-examples-description-1": "查询转储任务列表",
        "x-request-examples-url-1": "GET https://{Endpoint}/v2/{project_id}/streams/{stream_name}/transfer-tasks",
        "x-request-examples-1": "",
        "x-source": "SelfDeveloped",
        "x-timeout": "60s",
        "tags": [
          "转储任务管理"
        ],
        "summary": "查询转储任务列表",
        "x-support-sdk": "Y",
        "description": "本接口用于查询转储任务列表。",
        "operationId": "ListTransferTasks",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID。",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "stream_name",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "需要查询的通道名称。",
            "maxLength": 60,
            "x-example": "new-stream"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          }
        ],
        "responses": {
          "200": {
            "description": "正常返回",
            "examples": {
              "application/json": {
                "tasks": [
                  {
                    "task_id": "As805BudhcH1lDs6gbn",
                    "destination_type": "OBS",
                    "task_name": "newtask",
                    "create_time": 1606554932552,
                    "state": "RUNNING",
                    "last_transfer_timestamp": 1606984428612
                  }
                ],
                "total_number": 1
              }
            },
            "schema": {
              "$ref": "#/definitions/ListTransferTasksResult"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "TransferTask": {
      "properties": {
        "task_name": {
          "type": "string",
          "description": "转储任务名称。"
        },
        "state": {
          "type": "string",
          "description": "转储任务状态。\n\n- ERROR:错误。\n- STARTING:启动中。\n- PAUSED:已停止。\n- RUNNING:运行中。\n- DELETE:已删除。\n- ABNORMAL:异常。",
          "enum": [
            "ERROR",
            "STARTING",
            "PAUSED",
            "RUNNING",
            "DELETE",
            "ABNORMAL"
          ],
          "format": "int32",
          "example": "RUNNING"
        },
        "destination_type": {
          "type": "string",
          "description": "转储任务类型。\n\n- OBS:转储到OBS。\n- MRS:转储到MRS。\n- DLI:转储到DLI。\n- CLOUDTABLE:转储到CloudTable。\n- DWS:转储到DWS。",
          "enum": [
            "OBS",
            "MRS",
            "DLI",
            "CLOUDTABLE",
            "DWS"
          ],
          "format": "int32",
          "example": "OBS"
        },
        "create_time": {
          "type": "integer",
          "description": "转储任务创建时间。",
          "format": "int64"
        },
        "last_transfer_timestamp": {
          "type": "integer",
          "description": "转储任务最近一次转储时间。",
          "format": "int64"
        }
      }
    },
    "ListTransferTasksResult": {
      "properties": {
        "total_number": {
          "type": "integer",
          "description": "转储任务总数。"
        },
        "quota": {
          "type": "integer",
          "description": "可创建的转储任务配额。",
          "format": "int32"
        },
        "tasks": {
          "type": "array",
          "description": "转储任务列表。",
          "items": {
            "$ref": "#/definitions/TransferTask"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dis.cn-east-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
