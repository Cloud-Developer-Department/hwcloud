{
  "name": "ListApp",
  "summary": "查询App列表",
  "tags": "App管理",
  "productshort": "DIS",
  "region_id": "cn-north-1",
  "paths": {
    "/v2/{project_id}/apps": {
      "get": {
        "x-scope": "Commercial",
        "x-request-examples-description-1": "查询App列表",
        "x-request-examples-url-1": "GET https://{Endpoint}/v2/{project_id}/apps",
        "x-request-examples-1": "",
        "x-source": "SelfDeveloped",
        "x-timeout": "60s",
        "x-support-sdk": "Y",
        "tags": [
          "App管理"
        ],
        "description": "本接口用于查询APP列表。",
        "summary": "查询App列表",
        "operationId": "ListApp",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
            "x-order": 2
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          },
          {
            "name": "limit",
            "in": "query",
            "x-example": 100,
            "description": "单次请求返回APP列表的最大数量。",
            "type": "integer",
            "default": 10,
            "maximum": 100,
            "minimum": 1,
            "required": false
          },
          {
            "name": "start_app_name",
            "in": "query",
            "description": "从该app名称开始返回app列表,返回的app列表不包括此app名称。",
            "type": "string",
            "required": false
          },
          {
            "name": "stream_name",
            "in": "query",
            "x-example": "new-stream",
            "description": "返回该通道下的app列表。",
            "type": "string",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "正常返回",
            "examples": {
              "application/json": {
                "total_number": 1,
                "apps": [
                  {
                    "app_id": "bd6IPpvgiIflQPMpi9M",
                    "app_name": "newstream",
                    "create_time": 1593569685875
                  }
                ],
                "has_more_app": true
              }
            },
            "schema": {
              "$ref": "#/definitions/ListAppResult"
            }
          },
          "400": {
            "description": "Invalid Parameters"
          },
          "404": {
            "description": "Application not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "aksk": []
          }
        ],
        "x-version": "v2"
      }
    }
  },
  "definitions": {
    "ListAppResult": {
      "properties": {
        "has_more_app": {
          "type": "boolean",
          "description": "是否还有更多满足条件的App。\n\n- true:是。\n- false:否。"
        },
        "apps": {
          "type": "array",
          "description": "AppEntry list that meets the current request.",
          "items": {
            "$ref": "#/definitions/DescribeAppResult"
          }
        },
        "total_number": {
          "type": "integer",
          "description": "满足条件的App总数。",
          "format": "int32"
        }
      }
    },
    "DescribeAppResult": {
      "properties": {
        "app_name": {
          "type": "string",
          "description": "App的名称。",
          "format": "int32"
        },
        "app_id": {
          "type": "string",
          "description": "App的唯一标识符。",
          "format": "int32"
        },
        "create_time": {
          "type": "integer",
          "description": "App创建的时间,单位毫秒。",
          "format": "int64"
        },
        "commit_checkpoint_stream_names": {
          "type": "array",
          "description": "关联通道列表。",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dis.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}