{
  "name": "ConsumeRecords",
  "summary": "下载数据",
  "tags": "数据管理",
  "productshort": "DIS",
  "region_id": "cn-south-1",
  "paths": {
    "/v2/{project_id}/records": {
      "get": {
        "x-publishpath": "dis_02_0019",
        "x-scope": "Commercial",
        "x-request-examples-description-1": "下载数据",
        "x-request-examples-url-1": "GET https://{Endpoint}/v2/{project_id}/records",
        "x-request-examples-1": "",
        "x-source": "SelfDeveloped",
        "x-timeout": "60s",
        "x-support-sdk": "Y",
        "tags": [
          "数据管理"
        ],
        "summary": "下载数据",
        "description": "本接口用于从DIS通道中下载数据。",
        "operationId": "ConsumeRecords",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
            "x-order": 2
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-order": 1
          },
          {
            "name": "partition-cursor",
            "in": "query",
            "description": "数据游标,需要先通过获取数据游标的接口获取。\n\n取值范围:1~512个字符。\n\n说明:\n\n数据游标有效期为5分钟。",
            "required": true,
            "type": "string"
          },
          {
            "name": "max_fetch_bytes",
            "in": "query",
            "x-example": 1048576,
            "description": "每个请求获取记录的最大字节数。\n\n注意:\n\n该值如果小于分区中单条记录的大小,会导致一直无法获取到记录。",
            "type": "integer",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "正常返回",
            "examples": {
              "application/json": {
                "records": [
                  {
                    "partition_key": "0",
                    "sequence_number": "485",
                    "data": "MTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTEx",
                    "timestamp": 1527577402541,
                    "timestamp_type": "CreateTime"
                  }
                ],
                "next_partition_cursor": "eyJpdGVyR2VuVGltZSI6MTQ5MDk1MDE1Nzc0NywiU3RyZWFtTmFtZSI6IjY2MCIsIlNoYXJkSWQiOiIwIiwiU2hhcmRJdGVyYXRvclR5cGUiOiJBVF9TRVFVRU5DRV9OVU1CRVIiLCJTdGFydGluZ1NlcXVlbmNlTnVtYmVyIjoiMjIiLCJUaW1lU3RhbXAiOjB9"
              }
            },
            "schema": {
              "$ref": "#/definitions/GetRecordsResult"
            }
          }
        },
        "security": [
          {
            "aksk": []
          }
        ],
        "x-version": "v2"
      }
    }
  },
  "definitions": {
    "GetRecordsResult": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "description": "下载的记录列表。",
          "items": {
            "$ref": "#/definitions/Record",
            "type": "object"
          }
        },
        "next_partition_cursor": {
          "type": "string",
          "description": "下一个迭代器。\n\n说明:\n\n数据游标有效期为5分钟。"
        }
      },
      "xml": {
        "name": "GetRecordsResult"
      }
    },
    "Record": {
      "properties": {
        "partition_key": {
          "type": "string",
          "description": "用户上传数据时设置的partition_key。\n\n说明:\n\n上传数据时,如果传了partition_key参数,则下载数据时可返回此参数。如果上传数据时,未传partition_key参数,而是传入partition_id,则不返回partition_key。"
        },
        "sequence_number": {
          "type": "string",
          "description": "该条数据的序列号。"
        },
        "data": {
          "type": "string",
          "description": "下载的数据。\n\n下载的数据为序列化之后的二进制数据(Base64编码后的字符串)。\n\n比如下载数据接口返回的数据是“ZGF0YQ==”,“ZGF0YQ==”经过Base64解码之后是“data”。"
        },
        "timestamp": {
          "type": "integer",
          "description": "记录写入DIS的时间戳。",
          "format": "int64"
        },
        "timestamp_type": {
          "type": "string",
          "description": "时间戳类型。\n\n- CreateTime:创建时间。",
          "default": "CreateTime",
          "format": "int64"
        }
      },
      "xml": {
        "name": "Record"
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dis.cn-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}