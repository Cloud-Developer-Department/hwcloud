{
  "name": "ShowDasRecommendSqlLimitRule",
  "summary": "自动推荐SQL限流规则",
  "tags": "云DBA",
  "productshort": "DAS",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/das-recommend-sql-limit-rule": {
      "post": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "tags": [
          "云DBA"
        ],
        "summary": "自动推荐SQL限流规则",
        "description": "根据条件(包括模板所代表的sql平均时长,条数,最大执行时长,前三者混合)自动推荐SQL限流规则",
        "operationId": "ShowDasRecommendSqlLimitRule",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目id"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "实例id"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型。en-us:英文。 zh-cn:中文。",
            "type": "string",
            "default": "en-us",
            "enum": [
              "zh-cn",
              "en-us"
            ]
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "token",
            "type": "string"
          },
          {
            "name": "ShowDasRecommendSqlLimitRuleRequestBody",
            "in": "body",
            "required": true,
            "description": "请求参数",
            "schema": {
              "$ref": "#/definitions/ShowRecommendSqlLimitRuleRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/RecommendSqlLimitRuleResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ShowRecommendSqlLimitRuleRequestBody": {
      "type": "object",
      "properties": {
        "engine_type": {
          "type": "string",
          "description": "引擎类型,目前只支持mysql或者taurus"
        },
        "rds_recommendation_type": {
          "type": "string",
          "description": "如果是rds类型, 那么可以选择'count', 'average_time', 'max_time', 'all'这几种类型"
        },
        "taurus_recommendation_type": {
          "type": "string",
          "description": "如果选择了taurus类型,那么可以选择'count', 'avg_time'"
        },
        "recommend_count": {
          "type": "integer",
          "format": "int64",
          "description": "推荐数量"
        },
        "node_id": {
          "type": "string",
          "description": "如果选择了taurus, 那么需要制定node id"
        }
      }
    },
    "RecommendSqlLimitRuleResp": {
      "type": "object",
      "required": [
        "instance_id",
        "sql_limit_infos"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "description": "实例id"
        },
        "sql_limit_infos": {
          "type": "array",
          "items": {
            "properties": {
              "raw_sql": {
                "description": "mysql 提供原始sql的信息, taurus 只提供一条sql信息",
                "properties": {
                  "session_id": {
                    "type": "string",
                    "description": "会话id"
                  },
                  "host": {
                    "type": "string",
                    "description": "主机ip"
                  },
                  "sql": {
                    "type": "string",
                    "description": "sql"
                  },
                  "db": {
                    "type": "string",
                    "description": "数据库名称"
                  },
                  "time": {
                    "type": "integer",
                    "format": "int64",
                    "description": "时间"
                  }
                }
              },
              "average_time": {
                "type": "number",
                "format": "double",
                "description": "平均时间"
              },
              "count": {
                "type": "number",
                "format": "double",
                "description": "数量"
              },
              "maxTime": {
                "type": "integer",
                "format": "int64",
                "description": "mysql 提供, taurus不提供"
              },
              "exe_time": {
                "type": "integer",
                "format": "int64",
                "description": "执行时间"
              }
            }
          },
          "description": "sql的限流信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "das.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}