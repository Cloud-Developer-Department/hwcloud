{
  "name": "ListAlarmRulePolicies",
  "summary": "查询告警规则策略列表",
  "tags": "告警策略",
  "productshort": "CES",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/alarms/{alarm_id}/policies": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-php-exclude": "Y",
        "x-api-type": "open-api",
        "x-version": "v2",
        "x-request-examples-description-1": "查询告警规则ID为alCzk8o9dtSQHtiDgb44Eepw,且分页大小为10的告警规则策略列表。",
        "x-request-examples-url-1": "/v2/{project_id}/alarms/alCzk8o9dtSQHtiDgb44Eepw/policies?offset=0&limit=10",
        "x-order": 9,
        "tags": [
          "告警策略"
        ],
        "description": "根据告警规则ID查询策略列表",
        "summary": "查询告警规则策略列表",
        "operationId": "ListAlarmRulePolicies",
        "parameters": [
          {
            "$ref": "#/parameters/ContentType"
          },
          {
            "$ref": "#/parameters/AuthToken"
          },
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "name": "alarm_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "**参数解释**:\n告警规则ID。    \n**约束限制**:\n不涉及。\n**取值范围**:\n以al开头,后跟22个数字或字母。字符长度为24\n**默认取值**:\n不涉及。",
            "pattern": "^al([0-9A-Za-z]){22}$"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数解释**:\n分页偏移量。\n**约束限制**:\n不涉及。\n**取值范围**:\n0-10000\n**默认取值**:\n0",
            "type": "integer",
            "pattern": "^([0]|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]|[1-9][0-9][0-9][0-9]|10000)$",
            "default": 0,
            "required": false,
            "minimum": 0,
            "maximum": 10000
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数解释**:\n分页大小。\n**约束限制**:\n不涉及。\n**取值范围**:\n1-100\n**默认取值**:\n10",
            "type": "integer",
            "pattern": "^([1-9]|[1-9][0-9]|100)$",
            "default": 10,
            "required": false,
            "minimum": 1,
            "maximum": 100
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "$ref": "#/definitions/PoliciesRespV2"
            },
            "examples": {
              "application/json": {
                "policies": [
                  {
                    "namespace": "AGT.ECS",
                    "dimension_name": "instance_id",
                    "metric_name": "disk_device_read_bytes_rate",
                    "extra_info": {},
                    "period": 1,
                    "filter": "average",
                    "comparison_operator": ">",
                    "value": 75,
                    "hierarchical_value": {
                      "critical": 1
                    },
                    "unit": "byte/s",
                    "count": 3,
                    "type": "",
                    "suppress_duration": 10800,
                    "level": 2
                  }
                ],
                "count": 10
              }
            }
          },
          "400": {
            "description": "参数校验失败",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "404": {
            "description": "告警规则不存在",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "500": {
            "description": "系统内部错误",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ValueResp": {
      "description": "**参数解释**:\n告警阈值。具体阈值取值请参见[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)。 \n**取值范围**:\n最小值为-1.7976931348623157e+108,最大值为1.7976931348623157e+108。",
      "type": "number",
      "format": "double",
      "minimum": -1.7976931348623156e+108,
      "maximum": 1.7976931348623156e+108
    },
    "ComparisonOperatorResp": {
      "description": "**参数解释**:\n阈值符号。    \n**取值范围**:\n支持的值为(>|<|>=|<=|=|!=|cycle_decrease|cycle_increase|cycle_wave);cycle_decrease为环比下降,cycle_increase为环比上升,cycle_wave为环比波动。",
      "type": "string",
      "pattern": "^(>|<|>=|<=|=|!=|cycle_decrease|cycle_increase|cycle_wave)$",
      "example": ">="
    },
    "HierarchicalValueResp": {
      "type": "object",
      "description": "**参数解释**:\n多层级告警阈值。",
      "example": {
        "critical": 12,
        "major": 10,
        "minor": 8,
        "info": 4
      },
      "properties": {
        "critical": {
          "description": "**参数解释**:\n紧急级别的阈值。\n**取值范围**:\n[-1.7976931348623157e+108, 1.7976931348623157e+108]",
          "type": "number",
          "format": "double",
          "minimum": -1.7976931348623156e+108,
          "maximum": 1.7976931348623156e+108,
          "example": 12
        },
        "major": {
          "description": "**参数解释**:\n重要级别的阈值。\n**取值范围**:\n[-1.7976931348623157e+108, 1.7976931348623157e+108]",
          "type": "number",
          "format": "double",
          "minimum": -1.7976931348623156e+108,
          "maximum": 1.7976931348623156e+108,
          "example": 10
        },
        "minor": {
          "description": "**参数解释**:\n次要级别的阈值。\n**取值范围**:\n[-1.7976931348623157e+108, 1.7976931348623157e+108]",
          "type": "number",
          "format": "double",
          "minimum": -1.7976931348623156e+108,
          "maximum": 1.7976931348623156e+108,
          "example": 8
        },
        "info": {
          "description": "**参数解释**:\n提示级别的阈值。\n**取值范围**:\n[-1.7976931348623157e+108, 1.7976931348623157e+108]",
          "type": "number",
          "format": "double",
          "minimum": -1.7976931348623156e+108,
          "maximum": 1.7976931348623156e+108,
          "example": 4
        }
      }
    },
    "MetricExtraInfoResp": {
      "type": "object",
      "description": "**参数解释**:\n告警策略附加信息。",
      "properties": {
        "origin_metric_name": {
          "type": "string",
          "description": "**参数解释**:\n原始指标名称。\n**取值范围**:\n长度为[0,4096]个字符。",
          "minLength": 0,
          "maxLength": 4096,
          "pattern": "^([a-z]|[A-Z]|[0-9]|_|-|~|\\.|/|:)*$"
        },
        "metric_prefix": {
          "type": "string",
          "description": "**参数解释**:\n指标名称前缀。\n**取值范围**:\n长度为[0,4096]个字符。",
          "minLength": 0,
          "maxLength": 4096,
          "pattern": "^([a-z]|[A-Z]|[0-9]|_|-|~|\\.|/|:)*$"
        },
        "custom_proc_name": {
          "type": "string",
          "description": "**参数解释**:\n用户进程名称。\n**取值范围**:\n长度为[0,250]个字符。",
          "minLength": 0,
          "maxLength": 250
        },
        "metric_type": {
          "type": "string",
          "description": "**参数解释**:\n指标类型。\n**取值范围**:\n长度为[0,32]个字符。",
          "minLength": 0,
          "maxLength": 32,
          "pattern": "^([a-z]|[A-Z]|[0-9]|_|-|~|\\.|/|:)*$"
        }
      }
    },
    "UnitResp": {
      "type": "string",
      "description": "**参数解释**:\n数据的单位。   \n**取值范围**:\n长度为[0,32]个字符。",
      "example": "%",
      "minLength": 0,
      "maxLength": 32
    },
    "SuppressDurationResp": {
      "description": "**参数解释**:\n告警抑制时间,单位为秒,该字段主要为解决告警频繁的问题。\n**取值范围**:\n枚举值,只能为0、300、600、900、1800、3600、10800、21600、43200、86400。\n- 0:对于指标类告警,0代表告警一次,对于事件类告警,在立即触发场景中,0代表不抑制;在累计触发场景,0代表只告警一次。\n- 300代表满足告警触发条件后每5分钟告警一次。\n- 600代表满足告警触发条件后每10分钟告警一次。\n- 900代表满足告警触发条件后每15分钟告警一次。\n- 1800代表满足告警触发条件后每30分钟告警一次。\n- 3600代表满足告警触发条件后每60分钟告警一次。\n- 10800代表满足告警触发条件后每3小时告警一次。\n- 21600代表满足告警触发条件后每6小时告警一次。\n- 43200代表满足告警触发条件后每12小时告警一次。\n- 86400代表满足告警触发条件后每一天告警一次。",
      "type": "integer",
      "minimum": 0,
      "maximum": 86400,
      "enum": [
        0,
        300,
        600,
        900,
        1800,
        3600,
        10800,
        21600,
        43200,
        86400
      ]
    },
    "LevelResp": {
      "description": "**参数解释**:\n告警级别。   \n**取值范围**:\n只能为1、2、3、4。\n- 1:紧急\n- 2:重要\n- 3:次要\n- 4:提示",
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 2
    },
    "GoAPIErrorResponseV2": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "ces.0001",
          "description": "请求异常内部业务状态码",
          "minLength": 0,
          "maxLength": 256
        },
        "error_msg": {
          "type": "string",
          "example": "the request format is invalid",
          "description": "请求异常信息",
          "minLength": 0,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "example": "txnEntry-DESKTOP-4LPFH08.txnId-466541d0-f1a6-429b-b747-98d4991671c1.ts-1637909316688.c-95",
          "description": "请求ID",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "NamespaceAllowEmptyResp": {
      "type": "string",
      "description": "**参数解释**:\n各服务命名空间,请参阅[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)。\n**取值范围**:\n格式为service.item;service和item必须是字符串,必须以字母开头,只能包含0-9/a-z/A-Z/_。长度为[0,32]个字符。",
      "minLength": 0,
      "maxLength": 32,
      "example": "SYS.ECS"
    },
    "PoliciesRespV2": {
      "required": [
        "policies"
      ],
      "properties": {
        "policies": {
          "type": "array",
          "description": "**参数解释**:\n告警策略信息列表。",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/ListPolicyResp"
          }
        },
        "count": {
          "type": "integer",
          "description": "**参数解释**:\n指定告警规则对应的策略总数。\n**取值范围**:\n0-100",
          "minimum": 0,
          "maximum": 100
        }
      },
      "type": "object"
    },
    "FilterResp": {
      "description": "**参数解释**:\n聚合方式。        \n**取值范围**:\n- average:平均值\n- variance:方差\n- min:最小值\n- max:最大值\n- sum:求和",
      "type": "string",
      "pattern": "^(average|variance|min|max|sum)$",
      "example": "sum"
    },
    "DimensionNameAllowEmptyResp": {
      "type": "string",
      "description": "**参数解释**:\n资源维度名称,各服务资源的维度名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。\n**取值范围**:\n必须以字母开头,多维度用\",\"分隔,只能包含0-9/a-z/A-Z/_/-,每个维度的最大长度为32。目前最大支持4个维度。举例:单维度场景:instance_id;多维度场景:instance_id,disk",
      "minLength": 0,
      "maxLength": 256,
      "example": "instance_id,disk"
    },
    "CountResp": {
      "type": "integer",
      "format": "int32",
      "description": "**参数解释**:\n告警连续触发次数。    \n**取值范围**:\n事件告警时参数值为1~180(包括1和180);指标告警和站点告警时,次数采用枚举值,枚举值分别为:1、2、3、4、5、10、15、30、60、90、120、180。",
      "minimum": 1,
      "maximum": 180,
      "example": 5
    },
    "ListPolicyResp": {
      "properties": {
        "metric_name": {
          "$ref": "#/definitions/MetricNameResp"
        },
        "extra_info": {
          "$ref": "#/definitions/MetricExtraInfoResp"
        },
        "period": {
          "$ref": "#/definitions/PeriodResp"
        },
        "filter": {
          "$ref": "#/definitions/FilterResp"
        },
        "comparison_operator": {
          "$ref": "#/definitions/ComparisonOperatorResp"
        },
        "value": {
          "$ref": "#/definitions/ValueResp"
        },
        "hierarchical_value": {
          "$ref": "#/definitions/HierarchicalValueResp"
        },
        "unit": {
          "$ref": "#/definitions/UnitResp"
        },
        "type": {
          "type": "string",
          "description": "**参数解释**:\n告警策略类型,已废弃,不推荐使用。\n**取值范围**:\n不涉及。",
          "minLength": 0,
          "maxLength": 32
        },
        "count": {
          "$ref": "#/definitions/CountResp"
        },
        "suppress_duration": {
          "$ref": "#/definitions/SuppressDurationResp"
        },
        "level": {
          "$ref": "#/definitions/LevelResp"
        },
        "namespace": {
          "$ref": "#/definitions/NamespaceAllowEmptyResp"
        },
        "dimension_name": {
          "$ref": "#/definitions/DimensionNameAllowEmptyResp"
        }
      },
      "type": "object"
    },
    "PeriodResp": {
      "description": "**参数解释**:\n告警条件判断周期,单位为秒。\n**取值范围**:\n枚举值。\n- 0是默认值,事件类告警该字段用0即可。\n- 1代表指标的原始周期,比如RDS监控指标原始周期是60s,表示该RDS指标按60s周期为一个数据点参与告警计算。\n- 300代表指标按5分钟聚合周期为一个数据点参与告警计算。\n- 1200代表指标按20分钟聚合周期为一个数据点参与告警计算。\n- 3600代表指标按1小时聚合周期为一个数据点参与告警计算。\n- 14400代表指标按4小时聚合周期为一个数据点参与告警计算。\n- 86400代表指标按1天聚合周期为一个数据点参与告警计算。",
      "type": "integer",
      "minimum": 0,
      "maximum": 86400,
      "enum": [
        0,
        1,
        300,
        1200,
        3600,
        14400,
        86400
      ]
    },
    "MetricNameResp": {
      "description": "**参数解释**:\n资源的监控指标名称,各服务资源的指标名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。\n**取值范围**:\n必须以字母开头,只能包含0-9/a-z/A-Z/_/-。字符长度最短为1,最大为96。如:弹性云服务器中的监控指标cpu_util,表示弹性服务器的CPU使用率;文档数据库中的指标mongo001_command_ps,表示command执行频率。",
      "type": "string",
      "pattern": "^([A-Za-z]){1}([0-9A-Za-z]|_|-)*$",
      "minLength": 1,
      "maxLength": 96,
      "example": "cpu_util"
    }
  },
  "version": "2.0",
  "parameters": {
