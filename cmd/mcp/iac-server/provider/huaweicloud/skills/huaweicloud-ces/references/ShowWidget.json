{
  "name": "ShowWidget",
  "summary": "查询指定监控视图信息",
  "tags": "监控视图",
  "productshort": "CES",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/widgets/{widget_id}": {
      "get": {
        "summary": "查询指定监控视图信息",
        "description": "查询指定监控视图信息",
        "operationId": "ShowWidget",
        "x-constraint": "目前华东-青岛、拉美-墨西哥城一、土耳其-伊斯坦布尔、亚太-雅加达、中东-利雅得、亚太-马尼拉6个局点不支持该接口",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-version": "v2",
        "x-api-type": "open-api",
        "x-open-region-cloud": "hc,hk,hws,hws_hk,hws_eu,hws_eu_wb,dt,dt_test,sbc,g42",
        "tags": [
          "监控视图"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/ContentType"
          },
          {
            "$ref": "#/parameters/AuthToken"
          },
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/WidgetId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/WidgetInfoWithId"
            },
            "examples": {
              "application/json": {
                "widget_id": "wg1234567890123456789012",
                "metrics": [
                  {
                    "namespace": "SYS.ECS",
                    "dimensions": {
                      "name": "instance_id",
                      "filter_type": "all_instances"
                    },
                    "metric_name": "cpu_util",
                    "alias": [
                      "cpuutilalias"
                    ],
                    "extra_info": {
                      "origin_metric_name": "cpu_util",
                      "metric_prefix": "cpu",
                      "metric_type": "type",
                      "custom_proc_name": "app.sh"
                    }
                  }
                ],
                "view": "bar",
                "metric_display_mode": "single",
                "threshold": 0.7,
                "threshold_enabled": true,
                "title": "widget_title",
                "properties": {
                  "filter": "topN",
                  "topN": 100,
                  "order": "desc",
                  "description": "简单的示例",
                  "last_week_compare_enable": false,
                  "yesterday_compare_enable": false,
                  "legend_location": "right",
                  "legend_values": [
                    "max",
                    "min"
                  ],
                  "thresholds": [
                    {
                      "threshold": 90,
                      "threshold_color": "#F23030"
                    }
                  ]
                },
                "location": {
                  "left": 0,
                  "top": 0,
                  "width": 4,
                  "height": 3
                },
                "unit": "%",
                "create_time": 1111111111111
              }
            }
          },
          "400": {
            "description": "Bad Request, 请求错误",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "401": {
            "description": "Unauthorized, 未提供认证信息,或认证信息错误",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "500": {
            "description": "Internal Server Error, 请求未完成, 服务异常",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "BaseWidgetInfoResp": {
      "type": "object",
      "description": "**参数解释**\n监控视图信息",
      "properties": {
        "group_id": {
          "description": "**参数解释**\n视图分组id\n**取值范围**\n字符串必须以dg开头,包含22个字母和数字,长度为24个字符或者为default,default代表不分组",
          "type": "string",
          "example": "grxxx",
          "pattern": "^dg([a-z]|[A-Z]|[0-9]){22}|default$"
        },
        "metrics": {
          "description": "**参数解释**\n指标列表",
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/definitions/WidgetMetricResp"
          }
        },
        "title": {
          "type": "string",
          "description": "**参数解释**\n监控视图标题\n**取值范围**\n长度为[1,128]个字符,允许包括以下内容:1、中文汉字;2、拉丁字母;3、英文大小写字母;4、数字(0-9);5、符号: ” \" ≤ < > & % _ : / ; “ ' ? + , ~ , ( ) o ( ) [ . -",
          "example": "xxx-cpu",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^([\\一-\\鿿]|[\\À-\\Ȅ]|[a-z]|[A-Z]|[0-9]|[\\\"”≤<>&%_:/;“'?+,~,() o\\\\(\\\\)\\\\[\\\\.\\\\-])( *([\\一-\\鿿]|[\\À-\\Ȅ]|[a-z]|[A-Z]|[0-9]|[\\\"”≤<>&%_:/;“'?+,~,() o\\\\(\\\\)\\\\[\\\\.\\\\-]))*$"
        },
        "threshold": {
          "type": "number",
          "description": "**参数解释**\n监控视图指标的阈值\n**取值范围**\n最小值为0,最大值为1.7976931348623157e+308",
          "example": 90,
          "format": "double",
          "minimum": 0,
          "maximum": 1.7976931348623157e+308
        },
        "threshold_enabled": {
          "type": "boolean",
          "description": "**参数解释**\n阈值是否展示\n**取值范围**\n- true:展示\n- false:不展示",
          "example": true
        },
        "view": {
          "type": "string",
          "description": "**参数解释**\n监控视图图表类型\n**取值范围**\n- bar:条形图\n- line:折线图\n- bar_chart:柱状图\n- table:表格\n- circular_bar:环形柱状图\n- area_chart:面积图\n- gauge:仪表盘\n- stat:数字",
          "example": "bar",
          "enum": [
            "bar",
            "line",
            "bar_chart",
            "table",
            "circular_bar",
            "area_chart",
            "gauge",
            "stat"
          ]
        },
        "metric_display_mode": {
          "type": "string",
          "description": "**参数解释**\n指标展示类型\n**取值范围**\n- single:单指标展示\n- multiple:多指标展示",
          "example": "single",
          "enum": [
            "single",
            "multiple"
          ]
        },
        "properties": {
          "description": "**参数解释**\n额外信息",
          "properties": {
            "filter": {
              "type": "string",
              "description": "**参数解释**\n聚合类型\n**取值范围**\n目前只有TopN这一种类型,折线图不支持该参数",
              "example": "topN",
              "enum": [
                "topN"
              ]
            },
            "topN": {
              "type": "integer",
              "description": "**参数解释**\nTop前N个;折线图时为随机展示的时序数据条数\n**取值范围**\n最小值为1,最大值为2147483647",
              "example": "10",
              "format": "int32",
              "default": 100,
              "minimum": 1,
              "maximum": 2147483647
            },
            "order": {
              "type": "string",
              "description": "**参数解释**\n排序字段\n**取值范围**\n- asc:正序\n- desc:倒序",
              "example": "asc",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "description": {
              "type": "string",
              "description": "**参数解释**\n监控视图的描述信息\n**取值范围**\n长度为[0,200]个字符",
              "example": "这是一个简单的视图描述",
              "minLength": 0,
              "maxLength": 200
            },
            "last_week_compare_enable": {
              "type": "boolean",
              "description": "**参数解释**\n是否展示同比(上周同一时间)数据\n**取值范围**\n- true:展示\n- false:不展示",
              "example": true
            },
            "yesterday_compare_enable": {
              "type": "boolean",
              "description": "**参数解释**\n是否展示环比(昨天同一时间)数据\n**取值范围**\n- true:展示\n- false:不展示",
              "example": true
            },
            "legend_location": {
              "type": "string",
              "description": "**参数解释**\n图例位置标记\n**取值范围**\n- hide:表示隐藏图例\n- right:表示图例放在监控视图右侧\n- bottom:表示图例放在监控视图底部",
              "example": "hide",
              "enum": [
                "hide",
                "right",
                "bottom"
              ]
            },
            "legend_values": {
              "type": "array",
              "description": "**参数解释**\n当前时序数据需要在图例中展示的统计值名称列表",
              "example": [
                "max",
                "min"
              ],
              "minItems": 0,
              "maxItems": 6,
              "items": {
                "type": "string",
                "description": "**参数解释**\n统计值名称\n**取值范围**\n- last:当前值\n- max:最大值\n- min:最小值\n- avg:平均值\n- sum:求和值",
                "enum": [
                  "last",
                  "max",
                  "min",
                  "avg",
                  "sum"
                ]
              }
            },
            "thresholds": {
              "type": "array",
              "description": "**参数解释**\n监控视图的阈值辅助线配置",
              "minItems": 0,
              "maxItems": 5,
              "items": {
                "$ref": "#/definitions/ThresholdInfoResp"
              }
            },
            "is_all_compare_enable": {
              "type": "boolean",
              "description": "**参数解释**\n同比环比总开关是否生效\n**取值范围**\n- true:生效\n- false:不生效",
              "example": true
            }
          }
        },
        "location": {
          "description": "**参数解释**\n监控视图图表坐标",
          "required": [
            "top",
            "left",
            "width",
            "height"
          ],
          "properties": {
            "top": {
              "type": "integer",
              "description": "**参数解释**\n监控视图的上坐标             \n**取值范围**\n最小值为0,最大值为2147483647",
              "example": "0",
              "minimum": 0,
              "maximum": 2147483647
            },
            "left": {
              "type": "integer",
              "description": "**参数解释**\n监控视图的左坐标             \n**取值范围**\n最小值为0,最大值为9",
              "example": "1",
              "minimum": 0,
              "maximum": 9
            },
            "width": {
              "type": "integer",
              "description": "**参数解释**\n监控视图图表宽度              \n**取值范围**\n最小值为3,最大值为12",
              "example": "3",
              "minimum": 3,
              "maximum": 12
            },
            "height": {
              "type": "integer",
              "description": "**参数解释**\n监控视图图表高度            \n**取值范围**\n最小值为3,最大值为2147483647",
              "example": "3",
              "minimum": 3,
              "maximum": 2147483647
            }
          }
        },
        "unit": {
          "$ref": "#/definitions/UnitItemResp"
        }
      }
    },
    "MultiMetricNameResp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1080,
      "description": "**参数解释**\n多个指标名称\n**取值范围**\n长度为[1,1080]个字符,多个指标名称之间用逗号隔开",
      "example": "cpu_util,disk_util",
      "pattern": "^([A-Za-z]){1}([0-9A-Za-z]|_|-|,)*$"
    },
    "DimensionInfoResp": {
      "description": "**参数解释**\n维度信息列表。",
      "properties": {
        "name": {
          "description": "**参数解释**:\n维度名称。\n**取值范围**:\n多维度用逗号分隔,各服务资源的维度名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。必须以字母开头,只能包含0-9/a-z/A-Z/_/-,多维度用\",\"分隔,每个维度的最大长度为32。总长度为[1,131]个字符。目前最大支持4个维度。举例:单维度场景:instance_id;多维度场景:instance_id,disk",
          "type": "string",
          "minLength": 1,
          "maxLength": 131,
          "example": "cluster,instance",
          "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-){0,31}(,([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-){0,31}){0,3}$"
        },
        "filter_type": {
          "description": "**参数解释**:\n资源类型。\n**取值范围**:\n- all_instances: 全部资源\n- specific_instances: 指定资源\n- resource_groups:资源分组",
          "type": "string",
          "example": "all_instances",
          "enum": [
            "all_instances",
            "specific_instances",
            "resource_groups"
          ]
        },
        "values": {
          "description": "**参数解释**:\n维度值列表。",
          "example": [
            "cluster-value-001,instance-value-001",
            "cluster-value-002,instance-value-002"
          ],
          "minItems": 0,
          "maxItems": 200,
          "type": "array",
          "items": {
            "description": "**参数解释**:\n维度值。\n**取值范围**:\n长度为[1,1024]个字符,多维度用逗号分隔,与维度名顺序一一对应",
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "example": "cluster-001,instance-001",
            "pattern": "^([a-z]|[A-Z]|[0-9]){1}([a-z]|[A-Z]|[0-9]|_|-|\\\\.|){0,255}(,([a-z]|[A-Z]|[0-9]){1}([a-z]|[A-Z]|[0-9]|_|-|\\\\.|){0,255}){0,3}$"
          }
        }
      }
    },
    "WidgetMetricResp": {
      "type": "object",
      "properties": {
        "namespace": {
          "description": "**参数解释**\n查询服务的命名空间,各服务命名空间请参阅[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)\n**取值范围**\n格式为service.item;service和item必须是字符串,必须以字母开头,只能包含0-9/a-z/A-Z/_。字符串的长度必须在 3 到 32个字符之间。",
          "example": "SYS.XXX",
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*\\.([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*$"
        },
        "dimensions": {
          "$ref": "#/definitions/DimensionInfoResp"
        },
        "metric_name": {
          "$ref": "#/definitions/MultiMetricNameResp"
        },
        "y_axis_position": {
          "type": "string",
          "description": "**参数解释**\n阈值线所在的Y轴位置              \n**取值范围**\n枚举值:\n- left 左Y轴\n- right 右Y轴",
          "example": "left",
          "enum": [
            "left",
            "right"
          ]
        },
        "alias": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "description": "**参数解释**\n监控视图的指标别名列表",
          "example": [
            "cpu_01",
            "cpu_02"
          ],
          "items": {
            "type": "string",
            "description": "**参数解释**\n指标别名\n**取值范围**\n长度为[1,128]个字符",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "extra_info": {
          "$ref": "#/definitions/ExtraInfoResp"
        },
        "rollup_enable": {
          "$ref": "#/definitions/RollupEnableResp"
        },
        "rollup_filter": {
          "$ref": "#/definitions/RollupFilterResp"
        },
        "rollup_dimension": {
          "$ref": "#/definitions/RollupDimensionResp"
        },
        "last_week_compare_enable": {
          "type": "boolean",
          "description": "**参数解释**\n是否展示同比(上周同一时间)数据\n**取值范围**\n- true:展示\n- false:不展示",
          "example": true
        },
        "yesterday_compare_enable": {
          "type": "boolean",
          "description": "**参数解释**\n是否展示环比(昨天同一时间)数据\n**取值范围**\n- true:展示\n- false:不展示",
          "example": true
        },
        "metric_dimension": {
          "description": "**参数解释**\n维度名称,多维度用逗号分隔,各服务资源的维度名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。         \n**取值范围**\n必须以字母开头,只能包含0-9/a-z/A-Z/_/-,多维度用\",\"分隔,每个维度的最大长度为32。总长度为[1,131]个字符。目前最大支持4个维度。举例:单维度场景:instance_id;多维度场景:instance_id,disk",
          "type": "string",
          "minLength": 1,
          "maxLength": 131,
          "example": "cluster,instance",
          "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-){0,31}(,([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-){0,31}){0,3}$"
        },
        "top_num": {
          "type": "integer",
          "description": "**参数解释**\n展示数据数量              \n**取值范围**\n最小值为1,最大值为200",
          "example": "10",
          "format": "int32",
          "minimum": 1,
          "maximum": 200
        },
        "unit": {
          "$ref": "#/definitions/UnitItemResp"
        },
        "order": {
          "type": "string",
          "description": "**参数解释**\n排序字段              \n**取值范围**\n- asc:正序\n- desc:倒序",
          "example": "asc",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "topn_metric_name": {
          "$ref": "#/definitions/WidgetMetricNameResp"
        }
      }
    },
    "GoAPIErrorResponseV2": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "ces.0001",
          "description": "请求异常内部业务状态码",
          "minLength": 0,
          "maxLength": 256
        },
        "error_msg": {
          "type": "string",
          "example": "the request format is invalid",
          "description": "请求异常信息",
          "minLength": 0,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "example": "txnEntry-DESKTOP-4LPFH08.txnId-466541d0-f1a6-429b-b747-98d4991671c1.ts-1637909316688.c-95",
          "description": "请求ID",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "RollupFilterResp": {
      "type": "string",
      "description": "**参数解释**\n聚合规则\n**取值范围**\n- last:最新值\n- max:最大值\n- min:最小值\n- average:平均值\n- sum:求和值",
      "enum": [
        "last",
        "max",
        "min",
        "average",
        "sum"
      ],
      "example": "sum"
    },
    "WidgetMetricNameResp": {
      "description": "**参数解释**\n资源的监控指标名称,必须以字母开头,只能包含0-9/a-z/A-Z/_,字符长度最短为1,最大为64;如:弹性云服务器中的监控指标cpu_util,表示弹性服务器的CPU使用率;文档数据库中的指标mongo001_command_ps,表示command执行频率;各服务资源的指标名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。\n**取值范围**\n长度为[1,96]个字符",
      "type": "string",
      "pattern": "^([A-Za-z]){1}([0-9A-Za-z]|_|-)*$",
      "minLength": 1,
      "maxLength": 96,
      "example": "cpu_util"
    },
    "ExtraInfoResp": {
      "description": "**参数解释**\n指标信息",
      "type": "object",
      "properties": {
        "origin_metric_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "**参数解释**\n指标名称\n**取值范围**\n长度为[1,4096]个字符",
          "example": "xxxx",
          "pattern": "^([a-z]|[A-Z]|[0-9]|_|-|~|\\.|/|:)*$"
        },
        "metric_prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "**参数解释**\n指标名称前缀\n**取值范围**\n长度为[1,4096]个字符",
          "example": "xxxx",
          "pattern": "^([a-z]|[A-Z]|[0-9]|_|-|~|\\.|/|:)*$"
        },
        "metric_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "**参数解释**\n指标类型\n**取值范围**\n长度为[1,32]个字符",
          "example": "xxxx",
          "pattern": "^([a-z]|[A-Z]|[0-9]|_|-|~|\\.|/|:)*$"
        },
        "custom_proc_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
