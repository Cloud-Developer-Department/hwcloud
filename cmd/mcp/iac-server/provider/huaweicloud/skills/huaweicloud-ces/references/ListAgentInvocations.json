{
  "name": "ListAgentInvocations",
  "summary": "查询Agent任务列表",
  "tags": "Agent任务相关接口",
  "productshort": "CES",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/agent-invocations": {
      "get": {
        "tags": [
          "Agent任务相关接口"
        ],
        "summary": "查询Agent任务列表",
        "operationId": "ListAgentInvocations",
        "description": "查询Agent任务列表",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-version": "v3",
        "x-constraint": "目前拉美-布宜诺斯艾利斯一、拉美-利马一2个局点不支持该接口。该接口仅支持查询3个月内的Agent任务列表。\n",
        "x-request-examples-description-1": "查询project_id为xxx下的任务列表",
        "x-request-examples-url-1": "/v3/xxx/agent-invocations",
        "parameters": [
          {
            "$ref": "#/parameters/ContentType"
          },
          {
            "$ref": "#/parameters/ProjectID"
          },
          {
            "$ref": "#/parameters/ProjectAuthToken"
          },
          {
            "name": "instance_id",
            "type": "string",
            "description": "**参数解释**:\n主机id\n**约束限制**:\n不涉及\n**取值范围**:\n1到64个字符的字符串,且只包含字母、数字和连字符\n**默认取值**:\n不涉及\n",
            "in": "query",
            "required": false,
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          {
            "name": "instance_type",
            "in": "query",
            "type": "string",
            "description": "**参数解释**:\n主机类型,仅支持ECS弹性云服务器和BMS裸金属服务器\n**约束限制**:\n不涉及\n**取值范围**:\n- ECS: 弹性云服务器\n- BMS:裸金属服务器\n**默认取值**:\n不涉及\n",
            "required": false,
            "enum": [
              "ECS",
              "BMS"
            ]
          },
          {
            "name": "invocation_id",
            "description": "**参数解释**:\n任务id\n**约束限制**:\n不涉及\n**取值范围**:\n以字母或数字开头,后续可包含字母、数字、下划线或连字符的字符串,长度至少为 1\n**默认取值**:\n不涉及\n",
            "type": "string",
            "in": "query",
            "required": false,
            "pattern": "^([0-9A-Za-z]){1}([0-9A-Za-z]|_|-)*$"
          },
          {
            "name": "invocation_type",
            "description": "**参数解释**:\n任务类型, 仅包含:INSTALL安装, UPDATE升级, ROLLBACK回退,RETRY重试,SET_REMOTE_INSTALLER设置远程安装主机,REMOTE_INSTALL执行远程安装。\n**约束限制**:\n不涉及。\n**取值范围**:\n- INSTALL:安装\n- UPDATE:升级\n- ROLLBACK:回退\n- RETRY:重试\n- SET_REMOTE_INSTALLER:设置远程安装主机\n- REMOTE_INSTALL:执行远程安装\n**默认取值**:\n不涉及\n",
            "required": false,
            "type": "string",
            "in": "query",
            "enum": [
              "INSTALL",
              "UPDATE",
              "ROLLBACK",
              "RETRY",
              "SET_REMOTE_INSTALLER",
              "REMOTE_INSTALL"
            ]
          },
          {
            "name": "invocation_target",
            "description": "**参数解释**:\n任务对象, 支持telescope监控\n**约束限制**:\n不涉及。\n**取值范围**:\n- telescope: 主机监控插件telescope\n**默认取值**:\ntelescope。\n",
            "in": "query",
            "type": "string",
            "required": false,
            "default": "telescope",
            "enum": [
              "telescope"
            ]
          },
          {
            "$ref": "#/parameters/Offset"
          },
          {
            "$ref": "#/parameters/Limit100"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListInvocationsResp"
            },
            "examples": {
              "application/json": {
                "invocations": [
                  {
                    "invocation_id": "invocationxxx001",
                    "instance_id": "instancexxx001",
                    "instance_name": "xxxx",
                    "instance_type": "ECS",
                    "intranet_ips": [
                      "10.xxx.xx.1"
                    ],
                    "elastic_ips": [
                      "1.xx.xx.1"
                    ],
                    "invocation_type": "INSTALL",
                    "invocation_status": "RUNNING",
                    "invocation_target": "telescope",
                    "current_version": "2.5.1",
                    "target_version": "2.6.1",
                    "create_time": 1678070008306,
                    "update_time": 1678070008306,
                    "result_msg": "xxx"
                  }
                ],
                "count": 1
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResp400"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorResp401"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorResp403"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorResp500"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResp": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "pattern": "^(taskmgr\\.[0-9]{4})$"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "ListInvocationsResp": {
      "properties": {
        "invocations": {
          "description": "**参数解释**:\n任务列表\n",
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/InvocationInfo"
          }
        },
        "count": {
          "type": "integer",
          "description": "**参数解释**:\n任务列表总量\n**取值范围**:\n数字范围为[0,9999999999999]\n",
          "format": "int64",
          "minimum": 0,
          "maximum": 9999999999999
        }
      }
    },
    "ErrorResp400": {
      "allOf": [
        {
          "$ref": "#/definitions/ErrorResp"
        }
      ],
      "example": {
        "error_code": "taskmgr.0005",
        "error_msg": "Some content in message body is not correct."
      }
    },
    "ErrorResp401": {
      "allOf": [
        {
          "$ref": "#/definitions/ErrorResp"
        }
      ],
      "example": {
        "error_code": "taskmgr.0003",
        "error_msg": "Authentication fails or the authentication information is not provided"
      }
    },
    "ErrorResp500": {
      "allOf": [
        {
          "$ref": "#/definitions/ErrorResp"
        }
      ],
      "example": {
        "error_code": "taskmgr.0001",
        "error_msg": "Internal service error"
      }
    },
    "ErrorResp403": {
      "allOf": [
        {
          "$ref": "#/definitions/ErrorResp"
        }
      ],
      "example": {
        "error_code": "taskmgr.0007",
        "error_msg": "The authentication information is incorrect or the service invoker does not have sufficient rights."
      }
    },
    "InvocationInfo": {
      "properties": {
        "invocation_id": {
          "description": "**参数解释**:\n任务id\n**取值范围**:\n以字母或数字开头,后续可以包含字母、数字、下划线(_)或连字符(-),长度至少为1,且不允许出现其他字符\n",
          "type": "string",
          "pattern": "^([0-9A-Za-z]){1}([0-9A-Za-z]|_|-)*$"
        },
        "instance_id": {
          "description": "**参数解释**:\n主机id\n**取值范围**:\n1到64个字符的字符串,且只包含字母、数字和连字符\n",
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]{1,64}$"
        },
        "instance_name": {
          "description": "**参数解释**:\n主机名称\n**取值范围**:\n字符串长度范围为[1,128]\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "instance_type": {
          "description": "**参数解释**:\n主机类型,仅支持ECS弹性云服务器和BMS裸金属服务器\n**取值范围**:\n- ECS: 弹性云服务器\n- BMS:裸金属服务器\n",
          "type": "string",
          "enum": [
            "ECS",
            "BMS"
          ]
        },
        "intranet_ips": {
          "type": "array",
          "description": "**参数解释**:\n内网ip列表\n",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^(([0-9]|\\.){1,15})$"
          }
        },
        "elastic_ips": {
          "type": "array",
          "description": "**参数解释**:\n弹性公网ip列表\n",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^(([0-9]|\\.){1,15})$"
          }
        },
        "invocation_type": {
          "description": "**参数解释**:\n任务类型\n**取值范围**:\n- INSTALL:安装\n- UPDATE:升级\n- ROLLBACK:回滚\n- RETRY:重试\n- SET_REMOTE_INSTALLER:设置远程安装主机\n- REMOTE_INSTALL:执行远程安装\n",
          "type": "string",
          "enum": [
            "INSTALL",
            "UPDATE",
            "ROLLBACK",
            "RETRY",
            "SET_REMOTE_INSTALLER",
            "REMOTE_INSTALL"
          ]
        },
        "invocation_status": {
          "description": "**参数解释**:\n任务状态\n**取值范围**:\n- PENDING:待执行\n- RUNNING:运行中\n- TIMEOUT:超时\n- FAILED:失败\n- SUCCEEDED:成功\n- CANCELED:取消\n- ROLLBACKED:已回退\n",
          "type": "string",
          "enum": [
            "PENDING",
            "RUNNING",
            "TIMEOUT",
            "FAILED",
            "SUCCEEDED",
            "CANCELED",
            "ROLLBACKED"
          ]
        },
        "invocation_target": {
          "description": "**参数解释**:\n任务对象, 支持telescope监控\n**取值范围**:\n- telescope: 主机监控插件telescope\n",
          "type": "string",
          "enum": [
            "telescope"
          ]
        },
        "create_time": {
          "description": "**参数解释**:\n任务创建时间\n**取值范围**:\n数字范围为[1111111111111,9999999999999]\n",
          "type": "integer",
          "format": "int64",
          "minimum": 1111111111111,
          "maximum": 9999999999999
        },
        "update_time": {
          "description": "**参数解释**:\n任务更新时间\n**取值范围**:\n数字范围为[1111111111111,9999999999999]\n",
          "type": "integer",
          "format": "int64",
          "minimum": 1111111111111,
          "maximum": 9999999999999
        },
        "current_version": {
          "type": "string",
          "description": "**参数解释**:\n当前版本\n**取值范围**:\n字符串长度范围为[1,64]\n",
          "minLength": 1,
          "maxLength": 64
        },
        "target_version": {
          "type": "string",
          "description": "**参数解释**:\n目标版本\n**取值范围**:\n字符串长度范围为[1,64]\n",
          "minLength": 1,
          "maxLength": 64
        },
        "result_msg": {
          "type": "string",
          "description": "**参数解释**:\n任务执行结果信息\n**取值范围**:\n字符串长度范围为[1,5000]\n",
          "minLength": 1,
          "maxLength": 5000
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectID": {
      "name": "project_id",
      "in": "path",
      "description": "**参数解释**:项目ID。用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。获取方式请参见“[获取项目ID](ces_03_0057.xml)”。取值范围: 字符串的长度必须在 1 到 64个字符之间。\n**约束限制**:\n不涉及\n**取值范围**:\n长度为[1,64]个字符\n**默认取值**:\n不涉及\n",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "required": true
    },
    "ContentType": {
      "name": "Content-Type",
      "in": "header",
      "description": "**参数解释**:\n发送的实体的MIME类型\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[1,64]个字符\n**默认取值**:\napplication/json; charset=UTF-8\n",
      "required": false,
      "type": "string",
      "default": "application/json; charset=UTF-8",
      "minLength": 1,
      "maxLength": 64
    },
    "ProjectAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数解释**:\n用户project Token。用户Token也就是调用获取用户Token接口的响应值,该接口是唯一不需要认证的接口。请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[1,16384]个字符\n**默认取值**:\n不涉及\n",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "Limit100": {
      "name": "limit",
      "description": "**参数解释**:\n分页大小。\n**约束限制**:\n不涉及。\n**取值范围**:\n数字范围为[1,100]\n**默认取值**:\n100\n",
      "in": "query",
      "type": "integer",
      "format": "int32",
      "minimum": 1,
      "maximum": 100,
      "default": 100
    },
    "Offset": {
      "name": "offset",
      "description": "**参数解释**:\n分页偏移量\n**约束限制**:\n不涉及\n**取值范围**:\n数字范围为[0,9999999999999]\n**默认取值**:\n0\n",
      "in": "query",
      "type": "integer",
      "format": "int64",
      "minimum": 0,
      "maximum": 9999999999999,
      "default": 0
    }
  },
  "host": "ces.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}