  "definitions": {
    "GetResourceGroupsResp": {
      "type": "object",
      "description": "**参数解释**\n资源分组列表。",
      "required": [
        "count",
        "resource_groups"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "description": "**参数解释**\n资源分组总数。\n**取值范围**\n在[0,1000]区间内。",
          "minimum": 0,
          "maximum": 1000
        },
        "resource_groups": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "description": "**参数解释**\n资源分组列表。",
          "items": {
            "$ref": "#/definitions/OneResourceGroupResp"
          }
        }
      }
    },
    "OneResourceGroupResp": {
      "required": [
        "group_id",
        "group_name",
        "create_time",
        "update_time",
        "enterprise_project_id",
        "type"
      ],
      "properties": {
        "group_name": {
          "description": "**参数解释**\n资源分组的名称。\n**取值范围**\n只能为字母、数字、汉字、-或_,长度为[1,128]个字符。",
          "type": "string",
          "pattern": "^([一-鿿]|[a-z]|[A-Z]|[0-9]|_|-){1,128}$"
        },
        "group_id": {
          "description": "**参数解释**\n资源分组ID。\n**取值范围**\n以rg开头,后跟22位由字母或数字组成的字符串。",
          "type": "string",
          "maxLength": 24,
          "minLength": 2
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释**\n资源分组的创建时间,UNIX时间戳,单位毫秒;如:1603819753000。"
        },
        "update_time": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释**\n资源分组的修改时间,UNIX时间戳,单位毫秒;如:1603819753000。"
        },
        "enterprise_project_id": {
          "description": "**参数解释**\n资源分组归属企业项目ID。\n**取值范围**\n只能包含小写字母、数字或-,长度为36个字符。或者为0,代表默认企业项目ID。",
          "type": "string",
          "pattern": "^((([a-z]|[0-9]){8}-([a-z]|[0-9]){4}-([a-z]|[0-9]){4}-([a-z]|[0-9]){4}-([a-z]|[0-9]){12})|0)$"
        },
        "type": {
          "description": "**参数解释**\n资源分组添加资源方式。\n**取值范围**\n- EPS: 表示匹配企业项目\n- TAG: 表示匹配标签\n- Manual: 表示手动添加\n- COMB: 表示组合匹配\n- NAME: 表示匹配实例名称",
          "type": "string",
          "enum": [
            "EPS",
            "TAG",
            "Manual",
            "COMB",
            "NAME"
          ]
        },
        "status": {
          "type": "string",
          "example": "health",
          "description": "**参数解释**\n资源分组指标告警状态。\n**取值范围**\n- health: 表示无告警\n- unhealthy: 表示告警中\n- no_alarm_rule: 表示未设置告警规则",
          "enum": [
            "health",
            "unhealthy",
            "no_alarm_rule"
          ]
        },
        "event_status": {
          "type": "string",
          "example": "health",
          "description": "**参数解释**\n资源分组事件告警状态。\n**取值范围**\n- health: 表示无告警\n- unhealthy: 表示告警中\n- no_alarm_rule: 表示未设置告警规则",
          "enum": [
            "health",
            "unhealthy",
            "no_alarm_rule"
          ]
        },
        "resource_statistics": {
          "type": "object",
          "description": "**参数解释**\n资源分组中的资源信息统计。",
          "properties": {
            "unhealthy": {
              "type": "integer",
              "description": "**参数解释**\n该资源分组中当前处在告警状态的资源个数。 \n**取值范围**\n在[0,9999999]区间内。",
              "minimum": 0,
              "maximum": 9999999
            },
            "total": {
              "type": "integer",
              "description": "**参数解释**\n该资源分组中资源的总个数。 \n**取值范围**\n在[0,9999999]区间内。",
              "minimum": 0,
              "maximum": 9999999
            },
            "event_unhealthy": {
              "type": "integer",
              "description": "**参数解释**\n该资源分组中已触发的资源个数。 \n**取值范围**\n在[0,9999999]区间内。",
              "minimum": 0,
              "maximum": 9999999
            },
            "namespaces": {
              "type": "integer",
              "description": "**参数解释**\n该资源分组中选择的资源类型个数,如资源分组添加了弹性云服务、弹性公网IP和带宽则值为2。\n**取值范围**\n在[0,9999999]区间内。",
              "minimum": 0,
              "maximum": 9999999
            }
          }
        },
        "related_ep_ids": {
          "type": "array",
          "description": "**参数解释**\n当资源匹配规则为匹配企业项目时,指定的企业项目列表。",
          "minItems": 0,
          "maxItems": 9999999,
          "items": {
            "type": "string",
            "description": "**参数解释**\n企业项目ID。\n**取值范围**\n由数字、字母和-组成,或者为0(默认企业项目ID)。",
            "minLength": 0,
            "maxLength": 64
          }
        },
        "association_alarm_templates": {
          "type": "array",
          "description": "**参数解释**\n关联的告警模板列表。",
          "minItems": 0,
          "maxItems": 9999999,
          "items": {
            "$ref": "#/definitions/AssociationAlarmTemplate"
          }
        },
        "resource_level": {
          "type": "string",
          "description": "**参数解释**\n资源层级,资源生效范围。\n**取值范围**\n- product: 云产品\n- dimension: 子维度",
          "enum": [
            "product",
            "dimension"
          ]
        }
      }
    },
    "AssociationAlarmTemplate": {
      "properties": {
        "template_id": {
          "description": "**参数解释**\n告警模板ID。\n**取值范围**\n以at开头,后跟字母、数字,长度在[2,64]区间内。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "template_name": {
          "description": "**参数解释**\n告警模板名称。\n**取值范围**\n以字母或汉字开头,可包含字母、数字、汉字、_、-,长度在[1,128]区间内。",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "GoAPIErrorResponseV2": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "ces.0001",
          "description": "请求异常内部业务状态码",
          "minLength": 0,
          "maxLength": 256
        },
        "error_msg": {
          "type": "string",
          "example": "the request format is invalid",
          "description": "请求异常信息",
          "minLength": 0,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "example": "txnEntry-DESKTOP-4LPFH08.txnId-466541d0-f1a6-429b-b747-98d4991671c1.ts-1637909316688.c-95",
          "description": "请求ID",
          "minLength": 0,
          "maxLength": 256
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "description": "**参数解释**:\n项目ID。用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。获取方式请参见[获取项目ID](https://support.huaweicloud.com/api-ces/ces_03_0057.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n字符串的长度必须在 1 到 64个字符之间。\n**默认取值**:\n不涉及。",
      "in": "path",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "host": "ces.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
