  "paths": {
    "/v2/{project_id}/alarm-templates": {
      "get": {
        "tags": [
          "告警模板"
        ],
        "summary": "查询告警模板列表",
        "description": "查询告警模板列表",
        "operationId": "ListAlarmTemplates",
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-version": "v2",
        "x-order": 4,
        "x-request-examples-description-1": "查询告警模板列表",
        "x-request-examples-url-1": "/v2/{project_id}/alarm-templates?offset=0&limit=100",
        "parameters": [
          {
            "$ref": "#/parameters/AuthToken"
          },
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/Offset"
          },
          {
            "$ref": "#/parameters/Limit"
          },
          {
            "name": "namespace",
            "in": "query",
            "type": "string",
            "description": "**参数解释**:\n查询服务的命名空间,各服务命名空间请参阅[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n格式为service.item;service和item必须是字符串,必须以字母开头,只能包含0-9/a-z/A-Z/_。字符串的长度必须在 3 到 32个字符之间。\n**默认取值**:\n不涉及。",
            "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*\\.([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*$",
            "minLength": 3,
            "maxLength": 32,
            "required": false
          },
          {
            "name": "dim_name",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "**参数解释**:\n资源维度名称。\n**约束限制**:\n不涉及。\n**取值范围**:\n多维度用\",\"分隔,只能包含0-9、a-z、A-Z、_、-、#、/、(、),每个维度的最大长度为32。字符串总长度最小为1,最大为131。\n**默认取值**:\n不涉及。",
            "pattern": "^([a-z]|[A-Z]|/|#|\\(|\\)){1}([a-z]|[A-Z]|[0-9]|_|-|/|#|\\(|\\)){0,31}(,([a-z]|[A-Z]|/|#|\\(|\\)){1}([a-z]|[A-Z]|[0-9]|_|-|/|#|\\(|\\)){0,31}){0,3}$",
            "minLength": 1,
            "maxLength": 131
          },
          {
            "name": "template_type",
            "in": "query",
            "description": "**参数解释**:\n模板类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n枚举值。\n- system:默认指标模板。\n- custom: 自定义指标模板。   \n- system_event: 默认事件模板。\n- custom_event: 自定义事件模板。   \n- system_custom_event: 全部事件模板。    \n**默认取值**:\n不传返回全部指标模板。",
            "required": false,
            "type": "string",
            "enum": [
              "system",
              "custom",
              "system_event",
              "custom_event",
              "system_custom_event"
            ]
          },
          {
            "name": "template_name",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "告警模板的名称,以字母或汉字开头,可包含字母、数字、汉字、_、-,长度范围[1,128],支持模糊匹配",
            "pattern": "^([\\一-\\鿿]|[a-z]|[A-Z]|[0-9]|_|-|\\(|\\)|\\.|\\s){1,128}$"
          },
          {
            "name": "product_name",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "**参数解释**:\n产品层级跨维规则创建时需要指明的规则产品名称,一般由\"服务命名空间,服务首层维度名称\"组成,如\"SYS.ECS,instance_id\"。\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[0,128]个字符。         \n**默认取值**:\n不涉及。",
            "pattern": "^(([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-|\\.){0,31}(,([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-|\\.){0,31}){0,3}|)$"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListAlarmTemplatesResp"
            },
            "examples": {
              "application/json": {
                "alarm_templates": [
                  {
                    "template_id": "at1628592157541dB1klWgY6",
                    "template_name": "my_template",
                    "template_type": "custom",
                    "create_time": "2006-01-02T15:04:05.000Z",
                    "template_description": "hello world"
                  }
                ],
                "count": 100
              }
            }
          },
          "400": {
            "description": "参数校验失败",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "401": {
            "description": "未认证",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "403": {
            "description": "认证鉴权失败",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "500": {
            "description": "系统内部错误",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "TemplateType": {
      "type": "string",
      "description": "模板类型(custom代表默认自定义模板,system代表系统模板)",
      "enum": [
        "system",
        "custom"
      ],
      "example": "custom"
    },
    "CreateTime": {
      "type": "string",
      "format": "date-time",
      "description": "**参数解释**:\n告警模板的创建时间\n**取值范围**:\n不涉及。",
      "example": "2006-01-02T15:04:05.000Z"
    },
    "TemplateDescription": {
      "type": "string",
      "description": "**参数解释**:\n告警模板的描述    \n**约束限制**:\n不涉及。\n**取值范围**:\n长度范围[0,256]。         \n**默认取值**:\n空字符串。",
      "pattern": "^([\\一-\\鿿]|[a-z]|[A-Z]|[0-9]|| |_|-|\\.|。|,|,|:|:|;|;|\"|“|”|'|‘|’)+$",
      "minLength": 0,
      "maxLength": 256,
      "example": "hello world"
    },
    "TemplateID": {
      "type": "string",
      "description": "**参数解释**:\n告警模板的ID。    \n**约束限制**:\n不涉及。\n**取值范围**:\n以at开头,后跟字母、数字,长度为[2,64]个字符。          \n**默认取值**:\n不涉及。",
      "pattern": "^at([0-9A-Za-z])+$",
      "minLength": 2,
      "maxLength": 64,
      "example": "at1628592157541dB1klWgY6"
    },
    "ListAlarmTemplatesResp": {
      "properties": {
        "alarm_templates": {
          "type": "array",
          "description": "告警模板列表",
          "items": {
            "$ref": "#/definitions/AlarmTemplates"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "count": {
          "type": "integer",
          "description": "**参数解释**:\n告警模板记录总数。\n**取值范围**:\n字符串长度在 10 到 9999999 之间。",
          "example": 100,
          "minimum": 0,
          "maximum": 9999999
        }
      },
      "required": [
        "alarm_templates",
        "count"
      ]
    },
    "AlarmTemplates": {
      "properties": {
        "template_id": {
          "$ref": "#/definitions/TemplateID"
        },
