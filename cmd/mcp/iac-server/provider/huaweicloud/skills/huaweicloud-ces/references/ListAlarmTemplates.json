        },
        "create_time": {
          "$ref": "#/definitions/CreateTime"
        },
        "template_description": {
          "$ref": "#/definitions/TemplateDescription"
        }
      },
      "required": [
        "template_id",
        "template_name",
        "template_type",
        "create_time"
      ],
      "type": "object"
    },
    "TemplateName": {
      "type": "string",
      "description": "**参数解释**:\n告警模板的名称。\n**约束限制**:\n不涉及。\n**取值范围**:\n以字母或汉字开头,可包含字母、数字、汉字、_、-,长度为[1,128]个字符。          \n**默认取值**:\n不涉及。",
      "pattern": "^([\\一-\\鿿]|[a-z]|[A-Z]|[0-9]|_|-|\\(|\\)|\\.|\\s){1,128}$",
      "example": "my_template"
    },
    "GoAPIErrorResponseV2": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "ces.0001",
          "description": "请求异常内部业务状态码",
          "minLength": 0,
          "maxLength": 256
        },
        "error_msg": {
          "type": "string",
          "example": "the request format is invalid",
          "description": "请求异常信息",
          "minLength": 0,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "example": "txnEntry-DESKTOP-4LPFH08.txnId-466541d0-f1a6-429b-b747-98d4991671c1.ts-1637909316688.c-95",
          "description": "请求ID",
          "minLength": 0,
          "maxLength": 256
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
