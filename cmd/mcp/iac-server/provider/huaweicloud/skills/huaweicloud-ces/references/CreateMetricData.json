  "definitions": {
    "MetricNameSchema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "description": "**参数解释**:\n指标ID,例如弹性云服务器的监控指标CPU使用率,对应的metric_name为cpu_util。各服务资源的指标名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。\n**约束限制**:\n不涉及。\n**取值范围**:\n必须以字母开头,只能包含0-9/a-z/A-Z/_/-;如:弹性云服务器中的监控指标cpu_util,表示弹性服务器的CPU使用率;文档数据库中的指标mongo001_command_ps,表示command执行频率。字符串长度为[1,96]。\n**默认取值**:\n不涉及。",
      "example": "cpu_util",
      "pattern": "^([A-Za-z]){1}([0-9A-Za-z]|_|-)*$"
    },
    "NamespaceSchema": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32,
      "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*\\.([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*$",
      "description": "**参数解释**\n服务命名空间,样例:弹性云服务器的命名空间为SYS.ECS。\n各服务命名空间请参阅[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)。\n**约束限制**\n不涉及\n**取值范围**\n格式为service.item,service和item以点号拼接组成。\nservice和item必须以字母(大写或小写)开头,后面可以跟零个或多个字母(大写或小写)、数字、下划线(_),长度为[3,32]个字符\n**默认取值**\n不涉及",
      "example": "SYS.ECS"
    },
    "MetricInfo": {
      "required": [
        "namespace",
        "metric_name",
        "dimensions"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/definitions/NamespaceSchema"
        },
        "metric_name": {
          "$ref": "#/definitions/MetricNameSchema"
        },
        "dimensions": {
          "$ref": "#/definitions/MetricsDimensionArray"
        }
      },
      "description": "**参数解释**:\n指标信息\n**约束限制**:\n不涉及"
    },
    "MetricsDimension": {
      "properties": {
        "name": {
          "type": "string",
          "description": "**参数解释**\n资源维度,如:弹性云服务器,则维度为instance_id;目前最大支持4个维度,各服务资源的维度名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。\n**约束限制**\n不涉及\n**取值范围**\n由字母开头,后面可以包含字母、数字、_或-,长度为[1,32]个字符\n**默认取值**\n不涉及",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-)*$"
        },
        "value": {
          "type": "string",
          "description": "**参数解释**\n资源维度值,为资源的实例ID,如:4270ff17-aba3-4138-89fa-820594c39755。\n**约束限制**\n不涉及\n**取值范围**\n长度为[1,256]个字符\n**默认取值**\n不涉及",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^([a-z]|[A-Z]|[0-9]|\\*|_|/|#|\\(|\\)){1}([a-z]|[A-Z]|[0-9]|_|-|\\.|/|#|\\(|\\))*$"
        }
      },
      "description": "指标维度",
      "required": [
        "name",
        "value"
      ]
    },
    "CreateMetricDataRequestBody": {
      "required": [
        "collect_time",
        "metric",
        "ttl",
        "value"
      ],
      "properties": {
        "metric": {
          "description": "**参数解释**:\n指标数据。\n**约束限制**:\n不涉及。",
          "$ref": "#/definitions/MetricInfo"
        },
        "ttl": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n数据的有效期,超出该有效期则自动删除该数据,单位秒。\n**约束限制**:\n不涉及。\n**取值范围**:\n大小为[1,604800]的整数。\n**默认取值**:\n不涉及。",
          "minimum": 1,
          "maximum": 604800
        },
        "collect_time": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**:\n数据收集时间 。UNIX时间戳,单位毫秒。\n**约束限制**:\n不涉及。\n**取值范围**:\n因为客户端到服务器端有延时,因此插入数据的时间戳应该在[当前时间-3天+10秒,当前时间+10分钟-10秒]区间内,保证到达服务器时不会因为传输时延造成数据不能插入数据库。\n**默认取值**:\n不涉及。",
          "minimum": 1111111111111,
          "maximum": 9999999999999
        },
        "value": {
          "type": "number",
          "format": "double",
          "description": "**参数解释**:\n待添加的监控指标数据的值。\n**约束限制**:\n不涉及。\n**取值范围**:\n数值类型支持“整数”或“浮点数”。\n**默认取值**:\n不涉及。"
        },
        "unit": {
          "type": "string",
          "description": "**参数解释**:\n数据的单位。\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[0,32]个字符。\n**默认取值**:\n不涉及。",
          "minLength": 0,
          "maxLength": 32
        },
        "type": {
          "type": "string",
          "description": "**参数解释**:\n数据类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n枚举值,只能是\"int\"或\"float\"。\n- int:整数\n- float:浮点数\n**默认取值**:\n不涉及。",
          "pattern": "^(int|float)$",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "description": "添加一条或多条自定义指标监控数据,请求参数。"
    },
    "MetricsDimensionArray": {
      "type": "array",
      "minLength": 1,
      "maxLength": 4,
      "items": {
        "$ref": "#/definitions/MetricsDimension"
      },
      "description": "**参数解释**\n指标维度\n**约束限制**\n包含的指标维度对象个数为[1,4]"
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "**参数解释**:\n项目ID。用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。获取方式请参见[获取项目ID](https://support.huaweicloud.com/api-ces/ces_03_0057.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[1,64]个字符。\n**默认取值**:\n不涉及。",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "host": "ces.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}