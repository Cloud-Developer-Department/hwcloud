  "definitions": {
    "EventInfoDetailResp": {
      "description": "一条事件监控详细信息",
      "allOf": [
        {
          "$ref": "#/definitions/ShowEventItemResp"
        },
        {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "description": "**参数解释**:\n事件ID。\n**取值范围**:\n不涉及。",
              "minLength": 1,
              "maxLength": 9999
            }
          }
        }
      ]
    },
    "ListEventDetailResponseBody": {
      "description": "根据事件名称查询返回的事件详情响应体。",
      "properties": {
        "event_name": {
          "type": "string",
          "description": "**参数解释**:\n事件名称,值为系统产生的事件名称,或用户自定义上报的事件名称。\n**取值范围**:\n不涉及。",
          "minLength": 1,
          "maxLength": 9999
        },
        "event_type": {
          "type": "string",
          "description": "**参数解释**:\n事件类型。\n**取值范围**:\n值为EVENT.SYS或EVENT.CUSTOM。\n- EVENT.SYS: 系统事件。\n- EVENT.CUSTOM: 自定义事件。",
          "enum": [
            "EVENT.SYS",
            "EVENT.CUSTOM"
          ]
        },
        "sub_event_type": {
          "type": "string",
          "description": "**参数解释**:\n事件子类。\n**取值范围**:\n枚举类型。\n当事件类型为系统事件时,参数值为SUB_EVENT.OPS或SUB_EVENT.PLAN。\n当事件类型为自定义事件时,参数值为SUB_EVENT.CUSTOM。\n- SUB_EVENT.OPS:运维事件。\n- SUB_EVENT.PLAN:计划事件。\n- SUB_EVENT.CUSTOM:自定义事件。",
          "enum": [
            "SUB_EVENT.OPS",
            "SUB_EVENT.PLAN",
            "SUB_EVENT.CUSTOM"
          ]
        },
        "event_users": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 9999
          },
          "description": "**参数解释**:\n上报事件时用户的名称,也可能为projectID。\n**取值范围**:\n不涉及。",
          "minItems": 1,
          "maxItems": 999999
        },
        "event_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 9999
          },
          "description": "**参数解释**:\n事件来源。\n如果是系统事件则值为各服务的命名空间,可查看支持监控的服务列表。如果是自定义事件,则为用户自定义上报定义。\n**取值范围**:\n不涉及。",
          "minItems": 1,
          "maxItems": 999999
        },
        "event_info": {
          "type": "array",
          "description": "**参数解释**:\n一条或者多条事件详细信息。",
          "minItems": 1,
          "maxItems": 999999,
          "items": {
            "$ref": "#/definitions/EventInfoDetailResp"
          }
        },
        "meta_data": {
          "description": "**参数解释**:\n查询结果元数据统计个数。",
          "$ref": "#/definitions/TotalMetaData"
        }
      }
    },
    "MetricsDimensionResp": {
      "properties": {
        "name": {
          "type": "string",
          "description": "**参数解释**\n资源维度,如:弹性云服务器,则维度为instance_id;目前最大支持4个维度,各服务资源的维度名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。\n**取值范围**\n由字母开头,后面可以包含字母、数字、_或-,长度为[1,32]个字符",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-)*$"
        },
        "value": {
          "type": "string",
          "description": "**参数解释**\n资源维度值,为资源的实例ID,如:4270ff17-aba3-4138-89fa-820594c39755。\n**取值范围**\n长度为[1,256]个字符",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^([a-z]|[A-Z]|[0-9]|\\*|_|/|#|\\(|\\)){1}([a-z]|[A-Z]|[0-9]|_|-|\\.|/|#|\\(|\\))*$"
        }
      },
      "description": "**参数解释**\n指标维度响应体"
    },
    "ShowEventItemResp": {
      "required": [
        "detail",
        "event_name",
        "event_source",
        "time"
      ],
      "properties": {
        "event_name": {
          "type": "string",
          "description": "**参数解释**:\n事件名称。\n**取值范围**:\n必须以字母开头,只能包含0-9/a-z/A-Z/_,长度为[1,64]个字符。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*$"
        },
        "event_source": {
          "type": "string",
          "description": "**参数解释**:\n事件来源。\n**取值范围**:\n格式为service.item。service和item必须是字符串,必须以字母开头,只能包含0-9/a-z/A-Z/_,长度为[3,32]个字符。",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*$"
        },
        "time": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**:\n事件发生时间。UNIX时间戳,单位毫秒。\n**取值范围**:\n因为客户端到服务器端有延时,因此插入数据的时间戳应该在[当前时间-1小时+20秒,当前时间+10分钟-20秒]区间内,保证到达服务器时不会因为传输时延造成数据不能插入数据库。",
          "minimum": 0,
          "maximum": 99999999999999
        },
        "detail": {
          "description": "**参数解释**:\n事件详情。",
          "$ref": "#/definitions/ShowEventItemDetailResp"
        }
      },
      "description": "请求参数。"
    },
    "TotalMetaData": {
      "description": "**参数解释**:\n查询结果元数据统计个数。",
      "properties": {
        "total": {
          "type": "integer",
          "description": "**参数解释**:\n总条数。\n**取值范围**:\n在[0,2147483647]区间内。",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "ShowEventItemDetailResp": {
      "properties": {
        "content": {
          "type": "string",
          "description": "**参数解释**:\n事件内容。\n**取值范围**:\n长度为[1,4096]个字符。",
          "minLength": 1,
          "maxLength": 4096
        },
        "group_id": {
          "type": "string",
          "description": "**参数解释**:\n所属分组。\n**取值范围**:\n长度只能为24个字符。",
          "minLength": 24,
          "maxLength": 24
        },
        "resource_id": {
          "type": "string",
          "description": "**参数解释**:\n资源ID。\n**取值范围**:\n长度为[1,128]个字符。",
          "minLength": 1,
          "maxLength": 128
        },
        "resource_name": {
          "type": "string",
          "description": "**参数解释**:\n资源名称。\n**取值范围**:\n长度为[1,128]个字符。",
          "minLength": 1,
          "maxLength": 128
        },
        "event_state": {
          "type": "string",
          "description": "**参数解释**:\n事件状态。\n**取值范围**:\n枚举类型:normal\\warning\\incident。\n- normal: 正常\n- warning: 警告\n- incident: 故障",
          "enum": [
            "normal",
            "warning",
            "incident"
          ]
        },
        "event_level": {
          "type": "string",
          "description": "**参数解释**:\n事件级别。\n**取值范围**:\n枚举类型:Critical, Major, Minor, Info。\n- Critical: 紧急\n- Major: 重要\n- Minor: 次要\n- Info: 提示",
          "enum": [
            "Critical",
            "Major",
            "Minor",
            "Info"
          ]
        },
        "event_user": {
          "type": "string",
          "description": "**参数解释**:\n事件用户。\n**取值范围**:\n下划线、横线、斜杠、@ 符号或点号组成,长度为[0,64]个字符。",
          "minLength": 0,
          "maxLength": 64,
          "pattern": "([a-z]|[A-Z]|_|-|/|@|\\.){0,64}"
        },
        "event_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 9999,
          "description": "**参数解释**:\n事件类型。\n**取值范围**:\n枚举类型:EVENT.SYS,EVENT.CUSTOM\n- EVENT.SYS: 系统事件。\n- EVENT.CUSTOM: 自定义事件。"
        },
        "sub_event_type": {
          "type": "string",
          "description": "**参数解释**:\n事件子类。\n**取值范围**:\n枚举类型。\n当事件类型为系统事件时,参数值为SUB_EVENT.OPS或SUB_EVENT.PLAN。\n当事件类型为自定义事件时,参数值为SUB_EVENT.CUSTOM。\n- SUB_EVENT.OPS:运维事件。\n- SUB_EVENT.PLAN:计划事件。\n- SUB_EVENT.CUSTOM:自定义事件。",
          "enum": [
            "SUB_EVENT.OPS",
            "SUB_EVENT.PLAN",
            "SUB_EVENT.CUSTOM"
          ]
        },
        "dimensions": {
          "type": "array",
          "description": "**参数解释**:\n事件的维度,根据维度描述资源信息。\n用于指定资源、资源分组的事件告警场景中,支持按维度配置告警规则。\n**取值范围**:\n目前最大支持4个维度",
          "items": {
            "$ref": "#/definitions/MetricsDimensionResp"
          }
        }
      },
      "description": ""
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
