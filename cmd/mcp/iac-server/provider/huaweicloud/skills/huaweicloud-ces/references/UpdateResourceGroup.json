  "definitions": {
    "ResourceGroupTagRelation": {
      "type": "object",
      "description": "**参数解释**\n标签的匹配规则\n**约束限制**\n不涉及",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/definitions/TMSKey"
        },
        "operator": {
          "type": "string",
          "description": "**参数解释**\ntag操作符,含义是标签key与value的关系\n**约束限制**\n不涉及\n**取值范围**\n- include: 表示包含\n- prefix: 表示前缀\n- suffix: 表示后缀\n- notInclude: 表示不包含\n- equal: 表示相等,当operator为equal,value为空字符串时表示为全部\n- all: 表示全部\n**默认取值**\n不涉及",
          "enum": [
            "include",
            "prefix",
            "suffix",
            "notInclude",
            "equal",
            "all"
          ]
        },
        "value": {
          "$ref": "#/definitions/TMSValue"
        }
      }
    },
    "TMSKey": {
      "type": "string",
      "description": "**参数解释**\nTMS标签键规范\n**约束限制**\n不涉及\n**取值范围**\n长度为[1,128]个字符\n**默认取值**\n不涉及",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)(?<!\\s)$"
    },
    "CombRelation": {
      "required": [
        "logical_operator",
        "conditions"
      ],
      "description": "**参数解释**\n组合匹配参数。\n**约束限制**\n不涉及。",
      "properties": {
        "logical_operator": {
          "type": "string",
          "description": "**参数解释**\n逻辑运算符。\n**约束限制**\n不涉及。\n**取值范围**\n- ALL: 所有条件匹配成功。\n- ANY: 任意条件匹配成功。\n**默认取值**\n不涉及。",
          "enum": [
            "ALL",
            "ANY"
          ]
        },
        "conditions": {
          "type": "array",
          "description": "**参数解释**\n组合匹配资源分组的匹配条件。\n**约束限制**\n不超过50个条件。",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/Condition"
          }
        }
      }
    },
    "EnterpriseProjectIdAndTags": {
      "type": "object",
      "description": "**参数解释**\n企业项目Id或标签信息\n**约束限制**\n不涉及",
      "properties": {
        "enterprise_project_id": {
          "type": "string",
          "description": "**参数解释**\n企业项目ID\n**约束限制**\n不涉及\n**取值范围**\n由字母、数字、_和-组成,长度为[1,128]个字符\n**默认取值**\n不涉及",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^([a-z]|[A-Z]|[0-9]|_|-)+$"
        },
        "tag": {
          "$ref": "#/definitions/ResourceGroupTagRelation"
        }
      }
    },
    "GoAPIErrorResponseV2": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "ces.0001",
