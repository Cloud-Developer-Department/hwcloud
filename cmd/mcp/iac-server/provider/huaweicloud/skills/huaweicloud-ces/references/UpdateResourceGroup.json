        }
      }
    },
    "PutResourceGroupReq": {
      "type": "object",
      "description": "**参数解释**\n资源分组修改请求体",
      "required": [
        "group_name"
      ],
      "properties": {
        "group_name": {
          "type": "string",
          "description": "**参数解释**\n资源分组名称。\n**约束限制**\n不涉及。\n**取值范围**\n包含字母、数字、_、-或汉字,长度为[1,128]个字符。\n**默认取值**\n不涉及。",
          "example": "test",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^([一-鿿]|[a-z]|[A-Z]|[0-9]|_|-){1,128}$"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
