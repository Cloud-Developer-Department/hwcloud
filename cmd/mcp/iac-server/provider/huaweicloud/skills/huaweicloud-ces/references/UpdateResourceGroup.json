          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/ExtendRelationId"
          }
        },
        "instances": {
          "type": "array",
          "description": "**参数解释**\n实例名称匹配参数。\n**约束限制**\ntype为NAME时必传,不超过50个实例。",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/Instance"
          }
        },
        "product_names": {
          "type": "string",
          "description": "**参数解释**\n资源层级为云产品时的云产品名称\n**约束限制**\n不涉及。\n**取值范围**\n一般由\"服务命名空间,服务首层维度名称\"组成,如\"SYS.ECS,instance_id\"。多个云产品则用“;”隔开,如\"SERVICE.BMS,instance_id;SYS.ECS,instance_id\"。不超过10240个字符。\n**默认取值**\n不涉及。",
          "minLength": 0,
          "maxLength": 10240
        },
        "comb_relation": {
          "$ref": "#/definitions/CombRelation"
        }
      }
    },
    "ExtendRelationId": {
      "type": "string",
      "description": "**参数解释**\n关联企业项目ID。\n**约束限制**\n不涉及。\n**取值范围**\n只能包含字母、数字、和-,长度为36个字符;或者为0,代表默认企业项目\n**默认取值**\n不涉及。",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^([a-z]|[A-Z]|[0-9]|_|-)+$"
    },
    "Condition": {
      "type": "object",
      "description": "**参数解释**\n匹配条件\n**约束限制**\n不涉及",
      "properties": {
        "enterprise_project_id": {
          "description": "**参数解释**\n企业项目ID\n**约束限制**\n不涉及\n**取值范围**\n由数字、字母和-组成,或者为0(默认企业项目ID)\n**默认取值**\n不涉及",
          "type": "string",
          "pattern": "^((([a-z]|[0-9]){8}-([a-z]|[0-9]){4}-([a-z]|[0-9]){4}-([a-z]|[0-9]){4}-([a-z]|[0-9]){12})|0)$"
        },
        "instance_name": {
          "$ref": "#/definitions/CombResourceName"
        },
        "tag": {
          "$ref": "#/definitions/ResourceGroupTagRelation"
        }
      }
    },
    "TMSValue": {
      "type": "string",
      "description": "**参数解释**\nTMS标签值规范\n**约束限制**\n不涉及\n**取值范围**\n长度为[0,255]个字符\n**默认取值**\n不涉及",
      "minLength": 0,
      "maxLength": 255,
      "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$"
    },
    "CombResourceName": {
      "description": "资源名称匹配规则",
      "required": [
        "operator"
      ],
      "properties": {
        "resource_name": {
          "type": "string",
          "description": "**参数解释**\n资源名称条件值\n**约束限制**\n不涉及\n**取值范围**\n长度[1,128]个字符\n**默认取值**\n不涉及",
          "minLength": 1,
          "maxLength": 128
        },
        "operator": {
          "type": "string",
          "description": "**参数解释**\n实例操作符,含义是真实资源的名称与资源名称条件值的运算关系。\n**约束限制**\n不涉及\n**取值范围**\n- include: 表示包含\n- prefix: 表示前缀\n- suffix: 表示后缀\n- notInclude: 表示不包含\n- equal: 表示相等\n**默认取值**\n不涉及",
          "enum": [
            "include",
            "prefix",
            "suffix",
            "notInclude",
            "equal"
          ]
        },
        "resource_name_is_ignore_case": {
          "type": "boolean",
          "description": "**参数解释**\n资源名称忽略大小写\n**约束限制**\n不涉及\n**取值范围**\n- true: 名称忽略大小写\n- false: 名称不忽略大小写\n**默认取值**\nfalse"
        }
      }
    },
    "Instance": {
      "type": "object",
      "description": "**参数解释**\n资源名称匹配参数\n**约束限制**\n不涉及",
      "required": [
        "product_name",
        "logical_operator",
        "instance_names"
      ],
      "properties": {
        "product_name": {
          "type": "string",
          "description": "**参数解释**\n云产品名称\n**约束限制**\n不涉及\n**取值范围**\n长度为[0,128]个字符\n**默认取值**\n不涉及",
          "minLength": 0,
          "maxLength": 128
        },
        "logical_operator": {
          "type": "string",
          "description": "**参数解释**\n逻辑运算符\n**约束限制**\n不涉及\n**取值范围**\n- ALL: 所有条件匹配成功\n- ANY: 任意条件匹配成功\n**默认取值**\n不涉及",
          "enum": [
            "ALL",
            "ANY"
          ]
        },
        "instance_names": {
          "type": "array",
          "description": "**参数解释**\n资源名称匹配参数数组\n**约束限制**\n不超过10个名称",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/ResourceNameItem"
          }
        }
      }
