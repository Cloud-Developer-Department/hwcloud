          "description": "请求ID",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "ResourceNameItem": {
      "description": "资源名称",
      "required": [
        "operator"
      ],
      "properties": {
        "resource_name": {
          "type": "string",
          "description": "**参数解释**\n资源名称条件值\n**约束限制**\n不涉及\n**取值范围**\n长度[0,128]个字符\n**默认取值**\n不涉及",
          "minLength": 0,
          "maxLength": 128
        },
        "operator": {
          "type": "string",
          "description": "**参数解释**\n实例操作符,含义是真实资源的名称与资源名称条件值的运算关系。\n**约束限制**\n不涉及\n**取值范围**\n- include: 表示包含\n- prefix: 表示前缀\n- suffix: 表示后缀\n- notInclude: 表示不包含\n- equal: 表示相等\n- all: 表示全部\n**默认取值**\n不涉及",
          "enum": [
            "include",
            "prefix",
            "suffix",
            "notInclude",
            "equal",
            "all"
          ]
        },
