  "definitions": {
    "InstanceStatistics": {
      "description": "**参数解释**:\n资源分组中的资源信息统计。",
      "properties": {
        "unhealth": {
          "type": "integer",
          "description": "**参数解释**:\n该资源分组中当前处在告警状态的资源个数。 \n**取值范围**:\n在[0,2147483647]区间内。",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647
        },
        "total": {
          "type": "integer",
          "description": "**参数解释**:\n该资源分组中资源的总个数。 \n**取值范围**:\n在[0,2147483647]区间内。",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647
        },
        "type_statistics": {
          "type": "integer",
          "description": "**参数解释**:\n该资源分组中选择的资源类型个数,如资源分组添加了弹性云服务、弹性公网IP和带宽则值为2。\n**取值范围**:\n在[0,2147483647]区间内。",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "ListResourceGroupResponseBody": {
      "description": "**参数解释**:\n查询所有资源分组响应体。",
      "properties": {
        "resource_groups": {
          "type": "array",
          "description": "**参数解释**:\n一个或者多个资源分组信息。",
          "minItems": 0,
          "maxItems": 999999,
          "items": {
            "$ref": "#/definitions/ResourceGroupInfo"
          }
        },
        "meta_data": {
          "$ref": "#/definitions/TotalMetaData"
        }
      }
    },
    "ResourceGroupInfo": {
      "description": "**参数解释**\n资源分组信息。",
      "properties": {
        "group_name": {
          "type": "string",
          "description": "**参数解释**\n资源分组名称。\n**取值范围**\n包含字母、数字、_、-或汉字,长度为[1,128]个字符。",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "description": "**参数解释**\n资源添加/匹配方式。\n**取值范围**\n取值只能为EPS(匹配企业项目),TAG(匹配标签),NAME(匹配实例名称),COMB(组合匹配),Manual/空值(手动添加)。",
          "minLength": 1,
          "maxLength": 32
        },
        "relation_ids": {
          "description": "**参数解释**\n企业项目ID列表。",
          "type": "array",
          "items": {
            "description": "**参数解释**\n企业项目ID。\n**取值范围**\n由数字、字母和-组成,或者为0(默认企业项目ID)。",
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 50
        },
        "group_id": {
          "type": "string",
          "description": "**参数解释**:\n资源分组ID。 \n**取值范围**:\n以rg开头,后跟22位由字母或数字组成的字符串。长度为[2,24]个字符。",
          "minLength": 1,
          "maxLength": 128
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**\n资源分组的创建时间,UNIX时间戳,单位毫秒;如:1603819753000。\n**取值范围**\n在[0,9223372036854775807]区间内",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "instance_statistics": {
          "$ref": "#/definitions/InstanceStatistics"
        },
        "status": {
          "$ref": "#/definitions/StatusSchemaResp"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "**参数解释**\n资源分组归属企业项目ID。\n**取值范围**\n由数字、字母和-组成,或者为0(默认企业项目ID)。",
          "pattern": "^([a-z]|[0-9]){8}-([a-z]|[0-9]){4}-([a-z]|[0-9]){4}-([a-z]|[0-9]){4}-([a-z]|[0-9]){12}$|0|all_granted_eps"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Resource"
          },
          "description": "**参数解释**\n一组或者多个资源信息,默认为空。",
          "minItems": 0,
          "maxItems": 20
        }
      }
    },
    "Resource": {
      "type": "object",
      "description": "**参数解释**:\n资源信息",
      "properties": {
        "relation_id": {
          "type": "string",
          "description": "**参数解释**:\n告警规则的ID或者资源分组ID。\n**取值范围**:\n不涉及"
        },
        "namespace": {
          "type": "string",
          "description": "**参数解释**:\n服务指标命名空间。\n**取值范围**:\n不涉及"
        },
        "dimensions": {
          "type": "array",
          "description": "**参数解释**\n指标维度信息",
          "items": {
            "$ref": "#/definitions/DimensionResp"
          }
        },
        "status": {
          "type": "string",
          "description": "**参数解释**\n资源健康状态\n**取值范围**\n- health: 表示无告警\n- unhealth: 表示告警中\n- no_alarm_rule: 表示未设置告警规则",
          "enum": [
            "health",
            "unhealth",
            "no_alarm_rule"
          ],
          "example": "health"
        }
      }
    },
    "StatusSchemaResp": {
      "type": "string",
      "description": "**参数解释**\n资源分组健康状态\n**取值范围**\n- health: 表示无告警\n- unhealth: 表示告警中\n- no_alarm_rule: 表示未设置告警规则",
      "enum": [
        "health",
        "unhealth",
        "no_alarm_rule"
      ],
      "example": "health"
    },
    "DimensionResp": {
      "description": "**参数解释**:\n指标维度。",
      "properties": {
        "name": {
          "description": "**参数解释**:\n监控维度名称,如ECS的维度为instance_id。各服务资源的维度名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。\n**取值范围**:\n以字母开头,只能包含字母、数字、“_”、“-”。长度[1,32]个字符。",
          "type": "string",
          "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-)*$",
          "minLength": 1,
          "maxLength": 32,
          "example": "instance_id"
        },
        "value": {
          "description": "**参数解释**:\n监控维度取值,例如ECS的ID。\n**取值范围**:\n长度为[0,256]个字符。",
          "type": "string",
          "pattern": "^((([a-z]|[A-Z]|[0-9]|\\*|_){1}([a-z]|[A-Z]|[0-9]|_|-|\\.)*)|)$",
          "example": "33328f02-3814-422e-b688-bfdba93d4052",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "TotalMetaData": {
      "description": "**参数解释**:\n查询结果元数据统计个数。",
      "properties": {
        "total": {
          "type": "integer",
          "description": "**参数解释**:\n总条数。\n**取值范围**:\n在[0,2147483647]区间内。",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    }
  },
