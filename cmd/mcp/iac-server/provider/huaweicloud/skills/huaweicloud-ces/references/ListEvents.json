        "latest_occur_time": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**\n此事件最近一次发生的时间\n**取值范围**\n不涉及",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "latest_event_source": {
          "type": "string",
          "description": "**参数解释**\n事件来源,如果是系统事件则值为各服务的命名空间。\n各服务命名空间请参阅[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)。如果是自定义事件,则为用户自定义上报定义。\n**取值范围**\n不涉及",
          "minLength": 1,
          "maxLength": 9999
        }
      }
    },
    "TotalMetaData": {
      "description": "**参数解释**:\n查询结果元数据统计个数。",
      "properties": {
        "total": {
          "type": "integer",
          "description": "**参数解释**:\n总条数。\n**取值范围**:\n在[0,2147483647]区间内。",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
