        "event_type": {
          "type": "string",
          "enum": [
            "EVENT.SYS",
            "EVENT.CUSTOM"
          ],
          "description": "**参数解释**\n事件类型\n**取值范围**\n枚举值:\n- EVENT.SYS 系统事件\n- EVENT.CUSTOM 自定义事件"
        },
        "sub_event_type": {
          "type": "string",
          "description": "**参数解释**\n事件子类型\n**取值范围**\n枚举值:\n- SUB_EVENT.OPS 运维事件\n- SUB_EVENT.PLAN 计划事件\n- SUB_EVENT.CUSTOM 自定义事件",
