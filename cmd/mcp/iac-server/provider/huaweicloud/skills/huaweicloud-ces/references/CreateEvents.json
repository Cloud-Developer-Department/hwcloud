  "definitions": {
    "CreateEventsResponseBody": {
      "type": "array",
      "description": "事件响应体",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "$ref": "#/definitions/Event"
      }
    },
    "Event": {
      "required": [
        "event_id",
        "event_name"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "description": "**参数解释**:\n事件ID。\n**取值范围**:\n不涉及。",
          "minLength": 1,
          "maxLength": 9999
        },
        "event_name": {
          "type": "string",
          "description": "**参数解释**:\n事件名称。\n**取值范围**:\n不涉及。",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "description": "响应参数。"
    },
    "MetricsDimension": {
      "properties": {
        "name": {
          "type": "string",
          "description": "**参数解释**\n资源维度,如:弹性云服务器,则维度为instance_id;目前最大支持4个维度,各服务资源的维度名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。\n**约束限制**\n不涉及\n**取值范围**\n由字母开头,后面可以包含字母、数字、_或-,长度为[1,32]个字符\n**默认取值**\n不涉及",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-)*$"
        },
        "value": {
          "type": "string",
          "description": "**参数解释**\n资源维度值,为资源的实例ID,如:4270ff17-aba3-4138-89fa-820594c39755。\n**约束限制**\n不涉及\n**取值范围**\n长度为[1,256]个字符\n**默认取值**\n不涉及",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^([a-z]|[A-Z]|[0-9]|\\*|_|/|#|\\(|\\)){1}([a-z]|[A-Z]|[0-9]|_|-|\\.|/|#|\\(|\\))*$"
        }
      },
      "description": "指标维度",
      "required": [
        "name",
        "value"
      ]
    },
    "EventItemDetail": {
      "properties": {
        "content": {
          "type": "string",
          "description": "**参数解释**:\n事件内容\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[0,4096]个字符。\n**默认取值**:\n不涉及。",
          "minLength": 0,
          "maxLength": 4096
        },
        "group_id": {
          "type": "string",
          "description": "**参数解释**:\n所属分组。\n资源分组对应的ID,必须是已存在的分组ID。\n分组ID查询方法:\n1.登录管理控制台。\n2.单击“云监控服务”。\n3.单击页面左侧的“资源分组”。\n在名称/ID列获取具体资源分组ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n长度只能为24个字符。\n**默认取值**:\n不涉及。",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^rg([a-z]|[A-Z]|[0-9]){22}$"
        },
        "resource_id": {
          "type": "string",
          "description": "**参数解释**:\n资源ID。\n资源ID的查询方法:\n1.登录管理控制台。\n2.单击“计算 > 弹性云服务器”。\n在资源概览页可获取具体资源ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n支持字母、数字、下划线(_)、中划线(-)和冒号(:),最大长度128个字符。例如,6a69bf28-ee62-49f3-9785-845dacd799ec。\n**默认取值**:\n不涉及。",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^([a-z]|[A-Z]|[0-9]|_|-|:|/|#|\\(|\\)|)+$"
        },
        "resource_name": {
          "type": "string",
          "description": "**参数解释**:\n资源名称。\n**约束限制**:\n不涉及。\n**取值范围**:\n支持字母 中文 数字@_ -. ,最大长度128个字符。\n**默认取值**:\n不涉及。",
          "minLength": 0,
          "maxLength": 128
        },
        "event_state": {
          "type": "string",
          "description": "**参数解释**:\n事件状态。\n**约束限制**:\n不涉及。\n**取值范围**:\n枚举类型。\n- normal:正常发生\n- warning:异常\n- incident:严重\n**默认取值**:\n不涉及。",
          "enum": [
            "normal",
            "warning",
            "incident"
          ]
        },
        "event_level": {
          "type": "string",
          "description": "**参数解释**:\n事件级别。\n**约束限制**:\n不涉及。\n**取值范围**:\n枚举类型:Critical, Major, Minor, Info。\n- Critical: 紧急\n- Major: 重要\n- Minor: 次要\n- Info: 提示\n**默认取值**:\n不涉及。",
          "enum": [
            "Critical",
            "Major",
            "Minor",
            "Info"
          ]
        },
        "event_user": {
          "type": "string",
          "description": "**参数解释**:\n事件用户。\n**约束限制**:\n不涉及。\n**取值范围**:\n支持字母 数字_ -/空格 ,长度为[0,64]个字符。\n**默认取值**:\n不涉及。",
          "minLength": 0,
          "maxLength": 64,
          "pattern": "^([a-z]|[A-Z]|[0-9]|_|-|\\/| |@|\\.|)+$"
        },
        "event_type": {
          "type": "string",
          "description": "**参数解释**:\n事件类型。\n**约束限制**:\nEVENT.SYS为系统事件,用户自己不能上报系统事件,只能传EVENT.CUSTOM。\n**取值范围**:\n枚举类型,EVENT.SYS或EVENT.CUSTOM。\n- EVENT.SYS:系统事件\n- EVENT.CUSTOM:自定义事件\n**默认取值**:\n不涉及。",
          "enum": [
            "EVENT.SYS",
            "EVENT.CUSTOM"
          ]
        },
        "sub_event_type": {
          "type": "string",
          "description": "**参数解释**:\n事件子类。\n**约束限制**:\n不涉及。\n**取值范围**:\n枚举类型\n- SUB_EVENT.OPS: 运维事件\n- SUB_EVENT.PLAN: 计划事件\n- SUB_EVENT.CUSTOM: 自定义事件\n**默认取值**:\n不涉及。",
          "enum": [
            "SUB_EVENT.OPS",
            "SUB_EVENT.PLAN",
            "SUB_EVENT.CUSTOM"
          ]
        },
        "dimensions": {
          "type": "array",
          "description": "**参数解释**:\n事件的维度,根据维度描述资源信息。\n用于指定资源、资源分组的事件告警场景中,支持按维度配置告警规则。\n**约束限制**:\n目前最大支持4个维度。",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/MetricsDimension"
          }
        }
      },
      "description": ""
    },
    "CreateEventsRequestBody": {
      "required": [
        "detail",
        "event_name",
        "event_source",
        "time"
      ],
      "properties": {
        "event_name": {
          "type": "string",
          "description": "**参数解释**:\n事件名称。\n**约束限制**:\n不涉及。\n**取值范围**:\n必须以字母开头,只能包含0-9/a-z/A-Z/_,长度为[1,64]个字符。\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*$"
        },
        "event_source": {
          "type": "string",
          "description": "**参数解释**:\n事件来源。\n**约束限制**:\n不涉及。\n**取值范围**:\n格式为service.item,根据实际情况自定义配置。\nservice和item必须是字符串,必须以字母开头,只能包含0-9/a-z/A-Z/_,service.item,长度为[3,32]个字符。\n**默认取值**:\n不涉及。",
          "minLength": 0,
          "maxLength": 32,
          "pattern": "^((([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*\\.([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*)|)$"
        },
        "time": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**:\n事件发生时间。UNIX时间戳,单位毫秒。\n**约束限制**:\n因为客户端到服务器端有延时,因此插入数据的时间戳应该在[当前时间-1小时+10秒,当前时间+10分钟-10秒]区间内,保证到达服务器时不会因为传输时延造成数据不能插入数据库。\n**取值范围**:\n插入数据的时间戳应该在[当前时间-1小时+10秒,当前时间+10分钟-10秒]区间内。\n**默认取值**:\n不涉及。",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "detail": {
          "description": "**参数解释**:\n事件详情。\n**约束限制**:\n不涉及。",
          "$ref": "#/definitions/EventItemDetail"
        }
      },
      "description": "请求参数。"
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "**参数解释**:\n项目ID。用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。获取方式请参见[获取项目ID](https://support.huaweicloud.com/api-ces/ces_03_0057.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[1,64]个字符。\n**默认取值**:\n不涉及。",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ContentType": {
      "name": "Content-Type",
      "in": "header",
      "required": false,
      "description": "**参数解释**:\n发送的实体的MIME类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[1,64]个字符。\n**默认取值**:\n默认使用 application/json; charset=UTF-8,如果API是对象、镜像上传等接口,媒体类型可按照流类型的不同进行确定。",
      "type": "string",
      "default": "application/json; charset=UTF-8",
      "minLength": 1,
      "maxLength": 64,
      "x-order": 1
    },
    "AuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": false,
      "description": "**参数解释**:\n用户Token。\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[1,16384]个字符。\n**默认取值**:\n不涉及。",
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "x-order": 2
    }
  },
  "host": "ces.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}