  "definitions": {
    "MetricDimensionSchema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 131,
      "description": "**参数解释**:\n资源维度信息, 多维度逗号分隔。\n**约束限制**:\n不涉及。\n**取值范围**:\n必须以字母开头,只能包含0-9/a-z/A-Z/_/-/,。每个维度必须以字母开头,每个维度长度最短1,最长32,多个维度直接用,分隔。\n**默认取值**:\n不涉及。",
      "example": "instance_id,disk",
      "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-){0,31}(,([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-){0,31}){0,3}$"
    },
    "DimNameResp": {
      "type": "string",
      "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-)*$",
      "minLength": 1,
      "maxLength": 32,
      "description": "**参数解释**:\n资源维度名称\n**取值范围**:\n最小长度1,最大长度32",
      "example": "instance_id"
    },
    "MetricDataPoint": {
      "type": "object",
      "description": "**参数解释**:\n监控数据点",
      "properties": {
        "dimensions": {
          "type": "array",
          "description": "**参数解释**:\n维度信息",
          "maxItems": 4,
          "minItems": 1,
          "items": {
            "description": "**参数解释**:\n资源维度",
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "$ref": "#/definitions/DimNameResp"
              },
              "value": {
                "$ref": "#/definitions/DimValueResp"
              },
              "origin_value": {
                "$ref": "#/definitions/OriginValueResp"
              }
            }
          }
        },
        "timestamp": {
          "$ref": "#/definitions/TimeStampResp"
        },
        "value": {
          "type": "number",
          "format": "double",
          "description": "**参数解释**:\n指标值\n**取值范围**:\n不涉及"
        },
        "unit": {
          "$ref": "#/definitions/UnitResp"
        }
      }
    },
    "BatchListSpecifiedMetricDataRequestBody": {
      "type": "object",
      "description": "***参数解释***\n批量查询指标数据请求体\n***约束限制***\n不涉及",
      "required": [
        "namespace",
        "metric_name",
        "metric_dimension"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/definitions/NamespaceSchema"
        },
        "metric_name": {
          "$ref": "#/definitions/MetricNameSchema"
        },
        "metric_dimension": {
          "$ref": "#/definitions/MetricDimensionSchema"
        },
        "from": {
          "description": "**参数解释**:\n查询监控数据的开始时间,格式为时间戳, 单位毫秒。\n**约束限制**:\nfrom必须小于to, to和from的时间间隔必须在5分钟内。\n**取值范围**:\n毫秒级时间戳为[1111111111111,9999999999999]\n**默认取值**:\n不涉及。",
          "type": "integer",
          "format": "int64",
          "minimum": 1111111111111,
          "maximum": 9999999999999,
          "example": 1732071600000
        },
        "to": {
          "description": "**参数解释**:\n查询监控数据的结束时间,格式为时间戳, 单位毫秒。\n**约束限制**:\nfrom必须小于to, to和from的时间间隔必须在5分钟内。\n**取值范围**:\n毫秒级时间戳为[1111111111111,9999999999999]\n**默认取值**:\n不涉及。",
          "type": "integer",
          "format": "int64",
          "minimum": 1111111111111,
          "maximum": 9999999999999,
          "example": 1732071900000
        },
        "limit": {
          "description": "**参数解释**:\n分页大小。\n**约束限制**:\n不涉及。\n**取值范围**:\n最小值为1,最大值为1000。\n**默认取值**:\n100。",
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 1000
        },
        "offset": {
          "description": "**参数解释**:\n分页偏移量。默认值为 0,后续传值根据前一次请求返回结果中的 `data_points` 数组长度进行累加。若某次查询结果为空,则表示已获取全量的指标数据。\n**约束限制**:\n不涉及。\n**取值范围**:\n最小值为0,最大值为9999999。\n**默认取值**:\n0。",
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 9999999
        }
      }
    },
    "MetricDimensionStrResp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 131,
      "description": "**参数解释**:\n资源维度, 多维度逗号分隔。\n**取值范围**:\n必须以字母开头,只能包含0-9/a-z/A-Z/_/-/,。每个维度必须以字母开头,每个维度长度最短1,最长32,多个维度直接用,分隔。",
      "example": "instance_id,disk",
      "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-){0,31}(,([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-){0,31}){0,3}$"
    },
    "DimValueResp": {
      "type": "string",
      "pattern": "^([a-z]|[A-Z]|[0-9]|_){1}([a-z]|[A-Z]|[0-9]|_|-|\\\\.)*$",
      "minLength": 1,
      "maxLength": 256,
