      "example": "396d6eb7578840808d4c58d21951b3be"
    },
    "UnitResp": {
      "type": "string",
      "description": "**参数解释**:\n数据的单位。   \n**取值范围**:\n长度为[0,32]个字符。",
      "example": "%",
      "minLength": 0,
      "maxLength": 32
    },
    "BatchListSpecifiedMetricDataResp": {
      "type": "object",
      "description": "***参数解释***\n批量查询指标数据返回体",
