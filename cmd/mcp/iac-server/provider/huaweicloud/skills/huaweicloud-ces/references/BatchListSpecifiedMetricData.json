      "example": "vda"
    },
    "MetricNameSchema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "**参数解释**:\n资源的监控指标名称,各服务资源的指标名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。\n**约束限制**:\n不涉及。\n**取值范围**:\n必须以字母开头,只能包含0-9/a-z/A-Z/_/-。字符长度最短为1,最大为64。如:弹性云服务器中的监控指标cpu_util,表示弹性服务器的CPU使用率;文档数据库中的指标mongo001_command_ps,表示command执行频率。        \n**默认取值**:\n不涉及。",
      "example": "cpu_usage",
      "pattern": "^([A-Za-z]){1}([0-9A-Za-z]|_|-)*$"
    },
    "NamespaceSchema": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32,
      "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*\\.([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*$",
      "description": "**参数解释**:\n查询服务的命名空间,各服务命名空间请参阅[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n格式为service.item;service和item必须是字符串,必须以字母开头,只能包含0-9/a-z/A-Z/_。字符串的长度必须在 3 到 32个字符之间。\n**默认取值**:\n不涉及。",
      "example": "AGT.ECS"
    },
    "TimeStampResp": {
      "type": "integer",
      "format": "int64",
      "minimum": 0,
      "description": "**参数解释**:\n指标采集时间\n**取值范围**:\n最小值为0"
    },
    "NamespaceResp": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32,
      "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*\\.([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*$",
      "description": "**参数解释**:\n查询服务的命名空间,各服务命名空间请参阅[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)。\n**取值范围**:\n格式为service.item;service和item必须是字符串,必须以字母开头,只能包含0-9/a-z/A-Z/_。字符串的长度必须在 3 到 32个字符之间。",
      "example": "AGT.ECS"
    },
    "MetricNameResp": {
      "description": "**参数解释**:\n资源的监控指标名称,各服务资源的指标名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。\n**取值范围**:\n必须以字母开头,只能包含0-9/a-z/A-Z/_/-。字符长度最短为1,最大为96。如:弹性云服务器中的监控指标cpu_util,表示弹性服务器的CPU使用率;文档数据库中的指标mongo001_command_ps,表示command执行频率。",
      "type": "string",
      "pattern": "^([A-Za-z]){1}([0-9A-Za-z]|_|-)*$",
      "minLength": 1,
      "maxLength": 96,
      "example": "cpu_util"
    }
  },
