        "x-api-type": "open-api",
        "x-version": "v2",
        "x-request-examples-description-1": "请求样例:查询告警屏蔽ID为nmxxxxxxxxxxxxxxxxxxxxxx,分页数为10的资源列表。",
        "x-request-examples-url-1": "https://{云监控的endpoint}/v2/{project_id}/notification-masks/nmxxxxxxxxxxxxxxxxxxxxxx/resources?offset=0&limit=10\n",
        "tags": [
          "告警通知屏蔽"
        ],
        "summary": "查询告警通知屏蔽资源列表",
        "description": "查询告警通知屏蔽资源列表",
        "operationId": "ListNotificationMaskResources",
        "consumes": [
          "application/json"
        ],
        "produces": [
