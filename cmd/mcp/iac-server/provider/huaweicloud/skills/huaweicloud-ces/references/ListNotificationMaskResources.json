  "definitions": {
    "ResourceDimensionResp": {
      "description": "资源维度",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "description": "**参数解释**\n资源维度名称,如:弹性云服务器,则维度为instance_id;各服务资源的维度名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。\n**取值范围**\n由字母开头,后面可以包含字母、数字、_或-,长度为[1,32]个字符",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-)*$",
          "example": "instance_id"
        },
        "value": {
          "description": "**参数解释**\n资源维度值,为资源的实例ID,如:4270ff17-aba3-4138-89fa-820594c39755。\n**取值范围**\n长度为[1,256]个字符",
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^((([a-z]|[A-Z]|[0-9]|\\*|_|/|#|\\(|\\)){1}([a-z]|[A-Z]|[0-9]|_|-|\\.|\\*|/|#|\\(|\\))*))$",
          "example": "4270ff17-aba3-4138-89fa-820594c39755"
        }
      }
    },
    "ResourceNamespaceResp": {
      "type": "string",
      "description": "**参数解释**\n查询服务的命名空间,各服务命名空间请参阅[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)\n**取值范围**\n格式为service.item;service和item必须是字符串,必须以字母开头,只能包含0-9/a-z/A-Z/_。字符串的长度必须在 3 到 32个字符之间。",
      "minLength": 3,
      "maxLength": 32,
      "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*\\.([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*$",
      "example": "SYS.ECS"
    },
    "ListNotificationMaskResourcesResp": {
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceResp"
          },
          "description": "**参数解释**:\n通知屏蔽资源列表",
          "minItems": 1,
          "maxItems": 100
        },
        "count": {
          "description": "**参数解释**:\n资源总数\n**取值范围**:\n[0,100]",
          "type": "integer",
          "example": 100,
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "resources",
        "count"
      ]
    },
    "ResourceResp": {
      "required": [
        "namespace",
        "dimensions"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/definitions/ResourceNamespaceResp"
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "description": "**参数解释**\n资源的维度信息",
          "items": {
            "$ref": "#/definitions/ResourceDimensionResp"
          }
        }
      }
    },
    "GoAPIErrorResponseV2": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "ces.0001",
          "description": "请求异常内部业务状态码",
          "minLength": 0,
          "maxLength": 256
        },
        "error_msg": {
          "type": "string",
          "example": "the request format is invalid",
          "description": "请求异常信息",
          "minLength": 0,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "example": "txnEntry-DESKTOP-4LPFH08.txnId-466541d0-f1a6-429b-b747-98d4991671c1.ts-1637909316688.c-95",
          "description": "请求ID",
          "minLength": 0,
          "maxLength": 256
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "description": "**参数解释**:\n项目ID。用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。获取方式请参见[获取项目ID](https://support.huaweicloud.com/api-ces/ces_03_0057.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n字符串的长度必须在 1 到 64个字符之间。\n**默认取值**:\n不涉及。",
      "in": "path",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ContentType": {
      "name": "Content-Type",
      "in": "header",
      "description": "**参数解释**:\n发送的实体的MIME类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n最小字符数量为1,最大为64。\n**默认取值**:\n默认使用application/json; charset=UTF-8。",
      "required": false,
      "type": "string",
      "default": "application/json; charset=UTF-8",
      "minLength": 1,
      "maxLength": 64,
      "x-order": 1
    },
    "Limit": {
      "name": "limit",
      "in": "query",
      "description": "**参数解释**:\n分页大小\n**约束限制**:\n不涉及\n**取值范围**:\n整数,[1,100]\n**默认取值**:\n100",
      "type": "integer",
      "pattern": "^([1-9]|[1-9][0-9]|100)$",
      "default": 100,
      "required": false,
      "minimum": 1,
      "maximum": 100
    },
    "Offset": {
      "name": "offset",
      "in": "query",
      "description": "**参数解释**:\n分页偏移量\n**约束限制**:\n不涉及\n**取值范围**:\n整数,[0,10000]\n**默认取值**:\n0",
      "type": "integer",
      "pattern": "^([0]|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]|[1-9][0-9][0-9][0-9]|10000)$",
      "default": 0,
      "required": false,
      "minimum": 0,
      "maximum": 10000
    },
    "NotificationMaskID": {
      "name": "notification_mask_id",
      "in": "path",
      "type": "string",
      "description": "**参数解释**:\n屏蔽规则ID。   \n**约束限制**:\n不涉及。\n**取值范围**:\n只能包含字母、数字,长度为[1,64]个字符。          \n**默认取值**:\n不涉及。",
      "minLength": 1,
      "maxLength": 64,
      "required": true,
      "pattern": "^([a-z]|[A-Z]|[0-9]){1,64}$"
    },
    "AuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数解释**:\n用户Token。\n**约束限制**:\n不涉及。\n**取值范围**:\n最小字符数量为1,最大为16384。\n**默认取值**:\n不涉及。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "x-order": 2
    }
  },
  "host": "ces.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}