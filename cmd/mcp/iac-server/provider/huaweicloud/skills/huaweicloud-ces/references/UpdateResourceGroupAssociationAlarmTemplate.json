{
  "name": "UpdateResourceGroupAssociationAlarmTemplate",
  "summary": "资源分组异步关联自定义告警模板",
  "tags": "资源分组",
  "productshort": "CES",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/resource-groups/{group_id}/alarm-templates/async-association": {
      "put": {
        "tags": [
          "资源分组"
        ],
        "summary": "资源分组异步关联自定义告警模板",
        "description": "提交资源分组批量关联自定义告警模板异步任务,由异步任务覆盖性创建告警规则。每个用户创建处于待执行状态的异步任务数量上限为100个,单个资源分组仅可有1个未完成的任务。",
        "x-constraint": "目前非洲-开罗、华北三、华北-乌兰察布-汽车一、华东二、华东-青岛、华南-深圳、拉美-布宜诺斯艾利斯一、拉美-利马一、拉美-墨西哥城一、土耳其-伊斯坦布尔、华北-乌兰察布二零一、西南-贵阳-汽车二、亚太-马尼拉、华南-广州-友好用户环境 14个局点不支持该接口",
        "operationId": "UpdateResourceGroupAssociationAlarmTemplate",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-open-region-cloud": "hc,hk,hws,hws_hk,hws_eu,hws_eu_wb,dt,dt_test,sbc,g42",
        "x-version": "v2",
        "parameters": [
          {
            "$ref": "#/parameters/ContentType"
          },
          {
            "$ref": "#/parameters/AuthToken"
          },
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/GroupID"
          },
          {
            "name": "UpdateResourceGroupAssociationAlarmTemplateRequestBody",
            "in": "body",
            "description": "资源分组异步关联告警模板请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AsyncAssociateRGAndTemplatesReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "资源分组异步关联告警模板任务下发成功返回体",
            "schema": {
              "$ref": "#/definitions/AsyncAssociateRGAndTemplatesResp"
            },
            "examples": {
              "application/json": {
                "group_id": "rg1619578505263QkW3b66yo",
                "template_ids": [
                  "at1628592157541dB1klWgY6",
                  "at1625452115254dB1kllll3"
                ]
              }
            }
          },
          "400": {
            "description": "参数校验失败",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "401": {
            "description": "未认证",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "403": {
            "description": "认证鉴权失败",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "404": {
            "description": "资源不存在",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "500": {
            "description": "系统内部错误",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "NoticeTypeNotificationTemplateList": {
      "properties": {
        "notice_type": {
          "description": "通知类型, sms(短信)/email/http(s)/smn/welink/dingding(钉钉)/wechat(微信)/feishu(飞书)/wecomgroup(微信企业版)",
          "type": "string",
          "enum": [
            "sms",
            "email",
            "http(s)",
            "smn",
            "welink",
            "dingding",
            "wechat",
            "feishu",
            "wecomgroup"
          ],
          "pattern": "^(sms|email|http\\(s\\)|smn|welink|dingding|wechat|feishu|wecomgroup)$"
        },
        "alarm_notification_template_id": {
          "description": "**参数解释**:\n通知模板id\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[3,64]个字符。\n**默认取值**:\n不涉及",
          "type": "string",
          "pattern": "^ant([0-9A-Za-z]){0,61}$"
        },
        "alarm_notification_template_name": {
          "description": "**参数解释**:\n通知模板名\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[1,200]个字符。\n**默认取值**:\n不涉及",
          "type": "string",
          "pattern": "^([\\一-\\鿿]|[a-z]|[A-Z]|[0-9]|_|-){1,200}$"
        }
      },
      "required": [
        "notice_type",
        "alarm_notification_template_id"
      ]
    },
    "EffectiveTimezone": {
      "type": "string",
      "description": "**参数解释**:\n时区,形如:\"GMT-08:00\"、\"GMT+08:00\"、\"GMT+0:00\"。   \n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[1,16]个字符。          \n**默认取值**:\n不涉及。",
      "example": "GMT-08:00",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^(GMT[+-](0|0[1-9]|1[0-2]):00)$"
    },
    "GroupIDResp": {
      "type": "string",
      "description": "**参数解释**\n资源分组ID。\n**取值范围**\n以\"rg\"开头,后面跟着22个字母或数字",
      "pattern": "^rg([a-z]|[A-Z]|[0-9]){22}$",
      "example": "rg1619578505263QkW3b66yo"
    },
    "NotificationEndTime": {
      "type": "string",
      "description": "**参数解释**:\n告警通知关闭时间。如 08:00 \n**约束限制**:\n不涉及。\n**取值范围**:\n只能包含数字、“:”,长度为[1,64]个字符。          \n**默认取值**:\n不涉及。",
      "pattern": "^([01][0-9]|2[0-3]):([0-5][0-9])$",
      "minLength": 1,
      "maxLength": 64,
      "example": "23:59"
    },
    "GoAPIErrorResponseV2": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "ces.0001",
          "description": "请求异常内部业务状态码",
          "minLength": 0,
          "maxLength": 256
        },
        "error_msg": {
          "type": "string",
          "example": "the request format is invalid",
          "description": "请求异常信息",
          "minLength": 0,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "example": "txnEntry-DESKTOP-4LPFH08.txnId-466541d0-f1a6-429b-b747-98d4991671c1.ts-1637909316688.c-95",
          "description": "请求ID",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "Notification": {
      "required": [
        "type",
        "notification_list"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "**参数解释**:\n通知类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n枚举值。\n- notification:通知组或主题订阅。\n- contact:云账号联系人。\n- contactGroup:(已废弃)通知组。\n- autoscaling:AS通知,只在AS中使用。\n- groupwatch:已废弃,不推荐使用。\n- ecsRecovery:已废弃,不推荐使用。\n- iecAction:已废弃,不推荐使用。\n**默认取值**:\n不涉及。",
          "enum": [
            "notification",
            "autoscaling",
            "groupwatch",
            "ecsRecovery",
            "contact",
            "contactGroup",
            "iecAction"
          ],
          "example": "notification"
        },
        "notification_list": {
          "description": "**参数解释**:\n 告警状态发生变化时,被通知对象的列表。topicUrn可从SMN获取,具体操作请参考查询Topic列表。\n**约束限制**:\n当type为notification时,notification_list列表不能为空;当type为autoscaling时,列表必须为[]。若notification_enabled为true,对应的alarm_notifications、ok_notifications至少有一个不能为空。若alarm_notifications、ok_notification同时存在时,notification_list值保持一致。最多包含20个通知对象,最少可以为0个。",
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/SMNUrn"
          }
        }
      }
    },
    "AsyncAssociateRGAndTemplatesReq": {
      "properties": {
        "template_ids": {
          "items": {
            "$ref": "#/definitions/TemplateID"
          },
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "description": "告警模板编号列表,当ID列表为空时,将删除该资源分组已关联的告警模板所创建的告警规则"
        },
        "notification_enabled": {
          "$ref": "#/definitions/NotificationEnabled"
        },
        "alarm_notifications": {
          "description": "告警触发通知列表",
          "items": {
            "$ref": "#/definitions/Notification"
          },
          "type": "array",
          "minItems": 0,
          "maxItems": 10
        },
        "ok_notifications": {
          "description": "告警恢复通知列表",
          "items": {
            "$ref": "#/definitions/Notification"
          },
          "type": "array",
          "minItems": 0,
          "maxItems": 10
        },
        "notification_begin_time": {
          "$ref": "#/definitions/NotificationBeginTime"
        },
        "notification_end_time": {
          "$ref": "#/definitions/NotificationEndTime"
        },
        "effective_timezone": {
          "$ref": "#/definitions/EffectiveTimezone"
        },
        "enterprise_project_id": {
          "$ref": "#/definitions/EnterpriseProjectID"
        },
        "notification_manner": {
          "type": "string",
          "enum": [
            "NOTIFICATION_GROUP",
            "TOPIC_SUBSCRIPTION",
            "NOTIFICATION_POLICY"
          ],
          "description": "**参数解释**:\n通知方式。\n**约束限制**:\n不涉及。\n**取值范围**:\n枚举值。取值为NOTIFICATION_GROUP、TOPIC_SUBSCRIPTION、NOTIFICATION_POLICY\n- NOTIFICATION_GROUP: 通知组\n- TOPIC_SUBSCRIPTION: 主题订阅\n- NOTIFICATION_POLICY: 通知策略\n**默认取值**:\n不涉及。"
        },
        "notification_policy_ids": {
          "type": "array",
          "description": "关联的通知策略ID列表",
          "items": {
            "type": "string",
            "description": "**参数解释**:\n通知策略ID\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[0,64]个字符。\n**默认取值**:\n不涉及",
            "example": "np15563156337845e8A2Wv63",
            "minLength": 0,
            "maxLength": 64
          },
          "minItems": 0,
          "maxItems": 20
        },
        "notice_type_notification_template_list": {
          "type": "array",
          "description": "告警通知模板列表",
          "items": {
            "$ref": "#/definitions/NoticeTypeNotificationTemplateList"
          },
          "minItems": 0,
          "maxItems": 10
        }
      },
      "required": [
        "template_ids",
        "notification_enabled"
      ],
      "type": "object",
      "example": {
        "template_ids": [
          "at1628592157541dB1klWgY6",
          "at1628592157541dxcdfssfd"
        ],
        "notification_enabled": false
      }
    },
    "NotificationEnabled": {
      "type": "boolean",
      "description": "**参数解释**:\n是否开启告警通知。说明:若notification_enabled为true,对应的alarm_notifications、ok_notifications至少有一个不能为空。   \n**约束限制**:\n不涉及。\n**取值范围**:\n布尔值。\n- true:开启。\n- false:关闭。\n**默认取值**:\ntrue",
      "default": true,
      "example": true
    },
    "NotificationBeginTime": {
      "type": "string",
      "description": "**参数解释**:\n告警通知开启时间。如 00:00   \n**约束限制**:\n不涉及。\n**取值范围**:\n只能包含数字、“:”,长度为[1,64]个字符。          \n**默认取值**:\n不涉及。",
      "pattern": "^([01][0-9]|2[0-3]):([0-5][0-9])$",
      "minLength": 1,
      "maxLength": 64,
      "example": "00:00"
    },
    "TemplateID": {
      "type": "string",
      "description": "**参数解释**:\n告警模板的ID。    \n**约束限制**:\n不涉及。\n**取值范围**:\n以at开头,后跟字母、数字,长度为[2,64]个字符。          \n**默认取值**:\n不涉及。",
      "pattern": "^at([0-9A-Za-z])+$",
      "minLength": 2,
      "maxLength": 64,
      "example": "at1628592157541dB1klWgY6"
    },
    "SMNUrn": {
      "description": "**参数解释**:\n通知组、通知对象对应的SMN主题URN。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能包含字母、数字、“-”、“_” 、“:”。    \n**默认取值**:\n不涉及。",
      "type": "string",
      "pattern": "^((urn:smn:([a-z]|[A-Z]|[0-9]|\\-){1,32}:([a-z]|[A-Z]|[0-9]){32}:([a-z]|[A-Z]|[0-9]|\\-|\\_){1,256})|(ct|cg)([a-z]|[A-Z]|[0-9]){22})$",
      "example": "urn:smn:123"
    },
    "AsyncAssociateRGAndTemplatesResp": {
      "properties": {
        "group_id": {
          "$ref": "#/definitions/GroupIDResp"
        },
        "template_ids": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TemplateIDResp"
          },
          "description": "关联的告警模板的ID列表",
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "group_id",
        "template_ids"
      ],
      "type": "object"
    },
    "EnterpriseProjectID": {
      "type": "string",
      "description": "**参数解释**:\n企业项目ID。    \n**约束限制**:\n不涉及。\n**取值范围**:\n只能包含小写字母、数字、“-”。0 代表默认企业项目ID        \n**默认取值**:\n不涉及。",
      "pattern": "^((([a-z]|[0-9]){8}-([a-z]|[0-9]){4}-([a-z]|[0-9]){4}-([a-z]|[0-9]){4}-([a-z]|[0-9]){12})|0)$",
      "example": "a9d919b7-0456-4bb8-b470-6a23b64f4f7e"
    },
    "TemplateIDResp": {
      "type": "string",
      "description": "**参数解释**:\n告警模板的ID。\n**取值范围**:\n以at开头,后跟字母、数字,长度为[2,64]个字符。",
      "pattern": "^at([0-9A-Za-z])+$",
      "minLength": 2,
      "maxLength": 64,
      "example": "at1628592157541dB1klWgY6"
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "description": "**参数解释**:\n项目ID。用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。获取方式请参见[获取项目ID](https://support.huaweicloud.com/api-ces/ces_03_0057.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n字符串的长度必须在 1 到 64个字符之间。\n**默认取值**:\n不涉及。",
      "in": "path",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "GroupID": {
      "name": "group_id",
      "in": "path",
      "required": true,
      "type": "string",
      "description": "**参数解释**\n资源分组ID。\n**约束限制**\n不涉及\n**取值范围**\n以\"rg\"开头,后面跟着22个字母或数字\n**默认取值**\n不涉及",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^rg([a-z]|[A-Z]|[0-9]){22}$"
    },
    "ContentType": {
      "name": "Content-Type",
      "in": "header",
      "description": "**参数解释**:\n发送的实体的MIME类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n最小字符数量为1,最大为64。\n**默认取值**:\n默认使用application/json; charset=UTF-8。",
      "required": false,
      "type": "string",
      "default": "application/json; charset=UTF-8",
      "minLength": 1,
      "maxLength": 64,
      "x-order": 1
    },
    "AuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数解释**:\n用户Token。\n**约束限制**:\n不涉及。\n**取值范围**:\n最小字符数量为1,最大为16384。\n**默认取值**:\n不涉及。",
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "x-order": 2
    }
  },
  "host": "ces.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "put",
  "uri": null
