{
  "name": "ListOneClickAlarmRules",
  "summary": "查询一键告警关联告警规则列表",
  "tags": "一键告警",
  "productshort": "CES",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/one-click-alarms/{one_click_alarm_id}/alarms": {
      "get": {
        "tags": [
          "一键告警"
        ],
        "summary": "查询一键告警关联告警规则列表",
        "description": "查询一键告警关联告警规则列表",
        "operationId": "ListOneClickAlarmRules",
        "x-support-sdk": "Y",
        "x-php-exclude": "Y",
        "x-version": "v2",
        "x-is-registered": "Y",
        "x-open-region-cloud": "hc,hk,hws,hws_hk,hws_eu,hws_eu_wb,dt,dt_test,sbc,g42",
        "x-api-type": "open-api",
        "parameters": [
          {
            "$ref": "#/parameters/ContentType"
          },
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/AuthToken"
          },
          {
            "name": "one_click_alarm_id",
            "in": "path",
            "description": "**参数解释**\n一键告警ID\n**约束限制**\n不涉及\n**取值范围**\n长度为1到64字符,只能包含字母数字\n**默认取值**\n不涉及",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^([a-z]|[A-Z]|[0-9]){1,64}$"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListAlarmsResp"
            },
            "examples": {
              "application/json": {
                "alarms": [
                  {
                    "alarm_id": "al16558829757444BVVxr999",
                    "name": "alarm1",
                    "description": "hello world",
                    "namespace": "SYS.ECS",
                    "policies": [
                      {
                        "alarm_policy_id": "alxdxxxdsw12321321",
                        "metric_name": "cpu_util",
                        "period": 0,
                        "filter": "max",
                        "comparison_operator": ">=",
                        "value": 1.7976931348623156e+108,
                        "unit": "%",
                        "count": 100,
                        "suppress_duration": 0,
                        "level": 2,
                        "enabled": true
                      }
                    ],
                    "resources": [
                      {
                        "dimensions": [
                          {
                            "name": "string",
                            "value": "string"
                          }
                        ]
                      }
                    ],
                    "type": "EVENT.SYS",
                    "enabled": true,
                    "notification_enabled": true,
                    "alarm_notifications": [
                      {
                        "type": "notification",
                        "notification_list": [
                          "urn:smn:123"
                        ]
                      }
                    ],
                    "ok_notifications": [
                      {
                        "type": "notification",
                        "notification_list": [
                          "urn:smn:123"
                        ]
                      }
                    ],
                    "notification_begin_time": "00:00",
                    "notification_end_time": "23:59",
                    "notification_manner": "NOTIFICATION_POLICY",
                    "notification_policy_ids": [
                      "np15563156337845e8A2Wv63"
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数校验失败",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "401": {
            "description": "未认证",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "403": {
            "description": "认证鉴权失败",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          },
          "500": {
            "description": "系统内部错误",
            "schema": {
              "$ref": "#/definitions/GoAPIErrorResponseV2"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ResourcesInListResp": {
      "properties": {
        "resource_group_id": {
          "description": "**参数解释**:\n资源分组ID,监控范围为资源分组时,存在该值。\n**取值范围**:\n以rg开头,后跟22个字母或数字。",
          "type": "string",
          "pattern": "^rg([a-z]|[A-Z]|[0-9]){22}$"
        },
        "resource_group_name": {
          "description": "**参数解释**:\n资源分组名称,监控范围为资源分组时,存在该值。\n**取值范围**:\n长度为[1,128]个字符。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dimensions": {
          "description": "**参数解释**:\n维度信息。",
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "$ref": "#/definitions/MetricDimensionResp"
          }
        }
      }
    },
    "AlarmID": {
      "type": "string",
      "description": "**参数解释**:\n告警规则id。    \n**约束限制**:\n不涉及。\n**取值范围**:\n以al开头,后跟22个数字或字母。          \n**默认取值**:\n不涉及。",
      "pattern": "^al([0-9A-Za-z]){22}$",
      "example": "al16558829757444BVVxr999"
    },
    "SuppressDuration": {
      "type": "integer",
      "format": "int32",
      "description": "**参数解释**:\n告警抑制时间,单位为秒,对应页面上创建告警规则时告警策略最后一个字段,该字段主要为解决告警频繁的问题。\n**约束限制**:\n不涉及。\n**取值范围**:\n枚举值,只能为0、300、600、900、1800、3600、10800、21600、43200、86400。\n- 0:对于指标类告警,0代表告警一次。对于事件类告警,在立即触发场景中,0代表不抑制;在累计触发场景,0代表只告警一次。\n- 300代表满足告警触发条件后每5分钟告警一次。\n- 600代表满足告警触发条件后每10分钟告警一次。\n- 900代表满足告警触发条件后每15分钟告警一次。\n- 1800代表满足告警触发条件后每30分钟告警一次。\n- 3600代表满足告警触发条件后每60分钟告警一次。\n- 10800代表满足告警触发条件后每3小时告警一次。\n- 21600代表满足告警触发条件后每6小时告警一次。\n- 43200代表满足告警触发条件后每12小时告警一次。\n- 86400代表满足告警触发条件后每一天告警一次。\n**默认取值**:\n不涉及。",
      "enum": [
        0,
        300,
        600,
        900,
        1800,
        3600,
        10800,
        21600,
        43200,
        86400
      ]
    },
    "Filter": {
      "description": "**参数解释**:\n聚合方式。        \n**约束限制**:\nperiod为1(原始值)时filter字段不生效,默认为average。period大于1时filter才起作用。\n**取值范围**:\n- average:平均值\n- variance:方差\n- min:最小值\n- max:最大值\n- sum:求和\n**默认取值**:\n不涉及。",
      "type": "string",
      "pattern": "^(average|variance|min|max|sum)$",
      "example": "sum"
    },
    "OneClickAlarmPolicy": {
      "required": [
        "alarm_policy_id",
        "metric_name",
        "period",
        "filter",
        "comparison_operator",
        "value",
        "count",
        "enabled"
      ],
      "properties": {
        "alarm_policy_id": {
          "$ref": "#/definitions/AlarmPolicyID"
        },
        "metric_name": {
          "$ref": "#/definitions/MetricName"
        },
        "period": {
          "$ref": "#/definitions/Period"
        },
        "filter": {
          "$ref": "#/definitions/Filter"
        },
        "comparison_operator": {
          "$ref": "#/definitions/ComparisonOperator"
        },
        "value": {
          "$ref": "#/definitions/Value"
        },
        "hierarchical_value": {
          "$ref": "#/definitions/HierarchicalValue"
        },
        "unit": {
          "$ref": "#/definitions/Unit"
        },
        "count": {
          "$ref": "#/definitions/Count"
        },
        "suppress_duration": {
          "$ref": "#/definitions/SuppressDuration"
        },
        "level": {
          "$ref": "#/definitions/Level"
        },
        "enabled": {
          "$ref": "#/definitions/OneClickAlarmEnabled"
        },
        "selected_unit": {
          "$ref": "#/definitions/SelectedUnit"
        }
      }
    },
    "AlarmNotifications": {
      "items": {
        "$ref": "#/definitions/Notification"
      },
      "type": "array",
      "description": "**参数解释**:\n触发告警时,通知组/主题订阅的信息。\n**约束限制**:\n包含的通知对象信息的数量最多为10个,最少为0个。",
      "minItems": 0,
      "maxItems": 10
    },
    "NotificationEndTime": {
      "type": "string",
      "description": "**参数解释**:\n告警通知关闭时间。如 08:00 \n**约束限制**:\n不涉及。\n**取值范围**:\n只能包含数字、“:”,长度为[1,64]个字符。          \n**默认取值**:\n不涉及。",
      "pattern": "^([01][0-9]|2[0-3]):([0-5][0-9])$",
      "minLength": 1,
      "maxLength": 64,
      "example": "23:59"
    },
    "Namespace": {
      "type": "string",
      "description": "**参数解释**:\n查询服务的命名空间,各服务命名空间请参阅[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n格式为service.item;service和item必须是字符串,必须以字母开头,只能包含0-9/a-z/A-Z/_。字符串的长度必须在 3 到 32个字符之间。\n**默认取值**:\n不涉及。",
      "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*\\.([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*$",
      "minLength": 3,
      "maxLength": 32,
      "example": "SYS.ECS"
    },
    "Count": {
      "type": "integer",
      "format": "int32",
      "description": "**参数解释**:\n告警连续触发次数。    \n**约束限制**:\n不涉及。\n**取值范围**:\n事件告警时参数值为1~180(包括1和180);指标告警和站点告警时,次数采用枚举值,枚举值分别为:1、2、3、4、5、10、15、30、60、90、120、180。         \n**默认取值**:\n不涉及。",
      "minimum": 1,
      "maximum": 180,
      "example": 5
    },
    "MetricDimensionResp": {
      "description": "**参数解释**:\n资源维度。",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-){1,32}$",
          "minLength": 1,
          "maxLength": 32,
          "description": "**参数解释**:\n资源维度名称。\n**取值范围**:\n以字母开头,长度为[1,32]个字符。"
        },
        "value": {
          "type": "string",
          "pattern": "^((([a-z]|[A-Z]|[0-9]){1}([a-z]|[A-Z]|[0-9]|_|-)*)|){0,256}$",
          "minLength": 0,
          "maxLength": 256,
          "description": "**参数解释**:\n资源维度值。\n**取值范围**:\n长度为[0,256]个字符。"
        }
      }
    },
    "Notification": {
      "required": [
        "type",
        "notification_list"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "**参数解释**:\n通知类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n枚举值。\n- notification:通知组或主题订阅。\n- contact:云账号联系人。\n- contactGroup:(已废弃)通知组。\n- autoscaling:AS通知,只在AS中使用。\n- groupwatch:已废弃,不推荐使用。\n- ecsRecovery:已废弃,不推荐使用。\n- iecAction:已废弃,不推荐使用。\n**默认取值**:\n不涉及。",
          "enum": [
            "notification",
            "autoscaling",
            "groupwatch",
            "ecsRecovery",
            "contact",
            "contactGroup",
            "iecAction"
          ],
          "example": "notification"
        },
        "notification_list": {
          "description": "**参数解释**:\n 告警状态发生变化时,被通知对象的列表。topicUrn可从SMN获取,具体操作请参考查询Topic列表。\n**约束限制**:\n当type为notification时,notification_list列表不能为空;当type为autoscaling时,列表必须为[]。若notification_enabled为true,对应的alarm_notifications、ok_notifications至少有一个不能为空。若alarm_notifications、ok_notification同时存在时,notification_list值保持一致。最多包含20个通知对象,最少可以为0个。",
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/SMNUrn"
          }
        }
      }
    },
    "NotificationEnabled": {
      "type": "boolean",
      "description": "**参数解释**:\n是否开启告警通知。说明:若notification_enabled为true,对应的alarm_notifications、ok_notifications至少有一个不能为空。   \n**约束限制**:\n不涉及。\n**取值范围**:\n布尔值。\n- true:开启。\n- false:关闭。\n**默认取值**:\ntrue",
      "default": true,
      "example": true
    },
    "SelectedUnit": {
      "type": "string",
      "description": "**参数解释**:\n用户在页面中选择的指标单位, 用于后续指标数据回显和计算。字符串最大长度为64。   \n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[0,64]个字符。       \n**默认取值**:\n不涉及。",
      "example": "Byte/s",
      "minLength": 0,
      "maxLength": 64
    },
    "HierarchicalValue": {
      "type": "object",
      "description": "**参数解释**:\n多层级告警阈值。   \n**约束限制**:\n当hierarchical_value和value同时使用时以hierarchical_value为准。\n创建或修改告警规则以下2种场景只支持设置一个阈值:\n  1.告警类型为`指标告警`且告警策略为`所有策略都满足才告警`的场景。\n  2.告警类型为`事件告警`的场景。",
      "example": {
        "critical": 12,
        "major": 10,
        "minor": 8,
        "info": 4
      },
      "properties": {
        "critical": {
          "description": "**参数解释**:\n紧急级别的阈值。\n**约束限制**:\n不涉及。\n**取值范围**:\n[-1.7976931348623157e+108, 1.7976931348623157e+108]          \n**默认取值**:\n不涉及。",
          "type": "number",
          "format": "double",
          "minimum": -1.7976931348623156e+108,
          "maximum": 1.7976931348623156e+108,
          "example": 12
        },
        "major": {
          "description": "**参数解释**:\n重要级别的阈值。\n**约束限制**:\n不涉及。\n**取值范围**:\n[-1.7976931348623157e+108, 1.7976931348623157e+108]          \n**默认取值**:\n不涉及。",
          "type": "number",
          "format": "double",
          "minimum": -1.7976931348623156e+108,
          "maximum": 1.7976931348623156e+108,
          "example": 10
        },
        "minor": {
          "description": "**参数解释**:\n次要级别的阈值。\n**约束限制**:\n不涉及。\n**取值范围**:\n[-1.7976931348623157e+108, 1.7976931348623157e+108]          \n**默认取值**:\n不涉及。",
          "type": "number",
          "format": "double",
          "minimum": -1.7976931348623156e+108,
          "maximum": 1.7976931348623156e+108,
          "example": 8
        },
        "info": {
          "description": "**参数解释**:\n提示级别的阈值。\n**约束限制**:\n不涉及。\n**取值范围**:\n[-1.7976931348623157e+108, 1.7976931348623157e+108]          \n**默认取值**:\n不涉及。",
          "type": "number",
          "format": "double",
          "minimum": -1.7976931348623156e+108,
          "maximum": 1.7976931348623156e+108,
          "example": 4
        }
      }
    },
    "AlarmType": {
      "type": "string",
      "description": "**参数解释**:\n告警规则类型\n**约束限制**:\n不涉及。\n**取值范围**:\n枚举值。\n- ALL_INSTANCE:针对全部资源的告警规则。\n- RESOURCE_GROUP:针对资源分组的告警规则。\n- MULTI_INSTANCE:针对指定资源的告警规则。\n- EVENT.SYS:系统事件告警规则。\n- EVENT.CUSTOM:自定义事件告警规则。\n- DNSHealthCheck:健康检查告警规则。\n**默认取值**:\n不涉及。",
      "pattern": "^(EVENT.SYS|EVENT.CUSTOM|DNSHealthCheck|RESOURCE_GROUP|MULTI_INSTANCE|ALL_INSTANCE)$",
      "enum": [
        "EVENT.SYS",
        "EVENT.CUSTOM",
        "DNSHealthCheck",
        "RESOURCE_GROUP",
        "MULTI_INSTANCE",
        "ALL_INSTANCE"
      ],
      "example": "EVENT.SYS"
    },
    "Value": {
      "description": "**参数解释**:\n告警阈值。具体阈值取值请参见[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)。   \n**约束限制**:\n单一阈值时value和alarm_level配对使用,当hierarchical_value和value同时使用时以hierarchical_value为准。\n**取值范围**:\n最小值为-1.7976931348623157e+108,最大值为1.7976931348623157e+108。          \n**默认取值**:\n不涉及。",
      "type": "number",
      "format": "double",
      "minimum": -1.7976931348623156e+108,
      "maximum": 1.7976931348623156e+108
    },
    "AlarmEnabled": {
      "description": "**参数解释**:\n是否开启告警规则。    \n**约束限制**:\n不涉及。\n**取值范围**:\n布尔值。\n- true:开启。\n- false:关闭。\n**默认取值**:\ntrue",
      "type": "boolean",
      "default": true,
      "example": true
    },
    "ListAlarmsResp": {
      "required": [
        "alarms"
      ],
      "properties": {
        "alarms": {
          "description": "告警规则列表",
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "properties": {
              "alarm_id": {
                "$ref": "#/definitions/AlarmID"
              },
              "name": {
                "$ref": "#/definitions/AlarmName"
              },
              "description": {
                "$ref": "#/definitions/AlarmDescription"
              },
              "namespace": {
                "$ref": "#/definitions/Namespace"
              },
              "policies": {
                "description": "告警策略",
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "$ref": "#/definitions/OneClickAlarmPolicy"
                }
              },
              "resources": {
                "description": "资源列表,关联资源需要使用查询告警规则资源接口获取",
                "type": "array",
                "minItems": 1,
                "maxItems": 3000,
                "items": {
                  "$ref": "#/definitions/ResourcesInListResp"
                }
              },
              "type": {
                "$ref": "#/definitions/AlarmType"
              },
              "enabled": {
                "$ref": "#/definitions/AlarmEnabled"
              },
              "notification_enabled": {
                "$ref": "#/definitions/NotificationEnabled"
              },
              "alarm_notifications": {
                "$ref": "#/definitions/AlarmNotifications"
              },
              "ok_notifications": {
                "$ref": "#/definitions/OkNotifications"
              },
              "notification_begin_time": {
                "$ref": "#/definitions/NotificationBeginTime"
              },
              "notification_end_time": {
                "$ref": "#/definitions/NotificationEndTime"
              },
              "effective_timezone": {
                "$ref": "#/definitions/EffectiveTimezone"
              },
              "notification_manner": {
                "type": "string",
                "enum": [
                  "NOTIFICATION_GROUP",
                  "TOPIC_SUBSCRIPTION",
                  "NOTIFICATION_POLICY"
                ],
                "description": "NOTIFICATION_GROUP(通知组)/TOPIC_SUBSCRIPTION(主题订阅)/NOTIFICATION_POLICY(通知策略)",
                "example": "NOTIFICATION_POLICY",
                "minLength": 0,
                "maxLength": 64
              },
              "notification_policy_ids": {
                "type": "array",
                "description": "**参数解释**\n关联的通知策略ID列表\n**约束限制**\n包含的通知策略ID个数为0至20",
                "items": {
                  "type": "string",
                  "description": "通知策略ID",
                  "example": "np15563156337845e8A2Wv63",
                  "minLength": 0,
                  "maxLength": 64
                },
                "minItems": 0,
                "maxItems": 20
              }
            }
          }
        }
      }
    },
    "Level": {
