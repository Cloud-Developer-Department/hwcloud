  "definitions": {
    "DashBoardIdItem": {
      "properties": {
        "dashboard_id": {
          "description": "**参数解释**:\n监控看板id\n**约束限制**\n不涉及\n**取值范围**\n以db开头,包含22个字母和数字,长度为24个字符\n**默认取值**\n不涉及",
          "type": "string",
          "pattern": "^db([a-z]|[A-Z]|[0-9]){22}$",
          "example": "db16564943172807wjOmoLy2"
        }
      }
    },
    "EnterpriseIdItem": {
      "properties": {
        "enterprise_id": {
          "description": "**参数解释**\n企业项目ID\n**约束限制**\n不涉及\n**取值范围**\n只能包含小写字母、数字、“-”、“_”,可以自定义企业项目ID,长度为36个字符。也可以为0(代表默认企业项目ID)。\n**默认取值**\n不涉及",
          "type": "string",
          "pattern": "^((([a-z]|[0-9]){8}-([a-z]|[0-9]){4}-([a-z]|[0-9]){4}-([a-z]|[0-9]){4}-([a-z]|[0-9]){12})|0)$",
          "example": "xxxxx-aaa"
        }
      }
    },
    "DashBoardIdItemResp": {
      "properties": {
        "dashboard_id": {
          "description": "**参数解释**:\n监控看板id\n**取值范围**\n以db开头,包含22个字母和数字,长度为24个字符",
          "type": "string",
          "pattern": "^db([a-z]|[A-Z]|[0-9]){22}$",
          "example": "db16564943172807wjOmoLy2"
        }
      }
    },
    "CreateDashboardRequestBody": {
      "required": [
        "dashboard_name"
      ],
      "allOf": [
        {
          "$ref": "#/definitions/DashBoardNameItem"
        },
        {
          "$ref": "#/definitions/EnterpriseIdItem"
        },
        {
          "$ref": "#/definitions/DashBoardIdItem"
        },
        {
          "properties": {
            "row_widget_num": {
              "description": "**参数解释**:\n监控视图展示模式\n**约束限制**\n不涉及\n**取值范围**\n枚举值:\n- 0:表示自定义坐标\n- 1:代表每行1个监控视图\n- 2:代表每行2个监控视图\n- 3:代表每行3个监控视图\n- 4:代表每行4个监控视图\n**默认取值**\n不涉及",
              "type": "integer",
              "enum": [
                0,
                1,
                2,
                3,
                4
              ],
              "example": 3
            }
          }
        }
      ]
    },
    "CreateDashboardResponseBody": {
      "allOf": [
        {
          "$ref": "#/definitions/DashBoardIdItemResp"
        }
      ],
      "example": {
        "dashboard_id": "db16564943172807wjOmoLyn"
      }
    },
    "DashBoardNameItem": {
      "type": "object",
      "properties": {
        "dashboard_name": {
          "type": "string",
          "description": "**参数解释**:\n自定义监控看板名称\n**约束限制**\n不涉及\n**取值范围**\n长度为[1,128]个字符,只允许中文、英文、数字0-9、_和-\n**默认取值**\n不涉及",
          "pattern": "^([\\一-\\鿿]|[a-z]|[A-Z]|[0-9]|_|-)+$",
          "minLength": 1,
          "maxLength": 128,
          "example": "华为云监控大屏"
        }
      }
    },
    "GoAPIErrorResponseV2": {
      "type": "object",
      "properties": {
