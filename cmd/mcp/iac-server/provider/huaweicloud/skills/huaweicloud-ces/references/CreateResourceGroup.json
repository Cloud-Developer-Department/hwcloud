  "definitions": {
    "CreateResourceGroupResponseBody": {
      "description": "创建资源分组响应体。",
      "properties": {
        "group_id": {
          "type": "string",
          "description": "**参数解释**\n资源分组ID,如:rg1606377637506DmVOENVyL\n**约束限制**\n不涉及\n**取值范围**\n以\"rg\"开头,后面跟着22个字母或数字\n**默认取值**\n不涉及",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ResourceGroupTagRelation": {
      "type": "object",
      "description": "**参数解释**\n标签的匹配规则\n**约束限制**\n不涉及",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/definitions/TMSKey"
        },
        "operator": {
          "type": "string",
          "description": "**参数解释**\ntag操作符,含义是标签key与value的关系\n**约束限制**\n不涉及\n**取值范围**\n- include: 表示包含\n- prefix: 表示前缀\n- suffix: 表示后缀\n- notInclude: 表示不包含\n- equal: 表示相等,当operator为equal,value为空字符串时表示为全部\n- all: 表示全部\n**默认取值**\n不涉及",
          "enum": [
            "include",
            "prefix",
            "suffix",
            "notInclude",
            "equal",
            "all"
          ]
        },
        "value": {
          "$ref": "#/definitions/TMSValue"
        }
      }
    },
    "TMSKey": {
      "type": "string",
      "description": "**参数解释**\nTMS标签键规范\n**约束限制**\n不涉及\n**取值范围**\n长度为[1,128]个字符\n**默认取值**\n不涉及",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^([一-鿿]|[a-z]|[A-Z]|[0-9]|_|-)+$"
    },
    "TMSValue": {
      "type": "string",
      "description": "**参数解释**\nTMS标签值规范\n**约束限制**\n不涉及\n**取值范围**\n长度为[0,43]个字符\n**默认取值**\n不涉及",
      "minLength": 0,
      "maxLength": 43,
      "pattern": "^([一-鿿]|[a-z]|[A-Z]|[0-9]|\\.|_|-)*$"
    },
    "CreateResourceGroup": {
      "description": "资源分组中选择的资源信息。",
      "properties": {
        "namespace": {
          "$ref": "#/definitions/ResourceNamespace"
        },
        "dimensions": {
          "type": "array",
          "description": "**参数解释**\n资源的维度信息\n**约束限制**\n不超过4个维度",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/MetricsDimension"
          }
        },
        "relation_id": {
          "type": "string",
          "description": "**参数解释**\n关联id\n**约束限制**\n不涉及\n**取值范围**\n由数字、字母,_和-组成长度[1,128]\n**默认取值**\n不涉及",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^([a-z]|[A-Z]|[0-9]|_|-)+$"
        }
      },
      "required": [
        "namespace",
        "dimensions"
      ]
    },
    "MetricsDimension": {
      "properties": {
        "name": {
          "type": "string",
          "description": "**参数解释**\n资源维度,如:弹性云服务器,则维度为instance_id;目前最大支持4个维度,各服务资源的维度名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。\n**约束限制**\n不涉及\n**取值范围**\n由字母开头,后面可以包含字母、数字、_或-,长度为[1,32]个字符\n**默认取值**\n不涉及",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-)*$"
        },
        "value": {
          "type": "string",
          "description": "**参数解释**\n资源维度值,为资源的实例ID,如:4270ff17-aba3-4138-89fa-820594c39755。\n**约束限制**\n不涉及\n**取值范围**\n长度为[1,256]个字符\n**默认取值**\n不涉及",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^([a-z]|[A-Z]|[0-9]|\\*|_|/|#|\\(|\\)){1}([a-z]|[A-Z]|[0-9]|_|-|\\.|/|#|\\(|\\))*$"
        }
      },
      "description": "指标维度",
      "required": [
        "name",
        "value"
      ]
    },
    "ResourceNamespace": {
      "type": "string",
      "description": "**参数解释**\n查询服务的命名空间,各服务命名空间请参阅[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)。\n**约束限制**\n不涉及\n**取值范围**\n格式为service.item;service和item必须是字符串,必须以字母开头,只能包含0-9/a-z/A-Z/_。字符串的长度必须在 3 到 32个字符之间。\n**默认取值**\n不涉及",
      "minLength": 3,
      "maxLength": 32,
      "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*\\.([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_)*$",
      "example": "SYS.ECS"
    },
    "CreateResourceGroupRequestBody": {
      "description": "创建资源分组,请求参数。",
      "required": [
        "group_name"
      ],
      "properties": {
        "group_name": {
          "type": "string",
          "description": "**参数解释**\n资源分组的名称\n**约束限制**\n不涉及\n**取值范围**\n只能为字母、数字、汉字、-或_,长度为[1,128]个字符\n**默认取值**\n不涉及",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^([一-鿿]|[a-z]|[A-Z]|[0-9]|_|-)+$"
        },
        "resources": {
          "type": "array",
          "description": "**参数解释**\n手动创建时的资源详情。\n**约束限制**\n不超过1000个资源。",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/CreateResourceGroup"
          }
        },
        "type": {
          "description": "**参数解释**\n资源分组添加资源方式\n**约束限制**\n不涉及\n**取值范围**\n取值只能为EPS(同步企业项目),TAG(标签动态匹配),不传为手动添加。\n**默认取值**\n不涉及",
          "type": "string",
          "pattern": "^(EPS|TAG)$",
          "example": "TAG"
        },
        "relation_ids": {
          "type": "array",
          "description": "**参数解释**\n该资源分组内包含的资源来源的企业项目ID。\n**约束限制**\ntype为EPS时必传,不超过50个企业项目ID。",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "description": "**参数解释**\n企业项目ID。\n**约束限制**\n不涉及。\n**取值范围**\n由数字、字母和-组成,或者为0(默认企业项目ID)。\n**默认取值**\n不涉及。",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^([a-z]|[A-Z]|[0-9]|_|-)+$",
            "example": "d61d4705-5658-42f5-8e0c-70eb34d17b02"
          }
        },
        "tags": {
          "type": "array",
          "description": "**参数解释**\n标签动态匹配时的关联标签。\n**约束限制**\ntype为TAG时必传,不超过50个标签。",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/ResourceGroupTagRelation"
          }
        },
        "enterprise_project_id": {
          "description": "**参数解释**\n资源分组归属企业项目ID\n**约束限制**\n不涉及\n**取值范围**\n由数字、字母和-组成,或者为0(默认企业项目ID)。\n**默认取值**\n不涉及",
          "type": "string",
          "pattern": "^((([a-z]|[0-9]){8}-([a-z]|[0-9]){4}-([a-z]|[0-9]){4}-([a-z]|[0-9]){4}-([a-z]|[0-9]){12})|0)$",
          "example": 0
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "**参数解释**:\n项目ID。用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。获取方式请参见[获取项目ID](https://support.huaweicloud.com/api-ces/ces_03_0057.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[1,64]个字符。\n**默认取值**:\n不涉及。",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ContentType": {
      "name": "Content-Type",
      "in": "header",
      "required": false,
      "description": "**参数解释**:\n发送的实体的MIME类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[1,64]个字符。\n**默认取值**:\n默认使用 application/json; charset=UTF-8,如果API是对象、镜像上传等接口,媒体类型可按照流类型的不同进行确定。",
      "type": "string",
      "default": "application/json; charset=UTF-8",
      "minLength": 1,
      "maxLength": 64,
      "x-order": 1
    },
    "AuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": false,
      "description": "**参数解释**:\n用户Token。\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[1,16384]个字符。\n**默认取值**:\n不涉及。",
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "x-order": 2
    }
  },
  "host": "ces.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
