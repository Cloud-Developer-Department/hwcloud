            "pattern": "^([a-z]|[A-Z]|[0-9]|-){2,64}$",
            "example": "np15563156337845e8A2Wv63",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "example": {
        "notification_enabled": true,
        "alarm_notifications": [
          {
            "type": "",
            "notification_list": []
          }
        ],
        "ok_notifications": [
          {
            "type": "",
            "notification_list": []
          }
        ],
        "notification_begin_time": "00:00",
        "notification_end_time": "23:59"
      }
    },
