          "enum": [
            "NOTIFICATION_GROUP",
            "TOPIC_SUBSCRIPTION",
            "NOTIFICATION_POLICY"
          ],
          "minLength": 0,
          "maxLength": 64
        },
        "notification_policy_ids": {
          "type": "array",
