  "definitions": {
    "SMNUrnResp": {
      "description": "**参数解释**:\n通知组、通知对象对应的SMN主题URN。\n**取值范围**:\n只能包含字母、数字、“-”、“_” 、“:”。",
      "type": "string",
      "pattern": "^((urn:smn:([a-z]|[A-Z]|[0-9]|\\-){1,32}:([a-z]|[A-Z]|[0-9]){32}:([a-z]|[A-Z]|[0-9]|\\-|\\_){1,256})|(ct|cg)([a-z]|[A-Z]|[0-9]){22})$",
      "example": "urn:smn:123"
    },
    "NotificationBeginTimeResp": {
      "type": "string",
      "description": "**参数解释**:\n告警通知开启时间。如 00:00   \n**取值范围**:\n只能包含数字、“:”,长度为[1,64]个字符。",
      "pattern": "^([01][0-9]|2[0-3]):([0-5][0-9])$",
      "minLength": 1,
      "maxLength": 64,
      "example": "00:00"
    },
    "OkNotifications": {
      "items": {
        "$ref": "#/definitions/Notification"
      },
      "type": "array",
      "description": "**参数解释**:\n告警恢复时,通知组/主题订阅的信息。\n**约束限制**:\n包含的通知对象信息的数量最多为10个,最少为0个。",
      "minItems": 0,
      "maxItems": 10
    },
    "NotificationResp": {
      "properties": {
        "type": {
          "type": "string",
          "description": "**参数解释**:\n通知类型。\n**取值范围**:\n枚举值。\n- notification:通知组或主题订阅。\n- contact:云账号联系人。\n- contactGroup:(已废弃)通知组。\n- autoscaling:AS通知,只在AS中使用,不推荐客户使用。\n- groupwatch:已废弃,不推荐使用。\n- ecsRecovery:已废弃,不推荐使用。\n- iecAction:已废弃,不推荐使用。",
          "enum": [
            "notification",
            "autoscaling",
            "groupwatch",
            "ecsRecovery",
            "contact",
            "contactGroup",
            "iecAction"
          ],
          "example": "notification"
        },
        "notification_list": {
          "description": "**参数解释**:\n 告警状态发生变化时,被通知对象的列表。topicUrn可从SMN获取,具体操作请参考查询Topic列表。",
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/SMNUrnResp"
          }
        }
      }
    },
    "OkNotificationsResp": {
      "items": {
        "$ref": "#/definitions/NotificationResp"
      },
      "type": "array",
      "description": "**参数解释**:\n告警恢复时,通知组/主题订阅的信息。",
      "minItems": 0,
      "maxItems": 10
    },
    "NotificationEnabledResp": {
      "type": "boolean",
      "description": "**参数解释**:\n是否开启告警通知。    \n**取值范围**:\n布尔值。\n- true:开启。\n- false:关闭。",
      "example": true
    },
    "AlarmNotifications": {
      "items": {
        "$ref": "#/definitions/Notification"
      },
      "type": "array",
      "description": "**参数解释**:\n触发告警时,通知组/主题订阅的信息。\n**约束限制**:\n包含的通知对象信息的数量最多为10个,最少为0个。",
      "minItems": 0,
      "maxItems": 10
    },
    "AlarmNotificationsResp": {
      "items": {
        "$ref": "#/definitions/NotificationResp"
      },
      "type": "array",
      "description": "**参数解释**:\n触发告警时,通知组/主题订阅的信息。",
      "minItems": 0,
      "maxItems": 10
    },
    "EffectiveTimezoneResp": {
      "type": "string",
      "description": "**参数解释**:\n时区,形如:\"GMT-08:00\"、\"GMT+08:00\"、\"GMT+0:00\"。   \n**取值范围**:\n长度为[1,16]个字符。",
      "example": "GMT-08:00",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^(GMT[+-](0|0[1-9]|1[0-2]):00)$"
    },
    "EffectiveTimezone": {
      "type": "string",
      "description": "**参数解释**:\n时区,形如:\"GMT-08:00\"、\"GMT+08:00\"、\"GMT+0:00\"。   \n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[1,16]个字符。          \n**默认取值**:\n不涉及。",
      "example": "GMT-08:00",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^(GMT[+-](0|0[1-9]|1[0-2]):00)$"
    },
    "NotificationEndTime": {
      "type": "string",
      "description": "**参数解释**:\n告警通知关闭时间。如 08:00 \n**约束限制**:\n不涉及。\n**取值范围**:\n只能包含数字、“:”,长度为[1,64]个字符。          \n**默认取值**:\n不涉及。",
      "pattern": "^([01][0-9]|2[0-3]):([0-5][0-9])$",
      "minLength": 1,
      "maxLength": 64,
      "example": "23:59"
    },
