  "definitions": {
    "OkNotifications": {
      "items": {
        "$ref": "#/definitions/Notification"
      },
      "type": "array",
      "description": "**参数解释**:\n告警恢复时,通知组/主题订阅的信息。\n**约束限制**:\n包含的通知对象信息的数量最多为10个,最少为0个。",
      "minItems": 0,
      "maxItems": 10
    },
    "AlarmNotifications": {
      "items": {
        "$ref": "#/definitions/Notification"
      },
      "type": "array",
      "description": "**参数解释**:\n触发告警时,通知组/主题订阅的信息。\n**约束限制**:\n包含的通知对象信息的数量最多为10个,最少为0个。",
      "minItems": 0,
      "maxItems": 10
    },
    "EffectiveTimezone": {
      "type": "string",
      "description": "**参数解释**:\n时区,形如:\"GMT-08:00\"、\"GMT+08:00\"、\"GMT+0:00\"。   \n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[1,16]个字符。          \n**默认取值**:\n不涉及。",
      "example": "GMT-08:00",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^(GMT[+-](0|0[1-9]|1[0-2]):00)$"
    },
    "NotificationEndTime": {
      "type": "string",
      "description": "**参数解释**:\n告警通知关闭时间。如 08:00 \n**约束限制**:\n不涉及。\n**取值范围**:\n只能包含数字、“:”,长度为[1,64]个字符。          \n**默认取值**:\n不涉及。",
      "pattern": "^([01][0-9]|2[0-3]):([0-5][0-9])$",
      "minLength": 1,
      "maxLength": 64,
      "example": "23:59"
    },
    "GoAPIErrorResponseV2": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "ces.0001",
          "description": "请求异常内部业务状态码",
          "minLength": 0,
