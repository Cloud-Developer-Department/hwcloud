          "description": "请求ID",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "Notification": {
      "required": [
        "type",
        "notification_list"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "**参数解释**:\n通知类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n枚举值。\n- notification:通知组或主题订阅。\n- contact:云账号联系人。\n- contactGroup:(已废弃)通知组。\n- autoscaling:AS通知,只在AS中使用。\n- groupwatch:已废弃,不推荐使用。\n- ecsRecovery:已废弃,不推荐使用。\n- iecAction:已废弃,不推荐使用。\n**默认取值**:\n不涉及。",
          "enum": [
            "notification",
            "autoscaling",
            "groupwatch",
            "ecsRecovery",
            "contact",
            "contactGroup",
            "iecAction"
          ],
          "example": "notification"
        },
        "notification_list": {
          "description": "**参数解释**:\n 告警状态发生变化时,被通知对象的列表。topicUrn可从SMN获取,具体操作请参考查询Topic列表。\n**约束限制**:\n当type为notification时,notification_list列表不能为空;当type为autoscaling时,列表必须为[]。若notification_enabled为true,对应的alarm_notifications、ok_notifications至少有一个不能为空。若alarm_notifications、ok_notification同时存在时,notification_list值保持一致。最多包含20个通知对象,最少可以为0个。",
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/SMNUrn"
          }
        }
      }
    },
    "NotificationEnabled": {
      "type": "boolean",
      "description": "**参数解释**:\n是否开启告警通知。说明:若notification_enabled为true,对应的alarm_notifications、ok_notifications至少有一个不能为空。   \n**约束限制**:\n不涉及。\n**取值范围**:\n布尔值。\n- true:开启。\n- false:关闭。\n**默认取值**:\ntrue",
      "default": true,
      "example": true
    },
    "NotificationBeginTime": {
      "type": "string",
      "description": "**参数解释**:\n告警通知开启时间。如 00:00   \n**约束限制**:\n不涉及。\n**取值范围**:\n只能包含数字、“:”,长度为[1,64]个字符。          \n**默认取值**:\n不涉及。",
      "pattern": "^([01][0-9]|2[0-3]):([0-5][0-9])$",
      "minLength": 1,
      "maxLength": 64,
      "example": "00:00"
    },
    "UpdateOneClickAlarmNotificationsRequestBody": {
      "required": [
        "notification_enabled"
      ],
      "properties": {
        "notification_enabled": {
          "description": "**参数解释**:\n是否开启告警通知。\n**约束限制**:\n值为true时,其他必选字段均需填,值为false时,其他所有字段不可选。\n**取值范围**:\n布尔值。\n- true:开启告警通知。\n- false:关闭告警通知。\n**默认取值**:\n不涉及。",
          "$ref": "#/definitions/NotificationEnabled"
        },
        "alarm_notifications": {
          "$ref": "#/definitions/AlarmNotifications"
        },
        "ok_notifications": {
          "$ref": "#/definitions/OkNotifications"
        },
        "notification_begin_time": {
          "$ref": "#/definitions/NotificationBeginTime"
        },
        "notification_end_time": {
          "$ref": "#/definitions/NotificationEndTime"
        },
        "effective_timezone": {
          "$ref": "#/definitions/EffectiveTimezone"
        },
        "notification_manner": {
          "type": "string",
          "enum": [
            "NOTIFICATION_GROUP",
            "TOPIC_SUBSCRIPTION",
            "NOTIFICATION_POLICY"
          ],
          "description": "**参数解释**:\n通知方式。\n**约束限制**:\n不涉及。\n**取值范围**:\n枚举值。取值为NOTIFICATION_GROUP、TOPIC_SUBSCRIPTION、NOTIFICATION_POLICY\n- NOTIFICATION_GROUP: 通知组\n- TOPIC_SUBSCRIPTION: 主题订阅\n- NOTIFICATION_POLICY: 通知策略\n**默认取值**:\n不涉及。",
          "minLength": 0,
          "maxLength": 64
        },
        "notification_policy_ids": {
          "type": "array",
          "description": "**参数解释**:\n关联的通知策略ID列表。\n**约束限制**:\n包含的通知策略ID最多为20个,最少为0个。",
          "items": {
            "type": "string",
            "description": "**参数解释**:\n通知策略ID\n**约束限制**:\n不涉及。\n**取值范围**:\n长度为[2,64]个字符。只能包含字母或数字或-符号\n**默认取值**:\n不涉及。",
            "example": "np15563156337845e8A2Wv63",
            "minLength": 0,
            "maxLength": 64,
            "pattern": "([a-z]|[A-Z]|[0-9]|-){2,64}$"
          },
          "minItems": 0,
          "maxItems": 20
        }
      }
    },
    "SMNUrn": {
      "description": "**参数解释**:\n通知组、通知对象对应的SMN主题URN。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能包含字母、数字、“-”、“_” 、“:”。    \n**默认取值**:\n不涉及。",
      "type": "string",
      "pattern": "^((urn:smn:([a-z]|[A-Z]|[0-9]|\\-){1,32}:([a-z]|[A-Z]|[0-9]){32}:([a-z]|[A-Z]|[0-9]|\\-|\\_){1,256})|(ct|cg)([a-z]|[A-Z]|[0-9]){22})$",
      "example": "urn:smn:123"
    }
  },
