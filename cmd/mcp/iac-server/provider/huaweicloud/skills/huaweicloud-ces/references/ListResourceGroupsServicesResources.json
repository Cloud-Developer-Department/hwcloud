      "required": [
        "status",
        "dimensions"
      ],
      "properties": {
        "status": {
          "description": "**参数解释**\n按事件告警状态信息进行过滤。\n**取值范围**\n枚举值。\n- health: 表示无告警\n- unhealthy: 表示告警中\n- no_alarm_rule: 表示未设置告警规则",
