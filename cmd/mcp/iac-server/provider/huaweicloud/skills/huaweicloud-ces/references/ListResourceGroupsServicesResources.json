          "minLength": 0,
          "maxLength": 10240
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "**参数解释**\n企业项目ID。\n**取值范围**\n由数字、字母和-组成,字符串长度范围[1,128]",
          "minLength": 0,
          "maxLength": 128
        },
        "event_status": {
          "description": "**参数解释**\n按事件告警状态信息进行过滤。\n**取值范围**\n枚举值。\n- health: 表示无告警\n- unhealthy: 表示告警中\n- no_alarm_rule: 表示未设置告警规则",
          "type": "string",
          "example": "health",
          "enum": [
            "health",
            "unhealthy",
            "no_alarm_rule"
          ]
        },
        "resource_name": {
          "type": "string",
          "description": "**参数解释**\n资源名称\n**取值范围**\n长度[0,128]个字符",
          "minLength": 0,
          "maxLength": 128
        }
      }
    },
    "GoAPIErrorResponseV2": {
      "type": "object",
      "properties": {
