    "ResourceDimension": {
      "description": "资源维度",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "description": "**参数解释**\n资源维度名称,如:弹性云服务器,则维度为instance_id;各服务资源的维度名称,请参阅具体云服务的文档。您可以直接从[支持监控的服务列表](https://support.huaweicloud.com/api-ces/ces_03_0059.html)页面导航至相应文档。\n**约束限制**\n不涉及\n**取值范围**\n由字母开头,后面可以包含字母、数字、_或-,长度为[1,32]个字符\n**默认取值**\n不涉及",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^([a-z]|[A-Z]){1}([a-z]|[A-Z]|[0-9]|_|-)*$",
          "example": "instance_id"
        },
        "value": {
          "description": "**参数解释**\n资源维度值,为资源的实例ID,如:4270ff17-aba3-4138-89fa-820594c39755。\n**约束限制**\n不涉及\n**取值范围**\n长度为[1,256]个字符\n**默认取值**\n不涉及",
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^((([a-z]|[A-Z]|[0-9]|\\*|_|/|#|\\(|\\)){1}([a-z]|[A-Z]|[0-9]|_|-|\\.|\\*|/|#|\\(|\\))*))$",
          "example": "4270ff17-aba3-4138-89fa-820594c39755"
        }
      }
    },
