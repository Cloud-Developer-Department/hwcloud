{
  "name": "ShowOauth2UserInfo",
  "summary": "用户信息获取",
  "tags": "OAUTH",
  "productshort": "OrgID",
  "region_id": "cn-north-4",
  "paths": {
    "/oauth2/userinfo": {
      "get": {
        "tags": [
          "OAUTH"
        ],
        "operationId": "ShowOauth2UserInfo",
        "summary": "用户信息获取",
        "description": "用户级Token获取",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-OrgID-Authorization",
            "in": "header",
            "required": true,
            "description": "用户访问凭证,即 user_access_token, 示例值:\"Bearer u-7f1bcd13fc57d46bac21793a18e560\"",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "正常响应",
            "schema": {
              "$ref": "#/definitions/UserInfo"
            }
          },
          "400": {
            "description": "参数错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorInfo"
            }
          },
          "401": {
            "description": "权限错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorInfo"
            }
          },
          "500": {
            "description": "系统错误响应",
            "schema": {
              "$ref": "#/definitions/ErrorInfo"
            }
          }
        },
        "security": [
          {
            "X-Auth-Token": []
          }
        ]
      }
    }
  },
  "definitions": {
    "ErrorInfo": {
      "description": "响应结果",
      "required": [
        "error_code",
        "error"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码,错误码规范ORGID.OAUTH.0001,数字递增"
        },
        "error_msg": {
          "type": "string",
          "description": "响应描述"
        },
        "error": {
          "type": "string",
          "description": "响应码,错误码规范ORGID.OAUTH.0001,数字递增,兼容原开放接口字段,值复制上方字段"
        },
        "error_description": {
          "type": "string",
          "description": "响应描述,兼容原开放接口字段 ,值复制上方字段"
        }
      },
      "type": "object"
    },
    "UserInfo": {
      "description": "用户信息",
      "required": [
        "tenant",
        "name",
        "mobile",
        "user_name",
        "user_id"
      ],
      "properties": {
        "tenant": {
          "type": "string",
          "description": "租户code,这里即企业code"
        },
        "name": {
          "type": "string",
          "description": "用户显示名"
        },
        "mobile": {
          "type": "string",
          "description": "手机号"
        },
        "user_name": {
          "type": "string",
          "description": "用户登录账号"
        },
        "user_id": {
          "type": "string",
          "description": "用户外部id"
        },
        "email": {
          "type": "string",
          "description": "邮箱"
        },
        "role": {
          "type": "string",
          "description": "角色,枚举:user或者admin"
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "orgid-external.cn-north-4.myhuaweicloud.com",
  "base_path": "/orgid/openapi/v1",
  "info_version": "v1",
  "method": "get",
  "uri": null
}