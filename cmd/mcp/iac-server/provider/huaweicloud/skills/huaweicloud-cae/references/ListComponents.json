      "type": "object",
      "description": "构建附加参数。\n- base_image:基础镜像地址。\n- build_cmd:自定义构建命令。\n- dockerfile_path:自定义dockerfile文件路径\n- dockerfile_content:自定义dockerfile内容\n- artifact_name: 针对java多模块构建,指定构建后运行的产物,以\".jar\"结尾。",
      "additionalProperties": {
        "type": "string"
      },
      "example": {
        "base_image": "openjdk:8u181-jdk-alpine",
        "build_cmd": "mvn clean package"
      }
    },
    "Access": {
      "type": "object",
