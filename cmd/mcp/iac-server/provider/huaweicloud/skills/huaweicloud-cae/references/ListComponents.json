        },
        "replica": {
          "type": "integer",
          "format": "int32",
          "description": "实例个数。"
        },
        "source": {
          "$ref": "#/definitions/Source"
        },
        "build": {
          "$ref": "#/definitions/Build"
        },
        "resource_limit": {
          "$ref": "#/definitions/ResourceLimit"
        },
        "access_info": {
          "$ref": "#/definitions/AccessInfo"
        },
        "image_url": {
          "description": "镜像地址。",
          "type": "string"
        },
        "available_replica": {
          "type": "integer",
          "format": "int32",
          "description": "可用实例个数。"
        },
        "job_id": {
          "description": "任务ID。",
          "type": "string"
        },
        "build_id": {
          "type": "string",
          "description": "构建任务ID。"
        },
        "status": {
