      "properties": {
        "address": {
          "type": "string",
          "description": "访问地址。"
        },
        "type": {
          "type": "string",
          "description": "访问方式类型。",
          "enum": [
            "LoadBalancer",
            "Ingress"
          ]
        }
      }
    },
