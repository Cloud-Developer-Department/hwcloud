          "type": "string",
          "format": "date-time",
          "description": "创建时间。"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "更新时间。"
        },
        "spec": {
          "description": "组件规格。",
          "$ref": "#/definitions/ComponentSpec"
