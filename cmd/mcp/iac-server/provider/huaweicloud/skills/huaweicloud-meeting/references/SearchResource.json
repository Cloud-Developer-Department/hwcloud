{
  "name": "SearchResource",
  "summary": "SP管理员根据分页查询企业资源",
  "tags": "企业资源管理",
  "productshort": "Meeting",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/usg/dcs/sp/corp/{corp_id}/resource": {
      "get": {
        "summary": "SP管理员根据分页查询企业资源",
        "description": "SP根据条件查询企业的资源项。",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 4,
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "$ref": "#/parameters/X-Request-ID"
          },
          {
            "$ref": "#/parameters/Accept-Language"
          },
          {
            "$ref": "#/parameters/offset"
          },
          {
            "$ref": "#/parameters/limit"
          },
          {
            "name": "searchKey",
            "in": "query",
            "type": "string",
            "description": "搜索条件。",
            "maxLength": 255,
            "minLength": 0,
            "x-example": "5d35397d67504dd1b7e1766a25f1be11"
          },
          {
            "name": "corp_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "企业id。",
            "x-example": "818803911"
          },
          {
            "name": "startExpireDate",
            "in": "query",
            "description": "查询过期时间在该时间戳之后的资源项。",
            "type": "integer",
            "format": "int64",
            "x-example": 1572969600000
          },
          {
            "name": "endExpireDate",
            "in": "query",
            "description": "查询过期时间在该时间戳之前的资源项。",
            "type": "integer",
            "format": "int64",
            "x-example": 1620316799999
          },
          {
            "name": "type",
            "in": "query",
            "type": "string",
            "description": "资源类型。",
            "maxLength": 32,
            "x-example": "VMR"
          },
          {
            "name": "typeId",
            "in": "query",
            "type": "string",
            "description": "资源类型Id,若想搜索5方VMR时,需携带5方vmrpkg对应的id。",
            "maxLength": 32,
            "x-example": "ff808081699b56cb0169c411a0980152"
          },
          {
            "name": "status",
            "in": "query",
            "description": "订单状态:\n- 0:正常\n- 1:到期,仅查询时返回\n- 2:停用",
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "x-example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "schema": {
              "$ref": "#/definitions/SearchResourceReturnResultPage"
            },
            "examples": {
              "application/json": {
                "offset": 0,
                "limit": 5,
                "count": 1,
                "data": [
                  {
                    "id": "b974dfbe2daf456880afd10c80d12c9f",
                    "type": "VMR",
                    "typeId": "ff808081699b56cb0169c411a0980152",
                    "typeDesc": null,
                    "count": 10,
                    "expireDate": 2549030400000,
                    "status": 0,
                    "editable": true
                  }
                ]
              }
            }
          },
          "401": {
            "description": "未鉴权或鉴权失败。",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "403": {
            "description": "权限受限。",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "400": {
            "description": "参数异常。",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          }
        },
        "tags": [
          "企业资源管理"
        ],
        "operationId": "SearchResource",
        "x-imports": "com.huawei.springframework.response.dto.*;com.huawei.springframework.security.auth.annotation.TokenAuthorization;com.huawei.springframework.security.auth.constants.*;com.huawei.usg.datacenter.model.resource.*;",
        "x-methodAnnotations": [
          "@TokenAuthorization(userType = UserTypeEnum.SP_ADMIN)"
        ],
        "x-returnType": "Pages<QueryResourceResultDTO>",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/usg/dcs/sp/corp/818803911/resource?offset=0&limit=5&searchKey=5d35397d67504dd1b7e1766a25f1be11&startExpireDate=1572969600000&endExpireDate=1620316799999&type=VMR&typeId=ff808081699b56cb0169c411a0980152&status=0",
        "x-request-examples-text-1": "GET https://{endpoint}/v1/usg/dcs/sp/corp/818803911/resource?offset=0&limit=5&searchKey=5d35397d67504dd1b7e1766a25f1be11&startExpireDate=1572969600000&endExpireDate=1620316799999&type=VMR&typeId=ff808081699b56cb0169c411a0980152&status=0"
      }
    }
  },
  "definitions": {
    "Pages": {
      "x-subPackage": "discard",
      "description": "分页查询的公共属性。",
      "properties": {
        "offset": {
          "type": "integer",
          "description": "页面起始页,从0开始。",
          "example": 0
        },
        "limit": {
          "type": "integer",
          "description": "每页显示的条目数量。\n默认值:10。",
          "example": 5
        },
        "count": {
          "type": "integer",
          "description": "总数量。",
          "example": 1
        }
      }
    },
    "QueryResourceResultDTO": {
      "x-subPackage": "resource",
      "properties": {
        "id": {
          "description": "唯一标识若携带则以携带为准,企业内保证唯一,否则后台自动生成UUID。",
          "type": "string"
        },
        "type": {
          "description": "资源类型。\n- VMR        - 云会议室\n- CONF_CALL  - 会议并发数\n- HARD_1080P - 1080P硬终端\n- HARD_720P  - 720P硬终端\n- SOFT       - 软终端用户数\n- ROOM       - 大屏软终端\n- LIVE       - 直播推流\n- RECORD     - 录播空间\n- HARD_THIRD_PARTY - 第三方硬终端帐号\n- HUAWEI_VISION -智慧屏\n- IDEA_HUB   - ideahub",
          "type": "string"
        },
        "typeId": {
          "description": "资源标识,比如资源类型为VMR,则该参数为vmrPkgId。",
          "type": "string"
        },
        "typeDesc": {
          "description": "资源标识对应的回显描述,比如资源类型为VMR,则该参数为vmrPkgName。",
          "type": "string"
        },
        "vmrMode": {
          "description": "VMR模式。\n- 0:个人会议ID\n- 1:云会议室\n- 2:网络研讨会",
          "type": "integer"
        },
        "count": {
          "description": "资源数量。",
          "type": "integer"
        },
        "expireDate": {
          "description": "到期时间,utc时间戳。",
          "type": "integer",
          "format": "int64"
        },
        "orderId": {
          "description": "资源对应的订单id。",
          "type": "string"
        },
        "status": {
          "type": "integer",
          "description": "资源状态:\n- 0:正常\n- 1:到期\n- 2:停用"
        },
        "editable": {
          "description": "标识资源是否可以编辑或删除。",
          "type": "boolean"
        }
      }
    },
    "SearchResourceReturnResultPage": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "allOf": [
        {
          "$ref": "#/definitions/Pages"
        },
        {
          "properties": {
            "data": {
              "type": "array",
              "description": "分页查询企业的资源项。",
              "items": {
                "$ref": "#/definitions/QueryResourceResultDTO"
              }
            }
          }
        }
      ]
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "description": "异常返回结果。",
      "required": [
        "error_code",
        "error_msg",
        "request_id"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。"
        }
      }
    }
