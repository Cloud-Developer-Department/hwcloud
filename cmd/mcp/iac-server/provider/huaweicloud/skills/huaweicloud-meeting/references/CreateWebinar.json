          "description": "发送邮件是否开启。\n* Y:开启\n* N: 不开启",
          "type": "string",
          "example": "N"
        }
      }
    },
    "OpenScheduleConfReq": {
      "type": "object",
      "title": "OpenScheduleConfReq",
      "description": "创建网络研讨会请求。",
      "x-annotations": [
        "@JsonInclude(JsonInclude.Include.NON_NULL)"
      ],
      "x-imports": [
        "com.huawei.meeting.webinar.web.model.*;",
        "com.fasterxml.jackson.databind.annotation.*;",
        "com.fasterxml.jackson.annotation.JsonInclude;",
        "com.huawei.meeting.framework.validator.DateFormatValid;",
        "com.huawei.meeting.framework.serializer.*;",
        "org.hibernate.validator.constraints.Length;"
      ],
      "required": [
        "subject",
        "startTime",
        "duration",
        "timeZoneId",
        "vmrID"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "description": "网络研讨会主题。长度限制为128个字符。",
          "example": "周例行网络研讨会"
        },
        "description": {
          "type": "string",
          "description": "网络研讨会描述,长度限制为1000个字符。",
          "example": "周例行网络研讨会, 周一召开。"
        },
        "startTime": {
          "type": "string",
          "description": "网络研讨会开始时间(UTC时间),格式“yyyy-MM-dd HH:mm”。",
          "example": "2020-12-12 09:30"
        },
        "duration": {
          "type": "integer",
          "format": "int32",
          "description": "网络研讨会持续时长,单位分钟,取值范围[15,1440]。",
          "example": 120
        },
        "timeZoneId": {
          "type": "integer",
          "format": "int32",
          "description": "会议通知中会议时间的时区信息。时区信息,参考[时区映射关系](https://support.huaweicloud.com/api-meeting/meeting_21_0110.html#ZH-CN_TOPIC_0212714472__table137407441463)。\n> * 举例:“timeZoneID”:\"26\",则通过华为云会议发送的会议通知中的时间将会标记为如“2021/11/11 星期四 00:00 - 02:00 (GMT) 格林威治标准时间:都柏林, 爱丁堡, 里斯本, 伦敦”。",
          "example": 56
        },
        "attendees": {
          "type": "array",
          "description": "与会嘉宾列表。\n> 观众只能自己通过链接或者会议ID+密码加入,不支持被邀请。",
          "items": {
            "$ref": "#/definitions/OpenAttendeeEntity"
          }
        },
        "notifySetting": {
          "$ref": "#/definitions/OpenNotifySetting"
        },
        "vmrID": {
          "type": "string",
          "description": "绑定给当前创建网络研讨会帐号的VMR ID。通过[查询云会议室及个人会议ID](https://support.huaweicloud.com/api-meeting/meeting_21_1106.html)接口获取。\n> * vmrID取上述查询接口中返回的id,不是vmrId。\n> * 创建网络研讨会时,使用vmrMode=2的VMR。",
          "example": "ff80808167ef1edf0167f339533f05a8"
        },
        "guestPasswd": {
          "type": "string",
          "description": "嘉宾密码(4-16位长度的纯数字)。不指定则系统自动生成。",
          "example": 222222
        },
        "audiencePasswd": {
          "type": "string",
          "description": "观众密码(4-16位长度的纯数字)。不指定则系统自动生成。",
          "example": 333333
        },
        "callRestriction": {
          "type": "boolean",
          "description": "入会范围开关。\n* false:不限制入会范围\n* true:限制入会范围",
          "example": false
        },
        "scope": {
          "type": "integer",
          "description": "主持人、嘉宾入会范围 。仅callRestriction设置成true后生效。\n* 0: 所有用户\n* 2: 企业内用户\n* 3: 被邀请用户",
          "example": 0
        },
        "audienceScope": {
          "type": "integer",
          "description": "观众入会范围。仅callRestriction设置成true后生效。\n* 0: 所有用户\n* 2: 企业内用户和被邀请用户",
          "example": 0
        },
        "enableRecording": {
          "description": "开启录制,Y-开启,N-不开启",
          "$ref": "#/definitions/YesNoEnum",
          "example": "Y"
        },
        "liveAddress": {
          "type": "string",
          "description": "主流直播推流地址,在录播类型为 :直播、直播+录播时有效。最大不超过255个字符。",
          "maxLength": 255,
          "minLength": 0,
          "example": "rtmp://example/live"
        },
        "auxAddress": {
          "type": "string",
          "description": "辅流直播推流地址,在录播类型为 :直播、直播+录播时有效。最大不超过255个字符。",
          "maxLength": 255,
          "minLength": 0,
          "example": "rtmp://example/aux"
        },
        "liveUrl": {
          "type": "string",
          "description": "直播房间地址,在录播类型为录播+直播推流时有效。最大不超过255个字符。",
          "maxLength": 255,
          "minLength": 0,
          "example": "https://example/watch"
        }
      }
    },
