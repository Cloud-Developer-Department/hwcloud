{
  "name": "ShowDeviceDetail",
  "summary": "查询终端详情",
  "tags": "硬终端管理",
  "productshort": "Meeting",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/usg/dcs/corp/device/{sn}": {
      "get": {
        "tags": [
          "硬终端管理"
        ],
        "summary": "查询终端详情",
        "description": "企业管理员通过该接口查询专业会议终端详情。\n> 如果需要查询Ideahub、SmartRooms、智慧屏TV详情请使用[查询用户详情](https://support.huaweicloud.com/api-meeting/meeting_21_0069.html)接口。",
        "operationId": "ShowDeviceDetail",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "$ref": "#/parameters/X-Request-ID"
          },
          {
            "$ref": "#/parameters/Accept-Language"
          },
          {
            "name": "sn",
            "in": "path",
            "description": "终端SN号,仅可包含数字、字母和下划线。",
            "x-example": "I2lwxg01VgZWM1bmzEBzpC52ZvvOw3",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "schema": {
              "$ref": "#/definitions/QueryDeviceResultDTO"
            },
            "examples": {
              "application/json": {
                "name": "Hangzhou Z5-3-A29",
                "type": "TE",
                "model": "TE10",
                "sn": "eT6KJz2B80iBkSeAbSQLUxltHNF6e7",
                "account": "5c10fb8f62874c00bcfea9a96a6f9f9a",
                "number": "+8657106885",
                "prjCodeMode": 0,
                "deptCode": "1",
                "deptName": "根部门",
                "deptNamePath": "根部门",
                "phone": "+86123456789",
                "country": "chinaPR",
                "email": "email@huawei.com",
                "description": "description",
                "status": 0
              }
            }
          },
          "403": {
            "description": "权限受限。",
            "examples": {
              "application/json": {
                "request_id": "208b6e4c92074487bc43292f8554561e",
                "error_code": "USG.000000004",
                "error_msg": "Illegal request"
              }
            },
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "400": {
            "description": "参数异常。",
            "examples": {
              "application/json": {
                "request_id": "208b6e4c92074487bc43292f8554561e",
                "error_code": "USG.201050000",
                "error_msg": "设备不存在"
              }
            },
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1/usg/dcs/corp/device/eT6KJz2B80iBkSeAbSQLUxltHNF6e7"
      }
    }
  },
  "definitions": {
    "QueryDeviceResultDTO": {
      "description": "终端信息。",
      "properties": {
        "name": {
          "type": "string",
          "description": "终端名称。"
        },
        "type": {
          "type": "string",
          "description": "终端类型,区分自研和第三方终端。"
        },
        "model": {
          "type": "string",
          "description": "终端型号,枚举类型。当前支持TE系列和部分第三方硬件终端,具体的终端类型可以通过[获取所有终端类型](https://support.huaweicloud.com/api-meeting/meeting_21_0092.html)接口查询。"
        },
        "sn": {
          "type": "string",
          "description": "终端SN号,仅可包含数字、字母和下划线。"
        },
        "account": {
          "type": "string",
          "description": "硬终端对应的内置帐号。"
        },
        "number": {
          "type": "string",
          "description": "终端绑定的号码。"
        },
        "prjCodeMode": {
          "type": "integer",
          "description": "投影码生成模式。\n* 0:自动(该模式下根据消息上报的IP地址内部控制复杂度:私网地址配置成简单模式;公网地址配置成复杂模式)\n* 1:简单\n* 2:复杂"
        },
        "deptCode": {
          "type": "string",
          "description": "部门编码。"
        },
        "deptName": {
          "type": "string",
          "description": "部门名称。"
        },
        "deptNamePath": {
          "type": "string",
          "description": "部门名称路径。"
        },
        "phone": {
          "type": "string",
          "description": "手机号。"
        },
        "country": {
          "type": "string",
          "description": "[手机号所属的国家](https://support.huaweicloud.com/api-meeting/meeting_21_0109.html#ZH-CN_TOPIC_0212714591__table19371178135314) 。"
        },
        "email": {
          "type": "string",
          "description": "邮箱地址。"
        },
        "description": {
          "type": "string",
          "description": "终端描述。"
        },
        "status": {
          "type": "integer",
          "description": "终端状态。\n* 0、正常\n* 1、停用\""
        }
      }
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "description": "异常返回结果。",
      "required": [
        "error_code",
        "error_msg",
        "request_id"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Request-ID": {
      "name": "X-Request-Id",
      "in": "header",
      "description": "请求requestId,用来标识一路请求,用于问题跟踪定位,建议使用UUID,若不携带,则后台自动生成。",
      "required": false,
      "type": "string",
      "x-example": "208b6e4c92074487bc43292f8554561e"
    },
    "Accept-Language": {
      "name": "Accept-Language",
      "in": "header",
      "description": "语言参数,默认为中文zh-CN,英文为en-US。",
      "required": false,
      "type": "string",
      "x-example": "zh-CN"
    },
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    }
  },
  "host": "api.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}