  "definitions": {
    "QuerySpResDetailResultDTO": {
      "x-subPackage": "sp",
      "x-imports": "com.huawei.usg.datacenter.model.group.QueryGroupDTO;com.huawei.usg.datacenter.model.vmrpkg.QueryVmrPkgResResultDTO;com.huawei.usg.datacenter.model.common.*;",
      "properties": {
        "te1080pHardCount": {
          "$ref": "#/definitions/ResDetailDTO",
          "description": "1080P硬件终端接入数。"
        },
        "te720pHardCount": {
          "$ref": "#/definitions/ResDetailDTO",
          "description": "720P硬件终端接入数。"
        },
        "teSoftCount": {
          "$ref": "#/definitions/ResDetailDTO",
          "description": "软终端帐号数。"
        },
        "roomCount": {
          "$ref": "#/definitions/ResDetailDTO",
          "description": "电子白板(SmartRooms)接入数。"
        },
        "recordCapability": {
          "$ref": "#/definitions/ResDetailDTO",
          "description": "录播存储空间 (单位:G)。"
        },
        "confCallCount": {
          "$ref": "#/definitions/ResDetailDTO",
          "description": "会议并发方数。"
        },
        "liveCount": {
          "$ref": "#/definitions/ResDetailDTO",
          "description": "推流并发方数。"
        },
        "corpCount": {
          "$ref": "#/definitions/ResDetailDTO",
          "description": "企业总数。"
        },
        "thirdPartyHardCount": {
          "$ref": "#/definitions/ResDetailDTO",
          "description": "第三方硬终端接入数。"
        },
        "hwVisionCount": {
          "$ref": "#/definitions/ResDetailDTO",
          "description": "智慧屏TV接入数。"
        },
        "ideaHubCount": {
          "$ref": "#/definitions/ResDetailDTO",
          "description": "IdeaHub接入数。"
        },
        "enablePstn": {
          "description": "在创建企业的时候设置的pstn权限开关。",
          "type": "boolean"
        },
        "enableSMS": {
          "description": "企业是否通过短信形式发送会议通知。",
          "type": "boolean"
        },
        "groupList": {
          "description": "SP管理员绑定的分组列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/QueryCorpGroupDTO"
          }
        }
      }
    },
    "QueryCorpGroupDTO": {
      "x-subPackage": "corpgroup",
      "properties": {
        "groupId": {
          "description": "媒体接入分组id。",
          "type": "string"
        },
        "groupName": {
          "description": "分组名称。",
          "type": "string"
        },
        "groupType": {
          "description": "分组类型。",
          "type": "integer"
        },
        "remarks": {
          "description": "分组备注信息。",
          "type": "string"
        },
        "regionId": {
          "description": "区域ID,仅服务列表类型场景必填。",
          "type": "string"
        },
        "status": {
          "description": "分组状态。\n- 0: 正常\n- 1: 停用,服务列表类型停用后创建企业就不会再自动分配到该分组",
          "type": "integer"
        }
      }
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "description": "异常返回结果。",
      "required": [
        "error_code",
        "error_msg",
        "request_id"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。"
        }
      }
    },
    "ResDetailDTO": {
      "properties": {
        "sumCount": {
          "description": "总数。",
          "type": "integer",
          "example": 20
        },
        "trialCount": {
          "description": "赠送数量。",
          "type": "integer"
        },
        "expiredCount": {
          "description": "到期数量。",
          "type": "integer"
        },
        "expiringCount": {
          "description": "即将到期数量,到期时间在30天内。",
          "type": "integer"
        },
        "usedCount": {
          "description": "已使用数(录播存储空间、会议并发、推流并发方数暂无法查询)。",
          "type": "integer",
          "example": 5
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
