  "definitions": {
    "ModPwdReqDTO": {
      "x-subPackage": "dto",
      "required": [
        "account",
        "oldPwd",
        "newPwd"
      ],
      "properties": {
        "account": {
          "type": "string",
          "description": "帐号,必须是携带域名的帐号。",
          "maxLength": 255,
          "minLength": 1,
          "example": "3h1j64307qup927xd96xx90lv329er7809v0521l5071377nxr951n43q59t1e0s"
        },
        "oldPwd": {
          "type": "string",
          "description": "用户旧的登录密码。",
          "maxLength": 32,
          "minLength": 1,
          "example": "Qdjtufjwr4$4"
        },
        "newPwd": {
          "type": "string",
          "description": "用户新的登录密码。\n密码要求:\n* 长度范围要求8~32\n* 至少包含两种字符类型:小写字母、大写字母、数字、特殊字符(` ~ ! @ # $ % ^ & * ( ) - _ = + \\ | [ { } ] ; : \" ,' < . > / ?)\n* 旧密码和新密码不能相同\n* 上次修改密码后5分钟内不能更新密码\n* 不能与最近使用的旧密码相同\n* 不能包含3个以上重复字符\n* 密码不能包含与其对应的用户名(不区分大小写)以及逆序的用户名(不区分大小写)\n* 新密码与旧密码之间允许的最少不相同字符数为2个",
          "maxLength": 32,
          "minLength": 8,
          "example": "Huawei123"
        }
      }
    },
    "ReturnCodeDTO": {
      "x-subPackage": "discard",
      "description": "错误码。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "USG.206010000"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "example": "User name or password is incorrect"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。",
          "example": "9655664f10724b398187598a1d5097c3"
        }
      }
    }
