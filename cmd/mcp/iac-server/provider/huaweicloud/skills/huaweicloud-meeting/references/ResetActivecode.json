{
  "name": "ResetActivecode",
  "summary": "企业管理员通过sn重置激活码",
  "tags": "激活码管理",
  "productshort": "Meeting",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/usg/dcs/corp/device/{sn}/activecode": {
      "post": {
        "tags": [
          "激活码管理"
        ],
        "summary": "企业管理员通过sn重置激活码",
        "description": "当硬终端激活码失效时,企业管理员可以通过该接口重置激活码,使用重新获取的激活码激活终端,每24小时可重新激活5次。",
        "operationId": "ResetActivecode",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 5,
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "$ref": "#/parameters/X-Request-ID"
          },
          {
            "$ref": "#/parameters/Accept-Language"
          },
          {
            "name": "sn",
            "in": "path",
            "description": "终端序列号,仅可包含数字、字母和下划线。",
            "x-example": "I2lwxg01VgZWM1bmzEBzpC52ZvvOw3",
            "required": true,
            "type": "string"
          },
          {
            "name": "activeDTO",
            "in": "body",
            "required": true,
            "description": "重置激活码请求。",
            "schema": {
              "$ref": "#/definitions/ActiveDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。"
          },
          "403": {
            "description": "权限受限。",
            "examples": {
              "application/json": {
                "request_id": "208b6e4c92074487bc43292f8554561e",
                "error_code": "USG.000000004",
                "error_msg": "Illegal request"
              }
            },
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "400": {
            "description": "参数异常。",
            "examples": {
              "application/json": {
                "request_id": "208b6e4c92074487bc43292f8554561e",
                "error_code": "USG.201050010",
                "error_msg": "一天内重置设备激活码次数已达到最大值(5次)"
              }
            },
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v1/usg/dcs/corp/device/iXg0q35gRgZ5yXiW0efZKb1bmXnIen/activecode",
        "x-request-examples-1": {
          "country": "chinaPR",
          "emailAddr": "email@huawei.com",
          "smsNumber": "+86123456789"
        }
      }
    }
  },
  "definitions": {
    "ActiveDTO": {
      "description": "设备联系人信息。",
      "properties": {
        "smsNumber": {
          "type": "string",
          "description": "手机号。\n例如中国大陆手机+86xxxxxxxxxxx。当填写手机号时 “country”参数必填。\n> 号码和邮箱必须填一个,若企业未开启短信功能,则邮箱必填。",
          "example": "+86173****9092"
        },
        "country": {
          "type": "string",
          "description": "[手机号所属的国家](https://support.huaweicloud.com/api-meeting/meeting_21_0109.html#ZH-CN_TOPIC_0212714591__table19371178135314) 。",
          "example": "chinaPR"
        },
        "emailAddr": {
          "type": "string",
          "description": "邮件地址。\n> 号码和邮箱必须填一个,若企业未开启短信功能,则邮箱必填。",
          "example": "email@huawei.com"
        }
      }
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "description": "异常返回结果。",
      "required": [
        "error_code",
        "error_msg",
        "request_id"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Request-ID": {
      "name": "X-Request-Id",
      "in": "header",
      "description": "请求requestId,用来标识一路请求,用于问题跟踪定位,建议使用UUID,若不携带,则后台自动生成。",
      "required": false,
      "type": "string",
      "x-example": "208b6e4c92074487bc43292f8554561e"
    },
    "Accept-Language": {
      "name": "Accept-Language",
      "in": "header",
      "description": "语言参数,默认为中文zh-CN,英文为en-US。",
      "required": false,
      "type": "string",
      "x-example": "zh-CN"
    },
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    }
  },
  "host": "api.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}