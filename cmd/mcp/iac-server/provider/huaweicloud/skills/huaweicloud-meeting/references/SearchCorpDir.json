{
  "name": "SearchCorpDir",
  "summary": "查询企业通讯录",
  "tags": "查询企业通讯录",
  "productshort": "Meeting",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/usg/abs/users": {
      "get": {
        "summary": "查询企业通讯录",
        "tags": [
          "查询企业通讯录"
        ],
        "description": "企业用户(含管理员)通过该接口查询该企业的通讯录。",
        "operationId": "SearchCorpDir",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 1,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "$ref": "#/parameters/X-Request-ID"
          },
          {
            "$ref": "#/parameters/Accept-Language"
          },
          {
            "$ref": "#/parameters/offset"
          },
          {
            "$ref": "#/parameters/limit"
          },
          {
            "$ref": "#/parameters/searchKey"
          },
          {
            "name": "deptCode",
            "in": "query",
            "description": "部门编码。",
            "maxLength": 32,
            "minLength": 0,
            "type": "string",
            "required": false,
            "x-example": "deptcode123456"
          },
          {
            "name": "querySubDept",
            "in": "query",
            "description": "是否查询子部门下的用户。\n默认值:true。",
            "type": "boolean",
            "required": false,
            "default": true,
            "x-example": true
          },
          {
            "name": "searchScope",
            "in": "query",
            "description": "搜索范围。默认值为ALL。\n* NORMAL_USER - 查询普通用户。返回普通用户(响应中isHardTerminal=false,type=NORMAL_USER)\n* HARD_TERMINAL - 查询硬终端用户。返回大屏用户(响应中isHardTerminal=false,type=WHITE_BOARD)和硬终端用户(响应中isHardTerminal=true,type=HARD_TERMINAL)\n* ALL - 查询所有用户。",
            "type": "string",
            "required": false,
            "default": "ALL",
            "x-example": "ALL"
          }
        ],
        "responses": {
          "200": {
            "description": "响应成功",
            "examples": {
              "application/json": {
                "offset": 0,
                "limit": 5,
                "count": 1,
                "data": [
                  {
                    "account": "Zhangsan@example.com",
                    "name": "张三",
                    "englishName": "Zhangsan",
                    "email": "zhangshan@example.com",
                    "phone": "177****0476",
                    "deptName": "cloudcore",
                    "number": "+99111283523475338",
                    "updateTime": 1554268817303,
                    "isHardTerminal": false,
                    "vmrId": "912992631",
                    "signature": "张三的签名信息",
                    "title": "Project Manager",
                    "description": "张三的备注信息",
                    "type": "NORMAL_USER",
                    "deptCodes": [
                      "1"
                    ]
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/UserDTOPages"
            }
          }
        },
        "x-request-examples-text-1": "GET https://{endpoint}/v1/usg/abs/users?offset=0&limit=5&searchKey=username&description=deptcode123456&querySubDept=true&searchScope=ALL",
        "x-request-examples-1": "GET https://{endpoint}/v1/usg/abs/users?offset=0&limit=5&searchKey=username&description=deptcode123456&querySubDept=true&searchScope=ALL"
      }
    }
  },
  "definitions": {
    "UserDTOPages": {
      "x-subPackage": "discard",
      "allOf": [
        {
          "$ref": "#/definitions/Pages"
        },
        {
          "properties": {
            "data": {
              "description": "分页查询企业用户信息。",
              "type": "array",
              "items": {
                "$ref": "#/definitions/UserDTO"
              }
            }
          }
        }
      ]
    },
    "Pages": {
      "x-subPackage": "discard",
      "description": "分页查询的公共属性。",
      "properties": {
        "offset": {
          "type": "integer",
          "description": "页面起始页,从0开始。",
          "example": 0
        },
        "limit": {
          "type": "integer",
          "description": "每页显示的条目数量。\n默认值:10。",
          "example": 5
        },
        "count": {
          "type": "integer",
          "description": "总数量。",
          "example": 1
        }
      }
    },
    "UserDTO": {
      "description": "分页查询企业用户信息。",
      "properties": {
        "id": {
          "type": "string",
          "description": "用户ID。",
          "example": "re81lbcl4o0fsls8067312312"
        },
        "statusCode": {
          "type": "integer",
          "x-example": 0,
          "description": "查询用户详情时, 根据不同情况,响应不同。\n* 0: 查询成功且用户信息有变化, 响应会把新的信息都返回回去\n* 1 :查询成功且用户信息没有变化,响应只会返回用户ID\n* 2 :用户不存在\n* 3 :无权限查询这个用户"
        },
        "account": {
          "type": "string",
          "description": "用户帐号。",
          "example": "userAccount"
        },
        "name": {
          "type": "string",
          "description": "用户名。",
          "example": "username"
        },
        "englishName": {
          "type": "string",
          "description": "英文名。",
          "example": "username"
        },
        "email": {
          "type": "string",
          "description": "邮箱地址。",
          "example": "example@example.com"
        },
        "phone": {
          "type": "string",
          "description": "用户手机。",
          "example": "+86177****0476"
        },
        "deptName": {
          "type": "string",
          "description": "用户部门。",
          "example": "cloudcore"
        },
        "number": {
          "type": "string",
          "description": "用户SIP号码。",
          "example": "+99111283523475338"
        },
        "updateTime": {
          "type": "integer",
          "format": "int64",
          "description": "用户信息最后更新时间。",
          "example": 1554268817303
        },
        "isHardTerminal": {
          "type": "boolean",
          "description": "是否为硬终端。\n> 该参数将被废弃,请勿使用。",
          "example": true
        },
        "vmrId": {
          "type": "string",
          "description": "用户虚拟会议室ID。",
          "example": "912992631"
        },
        "signature": {
          "type": "string",
          "description": "用户签名。",
          "example": "张三的签名信息"
        },
        "title": {
          "type": "string",
          "description": "职位。",
          "example": "Project Manager"
        },
        "description": {
          "type": "string",
          "description": "描述信息。",
          "example": "xxx"
        },
        "hidePhone": {
          "type": "boolean",
          "description": "是否隐藏手机号(如果为true,其他人查询该用户时,不会返回该用户的手机号。自己查自己是可见的)",
          "example": true
        },
        "type": {
          "type": "string",
          "description": "类型:\n* NORMAL_USER=普通用户\n* HARD_TERMINAL=硬终端用户\n* WHITE_BOARD=第三方白板\n* HW_VISION_MEMBER=智慧屏",
          "example": "NORMAL_USER"
        },
        "deptCodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "部门编码列表。",
          "example": "[\"1\"]"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "searchKey": {
      "name": "searchKey",
      "in": "query",
      "type": "string",
      "description": "搜索条件。支持帐号、SIP号码、名称、手机、邮箱模糊搜索。",
      "required": false,
      "maxLength": 1024,
      "minLength": 0,
      "x-example": "zhansan"
    },
    "X-Request-ID": {
      "name": "X-Request-Id",
      "in": "header",
      "description": "请求requestId,用来标识一路请求,用于问题跟踪定位,建议使用UUID,若不携带,则后台自动生成。",
      "required": false,
      "type": "string",
      "x-example": "208b6e4c92074487bc43292f8554561e"
    },
    "Accept-Language": {
      "name": "Accept-Language",
      "in": "header",
      "description": "语言参数,默认为中文zh-CN,英文为en-US。",
      "required": false,
      "type": "string",
      "x-example": "zh-CN"
    },
    "offset": {
      "name": "offset",
      "in": "query",
      "description": "查询偏移量,若超过最大数量,则返回最后一页的数据。\n默认值:0。",
      "required": false,
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "x-example": 0
    },
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    },
    "limit": {
      "name": "limit",
      "in": "query",
      "description": "查询数量。\n默认值:10。",
      "required": false,
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 500,
      "x-example": 5
    }
  },
  "host": "api-intl.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}