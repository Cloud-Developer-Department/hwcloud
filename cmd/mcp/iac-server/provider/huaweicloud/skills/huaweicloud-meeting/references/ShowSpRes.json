{
  "name": "ShowSpRes",
  "summary": "SP管理员查询SP下资源使用信息",
  "tags": "会议管理",
  "productshort": "Meeting",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/mmc/management/spRes": {
      "get": {
        "summary": "SP管理员查询SP下资源使用信息",
        "description": "SP管理员查询所属SP的共享资源使用信息。",
        "operationId": "ShowSpRes",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 24,
        "parameters": [
          {
            "name": "X-Access-Token",
            "in": "header",
            "required": true,
            "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
            "format": "password",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "examples": {
              "application/json": {
                "usedAccountsCount": "5"
              }
            },
            "schema": {
              "$ref": "#/definitions/SpResUsageRsp"
            }
          },
          "400": {
            "description": "参数异常。",
            "examples": {
              "application/json": {
                "error_code": "MMC.111070001",
                "error_msg": "CONF_BAD_REQUEST"
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedRsp"
            }
          },
          "401": {
            "description": "未鉴权或鉴权失败。",
            "examples": {
              "application/json": {
                "error_code": "MMC.118000001",
                "error_msg": "USER_TOKEN_AUTH_FAILED"
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedRsp"
            }
          },
          "500": {
            "description": "服务端异常。",
            "examples": {
              "application/json": {
                "error_code": "MMC.11070003",
                "error_msg": "CONF_EXCEPTION"
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedRsp"
            }
          }
        },
        "deprecated": false,
        "x-name": "SP管理员查询SP下资源使用信息",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/mmc/management/spRes",
        "tags": [
          "会议管理"
        ]
      }
    }
  },
  "definitions": {
    "SpResUsageRsp": {
      "description": "SP共享并发资源使用情况。",
      "properties": {
        "usedAccountsCount": {
          "description": "SP下所有企业已使用的会议并发数量。",
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "RestFailedRsp": {
      "description": "错误码信息。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "MMC.111072065"
        },
        "error_msg": {
          "type": "string",
          "description": "错误码描述。",
          "example": "CONF_NOT_FOUND_OR_AUTH_FAILED"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "api.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}