{
  "name": "InviteWithPwd",
  "summary": "通过会议ID和密码邀请与会者",
  "tags": "会议控制",
  "productshort": "Meeting",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/mmc/control/conferences/inviteWithPwd": {
      "post": {
        "tags": [
          "会议控制"
        ],
        "summary": "通过会议ID和密码邀请与会者",
        "description": "该接口用于通过会议ID和密码邀请与会者。一般用于App已知会议ID和来宾密码,通过扫码等方式获取其他终端的SIP号码后,使用该接口将其他终端邀请加入会议中。\n> 需要管理员在企业的“会议设置”>“来宾扫码邀请任意硬终端入会”设置成打开,才允许通过来宾密码邀请其他终端入会。",
        "operationId": "InviteWithPwd",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 27,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "conferenceID",
            "in": "query",
            "description": "会议ID。",
            "required": true,
            "type": "string",
            "x-example": "914067448"
          },
          {
            "name": "reqBody",
            "in": "body",
            "description": "会议信息。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RestInviteWithPwdReqBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。"
          },
          "500": {
            "description": "服务端异常。",
            "examples": {
              "application/json": {
                "error_code": "MMC.111072065",
                "error_msg": "CONF_NOT_FOUND_OR_AUTH_FAILED"
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedRsp"
            }
          }
        },
        "deprecated": false,
        "x-name": "通过会议ID和密码邀请与会者",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/mmc/control/conferences/inviteWithPwd?conferenceID=914067448",
        "x-request-examples-1": {
          "callNum": "+8688665599",
          "orgID": "115489",
          "pwd": "123123",
          "numBelongsType": 0,
          "isNotOverlayPidName": false
        },
        "x-request-examples-text-1": "{\n  \"callNum\":\"+8688665599\",\n  \"orgID\":\"115489\",\n  \"pwd\":\"123123\",\n  \"numBelongsType\":0,\n  \"isNotOverlayPidName\":false\n}"
      }
    }
  },
  "definitions": {
    "RestFailedRsp": {
      "description": "错误码信息。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "MMC.111072065"
        },
        "error_msg": {
          "type": "string",
          "description": "错误码描述。",
          "example": "CONF_NOT_FOUND_OR_AUTH_FAILED"
        }
      }
    },
    "RestInviteWithPwdReqBody": {
      "description": "会议信息。",
      "required": [
        "confID",
        "pwd",
        "callNum"
      ],
      "properties": {
        "callNum": {
          "type": "string",
          "description": "被邀请者的SIP号码。",
          "example": "+99111253020382685"
        },
        "orgID": {
          "type": "string",
          "description": "被邀请者所属企业ID。"
        },
        "confID": {
          "type": "string",
          "description": "会议ID。",
          "example": "914067448"
        },
        "pwd": {
          "type": "string",
          "description": "会议的密码(主持人或者来宾)。",
          "example": "123458"
        },
        "numBelongsType": {
          "type": "integer",
          "description": "SIP号码类型。默认是0。\n* 0:华为云会议的号码\n* 1:VC会议的号码",
          "example": "0"
        },
        "isNotOverlayPidName": {
          "type": "boolean",
          "format": "int64",
          "description": "是否不叠加会场名(VDC场景下适用)。",
          "example": "false"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
