{
  "name": "ShowSsoConfig",
  "summary": "查询SSO登录配置",
  "tags": "登录鉴权",
  "productshort": "Meeting",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/usg/acs/authorizeconfig": {
      "get": {
        "tags": [
          "登录鉴权"
        ],
        "operationId": "ShowSsoConfig",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 9,
        "summary": "查询SSO登录配置",
        "description": "该接口用于查询SSO登录的鉴权配置。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "$ref": "#/parameters/X-Request-ID"
          },
          {
            "$ref": "#/parameters/Accept-Language"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "schema": {
              "$ref": "#/definitions/AuthorizeConfigInfo"
            },
            "examples": {
              "application/json": {
                "enableSSO": true,
                "domain": "clouddragon.huawei.com",
                "authorizeUrl": "http://127.0.0.1:8444/sns/userinfo",
                "getTokenUrl": "http://127.0.0.1:8444/sns/oauth2/access_token",
                "getTokenInfoUrl": null,
                "clientId": "18bc94a643bd4b93aab3179726120943",
                "clientSecret": null,
                "scope": null,
                "accFieldName": "openid",
                "getUserInfoUrl": "http://127.0.0.1:8444/sns/userinfo",
                "oauth2ServerType": 0,
                "pcSchemaUrl": "http://127.0.0.1:8444/schema/pc",
                "androidSchemaUrl": "http://127.0.0.1:8444/schema/android",
                "iosSchemaUrl": "http://127.0.0.1:8444/schema/ios",
                "thirdName": "openid",
                "thirdEmail": null,
                "thirdMobile": null,
                "thirdAccessToken": "access_token",
                "thirdHeadImgUrl": null
              }
            }
          },
          "400": {
            "description": "参数异常。",
            "schema": {
              "$ref": "#/definitions/ReturnCodeDTO"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ReturnCodeDTO"
            }
          },
          "403": {
            "description": "没有权限。",
            "schema": {
              "$ref": "#/definitions/ReturnCodeDTO"
            }
          },
          "500": {
            "description": "服务端异常。",
            "schema": {
              "$ref": "#/definitions/ReturnCodeDTO"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1/usg/acs/authorizeconfig"
      }
    }
  },
  "definitions": {
    "AuthorizeConfigInfo": {
      "type": "object",
      "required": [
        "enableSSO"
      ],
      "properties": {
        "enableSSO": {
          "type": "boolean",
          "description": "是否开启SSO登录。"
        },
        "domain": {
          "type": "string",
          "description": "企业域名。",
          "maxLength": 255,
          "minLength": 0
        },
        "authorizeUrl": {
          "type": "string",
          "description": "鉴权中心URL。",
          "maxLength": 255,
          "minLength": 0,
          "pattern": "^$|^[0-9a-zA-Z-_.:@&=$/?#%]+$"
        },
        "getTokenUrl": {
          "type": "string",
          "description": "获取Token URL。",
          "maxLength": 255,
          "minLength": 0,
          "pattern": "^$|^[0-9a-zA-Z-_.:@&=$/?#%]+$"
        },
        "clientId": {
          "type": "string",
          "description": "APP ID。",
          "maxLength": 255,
          "minLength": 0
        },
        "clientSecret": {
          "type": "string",
          "description": "APP秘钥。",
          "maxLength": 255,
          "minLength": 0
        },
        "scope": {
          "type": "string",
          "description": "授权范围。\n* openid:OAuth2.0的OIDC",
          "maxLength": 255,
          "minLength": 0
        },
        "accFieldName": {
          "type": "string",
          "description": "第三方帐号的字段名称。",
          "maxLength": 255,
          "minLength": 0
        },
        "getUserInfoUrl": {
          "type": "string",
          "description": "用户信息查询URL。",
          "maxLength": 255,
          "minLength": 0,
          "pattern": "^$|^[0-9a-zA-Z-_.:@&=$/?#%]+$"
        },
        "oauth2ServerType": {
          "type": "integer",
          "description": "鉴权类型。OAuth2.0鉴权时取0。\n* 0:OAuth2.0鉴权",
          "maximum": 255,
          "minimum": 0
        },
        "pcSchemaUrl": {
          "type": "string",
          "description": "拉起PC端终端的schema。",
          "maxLength": 255,
          "minLength": 0,
          "pattern": "^$|^[0-9a-zA-Z-_.{}:@&=$/?#%]+$"
        },
        "androidSchemaUrl": {
          "type": "string",
          "description": "拉起安卓端终端的schema。",
          "maxLength": 255,
          "minLength": 0,
          "pattern": "^$|^[0-9a-zA-Z-_.{}:@&=$/?#%]+$"
        },
        "iosSchemaUrl": {
          "type": "string",
          "description": "拉起ios端终端的schema。",
          "maxLength": 255,
          "minLength": 0,
          "pattern": "^$|^[0-9a-zA-Z-_.{}:@&=$/?#%]+$"
        },
        "thirdName": {
          "type": "string",
          "description": "第三方名称的字段名称。",
          "maxLength": 255,
          "minLength": 0
        },
        "thirdEmail": {
          "type": "string",
          "description": "第三方邮箱的字段名称。",
          "maxLength": 255,
          "minLength": 0
        },
        "thirdMobile": {
          "type": "string",
          "description": "第三方手机号的字段名称。",
          "maxLength": 255,
          "minLength": 0
        },
        "thirdAccessToken": {
          "type": "string",
          "description": "第三方accessToken的字段名称。",
          "maxLength": 255,
          "minLength": 0
        },
        "thirdHeadImgUrl": {
          "type": "string",
          "description": "第三方头像链接的字段名称。",
          "maxLength": 64,
          "minLength": 0
        }
      }
    },
    "ReturnCodeDTO": {
      "x-subPackage": "discard",
      "description": "错误码。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "USG.206010000"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "example": "User name or password is incorrect"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。",
          "example": "9655664f10724b398187598a1d5097c3"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Request-ID": {
      "name": "X-Request-Id",
      "in": "header",
      "description": "请求requestId,用来标识一路请求,用于问题跟踪定位,建议使用UUID,若不携带,则后台自动生成。",
      "required": false,
      "type": "string",
      "x-example": "208b6e4c92074487bc43292f8554561e"
    },
    "Accept-Language": {
      "name": "Accept-Language",
      "in": "header",
      "description": "语言参数,默认为中文zh-CN,英文为en-US。",
      "required": false,
      "type": "string",
      "x-example": "zh-CN"
    },
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    }
  },
  "host": "api-intl.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}