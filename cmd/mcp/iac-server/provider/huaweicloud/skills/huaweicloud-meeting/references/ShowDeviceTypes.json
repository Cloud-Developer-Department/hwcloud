{
  "name": "ShowDeviceTypes",
  "summary": "获取所有终端类型",
  "tags": "硬终端管理",
  "productshort": "Meeting",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/usg/dcs/termdevtype": {
      "get": {
        "tags": [
          "硬终端管理"
        ],
        "summary": "获取所有终端类型",
        "description": "企业管理员通过该接口获取所有的专业会议终端类型。",
        "operationId": "ShowDeviceTypes",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 7,
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "$ref": "#/parameters/X-Request-ID"
          },
          {
            "$ref": "#/parameters/Accept-Language"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "schema": {
              "type": "array",
              "description": "查询到的终端类型列表",
              "items": {
                "$ref": "#/definitions/QueryDeviceTypeResultDTO"
              }
            },
            "examples": {
              "application/json": [
                {
                  "type": "TE",
                  "model": "TE10",
                  "enableActiveCode": true,
                  "resolution": "720P",
                  "supportProjectionCode": false,
                  "supportSVC": true
                },
                {
                  "type": "3rd",
                  "model": "kEJjXW0yx59jNZzz0iodb9OcL1mgrvU0",
                  "enableActiveCode": true,
                  "resolution": "1080P",
                  "supportProjectionCode": false,
                  "supportSVC": true
                }
              ]
            }
          },
          "403": {
            "description": "权限受限。",
            "examples": {
              "application/json": {
                "request_id": "208b6e4c92074487bc43292f8554561e",
                "error_code": "USG.000000004",
                "error_msg": "Illegal request"
              }
            },
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "400": {
            "description": "参数异常。",
            "examples": {
              "application/json": {
                "request_id": "208b6e4c92074487bc43292f8554561e",
                "error_code": "USG.000000003",
                "error_msg": "请检查参数是否合法 "
              }
            },
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1/usg/dcs/termdevtype"
      }
    }
  },
  "definitions": {
    "QueryDeviceTypeResultDTO": {
      "description": "终端类型。",
      "properties": {
        "type": {
          "type": "string",
          "description": "终端类型,区分自研和第三方终端。\n* TE:华为自研硬终端\n* 3rd:第三方硬终端"
        },
        "model": {
          "type": "string",
          "description": "终端型号,枚举类型。\n* TE10\n* TE20\n* TE30\n* TE40\n* TE50\n* TE60\n* HUAWEI Box 300\n* HUAWEI Box 500\n* HUAWEI Box 600\n* HUAWEI Box 700\n* HUAWEI Box 900\n* DP300\n* HUAWEI Box 200\n* HUAWEI Box 300\n* HUAWEI Box 500\n* HUAWEI Board\n* polycomcisco"
        },
        "enableActiveCode": {
          "type": "boolean",
          "description": "是否支持激活码。"
        },
        "resolution": {
          "type": "string",
          "description": "屏幕分辨率。1080P、720P等。"
        },
        "supportProjectionCode": {
          "type": "boolean",
          "description": "是否支持投影码。"
        },
        "supportSVC": {
          "type": "boolean",
          "description": "是否支持SVC。"
        }
      }
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "description": "异常返回结果。",
      "required": [
        "error_code",
        "error_msg",
        "request_id"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Request-ID": {
      "name": "X-Request-Id",
      "in": "header",
      "description": "请求requestId,用来标识一路请求,用于问题跟踪定位,建议使用UUID,若不携带,则后台自动生成。",
      "required": false,
      "type": "string",
      "x-example": "208b6e4c92074487bc43292f8554561e"
    },
    "Accept-Language": {
      "name": "Accept-Language",
      "in": "header",
      "description": "语言参数,默认为中文zh-CN,英文为en-US。",
      "required": false,
      "type": "string",
      "x-example": "zh-CN"
    },
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    }
  },
  "host": "api.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}