{
  "name": "BatchShowUserDetails",
  "summary": "批量查询用户详情",
  "tags": "用户管理",
  "productshort": "Meeting",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/usg/abs/users/list": {
      "post": {
        "summary": "批量查询用户详情",
        "tags": [
          "用户管理"
        ],
        "description": "批量查询用户详情,支持指定第三方账号查询详情。",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "operationId": "BatchShowUserDetails",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "$ref": "#/parameters/X-Request-ID"
          },
          {
            "$ref": "#/parameters/Accept-Language"
          },
          {
            "name": "idType",
            "in": "query",
            "description": "查询类型。默认是USER_ID。\n* USER_ID:表示根据华为云会议用户ID查询用户详情\n* THIRD_ACCOUNT:表示根据第三方账号查询用户详情",
            "x-example": "USER_ID",
            "required": false,
            "type": "string"
          },
          {
            "in": "body",
            "name": "getUserDTOs",
            "description": "用户ID或第三方账号信息列表。\nminLength: 1\nmaxLength: 200",
            "schema": {
              "type": "array",
              "minLength": 1,
              "maxLength": 200,
              "items": {
                "$ref": "#/definitions/ShowUserRequestDTO"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "响应成功",
            "examples": {
              "application/json": [
                {
                  "account": "Zhangsan@example.com",
                  "name": "张三",
                  "englishName": "Zhangsan",
                  "email": "zhangshan@example.com",
                  "phone": "177****0476",
                  "deptName": "cloudcore",
                  "number": "+99111283523475338",
                  "updateTime": 1554268817303,
                  "isHardTerminal": false,
                  "vmrId": "912992631",
                  "signature": "张三的签名信息",
                  "title": "Project Manager",
                  "description": "张三的备注信息",
                  "type": "NORMAL_USER",
                  "deptCodes": [
                    "1"
                  ]
                }
              ]
            },
            "schema": {
              "type": "array",
              "description": "用户信息列表",
              "items": {
                "$ref": "#/definitions/UserDTO"
              }
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v1/usg/abs/users/list?idType=USER_ID",
        "x-request-examples-1": [
          {
            "id": "ff8080816993bac00169bdf14e0800ad"
          },
          {
            "id": "718b8be14f09432caf66f3076505207b"
          }
        ]
      }
    }
  },
  "definitions": {
    "UserDTO": {
      "description": "分页查询企业用户信息。",
      "properties": {
        "id": {
          "type": "string",
          "description": "用户ID。",
          "example": "re81lbcl4o0fsls8067312312"
        },
        "statusCode": {
          "type": "integer",
          "x-example": 0,
          "description": "查询用户详情时, 根据不同情况,响应不同。\n* 0: 查询成功且用户信息有变化, 响应会把新的信息都返回回去\n* 1 :查询成功且用户信息没有变化,响应只会返回用户ID\n* 2 :用户不存在\n* 3 :无权限查询这个用户"
        },
        "account": {
          "type": "string",
          "description": "用户帐号。",
          "example": "userAccount"
        },
        "name": {
          "type": "string",
          "description": "用户名。",
          "example": "username"
        },
        "englishName": {
          "type": "string",
          "description": "英文名。",
          "example": "username"
        },
        "email": {
          "type": "string",
          "description": "邮箱地址。",
          "example": "example@example.com"
        },
        "phone": {
          "type": "string",
          "description": "用户手机。",
          "example": "+86177****0476"
        },
        "deptName": {
          "type": "string",
          "description": "用户部门。",
          "example": "cloudcore"
        },
        "number": {
          "type": "string",
          "description": "用户SIP号码。",
          "example": "+99111283523475338"
        },
        "updateTime": {
          "type": "integer",
          "format": "int64",
          "description": "用户信息最后更新时间。",
          "example": 1554268817303
        },
        "isHardTerminal": {
          "type": "boolean",
          "description": "是否为硬终端。\n> 该参数将被废弃,请勿使用。",
          "example": true
        },
        "vmrId": {
          "type": "string",
          "description": "用户虚拟会议室ID。",
          "example": "912992631"
        },
        "signature": {
          "type": "string",
          "description": "用户签名。",
          "example": "张三的签名信息"
        },
        "title": {
          "type": "string",
          "description": "职位。",
          "example": "Project Manager"
        },
        "description": {
          "type": "string",
          "description": "描述信息。",
          "example": "xxx"
        },
        "hidePhone": {
          "type": "boolean",
          "description": "是否隐藏手机号(如果为true,其他人查询该用户时,不会返回该用户的手机号。自己查自己是可见的)",
          "example": true
        },
        "type": {
          "type": "string",
          "description": "类型:\n* NORMAL_USER=普通用户\n* HARD_TERMINAL=硬终端用户\n* WHITE_BOARD=第三方白板\n* HW_VISION_MEMBER=智慧屏",
          "example": "NORMAL_USER"
        },
        "deptCodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "部门编码列表。",
          "example": "[\"1\"]"
        }
      }
    },
    "ShowUserRequestDTO": {
      "description": "用户ID或第三方账号信息列表",
      "properties": {
        "id": {
          "type": "string",
          "description": "用户ID或者第三方账号",
          "example": "ff8080816993bac00169bdf14e0800ad"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Request-ID": {
      "name": "X-Request-Id",
      "in": "header",
      "description": "请求requestId,用来标识一路请求,用于问题跟踪定位,建议使用UUID,若不携带,则后台自动生成。",
      "required": false,
      "type": "string",
      "x-example": "208b6e4c92074487bc43292f8554561e"
    },
    "Accept-Language": {
      "name": "Accept-Language",
      "in": "header",
      "description": "语言参数,默认为中文zh-CN,英文为en-US。",
      "required": false,
      "type": "string",
      "x-example": "zh-CN"
    },
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    }
  },
  "host": "api-intl.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}