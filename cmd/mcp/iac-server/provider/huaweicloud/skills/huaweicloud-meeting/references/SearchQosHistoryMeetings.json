{
  "name": "SearchQosHistoryMeetings",
  "summary": "查询QoS历史会议列表",
  "tags": "会议QoS",
  "productshort": "Meeting",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/metrics/conferences/history": {
      "get": {
        "tags": [
          "OpenQosMetrics"
        ],
        "operationId": "SearchQosHistoryMeetings",
        "summary": "查询QoS历史会议列表",
        "description": "该接口用于查询企业内历史会议的QoS告警。仅旗舰版企业/标准版企业的企业管理员有权限查询。可以查询最近3个月内的数据。\n> 仪表盘的QoS统计功能需要申请才能开通。请联系华为销售人员,并提供华为云会议企业ID。",
        "x-support-sdk": "Y",
        "x-apiexplorer-auth": false,
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-open-region-cloud": "hc",
        "x-order": 2,
        "deprecated": false,
        "consumes": [
          "application/json; charset=utf-8"
        ],
        "produces": [
          "application/json; charset=utf-8"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "查询的起始日期,Unix时间戳(单位毫秒)。",
            "required": true,
            "type": "integer",
            "format": "int64",
            "x-example": 1617206400000
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "查询的截止日期,Unix时间戳(单位毫秒)。",
            "required": true,
            "type": "integer",
            "format": "int64",
            "x-example": 1618588800000
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询偏移量。\n* 取值:大于等于0,默认值为0\n* 大于等于最大条目数量,则返回最后一页的数据",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询的条目数量。\n* 取值:1-500,默认值为20",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 20,
            "x-example": 20
          },
          {
            "name": "searchKey",
            "in": "query",
            "description": "查询条件。会议主题、会议预约人和会议ID等可作为搜索内容。长度限制为1-512个字符。",
            "required": false,
            "type": "string",
            "x-example": "深圳分部的会议"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "examples": {
              "application/json": {
                "count": 2,
                "limit": 10,
                "offset": 0,
                "data": [
                  {
                    "confUUID": "a3d9a31c8af211eb8075a12479434adb",
                    "conferenceID": "98909587",
                    "subject": "研发晨会",
                    "scheduserName": "深圳分部秘书",
                    "deptName": "xxx部门",
                    "alarm": "YES",
                    "audioAlarm": "NO",
                    "videoAlarm": "YES",
                    "screenAlarm": "NO",
                    "cpuAlarm": "NO",
                    "timeZoneID": "56",
                    "startTime": 1618220740926,
                    "endTime": 1618222194202,
                    "duration": 32,
                    "participants": 52,
                    "webinar": false
                  },
                  {
                    "confUUID": "0542c13a9f2111eba8443bce5c4a4da3",
                    "conferenceID": "989030944",
                    "subject": "xxx技术讨论",
                    "scheduserName": "深圳分部秘书",
                    "deptName": "xxx部门",
                    "alarm": "NO",
                    "audioAlarm": "NO",
                    "videoAlarm": "NO",
                    "screenAlarm": "NO",
                    "cpuAlarm": "NO",
                    "timeZoneID": "56",
                    "startTime": 1618218740926,
                    "endTime": 1618222294202,
                    "duration": 208,
                    "participants": 108,
                    "webinar": true
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/SearchQosConferencesResult"
            }
          },
          "400": {
            "description": "Bad Request 客户端传参异常。",
            "examples": {
              "application/json": {
                "error_code": "MBI.104000001",
                "error_msg": "The mandatory parameter is missing."
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedResult"
            }
          },
          "401": {
            "description": "Unauthorized 未鉴权或鉴权失败。",
            "examples": {
              "application/json": {
                "error_code": "MBI.0000000004",
                "error_msg": "Illegal request."
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedResult"
            }
          },
          "403": {
            "description": "Forbidden 权限受限。",
            "examples": {
              "application/json": {
                "error_code": "MBI.104030001",
                "error_msg": "Insufficient permissions, non-flagship enterprise."
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedResult"
            }
          },
          "500": {
            "description": "服务端异常。",
            "examples": {
              "application/json": {
                "error_code": "MBI.105000001",
                "error_msg": "The server is busy."
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedResult"
            }
          }
        },
        "x-imports": [
          "com.huawei.springframework.security.auth.annotation.TokenAuthorization;",
          "com.huawei.springframework.security.auth.constants.*;"
        ],
        "x-methodAnnotations": [
          "@TokenAuthorization(userType = {UserTypeEnum.CORP_MEMBER}, adminType = {AdminTypeEnum.DEFAULT_ADMIN, AdminTypeEnum.COMMON_ADMIN})"
        ],
        "x-name": "查询QoS历史会议列表",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/metrics/conferences/history?startDate=1617206400000&endDate=1618588800000&offset=0&limit=20&searchKey=深圳分部"
      }
    }
  },
  "definitions": {
    "SearchQosConferencesResult": {
      "x-annotations": [
        "@com.fasterxml.jackson.annotation.JsonInclude(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_NULL)"
      ],
      "description": "会议QoS告警列表。",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "总记录数。",
          "minimum": 0,
          "example": 1
        },
        "limit": {
          "type": "integer",
          "description": "查询条目数量。",
          "minimum": 10,
          "maximum": 500,
          "example": 10
        },
        "offset": {
          "type": "integer",
          "description": "查询偏移量。",
          "minimum": 0,
          "example": 0
        },
        "data": {
          "description": "QoS会议列表,按照会议开始时间降序排序。",
          "type": "array",
          "minItems": 0,
          "maxItems": 500,
          "items": {
            "$ref": "#/definitions/QosConferenceInfo"
          }
        }
      }
    },
    "QosConferenceInfo": {
      "description": "会议QoS告警信息。",
      "type": "object",
      "properties": {
        "confUUID": {
          "type": "string",
          "description": "会议UUID。",
          "minLength": 0,
          "maxLength": 64,
          "example": "a3d9a31c8af211eb8075a12479434adb"
        },
        "conferenceID": {
          "type": "string",
          "description": "会议ID。",
          "minLength": 0,
          "maxLength": 64,
          "example": "98909587"
        },
        "subject": {
          "type": "string",
          "description": "会议主题。",
          "minLength": 0,
          "maxLength": 512,
          "example": "研发晨会"
        },
        "scheduserName": {
          "type": "string",
          "description": "会议预订者名称。",
          "minLength": 0,
          "maxLength": 512,
          "example": "深圳分部秘书"
        },
        "deptName": {
          "type": "string",
          "description": "部门名称。",
          "minLength": 0,
          "maxLength": 64,
          "example": "xxx部门"
        },
        "alarm": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "总体告警 。\n* YES:会议的音频、视频、屏幕共享、CPU任一项产生告警,总体告警就为YES\n* NO:无告警",
          "example": "YES"
        },
        "audioAlarm": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "音频告警 。\n* YES:会议中任一与会者存在音频告警,会议音频告警就为YES\n* NO:无音频告警",
          "example": "NO"
        },
        "videoAlarm": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "视频告警。\n* YES:会议中任一与会者存在视频告警,会议视频告警就为YES\n* NO:无音视频警",
          "example": "YES"
        },
        "screenAlarm": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "屏幕共享告警 YES/NO。\n* YES:会议中任一与会者存在屏幕共享告警,会议屏幕共享告警就为YES\n* NO:无屏幕共享告警",
          "example": "NO"
        },
        "cpuAlarm": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "CPU告警。\n* YES:会议中任一与会者存在CPU告警,会议CPU告警就为YES\n* NO:无CPU告警",
          "example": "NO"
        },
        "timeZoneID": {
          "type": "string",
          "description": "时区信息,参考[时区映射关系](https://support.huaweicloud.com/api-meeting/meeting_21_0110.html#ZH-CN_TOPIC_0212714472__table137407441463)。\n> 举例:“timeZoneID”:\"26\",则通过华为云会议发送的会议通知中的时间将会标记为如“2021/11/11 星期四 00:00 - 02:00 (GMT) 格林威治标准时间:都柏林, 爱丁堡, 里斯本, 伦敦”。",
          "minLength": 0,
          "maxLength": 20,
          "example": "56"
        },
        "startTime": {
          "type": "integer",
          "format": "int64",
          "description": "会议开始时间(UTC时间), Unix时间戳(单位毫秒)。",
          "example": 1618220740926
        },
        "endTime": {
          "type": "integer",
          "format": "int64",
          "description": "会议结束时间(UTC时间), Unix时间戳(单位毫秒)。\n> * 在线会议:会议召开中,endTime = 会议预计结束时间\n> * 历史会议:会议已结束,endTime = 会议实际结束时间",
          "example": 1618222194202
        },
        "duration": {
          "type": "integer",
          "description": "会议召开时长(分钟)。\n> * 在线会议:会议召开中,duration = 0\n> * 历史会议:会议已结束,duration = 会议实际召开时间",
          "minimum": 0,
          "example": 32
        },
        "participants": {
          "type": "integer",
          "description": "与会方数。\n> 同一用户多次进出会议属于不同的与会方,与会方数计算多次。",
          "minimum": 0,
          "example": 52
        },
        "webinar": {
          "type": "boolean",
          "description": "是否网络研讨会。",
          "example": false
        }
      }
    },
    "RestFailedResult": {
      "description": "处理失败返回结果。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "结果码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果描述。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    }
  },
  "host": "api.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}