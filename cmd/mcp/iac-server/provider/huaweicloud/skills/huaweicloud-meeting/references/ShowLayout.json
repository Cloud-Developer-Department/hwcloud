{
  "name": "ShowLayout",
  "summary": "查询多画面布局",
  "tags": "会议控制",
  "productshort": "Meeting",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/mmc/control/conferences/layOut": {
      "get": {
        "tags": [
          "会议控制"
        ],
        "summary": "查询多画面布局",
        "description": "该接口用于查询当前会议已保存的多画面布局。",
        "operationId": "ShowLayout",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 36,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "conferenceID",
            "in": "query",
            "description": "会议ID。",
            "required": true,
            "type": "string",
            "x-example": "914067448"
          },
          {
            "name": "X-Conference-Authorization",
            "in": "header",
            "description": "会控Token,通过[获取会控token](https://support.huaweicloud.com/api-meeting/meeting_21_0027.html)接口获得。",
            "required": true,
            "format": "password",
            "type": "string",
            "x-example": "stb0442ae70a6e527de968a97be293bdc5a20a952fcc833bf17"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "examples": {
              "application/json": {
                "returnCode": 0,
                "returnDesc": "Success",
                "picLayouts": [
                  {
                    "uuid": "aa3aaaf349f511edbea72fd2b9a0ad61",
                    "imageType": "Two",
                    "switchTime": 10,
                    "layOutName": "my_saved_layout",
                    "subscriberInPics": [
                      {
                        "index": 1,
                        "id": [
                          "+99111221231895886#Desktop"
                        ],
                        "share": 0
                      },
                      {
                        "index": 2,
                        "id": [
                          "+99111221231894887#Desktop"
                        ],
                        "share": 0
                      }
                    ]
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/RestPicLayoutResponse"
            }
          },
          "400": {
            "description": "参数异常。",
            "examples": {
              "application/json": {
                "error_code": "MMC.111072065",
                "error_msg": "CONF_NOT_FOUND_OR_AUTH_FAILED"
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedRsp"
            }
          }
        },
        "deprecated": false,
        "x-name": "查询多画面布局",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "PUT https://{endpoint}/v1/mmc/control/conferences/layOut?conferenceID=914370850"
      }
    }
  },
  "definitions": {
    "PicInfoNotify": {
      "description": "子画面信息。",
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "format": "int32",
          "description": "多画面中每个画面的编号,编号从1开始。"
        },
        "id": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "int32"
          },
          "description": "每个画面中的与会者SIP号码。SIP号码可以通过[查询企业通讯](https://support.huaweicloud.com/api-meeting/meeting_21_0512.html)获取。"
        },
        "share": {
          "type": "integer",
          "format": "int32",
          "description": "是否为辅流。\n* 0: 不是辅流\n* 1: 是辅流"
        }
      }
    },
    "RestFailedRsp": {
      "description": "错误码信息。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "MMC.111072065"
        },
        "error_msg": {
          "type": "string",
          "description": "错误码描述。",
          "example": "CONF_NOT_FOUND_OR_AUTH_FAILED"
        }
      }
    },
    "RestPicLayout": {
      "type": "object",
      "description": "多画面布局。",
      "properties": {
        "switchTime": {
          "type": "integer",
          "format": "int32",
          "minimum": 10,
          "description": "多画面轮询时间,单位秒。"
        },
        "picNum": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "description": "多画面画面数量。"
        },
        "layOutName": {
          "type": "string",
          "description": "多画面布局名称。"
        },
        "imageType": {
          "type": "string",
          "description": "画面类型。"
        },
        "uuid": {
          "type": "string",
          "description": "布局UUID。"
        },
        "subscriberInPics": {
          "description": "子画面列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PicInfoNotify"
          }
        }
      }
    },
    "RestPicLayoutResponse": {
      "type": "object",
      "description": "多画面布局查询结果。",
      "properties": {
        "returnCode": {
          "type": "integer",
          "format": "int32",
          "description": "结果码。\n* 0:成功\n* 非0:失败",
          "minimum": 0,
          "maximum": 2147483647
        },
        "returnDesc": {
          "type": "string",
          "description": "结果描述。\n* Success:成功\n* 其他:失败原因"
        },
        "picLayouts": {
          "type": "array",
          "description": "多画面布局。",
          "items": {
            "$ref": "#/definitions/RestPicLayout"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "api-intl.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}