{
  "name": "CreateAuthRandom",
  "summary": "获取会议鉴权随机数",
  "tags": "会议管理",
  "productshort": "Meeting",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v2/mms/ncms/conferences/auth/random": {
      "get": {
        "summary": "获取会议鉴权随机数",
        "description": "根据会议ID + 密码鉴权返回鉴权随机数,如果是小程序调用时,需要企业支持小程序功能",
        "operationId": "CreateAuthRandom",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "parameters": [
          {
            "name": "X-Access-Token",
            "in": "header",
            "required": true,
            "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
            "format": "password",
            "type": "string"
          },
          {
            "name": "conf_id",
            "in": "query",
            "required": true,
            "description": "会议ID",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-annotations": [
              "@NotEmpty(message=\"conf_id is empty\")"
            ]
          },
          {
            "name": "guest_waiting",
            "in": "query",
            "required": false,
            "description": "0-不支持来宾会前等待页能力(默认)、1-支持来宾会前等待页能力",
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 1
          },
          {
            "name": "X-Password",
            "in": "header",
            "required": false,
            "description": "会议密码",
            "type": "string",
            "minLength": 0,
            "maxLength": 6
          }
        ],
        "responses": {
          "200": {
            "description": "response of 200",
            "schema": {
              "$ref": "#/definitions/AuthRandomResponseV2"
            },
            "x-response-examples-1": {
              "random": "377267074221623",
              "subject": "xxx的会议",
              "conf_mode": "RTC",
              "webinar": false,
              "need_password": false,
              "support_applets": true
            }
          },
          "400": {
            "description": "客户端传参异常,包含错误码及对应描述",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "401": {
            "description": "鉴权失败",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "403": {
            "description": "鉴权失败",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "500": {
            "description": "内部错误",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v2/mms/ncms/conferences/auth/random?conf_id=912731059",
        "tags": [
          "会议管理"
        ]
      }
    }
  },
  "definitions": {
    "AuthRandomResponseV2": {
      "description": "获取鉴权随机数响应结果",
      "properties": {
        "random": {
          "description": "鉴权随机数",
          "type": "string",
          "minLength": 0,
          "maxLength": 15
        },
        "subject": {
          "description": "会议主题",
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        },
        "conf_mode": {
          "description": "会议类型模型。\n* COMMON:MCU会议\n* RTC:MMR会议",
          "type": "string",
          "enum": [
            "COMMON",
            "RTC"
          ]
        },
        "webinar": {
          "description": "是否为网络研讨会",
          "type": "boolean"
        },
        "need_password": {
          "description": "是否需要密码",
          "type": "boolean",
          "default": false
        },
        "support_applets": {
          "description": "是否支持小程序",
          "type": "boolean",
          "default": true
        }
      }
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "description": "异常返回结果。",
      "required": [
        "error_code",
        "error_msg",
        "request_id"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "api-intl.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}