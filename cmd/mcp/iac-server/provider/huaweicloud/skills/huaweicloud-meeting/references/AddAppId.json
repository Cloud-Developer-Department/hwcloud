  "definitions": {
    "AppIdInfoDTO": {
      "description": "添加企业应用的返回结果",
      "properties": {
        "app_name": {
          "type": "string",
          "description": "企业应用名称",
          "minLength": 1,
          "maxLength": 64,
          "example": "测试企业应用"
        },
        "app_id": {
          "type": "string",
          "description": "企业应用ID",
          "pattern": "^\\w{1,64}$",
          "example": "f9a4149457cf4a67a69bc98f9bdb5123"
        },
        "app_key": {
          "x-sensitive": true,
          "type": "string",
          "description": "企业应用appkey",
          "minLength": 32,
          "maxLength": 128,
          "example": "123456788c9f4ba5839fe2dc1ca73d53"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "企业应用描述",
          "example": "测试企业应用使用"
        },
        "create_time": {
          "type": "string",
          "description": "企业应用创建时间",
          "minLength": 0,
          "maxLength": 19,
          "example": "2024-06-28 19:13:07"
        },
        "last_update_time": {
          "type": "string",
          "description": "最近修改时间",
          "minLength": 0,
          "maxLength": 19,
          "example": "2024-06-28 19:13:07"
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1,
          "example": 0,
          "description": "企业应用状态 \n* 0:正常 \n* 1:停用"
        }
      }
    },
    "AddAppIdRequestBody": {
      "description": "添加企业应用入参",
      "required": [
        "app_name"
      ],
      "properties": {
        "app_name": {
          "type": "string",
          "description": "企业应用名称",
          "maxLength": 64,
          "minLength": 1,
          "example": "测试企业应用"
        },
        "description": {
          "type": "string",
          "description": "企业应用描述",
          "maxLength": 128,
          "minLength": 0,
          "example": "企业应用测试使用"
        }
      }
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "description": "异常返回结果。",
      "required": [
        "error_code",
        "error_msg",
        "request_id"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。"
        }
      }
    }
