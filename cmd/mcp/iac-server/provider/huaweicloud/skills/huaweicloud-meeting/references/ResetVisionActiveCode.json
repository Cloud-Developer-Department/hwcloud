            }
          },
          "403": {
            "description": "权限受限。",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "400": {
            "description": "参数异常。",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          }
        },
        "tags": [
          "激活码管理"
        ],
        "operationId": "ResetVisionActiveCode",
        "x-imports": "com.huawei.springframework.om.trace.masker.annotation.*;com.huawei.springframework.response.dto.ResultDTO;com.huawei.usg.datacenter.model.user.QueryUserResultDTO;com.huawei.springframework.security.auth.annotation.TokenAuthorization;com.huawei.springframework.security.auth.constants.*;com.huawei.usg.oms.model.kafka.constants.*",
        "x-methodAnnotations": [
          "@TokenAuthorization(userType=UserTypeEnum.CORP_MEMBER)",
          "@RequestMaskRule",
          "@OpLogFunction(opObjectStr = \"I18n.OpLog.ActiveCodeMGT\", opTypeStr = \"I18n.OpLog.ResetActivationCode\")"
        ],
        "x-request-examples-url-1": "PUT https://{endpoint}/v1/usg/dcs/corp/vision/activecode/test_account/reset",
        "x-request-examples-1": {
          "country": "chinaPR",
          "emailAddr": "email@huawei.com",
          "smsNumber": "+86173****9092"
        }
      }
    }
  },
  "definitions": {
    "ActiveDTO": {
