{
  "name": "UpdateDevice",
  "summary": "修改终端",
  "tags": "硬终端管理",
  "productshort": "Meeting",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/usg/dcs/corp/device/{sn}": {
      "put": {
        "tags": [
          "硬终端管理"
        ],
        "summary": "修改终端",
        "description": "企业管理员通过该接口修改专业会议终端。\n> 如果需要修改Ideahub、SmartRooms、智慧屏TV请使用[修改用户](https://support.huaweicloud.com/api-meeting/meeting_21_0068.html)接口。",
        "operationId": "UpdateDevice",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 2,
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "$ref": "#/parameters/X-Request-ID"
          },
          {
            "$ref": "#/parameters/Accept-Language"
          },
          {
            "name": "sn",
            "in": "path",
            "description": "终端SN号,仅可包含数字、字母和下划线。",
            "x-example": "I2lwxg01VgZWM1bmzEBzpC52ZvvOw3",
            "required": true,
            "type": "string"
          },
          {
            "name": "deviceDTO",
            "in": "body",
            "required": true,
            "description": "修改终端请求。",
            "schema": {
              "$ref": "#/definitions/ModDeviceDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。"
          },
          "403": {
            "description": "权限受限。",
            "examples": {
              "application/json": {
                "request_id": "208b6e4c92074487bc43292f8554561e",
                "error_code": "USG.000000004",
                "error_msg": "Illegal request"
              }
            },
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "400": {
            "description": "参数异常。",
            "examples": {
              "application/json": {
                "request_id": "208b6e4c92074487bc43292f8554561e",
                "error_code": "USG.201050002",
                "error_msg": "设备名称已存在"
              }
            },
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          }
        },
        "x-request-examples-url-1": "PUT https://{endpoint}/v1/usg/dcs/corp/device/yt2BO57VO31K8u0sXBEs0tPtGBIi5u",
        "x-request-examples-1": {
          "country": "chinaHKG",
          "phone": "+852987654321",
          "name": "Hangzhou Z5-3-A29",
          "description": "Hangzhou A29 Meeting Room",
          "deptCode": "1",
          "email": "Zhangsan@huawei.com",
          "status": 1,
          "prjCodeMode": "1"
        }
      }
    }
  },
  "definitions": {
    "ModDeviceDTO": {
      "description": "修改的终端参数。",
      "properties": {
        "name": {
          "type": "string",
          "description": "终端名称,建议为具体位置。",
          "maxLength": 64,
          "minLength": 0,
          "example": "杭州XX大楼XXX会议室"
        },
        "prjCodeMode": {
          "type": "integer",
          "format": "int32",
          "enum": [
            0,
            1,
            2
          ],
          "description": "投影码生成模式,默认为自动。\n* 0:自动(该模式下根据消息上报的IP地址内部控制复杂度。\n  私网地址配置成简单模式,公网地址配置成复杂模式)\n* 1:简单\n* 2:复杂",
          "example": 0
        },
        "deptCode": {
          "type": "string",
          "description": "部门编码,默认为根部门。\n默认值:1。",
          "example": "1"
        },
        "phone": {
          "type": "string",
          "description": "手机号,必须加上国家码。\n例如中国大陆手机为“+86xxxxxxxxxxx”,当填写手机号时 “country”参数必填。\n手机号只允许输入纯数字。\n> 手机号或者邮箱至少填写一个。",
          "example": "+86123456789"
        },
        "country": {
          "type": "string",
          "description": "[手机号所属的国家](https://support.huaweicloud.com/api-meeting/meeting_21_0109.html#ZH-CN_TOPIC_0212714591__table19371178135314) 。",
          "example": "chinaPR"
        },
        "email": {
          "type": "string",
          "description": "邮箱地址。",
          "example": "email@huawei.com"
        },
        "description": {
          "type": "string",
          "description": "终端描述。",
          "maxLength": 128,
          "minLength": 0,
          "example": "description"
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "终端状态。\n* 0:正常\n* 1:冻结",
          "enum": [
            0,
            1
          ],
          "example": 0
        }
      }
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "description": "异常返回结果。",
      "required": [
        "error_code",
        "error_msg",
        "request_id"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Request-ID": {
      "name": "X-Request-Id",
      "in": "header",
      "description": "请求requestId,用来标识一路请求,用于问题跟踪定位,建议使用UUID,若不携带,则后台自动生成。",
      "required": false,
      "type": "string",
      "x-example": "208b6e4c92074487bc43292f8554561e"
    },
    "Accept-Language": {
      "name": "Accept-Language",
      "in": "header",
      "description": "语言参数,默认为中文zh-CN,英文为en-US。",
      "required": false,
      "type": "string",
      "x-example": "zh-CN"
    },
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    }
  },
  "host": "api.meeting.huaweicloud.com",
  "base_path": "/",
