{
  "name": "ShowRecordInfo",
  "summary": "查询单会议录制文件信息",
  "tags": "会议控制",
  "productshort": "Meeting",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/mmc/rlm/record/info": {
      "post": {
        "tags": [
          "会议控制"
        ],
        "operationId": "ShowRecordInfo",
        "summary": "查询单会议录制文件信息",
        "description": "查询单会议录制文件信息",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-open-region-cloud": "hc",
        "x-order": 43,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Access-Token",
            "in": "header",
            "required": true,
            "description": "会控Token,通过[获取会控token](https://support.huaweicloud.com/api-meeting/meeting_21_0027.html)接口获得。",
            "type": "string"
          },
          {
            "name": "RecordInfoReq",
            "in": "body",
            "required": true,
            "description": "查询单会议录制文件信息",
            "schema": {
              "$ref": "#/definitions/RecordInfoReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "response of 200",
            "schema": {
              "$ref": "#/definitions/RecordInfoResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "RecordInfoResponse": {
      "type": "object",
      "description": "响应基础类",
      "properties": {
        "code": {
          "type": "string",
          "description": "结果码"
        },
        "message": {
          "type": "string",
          "description": "结果描述"
        },
        "data": {
          "description": "响应体详情数据",
          "$ref": "#/definitions/RecordInfoDO"
        }
      }
    },
    "SegmentDO": {
      "type": "object",
      "description": "录制切片段落",
      "properties": {
        "manualOrder": {
          "description": "录制人工分段序号,每次启动录制,生成一个分段",
          "type": "integer"
        },
        "segmentOrder": {
          "description": "录制片段内的文件自动切片序号(每次启动录制后,每三小时一个分片文件,多次人工启动重新从1开始)",
          "type": "integer"
        },
        "segmentSize": {
          "description": "录制分段总文件大小(字节)",
          "type": "string"
        },
        "fileList": {
          "description": "录制文件自动切片列表,每3小时文件切片一次",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SegmentFileDO"
          }
        }
      }
    },
    "RecordInfoReq": {
      "description": "录制会议文件信息请求体",
      "required": [
        "confUUID"
      ],
      "properties": {
        "confUUID": {
          "description": "会议uuid",
          "type": "string"
        },
        "segmentOffset": {
          "description": "录制段落查询偏移量",
          "type": "integer"
        },
        "segmentLimit": {
          "description": "录制段落查询数量",
          "type": "integer"
        }
      }
    },
    "RecordInfoDO": {
      "type": "object",
      "description": "响应基础类",
      "properties": {
        "subject": {
          "description": "会议主题",
          "type": "string"
        },
        "beginTime": {
          "description": "会议录制开始时间",
          "type": "string"
        },
        "segmentOffset": {
          "description": "录制段落查询偏移量",
          "type": "integer"
        },
        "segmentLimit": {
          "description": "录制段落查询数量",
          "type": "integer"
        },
        "segmentCount": {
          "description": "录制段落总数",
          "type": "integer",
          "format": "int64"
        },
        "segmentList": {
          "description": "录制人工启动/停止分段列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SegmentDO"
          }
        }
      }
    },
    "SegmentFileDO": {
      "type": "object",
      "description": "录制切片文件",
      "properties": {
        "recordType": {
          "description": "会议录制类型,取值范围见数据结构RecordType:AUDIO 纯音频录制,SPEAKER_VIDEO 演讲者视图,SHARE_VIDEO共享屏幕,SPEAKER_SHARE_VIDEO 含演讲者视图的共享屏幕",
          "type": "string"
        },
        "beginTime": {
          "description": "录制文件开始时间",
          "type": "integer",
          "format": "int64"
        },
        "endTime": {
          "description": "录制文件结束时间",
          "type": "integer",
          "format": "int64"
        },
        "duration": {
          "description": "录制文件时长(秒)",
          "type": "integer",
          "format": "int64"
        },
        "fileSize": {
          "description": "文件大小(字节数)",
          "type": "integer",
          "format": "int64"
        },
        "sha256": {
          "description": "文件hash校验码(SHA256),64个字符",
          "type": "string"
        },
        "playUrl": {
          "description": "录制文件播放地址,有效期1小时",
          "type": "string"
        },
        "downloadUrl": {
          "description": "录制文件下载地址,有效期1小时",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "api.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}