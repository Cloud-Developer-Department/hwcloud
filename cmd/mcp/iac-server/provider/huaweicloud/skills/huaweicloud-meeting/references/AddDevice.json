{
  "name": "AddDevice",
  "summary": "增加终端",
  "tags": "硬终端管理",
  "productshort": "Meeting",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/usg/dcs/corp/device": {
      "post": {
        "tags": [
          "硬终端管理"
        ],
        "summary": "增加终端",
        "description": "企业管理员通过该接口添加专业会议终端。专业会议终端包括DP300/HUAWEI Bar系列/HUAWEI Board/TE系列。",
        "operationId": "AddDevice",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 1,
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "$ref": "#/parameters/X-Request-ID"
          },
          {
            "$ref": "#/parameters/Accept-Language"
          },
          {
            "name": "deviceDTO",
            "in": "body",
            "required": true,
            "description": "增加终端请求。",
            "schema": {
              "$ref": "#/definitions/AddDeviceDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "examples": {
              "application/json": {
                "name": "Hangzhou Z5-3-A29",
                "type": "TE",
                "model": "TE30",
                "sn": "I2lwxg01VgZWM1bmzEBzpC52ZvvOw3",
                "account": "3d721661fac040daaeb6e93a5fbbea3f",
                "number": "+8657155498",
                "prjCodeMode": 0,
                "deptCode": "1",
                "deptName": "根部门",
                "deptNamePath": "根部门",
                "phone": "+86123456789",
                "country": "chinaPR",
                "email": "email@huawei.com",
                "description": "description",
                "status": 0
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryDeviceResultDTO"
            }
          },
          "403": {
            "description": "权限受限。",
            "examples": {
              "application/json": {
                "request_id": "208b6e4c92074487bc43292f8554561e",
                "error_code": "USG.000000004",
                "error_msg": "Illegal request"
              }
            },
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "400": {
            "description": "参数异常。",
            "examples": {
              "application/json": {
                "request_id": "208b6e4c92074487bc43292f8554561e",
                "error_code": "USG.201050005",
                "error_msg": "终端总数超过限制,请检查购买的硬件终端资源"
              }
            },
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v1/usg/dcs/corp/device",
        "x-request-examples-1": {
          "country": "chinaPR",
          "phone": "+86123456789",
          "name": "Hangzhou Z5-3-A29",
          "description": "description",
          "model": "TE30",
          "sn": "3cTUYnEGvj9LVPvs2Q4Vp5XGKXUL2U",
          "sendNotify": "0",
          "deptCode": "0",
          "email": "email@huawei.com",
          "status": 0
        }
      }
    }
  },
  "definitions": {
    "AddDeviceDTO": {
      "description": "终端信息。",
      "required": [
        "name",
        "model"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "终端名称,可以自定义,建议为具体位置,方便识别。",
          "maxLength": 64,
          "minLength": 1,
          "example": "杭州XX大楼XXX会议室"
        },
        "model": {
          "type": "string",
          "description": "终端型号,枚举类型。当前支持TE系列和部分第三方硬件终端,具体的终端类型可以通过[获取所有终端类型](https://support.huaweicloud.com/api-meeting/meeting_21_0092.html)接口查询。",
          "example": "TE30"
        },
        "sn": {
          "type": "string",
          "description": "终端SN码,仅可包含数字、字母和下划线。",
          "example": "I2lwxg01VgZWM1bmzEBzpC52ZvvOw3"
        },
        "prjCodeMode": {
          "type": "integer",
          "format": "int32",
          "enum": [
            0,
            1,
            2
          ],
          "description": "投影码生成模式,默认为自动。\n- 0:自动(该模式下根据消息上报的IP地址内部控制复杂度。\n  私网地址配置成简单模式,公网地址配置成复杂模式)\n- 1:简单\n- 2:复杂",
          "example": 0
        },
        "deptCode": {
          "type": "string",
          "description": "部门编码,默认为根部门。\n默认值:1。",
          "example": "1"
        },
        "phone": {
          "type": "string",
          "description": "手机号,必须加上国家码,例如中国大陆手机为“+86xxxxxxxxxxx”。当填写手机号时 “country”参数必填。\n手机号只允许输入纯数字。\n> 手机号或者邮箱至少填写一个。",
          "example": "+86123456789"
        },
        "country": {
          "type": "string",
          "description": "[手机号所属的国家](https://support.huaweicloud.com/api-meeting/meeting_21_0109.html#ZH-CN_TOPIC_0212714591__table19371178135314) 。",
          "example": "chinaPR"
        },
        "email": {
          "type": "string",
          "description": "邮箱地址。",
          "example": "email@huawei.com"
        },
        "description": {
          "type": "string",
          "description": "终端描述。",
          "maxLength": 128,
          "minLength": 0,
          "example": "description"
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "终端状态。默认值:0。\n* 0:正常\n* 1:冻结",
          "enum": [
            0,
            1
          ],
          "example": 0
        },
        "sendNotify": {
          "type": "string",
          "description": "是否发送邮件和短信通知。\n* 0:不发送\n* 不填或者其他值就发送",
          "example": "0"
        }
      }
    },
    "QueryDeviceResultDTO": {
      "description": "终端信息。",
      "properties": {
        "name": {
          "type": "string",
          "description": "终端名称。"
        },
        "type": {
          "type": "string",
          "description": "终端类型,区分自研和第三方终端。"
        },
        "model": {
          "type": "string",
          "description": "终端型号,枚举类型。当前支持TE系列和部分第三方硬件终端,具体的终端类型可以通过[获取所有终端类型](https://support.huaweicloud.com/api-meeting/meeting_21_0092.html)接口查询。"
        },
        "sn": {
          "type": "string",
          "description": "终端SN号,仅可包含数字、字母和下划线。"
        },
        "account": {
          "type": "string",
          "description": "硬终端对应的内置帐号。"
        },
        "number": {
          "type": "string",
          "description": "终端绑定的号码。"
        },
        "prjCodeMode": {
          "type": "integer",
          "description": "投影码生成模式。\n* 0:自动(该模式下根据消息上报的IP地址内部控制复杂度:私网地址配置成简单模式;公网地址配置成复杂模式)\n* 1:简单\n* 2:复杂"
        },
        "deptCode": {
          "type": "string",
          "description": "部门编码。"
        },
        "deptName": {
          "type": "string",
          "description": "部门名称。"
        },
        "deptNamePath": {
          "type": "string",
          "description": "部门名称路径。"
        },
        "phone": {
          "type": "string",
          "description": "手机号。"
        },
        "country": {
          "type": "string",
          "description": "[手机号所属的国家](https://support.huaweicloud.com/api-meeting/meeting_21_0109.html#ZH-CN_TOPIC_0212714591__table19371178135314) 。"
        },
        "email": {
          "type": "string",
          "description": "邮箱地址。"
        },
        "description": {
          "type": "string",
          "description": "终端描述。"
        },
        "status": {
          "type": "integer",
          "description": "终端状态。\n* 0、正常\n* 1、停用\""
        }
      }
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "description": "异常返回结果。",
      "required": [
        "error_code",
        "error_msg",
        "request_id"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Request-ID": {
      "name": "X-Request-Id",
      "in": "header",
      "description": "请求requestId,用来标识一路请求,用于问题跟踪定位,建议使用UUID,若不携带,则后台自动生成。",
      "required": false,
      "type": "string",
      "x-example": "208b6e4c92074487bc43292f8554561e"
    },
    "Accept-Language": {
      "name": "Accept-Language",
      "in": "header",
      "description": "语言参数,默认为中文zh-CN,英文为en-US。",
      "required": false,
      "type": "string",
      "x-example": "zh-CN"
    },
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    }
  },
  "host": "api.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}