          "example": "123456"
        },
        "chairPwd": {
          "type": "string",
          "description": "主持人密码。4~16位的数字。",
          "pattern": "^[0-9]{4,16}$",
          "example": "666666"
        },
        "allowGustFirst": {
          "type": "boolean",
          "description": "是否允许来宾先入会。",
          "example": true
        },
        "gustFirstNotice": {
          "type": "boolean",
          "description": "云会议室被使用后是否通知会议室所有者。",
          "example": true
        }
      }
