  "definitions": {
    "PicInfoNotify": {
      "description": "子画面信息。",
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "format": "int32",
          "description": "多画面中每个画面的编号,编号从1开始。"
        },
        "id": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "int32"
          },
          "description": "每个画面中的与会者SIP号码。SIP号码可以通过[查询企业通讯](https://support.huaweicloud.com/api-meeting/meeting_21_0512.html)获取。"
        },
        "share": {
          "type": "integer",
          "format": "int32",
          "description": "是否为辅流。\n* 0: 不是辅流\n* 1: 是辅流"
        }
      }
    },
    "CycleSubConfConfigDTO": {
      "type": "object",
      "x-imports": [
        "lombok.Getter;",
        "lombok.Setter;",
        "lombok.ToString;",
        "org.hibernate.validator.constraints.Range;",
        "javax.validation.constraints.Max;",
        "com.huawei.ncms.model.conf.bo.ShowAudienceCountInfo"
      ],
      "x-annotations": [
        "@Getter",
        "@Setter",
        "@ToString"
      ],
      "properties": {
        "callInRestriction": {
          "description": "允许加入会议的范围。\n- 0: 所有用户\n- 2: 企业内用户\n- 3: 被邀请用户",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 3
        },
        "audienceCallInRestriction": {
          "description": "允许加入网络研讨会的观众范围。\n- 0:所有用户\n- 2:企业内用户和被邀请用户",
          "type": "integer",
          "format": "int32"
        },
        "allowGuestStartConf": {
          "description": "是否允许来宾启动会议。\n- false:禁止来宾启动会议\n- true:允许来宾启动会议\n> 仅随机会议ID的会议生效。",
          "type": "boolean"
        },
        "enableWaitingRoom": {
          "description": "是否启用等候室。",
          "type": "boolean"
        },
        "showAudienceCountInfo": {
          "description": "网络研讨会观众数显示策略。",
          "$ref": "#/definitions/ShowAudienceCountInfo"
        }
      }
    },
    "RestConfConfigDTO": {
      "description": "会议其他配置信息。",
      "properties": {
        "isSendNotify": {
          "description": "是否需要发送会议邮件通知。默认值由企业级配置决定。\n- true: 需要\n- false: 不需要",
          "type": "boolean"
        },
        "isSendSms": {
          "description": "是否需要发送会议短信通知。默认值由企业级配置决定。\n- true: 需要\n- false: 不需要\n> 只有正式商用企业才有发送会议短信通知的权限,免费企业即使isSendSms设置成true也不会发送会议短信通知。",
          "type": "boolean"
        },
        "isSendCalendar": {
          "description": "是否需要发送会议邮件日历通知。默认值由企业级配置决定。\n- true: 需要\n- false: 不需要",
          "type": "boolean"
        },
        "isAutoMute": {
          "description": "来宾入会,软终端是否自动静音。默认值由企业级配置决定。\n- true: 自动静音\n- false: 不自动静音",
          "type": "boolean"
        },
        "isHardTerminalAutoMute": {
          "description": "来宾入会,硬终端是否自动静音。默认值由企业级配置决定。\n- true: 自动静音\n- false: 不自动静音",
          "type": "boolean"
        },
        "isGuestFreePwd": {
          "description": "是否来宾免密。\n- true: 免密\n- false: 需要密码\n> 仅随机会议ID的会议生效。",
          "type": "boolean"
        },
        "callInRestriction": {
          "description": "允许加入会议的范围。\n- 0: 所有用户\n- 2: 企业内用户\n- 3: 被邀请用户",
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "allowGuestStartConf": {
          "description": "是否允许来宾启动会议。\n- true: 允许来宾启动会议\n- false: 禁止来宾启动会议\n> 仅随机会议ID的会议生效。",
          "type": "boolean"
        },
        "guestPwd": {
          "description": "来宾密码(4-16位长度的纯数字)。",
          "type": "string",
          "x-annotations": [
            "@ToString.Exclude",
            "@Length(min = 4, max = 16, message = \"the RestConfConfigDTO.guestPwd length must between 4 and 16\")"
          ]
        },
        "vmrIDType": {
          "description": "云会议室的会议ID模式。\n* 0:固定会议ID\n* 1:随机会议ID",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1
        },
        "prolongLength": {
          "description": "自动延长会议时长(取值范围0-60)。\n* 0:表示会议到点自动结束,不延长会议\n* 其他:表示自动延长的时长\n> * 自动结束会议是按照会议时长计算。比如预定的会议是9:00开始11:00结束,会议时长2个小时,如果与会者8:00就加入会议了,那会议在10:00就会自动结束\n> * 设置成其他值时,只要会中还有与会者,会议自动多次延长",
          "type": "integer",
          "format": "int32"
        },
        "enableWaitingRoom": {
          "description": "开启或者关闭等候室。\n* true:开启\n* false:不开启",
          "type": "boolean"
        },
        "isHostCameraOn": {
          "description": "主持人入会是否开启摄像头。\n* true:开启\n* false:不开启",
          "type": "boolean"
        },
        "isGuestCameraOn": {
          "description": "来宾入会是否开启摄像头。\n* true:开启\n* false:不开启",
          "type": "boolean"
        }
      }
    },
    "RestFailedRsp": {
      "description": "错误码信息。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "MMC.111072065"
        },
        "error_msg": {
          "type": "string",
          "description": "错误码描述。",
          "example": "CONF_NOT_FOUND_OR_AUTH_FAILED"
        }
      }
    },
    "ConferenceInfo": {
      "description": "会议信息。",
      "properties": {
        "conferenceID": {
          "description": "会议ID。",
          "type": "string"
        },
        "subject": {
          "description": "会议主题。",
          "type": "string"
        },
        "size": {
          "description": "会议预约时添加的会议者数量。",
          "type": "integer",
          "format": "int32"
        },
        "timeZoneID": {
          "description": "会议通知中会议时间的时区信息。时区信息,参考[时区映射关系](https://support.huaweicloud.com/api-meeting/meeting_21_0110.html#ZH-CN_TOPIC_0212714472__table137407441463)。",
          "type": "string"
        },
        "startTime": {
          "description": "会议起始时间 (YYYY-MM-DD HH:MM )。",
          "type": "string"
        },
        "endTime": {
          "description": "会议结束时间 (YYYY-MM-DD HH:MM )。",
          "type": "string"
        },
        "mediaTypes": {
          "description": "会议的媒体类型。\n由1个或多个枚举String组成,多个枚举时,每个枚举值之间通过”,”逗号分隔。\n- Voice: 语音\n- Video: 标清视频\n- HDVideo: 高清视频\n- Data: 数据",
          "type": "string"
        },
        "conferenceState": {
          "description": "会议状态。\n- Schedule: 预定状态\n- Creating: 正在创建状态\n- Created: 会议已经被创建,并正在召开\n- Destroyed: 会议已经关闭",
          "type": "string"
        },
        "language": {
          "description": "会议通知短信或邮件的语言。默认中文。\n* zh-CN:中文\n* en-US:英文",
          "type": "string"
        },
        "accessNumber": {
          "description": "会议接入的SIP号码。",
          "type": "string"
        },
        "passwordEntry": {
          "description": "会议密码。\n> * 创建会议时,返回主持人密码和来宾密码\n> * 主持人查询会议时,返回主持人密码和来宾密码来\n> * 宾查询会议时,返回来宾密码",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PasswordEntry"
          }
        },
        "userUUID": {
          "description": "会议预订者的用户UUID。",
          "type": "string"
        },
        "scheduserName": {
          "description": "会议预订者名称。",
          "type": "string"
        },
        "conferenceType": {
          "description": "会议类型。\n- 0: 普通会议\n- 2: 周期性会议",
          "type": "integer",
          "format": "int32"
        },
        "confType": {
          "description": "会议类型。\n- FUTURE:将来开始的会议(创建时)\n- IMMEDIATELY:立即开始的会议(创建时)\n- CYCLE:周期会议",
          "type": "string"
        },
        "cycleParams": {
          "description": "周期会议参数。当会议是周期会议的时候携带该参数。",
          "$ref": "#/definitions/CycleParams"
        },
        "isAutoMute": {
          "description": "是否入会自动静音。\n- 0: 不自动静音\n- 1: 自动静音",
          "type": "integer",
          "format": "int32"
        },
        "isAutoRecord": {
          "description": "是否自动开启云录制。\n- 0: 不自动启动\n- 1: 自动启动",
          "type": "integer",
          "format": "int32"
        },
        "chairJoinUri": {
          "description": "主持人会议链接地址。",
          "type": "string"
        },
        "guestJoinUri": {
          "description": "普通与会者会议链接地址。",
          "type": "string"
        },
        "audienceJoinUri": {
          "description": "网络研讨会观众会议链接地址。",
          "type": "string"
        },
        "recordType": {
          "description": "录播类型。\n- 0: 禁用\n- 1: 直播\n- 2: 录播\n- 3: 直播+录播",
          "type": "integer",
          "format": "int32"
        },
        "auxAddress": {
          "description": "辅流直播推流地址。",
          "type": "string"
        },
        "liveAddress": {
          "description": "主流直播推流地址。",
          "type": "string"
        },
        "recordAuxStream": {
          "description": "是否录制辅流。\n - 0: 否\n - 1: 是",
          "type": "integer",
          "format": "int32"
        },
        "recordAuthType": {
          "description": "观看/下载录播的鉴权方式。\n - 0: 可通过链接观看/下载\n - 1: 企业用户可观看/下载\n - 2: 与会者可观看/下载",
          "type": "integer",
          "format": "int32"
        },
        "liveUrl": {
          "description": "直播观看地址。",
          "type": "string"
        },
        "confConfigInfo": {
          "description": "会议其他配置信息。",
          "$ref": "#/definitions/RestConfConfigDTO"
        },
        "vmrFlag": {
          "description": "是否使用云会议室或个人会议ID召开预约会议。\n- 0: 不使用云会议室或个人会议ID\n- 1: 使用云会议室或个人会议ID",
          "type": "integer",
          "format": "int32"
        },
        "isHasRecordFile": {
          "description": "是否有会议录制文件。仅历史会议查询时返回。\n- true: 有录制文件\n- false: 没有录制文件",
          "type": "boolean",
