{
  "name": "SearchMeetings",
  "summary": "查询会议列表",
  "tags": "会议管理",
  "productshort": "Meeting",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/mmc/management/conferences": {
      "get": {
        "summary": "查询会议列表",
        "description": "该接口用于查询尚未结束的会议。\n* 管理员可以查询管理权限域内所有的会议,普通用户仅能查询自己创建或者需要参加的会议。不带查询参数时,默认查询权限范围内正在召开或还未召开的会议。\n* 只能查询尚未结束的会议(既正在召开的会议和已预约还未召开的会议)。如果需要查询历史会议列表,请参考[查询历史会议列表](https://support.huaweicloud.com/api-meeting/meeting_21_0051.html)。",
        "operationId": "SearchMeetings",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 9,
        "parameters": [
          {
            "name": "userUUID",
            "in": "query",
            "required": false,
            "description": "用户的UUID。\n> 仅管理员有权限查询本企业其他用户的会议列表;普通帐号该字段无效,只能查询自己的。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "查询偏移量。默认为0。",
            "type": "integer",
            "format": "int32",
            "default": 0
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "查询数量。默认是20,最大500条。",
            "type": "integer",
            "format": "int32",
            "maximum": 500,
            "minimum": 0,
            "default": 20
          },
          {
            "name": "queryAll",
            "in": "query",
            "required": false,
            "description": "是否查询企业下所有用户的会议记录。默认值为false。\n* true:查询所有用户的会议\n* false:仅查询管理员自己创建的会议\n> 仅对企业管理员生效。",
            "type": "boolean",
            "default": false
          },
          {
            "name": "searchKey",
            "in": "query",
            "required": false,
            "description": "查询条件。会议主题、会议预约人和会议ID等可作为搜索内容。长度限制为1-128个字符。",
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "queryConfMode",
            "in": "query",
            "required": false,
            "description": "查询时间范围。\n- ADAY:  一天\n- AWEEK:  一周\n- AMONTH:  一个月\n- ALL:  查询所有",
            "type": "string"
          },
          {
            "name": "sortType",
            "in": "query",
            "required": false,
            "description": "查询结果排序。\n- ASC_StartTIME:  按会议开始时间升序排序\n- DSC_StartTIME:  按会议开始时间降序排序",
            "type": "string"
          },
          {
            "name": "X-Access-Token",
            "in": "header",
            "required": true,
            "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
            "format": "password",
            "type": "string"
          },
          {
            "name": "X-Authorization-Type",
            "in": "header",
            "required": false,
            "description": "标识是否为第三方portal过来的请求。\n> 该参数将废弃,请勿使用。",
            "type": "string"
          },
          {
            "name": "X-Site-Id",
            "in": "header",
            "required": false,
            "description": "用于区分到哪个HCSO站点鉴权。\n> 该参数将废弃,请勿使用。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "examples": {
              "application/json": {
                "data": [
