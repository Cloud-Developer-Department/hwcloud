        "x-imports": "com.huawei.springframework.response.dto.ResultDTO;com.huawei.usg.cloudsso.model.dto.TokenDTO;com.huawei.usg.oms.model.kafka.annotation.*;com.huawei.usg.oms.model.kafka.constants.oplog.*;com.huawei.springframework.om.trace.masker.annotation.*;com.huawei.springframework.om.trace.masker.base.*;com.huawei.springframework.business.advice.HttpStatusController;",
        "x-classAnnotation": "@HttpStatusController",
