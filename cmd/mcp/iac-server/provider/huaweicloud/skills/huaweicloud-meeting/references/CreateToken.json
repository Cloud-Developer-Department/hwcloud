  "paths": {
    "/v1/usg/acs/auth/account": {
      "post": {
        "tags": [
          "登录鉴权"
        ],
        "operationId": "CreateToken",
        "summary": "执行鉴权",
        "description": "该接口使用华为云会议帐号和密码鉴权,鉴权通过后生成一个Access Token。\n> * 当clientType取值为72时,同一个account,同时最多能创建64个Token。比如已经创建了64个Token,并且Token都在有效期内,再用同一个account创建一个Token,前64个Token中最早创建的Token将失效。\n> * 当clientType取值为非72时,同一个account,同时最多能创建1个Token。\n> * Token有效期是12~24小时。",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 2,
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "鉴权信息,携带用户帐号信息。使用时需要进行[Base64转码操作](https://support.huaweicloud.com/api-meeting/meeting_21_0113.html) 。\n* 规则:Basic base64(username:password)\n* 样例:Basic eWMyOjE5OTUYyaTIwwWWM=\n> password最少8个字符,最多32个字符。",
            "required": true,
            "format": "password",
            "type": "string",
            "x-notgenerate": true,
            "x-example": "Basic NTV4MWYyaTI1N2w4Z3AzYWdpMTgyXXXXX....=="
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Body的媒体格式。\n* 样例:application/json; charset=UTF-8",
            "required": true,
            "type": "string",
            "x-notgenerate": true,
            "x-example": "application/json; charset=UTF-8"
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "description": "请求requestId,用来标识一路请求,用于问题跟踪定位,建议使用UUID,若不携带,则后台自动生成。",
            "required": false,
            "type": "string",
            "x-notgenerate": true,
            "x-example": "5162fa32dc7e47afafeee39a72a2eec3"
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "语言参数,默认为中文zh-CN,英文为en-US。",
            "required": false,
            "type": "string",
            "x-notgenerate": true,
            "x-example": "en-US"
          },
          {
            "name": "authReqDTOV1",
            "in": "body",
            "description": "鉴权请求信息。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AuthReqDTOV1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "examples": {
