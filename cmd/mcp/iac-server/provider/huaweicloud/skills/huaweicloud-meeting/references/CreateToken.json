  "definitions": {
    "ProxyTokenDTO": {
      "x-subPackage": "dto",
      "description": "代理鉴权信息。",
      "required": [
        "accessToken"
      ],
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "代理鉴权服务器的短token字符串。"
        },
        "longAccessToken": {
          "type": "string",
          "description": "代理鉴权服务器的长token字符串。"
        },
        "validPeriod": {
          "type": "integer",
          "format": "int64",
          "description": "Token有效时长,单位:秒。"
        },
        "middleEndUrl": {
          "type": "string",
          "description": "中台地址。"
        },
        "middleEndInnerUrl": {
          "type": "string",
          "description": "中台内网地址。"
        },
        "enableRerouting": {
          "type": "boolean",
          "description": "是否开启二次路由。"
        }
      }
    },
    "TokenDTO": {
      "x-subPackage": "dto",
      "required": [
        "user",
        "accessToken",
        "validPeriod",
        "expireTime",
        "tokenIp",
        "clientType"
      ],
      "description": "鉴权请求信息。",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "Access Token字符串。",
          "example": "stb8cyTJFlVdaeCIWXXXX...."
        },
        "tokenIp": {
          "type": "string",
          "description": "用户IP。",
          "example": "10.8.0.90"
        },
        "validPeriod": {
          "type": "integer",
          "format": "int64",
          "description": "Access Token有效时长,单位:秒。",
          "example": 82188
        },
        "expireTime": {
          "type": "integer",
          "format": "int64",
          "description": "Access Token的失效时间戳,单位:秒。",
          "example": 1577858014
        },
        "createTime": {
          "type": "integer",
          "format": "int64",
          "description": "Access Token的创建时间戳,单位:毫秒。"
        },
        "user": {
          "$ref": "#/definitions/UserInfo"
        },
        "clientType": {
          "type": "integer",
          "description": "登录帐号类型。\n* 72:API调用类型",
          "example": 72
        },
        "forceLoginInd": {
          "type": "integer",
          "description": "抢占登录标识。\n* 0: 非抢占\n* 1: 抢占",
          "example": null
        },
        "firstLogin": {
          "type": "boolean",
          "description": "是否首次登录。\n> 首次登录表示尚未修改过密码。首次登录时,系统会提醒用户需要修改密码。\n默认值:false。",
          "default": false,
          "example": true
        },
        "pwdExpired": {
          "type": "boolean",
          "description": "密码是否过期,默认值:false。",
          "default": false,
          "example": false
        },
        "daysPwdAvailable": {
          "type": "integer",
          "description": "密码有效天数。",
          "example": -18171
        },
        "proxyToken": {
          "$ref": "#/definitions/ProxyTokenDTO"
        },
        "delayDelete": {
          "type": "boolean",
          "description": "是否延时删除状态。",
          "default": false
        },
        "tokenType": {
          "type": "integer",
          "description": "Token类型。\n* 0:用户Access Token\n* 1:会控TOKEN\n* 2:一次性TOKEN"
        },
        "refreshToken": {
          "type": "string",
          "description": "Refresh Token字符串。"
        },
        "refreshValidPeriod": {
          "type": "integer",
          "format": "int64",
          "description": "Refresh Token有效时长,单位:秒。"
        },
        "refreshExpireTime": {
          "type": "integer",
          "format": "int64",
          "description": "Refresh Token的失效时间戳,单位:秒。"
        },
        "refreshCreateTime": {
          "type": "integer",
          "format": "int64",
          "description": "Refresh Token的创建时间戳,单位:毫秒。"
        }
      }
    },
    "AuthReqDTOV1": {
      "x-subPackage": "dto",
      "required": [
        "account",
        "clientType"
      ],
      "properties": {
        "account": {
          "type": "string",
          "description": "用户帐号(华为云会议帐号)。\n* 样例:zhangsan@huawei\n业务帐号请提前申请,具体申请方法请参见[开发流程](https://support.huaweicloud.com/devg-meeting/meeting_20_0002.html) 。\n> account最少1个字符,最多255个字符。",
          "maxLength": 255,
          "minLength": 1,
          "example": "zhangsan@huawei.com"
        },
        "clientType": {
          "type": "integer",
          "description": "登录客户端类型。\n* 72:API调用类型;",
          "maximum": 255,
          "minimum": 0,
          "x-example": 72
        },
        "createTokenType": {
          "type": "integer",
          "description": "是否生成Token,默认值为0。\n* 0:生成,用于登录鉴权\n* 1:不生成",
          "default": 0,
          "example": 1
        },
        "HA2": {
          "type": "string",
          "maxLength": 255,
          "minLength": 0,
          "description": "验证码信息,用于验证码场景携带服务端返回的验证码信息。",
          "example": "xxxx"
        }
      }
    },
