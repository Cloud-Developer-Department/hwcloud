{
  "name": "ListNetworkQuality",
  "summary": "查询会场网络质量",
  "tags": "网络质量",
  "productshort": "Meeting",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/mmc/cqs/media/qos": {
      "post": {
        "tags": [
          "网络质量"
        ],
        "description": "查询会场网络质量",
        "summary": "查询会场网络质量",
        "operationId": "ListNetworkQuality",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-open-region-cloud": "hc",
        "x-order": 42,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "conferenceid",
            "in": "query",
            "required": true,
            "description": "会议id",
            "type": "string",
            "minLength": 7,
            "maxLength": 9
          },
          {
            "name": "confToken",
            "in": "header",
            "required": true,
            "description": "会控Token,通过[获取会控token](https://support.huaweicloud.com/api-meeting/meeting_21_0027.html)接口获得。",
            "type": "string"
          },
          {
            "name": "appid",
            "in": "query",
            "required": false,
            "description": "会议的appId",
            "type": "string"
          },
          {
            "name": "confuuid",
            "in": "query",
            "required": true,
            "description": "会议UUID,MMR房间ID",
            "type": "string"
          },
          {
            "name": "restQosRequestDTO",
            "in": "body",
            "required": false,
            "description": "会场id和接入类型列表",
            "schema": {
              "$ref": "#/definitions/RestQosRequestDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "QoS查询响应",
            "schema": {
              "$ref": "#/definitions/RestQosResponse"
            }
          }
        },
        "deprecated": false,
        "x-name": "网络质量",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/mmc/cqs/media/qos?conferenceid=969271421&appid=605876aefa163e971ba21f8a40097b51&confuuid=cabcf4ec031749f594cdfc26bf0dba9e",
        "x-request-examples-1": {
          "users": [
            {
              "accessMediaType": "MGR",
              "pid": "a02212ed329811ef9a4f5fc2299e581f"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "Qos": {
      "description": "网络质量对象,音频不涉及分辨率和帧率(注:所有媒体流的数据均为服务器视角,Portal展示时需要转换为端侧视角)",
      "properties": {
        "networkQuality": {
          "type": "string",
          "description": "网络质量评级"
        },
        "codecType": {
          "type": "string",
          "description": "编解码类型"
        },
        "bandWidth": {
          "type": "integer",
          "format": "int32",
          "description": "带宽(kbit/s)"
        },
        "lostPacketRate": {
          "type": "integer",
          "format": "int32",
          "description": "丢包率(千分数)"
        },
        "delay": {
          "type": "integer",
          "format": "int32",
          "description": "时延(ms)"
        },
        "jitter": {
          "type": "integer",
          "format": "int32",
          "description": "抖动(ms)"
        },
        "resolutionHeight": {
          "type": "integer",
          "format": "int32",
          "description": "分辨率:高"
        },
        "resolutionWidth": {
          "type": "integer",
          "format": "int32",
          "description": "分辨率:宽"
        },
        "frameRate": {
          "type": "integer",
          "format": "int32",
          "description": "帧率"
        },
        "codecUserId": {
          "type": "string",
          "description": "该媒体流编码会场ID,仅服务器向端侧发送方向涉及(视频),如路径A-->服务器-->B,即B观看A,该媒体流的codec_user_id为A"
        }
      }
    },
    "UserQosReqInfo": {
      "description": "QOS请求用户信息",
      "properties": {
        "pid": {
          "type": "string",
          "description": "用户pid"
        },
        "accessMediaType": {
          "type": "string",
          "description": "用户接入媒体类型"
        }
      }
    },
    "UserQos": {
      "description": "会场网络质量对象",
      "properties": {
        "participantID": {
          "type": "string",
          "description": "会场ID"
        },
        "netRate": {
          "type": "string",
          "description": "网络质量评级"
        },
        "bandWidthUp": {
          "type": "integer",
          "format": "int32",
          "description": "上行总带宽(kbit/s)"
        },
        "bandWidthDown": {
          "type": "integer",
          "format": "int32",
          "description": "下行总带宽(kbit/s)"
        },
        "lostPacketRateUp": {
          "type": "integer",
          "format": "int32",
          "description": "上行丢包率(千分数)"
        },
        "lostPacketRateDown": {
          "type": "integer",
          "format": "int32",
          "description": "下行丢包率(千分数)"
        },
        "delay": {
          "type": "integer",
          "format": "int32",
          "description": "时延(ms)"
        },
        "videoQos": {
          "$ref": "#/definitions/MediaQos",
          "description": "视频QoS"
        },
        "audioQos": {
          "description": "音频QoS",
          "$ref": "#/definitions/MediaQos"
        },
        "auxQos": {
          "description": "辅流QoS",
          "$ref": "#/definitions/MediaQos"
        }
      }
    },
    "RestQosRequestDTO": {
      "description": "QOS请求",
      "properties": {
        "users": {
          "type": "array",
          "description": "用户pid 媒体接入类型列表",
          "items": {
            "$ref": "#/definitions/UserQosReqInfo"
          }
        }
      }
    },
    "RestQosResponse": {
      "description": "查询会场网络质量响应",
      "properties": {
        "returnCode": {
          "type": "integer",
          "description": "结果码"
        },
        "returnDesc": {
          "type": "string",
          "description": "结果描述"
        },
        "qosList": {
          "items": {
            "$ref": "#/definitions/UserQos"
          },
          "description": "会场Qos列表",
          "type": "array"
        }
      }
    },
    "MediaQos": {
      "description": "某种媒体的QoS,包括视频、音频或辅流",
      "properties": {
        "upList": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Qos"
          },
          "description": "客户端-->服务器方向QoS"
        },
        "downList": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Qos"
          },
          "description": "服务器-->客户端方向QoS"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "api-intl.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}