  "definitions": {
    "OpenRoomSettingVO": {
      "type": "object",
      "title": "OpenRoomSettingVO",
      "description": "网络研讨会高级设置。",
      "x-imports": [
        "com.fasterxml.jackson.annotation.*;",
        "com.huawei.meeting.webinar.annotation.FileMeta;",
        "com.huawei.meeting.webinar.constant.*;",
        "com.fasterxml.jackson.databind.JsonNode;"
      ],
      "x-annotations": [
        "@JsonInclude(JsonInclude.Include.NON_NULL)"
      ],
      "properties": {
        "roomIntroduce": {
          "type": "string",
          "description": "网络研讨会介绍。",
          "example": "带你一起,探索未知世界"
        },
        "cropLogoId": {
          "type": "string",
          "description": "企业Logo的文件id。",
          "example": "16868728f90245ac9a267116a1f28ed0",
          "x-annotations": [
            "@FileMeta(filePurpose = FilePurposeEnum.CROP_LOGO)",
            "@JsonAlias({\"cropLogoId\", \"corpLogoId\", \"logoId\"})"
          ]
        },
        "coverPictureId": {
          "type": "string",
          "description": "欢迎界面的文件id。",
          "example": "1213e0bd3abb11eb937179241b151879",
          "x-annotations": [
            "@FileMeta(filePurpose = FilePurposeEnum.COVER_PICTURE)",
            "@JsonAlias({\"coverPictureId\", \"pictureId\"})"
          ]
        },
        "showAudienceMode": {
          "type": "string",
          "description": "显示观众人数的模式。默认值为real_time。\n- none: 不显示\n- real_time: 实时显示",
          "example": "none",
          "default": "real_time"
        },
        "isRedoubleOpen": {
          "type": "string",
          "description": "智能倍增开关。默认值为Y。\n- Y 开启智能倍增\n- N 关闭智能倍增",
          "example": "N",
          "default": "Y"
        },
        "baseAudienceCount": {
          "type": "integer",
          "format": "int32",
          "description": "基础设置人数(网络研讨会没人时显示的人数)。默认值为0。取值范围为[0, 10000]。",
          "example": 100,
          "default": 0
        },
        "multiple": {
          "type": "number",
          "format": "double",
          "description": "设置倍数(基础人数+真实人数*倍数)。默认值为1.0。 取值范围为[0, 10],取1位小数。",
          "example": 1.5,
          "default": 1.0
        }
      }
    },
    "RestFailedResult": {
