{
  "name": "InviteParticipant",
  "summary": "邀请与会者",
  "tags": "会议控制",
  "productshort": "Meeting",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/mmc/control/conferences/participants": {
      "post": {
        "tags": [
          "会议控制"
        ],
        "summary": "邀请与会者",
        "description": "该接口用于邀请与会者加入会议。",
        "operationId": "InviteParticipant",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 3,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "conferenceID",
            "in": "query",
            "description": "会议ID。",
            "required": true,
            "type": "string",
            "x-example": "914067448"
          },
          {
            "name": "X-Conference-Authorization",
            "in": "header",
            "description": "会控Token,通过[获取会控token](https://support.huaweicloud.com/api-meeting/meeting_21_0027.html)接口获得。",
            "required": true,
            "format": "password",
            "type": "string",
            "x-example": "stb0442ae70a6e527de968a97be293bdc5a20a952fcc833bf17"
          },
          {
            "name": "reqBody",
            "in": "body",
            "description": "邀请与会者请求。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RestInviteReqBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。"
          },
          "400": {
            "description": "参数异常。",
            "examples": {
              "application/json": {
                "error_code": "MMC.111072065",
                "error_msg": "CONF_NOT_FOUND_OR_AUTH_FAILED"
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedRsp"
            }
          }
        },
        "deprecated": false,
        "x-name": "邀请与会者",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/mmc/control/conferences/participants?conferenceID=914067448",
        "x-request-examples-1": {
          "attendees": [
            {
              "name": "上海分会场",
              "phone": "+991116140865",
              "type": "normal"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "RestFailedRsp": {
      "description": "错误码信息。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "MMC.111072065"
        },
        "error_msg": {
          "type": "string",
          "description": "错误码描述。",
          "example": "CONF_NOT_FOUND_OR_AUTH_FAILED"
        }
      }
    },
    "Attendee": {
      "description": "与会者信息。",
      "required": [
        "name",
        "phone",
        "type"
      ],
      "properties": {
        "userUUID": {
          "description": "与会者的用户UUID。",
          "type": "string",
          "example": "2b8a5f45123d459ebacb8ef8ea32ed66"
        },
        "accountId": {
          "description": "与会者的华为云会议帐号。",
          "type": "string",
          "example": "nanjinghuiyizhongxin"
        },
        "name": {
          "description": "与会者名称,长度限制为96个字符。",
          "type": "string",
          "maxLength": 96,
          "minLength": 0,
          "example": "南京分会场"
        },
        "role": {
          "description": "会议中的角色。默认为普通与会者。\n- 0: 普通与会者\n- 1: 会议主持人",
          "type": "integer",
          "format": "int32",
          "maximum": 2,
          "minimum": 0,
          "default": 0,
          "example": 0
        },
        "phone": {
          "description": "号码。支持SIP号码或者手机号码。\n> * 号码可以通过[查询企业通讯](https://support.huaweicloud.com/api-meeting/meeting_21_0512.html)接口录获取。返回的number是SIP号码,phone是手机号码\n> * 填SIP号码系统会呼叫对应的软终端或者硬终端;填手机号码系统会呼叫手机\n> * 呼叫手机需要开通PSTN权限,否则无法呼叫",
          "type": "string",
          "maxLength": 127,
          "minLength": 0,
          "example": "+991111234666"
        },
        "phone2": {
          "description": "预留字段,取值类型同参数“phone”。",
          "type": "string",
          "maxLength": 127,
          "minLength": 0,
          "example": ""
        },
        "phone3": {
          "description": "预留字段,取值类型同参数“phone”。",
          "type": "string",
          "maxLength": 127,
          "minLength": 0,
          "example": ""
        },
        "email": {
          "description": "邮件地址。\n> 会中邀请不发会议通知,不用填写。",
          "type": "string",
          "maxLength": 255,
          "minLength": 0,
          "example": ""
        },
        "sms": {
          "description": "短信通知的手机号码。\n> 会中邀请不发会议通知,不用填写。",
          "type": "string",
          "maxLength": 32,
          "minLength": 0,
          "example": ""
        },
        "type": {
          "description": "终端类型,类型枚举如下:\n* normal:软终端\n* terminal:硬终端\n* outside:外部与会人\n* mobile:用户手机号码\n* ideahub:ideahub\n* board: 电子白板(SmartRooms)。含Maxhub、海信大屏、IdeaHub B2hwvision:华为智慧屏TV",
          "type": "string",
          "example": "normal"
        },
        "deptUUID": {
          "description": "部门编码。",
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "example": "16888"
        },
        "deptName": {
          "description": "部门名称。",
          "type": "string",
          "maxLength": 128,
          "minLength": 0,
          "example": "大中华区销售部"
        }
      }
    },
    "RestInviteReqBody": {
      "description": "邀请与会者请求。",
      "required": [
        "attendees"
      ],
      "properties": {
        "attendees": {
          "type": "array",
          "description": "邀请的与会者列表。",
          "items": {
            "$ref": "#/definitions/Attendee"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "api.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}