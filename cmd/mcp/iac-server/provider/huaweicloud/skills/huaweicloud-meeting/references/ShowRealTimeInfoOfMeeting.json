{
  "name": "ShowRealTimeInfoOfMeeting",
  "summary": "查询会议实时信息",
  "tags": "会议控制",
  "productshort": "Meeting",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/mmc/control/conferences/realTimeInfo": {
      "get": {
        "tags": [
          "会议控制"
        ],
        "summary": "查询会议实时信息",
        "description": "该接口用于查询正在召开的会议实时信息。",
        "operationId": "ShowRealTimeInfoOfMeeting",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 2,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "conferenceID",
            "in": "query",
            "description": "会议ID。",
            "required": true,
            "type": "string",
            "x-example": "914067448"
          },
          {
            "name": "X-Conference-Authorization",
            "in": "header",
            "description": "会控Token,通过[获取会控token](https://support.huaweicloud.com/api-meeting/meeting_21_0027.html)接口获得。",
            "required": true,
            "format": "password",
            "type": "string",
            "x-example": "stb0442ae70a6e527de968a97be293bdc5a20a952fcc833bf17"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "examples": {
              "application/json": {
                "confInfo": {
                  "chairID": "19ec603353bc11eab6b7a71f8c3e47c3",
                  "coHosts": [
                    "e4286e9c3cca11ef813235922d0586e5"
                  ]
                },
                "attendees": [
                  {
                    "userUUID": "ff80808167ef1edf0167f339533d05a6",
                    "name": "北京会场",
                    "phone": "+991116006766"
                  }
                ],
                "participants": [
                  {
                    "pid": "19ec603353bc11eab6b7a71f8c3e47c3",
                    "name": "北京会场",
                    "phone": "+991116006766",
                    "state": 0,
                    "video": 1,
                    "mute": 0,
                    "hand": 0
                  },
                  {
                    "pid": "e4286e9c3cca11ef813235922d0586e5",
                    "name": "上海会场",
                    "phone": "+991112939613",
                    "state": 0,
                    "video": 1,
                    "mute": 0,
                    "hand": 0
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/RestRealTimeInfoResponse"
            }
          },
          "400": {
            "description": "参数异常。",
            "examples": {
              "application/json": {
                "error_code": "MMC.111072065",
                "error_msg": "CONF_NOT_FOUND_OR_AUTH_FAILED"
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedRsp"
            }
          }
        },
        "deprecated": false,
        "x-name": "查询会议实时信息",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/mmc/control/conferences/realTimeInfo?conferenceID=914067448"
      }
    }
  },
  "definitions": {
    "RestFailedRsp": {
      "description": "错误码信息。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "MMC.111072065"
        },
        "error_msg": {
          "type": "string",
          "description": "错误码描述。",
          "example": "CONF_NOT_FOUND_OR_AUTH_FAILED"
        }
      }
    },
    "RestRealTimeInfoResponse": {
      "description": "会议实时信息。",
      "properties": {
        "attendees": {
          "type": "array",
          "description": "被邀请与会者信息,包括预约会议时邀请的与会者和会中主持人邀请的与会者,已经加入会议的和未加入会议的都返回。",
          "items": {
            "$ref": "#/definitions/RealTimeAttendee"
          }
        },
        "participants": {
          "type": "array",
          "description": "在线与会者列表信息,包括已加入会议、被邀请正在呼叫中、正在加入会议的与会者列表等。\n> * 同一个帐号用不同类型终端(手机端或者PC端等)加入会议时,是不同的在线与会者\n> * 未加入或者已离会与会者,不在在线与会者列表中",
          "items": {
            "$ref": "#/definitions/RealTimeParticipant"
          }
        },
        "confInfo": {
          "description": "会议信息。",
          "$ref": "#/definitions/RealTimeConfInfo"
        }
      }
    },
    "RealTimeConfInfo": {
      "description": "在线会议信息。",
      "properties": {
        "chairID": {
          "type": "string",
          "description": "主持人与会者标识。",
          "example": "af50e9e63b4111ea9668df997d1c89da"
        },
        "coHosts": {
          "type": "array",
          "x-open-region-cloud": "hws",
          "items": {
            "type": "string"
          },
          "description": "联席主持人会场id。",
          "example": [
            "e4286e9c3cca11ef813235922d0586e5"
          ]
        }
      }
    },
    "RealTimeAttendee": {
      "description": "被邀请与会者信息。",
      "properties": {
        "accountID": {
          "type": "string",
          "description": "与会者的华为云会议帐号。",
          "example": "zhuangmohan01"
        },
        "userUUID": {
          "type": "string",
          "description": "与会者的用户UUID。",
          "example": "2b8a5f45123d459ebacb8ef8ea32ed66"
        },
        "name": {
          "type": "string",
          "description": "与会者名称。",
          "example": "南京分会场"
        },
        "phone": {
          "type": "string",
          "description": "与会者号码。",
          "example": "+99111252010993685"
        },
        "phoneLeft": {
          "type": "string",
          "description": "设备为三屏智真时的左屏号码。\n> 该参数将废弃,请勿使用。",
          "example": ""
        },
        "phoneRight": {
          "type": "string",
          "description": "设备为三屏智真时的右屏号码。\n> 该参数将废弃,请勿使用。",
          "example": ""
        }
      }
    },
    "RealTimeParticipant": {
      "description": "在线会场信息。",
      "properties": {
        "pid": {
          "type": "string",
          "description": "与会者标识。",
          "example": "af50e9e63b4111ea9668df997d1c89da"
        },
        "name": {
          "type": "string",
          "description": "与会者名称。",
          "example": "南京分会场"
        },
        "phone": {
          "type": "string",
          "description": "与会者号码。",
          "example": "+991111234666"
        },
        "state": {
          "type": "integer",
          "format": "int32",
          "description": "用户状态。\n- 0: 会议中\n- 1: 正在呼叫\n- 2: 正在加入会议\n> 若会场未入会或已离会,则不会显示于在线会场列表。",
          "example": 0
        },
        "video": {
          "type": "integer",
          "format": "int32",
          "description": "音视频能力。\n- 0: 音频\n- 1: 视频",
          "example": 1
        },
        "mute": {
          "type": "integer",
          "format": "int32",
          "description": "麦克风状态。\n- 0: 麦克风打开\n- 1: 麦克风关闭",
          "example": 0
        },
        "hand": {
          "type": "integer",
          "format": "int32",
          "description": "与会者举手状态。\n- 0: 未举手\n- 1: 举手",
          "example": 0
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "api.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}