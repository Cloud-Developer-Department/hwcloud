  "definitions": {
    "RecordResultDO": {
      "description": "录制信息。",
      "properties": {
        "confUUID": {
          "type": "string",
          "description": "会议UUID。"
        },
        "confID": {
          "type": "string",
          "description": "会议ID。"
        },
        "url": {
          "description": "录播观看地址。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rcdTime": {
          "type": "integer",
          "description": "录制时长(单位秒)。",
          "format": "int32"
        },
        "rcdSize": {
          "type": "integer",
          "description": "录制文件大小(MB)。",
          "format": "int32"
        },
        "subject": {
          "type": "string",
          "description": "会议主题。"
        },
        "scheduserName": {
          "type": "string",
          "description": "会议预订者名称。"
        },
        "startTime": {
          "type": "string",
          "description": "会议开始时间。"
        },
        "isDecodeFinish": {
          "type": "boolean",
          "description": "录制文件是否转码完成。"
        },
        "decodeEndTime": {
          "type": "integer",
          "description": "录制文件预计转码完成时间。",
          "format": "int64"
        },
        "available": {
          "type": "boolean",
          "description": "录播文件是否可观看。"
        },
        "recordAuthType": {
          "description": "观看/下载录播的鉴权方式。\n- 0: 可通过链接观看/下载\n- 1: 企业用户可观看/下载\n- 2: 与会者可观看/下载",
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "RestFailedRsp": {
      "description": "错误码信息。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "MMC.111072065"
        },
        "error_msg": {
          "type": "string",
          "description": "错误码描述。",
          "example": "CONF_NOT_FOUND_OR_AUTH_FAILED"
        }
      }
    },
    "PageRecordFileRsp": {
      "description": "录播文件列表。",
      "properties": {
        "offset": {
          "description": "查询偏移量。",
          "type": "integer",
          "format": "int32"
        },
        "limit": {
          "description": "每页的记录数。",
          "type": "integer",
          "format": "int32"
        },
        "count": {
          "description": "总记录数。",
          "type": "integer",
          "format": "int32"
        },
        "data": {
          "description": "录播文件列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RecordResultDO"
          }
        }
      }
    }
