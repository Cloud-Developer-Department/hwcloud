      "get": {
        "summary": "查询录制列表",
        "description": "该接口用于查询会议录制列表。管理员可以查询本企业内所有的录制,普通用户仅能查询自己创建的会议的录制。不带查询参数时,默认查询权限范围内的录制。",
        "operationId": "SearchRecordings",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 14,
        "parameters": [
          {
            "name": "userUUID",
            "in": "query",
            "required": false,
            "description": "用户的UUID。\n> 仅管理员有权限查询本企业其他用户的会议录制;普通帐号该字段无效,只能查询自己的。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "指定返回的页面索引。该值必须大于0。\ndefault: 0",
            "type": "integer",
            "format": "int32",
            "default": 0
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "查询数量。默认是20,最大500条。",
            "type": "integer",
            "format": "int32",
            "default": 20
          },
          {
            "name": "queryAll",
            "in": "query",
            "required": false,
            "description": "是否查询企业下所有用户的历史会议。\n* true:查询所有用户的会议录制\n* false:仅查询管理员自己的会议录制\n> 仅对企业管理员生效。",
            "type": "boolean",
            "default": false
          },
          {
            "name": "searchKey",
            "in": "query",
            "required": false,
            "description": "查询条件。会议主题、会议预约人和会议ID等可作为搜索内容。",
            "type": "string"
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "description": "查询的起始时间戳(单位毫秒)。",
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "endDate",
            "in": "query",
            "required": true,
            "description": "查询的截止时间戳(单位毫秒)。",
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "sortType",
            "in": "query",
            "required": false,
            "description": "查询结果排序类型。\n- ASC_StartTIME:按录制开始时间升序排序\n- DSC_StartTIME:按录制开始时间降序排序",
            "type": "string",
            "default": "DSC_StartTIME"
