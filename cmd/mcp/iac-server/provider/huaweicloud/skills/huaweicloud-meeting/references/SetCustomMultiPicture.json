        "deprecated": false,
        "x-name": "设置自定义多画面",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "PUT https://{endpoint}/v1/mmc/control/conferences/display/customMultiPicture?conferenceID=914370850",
        "x-request-examples-1": {
          "manualSet": 1,
