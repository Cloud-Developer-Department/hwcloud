  },
  "definitions": {
    "RestCustomMultiPictureBody": {
      "type": "object",
      "description": "设置自定义多画面请求。",
      "required": [
        "manualSet"
      ],
      "properties": {
        "manualSet": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1,
          "description": "是否为手工设置多画面。\n* 0: 系统自动多画面\n* 1: 手工设置多画面"
        },
        "picLayoutInfo": {
          "$ref": "#/definitions/PicLayoutInfo",
          "description": "会议自定义多画面布局信息。\n> 预留参数,当前版本不可用。"
        },
        "imageType": {
          "type": "string",
          "description": "画面类型。手工设置多画面时有效。\n- Single: 单画面\n- Two: 二画面\n- Three: 三画面\n- Three-2: 三画面\n- Three-3: 三画面\n- Three-4: 三画面\n- Four: 四画面\n- Four-2: 四画面\n- Four-3: 四画面\n- Five: 五画面\n- Five-2: 五画面\n- Six: 六画面\n- Six-2: 六画面\n- Six-3: 六画面\n- Six-4: 六画面\n- Six-5: 六画面\n- Seven: 七画面\n- Seven-2: 七画面\n- Seven-3: 七画面\n- Seven-4: 七画面\n- Eight: 八画面\n- Eight-2: 八画面\n- Eight-3: 八画面\n- Eight-4: 八画面\n- Nine: 九画面\n- Ten: 十画面\n- Ten-2: 十画面\n- Ten-3: 十画面\n- Ten-4: 十画面\n- Ten-5: 十画面\n- Ten-6: 十画面\n- Thirteen: 十三画面\n- Thirteen-2: 十三画面\n- Thirteen-3: 十三画面\n- Thirteen-4: 十三画面\n- Thirteen-5: 十三画面\n- Sixteen: 十六画面\n- Seventeen: 十七画面\n- Twenty-Five: 二十五画面"
        },
        "subscriberInPics": {
          "type": "array",
          "description": "子画面列表(手工设置多画面时必填)。",
          "items": {
            "$ref": "#/definitions/RestSubscriberInPic"
          }
        },
        "switchTime": {
          "type": "integer",
          "format": "int32",
          "minimum": 10,
          "maximum": 120,
          "description": "表示轮询间隔,取值范围:10-120,默认10。单位:秒。\n当同一个子画面中包含有多个与会者时,此参数有效。\n> 仅针对专业会议终端生效,对软终端不生效。"
        },
        "multiPicSaveOnly": {
          "type": "boolean",
          "description": "多画面是否仅保存。\n* true: 仅保存\n* false: 保存并应用\n> * ”仅保存“效果:仅保存当前画面布局,不进行广播等操作。\n> * ”保存并应用“效果:1、当会议状态为广播多画面、声控单画面、声控多画面、主持人观看多画面时,保存并应用后,改变画面布局,不改变状态。2、当会议状态为非广播多画面、声控单画面、声控多画面、主持人观看多画面时,如自动多画面、广播与会者、点名与会者时,保存并应用后,变为广播多画面。\n> * 当处于广播多画面、声控多画面、声控单画面状态下,无法设置主持人观看多画面。"
        }
      }
    },
    "RestFailedRsp": {
      "description": "错误码信息。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "MMC.111072065"
        },
        "error_msg": {
          "type": "string",
          "description": "错误码描述。",
          "example": "CONF_NOT_FOUND_OR_AUTH_FAILED"
        }
      }
    },
    "RestSubscriberInPic": {
      "type": "object",
      "description": "子画面信息。",
      "properties": {
        "index": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 16,
          "description": "多画面中每个画面的编号。编号从1开始。默认值为“1”。"
        },
        "subscriber": {
          "type": "array",
          "description": "每个画面中与会者号码,从[查询会议实时信息](https://support.huaweicloud.com/api-meeting/meeting_21_0029.html)接口返回participants中的phone中获取。",
          "items": {
            "type": "string"
          }
        },
        "isAssistStream": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1,
          "description": "是否为辅流。默认值为0。\n* 0: 不是辅流\n* 1: 是辅流"
        }
      }
    },
    "PicLayoutInfo": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "description": "横向小格子数。"
        },
        "y": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "description": "纵向小格子数。"
        },
        "subPicLayoutInfoList": {
          "type": "array",
          "description": "多画面信息。",
          "items": {
            "$ref": "#/definitions/SubPicLayoutInfo"
          }
        }
      }
    },
    "SubPicLayoutInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "description": "多画面信息。"
        },
        "left": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "description": "子画面从左到右的索引。"
        },
        "top": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "description": "子画面从上到下的索引。"
        },
        "xSize": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "description": "子画面横向尺寸。"
        },
        "ySize": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "description": "子画面横向尺寸。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "api-intl.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}