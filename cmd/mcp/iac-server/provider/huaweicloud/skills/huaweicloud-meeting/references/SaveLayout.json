  "definitions": {
    "RestPicLayoutBody": {
      "type": "object",
      "description": "子画面信息。",
      "properties": {
        "restPicLayout": {
          "$ref": "#/definitions/RestPicLayout",
          "description": "会议多画面布局信息。"
        }
      }
    },
    "PicInfoNotify": {
      "description": "子画面信息。",
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "format": "int32",
          "description": "多画面中每个画面的编号,编号从1开始。"
        },
        "id": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "int32"
          },
          "description": "每个画面中的与会者SIP号码。SIP号码可以通过[查询企业通讯](https://support.huaweicloud.com/api-meeting/meeting_21_0512.html)获取。"
        },
        "share": {
          "type": "integer",
          "format": "int32",
          "description": "是否为辅流。\n* 0: 不是辅流\n* 1: 是辅流"
        }
      }
    },
    "RestFailedRsp": {
      "description": "错误码信息。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "MMC.111072065"
        },
        "error_msg": {
          "type": "string",
          "description": "错误码描述。",
          "example": "CONF_NOT_FOUND_OR_AUTH_FAILED"
        }
      }
    },
    "RestPicLayout": {
      "type": "object",
      "description": "多画面布局。",
      "properties": {
        "switchTime": {
          "type": "integer",
          "format": "int32",
          "minimum": 10,
          "description": "多画面轮询时间,单位秒。"
        },
        "picNum": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "description": "多画面画面数量。"
        },
        "layOutName": {
          "type": "string",
          "description": "多画面布局名称。"
        },
        "imageType": {
          "type": "string",
          "description": "画面类型。"
        },
        "uuid": {
          "type": "string",
          "description": "布局UUID。"
        },
        "subscriberInPics": {
          "description": "子画面列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PicInfoNotify"
          }
        }
      }
    }
  },
