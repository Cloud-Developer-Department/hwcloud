{
  "name": "InviteUser",
  "summary": "邀请用户",
  "tags": "用户管理",
  "productshort": "Meeting",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/usg/dcs/corp/member/add": {
      "post": {
        "tags": [
          "用户管理"
        ],
        "summary": "邀请用户",
        "description": "通过手机号码或者邮箱地址邀请用户加入企业。\n* 若被邀请用户在华为云会议系统中不存在,则:\n  - 华为云会议免费版和华为云会议标准版发送短信/邮件邀请用户完成注册后加入企业。用户注册成功后,加入该企业。\n  - 华为云会议旗舰版在企业内直接添加该用户。用户会收到华为云会议的初始密码,用户第一次以手机号或者邮箱登录时,需要修改密码。\n* 若被邀请用户在华为云会议系统中存在,则该用户会收到短信或者邮件确认。确认完成后改用户加入企业内。该用户的密码保持原来的密码不变。",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 12,
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "$ref": "#/parameters/X-Request-ID"
          },
          {
            "$ref": "#/parameters/Accept-Language"
          },
          {
            "name": "userDTO",
            "in": "body",
            "required": true,
            "description": "要求用户请求。",
            "schema": {
              "$ref": "#/definitions/AddUserRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "examples": {
              "application/json": {
                "userExist": false
              }
            },
            "schema": {
              "$ref": "#/definitions/AddUserResponseBody"
            }
          },
          "401": {
            "description": "未鉴权或鉴权失败。",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "403": {
            "description": "权限受限。",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "400": {
            "description": "参数异常。",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          }
        },
        "operationId": "InviteUser",
        "x-imports": "com.huawei.springframework.om.trace.masker.annotation.*;com.huawei.springframework.security.auth.annotation.TokenAuthorization;com.huawei.springframework.security.auth.constants.*;com.huawei.usg.oms.model.kafka.constants.oplog.*;com.huawei.usg.oms.model.kafka.annotation.*;",
        "x-methodAnnotations": [
          "@TokenAuthorization(userType=UserTypeEnum.CORP_MEMBER, adminType={AdminTypeEnum.DEFAULT_ADMIN,AdminTypeEnum.COMMON_ADMIN})",
          "@OpLogFunction(opObject = OpObjectEnum.CORPPORTAL_USER_MGT, opType = OpTypeEnum.ADD)",
          "@RequestMaskRule"
        ],
        "x-request-examples-url-1": "POST https://{endpoint}/v1/usg/dcs/corp/member/add",
        "x-request-examples-1": {
          "country": "chinaPR",
          "contact": "+86123456789",
          "name": "Zhangsan"
        }
      }
    }
  },
  "definitions": {
    "AddUserRequestBody": {
      "x-subPackage": "user",
      "x-imports": "com.huawei.usg.datacenter.model.user.BaseUser;",
      "allOf": [
        {
          "$ref": "#/definitions/BaseUser"
        }
      ],
      "description": "用户信息。"
    },
    "BaseUser": {
      "x-subPackage": "user",
      "x-imports": "com.huawei.springframework.utils.ValidateConstants;com.huawei.usg.oms.model.kafka.annotation.*;com.huawei.usg.oms.model.kafka.constants.oplog.*",
      "description": "用户基础信息。",
      "required": [
        "name",
        "contact"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "企业用户名称。",
          "maxLength": 64,
          "minLength": 1,
          "x-example": "Zhangsan"
        },
        "contact": {
          "description": "后台自动识别是手机还是邮箱,若为手机号,则要求和国家码匹配。\n> * 当前中国站点企业支持使用邮箱或手机号进行邀请,手机仅支持+86开头的手机号。\n> * 当前国际站点企业仅支持使用邮箱进行邀请。",
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "x-example": "+86173****9991"
        },
        "country": {
          "type": "string",
          "description": "[手机号所属的国家](https://support.huaweicloud.com/api-meeting/meeting_21_0109.html#ZH-CN_TOPIC_0212714591__table19371178135314) 。",
          "minLength": 0,
          "maxLength": 255,
          "default": "chinaPR",
          "x-example": "chinaPR"
        },
        "deptCode": {
          "type": "string",
          "description": "部门编码,若不携带则默认根部门。",
          "maxLength": 32,
          "minLength": 1,
          "default": "1",
          "x-example": "1"
        },
        "title": {
          "type": "string",
          "description": "职位。",
          "maxLength": 32,
          "minLength": 0,
          "x-example": "Project Manager"
        },
        "sortLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "通讯录排序等级,序号越低优先级越高。",
          "default": 10000,
          "x-example": 10000
        },
        "desc": {
          "type": "string",
          "description": "备注。",
          "maxLength": 128,
          "minLength": 0,
          "x-annotations": [
            "@OpLogProperty(value = \"I18n.OpLog.Dcs.User.Desc\")"
          ]
        }
      }
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "description": "异常返回结果。",
      "required": [
        "error_code",
        "error_msg",
        "request_id"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。"
        }
      }
    },
    "AddUserResponseBody": {
      "description": "邀请用户返回信息",
      "properties": {
        "userExist": {
          "type": "boolean",
          "description": "用户是否存在",
          "default": false
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Request-ID": {
      "name": "X-Request-Id",
      "in": "header",
      "description": "请求requestId,用来标识一路请求,用于问题跟踪定位,建议使用UUID,若不携带,则后台自动生成。",
      "required": false,
      "type": "string",
      "x-example": "208b6e4c92074487bc43292f8554561e"
    },
    "Accept-Language": {
      "name": "Accept-Language",
      "in": "header",
      "description": "语言参数,默认为中文zh-CN,英文为en-US。",
      "required": false,
      "type": "string",
      "x-example": "zh-CN"
    },
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    }
  },
  "host": "api.meeting.huaweicloud.com",
