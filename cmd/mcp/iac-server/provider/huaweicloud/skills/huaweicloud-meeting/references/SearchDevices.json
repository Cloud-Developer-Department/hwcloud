  "definitions": {
    "QueryDeviceResultDTO": {
      "description": "终端信息。",
      "properties": {
        "name": {
          "type": "string",
          "description": "终端名称。"
        },
        "type": {
          "type": "string",
          "description": "终端类型,区分自研和第三方终端。"
        },
        "model": {
          "type": "string",
          "description": "终端型号,枚举类型。当前支持TE系列和部分第三方硬件终端,具体的终端类型可以通过[获取所有终端类型](https://support.huaweicloud.com/api-meeting/meeting_21_0092.html)接口查询。"
        },
        "sn": {
          "type": "string",
          "description": "终端SN号,仅可包含数字、字母和下划线。"
        },
        "account": {
          "type": "string",
          "description": "硬终端对应的内置帐号。"
        },
        "number": {
          "type": "string",
          "description": "终端绑定的号码。"
        },
        "prjCodeMode": {
          "type": "integer",
          "description": "投影码生成模式。\n* 0:自动(该模式下根据消息上报的IP地址内部控制复杂度:私网地址配置成简单模式;公网地址配置成复杂模式)\n* 1:简单\n* 2:复杂"
        },
        "deptCode": {
          "type": "string",
          "description": "部门编码。"
        },
        "deptName": {
          "type": "string",
          "description": "部门名称。"
        },
        "deptNamePath": {
          "type": "string",
          "description": "部门名称路径。"
        },
        "phone": {
          "type": "string",
          "description": "手机号。"
        },
        "country": {
          "type": "string",
          "description": "[手机号所属的国家](https://support.huaweicloud.com/api-meeting/meeting_21_0109.html#ZH-CN_TOPIC_0212714591__table19371178135314) 。"
        },
        "email": {
          "type": "string",
          "description": "邮箱地址。"
        },
        "description": {
          "type": "string",
          "description": "终端描述。"
        },
        "status": {
          "type": "integer",
          "description": "终端状态。\n* 0、正常\n* 1、停用\""
        }
      }
    },
    "Pages": {
      "x-subPackage": "discard",
      "description": "分页查询的公共属性。",
      "properties": {
        "offset": {
          "type": "integer",
          "description": "页面起始页,从0开始。",
          "example": 0
        },
        "limit": {
          "type": "integer",
          "description": "每页显示的条目数量。\n默认值:10。",
          "example": 5
        },
        "count": {
          "type": "integer",
          "description": "总数量。",
          "example": 1
        }
      }
    },
    "QueryDevicePage": {
      "allOf": [
        {
          "$ref": "#/definitions/Pages"
        },
        {
          "properties": {
            "data": {
              "type": "array",
              "description": "终端信息列表。",
              "items": {
                "$ref": "#/definitions/QueryDeviceResultDTO"
              }
            }
          }
        }
      ]
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "description": "异常返回结果。",
      "required": [
        "error_code",
        "error_msg",
        "request_id"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
