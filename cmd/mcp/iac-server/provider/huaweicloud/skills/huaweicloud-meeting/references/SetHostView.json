  "definitions": {
    "RestChairViewReqBody": {
      "description": "主持人选看请求。",
      "required": [
        "viewType"
      ],
      "properties": {
        "viewType": {
          "type": "integer",
          "format": "int32",
          "description": "主持人观看的画面类型。\n- 0: 主持人轮询\n- 1: 主持人观看多画面\n- 2: 主持人选看会场",
          "example": 2
        },
        "participantID": {
          "type": "string",
          "description": "被主持人选看的会场。\n当为主持人选看会场时为必填参数。",
          "example": "af50e9e63b4111ea9668df997d1c89da"
        },
        "switchTime": {
          "type": "integer",
          "format": "int32",
          "description": "轮询间隔,单位:秒。\n主持人轮询时,必填字段。\n范围:[10-120],默认值:10。",
          "default": 10,
          "example": 10
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "启动/停止轮询。\n主持人轮询时,必填字段。\n- 0: 停止轮询\n- 1: 启动轮询",
          "default": 0,
          "example": 0
        }
      }
    },
    "RestFailedRsp": {
      "description": "错误码信息。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "MMC.111072065"
        },
        "error_msg": {
          "type": "string",
          "description": "错误码描述。",
          "example": "CONF_NOT_FOUND_OR_AUTH_FAILED"
        }
      }
    }
  },
