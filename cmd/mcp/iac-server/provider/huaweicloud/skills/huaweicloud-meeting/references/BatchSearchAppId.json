          "description": "企业应用名称",
          "minLength": 1,
          "maxLength": 64,
          "example": "测试企业应用"
        },
        "app_id": {
          "type": "string",
          "description": "企业应用ID",
          "pattern": "^\\w{1,64}$",
          "example": "f9a4149457cf4a67a69bc98f9bdb5123"
        },
        "app_key": {
          "x-sensitive": true,
          "type": "string",
          "description": "企业应用appkey",
          "minLength": 32,
          "maxLength": 128,
          "example": "123456788c9f4ba5839fe2dc1ca73d53"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "企业应用描述",
          "example": "测试企业应用使用"
        },
        "create_time": {
          "type": "string",
          "description": "企业应用创建时间",
          "minLength": 0,
          "maxLength": 19,
          "example": "2024-06-28 19:13:07"
        },
        "last_update_time": {
          "type": "string",
          "description": "最近修改时间",
          "minLength": 0,
          "maxLength": 19,
          "example": "2024-06-28 19:13:07"
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1,
          "example": 0,
          "description": "企业应用状态 \n* 0:正常 \n* 1:停用"
        }
      }
    },
    "Pages": {
      "x-subPackage": "discard",
      "description": "分页查询的公共属性。",
      "properties": {
        "offset": {
          "type": "integer",
          "description": "页面起始页,从0开始。",
          "example": 0
        },
        "limit": {
          "type": "integer",
          "description": "每页显示的条目数量。\n默认值:10。",
          "example": 5
        },
        "count": {
          "type": "integer",
          "description": "总数量。",
          "example": 1
        }
      }
    },
    "BatchSearchAppIdResponseBody": {
      "allOf": [
        {
          "$ref": "#/definitions/Pages"
        },
        {
          "properties": {
            "data": {
              "type": "array",
              "description": "企业应用信息",
              "minItems": 0,
              "maxItems": 100,
              "items": {
                "$ref": "#/definitions/AppIdInfoDTO"
              }
            }
          }
        }
      ]
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
