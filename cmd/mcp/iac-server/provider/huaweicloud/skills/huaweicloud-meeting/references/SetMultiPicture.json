  },
  "definitions": {
    "RestMixedPictureBody": {
      "description": "设置多画面请求。",
      "required": [
        "manualSet"
      ],
      "properties": {
        "manualSet": {
          "type": "integer",
          "format": "int32",
          "description": "是否为手工设置多画面。\n- 0: 系统自动多画面\n- 1: 手工设置多画面",
          "example": 1
        },
        "imageType": {
          "type": "string",
          "description": "多画面数目。手工设置多画面时有效。\n- Single: 单画面\n- Two: 二画面\n- Three: 三画面\n- Four: 四画面\n- Six: 六画面\n- Nine: 九画面\n- Sixteen: 十六画面",
          "example": "Two"
        },
        "subscriberInPics": {
          "type": "array",
          "description": "子画面列表(手工设置多画面时必填)。",
          "items": {
            "$ref": "#/definitions/SubscriberInPic"
          }
        },
        "switchTime": {
          "type": "integer",
          "format": "int32",
          "description": "表示轮询间隔。单位:秒。\n当同一个子画面中包含有多个与会者时,此参数有效。",
          "example": 20
        }
      }
    },
    "RestFailedRsp": {
      "description": "错误码信息。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "MMC.111072065"
        },
        "error_msg": {
          "type": "string",
          "description": "错误码描述。",
          "example": "CONF_NOT_FOUND_OR_AUTH_FAILED"
        }
      }
    },
    "SubscriberInPic": {
      "description": "子画面信息。",
      "required": [
        "index"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "format": "int32",
          "description": "多画面中每个画面的编号。编号从1开始。\n默认值为1。",
          "example": 1
        },
        "subscriber": {
          "type": "array",
          "description": "每个画面中与会者标识列表,从[查询会议实时信息](https://support.huaweicloud.com/api-meeting/meeting_21_0029.html)接口返回的pid中获取。",
          "items": {
            "type": "string"
          }
        },
        "isAssistStream": {
          "type": "integer",
          "format": "int32",
          "description": "是否为辅流。默认值为0。\n- 0: 不是辅流\n- 1: 是辅流",
          "default": 0,
          "example": 0
        }
      }
    }
  },
  "version": "2.0",
