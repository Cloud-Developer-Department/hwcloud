  "paths": {
    "/v1/mmc/management/record/downloadurls": {
      "get": {
        "summary": "查询录制文件下载链接",
        "description": "该接口用户查询指定会议录制文件下载链接。\n> * 仅企业管理员权限的帐号才能查询录制文件的下载链接\n> * 这个接口需要在华为云会议后台开通白名单后才能调用。请联系华为销售人员,并提供华为云会议企业ID",
        "operationId": "ShowRecordingFileDownloadUrls",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 16,
        "parameters": [
          {
            "name": "confUUID",
            "in": "query",
            "required": true,
            "description": "会议UUID(通过[查询录制列表](https://support.huaweicloud.com/api-meeting/meeting_21_0048.html)获取)。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "查询偏移量。默认为0。",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "查询数量。默认是20,最大500条。",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "X-Access-Token",
            "in": "header",
            "required": true,
            "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
            "format": "password",
            "type": "string"
          },
          {
            "name": "X-Authorization-Type",
            "in": "header",
            "required": false,
            "description": "标识是否为第三方portal过来的请求。\n> 该参数将废弃,请勿使用。",
            "type": "string"
          },
          {
            "name": "X-Site-Id",
            "in": "header",
            "required": false,
            "description": "用于区分到哪个HCSO站点鉴权。\n> 该参数将废弃,请勿使用。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "examples": {
              "application/json": {
                "recordUrls": [
                  {
                    "confUuid": "7206baf3595411eab96df9726995e579",
                    "urls": [
                      {
                        "token": "177e1ba1230ad98b15b4df21d72ffa51",
                        "fileType": "Aux",
                        "url": "https://{vod_endpoint}/download/typeThree/video/resource/00037/00037ed2-351a-4741-8ce6-a2078f21ba6b/videoAux/0_0.mp4"
                      }
                    ]
                  }
                ]
              }
            },
