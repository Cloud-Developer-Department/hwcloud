            }
          },
          "400": {
            "description": "参数异常。",
            "examples": {
              "application/json": {
                "error_code": "MMC.111070005",
                "error_msg": "CONF_DATA_NOT_FOUND"
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedRsp"
            }
          },
          "401": {
            "description": "未鉴权或鉴权失败。",
            "examples": {
              "application/json": {
                "error_code": "MMC.118000001",
                "error_msg": "USER_TOKEN_AUTH_FAILED"
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedRsp"
            }
          },
          "500": {
            "description": "服务端异常。",
            "examples": {
              "application/json": {
                "error_code": "MMC.11070003",
                "error_msg": "CONF_EXCEPTION"
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedRsp"
            }
          }
        },
        "deprecated": false,
        "x-name": "查询录制文件下载链接",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/mmc/management/record/downloadurls?confUUID=7206baf3595411eab96df9726995e579",
        "tags": [
          "会议管理"
        ]
      }
    }
  },
  "definitions": {
    "RestFailedRsp": {
      "description": "错误码信息。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "MMC.111072065"
        },
        "error_msg": {
          "type": "string",
          "description": "错误码描述。",
          "example": "CONF_NOT_FOUND_OR_AUTH_FAILED"
        }
      }
    },
    "RecordDownloadInfoBO": {
      "description": "会议录制文件下载链接信息。",
      "type": "object",
      "properties": {
        "confUuid": {
          "type": "string",
          "description": "会议UUID。"
        },
        "urls": {
          "type": "array",
          "description": "下载链接信息。",
          "items": {
            "$ref": "#/definitions/RecordDownloadUrlDO"
          }
        }
      }
    },
    "RecordDownloadUrlRsp": {
      "description": "录制文件下载链接。",
      "type": "object",
      "properties": {
        "recordUrls": {
          "type": "array",
          "description": "录制文件下载链接。",
          "items": {
            "$ref": "#/definitions/RecordDownloadInfoBO"
          }
        }
      }
    },
    "RecordDownloadUrlDO": {
      "description": "单个录制文件下载链接信息。",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "下载鉴权token,下载文件时,使用该token鉴权。(一小时内有效,使用后立即失效)。"
        },
        "fileType": {
          "type": "string",
          "description": "文件类型。\n* Aux:辅流(会议中的共享画面;分辨率为720p)\n* Hd:高清(会议中的视频画面;分辨率和会议中视频画面的分辨率一致,1080p或者720p)\n* Sd:标清(会议中视频画面和共享画面的合成画面,视频画面是大画面,共享画面是小画面,共享画面布局在右下方;分辨率为4CIF)\n> 单个MP4文件大小不超过1GB。"
        },
        "url": {
          "type": "string",
          "description": "文件下载url,最大1000个字符。"
        }
      }
    }
  },
