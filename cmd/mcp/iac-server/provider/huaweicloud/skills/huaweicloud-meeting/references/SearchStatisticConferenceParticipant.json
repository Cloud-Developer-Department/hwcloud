{
  "name": "SearchStatisticConferenceParticipant",
  "summary": "查询企业级会议与会统计数据",
  "tags": "会议统计",
  "productshort": "Meeting",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/metrics/dashboard/statistic/conference/participant": {
      "get": {
        "tags": [
          "OpenStatisticMetrics"
        ],
        "operationId": "SearchStatisticConferenceParticipant",
        "summary": "查询企业级会议与会统计数据",
        "description": "该接口用于查询企业内与会者数据统计:\n* 查询与会用户统计数据,按日/按月统计。\n* 查询与会硬件终端统计数据,按日/按月统计。\n* 查询与会设备统计数据,按日/按月统计。\n> 仅旗舰版企业/标准版企业的企业管理员有权限查询。",
        "x-support-sdk": "Y",
        "x-apiexplorer-auth": false,
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-open-region-cloud": "hc",
        "x-order": 2,
        "deprecated": false,
        "consumes": [
          "application/json; charset=utf-8"
        ],
        "produces": [
          "application/json; charset=utf-8"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询偏移量。\n* 取值:大于等于0,默认值为0\n* 大于等于最大条目数量,则返回最后一页数据,页数根据总条目数和limit计算得出",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询的条目数量。\n* 取值:1-500,默认值为20",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 20,
            "x-example": 20
          },
          {
            "name": "timeUnit",
            "in": "query",
            "description": "查询时间维度,取值:\n* D: 按日查询\n* M: 按月查询",
            "required": true,
            "type": "string",
            "enum": [
              "D",
              "M"
            ],
            "x-example": "D"
          },
          {
            "name": "startTime",
            "in": "query",
            "description": "查询时间范围的开始时间,格式根据timeUnit的取值而定。\n* timeUnit = D,格式:yyyy-MM-dd,此情况下startTime与endTime间隔最多31日\n* timeUnit = M,格式:yyyy-MM,此情况下startTime与endTime间隔最多12个月",
            "required": true,
            "type": "string",
            "pattern": "\\d{4}-\\d{2}(-\\d{2}){0,1}",
            "x-example": "2020-08-01"
          },
          {
            "name": "endTime",
            "in": "query",
            "description": "查询时间范围的结束时间,格式根据timeUnit的取值而定。\n* timeUnit = D,格式:yyyy-MM-dd,此情况下startTime与endTime间隔最多31日\n* timeUnit = M,格式:yyyy-MM,此情况下startTime与endTime间隔最多12个月",
            "required": true,
            "type": "string",
            "pattern": "\\d{4}-\\d{2}(-\\d{2}){0,1}",
            "x-example": "2020-08-31"
          },
          {
            "name": "category",
            "in": "query",
            "description": "查询分类,取值:\n* user_participate_info: 用户与会统计数据\n* hard_terminal_participate_info: 硬件终端与会统计数据\n* participant_type_info: 与会设备统计数据",
            "required": true,
            "type": "string",
            "enum": [
              "user_participate_info",
              "hard_terminal_participate_info",
              "participant_type_info"
            ],
            "x-example": "participant_type_info"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "examples": {
              "application/json": {
                "count": 3,
                "limit": 4,
                "offset": 0,
                "data": [
                  {
                    "time": "2021-04-18",
                    "confUserName": "linghaiwen",
                    "confUserAccount": "lingwenhai",
                    "confUserDeptName": "1",
                    "confUserCount": "1",
                    "confUserDuration": "53"
                  },
                  {
                    "time": "2021-04-19",
                    "confUserName": "zhaoyuwei",
                    "confUserAccount": "haiwenling",
                    "confUserDeptName": "lingwenhai",
                    "confUserCount": "3",
                    "confUserDuration": "33"
                  },
                  {
                    "time": "2021-04-19",
                    "confUserName": "linghaiwen",
                    "confUserAccount": "lingwenhai",
                    "confUserDeptName": "lingwenhai",
                    "confUserCount": "2",
                    "confUserDuration": "22"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/SearchStatisticParticipateInfoResult"
            }
          },
          "400": {
            "description": "Bad Request 客户端传参异常。",
            "examples": {
              "application/json": {
                "error_code": "MBI.104000001",
                "error_msg": "The mandatory parameter is missing."
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedResult"
            }
          },
          "401": {
            "description": "Unauthorized 未鉴权或鉴权失败。",
            "examples": {
              "application/json": {
                "error_code": "MBI.0000000004",
                "error_msg": "Illegal request."
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedResult"
            }
          },
          "403": {
            "description": "Forbidden 权限受限。",
            "examples": {
              "application/json": {
                "error_code": "MBI.104030001",
                "error_msg": "Insufficient permissions, non-flagship enterprise."
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedResult"
            }
          },
          "500": {
            "description": "服务端异常。",
            "examples": {
              "application/json": {
                "error_code": "MBI.105000001",
                "error_msg": "The server is busy."
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedResult"
            }
          }
        },
        "x-imports": [
          "com.huawei.springframework.security.auth.annotation.TokenAuthorization;",
          "com.huawei.springframework.security.auth.constants.*;"
        ],
        "x-methodAnnotations": [
          "@TokenAuthorization(userType = {UserTypeEnum.CORP_MEMBER}, adminType = {AdminTypeEnum.DEFAULT_ADMIN, AdminTypeEnum.COMMON_ADMIN})"
        ],
        "x-name": "查询企业级会议与会统计数据",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/metrics/dashboard/statistic/conference/participant?timeUnit=D&startTime=2021-04-01&endTime=2021-04-30&category=user_participate_info&offset=0&limit=4"
      }
    }
  },
  "definitions": {
    "StatisticParticipateDataItem": {
      "x-annotations": [
        "@com.fasterxml.jackson.annotation.JsonInclude(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_EMPTY)"
      ],
      "description": "会议与会统计数据的单个时间点数据。",
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "description": "日期/月份。",
          "minLength": 1,
          "maxLength": 128
        },
        "confUserName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "与会用户名称。\ncategory = user_participate_info时有效。"
        },
        "confUserAccount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "与会用户账户。\ncategory = user_participate_info时有效。"
        },
        "confUserDeptName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "与会用户所属部门。\ncategory = user_participate_info时有效。"
        },
        "confUserCount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "用户与会数。\ncategory = user_participate_info时有效。"
        },
        "confUserDuration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "用户与会时长(秒)。\ncategory = user_participate_info时有效。"
        },
        "confHardTerminalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "与会硬件终端名称。\ncategory = hard_terminal_participate_info时有效。"
        },
        "confHardTerminalModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "与会硬件终端型号。\ncategory = hard_terminal_participate_info时有效。"
        },
        "confHardTerminalUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "与会硬件终端的用户ID。\ncategory = hard_terminal_participate_info时有效。"
        },
        "confHardTerminalCount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "硬件终端与会数。\ncategory = hard_terminal_participate_info时有效。"
        },
        "confHardTerminalDuration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "硬件终端与会时长(秒)。\ncategory = hard_terminal_participate_info时有效。"
        },
        "deviceType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "与会设备类型。\ncategory = participant_type_info时有效。"
        },
        "deviceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "与会设备版本。\ncategory = participant_type_info时有效。"
        },
        "deviceAttendanceCount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "设备与会数。\ncategory = participant_type_info时有效。"
        }
      }
    },
    "RestFailedResult": {
      "description": "处理失败返回结果。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "结果码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果描述。"
        }
      }
    },
    "SearchStatisticParticipateInfoResult": {
      "x-annotations": [
        "@com.fasterxml.jackson.annotation.JsonInclude(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_NULL)"
      ],
      "description": "会议与会统计数据查询结果。",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "总记录数。",
          "minimum": 0,
          "example": 1
        },
        "limit": {
          "type": "integer",
          "description": "查询条目数量。",
          "minimum": 10,
          "maximum": 500,
          "example": 20
        },
        "offset": {
          "type": "integer",
          "description": "查询偏移量。",
          "minimum": 0,
          "example": 0
        },
        "data": {
          "description": "会议与会数据按时间点统计的查询结果数组。",
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/definitions/StatisticParticipateDataItem"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    }
  },
  "host": "api.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}