{
  "name": "SearchCorpExternalDir",
  "summary": "查询企业外部联系人",
  "tags": "查询企业通讯录",
  "productshort": "Meeting",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/usg/abs/external-contacts": {
      "get": {
        "summary": "查询企业外部联系人",
        "tags": [
          "查询企业通讯录"
        ],
        "description": "企业用户(含管理员)通过该接口查询该企业的外部联系人或者个人外部联系人。",
        "operationId": "SearchCorpExternalDir",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 2,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "$ref": "#/parameters/X-Request-ID"
          },
          {
            "$ref": "#/parameters/Accept-Language"
          },
          {
            "$ref": "#/parameters/offset"
          },
          {
            "$ref": "#/parameters/limit"
          },
          {
            "name": "searchKey",
            "in": "query",
            "description": "搜索条件。支持名称、手机、邮箱模糊搜索。",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 1024,
            "x-example": "zhansan"
          },
          {
            "name": "searchScope",
            "in": "query",
            "description": "搜索范围。默认值为ALL。\n* PERSONAL - 查询个人外部联系人\n* CORP - 查询企业外部联系人\n* ALL - 查询所有外部联系人",
            "type": "string",
            "required": false,
            "default": "ALL",
            "x-example": "CORP"
          }
        ],
        "responses": {
          "200": {
            "description": "响应成功",
            "examples": {
              "application/json": {
                "offset": 0,
                "limit": 5,
                "count": 1,
                "data": [
                  {
                    "otherNumber": "",
                    "otherNumberCountry": "",
                    "country": "chinaPR",
                    "phone": "+8613575450611",
                    "email": "lishi@example.com",
                    "corpName": null,
                    "deptName": null,
                    "position": null,
                    "address": null,
                    "remarks": null,
                    "id": "af4aaae4b29d45649e3c61f48ee2f64b",
                    "name": "李四",
                    "customNumber": null,
                    "type": "CORP",
                    "updateTime": 1665994358499
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ExternalContactDTOPages"
            }
          }
        },
        "x-request-examples-text-1": "GET https://{endpoint}/v1/usg/abs/external-contacts?offset=0&limit=5&searchScope=CORP",
        "x-request-examples-1": "GET https://{endpoint}/v1/usg/abs/external-contacts?offset=0&limit=5&searchScope=CORP"
      }
    }
  },
  "definitions": {
    "ExternalContactBase": {
      "allOf": [
        {
          "properties": {
            "otherNumber": {
              "description": "其他号码。\n> * 其他号码必须以国家码作为前缀\n> * otherNumber填写时,otherNumberCountry也必须填写\n> * 如果要清空手机号配置,则otherNumberCountry和otherNumber都要置为\"\"",
              "example": "+8613789854984",
              "type": "string",
              "minLength": 0,
              "maxLength": 32
            },
            "otherNumberCountry": {
              "description": "[其他号码所属的国家](https://support.huaweicloud.com/api-meeting/meeting_21_0109.html#ZH-CN_TOPIC_0212714591__table19371178135314) 。",
              "example": "chinaPR",
              "type": "string",
              "minLength": 0,
              "maxLength": 32
            },
            "country": {
              "description": "[手机号所属的国家](https://support.huaweicloud.com/api-meeting/meeting_21_0109.html#ZH-CN_TOPIC_0212714591__table19371178135314) 。",
              "type": "string",
              "maxLength": 255,
              "default": "chinaPR",
              "example": "chinaPR"
            },
            "phone": {
              "description": "手机号。\n> * 手机号必须以国家码作为前缀\n> * phone填写时,country也必须填写\n> * 如果要清空手机号配置,则country和phone都要置为\"\"",
              "example": "+8613789854986",
              "type": "string",
              "minLength": 0,
              "maxLength": 32
            },
            "email": {
              "description": "邮箱。",
              "type": "string",
              "minLength": 0,
              "maxLength": 255
            },
            "corpName": {
              "description": "公司名称。",
              "type": "string",
              "minLength": 0,
              "maxLength": 64
            },
            "deptName": {
              "description": "部门。",
              "type": "string",
              "minLength": 0,
              "maxLength": 64
            },
            "position": {
              "description": "职务。",
              "type": "string",
              "minLength": 0,
              "maxLength": 64
            },
            "address": {
              "description": "个人地址。",
              "type": "string",
              "minLength": 0,
              "maxLength": 1024
            },
            "remarks": {
              "description": "备注。",
              "type": "string",
              "minLength": 0,
              "maxLength": 1024
            }
          }
        }
      ]
    },
    "Pages": {
      "x-subPackage": "discard",
      "description": "分页查询的公共属性。",
      "properties": {
        "offset": {
          "type": "integer",
          "description": "页面起始页,从0开始。",
          "example": 0
        },
        "limit": {
          "type": "integer",
          "description": "每页显示的条目数量。\n默认值:10。",
          "example": 5
        },
        "count": {
          "type": "integer",
          "description": "总数量。",
          "example": 1
        }
      }
    },
    "ExternalContactDTOPages": {
      "allOf": [
        {
          "$ref": "#/definitions/Pages"
        },
        {
          "properties": {
            "data": {
              "description": "分页查询外部联系人信息。",
              "type": "array",
              "items": {
                "$ref": "#/definitions/ExternalContactDTO"
              }
            }
          }
        }
      ]
    },
    "ExternalContactDTO": {
      "description": "外部联系人信息。",
      "allOf": [
        {
          "$ref": "#/definitions/ExternalContactBase"
        },
        {
          "properties": {
            "id": {
              "type": "string",
              "description": "外部联系人UUID。"
            },
            "name": {
              "type": "string",
              "description": "姓名。"
            },
            "customNumber": {
              "type": "string",
              "description": "外部联系人自定义号码。\n> 仅VDC场景下使用。"
            },
            "updateTime": {
              "type": "number",
              "description": "用户信息最后更新时间戳。",
              "example": 1554268817303
            },
            "type": {
              "type": "string",
              "description": "外部联系人类型。\n* PERSONAL:个人外部联系人\n* CORP:企业外部联系人"
            }
          }
        }
      ]
    }
  },
  "version": "2.0",
