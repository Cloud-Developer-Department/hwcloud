        "x-methodAnnotations": [
          "@TokenAuthorization(userType = {UserTypeEnum.CORP_MEMBER}, adminType = {AdminTypeEnum.DEFAULT_ADMIN, AdminTypeEnum.COMMON_ADMIN})"
        ],
        "x-name": "设置企业租户指定类型的会议质量阈值",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/metrics/conference/threshold?thresholdType=AUDIO",
        "x-request-examples-1": {
          "latency": {
            "receiving": 500,
            "sending": 50
          },
          "jitter": {
            "receiving": 500,
