  "definitions": {
    "SetQosThresholdResult": {
      "description": "设置企业用户阈值结果",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "返回码"
        },
        "message": {
          "type": "string",
          "description": "返回信息"
        }
      },
      "title": "SetQosThresholdResult"
    },
    "SetCPUThresholdData": {
      "description": "CPU阈值设置请求体",
      "type": "object",
      "properties": {
        "cpu": {
          "type": "integer",
          "format": "int32",
          "description": "CPU阈值设定值,单位为百分比(%)。\n取值范围:0 - 100。",
          "minimum": 0,
          "maximum": 100,
          "example": 50
        }
      },
      "title": "SetCPUThresholdData"
    },
    "SetQosThresholdReq": {
      "description": "设置企业用户指定类型的阈值的请求体。",
      "type": "object",
      "properties": {
        "latency": {
          "description": "* 延迟阈值设置值,单位为毫秒(ms)\n* thresholdTYpe = AUDIO/VIDEO/SCREEN时必填\n* thresholdType = CPU时无效",
          "$ref": "#/definitions/SetThresholdData"
        },
        "jitter": {
          "description": "* 抖动阈值设置值,单位为毫秒(ms)\n* thresholdTYpe = AUDIO/VIDEO/SCREEN时必填\n* thresholdType = CPU时无效",
          "$ref": "#/definitions/SetThresholdData"
        },
        "packetLoss": {
          "description": "* 丢包率阈值设置值,单位为百分比(%)\n* thresholdTYpe = AUDIO/VIDEO/SCREEN时必填\n* thresholdType = CPU时无效",
          "$ref": "#/definitions/SetPacketThresholdData"
        },
        "clientCpuMax": {
          "description": "* 会议最大CPU阈值设置值,单位为百分比(%)\n* thresholdTYpe = AUDIO/VIDEO/SCREEN时无效\n* 仅当thresholdType = CPU时必填",
          "$ref": "#/definitions/SetCPUThresholdData"
        },
        "systemCpuMax": {
          "description": "* 系统最大CPU阈值设置值,单位为百分比(%)\n* thresholdTYpe = AUDIO/VIDEO/SCREEN时无效\n* 仅当thresholdType = CPU时必填",
          "$ref": "#/definitions/SetCPUThresholdData"
        }
      },
      "title": "SetQosThresholdReq"
    },
    "RestFailedResult": {
      "description": "处理失败返回结果。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "结果码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果描述。"
        }
      }
    },
    "SetPacketThresholdData": {
      "description": "丢包率阈值设置请求体。",
      "type": "object",
      "properties": {
        "receiving": {
          "type": "integer",
          "format": "int32",
          "description": "接收方向阈值设定值,单位为百分比(%)。\n取值范围:0 - 100。",
          "minimum": 0,
          "maximum": 100,
          "example": 50
        },
        "sending": {
          "type": "integer",
          "format": "int32",
          "description": "发送方向阈值设定值,单位为百分比(%)。\n取值范围:0 - 100。",
          "minimum": 0,
          "maximum": 100,
          "example": 50
        }
      },
      "title": "SetPacketThresholdData"
    },
    "SetThresholdData": {
      "description": "阈值阈值设置请求体。",
      "type": "object",
      "properties": {
        "receiving": {
          "type": "integer",
          "format": "int32",
          "description": "接收方向阈值设定值,单位为毫秒(ms)。\n取值范围:0 - 10000。",
          "minimum": 0,
          "maximum": 10000,
          "example": 50
        },
        "sending": {
          "type": "integer",
          "format": "int32",
          "description": "发送方向阈值设定值,单位为毫秒(ms)。\n取值范围:0 - 10000。",
          "minimum": 0,
          "maximum": 10000,
          "example": 50
        }
      },
      "title": "SetThresholdData"
    }
  },
  "version": "2.0",
  "parameters": {
