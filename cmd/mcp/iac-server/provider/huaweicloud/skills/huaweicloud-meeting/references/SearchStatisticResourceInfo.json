{
  "name": "SearchStatisticResourceInfo",
  "summary": "查询企业级会议已购资源使用统计数据",
  "tags": "会议统计",
  "productshort": "Meeting",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/metrics/dashboard/statistic/resource/info": {
      "get": {
        "tags": [
          "OpenStatisticMetrics"
        ],
        "operationId": "SearchStatisticResourceInfo",
        "summary": "查询企业级会议已购资源使用统计数据",
        "description": "该接口用于查询企业内已购资源使用状况数据统计:\n* 查询已购资源使用状况,按日/按月统计。\n> 仅旗舰版企业/标准版企业的企业管理员有权限查询。",
        "x-support-sdk": "Y",
        "x-apiexplorer-auth": false,
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-open-region-cloud": "hc",
        "x-order": 4,
        "deprecated": false,
        "consumes": [
          "application/json; charset=utf-8"
        ],
        "produces": [
          "application/json; charset=utf-8"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询偏移量。\n* 取值:大于等于0,默认值为0\n* 大于等于最大条目数量,则返回最后一页数据,页数根据总条目数和limit计算得出",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询的条目数量。\n* 取值:1-500,默认值为20",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 20,
            "x-example": 20
          },
          {
            "name": "timeUnit",
            "in": "query",
            "description": "查询时间维度,取值:\n* D: 按日查询\n* M: 按月查询",
            "required": true,
            "type": "string",
            "enum": [
              "D",
              "M"
            ],
            "x-example": "D"
          },
          {
            "name": "startTime",
            "in": "query",
            "description": "查询时间范围的开始时间,格式根据timeUnit的取值而定。\n* timeUnit = D,格式:yyyy-MM-dd,此情况下startTime与endTime间隔最多31日\n* timeUnit = M,格式:yyyy-MM,此情况下startTime与endTime间隔最多12个月",
            "required": true,
            "type": "string",
            "pattern": "\\d{4}-\\d{2}(-\\d{2}){0,1}",
            "x-example": "2020-08-01"
          },
          {
            "name": "endTime",
            "in": "query",
            "description": "查询时间范围的结束时间,格式根据timeUnit的取值而定。\n* timeUnit = D,格式:yyyy-MM-dd,此情况下startTime与endTime间隔最多31日\n* timeUnit = M,格式:yyyy-MM,此情况下startTime与endTime间隔最多12个月",
            "required": true,
            "type": "string",
            "pattern": "\\d{4}-\\d{2}(-\\d{2}){0,1}",
            "x-example": "2020-08-31"
          },
          {
            "name": "category",
            "in": "query",
            "description": "查询分类,取值:\n* used_vmr_info: 已购VMR资源使用统计数据\n* used_live_info: 已购直播端口资源使用统计数据\n* used_record_info: 已购录播资源使用统计数据\n* used_pstn_info: 已购电话外呼资源使用统计数据",
            "required": true,
            "type": "string",
            "enum": [
              "used_vmr_info",
              "used_live_info",
              "used_record_info",
              "used_pstn_info"
            ],
            "x-example": "used_vmr_info"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "examples": {
              "application/json": {
                "count": 3,
                "limit": 10,
                "offset": 0,
                "data": [
                  {
                    "time": "2021-03-18",
                    "recordUsedSize": "0.23"
                  },
                  {
                    "time": "2021-03-19",
                    "recordUsedSize": "4035.24"
                  },
                  {
                    "time": "2021-03-20",
                    "recordUsedSize": "4036.24"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/SearchStatisticResourceInfoResult"
            }
          },
          "400": {
            "description": "Bad Request 客户端传参异常。",
            "examples": {
              "application/json": {
                "error_code": "MBI.104000001",
                "error_msg": "The mandatory parameter is missing."
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedResult"
            }
          },
          "401": {
            "description": "Unauthorized 未鉴权或鉴权失败。",
            "examples": {
              "application/json": {
                "error_code": "MBI.0000000004",
                "error_msg": "Illegal request."
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedResult"
            }
          },
          "403": {
            "description": "Forbidden 权限受限。",
            "examples": {
              "application/json": {
                "error_code": "MBI.104030001",
                "error_msg": "Insufficient permissions, non-flagship enterprise."
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedResult"
            }
          },
          "500": {
            "description": "服务端异常。",
            "examples": {
              "application/json": {
                "error_code": "MBI.105000001",
                "error_msg": "The server is busy."
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedResult"
            }
          }
        },
        "x-imports": [
          "com.huawei.springframework.security.auth.annotation.TokenAuthorization;",
          "com.huawei.springframework.security.auth.constants.*;"
        ],
        "x-methodAnnotations": [
          "@TokenAuthorization(userType = {UserTypeEnum.CORP_MEMBER}, adminType = {AdminTypeEnum.DEFAULT_ADMIN, AdminTypeEnum.COMMON_ADMIN})"
        ],
        "x-name": "查询企业级会议已购资源使用统计数据",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/metrics/dashboard/statistic/resource/info?timeUnit=D&startTime=2021-03-18&endTime=2021-03-20&category=used_record_info&offset=0&limit=10"
      }
    }
  },
  "definitions": {
    "SearchStatisticResourceInfoResult": {
      "x-annotations": [
        "@com.fasterxml.jackson.annotation.JsonInclude(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_NULL)"
      ],
      "description": "会议已购资源使用数据查询结果。",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "总记录数。",
          "minimum": 0,
          "example": 1
        },
        "limit": {
          "type": "integer",
          "description": "查询条目数量。",
          "minimum": 10,
          "maximum": 500,
          "example": 20
        },
        "offset": {
          "type": "integer",
          "description": "查询偏移量。",
          "minimum": 0,
          "example": 0
        },
        "data": {
          "description": "会议已购资源使用数据按时间点统计的查询结果数组。",
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/definitions/StatisticResourceDataItem"
          }
        }
      }
    },
    "RestFailedResult": {
      "description": "处理失败返回结果。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "结果码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果描述。"
        }
      }
    },
    "StatisticResourceDataItem": {
      "x-annotations": [
        "@com.fasterxml.jackson.annotation.JsonInclude(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_EMPTY)"
      ],
      "description": "会议已购资源使用数据的单个时间点数据。",
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "description": "日期/月份。",
          "minLength": 1,
          "maxLength": 128
        },
        "vmrParties": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "VMR方数。\ncategory = used_vmr_info时有效。"
        },
        "maxConcurrencyVmrCount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "VMR并发使用数。\ncategory = used_vmr_info时有效。"
        },
        "livePortUsedCount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "直播端口并发使用数。\ncategory = used_live_info时有效。"
        },
        "recordUsedSize": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "录播使用空间(G)。\ncategory = used_record_info时有效。"
        },
        "pstnUsedDuration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "PSTN外呼时长(分钟)。\ncategory = used_pstn_info时有效。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    }
  },
  "host": "api-intl.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}