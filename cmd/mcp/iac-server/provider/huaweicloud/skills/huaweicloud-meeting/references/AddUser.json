  "definitions": {
    "UserVmrDTO": {
      "properties": {
        "id": {
          "type": "string",
          "description": "云会议室的ID。\n> 对应[创建会议](https://support.huaweicloud.com/api-meeting/meeting_21_0014.html)接口中的vmrID。",
          "example": "2c908bc76f61a5f2016f61bbfdf5039b"
        },
        "vmrId": {
          "type": "string",
          "description": "云会议室的固定会议ID。\n> 对应[创建会议](https://support.huaweicloud.com/api-meeting/meeting_21_0014.html)接口返回数据的vmrConferenceID。",
          "example": "912992631"
        },
        "vmrName": {
          "type": "string",
          "description": "云会议室名称。",
          "example": "张三的云会议室"
        },
        "vmrMode": {
          "type": "integer",
          "description": "VMR模式。\n- 0:个人会议ID\n- 1: 云会议室\n- 2: 网络研讨会"
        },
        "vmrPkgId": {
          "type": "string",
          "description": "云会议室套餐包的id,仅云会议室返回。",
          "example": null
        },
        "vmrPkgName": {
          "type": "string",
          "description": "云会议室套餐包的名称,仅云会议室返回。",
          "example": null
        },
        "vmrPkgParties": {
          "type": "integer",
          "description": "云会议室套餐包的会议并发方数,仅云会议室返回。",
          "example": null
        },
        "vmrPkgLength": {
          "type": "integer",
          "description": "云会议室套餐包的与会时间,若为0则代表无限时长,仅云会议室返回。",
          "example": null
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "云会议室状态。\n* 0:正常\n* 1:停用\n* 2:未分配",
          "example": 0,
          "enum": [
            0,
            1,
            2
          ]
        }
      }
    },
    "UserFunctionDTO": {
      "properties": {
        "enableRoom": {
          "type": "boolean",
          "description": "是否开启智能协同白板功能。如果开启,表示该帐号是给智能协同白板使用,占用企业智能协同白板的资源,如果资源不足,则无法开启。\n默认值:false。\n> 该参数将废弃,请勿使用。",
          "default": false,
          "example": false
        }
      }
    },
    "CorpBasicInfoDTO": {
      "description": "企业注册信息。",
      "properties": {
        "id": {
          "description": "企业id。",
          "type": "string"
        },
        "name": {
          "description": "企业名称。",
          "type": "string"
        },
        "address": {
          "description": "企业所在地。",
          "type": "string"
        },
        "adminName": {
          "description": "管理员名称。",
          "type": "string"
        },
        "account": {
          "description": "管理员的华为云会议帐号。",
          "type": "string"
        },
        "phone": {
          "description": "管理员手机。",
          "type": "string"
        },
        "country": {
          "description": "[手机号所属的国家](https://support.huaweicloud.com/api-meeting/meeting_21_0109.html#ZH-CN_TOPIC_0212714591__table19371178135314) 。",
          "type": "string"
        },
        "email": {
          "description": "管理员邮箱。",
          "type": "string"
        },
        "enableSMS": {
          "description": "是否通过短信形式发送会议通知。",
          "type": "boolean"
        },
        "enableCloudDisk": {
          "description": "是否开启云盘。",
          "type": "boolean"
        },
        "enablePstn": {
          "description": "是否具有pstn功能。",
          "type": "boolean"
        },
        "autoUserCreate": {
          "description": "是否支持自动开户。",
          "type": "boolean"
        },
        "corpType": {
          "description": "企业类型。\n* 0:旗舰版\n* 5:免费版\n* 6:标准版",
          "type": "integer"
        }
      }
    },
    "QueryUserResultDTO": {
      "description": "查询用户的返回结果DTO对象。",
      "properties": {
        "id": {
          "type": "string",
          "description": "用户UUID。"
        },
        "userAccount": {
          "type": "string",
          "description": "华为云会议帐号。"
        },
        "name": {
          "type": "string",
          "description": "名称。"
        },
        "englishName": {
          "type": "string",
          "description": "英文名称。"
        },
        "phone": {
          "type": "string",
          "description": "联系电话。"
        },
        "country": {
          "type": "string",
          "description": "[手机号所属的国家](https://support.huaweicloud.com/api-meeting/meeting_21_0109.html#ZH-CN_TOPIC_0212714591__table19371178135314) 。"
        },
        "email": {
          "type": "string",
          "description": "邮箱地址。"
        },
        "sipNum": {
          "type": "string",
          "description": "SIP号码。"
        },
        "vmrList": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UserVmrDTO"
          },
          "description": "云会议室列表。"
        },
        "deptCode": {
          "type": "string",
          "description": "部门编码。"
        },
        "deptName": {
          "type": "string",
          "description": "部门名称。"
        },
        "deptNamePath": {
          "type": "string",
          "description": "部门完整名称。"
        },
        "userType": {
          "type": "integer",
          "description": "用户类型。\n- 2:企业成员账户"
        },
        "adminType": {
          "type": "integer",
          "description": "管理员类型。\n- 0:默认(超级)管理员\n- 1:普通管理员\n- 2:非管理员(即为普通企业成员,UserType是2时有效)"
        },
        "signature": {
          "type": "string",
          "description": "签名。"
        },
        "title": {
          "type": "string",
          "description": "职位。"
        },
        "desc": {
          "type": "string",
          "description": "备注。"
        },
        "corp": {
          "description": "企业注册信息。仅用户查询自己的信息才返回该数据。",
          "$ref": "#/definitions/CorpBasicInfoDTO"
        },
        "function": {
          "description": "用户功能位。",
          "$ref": "#/definitions/UserFunctionDTO"
        },
        "devType": {
          "description": "绑定设备类型信息。",
          "$ref": "#/definitions/QueryDeviceInfoResultDTO"
        },
        "status": {
          "type": "integer",
          "description": "用户状态。\n* 0:正常\n* 1:停用"
        },
        "sortLevel": {
          "type": "integer",
          "description": "通讯录排序等级,序号越低优先级越高。"
        },
        "hidePhone": {
          "type": "boolean",
          "description": "是否隐藏手机号码。"
        },
        "visionAccount": {
          "type": "string",
          "description": "智慧屏唯一帐号。"
        },
        "thirdAccount": {
          "type": "string",
          "description": "第三方User ID。"
        },
        "license": {
          "type": "integer",
          "description": "许可证。\n* 0:商用\n* 1:免费试用"
        },
        "activeTime": {
          "type": "integer",
          "format": "int64",
          "description": "激活时间,utc时间戳。"
        }
      }
    },
    "AddUserDTO": {
      "description": "用户信息。",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "企业用户名称。",
          "minLength": 1,
          "maxLength": 64,
          "example": "张三"
        },
        "englishName": {
          "type": "string",
          "description": "企业用户的英文名称。",
          "minLength": 0,
          "maxLength": 64,
          "example": "Zhangsan"
        },
        "account": {
          "type": "string",
          "description": "企业用户帐号,若携带则以携带为准,否则后台自动生成。帐号整系统唯一。\n帐号只能包含大小写字母、数字、_、-、.、@符号,不能为纯数字和@后面带.号。\n> 帐号/密码鉴权方式时需要填写。",
          "minLength": 0,
          "maxLength": 64,
          "example": "Zhangsan123"
        },
        "thirdAccount": {
          "type": "string",
          "description": "第三方User ID。\n> App ID鉴权方式时需要填写。第三方User ID需要企业内唯一。",
          "minLength": 0,
          "maxLength": 64,
          "example": "Zhangsan@example.com"
        },
        "phone": {
          "type": "string",
          "description": "手机号,必须加上国家码。\n例如中国大陆手机+86xxxxxxx。当填写手机号时 “country”参数必填。\n手机号只允许输入纯数字。\n说明:手机号或者邮箱至少填写一个",
          "example": "+8618911112222"
        },
        "country": {
          "type": "string",
          "description": "[手机号所属的国家](https://support.huaweicloud.com/api-meeting/meeting_21_0109.html#ZH-CN_TOPIC_0212714591__table19371178135314) 。",
          "example": "chinaPR"
        },
        "pwd": {
          "type": "string",
          "description": "企业用户帐号的密码。若携带则以实际携带为准,否则后台默认生成,密码必须满足:\n1、8-32位\n2、不能和帐号的正序和倒序一致\n3、至少包含两种字符类型:小写字母、大写字母、数字、特殊字符(` ~ ! @ # $ % ^ & * ( ) - _ = + | [ { } ] ; : \" ,’ < . > / ?)",
          "example": "pwd!@#$123456"
        },
        "email": {
          "type": "string",
          "description": "邮箱地址。"
        },
        "deptCode": {
          "type": "string",
          "description": "部门编码,若不携带则默认根部门。\n默认值:1",
          "example": "1"
        },
        "signature": {
          "type": "string",
          "description": "签名。",
          "minLength": 0,
          "maxLength": 512,
          "example": "张三的签名信息"
        },
        "title": {
          "type": "string",
          "description": "职位。",
          "minLength": 0,
          "maxLength": 32,
          "example": "Project Manager"
        },
        "desc": {
          "type": "string",
          "description": "备注。",
          "minLength": 0,
          "maxLength": 128,
          "example": "note information"
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "用户状态。默认值:0\n* 0:正常\n* 1:停用",
          "enum": [
            0,
            1
          ]
        },
        "function": {
          "description": "用户功能位",
          "$ref": "#/definitions/UserFunctionDTO"
        },
        "sendNotify": {
          "type": "string",
          "description": "是否发送开户的邮件和短信通知。\n- 0 不发送\n- 不填或者其他值就发送, 默认发送",
          "example": "0"
        },
        "sortLevel": {
          "type": "integer",
          "description": "通讯录排序等级,序号越低优先级越高。\n默认值:10000",
          "minimum": 1,
          "maximum": 10000,
          "example": 10000
        },
        "hidePhone": {
          "type": "boolean",
          "description": "是否隐藏手机号码。默认值:false。\n* true:在通讯录和会议中不显示手机号码\n* false:在通讯录和会议中显示手机号码",
          "example": false
        }
      }
    },
