{
  "name": "SearchQosParticipants",
  "summary": "查询QoS会议与会者列表",
  "tags": "会议QoS",
  "productshort": "Meeting",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/metrics/conference/participants": {
      "get": {
        "tags": [
