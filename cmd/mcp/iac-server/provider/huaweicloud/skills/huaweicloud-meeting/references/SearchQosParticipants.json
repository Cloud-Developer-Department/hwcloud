        "participantID": {
          "type": "string",
          "description": "与会者标识。",
          "minLength": 0,
          "maxLength": 64,
          "example": "kxxwoo5hmo9khlmggklawbwiwfl999bw"
        },
        "userUUID": {
          "type": "string",
          "description": "用户UUID。",
          "minLength": 0,
          "maxLength": 64,
          "example": "ff80808167ef1edf0167f339533d05a6"
        },
        "displayName": {
          "type": "string",
          "description": "与会者的名称。",
          "minLength": 0,
          "maxLength": 512,
