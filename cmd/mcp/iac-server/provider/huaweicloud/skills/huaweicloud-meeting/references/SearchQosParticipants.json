          "description": "摄像头。",
          "minLength": 0,
          "maxLength": 512,
          "example": "Lenovo EasyCamera"
        },
        "dataCenter": {
          "type": "string",
          "description": "数据中心。",
          "minLength": 0,
          "maxLength": 64,
          "example": "Region-China-2"
        },
        "leftReason": {
          "type": "integer",
          "format": "int32",
          "description": "离会原因。此字段仅标识离会原因,不做为是否已离会的判断依据。正在与会人员的离会原因初始值 = 0。\n* 0:正常离会\n* 1:网络异常离会",
          "example": 0
        },
        "existQos": {
          "type": "boolean",
          "description": "与会者是否存在QoS数据。\n* true:存在QoS数据\n* false:不存在QoS数据",
          "example": true
