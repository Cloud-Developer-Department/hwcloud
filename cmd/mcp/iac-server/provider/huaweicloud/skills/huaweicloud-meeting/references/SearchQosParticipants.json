            "description": "会议类别。\n* online:在线会议,正在召开的会议\n* history:历史会议,已结束的会议",
            "required": true,
            "type": "string",
            "enum": [
              "online",
              "history"
            ],
            "x-example": "history"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询偏移量。\n* 取值:大于等于0,默认值为0。\n* 大于等于最大条目数量,则返回最后一页的数据。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询的条目数量。\n* 取值:1-500,默认值为20。",
            "required": false,
            "type": "integer",
