          "minLength": 0,
          "maxLength": 32,
          "example": "PC"
        },
        "role": {
          "type": "string",
          "description": "与会者角色。\n- host:主持人\n- guest:来宾\n- audience:观众",
          "minLength": 0,
          "maxLength": 32,
          "example": "host"
        },
        "ipAddress": {
          "type": "string",
          "description": "与会者的IP地址。",
          "minLength": 0,
          "maxLength": 64,
          "example": "112.46.84.9"
        },
        "country": {
          "type": "string",
          "description": "国家。",
          "minLength": 0,
          "maxLength": 128,
          "example": "中国"
        },
        "province": {
          "type": "string",
          "description": "省市(仅限中国)。",
          "minLength": 0,
          "maxLength": 128,
          "example": "四川省"
        },
        "city": {
          "type": "string",
          "description": "城市(仅限中国)。",
          "minLength": 0,
          "maxLength": 128,
          "example": "成都市"
        },
        "appVersion": {
          "type": "string",
          "description": "华为云会议APP版本。",
          "minLength": 0,
          "maxLength": 128,
          "example": "60.15.5"
        },
        "joinTime": {
          "type": "integer",
          "format": "int64",
          "description": "入会时间(UTC时间), Unix时间戳(单位毫秒)。",
          "example": 1618220940926
        },
        "leftTime": {
          "type": "integer",
          "format": "int64",
          "description": "离会时间(UTC时间), Unix时间戳(单位毫秒)。\n> * 与会者未离会:leftTime = 0\n> * 与会者已离会:leftTime = 实际离会时间",
          "example": 1618221194202
        },
        "systemInfo": {
          "type": "string",
          "description": "终端操作系统信息。",
          "minLength": 0,
          "maxLength": 128,
          "example": "android-11"
        },
        "networkType": {
          "type": "string",
          "description": "网络类型。",
          "minLength": 0,
          "maxLength": 64,
          "example": "wifi"
        },
        "alarm": {
          "type": "string",
          "description": "总体告警。\n* YES:音频(发送/接收),视频(发送/接收),屏幕共享(发送/接收),CPU任一项产生告警,总体告警状态即为 YES\n* NO:无告警",
          "minLength": 0,
          "maxLength": 16,
          "example": "YES"
        },
        "audioAlarmSend": {
          "type": "string",
          "description": "音频发送告警。\n* YES :发送音频的抖动,时延,丢包率任一项产生阈值告警,则音频发送告警状态为YES\n* NO:发送音频无告警",
          "minLength": 0,
          "maxLength": 16,
          "example": "YES"
        },
        "videoAlarmSend": {
          "type": "string",
          "description": "视频发送告警。\n* YES :发送视频的抖动,时延,丢包率任一项产生阈值告警,则视频发送告警状态为YES\n* NO:发送视频无告警",
          "minLength": 0,
          "maxLength": 16,
          "example": "NO"
        },
        "screenAlarmSend": {
          "type": "string",
          "description": "屏幕共享发送告警。\n* YES:发送屏幕共享的抖动,时延,丢包率任一项产生阈值告警,则屏幕共享发送告警状态为YES\n* NO:发送屏幕共享无告警",
          "minLength": 0,
          "maxLength": 16,
          "example": "NO"
        },
        "audioAlarmRec": {
          "type": "string",
          "description": "音频接收告警。\n* YES:接收音频的抖动,时延,丢包率任一项产生阈值告警,则音频接收告警状态为YES\n* NO:接收音频无告警",
          "minLength": 0,
          "maxLength": 16,
          "example": "YES"
        },
        "videoAlarmRec": {
          "type": "string",
          "description": "视频接收告警。\n* YES:接收视频的抖动,时延,丢包率任一项产生阈值告警,则视频接收告警状态为YES\n* NO:接收视频无告警",
          "minLength": 0,
          "maxLength": 16,
          "example": "YES"
        },
        "screenAlarmRec": {
          "type": "string",
          "description": "屏幕共享接收告警。\n* YES:接收屏幕共享的抖动,时延,丢包率任一项产生阈值告警,则屏幕共享接收告警状态为YES\n* NO:接收屏幕共享无告警",
          "minLength": 0,
          "maxLength": 16,
          "example": "NO"
        },
        "cpuAlarm": {
          "type": "string",
          "description": "CPU告警。\n* YES:端侧的APP最大CPU使用率或系统最大CPU使用率任一项产生阈值告警,则CPU告警状态为YES\n* NO:CPU无告警",
          "minLength": 0,
          "maxLength": 16,
          "example": "NO"
        },
        "microphoneInfo": {
          "type": "string",
          "description": "麦克风。",
