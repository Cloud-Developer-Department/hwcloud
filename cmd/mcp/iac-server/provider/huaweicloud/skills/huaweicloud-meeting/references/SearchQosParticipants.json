      "x-annotations": [
        "@com.fasterxml.jackson.annotation.JsonInclude(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_NULL)"
      ],
      "description": "查询会议与会者QoS告警信息。",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "总记录数。",
          "minimum": 0,
          "example": 1
        },
        "limit": {
          "type": "integer",
          "description": "查询条目数量。",
          "minimum": 10,
          "maximum": 500,
          "example": 10
        },
        "offset": {
          "type": "integer",
          "description": "查询偏移量。",
          "minimum": 0,
          "example": 0
        },
        "data": {
          "description": "会议与会者QoS告警列表。",
          "type": "array",
          "minItems": 0,
          "maxItems": 500,
          "items": {
            "$ref": "#/definitions/QosParticipantInfo"
          }
        }
      }
    },
