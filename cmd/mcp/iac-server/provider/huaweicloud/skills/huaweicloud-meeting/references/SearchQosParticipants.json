        ],
        "operationId": "SearchQosParticipants",
        "summary": "查询QoS会议与会者列表",
        "description": "该接口用于查询企业内在线会议或历史会议的与会者QoS告警。仅旗舰版企业/标准版企业的企业管理员有权限查询。\n> 仪表盘的QoS统计功能需要申请才能开通。请联系华为销售人员,并提供华为云会议企业ID。",
        "x-support-sdk": "Y",
        "x-apiexplorer-auth": false,
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-open-region-cloud": "hc",
        "x-order": 3,
        "deprecated": false,
        "consumes": [
          "application/json; charset=utf-8"
        ],
        "produces": [
          "application/json; charset=utf-8"
