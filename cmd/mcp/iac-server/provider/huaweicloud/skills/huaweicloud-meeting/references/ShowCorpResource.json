        ],
        "summary": "企业管理员查询企业内资源及业务权限",
        "description": "企业管理员通过该接口查询企业内资源及业务权限,包括查询已使用的资源情况。",
        "operationId": "ShowCorpResource",
        "x-apiexplorer-auth": false,
