  "definitions": {
    "QueryVmrPkgResResultDTO": {
      "description": "查询Vmr套餐包分配数量结果。",
      "properties": {
        "vmrPkgId": {
          "type": "string",
          "description": "云会议室套餐包id。",
          "example": "ff8080816dc93549016dcced90c00117"
        },
        "vmrName": {
          "type": "string",
          "description": "云会议室套餐包名称。",
          "example": "Ideahub 50方限时体验云会议室"
        },
        "vmrPkgParties": {
          "type": "integer",
          "description": "云会议室套餐方数。",
          "example": 100
        },
        "vmrPkgCount": {
          "type": "integer",
          "description": "该云会议室套餐分配的总数。",
          "example": 6
        },
        "vmrPkgUsedCount": {
          "type": "integer",
          "description": "该套餐对应的云会议室已分配数量。",
          "example": 1
        }
      }
    },
    "QueryCorpResDetailResultDTO": {
      "properties": {
        "te1080pHardCount": {
          "description": "1080P硬终端接入帐号数量。",
          "$ref": "#/definitions/ResDetailDTO"
        },
        "te720pHardCount": {
          "description": "720P硬终端接入帐号数量。",
          "$ref": "#/definitions/ResDetailDTO"
        },
        "teSoftCount": {
          "description": "软终端账户数量。",
          "$ref": "#/definitions/ResDetailDTO"
        },
        "roomCount": {
          "description": "电子白板(SmartRooms)接入帐号数量。",
          "$ref": "#/definitions/ResDetailDTO"
        },
        "recordCapability": {
          "description": "录播存储空间 (单位:G)。",
          "$ref": "#/definitions/ResDetailDTO"
        },
        "confCallCount": {
          "$ref": "#/definitions/ResDetailDTO",
          "description": "会议并发方数。"
        },
        "liveCount": {
          "description": "直播端口数量。",
          "$ref": "#/definitions/ResDetailDTO"
        },
        "thirdPartyHardCount": {
          "description": "第三方硬终端接入帐号数量。",
          "$ref": "#/definitions/ResDetailDTO"
        },
        "hwVisionCount": {
          "description": "智慧屏终端接入帐号数量。",
          "$ref": "#/definitions/ResDetailDTO"
        },
        "ideaHubCount": {
          "description": "IdeaHub终端接入帐号数量。",
          "$ref": "#/definitions/ResDetailDTO"
        },
        "vmr": {
          "type": "array",
          "description": "查询云会议室套餐包分配数量结果。",
          "items": {
            "$ref": "#/definitions/QueryVmrPkgResResultDTO"
          }
        },
        "enablePstn": {
          "description": "在创建企业的时候设置的pstn权限开关。",
          "type": "boolean"
        },
        "enableSMS": {
          "description": "企业是否通过短信形式发送会议通知。",
          "type": "boolean"
        },
        "enableHybridCloud": {
          "description": "企业是否开启混合云模式。",
          "type": "boolean"
        },
        "enableCloudDisk": {
          "description": "是否开启云盘。",
          "type": "boolean"
        },
        "enableUc": {
          "description": "是否开启UC功能。",
          "type": "boolean"
        },
        "enableAiMinutes": {
          "description": "是否开启Ai会议纪要。",
          "type": "boolean"
        },
        "singleConfCallCount": {
          "description": "单会议并发呼叫数。",
          "type": "integer"
        },
        "confLength": {
          "description": "会议时长。",
          "type": "integer"
        }
      }
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "description": "异常返回结果。",
      "required": [
        "error_code",
        "error_msg",
        "request_id"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。"
        }
      }
    },
    "ResDetailDTO": {
      "properties": {
        "sumCount": {
          "description": "总数。",
          "type": "integer",
          "example": 20
        },
        "trialCount": {
          "description": "赠送数量。",
          "type": "integer"
        },
        "expiredCount": {
          "description": "到期数量。",
          "type": "integer"
        },
        "expiringCount": {
          "description": "即将到期数量,到期时间在30天内。",
          "type": "integer"
        },
        "usedCount": {
          "description": "已使用数(录播存储空间、会议并发、推流并发方数暂无法查询)。",
          "type": "integer",
          "example": 5
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Request-ID": {
      "name": "X-Request-Id",
      "in": "header",
      "description": "请求requestId,用来标识一路请求,用于问题跟踪定位,建议使用UUID,若不携带,则后台自动生成。",
      "required": false,
      "type": "string",
      "x-example": "208b6e4c92074487bc43292f8554561e"
    },
    "Accept-Language": {
      "name": "Accept-Language",
      "in": "header",
      "description": "语言参数,默认为中文zh-CN,英文为en-US。",
      "required": false,
      "type": "string",
      "x-example": "zh-CN"
    },
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    }
  },
  "host": "api.meeting.huaweicloud.com",
  "base_path": "/",
