                "jitter": {
                  "receiving": 500,
                  "receivingDefault": 800,
                  "sending": 500,
                  "sendingDefault": 800
                },
                "packetLoss": {
                  "receiving": 20,
                  "receivingDefault": 50,
                  "sending": 20,
                  "sendingDefault": 50
                }
              }
