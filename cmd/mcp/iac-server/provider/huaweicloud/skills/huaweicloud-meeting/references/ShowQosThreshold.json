  "definitions": {
    "ThresholdData": {
      "description": "阈值查询结果结构体",
      "type": "object",
      "properties": {
        "receiving": {
          "type": "integer",
          "format": "int32",
          "description": "自定义接收方向阈值,单位为毫秒(ms)",
          "minimum": 0,
          "maximum": 10000,
          "example": 50
        },
        "receivingDefault": {
          "type": "integer",
          "format": "int32",
          "description": "默认接收方向阈值,单位为毫秒(ms)",
          "minimum": 0,
          "maximum": 10000,
          "example": 0
        },
        "sending": {
          "type": "integer",
          "format": "int32",
          "description": "自定义发送方向阈值,单位为毫秒(ms)",
          "minimum": 0,
          "maximum": 10000,
          "example": 50
        },
        "sendingDefault": {
          "type": "integer",
          "format": "int32",
          "description": "默认发送方向阈值,单位为毫秒(ms)",
          "minimum": 0,
          "maximum": 10000,
          "example": 0
        }
      },
      "title": "ThresholdData"
    },
    "ShowQosThresholdResult": {
      "description": "企业用户指定类型的阈值查询结果。",
      "type": "object",
      "x-annotations": "@com.fasterxml.jackson.annotation.JsonInclude(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_NULL)",
      "properties": {
        "latency": {
          "description": "* 延迟阈值信息,单位为毫秒(ms)\n* thresholdType = CPU时无效",
          "$ref": "#/definitions/ThresholdData"
        },
        "jitter": {
          "description": "* 抖动阈值信息,单位为毫秒(ms)\n* thresholdType = CPU时无效",
          "$ref": "#/definitions/ThresholdData"
        },
        "packetLoss": {
          "description": "* 丢包率阈值信息,单位为百分比(%)\n* thresholdType = CPU时无效",
          "$ref": "#/definitions/PacketThresholdData"
        },
        "clientCpuMax": {
          "description": "* 会议最大CPU阈值信息,单位为百分比(%)\n* 仅当thresholdType = CPU时有效",
          "$ref": "#/definitions/CPUThresholdData"
        },
        "systemCpuMax": {
          "description": "* 系统最大CPU阈值信息,单位为百分比(%)\n* 仅当thresholdType = CPU时有效",
          "$ref": "#/definitions/CPUThresholdData"
        }
      },
      "title": "ShowQosThresholdResult"
    },
    "RestFailedResult": {
      "description": "处理失败返回结果。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "结果码。"
        },
        "error_msg": {
          "type": "string",
          "description": "结果描述。"
        }
      }
    },
    "PacketThresholdData": {
      "description": "丢包率阈值查询结果结构体",
      "type": "object",
      "properties": {
        "receiving": {
          "type": "integer",
          "format": "int32",
          "description": "自定义接收方向阈值,单位为百分比(%)",
          "minimum": 0,
          "maximum": 100,
          "example": 50
        },
        "receivingDefault": {
          "type": "integer",
          "format": "int32",
          "description": "默认接收方向阈值,单位为百分比(%)",
          "minimum": 0,
          "maximum": 100,
          "example": 0
        },
        "sending": {
          "type": "integer",
          "format": "int32",
          "description": "自定义发送方向阈值,单位为百分比(%)",
          "minimum": 0,
          "maximum": 100,
          "example": 50
        },
        "sendingDefault": {
          "type": "integer",
          "format": "int32",
          "description": "默认发送方向阈值,单位为百分比(%)",
          "minimum": 0,
          "maximum": 100,
          "example": 0
        }
      },
      "title": "PacketThresholdData"
    },
    "CPUThresholdData": {
      "description": "CPU阈值查询结果结构体",
      "type": "object",
      "properties": {
        "cpu": {
          "type": "integer",
          "format": "int32",
          "description": "自定义的cpu阈值,单位为百分比(%)",
          "minimum": 0,
          "maximum": 100,
          "example": 50
        },
        "cpuDefault": {
          "type": "integer",
          "format": "int32",
          "description": "cpu阈值默认值,单位为百分比(%)",
          "minimum": 0,
          "maximum": 100,
          "example": 0
        }
      },
      "title": "CPUThresholdData"
    }
