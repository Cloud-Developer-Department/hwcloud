  "definitions": {
    "AuthProxyInfo": {
      "x-subPackage": "dto",
      "required": [
        "authServerType",
        "authType",
        "clientType"
      ],
      "properties": {
        "account": {
          "type": "string",
          "description": "认证帐号。",
          "maxLength": 255,
          "minLength": 0,
          "example": "01alki06nq413uiaxy60bd3t3sotout1yg2l156axiw4bxg84ako6u9bwvxxv4u5"
        },
        "authServerType": {
          "type": "string",
          "description": "鉴权服务类型。\n* workplace:WeLink代理鉴权\n* oauth2:OAuth2.0鉴权",
          "maxLength": 255,
          "minLength": 1,
          "example": "workplace"
        },
        "authType": {
          "type": "string",
          "description": "鉴权类型。\n* AccountAndPwd:Welink代理鉴权\n* AuthCode:OAuth2.0鉴权",
          "maxLength": 255,
          "minLength": 1,
          "example": "AccountAndPwd"
        },
        "clientType": {
          "type": "integer",
          "description": "登录帐号类型。\n* 72:API调用类型",
          "example": 5
        },
        "createTokenType": {
          "type": "integer",
          "description": "是否生成Token。 默认0。\n* 0:生成,用于登录鉴权;\n* 1:不生成。",
          "default": 0,
          "example": 1
        },
        "pwd": {
          "format": "password",
          "type": "string",
          "description": "认证密码。Welink代理鉴权时需要填写。",
          "maxLength": 255,
          "minLength": 0,
          "example": "Qdjtufjwr4$4"
        },
        "credential": {
          "type": "string",
          "description": "OAuth2.0时填从鉴权中心获取的临时Code。",
          "maxLength": 2048,
          "minLength": 0,
          "example": "b609c27b4a5a440ab1ee5b1b77fcd0bb"
        },
        "domain": {
          "type": "string",
          "description": "企业域名。OAuth2.0鉴权时需要填写。",
          "maxLength": 255,
          "minLength": 0,
          "example": "huawei.com"
        },
        "remark": {
          "type": "string",
          "description": "备注信息。",
          "maxLength": 255,
          "minLength": 0,
          "example": "xxxx"
        }
      }
    },
    "ProxyTokenDTO": {
      "x-subPackage": "dto",
      "description": "代理鉴权信息。",
      "required": [
        "accessToken"
      ],
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "代理鉴权服务器的短token字符串。"
        },
        "longAccessToken": {
          "type": "string",
          "description": "代理鉴权服务器的长token字符串。"
        },
        "validPeriod": {
          "type": "integer",
          "format": "int64",
          "description": "Token有效时长,单位:秒。"
        },
        "middleEndUrl": {
          "type": "string",
          "description": "中台地址。"
        },
        "middleEndInnerUrl": {
          "type": "string",
          "description": "中台内网地址。"
        },
        "enableRerouting": {
          "type": "boolean",
          "description": "是否开启二次路由。"
        }
      }
    },
    "TokenDTO": {
      "x-subPackage": "dto",
      "required": [
        "user",
        "accessToken",
        "validPeriod",
        "expireTime",
        "tokenIp",
        "clientType"
      ],
      "description": "鉴权请求信息。",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "Access Token字符串。",
          "example": "stb8cyTJFlVdaeCIWXXXX...."
        },
        "tokenIp": {
          "type": "string",
          "description": "用户IP。",
          "example": "10.8.0.90"
        },
        "validPeriod": {
          "type": "integer",
          "format": "int64",
          "description": "Access Token有效时长,单位:秒。",
          "example": 82188
        },
        "expireTime": {
          "type": "integer",
          "format": "int64",
          "description": "Access Token的失效时间戳,单位:秒。",
          "example": 1577858014
        },
        "createTime": {
          "type": "integer",
          "format": "int64",
          "description": "Access Token的创建时间戳,单位:毫秒。"
        },
        "user": {
          "$ref": "#/definitions/UserInfo"
        },
        "clientType": {
          "type": "integer",
          "description": "登录帐号类型。\n* 72:API调用类型",
          "example": 72
        },
        "forceLoginInd": {
          "type": "integer",
          "description": "抢占登录标识。\n* 0: 非抢占\n* 1: 抢占",
          "example": null
        },
        "firstLogin": {
          "type": "boolean",
          "description": "是否首次登录。\n> 首次登录表示尚未修改过密码。首次登录时,系统会提醒用户需要修改密码。\n默认值:false。",
          "default": false,
          "example": true
        },
        "pwdExpired": {
          "type": "boolean",
          "description": "密码是否过期,默认值:false。",
          "default": false,
          "example": false
        },
        "daysPwdAvailable": {
          "type": "integer",
          "description": "密码有效天数。",
          "example": -18171
        },
        "proxyToken": {
          "$ref": "#/definitions/ProxyTokenDTO"
        },
        "delayDelete": {
          "type": "boolean",
          "description": "是否延时删除状态。",
          "default": false
        },
        "tokenType": {
          "type": "integer",
          "description": "Token类型。\n* 0:用户Access Token\n* 1:会控TOKEN\n* 2:一次性TOKEN"
        },
        "refreshToken": {
          "type": "string",
          "description": "Refresh Token字符串。"
        },
        "refreshValidPeriod": {
          "type": "integer",
          "format": "int64",
          "description": "Refresh Token有效时长,单位:秒。"
        },
        "refreshExpireTime": {
          "type": "integer",
          "format": "int64",
          "description": "Refresh Token的失效时间戳,单位:秒。"
        },
        "refreshCreateTime": {
          "type": "integer",
          "format": "int64",
          "description": "Refresh Token的创建时间戳,单位:毫秒。"
        }
      }
    },
    "UserInfo": {
      "x-subPackage": "dto",
      "x-imports": "com.fasterxml.jackson.annotation.JsonIgnore",
      "required": [
        "ucloginAccount"
      ],
      "description": "用户鉴权信息。",
      "properties": {
        "userId": {
          "type": "string",
          "description": "用户UUID。",
          "example": "689ead28d0a2409985b8f85a167b78fc"
        },
        "ucloginAccount": {
          "type": "string",
          "description": "华为云会议帐号。",
          "example": "p-53df7b90d6a3410fa75f82e08bfd9181"
        },
        "serviceAccount": {
          "type": "string",
          "description": "用户关联的SIP号码。",
          "example": "sip:+99111210334849378@huaweicloud.com"
        },
        "numberHA1": {
          "type": "string",
          "description": "号码对应的HA1。",
          "example": "1ead5e5ce44849bc2718d5cb479c890f"
        },
        "alias1": {
          "type": "string",
          "description": "用户别名。",
          "example": null
        },
        "companyId": {
          "type": "string",
          "description": "用户归属的企业ID。",
          "example": "c71e568704104ceb89717789692372fa"
        },
        "spId": {
          "type": "string",
          "description": "用户所在企业归属的SP ID。",
          "example": "acf9324477ef47a79bb691ee57496513"
        },
        "companyDomain": {
          "type": "string",
          "description": "企业域名。",
          "example": null
