        },
        "grayUser": {
          "type": "boolean",
          "description": "标识是否是灰度用户。"
        }
      }
    },
    "ReturnCodeDTO": {
      "x-subPackage": "discard",
      "description": "错误码。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "USG.206010000"
        },
        "error_msg": {
          "type": "string",
