        },
        "freeUser": {
          "type": "boolean",
          "description": "标识是否是免费试用用户。"
        },
        "thirdAccount": {
          "type": "string",
          "description": "第三方的用户帐号。",
          "maxLength": 255,
          "minLength": 0
        },
        "visionAccount": {
          "type": "string",
          "description": "智慧屏设备ID。",
          "maxLength": 255,
          "minLength": 0
        },
        "headPictureUrl": {
          "type": "string",
          "description": "头像链接。",
          "maxLength": 255,
          "minLength": 0
        },
        "password": {
          "type": "string",
          "description": "机机密码,用于智慧屏登录。",
          "maxLength": 255,
          "minLength": 0
        },
        "status": {
          "type": "integer",
          "description": "用户状态。\n* 0:正常\n* 1:停用",
          "maximum": 7,
          "minimum": 0
        },
        "paidAccount": {
          "type": "string",
          "description": "付费用户机机帐号,用于智慧屏登录。",
          "maxLength": 255,
          "minLength": 0
        },
        "paidPassword": {
          "type": "string",
          "description": "付费用户机机密码,用于智慧屏登录。",
          "maxLength": 255,
          "minLength": 0
        },
        "weLinkUser": {
          "type": "boolean",
          "description": "标识是否是WeLink用户。"
        },
        "appId": {
          "type": "string",
          "description": "应用ID。"
        },
        "tr069Account": {
          "type": "string",
          "description": "tr069帐号。"
        },
        "corpType": {
          "type": "integer",
          "description": "企业类型。\n* 0:旗舰版\n* 5:免费版\n* 6:标准版"
        },
        "cloudUserId": {
          "type": "string",
