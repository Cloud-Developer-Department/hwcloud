          "x-annotations": [
            "@JsonIgnore"
          ],
          "example": "huawei.com"
        },
        "userType": {
          "type": "integer",
          "description": "用户类型。\n* 1:SP管理用户\n* 2:企业用户\n* 3:免费注册用户\n* 10:企业设备用户\n* 11:匿名用户\n* 12:智慧屏用户\n* 13:IdeaHub用户\n* 14:电子白板(SmartRooms)用户",
          "example": 2
        },
        "adminType": {
          "type": "integer",
          "description": "管理员类型。\n* 0:默认管理员\n* 1:普通管理员\n* 2:非管理员,即普通企业成员,userType为2时有效",
          "example": 2
        },
        "name": {
          "type": "string",
          "description": "用户名称。",
          "example": "张三"
        },
        "nameEn": {
          "type": "string",
          "description": "用户英文名称。",
          "example": "zhangsan"
        },
        "isBindPhone": {
          "type": "boolean",
