          "@ResponseMaskRule(type = Type.JSON, rules = {@Rule(path = \"tokenIp\", masker = IpMasker.class), @Rule(path = \"accessToken\", masker = TokenMasker.class), @Rule(path = \"user.numberHA1\", masker = PasswordMasker.class)})"
