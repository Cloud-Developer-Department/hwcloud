{
  "name": "SetInterpreterGroup",
  "summary": "设置传译组",
  "tags": "会议控制",
  "productshort": "Meeting",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/mmc/control/conferences/interpreterGroup": {
      "put": {
        "tags": [
          "会议控制"
        ],
        "summary": "设置传译组",
        "description": "主持人通过该接口设置传译组,每个传译组支持两种语言,传译组内支持多个传译员。",
        "operationId": "SetInterpreterGroup",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-open-region-cloud": "hc",
        "x-order": 40,
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "conferenceID",
            "in": "query",
            "description": "会议ID。",
            "required": true,
            "type": "string",
            "x-example": "914067448"
          },
          {
            "name": "X-Conference-Authorization",
            "in": "header",
            "description": "会控Token,通过[获取会控token](https://support.huaweicloud.com/api-meeting/meeting_21_0027.html)接口获得。",
            "required": true,
            "format": "password",
            "type": "string",
            "x-example": "stb0442ae70a6e527de968a97be293bdc5a20a952fcc833bf17"
          },
          {
            "in": "body",
            "name": "restSetInterpreterGroupBody",
            "description": "设置传译组请求。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RestSetInterpreterGroupBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。"
          },
          "400": {
            "description": "参数异常。",
            "examples": {
              "application/json": {
                "error_code": "MMC.111072065",
                "error_msg": "CONF_NOT_FOUND_OR_AUTH_FAILED"
              }
            },
            "schema": {
              "$ref": "#/definitions/RestFailedRsp"
            }
          }
        },
        "deprecated": false,
        "x-name": "开启同声传译",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "PUT https://{endpoint}/v1/mmc/control/conferences/interpreterGroup?conferenceID=914370850"
      }
    }
  },
  "definitions": {
    "InterpreterGroupInfo": {
      "type": "object",
      "description": "传译组信息",
      "required": [
        "groupID",
        "firstLanguage",
        "secondLanguage"
      ],
      "properties": {
        "groupID": {
          "type": "string",
          "description": "传译组序号。"
        },
        "groupName": {
          "type": "string",
          "description": "传译组名称。"
        },
        "groupType": {
          "description": "传译组类型,MANUAL:人工传译,AI:AI传译。默认MANUAL。",
          "type": "string"
        },
        "firstLanguage": {
          "type": "string",
          "description": "传译组支持的第一种语言。"
        },
        "secondLanguage": {
          "type": "string",
          "description": "传译组支持的第二种语言。"
        },
        "interpreters": {
          "type": "array",
          "description": "传译员列表。",
          "items": {
            "$ref": "#/definitions/InterpreterInfo"
          }
        }
      }
    },
    "InterpreterAiDigitalInfo": {
      "type": "object",
      "description": "传译员AI数字资产信息",
      "properties": {
        "type": {
          "description": "数字资产类型:PUBLIC(系统公共)、PRIVATE(企业专用账号绑定)、LOCAL(企业本地通用)。",
          "type": "string"
        },
        "digitalAccount": {
          "description": "AI传译员场景下绑定使用的数字资产ID(数字人或TTS音色)。",
          "type": "string"
        },
        "digitalName": {
          "description": "数字资产名称。",
          "type": "string"
        },
        "presenterAccount": {
          "description": "专用数字资产绑定的发言人登录账号,翻译对象非匿名必填。",
          "type": "string"
        },
        "presenterRealNameAccount": {
          "description": "专用数字资产绑定的发言人登录账号(匿名时),翻译对象匿名必填。",
          "type": "string"
        },
        "presenterName": {
          "description": "专用数字资产绑定的发言人名称。",
          "type": "string"
        },
        "presenterUserID": {
          "description": "发言人用户的userUUID。",
          "type": "string"
        },
        "localConfId": {
          "description": "本地会议的会议id(第三方对接参数),数字资产为LOCAL时必填。",
          "type": "string"
        },
        "localConfAddr": {
          "description": "本地会议对接地址或域名。",
          "type": "string"
        },
        "localAuthInfo": {
          "description": "本地会议对接鉴权信息。",
          "type": "string"
        },
        "localNeedProxy": {
          "description": "true:需要代理 false:不需要代理。",
          "type": "boolean"
        },
        "localAuthUrl": {
          "description": "本地会议获取动态鉴权信息Url。",
          "type": "string"
        },
        "localAuthAppId": {
          "description": "本地会议鉴权AppId。",
          "type": "string"
        }
      }
    },
    "RestFailedRsp": {
      "description": "错误码信息。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "MMC.111072065"
        },
        "error_msg": {
          "type": "string",
          "description": "错误码描述。",
          "example": "CONF_NOT_FOUND_OR_AUTH_FAILED"
        }
      }
    },
    "InterpreterInfo": {
      "type": "object",
      "description": "传译员信息",
      "required": [
        "loginAccount"
      ],
      "properties": {
        "loginAccount": {
          "type": "string",
          "description": "用户登录账号,可以是账号、手机、邮箱其中一个,loginAccount和userID必须二选一。"
        },
        "userID": {
          "type": "string",
          "description": "用户的userUUID。"
        },
        "callNumber": {
          "type": "string",
          "description": "呼叫号码。"
        },
        "name": {
          "type": "string",
          "description": "用户名。"
        },
        "interpreterId": {
          "description": "传译员序号,AI传译组下传译员唯一标识。",
          "type": "string"
        },
        "interpreterType": {
          "description": "传译员类型,MANUAL:人工传译,AI:AI传译。默认MANUAL。",
          "type": "string"
        },
        "aiDigitalInfo": {
          "description": "AI传译员场景下使用的数字资产信息。",
          "$ref": "#/definitions/InterpreterAiDigitalInfo"
        }
      }
    },
    "RestSetInterpreterGroupBody": {
      "type": "object",
      "description": "设置传译组请求体",
      "required": [
        "interpreterGroups"
      ],
      "properties": {
        "interpreterGroups": {
          "type": "array",
          "description": "传译组列表信息",
          "items": {
            "$ref": "#/definitions/InterpreterGroupInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "api.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}