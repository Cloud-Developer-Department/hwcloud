  "definitions": {
    "VerifyCodeSendDTOV1": {
      "x-subPackage": "dto",
      "required": [
        "user"
      ],
      "properties": {
        "user": {
          "type": "string",
          "description": "用户身份信息(手机号码或邮箱帐号或用户真实帐号)。\n> 必须和发送滑块验证码时带的用户身份信息相同。",
          "maxLength": 255,
          "minLength": 1,
          "example": "6pn5sq2cd02l828pk01wwy1i"
        },
        "sendMethod": {
          "type": "string",
          "description": "验证码发送方式。\nuser类型是用户真实帐号时必选;如果没有选择的话,优先短信方式。\n* sms:短信方式\n* email:邮件方式",
          "maxLength": 64,
          "minLength": 0,
          "example": "sms"
        },
        "token": {
          "type": "string",
          "description": "访问Token字符串。通过[校验滑块验证码](https://support.huaweicloud.com/api-meeting/meeting_21_0101.html) 接口获取。",
          "maxLength": 255,
          "minLength": 0,
          "example": "pI9JTTD9pQZrd6WUskqxAjvnS0FWKqAlL"
        }
      }
    },
    "VerifyCodeSendResultDTO": {
      "x-subPackage": "dto",
      "properties": {
        "expire": {
          "type": "integer",
          "description": "过期时间,单位:秒。",
          "example": 180
        },
        "bindPhone": {
          "type": "string",
          "description": "如果通过手机发送验证码,则该字段携带该用户绑定的手机号(手机号经过处理,屏蔽中间几位,如+8618****12345)。",
          "example": "+8618****12345"
        },
        "bindEmail": {
          "type": "string",
          "description": "如果通过邮箱发送验证码,则该字段携带用户绑定的邮箱帐号(邮箱帐号经过处理,屏蔽中间几位,如tes****ount@huawei.com)。",
          "example": "tes****ount@huawei.com"
        }
      }
    },
    "ReturnCodeDTO": {
      "x-subPackage": "discard",
      "description": "错误码。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "example": "USG.206010000"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "example": "User name or password is incorrect"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。",
          "example": "9655664f10724b398187598a1d5097c3"
        }
      }
    }
  },
