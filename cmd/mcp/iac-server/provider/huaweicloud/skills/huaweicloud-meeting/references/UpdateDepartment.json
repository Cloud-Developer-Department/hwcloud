{
  "name": "UpdateDepartment",
  "summary": "修改部门",
  "tags": "企业部门管理",
  "productshort": "Meeting",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/usg/dcs/corp/dept/{dept_code}": {
      "put": {
        "tags": [
          "企业部门管理"
        ],
        "summary": "修改部门",
        "description": "企业管理员通过该接口修改部门。",
        "operationId": "UpdateDepartment",
        "x-apiexplorer-auth": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-order": 2,
        "parameters": [
          {
            "$ref": "#/parameters/X-Access-Token"
          },
          {
            "$ref": "#/parameters/X-Request-ID"
          },
          {
            "$ref": "#/parameters/Accept-Language"
          },
          {
            "name": "dept_code",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "部门编码。\n长度: 0-32位。",
            "x-minLength": 1,
            "x-example": "deptcode123456"
          },
          {
            "name": "deptDTO",
            "in": "body",
            "required": true,
            "description": "修改部门请求。",
            "schema": {
              "$ref": "#/definitions/ModDeptDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。"
          },
          "403": {
            "description": "权限受限。",
            "examples": {
              "application/json": {
                "request_id": "208b6e4c92074487bc43292f8554561e",
                "error_code": "USG.000000004",
                "error_msg": "Illegal request"
              }
            },
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "400": {
            "description": "参数异常。",
            "examples": {
              "application/json": {
                "request_id": "208b6e4c92074487bc43292f8554561e",
                "error_code": "USG.201030001",
                "error_msg": "同级部门名称已存在"
              }
            },
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          }
        },
        "x-request-examples-url-1": "PUT https://{endpoint}/v1/usg/dcs/corp/dept/deptcode123456",
        "x-request-examples-1": {
          "deptName": "综合管理部-修改",
          "parentDeptCode": "1",
          "note": "负责公司XX, XX等业务",
          "inPermission": "UNLIMITED",
          "outPermission": "UNLIMITED",
          "sortLevel": 10000
        }
      }
    }
  },
  "definitions": {
    "ModDeptDTO": {
      "properties": {
        "deptName": {
          "type": "string",
          "description": "部门名称。",
          "maxLength": 128,
          "minLength": 1,
          "example": "综合管理部"
        },
        "parentDeptCode": {
          "type": "string",
          "description": "父部门编码。",
          "maxLength": 32,
          "default": "1",
          "example": "1"
        },
        "note": {
          "type": "string",
          "description": "备注。",
          "maxLength": 96,
          "minLength": 0,
          "example": "负责公司XX, XX等业务"
        },
        "inPermission": {
          "type": "string",
          "description": "其他用户对该部门下用户的访问权限:\n- UNLIMITED:默认,不做限制\n- OPEN:公开,其他部门都可访问(无论对方权限如何配置)\n- CLOSE:隐藏,其他部门不可访问(暂未实现)\n- DESIGNATED_DEPARTMENT:指定部门能访问(暂未实现)",
          "enum": [
            "UNLIMITED",
            "OPEN",
            "CLOSE",
            "DESIGNATED_DEPARTMENT"
          ],
          "example": "UNLIMITED"
        },
        "outPermission": {
          "type": "string",
          "description": "该部门下用户访问权限控制。\n- UNLIMITED:不限制\n- ONLY_SELF:仅能查询自己\n- SELF_AND_CHILD_DEPARTMENT:该部门下用户能查询本部门及子部门通讯\n- DESIGNATED_DEPARTMENT:该部门下用户能查询指定部门通讯录",
          "enum": [
            "UNLIMITED",
            "ONLY_SELF",
            "SELF_AND_CHILD_DEPARTMENT",
            "DESIGNATED_DEPARTMENT"
          ],
          "example": "UNLIMITED"
        },
        "designatedOutDeptCodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "允许访问的部门列表,仅outPermission为DESIGNATED_DEPARTMENT时有效,最多支持配置150个部门。",
          "example": "[\"i6A\",\"KR7\"]"
        },
        "sortLevel": {
          "type": "integer",
          "format": "int32",
          "maximum": 10000,
          "minimum": 1,
          "description": "部门排序号,序号越小,部门排序越靠前。",
          "example": 10000
        }
      }
    },
    "AbnormalResultDTO": {
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.usg.datacenter.model.discard.*",
      "description": "异常返回结果。",
      "required": [
        "error_code",
        "error_msg",
        "request_id"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Request-ID": {
      "name": "X-Request-Id",
      "in": "header",
      "description": "请求requestId,用来标识一路请求,用于问题跟踪定位,建议使用UUID,若不携带,则后台自动生成。",
      "required": false,
      "type": "string",
      "x-example": "208b6e4c92074487bc43292f8554561e"
    },
    "Accept-Language": {
      "name": "Accept-Language",
      "in": "header",
      "description": "语言参数,默认为中文zh-CN,英文为en-US。",
      "required": false,
      "type": "string",
      "x-example": "zh-CN"
    },
    "X-Access-Token": {
      "name": "X-Access-Token",
      "in": "header",
      "description": "Access Token。通过[执行App ID鉴权](https://support.huaweicloud.com/api-meeting/meeting_21_0311.html) 接口返回的accessToken。",
      "required": true,
      "format": "password",
      "type": "string",
      "x-example": "stb42Kw30IPpsIRm3DhsE0ym7B2tdAHcwfyY"
    }
  },
  "host": "api-intl.meeting.huaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}