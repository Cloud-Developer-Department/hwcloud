{
  "name": "ExecuteChatCompletion",
  "summary": "对话问答",
  "tags": "Completions",
  "productshort": "PanguLargeModels",
  "region_id": "cn-southwest-2",
  "paths": {
    "/v2/{project_id}/pools/{pool_id}/deployments/{deployment_id}/chat/completions": {
      "post": {
        "description": "基于对话问答功能,用户可以与模型进行自然而流畅的对话和交流。",
        "summary": "对话问答",
        "tags": [
          "Completions"
        ],
        "operationId": "ExecuteChatCompletion",
        "x-publishpath": "",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc",
        "x-apiexplorer-hide": "N",
        "x-is-registered": "Y",
        "deprecated": false,
        "x-name": "多轮对话",
        "x-constraint": "",
        "x-scope": "Commercial",
        "x-order": 1,
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "https://{endpoint}/v2/{project_id}/pools/{pool_id}/deployments/{deployment_id}/chat/completions",
        "x-request-examples-1": {
          "messages": [
            {
              "content": "hello"
            },
            {
              "content": "Hello! How can I assist you today?"
            }
          ],
          "max_tokens": 50,
          "n": 1
        },
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "maxLength": 15000,
            "minLength": 1,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-is-registered": "N"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "发送的实体的MIME类型。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "x-example": "application/json"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "required": true,
            "description": "项目ID",
            "maxLength": 255,
            "minLength": 1,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "in": "path",
            "name": "pool_id",
            "type": "string",
            "required": true,
            "description": "资源池ID",
            "maxLength": 255,
            "minLength": 1,
            "x-example": "3279cbd8-xxxx-xxxx-xxxx-d6031a54085f"
          },
          {
            "in": "path",
            "name": "deployment_id",
            "type": "string",
            "required": true,
            "description": "模型的部署ID",
            "maxLength": 255,
            "minLength": 1,
            "x-example": "12928884-xxxx-xxxx-xxxx-b745b2rf"
          },
          {
            "in": "body",
            "name": "ExecuteTextCompletionRequestBody",
            "description": "通用文本请求",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ChatCompletionReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "接口响应成功。",
            "schema": {
              "$ref": "#/definitions/ChatCompletionResp"
            },
            "examples": {
              "application/json": {
                "id": "8efcd203-4cd9-4452-923f-00439205c6cb",
                "created": 1696759072,
                "choices": [
                  {
                    "index": 0,
                    "message": {
                      "role": null,
                      "content": "My name is AI Assistant. How can I help you today?"
                    }
                  }
                ],
                "usage": {
                  "completion_tokens": 9,
                  "prompt_tokens": 3,
                  "total_tokens": 12
                }
              }
            }
          },
          "401": {
            "description": "鉴权失败。"
          },
          "403": {
            "description": "没有操作权限。"
          },
          "404": {
            "description": "找不到资源。"
          },
          "500": {
            "description": "服务内部错误。"
          }
        }
      }
    }
  },
  "definitions": {
    "ChatChoice": {
      "description": "通用文本响应",
      "properties": {
        "index": {
          "type": "integer",
          "description": "回复的索引"
        },
        "message": {
          "type": "array",
          "$ref": "#/definitions/MessageItem",
          "description": "模型响应"
        }
      },
      "required": [
        "index",
        "message"
      ]
    },
    "ChatCompletionReq": {
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Message"
          },
          "description": "多轮对话问答对",
          "minItems": 1,
          "maxItems": 20
        },
        "user": {
          "type": "string",
          "description": "用于代表客户的唯一标识符,最小长度:1,最大长度64",
          "minLength": 1,
          "maxLength": 64
        },
        "stream": {
          "type": "boolean",
          "description": "流式调用的开启开关,true为开启流式调用,如果要开启流式调用,请使用流式SDK;false为关闭流式调用。默认为关闭状态(当前API Explorer不支持流式,在API Explorer调试时请使用非流式)。"
        },
        "temperature": {
          "type": "number",
          "format": "float",
          "description": "用于控制生成文本的多样性和创造力。参数的取值范围是0到1,其中0表示最低的随机性。一般来说,temperature越低,适合完成确定性的任务。temperature越高,例如0.9,适合完成创造性的任务。temperature参数可以影响语言模型输出的质量和多样性,但也不是唯一的因素。还有其他一些参数,如top_p参数也可以用来调整语言模型的行为和偏好,但不建议同时更改这两个参数。",
          "example": 1,
          "minimum": 0,
          "maximum": 1
        },
        "top_p": {
          "type": "number",
          "format": "float",
          "description": "一种替代温度采样的方法,称为nucleus sampling,取值范围:(0, 1],其中模型考虑具有top_p 概率质量的标记的结果。因此 0.1 意味着只考虑构成前 10% 概率质量的标记。我们通常建议更改此值或温度,但不要同时更改两者。通常建议更改top_p或temperature来调整生成文本的倾向性,但不要同时更改这两个参数。",
          "minimum": 0,
          "exclusiveMinimum": true,
          "maximum": 1
        },
        "max_tokens": {
          "type": "integer",
          "format": "int32",
          "description": "用于控制聊天回复的长度和质量。一般来说,较大的max_tokens值可以生成较长和较完整的回复,但也可能增加生成无关或重复内容的风险。较小的max_tokens值可以生成较短和较简洁的回复,但也可能导致生成不完整或不连贯的内容。因此,需要根据不同的场景和需求来选择合适的max_tokens值。最小值:1,最大值:根据模型不同最大值不同。",
          "example": 16,
          "minimum": 1
        },
        "n": {
          "type": "integer",
          "format": "int32",
          "description": "表示对每个问题生成多少条答案。n参数的默认值是1,表示只生成一个答案。如果想要生成多条答案,可以设置n参数为一个大于1的整数,例如n=2。这样,API会返回一个包含2个答案的数组。流式调用时,n只能取1。最小值:1,最大值:2,默认值:1",
          "default": 1,
          "example": 1,
          "minimum": 1,
          "maximum": 2
        },
        "presence_penalty": {
          "type": "number",
          "format": "float",
          "description": "用于控制生成文本中的重复程度。正值会根据它们到目前为止在文本中的现有频率来惩罚新tokens,从而降低模型逐字重复同一行的可能性。  presence_penalty 参数可以用来提高生成文本的多样性和创造性,避免生成单调或重复的内容。最小值:-2,最大值:2",
          "example": 0,
          "minimum": -2,
          "maximum": 2
        },
        "frequency_penalty": {
          "type": "number",
          "format": "float",
          "description": "用于调整模型对频繁出现的Token的处理方式。即如果一个Token在训练集中出现的频率较高,那么模型在生成这个Token时会受到一定的惩罚。当frequency_penalty的值为正数时,模型会更倾向于生成出现频率较低的Token,即模型会更倾向于使用不常见的词汇。最小值:-2,最大值:2",
          "example": 0,
          "minimum": -2,
          "maximum": 2
        }
      },
      "required": [
        "messages"
      ]
    },
    "CompletionUsage": {
      "description": "tokens统计对象",
      "properties": {
        "completion_tokens": {
          "type": "number",
          "format": "int32",
          "description": "表示模型生成的答案中包含的tokens的数量。"
        },
        "prompt_tokens": {
          "type": "number",
          "format": "int32",
          "description": "表示生成结果时使用的提示文本的tokens的数量。"
        },
        "total_tokens": {
          "type": "number",
          "format": "int32",
          "description": "对话过程中使用的tokens总数。"
        }
      },
      "required": [
        "prompt_tokens",
        "total_tokens",
        "completion_tokens"
      ]
    },
    "Message": {
      "type": "object",
      "required": [
        "content"
      ],
      "properties": {
        "role": {
          "type": "string",
          "description": "角色",
          "minLength": 1,
          "maxLength": 64
        },
        "content": {
          "type": "string",
          "description": "问答对文本内容,最小长度:1,最大长度:模型支持的max_tokens数量乘以系数,默认系数为1.5,并且所有content的总长度不能超过该最大长度",
          "minLength": 1
        }
      }
    },
    "ChatCompletionResp": {
      "description": "多轮对话响应体",
      "properties": {
        "id": {
          "type": "string",
          "description": "响应ID"
        },
        "created": {
          "type": "integer",
          "description": "响应时间"
        },
        "choices": {
          "type": "array",
          "description": "模型回复",
          "items": {
            "$ref": "#/definitions/ChatChoice"
          }
        },
        "usage": {
          "description": "tokens数量统计对象",
          "$ref": "#/definitions/CompletionUsage"
        }
      },
      "required": [
        "id",
        "created",
        "choices",
        "usage"
      ]
    },
    "MessageItem": {
      "description": "多轮对话响应对象",
      "properties": {
        "role": {
          "type": "string",
          "description": "角色"
        },
        "content": {
          "type": "string",
          "description": "模型响应"
        }
      },
      "required": [
        "content"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "pangu.cn-southwest-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}