  "definitions": {
    "Datastore": {
      "description": "cdm信息",
      "properties": {
        "type": {
          "description": "类型,一般为cdm。",
          "type": "string"
        },
        "version": {
          "description": "集群版本。",
          "type": "string"
        }
      },
      "example": {
        "version": "2.9.1.200",
        "type": "cdm"
      }
    },
    "ExtendedProperties": {
      "description": "集群扩展信息",
      "properties": {
        "workSpaceId": {
          "description": "工作空间ID。",
          "type": "string"
        },
        "resourceId": {
          "description": "资源ID。",
          "type": "string"
        },
        "trial": {
          "description": "是否是试用集群。",
          "type": "string"
        }
      },
      "example": {
        "workSpaceId": "7567534786684995b70734cf7aef9a5e",
        "resourceId": "41324ff8ae741679d47c9a3f6delf3f",
        "trial": "false"
      }
    },
    "sys_tags": {
      "properties": {
        "value": {
          "description": "企业项目ID",
          "type": "string",
          "example": "1ce45885-4033-40d2-bdde-d4dbaceb387d"
        },
        "key": {
          "description": "该值目前固定为“_sys_enterprise_project_id”",
          "type": "string",
          "example": "_sys_enterprise_project_id"
        }
      },
      "required": [
        "value",
        "key"
      ]
    },
    "instance": {
      "properties": {
        "availability_zone": {
          "description": "集群的可用分区",
          "type": "string",
          "example": "cn-north-1b"
        },
        "nics": {
          "description": "网卡列表,最多两个网卡。请参见•nics参数说明",
          "type": "array",
          "items": {
            "$ref": "#/definitions/nics"
          }
        },
        "flavorRef": {
          "description": "实例规格:\n- a79fd5ae-1833-448a-88e8-3ea2b913e1f6:表示cdm.small规格,2核CPU、4G内存的虚拟机。适合PoC验证和开发测试。\n- fb8fe666-6734-4b11-bc6c-43d11db3c745:表示cdm.medium规格,4核CPU、8G内存的虚拟机适合单张表规模<1000万条的场景。\n- 5ddb1071-c5d7-40e0-a874-8a032e81a697:表示cdm.large规格,8核CPU、16G内存的虚拟机。适合单张表规模≥1000万条的场景。\n- 6ddb1072-c5d7-40e0-a874-8a032e81a698:表示cdm.xlarge规格,16核CPU、32G内存的虚拟机。需要10GE高速带宽进行TB以上的数据量迁移时使用",
          "type": "string",
          "example": "a79fd5ae-1833-448a-88e8-3ea2b913e1f6"
        },
        "type": {
          "description": "节点类型,当前只有“cdm”一种类型",
          "type": "string",
          "example": "cdm"
        }
      },
      "required": [
        "flavorRef",
        "nics",
        "availability_zone",
        "type"
      ]
    },
    "CdmCreateClusterReq": {
      "properties": {
        "cluster": {
          "description": "集群对象,请参见cluster参数说明",
          "type": "object",
          "properties": {
            "scheduleBootTime": {
              "description": "定时开机的时间,CDM集群会在每天这个时间开机",
              "type": "string",
              "example": ""
            },
            "isScheduleBootOff": {
              "description": "选择是否启用定时开关机功能。定时开关机功能和自动关机功能不可同时开启",
              "type": "boolean",
              "example": false
            },
            "instances": {
              "description": "节点列表,请参见instances参数说明",
              "type": "array",
              "items": {
                "$ref": "#/definitions/instance"
              }
            },
            "datastore": {
              "description": "集群信息,请参见•datastore参数说明",
              "type": "object",
              "$ref": "#/definitions/Datastore"
            },
            "extended_properties": {
              "description": "扩展属性,请参见•extended_properties参数说明",
              "type": "object",
              "$ref": "#/definitions/ExtendedProperties"
            },
            "scheduleOffTime": {
              "description": "定时关机的时间,定时关机时系统不会等待未完成的作业执行完成",
              "type": "string",
              "example": ""
            },
            "vpcId": {
              "description": "指定虚拟私有云ID,用于集群网络配置",
              "type": "string",
              "example": "67c06084-2212-4242-bcd4-d2144c2385a9"
            },
            "name": {
              "description": "集群名称",
              "type": "string",
              "example": "cdm-ab82"
            },
            "sys_tags": {
              "description": "企业项目信息,请参见•sys_tags参数说明",
              "type": "array",
              "items": {
                "$ref": "#/definitions/sys_tags"
              }
            },
            "isAutoOff": {
              "description": "选择是否启用自动关机功能,自动关机功能和定时开关机功能不可同时开启。如果选择自动关机,则当集群中无作业运行且无定时作业时,等待15分钟后集群将自动关机来帮您节约成本",
              "type": "boolean",
              "example": false
            }
          },
          "required": [
            "name",
            "vpcId"
          ]
        },
        "auto_remind": {
          "description": "选择是否开启消息通知。开启后,支持配置5个手机号码或邮箱,作业(目前仅支持表/文件迁移的作业)失败时、EIP异常时会发送短信或邮件通知用户",
          "type": "boolean",
          "example": false
        },
        "phone_num": {
          "description": "接收消息通知的手机号码",
          "type": "string",
          "example": "138xxxx8888"
        },
        "email": {
          "description": "接收消息通知的邮箱",
          "type": "string",
          "example": "123@huawei.com"
        }
      },
      "required": [
        "cluster"
      ]
    },
    "CdmCreateClusterRepsonse": {
      "properties": {
        "name": {
          "description": "集群名称",
          "type": "string",
          "example": "cdm-ab82"
        },
        "id": {
          "description": "集群ID",
          "type": "string",
          "example": "7d85f602-a948-4a30-afd4-e84f47471c15"
        },
        "task": {
          "description": "任务信息",
          "type": "object",
          "$ref": "#/definitions/Task"
        },
        "datastore": {
          "description": "集群信息",
          "type": "object",
          "$ref": "#/definitions/Datastore"
        },
        "instances": {
          "description": "集群的节点信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClusterInstance"
          }
        }
      }
    },
    "ClusterInstance": {
      "description": "集群的节点信息",
      "properties": {
        "id": {
          "description": "节点的虚拟机ID。",
          "type": "string"
        },
        "name": {
          "description": "节点的虚拟机名称。",
          "type": "string"
        },
        "type": {
          "description": "节点类型,只支持一种类型“cdm”。",
          "type": "string"
        },
        "shard_id": {
          "description": "分片ID",
          "type": "string"
        }
      }
    },
    "nics": {
      "properties": {
        "securityGroupId": {
          "description": "安全组ID",
          "type": "string",
          "example": "c37852d2-2d12-41cb-af47-65c80e995c80"
        },
        "net-id": {
          "description": "子网ID",
          "type": "string",
          "example": "2d120298-6130-44d4-a438-454912fff901"
        }
      },
      "required": [
        "net-id",
        "securityGroupId"
      ]
    },
    "Task": {
      "description": "任务信息",
      "properties": {
        "id": {
          "description": "任务id",
          "type": "string"
        },
        "name": {
          "description": "任务名称",
          "type": "string"
        }
      }
    }
  },
