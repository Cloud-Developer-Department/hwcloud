  "definitions": {
    "CdmRestartClusterReq": {
      "properties": {
        "restart": {
          "description": "集群重启操作,定义哪些集群节点需要重启,请参见restart参数说明",
          "type": "object",
          "properties": {
            "restartDelayTime": {
              "description": "重启时延,单位:秒",
              "type": "integer",
              "format": "int32",
              "example": 0
            },
            "restartMode": {
              "description": "重启类型:\n- IMMEDIATELY:立即重启。\n- FORCELY:强制重启。\n- SOFTLY:一般重启。\n\n默认值为“IMMEDIATELY”。强制重启业务进程会中断,并重启集群的虚拟机。",
              "type": "string",
              "example": "IMMEDIATELY"
            },
            "restartLevel": {
              "description": "重启级别:\n- SERVICE:重启服务。\n- VM:重启虚拟机。\n\n默认值为“SERVICE”。",
              "type": "string",
              "example": "SERVICE"
            },
            "type": {
              "description": "集群节点类型,只支持“cdm”",
              "type": "string",
              "example": "cdm"
            },
            "instance": {
              "description": "预留字段,“restartLevel” 为“SERVICE”时,“instance”必填,填空字串。",
              "type": "string",
              "default": "",
              "example": "\"\""
            },
            "group": {
              "description": "预留字段,“restartLevel” 为“SERVICE”时,“group”必填,填空字串。",
              "type": "string",
              "default": "",
              "example": "\"\""
            }
          },
          "required": [
            "type"
          ]
        }
      },
