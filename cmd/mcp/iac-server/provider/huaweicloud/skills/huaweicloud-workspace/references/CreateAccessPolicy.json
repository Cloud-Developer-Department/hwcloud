  "definitions": {
    "AccessPolicyInfo": {
      "properties": {
        "policy_name": {
          "type": "string",
          "description": "策略名。",
          "minLength": 0,
          "maxLength": 50
        },
        "blacklist_type": {
          "type": "string",
          "example": "INTERNET",
          "description": "黑名单类型,当前黑名单只支持互联网。\n* INTERNET: 互联网",
          "minLength": 0,
          "maxLength": 50,
          "enum": [
            "INTERNET"
          ]
        },
        "access_control_type": {
          "type": "string",
          "example": "ACCESS_TYPE",
          "description": "访问控制类型。默认为接入类型\n* ACCESS_TYPE: 接入类型\n* IP_WHITE_LIST: IP白名单",
          "enum": [
            "ACCESS_TYPE",
            "IP_WHITE_LIST"
          ]
        },
        "ip_list": {
          "type": "array",
          "description": "策略的ip列表。",
          "items": {
            "$ref": "#/definitions/IpInfo"
          },
          "maxItems": 10000,
          "minItems": 0,
          "x-maxLength": 10000,
          "x-minLength": 0
        },
        "is_enable": {
          "type": "boolean",
          "description": "IP白名单是否生效。只能单独更新,此值的优先级最高,传此值只修改该策略是否生效。",
          "default": false
        },
        "is_block_all": {
          "type": "boolean",
          "description": "IP白名单是否禁止所有Ip接入。is_enable为false时,无法修改此值。此值也只能单独更新。",
          "default": false
        },
        "ip_total_count": {
          "type": "integer",
          "description": "策略总数。",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "AccessPolicyObjectInfo": {
      "required": [
        "object_id",
        "object_type"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "description": "黑名单中的对象id。",
          "minLength": 0,
          "maxLength": 255
        },
        "object_type": {
          "type": "string",
          "example": "USER",
          "description": "对象类型。\n* USER: 用户\n* USERGROUP: 用户组",
          "enum": [
            "USER",
            "USERGROUP"
          ]
        },
        "object_name": {
          "type": "string",
          "description": "对象名。后续此参数不会校验。",
          "minLength": 0,
          "maxLength": 255,
          "x-isSensitive": true
        }
