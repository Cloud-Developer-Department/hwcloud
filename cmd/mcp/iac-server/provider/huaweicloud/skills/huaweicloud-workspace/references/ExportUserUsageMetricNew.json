{
  "name": "ExportUserUsageMetricNew",
  "summary": "导出用户使用统计数据",
  "tags": "报表统计",
  "productshort": "Workspace",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/statistics/metrics/users/export": {
      "get": {
        "tags": [
          "StatisticsV3"
        ],
        "summary": "导出用户使用统计数据",
        "description": "导出用户使用统计信息;\n最多导出30天内的数据;",
        "operationId": "ExportUserUsageMetricNew",
        "parameters": [
          {
            "name": "start_time",
            "in": "query",
            "description": "查询起始时间(0时区)。",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "x-example": "1970-01-01T00:00:00Z"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "查询截止时间(0时区)。",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "x-example": "1970-01-01T01:00:00Z"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
            "x-annotations": [
              "@Size(max = 255, min = 1)"
            ]
          },
          {
            "name": "username",
            "in": "query",
            "description": "用户名(模糊匹配)。",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "x-example": "xxx"
          },
          {
            "name": "usage_min_hours",
            "in": "query",
            "description": "使用时长最小值。",
            "required": false,
            "type": "integer",
            "maximum": 2147483646,
            "minimum": 0,
            "x-example": "0"
          },
          {
            "name": "usage_max_hours",
            "in": "query",
            "description": "使用时长最大值\nusage_min_hours和usage_max_hours同时存在时,usage_max_hours必须大于等于usage_min_hours",
            "required": false,
            "type": "integer",
            "maximum": 2147483646,
            "minimum": 0,
            "x-example": "0"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目ID。",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "x-example": "xxxxxxxxxx"
          },
          {
            "name": "sort_field",
            "in": "query",
            "description": "按照指标进行排序\n* `user_usage` -  按照用户使用时长排序",
            "required": false,
            "type": "string",
            "pattern": "(user_usage)",
            "x-example": "user_usage"
          },
          {
            "name": "sort_type",
            "in": "query",
            "description": "按照指标进行排序的方向;需配合sort_field起义使用\n* `DESC` - 降序返回数据\n* `ASC` -  升序返回数据",
            "required": false,
            "type": "string",
            "default": "DESC",
            "pattern": "(ASC|DESC)",
            "x-example": "DESC"
          }
        ],
        "responses": {
          "200": {
            "description": "导出任务id。",
            "schema": {
              "$ref": "#/definitions/ExportTaskRsp"
            }
          },
          "400": {
            "description": "客户端请求有误。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-apig-version": "v3",
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-apig-group": "internal_token,public",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-methodAnnotations": [
          "@EnableAuth",
          "@IamAuthMeta(authLevel = IamAuthLevel.PROJECT, abacAction = \"workspace:statistics:exportUserMetrics\", authContextInitializerName = \"workspaceCommonAuthContextInitializer\", needApigwJwtAuthCheck = false, rbac = {\"te_admin\", \"wks_adm\"})",
          "@CtsMeta(serviceType = \"Workspace\", resourceType = \"workspace\", traceName = \"ExportDesktopStatisticMetricV3\")"
        ]
      }
    }
