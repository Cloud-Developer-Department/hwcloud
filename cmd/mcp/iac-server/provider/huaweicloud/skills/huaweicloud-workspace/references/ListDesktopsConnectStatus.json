        },
        "x-request-examples-url-1": "GET /v2/0bec5db98280d2d02fd6c00c2de791ce/connect-desktops",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-support-hcs": "Y",
        "x-apigateway-request-type": "public",
        "x-apiexplorer-hide": "N",
