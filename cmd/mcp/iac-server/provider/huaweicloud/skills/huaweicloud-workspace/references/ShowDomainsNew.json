  "definitions": {
    "DomainController": {
      "required": [
        "dc_ip",
        "dc_name"
      ],
      "properties": {
        "dc_ip": {
          "type": "string",
          "description": "域控制器IP地址。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "dc_name": {
          "type": "string",
          "description": "域控制器名称。",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "description": "域控制器信息。"
    },
    "UosDomainInfo": {
      "properties": {
        "auth_config_id": {
          "type": "string",
          "description": "认证配置id。",
          "readOnly": true
        },
        "id": {
          "type": "string",
          "example": "c711a46xxxxxxx7cf6da8800",
          "description": "域控id。",
          "readOnly": true
        },
        "type": {
          "description": "对接协议类型。",
          "readOnly": true,
          "$ref": "#/definitions/DomainType"
        },
        "domain_name": {
          "type": "string",
          "example": "UOS",
          "description": "统信域控名称。",
          "readOnly": true
        },
        "username": {
          "type": "string",
          "example": "admin",
          "description": "域管理员。",
          "readOnly": true,
          "x-anonymous": true
        },
        "main_dc_address": {
          "type": "string",
          "example": "https://127.0.0.1:4433",
          "description": "域管平台地址。",
          "readOnly": true
        },
        "open_interface_address": {
          "type": "string",
          "example": "https://127.0.0.1:4434",
          "description": "域管开放接口地址。",
          "readOnly": true
        },
        "open_interface_domain_name": {
          "type": "string",
          "example": "udcp-openapi.uniontech.com",
          "description": "域管开放接口域名。",
          "readOnly": true
        },
        "internal_service_address": {
          "type": "string",
          "example": "https://127.0.0.1:4435",
          "description": "域管内部服务地址。",
          "readOnly": true
        },
        "app_cert_id": {
          "type": "string",
          "example": "c711a46xxxxxxx7cf6da8800",
          "description": "客户端证书公钥id。",
          "readOnly": true
        },
        "app_cert_start_time": {
          "type": "string",
          "example": "2011-12-03T10:15:30",
          "description": "客户端证书公钥有效期起始时间。",
          "readOnly": true
        },
        "app_cert_end_time": {
          "type": "string",
          "example": "2012-12-03T10:15:30",
          "description": "客户端证书公钥有效期结束时间。",
          "readOnly": true
        },
        "openapi_ca_cert_id": {
          "type": "string",
          "example": "c711a46xxxxxxx7cf6da8800",
          "description": "服务端CA id。",
          "readOnly": true
        },
        "openapi_ca_cert_start_time": {
          "type": "string",
          "example": "2011-12-03T10:15:30",
          "description": "服务端CA有效期起始时间。",
          "readOnly": true
        },
        "openapi_ca_cert_end_time": {
          "type": "string",
          "example": "2012-12-03T10:15:30",
          "description": "服务端CA有效期结束时间。",
          "readOnly": true
        }
      },
      "description": "查询域控的配置信息响应。"
    },
    "AdDomain": {
      "required": [
        "domain_type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "域id。"
        },
        "domain_type": {
          "type": "string",
          "description": "域类型。\n- LITE_AS:本地认证。\n- LOCAL_AD:本地AD。\n说明:域类型为“LOCAL_AD”时,请确保所选VPC网络与AD所属网络可连通。",
          "minLength": 1,
          "maxLength": 55,
          "enum": [
            "LITE_AS",
            "LOCAL_AD"
          ]
        },
        "domain_name": {
          "type": "string",
          "description": "域名称。域类型为LOCAL_AD时需要配置。\n域名必须为AD服务器上已经存在的域名,且长度不超过55。",
          "minLength": 1,
          "maxLength": 55
        },
        "domain_admin_account": {
          "type": "string",
          "description": "域管理员账号。域类型为LOCAL_AD时需要配置。\n必须为AD服务器上已经存在的域管理员账号。",
          "minLength": 1,
          "maxLength": 55
        },
        "domain_password": {
          "type": "string",
          "description": "域管理员账号密码。域类型为LOCAL_AD时需要配置。",
          "minLength": 1,
          "maxLength": 255,
          "x-isSensitive": true
        },
        "active_domain_ip": {
          "type": "string",
          "description": "主域控制器IP地址。域类型为LOCAL_AD时需要配置。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "active_domain_name": {
          "type": "string",
          "description": "主域控制器名称。域类型为LOCAL_AD时需要配置。",
          "minLength": 1,
          "maxLength": 55
        },
        "standby_domain_ip": {
          "type": "string",
          "description": "备域控制器IP地址。域类型为LOCAL_AD时且配置备节点时需要配置。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "standby_domain_name": {
          "type": "string",
          "description": "备域控制器名称。域类型为LOCAL_AD时且配置备节点时需要配置。",
          "minLength": 0,
          "maxLength": 55
        },
        "active_dns_ip": {
          "type": "string",
          "description": "主DNS IP地址。域类型为LOCAL_AD时需要配置。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "standby_dns_ip": {
          "type": "string",
          "description": "备DNS IP地址。域类型为LOCAL_AD时且配置备节点时需要配置。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "delete_computer_object": {
          "type": "integer",
          "format": "int32",
          "description": "是否在删除桌面的同时删除AD上对应的计算机对象,0代表不删除,1代表删除。",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "use_ldaps": {
          "type": "boolean",
          "description": "是否开启LDAPS。",
          "default": false,
          "x-hcs-ignore": true
        },
        "tls_config": {
          "$ref": "#/definitions/TlsConfig"
        },
        "cba_enabled": {
          "type": "boolean",
          "description": "是否开启智能卡认证。"
        },
        "certificate_id": {
          "type": "string",
          "description": "智能卡证书id。",
          "minLength": 0,
          "maxLength": 255
        },
        "domain_controllers": {
          "type": "array",
          "description": "域控制器信息列表。有值时,active_domain_name、active_domain_ip、standby_domain_name、standby_domain_ip无效。",
          "items": {
            "$ref": "#/definitions/DomainController"
          },
          "maxItems": 1000,
          "minItems": 0,
          "x-maxLength": 1000,
          "x-minLength": 0
        }
      },
      "description": "域信息。"
    },
    "ShowDomainsNewRsp": {
      "properties": {
        "uos_domain_list": {
          "type": "array",
          "description": "统信域控列表。",
          "readOnly": true,
          "items": {
            "$ref": "#/definitions/UosDomainInfo"
          }
        },
        "domain_infos": {
          "type": "array",
          "description": "域信息。",
          "readOnly": true,
          "items": {
            "$ref": "#/definitions/AdDomain"
          },
          "maxItems": 100,
          "minItems": 0
        }
      },
      "description": "查询域控的配置信息响应。"
    },
    "BaseResponse": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 12
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 0,
          "maxLength": 1000
        },
        "error_detail": {
          "type": "string",
          "description": "错误详情。",
          "minLength": 0,
          "maxLength": 1000
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "加密后的详细拒绝原因,用户可以自行调用STS服务的decode-authorization-message接口进行解密。",
          "readOnly": true
        }
      },
      "description": "API响应基类。"
    },
    "DomainType": {
      "type": "string",
      "description": "域类型\nKERBEROS:对接AD\nOPEN_API:使用OPEN_API的方式对接统信域控",
      "enum": [
        "KERBEROS",
        "OPEN_API"
      ]
    },
    "TlsConfig": {
      "properties": {
        "cert_pem": {
          "type": "string",
          "description": "pem内容, 有则更新,无则上传。查询不返回。",
          "minLength": 0,
          "maxLength": 8192
        },
        "cert_start_time": {
          "type": "string",
          "description": "证书生效开始时间,时间参考样例 2022-01-25T09:24:27。",
          "minLength": 0,
          "maxLength": 255
        },
        "cert_end_time": {
          "type": "string",
          "description": "证书生效截止时间,时间参考样例 2022-01-25T09:24:27。",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "description": "TLS信息。"
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。",
      "required": true,
