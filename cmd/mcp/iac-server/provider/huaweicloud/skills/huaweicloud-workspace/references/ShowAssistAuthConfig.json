        "object_type": {
          "type": "string",
          "description": "绑定对象类型枚举。\n- USER:用户\n- USER_GROUP:用户组\n- ALL: 全部用户",
          "enum": [
            "USER",
            "USER_GROUP",
            "ALL"
          ]
        },
        "object_id": {
          "type": "string",
          "description": "用户/用户组id。",
          "minLength": 1,
          "maxLength": 255
        },
        "object_name": {
          "type": "string",
          "description": "用户/用户组名称。",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "description": "辅助认证策略应用的用户/用户组信息。"
    },
    "QueryAssistAuthMethodRsp": {
      "properties": {
