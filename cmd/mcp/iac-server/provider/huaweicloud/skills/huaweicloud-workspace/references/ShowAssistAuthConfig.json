          "maxLength": 255
        },
        "rule": {
          "type": "string",
          "description": "认证应用对象。\n- INTERNET:互联网接入,rule_type为ACCESS_MODE时可选该值\n- PRIVATE:专线接入,rule_type为ACCESS_MODE时可选该值",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "description": "认证应用对象信息,为null时代表对所有应用对象生效。"
    },
    "ReceiveModeEnum": {
      "type": "string",
      "description": "验证码接收模式\nVMFA:虚拟MFA设备\nHMFA:硬件MFA设备",
      "enum": [
        "VMFA",
        "HMFA"
      ]
    },
    "AuthServerAccessMode": {
      "type": "string",
      "description": "辅助认证服务接入模式\nINTERNET:互联网接入\nDEDICATED:专线接入\nSYSTEM_DEFAULT:系统默认",
      "enum": [
        "INTERNET",
        "DEDICATED",
        "SYSTEM_DEFAULT"
      ]
    },
