{
  "name": "AddMetricNotifyRule",
  "summary": "新增通知规则",
  "tags": "报表统计",
  "productshort": "Workspace",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/statistics/notify-rules": {
      "post": {
        "tags": [
          "Statistics"
        ],
        "summary": "新增通知规则",
        "description": "新增对应指标的通知规则;对应指标满足相应的规则条件时发送通知\n同一指标的规则不允许重复;\n统计指标名称,目前仅支持固定值:desktop_idle_duration\n  * `desktop_idle_duration` -  桌面空闲时长, 仅允许设置 '>=' 阈值\n注:需先为云服务添加委托授权,否则无法正常发送通知到SMN",
        "operationId": "AddMetricNotifyRule",
        "consumes": [
          "application/json;charset=UTF-8"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "in": "body",
            "name": "AddMetricNotifyRuleRequestBody",
            "description": "设置通知规则。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AddMetricNotifyRuleReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "响应成功。",
            "examples": {
              "application/json": {
                "rule_id": "xxxx-xxxx-xxxx",
                "metric_name": "desktop_idle_duration",
                "threshold": 30,
                "comparison_operator": "",
                "interval": 1,
                "enable": true,
                "notify_object": "urn:smn:REGION_ID:XXX-XXX-XXX:topicName"
              }
            },
            "schema": {
              "$ref": "#/definitions/MetricNotifyRule"
            }
          },
          "400": {
            "description": "客户端请求有误。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-request-examples-text-1": {
          "metric_name": "desktop_idle_duration",
          "threshold": 30,
          "comparison_operator": ">=",
          "interval": 1,
          "enable": true,
          "notify_object": "urn:smn:REGION_ID:XXX-XXX-XXX:topicName"
        },
        "x-request-examples-1": {
          "metric_name": "desktop_idle_duration",
          "threshold": 30,
          "comparison_operator": ">=",
          "interval": 1,
          "enable": true,
          "notify_object": "urn:smn:REGION_ID:XXX-XXX-XXX:topicName"
        },
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-apig-group": "internal_token,public",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-methodAnnotations": [
          "@EnableAuth",
          "@IamAuthMeta(authLevel = IamAuthLevel.PROJECT, abacAction = \"workspace:statistics:createNotifyRules\", authContextInitializerName = \"workspaceCommonAuthContextInitializer\", needApigwJwtAuthCheck = false, rbac = {\"te_admin\", \"wks_adm\"})",
          "@CtsMeta(serviceType = \"Workspace\", resourceType = \"workspace\", traceName = \"AddMetricNotifyRule\")"
        ]
      }
    }
  },
  "definitions": {
    "MetricNotifyRule": {
      "properties": {
        "rule_id": {
          "type": "string",
          "example": "xxxx-xxxx-xxxx",
          "description": "规则ID。",
          "readOnly": true
        },
        "metric_name": {
          "type": "string",
          "example": "desktop_idle_duration",
          "description": "统计指标名称,目前仅支持固定值:desktop_idle_duration\n* `desktop_idle_duration` -  桌面空闲时长",
          "readOnly": true
        },
        "threshold": {
          "type": "integer",
          "example": 30,
          "description": "统计持续周期(天)。",
          "readOnly": true
        },
        "comparison_operator": {
          "type": "string",
          "example": "",
          "description": "统计指标对应的统计值和threshold进行比较的条件\n* `>=` -  统计指标大于等于threshold时触发\n* `>` -   统计指标大于threshold时触发\n* `=` -  统计指标等于threshold时触发\n* `<=` -  统计指标小于等于threshold时触发\n* `<` -  统计指标小于threshold时触发",
          "readOnly": true
        },
        "interval": {
          "type": "integer",
          "example": 1,
          "description": "触发通知后;下次通知的间隔时间;默认每天一次",
          "readOnly": true
        },
        "enable": {
          "type": "boolean",
          "example": true,
          "description": "启禁用规则 true:启用 false:禁用。",
          "readOnly": true,
          "default": false
        },
        "notify_object": {
          "type": "string",
          "example": "urn:smn:REGION_ID:XXX-XXX-XXX:topicName",
          "description": "通知对象;smn的主题urn。",
          "readOnly": true
        }
      },
      "description": "指标通知规则。"
    },
    "AddMetricNotifyRuleReq": {
      "required": [
        "comparison_operator",
        "enable",
        "metric_name",
        "notify_object",
        "period"
      ],
      "properties": {
        "metric_name": {
          "type": "string",
          "example": "desktop_idle_duration",
          "description": "统计指标名称,目前仅支持固定值:desktop_idle_duration\n同一指标的规则不允许重复\n* `desktop_idle_duration` -  桌面空闲时长, 仅允许设置 '>=' threshold",
          "minLength": 1,
          "maxLength": 128
        },
        "threshold": {
          "type": "integer",
          "example": 30,
          "description": "规则配置-阈值(天)。",
          "minimum": 1,
          "maximum": 30
        },
        "comparison_operator": {
          "type": "string",
          "example": ">=",
          "description": "统计指标对应的统计值和threshold进行比较的条件\n* `>=` -  统计指标大于等于threshold时触发\n* `>` -   统计指标大于threshold时触发\n* `=` -  统计指标等于threshold时触发\n* `<=` -  统计指标小于等于threshold时触发\n* `<` -  统计指标小于threshold时触发",
          "pattern": "^(\\>\\=|\\>|\\=|\\<\\=|\\<)$"
        },
        "interval": {
          "type": "integer",
          "example": 1,
          "description": "触发通知后;下次通知的间隔时间;默认每天一次",
          "minimum": 1,
          "maximum": 30
        },
        "enable": {
          "type": "boolean",
          "example": true,
          "description": "启禁用规则 true:启用 false:禁用。",
          "default": false
        },
        "notify_object": {
          "type": "string",
          "example": "urn:smn:REGION_ID:XXX-XXX-XXX:topicName",
          "description": "通知对象;smn的主题urn。",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "description": "设置通知规则。"
    },
    "ErrorRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误对象。"
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。",
      "required": true,
      "type": "string",
      "maxLength": 255,
      "minLength": 1,
      "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
      "x-annotations": [
        "@Size(max = 255, min = 1)"
      ]
    }
  },
  "host": "workspace.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "post",
  "uri": null
}