{
  "name": "ListAlarms",
  "summary": "查询告警列表",
  "tags": "告警",
  "productshort": "Workspace",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/alarms": {
      "get": {
        "tags": [
          "Alarms"
        ],
        "summary": "查询告警列表",
        "description": "从ces查询告警列表。",
        "operationId": "ListAlarms",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "level",
            "in": "query",
            "description": "告警级别 | 1 - 紧急 2 - 重要 3 - 次要 4 - 提示。",
            "required": false,
            "type": "integer",
            "maximum": 4,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页偏移量。",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 2147483646,
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "分页大小,默认100。",
            "required": false,
            "type": "integer",
            "default": 100,
            "maximum": 100,
            "minimum": 1,
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "响应成功。",
            "examples": {
              "application/json": {
                "alarm_histories": [
                  {
                    "record_id": "string",
                    "alarm_id": "al1603131199286dzxpqK3Ez",
                    "name": "alarm-test01",
                    "status": "alarm",
                    "type": "EVENT.SYS",
                    "level": 1,
                    "begin_time": 231025,
                    "metric": {
                      "namespace": "SYS.IES",
                      "metric_name": "cpu_util",
                      "dimensions": [
                        {
                          "name": "instance_id",
                          "value": "4270ff17-aba3-4138-89fa-820594c39755"
                        }
                      ]
                    },
                    "condition": {
                      "period": 1,
                      "filter": "average",
                      "comparison_operator": "",
                      "value": 0,
                      "unit": "percent",
                      "count": 10,
                      "suppress_duration": 300
                    },
                    "additional_info": {
                      "resource_id": "22d98f6c-16d2-4c2d-b424-50e79d82838f",
                      "resource_name": "ECS-Test01",
                      "event_id": "ev16031292300990kKN8p17J"
                    },
                    "data_points": [
                      {
                        "time": "string",
                        "value": 7.019
                      }
                    ]
                  }
                ],
                "count": 0
              }
            },
            "schema": {
              "$ref": "#/definitions/ListAlarmsRsp"
            }
          },
          "400": {
            "description": "客户端请求有误。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-apig-group": "internal_token,public",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-imports": [
          "com.huawei.clouds.wushan.auth.token.IamAuthMeta",
          "com.huawei.clouds.wushan.auth.token.IamAuthLevel",
          "com.huawei.clouds.wushan.integration.common.auth.EnableAuth",
          "com.huawei.clouds.wushan.cts.meta.CtsMeta"
        ],
        "x-methodAnnotations": [
          "@EnableAuth",
          "@IamAuthMeta(authLevel = IamAuthLevel.PROJECT, abacAction = \"workspace:statistics:listAlarm\", authContextInitializerName = \"workspaceCommonAuthContextInitializer\", needApigwJwtAuthCheck = false, rbac = {\"te_admin\", \"wks_adm\"})",
          "@CtsMeta(serviceType = \"Workspace\", resourceType = \"workspace\", traceName = \"ListAlarms\")"
        ]
      }
    }
  },
  "definitions": {
    "ListAlarmsRsp": {
      "properties": {
        "alarm_histories": {
          "type": "array",
          "description": "alarmHistories列表。",
          "readOnly": true,
          "items": {
            "$ref": "#/definitions/AlarmHistoryItem"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "告警记录列表总数。",
          "readOnly": true
        }
      },
      "description": "查询告警列表响应体。"
    },
    "AlarmHistoryItem": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "description": "告警记录。",
          "readOnly": true
        },
        "alarm_id": {
          "type": "string",
          "example": "al1603131199286dzxpqK3Ez",
          "description": "告警规则ID。",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "example": "alarm-test01",
          "description": "告警规则的名称。",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "example": "alarm",
          "description": "告警记录的状态,取值为ok,alarm,invalid; ok为正常,alarm为告警,invalid为已失效。",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "example": "EVENT.SYS",
          "description": "告警规则类型 | ALL_INSTANCE为全部资源指标告警, RESOURCE_GROUP为资源分组指标告警, MULTI_INSTANCE为指定资源指标告警, EVENT.SYS为系统事件告警, EVENT.CUSTOM自定义事件告警, DNSHealthCheck为健康检查告警。",
          "readOnly": true
        },
        "level": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "告警记录的告警级别,值为1,2,3,4;1为紧急,2为重要,3为次要,4为提示。",
          "readOnly": true
        },
        "begin_time": {
          "type": "string",
          "example": "231025",
          "description": "产生时间,UTC时间。",
          "readOnly": true
        },
        "metric": {
          "$ref": "#/definitions/AlarmMetric"
        },
        "condition": {
          "$ref": "#/definitions/AlarmCondition"
        },
        "additional_info": {
          "$ref": "#/definitions/AdditionalInfo"
        },
        "data_points": {
          "type": "array",
          "description": "计算出该条告警记录的资源监控数据上报时间和监控数值。",
          "readOnly": true,
          "items": {
            "$ref": "#/definitions/DataPointInfo"
          }
        }
      }
    },
    "AlarmCondition": {
      "type": "object",
      "properties": {
        "period": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "指标周期,单位是秒; 0是默认值,例如事件类告警该字段就用0即可; 1代表指标的原始周期,比如RDS监控指标原始周期是60s,表示该RDS指标按60s周期为一个数据点参与告警计算;",
          "readOnly": true
        },
        "filter": {
          "type": "string",
          "example": "average",
          "description": "聚合方式, 支持的值为(average|min|max|sum)。",
          "readOnly": true
        },
        "comparison_operator": {
          "type": "string",
          "example": "",
          "description": "阈值符号,支持的值为(>|<|>=|<=|=|!=|cycle_decrease|cycle_increase|cycle_wave);cycle_decrease为环比下降,cycle_increase为环比上升,cycle_wave为环比波动。",
          "readOnly": true
        },
        "value": {
          "type": "number",
          "format": "double",
          "example": 0.0,
          "description": "告警阈值。",
          "readOnly": true
        },
        "unit": {
          "type": "string",
          "example": "percent",
          "description": "数据的单位,最大长度为32位。",
          "readOnly": true
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 10,
          "description": "次数。",
          "readOnly": true
        },
        "suppress_duration": {
          "type": "integer",
          "example": 300,
          "description": "告警抑制时间,单位为秒,对应页面上创建告警规则时告警策略最后一个字段,该字段主要为解决告警频繁的问题,0代表不抑制,满足条件即告警;300代表满足告警触发条件后每5分钟告警一次。",
          "readOnly": true
        }
      },
      "description": "告警触发条件。"
    },
    "AlarmMetric": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "example": "SYS.IES",
          "description": "查询服务的命名空间。",
          "readOnly": true
        },
        "metric_name": {
          "type": "string",
          "example": "cpu_util",
          "description": "资源的监控指标名称。",
          "readOnly": true
        },
        "dimensions": {
          "type": "array",
          "description": "指标维度,目前最大可添加4个维度。",
          "readOnly": true,
          "items": {
            "$ref": "#/definitions/AlarmMetricDimension"
          }
        }
      },
      "description": "告警指标信息。"
    },
    "AdditionalInfo": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string",
          "example": "22d98f6c-16d2-4c2d-b424-50e79d82838f",
          "description": "该条告警记录对应的资源ID。",
          "readOnly": true
        },
        "resource_name": {
          "type": "string",
          "example": "ECS-Test01",
          "description": "该条告警记录对应的资源名称。",
          "readOnly": true
        },
        "event_id": {
          "type": "string",
          "example": "ev16031292300990kKN8p17J",
          "description": "该条告警记录对应的事件监控ID,资源所产生的事件。",
          "readOnly": true
        }
      },
      "description": "告警记录额外字段,仅针对事件监控告警场景所产生的告警记录信息。"
    },
    "DataPointInfo": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "description": "计算出该条告警记录的资源监控数据上报的UTC时间。",
          "readOnly": true
        },
        "value": {
          "type": "number",
          "format": "double",
          "example": 7.019,
          "description": "计算出该条告警记录的资源监控数据在该时间点的监控数值。",
          "readOnly": true
        }
      },
      "description": "该条告警记录的资源监控数据上报时间和监控数值。"
    },
    "AlarmMetricDimension": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "instance_id",
          "description": "资源维度。",
          "readOnly": true
        },
        "value": {
          "type": "string",
          "example": "4270ff17-aba3-4138-89fa-820594c39755",
          "description": "资源维度值。",
          "readOnly": true
        }
      },
      "description": "指标维度,目前最大可添加4个维度。"
    },
    "ErrorRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误对象。"
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。",
      "required": true,
      "type": "string",
      "maxLength": 255,
      "minLength": 1,
      "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
      "x-annotations": [
        "@Size(max = 255, min = 1)"
      ]
    }
  },
  "host": "workspace.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}