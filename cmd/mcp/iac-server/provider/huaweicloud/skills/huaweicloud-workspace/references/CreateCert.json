          "com.huawei.clouds.wushan.cts.meta.CtsMeta"
        ],
        "x-methodAnnotations": [
          "@EnableAuth",
          "@IamAuthMeta(authLevel = IamAuthLevel.PROJECT, abacAction = \"workspace:ca:create\", authContextInitializerName = \"workspaceCommonAuthContextInitializer\", needApigwJwtAuthCheck = false, needRbacCheck = false)",
          "@CtsMeta(serviceType = \"Workspace\", resourceType = \"workspace\", traceName = \"createCertificate\")"
