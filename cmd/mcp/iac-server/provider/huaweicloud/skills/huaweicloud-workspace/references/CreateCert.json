  },
  "definitions": {
    "DistinguishedName": {
      "required": [
        "common_name",
        "country",
        "locality",
        "organization",
        "organizational_unit",
        "state"
      ],
      "properties": {
        "common_name": {
          "type": "string",
          "example": "api_test",
          "description": "ca名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "country": {
          "type": "string",
          "example": "CN",
          "description": "国家/地区。",
          "minLength": 2,
          "maxLength": 4
        },
        "state": {
          "type": "string",
          "example": "GuangDong",
          "description": "省份/州。",
          "minLength": 1,
          "maxLength": 128
        },
        "locality": {
          "type": "string",
          "example": "DongGuan",
          "description": "城市。",
          "minLength": 1,
          "maxLength": 128
        },
        "organization": {
          "type": "string",
          "example": "Huawei",
          "description": "公司名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "organizational_unit": {
          "type": "string",
          "example": "Workspace",
          "description": "部门名称。",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "description": "证书DN。"
    },
    "CreateCertificateReq": {
      "required": [
        "crl_configuration",
        "distinguished_name",
        "key_algorithm",
        "signature_algorithm",
        "validity"
      ],
      "properties": {
        "distinguished_name": {
          "$ref": "#/definitions/DistinguishedName"
        },
        "key_algorithm": {
          "type": "string",
          "example": "RSA-3072",
          "description": "密钥对生成算法 RSA-2048 RSA-3072。",
          "minLength": 1,
          "maxLength": 16
        },
        "signature_algorithm": {
          "type": "string",
          "example": "SHA-256",
          "description": "签名哈希算法 SHA-256 SHA-512。",
          "minLength": 1,
          "maxLength": 16
        },
        "validity": {
          "$ref": "#/definitions/CertValidityData"
        },
        "crl_configuration": {
          "$ref": "#/definitions/CrlConfigurationData"
        }
      },
      "description": "创建证书请求体。"
    },
    "CrlConfigurationData": {
      "required": [
        "enable",
        "type",
        "valid_day"
      ],
      "properties": {
        "enable": {
          "type": "boolean",
          "example": true,
          "description": "是否开启crl配置。"
        },
        "type": {
          "type": "string",
          "example": "SYSTEM",
          "description": "系统生成SYSTEM, 用户自定义CUSTOMIZE。",
          "enum": [
            "SYSTEM",
            "CUSTOMIZE"
          ]
        },
        "crl_url": {
          "type": "string",
          "example": "ldap:///CN=hcfactory-AD01-HCFACTORY-CA,CN=AD01-hcfactory,CN=CDP,CN=Public%20Key%20Services,CN=Services,CN=Configuration,DC=hcfactory,DC=huawei,DC=com?certificateRevocationList?base?objectClass=cRLDistributionPoint",
          "description": "当用户自定义时手动输入。",
          "minLength": 0,
          "maxLength": 256
        },
        "valid_day": {
          "type": "integer",
          "example": 3650,
          "description": "更新周期。",
          "minimum": 3650,
          "maximum": 99999999
        }
      },
      "description": "证书crl配置。"
    },
    "BaseResponse": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 12
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 0,
          "maxLength": 1000
        },
        "error_detail": {
          "type": "string",
          "description": "错误详情。",
          "minLength": 0,
          "maxLength": 1000
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "加密后的详细拒绝原因,用户可以自行调用STS服务的decode-authorization-message接口进行解密。",
          "readOnly": true
        }
      },
      "description": "API响应基类。"
    },
    "CertValidityData": {
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "时间单位, YEAR 年。",
          "enum": [
            "YEAR"
          ]
        },
        "value": {
          "type": "integer",
          "description": "时间数值。",
          "minimum": 1,
          "maximum": 99999999
        },
        "start_from": {
          "type": "string",
          "description": "证书过期时间。",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "description": "证书有效期配置。",
      "example": {
        "type": "YEAR",
        "value": 10,
        "start_from": "2025-08-01 00:00:00"
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。",
      "required": true,
      "type": "string",
      "maxLength": 255,
      "minLength": 1,
      "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
      "x-annotations": [
        "@Size(max = 255, min = 1)"
      ]
    }
  },
  "host": "workspace.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "post",
  "uri": null
}