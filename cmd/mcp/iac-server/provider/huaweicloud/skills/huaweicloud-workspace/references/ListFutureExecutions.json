  "definitions": {
    "ListFutureExecutionsRsp": {
      "type": "object",
      "properties": {
        "future_executions": {
          "type": "array",
          "description": "未来执行的具体时间列表。",
          "readOnly": true,
          "items": {
            "type": "string",
            "example": "2022-12-23 09:00:00",
            "readOnly": true
          }
        }
      },
      "description": "获取未来执行的具体时间列表响应体。"
    },
    "BaseResponse": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 12
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 0,
          "maxLength": 1000
        },
        "error_detail": {
          "type": "string",
          "description": "错误详情。",
          "minLength": 0,
          "maxLength": 1000
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "加密后的详细拒绝原因,用户可以自行调用STS服务的decode-authorization-message接口进行解密。",
          "readOnly": true
        }
      },
      "description": "API响应基类。"
    },
    "ListFutureExecutionsReq": {
      "allOf": [
        {
          "$ref": "#/definitions/ScheduledTaskConfig"
        },
        {
          "type": "object"
        }
      ],
      "description": "获取未来执行的具体时间列表请求体。"
    },
    "ScheduledTaskConfig": {
      "type": "object",
      "properties": {
        "scheduled_type": {
          "type": "string",
          "example": "FIXED_TIME",
          "description": "执行周期类型,可选值为:\n- FIXED_TIME:指定时间。\n- DAY:按天。\n- WEEK:按周。\n- MONTH:按月。\n- LIFE_CYCLE:指定场景下触发。",
          "minLength": 1,
          "maxLength": 255,
          "enum": [
            "FIXED_TIME",
            "DAY",
            "WEEK",
            "MONTH",
            "LIFE_CYCLE"
          ]
        },
        "day_interval": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "周期按天时:按x天间隔执行。",
          "minimum": 1,
          "maximum": 31
        },
        "week_list": {
          "type": "string",
          "example": "1,2,7",
          "description": "周期按周时:取值1~7,分别对应周日~周六,英文逗号分隔,如1,2,7。",
          "minLength": 0,
          "maxLength": 255
        },
        "month_list": {
          "type": "string",
          "example": "1,3,12",
          "description": "周期按月时:取值1~12,英文逗号分隔,如1,3,12。",
          "minLength": 0,
          "maxLength": 255
        },
        "date_list": {
          "type": "string",
          "example": "1,2,28,L",
          "description": "周期按月时:取值1~31及L(代表当月最后一天),英文逗号分隔,如1,2,28,L。",
          "minLength": 0,
          "maxLength": 255
        },
        "scheduled_date": {
          "type": "string",
          "example": "2022-12-23",
          "description": "周期指定时间时:表示指定的日期,格式为yyyy-MM-dd。",
          "minLength": 0,
          "maxLength": 255
        },
        "scheduled_time": {
          "type": "string",
          "example": "09:00:00",
          "description": "指定的执行时间点,格式为HH:mm:ss。",
          "minLength": 0,
          "maxLength": 255
        },
        "expire_time": {
          "type": "string",
          "example": "2022-12-31 09:00:00",
          "description": "到期时间,格式为yyyy-MM-dd HH:mm:ss。",
          "minLength": 0,
          "maxLength": 255
        },
        "gray_count": {
          "type": "integer",
          "format": "int32",
          "description": "灰度对象数量,优先级高于gray_desktop_ids。只支持脚本执行。",
          "minimum": 0,
          "maximum": 1000
        },
        "gray_desktop_ids": {
          "type": "array",
          "description": "灰度执行的桌面id列表,优先级低于gray_count。只支持脚本执行。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 255
          },
          "maxItems": 1000,
          "minItems": 0,
          "x-maxLength": 1000,
          "x-minLength": 0
        },
        "gray_fail_threshold": {
          "type": "integer",
          "format": "int32",
          "description": "灰度失败阈值,灰度执行失败次数达到该值时,不执行下一批任务。只支持脚本执行。",
          "minimum": 1,
          "maximum": 1000
        },
        "life_cycle_type": {
          "type": "string",
          "description": "触发场景。POST_CREATE_DESKTOP_SUCCESS:创建桌面成功后,POST_REBUILD_DESKTOP_SUCCESS:重建桌面成功后,POST_REATTACH_DESKTOP_SUCCESS:触发重建的分配用户任务成功后,POST_DESKTOP_DISCONNECTED:桌面断开连接后。",
          "minLength": 0,
          "maxLength": 255
        },
        "time_zone": {
          "type": "string",
          "example": "Asia/Shanghai",
          "description": "时区。",
          "minLength": 0,
          "maxLength": 2000
        }
      },
      "description": "定时任务时间配置。"
    }
  },
