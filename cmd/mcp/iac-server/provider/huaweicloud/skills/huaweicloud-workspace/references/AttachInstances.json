{
  "name": "AttachInstances",
  "summary": "分配用户",
  "tags": "桌面",
  "productshort": "Workspace",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/desktops/attach": {
      "post": {
        "tags": [
          "Desktop"
        ],
        "summary": "分配用户",
        "description": "将桌面分配给用户。",
        "operationId": "AttachInstances",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "x-annotations": "@Size(max = 255, min = 1)",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "in": "body",
            "name": "AttachInstancesRequestBody",
            "description": "分配用户的请求。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AttachInstancesReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "正常。",
            "examples": {
              "application/json": {
                "job_id": "string"
              }
            },
            "schema": {
              "$ref": "#/definitions/AttachInstancesRsp"
            }
          },
          "400": {
            "description": "由于包含语法错误,当前请求无法被服务器理解。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          },
          "403": {
            "description": "没有操作权限。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          },
          "404": {
            "description": "找不到资源。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          },
          "409": {
            "description": "操作冲突。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          },
          "500": {
            "description": "服务内部错误,具体返回错误码请参见错误码说明。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          }
        },
        "x-request-examples-url-1": "POST /v2/0bec5db98280d2d02fd6c00c2de791ce/desktops/attach",
        "x-request-examples-text-1": {
          "desktops": [
            {
              "desktop_id": "string",
              "user_name": "string",
              "user_group": "string",
              "computer_name": "string",
              "is_clear_data": "true"
            }
          ],
          "image_type": "string",
          "image_id": "string",
          "desktop_name_policy_id": "string"
        },
        "x-request-examples-1": {
          "desktops": [
            {
              "desktop_id": "string",
              "user_name": "string",
              "user_group": "string",
              "computer_name": "string",
              "is_clear_data": "true"
            }
          ],
          "image_type": "string",
          "image_id": "string",
          "desktop_name_policy_id": "string"
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-support-hcs": "Y",
        "x-methodAnnotations": [
          "@EnableAuth",
          "@WksIamAuthMeta(resourceField = \"desktops.![desktopId]\")",
          "@WksDependIamAuthMeta(resourceParamSpEL = {\"USER:name:desktops.![userName]\",\"USER:name:desktops.![attachUserInfos.![userName]]\"})",
          "@IamAuthMeta(authLevel = IamAuthLevel.INSTANCE_LIST, abacAction = \"workspace:desktops:attach\",  needApigwJwtAuthCheck = false, authContextInitializerName = \"workspaceInstanceListAuthContextInitializer\", needRbacCheck = false, needAbacResourceCheck = true)",
          "@CtsMeta(serviceType = \"Workspace\", resourceType = \"workspace\", traceName = \"attachDesktops\")"
        ],
        "x-apigateway-request-type": "public",
        "x-apiexplorer-hide": "N",
        "x-apig-group": "internal_token,internal_appcode,public",
        "x-api-type": "open-api",
        "x-workspace-api-auth": "CBC"
      }
    }
  },
  "definitions": {
    "EncryptType": {
      "type": "string",
      "minLength": 0,
      "maxLength": 255,
      "description": "加密类型。\n- KEEP:保持原有加密状态\n- UNENCRYPTED:不加密\n- ENCRYPTED:加密(需同步上传kms_id)",
      "enum": [
        "KEEP",
        "UNENCRYPTED",
        "ENCRYPTED"
      ],
      "default": "KEEP"
    },
    "AttachInstancesReq": {
      "properties": {
        "desktops": {
          "type": "array",
          "description": "桌面信息列表。",
          "items": {
            "$ref": "#/definitions/AttachInstancesDesktopInfo"
          },
          "maxItems": 50,
          "minItems": 1,
          "x-maxLength": 50,
          "x-minLength": 1
        },
        "image_type": {
          "type": "string",
          "description": "镜像类型,涉及变更镜像时需传(可选)。",
          "minLength": 0,
          "maxLength": 255
        },
        "image_id": {
          "type": "string",
          "description": "模板ID,涉及变更镜像时需传(可选)。",
          "minLength": 1,
          "maxLength": 255
        },
        "desktop_name_policy_id": {
          "type": "string",
          "description": "策略id,用于指定生成桌面名称策略,如果指定了桌面名称则优先使用指定的桌面名称。",
          "minLength": 0,
          "maxLength": 36
        },
        "encrypt_type": {
          "$ref": "#/definitions/EncryptType"
        },
        "kms_id": {
          "type": "string",
          "description": "密钥ID,encrypt_type为ENCRYPTED时必传。"
        }
      },
      "description": "分配用户请求。"
    },
    "AttachInstancesRsp": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "创建分配桌面总任务id。",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "description": "分配用户响应。"
    },
    "AttachInstancesDesktopInfo": {
      "properties": {
        "desktop_id": {
          "type": "string",
          "description": "待分配的桌面ID。",
          "minLength": 0,
          "maxLength": 255
        },
        "user_name": {
          "type": "string",
          "description": "桌面所属的用户,当桌面分配成功后此用户可以登录该桌面。只允许输入大写字母、小写字母、数字、中划线(-)和下划线(_)。域类型为LITE_AD时,使用小写字母或者大写字母开头,长度范围为[1-20]。当域类型为LOCAL_AD时,用户名可以使用小写字母或者大写字母或者数字开头,长度范围为[1-32]。Windows桌面用户最长支持20个字符,Linux桌面用户最长支持32个字符。用户名不能与分配的机器名重名。 attach_user_infos为空时,必填,attach_user_infos优先级更高",
          "minLength": 1,
          "maxLength": 64,
          "x-isSensitive": true
        },
        "user_id": {
          "type": "string",
          "description": "用户id。",
          "minLength": 1,
          "maxLength": 255
        },
        "user_email": {
          "type": "string",
          "description": "合法用户邮箱,桌面分配成功后系统会通过发送邮件的方式通知用户。",
          "minLength": 0,
          "maxLength": 255,
          "x-isSensitive": true
        },
        "user_group": {
          "type": "string",
          "description": "桌面用户所属的用户组,attach_user_infos为空时,必填,attach_user_infos优先级更高。\n\n- sudo:Linux管理员组。\n- default:Linux默认用户组。\n- administrators:Windows管理员组。管理员拥有对该桌面的完全访问权,可以做任何需要的更改(禁用操作除外)。\n- users:Windows标准用户组。标准用户可以使用大多数软件,并可以更改不影响其他用户的系统设置。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(sudo|default|administrators|users)?$"
        },
        "computer_name": {
          "type": "string",
          "description": "桌面名,桌面名必须保证唯一。只允许输入大写字母、小写字母、数字、中划线(-)和下划线(_);以字母开头且不允许以中划线(-)结尾;长度范围为[1-15]。",
          "minLength": 1,
          "maxLength": 15
        },
        "is_clear_data": {
          "type": "boolean",
          "description": "该字段只有当解绑和绑定为同一个用户时生效。表示绑定时是否清理桌面数据,true:清理,false:不清理,默认值为true。",
          "default": true
        },
        "attach_user_infos": {
          "type": "array",
          "description": "待分配的用户信息列表,只有多用户桌面分配多人时有效。",
          "items": {
            "$ref": "#/definitions/AttachInstancesUserInfo"
          },
          "maxItems": 500,
          "minItems": 0,
          "x-maxLength": 500,
          "x-minLength": 0
        }
      },
      "description": "分配用户请求桌面信息,单人专属桌面只能分配给一个用户;多人共享桌面可以分配给多个用户或用户组,具体分配信息见字段attach_user_infos说明。"
    },
    "BaseResponse": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 12
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 0,
          "maxLength": 1000
        },
        "error_detail": {
          "type": "string",
          "description": "错误详情。",
          "minLength": 0,
          "maxLength": 1000
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "加密后的详细拒绝原因,用户可以自行调用STS服务的decode-authorization-message接口进行解密。",
          "readOnly": true
        }
      },
      "description": "API响应基类。"
    },
    "AttachInstancesUserInfo": {
      "required": [
        "user_group",
        "user_name"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "description": "当type字段为USER时,填写用户id;当type字段为GROUP时,填写用户组id,后端服务会校验组id是否存在;",
          "minLength": 1,
          "maxLength": 255
        },
        "user_name": {
          "type": "string",
          "description": "桌面分配对象的名称,当type类型USER时填写用户名字;当type类型GROUP时填写用户组名称。\n- 当type类型USER时:桌面所属的用户,当桌面分配成功后此用户可以登录该桌面。只允许输入大写字母、小写字母、数字、中划线(-)和下划线(_)。域类型为LITE_AD时,使用小写字母或者大写字母开头,长度范围为[1-20]。当域类型为LOCAL_AD时,用户名可以使用小写字母或者大写字母或者数字开头,长度范围为[1-64]。Windows桌面用户最长支持20个字符,Linux桌面用户最长支持64个字符。后端服务会校验用户名是否存在,并且用户名不能与机器名重复。\n- 当type类型GROUP时:只能为中文、字母、数字及特殊符号-_。",
          "minLength": 1,
          "maxLength": 64,
          "x-isSensitive": true
        },
        "domain": {
          "type": "string",
          "description": "用户所属域。"
        },
        "user_group": {
          "type": "string",
          "description": "桌面用户所属的用户组。\n- sudo:Linux管理员组。\n- default:Linux默认用户组。\n- administrators:Windows管理员组。管理员拥有对该桌面的完全访问权,可以做任何需要的更改(禁用操作除外)。\n- users:Windows标准用户组。标准用户可以使用大多数软件,并可以更改不影响其他用户的系统设置。",
          "minLength": 1,
          "maxLength": 255
        },
        "type": {
          "type": "string",
          "description": "对象类型,可选值为,默认值为USER:\n- USER:用户。\n- GROUP:用户组。",
          "minLength": 1,
          "maxLength": 20,
          "default": "USER",
          "enum": [
            "USER",
            "GROUP"
          ]
        }
      },
      "description": "桌面分配用户信息。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "workspace.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "post",
  "uri": null
