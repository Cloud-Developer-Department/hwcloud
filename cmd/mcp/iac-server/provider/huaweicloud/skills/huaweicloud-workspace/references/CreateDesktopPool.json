  "definitions": {
    "CreateDesktopRsp": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "创建云桌面总任务id。",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "description": "创建按需桌面时的响应体,可根据job_id查询资源是否创建成功。"
    },
    "Tag": {
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "标签的键,不能为空,最大长度128个unicode字符。标签的键可以包含任意语种字母、数字、空格和_.:=+-@,但首尾不能含有空格,不能以_sys_开头。",
          "minLength": 0,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "description": "标签的值,最大长度43个unicode字符。标签的值可以包含任意语种字母、数字、空格和_.:=+-@,但首尾不能含有空格。",
          "minLength": 0,
          "maxLength": 43,
          "default": ""
        }
      },
      "description": "标签。"
    },
    "SecurityGroupIdInfo": {
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "安全组ID。",
          "minLength": 0,
          "maxLength": 255
        }
      }
    },
    "AutoscalePolicy": {
      "properties": {
        "autoscale_type": {
          "type": "string",
          "description": "弹性伸缩类型,ACCESS_CREATED:接入时创建,AUTO_CREATED:弹性伸缩。",
          "minLength": 0,
          "maxLength": 55,
          "enum": [
            "ACCESS_CREATED",
            "AUTO_CREATED"
          ]
        },
        "max_auto_created": {
          "type": "integer",
          "description": "最大自动创建桌面数。",
          "minimum": 1,
          "maximum": 5000
        },
        "min_idle": {
          "type": "integer",
          "description": "预留空闲桌面数。",
          "minimum": 0,
          "maximum": 5000
        },
        "once_auto_created": {
          "type": "integer",
          "description": "一次自动创建桌面的数量(已弃用)。",
          "minimum": 1,
          "maximum": 100
        },
        "min_retention": {
          "type": "integer",
          "description": "最小桌面数。",
          "minimum": 0,
          "maximum": 5000
        },
        "idle_retention_duration": {
          "type": "integer",
          "description": "空闲桌面保留时长(分钟)。",
          "minimum": 0,
          "maximum": 43200
        },
        "auto_isolation_enable": {
          "type": "boolean",
          "description": "自动故障隔离开关。"
        },
        "auto_isolation_max_num": {
          "type": "integer",
          "description": "自动隔离桌面数量上限,默认上限1000。",
          "minimum": 1
        }
      },
      "description": "弹性伸缩策略。"
    },
    "VolumeInfo": {
      "required": [
        "size",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "批量操作磁盘的磁盘集合id。",
          "minLength": 1,
          "maxLength": 255
        },
        "type": {
          "type": "string",
          "description": "桌面数据盘对应的磁盘类型,需要与系统所提供的磁盘类型相匹配。\n- SAS:高IO。\n- SSD:超高IO。",
          "minLength": 1,
          "maxLength": 255
        },
        "size": {
          "type": "integer",
          "description": "磁盘容量,单位GB。",
          "minimum": 0,
          "maximum": 8200
        },
        "iops": {
          "type": "integer",
          "description": "iops,云硬盘每秒进行读写的操作次数。",
          "minimum": 0,
          "maximum": 16380000
        },
        "throughput": {
          "type": "integer",
          "description": "吞吐量,云硬盘每秒成功传送的数据量,即读取和写入的数据量。",
          "minimum": 0,
          "maximum": 4095000
        },
        "resource_spec_code": {
          "type": "string",
          "description": "规格。",
          "minLength": 0,
          "maxLength": 255
        },
        "kms_id": {
          "type": "string",
          "description": "kms密钥Id",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "description": "磁盘信息。"
    },
    "AuthorizedObjects": {
      "required": [
        "object_id",
        "object_name",
        "object_type",
        "user_group"
      ],
      "properties": {
        "object_type": {
          "type": "string",
          "description": "绑定对象类型枚举。\n\n- USER:用户\n- USER_GROUP:用户组",
          "minLength": 1,
          "maxLength": 100,
          "enum": [
            "USER",
            "USER_GROUP"
          ]
        },
        "object_id": {
          "type": "string",
          "description": "用户/用户组id。",
          "minLength": 1,
          "maxLength": 255
        },
        "object_name": {
          "type": "string",
          "description": "用户/用户组名称。",
          "minLength": 1,
          "maxLength": 100
        },
        "domain": {
          "type": "string",
          "description": "用户/用户组所属域名。"
        },
        "user_group": {
          "type": "string",
          "description": "桌面用户所属的用户权限组。\n\n- sudo:Linux管理员组。\n- default:Linux默认用户组。\n- administrators:Windows管理员组。管理员拥有对该桌面的完全访问权,可以做任何需要的更改(禁用操作除外)。\n- users:Windows标准用户组。标准用户可以使用大多数软件,并可以更改不影响其他用户的系统设置。",
          "minLength": 1,
          "maxLength": 55
        },
        "created_at": {
          "type": "string",
          "description": "创建时间。",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "description": "查询桌面池授权的用户、用户组响应的用户/用户组信息。"
    },
    "CreateDesktopPoolRsp": {
      "allOf": [
        {
          "$ref": "#/definitions/CreateDesktopRsp"
        }
      ],
      "description": "创建按需桌面时的响应体,可根据job_id查询资源是否创建成功。"
    },
    "CreateDesktopPoolReq": {
      "required": [
        "image_id",
        "image_type",
        "name",
        "product_id",
        "root_volume",
        "size",
        "subnet_ids",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "桌面池名称,桌面池名称必须保证唯一。桌面名称只允许输入中文、大写字母、小写字母、数字、中划线,长度范围为1~64。",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "description": "桌面池类型,DYNAMIC:动态池,STATIC:静态池。",
          "minLength": 0,
          "maxLength": 255,
          "enum": [
            "DYNAMIC",
            "STATIC"
          ]
        },
        "size": {
          "type": "integer",
          "description": "桌面池大小:当前桌面池要创建多少台桌面。",
          "minimum": 0,
          "maximum": 100
        },
        "description": {
          "type": "string",
          "description": "桌面池描述。",
          "minLength": 0,
          "maxLength": 255
        },
        "availability_zone": {
          "type": "string",
          "description": "可用分区。将桌面创建到指定的可用分区。",
          "minLength": 0,
          "maxLength": 255
        },
        "product_id": {
          "type": "string",
          "description": "套餐ID。",
          "minLength": 1,
          "maxLength": 255
        },
        "flavor_id": {
          "type": "string",
          "description": "产品规格ID。",
          "minLength": 1,
          "maxLength": 255
        },
        "image_type": {
          "type": "string",
          "description": "镜像类型。默认值为private。\n\n- private:私有镜像。\n- gold:公共镜像。",
          "minLength": 1,
          "maxLength": 55,
          "default": "private"
        },
        "image_id": {
          "type": "string",
          "description": "镜像ID,用于私有镜像创建桌面场景,配合product_id使用。",
          "minLength": 1,
          "maxLength": 255
        },
        "root_volume": {
          "description": "系统盘。",
          "$ref": "#/definitions/VolumeInfo"
        },
        "data_volumes": {
          "type": "array",
          "description": "数据盘列表。",
          "items": {
            "$ref": "#/definitions/VolumeInfo"
          },
          "maxItems": 10,
          "minItems": 0,
          "x-maxLength": 10,
          "x-minLength": 0
        },
        "vpc_id": {
          "type": "string",
          "description": "创建桌面时的VPC ID。",
          "minLength": 1,
          "maxLength": 255
        },
        "subnet_ids": {
          "type": "array",
          "description": "创建桌面使用的子网ID。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 55
          },
          "maxItems": 100,
          "minItems": 0,
          "x-maxLength": 100,
          "x-minLength": 0
        },
        "security_groups": {
          "type": "array",
          "description": "桌面使用的安全组,如果不指定则默认使用桌面代理中指定的安全组。",
          "items": {
            "$ref": "#/definitions/SecurityGroupIdInfo"
          },
          "maxItems": 5,
          "minItems": 0,
          "x-maxLength": 5,
          "x-minLength": 0
        },
        "authorized_objects": {
          "type": "array",
          "description": "要授权的用户/用户组列表。",
          "items": {
            "$ref": "#/definitions/AuthorizedObjects"
          },
          "maxItems": 500,
          "minItems": 0,
          "x-maxLength": 500,
          "x-minLength": 0
        },
        "ou_name": {
          "type": "string",
          "description": "OU名称,在对接AD时使用,需提前在AD中创建OU。",
          "minLength": 0,
          "maxLength": 255
        },
        "tags": {
          "type": "array",
          "description": "标签列表。",
          "items": {
            "$ref": "#/definitions/Tag"
          },
          "maxItems": 20,
          "minItems": 0,
          "x-maxLength": 20,
          "x-minLength": 0
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID,默认\"0。\"",
          "minLength": 0,
          "maxLength": 36,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "default": "0"
        },
        "disconnected_retention_period": {
          "type": "integer",
          "description": "动态池桌面断连多少分钟内,保留用户与桌面的绑定关系,超时后自动解绑。",
          "minimum": 10,
          "maximum": 43200
        },
        "enable_autoscale": {
          "type": "boolean",
          "description": "桌面池是否开启弹性伸缩类型,为false则表示不开启弹性伸缩,为true则表示开启弹性伸缩。",
          "default": false
        },
        "autoscale_policy": {
          "$ref": "#/definitions/AutoscalePolicy"
        },
        "user_reset_policy": {
          "$ref": "#/definitions/UserResetPolicy"
        },
        "desktop_name_policy_id": {
          "type": "string",
          "description": "策略id,用于指定生成桌面名称策略。",
          "minLength": 0,
          "maxLength": 36
        },
        "domain": {
          "type": "string",
          "description": "桌面分配的域。",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "description": "创建桌面请求。"
    },
    "BaseResponse": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 12
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 0,
          "maxLength": 1000
        },
        "error_detail": {
          "type": "string",
          "description": "错误详情。",
          "minLength": 0,
          "maxLength": 1000
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "加密后的详细拒绝原因,用户可以自行调用STS服务的decode-authorization-message接口进行解密。",
          "readOnly": true
        }
      },
      "description": "API响应基类。"
    },
    "UserResetPolicy": {
      "properties": {
        "enable": {
          "type": "boolean",
          "description": "开关"
        },
        "reset_count_per_day": {
          "type": "integer",
          "description": "用户每天自动重试次数,重置次数每天0点刷新。",
          "minimum": 1,
          "maximum": 100
        }
      },
      "description": "用户重置策略。"
    }
  },
