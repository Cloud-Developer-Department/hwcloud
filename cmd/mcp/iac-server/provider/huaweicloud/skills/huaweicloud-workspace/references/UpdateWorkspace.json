          "default": false,
          "x-hcs-ignore": true
        },
        "tls_config": {
          "$ref": "#/definitions/TlsConfig"
        },
        "cba_enabled": {
          "type": "boolean",
          "description": "是否开启智能卡认证。"
        },
        "certificate_id": {
          "type": "string",
          "description": "智能卡证书id。",
          "minLength": 0,
          "maxLength": 255
        },
        "domain_controllers": {
          "type": "array",
          "description": "域控制器信息列表。有值时,active_domain_name、active_domain_ip、standby_domain_name、standby_domain_ip无效。",
