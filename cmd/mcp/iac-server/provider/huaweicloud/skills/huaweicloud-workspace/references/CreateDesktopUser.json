        },
        "group_ids": {
          "type": "array",
          "description": "用户组的专有ID列表。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 55
          },
          "maxItems": 5,
          "minItems": 1
        },
        "description": {
          "type": "string",
          "description": "用户描述,字符串长度区间[0, 255]。",
