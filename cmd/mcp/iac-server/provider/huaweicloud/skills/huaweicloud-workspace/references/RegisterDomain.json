        "operationId": "RegisterDomain",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "x-annotations": "@Size(max = 255, min = 1)",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
