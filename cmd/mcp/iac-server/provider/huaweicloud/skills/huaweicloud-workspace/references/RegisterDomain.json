            }
          },
          "412": {
            "description": "该桌面不支持重新加域。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          },
          "default": {
            "description": "默认错误响应。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          }
        },
        "x-support-sdk": "Y",
