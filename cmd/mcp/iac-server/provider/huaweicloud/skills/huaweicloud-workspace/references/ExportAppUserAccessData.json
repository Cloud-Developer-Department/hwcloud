{
  "name": "ExportAppUserAccessData",
  "summary": "导出云应用接入统计数据",
  "tags": "报表统计",
  "productshort": "Workspace",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/statistics/metrics/app-user-access/export": {
      "post": {
        "tags": [
          "Statistics"
        ],
        "summary": "导出云应用接入统计数据",
        "description": "创建云应用接入统计导出任务,仅能导出最近30天的数据。创建后根据taskId调用ListExportTasks查询任务状态,调用DownloadExportFile下载导出文件。",
        "operationId": "ExportAppUserAccessData",
        "consumes": [
          "application/json;charset=UTF-8"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "in": "body",
            "name": "ExportAppUserAccessDataRequestBody",
            "description": "创建应用使用记录导出任务",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ExportAppUserAccessDataRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "响应成功",
            "examples": {
              "application/json": {
                "task_id": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
              }
            },
            "schema": {
              "$ref": "#/definitions/ExportTaskRsp"
            }
          },
          "400": {
            "description": "客户端请求有误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-request-examples-text-1": {
          "start_time": "2022-05-11T11:45:42Z",
          "end_time": "2022-05-11T11:45:42Z",
          "username": "xxx",
          "sort_field": "access_failed_count",
          "sort_type": "DESC"
        },
        "x-request-examples-1": {
          "start_time": "2022-05-11T11:45:42Z",
          "end_time": "2022-05-11T11:45:42Z",
          "username": "xxx",
          "sort_field": "access_failed_count",
          "sort_type": "DESC"
        },
        "x-is-registered": "Y",
        "x-apigateway-request-type": "protected",
        "x-apig-group": "internal_token,public",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-methodAnnotations": [
          "@EnableAuth",
          "@IamAuthMeta(authLevel = IamAuthLevel.PROJECT, abacAction =  \"workspace:statistics:exportAppUserAccessData\",  authContextInitializerName = \"workspaceCommonAuthContextInitializer\", needApigwJwtAuthCheck = false, rbac = {\"te_admin\", \"wks_adm\"})",
          "@CtsMeta(serviceType = \"Workspace\", resourceType = \"workspace\", traceName = \"ExportAppUserAccessData\")"
        ]
      }
    }
  },
  "definitions": {
    "ExportTaskRsp": {
      "properties": {
        "task_id": {
          "type": "string",
          "example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
          "description": "导出任务id。",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "description": "导出任务返回体。"
    },
    "ExportAppUserAccessDataRequestBody": {
      "required": [
        "end_time",
        "start_time"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "example": "2022-05-11T11:45:42Z",
          "description": "查询起始时间,格式为:UTC格式,例如\"2022-05-11T11:45:42Z\"。",
          "minLength": 1,
          "maxLength": 32
        },
        "end_time": {
          "type": "string",
          "example": "2022-05-11T11:45:42Z",
          "description": "查询截止时间,格式为:UTC格式,例如\"2022-05-11T11:45:42Z\"。",
          "minLength": 1,
          "maxLength": 32
        },
        "username": {
          "type": "string",
          "example": "xxx",
          "description": "用户名(模糊匹配)。",
          "minLength": 0,
          "maxLength": 64
        },
        "sort_field": {
          "type": "string",
          "example": "access_failed_count",
          "description": "按照指标进行排序。\n* `access_failed_count` -  按照接入失败数排序\n* `last_access_failed_time` -  按照最近接入失败时间排序",
          "pattern": "(access_failed_count|last_access_failed_time)"
        },
        "sort_type": {
          "type": "string",
          "example": "DESC",
          "description": "按照指标进行排序的方向;需配合sort_field一起使用。\n* `DESC` - 降序返回数据\n* `ASC` -  升序返回数据",
          "pattern": "(ASC|DESC)",
          "default": "DESC"
        }
      },
      "description": "创建导出应用接入统计任务请求体。"
    },
    "ErrorRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误对象。"
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。",
      "required": true,
      "type": "string",
      "maxLength": 255,
      "minLength": 1,
      "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
      "x-annotations": [
        "@Size(max = 255, min = 1)"
      ]
    }
  },
  "host": "workspace.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "post",
  "uri": null
