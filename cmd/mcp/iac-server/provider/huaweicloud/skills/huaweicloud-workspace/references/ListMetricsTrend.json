{
  "name": "ListMetricsTrend",
  "summary": "查询指标趋势",
  "tags": "报表统计",
  "productshort": "Workspace",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/statistics/metrics/trend": {
      "get": {
        "tags": [
          "Statistics"
        ],
        "summary": "查询指标趋势",
        "description": "查询指标趋势。",
        "operationId": "ListMetricsTrend",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "dim",
            "in": "query",
            "description": "指标维度 | 目前最大支持3个维度,必须从0开始;维度格式为dim.{i}=key,value,key的最大长度32,value的最大长度为256。 单维度:dim.0=instance_id,6f3c6f91-4b24-4e1b-b7d1-a94ac1cb011d 多维度:dim.0=key,value&dim.1=key,value。",
            "required": false,
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "x-annotations": [
              "@Size(max = 1000, min = 1)"
            ]
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "开始时间。",
            "required": true,
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "x-example": "2024-12-08T16:00Z"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "结束时间。",
            "required": true,
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "x-example": "2024-12-08T16:00Z"
          },
          {
            "name": "metric_names",
            "in": "query",
            "description": "指标名称列表。",
            "required": true,
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "x-annotations": [
              "@Size(min = 1, max = 20)"
            ]
          },
          {
            "name": "period",
            "in": "query",
            "description": "数据周期 | MIN - 分钟级 5MIN - 5分钟级 DAY - 天级数据 HOUR - 小时级数据。",
            "required": false,
            "type": "string",
            "enum": [
              "MIN",
              "5MIN",
              "DAY",
              "HOUR"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "响应成功。",
            "examples": {
              "application/json": [
                {
                  "time": "string",
                  "metrics": [
                    {
                      "metric_name": "desktop_state",
                      "metric_value": 10
                    }
                  ]
                }
              ]
            },
            "schema": {
              "$ref": "#/definitions/ListMetricsTrendRsp"
            }
          },
          "400": {
            "description": "客户端请求有误。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-apig-group": "internal_token,public",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-methodAnnotations": [
          "@EnableAuth",
          "@IamAuthMeta(authLevel = IamAuthLevel.PROJECT, abacAction = \"workspace:statistics:getMetricTrend\", authContextInitializerName = \"workspaceCommonAuthContextInitializer\", needApigwJwtAuthCheck = false, rbac = {\"te_admin\", \"wks_adm\"})",
          "@CtsMeta(serviceType = \"Workspace\", resourceType = \"workspace\", traceName = \"ListMetricsTrend\")"
        ]
      }
    }
  },
  "definitions": {
    "MetricsWithTime": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "description": "时间。",
          "readOnly": true
        },
        "metrics": {
          "type": "array",
          "description": "指标值。",
          "readOnly": true,
          "items": {
            "$ref": "#/definitions/Metric"
          }
        }
      },
      "description": "带时间的指标。"
    },
    "ListMetricsTrendRsp": {
      "type": "array",
      "description": "查询指标趋势响应。",
      "items": {
        "$ref": "#/definitions/MetricsWithTime"
      }
    },
    "Metric": {
      "type": "object",
      "properties": {
        "metric_name": {
          "type": "string",
          "example": "desktop_state",
          "description": "指标名称。",
          "readOnly": true
        },
        "metric_value": {
          "type": "number",
          "format": "double",
          "example": 10.0,
          "description": "指标值。",
          "readOnly": true
        }
      },
      "description": "指标。"
    },
    "ErrorRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误对象。"
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。",
      "required": true,
      "type": "string",
      "maxLength": 255,
      "minLength": 1,
      "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
      "x-annotations": [
        "@Size(max = 255, min = 1)"
      ]
    }
  },
  "host": "workspace.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}