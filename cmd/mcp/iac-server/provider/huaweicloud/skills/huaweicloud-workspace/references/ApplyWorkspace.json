{
  "name": "ApplyWorkspace",
  "summary": "开通云办公服务",
  "tags": "云办公服务",
  "productshort": "Workspace",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/workspaces": {
      "post": {
        "tags": [
          "Workspace"
        ],
        "summary": "开通云办公服务",
        "description": "该接口用于开通云办公服务。\n\n作为异步接口,调用成功说明云办公服务后台收到了开通请求,但服务是否开通成功需要通过任务查询接口(GET /v2/{project_id}/workspace-sub-jobs)查询该任务的执行状态。",
        "operationId": "ApplyWorkspace",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "in": "body",
            "name": "ApplyWorkspaceRequestBody",
            "description": "开通云办公服务请求。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ApplyWorkspaceReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "开通云办公服务响应。",
            "examples": {
              "application/json": {
                "job_id": "0000000059071dbc01591661d3990019"
              }
            },
            "schema": {
              "$ref": "#/definitions/ApplyWorkspaceRsp"
            }
          },
          "400": {
