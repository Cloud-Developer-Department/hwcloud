  "definitions": {
    "Subnet": {
      "required": [
        "subnet_id"
      ],
      "properties": {
        "subnet_id": {
          "type": "string",
          "description": "子网的网络ID。",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "ApplyWorkspaceAdDomain": {
      "required": [
        "domain_type"
      ],
      "properties": {
        "domain_type": {
          "type": "string",
          "description": "域类型。\n- LITE_AS:本地认证。\n- LOCAL_AD:本地AD。\n说明:域类型为“LOCAL_AD”时,请确保所选VPC网络与AD所属网络可连通。",
          "minLength": 1,
          "maxLength": 55,
          "enum": [
            "LITE_AS",
            "LOCAL_AD"
          ]
        },
        "domain_name": {
          "type": "string",
          "description": "域名称。域类型为LOCAL_AD时需要配置。\n域名必须为AD服务器上已经存在的域名,且长度不超过55。",
          "minLength": 1,
          "maxLength": 55
        },
        "domain_admin_account": {
          "type": "string",
          "description": "域管理员账号。域类型为LOCAL_AD时需要配置。\n必须为AD服务器上已经存在的域管理员账号。",
          "minLength": 1,
          "maxLength": 55
        },
        "domain_password": {
          "type": "string",
          "description": "域管理员账号密码。域类型为LOCAL_AD时需要配置。",
          "minLength": 1,
          "maxLength": 255,
          "x-isSensitive": true
        },
        "active_domain_ip": {
          "type": "string",
          "description": "主域控制器IP地址。域类型为LOCAL_AD时需要配置。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "active_domain_name": {
          "type": "string",
          "description": "主域控制器名称。域类型为LOCAL_AD时需要配置。",
          "minLength": 1,
          "maxLength": 55
        },
        "standby_domain_ip": {
          "type": "string",
          "description": "备域控制器IP地址。域类型为LOCAL_AD时且配置备节点时需要配置。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "standby_domain_name": {
          "type": "string",
          "description": "备域控制器名称。域类型为LOCAL_AD时且配置备节点时需要配置。",
          "minLength": 0,
          "maxLength": 55
        },
        "active_dns_ip": {
          "type": "string",
          "description": "主DNS IP地址。域类型为LOCAL_AD时需要配置。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "standby_dns_ip": {
          "type": "string",
          "description": "备DNS IP地址。域类型为LOCAL_AD时且配置备节点时需要配置。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "delete_computer_object": {
          "type": "integer",
          "format": "int32",
          "description": "是否在删除桌面的同时删除AD上对应的计算机对象,0代表不删除,1代表删除。",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "use_ldaps": {
          "type": "boolean",
          "description": "是否开启LDAPS。",
          "default": false,
          "x-hcs-ignore": true
        },
        "cba_enabled": {
          "type": "boolean",
          "description": "是否开启智能卡认证"
        },
        "certificate_id": {
          "type": "string",
          "description": "智能卡证书id",
          "minLength": 0,
          "maxLength": 255
        },
        "tls_config": {
          "$ref": "#/definitions/TlsConfig"
        }
      },
      "description": "域信息。"
    },
    "ApplyWorkspaceRsp": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "开通云办公服务的任务ID。",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "description": "开通服务响应。"
    },
    "ApplyWorkspaceReq": {
      "required": [
        "ad_domains"
      ],
      "properties": {
        "ad_domains": {
          "description": "域信息。",
          "$ref": "#/definitions/ApplyWorkspaceAdDomain"
        },
        "enterprise_id": {
          "type": "string",
          "description": "企业ID。\n企业ID是您在云桌面服务的唯一标识,终端用户登录时需要填写企业ID,若不自定义设置企业ID,系统将自动生成您的企业ID。格式为由半角数字、字母、_-组成,长度范围小于等于32个字符。",
          "minLength": 0,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "vpc_id": {
          "type": "string",
          "description": "VPC ID。",
          "minLength": 0,
          "maxLength": 255
        },
        "subnet_ids": {
          "type": "array",
          "description": "指定业务子网的网络ID,子网不能与172.16.0.0/12冲突。",
          "items": {
            "$ref": "#/definitions/Subnet"
          },
          "maxItems": 100,
          "minItems": 0,
          "x-maxLength": 100,
          "x-minLength": 0
        },
        "manage_subnet_cidr": {
          "type": "string",
          "description": "管理子网网段。\n注:不能与172.16.0.0/12以及subnet_ids参数下子网的网段冲突。",
          "minLength": 0,
          "maxLength": 255
        },
        "access_mode": {
          "type": "string",
          "description": "接入方式。\n- INTERNET:表示Internet接入。\n- DEDICATED:表示专线接入。\n- BOTH:表示两种接入方式都支持。",
          "minLength": 0,
          "maxLength": 55,
          "enum": [
            "INTERNET",
            "DEDICATED",
            "BOTH"
          ]
        },
        "apply_shared_vpc_dedicated_param": {
          "$ref": "#/definitions/ApplySharedVpcDedicatedParam"
        },
        "dedicated_subnets": {
          "type": "string",
          "example": "192.168.0.0/24;10.0.0.0/16",
          "description": "专线接入网段列表,多个网段信息用分号隔开,列表长度不超过5。",
          "minLength": 0,
          "maxLength": 100
        },
        "is_send_email": {
          "type": "boolean",
          "description": "桌面退订是否发送邮件通知。"
        }
      },
      "description": "申请开通云办公服务请求。"
    },
    "ApplySharedVpcDedicatedParam": {
      "properties": {
        "address": {
          "type": "string",
          "description": "租户指定的共享Vpc专线地址。",
          "minLength": 0,
          "maxLength": 255
        },
        "port": {
          "type": "integer",
          "description": "租户指定共享Vpc专线地址端口。",
          "minimum": 1025,
          "maximum": 65535
        },
        "availability_zone": {
          "type": "array",
          "description": "开通服务资源使用的可用分区,默认随机使用2个可用区。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 255
          },
          "maxItems": 10,
          "minItems": 0,
          "x-maxLength": 10,
          "x-minLength": 0
        }
      },
      "description": "共享Vpc专线入参。"
    },
    "BaseResponse": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 12
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 0,
          "maxLength": 1000
        },
        "error_detail": {
          "type": "string",
          "description": "错误详情。",
          "minLength": 0,
          "maxLength": 1000
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "加密后的详细拒绝原因,用户可以自行调用STS服务的decode-authorization-message接口进行解密。",
          "readOnly": true
        }
      },
      "description": "API响应基类。"
    },
    "TlsConfig": {
      "properties": {
        "cert_pem": {
          "type": "string",
          "description": "pem内容, 有则更新,无则上传。查询不返回。",
          "minLength": 0,
          "maxLength": 8192
        },
        "cert_start_time": {
          "type": "string",
          "description": "证书生效开始时间,时间参考样例 2022-01-25T09:24:27。",
          "minLength": 0,
          "maxLength": 255
        },
        "cert_end_time": {
          "type": "string",
          "description": "证书生效截止时间,时间参考样例 2022-01-25T09:24:27。",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "description": "TLS信息。"
    }
  },
  "version": "2.0",
  "parameters": {},
