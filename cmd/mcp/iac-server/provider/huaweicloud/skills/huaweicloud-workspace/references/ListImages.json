            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "image_id",
            "in": "query",
            "description": "镜像Id。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
