{
  "name": "ListDesktopsStatistics",
  "summary": "桌面统计",
  "tags": "报表统计",
  "productshort": "Workspace",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/statistics": {
      "get": {
        "tags": [
          "Statistics"
        ],
        "summary": "桌面统计",
        "description": "统计租户下的普通桌面、桌面池状态,默认仅统计总数。",
        "operationId": "ListDesktopsStatistics",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "desktop_type",
            "in": "query",
            "description": "桌面类型,为空时查所有桌面。\n- DEDICATED:普通桌面,包括专享桌面、专属桌面等\n- POOLED:池桌面,即桌面池里的桌面",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 0
          },
          {
            "name": "statistics_type",
            "in": "query",
            "description": "统计类型,为空时仅统计桌面总数 |- - attach-state 按照分配状态统计 - login-state 按照登录状态统计 - run-state 按照运行状态统计。",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "attach-state",
                "login-state",
                "run-state"
              ]
            },
            "maxItems": 20,
            "minItems": 0
          },
          {
            "name": "desktop_pool_ids",
            "in": "query",
            "description": "待查询的桌面池ID列表",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 0,
            "x-minLength": 0,
            "x-maxLength": 100
          }
        ],
        "responses": {
          "200": {
            "description": "状态统计响应。",
            "examples": {
              "application/json": {
                "total_num": 1
              }
            },
            "schema": {
              "$ref": "#/definitions/DesktopStatisticsRsp"
            }
          },
          "default": {
            "description": "错误响应。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          }
        },
        "x-request-examples-url-1": "GET /v2/9565be6e740941c493b38a1f46ecae6f/statistics",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-support-hcs": "Y",
        "x-apigateway-request-type": "public",
        "x-apig-group": "internal_token,public",
        "x-api-type": "open-api",
        "x-apiexplorer-hide": "N",
        "x-imports": [
          "com.huawei.clouds.wushan.auth.token.IamAuthMeta",
          "com.huawei.clouds.wushan.auth.token.IamAuthLevel",
          "com.huawei.clouds.wushan.integration.common.auth.EnableAuth",
          "com.huawei.clouds.wushan.cts.meta.CtsMeta"
        ],
        "x-methodAnnotations": [
          "@EnableAuth",
          "@IamAuthMeta(authLevel = IamAuthLevel.PROJECT,  authContextInitializerName = \"workspaceCommonAuthContextInitializer\", abacAction = \"workspace:statistics:listDesktopStatus\",  needApigwJwtAuthCheck = false, needRbacCheck = false)",
          "@CtsMeta(serviceType = \"Workspace\", resourceType = \"workspace\", traceName = \"listDesktopsStatistics\", traceNameCn = \"桌面统计\")"
        ]
      }
    }
  },
