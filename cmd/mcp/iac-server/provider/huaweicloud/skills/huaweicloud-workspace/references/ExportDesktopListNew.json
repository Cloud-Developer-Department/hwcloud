{
  "name": "ExportDesktopListNew",
  "summary": "导出桌面列表",
  "tags": "桌面",
  "productshort": "Workspace",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/desktops/export": {
      "get": {
        "tags": [
          "DesktopV3"
        ],
        "summary": "导出桌面列表",
        "description": "导出桌面列表的excel文件。",
        "operationId": "ExportDesktopListNew",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "computer_name",
            "in": "query",
            "description": "桌面名。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "desktop_ip",
            "in": "query",
            "description": "桌面IP地址。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "desktop_id",
            "in": "query",
            "description": "桌面ID。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "tag",
            "in": "query",
            "description": "桌面的标签。标签的键和标签的值用“=”连接。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "language",
            "in": "query",
            "description": "语言。\n\n- zh_CN:中文\n- en_US:英文",
            "required": true,
            "type": "string",
            "default": "en_US",
            "enum": [
              "zh_CN",
              "en_US"
            ]
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目ID。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "desktop_type",
            "in": "query",
            "description": "桌面类型,为空时查所有桌面。\n- DEDICATED:普通桌面,包括专享桌面、专属桌面等\n- POOLED:池桌面,即桌面池里的桌面",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "status",
            "in": "query",
            "description": "桌面状态。\n\n- ACTIVE:运行中。\n- SHUTOFF:关机。\n- ERROR:异常。\n- HIBERNATED:休眠。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "user_names",
            "in": "query",
            "description": "桌面所属用户,批量筛选,最多不超过100个用户。",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 0,
              "maxLength": 36
            },
            "maxItems": 100,
            "minItems": 0
          },
          {
            "name": "sort_field",
            "in": "query",
            "description": "排序字段名称,需要结合sort_type字段一起使用。\n- created 创建时间。\n- computer_name 桌面名称。",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "enum": [
              "created",
              "computer_name"
            ]
          },
          {
            "name": "sort_type",
            "in": "query",
            "description": "排序类型,默认升序,需要结合sort_field字段一起使用。\n- ASC 升序。\n- DESC 降序。",
            "required": false,
            "type": "string",
            "default": "ASC",
            "maxLength": 32,
            "minLength": 0,
            "enum": [
              "ASC",
              "DESC"
            ]
          },
          {
            "name": "pool_id",
            "in": "query",
            "description": "桌面池ID,多个桌面池ID用逗号隔开。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "user_attached",
            "in": "query",
            "description": "是否分配了用户。",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "image_id",
            "in": "query",
            "description": "镜像ID。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "charge_mode",
            "in": "query",
            "description": "计费模式,0:包周期,1:按需。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0,
            "x-annotations": "@Size(max = 1, min = 0)"
          },
          {
            "name": "in_maintenance_mode",
            "in": "query",
            "description": "按照维护模式过滤。",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "subnet_id",
            "in": "query",
            "description": "桌面的子网ID。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "connection_status_version",
            "in": "query",
            "description": "连接状态版本,默认值为OLD。\n- NEW:新版本\n- OLD:老版本",
            "required": false,
            "type": "string",
            "default": "OLD",
            "maxLength": 36,
            "minLength": 0
          }
        ],
        "responses": {
