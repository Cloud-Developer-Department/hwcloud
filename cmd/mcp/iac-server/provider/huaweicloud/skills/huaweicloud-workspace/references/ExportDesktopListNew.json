          "@IamAuthMeta(authLevel = IamAuthLevel.INSTANCE_LIST, abacAction = \"workspace:desktops:export\", needApigwJwtAuthCheck = false, authContextInitializerName = \"workspaceListAuthContextInitializer\", needRbacCheck = false, needAbacResourceCheck = true)",
          "@CtsMeta(serviceType = \"Workspace\", resourceType = \"desktop\", traceName = \"exportDesktops\", traceNameCn = \"导出桌面列表\")"
