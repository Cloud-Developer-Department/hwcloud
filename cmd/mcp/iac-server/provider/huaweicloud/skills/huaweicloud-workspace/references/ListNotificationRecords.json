{
  "name": "ListNotificationRecords",
  "summary": "查询通知拦截记录",
  "tags": "用户",
  "productshort": "Workspace",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/users/notification-records": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "查询通知拦截记录",
        "description": "查询通知拦截记录",
        "operationId": "ListNotificationRecords",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "query_type",
            "in": "query",
            "description": "通过该类型查询桌面或桌面池相关的通知拦截记录\n- DESKTOP: 查找当前projectId下与桌面相关的通知拦截记录\n- DESKTOP_POOL: 查找当前projectId下与桌面池相关的通知拦截记录",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "enum": [
              "DESKTOP",
              "DESKTOP_POOL"
            ]
          },
          {
            "name": "desktop_name",
            "in": "query",
            "description": "桌面名",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "desktop_pool_name",
            "in": "query",
            "description": "桌面池名称,桌面池名称必须保证唯一。桌面名称只允许输入中文、大写字母、小写字母、数字、中划线,长度范围为1~255。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 1
          },
          {
            "name": "user_name",
            "in": "query",
            "description": "用户名",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "type",
            "in": "query",
            "description": "过滤出与SMN通知类型一致的通知拦截记录\n- EMAIL: 通过邮件查找通知拦截记录\n- SMS: 通过短信查找通知拦截记录",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "enum": [
              "EMAIL",
              "SMS"
            ]
          },
          {
            "name": "offset",
            "in": "query",
            "description": "用于分页查询,查询的起始记录序号,从0开始。",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 2147483647,
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "用于分页查询,取值范围0-1000,默认值1000。",
            "required": false,
            "type": "integer",
            "default": 1000,
            "maximum": 1000,
            "minimum": 0
          },
          {
            "name": "sort_field",
            "in": "query",
            "description": "排序字段名称,需要结合sort_type字段一起使用。\n- operate_time 发送时间",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "enum": [
              "operate_time"
            ]
          },
          {
            "name": "sort_type",
            "in": "query",
            "description": "排序类型,默认升序,需要结合sort_field字段一起使用。\n- ASC 升序。\n- DESC 降序。",
            "required": false,
            "type": "string",
            "default": "ASC",
            "maxLength": 32,
            "minLength": 0,
            "enum": [
              "ASC",
              "DESC"
            ]
          }
        ],
