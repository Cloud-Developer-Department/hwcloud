  "definitions": {
    "ShowScheduledTasksRsp": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "2b31e-d520xxxx-xxebedb6-e57xxxxxx",
          "description": "任务id。",
          "readOnly": true
        },
        "task_type": {
          "type": "string",
          "example": "START",
          "description": "任务类型。START:开机,STOP:关机,REBOOT:重启,HIBERNATE:休眠,REBUILD:重建系统盘,EXECUTE_SCRIPT:执行脚本。scheduled_type为LIFE_CYCLE时,不支持START、REBUILD。",
          "readOnly": true
        },
        "task_name": {
          "type": "string",
          "example": "测试任务",
          "description": "任务名称。",
          "readOnly": true
        },
        "force_execute": {
          "type": "boolean",
          "example": true,
          "description": "是否强制执行。",
          "readOnly": true
        },
        "scheduled_type": {
          "type": "string",
          "example": "FIXED_TIME",
          "description": "执行周期类型。FIXED_TIME:指定时间,DAY:按天,WEEK:按周,MONTH:按月,LIFE_CYCLE:指定场景下触发。",
          "readOnly": true
        },
        "life_cycle_type": {
          "type": "string",
          "description": "触发场景类型。仅当scheduled_type为LIFE_CYCLE时,生效。POST_CREATE_DESKTOP_SUCCESS:创建桌面成功后,POST_REBUILD_DESKTOP_SUCCESS:重建桌面成功后,POST_REATTACH_DESKTOP_SUCCESS:触发重建的分配用户任务成功后。",
          "readOnly": true
        },
        "life_cycle_exec_period": {
          "type": "integer",
          "format": "int32",
          "example": 1440,
          "description": "触发式任务执行周期,单位分钟。最小1分钟,最大10080分钟(7天),默认1440分钟(1天)。",
          "readOnly": true
        },
        "day_interval": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "周期按天时:按x天间隔执行。",
          "readOnly": true
        },
        "week_list": {
          "type": "string",
          "example": "1,2,7",
          "description": "周期按周时:取值1~7,分别对应周日~周六,英文逗号分隔,如1,2,7。",
          "readOnly": true
        },
        "month_list": {
          "type": "string",
          "example": "1,3,12",
          "description": "周期按月时:取值1~12,英文逗号分隔,如1,3,12。",
          "readOnly": true
        },
        "date_list": {
          "type": "string",
          "example": "1,2,28,L",
          "description": "周期按月时:取值1~31及L(代表当月最后一天),英文逗号分隔,如1,2,28,L。",
          "readOnly": true
        },
        "scheduled_date": {
          "type": "string",
          "example": "2022-12-23",
          "description": "周期指定时间时:表示指定的日期,格式为yyyy-MM-dd。",
          "readOnly": true
        },
        "scheduled_time": {
          "type": "string",
          "example": "09:00:00",
          "description": "指定的执行时间点,格式为HH:mm:ss。",
          "readOnly": true
        },
        "expire_time": {
          "type": "string",
          "example": "2022-12-31 09:00:00",
          "description": "到期时间,格式为yyyy-MM-dd HH:mm:ss。",
          "readOnly": true
        },
        "description": {
          "type": "string",
          "example": "一个描述",
          "description": "描述。",
          "readOnly": true
        },
        "extra_params": {
          "type": "string",
          "example": "{ \"notify_message\": \"测试\" }",
          "description": "扩展参数,json格式。",
          "readOnly": true
        },
        "apply_objects": {
          "type": "array",
          "description": "定时任务应用的对象列表。",
          "readOnly": true,
          "items": {
            "$ref": "#/definitions/ApplyObject"
          }
        },
        "gray_count": {
          "type": "integer",
          "format": "int32",
          "description": "灰度对象数量,优先级高于gray_desktop_ids。",
          "readOnly": true
        },
        "gray_desktop_ids": {
          "type": "array",
          "description": "灰度执行的桌面id列表,优先级低于gray_count。",
          "readOnly": true,
          "items": {
            "type": "string",
            "readOnly": true
          }
        },
        "gray_fail_threshold": {
          "type": "integer",
          "format": "int32",
          "description": "灰度失败阈值,灰度执行失败次数达到该值时,不执行下一批任务。",
          "readOnly": true
        },
        "time_zone": {
          "type": "string",
          "example": "GMT+8",
          "description": "时区。",
          "minLength": 0,
          "maxLength": 2000
        },
        "wait_time": {
          "type": "integer",
          "format": "int32",
          "description": "触发式任务触发后,等待时长。",
          "readOnly": true
        }
      },
      "description": "查询定时任务详情响应。"
    },
    "ApplyObject": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "example": "2b31e-d520xxxx-xxebedb6-e57xxxxxx",
          "description": "对象ID。",
          "minLength": 1,
          "maxLength": 255
        },
        "object_type": {
          "type": "string",
          "example": "DESKTOP",
          "description": "对象类型,可选值为:\n- DESKTOP:桌面。\n- DESKTOP_POOL:桌面池。\n- ALL_DESKTOPS: 所有桌面。\n- DESKTOP_TAG:桌面标签。",
          "minLength": 1,
          "maxLength": 255,
          "enum": [
            "DESKTOP",
            "DESKTOP_POOL",
            "ALL_DESKTOPS",
            "DESKTOP_TAG"
          ]
        },
        "object_name": {
          "type": "string",
          "example": "测试桌面",
          "description": "对象名称。"
        }
      },
      "description": "定时任务应用对象。"
    },
    "BaseResponse": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 12
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 0,
          "maxLength": 1000
        },
        "error_detail": {
          "type": "string",
          "description": "错误详情。",
          "minLength": 0,
          "maxLength": 1000
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "加密后的详细拒绝原因,用户可以自行调用STS服务的decode-authorization-message接口进行解密。",
          "readOnly": true
        }
      },
      "description": "API响应基类。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "workspace.af-north-1.myhuaweicloud.com",
