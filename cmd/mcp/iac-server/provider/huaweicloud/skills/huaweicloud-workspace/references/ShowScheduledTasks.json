          }
        },
        "x-apig-group": "public,internal_token",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-apigateway-request-type": "public",
        "x-apiexplorer-hide": "N",
        "x-methodAnnotations": [
          "@EnableAuth",
          "@WksIamAuthMeta(resourceType=ResourceType.SCHEDULED_TASK, resourceField=\"task_id\")",
          "@IamAuthMeta(authLevel = IamAuthLevel.INSTANCE, abacAction = \"workspace:scheduledTasks:get\", needApigwJwtAuthCheck = false, authContextInitializerName = \"workspaceInstanceAuthContextInitializer\", needRbacCheck = false, needAbacResourceCheck = true)",
          "@CtsMeta(serviceType = \"Workspace\", resourceType = \"workspace\", traceName = \"showScheduledTasks\", traceNameCn = \"查询定时任务详情\")"
        ]
      }
