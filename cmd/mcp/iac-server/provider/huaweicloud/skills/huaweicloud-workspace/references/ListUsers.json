    },
    "User": {
      "properties": {
        "id": {
          "type": "string",
          "description": "用户ID。",
          "minLength": 0,
          "maxLength": 255
        },
        "sid": {
          "type": "string",
          "description": "用户ID。",
          "minLength": 0,
          "maxLength": 255
        },
        "user_name": {
          "type": "string",
          "description": "桌面用户名。",
          "minLength": 0,
          "maxLength": 55
        },
        "user_email": {
          "type": "string",
          "description": "用户邮箱。",
          "minLength": 0,
          "maxLength": 64,
          "pattern": "^((([0-9a-zA-Z_]+)|([0-9a-zA-Z]+[_.0-9a-zA-Z-]*[0-9a-zA-Z]+))@([a-zA-Z0-9-_]+[.])+[a-zA-Z0-9]+)$"
        },
        "total_desktops": {
          "type": "integer",
          "format": "int32",
          "description": "用户绑定桌面云总数。",
          "minimum": 1,
          "maximum": 55
        },
        "user_phone": {
          "type": "string",
          "description": "手机号。",
          "minLength": 0,
          "maxLength": 20
        },
        "active_type": {
          "type": "string",
          "example": "USER_ACTIVATE",
          "description": "激活类型,默认为用户激活。\n* USER_ACTIVATE: 用户激活\n* ADMIN_ACTIVATE: 管理员激活",
          "minLength": 0,
          "maxLength": 50,
          "enum": [
            "USER_ACTIVATE",
            "ADMIN_ACTIVATE"
          ]
        },
        "is_pre_user": {
          "type": "boolean",
          "description": "是不是预创建的用户。"
        },
        "account_expires": {
          "type": "string",
          "description": "账户过期时间,0表示永远不过期。",
          "minLength": 0,
          "maxLength": 55
        },
        "password_never_expired": {
          "type": "boolean",
          "description": "密码是否永不过期,true表示密码永不过期,false表示密码会过期。"
        },
        "account_expired": {
          "type": "boolean",
          "description": "账号是否过期,true表示已过期,false表示未过期。"
        },
        "enable_change_password": {
          "type": "boolean",
          "description": "是否允许修改密码,true表示允许,false表示不允许。"
        },
        "next_login_change_password": {
          "type": "boolean",
          "description": "下次登录是否需要重置密码,true表示需要重置密码,false表示不需要。"
        },
        "description": {
          "type": "string",
          "description": "用户描述。",
          "minLength": 0,
          "maxLength": 255
        },
        "locked": {
          "type": "boolean",
          "description": "账户是否被锁定,true表示被锁定,false表示未锁定。"
        },
        "disabled": {
          "type": "boolean",
          "description": "账户是否禁用,true表示被禁用,false表示未禁用。"
        },
        "share_space_subscription": {
          "type": "boolean",
          "description": "用户是否订阅协同,true表示已订阅,false表示未订阅。",
          "x-hcs-ignore": true
        },
        "share_space_desktops": {
          "type": "integer",
          "format": "int32",
          "description": "用户已绑定协同桌面数。",
          "minimum": 0,
          "maximum": 100,
          "x-hcs-ignore": true
        },
        "group_names": {
          "type": "array",
          "description": "加入的组列表。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 255
          },
          "maxItems": 50,
          "minItems": 1
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。",
          "minLength": 0,
          "maxLength": 255
        },
        "user_info_map": {
          "type": "string",
          "description": "用户信息映射,包含用户的服务等级、操作模式和类型。",
          "minLength": 0,
          "maxLength": 255
        },
        "domain": {
          "type": "string",
          "description": "域。",
          "minLength": 0,
          "maxLength": 255
        },
        "certificate_status": {
          "type": "boolean",
          "example": true,
          "description": "当前用户是否存在用户证书。",
          "readOnly": true
        }
      }
    },
    "BaseResponse": {
      "properties": {
        "error_code": {
          "type": "string",
