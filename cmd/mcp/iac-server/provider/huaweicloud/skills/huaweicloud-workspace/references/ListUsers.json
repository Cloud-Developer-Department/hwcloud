{
  "name": "ListUsers",
  "summary": "查询用户列表",
  "tags": "用户",
  "productshort": "Workspace",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/users": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "查询用户列表",
        "description": "该接口用于查询桌面用户列表。",
        "operationId": "ListUsers",
        "schemes": [
          "https"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "user_name",
            "in": "query",
            "description": "桌面用户名,长度范围为1-20,不能包含特殊字符,不能以数字开头。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "user_names",
            "in": "query",
            "description": "桌面用户名列表。",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 0,
              "maxLength": 255
            },
            "maxLength": 100,
            "minLength": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "用于分页查询,返回用户数量限制。如果不指定,则返回所有符合条件的用户。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页查询起始条数。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "description",
            "in": "query",
            "description": "用户描述查询,模糊匹配。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0,
            "pattern": "[  一-龥a-zA-Z\\d._~!@*()=;:',??,【】、。!;()-]{0,255}"
          },
          {
            "name": "active_type",
            "in": "query",
            "description": "激活类型,默认为用户激活。\n* USER_ACTIVATE: 用户激活\n* ADMIN_ACTIVATE: 管理员激活",
            "required": false,
            "type": "string",
            "maxLength": 40,
            "minLength": 0
          },
          {
            "name": "group_name",
            "in": "query",
            "description": "桌面用户组名,精确匹配。",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          {
            "name": "share_space_subscription",
            "in": "query",
            "description": "用户是否已订阅协同,true/false。",
            "required": false,
            "type": "boolean",
            "x-hcs-ignore": true
          },
          {
            "name": "share_space_desktops",
            "in": "query",
            "description": "用户是否已绑定协同桌面,true/false。",
            "required": false,
            "type": "boolean",
            "x-hcs-ignore": true
          },
          {
            "name": "is_query_total_desktops",
            "in": "query",
            "description": "是否查询用户绑定的桌面数,true/false,默认true。",
            "required": false,
            "type": "boolean",
            "default": true
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目ID。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "disabled",
            "in": "query",
            "description": "用户是否被禁用",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "domain",
            "in": "query",
            "description": "域。",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          {
            "name": "platform_type",
            "in": "query",
            "description": "用户类型。\n* AD: AD域用户\n* LOCAL: 本地liteAs用户\n* UOS: UOS域用户",
            "required": false,
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          }
        ],
        "responses": {
          "200": {
            "description": "查询桌面云用户列表响应。",
            "examples": {
              "application/json": {
                "total_count": 2,
                "users": [
                  {
                    "id": "8a2c3f9579d240820179d51e6caf0001",
                    "user_name": "api-test",
                    "user_email": "test@huawei.com",
                    "total_desktops": 0,
                    "account_expires": "0",
                    "enable_change_password": true,
                    "next_login_change_password": true,
                    "locked": false,
                    "disabled": false
                  },
                  {
                    "id": "8a2c3f9579d240820179d51e6caf0002",
                    "user_name": "api-test2",
                    "user_email": "test@huawei.com",
                    "total_desktops": 0,
                    "account_expires": "0",
                    "enable_change_password": true,
                    "next_login_change_password": true,
                    "locked": false,
                    "disabled": false
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/UserListResponse"
            }
          },
          "400": {
            "description": "由于包含语法错误,当前请求无法被服务器理解。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          },
          "403": {
            "description": "没有操作权限。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          },
          "404": {
            "description": "找不到资源。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          },
          "405": {
            "description": "请求中指定的方法不被允许。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          },
          "500": {
            "description": "服务内部错误,具体返回错误码请参见错误码说明。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          },
          "503": {
            "description": "服务不可用。",
            "schema": {
              "$ref": "#/definitions/BaseResponse"
            }
          }
        },
        "x-addValid": true,
        "x-methodAnnotations": [
          "@EnableAuth",
          "@WksIamAuthMeta(operationType = OperationType.LIST, resourceType=ResourceType.USER)",
          "@IamAuthMeta(authLevel = IamAuthLevel.INSTANCE_LIST, abacAction = \"workspace:users:list\",  needApigwJwtAuthCheck = false, authContextInitializerName = \"workspaceListAuthContextInitializer\", needRbacCheck = false, needAbacResourceCheck = true)",
          "@CtsMeta(serviceType = \"Workspace\", resourceType = \"workspace\", traceName = \"listUsers\")"
        ],
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-support-hcs": "Y",
        "x-request-examples-url-1": "GET /v2/0bec5db98280d2d02fd6c00c2de791ce/users?limit=10",
        "x-apigateway-request-type": "public",
        "x-apig-group": "public,internal_token,internal_appcode"
      }
    }
