  "definitions": {
    "UserListResponse": {
      "properties": {
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "用户总数。",
          "readOnly": true
        },
        "users": {
          "type": "array",
          "description": "用户列表。",
          "readOnly": true,
          "items": {
            "$ref": "#/definitions/User"
          }
        }
