  "definitions": {
    "CreateScheduledTasksReq": {
      "allOf": [
        {
          "$ref": "#/definitions/ScheduledTaskConfig"
        },
        {
          "type": "object",
          "required": [
            "task_name",
            "task_type"
          ],
          "properties": {
            "task_type": {
              "type": "string",
              "example": "START",
              "description": "任务类型,可选值为:\n- START:开机。\n- STOP:关机。\n- REBOOT:重启。\n- HIBERNATE:休眠。\n- REBUILD:重建系统盘。\n- EXECUTE_SCRIPT:执行脚本。\n- CREATE_SNAPSHOT:创建快照",
              "minLength": 1,
              "maxLength": 255,
              "enum": [
                "START",
                "STOP",
                "REBOOT",
                "HIBERNATE",
                "REBUILD",
                "EXECUTE_SCRIPT",
                "CREATE_SNAPSHOT"
              ]
            },
            "task_name": {
              "type": "string",
              "example": "测试任务",
              "description": "任务名称。",
              "minLength": 1,
              "maxLength": 255
            },
            "force_execute": {
              "type": "boolean",
              "example": false,
              "description": "是否强制执行,true表示强制执行,false表示不强制执行。",
              "default": false
            },
            "description": {
              "type": "string",
              "example": "一个描述",
              "description": "描述。",
              "minLength": 0,
              "maxLength": 255
            },
            "extra_params": {
              "type": "string",
              "example": "{ \"notify_message\": \"测试\" }",
              "description": "扩展参数,json格式。",
              "minLength": 0,
              "maxLength": 2000
            },
            "apply_objects": {
              "type": "array",
              "description": "定时任务应用的对象列表。",
              "items": {
                "$ref": "#/definitions/ApplyObject"
              },
              "maxItems": 1000,
              "minItems": 0
            },
            "wait_time": {
              "type": "integer",
              "format": "int32",
              "description": "触发式任务触发后,等待时长。",
              "minimum": 0,
              "maximum": 43200,
              "default": 0
            },
            "life_cycle_exec_period": {
              "type": "integer",
              "format": "int32",
              "example": 1440,
              "description": "触发式任务执行周期,单位分钟。最小1分钟,最大10080分钟(7天),默认1440分钟(1天)。",
              "minimum": 1,
              "maximum": 10080,
              "default": 1440
            }
          }
        }
      ],
      "description": "创建定时任务请求体。"
    },
    "ApplyObject": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "example": "2b31e-d520xxxx-xxebedb6-e57xxxxxx",
          "description": "对象ID。",
          "minLength": 1,
          "maxLength": 255
        },
        "object_type": {
          "type": "string",
          "example": "DESKTOP",
          "description": "对象类型,可选值为:\n- DESKTOP:桌面。\n- DESKTOP_POOL:桌面池。\n- ALL_DESKTOPS: 所有桌面。\n- DESKTOP_TAG:桌面标签。",
          "minLength": 1,
          "maxLength": 255,
          "enum": [
            "DESKTOP",
            "DESKTOP_POOL",
            "ALL_DESKTOPS",
            "DESKTOP_TAG"
          ]
        },
        "object_name": {
          "type": "string",
          "example": "测试桌面",
          "description": "对象名称。"
        }
      },
      "description": "定时任务应用对象。"
    },
    "CreateScheduledTaskRsp": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "example": "2b31e-d520xxxx-xxebedb6-e57xxxxxx",
          "description": "任务id。",
          "readOnly": true
        }
      },
      "description": "创建定时任务响应。"
    },
    "BaseResponse": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 12
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 0,
          "maxLength": 1000
        },
        "error_detail": {
          "type": "string",
          "description": "错误详情。",
          "minLength": 0,
          "maxLength": 1000
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "加密后的详细拒绝原因,用户可以自行调用STS服务的decode-authorization-message接口进行解密。",
          "readOnly": true
        }
      },
      "description": "API响应基类。"
    },
    "ScheduledTaskConfig": {
      "type": "object",
      "properties": {
        "scheduled_type": {
          "type": "string",
          "example": "FIXED_TIME",
          "description": "执行周期类型,可选值为:\n- FIXED_TIME:指定时间。\n- DAY:按天。\n- WEEK:按周。\n- MONTH:按月。\n- LIFE_CYCLE:指定场景下触发。",
          "minLength": 1,
          "maxLength": 255,
          "enum": [
            "FIXED_TIME",
            "DAY",
            "WEEK",
            "MONTH",
            "LIFE_CYCLE"
          ]
        },
        "day_interval": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "周期按天时:按x天间隔执行。",
          "minimum": 1,
          "maximum": 31
        },
        "week_list": {
          "type": "string",
          "example": "1,2,7",
          "description": "周期按周时:取值1~7,分别对应周日~周六,英文逗号分隔,如1,2,7。",
          "minLength": 0,
          "maxLength": 255
        },
        "month_list": {
          "type": "string",
          "example": "1,3,12",
          "description": "周期按月时:取值1~12,英文逗号分隔,如1,3,12。",
          "minLength": 0,
          "maxLength": 255
        },
        "date_list": {
          "type": "string",
          "example": "1,2,28,L",
          "description": "周期按月时:取值1~31及L(代表当月最后一天),英文逗号分隔,如1,2,28,L。",
          "minLength": 0,
          "maxLength": 255
        },
        "scheduled_date": {
          "type": "string",
          "example": "2022-12-23",
          "description": "周期指定时间时:表示指定的日期,格式为yyyy-MM-dd。",
          "minLength": 0,
          "maxLength": 255
        },
        "scheduled_time": {
          "type": "string",
          "example": "09:00:00",
          "description": "指定的执行时间点,格式为HH:mm:ss。",
          "minLength": 0,
          "maxLength": 255
        },
        "expire_time": {
          "type": "string",
          "example": "2022-12-31 09:00:00",
          "description": "到期时间,格式为yyyy-MM-dd HH:mm:ss。",
          "minLength": 0,
          "maxLength": 255
        },
        "gray_count": {
          "type": "integer",
          "format": "int32",
          "description": "灰度对象数量,优先级高于gray_desktop_ids。只支持脚本执行。",
          "minimum": 0,
          "maximum": 1000
        },
        "gray_desktop_ids": {
          "type": "array",
          "description": "灰度执行的桌面id列表,优先级低于gray_count。只支持脚本执行。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 255
          },
          "maxItems": 1000,
          "minItems": 0,
          "x-maxLength": 1000,
          "x-minLength": 0
        },
        "gray_fail_threshold": {
          "type": "integer",
          "format": "int32",
          "description": "灰度失败阈值,灰度执行失败次数达到该值时,不执行下一批任务。只支持脚本执行。",
          "minimum": 1,
          "maximum": 1000
        },
        "life_cycle_type": {
          "type": "string",
          "description": "触发场景。POST_CREATE_DESKTOP_SUCCESS:创建桌面成功后,POST_REBUILD_DESKTOP_SUCCESS:重建桌面成功后,POST_REATTACH_DESKTOP_SUCCESS:触发重建的分配用户任务成功后,POST_DESKTOP_DISCONNECTED:桌面断开连接后。",
          "minLength": 0,
          "maxLength": 255
        },
        "time_zone": {
          "type": "string",
          "example": "Asia/Shanghai",
          "description": "时区。",
          "minLength": 0,
          "maxLength": 2000
        }
      },
      "description": "定时任务时间配置。"
    }
  },
  "version": "2.0",
  "parameters": {},
