          "type": "boolean",
          "description": "是否处于管理员维护模式。"
        },
        "desktop_name_policy_id": {
          "type": "string",
          "description": "策略id,用于指定生成桌面名称策略。",
          "minLength": 0,
          "maxLength": 36
