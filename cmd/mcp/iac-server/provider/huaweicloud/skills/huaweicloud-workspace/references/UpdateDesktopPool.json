          "maxLength": 128
        },
        "value": {
          "type": "string",
          "description": "标签的值,最大长度43个unicode字符。标签的值可以包含任意语种字母、数字、空格和_.:=+-@,但首尾不能含有空格。",
          "minLength": 0,
          "maxLength": 43,
          "default": ""
        }
      },
      "description": "标签。"
    },
    "UpdateDesktopPoolAttributesReq": {
      "properties": {
        "name": {
          "type": "string",
          "description": "桌面池名称,桌面池名称必须保证唯一。桌面名称只允许输入中文、大写字母、小写字母、数字、中划线,长度范围为1~64。",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "description": "桌面池描述。",
          "minLength": 0,
          "maxLength": 255
        },
        "ou_name": {
