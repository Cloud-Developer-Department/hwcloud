        "throughput": {
          "type": "integer",
          "description": "吞吐量,磁盘每秒成功传送的数据量,即读取和写入的数据量。",
          "minimum": 0,
          "maximum": 4095000
        },
        "kms_id": {
          "type": "string",
          "description": "kms密钥id。变更密钥时传入密钥id;如需删除密钥则传入空字符串;默认null,不变更密钥。",
          "minLength": 0,
          "maxLength": 255
