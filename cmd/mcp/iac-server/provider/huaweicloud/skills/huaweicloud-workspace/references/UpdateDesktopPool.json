      "properties": {
        "autoscale_type": {
          "type": "string",
          "description": "弹性伸缩类型,ACCESS_CREATED:接入时创建,AUTO_CREATED:弹性伸缩。",
          "minLength": 0,
          "maxLength": 55,
          "enum": [
            "ACCESS_CREATED",
            "AUTO_CREATED"
          ]
        },
        "max_auto_created": {
          "type": "integer",
          "description": "最大自动创建桌面数。",
          "minimum": 1,
          "maximum": 5000
        },
        "min_idle": {
          "type": "integer",
          "description": "预留空闲桌面数。",
          "minimum": 0,
          "maximum": 5000
        },
        "once_auto_created": {
          "type": "integer",
          "description": "一次自动创建桌面的数量(已弃用)。",
          "minimum": 1,
          "maximum": 100
        },
        "min_retention": {
          "type": "integer",
          "description": "最小桌面数。",
          "minimum": 0,
          "maximum": 5000
        },
        "idle_retention_duration": {
          "type": "integer",
          "description": "空闲桌面保留时长(分钟)。",
          "minimum": 0,
          "maximum": 43200
        },
        "auto_isolation_enable": {
          "type": "boolean",
          "description": "自动故障隔离开关。"
        },
        "auto_isolation_max_num": {
          "type": "integer",
          "description": "自动隔离桌面数量上限,默认上限1000。",
          "minimum": 1
        }
      },
      "description": "弹性伸缩策略。"
    },
    "DesktopPoolVolumeInfo": {
      "required": [
        "id",
        "type"
