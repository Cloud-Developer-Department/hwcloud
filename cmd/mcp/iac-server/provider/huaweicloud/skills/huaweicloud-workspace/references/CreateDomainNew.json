          "readOnly": true
        }
      },
      "description": "API响应基类。"
    },
    "DomainType": {
      "type": "string",
      "description": "域类型\nKERBEROS:对接AD\nOPEN_API:使用OPEN_API的方式对接统信域控",
      "enum": [
        "KERBEROS",
        "OPEN_API"
      ]
    },
    "TlsConfig": {
      "properties": {
        "cert_pem": {
          "type": "string",
          "description": "pem内容, 有则更新,无则上传。查询不返回。",
          "minLength": 0,
          "maxLength": 8192
        },
        "cert_start_time": {
          "type": "string",
          "description": "证书生效开始时间,时间参考样例 2022-01-25T09:24:27。",
          "minLength": 0,
          "maxLength": 255
