  "definitions": {
    "DomainController": {
      "required": [
        "dc_ip",
        "dc_name"
      ],
      "properties": {
        "dc_ip": {
          "type": "string",
          "description": "域控制器IP地址。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "dc_name": {
          "type": "string",
          "description": "域控制器名称。",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "description": "域控制器信息。"
    },
    "AdDomain": {
      "required": [
        "domain_type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "域id。"
        },
        "domain_type": {
          "type": "string",
          "description": "域类型。\n- LITE_AS:本地认证。\n- LOCAL_AD:本地AD。\n说明:域类型为“LOCAL_AD”时,请确保所选VPC网络与AD所属网络可连通。",
          "minLength": 1,
          "maxLength": 55,
          "enum": [
            "LITE_AS",
            "LOCAL_AD"
          ]
        },
        "domain_name": {
          "type": "string",
          "description": "域名称。域类型为LOCAL_AD时需要配置。\n域名必须为AD服务器上已经存在的域名,且长度不超过55。",
          "minLength": 1,
          "maxLength": 55
        },
        "domain_admin_account": {
          "type": "string",
          "description": "域管理员账号。域类型为LOCAL_AD时需要配置。\n必须为AD服务器上已经存在的域管理员账号。",
          "minLength": 1,
          "maxLength": 55
        },
        "domain_password": {
          "type": "string",
          "description": "域管理员账号密码。域类型为LOCAL_AD时需要配置。",
          "minLength": 1,
          "maxLength": 255,
          "x-isSensitive": true
        },
        "active_domain_ip": {
          "type": "string",
          "description": "主域控制器IP地址。域类型为LOCAL_AD时需要配置。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "active_domain_name": {
          "type": "string",
          "description": "主域控制器名称。域类型为LOCAL_AD时需要配置。",
          "minLength": 1,
          "maxLength": 55
        },
        "standby_domain_ip": {
          "type": "string",
          "description": "备域控制器IP地址。域类型为LOCAL_AD时且配置备节点时需要配置。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "standby_domain_name": {
          "type": "string",
          "description": "备域控制器名称。域类型为LOCAL_AD时且配置备节点时需要配置。",
          "minLength": 0,
          "maxLength": 55
        },
        "active_dns_ip": {
          "type": "string",
          "description": "主DNS IP地址。域类型为LOCAL_AD时需要配置。",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "standby_dns_ip": {
          "type": "string",
          "description": "备DNS IP地址。域类型为LOCAL_AD时且配置备节点时需要配置。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^((\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])\\.){3}(\\d{1,2}|1\\d\\d|2[0-4]\\d|25[0-5])$"
        },
        "delete_computer_object": {
          "type": "integer",
          "format": "int32",
          "description": "是否在删除桌面的同时删除AD上对应的计算机对象,0代表不删除,1代表删除。",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "use_ldaps": {
          "type": "boolean",
          "description": "是否开启LDAPS。",
          "default": false,
          "x-hcs-ignore": true
        },
        "tls_config": {
          "$ref": "#/definitions/TlsConfig"
        },
        "cba_enabled": {
          "type": "boolean",
          "description": "是否开启智能卡认证。"
        },
        "certificate_id": {
          "type": "string",
          "description": "智能卡证书id。",
          "minLength": 0,
          "maxLength": 255
        },
        "domain_controllers": {
          "type": "array",
          "description": "域控制器信息列表。有值时,active_domain_name、active_domain_ip、standby_domain_name、standby_domain_ip无效。",
          "items": {
            "$ref": "#/definitions/DomainController"
          },
          "maxItems": 1000,
          "minItems": 0,
          "x-maxLength": 1000,
          "x-minLength": 0
        }
      },
      "description": "域信息。"
    },
