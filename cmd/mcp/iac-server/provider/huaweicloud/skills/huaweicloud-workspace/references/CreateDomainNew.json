          "minLength": 1,
          "maxLength": 255
        },
        "internal_service_address": {
          "type": "string",
          "example": "https://127.0.0.1:4435",
          "description": "域管内部服务地址。",
          "minLength": 1,
          "maxLength": 255
        },
        "app_cert": {
          "type": "string",
          "description": "客户端证书公钥。",
          "minLength": 0,
          "maxLength": 4096,
          "x-isSensitive": true
        },
        "app_cert_key": {
          "type": "string",
          "description": "客户端证书私钥。",
          "minLength": 0,
          "maxLength": 4096,
          "x-isSensitive": true
        },
        "openapi_ca_cert": {
          "type": "string",
          "description": "服务端CA。",
          "minLength": 0,
          "maxLength": 4096,
          "x-isSensitive": true
        }
      }
