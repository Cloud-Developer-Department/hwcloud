  "definitions": {
    "CreateDesktopRsp": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "创建云桌面总任务id。",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "description": "创建按需桌面时的响应体,可根据job_id查询资源是否创建成功。"
    },
    "Tag": {
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "标签的键,不能为空,最大长度128个unicode字符。标签的键可以包含任意语种字母、数字、空格和_.:=+-@,但首尾不能含有空格,不能以_sys_开头。",
          "minLength": 0,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "description": "标签的值,最大长度43个unicode字符。标签的值可以包含任意语种字母、数字、空格和_.:=+-@,但首尾不能含有空格。",
          "minLength": 0,
          "maxLength": 43,
          "default": ""
        }
      },
      "description": "标签。"
    },
    "CreateDesktopReq": {
      "required": [
        "desktop_type",
        "image_id",
        "image_type",
        "product_id",
        "root_volume"
      ],
      "properties": {
        "desktop_type": {
          "type": "string",
          "description": "云桌面类型。\n- DEDICATED:专属桌面,单用户。\n- SHARED: 多用户共享桌面。",
          "minLength": 0,
          "maxLength": 255,
          "enum": [
            "DEDICATED",
            "SHARED"
          ]
        },
        "availability_zone": {
          "type": "string",
          "description": "可用分区。将桌面创建到指定的可用分区。",
          "minLength": 0,
          "maxLength": 255
        },
        "product_id": {
          "type": "string",
          "description": "套餐ID。",
          "minLength": 1,
          "maxLength": 255
        },
        "buy_type": {
          "type": "string",
          "description": "console页面购买方式。默认值为custom。\n\n- speed:快速购买。\n- custom:自定义购买。",
          "minLength": 1,
          "maxLength": 55,
          "default": "custom"
        },
        "image_type": {
          "type": "string",
          "description": "镜像类型。默认值为private。\n\n- private:私有镜像。\n- gold:公共镜像。",
          "minLength": 1,
          "maxLength": 55,
          "default": "private"
        },
        "image_id": {
          "type": "string",
          "description": "镜像ID,用于私有镜像创建桌面场景,配合product_id使用。",
          "minLength": 1,
          "maxLength": 255
        },
        "root_volume": {
          "description": "系统盘。",
          "$ref": "#/definitions/Volume"
        },
        "data_volumes": {
          "type": "array",
          "description": "数据盘列表。",
          "items": {
            "$ref": "#/definitions/Volume"
          },
          "maxItems": 10,
          "minItems": 0,
          "x-maxLength": 10,
          "x-minLength": 0
        },
        "nics": {
          "type": "array",
          "description": "桌面对应的网卡信息,如果不指定则使用默认网卡。",
          "items": {
            "$ref": "#/definitions/Nic"
          },
          "maxItems": 5,
          "minItems": 0,
          "x-maxLength": 5,
          "x-minLength": 0
        },
        "security_groups": {
          "type": "array",
          "description": "桌面使用的安全组,如果不指定则默认使用桌面代理中指定的安全组。",
          "items": {
            "$ref": "#/definitions/SecurityGroupIdInfo"
          },
          "maxItems": 5,
          "minItems": 0,
          "x-maxLength": 5,
          "x-minLength": 0
        },
        "desktops": {
          "type": "array",
          "description": "创建桌面使用的参数列表。长度为1-100。",
          "items": {
            "$ref": "#/definitions/Desktop"
          },
          "maxItems": 100,
          "minItems": 1,
          "x-maxLength": 100,
          "x-minLength": 0
        },
        "desktop_name": {
          "type": "string",
          "description": "搭配size使用,当size为1时代表桌面名,位数1-15,当size大于1时代表桌面名前缀,位数:1-13。",
          "minLength": 0,
          "maxLength": 15
        },
        "desktop_ips": {
          "type": "array",
          "description": "桌面指定分配的ip地址列表,最小为0,最大为100。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 255
          },
          "maxItems": 100,
          "minItems": 0,
          "x-maxLength": 100,
          "x-minLength": 0
        },
        "size": {
          "type": "integer",
          "description": "创建不分配用户的桌面的个数,和desktops不能同时生效,搭配desktop_name使用。",
          "minimum": 1,
          "maximum": 100
        },
        "email_notification": {
          "type": "boolean",
          "description": "创建成功后是否发送邮件通知桌面用户,默认为true。",
          "default": true,
          "enum": [
            true,
            false
          ]
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID,默认\"0。\"",
          "minLength": 0,
          "maxLength": 36,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "default": "0"
        },
        "ou_name": {
          "type": "string",
          "description": "OU名称,在对接AD时使用,需提前在AD中创建OU。",
          "minLength": 1,
          "maxLength": 255
        },
        "tags": {
          "type": "array",
          "description": "标签列表。",
          "items": {
            "$ref": "#/definitions/Tag"
          },
          "maxItems": 20,
          "minItems": 0,
          "x-maxLength": 20,
          "x-minLength": 0,
          "x-is-registered": "Y"
        },
        "apply_shared_vpc_dedicated_param": {
          "$ref": "#/definitions/ApplySharedVpcDedicatedParam"
        },
        "eip": {
          "description": "EIP信息。",
          "$ref": "#/definitions/Eip"
        },
        "desktop_name_policy_id": {
          "type": "string",
          "description": "策略id,用于指定生成桌面名称策略,如果指定了桌面名称则优先使用指定的桌面名称。",
          "minLength": 0,
          "maxLength": 36
        },
        "hour_package_product_id": {
          "type": "string",
          "description": "桌面小时包套餐ID。",
          "minLength": 1,
          "maxLength": 255
        },
        "hour_package_offering_id": {
          "type": "string",
          "description": "桌面小时包offeringID。",
          "minLength": 1,
          "maxLength": 255
        },
        "if_mount_old_desktop_disk": {
          "type": "boolean",
          "description": "是否在发放新桌面时,挂载旧桌面磁盘为数据盘",
          "default": false,
          "enum": [
            true,
            false
          ]
        },
        "domain": {
          "type": "string",
          "description": "桌面分配的域。",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "description": "创建桌面请求。"
    },
    "Nic": {
      "required": [
        "subnet_id"
      ],
      "properties": {
        "subnet_id": {
          "type": "string",
          "description": "网卡对应的子网ID。",
          "minLength": 0,
          "maxLength": 255
        }
      }
    },
    "SecurityGroupIdInfo": {
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "安全组ID。",
          "minLength": 0,
          "maxLength": 255
        }
      }
    },
    "ApplySharedVpcDedicatedParam": {
      "properties": {
        "address": {
          "type": "string",
          "description": "租户指定的共享Vpc专线地址。",
          "minLength": 0,
          "maxLength": 255
        },
        "port": {
          "type": "integer",
          "description": "租户指定共享Vpc专线地址端口。",
          "minimum": 1025,
          "maximum": 65535
        },
        "availability_zone": {
          "type": "array",
          "description": "开通服务资源使用的可用分区,默认随机使用2个可用区。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 255
          },
          "maxItems": 10,
          "minItems": 0,
          "x-maxLength": 10,
          "x-minLength": 0
        }
      },
      "description": "共享Vpc专线入参。"
    },
    "Volume": {
      "required": [
        "size",
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "桌面数据盘对应的磁盘类型,需要与系统所提供的磁盘类型相匹配。\n\n-SAS:高IO。\n-SSD:超高IO。\n-GPSSD:通用型SSD。",
          "minLength": 1,
          "maxLength": 255
        },
        "size": {
          "type": "integer",
          "description": "磁盘容量,单位GB。系统盘大小范围[80-32760],数据盘范围[10-32760],大小为10的倍数。",
          "minimum": 10,
          "maximum": 32760
        },
        "iops": {
          "type": "integer",
          "description": "iops,云硬盘每秒进行读写的操作次数。",
          "minimum": 0,
          "maximum": 16380000
        },
        "throughput": {
          "type": "integer",
          "description": "吞吐量,云硬盘每秒成功传送的数据量,即读取和写入的数据量。",
          "minimum": 0,
          "maximum": 4095000
        },
        "kms_id": {
          "type": "string",
          "description": "kms密钥id,对创建的磁盘进行加密。",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "description": "磁盘。"
    },
    "BaseResponse": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 0,
          "maxLength": 12
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 0,
          "maxLength": 1000
        },
        "error_detail": {
          "type": "string",
          "description": "错误详情。",
          "minLength": 0,
          "maxLength": 1000
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "加密后的详细拒绝原因,用户可以自行调用STS服务的decode-authorization-message接口进行解密。",
          "readOnly": true
        }
      },
      "description": "API响应基类。"
    },
    "Desktop": {
      "required": [
        "user_name"
      ],
      "properties": {
        "user_name": {
          "type": "string",
          "description": "桌面所属的用户,当桌面创建成功后此用户可以登录该桌面。只允许输入大写字母、小写字母、数字、中划线(-)和下划线(_)。域类型为LITE_AD时,使用小写字母或者大写字母开头,长度范围为[1-20]。当域类型为LOCAL_AD时,用户名可以使用小写字母或者大写字母或者数字开头,长度范围为[1-32]。Windows桌面用户最长支持20个字符,Linux桌面用户最长支持32个字符。",
          "minLength": 1,
          "maxLength": 32,
          "x-isSensitive": true
        },
        "domain": {
          "type": "string",
          "description": "用户所属域。"
        },
        "user_email": {
          "type": "string",
          "description": "合法用户邮箱,桌面创建成功后系统会通过发送邮件的方式通知用户。",
          "minLength": 1,
          "maxLength": 255
        },
        "user_phone": {
          "type": "string",
          "description": "合法用户手机号。",
          "minLength": 1,
          "maxLength": 255
        },
        "user_group": {
          "type": "string",
          "description": "桌面用户所属的用户组。\n\n- sudo:Linux管理员组。\n- default:Linux默认用户组。\n- administrators:Windows管理员组。管理员拥有对该桌面的完全访问权,可以做任何需要的更改(禁用操作除外)。\n- users:Windows标准用户组。标准用户可以使用大多数软件,并可以更改不影响其他用户的系统设置。",
          "minLength": 1,
          "maxLength": 255
        },
        "computer_name": {
          "type": "string",
          "description": "桌面名,桌面名必须保证唯一。桌面名称只允许输入大写字母、小写字母、中文、数字、中划线,以字母或数字开头、不能以中划线结尾,长度范围为1~15(中文字符长度为2,数字及英文字符长度为1)。",
          "minLength": 1,
          "maxLength": 15
        },
        "os_host_name": {
          "type": "string",
          "description": "系统计算机名。",
          "minLength": 1,
          "maxLength": 15
        },
        "desktop_name_prefix": {
          "type": "string",
          "description": "桌面名称前缀,不指定\"computer_name\"时生效。",
          "minLength": 0,
          "maxLength": 5
        },
        "copy_volume_desktop_id": {
          "type": "string",
          "description": "需要拷贝数据盘的桌面ID,如果指定了该参数,那么copy_volume_ids不能为空。",
          "minLength": 0,
          "maxLength": 100
        },
        "copy_volume_ids": {
          "type": "array",
          "description": "需要拷贝数据盘桌面的磁盘ID列表,如果指定了该参数,copy_volume_desktop_id不能为空,且磁盘必须属于该桌面。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 255
          },
          "maxItems": 10,
          "minItems": 0,
          "x-maxLength": 10,
          "x-minLength": 0
        },
        "if_delete_old_desktop": {
          "type": "boolean",
          "description": "是否删除按需旧桌面,值为true时,新发放桌面配置并拷贝磁盘后删除旧桌面",
          "default": false,
          "enum": [
            true,
            false
          ]
        }
      }
    },
    "Eip": {
      "properties": {
        "id": {
          "type": "string",
          "description": "桌面绑定的EIP的id,有值时优先绑定EIP。",
          "minLength": 1,
          "maxLength": 255
        },
        "type": {
          "type": "string",
          "description": "EIP的类型。",
          "minLength": 0,
          "maxLength": 255
        },
        "charge_mode": {
          "type": "string",
          "description": "eip带宽计费模式\n- TRAFFIC:按流量计费。\n- BANDWIDTH:按带宽计费。",
          "minLength": 0,
          "maxLength": 10,
          "enum": [
            "TRAFFIC",
            "BANDWIDTH"
          ]
        },
        "bandwidth_size": {
          "type": "integer",
          "format": "int32",
          "description": "带宽大小。",
          "minimum": 1,
          "maximum": 2000
        }
      },
      "description": "EIP信息。"
    }
  },
