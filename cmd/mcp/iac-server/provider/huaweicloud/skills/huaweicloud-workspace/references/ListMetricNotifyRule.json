{
  "name": "ListMetricNotifyRule",
  "summary": "查询通知规则",
  "tags": "报表统计",
  "productshort": "Workspace",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/statistics/notify-rules": {
      "get": {
        "tags": [
          "Statistics"
        ],
        "summary": "查询通知规则",
        "description": "查询对应指标的通知规则;。",
        "operationId": "ListMetricNotifyRule",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "metric_name",
            "in": "query",
            "description": "指标名称(精确匹配)。",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "x-example": "desktop_idle_duration"
          },
          {
            "name": "rule_id",
            "in": "query",
            "description": "通知规则ID。",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "x-example": "xxxx-x-x-xx"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询的偏移量,默认值0。",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 2147483646,
            "minimum": 0,
            "x-example": "0"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "单次查询的大小[1-100],默认值10。",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 100,
            "minimum": 1,
            "x-example": "10"
          }
        ],
        "responses": {
          "200": {
            "description": "响应成功。",
            "examples": {
              "application/json": {
                "count": 0,
                "items": [
                  {
                    "rule_id": "xxxx-xxxx-xxxx",
                    "metric_name": "desktop_idle_duration",
                    "threshold": 30,
                    "comparison_operator": "",
                    "interval": 1,
                    "enable": true,
                    "notify_object": "urn:smn:REGION_ID:XXX-XXX-XXX:topicName"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListMetricNotifyRuleResp"
            }
          },
          "400": {
            "description": "客户端请求有误。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-apigateway-request-type": "public",
        "x-apig-group": "internal_token,public",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-methodAnnotations": [
          "@EnableAuth",
          "@IamAuthMeta(authLevel = IamAuthLevel.PROJECT, abacAction = \"workspace:statistics:listNotificationRules\", authContextInitializerName = \"workspaceCommonAuthContextInitializer\", needApigwJwtAuthCheck = false, rbac = {\"te_admin\", \"wks_adm\"})",
          "@CtsMeta(serviceType = \"Workspace\", resourceType = \"workspace\", traceName = \"ListMetricNotifyRule\")"
        ]
      }
    }
  },
  "definitions": {
    "ListMetricNotifyRuleResp": {
      "properties": {
        "count": {
          "type": "integer",
          "example": 0,
          "description": "总数。",
          "readOnly": true
        },
        "items": {
          "type": "array",
          "description": "规则列表。",
          "readOnly": true,
          "items": {
            "$ref": "#/definitions/MetricNotifyRule"
          }
        }
      },
      "description": "查询通知规则响应。"
    },
    "MetricNotifyRule": {
      "properties": {
        "rule_id": {
          "type": "string",
          "example": "xxxx-xxxx-xxxx",
          "description": "规则ID。",
          "readOnly": true
        },
        "metric_name": {
          "type": "string",
          "example": "desktop_idle_duration",
          "description": "统计指标名称,目前仅支持固定值:desktop_idle_duration\n* `desktop_idle_duration` -  桌面空闲时长",
          "readOnly": true
        },
        "threshold": {
          "type": "integer",
          "example": 30,
          "description": "统计持续周期(天)。",
          "readOnly": true
        },
        "comparison_operator": {
          "type": "string",
          "example": "",
          "description": "统计指标对应的统计值和threshold进行比较的条件\n* `>=` -  统计指标大于等于threshold时触发\n* `>` -   统计指标大于threshold时触发\n* `=` -  统计指标等于threshold时触发\n* `<=` -  统计指标小于等于threshold时触发\n* `<` -  统计指标小于threshold时触发",
          "readOnly": true
        },
        "interval": {
          "type": "integer",
          "example": 1,
          "description": "触发通知后;下次通知的间隔时间;默认每天一次",
          "readOnly": true
        },
        "enable": {
          "type": "boolean",
          "example": true,
          "description": "启禁用规则 true:启用 false:禁用。",
          "readOnly": true,
          "default": false
        },
        "notify_object": {
          "type": "string",
          "example": "urn:smn:REGION_ID:XXX-XXX-XXX:topicName",
          "description": "通知对象;smn的主题urn。",
          "readOnly": true
        }
      },
      "description": "指标通知规则。"
    },
    "ErrorRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误对象。"
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。",
      "required": true,
      "type": "string",
      "maxLength": 255,
      "minLength": 1,
      "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
      "x-annotations": [
        "@Size(max = 255, min = 1)"
      ]
    }
  },
  "host": "workspace.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
