      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "- 参数解释:请求的唯一标识。\n- 约束限制:UUID格式。\n- 取值范围:不涉及。\n- 默认取值:不涉及。"
        },
        "connection": {
          "description": "- 参数解释:创建二层连接的响应体。\n- 约束限制:不涉及。\n- 取值范围:不涉及。\n- 默认取值:不涉及。",
          "$ref": "#/definitions/Connection"
        }
      }
    },
    "CreateConnectionOption": {
      "type": "object",
      "required": [
        "name",
        "remote_infos",
        "virsubnet_id",
        "vpc_id"
      ],
      "properties": {
        "fixed_ips": {
          "type": "array",
          "example": "[\"1.1.1.1\",\"2.2.2.2\"]",
          "description": "- 参数解释:下联面网口主备IP;ESW实例在本端二层子网中占用的主备接口IP。\n- 约束限制:字符串列表,只能设置两个字符串,且每个字符串内容应该是标准IPv4格式;IP必须在二层子网网段范围内。\n- 取值范围:不涉及。\n- 默认取值:不涉及。",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string",
          "example": "lisiaa",
          "description": "- 参数解释:二层连接的名称。\n- 约束限制:\n  - 长度范围为1~64个字符。\n  - 名称由中文、英文字母、数字、下划线(_)、中划线(-)、点(.)组成。\n- 取值范围:不涉及。\n- 默认取值:不涉及。"
        },
        "remote_infos": {
          "type": "array",
          "example": "[{\"tunnel_ip\":\"3.3.3.3\",\"segmentation_id\":7788,\"tunnel_port\":4788},{\"tunnel_ip\":\"4.4.4.4\",\"segmentation_id\":7788,\"tunnel_port\":4789}]",
          "description": "- 参数解释:远端隧道信息。\n- 约束限制:不涉及。\n- 取值范围:不涉及。\n- 默认取值:不涉及。",
          "items": {
            "$ref": "#/definitions/RemoteInfosOption"
          }
        },
        "virsubnet_id": {
          "type": "string",
          "example": "67d2ed7f-f895-46df-a119-3378a2077efd",
          "description": "- 参数解释:二层连接关联的二层子网ID。\n- 约束限制:\n  - 需要使用本租户下可操作的子网资源的ID;此值即为子网详情中的“网络ID”参数值。\n  - 带“-”的UUID格式。\n- 取值范围:不涉及。\n- 默认取值:不涉及。"
        },
        "vpc_id": {
          "type": "string",
          "example": "6b933ada-1ea9-4df9-9770-c94d0a646bf2",
          "description": "- 参数解释:ESW所在VPC资源ID。\n- 约束限制:\n  - 需要使用本租户下可操作的VPC资源的ID。\n  - 带“-”的UUID格式。\n- 取值范围:不涉及。\n- 默认取值:不涉及。"
        }
      }
    },
    "RemoteInfosResult": {
      "type": "object",
      "required": [
        "segmentation_id",
        "tunnel_ip",
        "tunnel_port",
        "tunnel_type"
      ],
      "properties": {
        "segmentation_id": {
          "type": "integer",
          "format": "int32",
          "example": 11000,
          "description": "- 参数解释:二层连接的隧道号,对应VXLAN网络标识VNI。\n- 约束限制:需与对端VXLAN设置的VNI保持一致。\n- 取值范围:1-16777216。\n- 默认取值:不涉及。"
        },
        "tunnel_ip": {
          "type": "string",
          "description": "- 参数解释:ESW实例的远端隧道IP。\n- 约束限制:不能与已存在的子网IP冲突。\n- 取值范围:标准的IPv4格式,例:192.168.1.1。\n- 默认取值:不涉及。"
        },
        "tunnel_port": {
          "type": "integer",
          "format": "int32",
          "description": "- 参数解释:二层连接的远端隧道端口。\n- 约束限制:不涉及。\n- 取值范围:4789。\n- 默认取值:不涉及。"
        },
        "tunnel_type": {
          "type": "string",
          "description": "- 参数解释:ESW实例的隧道协议类型。\n- 约束限制:不涉及。\n- 取值范围:vxlan。\n- 默认取值:不涉及。"
        }
      }
    },
