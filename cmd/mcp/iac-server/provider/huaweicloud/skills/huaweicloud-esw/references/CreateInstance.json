        },
        "tunnel_info": {
          "description": "- 参数解释:本端隧道信息。\n- 约束限制:不涉及。\n- 取值范围:不涉及。\n- 默认取值:不涉及。",
          "$ref": "#/definitions/TunnelInfoOption"
