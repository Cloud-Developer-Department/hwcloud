          "type": "string"
        },
        "updated": {
          "description": "更新时间,格式为\"yyyy-MM-ddTHH:mm:ssZ\"。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。",
          "type": "string"
        },
        "user_defined": {
