  "definitions": {
    "Erro": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "DBS.200082",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "example": "The available IP addresses in the selected subnet are insufficient.",
          "description": "错误消息。"
        }
      }
    },
    "HtapFlavorInfo": {
      "type": "object",
      "properties": {
        "flavors": {
          "items": {
            "properties": {
              "type": {
                "type": "string",
                "example": "x86",
                "description": "规格类型,取值为arm、x86和generalX86。\n\narm:独享型arm规格。\n\nx86:独享型x86规格。\n\ngeneralX86:通用型X86规格。"
              },
              "vcpus": {
                "type": "string",
                "example": 4,
                "description": "CPU大小。例如:1表示1U。"
              },
              "ram": {
                "type": "string",
                "example": 16,
                "description": "内存大小,单位为GB。"
              },
              "id": {
                "type": "string",
                "example": "de565db8-0a96-37ea-9388-61167624712c",
                "description": "规格ID,该字段唯一。"
              },
              "spec_code": {
                "type": "string",
                "example": "gaussdb.sr-be.xlarge.x86.4",
                "description": "资源规格编码,.同创建指定的flavor_ref。例如:gaussdb.sr-be.xlarge.x86.4。\n\n“gaussdb.sr”代表产品。\n\n“xlarge” 代表计算规格为4U。\n\n“x86” 代表CPU架构为x86。\n\n“4” 表示vCPU和内存为1:4。"
              },
              "version_name": {
                "type": "string",
                "example": 8.0,
                "description": "数据库版本号。"
              },
              "instance_mode": {
                "type": "string",
                "example": "Cluster",
                "description": "实例类型。目前仅支持Cluster、Single。"
              },
              "az_status": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "规格所在AZ的状态,包含以下状态:\n\nnormal:在售。\n\nunsupported:暂不支持该规格。\n\nsellout:售罄。",
                "type": "object"
              }
            }
          },
          "description": "规格信息。",
          "type": "array"
        }
      }
    }
  },
