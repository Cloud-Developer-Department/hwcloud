  "definitions": {
    "MysqlShowProxyResponseV3": {
      "properties": {
        "proxy": {
          "$ref": "#/definitions/MysqlProxyV3",
          "description": "Proxy实例信息。"
        },
        "master_node": {
          "description": "主节点信息。",
          "$ref": "#/definitions/MysqlProxyNodeV3"
        },
        "readonly_nodes": {
          "type": "array",
          "description": "只读节点信息。",
          "items": {
            "$ref": "#/definitions/MysqlProxyNodeV3"
          }
        },
        "htap_nodes": {
          "type": "array",
          "description": "**参数解释**:\n\nHTAP节点信息。\n",
          "items": {
            "$ref": "#/definitions/MysqlProxyNodeV3"
          }
        }
      }
    },
    "MysqlProxyNodes": {
      "properties": {
        "id": {
          "type": "string",
          "description": "Proxy节点ID。"
        },
        "status": {
          "type": "string",
          "description": "Proxy节点状态。\n\n取值范围:\n- ACTIVE,表示节点正常\n- ABNORMAL,表示节点异常\n- FAILED,表示节点失败\n- DELETED,表示节点已删除"
        },
        "name": {
          "type": "string",
          "description": "Proxy节点名称。"
        },
        "role": {
          "type": "string",
          "description": "Proxy节点角色:master和slave。"
        },
        "az_code": {
          "type": "string",
          "description": "可用区。"
        },
        "frozen_flag": {
          "type": "integer",
          "format": "int32",
          "description": "Proxy节点是否被冻结。\n\n取值范围:\n- 0-未冻结\n- 1-冻结\n- 2-冻结删除"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "MysqlProxyNodeV3": {
      "properties": {
        "id": {
          "type": "string",
          "description": "节点ID。"
        },
        "instance_id": {
          "type": "string",
          "description": "实例ID。"
        },
        "status": {
          "type": "string",
          "description": "节点状态。"
        },
        "name": {
          "type": "string",
          "description": "节点名称。"
        },
        "weight": {
          "type": "integer",
          "format": "int32",
          "description": "节点读写分离读权重。"
        },
        "availability_zone": {
          "description": "主实例所有节点的可用区信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MysqlProxyAvailable"
          }
        }
      }
    },
    "MysqlProxyV3": {
      "properties": {
        "pool_id": {
          "type": "string",
          "description": "Proxy实例ID。"
        },
        "status": {
          "type": "string",
          "description": "Proxy实例开启状态。\n\n取值:\n- “ACTIVE”,表示数据库代理正常;\n- “FAILED”,表示数据库代理创建失败;\n- “DELETED”,表示数据库代理已删除;\n- “ABNORMAL”,表示数据库代理异常;\n- “ENABLING PROXY”,表示数据库代理正在开启;\n- “DISABLING PROXY”,表示数据库代理正在关闭;\n- “ADDING PROXY NODE”,表示数据库代理正在扩容;\n- “DELETING READ REPLICAS FROM PROXY”,表示数据库代理正在移除只读节点;\n- “ADDING READ REPLICAS TO PROXY”,表示数据库代理正在添加只读节点;\n- “CHANGING WEIGHTS”,表示数据库代理正在修改只读节点权重。"
        },
        "address": {
          "type": "string",
          "description": "Proxy读写分离地址。"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "description": "Proxy端口信息。"
        },
        "pool_status": {
          "type": "string",
          "description": "Proxy实例状态。\n\n取值范围:\n- ACTIVE,表示数据库代理正常\n- ABNORMAL,表示数据库代理异常\n- FAILED,表示数据库代理创建失败\n- DELETED,表示数据库代理已删除"
        },
        "delay_threshold_in_seconds": {
          "type": "integer",
          "format": "int32",
          "description": "延时阈值,单位:秒。"
        },
        "elb_vip": {
          "type": "string",
          "description": "Elb模式的虚拟ip信息。"
        },
        "eip": {
          "type": "string",
          "description": "弹性公网IP信息。"
        },
        "vcpus": {
          "type": "string",
          "description": "Proxy实例规格的CPU数量。"
        },
        "ram": {
          "type": "string",
          "description": "Proxy实例规格的内存数量。"
        },
        "node_num": {
          "type": "integer",
          "format": "int32",
          "description": "Proxy节点个数。"
        },
        "type": {
          "type": "string",
          "description": "**参数解释**:\n\n数据库代理读写模式。\n\n**取值范围**:\n\n- readwrite:读写模式\n- readonly:只读模式\n",
          "enum": [
            "readwrite",
            "readonly"
          ]
        },
        "created_at": {
          "type": "string",
          "description": "数据库代理创建时间。"
        },
        "updated_at": {
          "type": "string",
          "description": "数据库代更新时间。"
        },
        "support_ap_node": {
          "type": "boolean",
          "description": "是否支持HTAP节点。"
        },
        "mode": {
          "type": "string",
          "description": "Proxy主备模式,取值范围:Cluster。"
        },
        "nodes": {
          "description": "Proxy节点信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MysqlProxyNodes"
          }
        },
        "flavor_ref": {
          "description": "Proxy规格信息。",
          "type": "string"
        },
        "name": {
          "description": "Proxy实例名称。",
          "type": "string"
        },
        "transaction_split": {
          "description": "Proxy事务拆分开关状态【ON/OFF】。",
          "type": "string"
        },
        "connection_pool_type": {
          "description": "连接池类型。\n\n取值范围:\n- CLOSED: 关闭连接池。\n- SESSION: 开启会话级连接池。",
          "type": "string"
        },
        "switch_connection_pool_type_enabled": {
          "description": "数据库代理版本是否支持会话级连接池。\n\n取值范围:\n- true: 支持。\n- false: 不支持。",
          "type": "boolean"
        },
        "route_mode": {
          "type": "integer",
          "format": "int32",
          "description": "数据库代理路由模式,默认为权重负载模式。\n\n取值范围:\n- 0,表示权重负载模式;\n- 1,表示负载均衡模式(数据库主节点不接受读请求);\n- 2,表示负载均衡模式(数据库主节点接受读请求)。"
        },
        "balance_route_mode_enabled": {
          "description": "数据库代理版本是否支持负载均衡模式。\n\n取值范围:\n- true 支持;\n- false 不支持。",
          "type": "boolean"
        },
        "consistence_mode": {
          "type": "string",
          "description": "一致性模式。默认值为空,此时以会话一致性参数session_consistence为准。\n- session: 会话一致性。\n- global: 全局一致性。\n- eventual: 最终一致性。"
        },
        "subnet_id": {
          "type": "string",
          "description": "数据库代理所属的子网ID。"
        },
        "ssl_option": {
          "type": "string",
          "description": "SSL数据加密开关设置。\n\n取值范围:\n- true: 开启SSL数据加密。\n- false: 关闭SSL数据加密。"
        },
        "new_node_auto_add_status": {
          "type": "string",
          "description": "新增节点是否自动加入该Proxy。\n\n取值范围:\n- ON:自动加入。\n- OFF:不自动加入。"
        },
        "new_node_weight": {
          "type": "integer",
          "format": "int32",
          "description": "新增节点的读权重。"
        }
      }
    },
    "MysqlProxyAvailable": {
      "properties": {
        "code": {
          "type": "string",
          "description": "可用区编码。"
        },
        "description": {
          "type": "string",
          "description": "可用区描述。"
        }
      }
    },
    "MysqlShowProxyListResponse": {
      "properties": {
        "proxy_list": {
          "type": "array",
          "description": "Proxy实例信息列表。",
          "items": {
            "$ref": "#/definitions/MysqlShowProxyResponseV3"
          }
        }
      }
    }
  },
