  "definitions": {
    "StarRocksCreateRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "htap-eca5",
          "description": "实例名称。同一租户下,同类型的实例名可重名。\n\n取值范围:最小为4个字符,最大为64个字符且不超过64个字节,必须以字母开头,区分大小写,可以包含字母、数字、中划线、下划线,不能包含其他特殊字符。不支持中文名。"
        },
        "engine": {
          "properties": {
            "type": {
              "type": "string",
              "example": "star-rocks",
              "description": "引擎类型。仅支持star-rocks。"
            },
            "version": {
              "type": "string",
              "example": 1,
              "description": "引擎大版本号。"
            }
          },
          "description": "引擎信息。",
          "required": [
            "type",
            "version"
          ]
        },
        "ha": {
          "properties": {
            "mode": {
              "type": "string",
              "example": "Single",
              "description": "部署模式。",
              "enum": [
                "Single",
                "Cluster"
              ]
            }
          },
          "description": "部署信息。",
          "required": [
            "mode"
          ]
        },
        "fe_flavor_id": {
          "type": "string",
          "example": "b44cfde6-d250-313c-8d7a-cd216f071658",
          "description": "FE节点规格ID。使用可通过查询HTAP规格响应消息中的“id”。"
        },
        "be_flavor_id": {
          "type": "string",
          "description": "BE节点规格ID。使用可通过查询HTAP规格响应消息中的“id”。",
          "example": "b44cfde6-d250-313c-8d7a-cd216f071658"
        },
        "db_root_pwd": {
          "type": "string",
          "example": "Test@123!",
          "description": "数据库密码。\n\n取值范围:至少包含以下字符的三种:大小写字母、数字和特殊符号~!@#$%^*-_=+?,()&|.,长度8~32个字符。 建议您输入高强度密码,以提高安全性,防止出现密码被暴力破解等安全风险。如果您输入弱密码,系统会自动判定密码非法。",
          "pattern": "^[a-zA-Z\\d~!@,$#%\\^\\-\\*_=\\+\\?\\|\\.]{8,32}$"
        },
        "fe_count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "FE节点数。\n- 单机时固定为1\n- 集群时取值[3, 10]"
        },
        "be_count": {
          "type": "integer",
          "format": "int32",
          "description": "BE节点数。\n- 单机时固定为1\n- 集群时取值[3, 10]",
          "example": 1
        },
        "az_mode": {
          "type": "string",
          "example": "single",
          "description": "可用区类型。\n当前仅支持single。",
          "enum": [
            "single"
          ]
        },
        "fe_volume": {
          "properties": {
            "io_type": {
              "type": "string",
              "example": "SSD",
              "description": "磁盘类型。通过查询HTAP引擎资源返回消息获取。"
            },
            "capacity_in_gb": {
              "type": "integer",
              "format": "int32",
              "minimum": 50,
              "maximum": 1000,
              "example": 50,
              "description": "磁盘容量,单位GB\n增长的步长:10GB。"
            }
          },
          "description": "FE节点存储规格。",
          "required": [
            "io_type",
            "capacity_in_gb"
          ]
        },
        "be_volume": {
          "description": "BE节点存储规格。",
          "properties": {
            "io_type": {
              "type": "string",
              "description": "磁盘类型。通过查询HTAP引擎资源返回消息获取。"
            },
            "capacity_in_gb": {
              "type": "integer",
              "format": "int32",
              "minimum": 50,
              "maximum": 32000,
              "description": "磁盘容量,单位GB\n增长的步长:10GB。"
