{
  "name": "CreateGaussMySqlProxy",
  "summary": "开启数据库代理",
  "tags": "数据库代理",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/proxy": {
      "post": {
        "tags": [
          "数据库代理"
        ],
        "operationId": "CreateGaussMySqlProxy",
        "summary": "开启数据库代理",
        "description": "开启数据库代理,只支持ELB模式。",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言。",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "61a4ea66210545909d74a05c27a7179ein07"
          },
          {
            "name": "CreateMysqlProxyRequest",
            "in": "body",
            "description": "请求体",
            "schema": {
              "$ref": "#/definitions/OpenMysqlProxyRequestBody"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/MysqlJobId"
            },
            "examples": {
              "application/json": {
                "job_id": "04efe8e2-9255-44ae-a98b-d87cae411890"
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "开启数据库代理,代理实例规格2U8GB,代理模式只读模式。",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/instances/43e4feaab48f11e89039fa163ebaa7e4br01/proxy",
        "x-request-examples-1": {
          "flavor_ref": "gaussdb.mysql.large.x86.4",
          "node_num": 2,
          "proxy_name": "gaussdb-proxy",
          "proxy_mode": "readonly",
          "route_mode": 0,
          "nodes_read_weight": [
            {
              "id": "45021bf73a244312a3f2af95092feeecno07",
              "weight": 50
            },
            {
              "id": "d78a65690cea4af5ad14585e110ff89bno07",
              "weight": 400
            }
          ],
          "subnet_id": "6991d82d-9166-4aff-a1fa-d2a8748b7084"
        }
      }
    }
  },
  "definitions": {
    "MysqlJobId": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID。",
          "example": "6ad4eb1f-73bd-4876-aa31-aa9a1e41c4bc"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "NodesWeight": {
      "properties": {
        "id": {
          "type": "string",
          "description": "数据库节点ID。"
        },
        "weight": {
          "type": "integer",
          "description": "权重。取值范围:0~1000。"
        }
      }
    },
    "OpenMysqlProxyRequestBody": {
      "required": [
        "flavor_ref",
        "node_num"
      ],
      "properties": {
        "flavor_ref": {
          "type": "string",
          "description": "代理规格码。"
        },
        "node_num": {
          "type": "integer",
          "format": "int32",
          "description": "代理实例节点数,取值整数2-32。"
        },
        "proxy_name": {
          "type": "string",
          "format": "int32",
          "description": "代理实例名称。用于表示实例的名称,同一租户下,同类型的实例名可重名。\n\n取值范围:最小为4个字符,最大为64个字符且不超过64个字节(注意:一个中文字符占用3个字节),必须以字母或中文开头,区分大小写,可以包含字母、数字、中划线、下划线或中文,不能包含其他特殊字符。"
        },
        "proxy_mode": {
          "type": "string",
          "format": "int32",
          "description": "代理实例类型。默认类型为readwrite。",
          "enum": [
            "readwrite",
            "readonly"
          ]
        },
        "route_mode": {
          "type": "integer",
          "format": "int32",
          "description": "数据库代理路由模式,默认为权重负载模式。\n\n取值范围:\n- 0,表示权重负载模式;\n- 1,表示负载均衡模式(数据库主节点不接受读请求);\n- 2,表示负载均衡模式(数据库主节点接受读请求)。"
        },
        "nodes_read_weight": {
          "type": "array",
          "description": "数据库节点的读权重设置。\n\n在proxy_mode为readonly时,只能为只读节点选择权重。",
          "items": {
            "$ref": "#/definitions/NodesWeight"
          }
        },
        "subnet_id": {
          "type": "string",
          "description": "数据库VPC下的子网ID。"
        },
        "new_node_auto_add_status": {
          "type": "string",
          "description": "是否开启新增节点自动加入该Proxy。如果需要设置是否开启新增节点自动加入该Proxy,请联系客服人员添加白名单,加入白名单后,方可输入该字段。\n\n取值范围:\n- ON:开启。\n- OFF:关闭。"
        },
        "new_node_weight": {
          "type": "integer",
          "format": "int32",
          "description": "新增节点的读权重:\n  \n- 如果路由模式为0,新增节点自动加入为ON,取值为0~1000。\n- 如果路由模式不为0或新增节点自动加入为OFF,则可不输入读权重。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}