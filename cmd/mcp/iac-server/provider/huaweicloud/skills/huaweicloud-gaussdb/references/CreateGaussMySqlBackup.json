        "tags": [
          "备份管理"
        ],
        "operationId": "CreateGaussMySqlBackup",
        "summary": "创建手动备份",
        "description": "创建手动备份。",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言。",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "MysqlCreateBackupRequest",
            "in": "body",
            "description": "请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/MysqlCreateBackupRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/MysqlCreateBackupResponse"
            },
            "examples": {
              "application/json": {
                "backup": {
                  "id": "2f4ddb93-b901-4b08-93d8-1d2e472f30fe",
                  "name": "backup-1",
                  "description": "手动备份",
                  "begin_time": "2020-07-07T01:17:05+0800",
