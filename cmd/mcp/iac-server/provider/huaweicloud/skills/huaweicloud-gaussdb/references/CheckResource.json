  "definitions": {
    "CheckResourceInfo": {
      "description": "资源信息。",
      "properties": {
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。action为createInstance时必填。"
        },
        "instance_num": {
          "type": "integer",
          "description": "实例数量。action为createInstance时必填。"
        },
        "mode": {
          "type": "string",
          "description": "实例类型,目前仅支持Cluster。action为createInstance时必填。"
        },
        "availability_zone_mode": {
          "type": "string",
          "description": "可用区类型,单可用区single或多可用区multi。action为createInstance时必填。"
        },
        "node_num": {
          "type": "integer",
          "description": "节点数量。action为createInstance、createReadonlyNode时必填。"
        },
        "flavor_ref": {
          "type": "string",
          "description": "规格码。action为createInstance、resizeFlavor时必填。"
        },
        "availability_zone": {
          "type": "string",
          "description": "可用区码。"
        },
        "subnet_id": {
          "type": "string",
          "description": "子网ID。action为createInstance时必填。"
        },
        "instance_id": {
          "type": "string",
          "description": "实例ID。action为createReadonlyNode、resizeFlavor时必填。"
        }
      }
    },
    "CheckResourceResp": {
      "properties": {
        "result": {
          "type": "boolean",
          "description": "结果。\n- true:表示通过。\n- false:表示不通过。"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "CheckResourceRequestBody": {
      "required": [
        "action",
        "resource"
      ],
      "properties": {
        "action": {
          "type": "string",
          "description": "校验类型。\n- createInstance:校验创建实例。\n- createReadonlyNode:校验创建只读节点。\n- resizeFlavor:校验规格变更。"
        },
        "resource": {
          "$ref": "#/definitions/CheckResourceInfo"
        }
      }
    }
  },
