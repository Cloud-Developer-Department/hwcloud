        "destination_region": {
          "type": "string",
          "description": "设置跨区域备份策略的目标区域。"
        },
        "keep_days": {
          "type": "integer",
          "description": "指定已生成的备份文件可以保存的天数。\n\n取值范围:1~1825。"
        }
