        "open_incremental_backup",
        "destination_project_id",
        "destination_region",
        "keep_days"
      ],
      "properties": {
        "open_auto_backup": {
          "type": "boolean",
          "description": "是否开启跨区域全量备份。\n- true:开启跨区域全量备份。\n- false:关闭跨区域全量备份。"
        },
        "open_incremental_backup": {
          "type": "boolean",
          "description": "是否开启跨区域增量备份。\n- true:开启跨区域增量备份,当open_auto_backup开启时才可以开启。\n- false:关闭跨区域增量备份。"
        },
        "destination_project_id": {
          "type": "string",
          "description": "设置跨区域备份策略的目标project ID。\n\n  租户在某一Region下的project ID。                          \n\n  获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。"
