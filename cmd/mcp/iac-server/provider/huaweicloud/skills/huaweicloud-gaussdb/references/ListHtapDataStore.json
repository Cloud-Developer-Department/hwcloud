{
  "name": "ListHtapDataStore",
  "summary": "HTAP引擎资源查询",
  "tags": "HTAP-标准版",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/htap/datastores/{engine_name}": {
      "get": {
        "x-request-examples-url-1": "GET https://{endpoint}/v3/23a50154cf494ec9ad6883979a12db0a/htap/datastores/star-rock",
        "x-request-examples-description-1": "查询StarRocks数据库版本信息",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "HTAP-标准版"
        ],
        "summary": "HTAP引擎资源查询",
        "description": "HTAP引擎资源查询。",
        "operationId": "ListHtapDataStore",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一Region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。"
          },
          {
            "name": "engine_name",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "HTAP引擎名。\n取值范围:\n- star-rocks\n- click-house"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。\n\n通过调用IAM服务[获取用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取。\n\n请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。",
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "内容类型。 取值:application/json。",
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型。默认en-us。\n取值范围:\n- en-us\n- zh-cn",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/SrDataStores"
            },
            "examples": {
              "application/json": {
                "datastores": [
                  {
                    "id": "38197973-8895-36ed-b853-52daeefb6d3a",
                    "name": "3.1",
                    "kernel_version": "3.1.6.0"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/Erro"
            },
            "examples": {
              "application/json": {
                "error_msg": "Invalid database type.",
                "error_code": "DBS.280235"
              }
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/Erro"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "SrDataStores": {
      "type": "object",
      "properties": {
        "datastores": {
          "items": {
            "properties": {
              "id": {
                "type": "string",
                "example": "38197973-8895-36ed-b853-52daeefb6d3a",
                "description": "数据库版本ID,该字段不会有重复。"
              },
              "name": {
                "type": "string",
                "example": 3.1,
                "description": "数据库版本号,只返回两位数的大版本号。"
              },
              "kernel_version": {
                "type": "string",
                "example": "3.1.6.0",
                "description": "数据库内核版本号,返回完整的四位版本号。"
              }
            }
          },
          "description": "数据库信息列表。",
          "type": "array"
        }
      }
    },
    "Erro": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "DBS.200082",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "example": "The available IP addresses in the selected subnet are insufficient.",
          "description": "错误消息。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}