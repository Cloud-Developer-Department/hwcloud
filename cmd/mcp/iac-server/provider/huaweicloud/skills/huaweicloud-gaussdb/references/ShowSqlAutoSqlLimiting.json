  "definitions": {
    "ShowSqlAutoSqlLimitingReq": {
      "properties": {
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "**参数解释**:\n\n节点ID列表。\n\n获取方法请参见[查询实例详情](https://support.huaweicloud.com/api-taurusdb/ShowGaussMySqlInstanceInfoUnifyStatus.html)。\n\n**约束限制**:\n\n节点角色必须为主节点。\n\n**取值范围**:\n\n列表元素为节点ID,只能由英文字母、数字组成,前面为UUID,后缀为no07,长度为36个字符。\n\n**默认取值**:\n\n不涉及。",
          "example": [
            "a4e0f43f6ee2459fa3ac27474cb5991cno07"
          ]
        }
      }
    },
    "ShowSqlAutoSqlLimitingRsp": {
      "properties": {
        "instance_id": {
          "type": "string",
          "description": "**参数解释**:\n\n实例ID,此参数是实例的唯一标识。\n\n**取值范围**:\n\n只能由英文字母、数字组成,后缀为in07,长度为36个字符。\n\n**默认取值**:\n\n不涉及。",
          "x-example": "af315b8e6aaa41799bd9a31f2de15abcin07"
        },
        "auto_sql_limiting_rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NodeSqlAutoSqlLimiting"
          },
          "description": "**参数解释**\n\n节点的自治限流规则。"
        }
      }
    },
    "NodeSqlAutoSqlLimiting": {
      "properties": {
        "node_id": {
          "type": "string",
          "description": "**参数解释**:\n\n节点ID。\n\n**取值范围**:\n\n只能由英文字母、数字组成,前面为UUID,后缀为no07,长度为36个字符。\n\n**默认取值**:\n\n不涉及。",
          "example": "c01a5645eb2c4fb6a9373542f5366e50no07"
        },
        "start_time": {
          "type": "string",
          "description": "**参数解释**:\n\n自治限流规则每天生效开始时间。\n\n**取值范围**:\n\n不涉及。\n\n**默认取值**:\n\n不涉及。",
          "example": "00:00"
        },
        "end_time": {
          "type": "string",
          "description": "**参数解释**:\n\n自治限流规则每天生效开始时间。\n\n**取值范围**:\n\n不涉及。\n\n**默认取值**:\n\n不涉及。",
          "example": "01:01"
        },
        "condition": {
          "type": "string",
          "description": "**参数解释**:\n\n限流策略CPU利用率和活跃会话数的关联关系。\n\n**取值范围**:\n\n  - and:且。\n  - or:或。\n\n**默认取值**:\n\n不涉及。",
          "example": "and"
        },
        "cpu_usage": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n\n限流策略CPU利用率。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n[70~100]。\n\n**默认取值**:\n\n不涉及。",
          "example": 70
        },
        "active_sessions": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n\n限流策略活跃会话数。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n[1~5000]。\n\n**默认取值**:\n\n不涉及。",
          "example": 2
        },
        "clear_time": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n\n每次最大限流时长(分钟)。\n\n**取值范围**:\n\n[1~1440]。\n\n**默认取值**:\n\n不涉及。",
          "example": 3
        },
        "duration": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n\n限流策略满足限流条件的事件持续时间(分钟)。\n\n**取值范围**:\n\n[2~60]。\n\n**默认取值**:\n\n不涉及。",
          "example": 30
        },
        "max_concurrency": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n\n最大并发数。\n\n**取值范围**:\n\n[0~1000000000]。\n\n**默认取值**:\n\n不涉及。",
          "example": 10
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    }
  },
