  "definitions": {
    "MysqlExtendInstanceVolumeRequest": {
      "description": "扩容信息",
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "扩容后的容量。包周期实例初始最小磁盘规格为10G,实例所选容量大小必须为10的整数倍,且大于实际使用容量,最大为128000GB.\n\n取值范围:\n扩容时必须大于等于20G;\n缩容时必须大于等于10G。"
        },
        "is_auto_pay": {
          "type": "string",
          "description": "表示是否自动从客户的账户中支付。\n\n- true,为自动支付,默认该方式。\n- false,为手动支付。"
        }
      },
      "type": "object"
    },
    "MysqlExtendInstanceVolumeResponse": {
      "required": [
        "size",
        "order_id"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "扩容后容量。"
        },
        "order_id": {
          "type": "string",
          "description": "订单号。"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
