{
  "name": "ListGaussMySqlInstancesUnifyStatus",
  "summary": "查询实例列表",
  "tags": "实例管理",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3.1/{project_id}/instances": {
      "get": {
        "tags": [
          "实例管理"
        ],
        "summary": "查询实例列表",
        "operationId": "ListGaussMySqlInstancesUnifyStatus",
        "description": "根据指定条件查询实例列表。",
        "x-is-registered": "Y",
        "x-apigateway-ratelimit": "gaussdbformysql01",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务[获取用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取。\n\n请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。\n",
            "type": "string",
            "required": true,
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "请求语言类型。默认en-us。\n取值范围:\n- en-us\n- zh-cn",
            "type": "string",
            "required": false,
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一Region下的project ID。                          \n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "id",
            "in": "query",
            "description": "实例ID。\n“\\*”为系统保留字符,如果id是以“\\*”起始,表示按照“\\*”后面的值模糊匹配,否则,按照id精确匹配查询。不能只传入“\\*”。",
            "type": "string",
            "x-example": "2f7be53812044494a44c08398b188ca3in07"
          },
          {
            "name": "name",
            "in": "query",
            "description": "实例名称。\n\n“\\*”为系统保留字符,如果name是以“\\*”起始,表示按照“\\*”后面的值模糊匹配,否则,按照name精确匹配查询。不能只传入“\\*”。",
            "type": "string",
            "x-example": "gauss_0926"
          },
          {
            "name": "type",
            "in": "query",
            "description": "按照实例类型查询。目前仅支持Cluster。",
            "type": "string",
            "x-example": "Cluster"
          },
          {
            "name": "datastore_type",
            "in": "query",
            "description": "数据库类型,现在只支持gaussdb-mysql。",
            "type": "string",
            "x-example": "gaussdb-mysql"
          },
          {
            "name": "vpc_id",
            "in": "query",
            "description": "虚拟私有云ID。",
            "type": "string",
            "x-example": "f7ee62e2-9705-4523-ba49-a85ea1a1fa87"
          },
          {
            "name": "subnet_id",
            "in": "query",
            "description": "子网的网络ID信息。",
            "type": "string",
            "x-example": "f4254a92-70d3-4c80-b38d-4a72f2a4357c"
          },
          {
            "name": "private_ip",
            "in": "query",
            "description": "读写内网IP地址。",
            "type": "string",
            "x-example": "192.168.0.142"
          },
          {
            "name": "readonly_private_ip",
            "in": "query",
            "description": "读内网IP地址。",
            "type": "string",
            "x-example": "192.168.0.228"
          },
          {
            "name": "proxy_ip",
            "in": "query",
            "description": "读写分离IP地址。",
            "type": "string",
            "x-example": "192.168.0.15"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0(偏移0条数据,表示从第一条数据开始查询),必须为数字,不能为负数。",
            "type": "integer",
            "format": "int32",
            "x-example": "0"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询记录数。默认为100,不能为负数,最小值为1,最大值为100。",
            "type": "integer",
            "format": "int32",
            "x-example": "100"
          },
          {
            "name": "tags",
            "in": "query",
            "description": "根据实例标签键值对进行查询。\n- {key}表示标签键。\n- {value}表示标签值。\n\n如果同时使用多个标签键值对进行查询,中间使用逗号分隔开,表示查询同时包含指定标签键值对的实例。key不能重复,key之间是与的关系。",
            "type": "string",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/MysqlInstanceListUnifyStatus"
            },
            "examples": {
              "application/json": {
                "total_count": 1,
                "instances": [
                  {
                    "id": "61a4ea66210545909d74a05c27a7179ein07",
                    "name": "gaussdb-mysql-instance01",
                    "status": "normal",
                    "port": 3306,
                    "type": "Cluster",
                    "private_ips": [
                      "192.168.0.142"
                    ],
                    "readonly_private_ips": [
                      "192.168.0.228",
                      "192.168.0.165"
                    ],
                    "proxy_ips": [
                      "192.168.0.15"
                    ],
                    "db_user_name": "root",
                    "region": "cn-north-4",
                    "datastore": {
                      "type": "gaussdb-mysql",
                      "version": "8.0",
                      "kernel_version": "2.0.29.1"
                    },
                    "created": "2018-08-20T02:33:49_0800",
                    "updated": "2018-08-20T02:33:49_0800",
                    "volume": {
                      "type": "POOL",
                      "size": 100
                    },
                    "vpc_id": "3cedfc54-b105-4652-a4e0-847b11576b58",
                    "subnet_id": "c1cfa53c-65d3-431e-8552-326bf310c7ad",
                    "security_group_id": "fc577a1a-f202-424a-977f-24faec3fdd55",
                    "flavor_ref": "gaussdb.mysql.c3.small.4",
                    "flavor_info": {
                      "vcpus": 8,
                      "ram": 16
                    },
                    "backup_strategy": {
                      "start_time": "19:00-20:00",
                      "keep_days": 7
                    },
                    "charge_info": {
                      "charge_mode": "postPaid"
                    },
                    "enterprise_project_id": 0,
                    "time_zone": "UTC",
                    "tags": [
                      {
                        "key": "taurusKey1",
                        "value": "value1"
                      }
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "查询TaurusDB实例列表,读写内网IP地址是192.168.0.142。",
        "x-request-examples-url-1": "GET https://{endpoint}/v3.1/054e292c9880d4992f02c0196d3ea468/instances?id=61a4ea66210545909d74a05c27a7179ein07&name=gaussdb-mysql-instance01&type=Cluster&datastore_type=gaussdb-mysql&vpc_id=3cedfc54-b105-4652-a4e0-847b11576b58&subnet_id=c1cfa53c-65d3-431e-8552-326bf310c7ad&private_ip=192.168.0.142&offset=0&limit=10&tags=taurusKey1=value1"
      }
    }
  },
  "definitions": {
    "MysqlFlavorInfo": {
      "required": [
        "vcpus",
        "ram"
      ],
      "description": "flavor规格信息。",
      "properties": {
        "vcpus": {
          "type": "string",
          "description": "CPU核数。"
        },
        "ram": {
          "type": "string",
          "description": "内存大小,单位GB。"
        }
      }
    },
    "MysqlInstanceListInfoUnifyStatus": {
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "实例ID,严格匹配UUID规则。"
        },
        "name": {
          "type": "string",
          "description": "创建的实例名称。"
        },
        "status": {
          "type": "string",
          "description": "实例状态。\n\n取值:\n- 值为“creating”,表示实例正在创建。\n- 值为“normal”,表示实例正常。\n- 值为“abnormal”,表示实例异常。\n- 值为“createfail”,表示实例创建失败。"
        },
        "private_ips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "实例写内网IP地址列表。弹性云服务器创建成功后该值存在,其他情况下为空字列表。"
        },
        "proxy_ips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "实例读写分离IP地址列表。TaurusDB实例开启代理成功后该值存在,其他情况下为空列表。"
        },
        "readonly_private_ips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "实例读内网IP地址列表。弹性云服务器创建成功后该值存在,其他情况下为空列表。"
        },
        "public_ips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "实例外网IP地址列表。"
        },
        "port": {
          "type": "string",
          "description": "数据库端口号。"
        },
        "type": {
          "type": "string",
          "description": "实例类型,取值为“Cluster”。"
        },
        "region": {
          "type": "string",
          "description": "实例所在区域。"
        },
        "datastore": {
          "$ref": "#/definitions/MysqlDatastoreWithKernelVersion"
        },
        "created": {
          "type": "string",
          "description": "创建时间,格式为\"yyyy-mm-ddThh:mm:ssZ\"。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
        },
        "updated": {
          "type": "string",
          "description": "更新时间,格式与\"created\"字段对应格式完全相同。"
        },
        "db_user_name": {
          "type": "string",
          "description": "默认用户名。"
        },
        "vpc_id": {
          "type": "string",
          "description": "虚拟私有云ID。"
        },
        "subnet_id": {
          "type": "string",
          "description": "子网的网络ID信息。"
        },
        "security_group_id": {
          "type": "string",
          "description": "安全组ID。"
        },
        "flavor_ref": {
          "type": "string",
          "description": "规格码。"
        },
        "flavor_info": {
          "$ref": "#/definitions/MysqlFlavorInfo"
        },
        "volume": {
          "$ref": "#/definitions/MysqlVolumeInfo"
        },
        "backup_strategy": {
          "$ref": "#/definitions/MysqlBackupStrategy"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。"
        },
        "time_zone": {
          "type": "string",
          "description": "时区。"
        },
        "charge_info": {
          "$ref": "#/definitions/MysqlChargeInfo"
        },
        "dedicated_resource_id": {
          "type": "string",
          "description": "专属资源池ID,只有数据库实例属于专属资源池才会返回该参数。"
        },
        "tags": {
          "description": "标签列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/InstanceTagItem"
          }
        }
      }
    },
    "MysqlDatastoreWithKernelVersion": {
      "required": [
        "type",
        "version",
        "kernel_version"
      ],
      "description": "数据库信息。",
      "properties": {
        "type": {
          "type": "string",
          "description": "数据库引擎,现在只支持gaussdb-mysql。"
        },
        "version": {
          "type": "string",
          "description": "兼容的开源数据库版本号,返回三位开源版本号。"
        },
        "kernel_version": {
          "type": "string",
          "description": "数据库内核版本"
        }
      }
    },
    "MysqlVolumeInfo": {
      "required": [
        "type",
        "size"
      ],
      "description": "存储盘信息。",
      "properties": {
        "type": {
          "type": "string",
          "description": "磁盘类型。"
        },
        "size": {
          "type": "string",
          "description": "已使用磁盘大小,单位GB。"
        }
      }
    },
    "MysqlBackupStrategy": {
      "required": [
        "start_time"
      ],
      "description": "自动备份策略",
      "properties": {
        "start_time": {
          "type": "string",
          "description": "自动备份开始时间段。自动备份将在该时间一个小时内触发。\n\n取值范围:非空,格式必须为hh:mm-HH:MM且有效,当前时间指UTC时间。\n\n1. HH取值必须比hh大1。\n2. mm和MM取值必须相同,且取值必须为00。",
          "example": "23:00-00:00"
        },
        "keep_days": {
          "type": "string",
          "description": "自动备份保留天数,取值范围:1-732"
        }
      }
    },
    "MysqlChargeInfo": {
      "description": "计费类型信息,支持包年包月和按需,默认为按需。",
      "required": [
        "charge_mode"
      ],
      "properties": {
        "charge_mode": {
          "type": "string",
          "description": "计费模式。\n\n取值范围:\n\n- prePaid:预付费,即包年/包月。\n- postPaid:后付费,即按需付费。",
          "enum": [
            "prePaid",
            "postPaid"
          ]
        },
        "period_type": {
          "type": "string",
          "description": "订购周期类型。\n\n取值范围:\n\n- month:包月。\n- year:包年。\n\n说明:“charge_mode”为“prePaid”时生效,且为必选值。",
          "enum": [
            "month",
            "year"
          ]
        },
        "period_num": {
          "type": "integer",
          "format": "int32",
          "description": "“charge_mode”为“prePaid”时生效,且为必选值,指定订购的时间。\n\n取值范围:\n\n当“period_type”为“month”时,取值为1~9。\n当“period_type”为“year”时,取值为1~3。"
        },
        "is_auto_renew": {
          "type": "string",
          "description": "创建包周期实例时可指定,表示是否自动续订,续订的周期和原周期相同,且续订时会自动支付。\n\n- true,为自动续订。\n- false,为不自动续订,默认该方式。"
        },
        "is_auto_pay": {
          "type": "string",
          "description": "创建包周期时可指定,表示是否自动从客户的账户中支付,此字段不影响自动续订的支付方式。\n\n- true,为自动支付,默认该方式。\n- false,为手动支付。"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "MysqlInstanceListUnifyStatus": {
      "required": [
        "instances",
        "total_count"
      ],
      "properties": {
        "instances": {
          "description": "实例列表信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MysqlInstanceListInfoUnifyStatus"
          }
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "总记录数。"
        }
      }
    },
    "InstanceTagItem": {
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "标签键。"
        },
        "value": {
          "description": "标签值。",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}