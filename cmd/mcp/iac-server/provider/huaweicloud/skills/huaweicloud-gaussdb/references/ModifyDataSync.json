        "tags": [
          "HTAP-标准版"
        ],
        "operationId": "ModifyDataSync",
        "summary": "修改StarRocks数据同步配置",
        "description": "修改StarRocks数据同步配置。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-ratelimit": "gaussdbformysql01",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "**参数解释**:\n\n租户在某一Region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n只能由英文字母、数字组成,且长度为32个字符。\n\n**默认值**:\n\n不涉及。"
          },
          {
            "name": "ModifyDataSyncRequestBody",
            "in": "body",
            "description": "**参数解释**:\n\n修改StarRocks数据同步配置请求体。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n不涉及。\n\n**默认值**:\n\n不涉及。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ModifyDataSyncConfigRequestV3"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "**参数解释**:\n\n用户Token。 通过调用IAM服务[获取用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取。 \n\n请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n不涉及。\n\n**默认值**:\n\n不涉及。",
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": true,
            "description": "**参数解释**:\n\n请求语言类型。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n- en-us\n- zh-cn\n\n**默认值**:\n\nen-us。",
            "type": "string"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "description": "**参数解释**:\n\nStarRocks实例ID,严格匹配UUID规则。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n只能由英文字母、数字组成,后缀为in17,且长度为36个字符。\n\n**默认值**:\n\n不涉及。",
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "**参数解释**:\n\n内容类型。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\napplication/json。\n\n**默认值**:\n\napplication/json。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ModifyDataSyncConfigResponseV3"
            },
            "examples": {
              "application/json": {
                "source_database_name": "source_database_name",
                "target_database_name": "target_database_name",
                "job_id": "job_id",
                "task_name": "task",
                "tbl_config_check_results": [
                  {
                    "table_name": "table",
                    "table_config": "order by id",
                    "check_result": "success"
                  }
                ],
                "source_db_config_check_results": [
                  {
                    "param_name": "enable_chunk_level_dump",
                    "value": "false",
                    "check_result": "success"
                  },
                  {
                    "param_name": "snapshot_with_lock",
                    "value": "true",
                    "check_result": "success"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "DBS.200022",
                "error_msg": "实例不存在"
              }
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "DbConfigCheckResult": {
      "type": "object",
      "description": "库配置校验检查结果。",
      "properties": {
        "param_name": {
          "type": "string",
          "description": "参数名。",
          "minLength": 2,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "description": "参数值。",
          "minLength": 1,
          "maxLength": 64
        },
        "check_result": {
          "type": "string",
          "description": "校验结果。",
          "minLength": 1,
          "maxLength": 1024,
          "enum": [
            "success",
            "fail"
          ]
        }
      }
    },
    "TablesConfig": {
      "type": "object",
      "description": "表配置。",
      "properties": {
        "table_name": {
          "type": "string",
          "description": "表名。",
          "minLength": 0,
          "maxLength": 128
        },
        "table_config": {
          "type": "string",
          "description": "表配置值。",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "TableReplConfig": {
      "type": "object",
      "description": "表同步配置。",
      "properties": {
        "repl_type": {
          "type": "string",
          "description": "表同步类型。include_tables:白名单,exclude_tables:黑名单。",
          "minLength": 2,
          "maxLength": 15,
          "enum": [
            "include_tables",
            "exclude_tables"
          ]
        },
        "repl_scope": {
          "type": "string",
          "description": "表同步范围。all:全量同步,part:部分同步。",
          "default": "all",
          "minLength": 3,
          "maxLength": 5,
          "enum": [
            "all",
            "part"
          ]
        },
        "tables": {
          "type": "array",
          "description": "白名单或黑名单的表范围。",
          "minItems": 0,
          "maxItems": 5000,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1024
          }
        }
      }
    },
    "DbConfig": {
      "type": "object",
      "description": "数据库配置。",
      "properties": {
        "param_name": {
          "type": "string",
          "description": "参数名。",
          "minLength": 2,
          "maxLength": 1024
        },
        "value": {
          "type": "string",
          "description": "参数值。",
          "minLength": 2,
          "maxLength": 1024
        }
      }
    },
    "ModifyDataSyncConfigRequestV3": {
      "type": "object",
      "description": "StarRocks修改配置请求体。",
      "properties": {
        "source_instance_id": {
          "type": "string",
          "description": "**参数解释**:\n\nTaurusDB实例ID。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n只能由英文字母、数字组成,后缀为in07,长度为36个字符。\n\n**默认值**:\n\n不涉及。"
        },
        "source_node_id": {
          "type": "string",
          "description": "**参数解释**:\n\nTaurusDB只读节点ID。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n只能由英文字母、数字组成,后缀为no07,长度为36个字符。\n\n**默认值**:\n\n不涉及。"
        },
        "source_database_name": {
          "type": "string",
          "description": "**参数解释**:\n\nTaurusDB数据库名。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n字符长度限制3~1024位,仅支持英文大小写字母、数字以及下划线。\n\n**默认值**:\n\n不涉及。"
        },
        "task_name": {
          "type": "string",
          "description": "**参数解释**:\n\n数据同步任务名称。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n长度限制3~128位,仅支持英文大小写字母、数字以及下划线。\n\n**默认值**:\n\n不涉及。"
        },
        "db_configs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DbConfig"
          },
          "description": "**参数解释**:\n\n库配置列表。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n不涉及。\n\n**默认值**:\n\n不涉及。"
        },
        "tables_configs": {
          "type": "array",
          "description": "**参数解释**:\n\n表配置信息。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n不涉及。\n\n**默认值**:\n\n不涉及。",
          "items": {
            "$ref": "#/definitions/TablesConfig"
          }
        },
        "table_repl_config": {
          "description": "**参数解释**:\n\n表同步配置信息。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n不涉及。\n\n**默认值**:\n\n不涉及。",
          "$ref": "#/definitions/TableReplConfig"
        },
        "target_database_name": {
          "type": "string",
          "description": "**参数解释**:\n\n目标数据库名。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n长度限制3~128位,仅支持英文大小写字母、数字以及下划线。\n\n**默认值**:\n\n不涉及。"
        },
        "is_instance_level_sync": {
          "type": "string",
          "description": "**参数解释**:\n\n是否支持实例级同步。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n- true:是。\n- false:否。\n\n**默认取值**:\n\nfalse。"
        },
        "database_repl_scope": {
          "type": "string",
          "description": "**参数解释**:\n\n库同步范围。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n- all:同步全部库。\n- part:同步部分库。\n\n**默认取值**:\n\npart。"
        },
        "is_support_reg_exp": {
          "type": "string",
          "description": "**参数解释**:\n\n是否支持通配符。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n- true:支持通配符。\n- false:不支持通配符。\n\n**默认取值**:\n\nfalse。"
        }
      }
    },
    "ModifyDataSyncConfigResponseV3": {
      "type": "object",
      "description": "修改同步配置响应。",
      "properties": {
        "source_database_name": {
          "type": "string",
          "description": "**参数解释**:\n\nTaurusDB数据库名。\n\n**取值范围**:\n\n长度限制3~1024位,仅支持英文大小写字母、数字以及下划线。"
        },
        "target_database_name": {
          "type": "string",
          "description": "**参数解释**:\n\n目标数据库名。\n\n**取值范围**:\n\n长度限制3~1024位,仅支持英文大小写字母、数字以及下划线。"
        },
        "source_db_config_check_results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DbConfigCheckResult"
          },
          "description": "**参数解释**:\n\nTaurusDB数据库配置检查结果。\n\n**取值范围**:\n\n不涉及。"
        },
        "tbl_config_check_results": {
          "type": "array",
          "description": "**参数解释**:\n\n表配置检查结果。\n\n**取值范围**:\n\n不涉及。",
          "items": {
            "$ref": "#/definitions/TableConfigCheckResult"
          }
        },
        "task_name": {
          "type": "string",
          "description": "**参数解释**:\n\n同步任务名称。\n\n**取值范围**:\n\n长度限制3~128位,仅支持英文大小写字母、数字以及下划线。"
        },
        "job_id": {
          "type": "string",
          "description": "**参数解释**:\n\n修改同步配置工作流ID。\n\n**取值范围**:\n\n不涉及。"
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.280292"
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "example": "数据库用户名非法"
        }
      },
      "type": "object"
    },
    "TableConfigCheckResult": {
      "type": "object",
      "description": "表配置校验结果。",
      "properties": {
        "table_name": {
          "type": "string",
          "description": "表名。",
          "minLength": 2,
          "maxLength": 1024
        },
        "table_config": {
          "type": "string",
          "description": "表配置项。",
          "minLength": 2,
          "maxLength": 1024
        },
        "check_result": {
          "type": "string",
          "description": "校验结果。",
          "minLength": 2,
          "maxLength": 10
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
