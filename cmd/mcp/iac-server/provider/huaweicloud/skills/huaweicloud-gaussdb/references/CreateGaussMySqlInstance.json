  "definitions": {
    "MysqlVolumeResp": {
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "description": "磁盘大小。单位GB。\n\n取值范围:10~128000,为10的整数倍。"
        }
      }
    },
    "MysqlInstanceResponse": {
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "实例ID。"
        },
        "name": {
          "type": "string",
          "description": "实例名称。用于表示实例的名称,同一租户下,同类型的实例名称可相同。\n\n取值范围:4~64个字符之间,必须以字母开头,不区分大小写,可以包含字母、数字、中划线或者下划线,\n不能包含其它的特殊字符。"
        },
        "status": {
          "type": "string",
          "description": "实例状态。"
        },
        "datastore": {
          "$ref": "#/definitions/MysqlDatastoreInRes"
        },
        "mode": {
          "type": "string",
          "description": "实例类型,仅支持Cluster。"
        },
        "configuration_id": {
          "type": "string",
          "description": "参数组ID。"
        },
        "port": {
          "type": "string",
          "description": "数据库端口信息。"
        },
        "backup_strategy": {
          "$ref": "#/definitions/MysqlBackupStrategy"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。"
        },
        "region": {
          "type": "string",
          "description": "区域ID,与请求参数相同。"
        },
        "availability_zone_mode": {
          "type": "string",
          "description": "可用区模式,与请求参数相同。"
        },
        "master_availability_zone": {
          "type": "string",
          "description": "主可用区ID。"
        },
        "vpc_id": {
          "type": "string",
          "description": "虚拟私有云ID,与请求参数相同。"
        },
        "security_group_id": {
          "type": "string",
          "description": "安全组ID,与请求参数相同。"
        },
        "subnet_id": {
          "type": "string",
          "description": "子网ID,与请求参数相同。"
        },
        "flavor_ref": {
          "type": "string",
          "description": "规格码,与请求参数相同。"
        },
        "charge_info": {
          "$ref": "#/definitions/MysqlChargeInfo"
        },
        "volume": {
          "description": "volume信息。创建包年/包月实例有返回。",
          "$ref": "#/definitions/MysqlVolumeResp"
        }
      }
    },
    "MysqlCreateInstanceResponse": {
      "required": [
        "instance",
        "job_id"
      ],
      "properties": {
        "instance": {
          "$ref": "#/definitions/MysqlInstanceResponse",
          "description": "实例信息"
        },
        "job_id": {
          "type": "string",
          "description": "实例创建的任务ID。\n\n仅创建按需实例时会返回该参数。",
          "example": "dff1d289-4d03-4942-8b9f-463ea07c000d"
        },
        "order_id": {
          "type": "string",
          "description": "订单号,创建包年包月时返回该参数。"
        }
      }
    },
    "MysqlBackupStrategy": {
      "required": [
        "start_time"
      ],
      "description": "自动备份策略",
      "properties": {
        "start_time": {
          "type": "string",
          "description": "自动备份开始时间段。自动备份将在该时间一个小时内触发。\n\n取值范围:非空,格式必须为hh:mm-HH:MM且有效,当前时间指UTC时间。\n\n1. HH取值必须比hh大1。\n2. mm和MM取值必须相同,且取值必须为00。",
          "example": "23:00-00:00"
        },
        "keep_days": {
          "type": "string",
          "description": "自动备份保留天数,取值范围:1-732"
        }
      }
    },
    "MysqlInstanceRequest": {
      "description": "实例信息",
      "required": [
        "region",
        "name",
        "datastore",
        "mode",
        "flavor_ref",
        "vpc_id",
        "subnet_id",
        "password",
        "availability_zone_mode",
        "slave_count",
        "backup_strategy",
        "charge_info"
      ],
      "properties": {
        "charge_info": {
          "description": "计费类型信息,支持包年包月和按需,默认为按需。\n\n说明:DeC专属云账号不支持创建包周期。",
          "$ref": "#/definitions/MysqlChargeInfo"
        },
        "region": {
          "type": "string",
          "description": "区域ID。"
        },
        "name": {
          "type": "string",
          "description": "实例名称。用于表示实例的名称,同一租户下,同类型的实例名可重名。\n\n取值范围:最小为4个字符,最大为64个字符且不超过64个字节(注意:一个中文字符占用3个字节),必须以字母或中文开头,区分大小写,可以包含字母、数字、中划线、下划线或中文,不能包含其他特殊字符。"
        },
        "datastore": {
          "$ref": "#/definitions/MysqlDatastoreInReq"
        },
        "mode": {
          "type": "string",
          "description": "**参数解释**:  \n\n实例模式。\n\n**约束限制**: \n\n不涉及。\n\n**取值范围**:\n\n- Cluster:集群版。\n- StandSingle:单机版。\n\n**默认取值**:\n\n不涉及。"
        },
        "flavor_ref": {
          "type": "string",
          "description": "规格码。",
          "example": "rds.mysql.s1.large"
        },
        "vpc_id": {
          "type": "string",
          "description": "虚拟私有云ID。"
        },
        "subnet_id": {
          "type": "string",
          "description": "子网的网络ID。"
        },
        "security_group_id": {
          "type": "string",
          "description": "安全组ID。如果实例所选用的子网开启网络ACL进行访问控制,则该参数非必选。如果未开启ACL进行访问控制,则该参数必选。"
        },
        "configuration_id": {
          "type": "string",
          "description": "参数模板ID。",
          "example": "452408-ef4b-44c5-94be-305145fg"
        },
        "password": {
          "type": "string",
          "description": "数据库密码。\n\n取值范围:至少包含以下字符的三种:大小写字母、数字和特殊符号~!@#$%^*-_=+?,()&,长度8~32个字符。\n建议您输入高强度密码,以提高安全性,防止出现密码被暴力破解等安全风险。如果您输入弱密码,系统会自动判定密码非法。"
        },
        "backup_strategy": {
          "$ref": "#/definitions/MysqlBackupStrategy"
        },
        "time_zone": {
          "type": "string",
          "description": "时区。默认时区为UTC。"
        },
        "availability_zone_mode": {
          "type": "string",
          "description": "可用区类型,单可用区single或多可用区multi。"
        },
        "master_availability_zone": {
          "type": "string",
          "description": "主可用区。"
        },
        "slave_count": {
          "type": "integer",
          "format": "int32",
          "description": "只读节点个数。单次接口调用最多支持创建9个只读节点。实例模式取值为StandSingle时取值必须为0。"
        },
        "volume": {
          "description": "**参数解释**:\n\nvolume信息。\n\n**约束限制**:\n\n不涉及。",
          "$ref": "#/definitions/MysqlVolume"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MysqlTags"
          }
        },
        "lower_case_table_names": {
          "type": "integer",
          "format": "int32",
          "description": "表名大小写是否敏感,默认值是“1”。\n\n取值范围:\n- 0:表名被存储成固定且表名称大小写敏感。\n- 1:表名将被存储成小写且表名称大小写不敏感。"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。如果账户开通企业项目服务则该参数必选,未开启该参数不可选。"
        },
        "dedicated_resource_id": {
          "type": "string",
          "description": "专属资源池ID,只有开通专属资源池后才可以下发此参数。"
        },
        "restore_point": {
          "description": "备份恢复信息。",
          "$ref": "#/definitions/MysqlRestorePoint"
        },
        "tde_info": {
          "description": "透明数据加密配置信息,支持AES256、SM4加密算法。\n\n透明加密功能目前处于公测阶段,如需使用,请提交工单联系客服人员申请权限。",
          "$ref": "#/definitions/MysqlTdeInfo"
        }
      }
    },
    "MysqlDatastoreInRes": {
      "required": [
        "type",
        "version"
      ],
      "description": "数据库信息。",
      "properties": {
        "type": {
          "type": "string",
          "description": "数据库引擎,现在只支持gaussdb-mysql。"
        },
        "version": {
          "type": "string",
          "description": "兼容的三位开源数据库版本号。\n\n获取方法请参见[查询数据库引擎的版本](https://support.huaweicloud.com/api-taurusdb/ShowGaussMySqlEngineVersion.html)返回的version字段。"
        },
        "kernel_version": {
          "type": "string",
          "description": "内核数据库版本。\n\n完整的四位内核数据库版本号,获取方法请参见[查询数据库引擎的版本](https://support.huaweicloud.com/api-taurusdb/ShowGaussMySqlEngineVersion.html)返回的kernel_version字段。"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "MysqlDatastoreInReq": {
      "required": [
        "type",
        "version"
      ],
      "description": "数据库信息。",
      "properties": {
        "type": {
          "type": "string",
          "description": "数据库引擎,现在只支持gaussdb-mysql。"
        },
        "version": {
          "type": "string",
          "description": "兼容的三位开源数据库版本号。\n\n获取方法请参见[查询数据库引擎的版本](https://support.huaweicloud.com/api-taurusdb/ShowGaussMySqlEngineVersion.html)返回的version字段。"
        },
        "kernel_version": {
          "type": "string",
