  "definitions": {
    "SqlFilterRulePattern": {
      "description": "SQL限流规则和最大并发数",
      "required": [
        "pattern",
        "max_concurrency"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "description": "**参数解释**:\n\nSQL限流规则。\n\n**取值范围**:\n\n由一个或多个关键字(最多为128个关键字)组成,关键字之间通过\"~\"分隔符分开,如select~from~t1。规则中不能包含‘\\’、中英文逗号、‘~~’,不能以‘~’结尾。"
        },
        "max_concurrency": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n\n最大并发数。\n\n**取值范围**:\n\n不涉及。"
        },
        "cur_concurrency": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 4294967296,
          "description": "**参数解释**:\n\n当前并发数。\n\n**取值范围**:\n\n0 - 4294967296。"
        },
        "cur_reject": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 4294967296,
          "description": "**参数解释**:\n\n当前拦截次数。\n\n**取值范围**:\n\n0 - 4294967296。"
        },
        "create_at": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "**参数解释**:\n\nSQL限流规则创建时间。\n\n**取值范围**:\n\n0 - 9223372036854775807。"
        },
        "expire_at": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "**参数解释**:\n\nSQL限流规则失效时间。\n\n**取值范围**:\n\n0 - 9223372036854775807。"
        }
      }
    },
    "SqlFilterRule": {
      "description": "SQL限流规则。",
      "required": [
        "sql_type",
        "patterns"
      ],
      "properties": {
        "sql_type": {
          "type": "string",
          "description": "Sql限流类型。\n\n取值范围:\n- SELECT\n- UPDATE\n- DELETE",
          "example": "SELECT"
        },
        "patterns": {
          "type": "array",
          "description": "SQL限流具体规则。",
          "items": {
            "$ref": "#/definitions/SqlFilterRulePattern"
          }
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "QuerySqlFilterRuleRsp": {
      "required": [
        "node_id",
        "sql_filter_rules"
      ],
      "description": "查询节点的SQL限流规则返回体",
      "properties": {
        "node_id": {
          "type": "string",
          "description": "节点ID"
        },
        "sql_filter_rules": {
          "type": "array",
          "description": "SQL限流规则",
          "items": {
            "$ref": "#/definitions/SqlFilterRule"
          }
        }
      }
    }
  },
