        },
        "node_id": {
          "type": "string",
          "description": "节点ID。"
        },
        "type": {
          "type": "string",
          "description": "语句类型,取空值,表示查询所有语句类型。\n\n枚举值:\n  - INSERT\n  - UPDATE\n  - SELECT\n  - DELETE\n  - CREATE\n  - ALL"
        },
        "database": {
          "type": "string",
          "description": "数据库名称。数据库名称不支持包含特殊字符 < > & 等的搜索。"
        },
        "start_time": {
          "type": "string",
          "description": "开始日期,格式为“yyyy-mm-ddThh:mm:ssZ”。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。"
        },
        "end_time": {
          "type": "string",
          "description": "结束时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。只能查询当前时间前一个月内的慢日志。"
        },
        "sort": {
          "type": "string",
          "description": "指定排序字段。\n  - executeTime:表示按照平均执行时间降序排序。\n  - 字段为空或传入其他值,表示按照执行次数降序排序。"
        },
        "order": {
          "type": "string",
          "description": "排序顺序。默认desc。\n枚举值:\n  - desc\n  - asc"
        }
      }
    },
