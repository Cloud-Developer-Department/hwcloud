{
  "name": "ShowGaussMySqlBackupPolicy",
  "summary": "查询自动备份策略",
  "tags": "备份管理",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/backups/policy": {
      "get": {
        "tags": [
          "备份管理"
        ],
        "operationId": "ShowGaussMySqlBackupPolicy",
        "summary": "查询自动备份策略",
        "description": "查询自动备份策略。",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。",
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "语言。",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID,严格匹配UUID规则。",
            "required": true,
            "type": "string",
            "x-example": "61a4ea66210545909d74a05c27a7179ein07"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/GetBackupPolicyResponse"
            },
            "examples": {
              "application/json": {
                "backup_policy": {
                  "keep_days": "7,",
                  "start_time": "19:00-20:00",
                  "period": "1,2",
                  "retention_num_backup_level1": 1
                }
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "查询实例的自动备份策略。",
        "x-request-examples-url-1": "get https://{endpoint}/v3/619d3e78f61b4be68bc5aa0b59edcf7b/instances/61a4ea66210545909d74a05c27a7179ein07/backups/policy"
      }
    }
  },
  "definitions": {
    "BackupPolicy": {
      "description": "备份策略信息。",
      "required": [
        "keep_days"
      ],
      "properties": {
        "keep_days": {
          "description": "指定已生成的备份文件可以保存的天数。取值范围:1~732。",
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 732
        },
        "start_time": {
          "description": "备份时间段。自动备份将在该时间段内触发。\n取值范围:格式必须为hh:mm-HH:MM且有效,当前时间指UTC时间。",
          "type": "string",
          "example": "08:00-09:00"
        },
        "period": {
          "description": "备份周期配置。自动备份将在每星期指定的天进行。\n取值范围:格式为逗号隔开的数字,数字代表星期。",
          "type": "string",
          "example": "1,2,3,4"
        },
        "retention_num_backup_level1": {
          "description": "一级备份保留数量。当一级备份开关开启时,返回此参数。",
          "type": "integer",
          "format": "int32",
          "example": 1
        }
      }
    },
    "GetBackupPolicyResponse": {
      "required": [
        "backup_policy"
      ],
      "properties": {
        "backup_policy": {
          "$ref": "#/definitions/BackupPolicy"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}