            "type": "string"
          },
          {
            "name": "main_task_name",
            "in": "query",
            "required": false,
            "description": "**参数解释**:\n\n新增子任务相应的主任务名。\n\n**约束限制**:\n\n非必填。\n\n**取值范围**:\n\n不涉及。\n\n**默认值**:\n\n不涉及。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
