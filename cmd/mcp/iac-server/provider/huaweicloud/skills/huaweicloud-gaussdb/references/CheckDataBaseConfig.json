        "operationId": "CheckDataBaseConfig",
        "summary": "HTAP数据同步库配置校验",
        "description": "HTAP数据同步库配置校验。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-ratelimit": "gaussdbformysql01",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一Region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。",
            "minLength": 2,
            "maxLength": 1024
          },
          {
            "name": "CheckDataBaseConfigRequestBody",
            "in": "body",
            "description": "数据同步创建任务请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DbConfigCheckRequestV3"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。\n\n通过调用IAM服务[获取用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取。\n\n请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。",
            "type": "string",
            "minLength": 2,
            "maxLength": 1024
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": true,
            "description": "请求语言类型。默认en-us。\n取值范围:\n- en-us\n- zh-cn",
            "type": "string"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "description": "StarRocks实例ID,严格匹配UUID规则。",
            "type": "string",
            "minLength": 2,
            "maxLength": 1024
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/DbConfigCheckResponseV3"
            },
            "examples": {
              "application/json": {
                "source_database_name": "source_database_name",
                "target_database_name": "",
                "source_db_config_check_results": [
                  {
                    "param_name": "enable_chunk_level_dump",
                    "value": "false",
                    "check_result": "success"
                  },
                  {
                    "param_name": "snapshot_with_lock",
                    "value": "true",
                    "check_result": "success"
                  }
                ],
                "target_db_config_check_results": []
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "DBS.200022",
                "error_msg": "实例不存在"
              }
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "DbConfigCheckResult": {
      "type": "object",
      "description": "库配置校验检查结果。",
      "properties": {
        "param_name": {
          "type": "string",
          "description": "参数名。",
          "minLength": 2,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "description": "参数值。",
          "minLength": 1,
          "maxLength": 64
        },
        "check_result": {
          "type": "string",
          "description": "校验结果。",
          "minLength": 1,
          "maxLength": 1024,
          "enum": [
            "success",
            "fail"
          ]
        }
      }
    },
    "TableReplConfig": {
      "type": "object",
      "description": "表同步配置。",
      "properties": {
        "repl_type": {
          "type": "string",
          "description": "表同步类型。include_tables:白名单,exclude_tables:黑名单。",
          "minLength": 2,
          "maxLength": 15,
          "enum": [
            "include_tables",
            "exclude_tables"
          ]
        },
        "repl_scope": {
          "type": "string",
          "description": "表同步范围。all:全量同步,part:部分同步。",
          "default": "all",
          "minLength": 3,
          "maxLength": 5,
          "enum": [
            "all",
            "part"
          ]
        },
        "tables": {
          "type": "array",
          "description": "白名单或黑名单的表范围。",
          "minItems": 0,
          "maxItems": 5000,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1024
          }
        }
      }
    },
    "DbConfigCheckRequestV3": {
      "type": "object",
      "description": "HTAP库配置校验请求体。",
      "properties": {
        "source_instance_id": {
          "type": "string",
          "description": "TaurusDB实例ID。",
          "minLength": 2,
          "maxLength": 1024
        },
        "source_node_id": {
          "type": "string",
          "description": "TaurusDB只读节点ID。如为空,则取TaurusDB主节点ID",
          "minLength": 0,
          "maxLength": 1024
        },
        "source_database_name": {
          "type": "string",
          "description": "TaurusDB数据库名。",
          "minLength": 3,
          "maxLength": 1024
        },
        "target_database_name": {
          "type": "string",
          "description": "目标数据库名。字符长度限制3~128位,仅支持英文大小写字母、数字以及下划线_。",
          "minLength": 3,
          "maxLength": 128
        },
        "task_name": {
          "type": "string",
          "description": "同步任务名称。字符长度限制3~128位,仅支持英文大小写字母、数字以及下划线_。",
          "minLength": 3,
          "maxLength": 128
        },
        "db_configs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DbConfig"
          },
          "description": "库配置列表。",
          "minItems": 0,
          "maxItems": 1024
        },
        "table_repl_config": {
          "description": "表配置信息。",
          "$ref": "#/definitions/TableReplConfig"
        }
      }
    },
    "DbConfig": {
      "type": "object",
      "description": "数据库配置。",
      "properties": {
        "param_name": {
          "type": "string",
          "description": "参数名。",
          "minLength": 2,
          "maxLength": 1024
        },
        "value": {
          "type": "string",
          "description": "参数值。",
          "minLength": 2,
          "maxLength": 1024
        }
      }
    },
    "DbConfigCheckResponseV3": {
      "type": "object",
      "description": "库配置校验响应。",
      "properties": {
        "source_database_name": {
          "type": "string",
          "description": "TaurusDB数据库名称。",
          "minLength": 2,
          "maxLength": 1024
        },
        "source_db_config_check_results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DbConfigCheckResult"
          },
          "description": "TaurusDB数据库配置检查结果。",
          "minItems": 0,
          "maxItems": 1024
        },
        "target_database_name": {
          "type": "string",
          "description": "目标数据库名称。",
          "minLength": 3,
          "maxLength": 128
        },
        "target_db_config_check_results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DbConfigCheckResult"
          },
          "description": "目标数据库配置检查结果。",
          "minItems": 0,
          "maxItems": 5000
        },
        "task_name": {
          "type": "string",
          "description": "同步任务名称。",
          "minLength": 3,
          "maxLength": 128
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.280292"
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "example": "数据库用户名非法"
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
