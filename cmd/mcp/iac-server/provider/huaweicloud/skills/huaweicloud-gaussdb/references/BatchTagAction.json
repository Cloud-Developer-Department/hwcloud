{
  "name": "BatchTagAction",
  "summary": "批量添加或删除标签",
  "tags": "标签管理",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/tags/action": {
      "post": {
        "tags": [
          "标签管理"
        ],
        "operationId": "BatchTagAction",
        "summary": "批量添加或删除标签",
        "description": "批量添加或删除指定实例的标签。",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言。",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "61a4ea66210545909d74a05c27a7179ein07"
          },
          {
            "name": "BatchOperateInstanceTagRequestBody",
            "in": "body",
            "description": "请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BatchOperateInstanceTagRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success."
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "批量添加标签。",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/61a4ea66210545909d74a05c27a7179ein07/tags/action",
        "x-request-examples-1": {
          "action": "create",
          "tags": [
            {
              "key": "key1",
              "value": "value1"
            },
            {
              "key": "key2",
              "value": "value2"
            }
          ]
        },
        "x-request-examples-description-2": "批量删除标签。",
        "x-request-examples-url-2": "POST https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/61a4ea66210545909d74a05c27a7179ein07/tags/action",
        "x-request-examples-2": {
          "action": "delete",
          "tags": [
            {
              "key": "key1"
            },
            {
              "key": "key2",
              "value": "value2"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "TagItem": {
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "标签键。最大长度36个unicode字符,不能为null或者空字符串,不能为空格。\n\n字符集:0-9,A-Z,a-z,“_”,“-”,中文。"
        },
        "value": {
          "type": "string",
          "description": "标签值。最大长度43个unicode字符,可以为空字符串,不能为空格。\n\n字符集:0-9,A-Z,a-z,“_”,“.”,“-”,中文。\n- “action”值为“create”时,该参数必选。\n- “action”值为“delete”时,如果value有值,按照key-value删除,如果value没值,则按照key删除。"
        }
      }
    },
    "BatchOperateInstanceTagRequestBody": {
      "required": [
        "action",
        "tags"
      ],
      "properties": {
        "action": {
          "description": "操作标识,取值:\n- create,表示添加标签。\n- delete,表示删除标签。",
          "type": "string"
        },
        "tags": {
          "description": "标签列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/TagItem"
          }
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}