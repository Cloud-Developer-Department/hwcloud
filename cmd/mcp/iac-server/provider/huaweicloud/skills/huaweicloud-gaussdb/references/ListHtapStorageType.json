{
  "name": "ListHtapStorageType",
  "summary": "获取HTAP实例存储类型",
  "tags": "HTAP-标准版",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/htap/storage-type/{database}": {
      "get": {
        "x-request-examples-url-1": "GET https://{endpoint}/v3/23a50154cf494ec9ad6883979a12db0a/htap/storage-type/star-rocks?version_name=3.1.6.0",
        "x-request-examples-description-1": "查询可提供给StarRocks实例的磁盘存储类型",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "HTAP-标准版"
        ],
        "summary": "获取HTAP实例存储类型",
        "description": "获取HTAP实例存储类型。",
        "operationId": "ListHtapStorageType",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一Region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。"
          },
          {
            "name": "database",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "HTAP数据库名。\n取值范围:\n- star-rocks\n- click-house"
          },
          {
            "name": "version_name",
            "in": "query",
            "required": true,
            "description": "数据库大版本号",
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。\n\n通过调用IAM服务[获取用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取。\n\n请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。",
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "内容类型。 取值:application/json。",
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型。默认en-us。\n取值范围:\n- en-us\n- zh-cn",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/HtapStorageType"
            },
            "examples": {
              "application/json": {
                "storage_type": [
                  {
                    "name": "ULTRAHIGH",
                    "az_status": {
                      "cn-southwest-244d": "normal",
                      "cn-southwest-244c": "normal",
                      "cn-southwest-244b": "normal",
                      "cn-southwest-244a": "normal"
                    },
                    "min_volume_size": 50
                  },
                  {
                    "name": "ESSD",
                    "az_status": {
                      "cn-southwest-244d": "unsupported",
                      "cn-southwest-244c": "unsupported",
                      "cn-southwest-244b": "normal",
                      "cn-southwest-244a": "normal"
                    },
                    "min_volume_size": 40
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/Erro"
            },
            "examples": {
              "application/json": "{\n    \"error_msg\": \"The DB engine or version is not supported.\"\n    \"error_code\": \"DBS.280238\",\n}"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/Erro"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Erro": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "DBS.200082",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "example": "The available IP addresses in the selected subnet are insufficient.",
          "description": "错误消息。"
        }
      }
    },
    "HtapStorageType": {
      "type": "object",
      "properties": {
        "storage_type": {
          "items": {
            "properties": {
              "name": {
                "type": "string",
                "example": "ULTRAHIGH",
                "description": "存储介质名。"
              },
              "az_status": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "可支持可用区信息。",
                "type": "object"
              },
              "min_volume_size": {
                "type": "integer",
                "format": "int32",
                "example": 50,
                "description": "最小可提供磁盘大小。"
              }
            }
          },
          "description": "存储类型。",
          "type": "array"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}