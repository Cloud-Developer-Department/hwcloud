{
  "name": "ShowRestoreTables",
  "summary": "查询表级时间点恢复可选表",
  "tags": "备份管理",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/backups/restore/tables": {
      "get": {
        "tags": [
          "备份管理"
        ],
        "operationId": "ShowRestoreTables",
        "summary": "查询表级时间点恢复可选表",
        "description": "查询表级时间点恢复可选表。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务[获取用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取。\n\n请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。\n",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型。默认en-us。\n取值范围:\n- en-us\n- zh-cn",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一Region下的project ID。                          \n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID,严格匹配UUID规则。",
            "required": true,
            "type": "string",
            "x-example": "61a4ea66210545909d74a05c27a7179ein07"
          },
          {
            "name": "restore_time",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "备份时间点,时间戳格式。\n\n通过[查询可恢复时间段](https://support.huaweicloud.com/api-taurusdb/ShowBackupRestoreTime.html)获取。"
          },
          {
            "name": "last_table_info",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "是否是最新库表。\n- true:是最新库表。\n- false:是恢复时间点库表。"
          },
          {
            "name": "database_name",
            "in": "query",
            "type": "string",
            "description": "数据库名称,模糊匹配。"
          },
          {
            "name": "table_name",
            "in": "query",
            "type": "string",
            "description": "表名称,模糊匹配。"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ShowRestoreTablesResp"
            },
            "examples": {
              "application/json": {
                "total_databases": 1,
                "databases": [
                  {
                    "name": "test_db_1",
                    "total_tables": 1,
                    "tables": [
                      {
                        "name": "t3"
                      }
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "查询表级时间点恢复可选表。",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/97b026aa9cc4417888c14c84a1ad9860/instances/61a4ea66210545909d74a05c27a7179ein07/backups/restore/tables?database_name=test&last_table_info=true&restore_time=1690890940000&table_name=t"
      }
    }
  },
  "definitions": {
    "ShowRestoreTablesResp": {
      "properties": {
        "total_databases": {
          "type": "integer",
          "description": "数据库总数。"
        },
        "databases": {
          "type": "array",
          "description": "数据库信息。",
          "items": {
            "$ref": "#/definitions/RestoreDatabaseInfos"
          }
        }
      }
    },
    "RestoreDatabaseTableInfo": {
      "properties": {
        "name": {
          "type": "string",
          "description": "表名。"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "RestoreDatabaseInfos": {
      "properties": {
        "name": {
          "type": "string",
          "description": "数据库名称。"
        },
        "total_tables": {
          "type": "integer",
          "description": "总表数。"
        },
        "tables": {
          "type": "array",
          "description": "表信息。",
          "items": {
            "$ref": "#/definitions/RestoreDatabaseTableInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
