{
  "name": "CreateGaussMySqlDatabase",
  "summary": "创建数据库",
  "tags": "数据库管理",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/databases": {
      "post": {
        "tags": [
          "数据库管理"
        ],
        "operationId": "CreateGaussMySqlDatabase",
        "summary": "创建数据库",
        "description": "创建云数据库 TaurusDB实例数据库。",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "required": true,
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言。",
            "required": false,
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "a23fb62bd61e4e9e9636fd2225f395bein07"
          },
          {
            "name": "CreateGaussMySqlDatabaseRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateGaussMySqlDatabaseRequestBody"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/CreateGaussMySqlDatabaseResponseBody"
            },
            "examples": {
              "application/json": {
                "job_id": "dff1d289-4d03-4942-8b9f-463ea07c000d"
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "创建数据库,字符集为utf8mb4,读写权限。",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/a23fb62bd61e4e9e9636fd2225f395bein07/databases",
        "x-request-examples-1": {
          "databases": [
            {
              "name": "test",
              "character_set": "utf8mb4",
              "comment": "database_comment",
              "users": [
                {
                  "name": "gaussdb_mysql_user1",
                  "host": "127.0.0.1",
                  "readonly": false
                }
              ]
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "CreateGaussMySqlDatabase": {
      "description": "数据库信息列表,列表最大长度为50。",
      "required": [
        "name",
        "character_set"
      ],
      "properties": {
        "name": {
          "description": "数据库名称,数据库名称长度可在1~64个字符之间,由字母、数字、下划线、中划线组成,中划线的累计总长度小于等于10个字符,且不能包含其他特殊字符。",
          "type": "string"
        },
        "comment": {
          "description": "数据库备注,长度不能超过512个字符,不能包含回车和特殊字符!<\"='>&。",
          "type": "string"
        },
        "character_set": {
          "description": "数据库使用的字符集名称,如utf8mb4、gbk。",
          "type": "string"
        },
        "users": {
          "description": "数据库用户列表,即创建数据库时同步授权给列表中的用户,列表最大长度为50。列表可以为空,即创建数据库时不授予其权限到数据库用户,在需要给该数据库授权某数据库用户时,调用数据库用户授权接口即可。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/GaussMySqlDatabaseUser"
          }
        }
      }
    },
    "CreateGaussMySqlDatabaseRequestBody": {
      "description": "创建数据库请求体。",
      "required": [
        "databases"
      ],
      "properties": {
        "databases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CreateGaussMySqlDatabase"
          }
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "GaussMySqlDatabaseUser": {
      "description": "需要授权的用户信息",
      "required": [
        "name",
        "host",
        "readonly"
      ],
      "properties": {
        "name": {
          "description": "数据库用户名",
          "type": "string"
        },
        "host": {
          "description": "主机地址",
          "type": "string"
        },
        "readonly": {
          "description": "是否为只读权限:\n- true,表示只读。\n- false,表示可读写。",
          "type": "boolean"
        }
      }
    },
    "CreateGaussMySqlDatabaseResponseBody": {
      "description": "创建数据库响应体。",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "创建数据库的任务ID。",
          "example": "6b7dd5d4-4590-4f14-b164-a8737ce071d5"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}