  "definitions": {
    "MysqlJobId": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID。",
          "example": "6ad4eb1f-73bd-4876-aa31-aa9a1e41c4bc"
        }
      }
    },
    "ModifyProxyRouteWeightReadonlyNode": {
      "description": "只读节点权重配置信息。",
      "required": [
        "id",
        "weight"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "只读节点ID。",
          "x-example": "9f59e78322ac40c58385ab77c12ef84bno07"
        },
        "weight": {
          "type": "integer",
          "format": "int32",
          "description": "只读节点权重:\n- 如果路由模式为0,取值为0~1000;\n- 如果路由模式为1或2,取值为0或1。",
          "x-example": 100
        }
      }
    },
    "ModifyGaussMySqlProxyRouteModeRequestBody": {
      "description": "proxy实例修改路由模式请求体",
      "required": [
        "route_mode"
      ],
      "properties": {
        "route_mode": {
          "type": "integer",
          "format": "int32",
          "description": "数据库代理路由模式。\n\n取值范围:\n- 0,表示权重负载模式。\n- 1,表示负载均衡模式(数据库主节点不接受读请求)。\n- 2,表示负载均衡模式(数据库主节点接受读请求)。"
        },
        "master_weight": {
          "type": "integer",
          "format": "int32",
          "description": "主节点权重:\n- 如果路由模式为0,取值为0~1000。\n- 如果路由模式为1,取值为0。\n- 如果路由模式为2,取值为1。",
          "x-example": 100
        },
        "readonly_nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModifyProxyRouteWeightReadonlyNode"
          },
          "description": "只读节点权重配置信息。"
        },
        "new_node_auto_add_status": {
          "type": "string",
          "description": "是否开启新增节点自动加入该Proxy。如果需要设置是否开启新增节点自动加入该Proxy,请联系客服人员添加白名单,加入白名单后,方可输入该字段。\n\n取值范围:\n- ON:开启。\n- OFF:关闭。"
        },
        "new_node_weight": {
          "type": "integer",
          "format": "int32",
          "description": "新增节点的读权重:\n  \n- 如果路由模式为0,新增节点自动加入为ON,取值为0~1000。\n- 如果路由模式不为0或新增节点自动加入为OFF,则可不输入读权重。\n- 如果路由模式不为0或新增节点自动加入为OFF,则可不输入读权重。"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
