  "definitions": {
    "NodeSqlFilterRuleInfo": {
      "description": "节点级别的SQL限流规则。",
      "required": [
        "node_id",
        "rules"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "description": "节点ID",
          "example": "c01a5645eb2c4fb6a9373542f5366e50no07"
        },
        "rules": {
          "type": "array",
          "description": "SQL限流规则。集合的sql_type值不能重复。",
          "items": {
            "$ref": "#/definitions/NodeSqlFilterRule"
          }
        }
      }
    },
    "NodeSqlFilterRulePattern": {
      "description": "SQL限流规则和最大并发数",
      "required": [
        "pattern",
        "max_concurrency",
        "expire_at"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "description": "SQL限流规则,由一个或多个关键字(最多为128个关键字)组成,关键字之间通过\"~\"分隔符分开,如select~from~t1。规则中不能包含‘\\’、中英文逗号、‘~~’,不能以‘~’结尾。"
        },
        "max_concurrency": {
          "type": "integer",
          "format": "int32",
          "description": "最大并发数。取值范围:非负整数。"
        },
        "expire_at": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**:\n\nSQL限流失效时间,标准秒级时间戳,永久生效SQL限流规则该字段为null。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n0 - 9223372036854775807。\n\n**默认取值**:\n\n不涉及。"
        }
      }
    },
    "NodeSqlFilterRule": {
      "description": "SQL限流规则。",
      "required": [
        "sql_type",
        "patterns"
      ],
      "properties": {
        "sql_type": {
          "type": "string",
          "description": "Sql限流类型。\n\n取值范围:\n- SELECT\n- UPDATE\n- DELETE",
          "example": "SELECT"
        },
        "patterns": {
          "type": "array",
          "description": "SQL限流具体规则。",
          "items": {
            "$ref": "#/definitions/NodeSqlFilterRulePattern"
          }
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "OperateSqlFilterRuleReq": {
      "required": [
        "sql_filter_rules"
      ],
      "description": "- 开启/关闭sql限流参数体。",
      "properties": {
        "sql_filter_rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NodeSqlFilterRuleInfo"
          }
        }
      }
    },
    "OperateSqlFilterRuleRsp": {
      "required": [
        "job_id"
      ],
      "description": "设置SQL限流规则任务ID",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "设置SQL限流规则任务ID。",
          "example": "aef6a470-fb63-4d5b-b644-12ead7e019b3"
        }
      }
    }
  },
