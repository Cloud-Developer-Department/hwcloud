              "$ref": "#/definitions/TaurusModifyInstanceMonitorResponseBody"
            },
            "examples": {
              "application/json": {
                "job_id": "6b7dd5d4-4590-4f14-b164-a8737ce071d5"
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
