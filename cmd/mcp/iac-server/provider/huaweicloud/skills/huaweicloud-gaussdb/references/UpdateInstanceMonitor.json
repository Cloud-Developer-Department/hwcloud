          "monitor_switch": true,
          "period": 1
        }
      }
    }
  },
  "definitions": {
    "TaurusModifyInstanceMonitorResponseBody": {
      "required": [
        "job_id"
      ],
      "description": "修改秒级监控的响应体",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "修改秒级监控的任务流ID",
          "example": "6b7dd5d4-4590-4f14-b164-a8737ce071d5"
        }
      }
    },
    "TaurusModifyInstanceMonitorRequestBody": {
      "required": [
        "monitor_switch"
      ],
      "description": "秒级监控修改请求",
