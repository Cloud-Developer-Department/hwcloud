          "example": "实例不存在"
        }
      }
    },
    "ResetDatabasePasswordRequest": {
      "description": "修改数据库用户密码请求体。",
      "required": [
        "users"
      ],
      "properties": {
        "users": {
          "description": "准备修改密码的数据库用户列表,列表最大长度为50。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResetDatabasePassword"
          }
        }
      }
    }
