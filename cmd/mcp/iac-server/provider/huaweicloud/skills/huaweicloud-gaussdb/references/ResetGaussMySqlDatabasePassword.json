  "definitions": {
    "ResetDatabasePasswordResponse": {
      "description": "修改数据库用户密码响应体。",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "修改数据库用户密码的任务ID。",
          "example": "6b7dd5d4-4590-4f14-b164-a8737ce071d5"
        }
      }
    },
    "ResetDatabasePassword": {
      "description": "数据库用户名密码信息。",
      "required": [
        "name",
        "host",
        "password"
      ],
      "properties": {
        "name": {
          "description": "数据库用户名。",
          "type": "string"
        },
        "host": {
          "description": "主机地址。",
          "type": "string"
        },
        "password": {
          "description": "数据库用户密码,非空,至少包含以下字符中的三种:大写字母、小写字母、数字和特殊符号~!@#$%^*-_=+?,()&组成,长度8~32个字符。建议您输入高强度密码,以提高安全性,防止出现密码被暴力破解等安全风险",
          "type": "string"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
