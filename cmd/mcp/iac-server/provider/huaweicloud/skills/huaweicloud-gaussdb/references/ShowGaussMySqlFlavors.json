{
  "name": "ShowGaussMySqlFlavors",
  "summary": "查询数据库规格",
  "tags": "查询数据库规格",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/flavors/{database_name}": {
      "get": {
        "tags": [
          "查询数据库规格"
        ],
        "operationId": "ShowGaussMySqlFlavors",
        "summary": "查询数据库规格",
        "description": "获取指定数据库引擎版本对应的规格信息。",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。",
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "语言。",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "database_name",
            "in": "path",
            "description": "数据库引擎名称。",
            "required": true,
            "type": "string",
            "x-example": "gaussdb-mysql"
          },
          {
            "name": "version_name",
            "in": "query",
            "description": "数据库版本号,目前仅支持兼容MySQL 8.0。",
            "required": false,
            "type": "string",
            "x-example": "8.0"
          },
          {
            "name": "availability_zone_mode",
            "in": "query",
            "description": "规格的可用区模式,现在仅支持\"single\"、\"multi\",不区分大小写。",
            "required": true,
            "type": "string",
            "x-example": "single"
          },
          {
            "name": "spec_code",
            "in": "query",
            "description": "规格编码。",
            "required": false,
            "type": "string",
            "x-example": "gaussdb.mysql.xlarge.x86.4"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/MysqlFlavors"
            },
            "examples": {
              "application/json": {
                "flavors": [
                  {
                    "vcpus": "4",
                    "ram": "16",
                    "type": "x86",
                    "id": "3169caaf-6c2f-41d5-aadd-c8fc3d83597e",
                    "spec_code": "gaussdb.mysql.xlarge.x86.4",
                    "instance_mode": "Cluster",
                    "version_name": "8.0",
                    "az_status": {
                      "az1": "normal",
                      "az2": "normal"
                    }
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "查询TaurusDB数据库实例指定规格的详细信息。",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/flavors/gaussdb-mysql?version_name=8.0&spec_code=gaussdb.mysql.xlarge.x86.4&availability_zone_mode=single"
      }
    }
  },
  "definitions": {
    "MysqlFlavors": {
      "required": [
        "flavors"
      ],
      "properties": {
        "flavors": {
          "description": "实例规格信息列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MysqlFlavorsInfo"
          }
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "MysqlFlavorsInfo": {
      "required": [
        "vcpus",
        "ram",
        "type",
        "id",
        "spec_code",
        "version_name",
        "instance_mode",
        "az_status"
      ],
      "properties": {
        "vcpus": {
          "type": "string",
          "description": "CPU大小。例如:1表示1U。"
        },
        "ram": {
          "type": "string",
          "description": "内存大小,单位为GB。"
        },
        "type": {
          "type": "string",
          "description": "规格类型,取值为arm、x86和generalX86。\n\n- arm:独享型arm规格。\n- x86:独享型x86规格。\n- generalX86:通用型X86规格。"
        },
        "id": {
          "type": "string",
          "description": "规格ID,该字段唯一"
        },
        "spec_code": {
          "type": "string",
          "description": "资源规格编码,同创建指定的flavor_ref。例如:gaussdb.mysql.xlarge.x86.4。"
        },
        "version_name": {
          "type": "string",
          "description": "数据库版本号。"
        },
        "instance_mode": {
          "type": "string",
          "description": "实例类型。目前仅支持Cluster。"
        },
        "az_status": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "规格所在az的状态,包含以下状态:\n\n- normal,在售\n- unsupported,暂不支持该规格\n- sellout,售罄。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}