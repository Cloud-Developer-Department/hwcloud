{
  "name": "CreateAccessControl",
  "summary": "设置访问控制规则",
  "tags": "数据库代理",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/proxy/{proxy_id}/access-control": {
      "post": {
        "tags": [
          "数据库代理"
        ],
        "operationId": "CreateAccessControl",
        "summary": "设置访问控制规则",
        "description": "设置访问控制规则。",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务[获取用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取。\n\n请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。\n",
            "type": "string",
            "required": true,
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型。默认en-us。\n取值范围:\n- en-us\n- zh-cn",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一Region下的project ID。                          \n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID,严格匹配UUID规则。",
            "required": true,
            "type": "string",
            "x-example": "61a4ea66210545909d74a05c27a7179ein07"
          },
          {
            "name": "proxy_id",
            "in": "path",
            "description": "数据库代理ID,严格匹配UUID规则。",
            "required": true,
            "type": "string",
            "x-example": "e87088f0b6a345e79db19d57c41fde15po01"
          },
          {
            "name": "CreateAccessControlRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateAccessControlRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ProxySwitchElbIpGroupResponse"
            },
            "examples": {
              "application/json": {
                "open_access_control": false
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "设置访问控制规则。",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/instances/61a4ea66210545909d74a05c27a7179ein07/proxy/e87088f0b6a345e79db19d57c41fde15po01/access-control",
        "x-request-examples-1": {
          "type": "black",
          "ip_list": [
            {
              "ip": "192.107.0.1",
              "description": "black01"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "CreateAccessControlRequestBody": {
      "required": [
        "type",
        "ip_list"
      ],
      "properties": {
        "type": {
          "description": "访问控制方式。 取值: - white:表示白名单。 - black:表示黑名单。",
          "type": "string",
          "example": "black"
        },
        "ip_list": {
          "type": "array",
          "description": "控制访问的IP地址数组,最多可添加300个IP地址或网段。",
          "items": {
            "$ref": "#/definitions/AccessControlRule"
          }
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "ProxySwitchElbIpGroupResponse": {
      "properties": {
        "open_access_control": {
          "type": "boolean",
          "description": "是否已开启访问控制。 取值: - true:开启。 - false:关闭。",
          "example": false
        }
      }
    },
    "AccessControlRule": {
      "required": [
        "ip"
      ],
      "properties": {
        "ip": {
          "type": "string",
          "description": "IP地址或网段。"
        },
        "description": {
          "type": "string",
          "description": "备注。备注长度范围是0到50个字符,不能包含<>。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
