            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/SetQuotasRequestBody"
            },
            "examples": {
              "application/json": {
                "quota_list": [
                  {
                    "enterprise_project_id": "0",
                    "instance_quota": 20,
                    "vcpus_quota": 20,
