                  }
                ]
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "修改指定企业项目的资源配额。",
        "x-request-examples-url-1": "PUT https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/quotas",
        "x-request-examples-1": {
          "quota_list": [
            {
              "enterprise_project_id": "0",
              "instance_quota": 20,
              "vcpus_quota": 20,
              "ram_quota": 40
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "SetQuotasRequestBody": {
      "required": [
        "quota_list"
      ],
      "properties": {
        "quota_list": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/setQuota"
          },
          "description": "资源列表对象。"
        }
      }
    },
    "setQuota": {
      "required": [
        "enterprise_project_id"
      ],
      "properties": {
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。"
        },
        "instance_quota": {
          "type": "integer",
          "format": "int32",
          "description": "实例个数配额。取值范围0~100000。(如果已经存在实例,应该大于已经存在的实例个数)"
        },
        "vcpus_quota": {
          "type": "integer",
          "format": "int32",
          "description": "CPU核数配额。取值范围0~2147483646。(如果已经存在实例,应该大于已经占用的cpu个数)"
        },
        "ram_quota": {
          "type": "integer",
          "format": "int32",
          "description": "内存使用配额,单位为GB。取值范围0~2147483646。(如果已经存在实例,应该大于已经占用的内存数)"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    }
  },
