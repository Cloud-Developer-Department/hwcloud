        "operationId": "CreateGaussMySqlConfiguration",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "summary": "创建参数模板",
        "description": "创建参数模板信息,包含参数模板名称、描述、数据库版本信息、参数值。",
