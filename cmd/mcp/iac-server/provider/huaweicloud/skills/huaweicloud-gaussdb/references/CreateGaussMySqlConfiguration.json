        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言。",
            "type": "string",
            "x-example": "zh-cn",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "CreateConfigurationRequestBody:",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateConfigurationRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/CreateConfigurationResponseBody"
            },
            "examples": {
              "application/json": {
                "configurations": {
                  "id": "887ea0d1bb0843c49e8d8e5a09a95652pr07",
                  "name": "myparameter",
                  "description": "parameter1",
                  "datastore": {
                    "type": "gaussdb-mysql",
                    "version": "8.0"
                  },
                  "created": "2022-05-15T11:53:34+0000",
                  "updated": "2022-05-15T11:53:34+0000"
                }
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "创建参数模板,帐户允许最大同时连接数为10。",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/056538411200d4cd2f79c003c7606412/configurations",
        "x-request-examples-1": {
          "name": "myparameter",
          "description": "parameter1",
          "datastore": {
            "type": "gaussdb-mysql",
            "version": "8.0"
          },
          "parameter_values": {
            "max_user_connections": "10"
          }
        }
      }
    }
  },
  "definitions": {
    "ConfigurationSummary2": {
      "description": "参数模板信息。",
      "properties": {
        "id": {
          "description": "参数组ID。",
          "type": "string"
        },
        "name": {
          "description": "参数组名称。",
          "type": "string"
        },
        "description": {
          "description": "参数组描述。",
          "type": "string"
        },
        "datastore": {
          "type": "object",
          "description": "数据库对象。",
          "$ref": "#/definitions/DatastoreResult"
        },
        "created": {
          "description": "创建时间,格式为\"yyyy-MM-ddTHH:mm:ssZ\"。\n\n其中,T指某个时间的开始;Z指时区偏移量。",
          "type": "string"
        },
        "updated": {
          "description": "更新时间,格式为\"yyyy-MM-ddTHH:mm:ssZ\"。\n\n其中,T指某个时间的开始;Z指时区偏移量。",
          "type": "string"
        }
      }
    },
    "CreateConfigurationResponseBody": {
      "required": [
        "configurations"
      ],
      "properties": {
        "configurations": {
          "type": "object",
          "$ref": "#/definitions/ConfigurationSummary2"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "CreateConfigurationRequestBody": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "参数模板名称。\n\n取值范围:长度1到64个字符之间,区分大小写字母,可包含字母、数字、中划线、下划线或句点,不能包含其他特殊字符。"
        },
        "description": {
          "type": "string",
          "description": "参数模板描述。默认为空。\n\n取值范围:长度不超过256个字符,且不能包含回车和特殊字符 ! < \" = ' > &"
        },
        "parameter_values": {
          "description": "参数名和参数值映射关系。用户可以基于默认参数模板的参数,自定义的参数值。",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "example": {
            "max_connections": "10"
          }
        },
        "datastore": {
          "type": "object",
          "description": "数据库对象。",
          "$ref": "#/definitions/DatastoreResult"
        }
      }
    },
    "DatastoreResult": {
      "required": [
        "type",
        "version"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "数据库引擎,现在只支持gaussdb-mysql"
        },
        "version": {
          "type": "string",
          "description": "数据库版本。数据库支持的详细版本信息,可调用查询数据库引擎的版本接口获取。"
        }
      }
    }
  },
