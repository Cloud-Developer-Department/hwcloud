  "definitions": {
    "CreateBackupResourcePackageRequestBody": {
      "required": [
        "spec_code",
        "num",
        "charge_info"
      ],
      "description": "**参数解释**:\n\n创建备份资源包请求体。",
      "properties": {
        "spec_code": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20,
          "description": "**参数解释**:\n\n备份资源包规格码。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n备份资源包规格码可根据[查询备份资源包规格](https://support.huaweicloud.com/api-taurusdb/ShowBackupResourcePackageFlavors.html)接口获取。\n\n**默认取值**:\n\n不涉及。"
        },
        "num": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 10,
          "description": "**参数解释**:\n\n备份资源包数量。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n1-10。\n\n**默认取值**:\n\n不涉及。"
        },
        "charge_info": {
          "$ref": "#/definitions/TaurusDbChargeInfo"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "TaurusDbChargeInfo": {
      "description": "**参数解释**:\n\n计费类型信息。\n\n**约束限制**:\n\n不涉及。",
      "required": [
        "period_type",
        "period_num"
      ],
      "properties": {
        "period_type": {
          "type": "string",
          "enum": [
            "month",
            "year"
          ],
          "description": "**参数解释**:\n\n订购周期类型。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n- month:包月。\n- year:包年。\n\n**默认取值**:\n\n不涉及。"
        },
        "period_num": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 9,
          "description": "**参数解释**:\n\n订购时间长度。\n\n**约束限制**:\n\n需要和period_type允许的订购时间长度对应。\n\n**取值范围**:\n\n- \"period_type\"为\"month\"时,取值为1~9。\n- \"period_type\"为\"year\"时,取值为1~3。\n\n**默认取值**:\n\n不涉及。"
        },
        "is_auto_renew": {
          "type": "boolean",
          "description": "**参数解释**:\n\n是否自动续订,续订的周期和原周期相同,且续订时会自动支付。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n- true:自动续订。\n- false:不自动续订。\n\n**默认取值**:\n\nfalse。"
        },
        "is_auto_pay": {
          "type": "boolean",
          "description": "**参数解释**:\n\n是否自动从客户的账户中支付,此字段不影响自动续订的支付方式。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n- true:自动支付。\n- false:手动支付。\n\n**默认取值**:\n\nfalse。"
        }
      }
    },
    "CreateBackupResourcePackageResponseBody": {
      "required": [
        "order_id",
        "spec_code",
        "num",
        "period_type",
        "period_num"
      ],
      "description": "**参数解释**:\n\n创建备份资源包响应体。",
      "properties": {
        "order_id": {
          "type": "string",
          "minLength": 17,
          "maxLength": 17,
          "description": "**参数解释**:\n\n创建备份资源包订单ID。\n\n**取值范围**:\n\n不涉及。",
          "example": "CS26032015513W796"
        },
        "spec_code": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20,
          "description": "**参数解释**:\n\n备份资源包规格码。\n\n**取值范围**:\n\n不涉及。",
          "example": "gaussdb.mysql.backup.pkg.1tb"
        },
        "num": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 10,
          "description": "**参数解释**:\n\n备份资源包数量。\n\n**取值范围**:\n\n1-10。",
          "example": 1
        },
        "period_type": {
          "type": "string",
          "enum": [
            "month",
            "year"
          ],
          "description": "**参数解释**:\n\n订购周期类型。\n\n**取值范围**:\n\n- month:包月。\n- year:包年。",
          "example": "year"
        },
        "period_num": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 9,
          "description": "**参数解释**:\n\n订购时间长度。\n\n**取值范围**:\n\n- \"period_type\"为\"month\"时,取值为1~9。\n- \"period_type\"为\"year\"时,取值为1~3。",
          "example": 1
        }
      }
    }
  },
