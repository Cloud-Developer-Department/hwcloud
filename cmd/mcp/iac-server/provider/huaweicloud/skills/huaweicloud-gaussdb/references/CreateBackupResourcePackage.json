            "maxLength": 64,
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "CreateBackupResourcePackageRequestBody",
            "in": "body",
            "description": "**参数解释**:\n\n创建备份资源包请求体。\n\n**约束限制**:\n\n不涉及。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateBackupResourcePackageRequestBody"
            }
          }
        ],
