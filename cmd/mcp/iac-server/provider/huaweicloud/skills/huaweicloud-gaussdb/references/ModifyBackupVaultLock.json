  "definitions": {
    "BackupVaultLockRequest": {
      "type": "object",
      "description": "**参数解释**:\n\n打开或延期备份合规锁配置的请求体。\n\n**约束限制**:\n\n不涉及。",
      "required": [
        "backup_vaultlock_info",
        "action"
      ],
      "properties": {
        "backup_vaultlock_info": {
          "description": "**参数解释**:\n\n备份合规锁配置。\n\n**约束限制**:\n\n不涉及。",
          "$ref": "#/definitions/BackupVaultLockInfoRequest"
        },
        "action": {
          "type": "string",
          "description": "**参数解释**:\n\n操作类型。\n\n**约束限制**:\n\n当前只支持开启和延期。不区分大小写。\n\n**取值范围**:\n- enable:开启。\n- extend:延期。\n\n**默认取值**:\n\nenable。",
          "enum": [
            "enable",
            "extend"
          ]
        }
      }
    },
    "BackupVaultLockResponse": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "string",
          "description": "**参数解释**:\n\n备份合规锁开启或延期状态。\n\n**取值范围**:\n- success:成功。",
          "enum": [
            "success"
          ]
        }
      },
      "description": "返回备份合规锁开启或延期操作的响应。"
    },
    "BackupVaultLockInfoRequest": {
      "type": "object",
      "required": [
        "lock_retention_days",
        "lock_policy"
      ],
      "properties": {
        "lock_retention_days": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n\n合规锁保留期,单位是天。\n\n**约束限制**:\n\n仅支持按天配置。\n\n**取值范围**:\n\n1-36500。\n\n**默认取值**:\n\n1。",
          "minimum": 1,
          "maximum": 36500
        },
        "lock_policy": {
          "type": "boolean",
          "description": "**参数解释**:\n\n合规锁配置策略。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n当前仅支持设置为true,表示开启或延期合规锁。\n\n**默认取值**:\n\ntrue。"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
