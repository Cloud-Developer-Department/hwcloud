            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "**参数解释**:            \n\n索引位置,偏移量。从第一条数据偏移offset条数据后开始查询。\n\n**约束限制**:\n\n必须为整数,不能为负数。\n\n**取值范围**:\n\n≥0\n\n**默认值**:\n\n0。",
            "type": "string"
          }
