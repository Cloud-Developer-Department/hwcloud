          "description": "**参数解释**:\n\n会话ID。  \n\n**取值范围**:\n\n不涉及。"
        },
        "user": {
          "type": "string",
          "description": "**参数解释**:\n\n会话用户名。  \n\n**取值范围**:\n\n不涉及。"
        },
        "host": {
          "type": "string",
          "description": "**参数解释**:\n\n会话主机。  \n\n**取值范围**:\n\n不涉及。"
        },
        "state": {
          "type": "string",
          "description": "**参数解释**:\n\n会话状态。\n\n**取值范围**:\n\n不涉及。"
        },
        "database": {
          "type": "string",
          "description": "**参数解释**:\n\n会话对应数据库。  \n\n**取值范围**:\n\n不涉及。"
        },
        "sql_statement": {
          "type": "string",
          "description": "**参数解释**:\n\n会话执行的SQL语句。  \n\n**取值范围**:\n\n不涉及。"
        },
        "duration": {
          "type": "string",
          "description": "**参数解释**:\n\n会话持续时间,单位是秒。\n\n**取值范围**:\n\n不涉及。"
        },
        "command": {
          "type": "string",
          "description": "**参数解释**:\n\n会话命令类型。  \n\n**取值范围**:\n\n不涉及。"
        }
      }
    },
    "QueryHtapProcessListRsp": {
      "required": [
        "process_list"
      ],
      "description": "**参数解释**:\n\n查询HTAP实例当前会话响应体。\n\n**约束限制**:\n\n不涉及。",
      "properties": {
        "process_list": {
          "type": "array",
