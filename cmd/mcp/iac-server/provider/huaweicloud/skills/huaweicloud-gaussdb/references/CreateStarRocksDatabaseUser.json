  "definitions": {
    "SuccRep": {
      "type": "object",
      "description": "请求成功结果。",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "string",
          "description": "请求结果。",
          "example": "SUCCESS"
        }
      }
    },
    "StarRocksDatabaseUserInfo": {
      "description": "账户信息",
      "required": [
        "user_name",
        "password",
        "databases"
      ],
      "properties": {
        "user_name": {
          "type": "string",
          "description": "数据库账户名。\n长度为2-32个字符,必须以小写字母开头,小写字母或数字结尾,可以包含小写字母、数字以及下划线,不能包含其它特殊字符。",
          "example": "user_test"
        },
        "password": {
          "type": "string",
          "description": "账户密码。\n- 8-32个字符\n- 不能与用户名或倒序的用户名相同\n- 至少包含以下字符中的三种:大写字母、小写字母、数字和特殊字符~!@#%^*-_=+?,",
          "example": "Rds_1234"
        },
        "databases": {
          "type": "array",
          "items": {
            "type": "string",
            "example": "*"
          },
          "description": "数据库列表。",
          "example": "[\"INFORMATION_SCHEMA\",   \"default\"]"
        },
        "dml": {
          "type": "integer",
          "format": "int32",
          "description": "DML权限,默认2。\n取值范围:\n- 0:读写权限\n- 1:只读权限\n- 2:只读和设置权限\n- 3:读写和设置权限",
          "example": 2
        },
        "ddl": {
          "type": "integer",
          "format": "int32",
          "description": "DDL权限,默认0。\n取值范围:\n- 0:无DDL权限\n- 1:有DDL权限",
          "example": 0
        }
      },
      "type": "object"
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.280292"
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "example": "数据库用户名非法"
        }
      },
      "type": "object"
    }
