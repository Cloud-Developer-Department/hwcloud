  "definitions": {
    "QueryScheduleTaskListResponse": {
      "required": [
        "schedules",
        "total_count"
      ],
      "properties": {
        "schedules": {
          "type": "array",
          "description": "任务详情",
          "items": {
            "$ref": "#/definitions/ScheduleTask"
          }
        },
        "total_count": {
          "type": "integer",
          "description": "记录总数。",
          "example": 2
        }
      }
    },
    "ScheduleTask": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID。",
          "example": "56d3c1138dcf4f1da73b0170700c78d0"
        },
        "instance_id": {
          "type": "string",
          "description": "实例ID。",
          "example": "79bc540dd4d6432784894a981fdfacfcin07"
        },
        "instance_name": {
          "type": "string",
          "description": "实例名称。",
          "example": "gauss-f821"
        },
        "instance_status": {
          "type": "string",
          "description": "实例状态。\n取值:\n- 值为“createfail”,表示实例创建失败。\n- 值为“creating”,表示实例创建中。\n- 值为“normal”,表示实例正常。\n- 值为“abnormal”,表示实例异常。\n- 值为“deleted”,表示实例已删除。",
          "example": "ACTIVE"
        },
        "project_id": {
          "type": "string",
          "description": "租户在某一region下的project ID。",
          "example": "053f533ead80d5102f0cc012e8d468a4"
        },
        "job_name": {
          "type": "string",
          "description": "**参数解释**:\n任务名称。\n\n**取值范围**:\n  - PROXY_VERSION_UPGRADE:表示数据库代理版本升级。\n  - VERSION_UPGRADE:表示实例版本升级。\n  - RESIZE_FLAVOR:表示实例规格变更。\n  - REBOOT_NODE:表示重启节点。\n  - REBOOT_INSTANCE:表示重启实例。"
        },
        "create_time": {
          "type": "string",
          "description": "任务创建时间,格式为\"yyyy-mm-ddThh:mm:ssZ\"。 其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。 说明:创建时返回值为空,数据库实例创建成功后该值不为空",
          "example": "2018-08-06T10:41:14+0000"
        },
        "start_time": {
          "type": "string",
          "description": "任务开始时间,格式为\"yyyy-mm-ddThh:mm:ssZ\"。 其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。 说明:创建时返回值为空,数据库实例创建成功后该值不为空",
          "example": "2018-08-06T10:41:14+0000"
        },
        "end_time": {
          "type": "string",
          "description": "任务结束时间,格式为\"yyyy-mm-ddThh:mm:ssZ\"。 其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。 说明:创建时返回值为空,数据库实例创建成功后该值不为空",
          "example": "2018-08-06T10:41:14+0000"
        },
        "job_status": {
          "type": "string",
          "description": "任务执行状态。\n取值:\n- 值为“Pending”,表示延时任务,未执行。\n- 值为“Running”,表示任务正在执行。\n- 值为“Completed”,表示任务执行成功。\n- 值为“Failed”,表示任务执行失败。",
          "example": "Completed"
        },
        "datastore_type": {
          "type": "string",
          "description": "数据库类型。",
          "example": "gaussdb-mysql"
        },
        "target_config": {
          "type": "object",
          "description": "实例配置相关信息,比如规格等。",
          "example": {
            "flavor": "gaussdb.mysql.large.arm.4",
            "mem": "8",
            "cpu": "2"
          }
        },
        "proxy_id": {
          "type": "string",
          "description": "**参数解释**:\n\n数据库代理ID,严格匹配UUID规则。\n\n**取值范围**:\n\n只能由英文字母、数字组成,后缀为po01,长度为36个字符。",
          "example": "e87088f0b6a345e79db19d57c41fde15po01"
        },
        "proxy_name": {
          "type": "string",
          "description": "**参数解释**:\n\n数据库代理名称。\n\n**取值范围**:\n\n不涉及。",
          "example": "proxy_name_1"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    }
  },
