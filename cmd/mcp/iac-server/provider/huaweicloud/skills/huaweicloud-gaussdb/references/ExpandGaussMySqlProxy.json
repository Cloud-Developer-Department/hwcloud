            "schema": {
              "$ref": "#/definitions/EnlargeProxyRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/MysqlJobId"
            },
            "examples": {
              "application/json": {
                "job_id": "04efe8e2-9255-44ae-a98b-d87cae411890"
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "扩容数据库代理节点。",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/619d3e78f61b4be68bc5aa0b59edcf7b/instances/61a4ea66210545909d74a05c27a7179ein07/proxy/enlarge",
        "x-request-examples-1": {
          "node_num": 2,
          "proxy_id": "151c14381ac14ecfb9703a745b992677po01"
        }
      }
    }
  },
  "definitions": {
    "MysqlJobId": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID。",
          "example": "6ad4eb1f-73bd-4876-aa31-aa9a1e41c4bc"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "EnlargeProxyRequest": {
      "description": "proxy节点扩容信息",
      "required": [
        "node_num"
      ],
      "properties": {
        "node_num": {
          "type": "integer",
          "format": "int32",
          "x-example": "2",
          "description": "proxy节点扩容操作需要扩容的节点数。\n\n扩容的节点数的取值范围:1~30之间的整数。\n\n限制条件:该实例的proxy节点的总数量小于等于32。"
        },
        "proxy_id": {
          "type": "string",
          "description": "数据库代理ID。\n\n如果实例只开启了一个代理,可不传该参数;如果实例开启了多个代理,则必须指定一个数据库代理,扩容新的代理节点。",
          "x-example": "169173c481b74b76b195659e8e29d3b8po01"
        }
      }
    }
