  "paths": {
    "/v3/{project_id}/instances/{instance_id}/proxy/enlarge": {
      "post": {
        "tags": [
          "数据库代理"
        ],
        "operationId": "ExpandGaussMySqlProxy",
        "summary": "扩容数据库代理节点的数量",
        "description": "扩容数据库代理节点的数量。\nDeC专属云账号暂不支持数据库代理。",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。",
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "语言。",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID,严格匹配UUID规则。",
            "required": true,
            "type": "string",
            "x-example": "61a4ea66210545909d74a05c27a7179ein07"
          },
          {
            "name": "EnlargeProxyRequest",
            "in": "body",
