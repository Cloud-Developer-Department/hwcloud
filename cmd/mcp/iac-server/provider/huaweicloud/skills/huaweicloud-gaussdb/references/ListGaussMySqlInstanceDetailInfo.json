  "definitions": {
    "MysqlDatastoreWithKernelVersion": {
      "required": [
        "type",
        "version",
        "kernel_version"
      ],
      "description": "数据库信息。",
      "properties": {
        "type": {
          "type": "string",
          "description": "数据库引擎,现在只支持gaussdb-mysql。"
        },
        "version": {
          "type": "string",
          "description": "兼容的开源数据库版本号,返回三位开源版本号。"
        },
        "kernel_version": {
          "type": "string",
          "description": "数据库内核版本"
        }
      }
    },
    "MysqlProxyInfo": {
      "description": "Proxy信息。",
      "properties": {
        "pool_id": {
          "type": "string",
          "description": "Proxy实例ID。"
        },
        "name": {
          "type": "string",
          "description": "Proxy实例名称。"
        },
        "address": {
          "type": "string",
          "description": "Proxy读写分离地址。"
        }
      }
    },
    "MysqlInstanceNodeVolumeInfo": {
      "required": [
        "type",
        "used",
        "size"
      ],
      "description": "存储盘信息。",
      "properties": {
        "type": {
          "type": "string",
          "description": "磁盘类型。"
        },
        "used": {
          "type": "string",
          "description": "已使用磁盘大小,单位GB。"
        },
        "size": {
          "type": "integer",
          "format": "int64",
          "description": "包周期购买的存储空间大小,单位GB。"
        }
      }
    },
    "MysqlInstanceInfoList": {
      "required": [
        "instances"
      ],
      "properties": {
        "instances": {
          "description": "实例详情。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MysqlInstanceInfoDetail"
          }
        }
      }
    },
    "MysqlBackupStrategy": {
      "required": [
        "start_time"
      ],
      "description": "自动备份策略",
      "properties": {
        "start_time": {
          "type": "string",
          "description": "自动备份开始时间段。自动备份将在该时间一个小时内触发。\n\n取值范围:非空,格式必须为hh:mm-HH:MM且有效,当前时间指UTC时间。\n\n1. HH取值必须比hh大1。\n2. mm和MM取值必须相同,且取值必须为00。",
          "example": "23:00-00:00"
        },
        "keep_days": {
          "type": "string",
          "description": "自动备份保留天数,取值范围:1-732"
        }
      }
    },
    "MysqlTags": {
      "description": "标签列表,根据标签键值对创建实例。\n- {key}表示标签键,不可以为空或重复。\n- {value}表示标签值,可以为空。\n\n如果创建实例时同时使用多个标签键值对,中间使用逗号分隔开,最多包含10组。",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "标签键。最大长度36个unicode字符。key不能为空或者空字符串,不能为空格。\n\n字符集:A-Z,a-z ,0-9,‘-’,‘_’,UNICODE字符(\\一-\\鿿)。"
        },
        "value": {
          "type": "string",
          "description": "标签值。最大长度43个unicode字符。可以为空字符串。\n\n字符集:A-Z,a-z ,0-9,‘.’,‘-’,‘_’,UNICODE字符(\\一-\\鿿)。"
        }
      }
    },
    "MysqlInstanceInfoDetail": {
      "required": [
        "id",
        "name",
        "project_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "实例ID。"
        },
        "name": {
          "type": "string",
          "description": "创建的实例名称。"
        },
        "project_id": {
          "type": "string",
          "description": "租户在某一region下的project ID。"
        },
        "status": {
          "type": "string",
          "description": "实例状态。\n\n取值:\n- 值为“BUILD”,表示实例正在创建。\n- 值为“ACTIVE”,表示实例正常。\n- 值为“FAILED”,表示实例创建失败。\n- 值为“FROZEN”,表示实例冻结。\n- 值为“MODIFYING”,表示实例正在扩容。\n- 值为“REBOOTING”,表示实例正在重启。\n- 值为“RESTORING”,表示实例正在恢复。\n- 值为“SWITCHOVER”,表示实例正在主备切换。\n- 值为“MIGRATING”,表示实例正在迁移。\n- 值为“BACKING UP”,表示实例正在进行备份。\n- 值为“MODIFYING DATABASE PORT”,表示实例正在修改数据库端口。\n- 值为“STORAGE FULL”,表示实例磁盘空间满。"
        },
        "port": {
          "type": "string",
          "description": "数据库端口号。"
        },
        "alias": {
          "type": "string",
          "description": "实例备注"
        },
        "type": {
          "type": "string",
          "description": "实例类型,取值为“Cluster”。"
        },
        "charge_info": {
          "$ref": "#/definitions/MysqlInstanceChargeInfo"
        },
        "node_count": {
          "type": "integer",
          "format": "int32",
          "description": "节点个数。"
        },
        "datastore": {
          "$ref": "#/definitions/MysqlDatastoreWithKernelVersion"
        },
        "backup_used_space": {
          "type": "number",
          "format": "double",
          "description": "备份空间使用大小,单位为GB。"
        },
        "created": {
          "type": "string",
          "description": "创建时间,格式为\"yyyy-mm-ddThh:mm:ssZ\"。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。\n\n说明:创建时返回值为空,数据库实例创建成功后该值不为空。"
        },
        "updated": {
          "type": "string",
          "description": "更新时间,格式与\"created\"字段对应格式完全相同。说明:创建时返回值为空,数据库实例创建成功后该值不为空。"
        },
        "private_write_ips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "实例的写内网IP。"
        },
        "private_dns_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "实例内网域名列表。实例创建成功后,需要手动申请内网域名,否则查询内网域名为空。"
        },
        "public_ips": {
          "type": "string",
          "description": "实例的公网IP。"
        },
        "db_user_name": {
          "type": "string",
          "description": "默认用户名。"
        },
        "vpc_id": {
          "type": "string",
          "description": "虚拟私有云ID。"
        },
        "subnet_id": {
          "type": "string",
          "description": "子网的网络ID信息。"
        },
        "security_group_id": {
          "type": "string",
          "description": "安全组ID。"
        },
        "configuration_id": {
          "type": "string",
          "description": "实例创建的模板ID,或者应用到实例的最新参数组模板ID。"
        },
        "backup_strategy": {
          "$ref": "#/definitions/MysqlBackupStrategy"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MysqlInstanceNodeInfo"
          }
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。"
        },
        "time_zone": {
          "type": "string",
          "description": "时区。"
        },
        "az_mode": {
          "type": "string",
          "description": "可用区模式,单可用区single或多可用区multi。"
        },
        "master_az_code": {
          "type": "string",
          "description": "主可用区。"
        },
        "maintenance_window": {
          "type": "string",
          "description": "可维护时间窗,为UTC时间。"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MysqlTags"
          },
          "description": "实例标签。"
        },
        "dedicated_resource_id": {
          "type": "string",
          "description": "专属资源池ID,只有数据库实例属于专属资源池才会返回该参数。"
        },
        "proxies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MysqlProxyInfo"
          }
        }
      }
    },
