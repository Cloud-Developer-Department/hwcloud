  "definitions": {
    "MetricCondition": {
      "properties": {
        "metric_name": {
          "type": "string",
          "description": "**参数描述**:\n\n指标名称。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n- cpuTotalUsage:CPU使用率。\n- memoryTotalUsage:内存使用率。\n\n**默认取值**:\n\n不涉及。"
        },
        "metric_value": {
          "type": "integer",
          "format": "int32",
          "description": "**参数描述**:\n\n指标变配阈值。\n\n**约束限制**:\n\n取值为百分比的10000倍,比如50%对应的参数值为5000。\n\n**取值范围**:\n\n6000-8000。\n\n**默认取值**:\n\n不涉及。"
        },
        "compare_mode": {
          "type": "string",
          "description": "**参数描述**:\n\n比较模式。\n\n**约束限制**:\n\n不涉及。。\n\n**取值范围**:\n\nGT:大于。\n\n**默认取值**:\n\n不涉及。"
        }
      }
    },
    "ScalingScene": {
      "description": "**参数描述**:\n\n变配场景。\n\n**约束限制**:\n\n只支持扩容场景。",
      "properties": {
        "conditions": {
          "type": "array",
          "description": "**参数解释**:\n\n变配条件。\n\n**约束限制**:\n\n不涉及。",
          "items": {
            "$ref": "#/definitions/ScalingCondition"
          }
        }
      }
    },
    "CustomScalingConfig": {
      "description": "**参数描述**:\n\n自定义扩容策略。\n\n**约束限制**:\n\n不涉及。",
      "properties": {
        "enlarge_scene": {
          "type": "object",
          "description": "**参数描述**:\n\n自定义扩容策略。\n\n**约束限制**:\n\n不涉及。",
          "$ref": "#/definitions/ScalingScene"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "ServerlessScalingPolicy": {
      "type": "object",
      "description": "**参数描述**:\n\n查询Serverless自定义扩容策略响应体。\n\n**约束限制**:\n\n不涉及。",
      "properties": {
        "enlarge_step_size": {
          "type": "string",
          "description": "**参数描述**:\n\n自定义扩容步长。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n2-算力上限的一半。\n\n**默认取值**:\n\n不涉及。"
        },
        "custom_scaling_config": {
          "type": "object",
          "description": "**参数描述**:\n\n自定义扩容策略。\n\n**约束限制**:\n\n不涉及。",
          "$ref": "#/definitions/CustomScalingConfig"
        }
      }
    },
    "ScalingCondition": {
      "description": "**参数描述**:\n\n变配条件。\n\n**约束限制**:\n\n至少各定义一个CPU使用率和内存使用率指标条件,最多各定义两个。",
      "type": "object",
      "properties": {
        "condition_id": {
          "type": "string",
          "description": "**参数描述**:\n\n变配条件名称。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n只能由英文字母、数字和中划线组成,且长度不超过32个字符,不能为空。\n\n**默认取值**:\n\n不涉及。"
        },
        "duration": {
          "type": "integer",
          "description": "**参数描述**:\n\n持续时间,单位是毫秒。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n2000-5000。\n\n**默认取值**:\n\n不涉及。"
        },
        "interval": {
          "type": "integer",
          "description": "**参数解释**:\n\n间隔时间,单位是毫秒。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n1000-5000。\n\n**默认取值**:\n\n不涉及。"
        },
        "metric_conditions": {
          "type": "array",
          "description": "**参数描述**:\n\n指标变配条件。\n\n**约束条件**:\n\n不涉及。",
          "items": {
            "$ref": "#/definitions/MetricCondition"
          }
        }
      }
    }
  },
