{
  "name": "ListLtsErrorLogDetails",
  "summary": "获取错误日志详情列表",
  "tags": "日志管理",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3.1/{project_id}/instances/{instance_id}/error-logs": {
      "post": {
        "tags": [
          "日志管理"
        ],
        "operationId": "ListLtsErrorLogDetails",
        "summary": "获取错误日志详情列表",
        "description": "获取指定实例的错误日志详情列表。",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "required": true,
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言。",
            "required": false,
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "ListLtsErrorLogDetailsRequestBody",
            "in": "body",
            "description": "查询错误日志请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LtsLogErrorQueryRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/LtsLogErrorDetailsResponse"
            },
            "examples": {
              "application/json": {
                "error_log_list": [
                  {
                    "node_id": "cc07c60e94ec4575989840e648fb4f66no07",
                    "time": "2022-11-25T10:55:16.000",
                    "level": "ERROR",
                    "content": "[MY013508] [Repl] do failed: 1",
                    "line_num": 1669344916000
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "查询错误日志详细信息。",
        "x-request-examples-url-1": "POST https://{endpoint}/v3.1/056538411200d4cd2f79c003c7606412/instances/096c0fc43e804757b59946b80dc27f8bin07/error-logs",
        "x-request-examples-1": {
          "start_time": "2022-11-20T00:00:00+0800",
          "end_time": "2022-11-29T00:00:00+0800",
          "node_id": "cc07c60e94ec4575989840e648fb4f66no07",
          "limit": 10,
          "line_num": 1669344916000
        }
      }
    }
  },
  "definitions": {
    "LtsLogErrorQueryRequest": {
      "required": [
        "node_id",
        "start_time",
        "end_time",
        "limit"
      ],
      "description": "错误日志请求体。",
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "description": "节点ID。"
        },
        "start_time": {
          "type": "string",
          "description": "开始时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
        },
        "end_time": {
          "type": "string",
          "description": "结束时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "查询记录数。"
        },
        "line_num": {
          "type": "string",
          "description": "日志单行序列号,第一次查询时不需要此参数,后续分页查询时需要使用,可从上次查询的返回信息中获取。"
        },
        "level": {
          "type": "string",
          "description": "日志级别,默认为ALL。\n\n取值范围:\n- ALL\n- INFO\n- LOG\n- WARNING\n- ERROR\n- FATAL\n- PANIC\n- NOTE"
        }
      }
    },
    "LtsLogErrorDetailsResponse": {
      "properties": {
        "error_log_list": {
          "type": "array",
          "description": "错误日志列表。",
          "items": {
            "$ref": "#/definitions/LtsLogErrorDetail"
          }
        }
      }
    },
    "LtsLogErrorDetail": {
      "properties": {
        "node_id": {
          "type": "string",
          "description": "节点ID。"
        },
        "time": {
          "type": "string",
          "description": "执行时间。"
        },
        "level": {
          "type": "string",
          "description": "日志级别。"
        },
        "content": {
          "type": "string",
          "description": "错误日志内容。"
        },
        "line_num": {
          "type": "string",
          "description": "日志单行序列号。"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}