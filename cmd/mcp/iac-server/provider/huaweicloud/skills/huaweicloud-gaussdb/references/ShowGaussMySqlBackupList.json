{
  "name": "ShowGaussMySqlBackupList",
  "summary": "查询全量备份列表",
  "tags": "备份管理",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/backups": {
      "get": {
        "tags": [
          "备份管理"
        ],
        "operationId": "ShowGaussMySqlBackupList",
        "summary": "查询全量备份列表",
        "description": "查询全量备份列表。",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。\n\n通过调用IAM服务[获取用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取。\n\n请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。\n",
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "请求语言类型。默认en-us。\n取值范围:\n- en-us\n- zh-cn",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一Region下的project ID。                          \n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "query",
            "description": "实例ID,严格匹配UUID规则。",
            "type": "string",
            "x-example": "b90dff1436824f5e999e04cccc2147f5in07"
          },
          {
            "name": "backup_id",
            "in": "query",
            "description": "备份ID。",
            "type": "string",
            "x-example": "43a3e152545343f099e5c0684fd9ead9br07"
          },
          {
            "name": "backup_type",
            "in": "query",
            "type": "string",
            "description": "备份类型。\n\n取值范围:\n- auto:自动全量备份。\n- manual:手动全量备份。",
            "x-example": "auto"
          },
          {
            "name": "offset",
            "in": "query",
            "type": "string",
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0(偏移0条数据,表示从第一条数据开始查询),必须为数字,不能为负数。"
          },
          {
            "name": "limit",
            "in": "query",
            "type": "string",
            "description": "查询记录数。默认为100,不能为负数,最小值为1,最大值为100。"
          },
          {
            "name": "begin_time",
            "in": "query",
            "type": "string",
            "description": "查询开始时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
          },
          {
            "name": "end_time",
            "in": "query",
            "type": "string",
            "description": "查询结束时间,格式为“yyyy-mm-ddThh:mm:ssZ”,且大于查询开始时间。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
          },
          {
            "name": "name",
            "in": "query",
            "type": "string",
            "description": "备份名称。"
          },
          {
            "name": "instance_name",
            "in": "query",
            "type": "string",
            "description": "实例名称。"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/MysqlBackupListResponse"
            },
            "examples": {
              "application/json": {
                "backups": [
                  {
                    "id": "7420f28010084e838113e78f77093093br07",
                    "name": "GaussDBforMySQL-gauss-e747-20200708185048266",
                    "begin_time": "2020-07-08T18:41:14+0800",
                    "end_time": "2020-07-08T20:45:14+0800",
                    "take_up_time": 2,
                    "status": "COMPLETED",
                    "type": "auto",
                    "size": 2803,
                    "datastore": {
                      "type": "gaussdb-mysql",
                      "version": "8.0"
                    },
                    "instance_id": "3ef58db3986540d19f95151309368d34in07",
                    "instance_name": "GaussDBforMySQL-gauss-e747",
                    "backup_level": "2"
                  }
                ],
                "total_count": 1
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "查询时间段内(2020-07-06~2020-07-16)的自动备份列表。",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/97b026aa9cc4417888c14c84a1ad9860/backups?instance_id=3ef58db3986540d19f95151309368d34in07&backup_id=7420f28010084e838113e78f77093093br07&backup_type=auto&offset=0&limit=10&begin_time=2020-07-06T10:41:14+0800&end_time=2020-07-16T10:41:14+0800"
      }
    }
  },
  "definitions": {
    "MysqlDatastoreInBackup": {
      "required": [
        "type",
        "version"
      ],
      "description": "数据库信息。",
      "properties": {
        "type": {
          "type": "string",
          "description": "数据库引擎,现在只支持gaussdb-mysql。"
        },
        "version": {
          "type": "string",
          "description": "数据库版本。\n\n数据库支持的版本信息,获取方法请参见[查询数据库引擎的版本](https://support.huaweicloud.com/api-taurusdb/ShowGaussMySqlEngineVersion.html)返回的name字段。"
        }
      }
    },
    "backups": {
      "properties": {
        "id": {
          "type": "string",
          "description": "备份ID。"
        },
        "name": {
          "type": "string",
          "description": "备份名称。"
        },
        "begin_time": {
          "type": "string",
          "description": "备份开始时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
        },
        "end_time": {
          "type": "string",
          "description": "备份结束时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
        },
        "status": {
          "type": "string",
          "description": "备份状态,取值:\n- BUILDING:备份中。\n- COMPLETED:备份完成。\n- FAILED:备份失败。\n- AVAILABLE:备份可用。"
        },
        "take_up_time": {
          "type": "integer",
          "format": "int32",
          "description": "备份花费时间(单位:minutes)"
        },
        "type": {
          "type": "string",
          "description": "备份类型,取值:\n\n- auto:自动全量备份。\n- manual:手动全量备份。"
        },
        "size": {
          "type": "number",
          "format": "double",
          "description": "备份大小(单位:MB)。"
        },
        "datastore": {
          "type": "object",
          "description": "数据库信息。",
          "$ref": "#/definitions/MysqlDatastoreInBackup"
        },
        "instance_id": {
          "type": "string",
          "description": "实例ID,严格匹配UUID规则。"
        },
        "instance_name": {
          "type": "string",
          "description": "实例名称。"
        },
        "backup_level": {
          "enum": [
            "0",
            "1",
            "2"
          ],
          "type": "string",
          "description": "备份级别。当开启一级备份开关时,返回该参数。"
        },
        "description": {
          "type": "string",
          "description": "备份文件描述信息。"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "MysqlBackupListResponse": {
      "properties": {
        "backups": {
          "type": "array",
          "description": "备份信息。",
          "items": {
            "$ref": "#/definitions/backups"
          }
        },
        "total_count": {
          "type": "integer",
          "format": "int64",
          "description": "备份文件的总数。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}