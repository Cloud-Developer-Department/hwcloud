{
  "name": "ShowGaussMySqlEngineVersion",
  "summary": "查询数据库引擎的版本",
  "tags": "查询数据库引擎的版本",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/datastores/{database_name}": {
      "get": {
        "tags": [
          "查询数据库引擎的版本"
        ],
        "operationId": "ShowGaussMySqlEngineVersion",
        "summary": "查询数据库引擎的版本",
        "description": "获取指定数据库引擎对应的数据库版本信息。",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。",
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "语言。",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。\n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "database_name",
            "in": "path",
            "description": "数据库引擎。支持的引擎如下,不区分大小写:gaussdb-mysql。",
            "required": true,
            "type": "string",
            "x-example": "gaussdb-mysql"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/MysqlEngineVersion"
            },
            "examples": {
              "application/json": {
                "datastores": [
                  {
                    "id": "87620726-6802-46c0-9028-a8785e1f1921",
                    "name": "8.0",
                    "version": "8.0.22",
                    "kernel_version": "2.0.28.18"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "查询TaurusDB数据库的版本信息。",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/619d3e78f61b4be68bc5aa0b59edcf7b/datastores/gaussdb-mysql"
      }
    }
  },
  "definitions": {
    "MysqlEngineVersionInfo": {
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "数据库版本ID,该字段不会有重复"
        },
        "name": {
          "type": "string",
          "description": "数据库版本号,只返回两位数的大版本号"
        },
        "version": {
          "type": "string",
          "description": "兼容的开源数据库版本号,返回三位开源版本号。"
        },
        "kernel_version": {
          "type": "string",
          "description": "数据库版本号,返回完整的四位版本号。"
        }
      }
    },
    "MysqlEngineVersion": {
      "required": [
        "datastores"
      ],
      "properties": {
        "datastores": {
          "description": "数据库版本信息列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MysqlEngineVersionInfo"
          }
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}