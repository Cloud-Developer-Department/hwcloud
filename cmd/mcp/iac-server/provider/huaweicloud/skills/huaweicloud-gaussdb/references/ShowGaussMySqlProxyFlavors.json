  },
  "definitions": {
    "MysqlProxyComputeFlavor": {
      "required": [
        "vcpus",
        "ram",
        "type",
        "id",
        "spec_code",
        "db_type",
        "az_status"
      ],
      "properties": {
        "vcpus": {
          "type": "string",
          "description": "CPU大小。例如:1表示1U。"
        },
        "ram": {
          "type": "string",
          "description": "内存大小,单位为GB。"
        },
        "db_type": {
          "type": "string",
          "description": "数据库类型。"
        },
        "id": {
          "type": "string",
          "description": "Proxy规格ID。"
        },
        "spec_code": {
          "type": "string",
          "description": "Proxy规格码。"
        },
        "az_status": {
          "type": "object",
          "description": "其中key是可用区编号,value是规格所在az的状态。"
        }
      }
    },
    "MysqlProxyFlavors": {
      "properties": {
        "proxy_flavor_groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MysqlProxyFlavorGroups"
          },
          "description": "规格组信息。"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "MysqlProxyFlavorGroups": {
      "properties": {
        "group_type": {
          "type": "string",
          "description": "规格组类型,如x86、arm。"
        },
        "proxy_flavors": {
          "description": "规格信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MysqlProxyComputeFlavor"
          }
        }
      }
    }
  },
