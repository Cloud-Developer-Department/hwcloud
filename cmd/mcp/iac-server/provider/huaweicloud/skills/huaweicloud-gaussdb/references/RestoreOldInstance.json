  "definitions": {
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "RestoreRequest": {
      "required": [
        "target_instance_id",
        "source_instance_id",
        "type"
      ],
      "properties": {
        "target_instance_id": {
          "description": "目标实例ID。",
          "type": "string"
        },
        "source_instance_id": {
          "description": "源实例ID。",
          "type": "string"
        },
        "backup_id": {
          "description": "用于恢复的备份ID。当使用备份文件恢复时需要指定该参数。",
          "type": "string"
        },
        "restore_time": {
          "description": "恢复数据的时间点,格式为UNIX时间戳,单位是毫秒,时区为UTC。",
          "type": "integer",
          "format": "int64"
        },
        "type": {
          "type": "string",
          "description": "表示恢复方式,枚举值:\n- backup:表示使用备份文件恢复,按照此方式恢复时,当\"type\"字段为非必选时,\"backup_id\"必选。\n- timestamp:表示按时间点恢复,按照此方式恢复时,当\"type\"字段必选时,\"restore_time\"必选。"
        }
      }
    },
    "RestoreResponse": {
      "properties": {
        "job_id": {
          "description": "工作流ID。",
          "type": "string"
        }
      }
