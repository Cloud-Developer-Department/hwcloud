{
  "name": "ShowInstanceDatabaseVersion",
  "summary": "查询内核版本信息",
  "tags": "实例管理",
  "productshort": "GaussDB",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/database-version": {
      "get": {
        "tags": [
          "实例管理"
        ],
        "summary": "查询内核版本信息",
        "description": "查询内核版本信息。",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "operationId": "ShowInstanceDatabaseVersion",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务[获取用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取。\n\n请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。\n",
            "type": "string",
            "required": true,
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型。默认en-us。\n取值范围:\n- en-us\n- zh-cn",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一Region下的project ID。                          \n\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-taurusdb/taurusdb_10_0004.html)。\n",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID,严格匹配UUID规则。",
            "required": true,
            "type": "string",
            "x-example": "61a4ea66210545909d74a05c27a7179ein07"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ShowInstanceDatabaseVersionResp"
            },
            "examples": {
              "application/json": {
                "datastore": {
                  "current_version": "8.0.22",
                  "current_kernel_version": "2.0.28.15",
                  "latest_version": "8.0.22",
                  "latest_kernel_version": "2.0.42.230600"
                },
                "upgrade_flag": true
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/MysqlErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "查询内核版本信息。",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/97b026aa9cc4417888c14c84a1ad9860/instances/61a4ea66210545909d74a05c27a7179ein07/database-version"
      }
    }
  },
  "definitions": {
    "ShowInstanceDatabaseVersionResp": {
      "properties": {
        "datastore": {
          "$ref": "#/definitions/InstanceDatabaseVersionInfo"
        },
        "upgrade_flag": {
          "description": "是否可升级。\n- true:是。\n- false:否。",
          "type": "boolean"
        }
      }
    },
    "MysqlErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例不存在"
        }
      }
    },
    "InstanceDatabaseVersionInfo": {
      "description": "数据库版本信息。",
      "properties": {
        "current_version": {
          "description": "当前数据库版本。",
          "type": "string"
        },
        "current_kernel_version": {
          "description": "当前数据库内核版本。",
          "type": "string"
        },
        "latest_version": {
          "description": "最新数据库版本。",
          "type": "string"
        },
        "latest_kernel_version": {
          "description": "最新数据库内核版本。",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-mysql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}