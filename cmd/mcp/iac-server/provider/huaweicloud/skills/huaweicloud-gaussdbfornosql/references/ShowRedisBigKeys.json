{
  "name": "ShowRedisBigKeys",
  "summary": "查询Redis实例的大key",
  "tags": "实例管理",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/big-keys": {
      "post": {
        "tags": [
          "实例管理"
        ],
        "operationId": "ShowRedisBigKeys",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "summary": "查询Redis实例的大key",
        "description": "支持查询Redis实例的大key。value长度大于bigkeys-string-threshold参数的string类型的key或者元素数大于bigkeys-composite-threshold参数的hash/list/zset/set/stream类型key,会被判断为大key。",
        "x-constraint": "[该接口支持如下数据库实例:]\n  - [GeminiDB Redis]",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/instances/91b5c48e11bf4913b35814f28b8f79f2in12/big-keys",
        "x-request-examples-description-1": "支持查询Redis实例的大key。value长度大于bigkeys-string-threshold参数的string类型的key或者元素数大于bigkeys-composite-threshold参数的hash/list/zset/set/stream类型key,会被判断为大key。",
        "x-request-examples-text-1": {
          "key_types": [
            "string",
            "hash",
            "zset",
            "set",
            "list",
            "stream"
          ]
        },
        "x-request-examples-1": {
          "key_types": [
            "string",
            "hash",
            "zset",
            "set",
            "list",
            "stream"
          ]
        },
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一region下的project ID。"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "实例ID。"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。",
            "type": "string"
          },
          {
            "name": "ShowRedisBigKeysRequestBody",
            "in": "body",
            "required": false,
            "description": "查询Redis大key的请求体。",
            "schema": {
              "$ref": "#/definitions/ShowRedisBigKeysRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ShowRedisBigKeysResponseBody"
            },
            "examples": {
              "application/json": {
                "keys": [
                  {
                    "db_id": 0,
                    "key_type": "String",
                    "key_name": "a",
                    "key_size": 12
                  }
                ],
                "count": 1
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "BigKeysInfoResponseBody": {
      "type": "object",
      "properties": {
        "db_id": {
          "type": "integer",
          "format": "int32",
          "description": "大Key所在的DB。"
        },
        "key_type": {
          "type": "string",
          "description": "大Key类型。"
        },
        "key_name": {
          "type": "string",
          "description": "大Key名。"
        },
        "key_size": {
          "type": "integer",
          "description": "大Key的长度。"
        }
      }
    },
    "ShowRedisBigKeysResponseBody": {
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BigKeysInfoResponseBody"
          },
          "description": "查询到的大Key列表。"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "大Key的总数。"
        }
      }
    },
    "ShowRedisBigKeysRequestBody": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "索引位置偏移量,表示从查询到的大key列表偏移offset条数据后查询对应的大key信息。 取值大于或等于0。不传该参数时,查询偏移量默认为0,表示从第一条大key开始查询。"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "查询个数上限值。 取值范围:1~100。不传该参数时,默认查询前100条大key。"
        },
        "key_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "大key的类型,一个字符串列表,支持\"string\",\"hash\",\"zset\",\"set\",\"list\",\"stream\"六种类型。"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    }
  },
