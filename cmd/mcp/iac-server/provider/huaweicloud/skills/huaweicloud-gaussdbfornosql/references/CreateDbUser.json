{
  "name": "CreateDbUser",
  "summary": "创建Redis数据库账号",
  "tags": "管理数据库和用户",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/redis/instances/{instance_id}/db-users": {
      "post": {
        "tags": [
          "管理数据库和用户"
        ],
        "operationId": "CreateDbUser",
        "summary": "创建Redis数据库账号",
        "description": "在Redis实例中创建数据库帐号。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-ratelimit": "nosql_default_policy",
        "x-constraint": "- 只支持GeminiDB Redis引擎。\n- 实例在创建、变更规格、修改端口、异常状态或冻结状态下不能执行该操作。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "054e292c9880d4992f02c0196d3ea468"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "054e292c9880d4992f02c0196d3ein12"
          },
          {
            "name": "RedisCreateDbUserRequest",
            "in": "body",
            "description": "创建账号请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RedisCreateDbUserRequest"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted.",
            "examples": {
              "application/json": {
                "job_id": "f85104b5-4a9c-4e0f-9505-fc5409d8f7ae"
              }
            },
            "schema": {
              "$ref": "#/definitions/RedisCreateDbUserResponse"
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v3/0549b4a43100d4f32f51c01c2fe4acdb/redis/054e292c9880d4992f02c0196d3ein12/db-users",
        "x-request-examples-text-1": {
          "users": [
            {
              "name": "redis1",
              "password": "****",
              "privilege": "ReadOnly",
              "databases": [
                "1",
                "2"
              ]
            },
            {
              "name": "redis2",
              "password": "****",
              "privilege": "ReadOnly",
              "databases": [
                "1",
                "2"
              ]
            }
          ]
        },
        "x-request-examples-1": {
          "users": [
            {
              "name": "redis1",
              "password": "****",
              "privilege": "ReadOnly",
              "databases": [
                "1",
                "2"
              ]
            },
            {
              "name": "redis2",
              "password": "****",
              "privilege": "ReadOnly",
              "databases": [
                "1",
                "2"
              ]
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "RedisCreateDbUserResponse": {
      "type": "object",
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID。"
        }
      }
    },
    "RedisCreateDbUserRequest": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RedisUserForCreation"
          },
          "description": "需要创建的账号列表"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "RedisUserForCreation": {
      "required": [
        "name",
        "password",
        "databases",
        "privilege"
      ],
      "properties": {
        "name": {
          "description": "账号名称。\n\n小于36个字符,以字母开头,仅包含数字、字母、中划线、下划线。",
          "type": "string"
        },
        "password": {
          "description": "- 密码长度为8~32位。\n\n- 密码需包含大写字母、小写字母、数字和特殊字符中的至少三种,支持的特殊字符为!@#$%^&*()_+-= 。",
          "type": "string",
          "minLength": 8,
          "maxLength": 32
        },
        "databases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "账号授权的数据库名称列表,至少指定一个数据库。"
        },
        "privilege": {
          "type": "string",
          "description": "账号权限。\n\n- 取值\"ReadOnly\":账号为只读权限;\n- 取值\"ReadWrite\":账号为读写权限。"
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-nosql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
