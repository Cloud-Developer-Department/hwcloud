{
  "name": "ListConfigurationDatastores",
  "summary": "查询支持参数模板的接口信息",
  "tags": "参数模板管理",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/configurations/datastores": {
      "get": {
        "x-request-examples-url-1": "GET https://{endpoint}/v3/375d8d8fad1f43039e23d3b6c0f60a19/configurations/datastores",
        "tags": [
          "参数模板管理"
        ],
        "summary": "查询支持参数模板的接口信息",
        "description": "查询支持参数模板的接口信息",
        "operationId": "ListConfigurationDatastores",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-constraint": "该接口支持如下数据库实例。\n- GeminiDB Cassandra\n- GeminiDB Mongo\n- GeminiDB Influx\n- GeminiDB Redis",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "用户token。",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一region下的project ID。"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/ListConfigurationDatastoresResponseBody"
            },
            "examples": {
              "application/json": {
                "datastores": [
                  {
                    "datastore_name": "mongodb",
                    "mode": "ReplicaSet",
                    "version": "4.0"
                  },
                  {
                    "datastore_name": "influxdb",
                    "mode": "InfluxdbCluster",
                    "version": "1.8"
                  },
                  {
                    "datastore_name": "cassandra",
                    "mode": "ReplicaCircle",
                    "version": "3.11"
                  },
                  {
                    "datastore_name": "redis",
                    "mode": "RedisCluster",
                    "version": "5.0"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "DataStoreList": {
      "type": "object",
      "required": [
        "datastore_name",
        "version",
        "mode"
      ],
      "properties": {
        "datastore_name": {
          "type": "string",
          "description": "数据库引擎。"
        },
        "version": {
          "type": "string",
          "description": "数据库引擎版本。"
        },
        "mode": {
          "type": "string",
          "description": "数据库实例类型。\n**取值范围:**\n取值为“Cluster”,表示GeminiDB Cassandra经典部署模式集群、GeminiDB Influx经典部署模式集群、GeminiDB Redis Proxy集群经典部署模式集群实例类型。\n取值为“CloudNativeCluster”, 表示GeminiDB Cassandra云原生部署模式实例类型。\n取值为“InfluxdbSingle”,表示GeminiDB Influx经典部署模式单节点类型实例类型。\n取值为“ReplicaSet”,表示GeminiDB Mongo副本集实例类型。"
        }
      }
    },
    "ListConfigurationDatastoresResponseBody": {
      "type": "object",
      "required": [
        "datastores"
      ],
      "properties": {
        "datastores": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DataStoreList"
          },
          "description": "引擎信息。"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
