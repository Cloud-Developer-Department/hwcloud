        "summary": "获取节点会话列表",
        "description": "获取节点会话列表。",
        "operationId": "ListInstancesSession",
        "x-api-type": "open-api",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一region下的project ID。"
          },
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "节点ID。"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "索引位置,偏移量。取值大于或等于0。不传该参数时,查询偏移量默认为0,表示从最新创建的实例节点连接开始查询。",
            "type": "integer"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "分页查询页数。不传该参数时,默认每页50条实例节点连接信息,最大100条。",
            "type": "integer"
          },
          {
            "name": "addr_prefix",
            "in": "query",
            "required": false,
            "description": "用户端地址前缀匹配字符串。完整的地址由ip和端口号组成。不传默认查询所有。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/ListInstancesSessionRespondBody"
            },
            "description": "Success."
          }
        }
      }
    }
  },
