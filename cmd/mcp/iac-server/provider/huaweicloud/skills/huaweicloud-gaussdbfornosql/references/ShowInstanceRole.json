{
  "name": "ShowInstanceRole",
  "summary": "获取容灾实例主/备角色信息",
  "tags": "容灾管理",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/instance-role": {
      "get": {
        "tags": [
          "容灾管理"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "summary": "获取容灾实例主/备角色信息",
        "description": "该接口用于获取容灾实例主/备角色信息,以便后续容灾实例备升主和容灾实例主降备接口调用。",
        "x-constraint": "该接口支持GeminiDB Redis数据库实例。",
        "operationId": "ShowInstanceRole",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一region下的project ID。",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "实例ID。",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein06"
          },
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "description": "用户Token",
            "type": "string",
            "x-example": "******"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/NoSqlInstanceRole"
            },
            "x-response-examples-description-1": "实例为主实例:",
            "x-response-examples-1": {
              "application/json": {
                "role": "master"
              }
            },
            "x-response-examples-description-2": "实例为备实例:",
            "x-response-examples-2": {
              "application/json": {
                "role": "slave"
              }
            }
          }
        },
        "x-apigateway-ratelimit": "nosql_default_policy",
        "x-request-examples-description-1": "URI样例",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/341f3291813f4fb6a523a8448aa86570in12/instance-role",
        "x-request-examples-description-2": "URI样例",
        "x-request-examples-url-2": "GET https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/419bdeb827c8419e88bb37f50e36c2e1in12/instance-role"
      }
    }
  },
  "definitions": {
    "NoSqlInstanceRole": {
