        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "用户在某一region下的projectId。"
          },
          {
            "name": "job_name",
            "in": "query",
            "required": false,
            "description": "任务名称,默认为空。对应取值如下:\n\t\"REBOOT\":重启实例\n\t\"RESIZE_FLAVOR\":变更实例的CPU和内存规格\n\t\"UPGRADE_DATABASE\":补丁升级",
            "type": "string"
          },
          {
            "name": "job_status",
            "in": "query",
            "required": false,
            "description": "任务执行状态,默认为空。 取值:\n\t值为\"Pending\",表示任务未执行。\n\t值为\"Running\",表示任务正在执行。\n\t值为\"Completed\",表示任务执行成功。\n\t值为\"Failed\",表示任务执行失败。\n\t值为\"Canceled\",表示任务取消执行。",
            "type": "string"
          },
          {
            "name": "instance_id",
            "in": "query",
            "required": false,
            "description": "实例ID,不传该值默认查所有符合条件的实例。",
            "type": "string"
          },
          {
            "name": "start_time",
            "in": "query",
            "required": false,
            "description": "任务创建起始时间,格式为\"yyyy-mm-ddThh:mm:ssZ\"。 其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100,不传默认为当前时间前七天。",
            "type": "string"
          },
          {
            "name": "end_time",
            "in": "query",
            "required": false,
            "description": "任务创建结束时间,格式为\"yyyy-mm-ddThh:mm:ssZ\"。 其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100,不传默认为当前时间。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0。",
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "查询记录数。不传该参数时,默认为10,取值范围1-100。",
            "type": "string"
          }
        ],
        "responses": {
