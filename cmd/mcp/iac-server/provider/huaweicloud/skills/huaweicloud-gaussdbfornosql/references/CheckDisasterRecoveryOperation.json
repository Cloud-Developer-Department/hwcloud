        "x-request-examples-description-2": "校验实例是否可以与特定实例解除容灾关系。",
        "x-request-examples-url-2": "POST https://{endpoint}/v3/0549b4a43100d4f32f51c01c2fe4acdb/instances/f90458c41aea4c26a9dcbb5740f2ff76in12/disaster-recovery/precheck",
        "x-request-examples-2": {
          "operation": "deconstruction"
        }
      }
    }
  },
