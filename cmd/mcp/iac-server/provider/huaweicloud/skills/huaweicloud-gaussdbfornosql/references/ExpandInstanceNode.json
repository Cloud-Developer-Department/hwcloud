{
  "name": "ExpandInstanceNode",
  "summary": "扩容指定集群实例的节点数量",
  "tags": "实例管理",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/enlarge-node": {
      "post": {
        "tags": [
          "实例管理"
        ],
        "operationId": "ExpandInstanceNode",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "summary": "扩容指定集群实例的节点数量",
        "description": "扩容指定集群实例的节点数量。",
        "x-constraint": "该接口支持如下数据库实例:\n- GeminiDB Cassandra\n- GeminiDB Redis\n- GeminiDB Redis实例支持的最大最小磁盘容量和节点数、规格相关,如果目标结果无法满足实例运行所需的磁盘大小,将无法扩容节点。\n- 该接口既支持包周期实例,也支持按需实例。\nGeminiDB Redis主备版实例不支持节点扩容。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein06"
          },
          {
            "name": "EnlargeInstanceRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ExpandInstanceNodeRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ExpandInstanceNodeResponseBody"
            },
            "examples": {
              "application/json": {
                "job_id": "04efe8e2-9255-44ae-a98b-d87cae411890"
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "扩容cassandra节点数量:",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/054e292c9880d4992f02c0196d3ein06/enlarge-node",
        "x-request-examples-1": {
          "num": 1
        }
      }
    }
  },
  "definitions": {
    "ExpandInstanceNodeResponseBody": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID,仅按需实例时会返回该参数。",
          "example": "6ad4eb1f-73bd-4876-aa31-aa9a1e41c4bc"
        },
        "order_id": {
          "type": "string",
          "description": "订单ID,仅创建包年包月实例时返回该参数。",
          "example": "CS20070721568OVO9"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "ExpandInstanceNodeRequestBody": {
      "required": [
        "num"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "description": "新增加的节点数量。"
        },
        "subnet_id": {
          "type": "string",
          "description": "扩容的节点所使用的子网的ID。\n- 该参数仅只支持GeminiDB Cassandra数据库实例扩容节点时传入。\n- 所传入的子网ID必须属于实例当前所在的VPC。\n- 不传该参数时,系统会在当前实例所使用的子网中为当前扩容的节点选择一个IP容量较为充足的子网。"
        },
        "is_auto_pay": {
          "type": "string",
          "description": "创建包周期实例时可指定,表示是否自动从账户中支付,此字段不影响自动续订的支付方式。\n- true,表示自动从账户中支付。\n- false,表示手动从账户中支付,默认为该方式。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
