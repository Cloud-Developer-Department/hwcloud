{
  "name": "SetBackupPolicy",
  "summary": "设置自动备份策略",
  "tags": "备份与恢复",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/backups/policy": {
      "put": {
        "tags": [
          "备份与恢复"
        ],
        "operationId": "SetBackupPolicy",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "summary": "设置自动备份策略",
        "description": "设置自动备份策略。",
        "x-constraint": "该接口支持如下数据库实例。\n- GeminiDB Cassandra\n- GeminiDB Influx",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "required": true,
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein06"
          },
          {
            "name": "SetBackupPolicyRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SetBackupPolicyRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success."
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "开启或修改自动备份策略:",
        "x-request-examples-url-1": "PUT https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/3d39c18788b54a919bab633874c159dfin02/backups/policy",
        "x-request-examples-1": {
          "backup_policy": {
            "keep_days": 9,
            "start_time": "08:15-09:15",
            "period": "1,4,5,6,7"
          }
        },
        "x-request-examples-description-2": "关闭自动备份策略",
        "x-request-examples-url-2": "PUT https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/3d39c18788b54a919bab633874c159dfin02/backups/policy",
        "x-request-examples-2": {
          "backup_policy": {
            "keep_days": 0
          }
        }
      }
    }
  },
  "definitions": {
    "SetBackupPolicyRequestBody": {
      "required": [
        "backup_policy"
      ],
      "properties": {
        "backup_policy": {
          "description": "备份策略对象,包括备份保留的天数和备份开始时间。",
          "$ref": "#/definitions/BackupPolicy"
        }
      }
    },
    "BackupPolicy": {
      "description": "备份策略对象,包括备份保留的天数和备份开始时间。",
      "required": [
        "keep_days"
      ],
      "properties": {
        "keep_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 35,
          "description": "指定已生成的备份文件可以保存的天数。\n取值范围:0~35。取0值,表示关闭自动备份策略。"
        },
        "start_time": {
          "type": "string",
          "example": "08:15-09:15",
          "description": "备份时间段。自动备份将在该时间段内触发。开启自动备份策略时,该参数必选;关闭自动备份策略时,不传该参数。\n取值范围:格式必须为hh:mm-HH:MM,且有效,当前时间指UTC时间。\n- HH取值必须比hh大1。\n- mm和MM取值必须相同,且取值必须为00、30。\n- 不传该参数,默认的备份时间段为00:00-01:00。\n- 取值示例:23:00-00:00。"
        },
        "period": {
          "type": "string",
          "example": "1,2,3,4",
          "description": "备份周期配置。自动备份将在每星期指定的天进行。\n取值范围:格式为半角逗号隔开的数字,数字代表星期。保留天数取值不同,备份周期约束如下:\n- 0天,不传该参数。\n- 1~6天,备份周期全选,取值为:1,2,3,4,5,6,7。\n- 7~732天,备份周期至少选择一周中的一天。示例:1,2,3,4。"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-nosql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "put",
  "uri": null
}