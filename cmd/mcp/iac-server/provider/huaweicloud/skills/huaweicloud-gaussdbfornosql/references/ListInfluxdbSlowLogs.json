{
  "name": "ListInfluxdbSlowLogs",
  "summary": "查询GeminiDB(for influxdb)数据库慢日志",
  "tags": "日志管理",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/influxdb/instances/{instance_id}/slow-logs": {
      "post": {
        "tags": [
          "日志管理"
        ],
        "operationId": "ListInfluxdbSlowLogs",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "summary": "查询GeminiDB(for influxdb)数据库慢日志",
        "description": "查询GeminiDB(for influxdb)数据库慢日志信息,支持日志关键字搜索。",
        "x-constraint": "- 在入参start_time和end_time的时间段内。\n- 当次查询的日志起始行号line_num须从上一次查询的日志返回信息中获取,第一次查询可不传。\n- 每页查询最大限制100条。\n- 慢日志最多保存30天。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID,可以调用“查询实例列表和详情”接口获取。如果未申请实例,可以调用“创建实例”接口创建。",
            "required": true,
            "type": "string",
            "x-example": "a6d3c8a9857b4c81b3c1fe4802dfa4d0in13"
          },
          {
            "name": "ListInfluxdbSlowLogsRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListInfluxdbSlowLogsRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ListInfluxdbSlowLogsResponseBody"
            },
            "examples": {
              "application/json": {
                "slow_logs": [
                  {
                    "node_name": "test_worker_node_1",
                    "node_id": "dbd0b65ed0c34125a0b04d4e5ba67e66no02",
                    "whole_message": "GqKc6_S",
                    "operate_type": "set",
                    "cost_time": 60.12,
                    "log_time": "2022-09-15T22:49:38.643000Z",
                    "line_num": "1595659490239433659"
                  }
                ]
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/619d3e78f61b4be68bc5aa0b59edcf7b/redis/instances/a6d3c8a9857b4c81b3c1fe4802dfa4d0in12/slow-logs",
        "x-request-examples-1": {
          "start_time": "2022-09-06T10:41:14+0800",
          "end_time": "2022-09-16T10:41:14+0800",
          "limit": 100,
          "line_num": "1595659490239433658",
          "operate_type": "set",
          "node_id": "2997329fe3cb4b3faedcade16df6966eno12",
          "keywords": [
            "log",
            "test"
          ],
          "max_cost_time": 100.12,
          "min_cost_time": 50.12
        }
      }
    }
  },
  "definitions": {
