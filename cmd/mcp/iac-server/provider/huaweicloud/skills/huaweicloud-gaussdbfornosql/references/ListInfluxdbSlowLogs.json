        },
        "line_num": {
          "type": "string",
          "description": "日志单行序列号。"
        }
      }
    },
    "ListInfluxdbSlowLogsResponseBody": {
      "type": "object",
      "properties": {
        "slow_logs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InfluxdbSlowLogDetail"
          },
          "description": "Influxdb慢日志列表"
        }
      },
      "required": [
        "slow_logs"
      ]
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "ListInfluxdbSlowLogsRequestBody": {
      "type": "object",
      "description": "查询Influxdb慢日志请求体",
      "required": [
        "start_time",
        "end_time",
        "limit"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "description": "开始时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。注:开始时间不得早于当前时间30天。"
        },
        "end_time": {
          "type": "string",
          "description": "结束时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。注:结束时间不能晚于当前时间。"
        },
        "limit": {
          "type": "integer",
          "description": "表示每次查询的日志条数,最大限制100条。"
        },
        "line_num": {
          "type": "string",
          "description": "日志单行序列号,第一次查询时不需要此参数,下一次查询时需要使用,可从上一次查询的返回信息中获取。 说明:当次查询从line_num的下一条日志开始查询,不包含当前line_num日志。"
        },
        "operate_type": {
          "type": "string",
          "description": "语句类型,取空值,表示查询所有语句类型。\n可取值:SELECT、DELETE 、SHOW 、DROP 、CREATE 、ALTER"
        },
        "node_id": {
          "type": "string",
          "description": "节点ID,取空值,表示查询实例下所有允许查询的节点。 具体取值请参考查询实例列表和详情接口\"ListInstances\"中nodes字段数据结构说明的“id”。"
        },
        "keywords": {
          "type": "string",
          "description": "根据多个关键字搜索日志全文,表示同时匹配所有关键字。 - 最多支持10个关键字。 - 每个关键字最大长度不超过512个字符。"
        },
        "max_cost_time": {
          "type": "integer",
          "description": "支持根据最大执行时间范围查找日志。单位:ms"
        },
        "min_cost_time": {
          "type": "integer",
          "description": "支持根据最小执行时间范围查找日志。单位:ms"
        },
        "database": {
          "type": "string",
          "description": "数据库名称。"
        },
        "retention_policy": {
          "type": "string",
          "description": "保留策略。"
        }
      }
    }
  },
