        "log_time",
        "database",
        "retention_policy",
        "line_num"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "description": "节点ID。"
        },
        "node_name": {
          "type": "string",
          "description": "节点名称。"
        },
        "whole_message": {
          "type": "string",
          "description": "执行语句。"
        },
        "operate_type": {
          "type": "string",
          "description": "语句类型。"
        },
        "cost_time": {
          "type": "string",
          "description": "执行时间。单位:ms"
        },
        "log_time": {
          "type": "string",
          "description": "日志产生时间,UTC时间。 格式为“yyyy-mm-ddThh:mm:ssZ”。 其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。"
        },
        "database": {
          "type": "string",
          "description": "数据库名称。"
        },
        "retention_policy": {
          "type": "string",
