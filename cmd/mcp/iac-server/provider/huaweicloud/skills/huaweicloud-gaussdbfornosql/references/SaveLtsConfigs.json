{
  "name": "SaveLtsConfigs",
  "summary": "关联LTS日志流",
  "tags": "日志管理",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/logs/lts-configs": {
      "post": {
        "tags": [
          "日志管理"
        ],
        "operationId": "SaveLtsConfigs",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "summary": "关联LTS日志流",
        "description": "- 将实例日志与LTS日志流关联,后台将自动上传实例日志到关联的LTS日志流里。\n- 关联成功后,会产生一定费用,具体计费可参考云日志服务(LTS)的定价详情。\n- 系统会为当前选择的日志流创建对应日志类型的结构化配置,若该日志流已存在其他日志类型的结构化配置,系统会进行覆盖。",
        "x-constraint": "- 仅支持GeminiDB Redis所有部署模式数据库实例的慢日志配置。\n- 仅支持GeminiDB Redis经典部署模式Proxy集群类型、主备类型实例和GeminiDB Mongo数据库实例的审计日志配置。\n- 部分低版本的实例需要升级内核小版本以支持审计日志配置功能。\n- 创建中、已删除、冻结状态的实例不支持该操作。\n- 最大支持100条数据。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言。",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "SaveLtsConfigsRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SaveLtsConfigsRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success."
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-1": {
          "instance_ids": [
            "fe45815ce8a6413ab7fa290da1db1614in12",
            "362b42f769ff45d884e1866f8ee00bb4in12"
          ],
          "log_type": "slow_log",
          "lts_group_id": "65442dd4-b8de-4e9f-8a80-b60aa0698354",
          "lts_stream_id": "5992dd29-fd11-4228-a852-5f6e578789c5"
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v3/0549b4a43100d4f32f51c01c2fe4acdb/instances/logs/lts-configs"
      }
    }
  },
  "definitions": {
    "SaveLtsConfigsRequestBody": {
      "required": [
        "instance_ids",
        "log_type",
        "lts_group_id",
        "lts_stream_id"
      ],
      "properties": {
        "instance_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "需要建立关联的实例ID列表。"
        },
        "log_type": {
          "type": "string",
          "enum": [
            "slow_log"
          ],
          "description": "日志类型。slow_log表示慢日志。"
        },
        "lts_group_id": {
          "type": "string",
          "description": "LTS日志组ID。可通过云日志服务-“查询账号下所有日志组”API接口获取。"
        },
        "lts_stream_id": {
          "type": "string",
          "description": "LTS日志流ID。可通过云日志服务-“查询指定日志组下的所有日志流”API接口获取。"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
