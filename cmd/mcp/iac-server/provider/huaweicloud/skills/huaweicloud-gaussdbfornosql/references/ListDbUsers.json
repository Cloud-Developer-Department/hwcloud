{
  "name": "ListDbUsers",
  "summary": "获取Redis数据库账号列表和详情",
  "tags": "管理数据库和用户",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/redis/instances/{instance_id}/db-users": {
      "get": {
        "tags": [
          "管理数据库和用户"
        ],
        "operationId": "ListDbUsers",
        "summary": "获取Redis数据库账号列表和详情",
        "description": "获取Redis数据库账号列表和详情。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-ratelimit": "nosql_default_policy",
        "x-constraint": "- 只支持GeminiDB Redis引擎。\n- 实例在创建、变更规格、修改端口、异常状态或冻结状态下不能执行该操作。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "054e292c9880d4992f02c0196d3ea468"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "054e292c9880d4992f02c0196d3ein12"
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "数据库账号名。若传此参数,则查询指定账号的信息,否则返回所有数据库账号信息。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "索引位置,偏移量。\n\n  - 从第一条数据偏移offset条数据后开始查询,默认为0。\n  - 取值必须为数字,且不能为负数。",
            "type": "integer"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "查询个数上限值。\n\n- 取值范围:1~100。\n- 不传该参数时,默认查询前100条信息。",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/RedisListDbUsersResponse"
            },
            "examples": {
              "application/json": {
                "users": [
                  {
                    "name": "db_user1",
                    "type": "rwuser",
                    "privilege": "ReadWrite",
                    "databases": [
                      "1",
                      "2"
                    ]
                  },
                  {
                    "name": "db_user2",
                    "type": "acluser",
                    "privilege": "ReadWrite",
                    "databases": [
                      "1",
                      "2"
                    ]
                  }
                ],
                "total_count": 2
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v3/375d8d8fad1f43039e23d3b6c0f60a19/redis/instances/9136fd2a9fcd405ea4674276ce36dae8in12/db-users"
      }
    }
  },
  "definitions": {
    "RedisListDbUsersResponse": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RedisDbUserInfo"
          },
          "description": "数据库用户信息列表。"
        },
        "total_count": {
          "type": "integer",
          "description": "总记录数。"
        }
      },
      "required": [
        "users",
        "total_count"
      ]
    },
    "RedisDbUserInfo": {
      "description": "数据库用户信息。",
      "properties": {
        "name": {
          "type": "string",
          "description": "账号名称。\n\n小于36个字符,以字母开头,仅包含数字、字母、中划线、下划线。"
        },
        "type": {
          "type": "string",
          "description": "账号类型。\n\n- rwuser:管理员用户\n- acluser:普通用户"
        },
        "privilege": {
          "type": "string",
          "description": "账号权限。\n\n- 取值\"ReadOnly\":账号为只读权限;\n- 取值\"ReadWrite\":账号为读写权限。"
        },
        "databases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "账号已授权的数据库名称列表。"
        }
      },
      "type": "object",
      "required": [
        "name",
        "type",
        "privilege",
        "databases"
      ]
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-nosql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}