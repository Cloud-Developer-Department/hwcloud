{
  "name": "RestartInstance",
  "summary": "重启实例或节点",
  "tags": "实例管理",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/restart": {
      "post": {
        "tags": [
          "实例管理"
        ],
        "operationId": "RestartInstance",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "summary": "重启实例或节点",
        "description": "重启实例或节点的数据库服务。",
        "x-constraint": "实例重启支持如下数据库实例:\n  - GeminiDB Cassandra\n  - GeminiDB Mongo\n  - GeminiDB Influx\n  - GeminiDB Redis\n节点重启支持如下数据库实例:\n- GeminiDB Redis云原生部署模式集群\n实例状态非“normal”时,不允许重启实例。",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "用户在某一region下的project ID。",
            "type": "string"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "description": "实例ID。",
            "type": "string"
          },
          {
            "name": "RestartInstanceRequestBody",
            "in": "body",
            "required": false,
            "description": "仅GeminiDB Redis云原生部署模式集群实例支持传入节点ID重启对应节点。",
            "schema": {
              "$ref": "#/definitions/RestartInstanceRequestBody"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "examples": {
              "application/json": {
                "job_id": "f85104b5-4a9c-4e0f-9505-fc5409d8f7ae"
              }
            },
            "schema": {
              "$ref": "#/definitions/RestartInstanceResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v3/619d3e78f61b4be68bc5aa0b59edcf7b/instances/944bdc55da6c4b33b260b34185ac86bein13/restart"
      }
    }
  },
  "definitions": {
    "RestartInstanceRequestBody": {
      "properties": {
        "node_id": {
          "type": "string",
          "example": "b802c7f15fc84412ba7c97418fcdddf6no12",
          "description": "待重启的节点ID。\n仅GeminiDB Redis云原生部署模式集群实例支持传入节点ID重启对应节点。\n不传则重启整个实例。"
        }
      },
      "type": "object"
    },
    "RestartInstanceResponseBody": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID。"
        }
      },
      "type": "object"
    }
  },
