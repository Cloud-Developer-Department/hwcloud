  "definitions": {
    "RestoreRequestBody": {
      "required": [
        "backup_id"
      ],
      "description": "恢复到已有实例的请求body",
      "properties": {
        "backup_id": {
          "type": "string",
          "description": "备份文件名称。根据备份文件恢复到已有的实例。"
        },
        "password": {
          "type": "string",
          "description": "实例密码。\n取值范围:长度为8~32位,必须是大写字母(A~Z)、小写字母(a~z)、数字(0~9)、特殊字符~!@#%^*-_=+?的组合。\n  - 不传入密码时,恢复后,备份文件中保留的密码将覆盖原有实例的密码。\n  - 传入密码时,恢复后,将使用该密码覆盖原有实例的密码。"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
