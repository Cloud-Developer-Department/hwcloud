{
  "name": "ShowAutoEnlargePolicy",
  "summary": "查询磁盘自动扩容策略",
  "tags": "实例管理",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/disk-auto-expansion": {
      "get": {
        "tags": [
          "实例管理"
        ],
        "summary": "查询磁盘自动扩容策略",
        "description": "查询磁盘自动扩容策略",
        "operationId": "ShowAutoEnlargePolicy",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-constraint": "该接口支持如下数据库实例。\n  - GeminiDB Cassandra",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "用户token。",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一Region下的Project ID。"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "实例Id,可以调用5.3.3 查询实例列表和详情接口获取。如果未申请实例,可以调用5.3.1 创建实例接口创建。"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/ShowAutoEnlargePolicyResponseBody"
            },
            "examples": {
              "application/json": {
                "policy": {
                  "threshold": 90,
                  "step": 10,
                  "size": 600
                }
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v3/619d3e78f61b4be68bc5aa0b59edcf7b/instances/93e4b3eda14349b1b870f72829bc3b9bin06/disk-auto-expansion"
      }
    }
  },
  "definitions": {
    "ShowAutoEnlargePolicyResponseBody": {
      "type": "object",
      "properties": {
        "policy": {
          "description": "磁盘自动扩容策略。\n\n自动扩容策略关闭时,接口无信息返回。",
          "$ref": "#/definitions/DiskAutoExpansionPolicy"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "DiskAutoExpansionPolicy": {
      "type": "object",
      "properties": {
        "threshold": {
          "type": "integer",
          "format": "int32",
          "description": "触发自动扩容阈值,只支持输入80、85和90。默认阈值为90,即当已使用存储空间达到总存储空间的90%或者可用空间小于10GB时就会触发扩容。"
        },
        "step": {
          "type": "integer",
          "format": "int32",
          "description": "扩容步长(s%),默认为10,支持输入10、15和20。当触发自动扩容的时候,自动扩容当前存储空间的s%(非10倍数向上取整。小数点后四舍五入,默认一次最小100G,账户余额不足时,会导致包年包月实例扩容失败)"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "实例通过自动扩容所能达到的存储空间上限,单位:GB。需要大于等于实例购买的存储空间大小,且最大上限不能超过实例当前规格支持的最大存储容量。批量自动扩容时,不支持自定义存储自动扩容上限,默认扩容至所选实例对应的最大存储空间。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-nosql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}