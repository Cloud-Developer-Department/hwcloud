      "properties": {
        "id": {
          "type": "string",
          "description": "**参数解释:**\n实例ID。\n**取值范围:**\n不涉及。",
          "example": "5a0c7051faa0471a8e23703f1dc0f458in06"
        },
        "name": {
          "type": "string",
          "description": "**参数解释:**\n实例名称。\n**取值范围:**\n不涉及。"
        },
        "status": {
          "type": "string",
          "description": "**参数解释:**\n实例状态。\n**取值范围:**\n- normal,表示实例正常。\n- abnormal,表示实例异常。\n- creating,表示实例创建中。\n- frozen,表示实例被冻结。\n- data_disk_full,表示实例磁盘已满。\n- createfail,表示实例创建失败。\n- enlargefail,表示实例扩容节点个数失败。",
          "example": "creating"
        },
        "port": {
          "type": "string",
          "description": "**参数解释:**\n数据库端口。\n**取值范围:**\n不涉及。",
          "example": "3306"
        },
        "region": {
          "type": "string",
          "description": "**参数解释:**\n实例所在区域。\n**取值范围:**\n不涉及。"
        },
        "datastore": {
          "description": "数据库信息。",
          "$ref": "#/definitions/ListInstancesDatastoreResult"
        },
        "mode": {
          "type": "string",
          "description": "**参数解释:**\n实例类型。\n**取值范围:**\n与请求参数相同。"
        },
        "product_type": {
          "type": "string",
          "description": "**参数解释:**\n产品类型。\n**取值范围:**\nGeminiDB Redis云原生部署模式集群涉及此字段,取值:\n  -  Standard 标准型\n  -  Capacity 容量型"
        },
        "engine": {
          "type": "string",
          "description": "**参数解释:**\n存储引擎。\n**取值范围:**\n取值为“rocksDB”。"
        },
        "created": {
          "type": "string",
          "description": "**参数解释:**\n实例创建时间。\n**取值范围:**\n不涉及。"
        },
        "updated": {
          "type": "string",
          "description": "**参数解释:**\n实例操作最新变更的时间。\n**取值范围:**\n不涉及。"
        },
        "db_user_name": {
          "type": "string",
          "description": "**参数解释:**\n默认用户名。\n**取值范围:**\n取值为“rwuser”。"
        },
        "vpc_id": {
          "type": "string",
          "description": "**参数解释:**\n虚拟私有云ID。\n**取值范围:**\n不涉及。"
        },
        "subnet_id": {
          "type": "string",
