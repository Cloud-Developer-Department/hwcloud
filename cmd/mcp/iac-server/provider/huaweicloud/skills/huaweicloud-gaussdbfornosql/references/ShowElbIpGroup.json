              "ip"
            ],
            "properties": {
              "ip": {
                "description": "IP地址或网段。支持IPv4、IPv6。",
                "type": "string",
                "example": "123.123.123.0/24"
              },
              "description": {
                "description": "备注信息,最长255字符。",
                "type": "string",
                "maxLength": 255,
                "example": "some description"
              }
            }
          }
        },
        "enabled": {
          "description": "true:开启,false:关闭。",
          "type": "boolean",
          "example": true
        }
      }
    }
