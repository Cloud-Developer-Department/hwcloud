{
  "name": "ListConfigurations",
  "summary": "获取参数模板列表",
  "tags": "参数模板管理",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/configurations": {
      "get": {
        "tags": [
          "参数模板管理"
        ],
        "operationId": "ListConfigurations",
        "summary": "获取参数模板列表",
        "description": "获取参数模板列表,包括所有数据库的默认参数模板和用户创建的参数模板。",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-constraint": "该接口支持如下数据库实例:\n- GeminiDB Cassandra\n- GeminiDB Mongo\n- GeminiDB Influx经典部署模式实例\n- GeminiDB Redis经典部署模式实例",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "datastore_name",
            "in": "query",
            "required": false,
            "description": "【参数解释】\n数据库名称。\n【约束限制】\n不限制。\n【取值范围】\ncassandra:表示支持GeminiDB Cassandra实例。\nredis:表示支持GeminiDB Redis实例。\ninfluxdb:表示支持GeminiDB Influx实例。\nmongodb: 表示支持GeminiDB Mongo实例。\n【默认取值】\n不传该参数,则表示查询所有数据库类型。",
            "type": "string"
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "description": "【参数解释】\n数据库实例类型。\n【约束限制】\n不限制。\n【取值范围】\n* 取值为“CloudNativeCluster”, 表示查询支持GeminiDB Cassandra云原生部署模式实例的参数模板。\n* 取值为“Cluster”, 表示查询GeminiDB Cassandra经典部署模式实例、GeminiDB Influx经典部署模式实例、GeminiDB Redis Proxy集群经典部署模式实例支持的参数模板。\n* 取值为“Replication”, 表示查询支持GeminiDB Redis经典部署模式主备类型实例的参数组。\n* 取值为“InfluxdbSingle”, 表示查询支持GeminiDB Influx经典部署模式单节点类型实例的参数组。\n* 取值为“ReplicaSet”, 表示查询支持GeminiDB Mongo副本集类型实例的参数组。\n* 取值为“All”, 表示查询所有部署模式的参数模板。\n【默认取值】\n不传该参数,则表示查询经典部署模式实例支持的参数组。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ListConfigurationsResponseBody"
            },
            "examples": {
              "application/json": {
                "count": 2,
                "quota": 100,
                "configurations": [
                  {
                    "id": "887ea0d1bb0843c49e8d8e5a09a95652pr06",
                    "name": "configuration_test",
                    "description": "configuration_test",
                    "datastore_version_name": "3.11",
                    "datastore_name": "cassandra",
                    "created": "2019-05-15T11:53:34+0000",
                    "updated": "2019-05-15T11:53:34+0000",
                    "mode": "Cluster",
                    "user_defined": true
                  },
                  {
                    "id": "3bc1e9cc0d34404b9225ed7a58fb284epr06",
                    "name": "Default-Cassandra-3.11",
                    "description": "Default parameter group for cassandra 3.11",
                    "datastore_version_name": "3.11",
                    "datastore_name": "cassandra",
                    "created": "2019-05-27T03:38:51+0000",
                    "updated": "2019-05-27T03:38:51+0000",
                    "mode": "Cluster",
                    "user_defined": false
                  }
                ]
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/configurations"
      }
    }
  },
  "definitions": {
    "ListConfigurationsResult": {
      "description": "参数模板信息。",
      "required": [
        "id",
        "name",
        "datastore_version_name",
        "datastore_name",
        "created",
        "updated",
        "mode",
        "user_defined"
      ],
      "properties": {
        "id": {
          "description": "参数模板ID。",
          "type": "string"
        },
        "name": {
          "description": "参数模板名称。",
          "type": "string"
        },
        "description": {
          "description": "参数模板描述。",
          "type": "string"
        },
        "datastore_version_name": {
          "description": "数据库版本名称。",
          "type": "string"
        },
        "datastore_name": {
          "description": "数据库名称。\n【取值范围】\ncassandra:表示支持GeminiDB Cassandra实例。\nredis:表示支持GeminiDB Redis实例。\ninfluxdb:表示支持GeminiDB Influx实例。\nmongodb: 表示支持GeminiDB Mongo实例。",
          "type": "string"
        },
        "created": {
          "description": "创建时间,格式为\"yyyy-MM-ddTHH:mm:ssZ\"。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800",
          "type": "string"
        },
        "updated": {
          "description": "更新时间,格式为\"yyyy-MM-ddTHH:mm:ssZ\"。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。",
          "type": "string"
        },
        "mode": {
          "type": "string",
          "description": "数据库实例类型。\nGeminiDB Cassandra经典部署模式集群类型为\"Cluster\"。\nGeminiDB Cassandra云原生部署模式集群类型为\"CloudNativeCluster\"。\nGeminiDB Mongo副本集类型为\"ReplicaSet\"。\nGeminiDB Mongo集群类型为\"Sharding\"。\nGeminiDB Influx经典部署模式集群类型为\"Cluster\"。\nGeminiDB Influx经典部署模式单节点类型为\"InfluxdbSingle\"。\nGeminiDB Redis经典部署模式集群类型为“Cluster”。"
        },
        "user_defined": {
          "description": "是否是用户自定义参数模板:\n- false,表示为系统默认参数模板。\n- true,表示为用户自定义参数模板。",
          "type": "boolean"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "ListConfigurationsResponseBody": {
      "required": [
        "configurations",
        "count",
        "quota"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "description": "总记录数。"
        },
        "quota": {
          "type": "integer",
          "description": "用户可创建的自定义参数模板最大数量。"
        },
        "configurations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ListConfigurationsResult"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-nosql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}