        },
        "values": {
          "description": "标签值列表。最大长度43个unicode字符,不能为空格,校验和使用之前先排除前后半角空格。如果values为空列表,则表示查询任意value。value之间为或的关系。",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ListInstancesByTagsRequestBody": {
      "required": [
        "action"
      ],
      "properties": {
        "offset": {
          "type": "string",
          "description": "索引位置偏移量,表示从第一条数据偏移offset条数据后开始查询。\n- “action”值为“count”时,不传该参数。\n- “action”值为“filter”时,取值必须为数字,不能为负数。默认取0值,表示从第一条数据开始查询。'"
        },
        "limit": {
          "type": "string",
          "description": "查询记录数。\n  - “action”值为“count”时,不传该参数。\n  - “action”值为“filter”时,取值范围:1~100。不传该参数时,默认查询前100条实例信息。"
        },
        "action": {
          "type": "string",
          "description": "操作标识。\n  - 取值为“filter”,表示根据标签过滤条件查询实例。\n  - 取值为“count”,表示仅返回总记录数,禁止返回其他字段。",
          "enum": [
            "filter",
            "count"
          ]
        },
        "matches": {
          "type": "array",
          "description": "搜索字段。\n  - 该字段值为空,表示不按照实例名称或实例ID查询。\n  - 该字段值不为空",
          "items": {
            "$ref": "#/definitions/MatchOption"
          }
        },
        "tags": {
          "type": "array",
          "description": "包含标签,最多包含20个key。",
          "items": {
            "$ref": "#/definitions/TagOption"
          }
        }
      }
    },
    "MatchOption": {
      "required": [
        "key",
        "value"
      ],
      "properties": {
