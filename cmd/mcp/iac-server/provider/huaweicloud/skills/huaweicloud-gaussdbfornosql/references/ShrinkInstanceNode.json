{
  "name": "ShrinkInstanceNode",
  "summary": "缩容指定集群实例的节点数量",
  "tags": "实例管理",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/reduce-node": {
      "post": {
        "tags": [
          "实例管理"
        ],
        "operationId": "ShrinkInstanceNode",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "summary": "缩容指定集群实例的节点数量",
        "description": "缩容指定集群实例的节点数量。",
        "x-constraint": "- 该接口支持如下数据库实例。\n  - GeminiDB Cassandra包年/包月实例和按需计费实例\n  - GeminiDB Redis按需计费实例\n- GeminiDB Redis实例支持的最大最小磁盘容量和节点数、规格相关,如果目标结果无法满足实例运行所需的磁盘大小,将无法缩容节点。\nGeminiDB Redis主备版实例不支持节点扩容。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein06"
          },
          {
            "name": "EnlargeInstanceRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ShrinkInstanceNodeRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ShrinkInstanceNodeResponseBody"
            },
            "examples": {
              "application/json": {
                "job_id": "04efe8e2-9255-44ae-a98b-d87cae411890"
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "缩容cassandra节点数量:",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/054e292c9880d4992f02c0196d3ein06/reduce-node",
        "x-request-examples-1": {
          "num": 1
        }
      }
    }
  },
  "definitions": {
    "ShrinkInstanceNodeResponseBody": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID。",
          "example": "6ad4eb1f-73bd-4876-aa31-aa9a1e41c4bc"
        },
        "order_id": {
          "type": "string",
          "description": "订单ID,仅创建包年包月实例时返回该参数。",
          "example": "CS20070721568OVO9"
        }
      }
    },
    "ShrinkInstanceNodeRequestBody": {
      "properties": {
        "num": {
          "type": "integer",
          "description": "随机缩减的节点数量。\n- GeminiDB Cassandra实例该字段取值为1~10。\n- GeminiDB Redis该字段取值为1。\n说明:\n如果客户端采用直连节点方式,不推荐使用随机节点缩容。"
        },
        "node_list": {
          "description": "指定缩容节点的ID,且该节点必须支持节点缩容。如果该字段不传指定缩减的节点ID,将根据系统内部策略缩减指定个数的节点。说明:\n- num与node_list必须有一个字段传值。\n  - 如果node_list传值时,GeminiDB Cassandra长度必须为1~10,GeminiDB Redis 长度必须为1。\n  - 如果num与node_list同时传值时,则以node_list的值为主。\n- 如果node_list取值为空时,缩容以随机节点缩容进行;node_list字段取值不为空,缩容以指定节点ID进行。\n- 节点缩容前,请避免直连节点,以防该节点缩容导致业务中断。",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
