{
  "name": "CompareConfiguration",
  "summary": "参数模板比较",
  "tags": "参数模板管理",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/configurations/comparison": {
      "post": {
        "tags": [
          "参数模板管理"
        ],
        "summary": "参数模板比较",
        "description": "比较两个参数模板之间的差异",
        "operationId": "CompareConfiguration",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "x-constraint": "该接口支持如下数据库实例。\n- GeminiDB Cassandra\n- GeminiDB Mongo\n- GeminiDB Influx\n- GeminiDB Redis\n\n只能比较相同节点类型、数据库版本、部署模式的参数模板,以了解该参数模板当前的配置情况。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "用户token。"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一region下的project ID。"
          },
          {
            "name": "ShowParamGroupDifferenceRequest",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CompareConfigurationRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/CompareConfigurationResponseBody"
            },
            "examples": {
              "application/json": {
                "differences": [
                  {
                    "parameter_name": "batch_size_fail_threshold_in_kb",
                    "source_value": "1000",
                    "target_value": "5000"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Client error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v3/375d8d8fad1f43039e23d3b6c0f60a19/configurations/comparison",
        "x-request-examples-text-1": {
          "source_configuration_id": "0764fdcd949b411ba76c2b762b80c212pr06",
          "target_configuration_id": "fa42c57bb62844e490052f2ff9d5a264pr06"
        },
        "x-request-examples-1": {
          "source_configuration_id": "0764fdcd949b411ba76c2b762b80c212pr06",
          "target_configuration_id": "fa42c57bb62844e490052f2ff9d5a264pr06"
        }
      }
    }
  },
  "definitions": {
    "CompareConfigurationRequestBody": {
      "type": "object",
      "required": [
        "source_configuration_id",
        "target_configuration_id"
      ],
      "properties": {
        "source_configuration_id": {
          "type": "string",
          "description": "需要进行比较的源参数模板ID。"
        },
        "target_configuration_id": {
          "type": "string",
          "description": "需要进行比较的目标参数模板ID。"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "CompareConfigurationResponseBody": {
      "type": "object",
      "required": [
        "differences"
      ],
      "properties": {
        "differences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DifferentDetails"
          },
          "description": "参数之间的区别集合。"
        }
      }
    },
    "DifferentDetails": {
      "type": "object",
      "required": [
        "parameter_name",
        "source_value",
        "target_value"
      ],
      "properties": {
        "parameter_name": {
          "type": "string",
          "description": "参数名称"
        },
        "source_value": {
          "type": "string",
          "description": "源参数模板中的参数值。"
        },
        "target_value": {
          "type": "string",
          "description": "目标参数模板中的参数值。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-nosql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}