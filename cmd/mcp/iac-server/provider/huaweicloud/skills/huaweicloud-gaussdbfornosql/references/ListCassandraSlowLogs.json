{
  "name": "ListCassandraSlowLogs",
  "summary": "查询GeminiDB(for Cassandra)数据库慢日志",
  "tags": "日志管理",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/cassandra/instances/{instance_id}/slow-logs": {
      "post": {
        "tags": [
          "日志管理"
        ],
        "operationId": "ListCassandraSlowLogs",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "summary": "查询GeminiDB(for Cassandra)数据库慢日志",
        "description": "查询GeminiDB(for Cassandra)数据库慢日志信息,支持日志关键字搜索。",
        "x-constraint": "- 不支持使用 &&、||、AND、OR、NOT、*、?、:、>、<、=、>=、<= 这些关键字来搜索日志。\n- 每页查询最大限制100条,慢日志最多保存30天。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID,可以调用“查询实例列表和详情”接口获取。如果未申请实例,可以调用“创建实例”接口创建。",
            "required": true,
            "type": "string",
            "x-example": "853f97101a9a4f618202f281cda82e92in06"
          },
          {
            "name": "ListCassandraSlowLogsRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListCassandraSlowLogsRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ListCassandraSlowLogsResponseBody"
            },
            "examples": {
              "application/json": {
                "slow_logs": [
                  {
                    "node_name": "test_priam_node_1",
                    "node_id": "8b76c35e91eb4c9d82fe25417d750cb5no06",
                    "keyspace": "system",
                    "table": "test",
                    "whole_message": "GqKc6_S",
                    "operate_type": "select",
                    "cost_time": 60,
                    "log_time": "2023-01-09T05:42:32.000+0000",
                    "line_num": "1595659490239433659"
                  }
                ]
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/619d3e78f61b4be68bc5aa0b59edcf7b/cassandra/instances/853f97101a9a4f618202f281cda82e92in06/slow-logs",
        "x-request-examples-1": {
          "start_time": "2023-01-06T10:41:14+0800",
          "end_time": "2023-01-10T10:41:14+0800",
          "limit": 100,
          "line_num": "1595659490239433658",
          "operate_type": "select",
          "node_id": "8b76c35e91eb4c9d82fe25417d750cb5no06",
          "keywords": [
            "log",
            "test"
          ],
          "keyspace_keywords": [
            "system",
            "system_auth"
          ],
          "table_keywords": [
            "test"
          ],
          "max_cost_time": 100,
          "min_cost_time": 50
        }
      }
    }
  },
  "definitions": {
    "ListCassandraSlowLogsRequestBody": {
      "required": [
        "start_time",
        "end_time",
        "limit"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "description": "开始时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。注:开始时间不得早于当前时间30天。"
        },
        "end_time": {
          "type": "string",
          "description": "结束时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。注:结束时间不能晚于当前时间。"
        },
        "limit": {
          "type": "integer",
          "description": "表示每次查询的日志条数,最大限制100条。"
        },
        "line_num": {
          "type": "string",
          "description": "日志单行序列号,第一次查询时不需要此参数,下一次查询时需要使用,可从上一次查询的返回信息中获取。\n说明:当次查询从line_num的下一条日志开始查询,不包含当前line_num日志。"
        },
        "operate_type": {
          "type": "string",
          "description": "语句类型,取空值,表示查询所有语句类型。\n取值:select"
        },
        "node_id": {
          "type": "string",
          "description": "节点ID,取空值,表示查询实例下所有允许查询的节点。\n具体取值请参考查询实例列表和详情接口\"ListInstances\"中nodes字段数据结构说明的“id”。"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "根据多个关键字搜索日志全文,表示同时匹配所有关键字。\n- 最多支持10个关键字。\n- 每个关键字最大长度不超过512个字符。"
        },
        "keyspace_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "根据多个键空间关键字模糊搜索日志,表示匹配至少一个关键字。\n- 只支持关键字前缀模糊搜索,最多支持10个关键字。\n- 每个关键字最大长度不超过48个字符。"
        },
        "table_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "根据多个数据库表名关键字模糊搜索日志,表示匹配至少一个关键字。\n- 只支持关键字前缀模糊搜索,最多支持10个关键字。\n- 每个关键字最大长度不超过48个字符。"
        },
        "max_cost_time": {
          "type": "integer",
          "description": "支持根据最大执行时间范围查找日志。单位:ms"
        },
        "min_cost_time": {
          "type": "integer",
          "description": "支持根据最小执行时间范围查找日志。单位:ms"
        }
      }
    },
    "CassandraSlowLogDetail": {
      "required": [
        "node_name",
        "node_id",
        "whole_message",
        "operate_type",
        "cost_time",
        "keyspace",
        "table",
        "log_time",
        "line_num"
      ],
      "properties": {
        "node_name": {
          "type": "string",
          "description": "节点名称。",
          "example": "test_priam_node_1"
        },
        "node_id": {
          "type": "string",
          "description": "节点ID。",
          "example": "8b76c35e91eb4c9d82fe25417d750cb5no06"
        },
        "whole_message": {
          "type": "string",
          "description": "执行语句。",
          "example": "testDb"
        },
        "operate_type": {
          "type": "string",
          "description": "语句类型。",
          "example": "select"
        },
        "cost_time": {
          "type": "integer",
          "description": "执行时间。单位:ms",
          "example": 60.12
        },
        "keyspace": {
          "type": "string",
          "description": "数据库键空间",
          "example": "system"
        },
        "table": {
          "type": "string",
          "description": "数据库表名",
          "example": "test"
        },
        "log_time": {
          "type": "string",
          "description": "日志产生时间,UTC时间。\n格式为“yyyy-mm-ddThh:mm:ssZ”。 其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。",
          "example": "2020-11-15T22:49:38.643000Z"
        },
        "line_num": {
          "type": "string",
          "description": "日志单行序列号",
          "example": "1595659490239433658"
        }
      },
      "type": "object"
    },
    "ListCassandraSlowLogsResponseBody": {
      "required": [
        "slow_logs"
      ],
      "properties": {
        "slow_logs": {
          "description": "慢日志具体信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CassandraSlowLogDetail"
          }
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-nosql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}