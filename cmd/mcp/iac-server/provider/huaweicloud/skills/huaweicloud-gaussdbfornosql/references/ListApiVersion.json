{
  "name": "ListApiVersion",
  "summary": "查询当前支持的API版本信息列表",
  "tags": "查询API版本",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/": {
      "get": {
        "tags": [
          "查询API版本"
        ],
        "operationId": "ListApiVersion",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "summary": "查询当前支持的API版本信息列表",
        "description": "查询当前支持的API版本信息列表。",
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ListApiVersionResponseBody"
            },
            "examples": {
              "application/json": {
                "versions": [
                  {
                    "id": "v3",
                    "links": [],
                    "status": "CURRENT",
                    "version": "",
                    "min_version": "",
                    "updated": "2017-02-07T17:34:02Z"
                  }
                ]
              }
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/"
      }
    }
  },
  "definitions": {
    "ApiVersionResponse": {
      "description": "API版本详细信息列表。",
      "required": [
        "id",
        "links",
        "status",
        "version",
        "min_version",
        "updated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "API版本号。",
          "example": "v3"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Links"
          },
          "description": "对应API的链接信息,v3版本该字段为[]。"
        },
        "status": {
          "type": "string",
          "description": "版本状态。\n取值为“CURRENT”,表示该版本目前已对外公布。",
          "example": "CURRENT"
        },
        "version": {
          "type": "string",
          "description": "API版本的子版本信息。"
        },
        "min_version": {
          "type": "string",
          "description": "API版本的最小版本号。"
        },
        "updated": {
          "type": "string",
          "description": "版本更新时间。格式为“yyyy-mm-dd Thh:mm:ssZ”。其中,T指某个时间的开始,Z指UTC时间。",
          "example": "2019-01-15T12:00:00Z"
        }
      }
    },
    "Links": {
      "description": "对应API的链接信息,v3版本该字段为[]。",
      "properties": {
        "href": {
          "type": "string",
          "description": "对应该API的URL,该字段为\"\"。"
        },
        "rel": {
          "type": "string",
          "description": "值为“self”,表示URL为本地链接。"
        }
      }
    },
    "ListApiVersionResponseBody": {
      "properties": {
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ApiVersionResponse"
          },
          "description": "API版本详细信息列表。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-nosql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}