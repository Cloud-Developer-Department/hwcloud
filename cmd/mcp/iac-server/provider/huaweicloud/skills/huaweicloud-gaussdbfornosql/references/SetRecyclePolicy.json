{
  "name": "SetRecyclePolicy",
  "summary": "设置回收策略",
  "tags": "备份与恢复",
  "productshort": "GaussDBforNoSQL",
  "region_id": "af-south-1",
  "paths": {
    "/v3/{project_id}/instances/recycle-policy": {
      "put": {
        "tags": [
          "备份与恢复"
        ],
        "operationId": "SetRecyclePolicy",
        "x-support-sdk": "Y",
        "x-is-registered": "N",
        "summary": "设置回收策略",
        "description": "设置已删除实例保留天数,修改保留天数后删除的实例按照新的天数保留,修改之前已在回收站的实例保留天数不变。",
        "x-constraint": "可设置范围为1~7天。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "054991d39500d3c52f90c01c9004ae61"
          },
          {
            "name": "SetRecyclePolicyRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RecyclePolicyRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success."
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "recycle_policy": {
            "retention_period_in_days": 3
          }
        },
        "x-request-examples-url-1": "PUT https://{endpoint}/v3/054991d39500d3c52f90c01c9004ae61/instances/recycle-policy"
      }
    }
  },
  "definitions": {
    "RecyclePolicy": {
      "description": "回收策略。",
      "properties": {
        "retention_period_in_days": {
          "type": "integer",
          "description": "策略保持时长(1-7天),天数为正整数,默认7天。",
          "example": 7
        }
      }
    },
    "RecyclePolicyRequestBody": {
      "required": [
        "recycle_policy"
      ],
      "properties": {
        "recycle_policy": {
          "$ref": "#/definitions/RecyclePolicy"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb-nosql.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
