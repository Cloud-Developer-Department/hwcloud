        "description": "设置实例负载均衡的IP访问黑白名单,黑名单、白名单只能选一种,每次调用此接口覆盖之前的设置。关闭后不限制连接的源IP地址。",
        "operationId": "SwitchIpGroup",
        "x-api-type": "open-api",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一region下的project ID。"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "实例ID。"
          },
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "description": "用户Token。",
            "type": "string"
          },
          {
            "name": "SwitchIpGroupRequestBody",
            "in": "body",
            "required": true,
            "description": "设置实例负载均衡的IP访问黑白名单请求体",
            "schema": {
              "$ref": "#/definitions/SwitchIpGroupRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success."
          }
        },
        "x-order": 0
      }
    }
  },
  "definitions": {
    "SwitchIpGroupRequestBody": {
      "required": [
        "enabled",
        "type",
        "ip_groups"
      ],
      "description": "设置实例均衡负载IP的访问黑白名单请求体。",
      "properties": {
        "type": {
          "description": "类型选项,取值: - whiteList:白名单,只允许指定ip或网段访问。 - blackList:黑名单,不允许指定ip或网段访问。",
          "type": "string",
          "enum": [
            "whiteList",
            "blackList"
          ],
          "example": "blackList"
        },
        "enabled": {
          "description": "true 开启,false 关闭。",
          "type": "boolean",
          "example": true
        },
        "ip_groups": {
          "description": "IP地址组中包含的IP或网段列表。",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ip"
            ],
            "properties": {
              "ip": {
                "description": "IP地址或网段。支持IPv4、IPv6。",
                "type": "string",
                "example": "123.123.123.0/24"
              },
              "description": {
                "description": "备注信息,最长255字符。",
                "type": "string",
                "maxLength": 255,
                "example": "some description"
              }
            }
          }
        }
      }
    }
  },
