  "definitions": {
    "SetAutoPolicyRequestBody": {
      "required": [
        "instance_ids"
      ],
      "properties": {
        "instance_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "设置磁盘自动扩容的实例组ID。"
        },
        "switch_option": {
          "type": "string",
          "description": "自动扩容开关。\n\t“on”,表示开启磁盘自动扩容策略。\n\t“off”,表示关闭磁盘自动扩容策略。\n默认值为“on”。"
        },
        "policy": {
          "type": "object",
          "description": "磁盘自动扩容策略",
          "$ref": "#/definitions/DiskAutoExpansionPolicy"
        }
      },
      "type": "object"
    },
    "SetAutoPolicyErrorResults": {
      "properties": {
        "instance_id": {
          "type": "string",
          "description": "**参数解释:**\n实例ID。\n**取值范围:**\n不涉及"
        },
        "error_message": {
          "type": "string",
          "description": "**参数解释:**\n错误信息。\n**取值范围:**\n不涉及"
        }
      }
    },
    "SetAutoPolicyResponseBody": {
      "properties": {
        "error_results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SetAutoPolicyErrorResults"
          },
          "description": "**参数解释:**\n设置磁盘自动扩容策略失败的实例信息列表。\n**取值范围:**\n不涉及"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "DiskAutoExpansionPolicy": {
      "type": "object",
      "properties": {
        "threshold": {
          "type": "integer",
          "format": "int32",
          "description": "触发自动扩容阈值,只支持输入80、85和90。默认阈值为90,即当已使用存储空间达到总存储空间的90%或者可用空间小于10GB时就会触发扩容。"
        },
        "step": {
          "type": "integer",
          "format": "int32",
          "description": "扩容步长(s%),默认为10,支持输入10、15和20。当触发自动扩容的时候,自动扩容当前存储空间的s%(非10倍数向上取整。小数点后四舍五入,默认一次最小100G,账户余额不足时,会导致包年包月实例扩容失败)"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "实例通过自动扩容所能达到的存储空间上限,单位:GB。需要大于等于实例购买的存储空间大小,且最大上限不能超过实例当前规格支持的最大存储容量。批量自动扩容时,不支持自定义存储自动扩容上限,默认扩容至所选实例对应的最大存储空间。"
        }
      }
    }
  },
