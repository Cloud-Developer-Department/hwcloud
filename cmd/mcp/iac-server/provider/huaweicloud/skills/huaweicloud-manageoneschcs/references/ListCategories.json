      "get": {
        "summary": "批量查询产品目录信息",
        "description": "批量查询已经注册的产品目录信息\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -X GET \"https://{endpoint}/silvan/rest/v1.0/categories\"\n```",
        "tags": [
          "Console Home"
        ],
        "x-resource": "产品分类",
        "operationId": "ListCategories",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-auth-mode": "None",
        "x-opseverity": "Minor",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "有效的token"
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "产品目录列表",
            "schema": {
              "$ref": "#/definitions/CategoriesList"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "categories": [
                  {
                    "seqId": 4671751145141,
                    "id": 3,
                    "name": "Network",
                    "order": 1,
                    "css": "Network",
                    "locale": "en-us"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "404": {
            "description": "rest接口没找到"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/silvan/rest/v1.0/categories",
