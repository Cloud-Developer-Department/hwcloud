{
  "name": "ModifyEndpointRegion",
  "summary": "修改region和endpoint关联",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/endpoints/{endpoint_id}/regions/{region_id}": {
      "put": {
        "summary": "修改region和endpoint关联",
        "description": "修改服务endpoint与region关联信息\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -H \"X-Auth-Token: xxxxxxx\" -d \"{\"address\": \"127.0.0.1\",\"port\": 9595}\" -X PUT \"https://{endpoint}/silvan/rest/v1.0/endpoints/ecs/regions/cn-global-1\"\n```",
        "tags": [
          "Console Home"
        ],
        "x-resource": "Endpoint和Region关联",
        "operationId": "ModifyEndpointRegion",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-opseverity": "Minor",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "有效的token(op_service权限的用户token)"
          },
          {
            "name": "endpoint_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "服务自己定义的id:比如nova、cinder等,由大小写英文字符、数字、“-”组成,长度范围1~255"
          },
          {
            "name": "region_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "区域Id:如cn-west-xian等,由大小写英文字符、数字、“-”组成,长度范围0~50"
          },
          {
            "name": "endpoint",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EndpointRegionRequest"
            },
            "description": "Endpoint服务地址与端口"
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "endpointregion关联修改成功",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": {
                "operate": "success"
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "404": {
            "description": "rest接口没找到"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "PUT https://{endpoint}/silvan/rest/v1.0/endpoints/ecs/regions/cn-global-1",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "address": "xx.xx.xx.xx",
          "port": 5000,
          "authConfig": "PKIToken"
        }
      }
    }
  },
  "definitions": {
    "EndpointRegionRequest": {
      "description": "服务Endpoint和区域Region关联对象",
      "required": [
        "address",
        "port"
      ],
      "properties": {
        "address": {
          "type": "string",
          "description": "服务Endpoint地址,由大小写英文字符、数字、“-”、“.”组成,长度范围1~255",
          "minLength": 1,
          "maxLength": 255
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "description": "服务Endpoint端口"
        },
        "authConfig": {
          "type": "string",
          "enum": [
            "PKIToken",
            "STSTokenSign",
            "PKITokenSMS",
            "PKITokenSMSCompatible"
          ],
          "description": "支持的token类型标识,PKIToken:国际PKIToken、STSTokenSign:STSToken、PKITokenSMS:国密PKIToken、PKITokenSMSCompatible:国密/国际PKIToken"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}