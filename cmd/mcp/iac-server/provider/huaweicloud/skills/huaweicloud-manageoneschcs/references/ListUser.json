{
  "name": "ListUser",
  "summary": "查询用户列表(已废弃)",
  "tags": "VDC",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/vdc/v3.0/users": {
      "get": {
        "summary": "查询用户列表(已废弃)",
        "x-resource": "用户管理",
        "description": "查询用户列表,运营管理员可以查询所有用户列表;VDC管理只能查询指定VDC树下的所有用户列表;代维管理员只能查询指定VDC树下的所有用户列表。\n由于该接口支持根据email精确搜索用户,存在安全风险。\n8.5.0版本后,该接口默认会返回北向账号(user_type=4)。\n\ncurl命令调用示例:\n```\ncurl -v -H \"Content-Type:application/json\" -H \"x-auth-token: ******\" -X GET  \"https://{endpoint}/rest/vdc/v3.0/users\"\n```\n\n|SLA项|定义|\n|-----|-----|\n|请求成功率| >=99.9%|\n|可用性|Tier1|\n|数据一致性|最终一致,不一致时长<1分钟|\n|吞吐量|120次/分钟|\n|吞吐量|20次/秒|\n|TP50请求时延|1500ms|\n|TP99.9请求时延|3000ms|",
        "x-precautions": "错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > VDC特性”章节。",
        "tags": [
          "VDC"
        ],
        "operationId": "ListUser",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "接口支持的用户token。运营管理员,机机账号权限,VDC管理员权限,vdc业务员权限,vdc只读权限用户的token。"
          },
          {
            "name": "query_string",
            "in": "query",
            "description": "按照角色名称或者用户名称或者租户名称查询。",
            "type": "string"
          },
          {
            "name": "except_user_names",
            "in": "query",
            "description": "过滤不查询的用户名。",
            "type": "string"
          },
          {
            "name": "roles",
            "in": "query",
            "description": "角色ID列表,默认查询所有可见范围内的角色。",
            "type": "string"
          },
          {
            "name": "level",
            "in": "query",
            "description": "VDC级别列表,默认查询所有可见范围内的VDC级别,与VDC角色配合使用。",
            "type": "string"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "description": "用户归属的租户ID,VDC下用户为VDC ID,资源租户下用户为资源租户ID,运营管理员为运营管理员租户ID。长度:1到36个字符。",
            "type": "string"
          },
          {
            "name": "exact",
            "in": "query",
            "description": "精确匹配,枚举值:true和false,默认值:false。",
            "type": "boolean",
            "default": false
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序字段。枚举值:name,create_at,vdc_name。默认值为name。",
            "type": "string",
            "default": "name"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序方向。枚举值:desc 和asc,默认值:asc。",
            "type": "string",
            "default": "asc"
          },
          {
            "name": "name",
            "in": "query",
            "description": "按照名称或显示名字段模糊搜索。长度:1到128个字符。",
            "type": "string"
          },
          {
            "name": "enabled",
            "in": "query",
            "description": "使用enabled字段精确搜索,枚举值:true 和 false。",
            "type": "string"
          },
          {
            "name": "email",
            "in": "query",
            "description": "使用邮箱字段精确搜索,长度:1到64个字符。",
            "type": "string"
          },
          {
            "name": "start",
            "in": "query",
            "description": "分页查询的起始位置,最小值:0 ,最大值:2147483647 ,默认值:0。",
            "type": "string",
            "default": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制每页显示的条目数量,最小值:1,最大值:100 ,默认值:10。",
            "type": "string",
            "default": 10
          },
          {
            "name": "user_type",
            "in": "query",
            "description": "用户类型。枚举值:'0','1','2','4','5','6',默认值为'0'。为'0'表示本地认证,为'1'表示SAML认证,为'2'表示LDAP认证,为'4'表示机机用户,为'5'表示CAS认证,为'6'表示OAuth认证。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询用户列表成功。",
            "schema": {
              "$ref": "#/definitions/UserListDetails"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "users": [
                  {
                    "enabled": "true",
                    "description": "",
                    "email": "",
                    "areacode": "",
                    "phone": "",
                    "roles": [
                      {
                        "id": "00000000-0000-0000-0000-000000000000",
                        "name": "serviceOperationManager",
                        "display_name": "Operation Admin",
                        "user_role_type": "0"
                      }
                    ],
                    "name": "dadad",
                    "id": "06b38f8a54f7454d92c7768c627019ab",
                    "domain_id": "0f1e8fb3c52e46cc8cb3c5b38a58ffa8",
                    "domain_name": "mo_bss_admin",
                    "resource_tenant_id": null,
                    "vdc_id": null,
                    "vdc_name": "xxxxx",
                    "level": null,
                    "display_name": "VDC管理员",
                    "user_type": "0",
                    "create_at": "2019-06-05 13:18:08.0",
                    "login_at": "2019-06-05 13:18:08.0",
                    "tags": [
                      {
                        "key": "key001",
                        "value": "value001"
                      }
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "接口认证失败。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET: https://{endpoint}",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "UserListDetails": {
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "结果总数。"
        },
        "users": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/UserListDetailBean"
          },
          "description": "用户信息。"
        }
      }
    },
    "UserListDetailBean": {
      "allOf": [
        {
          "$ref": "#/definitions/UserBase"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "用户id。"
            },
            "name": {
              "type": "string",
              "description": "用户名,长度在5-32之间,首位为字母或下划线_,不能为纯数字,且不能包含除下划线_以外的特殊字符。"
            },
            "display_name": {
              "type": "string",
              "description": "用户别名,由除\">\"和\"<\"之外的字符组成,0-128个字符。"
            },
            "create_at": {
              "type": "string",
              "description": "创建时间."
            },
            "roles": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/definitions/UserRoleRaw"
              },
              "description": "用户拥有的角色列表。"
            },
            "domain_id": {
              "type": "string",
              "description": "租户ID。"
            },
            "domain_name": {
              "type": "string",
              "description": "租户名称。"
            },
            "vdc_id": {
              "type": "string",
              "description": "VDC Id。长度:0到36字符."
            },
            "vdc_name": {
              "type": "string",
              "description": "VDC名称,长度为1-64位,只能由中文、英文字母(不区分大小写)、数字、下划线组成,且不能以数字、\"op_\"、\"shadow_\"开头。"
            },
            "resource_tenant_id": {
              "type": "string",
              "description": "资源管理租户id。"
            },
            "user_type": {
              "type": "string",
              "description": "用户类型。"
            },
            "login_at": {
              "type": "string",
              "description": "上次登录时间。"
            },
            "level": {
              "type": "string",
              "description": "VDC级别,取值在1-5之间。"
            },
            "tags": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TagModal"
              },
              "description": "绑定的标签信息"
            }
          }
        }
      ]
    },
    "UserBase": {
      "properties": {
        "enabled": {
          "type": "string",
          "description": "用户状态,true或false,默认为true。为false时,表示用户处于停用状态,无法登录"
        },
        "description": {
          "type": "string",
          "description": "说明,长度小于等于255。"
        },
        "email": {
          "type": "string",
          "description": "邮箱,符合邮箱格式,长度小于等于64位。"
        },
        "areacode": {
          "type": "string",
          "description": "国际区号。"
        },
        "phone": {
          "type": "string",
          "description": "手机号。"
        }
      }
    },
    "UserRoleRaw": {
      "properties": {
        "id": {
          "type": "string",
          "description": "角色id。"
        },
        "name": {
          "type": "string",
          "description": "角色名称。"
        },
        "display_name": {
          "type": "string",
          "description": "展示名称。"
        },
        "user_role_type": {
          "type": "string",
          "description": "用户角色类型。"
        }
      }
    },
    "TagModal": {
      "properties": {
        "key": {
          "type": "string",
          "description": "标签key。"
        },
        "value": {
          "type": "string",
          "description": "标签value。"
        }
      }
    }
  },
