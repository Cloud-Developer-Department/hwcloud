          "description": "发送峰值带宽(Mbps),可选,范围:txLimit– 网卡最大速率(10 * 1000),0表示未设置。 1)只有选择了txLimit,才能选择txPeakLimit字段。 2)txPeakLimit的默认值是txLimit。",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true
        },
        "tx_burst_size": {
          "description": "发送突发大小(Mbits),可选,范围:1-10000Mbits,0表示未设置。 1)只有选择了txLimit,才能选择txBurstSize字段。 2)txBurstSize默认值大小等于txPeakLimit。 (如峰值带宽100Mbps,突发大小缺省为100Mbits)。",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true
        },
        "tx_weight": {
          "description": "Qos的份额值,可选,取值范围1-100,默认值为0。",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true
        },
        "tx_reserve": {
          "description": "发送方向的带宽预留,可选,取值范围:[1Mbit,10000Mbit] 。",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true
        },
        "priority": {
          "description": "发送优先级(2~7),可选,优先级越小表示调度越快,0表示未设置。 1)priority默认值为7。 2)只有选择txLimit时,priority默认值才生效。",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true
        },
        "rx_limit": {
          "description": "接收平均带宽(Mbps) ,可选 范围:1 – 网卡最大速率(10 * 1000),0表示未设置。",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true
