            "modify",
            "delete",
            "delay",
            "softdelete",
            "restore",
            "clone",
            "snapshot",
            "all",
            "stop",
            "start",
            "restart"
          ]
        },
        "region_id": {
          "description": "所属的Region ID。",
          "type": "string",
          "maxLength": 36,
          "minLength": 1
