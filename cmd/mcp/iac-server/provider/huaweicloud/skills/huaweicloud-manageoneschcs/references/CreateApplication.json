  "definitions": {
    "CreateApplicationReq": {
      "description": "创建应用请求体。",
      "required": [
        "name",
        "project_id"
      ],
      "properties": {
        "name": {
          "description": "应用名称(长度1-64)。",
          "type": "string"
        },
        "version": {
          "description": "应用版本(长度0-64)。",
          "type": "string"
        },
        "type_id": {
          "description": "应用类型ID(长度32)。",
          "type": "string"
        },
        "project_id": {
          "description": "应用资源空间ID。多个时支持用逗号隔开,默认最大50个。",
          "type": "string"
        },
        "description": {
          "description": "应用描述(长度0-256)。",
          "type": "string"
        },
        "owner_name": {
          "description": "应用责任人(长度1-64)。",
          "type": "string"
        },
        "owner_phone": {
          "description": "应用责任人电话(长度0-32)。",
          "type": "string"
        },
        "owner_email": {
          "description": "应用责任人邮箱(长度0-64,需满足邮箱格式)。",
          "type": "string"
        },
        "owner_description": {
          "description": "应用责任人描述,数组长度最大1000(数组元素长度0-256)。应用责任人,应用责任人电话,应用责任人邮箱,应用责任人描述此四个参数为关联参数,需要同时出现。",
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporter_name": {
          "description": "应用实施人(长度1-64)。",
          "type": "string"
        },
        "supporter_phone": {
          "description": "应用实施电话(长度0-32)。",
          "type": "string"
        },
        "supporter_email": {
          "description": "应用实施邮箱(长度0-64,需满足邮箱格式)。",
          "type": "string"
        },
        "supporter_description": {
          "description": "应用实施人描述,数组长度最大1000(数组元素长度0-256)。应用实施人,应用实施电话,应用实施邮箱,应用实施人描述此四个参数为关联参数,需要同时出现。",
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attachment_id": {
          "description": "应用附件ID(已废弃)。",
          "type": "string"
        },
        "attachment_name": {
          "description": "应用附件名称(已废弃)。",
          "type": "string"
        },
        "attachment_size": {
          "description": "应用附件大小(已废弃)。",
          "type": "string"
        },
        "enterprise_id": {
          "description": "配额单元ID。多个时支持用逗号隔开,默认最大50个(已废弃)。",
          "type": "string"
        },
        "vdc_id": {
          "description": "VDC的ID(长度32,803新增,选择多资源空间必填,803以前的版本默认选择单个资源空间所在的vdc)。",
          "type": "string"
        },
        "portal": {
          "description": "扩展属性(长度0-2500)。",
          "maxItems": 15,
          "type": "array",
          "items": {
            "$ref": "#/definitions/PortalDetail"
          }
        }
      }
    },
    "CreateApplicationRes": {
      "description": "创建应用响应体。",
      "properties": {
        "id": {
          "description": "应用ID。",
          "type": "string"
        }
      }
    },
    "PortalDetail": {
      "description": "扩展属性",
      "properties": {
        "name": {
          "description": "名称。",
          "type": "string"
        },
        "description": {
          "description": "描述信息。",
          "type": "string"
        }
      }
    }
  },
