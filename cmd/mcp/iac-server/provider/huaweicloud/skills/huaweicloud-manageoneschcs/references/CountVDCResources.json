                "statics": [
                  {
                    "cloud_infra_type": "FUSION_CLOUD",
                    "service_id": "ECS",
                    "resources": [
                      {
                        "resource": "cores",
                        "toatl": 20000,
                        "used": 0
                      },
                      {
                        "resource": "instances",
                        "toatl": 100000,
                        "used": 0
                      },
                      {
