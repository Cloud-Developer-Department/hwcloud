{
  "name": "CreateService",
  "summary": "新增服务信息",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/services": {
      "post": {
        "summary": "新增服务信息",
        "description": "新增service\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -H \"X-Auth-Token: xxxxxxx\" -d \"{\"name\": \"vpc\",\"context_path\": \"/vpc\"}\" -X POST \"https://{endpoint}/silvan/rest/v1.0/services\"\n```",
        "tags": [
          "Console Home"
        ],
        "x-resource": "Service",
        "operationId": "CreateService",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-opseverity": "Minor",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "有效的token(op_service权限的用户token)"
          },
          {
            "name": "servicesCreateRequest",
            "in": "body",
            "required": true,
            "description": "服务信息。",
            "schema": {
              "$ref": "#/definitions/ServicesCreateRequest"
            }
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "service添加成功。",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": {
                "id": "31faf634-6ba0-440d-b07a-13ba4cb79205"
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/silvan/rest/v1.0/services",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "name": "nnn",
          "port": 443,
          "context_path": "/vpc"
        }
      }
    }
  },
  "definitions": {
    "ServicesCreateRequest": {
      "description": "创建服务对象。",
      "required": [
        "name",
        "port",
        "context_path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "服务名称,由不带<、>的字符组成,长度范围1~255"
        },
        "protocol": {
          "type": "string",
          "default": "https",
          "description": "服务支持的协议类型,可以是http或https,默认为https。"
        },
        "port": {
          "type": "integer",
          "format": "int64",
          "description": "服务对外端口。"
        },
        "retries": {
          "type": "integer",
          "format": "int32",
          "description": "代理失败后重试执行的次数。默认为3并且不能大于5。",
          "default": 3
        },
        "path": {
          "type": "string",
          "description": "服务路径,由不带<、>的字符组成,长度范围0~1024"
        },
        "host": {
          "type": "string",
          "description": "上游服务的地址。"
        },
        "context_path": {
          "type": "string",
          "description": "服务UI包中发请求时,给uri添加的前缀,由不带<、>的字符组成,长度范围0~255"
        },
        "connect_timeout": {
          "type": "integer",
          "format": "int64",
          "description": "与上游服务建立连接的时间(毫秒)。默认为60000。",
          "default": 60000
        },
        "write_timeout": {
          "type": "integer",
          "format": "int64",
          "description": "将请求发送到上游服务的两个连续写操作之间的超时时间(毫秒)。默认为60000。",
          "default": 60000
        },
        "read_timeout": {
          "type": "integer",
          "format": "int64",
          "description": "将请求发送到上游服务器的两个连续读操作之间的超时时间(毫秒)。默认为60000。",
          "default": 60000
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}