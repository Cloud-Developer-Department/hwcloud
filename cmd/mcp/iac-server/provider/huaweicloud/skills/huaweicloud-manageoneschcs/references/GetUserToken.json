        }
      }
    },
    "Error": {
      "description": "错误信息。",
      "properties": {
        "message": {
          "type": "string",
          "description": "错误信息。"
        },
        "code": {
          "type": "integer",
          "description": "错误码。"
        },
        "title": {
          "type": "string",
          "description": "错误标题。"
        }
      }
    },
    "TokenInfo": {
      "type": "object",
      "description": "Token信息",
      "required": [
        "methods",
        "issued_at",
        "expires_at",
        "user",
        "roles"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issued_at": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        },
        "user": {
          "$ref": "#/definitions/ResponseUserDomainObject"
        },
        "domian": {
          "$ref": "#/definitions/ResponseDomainObject"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RoleInfo"
          }
        }
      }
    },
    "RouteNotFoundError": {
      "description": "错误信息。",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误信息。"
        }
      }
    },
    "TokenResponse": {
      "properties": {
        "token": {
          "$ref": "#/definitions/TokenInfo"
        }
      }
    },
    "UserRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "用户名"
        },
        "password": {
          "type": "string",
          "description": "用户密码"
        },
        "domain": {
          "$ref": "#/definitions/RequestDomain"
        }
      }
    },
    "ResponseUserDomainObject": {
      "type": "object",
      "description": "用户和租户信息",
      "required": [
        "name",
        "id",
        "domain"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "用户名"
        },
        "id": {
          "type": "string",
          "description": "用户ID"
        },
        "domain": {
          "$ref": "#/definitions/ResponseDomainObject"
        }
      }
    }
  },
