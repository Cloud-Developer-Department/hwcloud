{
  "name": "ListVdcUsers",
  "summary": "查询VDC用户列表",
  "tags": "VDC",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/vdc/v3.2/vdcs/{vdc_id}/users": {
      "get": {
        "summary": "查询VDC用户列表",
        "x-resource": "用户管理",
        "description": "查询VDC用户列表。\n8.5.0版本后,该接口默认会返回北向账号(user_type=4)。\n\ncurl命令调用示例:\n```\ncurl -v -H \"Content-Type:application/json\" -X GET  \"https://{endpoint}/rest/vdc/v3.2/vdcs/{vdc_id}/users\"\n```\n|SLA项|定义|\n|-----|-----|\n|请求成功率| >=99.9%|\n|可用性|Tier1|\n|数据一致性|最终一致,不一致时长<1分钟|\n|吞吐量|120次/分钟|\n|吞吐量|20次/秒|\n|TP50请求时延|1500ms|\n|TP99.9请求时延|3000ms|",
        "tags": [
          "VDC"
        ],
        "operationId": "ListVdcUsers",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "接口支持的用户token。运营管理员,VDC管理员权限,vdc业务员权限,vdc只读权限,机机账号权限,代维管理员权限用户用户的token。"
          },
          {
            "name": "vdc_id",
            "in": "path",
            "description": "VDC id,只能包含小写字母、数字、中划线,长度在1-36之间。",
            "type": "string",
            "required": true
          },
          {
            "name": "name",
            "in": "query",
            "description": "按照名称或显示名字段模糊搜索。长度:1到128个字符。",
            "type": "string"
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序字段。枚举值:name。默认值为name。",
            "type": "string",
            "default": "name"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序方向。枚举值:desc 和asc,默认值:asc。",
            "type": "string",
            "default": "asc"
          },
          {
            "name": "start",
            "in": "query",
            "description": "分页查询的起始位置,最小值:0 ,最大值:2147483647 ,默认值:0。",
            "type": "integer",
            "format": "int32",
            "default": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制每页显示的条目数量,最小值:1,最大值:100 ,默认值:10。",
            "type": "integer",
            "format": "int32",
            "default": 10
          }
        ],
        "responses": {
          "200": {
            "description": "查询VDC用户列表成功。",
            "schema": {
              "$ref": "#/definitions/QueryVdcUserListResponse"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "users": [
                  {
                    "id": "xxx",
                    "domain_id": "xxx",
                    "domain_name": "xxx",
                    "name": "xxx",
                    "display_name": "",
                    "enabled": true,
                    "description": null,
                    "vdc_id": "xxx",
                    "vdc_name": "xxx",
                    "ldap_id": null,
                    "create_at": "xxx",
                    "login_at": 0,
                    "auth_type": "0",
                    "group_count": null,
                    "user_type": null,
                    "tag": "all",
                    "preseted": false,
                    "access_mode": "0"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET: https://{endpoint}/rest/vdc/v3.2/vdcs/{vdc_id}/users",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
