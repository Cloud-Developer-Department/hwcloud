{
  "name": "ListVDCMeters",
  "summary": "VDC管理员查询指定VDC的计量统计信息",
  "tags": "计量计价",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/metering/v3.0/vdcs/{vdc_id}/meters": {
      "get": {
        "summary": "VDC管理员查询指定VDC的计量统计信息",
        "description": "VDC管理员查询指定VDC的计量统计信息(如果数据量超过100w,建议填写参数region_id)。",
        "x-opseverity": "Minor",
        "x-resource": "VDC管理员计量管理",
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > 计量计价”章节。",
        "tags": [
          "计量计价"
        ],
        "operationId": "ListVDCMeters",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-language",
            "in": "header",
            "required": false,
            "type": "string",
            "description": "语言信息。",
            "enum": [
              "en-us",
              "zh-cn"
            ]
          },
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "当前用户的token。用于鉴权,必须具有vdc_adm、vdc_readonly、op_service角色。"
          },
          {
            "name": "vdc_id",
            "in": "path",
            "description": "VDC ID。",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "name": "locale",
            "in": "query",
            "description": "界面显示的语言类型。取值为:zh_CN(中文)或en_US(英文)。",
            "required": true,
            "type": "string",
            "enum": [
              "zh_CN",
              "en_US"
            ]
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "开始时间。时间为本地时间,格式:yyyy-mm-dd hh:mm:ss。",
            "required": true,
            "type": "string"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "结束时间。时间为本地时间,格式:yyyy-mm-dd hh:mm:ss。",
            "required": true,
            "type": "string"
          },
          {
            "name": "time_zone",
            "in": "query",
            "description": "时区信息。",
            "type": "string",
            "required": true,
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "spec_type",
            "in": "query",
            "description": "查询出的计量指标类型。取值:atom(原子计量)、flavor(规格计量)或all(全部)。",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "name": "region_id",
            "in": "query",
            "description": "地域ID。",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "az_id",
            "in": "query",
            "description": "可用分区ID。",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序字段。spec_type=atom时,支持的sort_key为(meterName, value, charge, spec_type)。spec_type为其他值时,支持的sort_key为(regionName, resourceTypeName, specName, meterValue, charge)。",
            "required": false,
            "type": "string",
            "enum": [
              "meterName",
              "value",
              "regionName",
              "resourceTypeName",
              "specName",
              "meterValue",
              "charge"
            ]
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序方向,取值范围asc,desc。",
            "required": false,
            "type": "string",
            "default": "asc",
            "enum": [
              "asc",
              "desc"
            ]
          },
          {
            "name": "start",
            "in": "query",
            "description": "分页查询的起始位置。默认从0开始,取值范围:0-2147483646。",
            "required": false,
            "type": "string",
            "maxLength": 10,
            "minLength": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制每页显示的条目数量,取值范围:1-100。",
            "required": false,
            "type": "string",
            "maxLength": 10,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "指定VDC的计量结果。",
            "schema": {
              "$ref": "#/definitions/StatisticsResponseList"
            },
            "examples": {
              "application/json": {
