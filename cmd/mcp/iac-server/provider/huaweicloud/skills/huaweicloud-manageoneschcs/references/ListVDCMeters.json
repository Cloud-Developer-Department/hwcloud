                    "resourceName": "kjvdc128",
                    "atomCharge": "0",
                    "flavorCharge": "0",
                    "regionCode": "shenzhen-region-1",
                    "regionName": "south china",
                    "azCode": null,
                    "azName": "all az",
                    "createTime": "2018-01-23 01:07:46",
                    "deleteTime": null,
                    "upperVdc": null,
                    "statistics": [
                      {
                        "meterId": "4ef3866e-50ac-45f9-b561-5e6aa0275f4d",
                        "meterName": "ECS-MEM-quota:cpu_shares#1000",
                        "meterType": "interval",
                        "meterUnit": "GB-Hour",
                        "meterKey": "NFVI-ECS-MEM",
                        "value": "10.81",
                        "time": "0",
                        "charge": "0.000000"
                      }
                    ],
                    "flavorStatistics": []
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "token鉴权失败"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/rest/metering/v3.0/vdcs/{vdc_id}/meters?spec_type={spec_type}&locale={locale}&start_time={start_time}&end_time={end_time}&time_zone={time_zone}&region_id={region_id}&sort_key={sort_key}&sort_dir={sort_dir}",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
