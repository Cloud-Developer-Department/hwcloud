{
  "name": "QueryUserList",
  "summary": "查询用户列表",
  "tags": "IAM1.0",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v3/users": {
      "get": {
        "summary": "查询用户列表",
        "description": "该接口用于查询用户列表。",
        "tags": [
          "IAM1.0"
        ],
        "operationId": "QueryUserList",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "用户名。如果包含中文或特殊字符,需要UrlEncode编码。",
            "type": "string"
          },
          {
            "name": "domain_id",
            "in": "query",
            "description": "用户所属的domain ID。",
            "type": "integer"
          },
          {
            "name": "enabled",
            "in": "query",
            "description": "是否启用用户,true为启用,false为停用,默认为true。",
            "type": "boolean"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "该字段内容填为“application/json;charset=utf8”。",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "已认证的拥有Security Administrator权限的token。",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。",
            "schema": {
              "$ref": "#/definitions/userList"
            },
            "examples": {
              "application/json": {
                "users": [
                  {
                    "name": "james1234",
                    "links": {
                      "self": "https://sample.domain.com/v3/users/6d8b04e3bf99445b8f76300903e5bf32"
                    },
                    "description": "james1234",
                    "domain_id": "88b16b6440684467b8825d7d96e154d8",
                    "enabled": false,
                    "id": "6d8b04e3bf99445b8f76300903e5bf32",
                    "default_project_id": "263fd9",
                    "password_expires_at": "2016-12-07T00:00:00.000000Z"
                  }
                ],
                "links": {
                  "self": "https://sample.domain.com/v3/users?domain_id=88b16b6440684467b8825d7d96e154d8&enabled=false",
                  "previous": null,
                  "next": null
                }
              }
            }
          },
          "401": {
            "description": "认证失败。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "token is not found or expired.",
                  "code": 401,
                  "title": "Unauthorized"
                }
              }
            }
          },
          "403": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "You are not authorized to perform the requested action: identity:xxxx",
                  "code": 403,
                  "title": "Forbidden"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在。",
            "schema": {
              "$ref": "#/definitions/RouteNotFoundError"
            },
            "examples": {
              "application/json": {
                "error_msg": "404 Route Not Found"
              }
            }
          },
          "500": {
            "description": "内部服务错误。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "Internal Exception",
                  "code": 500,
                  "title": "Internal Server Error"
                }
              }
            }
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/users",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
