{
  "name": "ListEndpoint",
  "summary": "查询所有endpoint",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/endpoints": {
      "get": {
        "summary": "查询所有endpoint",
        "description": "'查询所有endpoint,当带有region参数时返回当前region下的endpoints及全局的endpoints(endpointScope为global),当不带region时,反馈所有的endpoint列表'\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -X GET \"https://{endpoint}/silvan/rest/v1.0/endpoints?region=ap-sg\"\n```",
        "x-opseverity": "Info",
        "tags": [
          "Console Home"
        ],
        "x-resource": "Endpoint",
        "operationId": "ListEndpoint",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-auth-mode": "None",
        "parameters": [
          {
            "name": "X-Language",
            "in": "header",
            "description": "指定语言,英文为en-us,中文为zh-cn,默认为zh-cn",
            "type": "string"
          },
          {
            "name": "region",
            "type": "string",
            "in": "query",
            "description": "查询当前region下的endpoint"
          },
          {
            "name": "id",
            "type": "string",
            "in": "query",
            "description": "查询当前ID对应的endpoint"
          },
          {
            "name": "vdc_id",
            "type": "string",
            "in": "query",
            "description": "查询当前VDC支持的endpoint"
          },
          {
            "name": "start",
            "type": "integer",
            "format": "int32",
            "in": "query",
            "description": "分页查询的起始位置,默认从0开始。"
          },
          {
            "name": "limit",
            "type": "integer",
            "format": "int32",
            "maximum": 1000,
            "in": "query",
            "description": "limit参数表示一次查询多少条记录"
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "成功查询到endpoint列表",
            "schema": {
              "$ref": "#/definitions/ListEndpointResponse"
            },
            "examples": {
              "application/json": {
                "endpoints": [
                  {
                    "seqId": 3,
                    "id": "ecs",
                    "name": "ecs01",
                    "shortName": "ecs",
                    "catalog": "Compute",
                    "created": "2016-02-03 21:26:27",
                    "lastModified": "2016-02-03 21:26:27",
                    "version": "v1.0",
                    "endpoint": "https://{endpoint}/ecm/#/ecs/manager/vmList",
                    "endpointScope": "endpoint",
                    "description": "ecs description",
                    "active": true,
                    "serviceCss": "ecm",
                    "catalogCss": "Computing",
                    "defaultOpen": false,
                    "catalogOrder": 1,
                    "serviceOrder": 10,
                    "domainType": "vmall",
                    "regionId": "ap-sg",
                    "visible": true,
                    "links": [
                      {
                        "seqId": 450,
                        "key": "ecm",
                        "text": "buy",
                        "href": "https://{endpoint}/ecm/#/ecs/createVm",
                        "type": "endpoint"
                      }
                    ]
                  },
                  {
                    "seqId": 3,
                    "id": "dbs",
                    "name": "evs01",
                    "shortName": "dbs",
                    "catalog": "Storage",
                    "created": "2016-02-03 21:26:27",
                    "lastModified": "2016-02-03 21:26:27",
                    "version": "v1.0",
                    "endpoint": "https://{endpoint}/ecm/#/ecs/manager/volumelist",
                    "endpointScope": "endpoint",
                    "description": "evs description",
                    "active": true,
                    "serviceCss": "dbs",
                    "catalogCss": "Storage",
                    "defaultOpen": false,
                    "catalogOrder": 1,
                    "serviceOrder": 10,
                    "regionId": "ap-sg",
                    "domainType": "vmall",
                    "visible": true,
                    "links": [
                      {
                        "seqId": 450,
                        "key": "dbs",
                        "text": "dashboard",
                        "href": "https://{endpoint}/ecm/#/evs/manager/volumelist",
                        "type": "endpoint"
                      }
                    ]
                  }
                ],
                "total": 8
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/silvan/rest/v1.0/endpoints",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "QueryEndpointResponse": {
      "description": "单个endpoint对象信息",
      "properties": {
        "seqId": {
          "description": "endpoint记录在数据库中的序号,服务注册endpoint后,silvan会自动给该endpoint分配一个序号",
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "description": "服务id,也叫serviceId,endpointId,通常为服务缩写的小写形式",
          "type": "string"
        },
        "name": {
          "description": "服务名,通常为服务全称",
          "type": "string"
        },
        "shortName": {
          "description": "服务名缩写,收藏显示的name",
          "type": "string"
        },
        "created": {
          "description": "endpoint注册时间",
          "type": "string"
        },
        "lastModified": {
          "description": "endpoint最近修改时间",
          "type": "string"
        },
        "version": {
          "description": "api版本,暂时没用到,按常规取\"1.0\"即可",
          "type": "string"
        },
        "description": {
          "description": "服务的描述",
          "type": "string"
        },
        "endpoint": {
          "description": "服务的入口地址,即在页面上点击服务endpoint时跳转的地址",
          "type": "string"
        },
        "active": {
          "description": "endpoint是否激活",
          "type": "boolean"
        },
        "serviceCss": {
          "description": "endpoint在页面上的服务样式",
          "type": "string"
        },
        "defaultOpen": {
          "description": "服务是否默认对租户开放,是填true,默认开放的服务不显示购买图标和实例数,否填false",
          "type": "boolean"
        },
        "serviceOrder": {
          "description": "服务在其目录中的排序",
          "type": "integer",
          "format": "int32"
        },
        "domainType": {
          "description": "分销商类型",
          "type": "string"
        },
        "regionId": {
          "description": "当前endpoint所在的region值",
          "type": "string"
        },
        "nonsupportRegion": {
          "description": "服务不上线的region",
          "type": "string"
        },
        "catalog": {
          "description": "服务所属大类名称",
          "type": "string"
        },
        "catalogOrder": {
          "description": "服务所属大类的序号",
          "type": "integer"
        },
        "catalogCss": {
          "description": "服务大类样式",
          "type": "string"
        },
        "endpointScope": {
          "description": "默认为region global 级别的服务注册为“global”",
          "type": "string"
        },
        "links": {
          "description": "endpoint对应的link信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Link"
          }
        },
        "visible": {
          "description": "endpoint对应的visible信息",
          "type": "boolean",
          "default": true
        },
        "locale": {
          "description": "endpoint对应的locale信息",
          "type": "string"
        },
        "customCatalogId": {
          "description": "所属自定义服务目录ID",
          "type": "string",
          "minLength": 0,
          "maxLength": 50,
          "default": ""
        },
        "deployMode": {
          "description": "部署模式",
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "default": ""
        }
      }
    },
    "ListEndpointResponse": {
      "description": "endpoint列表信息",
      "properties": {
        "endpoints": {
          "description": "返回的endpoint数组",
          "type": "array",
          "items": {
            "$ref": "#/definitions/QueryEndpointResponse"
          }
        },
        "total": {
          "description": "endpoint信息的总条数",
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "Link": {
      "description": "链接信息",
      "properties": {
        "seqId": {
          "type": "integer",
          "format": "int64",
          "description": "记录在数据库中的序号,注册后,silvan会自动分配一个唯一的序号"
        },
        "key": {
          "type": "string",
          "description": "链接关键字"
        },
        "text": {
          "type": "string",
          "description": "链接内容"
        },
        "iconName": {
          "type": "string",
          "description": "链接按钮名称"
        },
        "href": {
          "type": "string",
          "description": "链接地址"
        },
        "type": {
          "type": "string",
          "description": "链接类型"
        },
        "domainType": {
          "type": "string",
          "description": "OB标识"
        },
        "regionId": {
          "type": "string",
          "description": "当前link所在的region值"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}