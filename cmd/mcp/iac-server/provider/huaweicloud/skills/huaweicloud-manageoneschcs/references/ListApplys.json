{
  "name": "ListApplys",
  "summary": "查询申请列表",
  "tags": "流程编排引擎",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/apply/v1.0/apply": {
      "get": {
        "summary": "查询申请列表",
        "description": "查询符合条件的申请列表",
        "x-opseverity": "Minor",
        "x-resource": "申请管理",
        "x-precautions": "错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > 流程编排引擎”章节。\n",
        "tags": [
          "流程编排引擎"
        ],
        "operationId": "ListApplys",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-language",
            "in": "header",
            "type": "string",
            "description": "语言类型:中文zh-cn、英文en-us。"
          },
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "操作用户的token。"
          },
          {
            "name": "source_system",
            "in": "query",
            "type": "string",
            "description": "来源系统,参数最大长度10。"
          },
          {
            "name": "service_type",
            "in": "query",
            "type": "string",
            "description": "申请类型,包含申请资源、事件工单等,参数最大长度64。"
          },
          {
            "name": "start",
            "in": "query",
            "type": "string",
            "default": 0,
            "description": "分页查询,起始值,0~999999999,默认值:0。"
          },
          {
            "name": "limit",
            "in": "query",
            "type": "string",
            "default": 10,
            "description": "分页查询,每页查询数据条数的最大值, 取值1~50,默认值:10。"
          },
          {
            "name": "name",
            "in": "query",
            "type": "string",
            "description": "申请名称,参数最大长度128。(已弃用,推荐使用search_key+search_words组合参数实现)"
          },
          {
            "name": "sort_key",
            "in": "query",
            "type": "string",
            "description": "排序字段,create_time即申请时间。"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "type": "string",
            "description": "排序方向,asc即升序,desc即降序。"
          },
          {
            "name": "search_key",
            "in": "query",
            "type": "string",
            "description": "模糊匹配字段,name即待办名称,object_id即待办对象编号。"
          },
          {
            "name": "search_words",
            "in": "query",
            "type": "string",
            "description": "模糊匹配内容,参数最大长度128,和search_key组合使用,传入需要匹配的内容。"
          },
          {
            "name": "status",
            "in": "query",
            "type": "string",
            "description": "申请任务状态,参数最大长度50。可传入多个由英文逗号分隔的值,状态列表:approving即审批中,handling即处理中,completed即已完成,closed即已关闭,canceled即已撤销,draft即草稿。"
          },
          {
            "name": "object_type",
            "in": "query",
            "type": "string",
            "description": "申请对象类型,order即订单,workorder即工单。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回符合条件的申请列表",
            "schema": {
              "$ref": "#/definitions/ApplyResponse"
            },
            "examples": {
              "application/json": {
                "total": 394,
                "applys": [
                  {
                    "id": "9dc4421c-f11d-4f2c-9b92-354e0ba12c01",
                    "name": "Account usage",
                    "name_en": "Account usage",
                    "source_system": "sc",
                    "organization_id": "e5ea561edc6646e087bed9e2fc1db9d6",
                    "object_id": "202411260930000868265",
                    "service_type": "31bd6653-43b2-45ba-a16c-e1eda86e9335",
                    "object_type": "workorder",
                    "status": "completed",
                    "creator_id": "a236bac9c36c403f96a8158b0fcf3665",
                    "creator_name": "bss_admin",
                    "create_time": "1732584602660",
                    "handler_name": "",
                    "finish_time": "1732584719748",
                    "detail_uri": "/mobasicframework",
                    "cancel_uri": "/rest/cancel",
                    "remind_flag": 1,
                    "last_remind_time": null,
                    "service_type_name": "Account Management Ticket(Work Order)",
                    "cancel_req_body": ""
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token鉴权失败"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "404": {
            "description": "rest接口未找到"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/rest/apply/v1.0/apply?start=0&limit=1&status=completed,closed",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "ApplyResponse": {
      "description": "符合条件的申请列表。",
      "required": [
        "total",
        "applys"
      ],
      "properties": {
        "total": {
          "description": "申请的数量。",
          "type": "integer",
          "format": "int32"
        },
        "applys": {
          "description": "申请列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ApplyInfo"
          }
        }
      }
    },
