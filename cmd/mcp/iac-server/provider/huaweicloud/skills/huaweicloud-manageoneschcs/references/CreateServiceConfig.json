{
  "name": "CreateServiceConfig",
  "summary": "新增服务配置信息",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/service-config": {
      "post": {
        "summary": "新增服务配置信息",
        "description": "新增服务配置信息\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -H \"X-Auth-Token: xxxxxxx\" -d \"{\"service_name\": \"moVpcService3\",\"config\": {\"support_regions\": [\"12321\",\"PUDS\"],\"maintenance_service\": [\"vpn\",\"VDC\"],\"token_ignore_paths_regex\": \"sdfsd\",\"auth_ignore_paths_regex\": \"\\\\\\\\\\\\\",\"session_touch_ignor\": null,\"csrf_methods\": [\"get\",\"PUT\"]}}\" -X POST \"https://{endpoint}/silvan/rest/v1.0/service-config\"\n```",
        "tags": [
          "Console Home"
        ],
        "x-resource": "Service Config",
        "operationId": "CreateServiceConfig",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-opseverity": "Minor",
        "parameters": [
          {
            "name": "X-Language",
            "in": "header",
            "type": "string",
            "description": "指定语言,英文为en-us,中文为zh-cn。"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "有效的token(op_service权限的用户token)"
          },
          {
            "name": "serviceConfigReq",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ServiceConfigRequest"
            },
            "description": "服务配置信息请求体"
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "成功创建服务配置信息。",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": {
                "operate": "success"
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/silvan/rest/v1.0/service-config",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "service_name": "moVpcService",
          "config": {
            "token_ignore_paths_regex": "",
            "maintenance_service": [
              "vpc"
            ],
            "auth_ignore_paths_regex": "",
            "csrf_methods": [
              "POST",
              "PUT",
              "DELETE",
              "PATCH"
            ],
            "session_touch_ignore": "",
            "support_regions": [
              "beta-xen"
            ],
            "extend_param": "{\"is_support_sc\":true}"
          },
          "region_id": "xx-xx-xxx"
        }
      }
    }
  },
  "definitions": {
    "ServiceConfigRequest": {
      "description": "服务配置信息请求实例。",
      "required": [
        "service_name",
        "config"
      ],
      "properties": {
        "service_name": {
          "type": "string",
          "description": "服务名,与service中的name对应。由不带<、>的字符组成,长度范围1~255"
        },
        "config": {
          "description": "服务配置。",
          "$ref": "#/definitions/ConfigDTO"
        },
        "region_id": {
          "type": "string",
          "description": "region信息,由不带<、>的字符组成,长度范围1~50",
          "maxLength": 50,
          "minLength": 0,
          "default": ""
        }
      }
    },
    "ConfigDTO": {
      "description": "配置信息实例。",
      "properties": {
        "support_regions": {
          "type": "array",
          "maxItems": 100,
          "description": "服务支持的region列表,为空表示服务支持所有region。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1024
          }
        },
        "maintenance_service": {
          "type": "array",
          "maxItems": 100,
          "description": "维护状态的服务列表。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1024
          }
        },
        "token_ignore_paths_regex": {
          "type": "string",
          "description": "不需要token鉴权的请求URI正则表达式,长度范围0~2048",
          "minLength": 0,
          "maxLength": 2048,
          "default": ""
        },
        "auth_ignore_paths_regex": {
          "type": "string",
          "description": "不需要做认证的URI正则表达式,长度范围0~2048",
          "minLength": 0,
          "maxLength": 2048,
          "default": ""
        },
        "csrf_ignore_paths_regex": {
          "type": "string",
          "description": "不需要csrf校验的URI正则表达式,长度范围0~2048",
          "minLength": 0,
          "maxLength": 2048,
          "default": ""
        },
        "session_touch_ignore": {
          "type": "string",
          "description": "不影响会话过期的URI正则表达式,常用于定时接口,长度范围0~2048",
          "minLength": 0,
          "maxLength": 2048,
          "default": ""
        },
        "csrf_methods": {
          "type": "array",
          "maxItems": 100,
          "description": "CSRF校验的方法。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1024
          }
        },
        "extend_param": {
          "type": "string",
          "description": "扩展字段。存放云服务配置参数,框架可以将此参数返回到页面,格式为JSON字符串,长度范围0~4096。",
          "minLength": 0,
          "maxLength": 4096,
          "default": ""
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
