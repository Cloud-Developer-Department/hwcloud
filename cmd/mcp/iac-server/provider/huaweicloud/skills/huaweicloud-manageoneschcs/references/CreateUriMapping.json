  "definitions": {
    "UriMappingRequest": {
      "description": "URI接口信息请求实例。",
      "required": [
        "service",
        "uri",
        "method",
        "target_service",
        "target_uri"
      ],
      "properties": {
        "service": {
          "type": "string",
          "description": "服务名,与service中的name对应。由单个*或字母字符、数字、“_”和“-”组成,长度范围是1~255个字符。"
        },
        "uri": {
          "type": "string",
          "description": "北向URI。不带“<”或“>”的字符组成,长度范围是1~512个字符。"
        },
        "method": {
          "type": "string",
          "description": "请求方法,由不包含”<“、”>“的字符组成,长度范围1~50"
        },
        "var_pattern": {
          "type": "string",
          "description": "模式,不带“<”或“>”的字符组成,长度范围是0~255个字符。"
        },
        "mode": {
          "type": "string",
          "description": "URI匹配方式,包括全匹配:FULL,最长匹配:SWA.默认为FULL。",
          "default": "FULL"
        },
        "target_service": {
          "type": "string",
          "description": "目标服务。由单个*或字母字符、数字、“_”和“-”组成,长度范围是1~255个字符。"
        },
        "target_protocol": {
          "type": "string",
          "description": "向region service转发请求时的HTTP协议(http/https)。"
        },
        "target_uri": {
          "type": "string",
          "description": "南向URI,不带“<”或“>”的字符组成,长度范围是1~512个字符。"
        },
        "region_id": {
          "type": "string",
          "description": "所属区域,由不包含”<“、”>“的字符组成,长度范围1~50",
          "default": ""
        }
      }
    }
  },
