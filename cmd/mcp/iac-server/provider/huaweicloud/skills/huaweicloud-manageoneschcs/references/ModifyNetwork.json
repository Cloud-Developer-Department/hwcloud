          },
          {
            "name": "id",
            "in": "path",
            "description": "网络ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "request",
            "in": "body",
            "description": "修改网络请求。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ModifyFCNetworkReq"
            }
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > VRM云服务”章节。\n",
