  "definitions": {
    "FCModifyNetworkResp": {
      "description": "更新内部网络响应体。",
      "properties": {
        "task_id": {
          "description": "更新内部网络对应任务的ID。",
          "type": "string"
        }
      }
    },
    "Subnet4ModifyingFCNetwork": {
      "properties": {
        "allocation_pools": {
          "description": "IP地址池。",
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/AllocationPool4FCNetwork"
          }
        }
      }
    },
    "ModifyFCNetworkReq": {
      "required": [
        "cloud_infra_id",
        "vpc_id"
      ],
      "description": "修改网络请求体。",
      "properties": {
        "cloud_infra_id": {
          "description": "云资源池ID。",
          "type": "string"
        },
        "vpc_id": {
          "description": "VPC ID。",
          "type": "string"
        },
        "name": {
          "description": "网络名称。由中文字符、字母字符、数字、中划线及下划线组成,长度范围是1-64个字符。",
          "type": "string"
        },
        "description": {
          "description": "网络描述。长度范围0-1024个字符。不能包含<和>。",
          "type": "string"
        },
        "qos_id": {
          "description": "关联的Qos ID。",
          "type": "string"
        },
        "ipv4_primary_dns": {
          "description": "IPv4协议的首选DNS服务器地址。",
          "type": "string"
        },
        "ipv4_second_dns": {
          "description": "IPv4协议的备选DNS服务器地址。",
          "type": "string"
        },
        "ipv6_primary_dns": {
          "description": "IPv6协议的首选DNS服务器地址。",
          "type": "string"
        },
        "ipv6_second_dns": {
          "description": "IPv6协议的备选DNS服务器地址。",
          "type": "string"
        },
        "ipv4_subnet": {
          "description": "IPv4子网信息。",
          "$ref": "#/definitions/Subnet4ModifyingFCNetwork"
        },
        "ipv6_subnet": {
          "description": "IPv6子网信息。",
          "$ref": "#/definitions/Subnet4ModifyingFCNetwork"
        }
      }
    },
    "AllocationPool4FCNetwork": {
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "description": "起始IP地址。",
          "type": "string"
        },
        "end": {
          "description": "结束IP地址。",
          "type": "string"
        }
      }
    }
  },
