{
  "name": "ListRegionByEndpoint",
  "summary": "批量查询region和endpoint关联",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/endpoints/{endpoint_id}/regions": {
      "get": {
        "summary": "批量查询region和endpoint关联",
        "description": "查询region endpoint关联\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -X GET \"https://{endpoint}/silvan/rest/v1.0/endpoints/ecs/regions\"\n```",
        "tags": [
          "Console Home"
        ],
        "x-resource": "Endpoint和Region关联",
        "operationId": "ListRegionByEndpoint",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-auth-mode": "None",
        "x-opseverity": "Minor",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "有效的token(op_service权限的用户token)"
          },
          {
            "name": "endpoint_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "服务id,由大小写英文字符、数字、“-”组成,长度范围1~255"
          },
          {
            "name": "auth_mode",
            "in": "query",
            "type": "boolean",
            "description": "指定是否返回authConfig字段,auth_mode为true时返回authConfig,否则不返回"
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "服务区域关联列表",
            "schema": {
              "$ref": "#/definitions/EndpointRegionList"
            },
            "examples": {
              "application/json": {
                "regionEndpoints": [
                  {
                    "seqId": 1,
                    "endpointId": "nova",
                    "regionId": "cn-east-sd",
                    "address": "xx.xx.xx.xx",
                    "port": 8443,
                    "authConfig": "PKIToken"
                  },
                  {
                    "seqId": 2,
                    "endpointId": "cinder",
                    "regionId": "cn-west-hn",
                    "address": "xx.xx.xx.xx",
                    "port": 7665,
                    "authConfig": "PKITokenSMSCompatible"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/silvan/rest/v1.0/endpoints/ecs/regions",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "EndpointRegionList": {
      "description": "区域Endpoint列表",
      "properties": {
        "regionEndpoints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EndpointRegion"
          },
          "description": "Endpoint信息"
        }
      }
    },
    "EndpointRegion": {
      "description": "服务Endpoint和区域Region关联对象",
      "properties": {
        "seqId": {
          "type": "integer",
          "format": "int64",
          "description": "服务注册endpoint后,silvan会自动给该endpoint分配一个序号"
        },
        "endpointId": {
          "type": "string",
          "description": "服务Endpoint Id"
        },
        "regionId": {
          "type": "string",
          "description": "服务Endpoint区域Id"
        },
        "address": {
          "type": "string",
          "description": "服务Endpoint地址"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "description": "服务Endpoint端口"
        },
        "authConfig": {
          "type": "string",
          "description": "支持的token类型标识,PKIToken:国际PKIToken、STSTokenSign:STSToken、PKITokenSMS:国密PKIToken、PKITokenSMSCompatible:国密/国际PKIToken"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}