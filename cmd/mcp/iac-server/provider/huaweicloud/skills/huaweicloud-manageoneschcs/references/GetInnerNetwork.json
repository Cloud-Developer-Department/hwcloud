  "definitions": {
    "FCNetworkQOSTemplate": {
      "description": "QoS规格。",
      "required": [
        "send_average_bandwidth",
        "send_max_bandwidth",
        "send_burst_size",
        "priority",
        "accept_average_bandwidth",
        "accept_max_bandwidth",
        "accept_burst_size"
      ],
      "properties": {
        "id": {
          "description": "QOS规格ID。",
          "type": "string"
        },
        "name": {
          "description": "QOS规格名称。",
          "type": "string"
        },
        "send_average_bandwidth": {
          "description": "发送平均带宽。参数范围:1-10000。单位:Mbit/s,0表示未设置。",
          "type": "integer",
          "format": "int32"
        },
        "send_max_bandwidth": {
          "description": "发送峰值带宽。参数范围:send_average_bandwidth参数值-10000。单位:Mbit/s,0表示未设置。",
          "type": "integer",
          "format": "int32"
        },
        "send_burst_size": {
          "description": "发送突发大小。参数范围:1-10000。单位:Mbit/s,0表示未设置。",
          "type": "integer",
          "format": "int32"
        },
        "priority": {
          "description": "发送优先级。参数范围:2-7,0表示未设置。",
          "type": "integer",
          "format": "int32"
        },
        "accept_average_bandwidth": {
          "description": "接收平均带宽。参数范围:1-10000。单位:Mbit/s,0表示未设置。",
          "type": "integer",
          "format": "int32"
        },
        "accept_max_bandwidth": {
          "description": "接收峰值带宽。参数范围:accept_average_bandwidth参数值-10000。单位:Mbit/s,0表示未设置。",
          "type": "integer",
          "format": "int32"
        },
        "accept_burst_size": {
          "description": "接收突发大小。参数范围:1-10000。单位:Mbit/s,0表示未设置。",
          "type": "integer",
          "format": "int32"
        }
      }
    },
