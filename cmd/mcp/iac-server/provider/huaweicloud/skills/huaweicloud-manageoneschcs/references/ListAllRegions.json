  "definitions": {
    "QueryRegionResponse": {
      "description": "查询region返回的单个对象信息",
      "properties": {
        "seqId": {
          "description": "region记录在数据库中的Id",
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "description": "region的id信息",
          "type": "string"
        },
        "name": {
          "description": "region的name信息",
          "type": "string"
        },
        "created": {
          "description": "region的创建时间",
          "type": "string"
        },
        "lastModified": {
          "description": "region最后一次修改时间",
          "type": "string"
        },
        "locale": {
