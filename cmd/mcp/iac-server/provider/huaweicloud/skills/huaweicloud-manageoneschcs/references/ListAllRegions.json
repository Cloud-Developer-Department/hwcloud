        },
        "authUrl": {
          "description": "多云合一场景下从接入管理查询跳转的authUrl",
          "type": "string"
        },
        "iamId": {
          "description": "多IAM场景下表示当前region所属的IAM信息",
          "type": "string"
        },
        "globalId": {
          "description": "对端的region Id",
          "type": "string"
        }
