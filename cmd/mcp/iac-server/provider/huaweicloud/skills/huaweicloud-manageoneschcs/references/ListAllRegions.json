      "description": "region列表信息",
      "properties": {
        "regions": {
          "description": "返回的region数组",
          "type": "array",
          "items": {
            "$ref": "#/definitions/QueryRegionResponse"
          }
        },
        "total": {
          "description": "region信息的总条数",
          "type": "integer",
          "format": "int64"
