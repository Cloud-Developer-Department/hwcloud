{
  "name": "CreateLinks",
  "summary": "新增服务链接信息",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/links": {
      "post": {
        "summary": "新增服务链接信息",
        "description": "新增服务链接信息\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -H \"X-Auth-Token: xxxxxxx\" -d \"{\"key\": \"message_list\",\"text\": \"消息列表\", \"iconName\": \"message\",\"href\": \"https://{endpoint}\",\"type\": \"message_center\",\"domainType\": \"TSI\" }\" -X POST \"https://{endpoint}/silvan/rest/v1.0/links\"\n```",
        "tags": [
          "Console Home"
        ],
        "x-resource": "链接",
        "operationId": "CreateLinks",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-opseverity": "Minor",
        "parameters": [
          {
            "name": "X-Language",
            "in": "header",
            "type": "string",
            "description": "指定语言,默认为zh-cn"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "有效的token(op_service权限的用户token)"
          },
          {
            "name": "Frame-Domain-Type",
            "in": "header",
            "type": "string",
            "description": "OB信息,可为空,添该header时,按OB查询,不建议添加该header"
          },
          {
            "name": "link",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LinkRequest"
            },
            "description": "链接信息结构体"
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "link创建成功",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": {
                "operate": "success",
                "seqId": 1
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/silvan/rest/v1.0/links",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "key": "user_center",
          "text": "text",
          "iconName": "text",
          "href": "https://{endpoint}/usercenter",
          "type": "common",
          "regionId": "ap-sg",
          "domainType": "BR"
        }
      }
    }
  },
  "definitions": {
    "LinkRequest": {
      "description": "链接请求信息",
      "required": [
        "key",
        "text",
        "href",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "链接关键字,由不包含“<”、“>”的字符组成,长度范围1~50",
          "minLength": 1,
          "maxLength": 50
        },
        "text": {
          "type": "string",
          "description": "链接内容,由不包含“<”、“>”的字符组成,长度范围1~255",
          "minLength": 1,
          "maxLength": 255
        },
        "iconName": {
          "type": "string",
          "description": "链接按钮名称,由不包含“<”、“>”的字符组成,长度范围0~255",
          "minLength": 0,
          "maxLength": 255
        },
        "href": {
          "type": "string",
          "description": "链接地址,合法的url或域名",
          "minLength": 1,
          "maxLength": 255
        },
        "type": {
          "type": "string",
          "description": "链接类型,由不包含“<”、“>”的字符组成,长度范围1~50",
          "minLength": 1,
          "maxLength": 50
        },
        "domainType": {
          "type": "string",
          "description": "OB标识,由不包含“<”、“>”的字符组成,长度范围0~100",
          "minLength": 0,
          "maxLength": 100,
          "default": ""
        },
        "regionId": {
          "description": "当前link所在的region值,由不包含“<”、“>”的字符组成,长度范围1~50",
          "type": "string",
          "minLength": 0,
          "maxLength": 50,
          "default": ""
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}