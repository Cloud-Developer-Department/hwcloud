{
  "name": "ListDomains",
  "summary": "查询租户列表",
  "tags": "VDC",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/vdc/v3.0/domains": {
      "get": {
        "summary": "查询租户列表",
        "x-resource": "租户管理",
        "description": "查询租户列表。\n\ncurl命令调用示例:\n```\ncurl -v -H \"Content-Type:application/json\" -X GET \"https://{endpoint}/rest/vdc/v3.0/domains\"\n```\n|SLA项|定义|\n|-----|-----|\n|请求成功率| >=99.9%|\n|可用性|Tier1|\n|数据一致性|最终一致,不一致时长<1分钟|\n|吞吐量|120次/分钟|\n|吞吐量|10次/秒|\n|TP50请求时延|1500ms|\n|TP99.9请求时延|3000ms|",
        "x-precautions": "错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > VDC特性”章节。",
        "tags": [
          "VDC"
        ],
        "operationId": "ListDomains",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "接口支持的用户token。运营管理员,机机账号权限。"
          },
          {
            "name": "domain_id",
            "in": "query",
            "description": "租户 ID",
            "type": "string"
          },
          {
            "name": "name",
            "in": "query",
            "description": "租户名称",
            "type": "string"
          },
          {
            "name": "type",
            "in": "query",
            "description": "租户类型",
            "type": "string"
          },
          {
            "name": "auth_type",
            "in": "query",
            "description": "租户认证类型,0:本地认证,1:SAML认证,2:LDAP认证,5:CAS认证,6:OAuth认证。",
            "type": "string"
          },
          {
            "name": "mfa_status",
            "in": "query",
            "description": "MFA状态",
            "type": "string"
          },
          {
            "name": "tag_key",
            "in": "query",
            "description": "标签键",
            "type": "string"
          },
          {
            "name": "tag_value",
            "in": "query",
            "description": "标签值",
            "type": "string"
          },
          {
            "name": "start",
            "in": "query",
            "description": "分页查询的起始位置,取值在0-2147483647之间,默认从0开始",
            "type": "integer"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制每页显示的条目数量,取值在0-1000之间,默认查询1000条",
            "type": "integer",
            "default": 1000
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序字段,默认按照create_at,支持名称,modify_at排序",
            "type": "string",
            "default": "create_at"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "升序或降序,desc:降序,asc:升序",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询租户列表成功。",
            "schema": {
              "$ref": "#/definitions/ListDomainsResponse"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "domains": [
                  {
                    "id": "e19554e8fe4d426f9fd4566e07bceb70",
                    "name": "example_tenant",
                    "status": "0",
                    "description": "This is a test tenant.",
                    "type": "DEFAULT",
                    "mfa_status": false,
                    "third_type": "0",
                    "ldap_id": "",
                    "create_at": "2023-10-25T15:30:00Z",
                    "update_at": "2023-10-25T15:30:00Z",
                    "create_user": "admin",
                    "update_user": "admin",
                    "tags": [
                      {
                        "name": "tag1"
                      }
                    ],
                    "extra": {
                      "manager": "xxx"
                    }
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/rest/vdc/v3.0/domains",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "ListDomainsResponse": {
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "租户总数。"
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DomainResponseBase"
          },
          "description": "租户列表。"
        }
      }
    },
    "DomainResponseBase": {
      "allOf": [
        {
          "$ref": "#/definitions/DomainBase"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "租户ID。"
            },
            "status": {
              "type": "string",
              "description": "租户状态。"
            },
            "type": {
              "type": "string",
              "default": "DEFAULT",
              "description": "租户类型。DEFAULT:普通租户,AGENCY:代维租户,MANAGE:管理租户,SYSTEM:系统租户。"
            },
            "create_at": {
              "type": "integer",
              "format": "int64",
              "description": "创建时间。"
            },
            "modify_at": {
              "type": "integer",
              "format": "int64",
              "description": "修改时间。"
            },
            "create_user": {
              "type": "string",
              "description": "创建者。"
            },
            "modify_user": {
              "type": "string",
              "description": "最后修改者。"
            },
            "tags": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "$ref": "#/definitions/TagModal"
              },
              "description": "租户标签列表。"
            }
          }
        }
      ]
    },
    "DomainBase": {
      "properties": {
        "name": {
          "type": "string",
          "description": "租户名称,长度为1-64位,只能由中文、英文字母(不区分大小写)、数字、特殊字符(!@$^-_=+[{}]:,./?~#*;|)组成,且不能以数字、\"op_\"、\"shadow_\"开头。"
        },
        "description": {
          "type": "string",
          "description": "描述,长度在0-255之间,不能包含\"<\"和\">\"。"
        },
        "mfa_status": {
          "type": "boolean",
          "default": false,
          "description": "租户双因素认证状态,true:开启,false:关闭。"
        },
        "third_type": {
          "type": "string",
          "default": 0,
          "description": "租户认证类型,0:本地认证,1:SAML认证,2:LDAP认证,5:CAS认证,6:OAuth认证。"
        },
        "ldap_id": {
          "type": "string",
          "description": "身份提供商标识,当third_type非0时必填。"
        },
        "extra": {
          "$ref": "#/definitions/DomainExtra",
          "description": "租户扩展信息。"
        }
      }
    },
    "TagModal": {
      "properties": {
        "key": {
          "type": "string",
          "description": "标签key。"
        },
        "value": {
          "type": "string",
          "description": "标签value。"
        }
      }
    },
    "DomainExtra": {
      "properties": {
        "manager": {
          "type": "string",
          "description": "业务主管。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
