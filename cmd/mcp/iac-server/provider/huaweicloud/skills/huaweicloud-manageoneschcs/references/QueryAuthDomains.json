{
  "name": "QueryAuthDomains",
  "summary": "查询用户可以访问的租户列表",
  "tags": "IAM1.0",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v3/auth/domains": {
      "get": {
        "summary": "查询用户可以访问的租户列表",
        "description": "该接口用于查询用户可以访问的租户列表。",
        "tags": [
          "IAM1.0"
        ],
        "operationId": "QueryAuthDomains",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "已认证的token。",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。",
            "schema": {
              "$ref": "#/definitions/ListDomainInfo"
            },
            "examples": {
              "application/json": {
                "domains": [
                  {
                    "description": "desc of domain",
                    "enabled": true,
                    "enterpriseName": "hw",
                    "id": "37ef61",
                    "links": {
                      "self": "https://example.com/v3/domains/37ef61"
                    },
                    "name": "my domain"
                  }
                ],
                "links": {
                  "self": "https://example.com/v3/auth/domains",
                  "previous": null,
                  "next": null
                }
              }
            }
          },
          "401": {
            "description": "认证失败。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "token is not found or expired.",
                  "code": 401,
                  "title": "Unauthorized"
                }
              }
            }
          },
          "403": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "You are not authorized to perform the requested action: identity:xxxx",
                  "code": 403,
                  "title": "You are not authorized to perform the requested action."
                }
              }
            }
          },
          "404": {
            "description": "未找到相应的资源。",
            "schema": {
              "$ref": "#/definitions/RouteNotFoundError"
            },
            "examples": {
              "application/json": {
                "error_msg": "404 Route Not Found"
              }
            }
          },
          "500": {
            "description": "内部服务错误。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "Internal Exception",
                  "code": 500,
                  "title": "Internal Server Error"
                }
              }
            }
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/auth/domains",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "ErrorCode": {
      "type": "object",
      "description": "错误码",
      "properties": {
        "error": {
          "$ref": "#/definitions/Error"
        }
      }
    },
    "LinkInfo": {
      "type": "object",
      "description": "链接信息",
      "properties": {
        "href": {
          "type": "string",
          "description": "链接地址"
        },
        "rel": {
          "type": "string",
          "description": "链接关系"
        }
      }
    },
    "Error": {
      "description": "错误信息。",
      "properties": {
        "message": {
          "type": "string",
          "description": "错误信息。"
        },
        "code": {
          "type": "integer",
          "description": "错误码。"
        },
        "title": {
          "type": "string",
          "description": "错误标题。"
        }
      }
    },
    "ListDomainInfo": {
      "type": "object",
      "description": "租户列表。",
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DomainInfo"
          }
        },
        "links": {
          "$ref": "#/definitions/LinkInfo"
        }
      }
    },
    "RouteNotFoundError": {
      "description": "错误信息。",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误信息。"
        }
      }
    },
    "Linkpath": {
      "type": "object",
      "description": "资源访问链接。",
      "properties": {
        "self": {
          "type": "string",
          "description": "资源的链接。"
        }
      }
    },
    "DomainInfo": {
      "type": "object",
      "description": "租户信息。",
      "properties": {
        "name": {
          "type": "string",
          "description": "租户名。"
        },
        "enabled": {
          "type": "boolean",
          "description": "是否启用租户,true为启用,false为停用,默认为true。"
        },
        "id": {
          "type": "string",
          "description": "租户ID。"
        },
        "description": {
          "type": "string",
          "description": "租户描述。"
        },
        "enterpriseName": {
          "type": "string",
          "description": "企业租户名。"
        },
        "links": {
          "$ref": "#/definitions/Linkpath"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
