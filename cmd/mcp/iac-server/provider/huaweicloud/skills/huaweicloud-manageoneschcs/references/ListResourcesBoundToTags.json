{
  "name": "ListResourcesBoundToTags",
  "summary": "查询标签绑定的资源列表",
  "tags": "标签管理",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/tag/v3.0/tags/resources/action": {
      "post": {
        "summary": "查询标签绑定的资源列表",
        "description": "查询标签绑定的资源列表。\n```\ncurl -i -k -H \"Content-Type: application/json\" -H \"Accept:application/json\"  -H \"x-auth-token:XXXXX\" -X POST \"https://{endpoint}/rest/tag/v3.0/tags/resources/action\"  -d '{ \"tags\": [{ \"key\": \"xxxx\", \"value\": \"XXXX\"}],\"tags_any\": [{ \"key\": \"XXXX\",\"value\": \"XXXX\" }], \"region_id\": \"XXXX\",\"resource_id\": \"XXXX\",\"resource_name\": \"XXXX\",\"project_id\": \"XXXX\",\"resource_type\": \"XXXX\",\"limit\": \"10\",\"start\": \"0\",\"action\": \"count\" }'\n\n```\n|SLA项|定义|\n|-----|-----|\n|请求成功率| >=99.9%|\n|可用性|Tier1|\n|数据一致性|最终一致,不一致时长<1分钟|\n|吞吐量|60次/分钟|\n|吞吐量|10次/秒|\n|TP50请求时延|1500ms|\n|TP99.9请求时延|3000ms|",
        "x-precautions": "错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > 标签管理特性”章节。",
        "x-service": "标签管理",
        "x-resource": "标签关联资源",
        "x-opseverity": "Minor",
        "tags": [
          "标签管理"
        ],
        "operationId": "ListResourcesBoundToTags",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "接口支持的用户token(token需要携带project信息):VDC管理员、VDC业务员、代维管理员以及VDC只读。"
          },
          {
            "name": "queryResourceTagReq",
            "in": "body",
            "description": "查询标签绑定的资源列表请求参数。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/QueryResourceTagReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询资源关联标签列表成功",
            "schema": {
              "$ref": "#/definitions/ListResourceTagRep"
            },
            "examples": {
              "application/json": {
                "total": 0,
                "resources": [
                  {
                    "region_id": "xxxx",
                    "project_id": "xxxx",
                    "cloud_infra_id": "xxxx",
                    "resource_id": "xxxx",
                    "resource_name": "xxxx",
                    "resource_type": "xxxx",
                    "tags": [
                      {
                        "key": "xxx",
                        "value": "xxx",
                        "operate_time": "yyyy-MM-dd HH:mm:ss"
                      }
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "403": {
            "description": "URL鉴权"
          },
          "404": {
            "description": "rest接口没找到"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/rest/tag/v3.0/tags/resources/action",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "tags": [
            {
              "key": "xxx",
              "value": "xxx"
            }
          ],
          "tags_any": [
            {
              "key": "xxx",
              "value": "xxx"
            }
          ],
          "project_id": "xxxx",
          "region_id": "xxx",
          "cloud_infra_id": "xxxx",
          "resource_id": "xxx",
          "resource_name": "xxx",
          "resource_type": "xxx",
          "limit": "xxx",
          "start": "xxx",
          "action": "filter|count|accurate_query"
        }
      }
    }
  },
  "definitions": {
    "Resources": {
      "description": "资源列表。",
      "properties": {
        "region_id": {
          "description": "实例所在Region的ID,最大长度36个字节。",
          "type": "string"
        },
        "project_id": {
          "description": "实例所属Project的ID,最大长度36个字节。",
          "type": "string"
        },
        "cloud_infra_id": {
          "description": "实例所在资源池的ID,最大长度36个字节。",
          "type": "string"
        },
        "resource_id": {
          "description": "资源ID,最大长度36个字节。",
          "type": "string"
        },
        "resource_name": {
          "description": "资源名称,无名称时传-(中划线),最大长度256个字节。",
          "type": "string"
        },
        "resource_type": {
          "description": "资源类型,即云服务ServiceID,最大长度32个字节,例如:ecs。",
          "type": "string"
        },
        "tags": {
          "description": "标签列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/TagRep"
          }
        }
      }
    },
    "TagRep": {
      "description": "查询关联表响应体中标签参数表。",
      "properties": {
        "key": {
          "description": "标签key,最大长度36个字节。",
          "type": "string"
        },
        "value": {
          "description": "标签value,最大长度43个字节。",
          "type": "string"
        },
        "operate_time": {
          "description": "操作时间,最大长度32个字节,格式:yyyy-MM-dd HH:mm:ss。",
          "type": "string"
        }
      }
    },
    "TagReq": {
      "description": "查询关联表请求体中标签参数表。",
      "properties": {
        "id": {
          "description": "标签ID,最大长度36个字节。",
          "type": "string"
        },
        "key": {
          "description": "标签的键,最大长度36字符,由英文字母、数字、下划线、中划线、中文字符组成,不能以双下划线开头。",
          "type": "string"
        },
        "value": {
          "description": "标签的值,最大长度43字符,由英文字母、数字、下划线、点、中划线、中文字符组成。",
          "type": "string"
        }
      }
    },
    "QueryResourceTagReq": {
      "description": "查询标签关联资源请求参数。",
      "required": [
        "project_id",
        "action"
      ],
      "properties": {
        "tags": {
          "description": "必须要包含的标签列表,tags和tags_any不能同时传入。",
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/TagReq"
          }
        },
        "tags_any": {
          "description": "可任意包含的标签列表,tags和tags_any不能同时传入。",
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/TagReq"
          }
        },
        "project_id": {
          "description": "实例所属Project的ID,最大长度36个字节。",
          "type": "string"
        },
        "region_id": {
          "description": "实例所在Region的ID,最大长度36个字节。",
          "type": "string"
        },
        "cloud_infra_id": {
          "description": "实例所在资源池的ID,最大长度36个字节。",
          "type": "string"
        },
        "resource_id": {
          "description": "资源ID,最大长度36个字节。",
          "type": "string"
        },
        "resource_name": {
          "description": "资源名称,无名称时传-(中划线),最大长度256个字节。",
          "type": "string"
        },
        "resource_type": {
          "description": "资源类型,即云服务ServiceID,最大长度32个字节。",
          "type": "string"
        },
        "start": {
          "description": "分页查询的起始位置,有效值为非负整型数。",
          "type": "string"
        },
        "limit": {
          "description": "限制每页显示的条目数量,有效值为非负整型数。",
          "type": "string"
        },
        "action": {
          "description": "操作类型(区分大小写):filter:分页查询;count:查询总记录数;accurate_query:精确查询。",
          "type": "string"
        }
      }
    },
    "ListResourceTagRep": {
      "description": "查询资源列表响应体。",
      "properties": {
        "total": {
          "description": "总数。",
          "type": "integer",
          "format": "int32"
        },
        "resources": {
          "description": "资源列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Resources"
          }
        }
      }
    }
  },
  "version": "2.0",
