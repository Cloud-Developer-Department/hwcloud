  "paths": {
    "/silvan/rest/v1.0/services": {
      "get": {
        "summary": "查询services",
        "description": "查询服务信息\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -H \"X-Auth-Token: xxxxxxx\" -X GET \"https://{endpoint}/silvan/rest/v1.0/services?page=1&size=10\"\n```",
        "tags": [
          "Console Home"
        ],
        "x-resource": "Service",
        "operationId": "ListAllServices",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-auth-mode": "None",
        "x-opseverity": "Minor",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "有效的token"
          },
          {
            "name": "page",
            "type": "integer",
            "format": "int32",
            "default": 1,
            "minimum": 1,
            "maximum": 999,
            "in": "query",
            "description": "分页查询时的页数,参数范围1-999。"
          },
          {
            "name": "size",
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 99,
            "in": "query",
            "description": "分页查询时每页数据条数,0-99,为0时默认查全量"
          }
        ],
        "responses": {
          "200": {
            "description": "服务列表。",
            "schema": {
              "$ref": "#/definitions/ServicesList"
            },
            "examples": {
