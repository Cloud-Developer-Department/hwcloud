                    "update_time": 1548372697015,
                    "port": 0,
                    "retries": 0,
                    "path": null,
                    "context_path": "/kkk",
                    "connect_timeout": 0,
                    "write_timeout": 0,
                    "read_timeout": 0
                  }
                ],
                "total": 1
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/silvan/rest/v1.0/services?page=1&size=10",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "Services": {
      "description": "服务对象。",
      "properties": {
        "id": {
          "type": "string",
          "description": "服务id,uuid。"
        },
        "name": {
          "type": "string",
          "description": "服务名称,通常和服务endpoint id一致。"
        },
        "protocol": {
          "type": "string",
          "default": "https",
          "description": "服务支持的协议类型,可以是http或https,默认为https。"
        },
        "host": {
          "type": "string",
          "description": "上游服务的地址。"
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "description": "服务创建时间。"
        },
        "update_time": {
          "type": "integer",
          "format": "int64",
          "description": "服务更新时间。"
        },
        "port": {
          "type": "integer",
          "format": "int64",
          "description": "服务对外开发的端口。"
        },
        "retries": {
          "type": "integer",
          "format": "int32",
          "description": "代理失败后重试执行的次数。默认为3并且不能大于5。",
          "default": 3
        },
        "path": {
          "type": "string",
          "description": "服务路径。"
        },
        "context_path": {
          "type": "string",
          "description": "服务UI包中发请求时,给uri添加的前缀,以“/”开头。"
        },
        "connect_timeout": {
          "type": "integer",
          "format": "int64",
          "description": "与上游服务建立连接的时间(毫秒)。默认为60000。",
          "default": 60000
        },
        "write_timeout": {
          "type": "integer",
          "format": "int64",
          "description": "将请求发送到上游服务的两个连续写操作之间的超时时间(毫秒)。默认为60000。",
          "default": 60000
        },
        "read_timeout": {
          "type": "integer",
          "format": "int64",
          "description": "将请求发送到上游服务器的两个连续读操作之间的超时时间(毫秒)。默认为60000。",
          "default": 60000
        }
      }
    },
    "ServicesList": {
      "description": "响应服务信息对象。",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "服务总条数。"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Services"
          },
          "description": "服务对象列表。"
        }
      }
    }
  },
