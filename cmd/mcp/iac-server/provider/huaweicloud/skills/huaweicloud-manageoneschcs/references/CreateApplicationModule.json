          "type": "string"
        },
        "version": {
          "description": "应用模块版本。",
          "type": "string"
        },
        "in_charger": {
          "description": "负责人,不能包含“>”和“<”字符,长度范围为0~64个字符。",
          "type": "string"
        },
        "in_charger_phone": {
          "description": "负责人电话,区号长度范围为0~10个字符,号码长度范围为0~32个字符,区号和号码可以同时为空(也可以为-)或同时不为空,但不能一个不为空、另一个为空。",
          "type": "string"
        },
        "in_charger_email": {
          "description": "负责人邮箱,长度范围为0~64个字符。",
          "type": "string"
        },
