      ],
      "properties": {
        "id": {
          "description": "QoS规格ID。",
          "type": "string"
        },
        "name": {
          "description": "QoS规格名称。",
          "type": "string"
        },
        "send_average_bandwidth": {
          "description": "发送平均带宽。参数范围:1-10000。单位:Mbit/s。",
          "type": "integer",
          "format": "int32"
        },
        "send_max_bandwidth": {
          "description": "发送峰值带宽。参数范围:send_average_bandwidth参数值-10000。单位:Mbit/s。",
