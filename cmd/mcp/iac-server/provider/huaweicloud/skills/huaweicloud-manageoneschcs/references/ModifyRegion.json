{
  "name": "ModifyRegion",
  "summary": "修改region",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/regions/{seq_id}": {
      "put": {
        "summary": "修改region",
        "description": "'根据region seq_id修改region'\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -H \"X-Auth-Token: xxxxxxx\" -d \"{'name':'cn-global-1'}\" -X PUT \"https://{endpoint}/silvan/rest/v1.0/regions/{seq_id}\"\n```",
        "x-opseverity": "Info",
        "tags": [
          "Console Home"
        ],
        "x-resource": "Region",
        "operationId": "ModifyRegion",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "有效的token(op_service权限的用户token)",
            "required": true,
            "type": "string"
          },
          {
            "name": "seq_id",
            "in": "path",
            "description": "region在数据表中生成的资源ID",
            "required": true,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "modifyRegionRequest",
            "description": "修改region,请求body中需要传的参数",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/modifyRegionRequest"
            }
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "region修改成功",
            "schema": {
              "type": "string"
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "404": {
            "description": "rest接口没找到"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "PUT https://{endpoint}/silvan/rest/v1.0/regions/10",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "name": "cn-global-1",
          "domainType": "MX",
          "type": "public"
        }
      }
    }
  },
  "definitions": {
    "modifyRegionRequest": {
      "description": "修改region的请求参数",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "region名称,由不包含“<”、“>”的字符组成,长度范围1~100",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "domainType": {
          "description": "OB属性,可为空,由不包含“<”、“>”的字符组成,长度范围0~100",
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "type": {
          "description": "type=private时,region为私有;type=public时,region为公有",
          "type": "string",
          "minLength": 0,
          "maxLength": 50
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
