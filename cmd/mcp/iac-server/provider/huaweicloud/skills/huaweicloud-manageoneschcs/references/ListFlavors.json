{
  "name": "ListFlavors",
  "summary": "查询规格列表",
  "tags": "产品管理",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/product/v3.0/flavor": {
      "get": {
        "summary": "查询规格列表",
        "description": "调用云服务的规格列表接口,返回规格列表,适用于HCS、NFVI和VMWARE场景",
        "x-opseverity": "Minor",
        "x-resource": "查询规格列表",
        "tags": [
          "产品管理"
        ],
        "operationId": "ListFlavors",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > 产品管理”章节。\n",
        "parameters": [
          {
            "name": "X-Language",
            "description": "操作发生时的语言环境,中文是zh-cn,英文是en-us。",
            "in": "header",
            "type": "string",
            "enum": [
              "zh-cn",
              "en-us"
            ]
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "运营管理员、VDC管理员、VDC只读管理员、资源空间管理员、VDC业务员、资源管理员或代维管理员有效的token,token中需要包含project信息。"
          },
          {
            "name": "region_id",
            "description": "产品所属的Region ID。",
            "in": "query",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "name": "resource_pool_id",
            "description": "resourcePoolId。",
            "in": "query",
            "default": "",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          {
            "name": "service_id",
            "description": "serviceId,HSC为nova-ext NFVI为nfviecs VMWARE为vmwareecs",
            "in": "query",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "name": "flavor_query_params",
            "description": "查询各云服务规格的具体参数,用平铺的json字符串表示。例如{\"project_id\":\"168d1b772c014cb3902e91df8abb0d81\",\"cloud_infra_id\":\"FUSION_CLOUD_cn-global-171\"}。\nflavor_query_params参数\n1. flavor_query_params通过传入的筛选参数查询规格列表。\n参数格式为:{\"start\":\"0\",\"limit\":\"10\",\"filter_vdc\":\"true\",\"name\":\"1u1g\",\"ram\":\"1024\",\"sla_label\":\"ecs:performancetype=normal\"}\n2. flavor_query_params中可支持的参数列表有filter_vdc、start、limit、vdc_level、sla_label、ext_boot_type、vcpu、ram、system_disk_size、volume_size、name。\n3. 当flavor_query_params参数中的filter_vdc为\"true\"时,接口返回所有规格的id集合。接口响应如下\n  {\n    \"flavor_ids\":[\n      \"072b7141-9c85-435f-b0ce-0bc8ed22533a\",\n      \"0f14b82f-8573-4bd0-aff0-84b4a5a912ea\",\n      \"afd68765-33c9-4b26-9e38-492c13b77b20\",\n      \"cd21d669-efde-4d1e-af7a-470e0915061e\"\n    ]\n  }",
            "in": "query",
            "required": true,
            "type": "string",
            "maxLength": 2048,
            "minLength": 0
          }
        ],
        "responses": {
          "200": {
            "description": "查询规格列表结果。",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": {
                "flavors": "[{\"flavor_id\":\"9db25a72-dda6-466e-9243-6f11e1817595\",\"flavor_name\":\"ECS_2020\",\"vcpus\":2,\"ram\":10240,\"system_disk_size\":\"\",\"ext_boot_type\":\"Volume\",\"server_type\":\"hw:numa_nodes\",\"volume_size\":null,\"sla_labels\":[{\"label_key\":\"hw:cpu_realtime\",\"label_value\":\"no\"},{\"label_key\":\"hw:cpu_model\",\"label_value\":\"\"},{\"label_key\":\"resource_type\",\"label_value\":\"<all-in-list> IOoptimized\"},{\"label_key\":\"hw:cpu_policy\",\"label_value\":\"dedicated\"},{\"label_key\":\"capabilities:cpu_info:arch\",\"label_value\":\"x86_64\"},{\"label_key\":\"trust:trusted_host\",\"label_value\":\"false\"},{\"label_key\":\"ecs:performancetype\",\"label_value\":\"normal\"},{\"label_key\":\"ecs:virtualization_env_types\",\"label_value\":\"CloudCompute\"},{\"label_key\":\"hw:mem_page_size\",\"label_value\":\"1048576\"},{\"label_key\":\"hw:cpu_mode\",\"label_value\":\"aggregate\"},{\"label_key\":\"hw:cpu_thread_policy\",\"label_value\":\"prefer\"},{\"label_key\":\"hw:numa_nodes\",\"label_value\":\"1\"}],\"ephemeral\":\"0\",\"swap\":\"\",\"cpu_shares\":null,\"cpu_limit\":null,\"cpu_reserve\":null,\"cpu_policy\":\"dedicated\",\"cpu_thread_policy\":\"prefer\",\"cpu_realtime\":\"no\",\"numa_nodes\":\"1\",\"mem_page_size\":\"1024\",\"flavor_type\":\"virtual\",\"all_visible\":true,\"custom_sla_labels\":[],\"availability_zone\":[\"KVM_AZ\"]}]",
                "total": 1,
                "vcpu_set": [
                  1
                ],
                "system_disk_size_set": [],
                "ram_set": [
                  1024
                ],
                "volume_size_set": []
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "406": {
            "description": "流控限流。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/rest/product/v3.0/flavor?region_id=cn-global-1&resource_pool_id=FUSION_CLOUD_cn-global-1&service_id=nova-ext&flavor_query_params={\"project_id\":\"xxxx\",\"cloud_infra_id\":\"xxxx\",\"start\":\"0\",\"limit\":\"10\",\"vdc_level\":\"0\"}",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {},
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
