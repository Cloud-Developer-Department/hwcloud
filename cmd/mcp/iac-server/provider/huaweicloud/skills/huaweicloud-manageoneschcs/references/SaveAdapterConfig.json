  "definitions": {
    "ApprovalAdapterConfigDTO": {
      "description": "流程对接的配置数据,以下参数的说明不做校验标准,目的是保证对接结果可用。",
      "required": [
        "name",
        "system_type",
        "ip",
        "port",
        "protocol",
        "connect_uri",
        "workflow_uri",
        "start_uri"
      ],
      "properties": {
        "name": {
          "description": "流程对接名称",
          "type": "string"
        },
        "system_type": {
          "description": "系统类型(custom定制系统/manageone云联邦)",
          "type": "string"
        },
        "ip": {
          "description": "适配服务的ip。",
          "type": "string"
        },
        "port": {
          "description": "适配服务的端口号。",
          "type": "string"
        },
        "protocol": {
          "description": "端口协议(http/https)",
          "type": "string"
        },
        "certificate": {
          "description": "认证方式(single单向认证/double双向认证/nocert无认证方式,protocol选择http时为nocert,system_type为manageone时为single)",
          "type": "string"
        },
        "certificate_type": {
          "description": "证书类型(内部属性,请求参数不使用该参数)",
          "type": "string"
        },
        "connect_uri": {
          "description": "连通性接口URL",
          "type": "string"
        },
        "workflow_uri": {
          "description": "查询流程定义接口URL",
          "type": "string"
        },
        "start_uri": {
          "description": "启动流程接口URL",
          "type": "string"
        },
        "keystore": {
          "description": "客户端证书文件名,certificate为double时必填。",
          "type": "string"
        },
        "keystore_key": {
          "description": "客户端证书密钥,有客户端证书时必填。",
          "type": "string"
        },
        "keystore_id": {
          "description": "客户端证书ID,有客户端证书时必填。",
          "type": "string"
        },
        "truststore": {
          "description": "服务端证书文件名,system_type为custom,有认证时必填。",
          "type": "string"
        },
        "truststore_key": {
          "description": "服务端证书密钥,有服务端证书时必填。",
          "type": "string"
        },
        "truststorey_id": {
          "description": "服务端证书ID,有服务端证书时必填。",
          "type": "string"
        },
        "creator_id": {
          "description": "创建者ID(内部属性,请求参数不使用该参数)",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
