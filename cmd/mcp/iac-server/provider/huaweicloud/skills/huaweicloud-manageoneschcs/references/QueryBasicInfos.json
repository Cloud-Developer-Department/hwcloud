        },
        "id": {
          "type": "string",
          "description": "用户ID。"
        },
        "domain_id": {
          "type": "string",
          "description": "用户所在domain的id。"
        },
        "name": {
          "type": "object",
          "description": "用户名"
        },
        "links": {
          "$ref": "#/definitions/links"
