{
  "name": "QueryBasicInfos",
  "summary": "查询用户详情",
  "tags": "IAM1.0",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v3/users/{user_id}": {
      "get": {
        "summary": "查询用户详情",
        "description": "该接口用于查询指定用户的详细信息。",
        "tags": [
          "IAM1.0"
        ],
        "operationId": "QueryBasicInfos",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "description": "用户ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "该字段内容填为“application/json;charset=utf8”。",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "已认证的拥有Security Administrator权限的token,或用户自身的token。",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。",
            "schema": {
              "$ref": "#/definitions/userBasicInfos"
            },
            "examples": {
              "application/json": {
                "user": {
                  "default_project_id": "263fd9",
                  "domain_id": "1789d1",
                  "enabled": true,
                  "id": "9fe1d3",
                  "links": {
                    "self": "https://example.com/identity/v3/users/9fe1d3"
                  },
                  "name": "jsmith",
                  "description": "jsmith",
                  "password_expires_at": "2016-11-06T15:32:17.000000"
                }
              }
            }
          },
          "401": {
            "description": "认证失败。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "token is not found or expired.",
                  "code": 401,
                  "title": "Unauthorized"
                }
              }
            }
          },
          "403": {
            "description": "鉴权失败。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "You are not authorized to perform the requested action: identity:xxxx",
                  "code": 403,
                  "title": "You are not authorized to perform the requested action."
                }
              }
            }
          },
          "404": {
            "description": "未找到相应的资源。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "Could not find user: 2809756f748a46e2b92d58d309f67291",
                  "code": 404,
                  "title": "Not Found"
                }
              }
            }
          },
          "500": {
            "description": "内部服务错误。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "Internal Exception",
                  "code": 500,
                  "title": "Internal Server Error"
                }
              }
            }
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/users/43cbe5e77aaf4665bbb962062dc1fc9d",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
