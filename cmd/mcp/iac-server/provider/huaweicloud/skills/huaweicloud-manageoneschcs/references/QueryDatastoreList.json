    "/rest/orchestration/v3.0/fcevs/datastores": {
      "get": {
        "summary": "查询存储列表(FusionCompute)",
        "x-resource": "云硬盘",
        "description": "查询存储列表,供弹性云服务器和云硬盘申请使用。",
        "x-filter": "ManageOne,interservice,openapi,erservice,cloudservice",
        "x-plane": "Tenant",
        "tags": [
          "VRM云服务"
        ],
        "operationId": "QueryDatastoreList",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "cloud_infra_id",
            "in": "query",
            "description": "云资源池ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "cluster_id",
            "in": "query",
            "description": "集群ID。",
            "required": false,
            "type": "string"
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > VRM云服务”章节。\n",
        "responses": {
          "200": {
            "description": "查询存储列表成功。",
