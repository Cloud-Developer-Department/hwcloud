        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "FCDatastoreRecord": {
      "description": "存储信息。",
      "properties": {
        "id": {
          "type": "string",
          "description": "存储ID。"
        },
        "name": {
          "type": "string",
          "description": "存储名称。"
        },
        "actualCapacityGB": {
          "type": "integer",
          "format": "int32",
          "description": "数据存储的实际总容量,单位:GB。数据存储为非精简配置模式时,该值和数据存储的最大可用容量相同。Console页面总容量取该值。"
        },
        "actualFreeSizeGB": {
          "type": "integer",
          "format": "int32",
          "description": "数据存储的实际可用容量,单位:GB。数据存储为非精简配置模式时,该值和数据存储的可用容量相同。Console页面可用容量取该值。"
        },
        "capacityGB": {
          "type": "integer",
          "format": "int32",
          "description": "数据存储的最大可用容量,单位:GB。"
        },
        "freeSizeGB": {
          "type": "integer",
          "format": "int32",
          "description": "数据存储的可用容量,单位:GB。"
        },
        "usedSizeGB": {
          "type": "integer",
          "format": "int32",
          "description": "数据存储的已分配容量,单位:GB。Console页面已分配容量取该值。"
        },
        "isThin": {
          "type": "boolean",
          "description": "是否支持精简配置。true:支持精简;false:不支持精简。"
        },
        "status": {
          "type": "string",
          "description": "数据存储状态:NORMAL,可用,表示存储设备已经添加为数据存储,不反映数据存储的真实物理状态;CREATING:创建中;DELETING:删除中。主机和数据存储的关联状态:CONNECTING:关联、CONNECTED:已关联、DISCONNECTING:解关联、ABNORMAL:异常、RESTORING:恢复中。"
        },
        "storageType": {
          "type": "string",
          "description": "存储类型。local,表示本地存储,(KVM未支持);san,基本共享存储(大lun), (KVM未支持);advanceSan,共享存储(小lun) (KVM未支持);DSWARE,华为分布式存储系统;NAS,表示NAS存储;LOCALPOME,表示虚拟化的本地存储;LUNPOME,表示虚拟化的共享存储(大LUN);LUN,只能用于裸设备映射的共享存储;iotailor,本地内存盘(KVM未支持)。"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "主机列表。"
        },
        "mediaType": {
          "type": "string",
          "description": "存储sla,预留字段。"
        }
      }
    },
    "FCQueryDatastoreListResp": {
      "description": "查询存储列表响应体。",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "符合条件的存储总数。"
        },
        "datastores": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FCDatastoreRecord"
          },
          "description": "存储列表。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}