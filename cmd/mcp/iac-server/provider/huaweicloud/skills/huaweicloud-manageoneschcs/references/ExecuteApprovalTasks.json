{
  "name": "ExecuteApprovalTasks",
  "summary": "批量审批任务",
  "tags": "流程审批",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/approval/v3.0/tasks/batch": {
      "put": {
        "summary": "批量审批任务",
        "description": "审批任务。\ncurl调用示例:\n```\ncurl -i -H \"Accept: application/json\" -X PUT \"https://accessip:port/rest/approval/v3.0/tasks/batch\"\n```",
        "x-precautions": "header中需要携带token, x-auth-token。",
        "x-opseverity": "Minor",
        "x-resource": "审批任务管理",
        "tags": [
          "流程审批"
        ],
        "operationId": "ExecuteApprovalTasks",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-language",
            "in": "header",
            "type": "string",
            "description": "语言类型:中文zh-cn、英文en-us。"
          },
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "当前用户的token。"
          },
          {
            "name": "request",
            "description": "审批的请求体。",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/BatchApprovalTaskRequest"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "审批成功。",
            "schema": {
              "$ref": "#/definitions/BatchApprovalTaskResponse"
            },
            "examples": {
              "application/json": {
                "batch_id": "1"
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "token鉴权失败"
          },
          "403": {
            "description": "URL鉴权。"
          },
          "404": {
            "description": "rest接口没找到。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "PUT https://{endpoint}/rest/approval/v3.0/tasks/batch",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "task_id": [
            "string"
          ],
          "action": "string",
          "task_key": "string",
          "reason": "string",
          "target_users": [
            {
              "approval_user_id": "string",
              "approval_user_name": "string",
              "vdc_id": "string",
              "vdc_name": "string"
            }
          ],
          "variables": [
            {
              "key": "string",
              "value": "string"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "ProcessSteps": {
      "description": "审批层级对象",
      "properties": {
        "approval_user_id": {
          "description": "审批节点的用户ID。最大长度36字符,由英文小写字母、数字、下划线、中划线组成。",
          "required": true,
          "type": "string"
        },
        "approval_user_name": {
          "description": "审批节点的用户名称。首位为字母或_或@或。字符,其后字符为数字或字母或_或@或。字符。长度:5到32个字符。",
          "required": true,
          "type": "string"
        },
        "vdc_id": {
          "description": "审批节点的用户对应的vdc的ID。最大长度36字符,由英文小写字母、数字、下划线、中划线组成。",
          "required": true,
          "type": "string"
        },
        "vdc_name": {
          "description": "审批节点的用户对应的vdc的名称。长度在1-64之间,只能由英文字母(不区分大小写)、数字、下划线组成,且不能以数字、\"op_\"、\"shadow_\"开头。",
          "required": true,
          "type": "string"
        }
      }
    },
    "ApprovalVariable": {
      "description": "审批字段",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "description": "审批字段名称",
          "type": "string"
        },
        "value": {
          "description": "审批字段名称",
          "type": "string"
        }
      }
    },
    "BatchApprovalTaskRequest": {
      "description": "批量审批任务请求体。",
      "required": [
        "task_id",
        "action"
      ],
      "properties": {
        "task_id": {
          "description": "任务ID。",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "action": {
          "description": "审批操作,1~36个字符。",
          "type": "string"
        },
        "task_key": {
          "description": "任务标识",
          "type": "string"
        },
        "reason": {
          "description": "审批意见。",
          "type": "string"
        },
        "target_users": {
          "description": "转派他人,最多转派给一个用户。",
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/ProcessSteps"
          }
        },
        "variables": {
          "description": "审批字段",
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/ApprovalVariable"
          }
        }
      }
    },
    "BatchApprovalTaskResponse": {
      "description": "批量审批任务响应体。",
      "properties": {
        "batch_id": {
          "description": "批量处理ID。",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}