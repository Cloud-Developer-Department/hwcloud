  "definitions": {
    "ProcessResponse": {
      "description": "审批流程数据对象。",
      "required": [
        "process_name",
        "level",
        "remark",
        "steps"
      ],
      "properties": {
        "id": {
          "description": "审批流程的ID。1~36个字符。",
          "type": "string"
        },
        "process_name": {
          "description": "审批流程的名称。1~128个字符。",
          "type": "string"
        },
        "level": {
          "description": "审批流程的审批层级,最多5级审批。-1~5之间的整数。0代表无需审批,-1代表关联了第三方审批系统的审批流程。",
          "type": "integer",
          "format": "int32"
        },
        "remark": {
          "description": "备注。1~512个字符。",
          "type": "string"
        },
        "steps": {
          "description": "审批节点及审批人数据列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProcessStepsResponse"
          }
        },
        "model_id": {
          "description": "模型ID。",
          "type": "string"
        },
        "thumbnail": {
          "description": "模型缩略图。",
          "type": "string"
        }
      }
    },
    "ProcessStepsResponse": {
      "description": "审批节点对象。",
      "required": [
        "step_id",
        "step_users"
      ],
      "properties": {
        "step_id": {
          "description": "审批节点编号。最多5级审批。1~5之间的整数。",
          "type": "integer",
          "format": "int32"
        },
        "step_users": {
          "description": "当前层级的审批用户列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProcessStepUsersResponse"
          }
        }
      }
    },
    "ProcessListResponse": {
      "description": "查询审批流程列表的返回值对象。",
      "required": [
        "total",
        "processes"
      ],
      "properties": {
        "total": {
          "description": "审批列表总数。",
          "type": "integer",
          "format": "int32"
        },
        "processes": {
          "description": "流程对象。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProcessResponse"
          }
        }
      }
    },
    "ProcessStepUsersResponse": {
      "description": "审批节点的用户对象。",
      "required": [
        "approval_user_id",
        "approval_user_name"
      ],
      "properties": {
        "approval_user_id": {
          "description": "审批节点的用户ID。",
          "type": "string"
        },
        "approval_user_name": {
          "description": "审批节点的用户名称。",
          "type": "string"
        }
      }
    }
