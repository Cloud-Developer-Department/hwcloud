{
  "name": "TokenIsUseful",
  "summary": "校验指定Token有效性",
  "tags": "IAM1.0",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v3/auth/tokens": {
      "get": {
        "summary": "校验指定Token有效性",
        "description": "该接口用于校验指定Token的有效性,如果有效则返回Token的详细信息。",
        "tags": [
          "IAM1.0"
        ],
        "operationId": "TokenIsUseful",
        "parameters": [
          {
            "name": "X-Subject-Token",
            "in": "header",
            "description": "待校验的token。该token和X-Auth-Token属于同一租户。",
            "required": true,
            "type": "string"
          },
          {
            "name": "nocatalog",
            "in": "query",
            "description": "token中不显示catalog信息。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "已认证的拥有secu_admin权限的token。",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/TokenResponse"
            },
            "description": "请求成功。",
            "examples": {
              "application/json": {
                "token": {
                  "methods": [
                    "password"
                  ],
                  "expires_at": "2015-11-09T01:42:57.527363Z",
                  "issued_at": "2015-11-09T00:42:57.527404Z",
                  "user": {
                    "domain": {
                      "id": "default",
                      "name": "Default"
                    },
                    "id": "ee4dfb6e5540447cb3741905149d9b6e",
                    "name": "admin"
                  },
                  "domain": {
                    "name": "Default",
                    "id": "default"
                  },
                  "roles": [
                    {
                      "name": "role1",
                      "id": "roleid1"
                    },
                    {
                      "name": "role2",
                      "id": "roleid2"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "认证失败。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "token is not found or expired.",
                  "code": 401,
                  "title": "Unauthorized"
                }
              }
            }
          },
          "403": {
            "description": "鉴权失败。"
          },
          "404": {
            "description": "找不到资源。",
            "schema": {
              "$ref": "#/definitions/RouteNotFoundError"
            },
            "examples": {
              "application/json": {
                "error_msg": "404 Route Not Found"
              }
            }
          },
          "500": {
            "description": "内部服务错误。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "Internal Exception",
                  "code": 500,
                  "title": "Internal Server Error"
                }
              }
            }
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/auth/tokens",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "RoleInfo": {
      "type": "object",
      "required": [
        "name",
