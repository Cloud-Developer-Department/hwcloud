        },
        "code": {
          "type": "integer",
          "description": "错误码。"
        },
        "title": {
          "type": "string",
          "description": "错误标题。"
        }
      }
    },
    "TokenInfo": {
      "type": "object",
      "description": "Token信息",
      "required": [
