        "domain"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "用户名"
        },
        "id": {
          "type": "string",
          "description": "用户ID"
        },
        "domain": {
          "$ref": "#/definitions/ResponseDomainObject"
        }
      }
    }
  },
  "version": "2.0",
