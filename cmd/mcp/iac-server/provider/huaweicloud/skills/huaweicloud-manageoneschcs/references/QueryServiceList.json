          "$ref": "#/definitions/LinkInfo"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ServiceDetail"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
