{
  "name": "QueryServiceList",
  "summary": "查询服务列表",
  "tags": "IAM1.0",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v3/services": {
      "get": {
        "summary": "查询服务列表",
        "description": "该接口用于查询服务列表。",
        "tags": [
          "IAM1.0"
        ],
        "operationId": "QueryServiceList",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "服务类型,类型的值可以是compute,ec2, identity, image, network, 或volume。",
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "该字段内容填为“application/json;charset=utf8”",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "已认证的token",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。",
            "schema": {
              "$ref": "#/definitions/ListServiceLimit"
            },
            "examples": {
              "application/json": {
                "services": [
                  {
                    "name": "compute5",
                    "links": {
                      "self": "https://iamcore_links.com/v3/services/053d21d488d1463c818132d9d08fb617"
                    },
                    "enabled": true,
                    "type": "compute",
                    "id": "053d21d488d1463c818132d9d08fb617",
                    "description": "Compute service 5"
                  }
                ],
                "links": {
                  "self": "https://iamcore_links.com/v3/services?type=compute",
                  "previous": null,
                  "next": null
                }
              }
            }
          },
          "401": {
            "description": "认证失败。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "token is not found or expired.",
                  "code": 401,
                  "title": "Unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "找不到资源。",
            "schema": {
              "$ref": "#/definitions/RouteNotFoundError"
            },
            "examples": {
              "application/json": {
                "error_msg": "404 Route Not Found"
              }
            }
          },
          "500": {
            "description": "内部服务错误。",
            "schema": {
              "$ref": "#/definitions/ErrorCode"
            },
            "examples": {
              "application/json": {
                "error": {
                  "message": "Internal Exception",
                  "code": 500,
                  "title": "Internal Server Error"
                }
              }
            }
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/services?type=compute",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "ErrorCode": {
      "type": "object",
      "description": "错误码",
      "properties": {
        "error": {
          "$ref": "#/definitions/Error"
        }
      }
    },
    "LinkInfo": {
      "type": "object",
      "description": "链接信息",
      "properties": {
        "href": {
          "type": "string",
          "description": "链接地址"
        },
        "rel": {
          "type": "string",
          "description": "链接关系"
        }
      }
    },
    "Error": {
      "description": "错误信息。",
      "properties": {
        "message": {
          "type": "string",
          "description": "错误信息。"
        },
        "code": {
          "type": "integer",
          "description": "错误码。"
        },
        "title": {
          "type": "string",
          "description": "错误标题。"
        }
      }
    },
    "ServiceDetail": {
      "type": "object",
      "description": "服务详情",
      "properties": {
        "name": {
          "type": "string",
          "description": "服务名"
        },
        "id": {
          "type": "string",
          "description": "服务ID"
        },
        "enabled": {
          "type": "boolean",
          "description": "服务是否可用"
        },
        "type": {
          "type": "string",
          "description": "服务类型"
        },
        "description": {
          "type": "string",
          "description": "服务描述"
        },
        "links": {
          "$ref": "#/definitions/LinkPath"
        }
      }
    },
    "LinkPath": {
      "type": "object",
      "description": "链接地址信息",
      "properties": {
        "self": {
          "type": "string",
          "description": "链接地址信息"
        }
      }
    },
    "RouteNotFoundError": {
      "description": "错误信息。",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误信息。"
        }
      }
    },
    "ListServiceLimit": {
      "type": "object",
      "description": "服务列表信息",
      "properties": {
