{
  "name": "ListEp",
  "summary": "查询企业项目列表",
  "tags": "VDC",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1.0/enterprise-projects": {
      "get": {
        "summary": "查询企业项目列表",
        "x-resource": "企业项目管理",
        "description": "查询企业项目列表。\n\ncurl命令调用示例:\n```\ncurl -v -H \"Content-Type:application/json\" -H \"x-auth-token: ******\" -X GET \"https://{endpoint}/v1.0/enterprise-projects\"\n```\n\n|SLA项|定义|\n|-----|-----|\n|请求成功率| >=99.9%|\n|可用性|Tier1|\n|数据一致性|最终一致,不一致时长<1分钟|\n|吞吐量|600次/分钟|\n|吞吐量|30次/秒|\n|TP50请求时延|1500ms|\n|TP99.9请求时延|3000ms|",
        "tags": [
          "VDC"
        ],
        "operationId": "ListEp",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-imports": "com.huawei.manageone.movdc.movdcservice.model.MapPlatId;com.huawei.manageone.movdc.movdcservice.model.PlatIdType",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "合法的token。"
          },
          {
            "name": "x-region-from",
            "in": "header",
            "type": "string",
            "description": "Token类型,取值regionId。Scope为project的token必须携带此参数,如cn-north-1。"
          },
          {
            "name": "name",
            "in": "query",
            "type": "string",
            "description": "企业项目名称,支持全模糊搜索。"
          },
          {
            "name": "id",
            "in": "query",
            "type": "string",
            "description": "企业项目ID,0表示搜索默认企业项目。"
          },
          {
            "name": "ids",
            "in": "query",
            "type": "string",
            "description": "企业项目ID列表,以逗号分隔,最大支持100个。"
          },
          {
            "name": "domain_id",
            "in": "query",
            "type": "string",
            "description": "租户ID,op_service 权限必须携带此参数。"
          },
          {
            "name": "vdc_id",
            "in": "query",
            "type": "string",
            "description": "VDC ID,查询指定VDC下的企业项目列表,授权时使用,仅支持具有管理企业项目的action的用户能使用该参数。"
          },
          {
            "name": "inherit",
            "in": "query",
            "type": "boolean",
            "default": false,
            "description": "是否查询下级VDC企业项目,仅针对 VDC_ID 参数生效。"
          },
          {
            "name": "project_id",
            "in": "query",
            "type": "string",
            "description": "资源空间 ID,查询指定资源空间下的企业项目列表。"
          },
          {
            "name": "type",
            "in": "query",
            "type": "string",
            "default": "prod",
            "description": "企业项目类型,取值为 prod 和 poc。当前不支持 poc 类型,默认取值 prod。"
          },
          {
            "name": "status",
            "in": "query",
            "type": "integer",
            "default": 1,
            "description": "企业项目状态,取值为1和2,1为启用状态,2为停用状态。当前不支持停用状态,默认取值1。"
          },
          {
            "name": "query_type",
            "in": "query",
            "type": "string",
            "default": "auth",
            "description": "查询类型。取值 auth、auths 和 list,默认取值 auth。auth 表示查询登录用户有权限的企业项目列表;auths 表示查询用户授权的所有企业项目列表;list 表示查询企业项目列表。"
          },
          {
            "name": "auth_action",
            "in": "query",
            "type": "string",
            "description": "获取有 action 权限的企业项目列表,多个时使用逗号分隔,最多支持10个action。仅在 query_type 取值为 auth 时生效。"
          },
          {
            "name": "contain_default",
            "in": "query",
            "type": "boolean",
            "default": true,
            "description": "是否包含默认企业项目。管理侧统计页面查询不包含。"
          },
          {
            "name": "federation",
            "in": "query",
            "type": "string",
            "description": "是否开通云联邦。"
          },
          {
            "name": "federation_system",
            "in": "query",
            "type": "string",
            "description": "开通云联邦的系统类型,支持 HWS、HCSO、CTC。"
          },
          {
            "name": "contain_not_authorize",
            "in": "query",
            "type": "boolean",
            "default": true,
            "description": "企业项目列表列表是否包含不可以变更授权的企业项目。"
          },
          {
            "name": "quota_unit_id",
            "in": "query",
            "type": "string",
            "description": "配额单元ID。"
          },
          {
            "name": "offset",
            "in": "query",
            "type": "string",
            "default": 0,
            "description": "索引位置,从offset指定的下一条数据开始查询,必须为数字,不能为负数,默认为0,最大支持1000000000。"
          },
          {
            "name": "limit",
            "in": "query",
            "type": "string",
            "default": 1000,
            "description": "查询记录数默认为1000,limit最多为1000, 最小值为1。"
          },
          {
            "name": "sort_key",
            "in": "query",
            "type": "string",
            "default": "created_at",
            "description": "排序字段,取值 created_at, updated_at 和 name,默认取值 created_at。"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "type": "string",
            "default": "desc",
            "description": "排序方向,取值 asc 和 desc, 默认取值 desc。"
          }
        ],
        "responses": {
          "201": {
            "description": "查询企业项目列表成功。",
            "schema": {
              "$ref": "#/definitions/EPListResponse"
            },
            "examples": {
              "application/json": {
                "total_count": 1,
                "enterprise_projects": [
                  {
                    "id": "6fbcf2f3-3164-4d32-9a3e-a8886dc38c24",
                    "name": "auto_test",
                    "description": "hello world!",
                    "type": "prod",
                    "delete_flag": true,
                    "status": 1,
                    "created_at": "2018-05-18T06:49:06Z",
                    "updated_at": "2018-05-28T02:21:36Z",
                    "domain_id": "domainId",
                    "vdc_id": "vdcId",
                    "project_id": "projectId",
                    "domain_name": "xxx",
                    "vdc_name": "xxx",
                    "project_name": "xxx",
                    "vdc_federation": true,
                    "eps_federations": [
                      "-1062080391",
                      "417050500"
                    ],
                    "project_federation": false,
                    "hcs_federation": false,
                    "quota_unit_type": "default",
                    "remote_status": [
                      {
                        "account_id": "xx",
                        "eps_status": true
                      }
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "接口认证失败。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "REST接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET: https://{endpoint}/v1.0/enterprise-projects?name=prise_pro",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "EPListResponseBase": {
      "allOf": [
        {
          "$ref": "#/definitions/EPResponseBase"
        },
        {
          "type": "object",
