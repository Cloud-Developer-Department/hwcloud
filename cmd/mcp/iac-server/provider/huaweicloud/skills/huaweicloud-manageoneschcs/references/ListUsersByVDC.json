                    "roles": [
                      {
                        "id": "00000000-0000-0000-0000-000000000001",
                        "name": "vdcServiceManager",
                        "display_name": "VDC Admin"
                      }
                    ],
                    "name": "fdsgdsg43453534",
                    "id": "f5cf142a99db4d8bb1628821361496d4",
                    "domain_id": "213ba5f9668147c8af871cea784022f9",
                    "domain_name": "a000001",
                    "resource_tenant_id": null,
                    "vdc_id": "jk34u9tj34t9834ut9434t34",
                    "vdc_name": "vdc_123",
                    "login_at": "2019-08-18 16:27:33.000000"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "接口认证失败。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET: https://{endpoint}",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "UserListDetails": {
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "结果总数。"
        },
        "users": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/UserListDetailBean"
          },
          "description": "用户信息。"
        }
      }
    },
    "UserListDetailBean": {
      "allOf": [
        {
          "$ref": "#/definitions/UserBase"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "用户id。"
            },
            "name": {
              "type": "string",
              "description": "用户名,长度在5-32之间,首位为字母或下划线_,不能为纯数字,且不能包含除下划线_以外的特殊字符。"
            },
            "display_name": {
              "type": "string",
              "description": "用户别名,由除\">\"和\"<\"之外的字符组成,0-128个字符。"
            },
            "create_at": {
              "type": "string",
              "description": "创建时间."
            },
            "roles": {
              "type": "array",
              "maxItems": 100,
