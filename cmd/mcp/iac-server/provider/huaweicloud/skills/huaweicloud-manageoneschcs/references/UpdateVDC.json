          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "接口认证失败。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "PUT: https://{endpoint}/rest/vdc/v3.0/vdcs/91ba27bc-6375-46a5-85b7-f836a7fc6be2",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "vdc": {
            "name": "modify_name",
            "description": "modify VDC description"
          }
        }
      }
    }
  },
  "definitions": {
    "VDCBase": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "VDC名称,长度为1-64位,只能由中文、英文字母(不区分大小写)、数字、下划线组成,且不能以数字、\"op_\"、\"shadow_\"开头。"
        },
        "description": {
          "type": "string",
          "description": "描述,长度在0-255之间,不能包含\"<\"和\">\"。"
        },
        "extra": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "扩展信息,长度为0-1024位。"
        },
        "mfa_status": {
          "type": "boolean",
          "description": "是否修改双因子认证开关,true开启,false不开启。"
        },
        "processes": {
          "$ref": "#/definitions/Processes",
          "description": "关联审批流程结构体。"
        },
        "is_domain": {
          "type": "boolean",
          "default": true,
          "description": "是否同步修改租户信息。"
        }
      }
    },
    "Processes": {
      "required": [
        "process_id",
        "status"
      ],
      "properties": {
        "process_id": {
          "type": "string",
          "description": "审批流程ID,长度为1-36个字符。"
        },
        "status": {
          "type": "string",
          "description": "关联操作,只能是add,modify,delete。"
        }
      }
    },
    "ModifyVDCBean": {
      "required": [
        "vdc"
      ],
      "properties": {
        "vdc": {
          "$ref": "#/definitions/VDCBase",
          "description": "更新VDC的数据。"
        }
      }
    }
  },
