  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/product/v3.0/products/{product_id}": {
      "put": {
        "summary": "修改产品",
        "description": "修改产品的属性,例如,名称、描述、图标等基本属性。只有草稿、未发布状态的产品才能修改。\n1. 只有草稿、未发布状态的产品才能修改;\n2. 如果产品处于草稿状态,则只有创建人才可以修改产品属性;\n3. 如果产品处于未发布状态,则同级用户就可以修改产品属性;\n4. 产品的is_default=true(即默认服务),不能修改params(规格)属性;\n5. 对于其他服务,即service_type字段是others-开头的产品,才可以修改endpoint属性;\n6. 修改产品接口可支持修改的属性字段有:\n    name、description、icon_id、params、secret_params、resource_pool_id、az_id、\n    project_id、product_type、catalog_id、custom_catalog_id、version、support_user、approval_parameter_mode、charge_user、service_vendor、endpoint\n7. 接口请求示例如下:\n{\n    \"name\": \"{\\\"zh_CN\\\":\\\"testname\\\",\\\"en_US\\\":\\\"testname\\\"}\",\n    \"description\": \"{\\\"zh_CN\\\":\\\"testdescription\\\",\\\"en_US\\\":\\\"testdescription\\\"}\",\n    \"icon_id\": \"defaulticonelb\",\n    \"params\": \"{\\\"region_id\\\":\\\"cn-global-137\\\",\\\"isHana\\\":false,\\\"availableZone\\\":{\\\"availableZoneId\\\":\\\"fsp137.type1\\\",\\\"isLocked\\\":true,\\\"azName\\\":\\\"testAzName\\\",\\\"azType\\\":\\\"KVM\\\",\\\"isArm\\\":false},\\\"is_support_disaster\\\":{\\\"isDisaster\\\":\\\"userDefine\\\",\\\"isLocked\\\":true},\\\"hostSpecType\\\":{\\\"hostSpecServiceType\\\":\\\"normal\\\",\\\"isLocked\\\":true},\\\"flavor\\\":{\\\"flavorRef\\\":\\\"072b7141-9c85-435f-b0ce-0bc8ed22533a\\\",\\\"isLocked\\\":true},\\\"root_volume\\\":{\\\"volumetype\\\":\\\"IPSAN\\\",\\\"isLocked\\\":true,\\\"volumeName\\\":\\\"IPSAN_SATA\\\"},\\\"image\\\":{\\\"imageRef\\\":\\\"8944238f-0b8c-4d7a-854b-aa09583df9a1\\\",\\\"isLocked\\\":true},\\\"cloudArea\\\":{\\\"isLocked\\\":true}}\",\n\t\"catalog_id\":\"1\",\n\t\"approval_parameter_mode\":\"param\",\n\t\"endpoint\":\"xxx\"\n}\n\n接口响应示例如下:\n{\n    \"result\": true\n}",
        "x-opseverity": "Minor",
        "x-resource": "修改产品",
        "tags": [
          "产品管理"
        ],
        "operationId": "ModifyProduct",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > 产品管理”章节。\n",
        "parameters": [
          {
            "name": "X-Language",
            "description": "操作发生时的语言环境,中文是zh-cn,英文是en-us。",
            "in": "header",
            "type": "string",
            "enum": [
              "zh-cn",
              "en-us"
            ]
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "机机账户、运营管理员或VDC管理员有效的token。"
          },
          {
            "name": "product_id",
            "description": "产品ID。",
            "in": "path",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 1
          },
          {
            "name": "product",
            "description": "待修改的产品信息对象。",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ModifyProductVO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "修改产品成功。",
            "schema": {
              "$ref": "#/definitions/CommonResultDTO"
            },
            "examples": {
              "application/json": {
                "result": true
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "406": {
            "description": "流控限流。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "PUT https://{endpoint}/rest/product/v3.0/products/b5cff842ec854e5eb40486646d2fddd6",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "name": "{\"zh_CN\":\"ecs product\",\"en_US\":\"ecs product1\"}",
          "description": "{\"zh_CN\":\"description\",\"en_US\":\"description\"}",
          "icon_id": "defaulticonelb",
          "params": "{\"a\":\"111\",\"b\":\"222\"}"
        }
      }
    }
  },
