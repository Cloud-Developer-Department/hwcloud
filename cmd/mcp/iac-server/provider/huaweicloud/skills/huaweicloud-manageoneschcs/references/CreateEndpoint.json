{
  "name": "CreateEndpoint",
  "summary": "新增endpoint",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/endpoints": {
      "post": {
        "summary": "新增endpoint",
        "description": "'向/silvan/rest新注册endpoint'\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -H \"X-Auth-Token: xxxxxxx\" \n-d \"{'active':true,'catalogId':0,'defaultOpen':false,'domainType':'vmall',\n'endpoint':'https://127.0.0.1:31943/motenantconsolehomewebsite/#/home','endpointScope':'region','id':'home',\n'locale':'zh-cn','name':'控制台首页','serviceOrder':0,'shortName':'控制台首页','version':'v1.0',\"visible\": true}\"\n-X POST \"https://{endpoint}/silvan/rest/v1.0/endpoints\"\n```",
        "tags": [
          "Console Home"
        ],
        "x-resource": "Endpoint",
        "operationId": "CreateEndpoint",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "op_service、运营管理员有效的token",
            "required": true,
            "type": "string"
          },
          {
            "name": "createEndpointRequest",
            "in": "body",
            "required": true,
            "description": "创建endpoint的请求参数",
            "schema": {
              "$ref": "#/definitions/CreateEndpointRequest"
            }
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "endpoint创建成功",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": {
                "operate": "success",
                "seqId": 1
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/silvan/rest/v1.0/endpoints",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "id": "ecm",
          "name": "Elastic Cloud Server",
          "shortName": "ECS",
          "description": "Elastic Cloud Server",
          "version": "1.0",
          "endpoint": "https://{endpoint}/ecm/#/ecs/manager/vmList",
          "serviceCss": "ecm",
          "serviceOrder": 1,
          "defaultOpen": false,
          "domainType": "BR",
          "nonsupportRegions": "",
          "regionId": "ap-sg",
          "locale": "en-us",
          "endpointScope": "region",
          "catalogId": 1,
          "visible": true
        }
      }
    }
  },
  "definitions": {
    "CreateEndpointRequest": {
      "description": "创建endpoint的请求参数",
      "required": [
        "id",
        "name",
        "shortName",
        "version",
        "catalogId",
        "endpoint",
        "locale",
        "visible"
      ],
      "properties": {
        "id": {
          "description": "endpoint id,由不带<、>的字符组成,长度范围1~255",
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "description": "endpoint名称,由不带<、>的字符组成,长度范围1~100",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "shortName": {
          "description": "服务名缩写,收藏显示的name,由不带<、>的字符组成,长度范围1~100",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "description": "api版本,暂时没用到,按常规取\"1.0\"即可,由不带<、>的字符组成,长度范围1~10",
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "serviceOrder": {
          "description": "服务在其目录中的排序",
          "type": "integer"
        },
        "catalogId": {
          "description": "服务所属大类id",
          "type": "integer"
        },
        "description": {
          "description": "服务的描述,由不包含“<”、“>”的字符组成,长度范围0~1024",
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        },
        "endpoint": {
          "description": "服务的入口地址,即在页面上点击服务endpoint时跳转的地址,需为合法的URL,长度范围0~1024",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "locale": {
          "description": "当前服务信息的国际化语言,当前支持中英文国际化,中文zh-cn,英文en-us",
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "serviceCss": {
          "description": "endpoint在页面上的服务样式,由不包含“<”、“>”的字符组成,长度范围0~100",
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "defaultOpen": {
          "description": "服务是否默认开放",
          "type": "boolean"
        },
        "domainType": {
          "description": "分销商类型,由不包含“<”、“>”的字符组成,长度范围0~100",
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "default": ""
        },
        "nonsupportRegions": {
          "description": "服务不上线的region,由不包含“<”、“>”的字符组成,长度范围0~255",
          "type": "string",
          "minLength": 0,
          "maxLength": 255
        },
        "endpointScope": {
          "description": "默认为region,global级别的服务注册为“global”",
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "regionId": {
          "description": "当前endpoint所在的region值,由不包含“<”、“>”的字符组成,长度范围0~50",
          "type": "string",
          "minLength": 0,
          "maxLength": 50,
          "default": ""
        },
        "visible": {
          "description": "endpoint对应的visible信息",
          "type": "boolean"
        },
        "customCatalogId": {
          "description": "所属自定义服务目录ID,由不包含“<”、“>”的字符组成,长度范围0~36",
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "default": ""
        },
        "deployMode": {
          "description": "部署模式,默认为空,全局endpoint为\"global\"",
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "default": ""
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}