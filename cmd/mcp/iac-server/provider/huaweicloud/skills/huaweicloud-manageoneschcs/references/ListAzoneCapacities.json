  "definitions": {
    "CapacityStatisticsResp": {
      "properties": {
        "cpuMemory": {
          "$ref": "#/definitions/AzoneStatisticsResponse",
          "description": "CPU和内存的容量信息。"
        },
        "storage": {
          "$ref": "#/definitions/AzoneVolumeResp",
          "description": "存储的容量信息。"
        },
        "vmCount": {
          "$ref": "#/definitions/AzoneVmResp",
          "description": "弹性云服务器状态统计。(Ironic类型可用分区时表示:裸金属服务器状态统计。)"
        }
      }
    },
    "AzoneStatisticsResponse": {
      "properties": {
        "cpu": {
          "$ref": "#/definitions/TypeStatisticsResp",
          "description": "CPU使用量统计。"
        },
        "memory": {
          "$ref": "#/definitions/TypeStatisticsResp",
          "description": "内存使用量统计。"
        },
        "disk": {
          "$ref": "#/definitions/TypeStatisticsResp",
          "description": "存储使用量统计。"
        }
      }
    },
    "TypeStatisticsResp": {
      "properties": {
        "collectTime": {
          "type": "string",
          "description": "资源采集周期。"
        },
        "isDataEmpty": {
          "type": "string",
          "description": "数据是否为空。"
        },
        "oversubscriptionCapacity": {
          "$ref": "#/definitions/CapacityResp",
          "description": "使用情况统计。"
        },
        "actualCapacity": {
          "$ref": "#/definitions/ActualRatio",
          "description": "超分前的实际容量信息。"
        }
      }
    },
    "AzoneVmResp": {
      "properties": {
        "vm": {
          "$ref": "#/definitions/VmStatusCountResp",
          "description": "弹性云服务器状态统计。(Ironic类型可用分区时表示:裸金属服务器状态统计。)"
        }
      }
    },
    "CapacityResp": {
      "properties": {
        "totalCapacity": {
          "$ref": "#/definitions/CapacityValueResp",
          "description": "指标总量。"
        },
        "allocatedCapacity": {
          "$ref": "#/definitions/CapacityValueResp",
          "description": "指标已使用量。"
        },
        "freeCapacity": {
          "$ref": "#/definitions/CapacityValueResp",
          "description": "指标最大可使用量。"
        }
      }
    },
    "VolumeTypeResp": {
      "properties": {
        "capacity": {
          "$ref": "#/definitions/TypeStatisticsResp",
          "description": "磁盘使用量信息。"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VolumeDimensionType"
          },
          "description": "磁盘类型。"
        }
      }
    },
    "RatioCapacity": {
      "description": "ratio信息",
      "properties": {
        "ratio": {
          "type": "number",
          "format": "float",
          "description": "容量占总容量的比例,精确到小数点后两位。"
        },
        "unit": {
          "description": "容量的统一单位。",
          "type": "string"
        },
        "capacityValue": {
          "description": "容量按照统一单位计量时的容量数值。",
          "type": "string"
        },
        "displayCapacity": {
          "description": "容量按照容量值大小自适应取对应容量单位时的含单位容量内容,例如,如果统一单位为MB,总容量为2560 MB时,此字段的值为2.50 GB。",
          "type": "string"
        }
      }
    },
    "ActualRatio": {
      "description": "actulRation容量信息",
      "properties": {
        "totalCapacity": {
          "description": "总容量。",
          "$ref": "#/definitions/TotalCapacity"
        },
        "usedCapacity": {
          "description": "已使用容量。",
          "$ref": "#/definitions/RatioCapacity"
        },
        "freeCapacity": {
          "description": "剩余容量。",
          "$ref": "#/definitions/RatioCapacity"
        }
      }
    },
    "CapacityValueResp": {
      "properties": {
        "unit": {
          "type": "string",
          "description": "指标单位。"
        },
        "capacityValue": {
          "description": "指标值。",
          "type": "string"
        }
      }
    },
    "VolumeDimensionType": {
      "properties": {
        "dimensionType": {
          "type": "string",
          "description": "维度类型。"
        },
        "dimensionValue": {
          "type": "string",
          "description": "维度值。"
        },
        "volumeTypeOriginal": {
          "type": "string",
          "description": "磁盘类型名称原始值。"
        }
      }
    },
    "AzoneVolumeResp": {
      "properties": {
        "totalCount": {
          "type": "integer",
          "format": "int32",
          "description": "磁盘类型总数量。"
        },
        "capacityList": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VolumeTypeResp"
          },
          "description": "存储的容量信息。"
        }
      }
    },
    "TotalCapacity": {
      "description": "总容量信息",
      "properties": {
        "unit": {
          "description": "容量的统一单位。",
          "type": "string"
        },
        "capacityValue": {
          "description": "容量按照统一单位计量时的容量数值。",
          "type": "string"
        },
        "displayCapacity": {
          "description": "容量按照容量值大小自适应取对应容量单位时的含单位容量内容,例如,如果统一单位为MB,总容量为2560 MB时,此字段的值为2.50 GB。",
          "type": "string"
        }
      }
    },
    "VmStatusCountResp": {
      "properties": {
        "isDataEmpty": {
          "type": "string",
          "description": "数据是否为空。"
        },
        "running": {
          "type": "integer",
          "format": "int32",
          "description": "开机数。"
        },
        "stopped": {
          "type": "integer",
          "format": "int32",
          "description": "关机数。"
        },
        "hibernated": {
          "type": "integer",
          "format": "int32",
          "description": "挂起数。"
        },
        "other": {
          "type": "integer",
          "format": "int32",
          "description": "其他数。"
        }
      }
    }
  },
