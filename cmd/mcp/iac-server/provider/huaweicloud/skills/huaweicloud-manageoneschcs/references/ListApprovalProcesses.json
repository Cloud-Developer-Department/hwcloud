          "description": "流程所属的vdc的ID。1~36个字符。",
          "type": "string"
        },
        "domain_id": {
          "description": "流程所属的domain的ID。1~36个字符。",
          "type": "string"
        },
        "user_id": {
          "description": "流程创建者ID。1~36个字符。",
          "type": "string"
        },
        "user_name": {
          "description": "流程创建者名称。1~256个字符。",
          "type": "string"
        },
        "update_by": {
          "description": "流程更新者ID。1~36个字符。",
          "type": "string"
        },
        "update_name": {
          "description": "流程更新者名称。1~256个字符。",
          "type": "string"
        },
        "category": {
          "description": "流程分类,all-通用,service-服务,application-应用,quota-配额",
          "type": "string"
        },
        "description": {
          "description": "备注。1~512个字符。",
          "type": "string"
        },
        "third_system_id": {
          "description": "关联的第三方审批系统ID。1~64个字符。",
          "type": "string"
        },
        "third_system_type": {
          "description": "关联的第三方审批系统类型。",
          "type": "string"
        },
        "third_process_id": {
          "description": "关联的第三方系统中的审批流程ID。1~64个字符。",
          "type": "string"
        },
        "create_time": {
          "description": "创建时间,utc时间年月日时分秒格式。",
          "type": "string"
        },
        "update_time": {
          "description": "更新时间,utc时间年月日时分秒格式。",
          "type": "string"
        },
        "process_type": {
          "description": "流程类型:system-固定流程;custom-自定义流程;external-外部流程",
          "type": "string"
        },
        "model_id": {
          "description": "当process_type是custom时,保存自定义模型的ID。",
