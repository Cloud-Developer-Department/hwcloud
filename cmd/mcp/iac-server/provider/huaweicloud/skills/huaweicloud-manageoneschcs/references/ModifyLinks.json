{
  "name": "ModifyLinks",
  "summary": "修改服务连接信息",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/links/{seq_id}": {
      "put": {
        "summary": "修改服务连接信息",
        "description": "修改服务连接信息\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -H \"X-Auth-Token: xxxxxxx\" -d \"{\"key\": \"message_list\",\"text\": \"消息列表\", \"iconName\": \"message\",\"href\": \"https://{endpoint}\",\"type\": \"message_center\",\"domainType\": \"TSI\" }\" -X PUT \"https://{endpoint}/silvan/rest/v1.0/links/{seqId}\"\n```",
        "tags": [
          "Console Home"
        ],
        "x-resource": "链接",
        "operationId": "ModifyLinks",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-opseverity": null,
        "parameters": [
          {
            "name": "X-Language",
            "in": "header",
            "type": "string",
            "description": "指定语言,默认为zh-cn,因seqId唯一,可以不指定该header"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "有效的token(op_service权限的用户token)"
          },
          {
            "name": "seq_id",
            "in": "path",
            "required": true,
            "type": "integer",
            "format": "int64",
            "description": "链接序列id唯一标识一个连接"
          },
          {
            "name": "link",
            "in": "body",
            "required": true,
            "description": "连接信息结构体",
            "schema": {
              "$ref": "#/definitions/LinkRequest"
            }
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "link修改成功",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": {
                "operate": "success"
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "404": {
            "description": "rest接口没找到"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "PUT https://{endpoint}/silvan/rest/v1.0/links/2",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "key": "user_center",
          "text": "text",
          "iconName": "text",
          "href": "https://{endpoint}/usercenter",
          "type": "common",
          "regionId": "ap-sg",
          "domianType": "BR"
        }
      }
    }
  },
  "definitions": {
    "LinkRequest": {
      "description": "链接请求信息",
      "required": [
        "key",
        "text",
        "href",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "链接关键字,由不包含“<”、“>”的字符组成,长度范围1~50",
          "minLength": 1,
          "maxLength": 50
        },
        "text": {
          "type": "string",
          "description": "链接内容,由不包含“<”、“>”的字符组成,长度范围1~255",
          "minLength": 1,
          "maxLength": 255
        },
        "iconName": {
          "type": "string",
          "description": "链接按钮名称,由不包含“<”、“>”的字符组成,长度范围0~255",
          "minLength": 0,
          "maxLength": 255
        },
        "href": {
          "type": "string",
          "description": "链接地址,合法的url或域名",
          "minLength": 1,
          "maxLength": 255
        },
        "type": {
          "type": "string",
          "description": "链接类型,由不包含“<”、“>”的字符组成,长度范围1~50",
          "minLength": 1,
          "maxLength": 50
        },
        "domainType": {
          "type": "string",
          "description": "OB标识,由不包含“<”、“>”的字符组成,长度范围0~100",
          "minLength": 0,
          "maxLength": 100,
          "default": ""
        },
        "regionId": {
          "description": "当前link所在的region值,由不包含“<”、“>”的字符组成,长度范围1~50",
          "type": "string",
          "minLength": 0,
          "maxLength": 50,
          "default": ""
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}