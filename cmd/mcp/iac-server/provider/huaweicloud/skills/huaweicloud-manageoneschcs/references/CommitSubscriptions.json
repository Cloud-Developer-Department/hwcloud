  "definitions": {
    "SubscriptionsReb": {
      "description": "创建订购结果。",
      "properties": {
        "purchases": {
          "description": "创建订购结果详情列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SubscriptionsRes"
          }
        },
        "expected_total": {
          "description": "订购提交全部成功时订单总数。",
          "type": "integer",
          "format": "int32"
        },
        "error_details": {
          "description": "购物车提交订购错误详情。",
          "type": "string"
        }
      }
    },
    "SubscriptionsRes": {
      "description": "单个订购资源实施结果。",
      "properties": {
        "subscription_id": {
          "description": "订单ID。",
          "type": "string"
        }
      }
    },
    "ShoppingCartReq": {
      "description": "创建订购参数。",
      "required": [
        "subscriptions",
        "operate_type",
        "project_id",
        "region_id"
      ],
      "properties": {
        "subscriptions": {
          "description": "创建订购参数详情。",
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/SubscriptionItem"
          }
        },
        "operate_type": {
          "description": "订单类型,取值范围为:apply:申请。",
          "type": "string"
        },
        "project_id": {
          "description": "资源空间ID,最大长度36。",
          "type": "string"
        },
        "region_id": {
          "description": "Region ID,最大长度36。",
          "type": "string"
        },
        "comments": {
          "description": "备注,最大长度1024。",
          "type": "string"
        },
        "contract_number": {
          "description": "订单关联的合同号。最大长度50。",
          "type": "string"
        },
        "attachment_key": {
          "description": "关联附件随机码,最大长度36",
          "type": "string"
        },
        "order_ext_params": {
          "description": "扩展参数。最大长度5120。",
          "type": "string"
        }
      }
    },
    "SubscriptionItem": {
      "description": "提交订购时产品ID和计费参数列表。",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "description": "购物车中项目的id。最大长度36",
          "type": "string"
        },
        "rate_params": {
          "description": "提交订购时的计费参数(参数已废弃)。json格式\"[{'price': 'price','params': [查询单价时的参数],'unit': {'zh_CN': '中文单位','en_US': '英文单位'}}]\",最大长度500000",
          "type": "string"
        }
      }
    }
  },
