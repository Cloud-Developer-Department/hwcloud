            "enum": [
              "zh-cn",
              "en-us"
            ]
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "系统内有效用户的token。如果是非机器账号,token中需要包含project信息。"
          },
          {
