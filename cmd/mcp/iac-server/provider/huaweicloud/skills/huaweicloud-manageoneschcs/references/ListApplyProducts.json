            "maxLength": 36,
            "minLength": 1
          },
          {
            "name": "filter_key",
            "description": "The Filter Key。产品规格params参数过滤key,具体值由params中json参数中的的key决定,例如:flavor_id、os_type、cpu等。",
            "in": "query",
            "type": "string",
            "default": "",
