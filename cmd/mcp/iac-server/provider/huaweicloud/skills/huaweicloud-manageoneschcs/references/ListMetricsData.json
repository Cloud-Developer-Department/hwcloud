      "properties": {
        "period": {
          "description": "查询周期\n1. hourly:查询开始时间和结束时间的间隔不能超过一周,且时间截取到小时。举例说明:2023-01-10 10:00:00\n2. daily:查询开始时间和结束时间的间隔不能超过一月,且时间截取到自然天。举例说明:2023-01-10 00:00:00\n3. monthly:查询开始时间和结束时间的间隔不能超过一年,且时间截取到自然月。举例说明:2023-01-01 00:00:00",
          "type": "string",
          "enum": [
            "hourly",
            "daily",
            "monthly"
          ]
        },
        "region_code": {
          "type": "string",
          "description": "区域",
          "maxLength": 128,
          "minLength": 1
        },
        "start_time": {
          "description": "开始时间,格式:yyyy-MM-dd HH:mm:ss,举例说明:2023-01-10 10:00:00",
          "type": "string"
        },
        "end_time": {
          "description": "结束时间,格式:yyyy-MM-dd HH:mm:ss,结束时间大于开始时间且满足查询周期时间间隔,举例说明:2023-01-17 10:00:00",
          "type": "string"
        },
        "domain_id": {
          "description": "租户ID,一级VDC用户可指定,查询该租户内计量数据",
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "upper_vdc_id": {
          "description": "一级VDC ID",
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "x-jsonIgnore": true
        },
        "vdc_id": {
          "description": "VDC ID,查询指定VDC计量数据,vdc_id和upper_vdc_id二选一",
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "time_zone": {
          "description": "查询时区,服务端不支持指定时区,默认返回服务端时区",
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "cloud_service_type_code": {
