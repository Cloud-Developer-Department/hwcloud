        "time_zone": {
          "description": "时区,指定时区不存在时返回服务端时区",
          "type": "string"
        },
        "start_time": {
          "description": "查询开始时间,指定时区时间,格式:yyyy-MM-dd HH:mm:ss.",
          "type": "string"
        },
        "end_time": {
          "description": "查询结束时间,指定时区时间,格式:yyyy-MM-dd HH:mm:ss",
          "type": "string"
        },
        "total": {
          "description": "当页总数",
          "type": "integer",
          "format": "int32"
        },
        "marker": {
          "type": "string",
          "description": "下一页数据标记,空:查询结束;非空:有满足条件的数据"
