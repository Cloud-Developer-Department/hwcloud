          "description": "云资源类型编码",
          "maxLength": 32,
          "minLength": 1
        },
        "locale": {
          "description": "查询语言,默认为en_US",
          "type": "string",
          "enum": [
            "zh_CN",
            "en_US"
          ]
        },
        "marker": {
          "type": "string",
