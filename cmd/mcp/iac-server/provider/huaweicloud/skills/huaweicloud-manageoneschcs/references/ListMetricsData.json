          "minLength": 1,
          "maxLength": 128
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "每页显示的条目数量,取值范围:0-1000",
          "minimum": 1,
          "maximum": 1000,
          "default": 1000
        },
        "resource_id": {
          "type": "array",
          "description": "RESOURCE ID,资源ID",
          "maxItems": 500,
          "minItems": 0,
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "type": "object"
