        },
        "update_time": {
          "type": "integer",
          "format": "int64",
          "description": "服务更新时间。"
        },
        "port": {
          "type": "integer",
          "format": "int64",
          "description": "服务对外开发的端口。"
        },
        "retries": {
          "type": "integer",
          "format": "int32",
          "description": "代理失败后重试执行的次数。默认为3并且不能大于5。",
          "default": 3
        },
        "path": {
          "type": "string",
          "description": "服务路径。"
        },
        "context_path": {
          "type": "string",
          "description": "服务UI包中发请求时,给uri添加的前缀,以“/”开头。"
