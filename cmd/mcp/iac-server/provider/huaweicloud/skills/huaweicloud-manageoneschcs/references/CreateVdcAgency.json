  "definitions": {
    "VdcAgencyDetail": {
      "description": "委托信息列表。",
      "properties": {
        "agency": {
          "description": "委托信息。",
          "$ref": "#/definitions/VdcAgency"
        }
      }
    },
    "VdcAgencyRequest": {
      "required": [
        "name",
        "domain_id",
        "trust_domain_name",
        "duration"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "委托名称,只能由英文字母(不区分大小写)、数字、中文、空格或特殊字符-_,.组成。长度范围是1到64位。"
        },
        "description": {
          "type": "string",
          "description": "委托的描述。"
        },
        "domain_id": {
          "type": "string",
          "description": "租户ID。"
        },
        "trust_domain_name": {
          "type": "string",
          "description": "被委托租户名称。"
        },
        "duration": {
          "type": "string",
          "default": "FOREVER",
          "description": "委托关系持续时间,取值范围:FOREVER,ONEDAY;默认取值 FOREVER。"
        },
        "region_id": {
          "type": "string",
          "description": "区域ID。"
        },
        "tag": {
          "type": "string",
          "description": "SM场景委托标签。"
        },
        "display_name": {
          "type": "string",
          "description": "委托显示名称。"
        }
      }
    },
    "VdcAgency": {
      "properties": {
        "id": {
          "type": "string",
          "description": "委托ID。"
        },
        "name": {
          "type": "string",
          "description": "IAM注册的委托名称。"
        },
        "domain_id": {
          "type": "string",
          "description": "当前租户的ID。"
        },
        "trust_domain_id": {
          "type": "string",
          "description": "委托租户ID。"
        },
        "trust_domain_name": {
          "type": "string",
          "description": "委托租户名称。"
        },
        "description": {
          "type": "string",
          "description": "委托描述。"
        },
        "duration": {
          "type": "string",
          "description": "委托期限,默认永久。"
        },
        "expire_time": {
          "type": "string",
          "description": "委托到期时间。"
        },
        "create_time": {
          "type": "string",
          "description": "委托创建时间。"
        }
      }
    },
    "CreateVdcAgencyRequest": {
      "required": [
        "agency"
      ],
      "description": "创建委托信息",
      "properties": {
        "agency": {
          "$ref": "#/definitions/VdcAgencyRequest",
          "description": "创建委托信息"
        }
      }
