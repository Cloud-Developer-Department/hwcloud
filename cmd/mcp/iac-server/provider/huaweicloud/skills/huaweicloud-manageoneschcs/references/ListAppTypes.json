  "definitions": {
    "ApplicationTypeList": {
      "description": "查询返回应用类型的列表",
      "properties": {
        "total": {
          "description": "应用类型总数。",
          "type": "integer",
          "format": "int32"
        },
        "actual_total": {
          "description": "租户下应用类型总数。",
          "type": "integer",
          "format": "int32"
        },
        "types": {
          "description": "应用类型。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/type"
          }
        }
      }
    },
    "type": {
      "description": "应用类型。",
      "properties": {
        "id": {
          "description": "应用类型的ID。1~36个字符。",
          "type": "string"
        },
        "name": {
          "description": "应用类型的名称。1~128个字符。",
          "type": "string"
        },
        "description": {
          "description": "应用类型的描述。1~128个字符。",
          "type": "string"
        },
        "flag": {
          "description": "应用预制类型标志。",
          "type": "boolean"
        },
        "domain_id": {
          "description": "租户id。",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
