            "description": "用户Token(运营管理员,VDC管理员,VDC业务员,只读管理员)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "name",
            "in": "query",
            "description": "应用类型名称。",
            "type": "string"
          },
          {
            "name": "type_id",
