            "description": "类型 id。",
            "type": "string"
          },
          {
            "name": "start",
            "in": "query",
            "default": 0,
            "description": "分页查询的起始位置。",
            "type": "integer"
          },
          {
            "name": "limit",
            "in": "query",
            "default": 10,
            "description": "限制每页显示的条目数量,范围1-50。",
            "type": "integer"
          }
