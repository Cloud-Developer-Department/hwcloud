  "definitions": {
    "FCVmSnapshot": {
      "description": "弹性云服务器快照。",
      "properties": {
        "id": {
          "type": "string",
          "description": "快照ID"
        },
        "name": {
          "type": "string",
          "description": "快照名称"
        },
        "type": {
          "type": "string",
