          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/FCVolSnapshot"
          },
          "description": "云硬盘快照。"
        },
        "createTime": {
          "type": "string",
          "description": "开始创建时间,UTC时间,格式如:2014-03-07 15:51:43。"
        },
        "status": {
          "type": "string",
          "description": "弹性云服务器快照状态。"
        },
        "coreNum": {
          "type": "integer",
          "format": "int32",
          "description": "弹性云服务器的总核数,范围[1,64]。"
        },
        "memorySize": {
          "type": "integer",
          "format": "int32",
          "description": "弹性云服务器内存总大小(单位:MB)。"
        },
        "volumeSizeSum": {
          "type": "integer",
          "format": "int64",
          "description": "弹性云服务器云硬盘总大小(单位:MB)。"
        },
        "childSnapshots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FCVmSnapshot"
          },
          "description": "弹性云服务器子快照。"
        },
        "includingMemorySnapshot": {
          "type": "boolean",
          "description": "是否包含内存快照。"
        }
