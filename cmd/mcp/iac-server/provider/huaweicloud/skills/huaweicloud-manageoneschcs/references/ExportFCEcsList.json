        }
      }
    }
  },
  "definitions": {
    "FCExportTaskResp": {
      "properties": {
        "export_file_path": {
          "type": "string",
          "description": "导出的文件名。"
        },
        "next_marker": {
          "type": "string",
          "description": "下次导出的起始偏移,仅对于openstack资源池场景有效。"
        }
      }
    },
    "FCExportRequest": {
      "properties": {
        "cloud_infra_id": {
          "type": "string",
          "x-allowNull": true,
          "description": "云资源池ID。"
        },
        "name": {
          "type": "string",
          "description": "弹性云服务器名称。"
        },
        "id": {
          "type": "string",
          "description": "弹性云服务器ID。"
        },
        "cluster_id": {
          "type": "string",
          "description": "集成ID。"
        },
        "ids": {
          "type": "array",
          "maxItems": 1000,
          "description": "弹性云服务器ID数组。 若是ids有值,则除了云资源池ID的其他参数都不生效。",
          "items": {
            "type": "string",
            "description": "弹性云服务器ID。"
          }
        },
        "ip": {
          "type": "string",
          "description": "IP地址。"
        },
        "status": {
          "type": "string",
          "description": "弹性云服务器状态。"
        },
        "available_zone_id": {
          "type": "string",
          "description": "可用分区ID。"
        },
        "start_page": {
          "type": "string",
          "description": "起始页。start_page、end_page的只能是同时有值和没有值,若是start_page、end_page取值null,则是导出所有的弹性云服务器信息。"
        },
        "end_page": {
          "type": "string",
          "description": "终止页。仅部分导出才下发此参数。"
        },
        "page_size": {
          "type": "string",
          "description": "页大小。 仅部分导出才下发此参数,默认值为10。"
        }
      }
    }
  },
