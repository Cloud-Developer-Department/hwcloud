    "DomainBase": {
      "properties": {
        "name": {
          "type": "string",
          "description": "租户名称,长度为1-64位,只能由中文、英文字母(不区分大小写)、数字、特殊字符(!@$^-_=+[{}]:,./?~#*;|)组成,且不能以数字、\"op_\"、\"shadow_\"开头。"
        },
        "description": {
          "type": "string",
