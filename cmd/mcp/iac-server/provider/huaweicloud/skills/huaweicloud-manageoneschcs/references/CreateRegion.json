{
  "name": "CreateRegion",
  "summary": "新增region",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/regions": {
      "post": {
        "summary": "新增region",
        "description": "'向/silvan/rest/新注册region'\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -H \"X-Auth-Token: xxxxxxx\" -d \"{'id':'cn-global-1','name':'cn-global-1'}\" -X POST \"https://{endpoint}/silvan/rest/v1.0/regions\"\n```",
        "tags": [
          "Console Home"
        ],
        "x-resource": "Region",
        "operationId": "CreateRegion",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Language",
            "in": "header",
            "description": "指定语言,英文为en-us,中文为zh-cn,默认为zh-cn",
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "有效的token(op_service权限的用户token)",
            "required": true,
            "type": "string"
          },
          {
            "name": "createRegionRequest",
            "in": "body",
            "required": true,
            "description": "创建region的请求参数",
            "schema": {
              "$ref": "#/definitions/createRegionRequest"
            }
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "region创建成功",
            "schema": {
              "type": "string"
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/silvan/rest/v1.0/regions",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "id": "cn-global-1",
          "name": "cn-global-1"
        }
      }
    }
  },
  "definitions": {
    "createRegionRequest": {
      "description": "创建region的请求参数",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "description": "region id,由不包含“<”、“>”的字符组成,长度范围1~50",
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "name": {
          "description": "region名称,由不包含“<”、“>”的字符组成,长度范围1~100",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "locale": {
          "description": "region对应的语言信息,中文为'zh-cn',英文为'en-us',不传locale参数时从header中获取,如果都没有,默认为’zh-cn'",
          "type": "string",
          "minLength": 0,
          "maxLength": 10
        },
        "domainType": {
          "description": "OB属性,可为空,由不包含“<”、“>”的字符组成,长度范围0~100",
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "default": ""
        },
        "type": {
          "description": "type=private时,region为私有;type=public时,region为公有",
          "type": "string",
          "minLength": 0,
          "maxLength": 50
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}