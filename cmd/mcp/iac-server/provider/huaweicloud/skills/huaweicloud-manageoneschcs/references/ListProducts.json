  "paths": {
    "/rest/product/v3.0/products": {
      "get": {
        "summary": "查询产品列表",
        "description": "查询产品列表,不同角色查看到不同的产品列表。\n1. 根据参数查询指定的服务。\n2. 处于草稿状态的服务只有创建人才能查看;\n3. 运营管理员创建并发布全部可见的服务,所有用户都能查看;\n4. 运营管理员创建并发布部分可见的服务,只有运营管理员以及可见范围内的租户可见;\n5. 租户侧创建并发布全部可见的服务,只有该租户侧所有用户能查看;\n6. 租户侧创建并发布部分可见的服务,只有该租户侧可见范围内的用户能查看",
        "x-opseverity": "Minor",
        "x-resource": "查询产品列表",
        "tags": [
          "产品管理"
        ],
        "operationId": "ListProducts",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > 产品管理”章节。\n",
        "parameters": [
          {
            "name": "X-Language",
            "description": "操作发生时的语言环境,中文是zh-cn,英文是en-us。",
            "in": "header",
            "type": "string",
            "enum": [
              "zh-cn",
              "en-us"
            ]
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "运营管理员或VDC管理员有效的token。"
          },
          {
            "name": "status",
            "description": "状态:草稿(draft)、未发布(unpublish)、发布(publish)、上线(online)、下线(offline)。",
            "in": "query",
            "type": "string",
            "maxLength": 32,
            "minLength": 0
          },
          {
            "name": "region_id",
            "description": "产品所属的regionId。",
            "in": "query",
            "type": "string",
            "maxLength": 10240,
            "minLength": 0
          },
          {
            "name": "service_type",
