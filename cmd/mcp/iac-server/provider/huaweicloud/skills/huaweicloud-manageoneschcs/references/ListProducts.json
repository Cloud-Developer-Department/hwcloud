            "type": "string",
            "maxLength": 1024,
            "minLength": 0
          },
          {
            "name": "name",
            "description": "产品名称。",
            "in": "query",
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          {
            "name": "project_id",
            "description": "The Project ID。",
            "in": "query",
            "type": "string",
            "default": "",
            "maxLength": 128,
            "minLength": 0
          },
          {
            "name": "catalog_id",
            "description": "目录ID。",
            "in": "query",
            "type": "string",
            "maxLength": 36,
            "minLength": 0
          },
          {
            "name": "limit",
            "description": "页数。兼容老版本limit范围0~1000,但是limit过大时存在性能问题, 建议limit使用100。",
            "in": "query",
            "required": true,
            "type": "string",
            "maxLength": 4,
            "minLength": 1
          },
          {
            "name": "start",
            "description": "页码。范围1~1000",
            "in": "query",
            "required": true,
            "type": "string",
            "maxLength": 4,
            "minLength": 1
          },
          {
