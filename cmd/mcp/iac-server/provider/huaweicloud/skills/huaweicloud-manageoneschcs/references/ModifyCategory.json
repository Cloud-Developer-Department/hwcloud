  "definitions": {
    "CategoryRequest": {
      "description": "产品目录请求信息",
      "required": [
        "id",
        "name",
        "order",
        "css",
        "locale"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32",
          "description": "产品目录Id"
        },
        "name": {
          "type": "string",
          "description": "产品目录名称,由不带<、>、'、 \"的字符组成,长度范围1~100",
          "minLength": 1,
          "maxLength": 100
        },
        "order": {
          "description": "产品目录顺序",
          "type": "integer",
          "format": "int32"
        },
        "css": {
          "type": "string",
          "description": "产品目录css,由不带<、>、'、 \"的字符组成,长度范围1~100",
          "minLength": 1,
          "maxLength": 100
        },
        "locale": {
          "type": "string",
          "description": "产品目录国际化语言,中文为“zh-cn”,英文为“en-us”",
          "minLength": 1,
          "maxLength": 10
        }
      }
    }
  },
