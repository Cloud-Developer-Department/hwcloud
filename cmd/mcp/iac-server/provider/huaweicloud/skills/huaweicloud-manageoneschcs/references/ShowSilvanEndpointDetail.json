{
  "name": "ShowSilvanEndpointDetail",
  "summary": "查询endpoint详情",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/endpoints/{seq_id}": {
      "get": {
        "summary": "查询endpoint详情",
        "description": "'根据endpoint seq_id获取endpoint详情'\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -X GET \"https://{endpoint}/silvan/rest/v1.0/endpoints/{seq_id}\"\n```",
        "x-opseverity": "Info",
        "tags": [
          "Console Home"
        ],
        "x-resource": "Endpoint",
        "operationId": "ShowSilvanEndpointDetail",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-auth-mode": "None",
        "parameters": [
          {
            "name": "seq_id",
            "in": "path",
            "required": true,
            "description": "需要查询的endpoint的seq_id",
            "type": "integer",
            "format": "int64"
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
