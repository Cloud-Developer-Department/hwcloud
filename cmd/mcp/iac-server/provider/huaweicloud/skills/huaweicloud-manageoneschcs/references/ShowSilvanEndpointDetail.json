          "200": {
            "description": "成功查询到endpoint详情信息",
            "schema": {
              "$ref": "#/definitions/QueryEndpointResponse"
            },
            "examples": {
              "application/json": {
                "seq_id": 244,
                "id": "ecm",
                "name": "Elastic Cloud Server",
                "shortName": "ECS",
                "created": "2016-05-31 16:01:11",
                "lastModified": "2016-05-31 16:01:11",
                "version": "1.0",
                "catalog": "Compute",
                "description": "Elastic Cloud Server",
                "endpoint": "https://{endpoint}/ecm/#/ecs/manager/vmList",
                "active": true,
                "serviceCss": "ecm",
                "defaultOpen": false,
                "catalogOrder": 1,
                "serviceOrder": 1,
                "catalogId": 1,
                "locale": "en-us",
                "domainType": "BR",
                "regionId": "ap-sg",
                "visible": true,
                "links": [
                  {
                    "seqId": 71,
                    "key": "ecm",
                    "text": "buy",
                    "href": "https://{endpoint}/ecm/#/ecs/createVm",
                    "type": "endpoint",
                    "domainType": "BR"
                  },
                  {
                    "seqId": 74,
                    "key": "ecm",
                    "text": "detail",
                    "href": "https://{endpoint}/ecm/#/ecs/manager/vmList",
                    "type": "endpoint",
                    "domainType": "BR"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "404": {
            "description": "rest接口没找到"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/silvan/rest/v1.0/endpoints/10",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "QueryEndpointResponse": {
      "description": "单个endpoint对象信息",
      "properties": {
        "seqId": {
          "description": "endpoint记录在数据库中的序号,服务注册endpoint后,silvan会自动给该endpoint分配一个序号",
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "description": "服务id,也叫serviceId,endpointId,通常为服务缩写的小写形式",
          "type": "string"
        },
        "name": {
          "description": "服务名,通常为服务全称",
          "type": "string"
        },
        "shortName": {
          "description": "服务名缩写,收藏显示的name",
          "type": "string"
        },
        "created": {
          "description": "endpoint注册时间",
          "type": "string"
        },
        "lastModified": {
          "description": "endpoint最近修改时间",
          "type": "string"
        },
        "version": {
          "description": "api版本,暂时没用到,按常规取\"1.0\"即可",
          "type": "string"
        },
        "description": {
          "description": "服务的描述",
          "type": "string"
        },
        "endpoint": {
          "description": "服务的入口地址,即在页面上点击服务endpoint时跳转的地址",
          "type": "string"
        },
        "active": {
          "description": "endpoint是否激活",
          "type": "boolean"
        },
        "serviceCss": {
          "description": "endpoint在页面上的服务样式",
          "type": "string"
        },
        "defaultOpen": {
          "description": "服务是否默认对租户开放,是填true,默认开放的服务不显示购买图标和实例数,否填false",
          "type": "boolean"
        },
        "serviceOrder": {
          "description": "服务在其目录中的排序",
          "type": "integer",
          "format": "int32"
        },
        "domainType": {
          "description": "分销商类型",
          "type": "string"
        },
        "regionId": {
          "description": "当前endpoint所在的region值",
          "type": "string"
        },
        "nonsupportRegion": {
          "description": "服务不上线的region",
          "type": "string"
        },
        "catalog": {
          "description": "服务所属大类名称",
          "type": "string"
        },
        "catalogOrder": {
          "description": "服务所属大类的序号",
          "type": "integer"
        },
        "catalogCss": {
          "description": "服务大类样式",
          "type": "string"
        },
        "endpointScope": {
          "description": "默认为region global 级别的服务注册为“global”",
          "type": "string"
        },
        "links": {
          "description": "endpoint对应的link信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Link"
          }
        },
        "visible": {
          "description": "endpoint对应的visible信息",
          "type": "boolean",
          "default": true
        },
        "locale": {
          "description": "endpoint对应的locale信息",
          "type": "string"
        },
        "customCatalogId": {
          "description": "所属自定义服务目录ID",
          "type": "string",
          "minLength": 0,
          "maxLength": 50,
          "default": ""
        },
        "deployMode": {
          "description": "部署模式",
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "default": ""
        }
      }
    },
    "Link": {
      "description": "链接信息",
      "properties": {
        "seqId": {
          "type": "integer",
          "format": "int64",
          "description": "记录在数据库中的序号,注册后,silvan会自动分配一个唯一的序号"
        },
        "key": {
          "type": "string",
          "description": "链接关键字"
        },
        "text": {
          "type": "string",
          "description": "链接内容"
        },
        "iconName": {
          "type": "string",
          "description": "链接按钮名称"
        },
        "href": {
          "type": "string",
          "description": "链接地址"
        },
        "type": {
          "type": "string",
          "description": "链接类型"
        },
        "domainType": {
          "type": "string",
          "description": "OB标识"
        },
        "regionId": {
          "type": "string",
          "description": "当前link所在的region值"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
