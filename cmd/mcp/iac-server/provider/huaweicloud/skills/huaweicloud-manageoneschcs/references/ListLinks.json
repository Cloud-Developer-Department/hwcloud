{
  "name": "ListLinks",
  "summary": "查询已经注册的服务链接信息",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/links": {
      "get": {
        "summary": "查询已经注册的服务链接信息",
        "description": "查询已经注册的服务链接信息\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -H \"X-Auth-Token: xxxxxxx\" -X GET \"https://{endpoint}/silvan/rest/v1.0/links\"\n```",
        "tags": [
          "Console Home"
        ],
        "x-resource": "链接",
        "operationId": "ListLinks",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-auth-mode": "None",
        "x-opseverity": "Minor",
        "parameters": [
          {
            "name": "X-Language",
            "in": "header",
            "type": "string",
            "description": "指定语言,默认为zh-cn"
          },
          {
            "name": "Frame-Domain-Type",
            "in": "header",
            "type": "string",
            "description": "OB信息,可为空,添该header时,按OB查询,不建议添加该header"
          },
          {
            "name": "key",
            "in": "query",
            "type": "string",
            "description": "链接关键字"
          },
          {
            "name": "type",
            "in": "query",
            "type": "string",
            "description": "链接类型"
          },
          {
            "name": "region",
            "type": "string",
            "in": "query",
            "description": "查询当前region下的link"
          },
          {
            "name": "mode",
            "type": "string",
            "in": "query",
            "description": "当添加条件mode=all时,查询全量links,否则进行去重"
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "链接列表",
            "schema": {
              "$ref": "#/definitions/LinksList"
            },
            "examples": {
              "application/json": {
                "total": 2,
                "links": [
                  {
                    "seqId": "1454754124512",
                    "key": "message_list",
                    "text": "Message List",
                    "iconName": "message",
                    "href": "https://{endpoint}",
                    "type": "message_center",
                    "regionId": "ap-sg",
                    "domainType": "TSI"
                  },
                  {
                    "seqId": "4671751145141",
                    "key": "user_center",
                    "text": "text",
                    "iconName": "text",
                    "href": "https://{endpoint}/usercenter",
                    "type": "common",
                    "regionId": "ap-sg",
                    "domainType": "BR"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/silvan/rest/v1.0/links",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "Link": {
      "description": "链接信息",
      "properties": {
        "seqId": {
          "type": "integer",
          "format": "int64",
          "description": "记录在数据库中的序号,注册后,silvan会自动分配一个唯一的序号"
        },
        "key": {
          "type": "string",
          "description": "链接关键字"
        },
        "text": {
          "type": "string",
          "description": "链接内容"
        },
        "iconName": {
          "type": "string",
          "description": "链接按钮名称"
        },
        "href": {
          "type": "string",
          "description": "链接地址"
        },
        "type": {
          "type": "string",
          "description": "链接类型"
        },
        "domainType": {
          "type": "string",
          "description": "OB标识"
        },
        "regionId": {
          "type": "string",
          "description": "当前link所在的region值"
        }
      }
    },
    "LinksList": {
      "description": "链接信息列表",
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Link"
          },
          "description": "链接列表"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "链接总数"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
