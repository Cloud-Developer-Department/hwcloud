                  "vdc_name": "vdcxxx",
                  "ldap_id": null,
                  "create_at": 1621327410000,
                  "login_at": 0,
                  "auth_type": "0",
                  "group_count": null,
                  "user_type": "tenant",
                  "tag": "all",
                  "preseted": false,
                  "access_mode": "0"
                }
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "接口认证失败。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
