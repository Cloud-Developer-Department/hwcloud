        },
        "top_vdc_id": {
          "type": "string",
          "description": "一级VDC id,只能包含小写字母、数字、中划线,长度在1-36之间。\nFirst-level VDC ID,A string of 1 to 36 characters that contain lowercase letters, digits, and hyphens (-)."
        },
        "certificate_info": {
          "description": "用户Ukey证书信息。",
          "$ref": "#/definitions/CertificateInfo"
        },
        "projects": {
