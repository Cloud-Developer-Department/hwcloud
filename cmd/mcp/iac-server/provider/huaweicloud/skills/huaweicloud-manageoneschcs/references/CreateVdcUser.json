  "definitions": {
    "CreateVdcUserModel": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "用户名,只能由英文字母(不区分大小写)、数字和特殊字符@._-\\组成,不能以op_svc、paas_op或\\开头,且不能以\\结尾,且不能命名为admin,power_user或guest。长度范围是4到32位,第三方用户 LDAP 类型为 AD 时,协议约束用户名长度不能超过20。"
        },
        "display_name": {
          "type": "string",
          "description": "用户别名,由除\">\"和\"<\"之外的字符组成,0-128个字符。"
        },
        "password": {
          "type": "string",
          "format": "password",
          "description": "密码,包含以下四种字符的三种: 大写字母、小写字母、数字、特殊字符(除<和>字符),且必须包含特殊字符,不能包含名字正序或逆序。长度:8到32个字符;不输入密码时,需要输入邮箱。"
        },
        "enabled": {
          "type": "boolean",
          "description": "用户状态,枚举值:true和false,默认为true。为false时,表示用户处于停用状态。",
          "default": "true"
        },
        "description": {
          "type": "string",
          "description": "说明,不能包含<或者>字符。长度:0到255个字符。"
        },
        "access_mode": {
          "type": "string",
          "default": 0,
          "description": "访问方式,取值0、1、2, 分别表示控制台访问或编程访问、控制台访问、编程访问。"
        },
        "email": {
          "type": "string",
          "description": "邮箱,符合邮箱格式,长度:0到64个字符。"
        },
        "areacode": {
          "type": "string",
          "description": "国际区号,只能为数字,长度:0到10个字符。"
        },
        "phone": {
          "type": "string",
          "description": "手机号,只能为数字,长度:0到32个字符。中国手机号长度为11个字符。"
        },
        "auth_type": {
          "type": "string",
          "description": "用户类型。枚举值:'0','1','2','4','5','6',默认值为'0'。为'0'表示本地认证,为'1'表示SAML认证,为'2'表示LDAP认证,为'4'表示机机用户,为'5'表示CAS认证,为'6'表示OAuth认证。",
          "default": "0"
        },
        "ldap_id": {
          "type": "string",
          "description": "ldap ID。"
        },
        "source": {
          "type": "string",
          "description": "区分用户的来源,枚举值:AUTH、IAM或SC,默认是SC。",
          "default": "SC"
        },
        "preseted": {
          "type": "boolean",
          "description": "是否是预置预置,枚举:true或false,默认是false,为true表示预置用户。",
          "default": false
        },
        "is_encrypt": {
          "type": "boolean",
          "description": "是否加密密码,枚举:true或false,默认是false,为true表示加密密码。",
          "default": false
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/TagModal"
          },
          "description": "绑定的标签信息"
        }
      }
    },
    "UserTrustedAgencyDomainModel": {
      "properties": {
        "agency_id": {
          "type": "string",
          "description": "委托ID。"
        },
        "domain_id": {
          "type": "string",
          "description": "租户ID。"
        },
        "domain_name": {
          "type": "string",
          "description": "租户名称。"
        },
        "agency_name": {
          "type": "string",
          "description": "委托名称。"
        }
      }
    },
    "CreateVdcUserRequest": {
      "required": [
        "user"
      ],
      "properties": {
        "user": {
          "$ref": "#/definitions/CreateVdcUserModel",
          "description": "用户信息。"
        }
      }
    },
