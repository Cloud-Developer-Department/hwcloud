{
  "name": "ListCatalogs",
  "summary": "查询服务分类信息",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/catalogs": {
      "get": {
        "summary": "查询服务分类信息",
        "description": "查询已经注册的服务分类信息\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -X GET \"https://{endpoint}/silvan/rest/v1.0/catalogs\"\n```",
        "tags": [
          "Console Home"
        ],
        "x-resource": "服务目录",
        "operationId": "ListCatalogs",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-auth-mode": "None",
        "x-opseverity": "Minor",
        "parameters": [
          {
            "name": "X-Language",
            "in": "header",
            "type": "string",
            "description": "按语言查询服务分类信息,无此参数则查询所有语言的服务分类信息,中文zh-cn英文en-us"
          },
          {
            "name": "id",
            "in": "query",
            "type": "integer",
            "format": "int32",
            "description": "服务分类Id可选,无此参数则查询所有服务分类"
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "服务分类列表",
            "schema": {
              "$ref": "#/definitions/CatalogsList"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "catalogs": [
                  {
                    "seqId": 4671751145141,
                    "id": 3,
                    "name": "Network",
                    "order": 1,
                    "css": "Network",
                    "locale": "en-us"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "404": {
            "description": "rest接口没找到"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/silvan/rest/v1.0/catalogs",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "Catalog": {
      "description": "服务分类信息",
      "properties": {
        "seqId": {
          "type": "integer",
          "format": "int64",
          "description": "记录在数据库中的序号,注册后,silvan会自动分配一个唯一的序号"
        },
        "id": {
          "type": "integer",
          "format": "int32",
          "description": "服务分类Id"
        },
        "name": {
          "type": "string",
          "description": "服务分类名称"
        },
        "order": {
          "type": "integer",
          "format": "int32",
          "description": "服务分类顺序"
        },
        "css": {
          "type": "string",
          "description": "服务分类css"
        },
        "locale": {
          "type": "string",
          "description": "服务分类语言"
        }
      }
    },
    "CatalogsList": {
      "description": "服务分类列表",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "分类服务总数"
        },
        "catalogs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Catalog"
          },
          "description": "服务分类列表"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}