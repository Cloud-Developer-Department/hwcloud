  "definitions": {
    "ProductIconDTO": {
      "description": "图标的返回值对象。",
      "required": [
        "id",
        "create_vdc_id",
        "type",
        "file_name"
      ],
      "properties": {
        "id": {
          "description": "图标ID。",
          "type": "string",
          "maxLength": 32,
          "minLength": 1
        },
        "create_vdc_id": {
          "description": "创建图标的所属VDC ID。",
          "type": "string",
          "maxLength": 36,
          "minLength": 1
        },
        "type": {
          "description": "图标所属的类型。",
          "type": "string",
          "maxLength": 36,
          "minLength": 1
        },
        "file_name": {
          "description": "图标文件名称。",
          "type": "string",
          "maxLength": 36,
          "minLength": 1
        }
      }
    },
    "IconListResultDTO": {
      "description": "查询图标列表的返回值对象。",
      "required": [
        "total",
        "icons"
      ],
      "properties": {
        "total": {
          "description": "图标总数。",
          "type": "integer",
          "format": "int32"
        },
        "icons": {
          "description": "图标具体对象。",
          "type": "array",
          "items": {
