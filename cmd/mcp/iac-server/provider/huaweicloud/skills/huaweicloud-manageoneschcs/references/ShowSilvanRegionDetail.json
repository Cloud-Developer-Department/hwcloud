                "seqId": 10,
                "id": "cn-suzhou-1",
                "name": "CN Suzhou 1",
                "created": "2016-02-03 21:26:27",
                "lastModified": "2016-02-03 21:26:27",
                "locale": "en-us",
                "active": true,
                "domainType": "MX",
                "type": "public"
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/silvan/rest/v1.0/regions/10",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "QueryRegionResponse": {
      "description": "查询region返回的单个对象信息",
      "properties": {
        "seqId": {
          "description": "region记录在数据库中的Id",
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "description": "region的id信息",
          "type": "string"
        },
        "name": {
          "description": "region的name信息",
          "type": "string"
        },
        "created": {
          "description": "region的创建时间",
          "type": "string"
        },
        "lastModified": {
          "description": "region最后一次修改时间",
          "type": "string"
        },
        "locale": {
          "description": "region的语言信息,en-us为英文,zh-cn为中文,locale不传时从header获取X-Language",
          "type": "string"
        },
        "active": {
          "description": "region是否激活",
          "type": "boolean"
        },
        "domainType": {
          "description": "regionOB信息",
          "type": "string"
        },
        "type": {
          "description": "region类型,type=private时,region为私有;type=public时,region为公有",
          "type": "string"
        },
        "deployType": {
          "description": "多云合一场景下该region属于中心云或非中心云。中心云(center)、非中心云(slave)",
          "type": "string"
        },
        "authUrl": {
          "description": "多云合一场景下从接入管理查询跳转的authUrl",
          "type": "string"
        },
        "iamId": {
          "description": "多IAM场景下表示当前region所属的IAM信息",
          "type": "string"
        },
        "globalId": {
          "description": "对端的region Id",
          "type": "string"
        }
      }
    }
  },
