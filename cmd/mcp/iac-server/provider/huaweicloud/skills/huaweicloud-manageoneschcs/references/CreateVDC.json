                    "available_zones": [
                      {
                        "az_id": "fsp137.type1",
                        "quotas": [
                          {
                            "service_id": "ecs",
                            "action": "bind",
                            "resources": [
                              {
                                "resource": "cores",
                                "local_limit": 1000,
                                "other_limit": 500
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ],
            "all_quotas": "0",
            "cloud_federation_rate": "99.99"
          }
