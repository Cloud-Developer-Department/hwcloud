          },
          "401": {
            "description": "接口认证失败。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST: https://{endpoint}/rest/vdc/v3.0/vdcs",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "vdc": {
            "upper_vdc_id": "0",
            "name": "vdc-test-1",
            "description": "create VDC BY V3.0",
