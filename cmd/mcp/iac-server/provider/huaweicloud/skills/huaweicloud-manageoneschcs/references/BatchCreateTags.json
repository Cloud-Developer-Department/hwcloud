  "definitions": {
    "CreateTagRequest": {
      "description": "创建标签请求体。",
      "required": [
        "action",
        "tags"
      ],
      "properties": {
        "action": {
          "description": "标签的执行动作,有创建或删除,创建:create,删除:delete。",
          "type": "string"
        },
