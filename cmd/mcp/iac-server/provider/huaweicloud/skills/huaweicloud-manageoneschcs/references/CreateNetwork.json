  "definitions": {
    "CreateFCNetworkTaskResp": {
      "description": "创建网络接口响应体。",
      "properties": {
        "urn": {
          "description": "内部网络标识。",
          "type": "string"
        },
        "uri": {
          "description": "内部网络对应的URI地址。",
          "type": "string"
        }
      }
    },
    "CreateFCNetworkReq": {
      "required": [
        "cloud_infra_id",
        "vpc_id",
        "name",
        "vlan",
        "dvs_urn"
      ],
      "description": "内部网络信息。",
      "properties": {
        "cloud_infra_id": {
          "description": "云资源池ID。",
          "type": "string"
        },
        "vpc_id": {
          "description": "VPC ID。",
          "type": "string"
        },
        "name": {
          "description": "网络名称。由中文字符、字母字符、数字、中划线及下划线组成,长度范围是1-64个字符。",
          "type": "string"
        },
        "vlan": {
          "description": "VLAN ID。",
          "type": "integer"
        },
        "dvs_urn": {
          "description": "关联的DVS标识。",
          "type": "string"
        },
        "description": {
          "description": "网络描述。长度范围0-1024个字符。不能包含<和>。",
          "type": "string"
        },
        "qos_id": {
          "description": "关联的Qos ID。",
          "type": "string"
        },
        "ipv4_primary_dns": {
          "description": "IPv4协议的首选DNS服务器地址。",
          "type": "string"
        },
        "ipv4_second_dns": {
          "description": "IPv4协议的备选DNS服务器地址。",
          "type": "string"
        },
        "ipv6_primary_dns": {
          "description": "IPv6协议的首选DNS服务器地址。",
          "type": "string"
        },
        "ipv6_second_dns": {
          "description": "IPv6协议的备选DNS服务器地址。",
          "type": "string"
        },
        "ipv4_subnet": {
          "description": "IPv4子网信息。",
          "$ref": "#/definitions/Subnet4CreatingFCNetwork"
        },
        "ipv6_subnet": {
          "description": "IPv6子网信息。",
          "$ref": "#/definitions/Subnet4CreatingFCNetwork"
        }
      }
    },
    "Subnet4CreatingFCNetwork": {
      "required": [
        "ip_allocation_policy",
        "cidr"
      ],
      "properties": {
        "ip_allocation_policy": {
          "description": "IP地址分配方式:1表示静态注入,2表示手动。",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true
        },
        "cidr": {
          "description": "子网/掩码。",
          "type": "string"
        },
        "gateway_ip": {
          "description": "网关。",
          "type": "string"
        },
        "allocation_pools": {
          "description": "IP地址池。",
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/AllocationPool4FCNetwork"
          }
        }
      }
    },
    "AllocationPool4FCNetwork": {
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "description": "起始IP地址。",
          "type": "string"
        },
        "end": {
          "description": "结束IP地址。",
          "type": "string"
        }
      }
    }
  },
