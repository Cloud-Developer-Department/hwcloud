{
  "name": "ListUriMapping",
  "summary": "查询uri-mapping信息列表",
  "tags": "Console Home",
  "productshort": "ManageOneSCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/silvan/rest/v1.0/uri-mapping": {
      "get": {
        "summary": "查询uri-mapping信息列表",
        "description": "查询uri-mapping信息列表\n\ncurl调用示例:\n```\ncurl -i -H \"Content-Type: application/json\" -H \"Accept: application/json\" -X GET \"https://{endpoint}/silvan/rest/v1.0/uri-mapping\"\n```",
        "tags": [
          "Console Home"
        ],
        "x-resource": "Uri-Mapping",
        "operationId": "ListUriMapping",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-auth-mode": "None",
        "x-opseverity": "Minor",
        "parameters": [
          {
            "name": "X-Language",
            "in": "header",
            "description": "指定语言,英文为en-us,中文为zh-cn。",
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "有效的token"
          },
          {
            "name": "page",
            "type": "integer",
            "format": "int32",
            "default": 1,
            "minimum": 1,
            "maximum": 999,
            "in": "query",
            "description": "分页查询的页数,1-999。"
          },
          {
            "name": "size",
            "type": "integer",
            "format": "int32",
            "default": 0,
            "in": "query",
            "minimum": 0,
            "maximum": 99,
            "description": "分页查询时每页数据条数,0-99,为0时默认查全量"
          },
          {
            "name": "service",
            "type": "string",
            "in": "query",
            "description": "按照源服务名查询。由单个*或字母字符、数字、“_”和“-”组成,长度范围是1~255个字符。"
          },
          {
            "name": "target_service",
            "type": "string",
            "in": "query",
            "description": "按照目标服务名查询,由单个*或字母字符、数字、“_”和“-”组成,长度范围是1~255个字符。"
          },
          {
            "name": "method",
            "type": "string",
            "in": "query",
            "description": "按照方法查询,由不包含”<“、”>“的字符组成,长度范围1~50。"
          },
          {
            "name": "uri",
            "type": "string",
            "in": "query",
            "description": "源地址,不带“<”或“>”的字符组成,长度范围是1~512个字符。"
          },
          {
            "name": "region_id",
            "type": "string",
            "in": "query",
            "description": "所属区域",
            "default": ""
          },
          {
            "name": "is_region_empty",
            "type": "string",
            "in": "query",
            "description": "是否查询regionId为空的数据",
            "default": "false"
          }
        ],
        "x-precautions": "1.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > Console Home”章节。\n",
        "responses": {
          "200": {
            "description": "uri-mapping信息列表。",
            "schema": {
              "$ref": "#/definitions/UriMappingResponse"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "UriMappings": [
                  {
                    "id": "e5c9831cd3294eeda5ba3dd1a0460921",
                    "service": "motaskcenterservice",
                    "uri": "/rest/task/v3.0/timerRequest/tasks",
                    "method": "GET|POST|PUT|DELETE ",
                    "var_pattern": "",
                    "mode": "FULL",
                    "target_serivce": "en-motaskcenterservice",
                    "target_protocol": "https",
                    "target_uri": "/rest/task/v3.0/timerRequest/tasks",
                    "region_id:": "xx-xx-xxx"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "token 错误"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/silvan/rest/v1.0/uri-mapping",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "UriMappingResponse": {
      "description": "URI接口信息响应体。",
      "properties": {
        "total": {
          "description": "uri-mapping信息的总条数。",
          "type": "integer",
          "format": "int32"
        },
        "uriMapping": {
          "description": "uri-mapping对象实例。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/UriMappingDTO"
          }
        }
      }
    },
    "UriMappingDTO": {
      "description": "URI接口信息响应实例。",
      "required": [
        "id",
        "service",
        "uri",
        "method",
        "target_service",
        "target_protocol",
        "target_uri"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "uri_mapping服务信息ID。"
        },
        "service": {
          "type": "string",
          "description": "服务名,与service中的name对应。"
        },
        "uri": {
          "type": "string",
          "description": "北向URI。"
        },
        "method": {
          "type": "string",
          "description": "请求方法,多个以“|”隔开。"
        },
        "var_pattern": {
          "type": "string",
          "description": "模式。"
        },
        "mode": {
          "type": "string",
          "description": "URI匹配方式,包括全匹配:FULL,最长匹配:SWA.默认为FULL。"
        },
        "target_service": {
          "type": "string",
          "description": "目标服务。"
        },
        "target_protocol": {
          "type": "string",
          "description": "向region service转发请求时的HTTP协议。"
        },
        "target_uri": {
          "type": "string",
          "description": "南向URI。"
        },
        "region_id": {
          "type": "string",
          "description": "所属区域",
          "default": ""
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
