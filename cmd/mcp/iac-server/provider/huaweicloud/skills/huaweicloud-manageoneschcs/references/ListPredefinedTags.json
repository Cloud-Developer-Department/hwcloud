          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/v1.0/predefine_tags?key=ENV&value=DEV&limit=10&marker=9&order_field=key&order_method=asc",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "PreDefineTags": {
      "description": "标签列表。",
      "properties": {
        "key": {
          "description": "键。 最大长度36个字符。 字符集:A-Z,a-z , 0-9,‘-’,‘_’,UNICODE字符(\\一-\\鿿)。",
          "type": "string",
          "maxLength": 36
        },
        "value": {
          "description": "值。每个值最大长度43个字符,可以为空字符串。 字符集:A-Z,a-z , 0-9,‘.’,‘-’,‘_’,UNICODE字符(\\一-\\鿿)。",
          "type": "string",
          "maxLength": 43
        },
        "update_time": {
          "description": "更新时间,采用UTC时间表示。2016-12-09T00:00:00Z。",
          "type": "string"
        }
      }
    },
    "ListPreDefineTagsRep": {
      "description": "查询预定义标签列表响应体。",
      "properties": {
        "marker": {
          "description": "分页位置标识(索引)。",
          "type": "string"
        },
        "total_count": {
          "description": "查询到的标签总数。",
          "type": "integer",
          "format": "int32"
        },
        "tags": {
          "description": "查询到的标签列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PreDefineTags"
          }
        }
      }
    }
