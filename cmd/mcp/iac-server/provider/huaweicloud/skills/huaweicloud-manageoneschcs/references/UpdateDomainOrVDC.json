            "in": "header",
            "required": true,
            "type": "string",
            "description": "接口支持的用户token。运营管理员,机机账号权限,VDC管理员权限用户的token。"
          },
          {
            "name": "vdc_id",
            "type": "string",
            "in": "path",
            "required": true,
            "description": "VDC id,只能包含小写字母、数字、中划线,长度在1-36之间。"
          },
          {
            "name": "vdcInfo",
            "description": "更新VDC的数据。",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ModifyVDCBeanV31"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "修改VDC成功。",
