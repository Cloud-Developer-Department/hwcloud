              "$ref": "#/definitions/ModifyVDCBeanV31Responses"
            },
            "examples": {
              "application/json": {
                "vdc": {
                  "domain_id": "6e7b5580647e47349d21c089b95354f9",
                  "upper_vdc_id": "0",
                  "level": 1,
                  "name": "vdcv31_1",
                  "description": "321",
                  "id": "be6d9587-d435-4045-a36a-faf729bad4bb"
