        },
        "enterprise_id": {
          "type": "string",
          "description": "华为云账户。长度为0-255位。"
        },
        "enterprise_detail": {
          "$ref": "#/definitions/EnterpriseDetail",
          "description": "华为云账户信息。"
        },
        "status": {
          "type": "boolean",
          "description": "是否开通云联邦,true表示开通,false表示未开通。"
        },
        "ldap_id": {
          "type": "string",
          "description": "AD id,只能包含小写字母、数字、中划线,长度在1-36之间。"
        },
        "third_type": {
          "type": "string",
          "description": "对接类型,1表示对接SAML,2表示对接ldap,5表示对接CAS,6表示对接OAuth"
        },
        "is_domain": {
          "type": "boolean",
          "default": false,
          "description": "是否租户或者VDC。"
        },
        "is_modify_domain_sync": {
          "type": "boolean",
          "default": true,
          "description": "是否同步修改租户信息。仅支持1级VDC。"
        }
      }
