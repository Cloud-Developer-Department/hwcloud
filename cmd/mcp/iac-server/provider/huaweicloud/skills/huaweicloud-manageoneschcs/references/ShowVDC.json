  "paths": {
    "/rest/vdc/v3.0/vdcs/{vdc_id}": {
      "get": {
        "summary": "查询VDC详情",
        "x-resource": "租户管理",
        "description": "根据VDC id查询其详情。\n\ncurl命令调用示例:\n```\ncurl -i -H \"Accept: application/json\" -H \"x-auth-token: ******\" -X GET \"https://{endpoint}/rest/vdc/v3.0/vdcs/113f4394-2f54-472f-b03f-aacbd98f9cb4\"\n```\n\n|SLA项|定义|\n|-----|-----|\n|请求成功率| >=99.9%|\n|可用性|Tier1|\n|数据一致性|最终一致,不一致时长<1分钟|\n|吞吐量|300次/分钟|\n|吞吐量|90次/秒|\n|TP50请求时延|1500ms|\n|TP99.9请求时延|3000ms|",
        "x-precautions": "错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运营面API参考 > 错误码说明 > VDC特性”章节。",
        "tags": [
          "VDC"
        ],
        "operationId": "ShowVDC",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "接口支持的用户token。运营管理员,机机账号权限,VDC管理员权限,vdc业务员权限,vdc只读权限,代维管理员权限用户用户的token。"
          },
          {
            "name": "vdc_id",
            "type": "string",
            "in": "path",
            "required": true,
            "description": "VDC id,只能包含小写字母、数字、中划线,长度在1-36之间。"
          },
          {
            "name": "is_domain",
            "type": "string",
            "in": "query",
            "default": "0",
            "description": "是否为租户,1代表是,0代表不是。"
          }
        ],
        "responses": {
          "200": {
            "description": "获取VDC详情成功。",
            "schema": {
              "$ref": "#/definitions/VdcDetailResponses"
            },
            "examples": {
              "application/json": {
                "vdc": {
                  "id": "ae6cb239f7514d94ab7508c4153c3a70",
                  "name": "xxx",
                  "tag": "vdc",
                  "description": "",
                  "upper_vdc_id": "-1",
                  "upper_vdc_name": null,
                  "top_vdc_id": "xxx",
                  "extra": "{\"manager\":\"\",\"phone\":\"\",\"email\":\"\"}",
                  "ecs_used": 0,
                  "evs_used": 0,
                  "project_count": 0,
                  "enabled": true,
                  "domain_id": "xxx",
                  "level": 0,
                  "create_user_id": "xxx",
                  "create_user_name": "xxx",
                  "create_at": 1685376828000,
                  "modify_at": 1685376828000,
                  "resource_status": "4",
                  "frozen_types": "1,3",
                  "utc_create_at": null,
                  "domain_name": "xxx",
                  "ldap_id": null,
                  "process_id": null,
                  "regions": [],
                  "third_type": null,
                  "enterprise_id": null,
                  "mfa_status": "0",
                  "enterprise_project_id": null,
                  "cloud_federation_rate": {},
                  "cloud_federation_status": false,
                  "ldap_name": ""
                }
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "接口认证失败。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET: https://{endpoint}/rest/vdc/v3.0/vdcs/91ba27bc-6375-46a5-85b7-f836a7fc6be2",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
