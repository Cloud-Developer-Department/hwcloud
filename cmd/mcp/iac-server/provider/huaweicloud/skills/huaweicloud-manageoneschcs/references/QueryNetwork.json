          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户带有project信息的Token(vdc_adm或vdc_readonly或vdc_user或mo_bss_adm角色的用户token)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言信息。",
