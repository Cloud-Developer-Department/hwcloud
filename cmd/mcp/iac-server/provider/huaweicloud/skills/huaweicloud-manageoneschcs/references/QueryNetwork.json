  "definitions": {
    "FCNetworkQOSTemplate": {
      "description": "QoS规格。",
      "required": [
        "send_average_bandwidth",
        "send_max_bandwidth",
        "send_burst_size",
        "priority",
        "accept_average_bandwidth",
        "accept_max_bandwidth",
        "accept_burst_size"
      ],
      "properties": {
        "id": {
          "description": "QOS规格ID。",
          "type": "string"
        },
        "name": {
          "description": "QOS规格名称。",
          "type": "string"
        },
        "send_average_bandwidth": {
          "description": "发送平均带宽。参数范围:1-10000。单位:Mbit/s,0表示未设置。",
          "type": "integer",
          "format": "int32"
        },
        "send_max_bandwidth": {
          "description": "发送峰值带宽。参数范围:send_average_bandwidth参数值-10000。单位:Mbit/s,0表示未设置。",
          "type": "integer",
          "format": "int32"
        },
        "send_burst_size": {
          "description": "发送突发大小。参数范围:1-10000。单位:Mbit/s,0表示未设置。",
          "type": "integer",
          "format": "int32"
        },
        "priority": {
          "description": "发送优先级。参数范围:2-7,0表示未设置。",
          "type": "integer",
          "format": "int32"
        },
        "accept_average_bandwidth": {
          "description": "接收平均带宽。参数范围:1-10000。单位:Mbit/s,0表示未设置。",
          "type": "integer",
          "format": "int32"
        },
        "accept_max_bandwidth": {
          "description": "接收峰值带宽。参数范围:accept_average_bandwidth参数值-10000。单位:Mbit/s,0表示未设置。",
          "type": "integer",
          "format": "int32"
        },
        "accept_burst_size": {
          "description": "接收突发大小。参数范围:1-10000。单位:Mbit/s,0表示未设置。",
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "FCNetworkResp": {
      "description": "查询网络返回实体。",
      "properties": {
        "id": {
          "description": "网络ID。",
          "type": "string"
        },
        "vpc_id": {
          "description": "VPC ID。",
          "type": "string"
        },
        "dvs_id": {
          "description": "DVS ID。",
          "type": "string"
        },
        "project_id": {
          "description": "租户ID。",
          "type": "string"
        },
        "dvs_name": {
          "description": "DVS 名称。",
          "type": "string"
        },
        "name": {
          "description": "网络名称。",
          "type": "string"
        },
        "description": {
          "description": "网络描述。",
          "type": "string"
        },
        "type": {
          "description": "网络类型,INTERNAL表示内部网络,EXTERNAL表示外部网络。",
          "type": "string"
        },
        "qos": {
          "description": "QoS规格。",
          "$ref": "#/definitions/FCNetworkQOSTemplate"
        },
        "cloud_infra_id": {
          "description": "云资源池ID。",
          "type": "string"
        },
        "vlan_id": {
          "description": "关联的VlanId,范围0-4094,portType为Access时,此字段必填 0:表示不带vlan标签",
          "type": "string"
        },
        "vlan_range": {
          "description": "表示关联的Vlan范围,最多可以包含2047个字符,vlan范围也可以是单个vlanid。vlan范围用A–B表示,不同的范围用“,”分割,A的vlanid要小于B的vlanid。 vlan范围内的vlanid取值范围是1-4094。",
          "type": "string"
        },
        "vsp_num": {
          "description": "portGroup中的Vsp总数",
          "type": "integer",
          "x-allowNull": true
        },
        "is_ip_mac_bind": {
          "description": "是否设置该端口组内的虚拟机的IP地址与MAC地址绑定,true:设置IP地址与MAC地址绑定,false:不设置IP地址与MAC地址绑定,可选,默认值为false。",
          "type": "boolean",
          "x-allowNull": true
        },
        "is_calc_tcp_check_sum": {
          "description": "填充tcp校检和:false表示关闭",
          "type": "boolean",
          "x-allowNull": true
        },
        "is_dhcp_isolation": {
          "description": "dhcp隔离:false表示关闭",
          "type": "boolean",
          "x-allowNull": true
        },
        "create_time": {
          "description": "网络创建时间。",
          "type": "string"
        },
        "ip_bcst_suppress": {
          "description": "广播抑制:0表示未开启",
          "type": "integer",
          "x-allowNull": true
        },
        "dvs_urn": {
          "description": "DVS 标识。",
          "type": "string",
          "x-allowNull": true
        },
        "pg_urn": {
          "description": "内部网络标识。",
          "type": "string",
          "x-allowNull": true
        },
        "status": {
          "description": "网络状态。取值范围:ACTIVE-正常,UNKNOWN-未知。",
          "type": "string"
        },
        "ipv4_primary_dns": {
          "description": "IPv4协议的首选DNS服务器地址。",
          "type": "string"
        },
        "ipv4_second_dns": {
          "description": "IPv4协议的备选DNS服务器地址。",
          "type": "string"
        },
        "ipv6_primary_dns": {
          "description": "IPv6协议的首选DNS服务器地址。",
          "type": "string"
        },
        "ipv6_second_dns": {
          "description": "IPv6协议的备选DNS服务器地址。",
          "type": "string"
        },
        "ipv4_subnet": {
          "description": "IPv4子网信息。",
          "$ref": "#/definitions/Subnet4FCNetwork"
        },
        "ipv6_subnet": {
          "description": "IPv6子网信息。",
          "$ref": "#/definitions/Subnet4FCNetwork"
        }
      }
    },
    "FCQueryNetworkReq": {
      "required": [
        "cloud_infra_id"
      ],
      "description": "批量查询网络列表请求。",
      "properties": {
        "cloud_infra_id": {
          "description": "云资源池ID。",
          "type": "string"
        },
        "vpc_id": {
          "description": "VPC ID。",
          "type": "string"
        },
        "vdc_id": {
          "description": "VDC ID,传入VDC ID时,网络类型必须为EXTERNAL。",
          "type": "string"
        },
        "limit": {
          "description": "单页查询量,最大为100,可选。",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "start": {
          "description": "分页查询的起始位置,必须是非负整型数,可选。",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "type": {
          "description": "网络类型,取值为INTERNAL或EXTERNAL,运营管理侧调用必须为EXTERNAL,租户侧查询type为EXTERNAL需要传vdc_id。",
          "type": "string"
        },
        "name": {
          "description": "网络名称,支持通过网络名称进行模糊搜索,可选。",
          "type": "string"
        },
        "id": {
          "description": "网络ID,支持根据网络ID进行模糊搜索,可选。",
          "type": "string"
        },
        "order": {
          "description": "排序字段,支持create_time,name,默认为(create_time),可选。",
          "type": "string",
          "default": "create_time",
          "pattern": "(create_time|name)"
        },
        "order_type": {
          "description": "排序方式,升序(asc)或降序(desc),默认为降序(desc),可选。",
          "type": "string",
          "default": "desc",
          "pattern": "(desc|asc)"
        },
        "dvs_urns": {
          "description": "DVS标识列表,可选。表示根据DVS 标识列表查询网络列表。一次查询DVS 标识列表总数量最大值为100。",
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string"
          }
        },
        "pg_urns": {
          "description": "内部网络标识列表,可选。通过内部网络标识列表查询网络列表。一次查询内部网络总数量最大值为100。",
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "description": "内部网络状态,取值范围:ACTIVE-正常,UNKNOWN-未知。",
          "type": "string"
        },
        "ipv4_primary_dns": {
          "description": "IPv4协议的首选DNS服务器地址。",
          "type": "string"
        },
        "ipv4_second_dns": {
          "description": "IPv4协议的备选DNS服务器地址。",
          "type": "string"
        },
        "ipv6_primary_dns": {
          "description": "IPv6协议的首选DNS服务器地址。",
          "type": "string"
        },
        "ipv6_second_dns": {
          "description": "IPv6协议的备选DNS服务器地址。",
          "type": "string"
        },
        "ipv4_subnet": {
          "description": "IPv4子网信息。",
          "$ref": "#/definitions/Subnet4FCNetwork"
        },
        "ipv6_subnet": {
          "description": "IPv6子网信息。",
          "$ref": "#/definitions/Subnet4FCNetwork"
        }
      }
    },
    "AllocationPool4FCNetwork": {
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "description": "起始IP地址。",
          "type": "string"
        },
        "end": {
          "description": "结束IP地址。",
          "type": "string"
        }
      }
    },
    "FCListNetworksResp": {
      "description": "查询网络列表返回实体。",
      "properties": {
        "networks": {
          "description": "网络列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FCNetworkResp"
          }
        },
        "total": {
          "description": "总数。",
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "Subnet4FCNetwork": {
      "properties": {
        "subnet_id": {
          "description": "子网ID。",
          "type": "string"
        },
        "ip_allocation_policy": {
          "description": "IP地址分配方式:1表示静态注入,2表示手动。",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true
        },
        "cidr": {
          "description": "子网/掩码。",
          "type": "string"
        },
        "gateway_ip": {
          "description": "网关。",
          "type": "string"
        },
        "allocation_pools": {
          "description": "IP地址池。",
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/AllocationPool4FCNetwork"
          }
        }
      }
    }
  },
