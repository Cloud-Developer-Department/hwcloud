{
  "name": "ListInstanceFlavors",
  "summary": "查询实例规格列表",
  "tags": "实例规格管理",
  "productshort": "IoTDM",
  "region_id": "cn-south-1",
  "paths": {
    "/v5/iot/{project_id}/iotda-instances/flavors": {
      "get": {
        "description": "用户可以调用此接口查询设备接入服务支持的实例规格列表。支持的实例规格请参见[产品规格说明](https://support.huaweicloud.com/productdesc-iothub/iot_04_0014.html)。",
        "tags": [
          "InstanceFlavorManagement"
        ],
        "summary": "查询实例规格列表",
        "operationId": "ListInstanceFlavors",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-iftype": "OpenAPI_new",
        "x-apig-name": "IoTDA_OpenAPI",
        "x-imports": [
          "org.springframework.http.ResponseEntity"
        ],
        "x-returnType": "ResponseEntity<InstanceFlavors>",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "consumes": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "x-example": "0",
            "minimum": 0,
            "maximum": 500,
            "description": "**参数说明**:表示从marker后偏移offset条记录开始查询。默认为0,取值范围为0-500的整数。当offset为0时,表示从marker后第一条记录开始输出。 - 限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。 取值范围:0-500的整数,默认为0。"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 500,
            "x-example": "500",
            "minimum": 1,
            "maximum": 500,
            "description": "**参数说明**:分页查询时每页显示的记录数。\n**取值范围**:1-500的整数,默认为500。"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。",
            "required": false,
            "pattern": "^[a-fA-F0-9]{1,20}$",
            "default": "ffffffffffffffffffff",
            "type": "string"
          },
          {
            "name": "instance_type",
            "in": "query",
            "required": false,
            "type": "string",
            "pattern": "(standard|enterprise|valueaddedservice)",
            "x-example": "standard",
            "description": "**参数说明**:实例类型。\n**取值范围**:\n- standard:标准版实例\n- enterprise:企业版实例"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/InstanceFlavors"
            },
            "examples": {
              "application/json": {
                "page": {
                  "count": 1,
                  "marker": 1805431584415871305
                },
                "flavors": [
                  {
                    "instance_type": "standard"
                  },
                  {
                    "type": "iotda.standard.s2"
                  },
                  {
                    "status": "normal"
                  },
                  {
                    "charge_modes": [
                      "prePaid",
                      "postPaid"
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "x-error": [
              "IoTDA.000006"
            ]
          },
          "401": {
            "description": "Unauthorized",
            "x-error": [
              "IoTDA.000002"
            ]
          },
          "403": {
            "description": "Forbidden",
            "x-error": [
              "IoTDA.000004"
            ]
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/iotda-instances/flavors",
        "x-request-examples-description-1": "查询实例规格列表。"
      }
    }
  },
  "definitions": {
    "InstanceFlavors": {
      "type": "object",
      "title": "查询实例列表响应结构体",
      "properties": {
        "page": {
          "$ref": "#/definitions/Page"
        },
        "flavors": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "description": "**参数说明**:设备接入实例规格的详情列表。",
          "items": {
            "$ref": "#/definitions/InstanceFlavor"
          }
        }
      }
    },
    "Page": {
      "title": "查询批量响应的分页结构体",
      "type": "object",
      "description": "查询批量分页结构体,定义了分页页码、每页记录数、记录总数、该页记录的最大Id。",
      "properties": {
        "count": {
          "type": "integer",
          "description": "满足查询条件的记录总数。",
          "format": "int64",
          "example": 100
        },
        "marker": {
          "type": "string",
          "description": "本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。",
          "example": "5c8f3d2d3df1f10d803adbda"
        }
      }
    },
    "InstanceFlavor": {
      "type": "object",
      "title": "创建实例请求结构体",
      "required": [
        "instance_type",
        "type",
        "status",
        "charge_modes"
      ],
      "properties": {
        "instance_type": {
          "type": "string",
          "pattern": "(standard|enterprise|valueaddedservice)",
          "example": "standard",
          "description": "**参数说明**:创建的实例类型。实例类型说明参见[产品规格说明](https://support.huaweicloud.com/productdesc-iothub/iot_04_0014.html)。\n**取值范围**:\n- standard:标准版实例\n- enterprise:企业版实例"
        },
        "type": {
          "type": "string",
          "example": "iotda.standard.s1",
          "pattern": "^[A-Za-z0-9-.]{1,64}$",
          "description": "**参数说明**:设备接入实例的规格名称。详情请参见[产品规格说明](https://support.huaweicloud.com/productdesc-iothub/iot_04_0014.html)中的规格编码。"
        },
        "status": {
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "example": "normal",
          "description": "**参数说明**:实例规格的在售状态。\n**取值范围**:\n- normal:在售\n- sellout:已售罄"
        },
        "charge_modes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "example": "[\"prePaid\", \"postPaid\"]",
          "items": {
            "minLength": 0,
            "maxLength": 100,
            "type": "string"
          },
          "description": "**参数说明**:实例规格支持的付费方式列表。\n**取值范围**:\n- prePaid:包年/包月\n- postPaid:按需计费"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
