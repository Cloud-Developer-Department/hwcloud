  "definitions": {
    "Tag": {
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*)(?<!\\s)$",
          "description": "**参数说明**:标签键,标签的键可用字母(包含中文)、数字、空格和以下字符:下划线(_)点(.)冒号(:)等号(=)加号(+)中划线(-)以及@,首尾不能有空格字符。",
          "example": "PRO"
        },
        "value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$",
          "description": "**参数说明**:标签值,可为空字符串和null,标签的值可用字母(包含中文)、数字、空格和以下字符:下划线(_)点(.)冒号(:)等号(=)加号(+)中划线(-)以及@。",
          "example": true
        }
      }
    },
    "QueryInstanceBase": {
      "type": "object",
      "title": "实例信息结构体",
      "properties": {
        "instance_type": {
          "type": "string",
          "pattern": "(standard|basic|enterprise|valueaddedservice)",
          "example": "standard",
          "description": "**参数说明**:实例类型。\n**取值范围**:\n- standard:标准版实例\n- enterprise:企业版实例"
        },
        "instance_id": {
          "type": "string",
          "pattern": "[0-9a-f-]{1,36}",
          "description": "**参数说明**:实例ID。\n**取值范围**:长度不超过36,由小写字母[a-f]、数字、连接符(-)的组成。"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_\\-\\一-\\龥]{1,64}$",
          "description": "**参数说明**:实例名称\n**取值范围**:由中文字符,英文字母、数字及“_”、“-”组成,且长度为[1-64]个字符。"
        },
        "flavor": {
          "$ref": "#/definitions/Flavor"
        },
        "status": {
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "example": "ACTIVE",
          "description": "**参数说明**:实例状态。\n**取值范围**:\n- CREATING:实例正在创建\n- ACTIVE:实例正常\n- FROZEN:实例冻结\n- TRADING: 实例正在进行交易\n- MODIFYING:实例正在变更规格\n- MODIFY_FAILED: 实例变更失败\n- FAILED:实例创建失败"
        },
        "charge_info": {
          "$ref": "#/definitions/ChargeInfo"
        },
        "description": {
          "type": "string",
          "example": "IoTDA instance for test.",
          "pattern": "^[A-Za-z0-9_,,.。、&\\-\\s\\一-\\龥]{0,256}$",
          "description": "**参数说明**:设备接入实例的描述信息。\n**取值范围**:长度不超过256,只允许中文、字母、数字、以及_,,.。、&-等字符的组合。"
        },
        "enterprise_project_id": {
          "type": "string",
          "example": "d22e47e9-cfad-4254-8a29-d2a56a07681d",
          "pattern": "[0-9a-f-]{1,36}",
          "description": "**参数说明**:企业项目Id。"
        },
        "tags": {
          "type": "array",
          "description": "**参数说明**: 设备接入实例的标签信息。如果实例有标签,则会有该字段,否则该字段为空。",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/Tag"
          }
        },
        "order_id": {
          "type": "string",
          "example": "CS22121614500ABCD",
          "maxLength": 64,
          "minLength": 0,
          "description": "**参数说明**:订单号,创建包年包月实例时返回该参数。查看订单详情请参考[查询订单详情](https://support.huaweicloud.com/api-bpconsole/zh-cn_topic_0075746564.html)。"
        },
        "additional_params": {
          "$ref": "#/definitions/AdditionalParams"
        }
      }
    },
    "Flavor": {
      "type": "object",
      "title": "产品规格参数结构体",
      "description": "**参数说明**:设备接入实例的规格参数。",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "example": "iotda.standard.s1",
          "pattern": "^[A-Za-z0-9-.]{1,64}$",
          "description": "**参数说明**:待创建设备接入实例的规格名称。详情请参见[产品规格说明](https://support.huaweicloud.com/productdesc-iothub/iot_04_0014.html)中的规格编码。"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "example": 1,
          "description": "**参数说明**:待创建设备接入标准版实例的单元数量。详情请参见[产品规格说明](https://support.huaweicloud.com/productdesc-iothub/iot_04_0014.html)。当instance_type是standard时,该参数必填。"
        }
      }
    },
    "Port": {
      "type": "object",
      "title": "企业版端口信息结构体",
      "description": "企业版端口信息。创建企业版实例时必填。",
      "properties": {
        "app_https_port": {
          "type": "integer",
          "format": "int32",
          "default": 443,
          "description": "**参数说明**:应用接入HTTPS协议端口,默认值:443。",
          "example": 443,
          "minimum": 0,
          "maximum": 65535
        },
        "app_amqps_port": {
          "type": "integer",
          "format": "int32",
          "default": 5671,
          "description": "**参数说明**:应用接入AMQP协议端口, 默认值:5671。",
          "example": 5671,
          "minimum": 0,
          "maximum": 65535
        },
        "app_mqtts_port": {
          "type": "integer",
          "format": "int32",
          "default": 8883,
          "description": "**参数说明**:应用接入MQTTS协议端口, 默认值:8883。",
          "example": 8883,
          "minimum": 0,
          "maximum": 65535
        },
        "device_coap_port": {
          "type": "integer",
          "format": "int32",
          "default": 5683,
          "description": "**参数说明**:设备接入COAP协议端口, 默认值:5683。",
          "example": 5683,
          "minimum": 0,
          "maximum": 65535
        },
        "device_coaps_port": {
          "type": "integer",
          "format": "int32",
          "default": 5684,
          "description": "**参数说明**:设备接入COAPS协议端口, 默认值:5684。",
          "example": 5684,
          "minimum": 0,
          "maximum": 65535
        },
        "device_mqtt_port": {
          "type": "integer",
          "format": "int32",
          "default": 1883,
          "description": "**参数说明**:设备接入MQTT协议端口, 默认值:1883。",
          "example": 1883,
          "minimum": 0,
          "maximum": 65535
        },
        "device_mqtts_port": {
          "type": "integer",
          "format": "int32",
          "default": 8883,
          "description": "**参数说明**:设备接入MQTTS协议端口, 默认值:8883。",
          "example": 8883,
          "minimum": 0,
          "maximum": 65535
        },
        "device_https_port": {
          "type": "integer",
          "format": "int32",
          "default": 443,
          "description": "**参数说明**:设备接入HTTPS协议端口, 默认值:443。",
          "example": 443,
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "ChargeInfo": {
      "type": "object",
      "title": "计费信息结构体",
      "description": "**参数说明**:设备接入实例计费信息",
      "required": [
        "charge_mode"
      ],
      "properties": {
        "charge_mode": {
          "type": "string",
          "pattern": "prePaid|postPaid",
          "example": "prePaid",
          "description": "**参数说明**:实例的付费方式。\n**取值范围**:\n- prePaid:包年/包月\n- postPaid:按需计费"
        },
        "period_type": {
          "type": "string",
          "pattern": "(month|year)",
          "example": "year",
          "description": "**参数说明**:订购设备接入实例的周期类型(包年、包月等)。charge_mode为prePaid时生效,且为必选值。\n**取值范围**:\n- month:包月\n- year:包年"
        },
        "period_num": {
          "type": "integer",
          "example": 1,
          "minimum": 1,
          "maximum": 9,
          "description": "**参数说明**:订购设备接入实例的周期数。charge_mode为prePaid时生效,且为必选值。\n**取值范围**:period_type=month(周期类型为月)时,取值为[1,9];period_type=year(周期类型为年)时,取值为[1,3]\"。"
        },
        "is_auto_renew": {
          "type": "boolean",
          "example": "true",
          "default": "false",
          "description": "**参数说明**:创建包年/包月实例时可指定,表示是否自动续订,续订的周期和原周期相同,且续订时会自动支付。\n**取值范围**:\n- true:自动续订\n- false:默认值,不自动续订"
        },
        "is_auto_pay": {
          "type": "boolean",
          "example": "true",
          "default": "false",
          "description": "**参数说明**:创建包年/包月实例时可指定,表示是否自动从客户的账户中支付,此字段不影响自动续订的支付方式。\n**取值范围**:true - 自动支付,从账户余额自动扣费; false - 默认值,只提交订单不支付。需要客户参考[支付包年/包月产品订单](https://support.huaweicloud.com/api-bpconsole/api_order_00016.html#section0)进行支付,或者在华为云官网页面使用进行支付。"
        },
        "promotion_infos": {
          "type": "string",
          "maxLength": 2048,
          "minLength": 0,
          "example": "string",
          "description": "**参数说明**:促销信息。"
        }
      }
    },
    "AdditionalParams": {
      "type": "object",
      "title": "企业版附加参数结构体",
      "required": [
        "vpc_id",
        "subnet_id",
        "security_group_id",
        "port_info"
      ],
      "description": "企业版附加参数信息。",
      "properties": {
        "vpc_id": {
          "type": "string",
          "pattern": "[0-9a-f-]{1,36}",
          "description": "**参数说明**:企业版实例的VPCID。",
          "example": "d22e47e9-cfad-4254-8a29-d2a56a076811"
        },
        "subnet_id": {
          "type": "string",
          "pattern": "[0-9a-f-]{1,36}",
          "description": "**参数说明**:企业版实例的子网ID。",
          "example": "d22e47e9-cfad-4254-8a29-d2a56a076"
        },
        "security_group_id": {
          "type": "string",
          "pattern": "[0-9a-f-]{1,36}",
          "description": "**参数说明**:企业版实例的安全组ID。请确保所选安全组已放通22端口(Linux SSH登录),3389端口(Windows远程登录)和ICMP协议(Ping)。",
          "example": "d22e47e9-cfad-4254-8a29-d2a56a07681d"
        },
        "smn_topic_urn": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_\\-:]{1,256}$",
          "example": "urn:smn:regionId:762bdb3251034f268af0e395c53ebcd:test_topic_v1",
          "description": "**参数说明**:SMN的topic urn, 当企业版实例创建成功时,平台将通过该topic发送通知。"
        },
        "ciphering_algorithm": {
          "type": "string",
          "default": "COMMON_ALGORITHM",
          "pattern": "(COMMON_ALGORITHM|SM_ALGORITHM)",
          "example": "COMMON_ALGORITHM",
          "description": "**参数说明**:实例支持的加密算法。\n**取值范围**:\n- COMMON_ALGORITHM: 通用加密算法(支持RSA,SHA256等国际通用的密码算法)\n- SM_ALGORITHM: 支持SM系列商密算法(支持SM2,SM3,SM4等国密算法)"
        },
        "port_info": {
          "$ref": "#/definitions/Port"
        }
      }
    },
    "CreateInstance": {
      "type": "object",
      "title": "创建实例请求结构体",
      "required": [
        "instance_type",
        "flavor",
        "name",
        "charge_info"
      ],
      "properties": {
        "instance_type": {
          "type": "string",
          "pattern": "(standard|basic|enterprise|valueaddedservice)",
          "example": "standard",
          "description": "**参数说明**:创建的实例类型。实例类型说明参见[产品规格说明](https://support.huaweicloud.com/productdesc-iothub/iot_04_0014.html)。\n**取值范围**:\n- standard:标准版实例\n- enterprise:企业版实例"
        },
        "flavor": {
          "$ref": "#/definitions/Flavor"
        },
        "name": {
          "type": "string",
          "example": "iotda_instance",
          "pattern": "^[A-Za-z0-9_\\-\\一-\\龥]{1,64}$",
          "description": "**参数说明**:实例名称\n**取值范围**:由中文字符,英文字母、数字及“_”、“-”组成,且长度为[1-64]个字符。"
        },
        "charge_info": {
          "$ref": "#/definitions/ChargeInfo"
        },
        "description": {
          "type": "string",
