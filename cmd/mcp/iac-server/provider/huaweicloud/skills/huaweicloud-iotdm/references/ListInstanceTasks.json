{
  "name": "ListInstanceTasks",
  "summary": "查询实例任务列表",
  "tags": "实例任务管理",
  "productshort": "IoTDM",
  "region_id": "cn-south-1",
  "paths": {
    "/v5/iot/{project_id}/iotda-instances/{instance_id}/tasks": {
      "get": {
        "description": "用户可以调用此接口查询设备接入实例任务列表。",
        "tags": [
          "InstanceTaskManagement"
        ],
        "summary": "查询实例任务列表",
        "operationId": "ListInstanceTasks",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-iftype": "OpenAPI_new",
        "x-apig-name": "IoTDA_OpenAPI",
        "x-imports": [
          "org.springframework.http.ResponseEntity"
        ],
        "x-returnType": "ResponseEntity<InstanceTasks>",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "consumes": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "df91ba92-b501-4ea4-b3e1-cd96386c936c",
            "description": "**参数说明**:实例ID。\n**取值范围**:长度不超过36,由小写字母[a-f]、数字、连接符(-)的组成。"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "x-example": "0",
            "minimum": 0,
            "maximum": 500,
            "description": "**参数说明**:表示从marker后偏移offset条记录开始查询。默认为0,取值范围为0-500的整数。当offset为0时,表示从marker后第一条记录开始输出。 - 限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。 取值范围:0-500的整数,默认为0。"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 10,
            "x-example": "500",
            "minimum": 1,
            "maximum": 500,
            "description": "**参数说明**:分页查询时每页显示的记录数。\n**取值范围**:1-500的整数,默认为500。"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。",
            "required": false,
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "default": "ffffffffffffffffffffffffffffffff",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/InstanceTasks"
            },
            "examples": {
              "application/json": {
                "page": {
                  "count": 1,
                  "marker": 1805431584415871305
                },
                "tasks": [
                  {
                    "task_id": "075f413d-a3bb-4243-974d-8eb9221c2df8",
                    "type": "CREATE",
                    "status": "SUCCESS",
                    "create_time": "2020-08-19T01:52:49.493Z",
                    "start_time": "2020-08-19T01:52:49.492Z",
                    "end_time": "2020-08-19T01:52:49.492Z",
                    "target_config": null,
                    "operate_window": null
                  },
                  {
                    "task_id": "075f413d-a3bb-4243-974d-8eb9221c1234",
                    "type": "MODIFY",
                    "status": "PENDING",
                    "create_time": "2021-08-19T01:52:49.493Z",
                    "start_time": "2021-08-19T01:52:49.492Z",
                    "end_time": "2021-08-19T01:52:49.492Z",
                    "target_config": {
                      "flavor": {
                        "type": "iotda.standard.s2",
                        "size": 2
                      }
                    },
                    "operate_window": {
                      "start_time": "18:00",
                      "end_time": "22:00"
                    }
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "x-error": [
              "IoTDA.000006",
              "IoTDA.019508"
            ]
          },
          "401": {
            "description": "Unauthorized",
            "x-error": [
              "IoTDA.000002"
            ]
          },
          "403": {
            "description": "Forbidden",
            "x-error": [
              "IoTDA.000004",
              "IoTDA.000022"
            ]
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/iotda-instances/{instance_id}/tasks",
        "x-request-examples-description-1": "查询实例任务列表。"
      }
    }
  },
  "definitions": {
    "OperateWindow": {
      "type": "object",
      "required": [
        "start_time",
        "end_time"
      ],
      "title": "实例维护时间窗结构体",
      "description": "实例维护时间窗,用户在变更实例规格时,可以指定在该时间窗内进行变更。",
      "properties": {
        "start_time": {
          "type": "string",
          "description": "**参数说明**:变更时间窗开始时间,UTC时间,格式为:\"HH:mm\"",
          "pattern": "^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$",
          "example": "18:00"
        },
        "end_time": {
          "type": "string",
          "description": "**参数说明**:变更时间窗结束时间,UTC时间,格式为:\"HH:mm\"",
          "pattern": "^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$",
          "example": "22:00"
        }
      }
    },
    "Flavor": {
      "type": "object",
      "title": "产品规格参数结构体",
      "description": "**参数说明**:设备接入实例的规格参数。",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "example": "iotda.standard.s1",
          "pattern": "^[A-Za-z0-9-.]{1,64}$",
          "description": "**参数说明**:待创建设备接入实例的规格名称。详情请参见[产品规格说明](https://support.huaweicloud.com/productdesc-iothub/iot_04_0014.html)中的规格编码。"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "example": 1,
          "description": "**参数说明**:待创建设备接入标准版实例的单元数量。详情请参见[产品规格说明](https://support.huaweicloud.com/productdesc-iothub/iot_04_0014.html)。当instance_type是standard时,该参数必填。"
        }
      }
    },
    "TargetConfig": {
      "description": "实例规格变更时,实例的目标规格配置。",
      "properties": {
        "flavor": {
          "$ref": "#/definitions/Flavor"
        },
        "charge_mode": {
          "type": "string",
          "pattern": "prePaid|postPaid",
          "example": "prePaid",
          "description": "**参数说明**:实例的付费方式。\n**取值范围**:\n- prePaid:包年/包月\n- postPaid:按需计费"
        }
      }
    },
    "InstanceTasks": {
      "description": "实例任务列表",
      "properties": {
        "page": {
          "$ref": "#/definitions/Page"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InstanceTask"
          },
          "minItems": 0,
          "maxItems": 100,
          "description": "实例任务列表"
        }
      }
    },
    "InstanceTask": {
      "description": "实例任务信息",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "**参数说明**:实任务ID。",
          "pattern": "[0-9a-f-]{1,64}",
          "example": "075f413d-a3bb-4243-974d-8eb9221c2df8"
        },
        "type": {
          "type": "string",
          "pattern": "(CREATE|MODIFY|DELETE|FREEZE|UNFREEZE|UPDATE_ACCESS_CONFIG|UPDATE_ALLOW_LISTS|OPEN_SNAT)",
          "example": "CREATE",
          "description": "**参数说明**:实例任务类型。\n**取值范围**:\n- CREATE:创建实例任务\n- MODIFY:实例规格变更任务\n- DELETE:实例删除任务\n- FREEZE:实例冻结任务\n- UNFREEZE:实例解冻任务\n- UPDATE_ACCESS_CONFIG:修改实例接入信息任务\n- UPDATE_ALLOW_LISTS: 修改实例接入白名单任务\n- OPEN_SNAT:启用实例SNAT配置任务"
        },
        "status": {
          "type": "string",
          "pattern": "(PENDING|RUNNING|SUCCESS|FAILED)",
          "example": "PENDING",
          "description": "**参数说明**:任务状态。\n**取值范围**:\n- PENDING:等待执行\n- RUNNING:执行中\n- SUCCESS:执行成功\n- FAILED:执行失败"
        },
        "status_detail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1028,
          "example": "创建失败,请重试",
          "description": "**参数说明**:任务状态描述。"
        },
        "create_time": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "example": "2020-08-19T01:52:49.493Z",
          "description": "**参数说明**:实例任务的创建时间。格式为:\"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\""
        },
        "start_time": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "example": "2020-08-19T01:52:49.492Z",
          "description": "**参数说明**:实例任务的开始时间。格式为:\"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\""
        },
        "end_time": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "example": "2020-08-19T01:53:49.492Z",
          "description": "**参数说明**:实例任务的结束时间。格式为:\"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\""
        },
        "target_config": {
          "$ref": "#/definitions/TargetConfig"
        },
        "operate_window": {
          "$ref": "#/definitions/OperateWindow"
        }
      }
    },
    "Page": {
      "title": "查询批量响应的分页结构体",
      "type": "object",
      "description": "查询批量分页结构体,定义了分页页码、每页记录数、记录总数、该页记录的最大Id。",
      "properties": {
        "count": {
          "type": "integer",
          "description": "满足查询条件的记录总数。",
          "format": "int64",
          "example": 100
        },
        "marker": {
          "type": "string",
          "description": "本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。",
          "example": "5c8f3d2d3df1f10d803adbda"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iotda-mgmt.cn-south-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v5",
  "method": "get",
  "uri": null
}