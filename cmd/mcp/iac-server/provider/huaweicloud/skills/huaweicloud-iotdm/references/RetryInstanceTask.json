{
  "name": "RetryInstanceTask",
  "summary": "重试实例任务",
  "tags": "实例任务管理",
  "productshort": "IoTDM",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v5/iot/{project_id}/iotda-instances/{instance_id}/tasks/{task_id}/retry": {
      "post": {
        "description": "用户可以调用此接口对运行失败的实例任务进行重试。",
        "tags": [
          "InstanceTaskManagement"
        ],
        "summary": "重试实例任务",
        "operationId": "RetryInstanceTask",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-iftype": "OpenAPI_new",
        "x-apig-name": "IoTDA_OpenAPI",
        "x-imports": [
          "org.springframework.http.ResponseEntity"
        ],
        "x-returnType": "ResponseEntity<InstanceTaskDetail>",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "consumes": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "[0-9a-f-]{1,36}",
            "x-example": "df91ba92-b501-4ea4-b3e1-cd96386c936c",
            "description": "**参数说明**:实例ID。\n**取值范围**:长度不超过36,由小写字母[a-f]、数字、连接符(-)的组成。"
          },
          {
            "name": "task_id",
            "in": "path",
            "description": "任务Id",
            "required": true,
            "type": "string",
            "pattern": "[0-9a-f-]{1,64}",
            "x-example": "075f413d-a3bb-4243-974d-8eb9221c2df8"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/InstanceTaskDetail"
            },
            "examples": {
              "application/json": {
                "task_id": "075f413d-a3bb-4243-974d-8eb9221c1234",
                "type": "MODIFY",
                "status": "RUNNING",
                "create_time": "2021-08-19T01:52:49.493Z",
                "start_time": "2021-08-19T01:52:49.492Z",
                "end_time": "2021-08-19T01:52:49.492Z",
                "target_config": {
                  "flavor": {
                    "type": "iotda.standard.s2",
                    "size": 2
                  }
                },
                "operate_window": {
                  "start_time": "18:00",
                  "end_time": "22:00"
                },
                "progress": 80
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "x-error": [
              "IoTDA.000006",
              "IoTDA.019508",
              "IoTDA.019525"
            ]
          },
          "401": {
            "description": "Unauthorized",
            "x-error": [
              "IoTDA.000002"
            ]
          },
          "403": {
            "description": "Forbidden",
            "x-error": [
              "IoTDA.000004",
              "IoTDA.000022",
              "IoTDA.019526"
            ]
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/iotda-instances/{instance_id}/tasks/{task_id}/retry"
      }
    }
  },
  "definitions": {
    "OperateWindow": {
      "type": "object",
      "required": [
        "start_time",
        "end_time"
      ],
      "title": "实例维护时间窗结构体",
      "description": "实例维护时间窗,用户在变更实例规格时,可以指定在该时间窗内进行变更。",
      "properties": {
        "start_time": {
          "type": "string",
          "description": "**参数说明**:变更时间窗开始时间,UTC时间,格式为:\"HH:mm\"",
          "pattern": "^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$",
          "example": "18:00"
        },
        "end_time": {
          "type": "string",
          "description": "**参数说明**:变更时间窗结束时间,UTC时间,格式为:\"HH:mm\"",
          "pattern": "^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$",
          "example": "22:00"
        }
      }
    },
    "Flavor": {
      "type": "object",
      "title": "产品规格参数结构体",
      "description": "**参数说明**:设备接入实例的规格参数。",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "example": "iotda.standard.s1",
          "pattern": "^[A-Za-z0-9-.]{1,64}$",
          "description": "**参数说明**:待创建设备接入实例的规格名称。详情请参见[产品规格说明](https://support.huaweicloud.com/productdesc-iothub/iot_04_0014.html)中的规格编码。"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "example": 1,
          "description": "**参数说明**:待创建设备接入标准版实例的单元数量。详情请参见[产品规格说明](https://support.huaweicloud.com/productdesc-iothub/iot_04_0014.html)。当instance_type是standard时,该参数必填。"
        }
      }
    },
    "TargetConfig": {
      "description": "实例规格变更时,实例的目标规格配置。",
      "properties": {
        "flavor": {
          "$ref": "#/definitions/Flavor"
        },
        "charge_mode": {
          "type": "string",
          "pattern": "prePaid|postPaid",
          "example": "prePaid",
          "description": "**参数说明**:实例的付费方式。\n**取值范围**:\n- prePaid:包年/包月\n- postPaid:按需计费"
        }
      }
    },
    "InstanceTaskDetail": {
      "description": "实例任务详情",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务Id",
          "pattern": "[0-9a-f-]{1,64}",
          "example": "075f413d-a3bb-4243-974d-8eb9221c2df8"
        },
        "type": {
          "type": "string",
          "pattern": "(CREATE|MODIFY|DELETE|FREEZE|UNFREEZE|UPDATE_ACCESS_CONFIG|UPDATE_ALLOW_LISTS|OPEN_SNAT)",
          "example": "CREATE",
          "description": "**参数说明**:实例任务类型。\n**取值范围**:\n- CREATE:创建实例任务\n- MODIFY:实例规格变更任务\n- DELETE:实例删除任务\n- FREEZE:实例冻结任务\n- UNFREEZE:实例解冻任务\n- UPDATE_ACCESS_CONFIG:修改实例接入信息任务\n- UPDATE_ALLOW_LISTS: 修改实例接入白名单任务\n- OPEN_SNAT:启用实例SNAT配置任务"
        },
        "status": {
          "type": "string",
          "pattern": "(PENDING|RUNNING|SUCCESS|FAILED)",
          "example": "PENDING",
          "description": "**参数说明**:任务状态。\n**取值范围**:\n- PENDING:等待执行\n- RUNNING:执行中\n- SUCCESS:执行成功\n- FAILED:执行失败"
        },
        "status_detail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1028,
          "description": "**参数说明**:任务状态描述。"
        },
        "create_time": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "example": "2020-08-19T01:52:49.492Z",
          "description": "**参数说明**:实例任务的创建时间。格式为:\"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\""
        },
        "start_time": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "example": "2020-08-19T01:52:49.492Z",
          "description": "**参数说明**:实例任务的开始时间。格式为:\"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\""
        },
        "end_time": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "example": "2020-08-19T01:53:49.492Z",
          "description": "**参数说明**:实例任务的结束时间。格式为:\"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\""
        },
        "target_config": {
          "$ref": "#/definitions/TargetConfig"
        },
        "operate_window": {
          "$ref": "#/definitions/OperateWindow"
        },
        "progress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "example": 100,
          "description": "**参数说明**:任务进度\""
        }
      }
    }
  },
