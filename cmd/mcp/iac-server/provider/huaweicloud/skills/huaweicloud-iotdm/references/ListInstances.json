{
  "name": "ListInstances",
  "summary": "查询实例列表",
  "tags": "实例管理",
  "productshort": "IoTDM",
  "region_id": "ru-moscow-1",
  "paths": {
    "/v5/iot/{project_id}/iotda-instances": {
      "get": {
        "description": "用户可以调用此接口查询设备接入实例列表。",
        "tags": [
          "InstanceManagement"
        ],
        "summary": "查询实例列表",
        "operationId": "ListInstances",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-iftype": "OpenAPI_new",
        "x-apig-name": "IoTDA_OpenAPI",
        "x-imports": [
          "org.springframework.http.ResponseEntity"
        ],
        "x-returnType": "ResponseEntity<QueryInstances>",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数说明**:项目ID。获取方法请参见 [获取项目ID](https://support.huaweicloud.com/api-iothub/iot_06_v5_1001.html) 。",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{1,32}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数说明**:用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "x-effective-scene": "huaweicloud"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "x-example": "0",
            "minimum": 0,
            "maximum": 500,
            "description": "**参数说明**:表示从marker后偏移offset条记录开始查询。默认为0,取值范围为0-500的整数。当offset为0时,表示从marker后第一条记录开始输出。 - 限制offset最大值是出于API性能考虑,您可以搭配marker使用该参数实现翻页,例如每页50条记录,1-11页内都可以直接使用offset跳转到指定页,但到11页后,由于offset限制为500,您需要使用第11页返回的marker作为下次查询的marker,以实现翻页到12-22页。 取值范围:0-500的整数,默认为0。"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 500,
            "x-example": "500",
            "minimum": 1,
            "maximum": 500,
            "description": "**参数说明**:分页查询时每页显示的记录数。\n**取值范围**:1-500的整数,默认为500。"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "上一次分页查询结果中最后一条记录的ID,在上一次分页查询时由物联网平台返回获得。分页查询时物联网平台是按marker也就是记录ID降序查询的,越新的数据记录ID也会越大。若填写marker,则本次只查询记录ID小于marker的数据记录。若不填写,则从记录ID最大也就是最新的一条数据开始查询。如果需要依次查询所有数据,则每次查询时必须填写上一次查询响应中的marker值。",
            "required": false,
            "pattern": "^[a-fA-F0-9]{1,20}$",
            "default": "ffffffffffffffffff",
            "type": "string"
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-\\一-\\龥]{1,64}$",
            "x-example": "iotda_instance",
            "description": "**参数说明**:设备接入实例名称,匹配规则为模糊匹配。\n**取值范围**:由中文字符,英文字母、数字及“_”、“-”组成,且长度为[1-64]个字符。"
          },
          {
            "name": "instance_type",
            "in": "query",
            "required": false,
            "type": "string",
            "pattern": "(standard|basic|enterprise|valueaddedservice)",
            "x-example": "standard",
            "description": "**参数说明**:实例类型。\n**取值范围**:\n- standard:标准版实例\n- enterprise:企业版实例"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/QueryInstances"
            },
            "x-SuccessCode": true,
            "examples": {
              "application/json": {
                "count": 1,
                "marker": 1805431584415871305,
                "instances": [
                  {
                    "instance_type": "standard",
                    "instance_id": "8561675c-d8a3-4956-9884-9cf9cbdd3134",
                    "name": "iotda_instance",
                    "charge_mode": "prePaid",
                    "flavor": {
                      "type": "iotda.standard.s1",
                      "size": 1
                    },
                    "status": "ACTIVE",
                    "create_time": "2023-01-28T06:57:52Z",
                    "update_time": "2023-01-28T06:57:52Z",
                    "enterprise_project_id": "d22e47e9-cfad-4254-8a29-d2a56a07681d"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v5/iot/{project_id}/iotda-instances",
        "x-request-examples-description-1": "列表查询所有实例。"
      }
    }
  },
  "definitions": {
    "Flavor": {
      "type": "object",
      "title": "产品规格参数结构体",
      "description": "**参数说明**:设备接入实例的规格参数。",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "example": "iotda.standard.s1",
          "pattern": "^[A-Za-z0-9-.]{1,64}$",
          "description": "**参数说明**:待创建设备接入实例的规格名称。详情请参见[产品规格说明](https://support.huaweicloud.com/productdesc-iothub/iot_04_0014.html)中的规格编码。"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "example": 1,
          "description": "**参数说明**:待创建设备接入标准版实例的单元数量。详情请参见[产品规格说明](https://support.huaweicloud.com/productdesc-iothub/iot_04_0014.html)。当instance_type是standard时,该参数必填。"
        }
      }
    },
    "QueryInstances": {
      "type": "object",
      "title": "查询实例列表响应结构体",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "**参数说明**:设备接入实例的总数。"
        },
        "marker": {
          "type": "string",
          "description": "**参数说明**:本次分页查询结果中最后一条记录的ID,可在下一次分页查询时使用。",
          "maxLength": 20,
          "minLength": 0
        },
        "instances": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "description": "**参数说明**:设备接入实例的详情列表。",
          "items": {
            "$ref": "#/definitions/QueryInstanceSimplify"
          }
        }
      }
    },
    "QueryInstanceSimplify": {
      "type": "object",
      "title": "查询实例简单信息结构体",
      "properties": {
        "instance_type": {
          "type": "string",
          "pattern": "(standard|basic|enterprise|valueaddedservice)",
          "example": "standard",
          "description": "**参数说明**:实例类型。\n**取值范围**:\n- standard:标准版实例\n- enterprise:企业版实例"
        },
        "instance_id": {
          "type": "string",
          "pattern": "[0-9a-f-]{1,36}",
          "description": "**参数说明**:实例ID。\n**取值范围**:长度不超过36,由小写字母[a-f]、数字、连接符(-)的组成。"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_\\-\\一-\\龥]{1,64}$",
          "description": "**参数说明**:实例名称\n**取值范围**:由中文字符,英文字母、数字及“_”、“-”组成,且长度为[1-64]个字符。"
        },
        "charge_mode": {
          "type": "string",
          "pattern": "prePaid|postPaid",
          "example": "prePaid",
          "description": "**参数说明**:实例的付费方式。\n**取值范围**:\n- prePaid:包年/包月\n- postPaid:按需计费"
        },
        "flavor": {
          "$ref": "#/definitions/Flavor"
        },
        "status": {
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "example": "ACTIVE",
          "description": "**参数说明**:实例状态。\n**取值范围**:\n- CREATING:实例正在创建\n- ACTIVE:实例正常\n- FROZEN:实例冻结\n- TRADING: 实例正在进行交易\n- MODIFYING:实例正在变更规格\n- MODIFY_FAILED: 实例变更失败\n- FAILED:实例创建失败"
        },
        "create_time": {
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "description": "**参数说明**:实例的创建时间。时间格式例如:2023-01-28T06:57:52Z。"
        },
        "update_time": {
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "description": "**参数说明**:实例的最近一次更新的时间。时间格式例如:2023-01-28T06:57:52Z。"
        },
        "enterprise_project_id": {
          "type": "string",
          "example": "d22e47e9-cfad-4254-8a29-d2a56a07681d",
          "pattern": "[0-9a-f-]{1,36}",
          "description": "**参数说明**:企业项目Id。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
