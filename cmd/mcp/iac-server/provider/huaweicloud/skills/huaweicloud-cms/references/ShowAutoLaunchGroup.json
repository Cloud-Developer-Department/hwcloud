    "ShowAutoLaunchGroupResp": {
      "required": [
        "allocation_strategy",
        "created_at",
        "current_capacity",
        "current_stable_capacity",
        "excess_fulfilled_capacity_behavior",
        "instances_behavior_with_expiration",
        "name",
        "region_specs",
        "stable_capacity",
        "target_capacity",
        "type",
        "user_id",
        "valid_since",
        "valid_until",
        "status",
        "task_state"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "智能购买组名称",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "description": "请求类型。枚举值\nrequest:一次性。仅在启动时交付实例集群,调度失败后不再重试。\nmaintain:持续供应。在启动时尝试交付实例集群,并监控实时容量,未达到目标容量则尝试继续创建ECS实例",
          "minLength": 1,
          "maxLength": 64,
          "enum": [
            "request",
            "maintain"
          ],
          "default": "request"
        },
        "status": {
          "type": "string",
          "description": "智能购买组的运行状态,枚举值\nSUBMITTED:已提交\nACTIVE:运行中\nDELETING:删除中\nDELETED:已删除"
        },
        "task_state": {
          "type": "string",
          "description": "智能购买组的任务状态,枚举值\nHANDLING:购买中\nFULFILLED:智能购买组已满配\nERROR:智能购买组异常"
        },
        "target_capacity": {
          "type": "integer",
          "format": "int32",
          "description": "智能购买组目标容量.\n实例数量或者CPU个数,目标容量大于等于stable_capacity。竞价实例的容量为满配容量减去stable_capacity",
          "minimum": 0,
          "maximum": 10000,
          "default": 0
        },
        "stable_capacity": {
          "type": "integer",
          "format": "int32",
          "description": "按需实例目标容量\n目标容量指实例数量或CPU个数,必须小于等于target_capacity,智能购买组中可以没有按需实例",
          "minimum": 0,
          "maximum": 10000,
          "default": 0
        },
        "current_capacity": {
          "type": "integer",
          "format": "int32",
          "description": "当前已经购买成功的总算力",
          "minimum": 0,
          "maximum": 10000,
          "default": 0
        },
        "current_stable_capacity": {
          "type": "integer",
          "format": "int32",
          "description": "当前已经购买成功的按需算力",
          "minimum": 0,
          "maximum": 10000,
          "default": 0
        },
        "excess_fulfilled_capacity_behavior": {
          "type": "string",
          "description": "超过目标容量或目标容量减少时的实例中断行为,枚举值\nterminate:释放\nnoTermination:不释放",
          "minLength": 1,
          "maxLength": 64,
          "enum": [
            "noTermination",
            "terminate"
          ],
          "default": "terminate"
        },
        "instances_behavior_with_expiration": {
          "type": "string",
          "description": "请求到期时的实例中断行为,枚举值\nterminate:释放\nnoTermination:不释放",
          "minLength": 1,
          "maxLength": 64,
          "enum": [
            "terminate",
            "noTermination"
          ],
          "default": "terminate"
        },
        "valid_since": {
          "type": "string",
          "format": "date-time",
          "description": "请求开始时间,格式为yyyy-MM-ddTHH:mm:ssZ"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time",
          "description": "请求结束时间,格式为yyyy-MM-ddTHH:mm:ssZ"
        },
        "region_specs": {
          "type": "array",
          "description": "智能购买组在各个区域的配置",
          "items": {
            "description": "",
            "$ref": "#/definitions/RegionSpec"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "allocation_strategy": {
          "type": "string",
          "description": "实例分配策略,枚举值\nlowest_price:价格最低策略,智能购买组购买的所有实例的价格总和最低。\nprioritized:优先级策略,按照规格设定的优先级创建实例。\ncapacity_optimized:容量最优化策略,智能购买组购买的实例按照大规格优先进行购买。",
          "minLength": 1,
          "maxLength": 64,
          "enum": [
            "lowest_price",
            "diversified",
            "prioritized",
            "capacity_optimized"
          ],
          "default": "lowest_price"
        },
        "spot_price": {
          "type": "number",
          "format": "double",
          "description": "用户愿意为竞价实例每小时支付的最高价格。如果overrides中没有提供价格,可以使用该价格。",
          "minimum": 0,
          "maximum": 1000
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "智能购买组创建时间"
        }
      },
      "description": "智能购买组信息"
    },
