          }
        }
      },
      "description": "This is a auto create Response Object"
    },
    "FlavorConstraint": {
      "properties": {
        "architecture_type": {
          "type": "array",
          "description": "接受的体系结构描述",
          "items": {
            "type": "string",
            "description": "",
            "enum": [
              "x86_64",
              "arm64"
            ]
          }
        },
        "flavor_requirements": {
          "type": "array",
          "description": "资源的需求约束",
          "items": {
            "description": "",
            "$ref": "#/definitions/FlavorRequirement"
          }
        }
      },
      "description": "资源规格的筛选约束"
    },
    "SupplyOption": {
      "properties": {
        "result_granularity": {
          "type": "string",
          "description": "推荐结果的粒度\nBY_REGION:对每个区域打分,可使用多种规格满足需求\nBY_AZ:对每个可用区打分\nBY_FLAVOR:对每个规格打分,可使用多地域满足需求\nBY_FLAVOR_AND_REGION:对每个区域下的每个规格打分\nBY_FLAVOR_AND_AZ:对每个可用区下的每个规格打分",
          "enum": [
            "BY_REGION",
            "BY_AZ",
            "BY_FLAVOR",
            "BY_FLAVOR_AND_REGION",
            "BY_FLAVOR_AND_AZ"
