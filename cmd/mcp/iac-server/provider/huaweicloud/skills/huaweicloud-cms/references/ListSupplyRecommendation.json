    "DoubleRange": {
      "properties": {
        "max": {
          "type": "number",
          "format": "double",
          "description": "最大值,-1表示无限制",
          "default": 999999999.9
        },
        "min": {
          "type": "number",
          "format": "double",
          "description": "最小值,-1表示无限制",
          "default": 0
        }
      },
      "description": "资源取值范围,最大值最小值可取。\n约束:min<=max"
    },
