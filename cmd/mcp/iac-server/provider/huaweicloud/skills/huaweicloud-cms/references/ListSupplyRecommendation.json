          "type": "string",
          "description": "实例规格ID"
        },
        "region_id": {
          "type": "string",
          "description": "区域ID"
        },
        "availability_zone_id": {
          "type": "string",
          "description": "可用区ID"
        },
        "score": {
          "type": "integer",
          "format": "int32",
          "description": "推荐分数",
          "minimum": 1,
          "maximum": 10
