{
  "name": "ShowQuotas",
  "summary": "查询配额",
  "tags": "配额管理",
  "productshort": "DC",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/dcaas/quotas": {
      "get": {
        "tags": [
          "QuotaManager"
        ],
        "summary": "查询配额",
        "description": "查询租户各类资源的使用情况,如Directconnect的使用量,虚拟接口的使用量等。",
        "operationId": "ShowQuotas",
        "x-huawei-security": {
          "epsAction": "list",
          "enableEProject": true
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "name": "type",
            "in": "query",
            "description": "支持过滤的配额类型:\n- physicalConnect:  物理连接direct_connect实例的配额和使用量\n- virtualInterface: 虚拟接口virtual-interface的配额和使用量\n- connectGateway: 连接网关(用于关联GEIP)的配额和使用量\n- geip: 每租户可以关联GEIP的配额和使用量\n- globalDcGateway 专线全域接入网关的配额和使用量\n- peerLinkPerGdgw: 接入网关的关联连接的配额和使用量",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "查询配额成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowQuotasResponseBody"
                },
                "example": {
                  "request_id": "7e41b3413985e7a1de1701fe09cc05c9",
                  "quotas": {
                    "resources": [
                      {
                        "type": "physicalConnect",
                        "quota": 300,
                        "used": 60
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "x-request-examples-description-1": "查询配额信息",
        "x-request-examples-url-1": "GET https://{dc_endpoint}/v3/08d5a9564a704afda6039ae2babbef3c/dcaas/quotas?type=physicalConnect",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "false",
        "x-open-region-cloud": "hws,hws_hk,cmcc,ocb,hws_eu"
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "dcaas.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v3",
  "method": "get",
  "uri": null
}