              "schema": {
                "$ref": "#/components/schemas/CreateSwitchoverTestRequestBody"
              },
              "example": {
                "switchover_test_record": {
                  "resource_type": "virtual_interface",
                  "resource_id": "d0b3329c-0063-470c-b1dc-657656b2e540",
                  "operation": "shutdown"
