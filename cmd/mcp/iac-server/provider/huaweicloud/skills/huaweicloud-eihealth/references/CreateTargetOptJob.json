{
  "name": "CreateTargetOptJob",
  "summary": "创建靶点优化作业",
  "tags": "靶点优化作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-jobs/target-optimization": {
      "post": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-ut-partial": true,
        "x-interface-name": "ITargetOptJobController",
        "tags": [
          "靶点优化作业管理"
        ],
        "summary": "创建靶点优化作业",
        "description": "创建靶点优化作业",
        "operationId": "CreateTargetOptJob",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "in": "body",
            "name": "CreateTargetOptJobRequestBody",
            "description": "CreateTargetOptJobRequestBody",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateTargetOptJobReq"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "CREATED",
            "schema": {
              "$ref": "#/definitions/DrugJobIdRsp"
            },
            "x-response-examples-1": {
              "application/json": {
                "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1"
              }
            },
            "x-response-examples-description-1": "创建靶点优化作业成功",
            "x-response-examples-2": {
              "application/json": {
                "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                "limit_concurrency": 50
              }
            },
            "x-response-examples-description-2": "创建靶点优化作业成功,当前运行作业数已达配额限制,此作业会等待"
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-jobs/target-optimization",
        "x-request-examples-description-1": "创建靶点优化作业,作业名称为demo-job,受体文件为project:/dir/file,配体文件为project:/dir/file,时间步长为2fs,温度为300k,能量最小化步数为10000,nvt为200ps,npt为500ps,平衡步骤模拟时长为50ns",
        "x-request-examples-1": {
          "basic_info": {
            "name": "demo-job",
            "labels": [
              "labelA"
            ]
          },
          "receptor": {
            "file": {
              "source": "PRIVATE",
              "url": "project:/dir/file"
            },
            "balanced_charge": true,
            "water_model": "tip3p",
            "force_field": "amber99sb",
            "ion_type": "NaCl",
            "ion_concentration": 0.15
          },
          "ligand": {
            "file": {
              "source": "PRIVATE",
              "url": "project:/dir/file"
            },
            "force_field": "gaff"
          },
          "md_params": {
            "timestep_size": 2,
            "temperature": 300,
            "step_params": {
              "energy_minimization_steps": 10000,
              "nvt": 200,
              "npt": 500,
              "simulation_time": 50
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ProbeDrugFile": {
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/DrugFileSource",
          "example": "RAW"
        },
        "url": {
          "type": "string",
          "description": "文件URL,当数据源为外部网络数据时为https地址;用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "pattern": ".*\\.(pdb|mol2|sdf)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB|SDF|MOL2)$",
          "description": "文件格式,支持PDB、SDF、MOL2,仅数据源为RAW时提供"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "文件原始数据,仅数据源为RAW时提供"
        }
      }
    },
    "CreateDrugJobBasicInfo": {
      "type": "object",
      "required": [
        "name"
      ],
      "description": "创建药物作业基本信息",
      "properties": {
        "name": {
          "type": "string",
          "example": "demo-job",
          "minLength": 5,
          "maxLength": 64,
          "pattern": "^[a-z0-9A-Z]+[a-z0-9A-Z-_\\s]+$",
          "x-pattern-message": "The name format does not match.",
          "description": "作业的名称,取值范围:[5,64],允许大小写字母、数字、空格、下划线(_)和中划线(-),只能以数字或字母开头"
        },
        "labels": {
          "type": "array",
          "example": [
            "labelA",
            "labelB"
          ],
          "description": "标签,取值范围[0,5],单个标签最大长度32字符,支持中文、字母、数字、空格、下划线和中划线,且不能以空格开头或者结尾。",
          "items": {
            "type": "string",
            "pattern": "^[\\一-\\龥A-Za-z0-9-_]+(\\s+[\\一-\\龥A-z0-9-_]+)*$",
            "maxLength": 32,
            "minLength": 1,
            "x-pattern-message": "The label name format does not match"
          },
          "minItems": 0,
          "maxItems": 5
        },
        "upstream_job_info": {
          "type": "string",
          "maxLength": 10240,
          "minLength": 1,
          "example": "{\"job_id\":\"demo-job-id\",\"job_name\":\"demo-job-name\"}",
          "description": "**参数解释**:\n上游作业信息。\n**约束限制**:\n不涉及\n**取值范围**:\n长度为[1-10240]个字符。\n**默认取值**:\n不涉及"
        }
      }
    },
    "CreateTargetOptJobReq": {
      "type": "object",
      "required": [
        "basic_info",
        "receptor"
      ],
      "properties": {
        "basic_info": {
          "$ref": "#/definitions/CreateDrugJobBasicInfo"
        },
        "receptor": {
          "$ref": "#/definitions/TargetOptReceptor",
          "description": "受体文件"
        },
        "ligand": {
          "$ref": "#/definitions/TargetOptLigand",
          "description": "配体文件"
        },
        "md_params": {
          "$ref": "#/definitions/MdParam",
          "description": "MD参数配置"
        }
      },
      "description": "创建靶点优化作业请求体"
    },
    "TargetOptLigand": {
      "type": "object",
      "description": "配体设置",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "$ref": "#/definitions/ProbeDrugFile",
          "description": "配体文件"
        },
        "force_field": {
          "type": "string",
          "default": "gaff",
          "description": "配体力场, 支持选择gaff, gaff2",
          "pattern": "^(gaff|gaff2)$"
        }
      }
    },
    "ReceptorDrugFile": {
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/DrugFileSource",
          "example": "RAW"
        },
        "url": {
          "type": "string",
          "description": "文件URL,当数据源为外部网络数据时为https地址;用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "pattern": ".*\\.(pdb)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB)$",
          "description": "文件格式,仅支持PDB,仅数据源为RAW时提供"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "文件原始数据,仅数据源为RAW时提供",
          "x-ut-exclude-equivalence": [
            "NULL"
          ]
        }
      }
    },
    "DrugJobIdRsp": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "作业id"
        },
        "limit_concurrency": {
          "type": "integer",
          "format": "int32",
          "example": 50,
          "description": "限制的并发量"
        }
      }
    },
    "MdStepParam": {
      "description": "MD计算步骤配置",
      "type": "object",
      "properties": {
        "energy_minimization_steps": {
          "type": "integer",
          "format": "int32",
          "description": "能量最小化的步骤",
          "default": 10000,
          "example": 10000,
          "minimum": 1,
          "maximum": 50000
        },
        "nvt": {
          "type": "number",
          "format": "float",
          "description": "等温等体步骤模拟的时长,单位ps",
          "example": 200,
          "default": 200,
          "minimum": 0,
          "maximum": 1000.0,
          "exclusiveMinimum": true,
          "x-ut-exclude-equivalence": [
            "INVALID",
            "OUT_LOWER_BOUND",
            "OUT_UPPER_BOUND"
          ]
        },
        "npt": {
          "type": "number",
          "format": "float",
          "description": "等压等温步骤模拟的时长,单位ps",
          "example": 500,
          "default": 500,
          "minimum": 0,
          "maximum": 1000.0,
          "exclusiveMinimum": true,
          "x-ut-exclude-equivalence": [
            "INVALID",
            "OUT_LOWER_BOUND",
            "OUT_UPPER_BOUND"
          ]
        },
        "simulation_time": {
          "type": "number",
          "format": "float",
          "description": "平衡步骤模拟的时长,单位ns",
          "example": 50,
          "default": 50,
          "minimum": 0,
          "maximum": 50.0,
          "exclusiveMinimum": true,
          "x-ut-exclude-equivalence": [
            "INVALID",
            "OUT_LOWER_BOUND",
            "OUT_UPPER_BOUND"
          ]
        }
      }
    },
    "MdParam": {
      "description": "靶点优化MD参数配置",
      "type": "object",
      "properties": {
        "timestep_size": {
          "type": "number",
          "format": "float",
          "description": "MD模拟的时间步长,单位fs,取值范围:大于0,小于等于5",
          "default": 2,
          "example": 2,
          "minimum": 0,
          "maximum": 5.0,
          "exclusiveMinimum": true,
          "x-ut-exclude-equivalence": [
            "INVALID",
            "OUT_LOWER_BOUND",
            "OUT_UPPER_BOUND"
          ]
        },
        "temperature": {
          "type": "number",
          "format": "float",
          "description": "MD模拟的温度,单位K",
          "default": 300,
          "example": 300,
          "minimum": 0,
          "maximum": 1000.0,
          "exclusiveMinimum": true,
          "x-ut-exclude-equivalence": [
            "INVALID",
            "OUT_LOWER_BOUND",
            "OUT_UPPER_BOUND"
          ]
        },
        "step_params": {
          "$ref": "#/definitions/MdStepParam",
          "description": "计算步骤参数"
        }
      }
    },
    "DrugFileSource": {
      "type": "string",
      "enum": [
        "EXTRANET",
        "PRIVATE",
        "PUBLIC",
        "RAW"
      ],
      "description": "受体的数据源:外部网络数据(如RCSB在线数据库)、用户私有数据中心、承载租户公共数据(含样例/公共库)"
    },
    "TargetOptReceptor": {
      "type": "object",
      "description": "靶点设置",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "$ref": "#/definitions/ReceptorDrugFile",
          "description": "受体文件"
        },
        "balanced_charge": {
          "type": "boolean",
          "default": true,
          "description": "是否平衡电荷"
        },
        "water_model": {
          "type": "string",
          "default": "tip3p",
          "description": "水模型, 支持选择spc, spce, tip3p, tip4p, tip5p",
          "pattern": "^(spc|spce|tip3p|tip4p|tip5p)$"
        },
        "force_field": {
          "type": "string",
          "default": "amber99sb",
          "description": "蛋白立场,支持选择amber03, amber94, amber96, amber99, amber99sb, amber99sb-ildn, amberGS, charmm27, oplsaa, gromos43a1, gromos43a2, gromos45a3, gromos53a5, gromos53a6, gromos54a7",
          "pattern": "^(amber03|amber94|amber96|amber99|amber99sb|amber99sb-ildn|amberGS|charmm27|oplsaa|gromos43a1|gromos43a2|gromos45a3|gromos53a5|gromos53a6|gromos54a7)$"
        },
        "ion_type": {
          "type": "string",
          "default": "NaCl",
          "description": "离子种类,支持选择NaCl、MgCl2、None,若设置了平衡电荷不支持选择None",
          "pattern": "^(NaCl|MgCl2|None)$"
        },
        "ion_concentration": {
          "type": "number",
          "format": "float",
          "description": "离子浓度,单位mol/L,若离子种类设置为None离子浓度不支持设置",
          "default": 0.15,
          "example": 0.15,
          "minimum": 0,
          "maximum": 5.0,
          "exclusiveMinimum": true,
          "x-ut-exclude-equivalence": [
            "INVALID",
            "OUT_LOWER_BOUND",
            "OUT_UPPER_BOUND"
          ]
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}