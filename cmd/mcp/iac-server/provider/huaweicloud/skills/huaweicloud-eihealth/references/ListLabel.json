{
  "name": "ListLabel",
  "summary": "获取标签列表",
  "tags": "标签管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/system/labels": {
      "get": {
        "x-interface-name": "ILabelController",
        "tags": [
          "标签管理"
        ],
        "summary": "获取标签列表",
        "description": "获取标签列表",
        "operationId": "ListLabel",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "count": 1,
                "labels": [
                  {
                    "id": "id",
                    "name": "label1",
                    "description": "测试标签",
                    "creator": "user1",
                    "create_time": "2021-02-01T14:25:34.000+00:00",
                    "update_time": "2021-02-01T14:25:34.000+00:00"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListLabelRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "获取系统标签列表",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/system/labels"
      }
    }
  },
  "definitions": {
    "ListLabelRsp": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 0,
          "description": "标签列表个数"
        },
        "labels": {
          "type": "array",
          "description": "标签详情",
