{
  "name": "CreateFavorite",
  "summary": "添加收藏",
  "tags": "收藏管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/favorites": {
      "post": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-ut-partial": true,
        "operationId": "CreateFavorite",
        "x-interface-name": "IFavoriteController",
        "tags": [
          "收藏管理"
        ],
        "summary": "添加收藏",
        "description": "添加收藏。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "name": "CreateFavoriteRequestBody",
            "in": "body",
            "required": true,
            "description": "添加收藏请求体。",
            "schema": {
              "$ref": "#/definitions/CreateFavoriteReq"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "添加收藏成功响应",
            "schema": {
              "$ref": "#/definitions/CreateFavoriteRsp"
            },
            "examples": {
              "application/json": {
                "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1"
              }
            }
          }
        },
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/favorites",
        "x-request-examples-description-1": "添加收藏分子类型。",
        "x-request-examples-1": {
          "type": "MOLECULE",
          "resource_id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "resource_type": "OPTIMIZATION",
          "resource_name": "demo-resource",
          "display_info": "{\"smiles\":\"c1ccccc1\",\"molecule_name\":\"AA-173/40757587\"}",
          "location_info": "{\"receptor_idx\":\"1\",\"result_idx\":\"1\"}"
        }
      }
    }
  },
  "definitions": {
    "CreateFavoriteReq": {
      "description": "添加收藏请求体。",
      "required": [
        "type",
        "resource_id",
        "resource_name",
        "resource_type",
        "display_info",
        "location_info"
      ],
      "properties": {
        "type": {
          "description": "收藏类型。",
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^(MICROMOLECULE|PROTEIN)$",
          "x-pattern-message": "Type only supports MICROMOLECULE and PROTEIN.",
          "example": "MICROMOLECULE"
        },
        "resource_id": {
          "description": "收藏的资源ID。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]*$",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1"
        },
        "resource_name": {
          "description": "收藏的资源名称,正则匹配中文,英文字母和数字及下划线。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "example": "demo-resource",
          "pattern": "^[\\一-\\龥\\sA-Za-z0-9-_]*$"
        },
        "resource_type": {
          "description": "收藏的资源类型,正则匹配英文字母和数字及下划线。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "example": "OPTIMIZATION",
          "pattern": "^[A-Za-z0-9-_]*$"
        },
        "display_info": {
          "description": "展示信息。",
          "type": "string",
          "minLength": 1,
          "maxLength": 65535,
          "example": "{\"smiles\":\"c1ccccc1\",\"molecule_name\":\"AA-173/40757587\"}"
        },
        "location_info": {
          "description": "定位信息。",
          "type": "string",
          "minLength": 1,
          "maxLength": 65535,
          "example": "{\"receptor_idx\":\"1\",\"result_idx\":\"1\"}"
        }
      }
    },
    "CreateFavoriteRsp": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "收藏记录ID。"
        }
      },
      "description": "创建收藏响应体。"
    }
  },
  "version": "2.0",
