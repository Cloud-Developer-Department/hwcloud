{
  "name": "ListBaseModel",
  "summary": "获取基模型列表",
  "tags": "药物模型管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/base-models": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-interface-name": "IDrugModelController",
        "x-ut-partial": true,
        "tags": [
          "药物模型管理"
        ],
        "summary": "获取基模型列表",
        "description": "获取基模型列表",
        "operationId": "ListBaseModel",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制量,单次查询总量,必须由数字组成,默认为100,取值范围[1,1000]",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 100,
            "maximum": 1000,
            "minimum": 1
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,查询起始偏移,必须由数字组成,默认为0,取值范围[0,100000000]",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 100000000,
            "minimum": 0
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序规则 目前默认时间升序",
            "required": false,
            "type": "string",
            "default": "ASC",
            "x-enum-type": "SortDir"
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序规则 目前默认时间升序,支持根据create_time排序",
            "required": false,
            "type": "string",
            "default": "create_time",
            "x-enum-type": "BaseModelSortKey"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListBaseModelRsp"
            },
            "examples": {
              "application/json": {
                "count": 1,
                "models": [
                  {
                    "id": "56e0f1b0-ac10-46a5-8fa7-b26831d7d488",
                    "name": "demo_name",
                    "description": "description",
                    "create_time": "2021-01-30T02:34:36Z",
                    "creator": "demo-user"
                  }
                ]
              }
            }
          }
        },
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/base-models",
        "deprecated": false
      }
    }
  },
  "definitions": {
    "BaseModelDto": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "model_name",
          "description": "模型名称"
        },
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "模型ID"
        },
        "create_time": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "模型创建时间"
        },
        "description": {
          "type": "string",
          "example": "description",
          "description": "模型描述信息"
        }
      }
    },
    "ListBaseModelRsp": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "description": "模型列表",
          "items": {
            "$ref": "#/definitions/BaseModelDto"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "模型总数"
        }
      },
      "description": "查询模型列表响应体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}