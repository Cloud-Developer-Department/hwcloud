{
  "name": "ShowUserSetting",
  "summary": "查询用户设置",
  "tags": "用户管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/users/{user_id}/settings": {
      "get": {
        "x-interface-name": "IUserController",
        "tags": [
          "用户管理"
        ],
        "summary": "查询用户设置",
        "description": "查询用户设置",
        "operationId": "ShowUserSetting",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "user_id",
            "in": "path",
            "description": "用户id",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "user_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "operation": "OPEN",
                "settings": {
                  "job_quota": 10,
                  "job_timeout": 1,
                  "cpu_quota": 50,
                  "mem_quota": 128,
                  "projects_per_user": 2
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/GetUserSettingRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "GetUserSettingRsp": {
      "properties": {
        "operation": {
          "description": "是否开启资源配额限制",
          "$ref": "#/definitions/Operation"
        },
        "settings": {
          "$ref": "#/definitions/UserSettingDto"
        }
      },
      "title": "GetUserSettingsRsp",
      "description": "获取用户设置返回体"
    },
    "Operation": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSE"
      ],
      "x-json-name": "operation"
    },
    "UserSettingDto": {
      "required": [
        "cpu_quota",
        "job_quota",
        "job_timeout",
        "mem_quota"
      ],
      "properties": {
        "job_quota": {
          "type": "integer",
          "format": "int32",
          "example": 10,
          "description": "允许同时运行的作业数",
          "minimum": 1,
          "maximum": 100
        },
        "job_timeout": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "作业执行超时时长,单位天",
          "minimum": 1,
          "maximum": 60
        },
        "cpu_quota": {
          "type": "integer",
          "format": "int32",
          "example": 50,
          "description": "作业的CPU资源配额,单位核",
          "minimum": 1,
          "maximum": 1024
        },
        "mem_quota": {
          "type": "integer",
          "format": "int32",
          "example": 128,
          "description": "作业的内存资源配额,单位GB",
          "minimum": 1,
          "maximum": 1024
        },
        "projects_per_user": {
          "type": "integer",
          "format": "int32",
          "example": 2,
          "description": "用户可创建项目数配额",
          "minimum": 0,
          "maximum": 20,
          "default": 2
        }
      },
      "title": "UpdateUserSettingsReq",
      "description": "更新用户请求体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}