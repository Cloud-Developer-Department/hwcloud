{
  "name": "GeneratePocketFile",
  "summary": "根据center、size、padding参数生成可渲染的口袋文件内容",
  "tags": "药物通用接口",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-common/toolkit/pocket": {
      "post": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-interface-name": "IDrugCommonController",
        "tags": [
          "药物通用接口"
        ],
        "summary": "根据center、size、padding参数生成可渲染的口袋文件内容",
        "description": "根据center、size、padding参数生成可渲染的口袋文件内容",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "operationId": "GeneratePocketFile",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "name": "GeneratePocketFileRequestBody",
            "in": "body",
            "required": true,
            "description": "口袋生成请求体",
            "schema": {
              "$ref": "#/definitions/RunPocketReq"
            }
          }
        ],
        "x-request-examples-1": {
          "center": [
            0,
            0,
            0
          ],
          "size": [
            10,
            10,
            10
          ],
          "padding": 6
        },
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/drug-common/toolkit/pocket",
        "x-request-examples-description-1": "设置口袋中心位置、大小和padding的值生成可渲染的口袋文件内容",
        "responses": {
          "200": {
            "description": "生成的口袋字符串",
            "schema": {
              "type": "string"
            },
            "examples": {
              "text/plain; charset=utf-8": "HEADER    CORNERS OF BOX\nREMARK    CENTER (X Y Z)   0.0  0.0  0.0\nREMARK    DIMENSIONS (X Y Z)   10.0  10.0  10.0\nATOM      1  DUA BOX     1     -11.000 -11.000 -11.000\nATOM      2  DUB BOX     1      11.000 -11.000 -11.000\nATOM      3  DUC BOX     1      11.000 -11.000  11.000\nATOM      4  DUD BOX     1     -11.000 -11.000  11.000\nATOM      5  DUE BOX     1     -11.000  11.000 -11.000\nATOM      6  DUF BOX     1      11.000  11.000 -11.000\nATOM      7  DUG BOX     1      11.000  11.000  11.000\nATOM      8  DUH BOX     1     -11.000  11.000  11.000\nCONECT    1    2    4    5\nCONECT    2    1    3    6\nCONECT    3    2    4    7\nCONECT    4    1    3    8\nCONECT    5    1    6    8\nCONECT    6    2    5    7\nCONECT    7    3    6    8\nCONECT    8    4    5    7\n"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "RunPocketReq": {
      "type": "object",
      "description": "RunPocket请求体",
      "required": [
        "center",
        "size",
        "padding"
      ],
      "properties": {
        "center": {
          "type": "array",
          "description": "口袋中心坐标",
          "example": [
            0,
            0,
            0
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "format": "float",
            "minimum": -9999999,
            "maximum": 99999999
          }
        },
        "size": {
          "type": "array",
          "description": "口袋大小",
          "example": [
            10,
            10,
            10
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "format": "float",
            "minimum": 2,
            "maximum": 500
          }
        },
        "padding": {
          "type": "number",
          "format": "float",
          "description": "口袋的padding值",
          "example": 6,
          "minimum": 0,
          "maximum": 20
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
