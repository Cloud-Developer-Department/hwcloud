{
  "name": "CreateClusteringJob",
  "summary": "创建聚类分析作业",
  "tags": "聚类分析作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-jobs/clustering": {
      "post": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-ut-partial": true,
        "x-interface-name": "IClusteringController",
        "tags": [
          "聚类分析作业管理"
        ],
        "summary": "创建聚类分析作业",
        "description": "创建聚类分析作业。",
        "operationId": "CreateClusteringJob",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。 Token认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "name": "CreateClusteringJobRequestBody",
            "in": "body",
            "required": true,
            "description": "CreateClusteringJobRequestBody",
            "schema": {
              "$ref": "#/definitions/CreateClusteringJobReq"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "CREATED",
            "schema": {
              "$ref": "#/definitions/DrugJobIdRsp"
            },
            "x-response-examples-1": {
              "application/json": {
                "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1"
              }
            },
            "x-response-examples-description-1": "创建聚类分析作业成功",
            "x-response-examples-2": {
              "application/json": {
                "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                "limit_concurrency": 50
              }
            },
            "x-response-examples-description-2": "创建聚类分析作业成功,当前运行作业数已达配额限制,此作业会等待"
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-jobs/{job_id}/clustering",
        "x-request-examples-description-1": "创建聚类分析作业,输入方式为分子文件,作业名称为demo-job",
        "x-request-examples-1": {
          "basic_info": {
            "name": "demo-job",
            "labels": [
              "labelA"
            ]
          },
          "file": {
            "source": "PRIVATE",
            "url": "project:/dir/file"
          }
        }
      }
    }
  },
  "definitions": {
    "CreateClusteringJobReq": {
      "type": "object",
      "description": "创建聚类分析作业请求体。",
      "required": [
        "basic_info",
        "file"
      ],
      "properties": {
        "basic_info": {
          "$ref": "#/definitions/CreateDrugJobBasicInfo",
          "description": "作业基本信息。"
        },
        "file": {
          "description": "分子文件。",
          "$ref": "#/definitions/ClusteringDrugFile"
        }
      }
    },
    "CreateDrugJobBasicInfo": {
      "type": "object",
      "required": [
        "name"
      ],
      "description": "创建药物作业基本信息",
      "properties": {
        "name": {
          "type": "string",
          "example": "demo-job",
          "minLength": 5,
          "maxLength": 64,
          "pattern": "^[a-z0-9A-Z]+[a-z0-9A-Z-_\\s]+$",
          "x-pattern-message": "The name format does not match.",
          "description": "作业的名称,取值范围:[5,64],允许大小写字母、数字、空格、下划线(_)和中划线(-),只能以数字或字母开头"
        },
        "labels": {
          "type": "array",
          "example": [
            "labelA",
            "labelB"
          ],
          "description": "标签,取值范围[0,5],单个标签最大长度32字符,支持中文、字母、数字、空格、下划线和中划线,且不能以空格开头或者结尾。",
          "items": {
            "type": "string",
            "pattern": "^[\\一-\\龥A-Za-z0-9-_]+(\\s+[\\一-\\龥A-z0-9-_]+)*$",
            "maxLength": 32,
            "minLength": 1,
            "x-pattern-message": "The label name format does not match"
          },
          "minItems": 0,
          "maxItems": 5
        },
        "upstream_job_info": {
          "type": "string",
          "maxLength": 10240,
          "minLength": 1,
          "example": "{\"job_id\":\"demo-job-id\",\"job_name\":\"demo-job-name\"}",
          "description": "**参数解释**:\n上游作业信息。\n**约束限制**:\n不涉及\n**取值范围**:\n长度为[1-10240]个字符。\n**默认取值**:\n不涉及"
        }
      }
    },
    "ClusteringFileSource": {
      "type": "string",
      "enum": [
        "PRIVATE",
        "PUBLIC",
        "RAW"
      ],
      "description": "受体的数据源:用户私有数据中心、承载租户公共数据(含样例/公共库)。"
    },
    "DrugJobIdRsp": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "作业id"
        },
        "limit_concurrency": {
          "type": "integer",
          "format": "int32",
          "example": 50,
          "description": "限制的并发量"
        }
      }
    },
    "ClusteringDrugFile": {
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/ClusteringFileSource",
          "example": "PRIVATE"
        },
        "url": {
          "type": "string",
          "description": "文件URL,当数据源为用户私有数据中心为项目路径,为公共数据场景时为obs地址。",
          "example": "https://eihealth-public-material.obs.cn-north-7.ulanqab.huawei.com/file.smi",
          "x-ut-exclude-equivalence": [
            "NULL"
          ],
          "pattern": ".*\\.(smi)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "SMI",
          "pattern": "SMI",
          "description": "文件格式,支持SMI,仅数据源为RAW时提供。"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "文件原始数据,仅数据源为RAW时提供。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
