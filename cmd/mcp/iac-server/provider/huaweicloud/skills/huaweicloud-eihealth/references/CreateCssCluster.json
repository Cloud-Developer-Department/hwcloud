{
  "name": "CreateCssCluster",
  "summary": "绑定CSS集群",
  "tags": "CSS集群管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/drug/css-clusters": {
      "post": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-interface-name": "IDrugCssClusterController",
        "tags": [
          "CSS集群管理"
        ],
        "summary": "绑定CSS集群",
        "description": "绑定CSS集群",
        "operationId": "CreateCssCluster",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "in": "body",
            "name": "CreateCssClusterRequestBody",
            "description": "绑定CSS集群请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateCssClusterReq"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "CREATED",
            "schema": {
              "$ref": "#/definitions/CssClusterIdRsp"
            },
            "examples": {
              "application/json": {
                "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1"
              }
            }
          }
        },
        "x-response-examples-description-1": "绑定CSS集群成功",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/drug/css-clusters",
        "x-request-examples-description-1": "绑定CSS资源,选择id为2f042ad4-6aca-11ed-b7f6-fa163e504fdd的CSS资源,集群管理员为admin,密码为user_pwd",
        "x-request-examples-1": {
          "css_id": "2f042ad4-6aca-11ed-b7f6-fa163e504fdd",
          "user_name": "admin",
          "user_pwd": "user_pwd"
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "CssClusterIdRsp": {
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "css集群id"
        }
      },
      "description": "创建css集群id响应体"
    },
    "CreateCssClusterReq": {
      "description": "绑定CSS集群请求体",
      "required": [
        "css_id",
        "user_name",
        "user_pwd"
      ],
      "properties": {
        "css_id": {
          "type": "string",
          "description": "集群id",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]*$",
          "x-pattern-message": "css_id is invalid",
          "example": "2f042ad4-6aca-11ed-b7f6-fa163e504fdd"
        },
        "user_name": {
          "type": "string",
          "description": "集群用户账号",
          "minLength": 4,
          "maxLength": 32,
          "example": "admin"
        },
        "user_pwd": {
          "type": "string",
          "description": "集群用户密码,长度限制为[8,32]",
          "minLength": 8,
          "maxLength": 32,
          "example": "Strong#Pwd56"
        }
      }
    }
  },
