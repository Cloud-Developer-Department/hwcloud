{
  "name": "ShowJobLog",
  "summary": "获取作业日志",
  "tags": "作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/jobs/{job_id}/logs": {
      "get": {
        "x-interface-name": "IJobController",
        "tags": [
          "作业管理"
        ],
        "summary": "获取作业日志",
        "description": "获取作业日志",
        "operationId": "ShowJobLog",
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is illegal"
          },
          {
            "name": "job_id",
            "in": "path",
            "description": "作业id",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "The job id format does not match."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "task_name",
            "in": "query",
            "description": "子任务名称",
            "required": true,
            "type": "string",
            "default": "task0",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "task_index",
            "in": "query",
            "description": "子任务并发的序号",
            "required": false,
            "type": "string",
            "default": "0",
            "maxLength": 128,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "count": 1,
                "logs": [
                  {
                    "collect_time": "2021-01-30T02:53:26Z",
                    "content": "eihealth"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/JobLogRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "LogContentDto": {
      "properties": {
        "collect_time": {
          "type": "string",
          "example": "2021-01-30T02:53:26Z",
          "description": "作业日志采集时间"
        },
        "content": {
          "type": "string",
          "example": "eihealth",
          "description": "作业日志内容"
        }
      }
    },
    "JobLogRsp": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "作业日志条数"
        },
        "logs": {
          "type": "array",
          "description": "作业日志内容列表",
          "items": {
            "$ref": "#/definitions/LogContentDto"
          }
        },
        "log_storage_link": {
          "type": "string",
          "description": "作业日志存储链接"
        }
      },
      "description": "查询作业日志响应体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}