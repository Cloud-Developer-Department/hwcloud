{
  "name": "ListUserWorkflow",
  "summary": "获取用户所属空间的流程列表",
  "tags": "流程管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/workflows": {
      "get": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-interface-name": "IWorkflowController",
        "tags": [
          "流程管理"
        ],
        "summary": "获取用户所属空间的流程列表",
        "description": "获取用户所属空间的流程列表。",
        "operationId": "ListUserWorkflow",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。 Token认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](ai4s_03_0011.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](ai4s_03_0023.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "is_creator",
            "in": "query",
            "required": false,
            "type": "boolean",
            "default": true,
            "description": "是否仅展示本人创建资源。"
          },
          {
            "name": "id",
            "in": "query",
            "description": "流程ID,仅支持精确搜索。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "id is invalid"
          },
          {
            "name": "name",
            "in": "query",
            "description": "流程名称,支持模糊搜索。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 56,
            "pattern": "^[a-z0-9A-Z-_]+$",
            "x-pattern-message": "The workflow name format does not match."
          },
          {
            "name": "summary",
            "in": "query",
            "description": "短描述,支持模糊搜索。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          {
            "name": "eihealth_project_names",
            "in": "query",
            "required": false,
            "description": "空间名称列表,多个值之间使用逗号分隔。",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 0,
            "maxItems": 10
          },
          {
            "name": "labels",
            "in": "query",
            "required": false,
            "description": "标签列表。",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[\\一-\\龥A-Za-z0-9-_]+(\\s+[\\一-\\龥A-Za-z0-9-_]+)*$",
              "maxLength": 32,
              "minLength": 1,
              "x-pattern-message": "labels is illegal"
            },
            "minItems": 0,
            "maxItems": 5
          },
          {
            "name": "start_create_time",
            "in": "query",
            "description": "开始创建时间。",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "end_create_time",
            "in": "query",
            "description": "结束创建时间。",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "start_update_time",
            "in": "query",
            "description": "开始更新时间。",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "end_update_time",
            "in": "query",
            "description": "结束更新时间。",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序规则。",
            "required": false,
            "type": "string",
            "default": "DESC",
            "x-enum-type": "SortDir"
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序规则,默认根据创建时间降序,支持根据create_time|update_time排序。",
            "required": false,
            "type": "string",
            "x-enum-type": "WorkflowSortKey"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制量,单次查询总量,必须由数字组成,默认为100,取值范围[1,1000]。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 100,
            "maximum": 1000,
            "minimum": 1
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,查询起始偏移,必须由数字组成,默认为0,取值范围[0,100000000]。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 100000000,
            "minimum": 0
          }
        ],
        "x-request-examples-description-1": "获取用户所属空间的流程列表。",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/workflows",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/WorkflowListRsp"
            },
            "examples": {
              "application/json": {
                "workflows": [
                  {
                    "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                    "name": "demo-workflow",
                    "eihealth_project_id": "d57g37ee-831d-4f64-afca-e2fd05f0824d",
                    "eihealth_project_name": "demo-project",
                    "version": "1.0.0",
                    "summary": "summary",
                    "description": "description",
                    "labels": [
                      "labelA",
                      "labelB"
                    ],
                    "create_time": "2021-01-30T02:34:36Z",
                    "update_time": "2021-01-30T02:53:26Z",
                    "user_name": "gwj-test-01"
                  }
                ],
                "count": 1
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
