{
  "name": "ListCceCluster",
  "summary": "获取CCE集群列表",
  "tags": "计算集群管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/system/cce-clusters": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-ut-partial": true,
        "x-interface-name": "IComputingClusterController",
        "tags": [
          "计算集群管理"
        ],
        "summary": "获取CCE集群列表",
        "description": "获取CCE集群列表。",
        "operationId": "ListCceCluster",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](ai4s_03_0011.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](ai4s_03_0023.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListCceClusterRsp"
            },
            "examples": {
              "application/json": {
                "count": 1,
                "clusters": [
                  {
                    "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                    "name": "cluster_name",
                    "status": "Available"
                  }
                ]
              }
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/system/cce-clusters?imit=10&offset=0",
        "x-request-examples-description-1": "获取CCE集群列表,查询起始偏移为0,单次查询总量为10。"
      }
    }
  },
  "definitions": {
    "ListCceClusterRsp": {
      "properties": {
        "clusters": {
          "type": "array",
          "description": "CCE集群列表。",
          "items": {
            "$ref": "#/definitions/CceClusterRsp"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "CCE集群集群总数。"
        }
      },
      "description": "查询最终租户计算集群列表响应体。"
    },
    "CceClusterRsp": {
      "description": "最终租户计算集群详情。",
      "properties": {
        "id": {
          "type": "string",
          "description": "计算集群ID。"
        },
        "name": {
          "type": "string",
          "description": "计算集群名称。"
        },
        "status": {
          "type": "string",
          "description": "计算集群状态。"
        },
        "version": {
          "type": "string",
          "description": "计算集群版本。"
        },
        "flavor": {
          "type": "string",
          "description": "计算集群规格。"
        },
        "category": {
          "type": "string",
          "description": "计算集群类别。CCE代表CCE集群,Turbo代表CCE Turbo集群。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}