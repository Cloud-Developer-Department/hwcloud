  "definitions": {
    "CreateMolBatchDownloadTaskReq": {
      "type": "object",
      "description": "创建分子或分子复合物批量下载任务请求体",
      "required": [
        "job_id",
        "job_result_url",
        "mode",
        "selected"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "作业ID",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "x-pattern-message": "job_id is invalid",
          "example": "1296790078dbc",
          "x-ut-exclude-equivalence": [
            "EFFECTIVE",
            "LOWER_BOUND",
            "UPPER_BOUND"
          ]
        },
        "job_result_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "作业结果文件url",
          "example": "ch-test:/job-results/docking/Molecule Docking-20230825-conformation-test-8f8a/result.json",
          "x-ut-exclude-equivalence": [
            "EFFECTIVE",
            "LOWER_BOUND"
          ]
        },
        "mode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 7,
          "description": "下载类型:MOL(小分子)、COMPLEX(复合物)",
          "example": "MOL",
          "pattern": "^MOL|COMPLEX$",
          "x-ut-exclude-equivalence": [
            "EFFECTIVE"
          ]
        },
        "format": {
          "type": "string",
          "minLength": 3,
          "maxLength": 6,
          "description": "**参数解释**:\n文件格式:pdb、sdf(仅下载小分子时支持此格式)。\n**约束限制**:\n不涉及\n**取值范围**:\n- pdb:pdb文件格式。\n- sdf:sdf文件格式,仅下载小分子时支持此格式。\n**默认取值**:\npdb",
          "default": "pdb",
          "example": "pdb",
          "pattern": "^pdb|sdf$"
        },
        "selected": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 1000000,
            "example": 1
          },
          "description": "选中下载的分子下标",
          "x-ut-exclude-equivalence": [
            "EFFECTIVE",
            "LOWER_BOUND"
          ]
        }
      }
    },
