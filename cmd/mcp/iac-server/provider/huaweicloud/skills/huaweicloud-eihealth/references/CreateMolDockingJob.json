{
  "name": "CreateMolDockingJob",
  "summary": "单分子预对接",
  "tags": "药物通用接口",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-common/mol-docking": {
      "post": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-interface-name": "IDrugCommonController",
        "tags": [
          "药物通用接口"
        ],
        "summary": "单分子预对接",
        "description": "单分子预对接。",
        "operationId": "CreateMolDockingJob",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "in": "body",
            "name": "CreateMolDockingJobRequestBody",
            "description": "单分子预对接请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateMolDockingJobReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "单分子预对接成功。",
            "schema": {
              "$ref": "#/definitions/MolDockingRsp"
            },
            "examples": {
              "application/json": {
                "vina_score": -5.05
              }
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-common/mol-docking",
        "x-request-examples-description-1": "单分子预对接,受体文件为project:/dir/file,配体文件为project:/dir/file。",
        "x-request-examples-1": {
          "receptor": {
            "receptor": {
              "source": "PRIVATE",
              "url": "project:/dir/file"
            },
            "bounding_box": {
              "center": [
                0,
                0,
                0
              ],
              "size": [
                10,
                10,
                10
              ]
            },
            "remove_water": true,
            "remove_ion": false,
            "remove_ligand": false,
            "add_hydrogen": true
          },
          "ligand": {
            "source": "PRIVATE",
            "url": "project:/dir/file"
          }
        }
      }
    }
  },
  "definitions": {
    "DrugFile": {
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/DrugFileSource",
          "example": "RAW"
        },
        "url": {
          "type": "string",
          "description": "文件URL,当数据源为外部网络数据时为https地址;用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "x-ut-exclude-equivalence": [
            "NULL"
          ],
          "pattern": ".*\\.(pdb|mol2|sdf|smi)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB|SDF|MOL2|SMI)$",
          "description": "文件格式,支持PDB、SDF、MOL2、SMI,仅数据源为RAW时提供"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "文件原始数据,仅数据源为RAW时提供"
        }
      }
    },
    "ReceptorDrugFile": {
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/DrugFileSource",
          "example": "RAW"
        },
        "url": {
          "type": "string",
          "description": "文件URL,当数据源为外部网络数据时为https地址;用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "pattern": ".*\\.(pdb)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB)$",
          "description": "文件格式,仅支持PDB,仅数据源为RAW时提供"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "文件原始数据,仅数据源为RAW时提供",
          "x-ut-exclude-equivalence": [
            "NULL"
          ]
        }
      }
    },
    "BoundBoxDto": {
      "required": [
        "center",
        "size"
      ],
      "type": "object",
      "description": "结合口袋,包含口袋中心位置和尺寸大小。",
      "properties": {
        "center": {
          "type": "array",
          "description": "口袋中心坐标,x、y、z轴的坐标。",
          "minItems": 3,
          "maxItems": 3,
          "example": [
            1.3,
            23.4,
            -14.5
          ],
          "items": {
            "type": "number",
            "format": "double",
            "minimum": -9999999,
            "maximum": 99999999
          }
        },
        "size": {
          "type": "array",
          "description": "口袋尺寸大小,x、y、z轴的大小。",
          "minItems": 3,
          "maxItems": 3,
          "example": [
            10.0,
            10.0,
            10.0
          ],
          "items": {
            "type": "number",
            "format": "float",
            "minimum": 2,
            "maximum": 500
          }
        },
        "padding": {
          "type": "number",
          "format": "float",
          "minimum": 0,
          "maximum": 20,
          "description": "填充。"
        }
      }
    },
    "MolDockingRsp": {
      "type": "object",
      "x-resource-id": "vina_score",
      "properties": {
        "vina_score": {
          "type": "number",
          "format": "float",
          "description": "对接打分结果。"
        },
        "pose": {
          "type": "string",
          "description": "对接构象。"
        }
      },
      "description": "单分子预对接响应体。"
    },
    "ReceptorDto": {
      "required": [
        "receptor"
      ],
      "type": "object",
      "description": "结合位点",
      "properties": {
        "name": {
          "description": "靶点名称。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]*$",
          "x-pattern-message": "bind site name is invalid",
          "example": "target1",
          "x-ut-exclude-equivalence": [
            "LOWER_BOUND",
            "NULL",
            "UPPER_BOUND"
          ]
        },
        "receptor": {
          "$ref": "#/definitions/ReceptorDrugFile",
          "description": "受体文件"
        },
        "bounding_box": {
          "$ref": "#/definitions/BoundBoxDto"
        },
        "remove_ion": {
          "type": "boolean",
          "description": "去除受体中的离子。",
          "default": true
        },
        "remove_water": {
          "type": "boolean",
          "description": "去除受体中的水分子。",
          "default": true
        },
        "remove_ligand": {
          "type": "boolean",
          "description": "去除受体中的配体分子。",
          "default": true
        },
        "add_hydrogen": {
          "type": "boolean",
          "default": false,
          "description": "增加氢原子。"
        }
      }
    },
    "CreateMolDockingJobReq": {
      "type": "object",
      "required": [
        "receptor",
        "ligand"
      ],
      "properties": {
        "receptor": {
          "$ref": "#/definitions/ReceptorDto",
          "description": "受体文件。"
        },
        "ligand": {
          "$ref": "#/definitions/DrugFile",
          "description": "配体文件。"
        },
        "engine": {
          "type": "string",
          "minLength": 0,
          "maxLength": 15,
          "pattern": "^(DSDP|AUTODOCK_VINA)$",
          "default": "AUTODOCK_VINA",
          "description": "引擎,默认为AUTODOCK_VINA。",
          "example": "AUTODOCK_VINA"
        }
      },
      "description": "单分子预对接请求体。"
    },
    "DrugFileSource": {
      "type": "string",
      "enum": [
        "EXTRANET",
        "PRIVATE",
        "PUBLIC",
        "RAW"
      ],
      "description": "受体的数据源:外部网络数据(如RCSB在线数据库)、用户私有数据中心、承载租户公共数据(含样例/公共库)"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
