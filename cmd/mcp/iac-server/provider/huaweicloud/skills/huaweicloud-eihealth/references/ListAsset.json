{
  "name": "ListAsset",
  "summary": "获取资产列表",
  "tags": "资产管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/assets": {
      "get": {
        "x-interface-name": "IAssetController",
        "tags": [
          "资产管理"
        ],
        "summary": "获取资产列表",
        "description": "获取资产列表",
        "operationId": "ListAsset",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "categories",
            "in": "query",
            "description": "资产类别,支持IMAGE/APP/WORKFLOW/DATASET,支持查询多个,以','分割",
            "required": false,
            "type": "string",
            "maxLength": 2000,
            "minLength": 0,
            "x-example": "IMAGE"
          },
          {
            "name": "key_word",
            "in": "query",
            "description": "关键字,支持在资产名、资产标题、短描述、长描述中搜索",
            "required": false,
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          {
            "name": "labels",
            "in": "query",
            "description": "标签,支持查询多个,以','分割",
            "required": false,
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "返回记录限制",
            "required": false,
            "type": "integer",
            "default": 100,
            "maximum": 1000,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 100000000,
            "minimum": 0,
            "format": "int32"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "publishers",
            "in": "query",
            "description": "发布者,支持查询多个,以','分割",
            "required": false,
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          {
            "name": "scope",
            "in": "query",
            "description": "查询范围,支持PUBLIC/INTERNAL/SELF",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^(PUBLIC|INTERNAL|SELF)$",
            "x-pattern-message": "scope is illegal, only support PUBLIC, INTERNAL or SELF"
          },
          {
            "name": "vendor_ids",
            "in": "query",
            "description": "供应商,支持查询多个,以','分割",
            "required": false,
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "count": 15,
                "assets": [
                  {
                    "id": "aa78f595-5acb-4be8-b277-229be335633a",
                    "category": "WORKFLOW",
                    "name": "Docking Summary",
                    "title": "Docking Summary",
                    "labels": [
                      "molecular docking",
                      "drug discovery",
                      "smallMolecularChemicals"
