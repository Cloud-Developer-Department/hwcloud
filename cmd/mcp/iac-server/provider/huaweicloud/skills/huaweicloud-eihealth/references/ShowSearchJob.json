{
  "name": "ShowSearchJob",
  "summary": "查询分子搜索作业详情",
  "tags": "分子搜索作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-jobs/search/{job_id}": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-ut-partial": true,
        "x-interface-name": "ISearchJobController",
        "tags": [
          "分子搜索作业管理"
        ],
        "summary": "查询分子搜索作业详情",
        "description": "查询分子搜索作业详情",
        "operationId": "ShowSearchJob",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid",
            "x-example": "projectId"
          },
          {
            "name": "job_id",
            "in": "path",
            "description": "作业id",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "job_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/SearchJobDetailRsp"
            },
            "examples": {
              "application/json": {
                "basic_info": {
                  "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                  "name": "demo-job",
                  "labels": [
                    "labelA",
                    "labelB"
                  ],
                  "status": "FINISHED",
                  "type": "SEARCH",
                  "create_time": "2021-01-30T02:34:36Z",
                  "start_time": "2021-01-30T02:34:37Z",
                  "finish_time": "2021-01-30T02:53:26Z",
                  "failed_message": "null",
                  "user_name": "demo-user-name",
                  "output_dir": "job-analysis/job-name"
                },
                "smiles": "string",
                "top_n": 100,
                "databases": [
                  "databaseA",
                  "databaseB"
                ],
                "custom_databases": [
                  "custom_databaseA_id",
                  "custom_databaseB_id"
                ],
                "search_method": [
                  "ECFP_4"
                ]
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "DrugJobDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "作业id"
        },
        "name": {
          "type": "string",
          "example": "demo-job",
          "description": "作业的名称,取值范围:[1,63],允许大小写字母、数字、以及特殊字符中划线(-)"
        },
        "eihealth_project_id": {
          "type": "string",
          "example": "demo_id",
          "description": "**参数解释**:\n作业所属空间ID。\n**约束限制**:\n不涉及\n**取值范围**:\n长度为[1-63]个字符,允许大小写字母、数字、以及特殊字符中划线(-)。\n**默认取值**:\n不涉及"
        },
        "eihealth_project_name": {
          "type": "string",
          "example": "demo_name",
          "description": "**参数解释**:\n作业所属空间名称。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        },
        "upstream_job_info": {
          "type": "string",
          "example": "{\"job_id\":\"demo-job-id\",\"job_name\":\"demo-job-name\"}",
          "description": "**参数解释**:\n上游作业信息。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        },
        "labels": {
          "type": "array",
          "example": [
            "labelA",
            "labelB"
          ],
          "description": "作业标签",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "example": "FINISHED",
          "description": "作业状态"
        },
        "type": {
          "type": "string",
          "example": "OPTIMIZATION",
          "description": "作业类型"
        },
        "create_time": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "作业创建时间"
        },
        "finish_time": {
          "type": "string",
          "example": "2021-01-30T02:53:26Z",
          "description": "作业结束时间"
        },
        "start_time": {
          "type": "string",
          "example": "2021-01-30T02:50:26Z",
          "description": "作业开始时间"
        },
        "failed_message": {
          "type": "string",
          "example": "null",
          "description": "失败提示,当作业执行失败时会返回"
        },
        "user_name": {
          "type": "string",
          "example": "demo-user-name",
          "description": "创建任务的用户名称"
        },
        "output_dir": {
          "type": "string",
          "example": "projectName:/job-result/dir",
          "description": "作业结果输出目录"
        },
        "expect_charge_num": {
          "type": "number",
          "format": "double",
          "example": 1,
          "description": "预估功能调用消耗次数"
        },
        "real_charge_num": {
          "type": "number",
          "format": "double",
          "example": 1,
          "description": "实际功能调用消耗次数"
        },
        "progress": {
          "$ref": "#/definitions/Progress",
          "description": "作业进度信息"
        }
      }
    },
    "SearchJobDetailRsp": {
      "properties": {
        "basic_info": {
          "$ref": "#/definitions/DrugJobDto",
          "description": "作业基本信息"
        },
        "smiles": {
          "type": "string",
          "description": "分子SMILES表达式",
          "minLength": 1,
          "maxLength": 1024
        },
        "scaffold": {
          "type": "string",
          "description": "分子骨架表达式",
          "example": "CN(C)CCN(C)C1",
          "minLength": 1,
          "maxLength": 1024
        },
        "top_n": {
          "type": "integer",
          "format": "int32",
          "description": "生成分子数量",
          "minimum": 0,
          "maximum": 1000
        },
        "databases": {
          "description": "可供搜索分子的公共数据库名称列表",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 10,
          "example": [
            "databaseA",
            "databaseB"
          ]
        },
        "custom_databases": {
          "description": "可供搜索分子的自定义数据库名称列表",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 10,
          "example": [
            "custom_databaseA",
            "custom_databaseB"
          ]
        },
        "models": {
          "description": "模型信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/BasicDrugModel"
          }
        },
        "search_method": {
          "type": "string",
          "description": "分子搜索方法",
          "default": "ECFP_4",
          "$ref": "#/definitions/SearchType"
        },
        "part_failed_reason": {
          "type": "array",
          "description": "部分失败原因和数量",
          "items": {
            "$ref": "#/definitions/FailedReasonRecord"
          }
        }
      },
      "description": "获取分子搜索作业详情响应体"
    },
    "Progress": {
      "properties": {
        "overall": {
          "type": "number",
          "format": "float",
          "example": 0.21,
          "description": "整体进度"
        },
        "estimated_finish_time": {
          "type": "integer",
          "format": "int64",
          "example": 1000,
          "description": "预计结束时间,毫秒"
        }
      }
    },
    "FailedReasonRecord": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "example": "invalid smiles",
          "description": "失败原因"
        },
        "count": {
          "type": "integer",
          "example": 20,
          "description": "失败数量"
        }
      }
    },
    "BasicDrugModel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "模型ID"
        },
        "task_id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "任务ID"
        },
        "name": {
          "type": "string",
          "example": "model_name",
          "description": "模型名称"
        },
        "creator": {
          "type": "string",
          "example": "creator",
          "description": "模型创建者"
        },
        "type": {
          "type": "string",
          "example": "binary",
          "description": "模型类型"
        },
        "value_range": {
          "$ref": "#/definitions/ValueRange2"
        },
        "description": {
          "type": "string",
          "example": "description",
          "description": "模型描述信息"
        }
      }
    },
    "SearchType": {
      "type": "string",
      "enum": [
        "ECFP_4",
        "SCAFFOLD"
      ]
    },
    "ValueRange2": {
      "properties": {
        "lower": {
          "type": "number",
          "format": "float",
          "description": "值域下限"
        },
        "upper": {
          "type": "number",
          "format": "float",
          "description": "值域上限"
        }
      },
      "description": "数值值域区间定义",
      "example": {
        "lower": 0,
        "upper": 20
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}