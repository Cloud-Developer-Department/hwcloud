{
  "name": "CreateWorkflow",
  "summary": "创建流程",
  "tags": "流程管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/workflows": {
      "post": {
        "x-interface-name": "IWorkflowController",
        "tags": [
          "流程管理"
        ],
        "summary": "创建流程",
        "description": "创建流程",
        "operationId": "CreateWorkflow",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is illegal"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "in": "body",
            "name": "CreateWorkflowRequestBody",
            "description": "workflowDto",
            "required": true,
            "schema": {
              "$ref": "#/definitions/WorkflowDto"
            }
          }
        ],
        "deprecated": false,
        "responses": {
          "201": {
            "description": "CREATED",
            "examples": {
              "application/json": {
                "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1"
              }
            },
            "schema": {
              "$ref": "#/definitions/WorkflowIdRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "创建流程,流程的名称为demo-workflow,版本为1.0.0。",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/workflows",
        "x-request-examples-1": {
          "name": "demo-workflow",
          "version": "1.0.0",
          "summary": "summary",
          "description": "description",
          "labels": [
            "labelA",
            "labelB"
          ],
          "timeout": 1440,
          "output_dir": "/workflow",
          "tasks": [
            {
              "task_name": "app1-1",
              "app_id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
              "display_name": "步骤1",
              "output_dir": "/task",
              "resources": {
                "cpu_type": "X86",
                "cpu": "1C",
                "memory": "1G",
                "gpu_type": "GPU",
                "gpu": 0
              },
              "location": {
                "x": 100,
                "y": 100
              },
              "inputs": [
                {
                  "name": "dir-parameter",
                  "values": [
                    "/test"
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "TaskDto": {
      "required": [
        "app_id",
        "task_name"
      ],
      "properties": {
        "task_name": {
          "type": "string",
          "example": "app1-1",
          "description": "子任务实际名称,取值范围[1,32],只能以大小写字母开头,由大小写字母、数字、中划线(-)、下划线(_)组成,以大小写字符或数字结尾。",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z](([-_]*[a-zA-Z0-9])|[a-zA-Z0-9])*$",
          "x-pattern-message": "The task parameter format does not match."
        },
        "app_id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "应用id,取值范围[1,135],正则先不能有中文,两种格式。特殊id,采用{app_name}::{app_version}::{src_project_name}格式,用于手动创建场景;其他场景,app_id为系统分配的唯一标识",
          "minLength": 1,
          "maxLength": 135,
          "pattern": "^[^\\一-\\龥]+$",
          "x-pattern-message": "The app parameter format does not match."
        },
        "display_name": {
          "type": "string",
          "example": "步骤1",
          "description": "流程的子任务展示名称,最大长度64",
          "minLength": 0,
          "maxLength": 64
        },
        "output_dir": {
          "type": "string",
          "example": "/task",
          "description": "子任务的输出存放路径,用户可显式指定;输出路径必须以斜杠(/)开头且不能以斜杠(/)结尾,不能包含两个以上相邻的斜杠(/),不能包含以下特殊字符:\\ : ; * ? < \" > | 。其中单个文件夹名称不能以中划线(-)开头,不能以英文句号(.)或斜杠(/)或空格开头或结尾",
          "minLength": 0,
          "maxLength": 128
        },
        "resources": {
          "$ref": "#/definitions/TaskResourceDto"
        },
        "location": {
          "$ref": "#/definitions/VertexLocationDto"
        },
        "inputs": {
          "type": "array",
          "description": "任务的输入参数信息",
          "items": {
            "$ref": "#/definitions/TaskParameterDto"
          },
          "maxItems": 128,
          "minItems": 0
        },
        "outputs": {
          "type": "array",
          "description": "**参数解释**:\n任务的输出参数信息。\n**约束限制**:\n最多支持128个参数。\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
          "items": {
            "$ref": "#/definitions/TaskParameterDto"
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "title": "TaskDto"
    },
    "WorkflowIdRsp": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "流程id"
        }
      }
    },
    "VertexLocationDto": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double",
          "example": 100.0,
          "description": "子任务的画布横坐标"
        },
        "y": {
          "type": "number",
          "format": "double",
          "example": 100.0,
          "description": "子任务的画布纵坐标"
        }
      }
    },
    "TaskParameterDto": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "dir-parameter",
          "description": "子任务的参数名称,长度为[1,32],以小写字母开头,允许出现中划线(-)、小写字母和数字,且必须以小写字母或数字结尾。需要和已有应用的参数名称一致。",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$",
          "x-pattern-message": "The task parameter format does not match."
        },
        "source": {
          "type": "string",
          "example": "MANUAL",
          "description": "子任务的参数类型,不填默认为MANUAL",
          "pattern": "^$|^(MANUAL|DATABASE)$",
          "x-pattern-message": "The task parameter format does not match."
        },
        "values": {
          "type": "array",
          "example": [
            "/test"
          ],
          "description": "子任务的参数数值,根据参数类型进行合法性校验",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2048
          },
          "maxItems": 128,
          "minItems": 0
        }
      }
    },
    "TaskResourceDto": {
      "properties": {
        "cpu": {
          "type": "string",
          "example": "1C",
          "description": "cpu申请使用量,取值范围[0.1-128],单位C,支持一位小数。对于应用,不填默认1C;对于流程和作业,不填默认使用前一级的配置,填值会覆盖更新。覆盖关系:作业->流程->应用",
          "minLength": 0,
          "maxLength": 24
        },
        "cpu_type": {
          "type": "string",
          "example": "X86",
          "description": "cpu架构类型,不填默认X86",
          "minLength": 0,
          "maxLength": 24,
          "pattern": "^$|^(X86|ARM)$",
          "x-pattern-message": "The cpu_type format does not match."
        },
        "memory": {
          "type": "string",
          "example": "1G",
          "description": "内存申请使用量,取值范围[0.1-3072],单位G,支持一位小数。对于应用,不填默认1G;对于流程和作业,不填默认使用前一级的配置,填值会覆盖更新。覆盖关系:作业->流程->应用",
          "minLength": 0,
          "maxLength": 24
        },
        "gpu_type": {
          "type": "string",
          "example": "GPU",
          "description": "gpu架构类型,取值范围 ' '|GPU|D910|D310。对于流程和作业,不填默认使用前一级的配置,填值会覆盖更新。覆盖关系:作业->流程->应用",
          "minLength": 0,
          "maxLength": 24,
          "pattern": "^$|^(GPU|D910|D310)$",
          "x-pattern-message": "The gpu_type format does not match."
        },
        "gpu": {
          "type": "string",
          "example": "0",
          "description": "gpu申请使用量,取值范围[0-16],仅支持整数,D910有特殊约束,申请数量需要是0,1,2,4,8。对于应用,不填默认0;对于流程和作业,不填默认使用前一级的配置,填值会覆盖更新。覆盖关系:作业->流程->应用",
          "minLength": 0,
          "maxLength": 24
        }
      },
      "description": "应用申请资源"
    },
    "WorkflowDto": {
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "demo-workflow",
          "description": "流程名称,取值范围[1,56],允许大小写字母、数字、以及特殊字符中划线(-)和下划线(_)。更新流程时,流程名称不支持修改。",
          "minLength": 1,
          "maxLength": 56,
          "pattern": "^[a-z0-9A-Z-_]+$",
          "x-pattern-message": "The workflow parameter format does not match."
        },
        "version": {
          "type": "string",
          "example": "1.0.0",
          "description": "流程版本,取值范围[1,24],以小写字母或数字或大写字母开头,允许出现中划线,必须以小写字母或数字或大写字母结尾。更新流程时,流程版本不支持修改。",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9]+([-.][a-zA-Z0-9]+)*$",
          "x-pattern-message": "The workflow parameter format does not match."
        },
        "summary": {
          "type": "string",
          "example": "summary",
          "description": "流程简述 取值范围[0,128]",
          "minLength": 0,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "example": "description",
          "description": "流程描述 取值范围[0,65535],后续支持markdown文本",
          "minLength": 0,
          "maxLength": 65535
        },
        "labels": {
          "type": "array",
          "example": [
            "labelA",
            "labelB"
          ],
          "description": "流程标签,取值范围[0,5],单个标签最大长度32字符,支持中文、字母、数字、空格、下划线和中划线,且不能以空格开头或者结尾。",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[\\一-\\龥A-Za-z0-9-_]+(\\s+[\\一-\\龥A-Za-z0-9-_]+)*$",
            "x-pattern-message": "The workflow parameter format does not match."
          },
          "maxItems": 5,
          "minItems": 0
        },
        "timeout": {
          "type": "integer",
          "format": "int32",
          "example": 1440,
          "description": "流程超时时间,取值范围[1,144000],单位分钟,默认1440",
          "minimum": 1,
          "maximum": 144000
        },
        "output_dir": {
          "type": "string",
          "example": "/workflow",
          "description": "流程的当前工作目录,默认为根目录,用户可显式指定;输出路径必须以斜杠(/)开头且不能以斜杠(/)结尾,不能包含两个以上相邻的斜杠(/),不能包含以下特殊字符:\\ : ; * ? < \" > | 。其中单个文件夹名称不能以中划线(-)开头,不能以英文句号(.)或斜杠(/)或空格开头或结尾",
          "minLength": 0,
          "maxLength": 128
        },
        "tasks": {
          "type": "array",
          "description": "流程中子任务的描述信息,子任务数量取值范围:[1,64]",
          "items": {
            "$ref": "#/definitions/TaskDto"
          },
          "maxItems": 64,
          "minItems": 0
        }
      },
      "title": "WorkflowDto",
      "description": "流程请求体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}