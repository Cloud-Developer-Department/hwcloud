          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "name": "GenerateComplexCombineRequestBody",
            "in": "body",
            "required": true,
            "description": "蛋白小分子拼接复合物的请求体",
