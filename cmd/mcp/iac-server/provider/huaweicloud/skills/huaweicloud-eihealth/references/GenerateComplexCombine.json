  },
  "definitions": {
    "ReceptorDrugFileReq": {
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/DrugFileSource",
          "example": "RAW"
        },
        "url": {
          "type": "string",
          "description": "文件URL,当数据源为外部网络数据时为https地址;用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "pattern": ".*\\.(pdb)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB)$",
          "description": "文件格式,仅支持PDB,仅数据源为RAW时提供"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "description": "文件原始数据,仅数据源为RAW时提供",
          "example": "raw_data"
        },
        "add_hydrogen": {
          "type": "boolean",
          "default": true,
          "description": "增加氢原子"
        }
      },
      "description": "受体文件"
    },
    "RunReceptorPreprocessReq": {
      "type": "object",
      "description": "受体预处理请求体",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "$ref": "#/definitions/ReceptorDrugFileReq",
          "description": "受体文件"
        },
        "remove_water": {
          "type": "boolean",
          "default": false,
          "description": "去除水分子"
        },
        "remove_ion": {
          "type": "boolean",
          "default": false,
          "description": "去除离子"
        },
        "remove_ligand": {
          "type": "boolean",
          "default": false,
          "description": "去除配体分子"
        },
        "add_hydrogen": {
          "type": "boolean",
          "default": false,
          "description": "增加氢原子"
        }
      },
      "example": {
        "file": {
          "source": "EXTRANET",
          "url": "https://files.rcsb.org/download/1TQN.pdb"
        }
      }
    },
    "DrugFileSource": {
      "type": "string",
      "enum": [
        "EXTRANET",
        "PRIVATE",
        "PUBLIC",
        "RAW"
      ],
      "description": "受体的数据源:外部网络数据(如RCSB在线数据库)、用户私有数据中心、承载租户公共数据(含样例/公共库)"
    },
    "GenerateComplexCombineReq": {
      "type": "object",
      "description": "蛋白小分子拼接复合物接口的请求体",
      "required": [
        "receptor",
        "ligand"
      ],
      "properties": {
        "receptor": {
          "description": "受体蛋白文件",
          "$ref": "#/definitions/RunReceptorPreprocessReq"
        },
        "ligand": {
          "description": "配体小分子文件",
          "$ref": "#/definitions/ReceptorDrugFileReq"
        }
      }
    }
  },
