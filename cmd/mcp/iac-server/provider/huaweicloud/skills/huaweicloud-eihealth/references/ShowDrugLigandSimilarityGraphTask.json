{
  "name": "ShowDrugLigandSimilarityGraphTask",
  "summary": "查询配体相似性图计算任务",
  "tags": "IDrugCommonController",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-common/ligand/similarity-graph/{task_id}": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ShowDrugLigandSimilarityGraphTask",
        "tags": [
          "IDrugCommonController"
        ],
        "summary": "查询配体相似性图计算任务",
        "description": "查询配体相似性图计算任务",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "name": "task_id",
            "in": "path",
            "type": "string",
            "description": "任务ID,通过创建任务接口取得。",
            "required": true,
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "task_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "查询配体相似性图计算任务成功响应",
            "schema": {
              "$ref": "#/definitions/LigandSimilarityGraphTaskRsp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "LigandSimilarityGraphTaskRsp": {
      "type": "object",
      "description": "配体相似度图任务响应体,仅在任务完成时包含result字段",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "example": "FINISHED",
          "description": "任务状态"
        },
        "result": {
          "$ref": "#/definitions/LigandSimilarityGraphTaskResultDto"
        }
      },
      "example": {
        "status": "running"
      }
    },
    "LigandSimilarityGraphTaskResultPairDto": {
      "type": "object",
      "description": "配体相似度图任务结果对,成功则返回similarity,失败则返回reason",
      "required": [
        "ids",
        "success"
      ],
      "properties": {
        "ligands": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "两个配体名称",
          "items": {
            "type": "string",
            "description": "配体分子唯一名字,受体中的建议使用\"{氨基酸}:{链}:{编号}\"",
            "minLength": 1,
            "maxLength": 32,
            "example": "LIG:0"
          }
        },
        "success": {
          "type": "boolean",
          "description": "相似度计算是否成功"
        },
        "similarity": {
          "type": "number",
          "format": "float",
          "minimum": 0,
          "maximum": 1,
          "description": "配体对之间的相似度"
        },
        "reason": {
          "type": "string",
          "description": "相似度计算失败的理由",
          "minLength": 1,
          "maxLength": 512,
          "example": "calculation timeout"
        }
      }
    },
    "LigandSimilarityGraphTaskResultDto": {
      "type": "object",
      "description": "配体相似度图任务结果",
      "required": [
        "pairs"
      ],
      "properties": {
        "pairs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "description": "配体相似度图任务结果对列表",
          "items": {
            "$ref": "#/definitions/LigandSimilarityGraphTaskResultPairDto"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}