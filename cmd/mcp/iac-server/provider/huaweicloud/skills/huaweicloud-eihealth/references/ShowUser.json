{
  "name": "ShowUser",
  "summary": "获取指定用户详情",
  "tags": "用户管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/users/{user_id}": {
      "get": {
        "x-interface-name": "IUserController",
        "tags": [
          "用户管理"
        ],
        "summary": "获取指定用户详情",
        "description": "获取指定用户详情",
        "operationId": "ShowUser",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "user_id",
            "in": "path",
            "description": "用户id",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "user_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "id": "7116d09f88fa41908676fdd4b039...",
                "name": "user",
                "role": "ADMIN",
                "status": "ACTIVE",
                "email": "example@huawei.com",
                "phone": "12345678910",
                "areacode": "0086",
                "is_domain_owner": true,
                "create_time": "2021-01-15T02:45:38Z",
                "pwd_status": true,
                "update_time": "2021-01-15T02:45:38Z",
                "source": "PLATFORM"
              }
            },
            "schema": {
              "$ref": "#/definitions/GetUserRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "GetUserRsp": {
      "properties": {
        "id": {
          "type": "string",
          "example": "7116d09f88fa41908676fdd4b039...",
          "description": "用户id"
        },
        "name": {
          "type": "string",
          "example": "user",
          "description": "用户名,长度4~31之间,首位不能为数字,特殊字符只能包含下划线“_”、中划线“-”和空格"
        },
        "role": {
          "type": "string",
          "example": "ADMIN",
          "description": "角色类型:管理员(ADMIN)、操作者(OPERATOR)"
        },
        "status": {
          "type": "string",
          "example": "ACTIVE",
          "description": "状态"
        },
        "email": {
          "type": "string",
          "example": "example@huawei.com",
          "description": "用户邮箱,需符合邮箱格式"
        },
        "phone": {
          "type": "string",
          "example": "12345678910",
          "description": "用户手机号,纯数字,长度小于等于32位。必须与国家码同时存在。"
        },
        "areacode": {
          "type": "string",
          "example": "0086",
          "description": "国家码。中国大陆为“0086”"
        },
        "is_domain_owner": {
          "type": "boolean",
          "example": true,
          "description": "是否domain用户"
        },
        "create_time": {
          "type": "string",
          "example": "2021-01-15T02:45:38Z",
          "description": "用户创建时间,UTC时间"
        },
        "pwd_status": {
          "type": "boolean",
          "example": true,
          "description": "是否需要修改密码"
        },
        "update_time": {
          "type": "string",
          "example": "2021-01-15T02:45:38Z",
          "description": "更新时间,UTC时间"
        },
        "source": {
          "type": "string",
          "example": "PLATFORM",
          "description": "来源,PLATFORM或者IAM"
        }
      },
      "title": "UserInfo"
    }
  },
