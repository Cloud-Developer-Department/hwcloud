{
  "name": "ListQuota",
  "summary": "获取当前系统配额及资源使用情况",
  "tags": "系统配额及资源使用情况获取",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/quotas": {
      "get": {
        "x-interface-name": "ISystemQuotaUIController",
        "tags": [
          "系统配额及资源使用情况获取"
        ],
        "summary": "获取当前系统配额及资源使用情况",
        "description": "获取当前系统配额及资源使用情况",
        "operationId": "ListQuota",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "count": 1,
                "quotas": [
                  {
                    "name": "USER",
                    "total": 20,
                    "unit": "NUM",
                    "usage": 2
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListQuotaRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "ListQuotaRsp": {
      "required": [
        "count",
        "quotas"
      ],
      "properties": {
        "quotas": {
          "type": "array",
          "description": "配额信息列表",
          "items": {
            "$ref": "#/definitions/QuotaRsp"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "配额列表个数"
        }
      },
      "title": "QuotaInfoResponse",
      "description": "获取系统配额返回体"
    },
    "QuotaRsp": {
      "required": [
        "name",
        "total",
        "unit",
        "usage"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "USER",
          "description": "配额项名称,支持USER,PROJECT,USER_PROJECT,STORAGE,PROJECT_APP,PROJECT_NOTEBOOK,PROJECT_WORKFLOW,PROJECT_IMAGE"
        },
        "total": {
          "type": "integer",
          "example": 20,
          "description": "配额"
        },
        "unit": {
          "type": "string",
          "example": "NUM",
          "description": "配额项单位"
        },
        "usage": {
          "type": "integer",
          "example": 2,
          "description": "配额使用量"
        }
      },
      "title": "QuotaInfo",
      "description": "配额信息"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}