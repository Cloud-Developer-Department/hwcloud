  "definitions": {
    "UpdateUserReq": {
      "properties": {
        "mobile": {
          "type": "string",
          "example": "12345678910",
          "description": "用户手机号,纯数字,长度小于等于32位,当且仅当重置手机号时传入空串。必须与国家码同时存在。",
          "minLength": 0,
          "maxLength": 32,
          "pattern": "^[0-9]*$",
          "x-pattern-message": "phone is invalid, length should between 0-32, can only contain numbers",
          "x-ut-exclude-equivalence": [
            "NULL"
          ]
        },
        "areacode": {
          "type": "string",
          "example": "0086",
          "description": "国家码,当且仅当重置手机号时传入空串。中国大陆为“0086”",
          "minLength": 0,
          "maxLength": 10,
          "pattern": "^[0-9]*$",
          "x-pattern-message": "areacode is invalid",
          "x-ut-exclude-equivalence": [
            "NULL"
          ]
        },
        "email": {
          "type": "string",
          "example": "example@huawei.com",
          "description": "用户邮箱,需符合邮箱格式",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^\\w+([-+.]\\w+)*@\\w+([-.]\\w+)*\\.\\w+([-.]\\w+)*$",
          "x-pattern-message": "email is invalid",
          "x-sensitive": true
        },
        "ticket": {
          "type": "string",
          "example": "ticket",
          "description": "预验证凭证",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^[a-zA-Z0-9_-]*$",
          "x-pattern-message": "ticket is invalid"
        }
      },
