{
  "name": "ListWorkflow",
  "summary": "获取流程列表",
  "tags": "流程管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/workflows": {
      "get": {
        "x-interface-name": "IWorkflowController",
        "tags": [
          "流程管理"
        ],
        "summary": "获取流程列表",
        "description": "获取流程列表",
        "operationId": "ListWorkflow",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is illegal"
          },
          {
            "name": "name",
            "in": "query",
            "description": "流程名称",
            "required": false,
            "type": "string",
            "maxLength": 56,
            "minLength": 1,
            "pattern": "^[a-z0-9A-Z-_]+$",
            "x-pattern-message": "The workflow name format does not match."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "version",
            "in": "query",
            "description": "流程版本",
            "required": false,
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9]+([-.][a-zA-Z0-9]+)*$",
            "x-pattern-message": "The workflow version format does not match."
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "workflows": [
                  {
                    "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                    "name": "demo-workflow",
                    "version": "1.0.0",
                    "summary": "summary",
                    "description": "description",
                    "labels": [
                      "labelA",
                      "labelB"
                    ],
                    "create_time": "2021-01-30T02:34:36Z",
                    "update_time": "2021-01-30T02:53:26Z",
                    "user_name": "gwj-test-01"
                  }
                ],
                "count": 1
              }
            },
            "schema": {
              "$ref": "#/definitions/WorkflowListRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
