{
  "name": "ValidateCode",
  "summary": "预验证",
  "tags": "用户管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/users/{user_id}/code-verify": {
      "post": {
        "x-interface-name": "IUserController",
        "tags": [
          "用户管理"
        ],
        "summary": "预验证",
        "description": "预验证",
        "operationId": "ValidateCode",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "in": "body",
            "name": "ValidateCodeRequestBody",
            "description": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CodeVerifyReq"
            }
          },
          {
            "name": "user_id",
            "in": "path",
            "description": "用户id",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "user_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/CodeVerifyRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/users/{user_id}/code-verify",
        "x-request-examples-1": {
          "code": "string",
          "method": "string"
        },
        "x-request-examples-description-1": "校验验证码,校验码为string,校验方法为string"
      }
    }
  },
  "definitions": {
    "CodeVerifyRsp": {
      "properties": {
        "ticket": {
          "type": "string",
          "example": "7116d39...",
          "description": "预验证ticket"
        }
      },
      "title": "UserResponse",
      "description": "操作用户返回体"
    },
    "CodeVerifyReq": {
      "required": [
        "code",
        "method"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "验证码",
          "minLength": 6,
          "maxLength": 8,
          "pattern": "^\\d*$",
          "x-pattern-message": "Captchas can only be 6 or 8 digits"
        },
        "method": {
          "type": "string",
          "description": "认证方式",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(sms|email|vmfa)$",
          "x-pattern-message": "Authentication only supports ‘sms’,‘email’,‘vmfa’"
        }
      },
      "title": "CodeVerificationRequest",
      "description": "预验证请求体"
    }
  },
  "version": "2.0",
