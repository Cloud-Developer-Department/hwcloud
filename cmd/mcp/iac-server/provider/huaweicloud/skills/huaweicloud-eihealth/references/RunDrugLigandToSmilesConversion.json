{
  "name": "RunDrugLigandToSmilesConversion",
  "summary": "配体格式转换为SMILES",
  "tags": "IDrugCommonController",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-common/ligand/smiles": {
      "post": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "RunDrugLigandToSmilesConversion",
        "tags": [
          "IDrugCommonController"
        ],
        "summary": "配体格式转换为SMILES",
        "description": "配体格式转换为SMILES,若配体文件中存在多个分子,则只取第一个返回",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "name": "RunDrugLigandToSmilesConversionRequestBody",
            "in": "body",
            "required": true,
            "description": "配体格式转换为SMILES请求体",
            "schema": {
              "$ref": "#/definitions/DrugFile"
            }
          }
        ],
        "x-request-examples-1": {
          "source": "RAW",
          "url": "https://files.rcsb.org/download/1TQN.pdb",
          "format": "PDB",
          "data": "MODEL1.xxxxxxx.END"
        },
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-common/ligand/smiles",
        "x-request-examples-description-1": "配体格式转换为SMILES,若配体文件中存在多个分子,则只取第一个返回",
        "responses": {
          "200": {
            "description": "配体格式转换为SMILES成功响应",
            "schema": {
              "$ref": "#/definitions/RunLigandToSmilesConversionRsp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "DrugFile": {
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/DrugFileSource",
          "example": "RAW"
        },
        "url": {
          "type": "string",
          "description": "文件URL,当数据源为外部网络数据时为https地址;用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "x-ut-exclude-equivalence": [
            "NULL"
          ],
          "pattern": ".*\\.(pdb|mol2|sdf|smi)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB|SDF|MOL2|SMI)$",
          "description": "文件格式,支持PDB、SDF、MOL2、SMI,仅数据源为RAW时提供"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "文件原始数据,仅数据源为RAW时提供"
        }
      }
    },
    "RunLigandToSmilesConversionRsp": {
      "type": "object",
      "description": "配体转SMILES响应体",
      "required": [
        "smiles"
      ],
      "properties": {
        "smiles": {
          "type": "string",
          "description": "分子SMILES表达式",
          "minLength": 1,
          "maxLength": 512,
          "example": "CC"
        }
      }
    },
    "DrugFileSource": {
      "type": "string",
      "enum": [
        "EXTRANET",
        "PRIVATE",
        "PUBLIC",
        "RAW"
      ],
      "description": "受体的数据源:外部网络数据(如RCSB在线数据库)、用户私有数据中心、承载租户公共数据(含样例/公共库)"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}