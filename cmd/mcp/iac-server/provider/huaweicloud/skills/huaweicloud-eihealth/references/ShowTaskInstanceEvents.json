{
  "name": "ShowTaskInstanceEvents",
  "summary": "获取子任务中实例的事件",
  "tags": "作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/jobs/{job_id}/tasks/{task_name}/instances/{instance_name}/events": {
      "get": {
        "x-interface-name": "IJobController",
        "tags": [
          "作业管理"
        ],
        "summary": "获取子任务中实例的事件",
        "description": "获取子任务中实例的事件",
        "operationId": "ShowTaskInstanceEvents",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is illegal"
          },
          {
            "name": "job_id",
            "in": "path",
            "description": "作业id",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "The job id format does not match."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "task_name",
            "in": "path",
            "description": "子任务名称",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "task_index",
            "in": "query",
            "description": "子任务的并发序号",
            "required": false,
            "type": "string",
            "default": "0",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "instance_name",
            "in": "path",
            "description": "子任务实例名称",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "count": 0,
                "events": [
                  {
                    "type": "Normal",
                    "count": 1,
                    "reason": "Started",
                    "message": "Started container task-2-zqy-test-0218-0-19df0004a000206",
                    "first_timestamp": "2021-01-30T02:34:36Z",
                    "last_timestamp": "2021-01-30T02:34:36Z"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListEventRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "ListEventRsp": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "事件条数"
        },
        "events": {
          "type": "array",
          "description": "事件列表",
          "items": {
            "$ref": "#/definitions/EventRsp"
          }
        }
      }
    },
    "EventRsp": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "example": "Normal",
          "description": "任务启动事件类型"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "任务启动事件发生次数"
        },
        "reason": {
          "type": "string",
          "example": "Started",
          "description": "任务启动事件状态"
        },
        "message": {
          "type": "string",
          "example": "Started container task-2-zqy-test-0218-0-19df0004a000206",
          "description": "任务启动事件详细信息"
        },
        "first_timestamp": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "任务启动事件首次上报时间"
        },
        "last_timestamp": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "任务启动事件末次上报时间"
        }
      },
      "description": "任务启动事件响应内容"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}