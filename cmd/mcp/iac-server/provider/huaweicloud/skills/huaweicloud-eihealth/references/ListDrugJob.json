{
  "name": "ListDrugJob",
  "summary": "获取药物作业列表",
  "tags": "药物作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-jobs": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-interface-name": "IDrugJobController",
        "tags": [
          "药物作业管理"
        ],
        "summary": "获取药物作业列表",
        "description": "获取药物作业列表",
        "operationId": "ListDrugJob",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制量,单次查询总量,必须由数字组成,默认为100,取值范围[1,1000]",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 100,
            "maximum": 1000,
            "minimum": 1
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,查询起始偏移,必须由数字组成,默认为0,取值范围[0,100000000]",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 100000000,
            "minimum": 0
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序规则 目前默认时间降序",
            "required": false,
            "type": "string",
            "default": "DESC",
            "x-enum-type": "SortDir"
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序规则 目前默认时间降序,支持根据create_time|finish_time|running_time|total_time排序",
            "required": false,
            "type": "string",
            "x-enum-type": "DrugJobSortKey"
          },
          {
            "name": "job_name",
            "in": "query",
            "description": "作业名称",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "labels",
            "in": "query",
            "required": false,
            "description": "标签列表",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[\\一-\\龥A-Za-z0-9-_]+(\\s+[\\一-\\龥A-Za-z0-9-_]+)*$",
              "maxLength": 32,
              "minLength": 1,
              "x-pattern-message": "labels is illegal"
            },
            "minItems": 0,
            "maxItems": 5
          },
          {
            "name": "status_list",
            "in": "query",
            "required": false,
            "description": "作业运行状态列表, 支持WAITING|RUNNING|FINISHED|FAILED|CANCELLED",
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-type": "DrugJobStatus"
            },
            "minItems": 0,
            "maxItems": 5
          },
          {
            "name": "type_list",
            "in": "query",
            "required": false,
            "description": "作业类型列表, 支持DOCKING|OPTIMIZATION|SYNTHESIS|FEP|POCKET_DETECTION|ADMET",
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-type": "DrugJobType"
            },
            "minItems": 0,
            "maxItems": 10
          },
          {
            "name": "create_start_time",
            "in": "query",
            "description": "最小创建时间",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "create_end_time",
            "in": "query",
            "description": "最大创建时间",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "finish_start_time",
            "in": "query",
            "description": "最小结束时间",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "finish_end_time",
            "in": "query",
            "description": "最大结束时间",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "total_time_range",
            "in": "query",
            "description": "总运行时长, 支持ONE_DAY_MORE|ONE_DAY|ONE_HOUR|TWELVE_HOUR",
            "required": false,
            "type": "string",
            "x-enum-type": "TotalTimeRange"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListDrugJobRsp"
            },
            "examples": {
              "application/json": {
                "jobs": [
                  {
                    "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                    "name": "demo-job",
                    "labels": [
                      "labelA",
                      "labelB"
                    ],
                    "status": "FINISHED",
                    "type": "OPTIMIZATION",
                    "create_time": "2021-01-30T02:34:36Z",
                    "start_time": "2021-01-30T02:34:37Z",
                    "finish_time": "2021-01-30T02:53:26Z",
                    "failed_message": "null",
                    "user_name": "demo-user-name",
                    "output_dir": "job-analysis/job-name",
                    "expect_charge_num": 1,
                    "real_charge_num": 1
                  }
                ],
                "count": 1
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "DrugJobDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "作业id"
        },
        "name": {
          "type": "string",
          "example": "demo-job",
          "description": "作业的名称,取值范围:[1,63],允许大小写字母、数字、以及特殊字符中划线(-)"
        },
        "eihealth_project_id": {
          "type": "string",
          "example": "demo_id",
          "description": "**参数解释**:\n作业所属空间ID。\n**约束限制**:\n不涉及\n**取值范围**:\n长度为[1-63]个字符,允许大小写字母、数字、以及特殊字符中划线(-)。\n**默认取值**:\n不涉及"
        },
        "eihealth_project_name": {
          "type": "string",
          "example": "demo_name",
          "description": "**参数解释**:\n作业所属空间名称。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        },
        "upstream_job_info": {
          "type": "string",
          "example": "{\"job_id\":\"demo-job-id\",\"job_name\":\"demo-job-name\"}",
          "description": "**参数解释**:\n上游作业信息。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        },
        "labels": {
          "type": "array",
          "example": [
            "labelA",
            "labelB"
          ],
          "description": "作业标签",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "example": "FINISHED",
          "description": "作业状态"
        },
        "type": {
          "type": "string",
          "example": "OPTIMIZATION",
          "description": "作业类型"
        },
        "create_time": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "作业创建时间"
        },
        "finish_time": {
          "type": "string",
          "example": "2021-01-30T02:53:26Z",
          "description": "作业结束时间"
        },
        "start_time": {
          "type": "string",
          "example": "2021-01-30T02:50:26Z",
          "description": "作业开始时间"
        },
        "failed_message": {
          "type": "string",
          "example": "null",
          "description": "失败提示,当作业执行失败时会返回"
        },
        "user_name": {
          "type": "string",
          "example": "demo-user-name",
          "description": "创建任务的用户名称"
        },
        "output_dir": {
          "type": "string",
          "example": "projectName:/job-result/dir",
          "description": "作业结果输出目录"
        },
        "expect_charge_num": {
          "type": "number",
          "format": "double",
          "example": 1,
          "description": "预估功能调用消耗次数"
        },
        "real_charge_num": {
          "type": "number",
          "format": "double",
          "example": 1,
          "description": "实际功能调用消耗次数"
        },
        "progress": {
          "$ref": "#/definitions/Progress",
          "description": "作业进度信息"
        }
      }
    },
    "Progress": {
      "properties": {
        "overall": {
          "type": "number",
          "format": "float",
          "example": 0.21,
          "description": "整体进度"
        },
        "estimated_finish_time": {
          "type": "integer",
          "format": "int64",
          "example": 1000,
          "description": "预计结束时间,毫秒"
        }
      }
    },
    "ListDrugJobRsp": {
      "type": "object",
      "properties": {
        "jobs": {
          "type": "array",
          "description": "作业列表",
          "items": {
            "$ref": "#/definitions/DrugJobDto"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "作业总数"
        }
      },
      "description": "查询作业列表响应体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}