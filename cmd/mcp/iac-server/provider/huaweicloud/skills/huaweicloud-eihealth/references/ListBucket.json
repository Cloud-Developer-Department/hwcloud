{
  "name": "ListBucket",
  "summary": "获取桶列表",
  "tags": "数据管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/buckets": {
      "get": {
        "tags": [
          "数据管理"
        ],
        "x-interface-name": "IDataController",
        "summary": "获取桶列表",
        "description": "获取桶列表(包含当前项目桶和引用项目桶)",
        "operationId": "ListBucket",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "count": 1,
                "buckets": [
                  {
                    "eihealth_project_id": "a1decfc3-ef88-4dd3-9c23-62d05c26b288",
                    "eihealth_project_name": "test-project-01",
                    "type": "real"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListProjectBucketRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/buckets",
        "x-request-examples-description-1": "获取桶列表"
      }
    }
  },
  "definitions": {
    "ListProjectBucketRsp": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "桶个数"
        },
        "buckets": {
          "type": "array",
          "description": "桶列表",
          "items": {
            "$ref": "#/definitions/ProjectBucketRsp"
          }
        }
      }
    },
    "ProjectBucketRsp": {
      "properties": {
        "eihealth_project_id": {
          "type": "string",
          "example": "a1decfc3-ef88-4dd3-9c23-62d05c26b288",
          "description": "项目编号"
        },
        "eihealth_project_name": {
          "type": "string",
          "example": "test-project-01",
          "description": "项目名称"
        },
        "type": {
          "type": "string",
          "example": "real",
          "description": "桶类型(real:项目桶,quote:引用桶)"
        },
        "quote_root": {
          "type": "boolean",
          "example": true,
          "description": "是否引用桶根路径"
        }
      },
      "title": "ProjectBucket",
      "description": "项目桶"
    }
  },
