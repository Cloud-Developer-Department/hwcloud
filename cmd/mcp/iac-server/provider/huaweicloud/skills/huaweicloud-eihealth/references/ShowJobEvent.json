{
  "name": "ShowJobEvent",
  "summary": "获取作业事件",
  "tags": "作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/jobs/{job_id}/events": {
      "get": {
        "x-interface-name": "IJobController",
        "tags": [
          "作业管理"
        ],
        "summary": "获取作业事件",
        "description": "获取作业事件",
        "operationId": "ShowJobEvent",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "Locale语言类型,zh_cn返回中文,en_us返回英文",
            "required": false,
            "type": "string",
            "default": "en_us",
            "maxLength": 10,
            "minLength": 1
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is illegal"
          },
          {
            "name": "job_id",
            "in": "path",
            "description": "作业id",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "The job id format does not match."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "count": 1,
                "events": [
                  {
                    "action_name": "create",
                    "count": 1,
                    "first_timestamp": "2021-01-30T02:34:36Z",
                    "last_timestamp": "2021-01-30T02:34:36Z",
                    "message": "创建k8s Job对象 app1-1-0-093a002fa000217 成功",
                    "reason": "创建成功##SuccessfulCreate",
                    "type": "Normal"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListJobEventRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "ListJobEventRsp": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "条数"
        },
        "events": {
          "type": "array",
          "description": "作业事件列表",
          "items": {
            "$ref": "#/definitions/JobEventRsp"
          }
        }
      }
    },
    "JobEventRsp": {
      "type": "object",
      "properties": {
        "action_name": {
          "type": "string",
          "example": "create",
          "description": "执行动作名称"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "作业启动事件发生次数"
        },
        "first_timestamp": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "作业启动事件首次上报时间"
        },
        "last_timestamp": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "作业启动事件末次上报时间"
        },
        "message": {
          "type": "string",
          "example": "创建k8s Job对象 app1-1-0-093a002fa000217 成功",
          "description": "作业启动事件详细信息"
        },
        "reason": {
          "type": "string",
          "example": "创建成功##SuccessfulCreate",
          "description": "作业启动事件状态"
        },
        "type": {
          "type": "string",
          "example": "Normal",
          "description": "作业启动事件类型"
        }
      },
      "description": "作业事件响应内容"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}