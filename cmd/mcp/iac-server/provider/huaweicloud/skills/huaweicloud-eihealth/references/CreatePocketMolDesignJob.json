{
  "name": "CreatePocketMolDesignJob",
  "summary": "创建靶点口袋分子设计作业",
  "tags": "靶点口袋分子设计作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-jobs/pocket-mol-design": {
      "post": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-ut-exclude": true,
        "x-interface-name": "IPocketMolDesignJobController",
        "tags": [
          "靶点口袋分子设计作业管理"
        ],
        "summary": "创建靶点口袋分子设计作业",
        "description": "创建靶点口袋分子设计作业",
        "operationId": "CreatePocketMolDesignJob",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "in": "body",
            "name": "CreatePocketMolDesignJobRequestBody",
            "description": "CreatePocketMolDesignJobRequestBody",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreatePocketMolDesignJobReq"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "CREATED",
            "schema": {
              "$ref": "#/definitions/DrugJobIdRsp"
            },
            "x-response-examples-1": {
              "application/json": {
                "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1"
              }
            },
            "x-response-examples-description-1": "创建靶点口袋分子设计作业成功",
            "x-response-examples-2": {
              "application/json": {
                "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                "limit_concurrency": 50
              }
            },
            "x-response-examples-description-2": "创建靶点口袋分子设计作业成功,当前运行作业数已达配额限制,此作业会等待"
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-jobs/pocket-mol-design",
        "x-request-examples-description-1": "创建靶点口袋发现作业,作业名称为demo-job, 受体文件为project:/dir/file,小分子片段文件为project:/dir/file,自定义属性预测id为xxxxxx,分子量约束为200-600,预期的最大输出为5000个",
        "x-request-examples-1": {
          "basic_info": {
            "name": "demo-job",
            "labels": [
              "labelA"
            ]
          },
          "receptor": {
            "file": {
              "source": "PRIVATE",
              "url": "project:/dir/file"
            },
            "bounding_box": {
              "center": [
                0,
                0,
                0
              ],
              "size": [
                10,
                10,
                10
              ],
              "padding": 10
            },
            "remove_water": false,
            "remove_ion": false
          },
          "ligands": [
            {
              "source": "PRIVATE",
              "url": "project:/dir/file"
            }
          ],
          "model_ids": [
            "xxxxxx"
          ],
          "molecular_weight": [
            200,
            600
          ]
        }
      }
    }
  },
  "definitions": {
    "BoundingBoxDto": {
      "required": [
        "center",
        "size"
      ],
      "type": "object",
      "description": "结合口袋,包含口袋中心位置和尺寸大小",
      "properties": {
        "center": {
          "type": "array",
          "description": "口袋中心坐标; x, y, z轴的坐标",
          "minItems": 3,
          "maxItems": 3,
          "example": [
            1.3,
            23.4,
            -14.5
          ],
          "items": {
            "type": "number",
            "format": "float",
            "minimum": -9999999,
            "maximum": 99999999
          }
        },
        "size": {
          "type": "array",
          "description": "口袋尺寸大小;  x, y, z轴的大小",
          "minItems": 3,
          "maxItems": 3,
          "example": [
            10.0,
            10.0,
            10.0
          ],
          "items": {
            "type": "number",
            "format": "float",
            "minimum": 2,
            "maximum": 500
          }
        },
        "padding": {
          "type": "number",
          "format": "float",
          "minimum": 0,
          "maximum": 20,
          "description": "填充"
        }
      }
    },
    "LabelSite": {
      "description": "靶点分子设计标记位点",
      "type": "object",
      "properties": {
        "index": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "items": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 99999
          },
          "description": "索引",
          "example": [
            0,
            1
          ]
        },
        "name": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": "标记位点名称",
          "example": [
            "site_x",
            "site_y"
          ]
        },
        "coordinate": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "items": {
            "type": "array",
            "description": "位点三维坐标",
            "items": {
              "type": "number",
              "format": "float",
              "minimum": -9999999,
              "maximum": 99999999
            }
          },
          "example": [
            [
              1,
              2,
              3
            ],
            [
              4,
              5,
              6
            ]
          ],
          "description": "位点三维坐标集"
        }
      }
    },
    "PocketMolDesignReceptorDto": {
      "type": "object",
      "required": [
        "file"
      ],
      "description": "靶点口袋分子设计的靶点文件",
      "properties": {
        "file": {
          "$ref": "#/definitions/ReceptorDrugFile",
          "description": "靶点文件"
        },
        "bounding_box": {
          "$ref": "#/definitions/BoundingBoxDto"
        },
        "remove_ion": {
          "type": "boolean",
          "description": "去除受体中的离子",
          "default": true
        },
        "remove_water": {
          "type": "boolean",
          "description": "去除受体中的水分子",
          "default": true
        },
        "remove_ligand": {
          "type": "boolean",
          "description": "去除受体中的配体分子",
          "default": true
        },
        "add_hydrogen": {
          "type": "boolean",
          "default": false,
          "description": "增加氢原子"
        }
      }
    },
    "CreateDrugJobBasicInfo": {
      "type": "object",
      "required": [
        "name"
      ],
      "description": "创建药物作业基本信息",
      "properties": {
        "name": {
          "type": "string",
          "example": "demo-job",
          "minLength": 5,
          "maxLength": 64,
          "pattern": "^[a-z0-9A-Z]+[a-z0-9A-Z-_\\s]+$",
          "x-pattern-message": "The name format does not match.",
          "description": "作业的名称,取值范围:[5,64],允许大小写字母、数字、空格、下划线(_)和中划线(-),只能以数字或字母开头"
        },
        "labels": {
          "type": "array",
          "example": [
            "labelA",
            "labelB"
          ],
          "description": "标签,取值范围[0,5],单个标签最大长度32字符,支持中文、字母、数字、空格、下划线和中划线,且不能以空格开头或者结尾。",
          "items": {
            "type": "string",
            "pattern": "^[\\一-\\龥A-Za-z0-9-_]+(\\s+[\\一-\\龥A-z0-9-_]+)*$",
            "maxLength": 32,
            "minLength": 1,
            "x-pattern-message": "The label name format does not match"
          },
          "minItems": 0,
          "maxItems": 5
        },
        "upstream_job_info": {
          "type": "string",
          "maxLength": 10240,
          "minLength": 1,
          "example": "{\"job_id\":\"demo-job-id\",\"job_name\":\"demo-job-name\"}",
          "description": "**参数解释**:\n上游作业信息。\n**约束限制**:\n不涉及\n**取值范围**:\n长度为[1-10240]个字符。\n**默认取值**:\n不涉及"
        }
      }
    },
    "ReceptorDrugFile": {
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/DrugFileSource",
          "example": "RAW"
        },
        "url": {
          "type": "string",
          "description": "文件URL,当数据源为外部网络数据时为https地址;用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "pattern": ".*\\.(pdb)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB)$",
          "description": "文件格式,仅支持PDB,仅数据源为RAW时提供"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "文件原始数据,仅数据源为RAW时提供",
          "x-ut-exclude-equivalence": [
            "NULL"
          ]
        }
      }
    },
    "EditedLigand": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "RAW",
          "pattern": "^RAW$",
          "description": "文件来源,仅支持RAW"
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "CIF",
          "pattern": "^(CIF)$",
          "description": "文件格式,仅支持CIF"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "文件原始数据,仅数据源为RAW时提供"
        }
      }
    },
    "DrugJobIdRsp": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "作业id"
        },
        "limit_concurrency": {
          "type": "integer",
          "format": "int32",
          "example": 50,
          "description": "限制的并发量"
        }
      }
    },
    "PocketFragment": {
      "type": "object",
      "description": "靶点口袋分子优化片段",
      "properties": {
        "source": {
          "$ref": "#/definitions/DrugFileSource",
          "example": "RAW"
        },
        "url": {
          "type": "string",
          "description": "文件URL,当数据源为外部网络数据时为https地址;用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "pattern": ".*\\.(pdb|mol2|sdf|smi)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB|SDF|MOL2|SMI)$",
          "description": "文件格式,支持PDB、SDF、MOL2、SMI,仅数据源为RAW时提供"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "example": "LIG::0",
          "description": "原始配体名称,仅RAW类型时用于配体名称标识"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "文件原始数据,仅数据源为RAW时提供"
        },
        "edited": {
          "$ref": "#/definitions/EditedLigand",
          "description": "编辑后的配体"
        },
        "label_sites": {
          "description": "标记位点",
          "$ref": "#/definitions/LabelSite"
        }
      }
    },
    "OptimizationMode": {
      "type": "string",
      "enum": [
        "generation",
        "side_chains_decoration",
        "scaffold_hopping",
        "fragment_growing"
      ],
      "description": "靶点口袋分子设计模式:支持从头生成、侧链修饰、骨架跃迁、片段生长。"
    },
    "CreatePocketMolDesignJobReq": {
      "type": "object",
      "required": [
        "basic_info",
        "receptor",
        "ligand"
      ],
      "properties": {
        "basic_info": {
          "$ref": "#/definitions/CreateDrugJobBasicInfo",
          "description": "作业基本信息"
        },
        "receptor": {
          "$ref": "#/definitions/PocketMolDesignReceptorDto",
          "description": "靶点文件"
        },
        "ligands": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/PocketFragment"
          },
          "description": "配体文件列表,最多支持1个"
        },
        "num_trials": {
          "type": "integer",
          "format": "int32",
          "description": "生成分子数量",
          "minimum": 1,
          "maximum": 5000,
          "default": 1000
        },
        "model_ids": {
          "description": "模型id列表",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "example": [
            "model_id"
          ],
          "minItems": 0,
          "maxItems": 10
        },
        "molecular_weight": {
          "type": "array",
          "description": "分子量范围",
          "minItems": 2,
          "maxItems": 2,
          "example": [
            500,
            600
          ],
          "items": {
            "type": "integer",
            "format": "int32",
            "maximum": 1000,
            "minimum": 1
          }
        },
        "optimization_mode": {
          "$ref": "#/definitions/OptimizationMode",
          "description": "优化类型"
        },
        "base_model_id": {
          "type": "string",
          "description": "**参数解释**:\n基模型ID。\n**约束限制**:\n当optimization_mode为generation时,可选择PanguDrug3D、Lingo3DMol,当为其他方式时,仅可选择可选择PanguDrug3D。\n**取值范围**:\n- PanguDrug3D\n- Lingo3DMol\n**默认取值**:\n不涉及",
          "minLength": 0,
          "maxLength": 128,
          "example": "PanguDrug3D",
          "x-ut-exclude-equivalence": [
            "UPPER_BOUND"
          ]
        }
      }
    },
    "DrugFileSource": {
      "type": "string",
      "enum": [
        "EXTRANET",
        "PRIVATE",
        "PUBLIC",
        "RAW"
      ],
      "description": "受体的数据源:外部网络数据(如RCSB在线数据库)、用户私有数据中心、承载租户公共数据(含样例/公共库)"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}