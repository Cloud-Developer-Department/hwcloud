{
  "name": "ListFavorite",
  "summary": "获取收藏夹列表",
  "tags": "收藏管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/favorites": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-ut-partial": true,
        "operationId": "ListFavorite",
        "x-interface-name": "IFavoriteController",
        "tags": [
          "收藏管理"
        ],
        "summary": "获取收藏夹列表",
        "description": "获取收藏夹列表。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "name": "resource_id",
            "in": "query",
            "description": "资源ID。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "resource_id is invalid"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,查询起始偏移,必须由数字组成,默认为0,取值范围[0,100000000]。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 100000000,
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制量,单次查询总量,必须由数字组成,默认为100,取值范围[1,1000]。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 100,
            "maximum": 1000,
            "minimum": 1
          },
          {
            "name": "user_name_list",
            "in": "query",
            "description": "收藏人名称列表。",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 10
          },
          {
            "name": "resource_type_list",
            "in": "query",
            "required": false,
            "description": "资源类型列表。",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 5
          },
          {
            "name": "type_list",
            "in": "query",
            "required": false,
            "description": "收藏类型列表,支持MICROMOLECULE|PROTEIN。",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16
            },
            "minItems": 0,
            "maxItems": 5
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "查询收藏信息的起始时间,UNIX时间戳,单位毫秒,不填时默认为当前时间。",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "查询收藏信息的结束时间,UNIX时间戳,单位毫秒,不填时默认为当前时间。",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "key_word",
            "in": "query",
            "description": "关键字,支持在display_info字段中内容的模糊搜索。",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序规则,目前默认时间降序。",
            "required": false,
            "type": "string",
            "default": "DESC",
            "x-enum-type": "SortDir"
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序规则,目前默认按收藏时间降序,支持根据create_time|user_name|resource_name|resource_type排序。",
            "required": false,
            "type": "string",
            "x-enum-type": "FavoriteSortKey"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListFavoriteRsp"
            },
            "examples": {
