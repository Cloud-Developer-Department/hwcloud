{
  "name": "ShowTaskInstances",
  "summary": "获取子任务实例信息",
  "tags": "作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/jobs/{job_id}/tasks/{task_name}/instances": {
      "get": {
        "x-interface-name": "IJobController",
        "tags": [
          "作业管理"
        ],
        "summary": "获取子任务实例信息",
        "description": "获取子任务实例信息",
        "operationId": "ShowTaskInstances",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is illegal"
          },
          {
            "name": "job_id",
            "in": "path",
            "description": "作业id",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "The job id format does not match."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "task_name",
            "in": "path",
            "description": "子任务名称",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "task_index",
            "in": "query",
            "description": "子任务的并发序号",
            "required": false,
            "type": "string",
            "default": "0",
            "maxLength": 128,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "count": 0,
                "instances": [
                  {
                    "status": {
                      "phase": "Failed",
                      "pod_ip": "192.168.0.1",
                      "host_ip": "192.168.0.1",
                      "host_name": "health-f789d9c5-e8e6-44e7-84fb-8e234bba1cee",
                      "start_time": "2021-01-30T02:34:36Z",
                      "container_statuses": [
                        {
                          "restart_count": 0
                        }
                      ]
                    },
                    "metadata": {
                      "name": "string",
                      "namespace": "default"
                    },
                    "spec": {
                      "containers": [
                        {
                          "resources": {
                            "limits": {
                              "cpu": "string",
                              "memory": "string"
                            },
                            "requests": {
                              "cpu": "string",
                              "memory": "string"
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListTaskInstanceRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "TaskInstanceRsp": {
      "type": "object",
      "properties": {
        "status": {
          "description": "实例状态信息",
          "$ref": "#/definitions/TaskInstanceStatusRsp"
        },
        "metadata": {
          "description": "实例元数据信息",
          "$ref": "#/definitions/TaskInstanceMetadataRsp"
        },
        "spec": {
          "description": "实例cpu和内存使用率信息",
          "$ref": "#/definitions/TaskInstanceSpecRsp"
        }
      }
    },
    "TaskInstanceSpecRsp": {
      "type": "object",
      "properties": {
        "containers": {
          "type": "array",
          "description": "实例详情响应体",
          "items": {
            "$ref": "#/definitions/TaskInstanceSpecContainersRsp"
          }
        }
      }
    },
    "TaskInstanceSpecConResourceRsp": {
      "type": "object",
      "properties": {
        "limits": {
          "$ref": "#/definitions/TaskInstanceSpecConResLimitRsp"
        },
        "requests": {
          "$ref": "#/definitions/TaskInstanceSpecConResRequestRsp"
        }
      }
    },
    "TaskInstanceStatusRsp": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "example": "Failed",
          "description": "实例执行状态"
        },
        "pod_ip": {
          "type": "string",
          "example": "192.168.0.1",
          "description": "实例IP"
        },
        "host_ip": {
          "type": "string",
          "example": "192.168.0.1",
          "description": "实例所在节点IP"
        },
        "host_name": {
          "type": "string",
          "example": "health-f789d9c5-e8e6-44e7-84fb-8e234bba1cee",
          "description": "计算节点的名称"
        },
        "start_time": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "实例创建时间"
        },
        "container_statuses": {
          "type": "array",
          "description": "实例状态信息",
          "items": {
            "$ref": "#/definitions/TaskInstanceContainerStatusRsp"
          }
        }
      }
    },
    "TaskInstanceSpecConResRequestRsp": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string",
          "description": "CPU申请值"
        },
        "memory": {
          "type": "string",
          "description": "内存申请值"
        }
      }
    },
    "TaskInstanceMetadataRsp": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "实例名称"
        },
        "namespace": {
          "type": "string",
          "example": "default",
          "description": "命名空间"
        }
      }
    },
    "TaskInstanceSpecConResLimitRsp": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string",
          "description": "CPU限制值"
        },
        "memory": {
          "type": "string",
          "description": "内存限制值"
        }
      }
    },
    "TaskInstanceContainerStatusRsp": {
      "type": "object",
      "properties": {
        "restart_count": {
          "type": "integer",
          "format": "int32",
          "description": "重启次数"
        }
      }
    },
    "ListTaskInstanceRsp": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "实例个数"
        },
        "instances": {
          "type": "array",
          "description": "实例响应结构体",
          "items": {
            "$ref": "#/definitions/TaskInstanceRsp"
          }
        }
      }
    },
    "TaskInstanceSpecContainersRsp": {
      "type": "object",
      "properties": {
        "resources": {
          "$ref": "#/definitions/TaskInstanceSpecConResourceRsp"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}