{
  "name": "ListObsBucketObject",
  "summary": "获取用户OBS桶内对象",
  "tags": "OBS桶管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/customer-buckets/{bucket_name}/objects": {
      "get": {
        "tags": [
          "OBS桶管理"
        ],
        "x-interface-name": "IObsController",
        "summary": "获取用户OBS桶内对象",
        "description": "获取用户OBS桶内对象",
        "operationId": "ListObsBucketObject",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "bucket_name",
            "in": "path",
            "description": "桶名称",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "[0-9a-z-.]*",
            "x-pattern-message": "Invalid bucket name."
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制量,单次查询总量[1, 1000],默认100",
            "required": false,
            "type": "integer",
            "default": 100,
            "maximum": 1000,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,查询起始偏移,默认为0",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 100000000,
            "minimum": 0,
            "format": "int32"
          },
          {
            "name": "path",
            "in": "query",
            "description": "子路径",
            "required": false,
            "type": "string",
            "maxLength": 2000,
            "minLength": 0,
            "x-example": "path/"
          },
          {
            "name": "search_key",
            "in": "query",
            "description": "查询关键词",
            "required": false,
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "count": 1,
                "objects": [
                  {
                    "path": "bucket:/test.txt",
                    "name": "test.txt",
                    "type": "FILE",
                    "size": 1024,
                    "create_time": "2021-02-01T14:25:34.000+00:00"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListObsBucketObjectRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "获取用户OBS桶内对象",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/customer-buckets/{bucket_name}/object"
      }
    }
  },
  "definitions": {
    "ListObsBucketObjectRsp": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 10,
          "description": "数据(文件夹、文件)总数量"
        },
        "objects": {
          "type": "array",
          "description": "数据列表",
          "items": {
            "$ref": "#/definitions/BucketObjectDto"
          }
        }
      },
      "description": "查询OBS桶内数据响应参数"
    },
    "BucketObjectDto": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "example": "test-project-01:/db_test1.txt",
          "description": "对象全路径(项目名称:/路径)"
        },
        "name": {
          "type": "string",
          "example": "db_test1.txt",
          "description": "名称"
        },
        "type": {
          "description": "类型",
          "$ref": "#/definitions/PathType"
        },
        "size": {
          "type": "integer",
          "format": "int64",
          "example": 1862,
          "description": "大小"
        },
        "create_time": {
          "type": "string",
          "example": "2021-02-01T14:25:34Z",
          "description": "创建时间"
        }
      },
      "title": "BucketObjectDto",
      "description": "数据对象"
    },
    "PathType": {
      "type": "string",
      "enum": [
        "FILE",
        "FOLDER"
      ],
      "x-json-name": "type"
    }
  },
  "version": "2.0",
  "parameters": {},
