{
  "name": "ShowEnv",
  "summary": "查询系统配置列表",
  "tags": "系统配置内部接口",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/system/configs": {
      "get": {
        "x-interface-name": "ISystemInternalController",
        "tags": [
          "系统配置内部接口"
        ],
        "summary": "查询系统配置列表",
        "description": "获取系统配置列表",
        "operationId": "ShowEnv",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "dev_user_pool": false,
                "has_dev": false,
                "has_drug": false,
                "has_encryption_button": false,
                "deploy_mode": "basic",
                "enable_cold_archive": true
              }
            },
            "schema": {
              "$ref": "#/definitions/GetEnvRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "查询系统配置列表",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/system/configs"
      }
    }
  },
  "definitions": {
    "GetEnvRsp": {
      "properties": {
        "dev_user_pool": {
          "type": "boolean",
          "example": false,
          "description": "notebook是否使用专属资源池"
        },
        "has_dev": {
          "type": "boolean",
          "example": false,
          "description": "是否集成开发环境"
        },
        "has_drug": {
          "type": "boolean",
          "example": false,
          "description": "是否部署药物虚拟筛选"
        },
        "has_encryption_button": {
          "type": "boolean",
          "example": false,
          "description": "是否显示加密按钮"
        },
        "deploy_mode": {
          "type": "string",
          "example": "basic|standard|professional|permium",
          "description": "医疗智能体部署模式"
        },
        "enable_cold_archive": {
          "type": "boolean",
          "example": false,
          "description": "是否支持归档类型存储"
        },
        "public_bucket_path": {
          "type": "string",
          "example": "https://bucket.obs.cn-north-4.myhuawei.com",
          "description": "医疗智能体公共数据桶https路径"
        }
      },
      "title": "SystemConfigsDto",
      "description": "获取系统配置列表返回体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}