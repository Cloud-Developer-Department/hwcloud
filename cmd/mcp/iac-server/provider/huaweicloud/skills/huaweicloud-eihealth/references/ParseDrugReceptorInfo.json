{
  "name": "ParseDrugReceptorInfo",
  "summary": "受体信息解析",
  "tags": "IDrugCommonController",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-common/receptor/info": {
      "post": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ParseDrugReceptorInfo",
        "tags": [
          "IDrugCommonController"
        ],
        "summary": "受体信息解析",
        "description": "受体信息解析,如果有多个受体蛋白则只处理第一个,如果一个受体蛋白里结合了多个配体,则最多只处理前10个",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "name": "ParseDrugReceptorInfoRequestBody",
            "in": "body",
            "required": true,
            "description": "受体信息解析请求体",
            "schema": {
              "$ref": "#/definitions/ReceptorDrugFileReq"
            }
          }
        ],
        "x-request-examples-1": {
          "source": "RAW",
          "url": "https://files.rcsb.org/download/1TQN.pdb",
          "format": "PDB",
          "data": "MODEL1.xxxxxxx.END"
        },
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-common/receptor/info",
        "x-request-examples-description-1": "受体信息解析,如果有多个受体蛋白则只处理第一个,如果一个受体蛋白里结合了多个配体,则最多只处理前10个",
        "responses": {
          "200": {
            "description": "受体信息解析响应",
            "schema": {
              "$ref": "#/definitions/ParseReceptorInfoRsp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ReceptorDrugFileReq": {
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/DrugFileSource",
          "example": "RAW"
        },
        "url": {
          "type": "string",
          "description": "文件URL,当数据源为外部网络数据时为https地址;用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "pattern": ".*\\.(pdb)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB)$",
          "description": "文件格式,仅支持PDB,仅数据源为RAW时提供"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "description": "文件原始数据,仅数据源为RAW时提供",
          "example": "raw_data"
        },
        "add_hydrogen": {
          "type": "boolean",
          "default": true,
          "description": "增加氢原子"
        }
      },
      "description": "受体文件"
    },
    "LigandStructureDto": {
      "type": "object",
      "description": "配体3D结构",
      "required": [
        "format",
        "data"
      ],
      "properties": {
        "format": {
          "type": "string",
          "description": "配体格式,即文件后缀名",
          "minLength": 1,
          "maxLength": 5,
          "example": "MOL2"
        },
        "compressed": {
          "type": "boolean",
          "description": "是否压缩",
          "default": false
        },
        "data": {
          "type": "string",
          "description": "结构数据,如压缩则需要解码、解压处理(ASCII Encode -> Base64 Decode -> GZip Inflate -> UTF-8 Decode)以得到原始字符串;如未压缩则为原始字符串",
          "minLength": 0,
          "maxLength": 10000000
        }
      }
    },
    "DrugBoundingBoxDto": {
      "type": "object",
      "description": "结合口袋,包含口袋中心位置和尺寸大小",
      "required": [
        "center",
        "size"
      ],
      "properties": {
        "center": {
          "type": "array",
          "description": "口袋中心坐标;x, y, z轴的坐标",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "format": "float",
            "minimum": -9999999,
            "maximum": 99999999
          }
        },
        "size": {
          "type": "array",
          "description": "口袋尺寸大小;x, y, z轴的大小",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "format": "float",
            "minimum": 2,
            "maximum": 500
          }
        }
      }
    },
    "ReceptorLigandInfoDto": {
      "type": "object",
      "description": "受体中配体信息,若成功则除reason字段均有,若失败也有可能存在formula和smiles字段",
      "required": [
        "index",
        "name",
        "success"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 9,
          "description": "配体索引(从0起编号)"
        },
        "name": {
          "type": "string",
          "description": "配体名称,即配体所在的残基表示",
          "minLength": 1,
          "maxLength": 128,
          "example": "GLY:A:222"
        },
        "success": {
          "type": "boolean",
          "description": "解析是否成功"
        },
        "smiles": {
          "type": "string",
          "description": "分子SMILES表达式",
          "minLength": 1,
          "maxLength": 512,
          "example": "CC"
        },
        "formula": {
          "type": "string",
          "description": "配体分子的化学式",
          "minLength": 1,
          "maxLength": 128,
          "example": "C6H6"
        },
        "structure": {
          "$ref": "#/definitions/LigandStructureDto"
        },
        "bounding_box": {
          "$ref": "#/definitions/DrugBoundingBoxDto"
        }
      }
    },
    "ResidueDto": {
      "type": "object",
      "description": "氨基酸残基或者配体",
      "required": [
        "chain",
        "residue_name",
        "residue_id"
      ],
      "properties": {
        "chain": {
          "type": "string",
          "description": "氨基酸残基或者配体链的名称",
          "pattern": "^[A-Z]",
          "example": "chain_name"
        },
        "name": {
          "type": "string",
          "description": "氨基酸残基或者配体名称",
          "minLength": 1,
          "maxLength": 10,
          "example": "ligand_name"
        },
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "氨基酸残基或者配体的序列ID",
          "minLength": 1,
          "maxLength": 99999,
          "example": 10
        }
      },
      "example": {
        "chain": "A",
        "residue_name": "SER",
        "residue_id": 122
      }
    },
    "ParseReceptorInfoRsp": {
      "type": "object",
      "description": "受体信息响应体",
      "required": [
        "residues",
        "ligands"
      ],
      "properties": {
        "residues": {
          "type": "array",
          "minLength": 0,
          "maxLength": 100000,
          "description": "受体中的氨基酸残基列表",
          "items": {
            "$ref": "#/definitions/ResidueDto"
          }
        },
        "ligands": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "description": "受体中的配体列表",
          "items": {
            "$ref": "#/definitions/ReceptorLigandInfoDto"
          }
        }
      }
    },
    "DrugFileSource": {
      "type": "string",
      "enum": [
        "EXTRANET",
        "PRIVATE",
        "PUBLIC",
        "RAW"
      ],
      "description": "受体的数据源:外部网络数据(如RCSB在线数据库)、用户私有数据中心、承载租户公共数据(含样例/公共库)"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}