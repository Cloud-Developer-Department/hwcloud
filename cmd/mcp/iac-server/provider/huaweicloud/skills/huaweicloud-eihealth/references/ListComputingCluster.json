{
  "name": "ListComputingCluster",
  "summary": "获取计算集群列表",
  "tags": "计算集群管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/system/computing-clusters": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-ut-partial": true,
        "x-interface-name": "IComputingClusterController",
        "tags": [
          "计算集群管理"
        ],
        "summary": "获取计算集群列表",
        "description": "获取计算集群列表。",
        "operationId": "ListComputingCluster",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](ai4s_03_0011.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](ai4s_03_0023.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制量,单次查询总量,必须由数字组成,默认为100,取值范围[1,1000]。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 100,
            "maximum": 1000,
            "minimum": 1
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,查询起始偏移,必须由数字组成,默认为0,取值范围[0,100000000]。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 100000000,
            "minimum": 0
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListComputingClusterRsp"
            },
            "examples": {
              "application/json": {
                "count": 1,
                "clusters": [
                  {
                    "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                    "name": "cce_cluster_name",
                    "version": 1.25,
                    "category": "CCE",
                    "flavor": "cce.s1.small",
                    "cce_status": "Available",
                    "cce_id": "afdccb56-5bb6-11eb-8a0d-fa163e3dddwa",
                    "status": "Running",
                    "active_nodes_number": 1,
                    "total_nodes_number": 1,
                    "create_time": "2024-01-01T14:25:50Z"
                  }
                ]
              }
            }
          }
        },
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/system/computing-clusters",
        "x-request-examples-description-1": "获取计算集群列表,查询起始偏移为0,单次查询总量为10。"
      }
    }
  },
  "definitions": {
    "ComputingClusterRsp": {
      "description": "计算集群详情。",
      "properties": {
        "id": {
          "type": "string",
          "description": "已绑定的集群ID。"
        },
        "name": {
          "type": "string",
          "description": "计算集群名称。"
        },
        "version": {
          "type": "string",
          "description": "计算集群版本。"
        },
        "flavor": {
          "type": "string",
          "description": "计算集群规格。"
        },
        "category": {
          "type": "string",
          "description": "计算集群类别。CCE代表CCE集群,Turbo代表CCE Turbo集群。"
        },
        "status": {
          "type": "string",
          "description": "计算集群绑定状态,支持RUNNING|INSTALL_FAILED|UNINSTALL_FAILED|INSTALLING|UNINSTALLING。"
        },
        "active_nodes_number": {
          "type": "integer",
          "format": "int32",
          "description": "计算集群可用节点数。"
        },
        "total_nodes_number": {
          "type": "integer",
          "format": "int32",
          "description": "计算集群总节点数。"
        },
        "create_time": {
          "type": "string",
          "description": "计算集群绑定时间。"
        },
        "cce_create_time": {
          "type": "string",
          "description": "cce集群创建时间。"
        },
        "cce_status": {
          "type": "string",
          "description": "cce集群绑态。"
        },
        "cce_id": {
          "type": "string",
          "description": "cce集群ID。"
        },
        "billing_mode": {
          "type": "string",
          "description": "计费模式,prepaid表示包周期,postpaid表示按需。"
        }
      }
    },
    "ListComputingClusterRsp": {
      "properties": {
        "clusters": {
          "type": "array",
          "description": "计算集群列表。",
          "items": {
            "$ref": "#/definitions/ComputingClusterRsp"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "计算集群总数。"
        }
      },
      "description": "查询计算集群列表响应体。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}