{
  "name": "ShowAgency",
  "summary": "获取业务委托",
  "tags": "业务委托管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/system/agencies": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-interface-name": "IAgencyController",
        "tags": [
          "业务委托管理"
        ],
        "summary": "获取业务委托",
        "description": "获取业务委托。",
        "operationId": "ShowAgency",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](ai4s_03_0011.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](ai4s_03_0023.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          }
        ],
        "x-request-examples-description-1": "获取业务委托。",
        "x-request-examples-url-1": "/v1/{project_id}/system/agencies",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/AgencyRsp"
            },
            "examples": {
              "application/json": {
                "existing_agencies": [
                  {
                    "id": "id",
                    "name": "agency-name",
                    "description": "description",
                    "trust_domain_name": "op_svc_eihealth",
                    "roles": [
                      {
                        "id": "id",
                        "display_name": "role-name",
                        "description": "description",
                        "type": "XA",
                        "actions": [
                          [
                            "css:cluster:get",
                            "css:cluster:list"
                          ]
                        ]
                      }
                    ]
                  }
                ],
                "wanted_agencies": [],
                "redundant_agencies": []
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "AgencyRsp": {
      "properties": {
        "existing_agencies": {
          "type": "array",
          "description": "当前存在的委托权限列表。",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/AgencyDto"
          }
        },
        "wanted_agencies": {
          "type": "array",
          "description": "仍需要的委托权限列表。",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/AgencyDto"
          }
        },
        "redundant_agencies": {
          "type": "array",
          "description": "冗余的委托权限列表。",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/AgencyDto"
          }
        }
      },
      "description": "查询委托列表响应体。"
    },
    "AgencyDto": {
      "properties": {
        "id": {
          "type": "string",
          "example": "id",
          "description": "委托ID。"
        },
        "name": {
          "type": "string",
          "example": "agency-name",
          "description": "委托名。"
        },
        "trust_domain_name": {
          "type": "string",
          "example": "account-name",
          "description": "被委托方账号名。"
        },
        "description": {
          "type": "string",
          "example": "description",
          "description": "委托描述。"
        },
        "roles": {
          "type": "array",
          "description": "委托权限列表。",
          "items": {
            "$ref": "#/definitions/IamRoleDto"
          }
        }
      },
      "description": "委托结构体。"
    },
    "IamRoleDto": {
      "properties": {
        "id": {
          "type": "string",
          "example": "id",
          "description": "权限ID。"
        },
        "display_name": {
          "type": "string",
          "example": "role-name",
          "description": "权限显示名称。"
        },
        "type": {
          "type": "string",
          "example": "XA",
          "description": "权限类型:AX为全局级角色,XA为项目级角色。"
        },
        "description": {
          "type": "string",
          "example": "description",
          "description": "权限描述。"
        },
        "actions": {
          "type": "array",
          "description": "授权项,指对资源的具体操作权限。",
          "items": {
            "type": "string"
          },
          "example": [
            [
              "css:cluster:get",
              "css:cluster:list"
            ]
          ]
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}