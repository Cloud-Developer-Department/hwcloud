{
  "name": "UpdateVendor",
  "summary": "设置供应商配置",
  "tags": "系统配置内部接口",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/system/vendor-config": {
      "put": {
        "x-interface-name": "ISystemInternalController",
        "tags": [
          "系统配置内部接口"
        ],
        "summary": "设置供应商配置",
        "description": "设置供应商配置",
        "operationId": "UpdateVendor",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "file",
            "in": "formData",
            "description": "文件流对象",
            "required": true,
            "type": "file",
            "x-example": "50_32.png"
          },
          {
            "name": "name",
            "in": "formData",
            "description": "供应商名称",
            "required": true,
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "x-example": "vendor-example"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "设置供应商配置,设置名称,上传图片",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/system/vendor-config",
        "x-request-examples-1": {
          "file": "(binary)",
          "name": "EI HEALTH API"
        }
      }
    }
  },
