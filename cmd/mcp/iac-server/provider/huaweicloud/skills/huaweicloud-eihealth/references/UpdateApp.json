          "minLength": 5,
          "maxLength": 255,
          "pattern": "^[^\\一-\\龥]+/[^\\一-\\龥]+:[^\\一-\\龥]+$",
          "x-pattern-message": "The app parameter format does not match."
        },
        "commands": {
          "type": "array",
          "example": [
            "echo eihealth;"
          ],
          "description": "docker启动时执行命令 取值范围[1-300],单个命令长度取值范围[0-256],不能包含中文字符",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 256,
            "pattern": "^$|^[^\\一-\\龥]*$"
