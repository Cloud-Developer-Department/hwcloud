            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^(health\\.)([\\.A-Za-z0-9_-]*[A-Za-z0-9])$",
            "x-pattern-message": "The computing resource nodeLabel should start with 'health.' and end with letters or digit, can only contain '.','-','_' ."
          },
          "maxItems": 1,
          "minItems": 0,
          "x-ut-exclude-equivalence": [
            "UPPER_BOUND"
          ]
        },
        "icon": {
          "type": "string",
          "example": "data:image/svg+xml;base64,",
          "description": "图标base64编码",
          "minLength": 0,
          "maxLength": 20000,
          "pattern": "^$|^(data:image/svg\\+xml;base64,)[A-Za-z0-9+/=]*$",
          "x-pattern-message": "The app parameter format does not match."
