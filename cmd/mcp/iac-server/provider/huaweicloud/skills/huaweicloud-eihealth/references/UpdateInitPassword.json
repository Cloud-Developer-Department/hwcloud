{
  "name": "UpdateInitPassword",
  "summary": "新用户重置密码",
  "tags": "用户管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/users/{user_id}/init-password": {
      "put": {
        "x-interface-name": "IUserController",
        "tags": [
          "用户管理"
        ],
        "summary": "新用户重置密码",
        "description": "新用户重置密码",
        "operationId": "UpdateInitPassword",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "{ \"user\" : { \"id\" : \"{user_id}\" } }"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "in": "body",
            "name": "UpdateInitPasswordRequestBody",
            "description": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ResetPasswordReq"
            }
          },
          {
            "name": "user_id",
            "in": "path",
            "description": "用户id",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "user_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "重置新用户密码,校验码为string,校验方法为string,修改原始密码Original_Password@为New_Password@",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/users/{user_id}/init-password",
        "x-request-examples-1": {
          "code": "string",
          "method": "string",
          "original_password": "Original_Password@",
          "new_password": "New_Password@"
        }
      }
    }
  },
  "definitions": {
    "ResetPasswordReq": {
      "required": [
        "new_password",
        "original_password"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "验证码",
          "minLength": 6,
          "maxLength": 8,
          "pattern": "^\\d*$",
          "x-pattern-message": "Captchas can only be 6 or 8 digits"
        },
        "method": {
          "type": "string",
          "description": "认证方式",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(sms|email|vmfa)$",
          "x-pattern-message": "Authentication only supports ‘sms’,‘email’,‘vmfa’"
        },
        "original_password": {
          "type": "string",
          "example": "Original_Password@",
          "description": "原始密码",
          "minLength": 0,
          "maxLength": 128
        },
        "new_password": {
          "type": "string",
          "example": "New_Password@",
          "description": "新密码",
          "minLength": 8,
          "maxLength": 32,
          "pattern": "^(?![a-z]+$)(?![A-Z]+$)(?![0-9]+$)(?![_\\\\`~!@#$%^&*()\\-\\=+|\\[{}\\];:'\",<.>/? ]+$)[a-zA-Z0-9_\\\\`~!@#$%^&*()\\-\\=+|\\[{}\\];:'\",<.>/? ]*$",
          "x-pattern-message": "The password must contain at least two of the following character types: uppercase letters, lowercase letters, digits, and special characters, and be a length between 8 and 32."
        }
      },
      "title": "ResetPasswordRequest",
      "description": "重置密码请求体"
    }
  },
