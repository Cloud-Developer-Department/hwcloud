{
  "name": "ListDrugDatabase",
  "summary": "获取数据库列表",
  "tags": "药物数据库管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/drug/databases": {
      "get": {
        "x-ut-partial": true,
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-interface-name": "IDrugDatabaseController",
        "tags": [
          "药物数据库管理"
        ],
        "summary": "获取数据库列表",
        "description": "获取数据库列表",
        "operationId": "ListDrugDatabase",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "search_key",
            "in": "query",
            "description": "数据库名称搜索",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          },
          {
            "name": "type",
            "in": "query",
            "description": "数据库类型搜索",
            "required": false,
            "type": "string",
            "x-enum-type": "DrugDatabaseType"
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序规则 目前默认时间降序,支持根据create_time|update_time",
            "required": false,
            "type": "string",
            "x-enum-type": "QueryDrugDatabaseSortKey"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序规则 目前默认时间降序",
            "required": false,
            "type": "string",
            "default": "desc",
            "x-enum-type": "SortDir2"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制量,单次查询总量,必须由数字组成,默认为100,取值范围[1,1000]",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 100,
            "maximum": 1000,
            "minimum": 1
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,查询起始偏移,必须由数字组成,默认为0,取值范围[0,100000000]",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 100000000,
            "minimum": 0
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListDrugDatabaseRsp"
            },
            "examples": {
              "count": 1,
              "cur_user_count": 1,
              "databases": [
                {
                  "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                  "name": "database_name",
                  "status": "ACTIVE",
                  "description": "description",
                  "create_time": "2024-01-30T02:34:36Z",
                  "update_time": "2024-01-30T02:53:26Z",
                  "creator": "demo_user_name",
                  "failed_message": "null",
                  "css_id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba2",
                  "css_name": "css_name",
                  "files": [
                    {
                      "source": "public",
                      "url": "project:/test/url.csv",
                      "eihealth_project_id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                      "status": "SUCCESS"
                    }
                  ],
                  "columns": [
                    "SMILES",
                    "NAME"
                  ],
                  "shareable": true,
                  "data_num": 500
                }
              ]
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "ListDrugDatabaseRsp": {
      "properties": {
        "databases": {
          "type": "array",
          "description": "数据库列表",
          "items": {
            "$ref": "#/definitions/DrugDatabaseDto"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "数据库总数"
        },
        "cur_user_count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "当前用户数据库总数"
        }
      },
      "description": "查询数据库列表响应体"
    },
    "DrugDatabaseDto": {
      "properties": {
        "id": {
          "type": "string",
          "description": "数据库id",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1"
        },
        "name": {
          "type": "string",
          "description": "数据库名称",
          "example": "database_name"
        },
        "type": {
          "type": "string",
          "description": "数据库类型",
          "example": "CUSTOM"
        },
        "status": {
          "type": "string",
          "example": "CREATING",
          "description": "数据库状态"
        },
        "description": {
          "type": "string",
          "description": "数据库描述",
          "example": "description"
        },
        "create_time": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "数据库创建时间"
        },
        "update_time": {
          "type": "string",
          "example": "2021-01-30T02:53:26Z",
          "description": "数据库更新时间"
        },
        "creator": {
          "type": "string",
          "example": "demo_user_name",
          "description": "创建数据库的用户名称"
        },
        "failed_message": {
          "type": "string",
          "example": "null",
          "description": "失败提示,当作业执行失败时会返回"
        },
        "css_id": {
          "type": "string",
          "description": "css集群id",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba2"
        },
        "css_name": {
          "type": "string",
          "description": "css集群名称",
          "example": "css_name"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DetailDatabaseFile"
          },
          "description": "数据库文件列表"
        },
        "columns": {
          "description": "数据库列名",
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "SMILES",
            "NAME"
          ]
        },
        "shareable": {
          "type": "boolean",
          "description": "是否打开组织共享"
        },
        "data_num": {
          "type": "integer",
          "format": "int32",
          "description": "分子数量"
        }
      }
    },
    "DetailDatabaseFile": {
      "description": "数据库数据文件详情",
      "type": "object",
      "required": [
        "source",
        "url"
      ],
      "properties": {
        "source": {
          "$ref": "#/definitions/DatabaseFileSource"
        },
        "url": {
          "type": "string",
          "description": "文件URL,用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "project:/test/url.csv",
          "x-example": "https://fake.obs.cn-north-7.ulanqab.huawei.com/create_database.csv",
          "pattern": ".*\\.(csv)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "eihealth_project_id": {
          "description": "数据库文件所在项目id,仅文件为数据中心时填写",
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]*$"
        },
        "status": {
          "type": "string",
          "example": "FAILED",
          "description": "数据库文件写入状态"
        },
        "failed_reason": {
          "type": "string",
          "example": "failed to connect css.",
          "description": "失败原因"
        }
      }
    },
    "DatabaseFileSource": {
      "description": "数据库文件来源",
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
