{
  "name": "ImportUser",
  "summary": "导入用户",
  "tags": "用户管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/users/import": {
      "post": {
        "x-interface-name": "IUserController",
        "tags": [
          "用户管理"
        ],
        "summary": "导入用户",
        "description": "导入用户",
        "operationId": "ImportUser",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "in": "body",
            "name": "ImportUserRequestBody",
            "description": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ImportUserReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": [
                {
                  "id": "18c10a09-65d5-4fe8-8337-4ce5570b8a4b"
                }
              ]
            },
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/UserIdRsp"
              }
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "导入用户,用户id为18c10a09-65d5-4fe8-8337-4ce5570b8a4b,角色为ADMIN,作业配额为10,作业超时时长为1天,CPU的核数配额为50,内存的配额为128GB,用户可创建的项目数为2",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/users/batch-import",
        "x-request-examples-1": {
          "iam_user_id": "18c10a09-65d5-4fe8-8337-4ce5570b8a4b",
          "role": "ADMIN",
          "settings": {
            "job_quota": 10,
            "job_timeout": 1,
            "cpu_quota": 50,
            "mem_quota": 128,
            "projects_per_user": 2
          }
        }
      }
    }
  },
  "definitions": {
    "ImportUserReq": {
      "required": [
        "iam_user_id",
        "role"
      ],
      "properties": {
        "iam_user_id": {
          "type": "string",
          "example": "56e0f1b0-ac10-46a5-8fa7-b26831d7d488",
          "description": "IAM用户id",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]*$",
          "x-pattern-message": "iam_user_id is invalid."
        },
        "role": {
          "type": "string",
          "example": "ADMIN",
          "description": "角色类型:管理员(ADMIN)、操作者(OPERATOR)",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(ADMIN|OPERATOR)$",
          "x-pattern-message": "role only support ADMIN and OPERATOR"
        },
        "settings": {
          "description": "用户设置",
          "$ref": "#/definitions/UserSettingDto"
        }
      }
    },
    "UserIdRsp": {
      "properties": {
        "id": {
          "type": "string",
          "example": "7116d09f88fa41908676fdd4b039...",
          "description": "用户id"
        }
      },
      "title": "UserResponse",
      "description": "操作用户返回体"
    },
    "UserSettingDto": {
      "required": [
        "cpu_quota",
        "job_quota",
        "job_timeout",
        "mem_quota"
      ],
      "properties": {
        "job_quota": {
          "type": "integer",
          "format": "int32",
          "example": 10,
          "description": "允许同时运行的作业数",
          "minimum": 1,
          "maximum": 100
        },
        "job_timeout": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "作业执行超时时长,单位天",
          "minimum": 1,
          "maximum": 60
        },
        "cpu_quota": {
          "type": "integer",
          "format": "int32",
          "example": 50,
          "description": "作业的CPU资源配额,单位核",
          "minimum": 1,
          "maximum": 1024
        },
        "mem_quota": {
          "type": "integer",
          "format": "int32",
          "example": 128,
          "description": "作业的内存资源配额,单位GB",
          "minimum": 1,
          "maximum": 1024
        },
        "projects_per_user": {
          "type": "integer",
          "format": "int32",
          "example": 2,
          "description": "用户可创建项目数配额",
          "minimum": 0,
          "maximum": 20,
          "default": 2
        }
      },
      "title": "UpdateUserSettingsReq",
      "description": "更新用户请求体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}