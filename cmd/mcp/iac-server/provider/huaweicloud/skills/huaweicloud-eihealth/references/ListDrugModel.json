{
  "name": "ListDrugModel",
  "summary": "获取模型列表",
  "tags": "药物模型管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/drug-models": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-interface-name": "IDrugModelController",
        "x-ut-partial": true,
        "tags": [
          "药物模型管理"
        ],
        "summary": "获取模型列表",
        "description": "获取模型列表",
        "operationId": "ListDrugModel",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。 Token认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "search_key",
            "in": "query",
            "description": "模糊搜索值",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 1024
          },
          {
            "name": "creator_list",
            "in": "query",
            "description": "创建者列表",
            "required": false,
            "type": "array",
            "minItems": 0,
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 32,
              "minLength": 5
            }
          },
          {
            "name": "type_list",
            "in": "query",
            "description": "模型类型列表",
            "required": false,
            "type": "array",
            "minItems": 0,
            "maxItems": 10,
            "items": {
              "type": "string",
              "x-enum-type": "ModelType"
            }
          },
          {
            "name": "status_list",
            "in": "query",
            "type": "array",
            "minItems": 0,
            "maxItems": 10,
            "items": {
              "type": "string",
              "x-enum-type": "DrugModelStatus"
            },
            "description": "模型状态列表",
            "required": false
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序规则 目前默认时间降序,支持根据create_time|finish_time|base_model_name",
            "required": false,
            "type": "string",
            "x-enum-type": "ModelSortKey"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序规则 目前默认时间降序",
            "required": false,
            "type": "string",
            "default": "DESC",
            "x-enum-type": "SortDir"
          },
          {
            "name": "create_start_time",
            "in": "query",
            "description": "最小创建时间",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "create_end_time",
            "in": "query",
            "description": "最大创建时间",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "finish_start_time",
            "in": "query",
            "description": "最小结束时间",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "finish_end_time",
            "in": "query",
            "description": "最大结束时间",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制量,单次查询总量,必须由数字组成,默认为100,取值范围[1,1000]",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 100,
            "maximum": 1000,
            "minimum": 1
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,查询起始偏移,必须由数字组成,默认为0,取值范围[0,100000000]",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 100000000,
            "minimum": 0
          },
          {
            "name": "base_model_list",
            "in": "query",
            "description": "基模型id列表",
            "required": false,
            "type": "array",
            "minItems": 0,
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListModelRsp"
            },
            "examples": {
              "application/json": {
                "count": 1,
                "models": [
                  {
                    "id": "56e0f1b0-ac10-46a5-8fa7-b26831d7d488",
                    "name": "demo_name",
                    "description": "description",
                    "status": "FINISHED",
                    "create_time": "2021-01-30T02:34:36Z",
                    "finish_time": "2021-01-30T02:53:26Z",
                    "creator": "demo-user",
                    "shareable": true,
                    "data_quantity": 1000,
                    "type": "binary",
                    "file": {
                      "source": "PRIVATE",
                      "url": "project:/file/data.csv"
                    },
                    "losses": [
                      6.2,
                      1.2,
                      4.54
                    ],
                    "metrics": [
                      {
                        "name": "rmse",
                        "value": 0.3744
                      },
                      {
                        "name": "mae",
                        "value": 0.2844
                      },
                      {
                        "name": "pcc",
                        "value": 0.4871
                      }
                    ],
                    "base_model_id": "pangu-drug-model",
                    "base_model_name": "pangu-drug-model"
                  }
                ]
              }
            }
          }
        },
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/drug-models",
        "deprecated": false
      }
    }
  },
  "definitions": {
    "ListModelRsp": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "description": "模型列表",
          "items": {
            "$ref": "#/definitions/ModelDto"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "模型总数"
        }
      },
      "description": "查询模型列表响应体"
    },
    "ModelDto": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "model_name",
          "description": "模型名称"
        },
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "模型ID"
        },
        "type": {
          "type": "string",
          "example": "binary",
          "description": "模型类型"
        },
        "create_time": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "模型创建时间"
        },
        "finish_time": {
          "type": "string",
          "example": "2021-01-30T02:53:26Z",
          "description": "模型结束时间"
        },
        "creator": {
          "type": "string",
          "example": "demo_user_name",
          "description": "创建模型的用户名称"
        },
        "status": {
          "type": "string",
          "example": "FINISHED",
          "description": "作业状态"
        },
        "shareable": {
          "type": "boolean",
          "example": false,
          "description": "是否打开组织共享"
        },
        "data_quantity": {
          "type": "integer",
          "example": 1000,
          "format": "int32",
          "description": "模型数据量"
        },
        "file": {
          "$ref": "#/definitions/ModelFile",
          "description": "模型数据来源"
        },
        "value_range": {
          "$ref": "#/definitions/ValueRange2"
        },
        "description": {
          "type": "string",
          "example": "description",
          "description": "模型描述信息"
        },
        "failed_message": {
          "type": "string",
          "example": "null",
          "description": "失败提示,当作业执行失败时会返回"
        },
        "losses": {
          "type": "array",
          "description": "模型训练loss信息",
          "items": {
            "type": "number",
            "format": "float"
          }
        },
        "metrics": {
          "description": "模型评估指标",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModelMetric"
          }
        },
        "base_model_id": {
          "description": "基模型id",
          "type": "string",
          "example": "pangu-drug-model",
          "default": "pangu-drug-model"
        },
        "base_model_name": {
          "description": "基模型名称",
          "type": "string",
          "example": "pangu-drug-model",
          "default": "pangu-drug-model"
        }
      }
    },
    "ModelMetric": {
      "description": "模型评估指标",
      "properties": {
        "name": {
          "type": "string",
          "description": "评估指标的名称",
          "minLength": 1,
          "maxLength": 32,
          "example": "rmsd"
        },
        "value": {
          "type": "number",
          "format": "float",
          "description": "评估指标的评估结果",
          "example": 0.73
        }
      },
      "example": {
        "name": "rmsd",
        "value": 0.73
      }
    },
    "ModelFileSource": {
      "description": "模型数据文件来源",
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "ModelFile": {
      "description": "模型数据文件",
      "type": "object",
      "required": [
        "source",
        "url"
      ],
      "properties": {
        "source": {
          "$ref": "#/definitions/ModelFileSource"
        },
        "url": {
          "type": "string",
          "description": "文件URL,用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "project:/test/url.csv",
          "pattern": ".*\\.(csv)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "eihealth_project_id": {
          "description": "模型文件所在项目id,仅文件为数据中心时填写",
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]*$"
        }
      }
    },
    "ValueRange2": {
      "properties": {
        "lower": {
          "type": "number",
          "format": "float",
          "description": "值域下限"
        },
        "upper": {
          "type": "number",
          "format": "float",
          "description": "值域上限"
        }
      },
      "description": "数值值域区间定义",
      "example": {
        "lower": 0,
        "upper": 20
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}