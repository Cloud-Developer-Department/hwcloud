            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从获取项目ID中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "name": "task_id",
            "in": "path",
            "description": "下载任务ID。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "task_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "查询分子或分子复合物批量下载任务详情响应体",
            "schema": {
              "$ref": "#/definitions/MolBatchDownloadTaskRsp"
            },
            "examples": {
              "application/json": {
                "status": "FINISHED",
                "out_dir": "zb_test:/a/b/Docking-202401091947-6sn7_complex_7abc.zip",
                "filename": "Docking-202401091947-6sn7_complex_7abc.zip"
              }
            }
          }
        }
      }
    }
