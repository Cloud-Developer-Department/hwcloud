        },
        "create_time": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "**参数解释**:\n创建对话时间。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        },
        "update_time": {
          "type": "string",
          "example": "2021-01-30T02:53:26Z",
          "description": "**参数解释**:\n更新对话时间。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        },
        "top_time": {
          "type": "string",
          "example": "2021-01-30T02:53:26Z",
          "description": "**参数解释**:\n置顶对话时间。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        }
      }
    },
    "ListChatRsp": {
      "type": "object",
