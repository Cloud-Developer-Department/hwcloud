            "schema": {
              "$ref": "#/definitions/ListPerformanceResourceRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "获取性能加速资源列表",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/system/performance-resources"
      }
    }
