{
  "name": "UploadData",
  "summary": "上传数据文件",
  "tags": "数据管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/datas/upload": {
      "post": {
        "tags": [
          "数据管理"
        ],
        "x-interface-name": "IDataController",
        "summary": "上传数据文件",
        "description": "上传数据文件",
        "operationId": "UploadData",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "name": "file",
            "in": "formData",
            "description": "文件流对象",
            "required": true,
            "type": "file",
            "x-example": "test.txt"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "target_folder",
            "in": "formData",
            "description": "目标文件夹",
            "required": false,
            "type": "string",
            "maxLength": 2000,
            "minLength": 0,
            "x-annotations": [
              "@Pattern(regexp = \"^([^/]+/)+$\", message = \"Please specify folder\", groups = {GroupE.class})",
              "@Pattern(regexp = \"^[^\\\\.\\\\s\\b-].*\", message = \"Please specify folder\", groups = {GroupE.class})",
              "@Pattern(regexp = \".*[^\\\\.\\\\s\\b]$\", message = \"Please specify folder\", groups = {GroupE.class})",
              "@Pattern(regexp = \"^(\\\\x20|[^\\\\s\\b:;\\\\*\\\\?\\\"`,\\\\|<>\\\\\\\\])+$\", message = \"Please specify folder\", groups = {GroupE.class})"
            ]
          },
          {
            "name": "part_number",
            "in": "formData",
            "type": "string",
            "minLength": 1,
            "maxLength": 4,
            "pattern": "^([1-9][0-9]{0,2}|1000)$",
            "required": false,
            "default": 1,
            "description": "分段序号,表示第几个文件片段"
          },
          {
            "name": "total_part",
            "in": "formData",
            "type": "string",
            "minLength": 1,
            "maxLength": 4,
            "pattern": "^([1-9][0-9]{0,2}|1000)$",
            "required": false,
            "default": 1,
            "description": "分段总数,上传的文件总共分成了几个片段"
          },
          {
            "name": "multipart_id",
            "in": "formData",
            "description": "分段上传任务id,除了第一个片段外,后续的片段都需要标识出任务id",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "[A-Za-z0-9_-]*",
            "x-pattern-message": "multipart id is illegal"
          },
          {
            "name": "file_name",
            "in": "formData",
            "description": "文件名称",
            "required": false,
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          },
          {
            "name": "md5",
            "in": "formData",
            "description": "MD5",
            "required": false,
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "multipart_id": "0000017B09C208EA40127EA8AE05F327"
              }
            },
            "schema": {
              "$ref": "#/definitions/UploadDataRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/datas/upload",
        "x-request-examples-1": {
          "file": "upload.txt"
        },
        "x-request-examples-description-1": "上传数据文件,数据名称为upload.txt。"
      }
    }
  },
  "definitions": {
    "UploadDataRsp": {
      "type": "object",
      "properties": {
        "multipart_id": {
          "type": "string",
          "example": "0000017B09C208EA40127EA8AE05F327",
          "description": "分段上传任务id"
        }
      },
      "title": "UploadDataRsp",
      "description": "上传文件返回参数,用于分段上传"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}