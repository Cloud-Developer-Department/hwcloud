                "inputs": [
                  {
                    "name": "dir-parameter",
                    "description": "parameter description",
                    "required": true,
                    "concurrent": "var_iter",
                    "type": "DIRECTORY",
                    "pattern": "*.fastq",
                    "values": [
                      "/test"
                    ]
                  }
                ],
                "outputs": [
                  {
                    "name": "dir-parameter",
                    "description": "parameter description",
                    "required": true,
                    "type": "DIRECTORY",
                    "pattern": "*.fastq",
                    "values": [
                      "/test"
