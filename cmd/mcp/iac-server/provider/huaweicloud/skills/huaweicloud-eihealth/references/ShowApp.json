          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$",
          "x-pattern-message": "The app parameter format does not match."
        },
        "description": {
          "type": "string",
          "example": "parameter description",
