{
  "name": "CreateDrugLigandSimilarityGraphTask",
  "summary": "创建配体相似性图计算任务",
  "tags": "IDrugCommonController",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-common/ligand/similarity-graph": {
      "post": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "CreateDrugLigandSimilarityGraphTask",
        "tags": [
          "IDrugCommonController"
        ],
        "summary": "创建配体相似性图计算任务",
        "description": "创建配体相似性图计算任务",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid"
          },
          {
            "name": "CreateDrugLigandSimilarityGraphTaskRequestBody",
            "in": "body",
            "required": true,
            "description": "创建配体相似性图计算任务请求体",
            "schema": {
              "$ref": "#/definitions/CreateLigandSimilarityGraphTaskReq"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "配体相似度图任务创建成功响应",
            "schema": {
              "$ref": "#/definitions/CreateAsyncTaskRsp"
            },
            "examples": {
              "application/json": {
                "id": "c05ebc2029c24699af2354f67391604c"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CreateLigandSimilarityGraphTaskReq": {
      "type": "object",
      "description": "创建配体相似度图任务请求体",
      "required": [
        "mode",
        "ligands"
      ],
      "properties": {
        "mode": {
          "$ref": "#/definitions/LigandSimilarityGraphMode"
        },
        "ligands": {
          "type": "array",
          "minItems": 2,
          "maxItems": 101,
          "description": "配体列表",
          "items": {
            "$ref": "#/definitions/CreateLigandSimilarityGraphLigandDto"
          }
        }
      },
      "example": {
        "mode": "CENTER",
        "ligands": [
          {
            "name": "MolA",
            "smiles": "c1ccccc1",
            "main": true
          },
          {
            "name": "MolB",
            "smiles": "c1ccccc1",
            "main": false
          }
        ]
      }
    },
    "CreateLigandSimilarityGraphLigandDto": {
      "type": "object",
      "description": "创建配体相似度图任务配体",
      "required": [
        "name",
        "smiles"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "配体分子唯一名字,受体中的建议使用\"{氨基酸}:{链}:{编号}\"",
          "minLength": 1,
          "maxLength": 32,
          "example": "LIG:0"
        },
        "smiles": {
          "type": "string",
          "description": "分子SMILES表达式",
          "minLength": 1,
          "maxLength": 512,
          "example": "CC"
        },
        "main": {
          "type": "boolean",
          "default": false,
          "description": "配体是否为主要配体,在中心模式下,必须指定1个主要配体"
        }
      }
    },
    "CreateAsyncTaskRsp": {
      "type": "object",
      "description": "创建异步任务响应体",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "任务ID"
        }
      }
    },
    "LigandSimilarityGraphMode": {
      "type": "string",
      "enum": [
        "CENTER",
        "FREE"
      ],
      "description": "创建配体相似度图的模式:中心模式、自由模式"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}