{
  "name": "ValidateCssConnection",
  "summary": "测试CSS集群连接",
  "tags": "CSS集群管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/drug/css-clusters/connection": {
      "post": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-interface-name": "IDrugCssClusterController",
        "tags": [
          "CSS集群管理"
        ],
        "summary": "测试CSS集群连接",
        "description": "测试CSS集群连接",
        "operationId": "ValidateCssConnection",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "in": "body",
            "name": "ValidateCssConnectionRequestBody",
            "description": "css连通性校验请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateCssClusterReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ValidationConnectionRsp"
            },
            "examples": {
              "application/json": {
                "connected": true
              }
            }
          }
        },
        "x-response-examples-description-1": "CSS集群连通性测试",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/drug/css-clusters",
        "x-request-examples-description-1": "测试CSS资源连通性,选择id为2f042ad4-6aca-11ed-b7f6-fa163e504fdd的CSS资源,集群管理员为admin,密码为user_pwd",
        "x-request-examples-1": {
          "css_id": "2f042ad4-6aca-11ed-b7f6-fa163e504fdd",
          "user_name": "admin",
          "user_pwd": "user_pwd"
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "CreateCssClusterReq": {
      "description": "绑定CSS集群请求体",
      "required": [
        "css_id",
        "user_name",
        "user_pwd"
      ],
      "properties": {
        "css_id": {
          "type": "string",
          "description": "集群id",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]*$",
          "x-pattern-message": "css_id is invalid",
          "example": "2f042ad4-6aca-11ed-b7f6-fa163e504fdd"
        },
        "user_name": {
          "type": "string",
          "description": "集群用户账号",
          "minLength": 4,
          "maxLength": 32,
          "example": "admin"
        },
        "user_pwd": {
          "type": "string",
          "description": "集群用户密码,长度限制为[8,32]",
          "minLength": 8,
          "maxLength": 32,
          "example": "Strong#Pwd56"
        }
      }
    },
    "ValidationConnectionRsp": {
      "description": "集群连通性校验返回体",
      "properties": {
        "connected": {
          "type": "boolean",
          "description": "是否连通",
          "example": false
        },
        "reason": {
          "type": "string",
          "description": "失败原因",
          "example": "wrong password"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}