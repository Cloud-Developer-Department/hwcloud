{
  "name": "ListProperty",
  "summary": "获取属性值列表",
  "tags": "资产管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/assets/properties": {
      "get": {
        "x-interface-name": "IAssetController",
        "tags": [
          "资产管理"
        ],
        "summary": "获取属性值列表",
        "description": "获取属性值列表",
        "operationId": "ListProperty",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "property",
            "in": "query",
            "description": "属性,支持LABEL/PUBLISHER/CATEGORY",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^(LABEL|PUBLISHER|CATEGORY)$",
            "x-pattern-message": "property only support LABEL, PUBLISHER, CATEGORY"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": [
                "IMAGE",
                "DATASET",
                "APP",
                "WORKFLOW"
              ]
            },
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "x-ut-partial": true,
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "查询资产属性列表",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/assets/properties"
      }
    }
  },
