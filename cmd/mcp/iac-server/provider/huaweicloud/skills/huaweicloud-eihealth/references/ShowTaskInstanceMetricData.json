{
  "name": "ShowTaskInstanceMetricData",
  "summary": "获取子任务中实例的资源监控数据",
  "tags": "作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/jobs/{job_id}/tasks/{task_name}/instances/{instance_name}/metric-data": {
      "get": {
        "x-interface-name": "IJobController",
        "tags": [
          "作业管理"
        ],
        "summary": "获取子任务中实例的资源监控数据",
        "description": "获取子任务中实例的资源监控数据",
        "operationId": "ShowTaskInstanceMetricData",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is illegal"
          },
          {
            "name": "job_id",
            "in": "path",
            "description": "作业id",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "The job id format does not match."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "task_name",
            "in": "path",
            "description": "子任务名称",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "task_index",
            "in": "query",
            "description": "子任务的并发序号",
            "required": false,
            "type": "string",
            "default": "0",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "instance_name",
            "in": "path",
            "description": "子任务实例名称",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "from_time",
            "in": "query",
            "description": "查询监控数据起始时间,UNIX时间戳,单位毫秒,不填时默认为当前时间",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "to_time",
            "in": "query",
            "description": "查询监控数据截止时间,UNIX时间戳,单位毫秒,不填时默认为当前时间",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "method",
            "in": "query",
            "description": "统计方法。枚举值,取值范围:maximum(最大值)、minimum(最小值)、average(平均值),不填时默认为maximum",
            "required": false,
            "type": "string",
            "default": "maximum",
            "x-enum-type": "TaskMonitorMethod"
          },
          {
            "name": "metric_name",
            "in": "query",
            "description": "查询的监控指标名称",
            "required": true,
            "type": "string",
            "x-enum-type": "TaskMonitorMetricName"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/TaskMetricDataRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "DataPointDto": {
      "properties": {
        "timestamp": {
          "type": "integer",
          "format": "int64",
          "example": 1467892800000,
          "description": "时间戳"
        },
        "unit": {
          "type": "string",
          "description": "数据单位"
        },
        "value": {
          "type": "number",
          "example": 33.2,
          "description": "统计结果"
        }
      },
      "title": "DataPointDto",
      "description": "监控数据列表"
    },
    "TaskMetricDataRsp": {
      "properties": {
        "data_points": {
          "type": "array",
          "description": "监控数据列表",
          "items": {
            "$ref": "#/definitions/DataPointDto"
          }
        }
      },
      "title": "TaskMetricDataRsp",
      "description": "资源监控数据返回体"
    }
  },
