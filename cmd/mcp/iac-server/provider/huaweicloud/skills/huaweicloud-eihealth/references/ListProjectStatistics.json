{
  "name": "ListProjectStatistics",
  "summary": "获取当前用户所属空间资源统计信息",
  "tags": "空间统计接口",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/statistics": {
      "get": {
        "x-ut-partial": true,
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-interface-name": "IStatisticInternalController",
        "tags": [
          "空间统计接口"
        ],
        "summary": "获取当前用户所属空间资源统计信息",
        "description": "获取当前用户所属空间资源统计信息。",
        "operationId": "ListProjectStatistics",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。 Token认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](ai4s_03_0011.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](ai4s_03_0023.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          }
        ],
        "x-request-examples-description-1": "查询用户所属空间资源统计信息。",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/statistics",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListProjectStatisticRsp"
            },
            "examples": {
              "application/json": {
                "count": 1,
                "projects": [
                  {
                    "id": "eihealth_project_id",
                    "name": "eihealth_project_name",
                    "role_type": "Owner",
                    "creator": "creator",
                    "create_time": "2025-01-02T10:50:59Z",
                    "update_time": "2025-01-02T10:50:59Z",
                    "top_time": "2025-01-02T10:50:59Z",
                    "user_statistics": [
                      {
                        "resource_name": "app",
                        "count": 1
                      },
                      {
                        "resource_name": "workflow",
                        "count": 2
                      },
                      {
                        "resource_name": "job",
                        "count": 3
                      },
                      {
                        "resource_name": "drug_job",
                        "count": 4
                      }
                    ],
                    "total_statistics": [
                      {
                        "resource_name": "app",
                        "count": 2
                      },
                      {
                        "resource_name": "workflow",
                        "count": 2
                      },
                      {
                        "resource_name": "job",
                        "count": 3
                      },
                      {
                        "resource_name": "drug_job",
                        "count": 4
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "StatisticDto": {
      "type": "object",
      "properties": {
        "resource_name": {
          "type": "string",
          "description": "统计资源名称",
          "example": "app"
        },
        "count": {
          "type": "integer",
          "format": "int64",
          "description": "统计资源值",
          "example": 100
        }
      },
      "description": "资源统计模型"
    },
    "ProjectStatistic": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "fce1376b-72f9-4d15-9f95-9b533cb96fda",
          "description": "空间ID。"
        },
        "name": {
          "type": "string",
          "example": "demo-project",
          "description": "空间名称。"
        },
        "role_type": {
          "type": "string",
          "example": "Administrator",
          "description": "用户所属空间的角色。"
        },
        "creator": {
          "type": "string",
          "example": "demo-user",
          "description": "空间所有者。"
        },
        "create_time": {
          "type": "string",
          "example": "2020-09-10T10:07:17Z",
          "description": "空间创建时间。"
        },
        "update_time": {
          "type": "string",
          "example": "2020-09-10T10:07:17Z",
          "description": "空间更新时间。"
        },
        "top_time": {
          "type": "string",
          "example": "2020-09-10T10:07:17Z",
          "description": "空间置顶时间。"
        },
        "user_statistics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StatisticDto"
          },
          "description": "用户资源统计详情"
        },
        "total_statistics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StatisticDto"
          },
          "description": "总资源统计详情"
        }
      },
      "title": "ListStatisticRsp",
      "description": "空间资源统计信息"
    },
    "ListProjectStatisticRsp": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProjectStatistic"
          },
          "description": "空间统计信息。"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "空间总数。"
        }
      },
      "title": "ListStatisticRsp",
      "description": "空间统计信息列表。"
    }
  },
