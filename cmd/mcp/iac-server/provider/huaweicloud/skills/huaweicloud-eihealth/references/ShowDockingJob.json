{
  "name": "ShowDockingJob",
  "summary": "查询分子对接作业详情",
  "tags": "分子对接作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-jobs/docking/{job_id}": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-ut-partial": true,
        "x-interface-name": "IDockingJobController",
        "tags": [
          "分子对接作业管理"
        ],
        "summary": "查询分子对接作业详情",
        "description": "查询分子对接作业详情",
        "operationId": "ShowDockingJob",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid",
            "x-example": "projectId"
          },
          {
            "name": "job_id",
            "in": "path",
            "description": "作业id",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "job_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/DockJobDetailRsp"
            },
            "examples": {
              "application/json": {
                "basic_info": {
                  "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                  "name": "demo-job",
                  "labels": [
                    "labelA",
                    "labelB"
                  ],
                  "status": "FINISHED",
                  "type": "OPTIMIZATION",
                  "create_time": "2021-01-30T02:34:36Z",
                  "finish_time": "2021-01-30T02:53:26Z",
                  "failed_message": "null",
                  "user_name": "demo-user-name",
                  "output_dir": "job-analysis/job-name",
                  "expect_charge_num": 1,
                  "real_charge_num": 1
                },
                "receptors": [
                  {
                    "receptor": {
                      "source": "PRIVATE",
                      "url": "project:/dir/file"
                    },
                    "bounding_box": {
                      "center": [
                        0,
                        0,
                        0
                      ],
                      "size": [
                        10,
                        10,
                        10
                      ]
                    },
                    "remove_water": true,
                    "remove_ion": false,
                    "remove_ligand": false
                  }
                ],
                "ligands": [
                  {
                    "ligand": {
                      "source": "PRIVATE",
                      "url": "project:/dir/file"
                    },
                    "count": 100
                  }
                ],
                "engine": "AUTODOCK_VINA",
                "job_result": {
                  "total_count": 10,
                  "failed_count": 1
                },
                "cluster_result": {
                  "method": "hiq_mc",
                  "output_dir": "project://bucket/path/to/task/dir/",
                  "status": "finished",
                  "failed_reasons": [
                    {
                      "reason": "failed reason"
                    },
                    {
                      "count": 1
                    }
                  ]
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "DockingReceptorDto": {
      "required": [
        "receptor",
        "bounding_box"
      ],
      "type": "object",
      "description": "结合位点",
      "properties": {
        "receptor": {
          "$ref": "#/definitions/ReceptorDrugFile",
          "description": "受体文件"
        },
        "bounding_box": {
          "$ref": "#/definitions/BoundingBoxDto"
        },
        "remove_ion": {
          "type": "boolean",
          "description": "去除受体中的离子",
          "default": true
        },
        "remove_water": {
          "type": "boolean",
          "description": "去除受体中的水分子",
          "default": true
        },
        "remove_ligand": {
          "type": "boolean",
          "description": "去除受体中的配体分子",
          "default": true
        },
        "add_hydrogen": {
          "type": "boolean",
          "default": false,
          "description": "增加氢原子"
        },
        "docking_type": {
          "type": "string",
          "description": "**参数解释**:\n对接类型。\n**约束限制**:\n不支持\n**取值范围**:\n- BLIND_DOCKING:全局对接\n- POCKET_DOCKING:口袋对接\n**默认取值**:\nPOCKET_DOCKING",
          "minLength": 0,
          "maxLength": 15,
          "pattern": "^(BLIND_DOCKING|POCKET_DOCKING)$",
          "x-pattern-message": "Docking_type only supports BLIND_DOCKING and POCKET_DOCKING.",
          "default": "POCKET_DOCKING",
          "example": "POCKET_DOCKING"
        },
        "reference_file": {
          "$ref": "#/definitions/ReferenceLigandFile",
          "description": "**参数解释**:\n模板配体文件,仅引擎为SIMILAR_DOCKING时提供。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        }
      }
    },
    "Progress": {
      "properties": {
        "overall": {
          "type": "number",
          "format": "float",
          "example": 0.21,
          "description": "整体进度"
        },
        "estimated_finish_time": {
          "type": "integer",
          "format": "int64",
          "example": 1000,
          "description": "预计结束时间,毫秒"
        }
      }
    },
    "ReceptorDrugFile": {
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/DrugFileSource",
          "example": "RAW"
        },
        "url": {
          "type": "string",
          "description": "文件URL,当数据源为外部网络数据时为https地址;用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "pattern": ".*\\.(pdb)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB)$",
          "description": "文件格式,仅支持PDB,仅数据源为RAW时提供"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "文件原始数据,仅数据源为RAW时提供",
          "x-ut-exclude-equivalence": [
            "NULL"
          ]
        }
      }
    },
    "FailedReasonRecord": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "example": "invalid smiles",
          "description": "失败原因"
        },
        "count": {
          "type": "integer",
          "example": 20,
          "description": "失败数量"
        }
      }
    },
    "JobResult": {
      "type": "object",
      "properties": {
        "total_count": {
          "type": "integer",
          "format": "int32",
          "example": 10,
          "description": "输入总数"
        },
        "failed_count": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "失败个数"
        },
        "sub_tasks_duration": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "description": "子任务运行时长(秒)。",
          "items": {
            "type": "number",
            "format": "float",
            "description": "运行时长(秒)。"
          }
        },
        "num_molecules": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n分子聚类任务中的分子总数。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        },
        "success_count": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n聚类成功的分子数。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        }
      },
      "description": "作业运行结果信息"
    },
    "DockJobDetailRsp": {
      "type": "object",
      "description": "获取分子对接作业详情响应体",
      "properties": {
        "basic_info": {
          "$ref": "#/definitions/DrugJobDto",
          "description": "作业基本信息"
        },
        "receptors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DockingReceptorDto"
          },
          "minItems": 1,
          "maxItems": 20,
          "description": "受体文件列表"
        },
        "ligands": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LigandDto"
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "配体文件列表,当前仅支持1个"
        },
        "engine": {
          "type": "string",
          "description": "引擎"
        },
        "job_result": {
          "$ref": "#/definitions/JobResult",
          "description": "作业结果信息"
        },
        "part_failed_reason": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FailedReasonRecord"
          },
          "description": "部分失败原因和数量"
        },
        "cluster_result": {
          "$ref": "#/definitions/ClusterJobRsp",
          "description": "聚类结果信息"
        }
      }
    },
    "ReferenceLigandFile": {
      "description": "模板配体文件,仅引擎为SIMILAR_DOCKING时提供。",
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/DrugFileSource",
          "example": "DrugFileSource.RAW"
        },
        "url": {
          "type": "string",
          "description": "**参数解释**:\n文件URL。\n**约束限制**:\n当数据源source为外部网络数据时为https地址,为用户私有数据中心时为空间路径,为公共数据场景时为obs地址。\n**取值范围**:\n文件URL仅支持以.pdb、.sdf、.mol2、.smi、.csv结尾,长度为[1-2000]个字符。\n**默认取值**:\n不涉及",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "pattern": ".*\\.(pdb|sdf|mol2|smi|csv)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB|SDF|MOL2|SMI|CSV)$",
          "description": "**参数解释**:\n文件格式。\n**约束限制**:\n仅数据源source为RAW时提供。\n**取值范围**:\n- PDB\n- SDF\n- MOL2\n- SMI\n- CSV\n**默认取值**:\n不涉及"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "**参数解释**:\n文件原始数据。\n**约束限制**:\n仅数据源source为RAW时提供。\n**取值范围**:\n长度为[0-10000000]个字符。\n**默认取值**:\n不涉及"
        }
      }
    },
    "DrugFileSource": {
      "type": "string",
      "enum": [
        "EXTRANET",
        "PRIVATE",
        "PUBLIC",
        "RAW"
      ],
      "description": "受体的数据源:外部网络数据(如RCSB在线数据库)、用户私有数据中心、承载租户公共数据(含样例/公共库)"
    },
    "BoundingBoxDto": {
      "required": [
        "center",
        "size"
      ],
      "type": "object",
      "description": "结合口袋,包含口袋中心位置和尺寸大小",
      "properties": {
        "center": {
          "type": "array",
          "description": "口袋中心坐标; x, y, z轴的坐标",
          "minItems": 3,
          "maxItems": 3,
          "example": [
            1.3,
            23.4,
            -14.5
          ],
          "items": {
            "type": "number",
            "format": "float",
            "minimum": -9999999,
            "maximum": 99999999
          }
        },
        "size": {
          "type": "array",
          "description": "口袋尺寸大小;  x, y, z轴的大小",
          "minItems": 3,
          "maxItems": 3,
          "example": [
            10.0,
            10.0,
            10.0
          ],
          "items": {
            "type": "number",
            "format": "float",
            "minimum": 2,
            "maximum": 500
          }
        },
        "padding": {
          "type": "number",
          "format": "float",
          "minimum": 0,
          "maximum": 20,
          "description": "填充"
        }
      }
    },
    "DrugFile": {
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/DrugFileSource",
          "example": "RAW"
        },
        "url": {
          "type": "string",
          "description": "文件URL,当数据源为外部网络数据时为https地址;用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "x-ut-exclude-equivalence": [
            "NULL"
          ],
          "pattern": ".*\\.(pdb|mol2|sdf|smi)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB|SDF|MOL2|SMI)$",
          "description": "文件格式,支持PDB、SDF、MOL2、SMI,仅数据源为RAW时提供"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "文件原始数据,仅数据源为RAW时提供"
        }
      }
    },
    "DrugJobDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "作业id"
        },
        "name": {
          "type": "string",
          "example": "demo-job",
          "description": "作业的名称,取值范围:[1,63],允许大小写字母、数字、以及特殊字符中划线(-)"
        },
        "eihealth_project_id": {
          "type": "string",
          "example": "demo_id",
          "description": "**参数解释**:\n作业所属空间ID。\n**约束限制**:\n不涉及\n**取值范围**:\n长度为[1-63]个字符,允许大小写字母、数字、以及特殊字符中划线(-)。\n**默认取值**:\n不涉及"
        },
        "eihealth_project_name": {
          "type": "string",
          "example": "demo_name",
          "description": "**参数解释**:\n作业所属空间名称。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        },
        "upstream_job_info": {
          "type": "string",
          "example": "{\"job_id\":\"demo-job-id\",\"job_name\":\"demo-job-name\"}",
          "description": "**参数解释**:\n上游作业信息。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        },
        "labels": {
          "type": "array",
          "example": [
            "labelA",
            "labelB"
          ],
          "description": "作业标签",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "example": "FINISHED",
          "description": "作业状态"
        },
        "type": {
          "type": "string",
          "example": "OPTIMIZATION",
          "description": "作业类型"
        },
        "create_time": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "作业创建时间"
        },
        "finish_time": {
          "type": "string",
          "example": "2021-01-30T02:53:26Z",
          "description": "作业结束时间"
        },
        "start_time": {
          "type": "string",
          "example": "2021-01-30T02:50:26Z",
          "description": "作业开始时间"
        },
        "failed_message": {
          "type": "string",
          "example": "null",
          "description": "失败提示,当作业执行失败时会返回"
        },
        "user_name": {
          "type": "string",
          "example": "demo-user-name",
          "description": "创建任务的用户名称"
        },
        "output_dir": {
          "type": "string",
          "example": "projectName:/job-result/dir",
          "description": "作业结果输出目录"
        },
        "expect_charge_num": {
          "type": "number",
          "format": "double",
          "example": 1,
          "description": "预估功能调用消耗次数"
        },
        "real_charge_num": {
          "type": "number",
          "format": "double",
          "example": 1,
          "description": "实际功能调用消耗次数"
        },
        "progress": {
          "$ref": "#/definitions/Progress",
          "description": "作业进度信息"
        }
      }
    },
    "ClusterJobRsp": {
      "type": "object",
      "description": "分子聚类结果",
      "required": [
        "method",
        "output_dir",
        "status",
        "failed_reasons"
      ],
      "properties": {
        "method": {
          "type": "string",
          "description": "分子聚类方法",
          "example": "hiq_mc"
        },
        "output_dir": {
          "type": "string",
          "description": "分子聚类输出结果",
          "example": "project://bucket/path/to/task/dir/"
        },
        "status": {
          "type": "string",
          "description": "作业结果信息",
          "example": "finished"
        },
        "failed_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FailedReasonRecord"
          },
          "description": "部分失败原因和数量"
        }
      }
    },
    "LigandDto": {
      "type": "object",
      "required": [
        "ligand",
        "count"
      ],
      "description": "配体配置",
      "properties": {
        "ligand": {
          "$ref": "#/definitions/DrugFile",
          "description": "配体文件"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "计算个数",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}