              "$ref": "#/definitions/GetVendorRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "获取供应商配置",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/system/vendor-config"
      }
    }
