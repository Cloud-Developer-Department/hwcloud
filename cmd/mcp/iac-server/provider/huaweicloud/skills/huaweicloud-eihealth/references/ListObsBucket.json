{
  "name": "ListObsBucket",
  "summary": "获取用户OBS桶列表",
  "tags": "OBS桶管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/customer-buckets": {
      "get": {
        "tags": [
          "OBS桶管理"
        ],
        "x-interface-name": "IObsController",
        "summary": "获取用户OBS桶列表",
        "description": "获取用户OBS桶列表",
        "operationId": "ListObsBucket",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "type",
            "in": "query",
            "description": "桶类型。OBJECT:桶列表;PFS:并行文件系统。不传返回所有",
            "required": false,
            "type": "string",
            "x-enum-type": "BucketType"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "count": 1,
                "buckets": [
                  {
                    "name": "bucket",
                    "region": "cn-north-7",
                    "type": "PFS"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListObsBucketRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "获取用户OBS桶列表",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/customer-buckets"
      }
    }
  },
  "definitions": {
    "ListObsBucketRsp": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "桶个数"
        },
        "buckets": {
          "type": "array",
          "description": "桶列表",
          "items": {
            "$ref": "#/definitions/BucketDto"
          }
        }
      },
      "description": "获取obs桶列表"
    },
    "BucketDto": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "bucket",
          "description": "桶名称"
        },
        "region": {
          "type": "string",
          "example": "cn-north-7",
          "description": "区域"
        },
        "type": {
          "description": "桶类型",
          "$ref": "#/definitions/BucketType"
        }
      },
      "title": "BucketDto",
      "description": "OBS桶"
    },
    "BucketType": {
      "type": "string",
      "enum": [
        "OBJECT",
        "PFS"
      ],
      "x-json-name": "type"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
