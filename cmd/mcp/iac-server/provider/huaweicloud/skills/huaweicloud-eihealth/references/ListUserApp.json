{
  "name": "ListUserApp",
  "summary": "获取用户所属空间的应用列表",
  "tags": "应用管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/apps": {
      "get": {
        "x-interface-name": "IAppController",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-ut-partial": true,
        "tags": [
          "应用管理"
        ],
        "summary": "获取用户所属空间的应用列表",
        "description": "获取用户所属空间的应用列表。",
        "operationId": "ListUserApp",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。 Token认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](ai4s_03_0023.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](ai4s_03_0023.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$"
          },
          {
            "name": "is_creator",
            "in": "query",
            "required": false,
            "type": "boolean",
            "default": true,
            "description": "是否仅展示本人创建资源。"
          },
          {
            "name": "id",
            "in": "query",
            "description": "应用ID,支持精确搜索。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "id is invalid"
          },
          {
            "name": "name",
            "in": "query",
            "description": "应用名称,支持模糊搜索。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 56,
            "x-annotations": [
              "@Pattern(regexp = \"^[a-zA-Z]+([-_]*[a-zA-Z0-9]+)*$\", message = \"The app parameter format does not match.\", groups = {GroupE.class})"
            ]
          },
          {
            "name": "summary",
            "in": "query",
            "description": "短描述,支持模糊搜索。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          {
            "name": "eihealth_project_names",
            "in": "query",
            "required": false,
            "description": "空间名称列表,支持查询多个空间下的镜像。",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 0,
            "maxItems": 100
          },
          {
            "name": "labels",
            "in": "query",
            "required": false,
            "description": "标签列表。",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[\\一-\\龥A-Za-z0-9-_]+(\\s+[\\一-\\龥A-Za-z0-9-_]+)*$",
              "maxLength": 32,
              "minLength": 1,
              "x-pattern-message": "labels is illegal"
            },
            "minItems": 0,
            "maxItems": 5
          },
          {
            "name": "start_create_time",
            "in": "query",
            "description": "最小创建时间。",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "end_create_time",
            "in": "query",
            "description": "最大创建时间。",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "start_update_time",
            "in": "query",
            "description": "最小更新时间。",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "end_update_time",
            "in": "query",
            "description": "最大更新时间。",
            "required": false,
            "type": "integer",
            "format": "int64",
            "maximum": 9999999999999,
            "minimum": 1000000000000
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "排序规则,目前默认时间降序,支持根据create_time|update_time排序。",
            "required": false,
            "type": "string",
            "x-enum-type": "AppSortKey"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序规则,目前默认时间降序。",
            "required": false,
            "type": "string",
            "default": "DESC",
            "x-enum-type": "SortDir"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制量,单次查询总量,必须由数字组成,默认为100,取值范围[1,1000]。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 100,
            "maximum": 1000,
            "minimum": 1
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,查询起始偏移,必须由数字组成,默认为0,取值范围[0,100000000]。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 100000000,
            "minimum": 0
          }
        ],
        "x-request-examples-description-1": "查询用户所属空间的应用列表。",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/apps",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListAppRsp"
            },
            "examples": {
              "application/json": {
                "apps": [
                  {
                    "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                    "name": "demo-app",
                    "eihealth_project_id": "project-id",
                    "eihealth_project_name": "project-name",
                    "version": "1.0.0",
                    "summary": "summary",
                    "description": "description",
                    "labels": [
                      "labelA",
                      "labelB"
                    ],
                    "create_time": "2021-01-30T02:34:36Z",
                    "update_time": "2021-01-30T02:53:26Z",
                    "user_name": "gwj-test-01"
                  }
                ],
                "count": 1
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "AppDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "应用ID。"
        },
        "name": {
          "type": "string",
          "example": "demo-app",
          "description": "应用名称。"
        },
        "eihealth_project_id": {
          "type": "string",
          "example": "demo-id",
          "description": "应用所属空间ID。"
        },
        "eihealth_project_name": {
          "type": "string",
          "example": "demo-name",
          "description": "应用所属空间名称。"
        },
        "version": {
          "type": "string",
          "example": "1.0.0",
          "description": "应用版本。"
        },
        "summary": {
          "type": "string",
          "example": "summary",
          "description": "应用简述。"
        },
        "description": {
          "type": "string",
          "example": "description",
          "description": "应用描述。"
        },
        "labels": {
          "type": "array",
          "example": [
            "labelA",
            "labelB"
          ],
          "description": "应用标签。",
          "items": {
            "type": "string"
          }
        },
        "create_time": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "创建应用时间。"
        },
        "update_time": {
          "type": "string",
          "example": "2021-01-30T02:53:26Z",
          "description": "更新应用时间。"
        },
        "user_name": {
          "type": "string",
          "example": "gwj-test-01",
          "description": "创建应用的用户名。"
        },
        "source_project_name": {
          "type": "string",
          "example": "null",
          "description": "源项目名称。"
        },
        "source_resource_id": {
          "type": "string",
          "example": "null",
          "description": "源资源ID。"
        },
        "icon": {
          "type": "string",
          "example": "data:image/png;base64,",
          "description": "图标base64编码。"
        }
      },
      "title": "AppListDto",
      "description": "应用列表返回的单个应用对象。"
    },
    "ListAppRsp": {
      "type": "object",
      "properties": {
        "apps": {
          "type": "array",
          "description": "应用列表。",
          "items": {
            "$ref": "#/definitions/AppDto"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "应用总条数。"
        }
      },
      "description": "获取应用列表响应体。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}