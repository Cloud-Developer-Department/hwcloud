{
  "name": "ListVendor",
  "summary": "获取供应商列表",
  "tags": "供应商管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/vendors": {
      "get": {
        "x-interface-name": "IVenderController",
        "tags": [
          "供应商管理"
        ],
        "summary": "获取供应商列表",
        "description": "获取供应商列表",
        "operationId": "ListVendor",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "vendors": [
                  {
                    "id": "09e517572000d42f0ffbc00161366480",
                    "domain_id": "09e517572000d42f0ffbc00161363380",
                    "name": "test",
                    "logo": "data:image/png;base64,iVBOxxxxx"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListVendorRsp"
            }
          }
        },
        "x-ut-partial": true,
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "VendorDto": {
      "required": [
        "domain_id",
        "id",
        "logo",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "供应商id",
          "minLength": 0,
          "maxLength": 128
        },
        "domain_id": {
          "type": "string",
          "example": "09e517572000d42f0ffbce9a",
          "description": "账号id",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_-]*$",
          "x-pattern-message": "illegal domain id"
        },
        "name": {
          "type": "string",
          "example": "vendor",
          "description": "名称",
          "minLength": 1,
          "maxLength": 100
        },
        "logo": {
          "type": "string",
          "example": "data:image/png;base64,iVBORw0ce9a",
          "description": "logo图片base64编码",
          "minLength": 0,
          "maxLength": 1500000
        }
      },
      "title": "VendorDto",
      "description": "vendor配置请求体"
    },
    "ListVendorRsp": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "供应商个数"
        },
        "vendors": {
          "type": "array",
          "description": "供应商列表",
          "items": {
            "$ref": "#/definitions/VendorDto"
          }
        }
      },
      "description": "供应商列表"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}