  "paths": {
    "/v1/{project_id}/admet": {
      "post": {
        "tags": [
          "ADMET"
        ],
        "summary": "ADMET属性预测接口",
        "description": "计算小分子的物化性质,包括吸收(adsorption)、分布(distribution)、代谢(metabolism)、清除(excretion)与毒性(toxicity)。",
        "operationId": "ShowAdmetProperties",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "华为云项目id",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "ShowAdmetPropertiesRequestBody",
            "description": "ADMET任务的请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AdmetRequest"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户 token",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "ADMET成功响应",
            "schema": {
              "$ref": "#/definitions/AdmetPropertyDict"
            }
          },
          "400": {
            "description": "分子SMILES输入不合法"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y"
      }
    }
  },
