{
  "name": "ShowNotebook",
  "summary": "获取notebook详情",
  "tags": "notebook开发环境",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/notebooks/{notebook_id}": {
      "get": {
        "tags": [
          "notebook开发环境"
        ],
        "x-interface-name": "INotebookController",
        "summary": "获取notebook详情",
        "description": "获取notebook详情",
        "operationId": "ShowNotebook",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,获取Token接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid",
            "x-example": "fce1376b-72f9-4d15-9f95-9b533cb988ab"
          },
          {
            "name": "notebook_id",
            "in": "path",
            "description": "notebook id",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "notebook_id is invalid"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "id": "DE-7d558ef8-c73d-11ea-964c-0255ac100033",
                "name": "notebook-example",
                "description": "notebook description in here",
                "creator": "notebook_creator",
                "url": "https://0.0.0.0:0000/0951eb641.../notebook/e4a3b97a.../services/notebook",
                "flavor": {
                  "cpu": "1",
                  "gpu": "0",
                  "memory": "100"
                },
                "status": "Running",
                "image": {
                  "image_type": "SYSTEM",
                  "image_info": {
                    "source_project_name": "eihealth-project",
                    "image_name": "eihealth-notebook",
                    "image_tag": "3.1.0-latest",
                    "profile": "PY3"
                  }
                },
                "storages": [
                  {
                    "path": "project_name:/example",
                    "mount_path": "/example"
                  }
                ],
                "create_time": "2020-09-10T10:07:17Z",
                "update_time": "2020-09-10T10:07:17Z",
                "failed_message": "failed massage in here"
              }
            },
            "schema": {
              "$ref": "#/definitions/NotebookEntity"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "获取notebook详情",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/notebooks/{notebook_id}"
      }
    }
  },
  "definitions": {
    "Profile": {
      "type": "string",
      "enum": [
        "PY3"
      ],
      "x-json-name": "profile"
    },
    "ImageInfo": {
      "type": "object",
      "properties": {
        "source_project_name": {
          "type": "string",
          "example": "atelier",
          "description": "源项目名",
          "minLength": 1,
          "maxLength": 128
        },
        "image_name": {
          "type": "string",
          "example": "mul-kernel-cpu-cp27",
          "description": "镜像名",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]([a-z0-9-_/.]*[a-z0-9])?$",
          "x-pattern-message": "image name should start and end with lowercase letter or number, only support lowercase letters, numbers, `-`, `_`, `.` and `/`"
        },
        "image_tag": {
          "type": "string",
          "example": "3.1.0-latest",
          "description": "镜像tag名",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9-_./]*$",
          "x-pattern-message": "image tag length should between 1-64, only support letters, numbers and `-`, `_`, `.`, `/`"
        },
        "profile": {
          "description": "系统镜像名",
          "$ref": "#/definitions/Profile"
        }
      },
      "title": "ImageInfo",
      "description": "镜像信息"
    },
    "NotebookStorage": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "example": "project_name:/example",
          "description": "notebook存储路径",
          "minLength": 1,
          "maxLength": 4096
        },
        "mount_path": {
          "type": "string",
          "example": "/example",
          "description": "挂载路径,由于目前暂不支持自定义挂载,暂不开放",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "title": "NotebookStorage",
      "description": "notebook存储信息"
    },
    "NotebookEntity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "DE-7d558ef8-c73d-11ea-964c-0255ac100033",
          "description": "notebook ID"
        },
        "name": {
          "type": "string",
          "example": "notebook-example",
          "description": "notebook名称"
        },
        "eihealth_project_id": {
          "type": "string",
          "example": "demo_id",
          "description": "**参数解释**:\n空间ID。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        },
        "eihealth_project_name": {
          "type": "string",
          "example": "demo_name",
          "description": "**参数解释**:\n空间名称。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        },
        "description": {
          "type": "string",
          "example": "notebook description in here",
          "description": "notebook描述"
        },
        "creator": {
          "type": "string",
          "example": "notebook_creator",
          "description": "notebook所属用户"
        },
        "url": {
          "type": "string",
          "example": "https://0.0.0.0:0000/0951eb641.../notebook/e4a3b97a.../services/notebook",
          "description": "notebook访问URL"
        },
        "flavor": {
          "description": "notebook规格",
          "$ref": "#/definitions/FlavorInfo"
        },
        "status": {
          "description": "notebook状态",
          "$ref": "#/definitions/NotebookStatus"
        },
        "image": {
          "description": "notebook镜像信息",
          "$ref": "#/definitions/NotebookImage"
        },
        "storages": {
          "type": "array",
          "description": "notebook存储信息",
          "items": {
            "$ref": "#/definitions/NotebookStorage"
          }
        },
        "create_time": {
          "type": "string",
          "example": "2020-09-10T10:07:17Z",
          "description": "notebook创建时间"
        },
        "update_time": {
          "type": "string",
          "example": "2020-09-10T10:07:17Z",
          "description": "notebook更新时间"
        },
        "failed_message": {
          "type": "string",
          "example": "failed massage in here",
          "description": "notebook失败信息"
        },
        "events": {
          "type": "array",
          "description": "cce事件",
          "items": {
            "$ref": "#/definitions/TaskEventRsp"
          }
        }
      },
      "title": "NotebookEntity",
      "description": "notebook详情"
    },
    "NotebookStatus": {
      "type": "string",
      "enum": [
        "Running",
        "Abnormal",
        "Hibernate",
        "Succeeded",
        "Creating",
        "Deleting",
        "Updating",
        "CreatedFailed",
        "DeletedFailed",
        "UpdatedFailed",
        "Unknown"
      ],
      "x-json-name": "status"
    },
    "DevelopImageType": {
      "type": "string",
      "enum": [
        "SYSTEM",
        "CUSTOMER"
      ],
      "x-json-name": "image_type"
    },
    "FlavorInfo": {
      "type": "object",
      "required": [
        "cpu",
        "gpu",
        "memory"
      ],
      "properties": {
        "cpu_type": {
          "type": "string",
          "example": "X86",
          "default": "X86",
          "maxLength": 24,
          "minLength": 0,
          "pattern": "^$|^(X86|ARM)$",
          "x-pattern-message": "The cpu_type format does not match.",
          "description": "**参数解释**:\ncpu架构类型。\n**约束限制**:\n不涉及\n**取值范围**:\n* X86: X86架构\n* ARM:ARM架构\n**默认取值**:\nX86"
        },
        "cpu": {
          "type": "number",
          "format": "float",
          "example": 1.0,
          "description": "notebook占用的cpu,0.1核为100m,单位为\"C\"",
          "minimum": 1,
          "maximum": 128,
          "default": 1.0,
          "x-ut-exclude-equivalence": [
            "NOT_NULL"
          ]
        },
        "gpu": {
          "type": "number",
          "format": "float",
          "example": 0.0,
          "description": "notebook占用的gpu,0.1为使用单卡10%,1为占满单个显卡,1+为使用多个显卡",
          "minimum": 0,
          "maximum": 16,
          "default": 0.0,
          "x-ut-exclude-equivalence": [
            "NOT_NULL"
          ]
        },
        "gpu_type": {
          "type": "string",
          "example": "GPU",
          "maxLength": 24,
          "minLength": 0,
          "pattern": "^$|^(GPU|Snt9)$",
          "x-pattern-message": "The gpu_type format does not match.",
          "description": "**参数解释**:\ngpu架构类型。\n**约束限制**:\n不涉及\n**取值范围**:\n* GPU:支持GPU\n* Snt9:支持Snt9\n**默认取值**:\n不涉及"
        },
        "memory": {
          "type": "number",
          "format": "float",
          "example": 100.0,
          "description": "notebook占用的内存,单位为\"G\"",
          "minimum": 2,
          "maximum": 512,
          "default": 2.0,
          "x-ut-exclude-equivalence": [
            "NOT_NULL"
          ]
        }
      },
      "title": "FlavorInfo",
      "description": "notebook规格信息"
    },
    "NotebookImage": {
      "type": "object",
      "required": [
        "image_info",
        "image_type"
      ],
      "properties": {
        "image_type": {
          "description": "镜像类型",
          "$ref": "#/definitions/DevelopImageType"
        },
        "image_info": {
          "description": "镜像信息",
          "$ref": "#/definitions/ImageInfo"
        }
      },
      "title": "NotebookImage",
      "description": "notebook镜像",
      "x-required-message": "image cannot be null"
    },
    "TaskEventRsp": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "example": "Normal",
          "description": "任务启动事件类型"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "任务启动事件发生次数"
        },
        "reason": {
          "type": "string",
          "example": "Started",
          "description": "任务启动事件状态"
        },
        "message": {
          "type": "string",
          "example": "Started container task-2-zqy-test-0218-0-19df0004a000206",
          "description": "任务启动事件详细信息"
        },
        "first_timestamp": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "任务启动事件首次上报时间"
        },
        "last_timestamp": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "任务启动事件末次上报时间"
        }
      },
      "description": "任务启动事件响应内容"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}