{
  "name": "ImportWorkflow",
  "summary": "导入流程",
  "tags": "流程管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/workflows/import": {
      "post": {
        "x-interface-name": "IWorkflowController",
        "tags": [
          "流程管理"
        ],
        "summary": "导入流程",
        "description": "导入流程",
        "operationId": "ImportWorkflow",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is illegal"
          },
          {
            "in": "body",
            "name": "ImportWorkflowRequestBody",
            "description": "importWorkflowDto",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ImportWorkflowReq"
            }
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                "import_workflow_status": "IMPORT_SUCCESS",
                "import_app_results": [
                  {
                    "source_app_id": "328e5b04-f5f4-6528-3af1-a10790835f73",
                    "destination_app_id": "7513f7c2-eed5-4ebb-bd7d-cee85a87a338",
                    "destination_app_name": "dest_app_name",
                    "version": "1.0.0",
                    "message": "string",
                    "status": "IMPORT_SUCCESS"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ImportWorkflowRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "导入流程,流程的名称为demo-workflow,版本为1.0.0。",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/workflows/import",
        "x-request-examples-1": {
          "source_project_id": "3ce0f1b0-ac10-46a5-8fa7-b16831d7d480",
          "source_workflow_id": "2b4b1836-5967-11eb-8a0d-fa163e3ddba1",
          "destination_workflow_name": "dest_workflow_name",
          "destination_workflow_version": "1.0.0"
        }
      }
    }
  },
  "definitions": {
    "ImportWorkflowReq": {
      "required": [
        "destination_workflow_name",
        "destination_workflow_version",
        "source_project_id",
        "source_workflow_id"
      ],
      "properties": {
        "source_project_id": {
          "type": "string",
          "example": "3ce0f1b0-ac10-46a5-8fa7-b16831d7d480",
          "description": "源项目id",
          "minLength": 1,
          "maxLength": 128,
          "x-importvalid": true
        },
        "source_workflow_id": {
          "type": "string",
          "example": "2b4b1836-5967-11eb-8a0d-fa163e3ddba1",
          "description": "源流程id",
          "minLength": 1,
          "maxLength": 128
        },
        "destination_workflow_name": {
          "type": "string",
          "example": "dest_workflow_name",
          "description": "目标流程名称 取值范围[1,56],允许大小写字母、数字、以及特殊字符中划线(-)和下划线(_)。",
          "minLength": 1,
          "maxLength": 56,
          "pattern": "^[a-z0-9A-Z-_]+$",
          "x-pattern-message": "The workflow parameter format does not match."
        },
        "destination_workflow_version": {
          "type": "string",
          "example": "1.0.0",
          "description": "目标流程版本 取值范围[1,24],以小写字母或数字或大写字母开头,允许出现中划线,必须以小写字母或数字或大写字母结尾。",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9]+([-.][a-zA-Z0-9]+)*$",
          "x-pattern-message": "The workflow parameter format does not match."
        }
      },
      "title": "ImportWorkflowDto"
    },
    "ImportAppRsp": {
      "properties": {
        "source_app_id": {
          "type": "string",
          "example": "328e5b04-f5f4-6528-3af1-a10790835f73",
          "description": "源应用id"
        },
        "destination_app_id": {
          "type": "string",
          "example": "7513f7c2-eed5-4ebb-bd7d-cee85a87a338",
          "description": "目标应用id"
        },
        "destination_app_name": {
          "type": "string",
          "example": "dest_app_name",
          "description": "目标应用名称"
        },
        "version": {
          "type": "string",
          "example": "1.0.0",
          "description": "应用版本"
        },
        "message": {
          "type": "string",
          "description": "导入结果信息,仅在导入失败时会返回"
        },
        "status": {
          "type": "string",
          "example": "IMPORT_SUCCESS",
          "description": "导入结果状态"
        }
      },
      "title": "ImportAppsResponse",
      "description": "导入应用响应体"
    },
    "ImportWorkflowRsp": {
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "流程ID"
        },
        "import_workflow_status": {
          "type": "string",
          "example": "IMPORT_SUCCESS",
          "description": "导入流程结果状态, 包括以下状态:IMPORT_SUCCESS,IMPORT_FAIL"
        },
        "import_app_results": {
          "type": "array",
          "description": "导入应用详情",
          "items": {
            "$ref": "#/definitions/ImportAppRsp"
          }
        }
      },
      "title": "ImportWorkflowResponse"
    }
  },
  "version": "2.0",
