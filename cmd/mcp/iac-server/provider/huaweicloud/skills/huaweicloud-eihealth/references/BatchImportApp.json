{
  "name": "BatchImportApp",
  "summary": "导入应用",
  "tags": "应用管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/apps/batch-import": {
      "post": {
        "x-interface-name": "IAppController",
        "tags": [
          "应用管理"
        ],
        "summary": "导入应用",
        "description": "批量导入应用",
        "operationId": "BatchImportApp",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is illegal"
          },
          {
            "in": "body",
            "name": "BatchImportAppRequestBody",
            "description": "importAppSrcDto",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BatchImportAppReq"
            }
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$"
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": [
                {
                  "source_app_id": "328e5b04-f5f4-6528-3af1-a10790835f73",
                  "destination_app_id": "7513f7c2-eed5-4ebb-bd7d-cee85a87a338",
                  "destination_app_name": "dest_app_name",
                  "version": "1.0.0",
                  "message": "string",
                  "status": "IMPORT_SUCCESS"
                }
              ]
            },
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ImportAppRsp"
              }
            }
          },
          "207": {
            "description": "MULTI_STATUS",
            "examples": {
              "application/json": [
                {
                  "source_app_id": "328e5b04-f5f4-6528-3af1-a10790835f73",
                  "destination_app_id": "7513f7c2-eed5-4ebb-bd7d-cee85a87a338",
                  "destination_app_name": "dest_app_name",
                  "version": "1.0.0",
                  "message": "string",
                  "status": "IMPORT_SUCCESS"
                }
              ]
            },
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ImportAppRsp"
              }
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "导入应用,导入后应用名称为dest-demo-app,版本为1.0.0",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/apps/batch-import",
        "x-request-examples-1": {
          "source_project_id": "3ce0f1b0-ac10-46a5-8fa7-b16831d7d480",
          "import_apps": [
            {
              "destination_app_name": "dest-demo-app",
              "destination_app_version": "1.0.0",
              "source_app_id": "2b4b1836-5967-11eb-8a0d-fa163e3ddba1"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "ImportAppRsp": {
      "properties": {
        "source_app_id": {
          "type": "string",
          "example": "328e5b04-f5f4-6528-3af1-a10790835f73",
          "description": "源应用id"
        },
        "destination_app_id": {
          "type": "string",
          "example": "7513f7c2-eed5-4ebb-bd7d-cee85a87a338",
          "description": "目标应用id"
        },
        "destination_app_name": {
          "type": "string",
          "example": "dest_app_name",
          "description": "目标应用名称"
        },
        "version": {
          "type": "string",
          "example": "1.0.0",
          "description": "应用版本"
        },
        "message": {
          "type": "string",
          "description": "导入结果信息,仅在导入失败时会返回"
        },
        "status": {
          "type": "string",
          "example": "IMPORT_SUCCESS",
          "description": "导入结果状态"
        }
      },
      "title": "ImportAppsResponse",
      "description": "导入应用响应体"
    },
    "AppSrcReq": {
      "required": [
        "destination_app_name",
        "destination_app_version",
        "source_app_id"
      ],
      "properties": {
        "destination_app_name": {
          "type": "string",
          "example": "dest-demo-app",
          "description": "目标应用名称 取值范围:长度为[1,56],以大小写字母开头,允许出现中划线(-)、下划线(_)、小写字母和数字,且必须以大小写字母或数字结尾。",
          "minLength": 1,
          "maxLength": 56,
          "x-annotations": [
            "@Pattern(regexp = \"^[a-zA-Z]+([-_]*[a-zA-Z0-9]+)*$\", message = \"The app parameter format does not match.\", groups = {GroupE.class})"
          ],
          "pattern": "^[a-zA-Z]+([-_]*[a-zA-Z0-9]+)*$",
          "x-pattern-message": "The app parameter format does not match."
        },
        "destination_app_version": {
          "type": "string",
          "example": "1.0.0",
          "description": "目标应用版本 取值范围:长度[1,24],以小写字母或数字或大写字母开头,允许出现中划线,必须以小写字母或数字或大写字母结尾。",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9]+([-.][a-zA-Z0-9]+)*$",
          "x-pattern-message": "The app parameter format does not match."
        },
        "source_app_id": {
          "type": "string",
          "example": "2b4b1836-5967-11eb-8a0d-fa163e3ddba1",
          "description": "源应用id",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]*$",
          "x-pattern-message": "The app id format does not match."
        }
      },
      "title": "AppSrc",
      "description": "导入应用参数"
    },
    "BatchImportAppReq": {
      "required": [
        "import_apps",
        "source_project_id"
      ],
      "properties": {
        "source_project_id": {
          "type": "string",
          "example": "3ce0f1b0-ac10-46a5-8fa7-b16831d7d480",
          "description": "源项目id",
          "minLength": 1,
          "maxLength": 128,
          "x-importvalid": true
        },
        "import_apps": {
          "type": "array",
          "description": "源应用列表",
          "items": {
            "$ref": "#/definitions/AppSrcReq"
          },
          "maxItems": 10,
          "minItems": 0
        }
      },
      "title": "ImportAppSrcDto",
      "description": "导入应用请求体"
    }
  },
