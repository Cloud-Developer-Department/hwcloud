{
  "name": "ShowOverview",
  "summary": "获取医疗平台信息",
  "tags": "IOverviewController",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/system/overview": {
      "get": {
        "tags": [
          "IOverviewController"
        ],
        "summary": "获取医疗平台信息",
        "description": "获取医疗平台信息",
        "operationId": "ShowOverview",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "id": "id",
                "storage": 64,
                "project_num": 5,
                "charge_mode": 2,
                "is_arrears": false
              }
            },
            "schema": {
              "$ref": "#/definitions/OverviewRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "OverviewRsp": {
      "required": [
        "is_arrears"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "平台ID",
          "maxLength": 64
        },
        "storage": {
          "type": "integer",
          "format": "int64",
          "description": "存储量,单位:byte"
        },
        "project_num": {
          "type": "integer",
          "format": "int32",
          "description": "项目总数"
        },
        "charge_mode": {
          "type": "integer",
          "format": "int32",
          "description": "计费模式"
        },
        "is_arrears": {
          "type": "boolean",
          "description": "是否欠费"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}