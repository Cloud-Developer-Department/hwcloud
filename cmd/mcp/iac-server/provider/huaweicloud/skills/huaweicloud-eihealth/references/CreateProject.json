{
  "name": "CreateProject",
  "summary": "创建项目",
  "tags": "空间管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/eihealth-projects": {
      "post": {
        "x-interface-name": "IProjectController",
        "tags": [
          "空间管理"
        ],
        "summary": "创建项目",
        "description": "创建项目",
        "operationId": "CreateProject",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,获取Token接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "in": "body",
            "name": "CreateProjectRequestBody",
            "description": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateProjectReq"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "CREATED",
            "examples": {
              "application/json": {
                "id": "fce1376b-72f9-4d15-9f95-9b533cb96fda"
              }
            },
            "schema": {
              "$ref": "#/definitions/ProjectIdRsp"
            }
          }
        },
        "x-ut-partial": true,
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "创建项目,设置描述、名称、标签",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects",
        "x-request-examples-1": {
          "description": "this is a demo project",
          "name": "demo-project",
          "tags": [
            "tag"
          ]
        }
      }
    }
  },
  "definitions": {
    "CreateProjectReq": {
      "required": [
        "name"
      ],
      "properties": {
        "description": {
          "type": "string",
          "example": "this is a demo project",
          "description": "项目描述",
          "minLength": 0,
          "maxLength": 1024
        },
        "name": {
          "type": "string",
          "example": "demo-project",
          "description": "项目名称",
          "minLength": 3,
          "maxLength": 45,
          "x-ut-example-only": "demo-project",
          "x-annotations": [
            "@Pattern(regexp = \"^[0-9a-z_-]*[0-9a-z]$\", message = \"Project name should start and end with a lowercase letter or digit. Can contain only digits, lowercase letter, `_` and `-`.\", groups = {GroupG.class})",
            "@Pattern(regexp = \"^[0-9a-z][0-9a-z_-]*$\", message = \"Project name should start and end with a lowercase letter or digit. Can contain only digits, lowercase letter, `_` and `-`.\", groups = {GroupG.class})"
          ]
        },
        "tags": {
          "type": "array",
          "example": [
            "tag"
          ],
          "description": "标签",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[\\一-\\龥\\sA-Za-z0-9-_]*$",
            "x-pattern-message": "label is illegal"
          },
          "maxItems": 5,
          "minItems": 0
        },
        "is_core": {
          "type": "boolean",
          "example": true,
          "description": "是否核心项目",
          "default": true,
          "x-ut-example-only": "false",
          "x-ut-exclude-equivalence": [
            "NULL"
          ]
        },
        "is_new_bucket": {
          "type": "boolean",
          "example": true,
          "description": "是否新桶, 仅气象支持该字段",
          "x-ut-example-only": "false"
        },
        "bucket_name": {
          "type": "string",
          "example": "bucket-demo123",
          "description": "桶名, 仅气象支持该字段",
          "minLength": 3,
          "maxLength": 63,
          "pattern": "^[a-z0-9-.]*$",
          "x-pattern-message": "bucket name is illegal",
          "x-ut-example-only": "demo-bucket"
        },
        "storage_tenant": {
          "type": "string",
          "example": "RESOURCE",
          "description": "**参数解释**:\n空间桶来源租户,TERMINATE表示最终租户桶。\n**约束限制**:\n不涉及\n**取值范围**:\n* TERMINATE: 最终租户桶。\n* RESOURCE: 资源租户桶。\n**默认取值**:\nTERMINATE",
          "pattern": "^(RESOURCE|TERMINATE)$"
        }
      },
      "title": "CreateProjectRequest",
      "description": "创建项目请求体"
    },
    "ProjectIdRsp": {
      "properties": {
        "id": {
          "type": "string",
          "example": "fce1376b-72f9-4d15-9f95-9b533cb96fda",
          "description": "项目id"
        }
      },
      "title": "ProjectResponse",
      "description": "项目id返回体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}