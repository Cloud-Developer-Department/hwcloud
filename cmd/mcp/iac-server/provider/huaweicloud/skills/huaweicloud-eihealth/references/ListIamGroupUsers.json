{
  "name": "ListIamGroupUsers",
  "summary": "查询IAM用户组的用户列表",
  "tags": "用户管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/iam/groups/{group_id}/users": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-interface-name": "IIAMController",
        "tags": [
          "用户管理"
        ],
        "summary": "查询IAM用户组的用户列表",
        "description": "查询IAM用户组的用户列表",
        "operationId": "ListIamGroupUsers",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "group_id",
            "in": "path",
            "description": "IAM用户组id",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "group_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListIamGroupRsp"
            },
            "examples": {
              "application/json": {
                "count": 1,
                "groups": [
                  {
                    "id": "56e0f1b0-ac10-46a5-8fa7-b26831d7d488",
                    "name": "user1"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "IamGroupDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "IAM用户组id"
        },
        "name": {
          "type": "string",
          "example": "demo-user",
          "description": "IAM用户组名"
        }
      }
    },
    "ListIamGroupRsp": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "description": "用户组列表",
          "items": {
            "$ref": "#/definitions/IamGroupDto"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "总数"
        }
      },
      "description": "查询用户列表响应体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
