                    },
                    "location": {
                      "x": 100,
                      "y": 100
                    },
                    "inputs": [
                      {
                        "name": "dir-parameter",
                        "values": [
                          "/test"
                        ]
                      }
                    ],
                    "app_info": {
                      "app_id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                      "app_name": "demo-app",
                      "app_version": "1.0.0",
                      "app_labels": [
                        "labelA",
                        "labelB"
                      ],
                      "app_summary": "summary",
                      "app_description": "description",
