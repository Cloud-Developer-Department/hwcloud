                      "app_commands": [
                        "echo eihealth;"
                      ],
                      "app_input_parameters": [
                        {
                          "name": "dir-parameter",
                          "description": "parameter description",
                          "required": true,
                          "type": "DIRECTORY",
                          "pattern": "*.fastq",
                          "values": [
                            "/test"
