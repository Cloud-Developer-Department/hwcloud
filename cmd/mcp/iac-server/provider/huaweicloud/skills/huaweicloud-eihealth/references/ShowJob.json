{
  "name": "ShowJob",
  "summary": "获取作业详情",
  "tags": "作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/jobs/{job_id}": {
      "get": {
        "x-interface-name": "IJobController",
        "tags": [
          "作业管理"
        ],
        "summary": "获取作业详情",
        "description": "获取作业详情",
        "operationId": "ShowJob",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Addition-Info",
            "in": "header",
            "description": "设置为LOG时,返回作业日志链接",
            "required": false,
            "type": "string",
            "pattern": "^$|^(LOG)$"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is illegal"
          },
          {
            "name": "job_id",
            "in": "path",
            "description": "作业id",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "The job id format does not match."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                "name": "demo-job",
                "description": "description",
                "labels": [
                  "labelA",
                  "labelB"
                ],
                "priority": 0,
                "timeout": 1440,
                "output_dir": "/job/task",
                "status": "SUCCEEDED",
                "create_time": "2021-01-30T02:53:26Z",
