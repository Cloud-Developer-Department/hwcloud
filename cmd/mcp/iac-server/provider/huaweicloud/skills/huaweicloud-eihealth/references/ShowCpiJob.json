{
  "name": "ShowCpiJob",
  "summary": "查询CPI作业详情",
  "tags": "CPI作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/drug-jobs/cpi/{job_id}": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-ut-partial": true,
        "x-interface-name": "IDockingJobController",
        "tags": [
          "CPI作业管理"
        ],
        "summary": "查询CPI作业详情",
        "description": "查询CPI作业详情",
        "operationId": "ShowCpiJob",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "x-example": "termToken"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](eihealth_33_0044.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is invalid",
            "x-example": "projectId"
          },
          {
            "name": "job_id",
            "in": "path",
            "description": "作业id",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "job_id is invalid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/CpiJobDetailRsp"
            },
            "examples": {
              "application/json": {
                "basic_info": {
                  "id": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
                  "name": "demo-job",
                  "labels": [
                    "labelA",
                    "labelB"
                  ],
                  "status": "FINISHED",
                  "type": "OPTIMIZATION",
                  "create_time": "2021-01-30T02:34:36Z",
                  "finish_time": "2021-01-30T02:53:26Z",
                  "failed_message": "null",
                  "user_name": "demo-user-name",
                  "output_dir": "job-analysis/job-name",
                  "expect_charge_num": 1,
                  "real_charge_num": 1
                },
                "receptors": [
                  {
                    "source": "PRIVATE",
                    "url": "project:/dir/file"
                  }
                ],
                "ligands": [
                  {
                    "file": {
                      "source": "PRIVATE",
                      "url": "project:/dir/file"
                    },
                    "count": 10000
                  }
                ]
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "MoleculeFile": {
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8,
          "example": "PRIVATE",
          "pattern": "^(PRIVATE|PUBLIC|RAW)$",
          "description": "文件来源,支持用户私有数据中心、公共数据和源数据"
        },
        "url": {
          "type": "string",
          "description": "文件URL,用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "pattern": ".*\\.(pdb|sdf|mol2|smi)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB|SDF|MOL2|SMI)$",
          "description": "文件格式,支持PDB、SDF、MOL2、SMI,仅数据源为RAW时提供"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "文件原始数据,仅数据源为RAW时提供"
        }
      }
    },
    "DrugJobDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "baabcb56-5bb6-11eb-8a0d-fa163e3ddba1",
          "description": "作业id"
        },
        "name": {
          "type": "string",
          "example": "demo-job",
          "description": "作业的名称,取值范围:[1,63],允许大小写字母、数字、以及特殊字符中划线(-)"
        },
        "eihealth_project_id": {
          "type": "string",
          "example": "demo_id",
          "description": "**参数解释**:\n作业所属空间ID。\n**约束限制**:\n不涉及\n**取值范围**:\n长度为[1-63]个字符,允许大小写字母、数字、以及特殊字符中划线(-)。\n**默认取值**:\n不涉及"
        },
        "eihealth_project_name": {
          "type": "string",
          "example": "demo_name",
          "description": "**参数解释**:\n作业所属空间名称。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        },
        "upstream_job_info": {
          "type": "string",
          "example": "{\"job_id\":\"demo-job-id\",\"job_name\":\"demo-job-name\"}",
          "description": "**参数解释**:\n上游作业信息。\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及"
        },
        "labels": {
          "type": "array",
          "example": [
            "labelA",
            "labelB"
          ],
          "description": "作业标签",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "example": "FINISHED",
          "description": "作业状态"
        },
        "type": {
          "type": "string",
          "example": "OPTIMIZATION",
          "description": "作业类型"
        },
        "create_time": {
          "type": "string",
          "example": "2021-01-30T02:34:36Z",
          "description": "作业创建时间"
        },
        "finish_time": {
          "type": "string",
          "example": "2021-01-30T02:53:26Z",
          "description": "作业结束时间"
        },
        "start_time": {
          "type": "string",
          "example": "2021-01-30T02:50:26Z",
          "description": "作业开始时间"
        },
        "failed_message": {
          "type": "string",
          "example": "null",
          "description": "失败提示,当作业执行失败时会返回"
        },
        "user_name": {
          "type": "string",
          "example": "demo-user-name",
          "description": "创建任务的用户名称"
        },
        "output_dir": {
          "type": "string",
          "example": "projectName:/job-result/dir",
          "description": "作业结果输出目录"
        },
        "expect_charge_num": {
          "type": "number",
          "format": "double",
          "example": 1,
          "description": "预估功能调用消耗次数"
        },
        "real_charge_num": {
          "type": "number",
          "format": "double",
          "example": 1,
          "description": "实际功能调用消耗次数"
        },
        "progress": {
          "$ref": "#/definitions/Progress",
          "description": "作业进度信息"
        }
      }
    },
    "CpiJobDetailRsp": {
      "type": "object",
      "description": "获取分子对接作业详情响应体",
      "properties": {
        "basic_info": {
          "$ref": "#/definitions/DrugJobDto",
          "description": "作业基本信息"
        },
        "receptors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReceptorDrugFile"
          },
          "minItems": 1,
          "maxItems": 100,
          "description": "受体文件列表"
        },
        "ligands": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MoleculeFileDto"
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "小分子"
        }
      }
    },
    "Progress": {
      "properties": {
        "overall": {
          "type": "number",
          "format": "float",
          "example": 0.21,
          "description": "整体进度"
        },
        "estimated_finish_time": {
          "type": "integer",
          "format": "int64",
          "example": 1000,
          "description": "预计结束时间,毫秒"
        }
      }
    },
    "ReceptorDrugFile": {
      "required": [
        "source"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/DrugFileSource",
          "example": "RAW"
        },
        "url": {
          "type": "string",
          "description": "文件URL,当数据源为外部网络数据时为https地址;用户私有数据中心为项目路径、公共数据场景为obs地址",
          "example": "https://files.rcsb.org/download/1TQN.pdb",
          "pattern": ".*\\.(pdb)$",
          "minLength": 1,
          "maxLength": 2000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "example": "PDB",
          "pattern": "^(PDB)$",
          "description": "文件格式,仅支持PDB,仅数据源为RAW时提供"
        },
        "data": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000000,
          "example": "raw_data",
          "description": "文件原始数据,仅数据源为RAW时提供",
          "x-ut-exclude-equivalence": [
            "NULL"
          ]
        }
      }
    },
    "MoleculeFileDto": {
      "type": "object",
      "required": [
        "file",
        "count"
      ],
      "properties": {
        "file": {
          "$ref": "#/definitions/MoleculeFile",
          "description": "分子文件"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "分子个数",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "DrugFileSource": {
      "type": "string",
      "enum": [
        "EXTRANET",
        "PRIVATE",
        "PUBLIC",
        "RAW"
      ],
      "description": "受体的数据源:外部网络数据(如RCSB在线数据库)、用户私有数据中心、承载租户公共数据(含样例/公共库)"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ai4sservice.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}