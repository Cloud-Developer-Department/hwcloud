{
  "name": "UpdateJob",
  "summary": "更新作业",
  "tags": "作业管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/eihealth-projects/{eihealth_project_id}/jobs/{job_id}": {
      "put": {
        "x-interface-name": "IJobController",
        "tags": [
          "作业管理"
        ],
        "summary": "更新作业",
        "description": "更新作业",
        "operationId": "UpdateJob",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\nToken认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](eihealth_33_0010.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string"
          },
          {
            "name": "eihealth_project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "eihealth_project_id is illegal"
          },
          {
            "name": "job_id",
            "in": "path",
            "description": "作业id",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "The job id format does not match."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "平台项目ID,您可以在平台单击所需的项目名称,进入项目设置页面查看。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "in": "body",
            "name": "UpdateJobRequestBody",
            "description": "updateJobReq",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateJobReq"
            }
          }
        ],
        "deprecated": false,
        "responses": {
          "202": {
            "description": "ACCEPTED"
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-description-1": "更新作业,更新作业的cpu资源为1C,内存资源为1G",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/eihealth-projects/{eihealth_project_id}/jobs/{job_id}/update",
        "x-request-examples-1": {
          "tasks": [
            {
              "task_name": "app1-1",
              "inputs": [
                {
                  "name": "dir-parameter",
                  "source": "MANUAL",
                  "values": [
                    "/test"
                  ]
                }
              ],
              "resources": {
                "cpu": "1C",
                "cpu_type": "X86",
                "memory": "1G",
                "gpu_type": "GPU",
                "gpu": "0"
              },
              "io_acc_type": "SFS"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "JobTaskDto": {
      "required": [
        "task_name"
      ],
      "properties": {
        "task_name": {
          "type": "string",
          "example": "app1-1",
          "description": "子任务实际名称,取值范围[1,32],只能以大小写字母开头,由大小写字母、数字、中划线(-)、下划线(_)组成,以大小写字符或数字结尾。需要和已有子任务的名称一致。",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z](([-_]*[a-zA-Z0-9])|[a-zA-Z0-9])*$",
          "x-pattern-message": "The task parameter format does not match."
        },
        "inputs": {
          "type": "array",
          "description": "任务的输入参数信息",
          "items": {
            "$ref": "#/definitions/TaskParameterDto"
          },
          "maxItems": 128,
          "minItems": 0
        },
        "outputs": {
          "type": "array",
          "description": "**参数解释**:\n任务的输出参数信息。\n**约束限制**:\n最多支持128个参数。\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
          "items": {
            "$ref": "#/definitions/TaskParameterDto"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "output_dir": {
          "type": "string",
          "example": "/job",
          "description": "**参数解释**:\n子任务结果存储目录,默认为空。\n**约束限制**:\n不涉及\n**取值范围**:\n长度[0,128]。\n**默认取值**:\n不涉及",
          "minLength": 0,
          "maxLength": 128
        },
        "resources": {
          "$ref": "#/definitions/TaskResourceDto"
        },
        "io_acc_type": {
          "type": "string",
          "example": "SFS",
          "description": "子任务使用的IO加速实例类型,不填表示不使用;",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^$|^(SFS|EVS)$",
          "x-pattern-message": "The task parameter format does not match."
        }
      },
      "title": "JobTaskDto"
    },
    "UpdateJobReq": {
      "required": [
        "tasks"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "description": "步骤的参数修改信息",
          "items": {
            "$ref": "#/definitions/JobTaskDto"
          },
          "maxItems": 64,
          "minItems": 0
        }
      },
      "title": "UpdateJobReq",
      "description": "更新作业参数请求体"
    },
    "TaskParameterDto": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "dir-parameter",
          "description": "子任务的参数名称,长度为[1,32],以小写字母开头,允许出现中划线(-)、小写字母和数字,且必须以小写字母或数字结尾。需要和已有应用的参数名称一致。",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$",
          "x-pattern-message": "The task parameter format does not match."
        },
        "source": {
          "type": "string",
          "example": "MANUAL",
          "description": "子任务的参数类型,不填默认为MANUAL",
          "pattern": "^$|^(MANUAL|DATABASE)$",
          "x-pattern-message": "The task parameter format does not match."
        },
        "values": {
          "type": "array",
          "example": [
            "/test"
          ],
          "description": "子任务的参数数值,根据参数类型进行合法性校验",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2048
          },
          "maxItems": 128,
          "minItems": 0
        }
      }
    },
    "TaskResourceDto": {
      "properties": {
        "cpu": {
          "type": "string",
          "example": "1C",
          "description": "cpu申请使用量,取值范围[0.1-128],单位C,支持一位小数。对于应用,不填默认1C;对于流程和作业,不填默认使用前一级的配置,填值会覆盖更新。覆盖关系:作业->流程->应用",
          "minLength": 0,
          "maxLength": 24
        },
        "cpu_type": {
          "type": "string",
          "example": "X86",
          "description": "cpu架构类型,不填默认X86",
          "minLength": 0,
          "maxLength": 24,
          "pattern": "^$|^(X86|ARM)$",
          "x-pattern-message": "The cpu_type format does not match."
        },
        "memory": {
          "type": "string",
          "example": "1G",
          "description": "内存申请使用量,取值范围[0.1-3072],单位G,支持一位小数。对于应用,不填默认1G;对于流程和作业,不填默认使用前一级的配置,填值会覆盖更新。覆盖关系:作业->流程->应用",
          "minLength": 0,
          "maxLength": 24
        },
        "gpu_type": {
          "type": "string",
          "example": "GPU",
          "description": "gpu架构类型,取值范围 ' '|GPU|D910|D310。对于流程和作业,不填默认使用前一级的配置,填值会覆盖更新。覆盖关系:作业->流程->应用",
          "minLength": 0,
          "maxLength": 24,
          "pattern": "^$|^(GPU|D910|D310)$",
          "x-pattern-message": "The gpu_type format does not match."
        },
        "gpu": {
          "type": "string",
          "example": "0",
          "description": "gpu申请使用量,取值范围[0-16],仅支持整数,D910有特殊约束,申请数量需要是0,1,2,4,8。对于应用,不填默认0;对于流程和作业,不填默认使用前一级的配置,填值会覆盖更新。覆盖关系:作业->流程->应用",
          "minLength": 0,
          "maxLength": 24
        }
      },
      "description": "应用申请资源"
    }
  },
  "version": "2.0",
  "parameters": {},
