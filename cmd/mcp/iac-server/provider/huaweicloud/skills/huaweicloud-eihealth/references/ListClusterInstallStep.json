{
  "name": "ListClusterInstallStep",
  "summary": "查询指定集群安装步骤列表",
  "tags": "计算集群管理",
  "productshort": "eiHealth",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/system/computing-clusters/{cluster_id}/steps": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-ut-partial": true,
        "x-interface-name": "IComputingClusterController",
        "tags": [
          "计算集群管理"
        ],
        "summary": "查询指定集群安装步骤列表",
        "description": "查询指定集群安装步骤列表。",
        "operationId": "ListClusterInstallStep",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。 Token认证就是在调用API的时候将Token加到请求消息头,从而通过身份认证,获得操作API的权限,[获取Token](ai4s_03_0011.xml)接口响应消息头中X-Subject-Token的值即为Token。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,您可以从[获取项目ID](ai4s_03_0023.xml)中获取。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "project_id is invalid",
            "x-ut-exclude-equivalence": [
              "EFFECTIVE"
            ]
          },
          {
            "name": "cluster_id",
            "in": "path",
            "description": "计算集群ID。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-pattern-message": "cluster_id is invalid",
            "x-ut-exclude-equivalence": [
              "EFFECTIVE"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListClusterInstallStepRsp"
            },
            "examples": {
              "application/json": {
                "installs": [
                  {
                    "name": "elb install",
                    "status": "FAILED",
                    "failed_reason": "internal error."
                  }
                ],
                "uninstalls": [
                  {
                    "name": "vpcep install",
                    "status": "FINISHED"
                  }
                ]
              }
            }
          }
        },
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/system/computing-clusters/{cluster_id}/steps",
        "x-request-examples-description-1": "查询指定集群安装步骤列表。",
        "deprecated": false
      }
    }
  },
  "definitions": {
    "StepStatus": {
      "type": "string",
      "enum": [
        "RUNNING",
        "FAILED",
        "FINISHED"
      ]
    },
    "ListClusterInstallStepRsp": {
      "description": "集群安装步骤详情。",
      "properties": {
        "installs": {
          "type": "array",
          "description": "安装步骤详情列表。",
          "items": {
            "$ref": "#/definitions/InstallStep"
          }
        },
        "uninstalls": {
          "type": "array",
          "description": "卸载步骤详情列表。",
          "items": {
            "$ref": "#/definitions/InstallStep"
          }
        }
      }
    },
    "InstallStep": {
      "description": "安装步骤详情。",
      "properties": {
        "name": {
          "type": "string",
          "description": "安装步骤。"
        },
        "status": {
          "$ref": "#/definitions/StepStatus",
          "description": "安装状态。"
        },
        "failed_reason": {
          "type": "string",
          "description": "失败原因。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
