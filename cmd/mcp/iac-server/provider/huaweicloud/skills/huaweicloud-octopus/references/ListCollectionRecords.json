{
  "name": "ListCollectionRecords",
  "summary": "获取导入任务列表",
  "tags": "数据导入",
  "productshort": "Octopus",
  "region_id": "cn-north-11",
  "paths": {
    "/v1.0/{project_id}/data/import-records": {
      "get": {
        "operationId": "ListCollectionRecords",
        "description": "获取导入任务列表",
        "tags": [
          "数据导入"
        ],
        "summary": "获取导入任务列表",
        "x-iftype": "openapi",
        "x-support-sdk": "N",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "description": "项目id,获取方法请参见[获取项目ID](octopus-10-0020.xml)",
            "schema": {
              "type": "string",
              "pattern": "[a-z0-9]{32}"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "workspace_id",
            "description": "工作空间id",
            "schema": {
              "default": "0",
              "type": "string",
              "pattern": "0$|^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "offset",
            "description": "查询偏移量",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "format": "int32"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "description": "返回个数上限",
            "schema": {
              "format": "int32",
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 10
            },
            "required": false
          },
          {
            "in": "query",
            "name": "status",
            "description": "导入任务状态筛选,支持以逗号分隔填写多个值。最多20个。",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "WAITING_IMPORT(数据待传输)",
                "IMPORTING(导入中)",
                "SUCCESS(成功)",
                "FAILED(失败)",
                "DELETING(删除中)",
                "DELETE_FAILED(删除失败)",
                "DELETED(已删除)"
              ]
            }
          },
          {
            "in": "query",
            "name": "id",
            "description": "模糊查询:导入任务ID",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "[\\一-\\龥a-zA-Z0-9-_.]{1,255}",
              "maxLength": 255
            }
          },
          {
            "in": "query",
            "name": "start_at",
            "required": false,
            "description": "最小导入时间,UTC标准时间毫秒时间戳",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1000000000000,
              "maximum": 2000000000000
            }
          },
          {
            "in": "query",
            "name": "end_at",
            "description": "最大导入时间,UTC标准时间毫秒时间戳",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1000000000000,
              "maximum": 2000000000000
            }
          },
          {
            "in": "query",
            "name": "sort",
            "description": "排序方式",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CREATE_AT_ASC(导入时间升序)",
                "CREATE_AT_DESC(导入时间降序)",
                "UPDATE_AT_ASC(更新时间升序)",
                "UPDATE_AT_DESC(更新时间降序)"
              ],
              "default": "UPDATE_AT_DESC(更新时间降序)"
            }
          },
          {
            "in": "query",
            "name": "source_type",
            "description": "传输方式",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "OBS(对象存储)"
              ]
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-request-examples-description-1": "查询数据导入任务列表",
        "x-request-examples-url-1": "GET https://{endpoint}/v1.0/{project_id}/data/import-records?sort=CREATE_AT_DESC&offset=0&limit=10&status=SUCCESS",
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/models.data.collecting.DataCollectListModel"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误"
          },
          "403": {
            "description": "权限校验失败"
          },
          "500": {
            "description": "系统内部错误"
          }
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.3",
  "parameters": null,
  "host": "octopus.cn-north-11.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}