{
  "name": "ListPackages",
  "summary": "获取数据包列表",
  "tags": "数据包",
  "productshort": "Octopus",
  "region_id": "cn-north-11",
  "paths": {
    "/v1.0/{project_id}/data/packages": {
      "get": {
        "x-request-examples-url-1": "GET https://{endpoint}/v1.0/{project_id}/data/packages?status=NORMAL&sort=CREATE_AT_DESC&offset=0&limit=10&is_recycle=false",
        "x-request-examples-description-1": "获取数据包列表",
        "operationId": "ListPackages",
        "description": "获取数据包列表",
        "tags": [
          "数据包"
        ],
        "summary": "获取数据包列表",
        "x-iftype": "openapi",
        "x-support-sdk": "N",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "description": "项目id,获取方法请参见[获取项目ID](octopus-10-0020.xml)",
            "schema": {
              "type": "string",
              "pattern": "[a-z0-9]{32}"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "workspace_id",
            "description": "工作空间id",
            "schema": {
              "type": "string",
              "pattern": "0$|^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
              "default": "0"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "offset",
            "description": "查询偏移量",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "description": "返回个数上限",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10,
              "minimum": 1,
              "maximum": 200
            },
            "required": false
          },
          {
            "in": "query",
            "name": "status",
            "description": "数据包状态,配合is_recycle字段使用。\nis_recycle=true时,状态有NOT_RECYCLED,RECYCLED,DELETING,FAILED,DELETED。\nis_recycle=false时,状态有CREATED,SCANNING,NORMAL,ABNORMAL,PRE_DESENSITIZATION,IN_DESENSITIZATION,DESENSITIZATION_SUCCESS,DESENSITIZATION_FAILED",
            "schema": {
              "type": "string",
              "enum": [
                "CREATED(已创建)",
                "SCANNING(扫描中)",
                "NORMAL(导入完成)",
                "ABNORMAL(导入异常)",
                "PRE_DESENSITIZATION(待脱敏)",
                "IN_DESENSITIZATION(脱敏中)",
                "DESENSITIZATION_SUCCESS(脱敏完成)",
                "DESENSITIZATION_FAILED(脱敏失败)",
                "NOT_RECYCLED(未回收)",
                "RECYCLED(待处理)",
                "DELETING(删除中)",
                "FAILED(删除失败)",
                "DELETED(已删除)"
              ]
            },
            "required": false
          },
          {
            "in": "query",
            "name": "id",
            "description": "模糊查询:数据包ID",
            "schema": {
              "type": "string",
              "pattern": "[\\一-\\龥a-zA-Z0-9-_.]{1,255}",
              "maxLength": 255
            },
            "required": false
          },
          {
            "in": "query",
            "name": "ids",
            "description": "批量查询:数据包ID",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "[\\一-\\龥a-zA-Z0-9-_.]{1,255}",
                "maxLength": 200
              }
            },
            "required": false
          },
          {
            "in": "query",
            "name": "name",
            "description": "模糊查询:数据包名称",
            "schema": {
              "type": "string",
              "pattern": "[\\一-\\龥a-zA-Z0-9-_.]{1,255}",
              "maxLength": 255
            },
            "required": false
          },
          {
            "in": "query",
            "name": "vehicle_name",
            "description": "车辆名称",
            "schema": {
              "type": "string",
              "pattern": "[\\一-\\龥a-zA-Z0-9-_.]{1,255}",
              "maxLength": 255
            },
            "required": false
          },
          {
            "in": "query",
            "name": "dcl_id",
            "description": "导入id或数据递送单号,DCL或DO开头,加13位数字",
            "schema": {
              "type": "string",
              "pattern": "(DCL|DO)[0-9]{13}"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "calibration_id",
            "description": "标定id",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "required": false
          },
          {
            "in": "query",
            "name": "start_at",
            "description": "最小导入时间,UTC标准时间毫秒时间戳",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1000000000000,
              "maximum": 2000000000000
            },
            "required": false
          },
          {
            "in": "query",
            "name": "end_at",
            "description": "最大导入时间,UTC标准时间毫秒时间戳",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1000000000000,
              "maximum": 2000000000000
            },
            "required": false
          },
          {
            "in": "query",
            "name": "sort",
            "description": "排序方式",
            "required": false,
            "schema": {
              "type": "string",
              "default": "UPDATE_AT_DESC(更新时间降序)",
              "enum": [
                "CREATE_AT_ASC(导入时间升序)",
                "CREATE_AT_DESC(导入时间降序)",
                "UPDATE_AT_ASC(更新时间升序)",
                "UPDATE_AT_DESC(更新时间降序)",
                "STORAGE_SIZE_ASC(数据量升序)",
                "STORAGE_SIZE_DESC(数据量降序)"
              ]
            }
          },
          {
            "in": "query",
            "name": "is_recycle",
            "description": "是否已回收",
            "schema": {
              "type": "boolean"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "data_source",
            "description": "传输方式",
            "schema": {
              "type": "string",
              "enum": [
                "OBS(对象存储)",
                "DES(数据递送)"
              ]
            },
            "required": false
          },
          {
            "in": "query",
            "name": "project",
            "description": "项目",
            "schema": {
              "type": "string",
              "pattern": "[\\一-\\龥a-zA-Z0-9-_.]{1,255}",
              "maxLength": 255
            },
            "required": false
          },
          {
            "in": "query",
            "name": "module",
            "description": "模块",
            "schema": {
              "type": "string",
              "pattern": "[\\一-\\龥a-zA-Z0-9-_.]{1,255}",
              "maxLength": 255
            },
            "required": false
          },
          {
            "in": "query",
            "name": "tags",
            "description": "标签筛选,最大长度10",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              },
              "maxItems": 10
            },
            "required": false
          },
          {
            "in": "query",
            "name": "station",
            "description": "采集站点",
            "schema": {
              "type": "string",
              "pattern": "[\\一-\\龥a-zA-Z0-9-_.]{1,255}",
              "maxLength": 255
            },
            "required": false
          },
          {
            "in": "query",
            "name": "mode",
            "description": "驾驶模式",
            "schema": {
              "type": "string",
              "pattern": "[\\一-\\龥a-zA-Z0-9-_.]{1,255}",
              "maxLength": 255
            },
            "required": false
          },
          {
            "in": "query",
            "name": "collect_start_at",
            "description": "最小收集时间,UTC标准时间毫秒时间戳",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1000000000000,
              "maximum": 2000000000000
            },
            "required": false
          },
          {
            "in": "query",
            "name": "collect_end_at",
            "description": "最大收集时间,UTC标准时间毫秒时间戳",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1000000000000,
              "maximum": 2000000000000
            },
            "required": false
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "has_opendata",
            "in": "query",
            "description": "是否是opendata数据包",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataPackageListModel"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误"
          },
          "403": {
            "description": "权限校验失败"
          },
          "500": {
            "description": "系统内部错误"
          }
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.3",
  "parameters": null,
  "host": "octopus.cn-north-11.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}