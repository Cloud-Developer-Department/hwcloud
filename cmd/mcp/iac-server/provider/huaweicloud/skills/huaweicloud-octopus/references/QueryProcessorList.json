        "operationId": "QueryProcessorList",
        "summary": "查询算子列表",
        "x-iftype": "openapi",
        "x-support-sdk": "N",
        "description": "查询算子列表",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目id,获取方法请参见[获取项目ID](octopus-10-0020.xml)",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "[a-z0-9]{32}"
            }
          },
          {
            "in": "query",
            "name": "workspace_id",
            "description": "工作空间id",
            "required": false,
            "schema": {
              "default": "0",
              "type": "string",
              "pattern": "0$|^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "算子id",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "算子名称",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "[\\一-\\龥a-zA-Z0-9-_]{0,256}",
              "maxLength": 256
            }
          },
          {
            "name": "output_type",
            "in": "query",
            "description": "输出类型",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "DATA_MARK(数据标记)",
                  "OPEN_DATA(数据回放)",
                  "DATA_SET(数据集)",
                  "REPLAY_SIM(回放仿真)",
                  "PLOT_DATA(数据图表)",
                  "DATA_DESENSITIZATION(数据脱敏)"
                ]
              },
              "maxItems": 10
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "返回个数上限",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 200,
              "default": 10
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询偏移量",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "sort",
            "description": "排序方式",
            "required": false,
            "schema": {
              "type": "string",
              "default": "UPDATE_DESC(更新时间降序)",
              "enum": [
                "CREATE_ASC(创建时间升序)",
                "CREATE_DESC(创建时间降序)",
                "UPDATE_ASC(更新时间升序)",
                "UPDATE_DESC(更新时间降序)"
              ]
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
