{
  "name": "GetSystemJobList",
  "summary": "查询内部作业列表",
  "tags": "内部作业",
  "productshort": "Octopus",
  "region_id": "cn-north-11",
  "paths": {
    "/v1.0/{project_id}/data/system-jobs": {
      "get": {
        "x-request-examples-url-1": "https://{endpoint}/v1.0/{project_id}/data/system-job?job_types=SCENARIO_AUTO_MINING",
        "x-request-examples-description-1": "内部作业列表",
        "tags": [
          "内部作业"
        ],
        "operationId": "GetSystemJobList",
        "summary": "查询内部作业列表",
        "x-iftype": "openapi",
        "x-support-sdk": "N",
        "description": "查询内部作业列表",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目id,获取方法请参见[获取项目ID](octopus-10-0020.xml)",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "[a-z0-9]{32}"
            }
          },
          {
            "in": "query",
            "name": "workspace_id",
            "description": "工作空间id",
            "required": false,
            "schema": {
              "type": "string",
              "default": "0",
              "pattern": "0$|^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
            }
          },
          {
            "in": "query",
            "name": "data_id",
            "description": "输入数据id",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "[\\一-\\龥a-zA-Z0-9-_]{1,64}",
              "maxLength": 64
            }
          },
          {
            "in": "query",
            "name": "id",
            "description": "作业id",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "job_types",
            "description": "作业类型",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "PACKAGE_IMPORT(数据包导入)",
                  "PACKAGE_DELETE(数据包删除)",
                  "SCENARIO_AUTO_MINING(场景挖掘)",
                  "SCENARIO_TO_SIM(转仿真场景)",
                  "FRAME_EXTRACT(数据抽帧)",
                  "SCENARIO_EXTRACT(场景提取)"
                ]
              },
              "maxItems": 20
            }
          },
          {
            "in": "query",
            "name": "statuses",
            "description": "作业状态",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "QUEUING(排队中)",
                  "SUBMIT_FAILED(提交失败)",
                  "RUNNING(运行中)",
                  "RUN_FAILED(运行异常)",
                  "FINISHED(已完成)",
                  "STOPPED(已停止)",
                  "LAUNCHING(启动中)",
                  "UPLOADING(上传中)",
                  "UPLOAD_FAILED(上传失败)"
                ]
              },
              "maxItems": 20
            }
          },
          {
            "in": "query",
            "name": "start_time",
            "description": "最小创建时间,UTC标准时间毫秒时间戳",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1000000000000,
              "maximum": 2000000000000
            }
          },
          {
            "in": "query",
            "name": "end_time",
            "description": "最大更新时间,UTC标准时间毫秒时间戳",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1000000000000,
              "maximum": 2000000000000
            }
          },
          {
            "in": "query",
            "name": "offset",
            "description": "查询偏移量",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "limit",
            "description": "返回个数上限",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "in": "query",
            "name": "sort",
            "description": "排序",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CREATE_ASC(创建时间升序)",
                "CREATE_DESC(创建时间降序)",
                "UPDATE_ASC(更新时间升序)",
                "UPDATE_DESC(更新时间降序)"
              ],
              "default": "UPDATE_DESC(更新时间降序)"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataSystemJobInfoPayloadResponse"
                }
              }
            },
            "x-response-examples-1": {
              "application/json": {
                "meta_info": {
                  "current_time": "2022-01-01T08:08:29Z"
                },
                "payload": {
                  "list": [
                    {
                      "id": 1,
                      "job_type": "SCENARIO_AUTO_MINING",
