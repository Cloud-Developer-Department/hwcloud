  "definitions": {
    "Rule": {
      "required": [
        "params",
        "tag_selectors",
        "template"
      ],
      "properties": {
        "template": {
          "type": "string",
          "enum": [
            "date_rule",
            "tag_rule"
          ],
          "description": "回收类型,date_rule、tag_rule"
        },
        "params": {
          "type": "object",
          "description": "template是date_rule时,设置params为{\"days\": \"xxx\"}\ntemplate是tag_rule时,设置params为{\"num\": \"xxx\"}"
        },
        "tag_selectors": {
          "type": "array",
          "description": "例外镜像",
          "items": {
            "$ref": "#/definitions/TagSelector"
          }
        }
      }
    },
    "Retention": {
      "required": [
        "algorithm",
        "id",
        "rules",
        "scope"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "description": "回收规则匹配策略,or"
        },
        "id": {
          "type": "integer",
          "format": "int32",
          "description": "ID"
        },
        "rules": {
          "type": "array",
          "description": "镜像老化规则",
          "items": {
            "$ref": "#/definitions/Rule"
          }
        },
        "scope": {
          "type": "string",
          "description": "保留字段"
        }
      },
      "description": "镜像老化规则"
    },
    "TagSelector": {
      "required": [
        "kind",
        "pattern"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "匹配规则,label、regexp"
        },
        "pattern": {
          "type": "string",
          "description": "kind是label时,设置为镜像版本,kind是regexp时,设置为正则表达式"
        }
      }
    }
  },
