{
  "name": "ShowNamespaceAuth",
  "summary": "查询组织权限",
  "tags": "组织权限管理",
  "productshort": "SWR",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/manage/namespaces/{namespace}/access": {
      "get": {
        "tags": [
          "组织权限管理"
        ],
        "summary": "查询组织权限",
        "operationId": "ShowNamespaceAuth",
        "produces": [
          "application/json"
        ],
        "description": "查询组织权限",
        "parameters": [
          {
            "name": "Content-Type",
            "default": "application/json",
            "in": "header",
            "description": "消息体的类型(格式),下方类型可任选其一使用:\napplication/json;charset=utf-8\napplication/json",
            "required": true,
            "type": "string",
            "enum": [
              "application/json;charset=utf-8",
              "application/json"
            ],
            "x-example": "application/json",
            "x-order": 1
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-order": 2
          },
          {
            "name": "namespace",
            "in": "path",
            "description": "组织名称。小写字母开头,后面跟小写字母、数字、小数点、下划线或中划线(其中下划线最多允许连续两个,小数点、下划线、中划线不能直接相连),小写字母或数字结尾,1-64个字符。",
            "required": true,
            "type": "string",
            "x-example": "huawei",
            "x-order": 3
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "$ref": "#/definitions/ShowNamespaceAuthResp"
            },
            "examples": {
              "application/json": {
                "id": 1422,
                "name": "test",
                "creator_name": "user01",
                "self_auth": {
                  "user_id": "3059e6b5562241fda3fa441cca6f228b",
                  "user_name": "user",
                  "auth": 7
                },
                "others_auths": [
                  {
                    "user_id": "fb3f175c1fd146ab8cdae3272be6107b",
                    "user_name": "user01",
                    "auth": 7
                  }
                ]
              }
            }
          },
          "400": {
            "description": "错误的请求"
          },
          "401": {
            "description": "鉴权失败"
          },
          "404": {
            "description": "组织不存在"
          },
          "500": {
            "description": "内部错误"
          }
        },
        "x-name": "查询组织权限",
        "x-constraint": "无",
        "x-version": "v1",
        "x-scope": "Commercial",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "",
        "x-request-examples-1": "GET https://{endpoint}/v2/manage/namespaces/{namespace}/access",
        "x-request-examples-text-1": "GET https://{endpoint}/v2/manage/namespaces/{namespace}/access",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "false",
        "x-publishpath": "swr_02_0045"
      }
    }
  },
  "definitions": {
    "UserAuth": {
      "required": [
        "user_id",
        "user_name",
        "auth"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "description": "用户id,需要从IAM服务获取",
          "example": "fb3f175c1fd146ab8cdae3272be6107b"
        },
        "user_name": {
          "type": "string",
          "description": "用户名,需要从IAM服务获取",
          "example": "user01"
        },
        "auth": {
          "type": "integer",
          "format": "int64",
          "enum": [
            7,
            3,
            1
          ],
          "description": "用户权限,7表示管理权限,3表示编辑权限,1表示读取权限",
          "example": 1
        }
      }
    },
    "ShowNamespaceAuthResp": {
      "required": [
        "id",
        "name",
        "creator_name",
        "self_auth",
        "others_auths"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32",
          "description": "id"
        },
        "name": {
          "type": "string",
          "description": "组织名称。小写字母开头,后面跟小写字母、数字、小数点、下划线或中划线(其中下划线最多允许连续两个,小数点、下划线、中划线不能直接相连),小写字母或数字结尾,1-64个字符。"
        },
        "creator_name": {
          "type": "string",
          "description": "组织创建者"
        },
        "self_auth": {
          "description": "本用户权限",
          "$ref": "#/definitions/UserAuth"
        },
        "others_auths": {
          "type": "array",
          "description": "其他用户的权限",
          "items": {
            "$ref": "#/definitions/UserAuth"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "swr-api.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
