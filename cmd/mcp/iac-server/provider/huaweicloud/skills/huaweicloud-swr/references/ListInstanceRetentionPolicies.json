          "type": "integer",
          "description": "命名空间ID"
        },
        "namespace_name": {
          "type": "string",
          "description": "命名空间名"
        }
      }
    },
    "RetentionRuleResponseBody": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "镜像老化策略ID"
        },
        "priority": {
          "type": "integer",
          "description": "预留字段,目前只支持0"
        },
        "disabled": {
          "type": "boolean",
          "description": "是否关闭此条规则"
        },
        "action": {
          "type": "string",
          "description": "预留字段,目前只支持retain"
        },
        "template": {
          "type": "string",
          "description": "规则模板类型,值为:latestPulledN,latestPushedK,nDaysSinceLastPush,nDaysSinceLastPull"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "description": "保留方式的参数,配套template使用,可参考请求示例"
        },
        "tag_selectors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RetentionSelector"
          },
          "description": "制品版本选择器,目前只支持长度为1"
        },
        "scope_selectors": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/RetentionSelector"
            }
          },
          "description": "制品仓库选择器,目前只支持repository且长度为1"
        },
        "repo_scope_mode": {
          "type": "string",
          "description": "repo选择模式,前端使用,可选regular、selection"
        }
      }
    },
    "TriggerSetting": {
      "properties": {
        "cron": {
          "type": "string",
          "description": "定时设置,cron格式描述 '* * * * * *'。cron 基于 UTC 时间。"
        }
      },
      "type": "object"
    },
    "ListRetentionPolicyResponseBody": {
      "required": [
        "total",
        "retentions"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "description": "策略总数"
        },
        "retentions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImageRetention"
          },
          "description": "老化策略详情"
        }
      }
    },
    "RetentionSelector": {
      "type": "object",
      "required": [
        "kind",
        "decoration",
        "pattern"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "匹配类型,目前只支持doublestar"
        },
        "decoration": {
          "type": "string",
          "description": "选择器匹配类型 制品仓库选择器可选repoMatches,repoMatches制品版本可选matches,excludes"
        },
        "pattern": {
          "type": "string",
          "description": "选择器匹配样式,最大长度512。支持正则表达式,正则表达式规则可填写如 nginx-* ,{repo1,repo2} 等,其中:\n* : 匹配不包含 '/' 的任何字段。\n**:匹配包含 '/' 的任何字段。\n? :匹配任何单个非 '/' 的字符。\n{选项1,选项2,...}:同时匹配多个选项。"
        },
        "extras": {
          "type": "string",
          "description": "预留字段"
        }
      }
    },
    "TriggerConfig": {
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "触发类型,老化规则只支持manual(手动)、scheduled(定时+手动);同步策略支持manual(手动)、scheduled(定时+手动)、event_based(事件触发+手动);镜像签名支持manual(手动)、event_based(事件触发+手动)",
          "enum": [
            "manual",
            "scheduled",
            "event_based"
          ]
        },
        "trigger_settings": {
          "$ref": "#/definitions/TriggerSetting",
          "description": "触发设置,只有type为scheduled的时候,才需要设置"
        }
      },
      "type": "object"
    }
