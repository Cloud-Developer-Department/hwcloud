  "definitions": {
    "PageInfo": {
      "properties": {
        "next_marker": {
          "type": "string",
          "description": "下一次分页查询的起始标记。如果未返回该值,则表示数据已查询完毕"
        }
      }
    },
    "GcTask": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "gc任务的ID。"
        },
        "job_name": {
          "type": "string",
          "description": "gc任务的名称。"
        },
        "job_kind": {
          "type": "string",
          "enum": [
            "MANUAL",
            "SCHEDULE"
          ],
          "description": "任务类型,MANUAL:手动执行,SCHEDULE:定时执行。"
        },
        "job_parameters": {
          "$ref": "#/definitions/JobParameters",
          "description": "gc任务的作业参数。"
        },
        "job_status": {
          "type": "string",
          "enum": [
            "Success",
            "Stopped",
            "Running",
            "Pending",
            "Error"
          ],
          "description": "gc任务的状态,Success:已完成,Stopped:已停止,Running:清理中,Pending:排队中,Error:失败。",
          "x-api-type": "open-api"
        },
        "creation_time": {
          "type": "string",
          "description": "gc任务的创建时间。"
        },
        "update_time": {
          "type": "string",
          "description": "gc任务的更新时间。"
        }
      }
    },
    "JobParameters": {
      "allOf": [
        {
          "$ref": "#/definitions/GcParameters"
        },
        {
          "type": "object",
          "properties": {
            "purged_blobs": {
              "type": "integer",
              "description": "清理镜像层的个数。"
            },
            "purged_manifests": {
              "type": "integer",
              "description": "清理镜像manifest的个数。"
            },
            "freed_space": {
              "type": "integer",
              "description": "释放的镜像存储空间大小(单位为字节)。"
            }
          }
        }
      ]
    },
    "GcParameters": {
      "type": "object",
      "required": [
        "workers"
      ],
      "properties": {
        "delete_untagged": {
          "type": "boolean",
          "description": "是否删除无tag的制品;默认为false,不删除无tag的制品。",
          "default": true,
          "x-api-type": "open-api"
        },
        "workers": {
          "type": "integer",
          "description": "并行执行制品清理任务的工作者数量,最小值为1,最大值为5。",
          "minimum": 1,
          "maximum": 5,
          "x-api-type": "open-api",
          "default": 1
        },
        "dry_run": {
          "type": "boolean",
          "description": "是否模拟执行任务;默认值为false,非模拟运行。",
          "x-api-type": "open-api",
          "default": false
        }
      }
    },
    "ListGcTasksResponseBody": {
      "required": [
        "page_info",
        "tasks"
      ],
      "properties": {
        "page_info": {
          "type": "object",
          "$ref": "#/definitions/PageInfo",
          "description": "分页信息"
