  "definitions": {
    "TriggerSetting": {
      "properties": {
        "cron": {
          "type": "string",
          "description": "定时设置,cron格式描述 '* * * * * *'。cron 基于 UTC 时间。"
        }
      },
      "type": "object"
    },
    "Filter": {
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "过滤类型,可选name,tag"
        },
        "value": {
          "type": "string",
          "description": "过滤类型对应的正则表达式(type为name时,对应的是命名空间及制品仓库,例如library/**; type为tag时,对应的是制品版本,例如:**repo和**tag; 正则表达式有多个时,用英文逗号分隔,且在最外层加{},如library/{test,test*,*test})"
        }
      }
    },
    "ReplicationRegistry": {
      "required": [
        "id"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "The registry ID."
        }
      }
    },
    "CreateReplicationPolicyRequestBody": {
      "required": [
        "name",
        "filters",
        "repo_scope_mode",
        "trigger",
        "enabled"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "策略名称, 1-256字符组成,只能包含英文大小写、数字、汉字、中划线和下划线。"
        },
        "description": {
          "type": "string",
          "description": "策略描述"
        },
        "src_registry": {
          "$ref": "#/definitions/ReplicationRegistry",
          "description": "Pull-based时必选,src_registry跟dest_registry必须传一个"
        },
        "dest_registry": {
          "$ref": "#/definitions/ReplicationRegistry",
          "description": "Push-based时必选,src_registry跟dest_registry必须传一个"
        },
        "dest_namespace": {
          "type": "string",
          "description": "目标命名空间名,默认值为空值"
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Filter"
          },
          "description": "过滤器(目前只支持harbor类型的仓库)"
        },
        "repo_scope_mode": {
          "type": "string",
          "description": "repo的选择方式,regular,selection"
        },
        "trigger": {
          "$ref": "#/definitions/TriggerConfig",
          "description": "触发配置"
        },
        "override": {
          "type": "boolean",
          "description": "是否覆盖,默认为false"
        },
        "enabled": {
          "type": "boolean",
          "description": "是否启用,默认为false"
        }
      },
      "type": "object"
    },
    "TriggerConfig": {
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "触发类型,老化规则只支持manual(手动)、scheduled(定时+手动);同步策略支持manual(手动)、scheduled(定时+手动)、event_based(事件触发+手动);镜像签名支持manual(手动)、event_based(事件触发+手动)",
          "enum": [
            "manual",
            "scheduled",
            "event_based"
          ]
        },
        "trigger_settings": {
          "$ref": "#/definitions/TriggerSetting",
          "description": "触发设置,只有type为scheduled的时候,才需要设置"
        }
      },
      "type": "object"
    },
    "CreateReplicationPolicyResponseBody": {
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "description": "命名空间ID"
        }
      }
    }
  },
