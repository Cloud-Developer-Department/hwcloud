{
  "name": "CreateSecret",
  "summary": "生成临时登录指令",
  "tags": "临时登录指令",
  "productshort": "SWR",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/manage/utils/secret": {
      "post": {
        "tags": [
          "临时登录指令"
        ],
        "summary": "生成临时登录指令",
        "operationId": "CreateSecret",
        "description": "调用该接口,通过获取响应消息头的X-Swr-Dockerlogin的值及响应消息体的host值,可生成临时登录指令。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "Content-Type",
            "default": "application/json",
            "in": "header",
            "description": "消息体的类型(格式),下方类型可任选其一使用:\napplication/json;charset=utf-8\napplication/json",
            "required": true,
            "type": "string",
            "enum": [
              "application/json;charset=utf-8",
              "application/json"
            ],
            "x-example": "application/json",
            "x-order": 1
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-order": 2
          },
          {
            "name": "projectname",
            "in": "query",
            "description": "项目名称,缺省值默认为区域名称,例如:cn-north-1。",
            "required": false,
            "type": "string",
            "x-order": 3
          }
        ],
        "responses": {
          "200": {
            "description": "创建成功",
            "headers": {
              "X-Swr-Dockerlogin": {
                "type": "string",
                "description": "docker login登录指令,例如:docker login -u cn-north-1@OW******FPUKBXI -p 6f0779072******863d1ae3ccef921b7f33"
              },
              "X-Swr-Expireat": {
                "type": "string",
                "description": "凭据的过期时间,例如:2025-11-01T12:18:44.382000Z"
              }
            },
            "examples": {
              "application/json": {
                "auths": {
                  "swr.xxx": {
                    "auth": "Y24tbm9ydGg******hhMTgzMGVmN2RhZjJm"
                  }
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateSecretResp"
            }
          },
          "400": {
            "description": "错误的请求"
          },
          "401": {
            "description": "鉴权失败"
          },
          "500": {
            "description": "内部错误"
          }
        },
        "x-name": "生成临时登录指令",
        "x-constraint": "无",
        "x-version": "v1",
        "x-scope": "Commercial",
        "x-request-examples-description-1": "POST https://{endpoint}/v2/manage/utils/secret",
        "x-request-examples-url-1": "POST https://{endpoint}/v2/manage/utils/secret",
        "x-request-examples-1": "",
        "x-request-examples-text-1": "",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "g42,hk_g42,hc,hk,tm",
        "x-apiexplorer-hide": "false",
        "x-publishpath": "swr_02_0052"
      }
    }
  },
  "definitions": {
    "AuthInfo": {
      "required": [
        "auth"
      ],
      "properties": {
        "auth": {
          "type": "string",
          "description": "Base64加密的认证信息"
        }
      }
    },
    "CreateSecretResp": {
      "required": [
        "auths"
      ],
      "properties": {
        "auths": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/AuthInfo"
          },
          "description": "认证信息"
        }
      }
    }
  },
