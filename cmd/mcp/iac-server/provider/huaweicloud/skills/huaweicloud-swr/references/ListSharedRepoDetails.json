      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "仓库ID"
        },
        "name": {
          "type": "string",
          "description": "仓库名称"
        },
        "category": {
          "type": "string",
          "description": "仓库类型(计划改造,每个镜像会有多个lable标示)"
        },
        "description": {
          "type": "string",
          "description": "仓库描述信息"
        },
        "size": {
          "type": "integer",
          "format": "int64",
          "description": "仓库大小"
        },
        "is_public": {
          "type": "boolean",
          "description": "仓库是否为公共仓库,值为true或false"
        },
        "num_images": {
          "type": "integer",
          "format": "int64",
          "description": "仓库中镜像个数,0 ~ 9223372036854775807"
        },
        "num_download": {
          "type": "integer",
          "format": "int64",
          "description": "仓库下载次数"
        },
        "created_at": {
          "type": "string",
          "description": "仓库创建时间,UTC日期格式,时间为UTC标准时间,用户需要根据本地时间计算偏移量;如东8区需要+8:00"
        },
        "updated_at": {
          "type": "string",
          "description": "仓库更新时间,UTC日期格式,时间为UTC标准时间,用户需要根据本地时间计算偏移量;如东8区需要+8:00"
        },
        "domain_name": {
          "type": "string",
          "description": "仓库所属租户"
        },
        "namespace_name": {
          "type": "string",
          "description": "租户的组织名称"
        },
        "status": {
          "type": "boolean",
          "description": "查询他人共享镜像:共享是否过期 查询我共享的镜像:默认为false,无意义"
        }
