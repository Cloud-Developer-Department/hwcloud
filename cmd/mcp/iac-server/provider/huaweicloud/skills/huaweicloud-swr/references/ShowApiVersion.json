  "definitions": {
    "Link": {
      "required": [
        "href",
        "rel"
      ],
      "properties": {
        "href": {
          "type": "string",
          "description": "链接"
        },
        "rel": {
          "type": "string",
          "description": "描述"
        }
      }
    },
    "ShowApiVersionResp": {
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "object",
          "description": "描述version相关对象的列表",
          "$ref": "#/definitions/VersionDetail"
        }
      }
    },
    "VersionDetail": {
      "required": [
        "id",
        "links",
        "version",
        "status",
        "updated",
        "min_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "版本ID(版本号)。",
          "example": "v2"
        },
        "links": {
          "type": "object",
          "$ref": "#/definitions/Link",
          "description": "API的URL地址"
        },
        "version": {
          "type": "string",
          "description": "若该版本API支持微版本,则填支持的最大微版本号,如果不支持微版本,则填空。"
        },
        "status": {
          "type": "string",
          "description": "版本状态,为如下3种:\n\nCURRENT:表示该版本为主推版本;\n\nSUPPORTED:表示为老版本,但是现在还继续支持;\n\nDEPRECATED:表示为废弃版本,存在后续删除的可能。"
        },
        "updated": {
          "type": "string",
          "description": "版本发布时间,要求用UTC时间表示。如v1发布的时间2014-06-28T12:20:21Z。"
        },
        "min_version": {
          "type": "string",
          "description": "若该版本API 支持微版本,则填支持的最小微版本号, 如果不支持微版本,则填空。"
        }
      }
    }
