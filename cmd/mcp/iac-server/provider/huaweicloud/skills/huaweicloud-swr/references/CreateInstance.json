  "definitions": {
    "CreateInstanceResponseBody": {
      "required": [
        "job_id",
        "instance_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID"
        },
        "instance_id": {
          "type": "string",
          "description": "实例ID"
        }
      },
      "type": "object"
    },
    "CreateInstanceRequestBody": {
      "required": [
        "name",
        "spec",
        "vpc_id",
        "subnet_id",
        "project_id",
        "charge_mode",
        "enterprise_project_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "企业仓库实例名称,长度范围为3-48个字符,以小写字母开头,支持小写字母、数字和中划线(-),不能以中划线(-)结尾,中划线不能连续。"
        },
        "description": {
          "type": "string",
          "description": "企业仓库实例描述"
        },
        "spec": {
          "type": "string",
          "description": "企业仓库实例规格,目前支持企业版(swr.ee.professional)",
          "enum": [
            "swr.ee.basic",
            "swr.ee.professional"
          ]
        },
        "vpc_id": {
          "type": "string",
          "description": "用户虚拟私有云ID"
        },
        "subnet_id": {
          "type": "string",
          "description": "用户子网的网络ID"
        },
        "project_id": {
          "type": "string",
          "description": "vpc和子网所在项目编号"
        },
        "charge_mode": {
          "type": "string",
          "description": "实例计费模式,目前只支持按需(postPaid)",
          "enum": [
            "postPaid"
          ]
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目编号"
        },
        "resource_tags": {
          "type": "array",
          "description": "指定资源tag.",
          "items": {
            "properties": {
              "key": {
                "type": "string",
                "description": "tag键值."
              },
              "value": {
                "type": "string",
                "description": "tag值."
              }
            }
          }
        },
        "obs_encrypt": {
          "type": "boolean",
          "description": "obs桶是否开启加密, 如果开启了加密,则可以根据encrypt_type指定加密算法"
        },
        "encrypt_type": {
          "type": "string",
          "description": "obs桶加密类型,空值使用AES-256加密算法, gm为国密加密算法",
          "enum": [
            "gm"
          ]
        },
        "obs_bucket_name": {
          "type": "string",
          "description": "指定obs桶的名称,当指定自定义obs桶之后,则无需对obs_encrypt、encrypt_type进行传值。"
        },
        "enable_intranet_access": {
          "type": "boolean",
          "description": "是否创建内网访问,不传此值,默认会创建内网访问。"
        },
        "obs_enc_kms_key_id": {
          "type": "string",
          "description": "KMS的密钥ID,用于对自动创建的OBS桶进行加密。密钥的加密算法支持AES-256和SM4。指定该字段时必须开启OBS桶加密开关,且不能指定自定义OBS桶。"
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
