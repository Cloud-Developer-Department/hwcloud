  "definitions": {
    "UpdateCVEAllowlistRequest": {
      "type": "object",
      "description": "更新漏洞CVE白名单列表的请求",
      "properties": {
        "id": {
          "type": "integer",
          "description": "白名单ID,查询命名空间信息时,会返回白名单ID"
        },
        "namespace_id": {
          "type": "integer",
          "description": "漏洞白名单列表所属的命名空间ID"
        },
        "expires_at": {
          "type": "integer",
          "description": "漏洞白名单的有效期时间,以自 1970 年 1 月 1 日以来的秒数表示;如果没有配置,则永不过期"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CVEAllowlistItem"
          },
          "description": "漏洞列表,最多支持100条数据,且不能有重复漏洞。"
        }
      }
    },
    "UpdateNamespaceRequestBody": {
      "required": [
        "metadata"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/definitions/NamespaceMetadata",
          "description": "元数据"
        },
        "cve_allowlist": {
          "$ref": "#/definitions/UpdateCVEAllowlistRequest",
          "description": "漏洞白名单"
        }
      },
      "type": "object"
    },
    "CVEAllowlistItem": {
      "type": "object",
      "description": "CVE漏洞列表",
      "properties": {
        "cve_id": {
          "type": "string",
          "description": "CVE的ID, 比如:CVE-2019-10164"
        }
      }
    },
    "NamespaceMetadata": {
      "required": [
        "public"
      ],
      "properties": {
        "public": {
          "type": "string",
          "description": "是否公开,可选true、false",
          "enum": [
            "true",
            "false"
          ]
        },
        "auto_scan": {
          "type": "string",
          "description": "上传制品时,是否自动触发制品扫描,可选true、false",
          "enum": [
            "true",
            "false"
          ],
          "x-api-type": "open-api"
        },
        "prevent_vul": {
          "type": "string",
          "description": "是否开启制品阻断,可选true、false",
          "enum": [
            "true",
            "false"
          ],
          "x-api-type": "open-api"
        },
        "severity": {
          "type": "string",
          "description": "阻断开启的场景下,如果存在漏洞,并且存在的漏洞严重程度高于此处定义的级别,则无法拉取镜像。可选值为\"none\", \"low\", \"medium\", \"high\", \"critical\"。",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "x-api-type": "open-api"
        }
      },
      "type": "object"
    },
