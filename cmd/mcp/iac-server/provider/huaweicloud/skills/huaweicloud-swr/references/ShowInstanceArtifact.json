  "definitions": {
    "NativeReportSummary": {
      "type": "object",
      "description": "云原生制品扫描报告摘要",
      "properties": {
        "report_id": {
          "type": "string",
          "description": "报告ID"
        },
        "scan_status": {
          "type": "string",
          "description": "制品扫描状态,Pending(扫描等待中)、Running(扫描中)、Error(扫描失败)、Success(扫描成功)",
          "enum": [
            "Success",
            "Error",
            "Running",
            "Pending"
          ]
        },
        "severity": {
          "type": "string",
          "description": "制品扫描报告的总体严重程度,None(无评分), Low(低危), Medium(中危), High(高危), Critical(严重), Security(安全)",
          "enum": [
            "None",
            "Low",
            "Medium",
            "High",
            "Critical",
            "Security"
          ]
        },
        "duration": {
          "type": "integer",
          "description": "生成报告所花费的秒数时间"
        },
        "summary": {
          "description": "漏洞信息摘要",
          "$ref": "#/definitions/VulnerabilitySummary"
        },
        "start_time": {
          "type": "string",
          "description": "生成报告的扫描进程的开始时间"
        },
        "end_time": {
          "type": "string",
          "description": "生成报告的扫描进程的结束时间"
        },
        "complete_percent": {
          "type": "integer",
          "description": "扫描的完成百分比,该值介于0和100之间"
        },
        "scanner": {
          "description": "扫描器的信息",
          "$ref": "#/definitions/Scanner"
        }
      }
    },
    "Artifact": {
      "properties": {
        "digest": {
          "type": "string",
          "description": "制品摘要"
        },
        "id": {
          "type": "integer",
          "description": "制品ID"
        },
        "repository_id": {
          "type": "integer",
          "description": "仓库ID"
        },
        "repository_name": {
          "type": "string",
          "description": "仓库名称"
        },
        "type": {
          "type": "string",
          "description": "制品类型"
        },
        "namespace_id": {
          "type": "integer",
          "description": "命名空间ID"
        },
        "media_type": {
          "type": "string",
          "description": "制品MIME类型"
        },
        "manifest_media_type": {
          "type": "string",
          "description": "制品元数据MIME类型"
        },
        "pull_time": {
          "type": "string",
          "description": "最近一次拉取时间"
        },
        "push_time": {
          "type": "string",
          "description": "最近一次上传时间"
        },
        "size": {
          "type": "integer",
          "format": "int64",
          "description": "制品大小,单位:Byte"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactTag"
          },
          "description": "制品版本的Tag列表"
        }
      },
      "type": "object"
    },
    "ArtifactTag": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Tag ID"
        },
        "repository_id": {
          "type": "integer",
          "format": "int64",
          "description": "制品仓库ID"
        },
        "artifact_id": {
          "type": "integer",
          "format": "int64",
          "description": "制品版本ID"
        },
        "name": {
          "type": "string",
          "description": "tag名称"
        },
        "push_time": {
          "type": "string",
          "description": "tag的上传时间"
        },
        "pull_time": {
          "type": "string",
          "description": "tag的下载时间"
        }
      }
    },
    "Scanner": {
      "type": "object",
      "description": "漏洞扫描器",
      "properties": {
        "name": {
          "type": "string",
          "description": "扫描器的名称"
        },
        "vendor": {
          "type": "string",
          "description": "扫描器的提供商"
        },
        "version": {
          "type": "string",
          "description": "扫描器的版本号"
        }
      }
    },
    "VulnerabilitySummary": {
      "type": "object",
      "description": "漏洞信息摘要",
      "properties": {
        "total": {
          "type": "integer",
          "description": "发现的漏洞总数"
        },
        "fixable": {
          "type": "integer",
          "description": "可修复漏洞的数量"
        },
        "summary": {
          "type": "object",
          "description": "不同级别的漏洞数量",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "ScanOverview": {
      "type": "object",
      "description": "制品扫描摘要,支持制品扫描报告类型为application/vnd.security.vulnerability.report; version=1.1的制品扫描摘要",
      "additionalProperties": {
        "$ref": "#/definitions/NativeReportSummary"
      }
    },
    "ArtifactWithScanOverview": {
      "allOf": [
        {
          "$ref": "#/definitions/Artifact"
        },
        {
          "type": "object",
          "properties": {
            "scan_overview": {
              "$ref": "#/definitions/ScanOverview",
              "description": "制品扫描摘要"
            }
          }
        }
      ],
      "type": "object"
    }
  },
