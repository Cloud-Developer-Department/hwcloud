  "definitions": {
    "ListResourceInstancesRequestBody": {
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TagsFilter"
          },
          "description": "包含标签,最多包含50个key,每个key下面的value最多10个,每个key对应的value可以为空数组但结构体不能缺失。Key不能重复,同一个key中values不能重复。结果返回包含所有标签的资源列表,key之间是与的关系,key-value结构中value是或的关系。无tag过滤条件时返回全量数据。"
        }
      }
    },
    "ResourceTag": {
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "标签键,最大长度128个unicode字符。"
        },
        "value": {
          "type": "string",
          "description": "标签值,每个值最大长度255个unicode字符。"
        }
      }
    },
    "Resource": {
      "properties": {
        "resource_id": {
          "type": "string",
          "description": "资源id"
        },
        "resource_detail": {
          "type": "object",
          "additionalProperties": true,
          "description": "资源详情"
        },
        "resource_name": {
          "type": "string",
          "description": "资源名称"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceTag"
          },
          "description": "资源标签列表"
        },
        "sys_tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceTag"
          },
          "description": "-| 系统标签列表。仅op_service权限才可以可以获取此字段:目前只包含一个resource_tag 结构体key:_sys_enterprise_project_idvalue:企业项目id,0表示默认企业项目非op_service场景不能返回此字段。"
        }
      }
    },
    "ListResourceInstancesResponseBody": {
      "required": [
        "resources",
        "total_count"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Resource"
          },
          "description": "资源列表"
        },
        "total_count": {
          "type": "integer",
          "description": "资源数量"
        }
      }
    },
    "TagsFilter": {
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "标签键,最大长度128个unicode字符。 key不能为空。"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "标签值列表,每个值最大长度255个unicode字符,校验和使用之前先trim 前后半角空格。value可为空数组但不可缺省。如果values为空列表,则表示any_value(查询任意value)。value之间为或的关系。。"
        }
      }
    }
