  "definitions": {
    "TriggerSetting": {
      "properties": {
        "cron": {
          "type": "string",
          "description": "定时设置,cron格式描述 '* * * * * *'。cron 基于 UTC 时间。"
        }
      },
      "type": "object"
    },
    "SignScopeRule": {
      "required": [
        "tag_selectors",
        "scope_selectors",
        "repo_scope_mode"
      ],
      "properties": {
        "tag_selectors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SignRuleSelector"
          },
          "description": "制品版本选择器,目前只支持长度为1"
        },
        "scope_selectors": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/SignRuleSelector"
            }
          },
          "description": "制品仓库选择器,目前只支持repository且长度为1"
        },
        "repo_scope_mode": {
          "type": "string",
          "description": "repository选择方式。可选regular、selection,前端显示需要,api调用时可选regular"
        }
      }
    },
    "TriggerConfig": {
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "触发类型,老化规则只支持manual(手动)、scheduled(定时+手动);同步策略支持manual(手动)、scheduled(定时+手动)、event_based(事件触发+手动);镜像签名支持manual(手动)、event_based(事件触发+手动)",
          "enum": [
            "manual",
            "scheduled",
            "event_based"
          ]
        },
        "trigger_settings": {
          "$ref": "#/definitions/TriggerSetting",
          "description": "触发设置,只有type为scheduled的时候,才需要设置"
        }
      },
      "type": "object"
    },
    "SignRuleSelector": {
      "required": [
        "kind",
        "decoration",
        "pattern"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "匹配类型,目前只支持doublestar"
        },
        "decoration": {
          "type": "string",
          "description": "选择器匹配类型,当前支持repoMatches"
        },
        "pattern": {
          "type": "string",
          "description": "选择器匹配样式,最大长度512。支持正则表达式,正则表达式规则可填写如 nginx-* ,{repo1,repo2} 等,其中:\n* : 匹配不包含 '/' 的任何字段。\n**:匹配包含 '/' 的任何字段。\n? :匹配任何单个非 '/' 的字符。\n{选项1,选项2,...}:同时匹配多个选项。"
        },
        "extras": {
          "type": "string",
          "description": "预留字段,镜像签名策略中,对无版本的制品进行签名则传入{\"untagged\":true}"
        }
      }
    },
    "SignPolicyDetail": {
      "properties": {
        "id": {
          "type": "integer",
          "description": "签名策略ID"
        },
        "name": {
          "type": "string",
          "description": "签名策略名称"
        },
        "description": {
          "type": "string",
          "description": "签名策略描述"
        },
        "namespace_id": {
          "type": "integer",
          "description": "命名空间ID"
        },
        "namespace_name": {
          "type": "string",
          "description": "命名空间名"
        },
        "trigger": {
          "type": "object",
          "$ref": "#/definitions/TriggerConfig",
          "description": "触发方式"
        },
        "creator": {
          "type": "string",
          "description": "创建者"
        },
        "enabled": {
          "type": "boolean",
          "description": "是否"
        },
        "scope_rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SignScopeRule"
          },
          "description": "作用范围规则"
        },
        "created_at": {
          "type": "string",
          "description": "创建时间"
        },
        "updated_at": {
          "type": "string",
          "description": "更新时间"
        },
        "signature_algorithm": {
          "type": "string",
          "description": "加签算法,KMS的密钥算法EC_P256对应着ECDSA_SHA_256,EC_P384对应着ECDSA_SHA_384,SM2对应着SM2DSA_SM3"
        },
        "signature_key": {
          "type": "string",
          "description": "签名算法key ID"
        },
        "signature_method": {
          "type": "string",
          "description": "镜像签名方式"
        }
      }
    }
  },
