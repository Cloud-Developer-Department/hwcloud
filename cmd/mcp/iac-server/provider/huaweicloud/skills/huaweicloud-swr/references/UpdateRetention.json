  "definitions": {
    "UpdateRetentionRequestBody": {
      "required": [
        "rules",
        "algorithm"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "description": "老化规则匹配策略,固定为\"or\""
        },
        "rules": {
          "type": "array",
          "description": "镜像老化规则",
          "items": {
            "$ref": "#/definitions/Rule"
          }
        }
      },
      "example": {
        "algorithm": "or",
        "rules": [
          {
            "params": {
              "days": "30"
            },
            "tag_selectors": [
              {
                "kind": "label",
                "pattern": "v5"
              },
              {
                "kind": "label",
                "pattern": "1.0.1"
              },
              {
                "kind": "regexp",
                "pattern": "^123$"
              }
            ],
            "template": "date_rule"
          }
        ]
      }
    },
    "Rule": {
      "required": [
        "params",
        "tag_selectors",
        "template"
      ],
      "properties": {
        "template": {
          "type": "string",
          "enum": [
            "date_rule",
            "tag_rule"
          ],
          "description": "回收类型,date_rule、tag_rule"
        },
        "params": {
          "type": "object",
          "description": "template是date_rule时,设置params为{\"days\": \"xxx\"}\ntemplate是tag_rule时,设置params为{\"num\": \"xxx\"}"
        },
        "tag_selectors": {
          "type": "array",
          "description": "例外镜像",
          "items": {
            "$ref": "#/definitions/TagSelector"
          }
        }
      }
    },
    "TagSelector": {
      "required": [
        "kind",
        "pattern"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "匹配规则,label、regexp"
        },
        "pattern": {
          "type": "string",
          "description": "kind是label时,设置为镜像版本,kind是regexp时,设置为正则表达式"
        }
      }
    }
