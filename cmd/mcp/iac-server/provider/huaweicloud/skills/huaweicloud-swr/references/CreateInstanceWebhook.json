  "definitions": {
    "ScopeRule": {
      "required": [
        "tag_selectors",
        "scope_selectors",
        "repo_scope_mode"
      ],
      "properties": {
        "tag_selectors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RuleSelector"
          },
          "description": "制品版本选择器,目前只支持长度为1"
        },
        "scope_selectors": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/RuleSelector"
            }
          },
          "description": "制品仓库选择器,目前只支持repository且长度为1"
        },
        "repo_scope_mode": {
          "type": "string",
          "description": "repository选择方式。可选regular、selection,前端显示需要,api调用时可选regular"
        }
      }
    },
    "Target": {
      "properties": {
        "type": {
          "type": "string",
          "description": "触发类型,可选http"
        },
        "address": {
          "type": "string",
          "description": "触发地址,不可修改"
        },
        "auth_header": {
          "type": "string",
          "description": "请求头,格式为key1:value1;key2:value2"
        },
        "skip_cert_verify": {
          "type": "boolean",
          "description": "是否跳过证书认证"
        },
        "address_type": {
          "type": "string",
          "description": "触发地址类型,可选internal(内网),internet(公网)。internal必须为内网ip形式。"
        }
      },
      "type": "object",
      "required": [
        "type",
        "address",
        "address_type"
      ]
    },
    "CreateWebhookPolicyRequestBody": {
      "required": [
        "name",
        "targets",
        "scope_rules",
        "enabled",
        "event_types"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "触发器名称,由字母、汉字、数字、下划线(_)、中划线 (-)组成,1-256个字符。"
        },
        "description": {
          "type": "string",
          "description": "触发器描述"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Target"
          },
          "description": "触发器目标参数"
        },
        "scope_rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ScopeRule"
          },
          "description": "作用范围规则"
        },
        "event_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "触发器触发条件,当前支持PUSH_ARTIFACT"
        },
        "enabled": {
          "type": "boolean",
          "description": "是否启用"
        }
      },
      "type": "object"
    },
    "RuleSelector": {
      "required": [
        "kind",
        "decoration",
        "pattern"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "匹配类型,目前只支持doublestar"
        },
        "decoration": {
          "type": "string",
          "description": "选择器匹配类型,当前支持repoMatches"
        },
        "pattern": {
          "type": "string",
          "description": "选择器匹配样式,最大长度512。支持正则表达式,正则表达式规则可填写如 nginx-* ,{repo1,repo2} 等,其中:\n* : 匹配不包含 '/' 的任何字段。\n**:匹配包含 '/' 的任何字段。\n? :匹配任何单个非 '/' 的字符。\n{选项1,选项2,...}:同时匹配多个选项。"
        },
        "extras": {
          "type": "string",
          "description": "预留字段"
        }
      }
    },
    "CreateWebhookPolicyResponseBody": {
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "description": "触发器ID"
        }
      }
    }
