{
  "name": "ListNamespaces",
  "summary": "查询组织列表",
  "tags": "组织管理",
  "productshort": "SWR",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/manage/namespaces": {
      "get": {
        "tags": [
          "组织管理"
        ],
        "summary": "查询组织列表",
        "description": "查询组织列表",
        "operationId": "ListNamespaces",
        "parameters": [
          {
            "name": "Content-Type",
            "default": "application/json",
            "in": "header",
            "description": "消息体的类型(格式),下方类型可任选其一使用:\napplication/json;charset=utf-8\napplication/json",
            "required": true,
            "type": "string",
            "enum": [
              "application/json;charset=utf-8",
              "application/json"
            ],
            "x-example": "application/json",
            "x-order": 1
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-order": 2
          },
          {
            "name": "namespace",
            "in": "query",
            "description": "组织名称。小写字母开头,后面跟小写字母、数字、小数点、下划线或中划线(其中下划线最多允许连续两个,小数点、下划线、中划线不能直接相连),小写字母或数字结尾,1-64个字符。",
            "required": false,
            "type": "string",
            "x-example": "huawei",
            "x-order": 3
          },
          {
            "name": "filter",
            "in": "query",
            "description": "应填写namespace::{namespace}|mode::{mode}。其中{namespace}是组织名称,{mode}如果不设置,查看有权限的组织列表;设置为visible,查看可见的组织列表(部分组织:仓库有权限,组织没有权限)。",
            "required": false,
            "type": "string",
            "x-example": "huawei",
            "x-order": 4
          }
        ],
        "responses": {
          "200": {
            "description": "获取组织列表成功",
            "schema": {
              "$ref": "#/definitions/ShowNamespaces"
            },
            "examples": {
              "application/json": {
                "namespaces": [
                  {
                    "id": 1422,
                    "name": "group",
                    "creator_name": "username",
                    "auth": 7
                  }
                ]
              }
            }
          },
          "400": {
            "description": "错误的请求"
          },
          "401": {
            "description": "鉴权失败"
          },
          "404": {
            "description": "组织不存在"
          },
          "500": {
            "description": "内部错误"
          }
        },
        "x-name": "获取组织列表",
        "x-constraint": "无",
        "x-version": "v1",
        "x-scope": "Commercial",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v2/manage/namespaces?filter=namespace::{namespace}",
        "x-request-examples-1": "",
        "x-request-examples-text-1": "",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "false",
        "x-publishpath": "swr_02_0028"
      }
    }
  },
  "definitions": {
    "ShowNamespaces": {
      "required": [
        "namespaces"
      ],
      "properties": {
        "namespaces": {
          "type": "array",
          "description": "组织列表",
          "items": {
            "$ref": "#/definitions/ShowNamespace"
          }
        }
      }
    },
    "ShowNamespace": {
      "required": [
        "id",
        "name",
        "creator_name",
        "auth"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32",
          "example": 1422,
          "description": "id"
        },
        "name": {
          "type": "string",
          "example": "group",
          "description": "组织名称。小写字母开头,后面跟小写字母、数字、小数点、下划线或中划线(其中下划线最多允许连续两个,小数点、下划线、中划线不能直接相连),小写字母或数字结尾,1-64个字符。"
        },
        "creator_name": {
          "type": "string",
          "example": "username",
          "description": "IAM用户名"
        },
        "auth": {
          "type": "integer",
          "format": "int32",
          "enum": [
            7,
            3,
            1
          ],
          "example": 7,
          "description": "用户权限。7表示管理权限,3表示编辑权限,1表示读取权限。"
        }
      }
    }
  },
  "version": "2.0",
