{
  "name": "ListReposDetails",
  "summary": "查询镜像仓库列表",
  "tags": "镜像仓库管理",
  "productshort": "SWR",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/manage/repos": {
      "get": {
        "tags": [
          "镜像仓库管理"
        ],
        "summary": "查询镜像仓库列表",
        "description": "查询镜像仓库列表",
        "operationId": "ListReposDetails",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "Content-Type",
            "default": "application/json",
            "in": "header",
            "description": "消息体的类型(格式),下方类型可任选其一使用:\napplication/json;charset=utf-8\napplication/json",
            "required": true,
            "type": "string",
            "enum": [
              "application/json;charset=utf-8",
              "application/json"
            ],
            "x-example": "application/json",
            "x-order": 1
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-order": 2
          },
          {
            "name": "namespace",
            "in": "query",
            "description": "组织名称。小写字母开头,后面跟小写字母、数字、小数点、下划线或中划线(其中下划线最多允许连续两个,小数点、下划线、中划线不能直接相连),小写字母或数字结尾,1-64个字符。注意:和filter最好分开使用,如果同时使用,此过滤参数将失效,以filter为准。",
            "required": false,
            "type": "string",
            "x-example": "huawei123113",
            "x-order": 3
          },
          {
            "name": "name",
            "in": "query",
            "description": "镜像仓库名称。注意:和filter最好分开使用,如果同时使用,此过滤参数将失效,以filter为准。",
            "required": false,
            "type": "string",
            "x-example": "test_repo",
            "x-order": 4
          },
          {
            "name": "category",
            "in": "query",
            "description": "镜像仓库分类,可设置为app_server, linux, framework_app, database, lang, other, windows, arm。注意:和filter最好分开使用,如果同时使用,此过滤参数将失效,以filter为准。",
            "required": false,
            "type": "string",
            "x-example": "linux",
            "x-order": 5
          },
          {
            "name": "limit",
            "in": "query",
            "description": "返回条数,默认情况下返回100条记录,最多返回1000条记录。注意:offset和limit参数需要配套使用。",
            "required": false,
            "type": "string",
            "x-example": "1",
            "x-order": 6
          },
          {
            "name": "offset",
            "in": "query",
            "description": "起始索引。注意:offset和limit参数需要配套使用。",
            "required": false,
            "type": "string",
            "x-example": "1",
            "x-order": 7
          },
          {
            "name": "order_column",
            "in": "query",
            "description": "按列排序,可设置为updated_at(按更新时间排序)。注意:order_column和order_type参数需要配套使用。",
            "required": false,
            "type": "string",
            "x-example": "updated_time",
            "x-order": 8
          },
          {
            "name": "order_type",
            "in": "query",
            "description": "排序类型,可设置为desc(降序)、asc(升序)。注意:order_column和order_type参数需要配套使用。",
            "required": false,
            "type": "string",
            "x-example": "asc",
            "x-order": 9
          },
          {
            "name": "filter",
            "in": "query",
            "description": "注意:如果使用filter至少要传递一个filter参数。应填写 namespace::{namespace}|name::{name}|limit::{limit}|offset::{offset}|order_column::{order_column}|order_type::{order_type},其中{namespace}为组织名称。\n{name}为镜像仓库名称,模糊匹配。{category}为镜像仓库分类,可设置为app_server、linux、framework_app、database、lang、other、windows、arm。\n{limit}为返回条数,{offset}为起始索引,注意:offset和limit参数需要配套使用。{order_column}为按列排序,可设置为name、updated_time、tag_count,{order_type}为排序类型,\n可设置为desc(降序)、asc(升序),注意:order_column和order_type参数需要配套使用。",
            "required": false,
            "type": "string",
            "x-order": 10
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "headers": {
              "Content-Range": {
                "type": "string",
                "description": "offset(开始索引)-count(当前页记录条数)/total(总记录条数)"
              }
            },
            "examples": {
              "application/json": [
                {
                  "name": "nginx",
                  "category": "linux",
                  "size": 200977474,
                  "is_public": false,
                  "num_images": 2,
                  "num_download": 0,
                  "created_at": "2017-01-01T00:00:00Z",
                  "updated_at": "2017-09-11T03:00:02.542841141Z",
                  "url": "",
                  "path": "swr.cn-north-1.myhuaweicloud.com/namespace/repository",
                  "internal_path": "10.125.0.198:20202/namespace/repository",
                  "domain_name": "root",
                  "namespace": "root",
                  "tags": [
                    "latest",
                    "log"
                  ],
                  "status": "false \"total_ranage\"  4"
                }
              ]
            },
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ShowReposResp"
              }
            }
          },
          "400": {
            "description": "错误的请求"
          },
          "401": {
            "description": "鉴权失败"
          },
          "500": {
            "description": "内部错误"
          }
        },
        "x-name": "查询镜像仓库列表",
        "x-constraint": "无",
        "x-version": "v1",
        "x-scope": "Commercial",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "",
        "x-request-examples-1": "GET https://{endpoint}/v2/manage/repos",
        "x-request-examples-text-1": "GET https://{endpoint}/v2/manage/repos",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "false",
        "x-publishpath": "swr_02_0034"
      }
    }
  },
  "definitions": {
    "ShowReposResp": {
      "required": [
        "name",
        "category",
        "description",
        "size",
        "is_public",
        "num_images",
        "num_download",
        "created_at",
        "updated_at",
        "logo",
        "url",
        "path",
        "internal_path",
        "domain_name",
        "namespace",
        "tags",
        "status",
        "total_range"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "仓库名称"
        },
        "category": {
          "type": "string",
          "description": "仓库类型(计划改造,每个镜像会有多个lable标示)"
        },
        "description": {
          "type": "string",
          "description": "仓库描述信息"
        },
        "size": {
          "type": "integer",
          "format": "int64",
          "description": "仓库大小"
        },
        "is_public": {
          "type": "boolean",
          "description": "仓库是否为公共仓库,值为true或false"
        },
        "num_images": {
          "type": "integer",
          "format": "int64",
          "description": "仓库中镜像个数,0 ~ 9223372036854775807"
        },
        "num_download": {
          "type": "integer",
          "format": "int64",
          "description": "仓库下载次数"
        },
        "created_at": {
          "type": "string",
          "description": "仓库创建时间,UTC日期格式,时间为UTC标准时间,用户需要根据本地时间计算偏移量;如东8区需要+8:00"
        },
        "updated_at": {
          "type": "string",
          "description": "仓库更新时间,UTC日期格式,时间为UTC标准时间,用户需要根据本地时间计算偏移量;如东8区需要+8:00"
        },
        "logo": {
          "type": "string",
          "description": "仓库logo地址(暂时未用)"
        },
        "url": {
          "type": "string",
          "description": "仓库logo图片的URL,URL格式。(暂时未用)"
        },
        "path": {
          "type": "string",
          "description": "镜像pull路径,格式为 swr.cn-north-1.myhuaweicloud.com/namespace/repository"
        },
        "internal_path": {
          "type": "string",
          "description": "镜像pull路径,格式为 10.125.0.198:20202/namespace/repository"
        },
        "domain_name": {
          "type": "string",
          "description": "租户名"
        },
        "namespace": {
          "type": "string",
          "description": "租户的组织名称"
        },
        "tags": {
          "type": "array",
          "description": "镜像版本列表",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "boolean",
          "description": "查询他人共享镜像:共享是否过期 查询我共享的镜像:默认为false,无意义"
        },
        "total_range": {
          "type": "integer",
          "format": "int64",
          "description": "总记录条数"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
