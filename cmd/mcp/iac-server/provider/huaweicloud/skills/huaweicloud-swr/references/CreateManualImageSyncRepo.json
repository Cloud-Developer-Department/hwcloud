{
  "name": "CreateManualImageSyncRepo",
  "summary": "手动同步镜像",
  "tags": "镜像同步管理",
  "productshort": "SWR",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/manage/namespaces/{namespace}/repos/{repository}/sync_images": {
      "post": {
        "tags": [
          "镜像同步管理"
        ],
        "summary": "手动同步镜像",
        "operationId": "CreateManualImageSyncRepo",
        "description": "对于镜像仓库已有的镜像,如果想在其他区域使用,需要手动触发镜像同步。 判断是否同步成功的方法如下:响应状态码为200,无报错信息,表示同步成功。通过SWR管理控制台或调用查询镜像仓库概要信息接口,在目标区域的目标组织下,若存在所同步的镜像版本表示同步成功。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "Content-Type",
            "default": "application/json",
            "in": "header",
            "description": "消息体的类型(格式),下方类型可任选其一使用:\napplication/json;charset=utf-8\napplication/json",
            "required": true,
            "type": "string",
            "enum": [
              "application/json;charset=utf-8",
              "application/json"
            ],
            "x-example": "application/json",
            "x-order": 1
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-order": 2
          },
          {
            "name": "namespace",
            "in": "path",
            "description": "组织名称。小写字母开头,后面跟小写字母、数字、小数点、下划线或中划线(其中下划线最多允许连续两个,小数点、下划线、中划线不能直接相连),小写字母或数字结尾,1-64个字符。",
            "required": true,
            "type": "string",
            "x-example": "huawei",
            "x-order": 3
          },
          {
            "name": "repository",
            "in": "path",
            "description": "镜像仓库名称",
            "required": true,
            "type": "string",
            "x-example": "test_repo",
            "x-order": 4
          },
          {
            "in": "body",
            "name": "body",
            "description": "需要手动同步镜像的信息",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateManualImageSyncRepoRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "examples": {
              "application/json": []
            }
          },
          "400": {
            "description": "错误的请求"
          },
          "401": {
            "description": "鉴权失败"
          },
          "404": {
            "description": "组织或镜像仓库不存在"
          },
          "500": {
            "description": "内部错误"
          },
          "default": {
            "description": "失败的版本",
            "schema": {
              "$ref": "#/definitions/FailSyncImages"
            }
          }
        },
        "x-name": "手动同步镜像",
        "x-constraint": "无",
        "x-version": "v1",
        "x-scope": "Commercial",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "POST https://{endpoint}/v2/manage/namespaces/{namespace}/repos/{repository}/sync_images",
        "x-request-examples-1": {
          "imageTag": [
            "V1"
          ],
          "override": true,
          "remoteNamespace": "sdsad",
          "remoteRegionId": "cn-north-208"
        },
        "x-request-examples-text-1": "{ \"imageTag\": [ \"V1\" ], \"override\": true, \"remoteNamespace\": \"sdsad\", \"remoteRegionId\": \"cn-north-208\"}",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc,hk",
        "x-apiexplorer-hide": "false",
        "x-publishpath": "swr_02_0014"
      }
    }
  },
  "definitions": {
    "FailSyncImages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ImageTag"
      },
      "description": "失败的版本"
    },
    "ImageTag": {
      "type": "string",
      "description": "版本"
    },
    "CreateManualImageSyncRepoRequestBody": {
      "required": [
        "imageTag",
        "remoteNamespace",
        "remoteRegionId"
      ],
      "properties": {
        "imageTag": {
          "type": "array",
          "description": "版本列表",
          "items": {
            "type": "string",
            "description": "版本"
          }
        },
        "override": {
          "type": "boolean",
          "description": "是否覆盖,默认为false"
        },
        "remoteNamespace": {
          "type": "string",
          "description": "目标组织"
        },
        "remoteRegionId": {
          "type": "string",
          "description": "目标region ID。"
        }
      },
      "description": "手动同步镜像需要的参数",
      "example": {
        "imageTag": [
          "V1"
        ],
        "override": true,
        "remoteNamespace": "sdsad",
        "remoteRegionId": "cn-north-208"
      }
    }
  },
  "version": "2.0",
  "parameters": {},
