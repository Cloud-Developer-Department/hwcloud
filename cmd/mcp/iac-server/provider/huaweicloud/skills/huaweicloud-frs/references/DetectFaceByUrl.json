  "definitions": {
    "DetectFace": {
      "properties": {
        "bounding_box": {
          "description": "人脸在图像中的位置。",
          "$ref": "#/definitions/BoundingBox",
          "type": "object"
        },
        "attributes": {
          "x-open-region-cloud": "hc",
          "description": "人脸关键属性,比如性别、年龄、头部姿态等。",
          "$ref": "#/definitions/Attributes",
          "type": "object"
        }
      },
      "required": [
        "bounding_box"
      ]
    },
    "ErrorResp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参考[错误码](https://support.huaweicloud.com/api-face/face_02_0045.html)。调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      }
    },
    "FaceDetectResp": {
      "properties": {
        "faces": {
          "description": "检测到的人脸。\n调用失败时无此字段。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/DetectFace",
            "type": "object"
          }
        }
      },
      "required": [
        "faces"
      ]
    },
    "FaceDetectUrlReq": {
      "properties": {
        "image_url": {
          "description": "图片的URL路径,目前仅支持华为云上OBS的URL,且人脸识别服务有权限读取该OBS桶的数据。开通读取权限的操作请参见[服务授权](https://support.huaweicloud.com/api-face/face_02_0006.html)。",
          "type": "string"
        },
        "attributes": {
          "x-open-region-cloud": "hc",
          "description": "是否返回人脸属性,希望获取的属性列表,多个属性间使用逗号(,)隔开。目前支持的属性有:\n  • 1:性别\n  • 2:年龄\n  • 4:装束(帽子、眼镜)\n  • 6:口罩\n  • 7:发型\n  • 8:胡须\n  • 11:图片类型\n  • 12:质量\n  • 13:表情\n  • 21:人脸图片旋转角(顺时针偏转角度),支持0°、90°、180°和270°图片旋转",
          "type": "string"
        }
      },
      "required": [
        "image_url"
      ]
    },
    "BoundingBox": {
      "properties": {
        "width": {
          "description": "矩形框宽度。",
          "type": "integer",
          "format": "int32"
        },
        "top_left_y": {
          "description": "矩形框左上角纵坐标。",
          "type": "integer",
          "format": "int32"
        },
        "top_left_x": {
          "description": "矩形框左上角横坐标。",
          "type": "integer",
          "format": "int32"
        },
        "height": {
          "description": "矩形框高度。",
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "top_left_x",
        "top_left_y",
        "width",
        "height"
      ]
    },
    "Dress": {
      "properties": {
        "glass": {
          "description": "是否带眼镜:\n• yes:带眼镜\n• dark:带墨镜\n• none:未戴眼镜\n• unknown:未知",
          "type": "string"
        },
        "hat": {
          "description": "是否戴帽子:\n• yes:戴帽子\n• none:未戴帽子\n• unknown:未知",
          "type": "string"
        }
      }
    },
    "FaceQuality": {
      "properties": {
        "total_score": {
          "description": "人脸质量总分,取值范围[0-1],分值越大质量越高。",
          "type": "number",
          "format": "double"
        },
        "blur": {
          "description": "模糊度,取值范围[0-1],分值越大模糊问题越严重。",
          "type": "number",
          "format": "double"
        },
        "pose": {
          "description": "姿态,取值范围[0-1],分值越大姿态问题越严重。",
          "type": "number",
          "format": "double"
        },
        "occlusion": {
          "description": "遮挡,取值范围[0-1],分值越大遮挡问题越严重。",
          "type": "number",
          "format": "double"
        },
        "illumination": {
          "description": "光照,取值范围[0-1],分值越大光照问题越严重。",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "total_score",
        "blur",
        "pose",
        "occlusion",
        "illumination"
      ]
    },
    "Attributes": {
      "properties": {
        "gender": {
          "description": "性别:\n• male:男性\n• female:女性",
          "type": "string"
        },
        "dress": {
          "description": "包含glass和hat两个属性结果。",
          "$ref": "#/definitions/Dress"
        },
        "glass": {
          "description": "是否带眼镜:\n• yes:带眼镜\n• dark:带墨镜\n• none:未戴眼镜\n• unknown:未知",
          "type": "string"
        },
        "hat": {
          "description": "是否戴帽子:\n• yes:戴帽子\n• none:未戴帽子\n• unknown:未知",
          "type": "string"
        },
        "age": {
          "description": "年龄。",
          "type": "integer",
          "format": "int32"
        },
        "mask": {
          "description": "是否戴口罩:\n• yes:戴口罩\n• none:未戴口罩\n• unknown:未知",
          "type": "string"
        },
        "beard": {
          "description": "胡须:\n• yes:有胡须\n• none:无胡须\n• unknown:未知",
          "type": "string"
        },
        "phototype": {
          "description": "图片类型:\n• idcard:证件照\n• monitor:摄像头监控\n• internet photo:网络图片",
          "type": "string"
        },
        "quality": {
          "description": "图片中人脸的遮挡度、模糊度、光照强度、姿态角度。",
          "$ref": "#/definitions/FaceQuality",
          "type": "object"
        },
        "hair": {
          "description": "发型:\n• long:长发\n• short:短发\n• unknown:未知",
          "type": "string"
        },
        "expression": {
          "description": "人脸表情,包括中性、高兴、害怕、惊讶、伤心、生气、厌恶。",
          "properties": {
            "type": {
              "description": "人脸表情类型:\n• neutral:中性\n• happy:高兴\n• fear:害怕\n• surprise:惊讶\n• sad:伤心\n• angry:生气\n• disgust:厌恶\n• unknown:图片质量问题导致未识别",
              "type": "string"
            },
            "probability": {
              "description": "表情置信度,取值范围[0-1]。",
              "type": "number",
              "format": "double"
            }
          },
          "type": "object"
        },
        "face_angle": {
          "description": "人脸图片旋转角(顺时针偏转角度),支持0°、90°、180°和270°图片旋转。",
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "gender",
        "age",
        "dress",
        "glass",
        "hat",
        "mask",
        "beard",
        "phototype",
        "quality",
        "hair",
        "expression",
        "face_angle"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
