{
  "name": "DetectFaceByUrl",
  "summary": "人脸检测",
  "tags": "人脸检测",
  "productshort": "FRS",
  "region_id": "cn-east-3",
  "paths": {
    "/v2/{project_id}/face-detect": {
      "post": {
        "summary": "人脸检测",
        "x-name": "人脸检测",
        "deprecated": false,
        "produces": [
          "application/json"
        ],
        "description": "人脸检测是对输入图片进行人脸检测和分析,输出人脸在图像中的位置、人脸关键点位置和人脸关键属性。",
        "operationId": "DetectFaceByUrl",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc",
        "responses": {
          "200": {
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "This field is the request ID number for task tracking. Format is request_uuid-timestamp-hostname."
              }
            },
            "schema": {
              "$ref": "#/definitions/FaceDetectResp"
            },
            "examples": {
              "application/json": {
                "faces": [
                  {
                    "bounding_box": {
                      "width": 174,
                      "top_left_y": 37,
                      "top_left_x": 22,
                      "height": 174
                    }
                  },
                  {
                    "attributes": {
                      "age": 35
                    }
                  }
                ]
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "失败响应样例",
            "examples": {
              "application/json": {
                "error_code": "FRS.0019",
                "error_msg": "The service has not been subscribed."
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          }
        },
        "x-request-examples-1": {
          "image_url": "/BucketName/ObjectName",
          "attributes": "2,4"
        },
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
            "description": "项目ID,获取方法请参见[获取项目ID/账号租户名/AK/SK](https://support.huaweicloud.com/api-face/face_02_0056.html)。",
            "type": "string",
            "required": true,
            "x-order": 2
          },
          {
            "in": "header",
            "name": "X-Auth-Token",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "description": "X-Auth-Token值获取方法请参见[认证鉴权](https://support.huaweicloud.com/api-face/face_02_0004.html)。",
            "type": "string",
            "required": true,
            "x-order": 1
          },
          {
            "name": "Enterprise-Project-Id",
            "in": "header",
            "description": "企业项目ID。FRS支持通过企业项目管理(EPS)对不同用户组和用户的资源使用,进行分账。当前仅支持按需计费模式。\n\n获取方法:进入“[企业项目管理](https://console.huaweicloud.com/eps/?region=cn-north-4#/projects/list)”页面,单击企业项目名称,在企业项目详情页获取Enterprise-Project-Id(企业项目ID)。\n\n企业项目创建步骤请参见用户指南。\n> 说明:\n创建企业项目后,在传参时,有以下三类场景。\n- 携带正确的ID,正常使用FRS服务,账单的企业项目会被分类到企业ID对应的企业项目中。\n- 携带格式正确但不存在的ID,正常使用FRS服务,账单的企业项目会显示对应不存在的企业项目ID。\n- 不携带ID或格式错误ID(包含特殊字符等),正常使用FRS服务,账单的企业项目会被分类到\"default\"中。",
            "required": false,
            "type": "string",
            "x-order": 3
          },
          {
            "schema": {
              "$ref": "#/definitions/FaceDetectUrlReq"
            },
            "in": "body",
            "name": "FaceDetectUrlReq",
            "description": "This is a auto create Body Object",
            "required": true
          }
        ],
        "consumes": [
          "application/json"
        ],
        "tags": [
          "人脸检测"
        ],
        "x-request-examples-url-1": "POST https://{endpoint}/v2/{project_id}/face-detect",
        "x-cpp-exclude": "Y"
      }
    }
