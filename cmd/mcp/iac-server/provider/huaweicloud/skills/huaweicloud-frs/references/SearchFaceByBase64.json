            },
            "examples": {
              "application/json": {
                "faces": [
                  {
                    "bounding_box": {
                      "width": 170,
                      "top_left_y": 37,
                      "top_left_x": 20,
                      "height": 170
                    },
                    "similarity": 0.996146,
                    "external_fields": {
                      "id": "home",
                      "timestamp": 12
                    },
                    "external_image_id": "123",
                    "face_id": "6KLB1Ktu"
