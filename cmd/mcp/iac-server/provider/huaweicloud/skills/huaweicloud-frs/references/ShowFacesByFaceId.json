  "definitions": {
    "ShowFacesResp": {
      "properties": {
        "face_set_id": {
          "description": "人脸库ID,随机生成的包含八个字符的字符串。\n调用失败时无此字段。",
          "type": "string"
        },
        "face_set_name": {
          "description": "人脸库名称。\n调用失败时无此字段。",
          "type": "string"
        },
        "faces": {
          "description": "人脸库当中的人脸结构,详见[FaceSetFace](https://support.huaweicloud.com/api-face/face_02_0018.html)。调用失败时无此字段。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FaceSetFace",
            "type": "object"
          }
        }
      },
      "required": [
        "face_set_name",
        "face_set_id",
        "faces"
      ]
    },
    "FaceSetFace": {
      "properties": {
        "bounding_box": {
          "description": "人脸在图像中的位置。BoundingBox结构见[BoundingBox](https://support.huaweicloud.com/api-face/face_02_0021.html)。",
          "$ref": "#/definitions/BoundingBox",
          "type": "object"
        },
        "external_fields": {
          "description": "用户添加的额外字段。",
          "type": "object"
        },
        "external_image_id": {
          "description": "人脸所在的外部图片ID。",
          "type": "string"
        },
        "face_id": {
          "description": "人脸ID,由系统内部生成的唯一ID。",
          "type": "string"
        }
      },
      "required": [
        "bounding_box",
        "face_id",
        "external_image_id",
        "external_fields"
      ]
    },
    "ErrorResp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参考[错误码](https://support.huaweicloud.com/api-face/face_02_0045.html)。调用成功时无此字段。"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n调用成功时无此字段。"
        }
      }
    },
    "BoundingBox": {
      "properties": {
        "width": {
          "description": "矩形框宽度。",
          "type": "integer",
          "format": "int32"
        },
        "top_left_y": {
          "description": "矩形框左上角纵坐标。",
          "type": "integer",
          "format": "int32"
        },
        "top_left_x": {
          "description": "矩形框左上角横坐标。",
          "type": "integer",
          "format": "int32"
        },
        "height": {
          "description": "矩形框高度。",
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "top_left_x",
        "top_left_y",
        "width",
        "height"
      ]
    }
