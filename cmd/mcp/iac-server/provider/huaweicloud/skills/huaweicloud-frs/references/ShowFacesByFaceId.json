              }
            },
            "schema": {
              "$ref": "#/definitions/ShowFacesResp"
            },
            "examples": {
              "application/json": {
                "face_set_id": "T785tx1N",
                "face_set_name": "showFaceSet",
                "faces": [
                  {
                    "bounding_box": {
                      "width": 63,
                      "top_left_y": 100,
                      "top_left_x": 221,
                      "height": 63
                    },
                    "external_fields": {
                      "number": 122,
                      "id": "home",
                      "timestamp": 12
                    },
                    "external_image_id": "aIzRAa58",
                    "face_id": "cFydu4d2"
                  }
                ]
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "失败响应样例",
            "examples": {
              "application/json": {
                "error_code": "FRS.0303",
                "error_msg": "The face id is not exist, checkout your input."
              }
