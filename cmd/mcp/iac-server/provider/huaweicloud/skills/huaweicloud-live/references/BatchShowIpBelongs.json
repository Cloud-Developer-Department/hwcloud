{
  "name": "BatchShowIpBelongs",
  "summary": "查询IP归属信息",
  "tags": "域名管理",
  "productshort": "Live",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/{project_id}/cdn/ip-info": {
      "get": {
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/cdn/ip-info?ip=192.168.1.1&ip=192.168.1.2",
        "x-request-examples-url-2": "GET https://{endpoint}/v1/{project_id}/cdn/ip-info?ip=192.168.1.1,192.168.1.2",
        "tags": [
          "域名管理"
        ],
        "summary": "查询IP归属信息",
        "description": "查询IP归属信息。",
        "operationId": "BatchShowIpBelongs",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "ip",
            "in": "query",
            "required": true,
            "description": "IP地址列表,最多20个。",
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "uniqueItems": true,
            "collectionFormat": "multi"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "$ref": "#/definitions/BatchShowIpBelongsResp"
            },
            "examples": {
              "application/json": {
                "cdn_ips": [
                  {
                    "ip": "192.168.1.1",
                    "region": "Sichuan",
                    "platform": null,
                    "isp": "Dianxin",
                    "belongs": true
                  },
                  {
                    "ip": "192.168.1.2",
                    "region": "Unknown",
                    "platform": null,
                    "isp": null,
                    "belongs": false
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Request Illegal"
              }
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011005",
                "error_msg": "Server internal error, please try again later or contact customer service staff to help solve"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "BatchShowIpBelongsResp": {
      "type": "object",
      "properties": {
        "cdn_ips": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CdnIp"
          },
          "description": "IP归属信息列表。"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "CdnIp": {
      "type": "object",
      "properties": {
        "ip": {
          "type": "string",
          "description": "需查询的IP地址。"
        },
        "belongs": {
          "type": "boolean",
          "description": "是否是华为云CDN节点。(true:是华为云CDN节点,false:不是华为云CDN节点)"
        },
        "region": {
          "type": "string",
          "description": "IP归属地省份。(Unknown:表示未知归属地)"
        },
        "isp": {
          "type": "string",
          "description": "运营商名称。如果IP归属地未知,该字段返回null。"
        },
        "platform": {
          "type": "string",
          "description": "平台。如果IP归属地未知,该字段返回null。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "required": false,
