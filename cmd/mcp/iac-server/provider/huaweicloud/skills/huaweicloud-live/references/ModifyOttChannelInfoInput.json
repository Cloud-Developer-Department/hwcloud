{
  "name": "ModifyOttChannelInfoInput",
  "summary": "修改频道入流信息",
  "tags": "OTT频道管理",
  "productshort": "Live",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/ott/channels/input": {
      "put": {
        "x-request-examples-url-1": "PUT https://{endpoint}/v1/{project_id}/ott/channels/input",
        "x-request-examples-text-1": {
          "domain": "push.testott.hls.com",
          "app_name": "ott",
          "id": "test",
          "input": {
            "input_protocol": "RTMP_PUSH",
            "sources": [
              {
                "width": 100,
                "bitrate_for3u8": false,
                "enable_snapshot": false,
                "bitrate": 1024,
                "passphrase": "",
                "url": "rtmp://192.168.8.158/ott/adtestdrm?vhost=pull.testott.hls.com",
                "height": 100
              }
            ]
          }
        },
        "x-request-examples-1": {
          "domain": "push.testott.hls.com",
          "app_name": "ott",
          "id": "test",
          "input": {
            "input_protocol": "RTMP_PUSH",
            "sources": [
              {
                "width": 100,
                "bitrate_for3u8": false,
                "enable_snapshot": false,
                "bitrate": 1024,
                "passphrase": "",
                "url": "http://192.168.8.158/ott/adtestdrm.flv?vhost=pull.testott.hls.com",
                "height": 100
              }
            ]
          }
        },
        "tags": [
          "OTT频道管理"
        ],
        "operationId": "ModifyOttChannelInfoInput",
        "summary": "修改频道入流信息",
        "description": "修改频道入流信息。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,使用Token鉴权方式时必选。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Access-Control-Allow-Internal",
            "in": "header",
            "description": "服务鉴权Token,服务开启鉴权,必须携带Access-Control-Allow-Internal访问服务。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          {
            "name": "Access-Control-Allow-External",
            "in": "header",
            "description": "服务鉴权Token,服务开启鉴权,必须携带Access-Control-Allow-External访问服务。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](live_26_0018.xml)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "body",
            "name": "ModifyOttChannelInfoInputRequestBody",
            "description": "ModifyOttChannelInfoInputRequestBody",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ModifyOttChannelInputReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Demo Information",
            "schema": {
              "$ref": "#/definitions/SuccessRsp"
            },
            "examples": {
              "application/json": {
                "result_code": "LIVE.100000000",
                "result_msg": "SUCCESS",
                "domain": "push.testott.hls.com",
                "app_name": "ott",
                "id": "test"
              }
            }
          },
          "400": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "examples": {
              "application/json": {
                "result_code": "LIVE.103011019",
                "result_msg": "The resource to access is not exists",
                "domain": "push.testott.hls.com",
                "app_name": "test",
                "id": "test-abc"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "SuccessRsp": {
      "description": "创建成功响应",
      "properties": {
        "result_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "description": "错误码"
        },
        "result_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "错误描述"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "推流域名"
        },
        "app_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "组名或应用名,为必填项"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "频道ID。频道唯一标识,为必填项"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/SourceRsp"
          },
          "description": "推流URL列表。创建频道时,只有入流协议为RTMP_PUSH时,会返回推流URL列表",
          "type": "array",
          "minItems": 1,
          "maxItems": 12
        }
      },
      "type": "object"
    },
    "ModifyOttChannelInputReq": {
      "description": "OTT频道修改入流消息体",
      "required": [
        "domain",
        "app_name",
        "id"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "description": "频道推流域名",
          "minLength": 1,
          "maxLength": 255,
          "example": "www.huaweiott.pushdomain.com"
        },
        "app_name": {
          "type": "string",
          "description": "组名或应用名",
          "minLength": 1,
          "maxLength": 64,
          "example": "live"
        },
        "id": {
          "type": "string",
          "description": "频道ID。频道唯一标识,为必填项",
          "minLength": 2,
          "maxLength": 512,
          "example": "channelId"
        },
        "input": {
          "description": "频道出流信息",
          "$ref": "#/definitions/InputStreamInfo"
        },
        "encoder_settings_expand": {
          "description": "音频输出配置",
          "$ref": "#/definitions/EncoderSettingsExpand"
        }
      },
      "type": "object"
    },
    "EncoderSettingsExpand": {
      "type": "object",
      "description": "输出编码扩展",
      "properties": {
        "audio_descriptions": {
          "type": "array",
          "items": {
            "required": [
              "name",
              "audio_selector_name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "example": "test",
                "description": "音频输出配置的名称。仅支持大小写字母,数字,中划线(-),下划线(_)。\n\n同一个频道不同的音频输出配置名称,不允许重复。",
                "minLength": 1,
                "maxLength": 255
              },
              "audio_selector_name": {
                "type": "string",
                "example": "test",
                "description": "音频选择器名称",
                "minLength": 1,
                "maxLength": 255
              },
              "language_code_control": {
                "type": "string",
                "example": "FOLLOW_INPUT",
                "description": "语言代码控制。这里的设置不会修改音频实际的语言,只会修改音频对外展示的语言。\n\n包含如下选项:\n- FOLLOW_INPUT:如果所选音频选择器对应的输出音频有语言,则与其保持一致,否则会以这里配置的语言代码和流名称进行兜底。推荐当前选项,为默认值。\n- USE_CONFIGURED:用户根据实际情况自定义输出音频的语言和流名称。",
                "enum": [
                  "FOLLOW_INPUT",
                  "USE_CONFIGURED"
                ]
              },
              "language_code": {
                "type": "string",
                "example": "cn",
                "description": "语言代码,输入2或3个小写字母。",
                "minLength": 2,
                "maxLength": 3
              },
              "stream_name": {
                "type": "string",
                "example": "Arabic",
                "description": "流名称",
                "minLength": 0,
                "maxLength": 255
              }
            }
          },
          "description": "音频输出配置的描述信息",
          "minItems": 0,
          "maxItems": 8
        },
        "video_descriptions": {
          "description": "视频输出配置的描述信息",
          "$ref": "#/definitions/VideoDescriptions"
        }
      }
    },
    "InputAudioSelector": {
      "type": "object",
      "description": "音频选择器",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "音频选择器的名称。仅支持大小写字母、数字、中划线和下划线。\n\n同一个频道中每个选择器的名称需要唯一。",
          "minLength": 1,
          "maxLength": 255
        },
        "selector_settings": {
          "description": "设置音频选择器",
          "$ref": "#/definitions/AudioSelectorSettings"
        }
      }
    },
    "VideoDescriptions": {
      "type": "object",
      "properties": {
        "gop_duration_seconds": {
          "type": "integer",
          "format": "int32",
          "description": "自定义gop时长,单位秒,有效取值[0,10]. 默认值0,表示跟随源流,不支持7和9,值无效时按默认值处理",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "enum": [
            0,
            1,
            2,
            3,
            4,
            5,
            6,
            8,
            10
          ]
        }
      }
    },
    "AudioSelectorHlsSelection": {
      "type": "object",
      "description": "hls音频选择器",
      "required": [
        "name",
        "group_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "hls音频选择器名",
          "minLength": 1,
          "maxLength": 255
        },
        "group_id": {
          "type": "string",
          "description": "hls音频选择器gid"
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "result_code",
        "result_msg"
      ],
      "properties": {
        "result_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "description": "错误码"
        },
        "result_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "错误描述"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "推流域名"
        },
        "app_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "组名或应用名,为必填项"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "频道ID。频道唯一标识,为必填项"
        }
      }
    },
    "AudioSelectorSettings": {
      "type": "object",
      "description": "设置音频选择器",
      "properties": {
        "audio_language_selection": {
          "description": "设置语言选择器",
          "$ref": "#/definitions/AudioSelectorLangSelection"
        },
        "audio_pid_selection": {
          "description": "设置PID选择器",
          "$ref": "#/definitions/AudioSelectorPidSelection"
        },
        "audio_hls_selection": {
          "description": "设置Hls选择器",
          "$ref": "#/definitions/AudioSelectorHlsSelection"
        }
      }
    },
    "AudioSelectorPidSelection": {
      "type": "object",
      "description": "PID选择器",
      "required": [
        "pid"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "format": "int32",
          "description": "设置PID的值",
          "minimum": 0,
          "maximum": 8191
        }
      }
    },
    "InputStreamInfo": {
      "description": "频道入流信息",
      "properties": {
        "input_protocol": {
          "type": "string",
          "description": "频道入流协议\n- FLV_PULL\n- RTMP_PUSH\n- HLS_PULL\n- SRT_PULL\n- SRT_PUSH",
          "enum": [
            "FLV_PULL",
            "RTMP_PUSH",
            "HLS_PULL",
            "SRT_PULL",
            "SRT_PUSH"
          ],
          "default": "FLV_PULL",
          "example": "FLV_PULL"
        },
        "sources": {
          "description": "频道主源流信息。入流协议为RTMP_PUSH和SRT_PUSH时,非必填项。其他情况下,均为必填项。",
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/definitions/SourcesInfo"
          }
        },
        "secondary_sources": {
          "description": "备入流数组,非必填项。如果有备入流,则主备入流必须保证路数、codec和分辨率均一致。入流协议为RTMP_PUSH时,无需填写。",
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/definitions/SecondarySourcesInfo"
          }
        },
        "failover_conditions": {
          "description": "非必填,频道供应商提供的主备音视频流URL切换的配置。",
          "$ref": "#/definitions/FailoverConditions"
        },
        "max_bandwidth_limit": {
          "type": "integer",
          "format": "int32",
          "description": "当入流协议为HLS_PULL时,需要配置的最大带宽。\n\n用户提供的拉流URL中,针对不同码率的音视频,均会携带带宽参数“BANDWIDTH”。\n- 如果这里配置最大带宽,媒体直播服务从URL拉流时,会选择小于最大带宽且码率最大的音视频流,推流到源站。\n- 如果这里未配置最大带宽,媒体直播服务从URL拉流时,会默认选择“BANDWIDTH”最高的音视频流,推流到源站。"
        },
        "ip_port_mode": {
          "type": "boolean",
          "description": "当推流协议为SRT_PUSH时,如果配置了直推源站,编码器不支持输入streamid,需要打开设置为true"
        },
        "ip_whitelist": {
          "type": "string",
          "description": "SRT_PUSH类型时,客户push ip白名单",
          "minLength": 0,
          "maxLength": 256
        },
        "scte35_source": {
          "type": "string",
          "description": "广告的scte35信号源。\n\n仅HLS_PULL类型的频道支持此配置,且目前仅支持SEGMENTS。",
          "example": "SEGMENTS,MANIFEST"
        },
        "ad_triggers": {
          "type": "array",
          "description": "广告触发器配置。\n\n包含如下取值:\n- Splice insert:拼接插入\n- Provider advertisement:提供商广告\n- Distributor advertisement:分销商广告\n- Provider placement opportunity:提供商置放机会\n- Distributor placement opportunity:分销商置放机会",
          "enum": [
            "Splice insert",
            "Provider advertisement",
            "Distributor advertisement",
            "Provider placement opportunity",
            "Distributor placement opportunity"
          ],
          "items": {
            "type": "string"
          }
        },
        "audio_selectors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InputAudioSelector"
          },
          "description": "设置音频选择器,最多设置8个音频选择器"
        }
      },
      "type": "object",
      "required": [
        "input_protocol"
      ]
    },
    "SourcesInfo": {
      "description": "主入流信息",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "频道源流URL,用于外部拉流"
        },
        "bitrate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600,
          "description": "码率。无需直播转码时,此参数为必填项\n\n单位:bps。取值范围:(0,104,857,600](100Mbps)"
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096,
          "description": "分辨率对应宽的值,非必填项\n\n取值范围:0 - 4096(4K)"
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2160,
          "description": "分辨率对应高的值,非必填项\n\n取值范围:0 - 2160(4K)"
        },
        "enable_snapshot": {
          "type": "boolean",
          "description": "描述是否使用该流做截图",
          "default": false
        },
        "bitrate_for3u8": {
          "type": "boolean",
          "description": "是否使用bitrate来固定码率。默认值:false"
        },
        "passphrase": {
          "type": "string",
          "description": "协议为SRT_PUSH时的加密信息",
          "minLength": 10,
          "maxLength": 79
        },
        "pbkeylen": {
          "type": "integer",
          "description": "srt加密算法",
          "minimum": 16,
          "maximum": 32
        },
        "backup_urls": {
          "type": "array",
          "description": "备入流地址列表",
          "maxItems": 12,
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "stream_id": {
          "type": "string",
          "description": "频道为SRT_PULL类型时,拉流地址的Stream ID。"
        },
        "latency": {
          "type": "integer",
          "format": "int32",
          "description": "频道为SRT_PULL类型时的拉流时延。"
        }
      },
      "type": "object"
    },
    "SourceRsp": {
      "type": "object",
      "description": "RTMP推流地址。只有频道入流协议为RTMP_PUSH时,会返回RTMP推流地址",
      "properties": {
        "url": {
          "type": "string",
          "example": "string",
          "description": "RTMP推流地址",
          "minLength": 1,
          "maxLength": 1024
        },
        "bitrate": {
          "type": "integer",
          "format": "int32",
          "example": 104857600,
          "description": "码率。\n\n单位:bps。取值范围:(0,104,857,600](100Mbps)",
          "minimum": 0,
          "maximum": 104857600
        },
        "width": {
          "type": "integer",
          "format": "int32",
          "example": 4096,
          "description": "分辨率对应宽的值。取值范围:0 - 4096(4K)",
          "minimum": 0,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "format": "int32",
          "example": 2160,
          "description": "分辨率对应高的值。取值范围:0 - 2160(4K)",
          "minimum": 0,
          "maximum": 2160
        },
        "enable_snapshot": {
          "type": "boolean",
          "example": false,
          "description": "描述是否使用该流做截图"
        }
      }
    },
    "SecondarySourcesInfo": {
      "description": "备入流信息",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "频道源流URL,用于外部拉流"
        },
        "bitrate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600,
          "description": "码率。无需直播转码时,此参数为必填项\n\n单位:bps。取值范围:(0,104,857,600](100Mbps)"
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096,
          "description": "分辨率对应宽的值,非必填项\n\n取值范围:0 - 4096(4K)"
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2160,
          "description": "分辨率对应高的值,非必填项\n\n取值范围:0 - 2160(4K)"
        },
        "bitrate_for3u8": {
          "type": "boolean",
          "description": "是否使用bitrate来固定码率。默认值:false"
        },
        "passphrase": {
          "type": "string",
          "description": "协议为SRT_PUSH时的加密信息",
          "minLength": 10,
          "maxLength": 79
        },
        "pbkeylen": {
          "type": "integer",
          "description": "srt加密算法",
          "minimum": 16,
          "maximum": 32
        },
        "backup_urls": {
          "type": "array",
          "description": "备入流地址列表",
          "minItems": 0,
          "maxItems": 12,
          "items": {
            "type": "string"
          }
        },
        "stream_id": {
          "type": "string",
          "description": "频道为SRT_PULL类型时,拉流地址的Stream ID。"
        },
        "latency": {
          "type": "integer",
          "format": "int32",
          "description": "频道为SRT_PULL类型时的拉流时延。"
        }
      },
      "type": "object"
    },
    "FailoverConditions": {
      "description": "主备切换配置",
      "properties": {
        "input_loss_threshold_msec": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000,
          "description": "入流停止的时长阈值。到达此阈值后,自动触发主备切换。\n\n单位:毫秒,取值范围:0 - 3600000。\n\n非必填,默认填2000ms。"
        },
        "input_preference": {
          "type": "string",
