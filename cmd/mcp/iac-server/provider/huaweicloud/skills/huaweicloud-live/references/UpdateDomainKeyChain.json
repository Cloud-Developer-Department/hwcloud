  "definitions": {
    "KeyChainInfo": {
      "type": "object",
      "required": [
        "key",
        "auth_type",
        "timeout"
      ],
      "properties": {
        "key": {
          "type": "string",
          "example": "IbBIzklRGCyMEd18oPV9sxAuuwNIzT81",
          "description": "防盗链Key值,由32个字符组成,支持大写字母、小写字母、数字。不可为纯数字或纯字母。",
          "minLength": 32,
          "maxLength": 32
        },
        "auth_type": {
          "type": "string",
          "example": "d_sha256",
          "description": "计算鉴权串的方式:\n- d_sha256:鉴权方式D,采用HMAC-SHA256算法,建议优先选择此方式;\n- c_aes:鉴权方式C,采用对称加密算法;\n- b_md5:鉴权方式B,采用MD5信息摘要算法;\n- a_md5:鉴权方式A,采用MD5信息摘要算法。\n\n> 鉴权方式ABC存在安全风险,鉴权方式D拥有更高的安全性,建议您优先使用鉴权方式D。",
          "enum": [
            "d_sha256",
            "c_aes",
            "b_md5",
            "a_md5"
          ]
        },
        "timeout": {
          "type": "integer",
          "format": "int32",
          "example": 3600,
          "description": "URL鉴权信息的超时时长\n\n取值范围:[60,2592000],即1分钟-30天\n\n单位:秒\n\n鉴权信息中携带的请求时间与直播服务收到请求时的时间的最大差值,用于检查直播推流URL或者直播播放URL是否已过期",
          "minimum": 60,
          "maximum": 2592000
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "required": false,
      "minLength": 1,
      "maxLength": 256,
      "description": "使用AK/SK方式认证时必填,携带的鉴权信息。",
      "type": "string",
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": false,
      "description": "用户Token,使用Token鉴权方式时必填。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,携带项目ID信息。",
      "minLength": 1,
      "maxLength": 64,
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,请求的发生时间。",
      "minLength": 1,
      "maxLength": 256,
      "type": "string",
      "x-example": "20191115T033655Za"
    }
  },
