{
  "name": "ListSingleStreamBitrate",
  "summary": "查询推流码率数据接口",
  "tags": "流监控",
  "productshort": "Live",
  "region_id": "cn-north-1",
  "paths": {
    "/v2/{project_id}/stats/stream/bitrate": {
      "get": {
        "tags": [
          "StreamMonitor"
        ],
        "summary": "查询推流码率数据接口",
        "description": "查询推流监控码率数据接口。\n\n最大查询跨度1天,最大查询周期1个月。\n\n返回的码率数据列表粒度为1秒钟。\n",
        "operationId": "ListSingleStreamBitrate",
        "deprecated": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-external-api": true,
        "x-interface-frequency": "HIGH",
        "x-constraint": "该接口暂只支持查询部署在新版视频直播服务上的域名的相关数据(不包含“华北-北京一”)。此约束条件仅适用于中国站。",
        "x-imports": "javax.validation.constraints.NotBlank;org.hibernate.validator.constraints.Range;",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息, 与路径参数中的项目ID相同。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-live/live_03_0023.html)。\n",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "query",
            "name": "domain",
            "description": "推流域名。\n",
            "type": "string",
            "required": true,
            "x-annotations": [
              "@NotBlank"
            ],
            "minLength": 1,
            "maxLength": 64
          },
          {
            "in": "query",
            "name": "app",
            "description": "App名。\n",
            "type": "string",
            "required": true,
            "x-annotations": [
              "@NotBlank"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          {
            "in": "query",
            "name": "stream",
            "description": "流名。\n",
            "type": "string",
            "required": true,
            "x-annotations": [
              "@NotBlank"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          {
            "in": "query",
            "name": "type",
            "type": "string",
            "required": false,
            "description": "数据类型,取值如下:\n - VIDEO :视频码率\n - AUDIO :音频码率\n\n 不填写默认查询视频码率的数据。\n",
            "enum": [
              "VIDEO",
              "AUDIO"
            ],
            "default": "VIDEO",
            "minLength": 1,
            "maxLength": 10
          },
          {
            "in": "query",
            "name": "start_time",
            "description": "起始时间。日期格式按照ISO8601表示法,并使用UTC时间。\n\n格式为:YYYY-MM-DDThh:mm:ssZ。最大查询跨度1天,最大查询周期1个月。\n\n若参数为空,默认查询最近1小时数据。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 64
          },
          {
            "in": "query",
            "name": "end_time",
            "description": "结束时间。日期格式按照ISO8601表示法,并使用UTC时间。格式为:YYYY-MM-DDThh:mm:ssZ。\n\n若参数为空,默认为当前时间。结束时间需大于起始时间。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 64
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。\n",
            "schema": {
              "$ref": "#/definitions/V2BitrateInfoRsp"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求的唯一标识。"
              }
            },
            "examples": {
              "application/json": {
                "bitrate_info_list": [
                  {
                    "publish_domain": "example.huawei.com",
                    "app": "app",
                    "stream": "stream",
                    "start_time": "2020-06-04T07:00:00Z",
                    "end_time": "2020-06-05T07:00:00Z",
                    "data_list": [
                      100,
                      200
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "处理失败返回。\n",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求的唯一标识。"
              }
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Invalid request parameter: domain"
              }
            }
          }
        },
        "x-request-examples-description-1": "查询推流域名码率",
        "x-request-examples-url-1": "GET /v2/{project_id}/stats/stream/bitrate?app=live&stream=stream&domain=example.huawei.com\n"
      }
    }
  },
  "definitions": {
    "V2BitrateInfoRsp": {
      "type": "object",
      "properties": {
        "bitrate_info_list": {
          "description": "用量详情。",
          "type": "array",
          "minItems": 0,
          "maxItems": 8928,
          "items": {
            "$ref": "#/definitions/V2BitrateInfo"
          }
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "V2BitrateInfo": {
      "type": "object",
      "description": "实时码率",
      "properties": {
        "publish_domain": {
          "type": "string",
          "description": "域名。",
          "minLength": 1,
          "maxLength": 64
        },
        "app": {
          "type": "string",
          "description": "应用名称。",
          "minLength": 1,
          "maxLength": 128
        },
        "stream": {
          "type": "string",
          "description": "流名。",
          "minLength": 1,
          "maxLength": 128
        },
        "start_time": {
          "type": "string",
          "description": "采样开始时间。日期格式按照ISO8601表示法,并使用UTC时间。 格式为:YYYY-MM-DDThh:mm:ssZ。",
          "minLength": 1,
          "maxLength": 64
        },
        "end_time": {
          "type": "string",
          "description": "采样结束时间。日期格式按照ISO8601表示法,并使用UTC时间。 格式为:YYYY-MM-DDThh:mm:ssZ。",
          "minLength": 1,
          "maxLength": 64
        },
        "data_list": {
          "description": "码率信息列表,单位为Kbps。",
          "type": "array",
          "minItems": 0,
          "maxItems": 8928,
          "items": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "live.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
