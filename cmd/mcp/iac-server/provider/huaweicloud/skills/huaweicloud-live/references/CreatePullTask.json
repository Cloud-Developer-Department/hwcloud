{
  "name": "CreatePullTask",
  "summary": "创建直播拉流转推任务",
  "tags": "拉流管理",
  "productshort": "Live",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/pull/stream/task": {
      "post": {
        "x-api-type": "open-api",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/{project_id}/pull/stream/task",
        "x-request-examples-text-1": {
          "region": "cn-north-4",
          "source_type": "PullLivePushLive",
          "source_urls": [
            "rtmp://play.example.huawei.com/live/stream1"
          ],
          "domain": "publish.example.huawei.com",
          "app_name": "live",
          "stream_name": "test",
          "start_time": "2018-05-19T18:00:00Z",
          "end_time": "2018-05-19T21:00:00Z",
          "push_args": "arg1=value1",
          "callback_events": [
            "TaskStart",
            "TaskExit",
            "TaskAlarm"
          ],
          "callback_url": "callback.example.com",
          "backup_source_type": "PullLivePushLive",
          "backup_source_urls": [
            "rtmp://play.example.huawei.com/live/stream1_bak"
          ]
        },
        "x-request-examples-1": {
          "region": "cn-north-4",
          "source_type": "PullLivePushLive",
          "source_urls": [
            "rtmp://play.example.huawei.com/live/stream1"
          ],
          "domain": "publish.example.huawei.com",
          "app_name": "live",
          "stream_name": "test",
          "start_time": "2018-05-19T18:00:00Z",
          "end_time": "2018-05-19T21:00:00Z",
          "push_args": "arg1=value1",
          "callback_events": [
            "TaskStart",
            "TaskExit",
            "TaskAlarm"
          ],
          "callback_url": "callback.example.com",
          "backup_source_type": "PullLivePushLive",
          "backup_source_urls": [
            "rtmp://play.example.huawei.com/live/stream1_bak"
          ]
        },
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "x-open-region-cloud": "hc,hk",
        "tags": [
          "拉流管理"
        ],
        "summary": "创建直播拉流转推任务",
        "description": "根据租户指定的拉流源以及拉流任务信息创建直播拉流转推任务",
        "operationId": "CreatePullTask",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "CreatePullTaskRequestBody",
            "in": "body",
            "required": true,
            "description": "拉流转推任务配置信息",
            "schema": {
              "$ref": "#/definitions/LivePullStreamTask"
            }
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "responses": {
          "200": {
            "description": "创建拉流转推任务成功",
            "schema": {
              "$ref": "#/definitions/CreatePullTaskResponseBody"
            },
            "examples": {
              "application/json": {
                "task_id": "7864b3dc-e92f-42db-a754-08e627b6d8dd",
                "request_id": "85968475-e92f-42db-a754-08e627b6d8dd"
              }
            }
          },
          "400": {
            "description": "创建拉流转推任务失败",
            "schema": {
              "$ref": "#/definitions/PullPushErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Request Illegal",
                "request_id": "85968475-e92f-42db-a754-08e627b6d8dd"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CreatePullTaskResponseBody": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务id",
          "minLength": 1,
          "maxLength": 64,
          "example": "7864b3dc-e92f-42db-a754-08e627b6d8dd"
        },
        "request_id": {
          "type": "string",
          "description": "请求id",
          "minLength": 1,
          "maxLength": 64,
          "example": "58684758-e92f-42db-a754-08e627b6d8dd"
        }
      }
    },
    "PullPushErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "maxLength": 32,
          "minLength": 1
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "maxLength": 1024,
          "minLength": 0
        },
        "request_id": {
          "type": "string",
          "description": "请求id",
          "minLength": 1,
          "maxLength": 64,
          "example": "58684758-e92f-42db-a754-08e627b6d8dd"
        }
      }
    },
    "LivePullStreamTask": {
      "type": "object",
      "required": [
        "source_type",
        "source_urls"
      ],
      "properties": {
        "region": {
          "type": "string",
          "example": "cn-north-4",
          "description": "任务执行区域,如果指定推流域名,则region需要与推流域名直播源站一致,缺省为租户归属region",
          "minLength": 1,
          "maxLength": 64
        },
        "source_type": {
          "type": "string",
          "example": "PullLivePushLive",
          "description": "拉流源类型\nPullLivePushLive:拉转推(拉直播推直播)\nPullVodPushLive:轮播(拉点播推直播)",
          "enum": [
            "PullLivePushLive",
            "PullVodPushLive"
          ]
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "example": [
            "rtmp://play.example.huawei.com/live/stream1"
          ],
          "description": "拉流源URL\n当 source_type 为 PullLivePushLive 时,只能填写一个URL\n当 source_type 为 PullVodPushLive 时,可以指定多个轮播源文件URL",
          "minItems": 1,
          "maxItems": 30
        },
        "domain": {
          "type": "string",
          "example": "publish.example.huawei.com",
          "description": "推流域名",
          "minLength": 0,
          "maxLength": 255
        },
        "app_name": {
          "type": "string",
          "example": "live",
          "description": "推流app",
          "minLength": 0,
          "maxLength": 128
        },
        "stream_name": {
          "type": "string",
          "example": "test",
          "description": "推流流名",
          "minLength": 0,
          "maxLength": 512
        },
        "push_args": {
          "type": "string",
          "example": "arg1=value1",
          "description": "推流参数",
          "minLength": 0,
          "maxLength": 2048
        },
        "destination_url": {
          "type": "string",
          "example": "rtmp://publish.example.com/live/test",
          "description": "完整的目标URL。\n如果指定此参数,domain、app_name和stream_name需要传入空字符串或不传。",
          "minLength": 0,
          "maxLength": 2048
        },
        "start_time": {
          "type": "string",
          "format": "date-time",
          "example": "2018-05-19T18:00:00Z",
          "description": "任务启动时间,时间格式:\n\"2006-01-02T15:04:05Z\"\n必须小于结束时间,缺省为当前时间"
        },
        "end_time": {
          "type": "string",
          "format": "date-time",
          "example": "2018-05-19T21:00:00Z",
          "description": "任务结束时间,时间格式:\n\"2006-01-02T15:04:05Z\"\n必须大于开始时间,至多为开始时间+7天"
        },
        "vod_loop_time": {
          "type": "string",
          "description": "轮播播放次数,仅当source_type为PullVodPushLive生效。缺省值”-1”。-1:无限轮播,以结束时间为准;N:按文件列表播放N轮,以播放完成和结束时间先到的为准。不传、为空(\"\")时按缺省值生效",
          "example": -1,
          "minLength": 0,
          "maxLength": 10
        },
        "vod_refresh_type": {
          "type": "string",
          "description": "轮播文件播放形式,仅当source_type为PullVodPushLive生效。缺省值immediate_new_source\nimmediate_new_source:立即播放新的文件源\ncontinue_from_file_start:从上次断流URL文件重新播放(更新任务时有效)\ncontinue_from_break_point:从上次断流URL文件断流位置重新播放(更新任务时有效)",
          "example": "immediate_new_source",
          "enum": [
            "immediate_new_source",
            "continue_from_file_start",
            "continue_from_break_point"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "vod_start_video_index": {
          "type": "integer",
          "description": "指定播放文件的下标,仅当source_type为PullVodPushLive生效。缺省值 0,从0开始表示第一个文件,最大值 len(source_urls)-1",
          "example": 0,
          "minimum": 0,
          "maximum": 2147483647
        },
        "vod_start_video_time": {
          "type": "integer",
          "description": "缺省值 0,指定从上述指定文件的第几秒开始播放,仅当source_type为PullVodPushLive生效",
          "example": 0,
          "minimum": 0,
          "maximum": 2147483647
        },
        "backup_source_type": {
          "type": "string",
          "example": "PullLivePushLive",
          "description": "备源的类型\n- PullLivePushLive:直播\n注意事项:\n1. 仅当source_type为PullVodPushLive生效。\n2. 主直播源拉流中断时,自动使用备源进行拉流。",
          "minLength": 0,
          "maxLength": 2048
        },
        "backup_source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "example": [
            "rtmp://play.example.huawei.com/live/stream1_bak"
          ],
          "description": "备源URL,仅当source_type为PullVodPushLive生效。",
          "minItems": 0,
          "maxItems": 30
        },
        "callback_events": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "TaskStart",
              "VodSourceFileStart",
              "VodSourceFileFinish",
              "ResetTaskConfig",
              "TaskExit",
              "TaskAlarm"
            ]
          },
          "example": [
            "TaskStart",
            "VodSourceFileStart",
            "VodSourceFileFinish",
            "ResetTaskConfig",
            "TaskExit",
            "TaskAlarm"
          ],
          "description": "要回调的事件列表(不填则回调全部)\n- TaskStart:任务启动回调\n- TaskExit:任务停止回调\n- VodSourceFileStart:仅PullVodPushLive可用,文件启动切换\n- VodSourceFileFinish:仅PullVodPushLive可用,文件播放完毕\n- ResetTaskConfig:仅PullVodPushLive可用,任务更新\n- TaskAlarm:用于告警事件通知",
          "minItems": 0,
          "maxItems": 6
        },
        "callback_url": {
          "type": "string",
          "example": "callback.example.com",
          "description": "回调接收地址",
          "minLength": 0,
          "maxLength": 2048
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目ID,获取方法请参考[获取项目ID](live_03_0023.xml)。",
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": false,
      "description": "用户Token,使用Token鉴权方式时必填。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "host": "live.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}