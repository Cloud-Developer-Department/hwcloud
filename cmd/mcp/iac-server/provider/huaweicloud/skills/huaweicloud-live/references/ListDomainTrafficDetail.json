{
  "name": "ListDomainTrafficDetail",
  "summary": "查询播放流量趋势接口",
  "tags": "数据统计分析",
  "productshort": "Live",
  "region_id": "ap-southeast-2",
  "paths": {
    "/v2/{project_id}/stats/traffic/detail": {
      "get": {
        "tags": [
          "DataStatisticsAnalysis"
        ],
        "summary": "查询播放流量趋势接口",
        "description": "查询播放域名流量数据。\n\n如果不传入域名,则查询租户下所有播放域名的流量数据。\n\n当查询租户级别流量数据时,参数app、stream不生效。\n\n最大查询跨度31天,最大查询周期一年。\n",
        "operationId": "ListDomainTrafficDetail",
        "deprecated": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-external-api": true,
        "x-interface-frequency": "HIGH",
        "x-constraint": "该接口暂只支持查询部署在新版视频直播服务上的域名的相关数据(不包含“华北-北京一”)。此约束条件仅适用于中国站。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息, 与路径参数中的项目ID相同。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-live/live_03_0023.html)。\n",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "query",
            "name": "play_domains",
            "description": "播放域名列表,最多支持查询100个域名,多个域名以逗号分隔。\n\n如果不传入域名,则查询租户下所有播放域名的流量数据。\n",
            "type": "array",
            "required": false,
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 100
          },
          {
            "in": "query",
            "name": "app",
            "type": "string",
            "description": "应用名称。",
            "required": false,
            "minLength": 1,
            "maxLength": 128
          },
          {
            "in": "query",
            "name": "stream",
            "type": "string",
            "description": "流名。",
            "required": false,
            "minLength": 0,
            "maxLength": 256
          },
          {
            "in": "query",
            "name": "region",
            "description": "区域列表。具体取值请参考[省份名称缩写](https://support.huaweicloud.com/api-live/live_03_0043.html),不填写查询所有区域。\n",
            "type": "array",
            "items": {
              "type": "string"
            },
            "required": false,
            "minItems": 0,
            "maxItems": 35
          },
          {
            "in": "query",
            "name": "isp",
            "description": "运营商列表,取值如下:\n- CMCC :移动\n- CTCC : 电信\n- CUCC :联通\n- OTHER :其他\n\n不填写查询所有运营商。\n",
            "type": "array",
            "items": {
              "type": "string"
            },
            "required": false,
            "minItems": 0,
            "maxItems": 4
          },
          {
            "in": "query",
            "name": "protocol",
            "type": "string",
            "description": "请求协议",
            "required": false,
            "minLength": 0,
            "maxLength": 128,
            "enum": [
              "flv",
              "hls"
            ]
          },
          {
            "in": "query",
            "name": "interval",
            "description": "查询数据的时间粒度。支持300(默认值), 3600和86400秒。不传值时,使用默认值300秒。\n",
            "type": "integer",
            "format": "int32",
            "required": false,
            "minimum": 300,
            "maximum": 86400
          },
          {
            "in": "query",
            "name": "start_time",
            "description": "起始时间。日期格式按照ISO8601表示法,并使用UTC时间。\n\n格式为:YYYY-MM-DDThh:mm:ssZ。最大查询跨度31天,最大查询周期一年。\n\n若参数为空,默认查询7天数据。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 64
          },
          {
            "in": "query",
            "name": "end_time",
            "description": "结束时间。日期格式按照ISO8601表示法,并使用UTC时间。格式为:YYYY-MM-DDThh:mm:ssZ。\n\n若参数为空,默认为当前时间。结束时间需大于起始时间。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 64
          },
          {
            "in": "query",
            "name": "service_type",
            "type": "string",
            "required": false,
            "description": "服务类型:\n- Live:直播\n- LLL:超低时延直播\n- ALL: 默认所有直播\n",
            "enum": [
              "Live",
              "LLL",
              "ALL"
            ],
            "default": "ALL",
            "minLength": 1,
            "maxLength": 10
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。\n",
            "schema": {
              "$ref": "#/definitions/TrafficDataRsp"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求的唯一标识。"
              }
            },
            "examples": {
              "application/json": {
                "data_list": [
                  {
                    "value": 50,
                    "time": "2020-06-04T07:00:00Z"
                  },
                  {
                    "value": 78
                  },
                  {
                    "time": "2020-06-04T07:05:00Z"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "处理失败返回。\n",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求的唯一标识。"
              }
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Invalid request parameter: start_time"
              }
            }
          }
        },
        "x-request-examples-description-1": "查询播放域名流量",
        "x-request-examples-url-1": "GET /v2/{project_id}/stats/traffic/detail?play_domains=test.huawei.com\n"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "TrafficData": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "format": "int64",
          "description": "采样值,单位为byte。",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "time": {
          "type": "string",
          "description": "采样时间。日期格式按照ISO8601表示法,并使用UTC时间。 格式为:YYYY-MM-DDThh:mm:ssZ。",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "TrafficDataRsp": {
      "type": "object",
      "properties": {
        "data_list": {
          "description": "采样数据列表。",
          "minItems": 0,
          "maxItems": 8928,
          "type": "array",
          "items": {
            "$ref": "#/definitions/TrafficData"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "live.ap-southeast-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}