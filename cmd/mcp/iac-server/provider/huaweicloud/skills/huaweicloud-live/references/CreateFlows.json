{
  "name": "CreateFlows",
  "summary": "创建流",
  "tags": "流连接管理",
  "productshort": "Live",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/{project_id}/flows": {
      "post": {
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/flows",
        "x-request-examples-text-1": {
          "name": "test_caller",
          "region": "cn-north-5",
          "sources": [
            {
              "source_listener_address": "srt://100.10.10.10",
              "source_listener_port": 5000,
              "stream_id": "",
              "min_latency": 2000,
              "cidr_whitelist": [
                "0.0.0.0/32"
              ],
              "description": "test_caller",
              "protocol": "srt-caller",
              "name": "gzztest_caller",
              "decryption": {
                "algorithm": "aes256",
                "key_type": "srt-password",
                "passphrase": "*******"
              }
            }
          ]
        },
        "x-request-examples-1": {
          "name": "test_caller",
          "region": "cn-north-5",
          "sources": [
            {
              "source_listener_address": "srt://100.10.10.10",
              "source_listener_port": 5000,
              "stream_id": "",
              "min_latency": 2000,
              "cidr_whitelist": [
                "0.0.0.0/32"
              ],
              "description": "test_caller",
              "protocol": "srt-caller",
              "name": "gzztest_caller",
              "decryption": {
                "algorithm": "aes256",
                "key_type": "srt-password",
                "passphrase": "*******"
              }
            }
          ]
        },
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "tags": [
          "流连接管理"
        ],
        "summary": "创建流",
        "description": "创建流",
        "consumes": [
          "application/json;charset=utf-8"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "operationId": "CreateFlows",
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "CreateFlowsRequestBody",
            "in": "body",
            "required": true,
            "description": "创建流请求体",
            "schema": {
              "$ref": "#/definitions/CreateFlowsRequestBody"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "流创建成功响应",
            "schema": {
              "$ref": "#/definitions/FlowCreateResp"
            },
            "examples": {
              "application/json": {
                "flow": {
                  "name": "test_caller",
                  "region": "cn-north-5",
                  "sources": [
                    {
                      "description": "test_caller",
                      "min_latency": 2000,
                      "source_listener_port": 5000,
                      "source_listener_address": "srt://100.11.10.10",
                      "cidr_whitelist": [
                        "0.0.0.0/32",
                        "192.168.0.1/16"
                      ],
                      "protocol": "srt-caller",
                      "name": "test_caller",
                      "decryption": {
                        "algorithm": "aes256",
                        "key_type": "srt-password",
                        "passphrase": "******"
                      }
                    }
                  ],
                  "flow_id": "fcbc63d1-06d8-47ba-8fd9-cd0096b72f6d",
                  "status": "STANDBY"
                }
              }
            }
          },
          "400": {
            "description": "流创建失败响应",
            "schema": {
              "$ref": "#/definitions/FlowErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.103011018",
                "error_msg": "The resource to create is already exists"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "FlowOutput": {
      "type": "object",
      "description": "流输出信息",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "名称",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "description": "类型",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "FlowDetailRespBody": {
      "type": "object",
      "description": "响应流详情",
      "required": [
        "name",
        "region",
        "sources",
        "status",
        "flow_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "testflow",
          "description": "流名称",
          "minLength": 1,
          "maxLength": 64
        },
        "region": {
          "type": "string",
          "example": "cn-north-5",
          "description": "区域",
          "minLength": 1,
          "maxLength": 64
        },
        "sources": {
          "type": "array",
          "description": "入流信息",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/FlowSource"
          }
        },
        "status": {
          "type": "string",
          "description": "状态",
          "minLength": 1,
          "maxLength": 16
        },
        "flow_id": {
          "type": "string",
          "description": "流id",
          "minLength": 1,
          "maxLength": 64
        },
        "outputs": {
          "type": "array",
          "description": "流输出信息",
          "minItems": 0,
          "maxItems": 12,
          "items": {
            "$ref": "#/definitions/FlowOutput"
          }
        }
      }
    },
    "CreateFlowsRequestBody": {
      "type": "object",
      "description": "创建流请求体",
      "required": [
        "name",
        "region",
        "sources"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "testflow",
          "description": "流名称",
          "minLength": 1,
          "maxLength": 64
        },
        "region": {
          "type": "string",
          "example": "cn-north-5",
          "description": "区域",
          "minLength": 1,
          "maxLength": 64
        },
        "sources": {
          "type": "array",
          "description": "入流信息",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/FlowSource"
          }
        }
      }
    },
    "FlowSourceDecryption": {
      "type": "object",
      "description": "StreamConnect flow解密信息",
      "required": [
        "key_type",
        "passphrase"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "aes128",
            "aes192",
            "aes256"
          ],
          "default": "aes256",
          "description": "加密算法,aes128: 加密算法为aes-128,aes192:加密算法为aes-192,aes256: 加密算法为AES-256"
        },
        "key_type": {
          "type": "string",
          "description": "秘钥类型,speke:使用speke协议获取秘钥,static-key:静态秘钥,srt-password:SRT协议秘钥\n目前仅支持srt-password类型,其他类型暂不支持",
          "enum": [
            "speke",
            "static-key",
            "srt-password"
          ]
        },
        "passphrase": {
          "type": "string",
          "minLength": 10,
          "maxLength": 79,
          "description": "srt解密秘钥,用于flow对srt流进行解密"
        }
      }
    },
    "FlowSource": {
      "type": "object",
      "description": "入流信息",
      "required": [
        "protocol",
        "name"
      ],
      "properties": {
        "source_listener_address": {
          "type": "string",
          "example": "",
          "description": "拉流地址",
          "minLength": 0,
          "maxLength": 255
        },
        "source_listener_port": {
          "type": "integer",
          "format": "int32",
          "example": 5000,
          "description": "拉流端口,2077/2088不可选",
          "minimum": 1024,
          "maximum": 65535
        },
        "stream_id": {
          "type": "string",
          "example": "",
          "description": "srt拉流streamid",
          "minLength": 1,
          "maxLength": 512
        },
        "min_latency": {
          "type": "integer",
          "format": "int32",
          "example": null,
          "description": "最小时延,单位ms",
          "minimum": 10,
          "maximum": 15000
        },
        "cidr_whitelist": {
          "type": "array",
          "example": "0.0.0.0/0",
          "description": "推流CIDR IP白名单列表",
          "maxItems": 20,
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "description": {
          "type": "string",
          "example": "",
          "description": "描述",
          "minLength": 0,
          "maxLength": 255
        },
        "protocol": {
          "type": "string",
          "example": "srt-caller",
          "description": "协议,srt-caller,srt-listener",
          "enum": [
            "srt-caller",
            "srt-listener"
          ],
          "minLength": 1,
          "maxLength": 16
        },
        "name": {
          "type": "string",
          "example": "",
          "description": "入流资源名称",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^([a-zA-Z0-9\\-_]){1,64}$"
        },
        "decryption": {
          "$ref": "#/definitions/FlowSourceDecryption"
        },
        "health_status": {
          "type": "string",
          "description": "**参数解释**:\n转推流状态\n**约束限制**:\n不涉及\n**取值范围**:\n- CONNECTED:转推中\n- DISCONNECTED:转推中断",
          "default": "DISCONNECTED",
          "enum": [
            "CONNECTED",
            "DISCONNECTED"
          ]
        }
      }
    },
    "FlowErrorResp": {
      "type": "object",
      "description": "流失败响应",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "example": "LIVE.10301101",
          "minLength": 1,
          "maxLength": 64,
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "The resource to create is already exists",
          "minLength": 1,
          "maxLength": 64,
          "description": "错误描述"
        }
      }
    },
    "FlowCreateResp": {
      "type": "object",
      "description": "创建流响应体",
      "required": [
        "flow"
      ],
      "properties": {
        "flow": {
          "description": "流信息",
          "$ref": "#/definitions/FlowDetailRespBody"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目ID,获取方法请参考[获取项目ID](live_03_0023.xml)。",
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "required": false,
      "minLength": 1,
      "maxLength": 256,
      "description": "使用AK/SK方式认证时必填,携带的鉴权信息。",
      "type": "string",
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": false,
      "description": "用户Token,使用Token鉴权方式时必填。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,携带项目ID信息。",
      "minLength": 1,
      "maxLength": 64,
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,请求的发生时间。",
      "minLength": 1,
      "maxLength": 256,
      "type": "string",
      "x-example": "20191115T033655Za"
    }
  },
  "host": "live.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
