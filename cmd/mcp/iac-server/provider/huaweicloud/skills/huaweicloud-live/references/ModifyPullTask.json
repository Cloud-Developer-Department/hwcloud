{
  "name": "ModifyPullTask",
  "summary": "修改直播拉流转推任务",
  "tags": "拉流管理",
  "productshort": "Live",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/pull/stream/task": {
      "put": {
        "x-api-type": "open-api",
        "x-request-examples-url-1": "PUT https://{endpoint}/v1/{project_id}/pull/stream/task",
        "x-request-examples-text-1": {
          "task_id": "xxxxxxxxxx",
          "status": "pause",
          "source_urls": [
            "rtmp://play.example.huawei.com/live/stream1"
          ],
          "start_time": "2018-05-19T18:00:00Z",
          "end_time": "2018-05-19T21:00:00Z",
          "vod_loop_time": "-1",
          "vod_refresh_type": "immediate_new_source",
          "vod_start_video_index": 0,
          "vod_start_video_time": 0,
          "callback_events": [
            "TaskStart",
            "VodSourceFileStart",
            "VodSourceFileFinish",
            "ResetTaskConfig",
            "TaskExit",
            "TaskAlarm"
          ]
        },
        "x-request-examples-1": {
          "task_id": "xxxxxxxxxx",
          "status": "pause",
          "source_urls": [
            "rtmp://play.example.huawei.com/live/stream1"
          ],
          "start_time": "2018-05-19T18:00:00Z",
          "end_time": "2018-05-19T21:00:00Z",
          "vod_loop_time": "-1",
          "vod_refresh_type": "immediate_new_source",
          "vod_start_video_index": 0,
          "vod_start_video_time": 0,
          "callback_events": [
            "TaskStart",
            "VodSourceFileStart",
            "VodSourceFileFinish",
            "ResetTaskConfig",
            "TaskExit",
            "TaskAlarm"
          ]
        },
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "x-open-region-cloud": "hc,hk",
        "tags": [
          "拉流管理"
        ],
        "summary": "修改直播拉流转推任务",
        "description": "修改直播拉流转推任务,仅当source_type为PullVodPushLive的任务生效",
        "operationId": "ModifyPullTask",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "ModifyPullTaskRequestBody",
            "in": "body",
            "required": true,
            "description": "转推任务配置信息",
            "schema": {
              "$ref": "#/definitions/ModifyLivePullStreamTask"
            }
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "responses": {
          "200": {
            "description": "修改直播拉流转推任务成功",
            "schema": {
              "$ref": "#/definitions/CreatePullTaskResponseBody"
            },
            "examples": {
              "application/json": {
                "task_id": "7864b3dc-e92f-42db-a754-08e627b6d8dd",
                "request_id": "85968475-e92f-42db-a754-08e627b6d8dd"
              }
            }
          },
          "400": {
            "description": "修改直播拉流转推任务失败",
            "schema": {
              "$ref": "#/definitions/PullPushErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Request Illegal",
                "request_id": "85968475-e92f-42db-a754-08e627b6d8dd"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ModifyLivePullStreamTask": {
      "type": "object",
      "required": [
        "task_id"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务id",
          "minLength": 0,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "example": "pause",
          "enum": [
            "pause",
            "enable"
          ],
          "description": "pause停用/enable启用",
          "minLength": 0,
          "maxLength": 64
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "example": [
            "rtmp://play.example.huawei.com/live/stream1"
          ],
          "description": "拉流源URL",
          "minItems": 1,
          "maxItems": 30
        },
        "vod_loop_time": {
          "type": "string",
          "description": "缺省值”-1”。-1:无限轮播,以结束时间为准;N:按文件列表播放N轮,以播放完成和结束时间先到的为准。不传、为空(\"\")时按缺省值生效",
          "example": -1,
          "minLength": 0,
          "maxLength": 10
        },
        "vod_refresh_type": {
          "type": "string",
          "description": "缺省值 immediate_new_source,可选 immediate_new_source、continue_from_file_start、continue_from_break_point",
          "example": "immediate_new_source",
          "enum": [
            "immediate_new_source",
            "continue_from_file_start",
            "continue_from_break_point"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "vod_start_video_index": {
          "type": "integer",
          "description": "缺省值 0,指定播放文件的下标,从0开始表示第一个文件,最大值 len(source_urls)-1",
          "example": 0,
          "minimum": 0,
          "maximum": 2147483647
        },
        "start_time": {
          "type": "string",
          "format": "date-time",
          "example": "2018-05-19T18:00:00Z",
          "description": "任务启动时间,时间格式:\n\"2006-01-02T15:04:05Z\"\n必须小于结束时间,缺省为当前时间"
        },
        "end_time": {
          "type": "string",
          "format": "date-time",
          "example": "2018-05-19T21:00:00Z",
          "description": "任务结束时间,时间格式:\n\"2006-01-02T15:04:05Z\"\n必须大于开始时间,至多为开始时间+7天"
        },
        "vod_start_video_time": {
          "type": "integer",
          "description": "缺省值 0,指定从上述指定文件的第几秒开始播放",
          "example": 0,
          "minimum": 0,
          "maximum": 2147483647
        },
        "callback_events": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "TaskStart",
              "VodSourceFileStart",
              "VodSourceFileFinish",
              "ResetTaskConfig",
              "TaskExit",
              "TaskAlarm"
            ]
          },
          "example": [
            "TaskStart",
            "VodSourceFileStart",
            "VodSourceFileFinish",
            "ResetTaskConfig",
            "TaskExit",
            "TaskAlarm"
          ],
          "description": "要回调的事件列表(不填则回调全部)\n- TaskStart:任务启动回调\n- TaskExit:任务停止回调\n- VodSourceFileStart 仅PullVodPushLive可用,文件启动切换\n- VodSourceFileFinish 仅PullVodPushLive可用,文件播放完毕\n- ResetTaskConfig 仅PullVodPushLive可用,任务更新\n- TaskAlarm: 用于告警事件通知",
          "minItems": 0,
          "maxItems": 6
        }
      }
    },
    "CreatePullTaskResponseBody": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务id",
          "minLength": 1,
          "maxLength": 64,
          "example": "7864b3dc-e92f-42db-a754-08e627b6d8dd"
        },
        "request_id": {
          "type": "string",
          "description": "请求id",
          "minLength": 1,
          "maxLength": 64,
          "example": "58684758-e92f-42db-a754-08e627b6d8dd"
        }
      }
    },
    "PullPushErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "maxLength": 32,
          "minLength": 1
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "maxLength": 1024,
          "minLength": 0
        },
        "request_id": {
          "type": "string",
          "description": "请求id",
          "minLength": 1,
          "maxLength": 64,
          "example": "58684758-e92f-42db-a754-08e627b6d8dd"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目ID,获取方法请参考[获取项目ID](live_03_0023.xml)。",
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": false,
      "description": "用户Token,使用Token鉴权方式时必填。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "host": "live.cn-east-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}