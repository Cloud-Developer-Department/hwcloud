  "definitions": {
    "ListCesInstanceRequestBody": {
      "type": "object",
      "description": "查询medialive维度(medialive_mpc、medialive_cdn、medialive_package、medialive_connect、medialive_tailor)\nmedialive_mpc维度可以查询实例下的pipeline实例及pipeline下的音频实例",
      "required": [
        "namespace",
        "query"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "example": "SYS.LIVE",
          "description": "命名空间",
          "minLength": 1,
          "maxLength": 256,
          "enum": [
            "SYS.LIVE"
          ]
        },
        "query": {
          "type": "array",
          "items": {
            "required": [
              "dim_name"
            ],
            "properties": {
              "dim_name": {
                "type": "string",
                "example": "medialive_mpc",
                "minLength": 1,
                "maxLength": 256,
                "description": "维度名称"
              },
              "id": {
                "type": "string",
                "description": "维度id",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "minItems": 1,
          "maxItems": 12,
          "description": "查询信息"
        },
        "start": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "查询开始偏移"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "example": 100,
          "description": "查询限制"
        }
      }
    },
    "ListCesInstanceRspBody": {
      "type": "object",
      "description": "实例查询查询响应",
      "required": [
        "instances",
        "total"
      ],
      "properties": {
        "instances": {
          "type": "array",
          "items": {
            "required": [
              "medialive_mpc"
            ],
            "properties": {
              "medialive_mpc": {
                "description": "媒体直播转码服务",
                "properties": {
                  "id": {
                    "type": "string",
                    "example": "test1112",
                    "description": "频道id",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "name": {
                    "type": "string",
                    "example": "test1112",
                    "description": "频道名",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              },
              "pipeline": {
                "description": "通道",
                "properties": {
                  "id": {
                    "type": "string",
                    "example": "Pipeline0",
                    "description": "pipeline id",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "name": {
                    "type": "string",
                    "example": "Pipeline0",
                    "description": "pipeline name",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              },
              "audio": {
                "description": "音频",
                "properties": {
                  "id": {
                    "type": "string",
                    "example": "Audio0",
                    "description": "频道id",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "name": {
                    "type": "string",
                    "example": "Audio0",
                    "description": "频道name",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              }
            }
          },
          "description": "实例",
          "minItems": 1,
          "maxItems": 12
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "example": 5,
          "description": "总数",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "CesErrorResp": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 0,
          "maxLength": 64
        },
        "error_msg": {
          "type": "string",
          "description": "错误内容",
          "minLength": 0,
          "maxLength": 128
        }
      }
    }
