          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "RECORD_NEW_FILE_START",
              "RECORD_FILE_COMPLETE",
              "RECORD_OVER",
              "RECORD_FAILED"
            ],
            "default": "RECORD_FILE_COMPLETE",
            "maxLength": 64,
            "minLength": 1
          }
        },
        "sign_type": {
          "type": "string",
          "description": "加密类型",
          "enum": [
            "MD5",
            "HMACSHA256"
          ]
        },
        "create_time": {
          "type": "string",
          "description": "创建时间,格式:yyyy-mm-ddThh:mm:ssZ,UTC时间。 在查询的时候返回",
          "maxLength": 64,
          "minLength": 1,
          "format": "date"
        },
        "update_time": {
          "type": "string",
          "description": "修改时间,格式:yyyy-mm-ddThh:mm:ssZ,UTC时间。 在查询的时候返回",
          "maxLength": 64,
          "minLength": 1,
          "format": "date"
        }
      }
    },
    "RecordCallbackConfigRequest": {
      "required": [
        "publish_domain",
        "app"
      ],
      "properties": {
        "publish_domain": {
          "type": "string",
          "description": "直播推流域名",
          "maxLength": 256,
          "minLength": 1
        },
        "app": {
          "type": "string",
          "description": "app名称。如果需要匹配任意应用则需填写*。录制规则匹配的时候,优先精确app匹配,如果匹配不到,则匹配*",
          "maxLength": 128,
          "minLength": 1
        },
        "notify_callback_url": {
          "type": "string",
          "description": "录制回调通知url地址",
          "maxLength": 1024,
          "minLength": 1
        },
        "notify_event_subscription": {
          "type": "array",
          "description": "订阅录制通知消息。消息类型。RECORD_NEW_FILE_START开始创建新的录制文件。RECORD_FILE_COMPLETE录制文件生成完成。RECORD_OVER录制结束。RECORD_FAILED表示录制失败。如果不填写,默认订阅RECORD_FILE_COMPLETE",
          "maxItems": 10,
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "RECORD_NEW_FILE_START",
              "RECORD_FILE_COMPLETE",
              "RECORD_OVER",
              "RECORD_FAILED"
            ],
            "default": "RECORD_FILE_COMPLETE",
            "maxLength": 64,
            "minLength": 1
          }
        },
        "sign_type": {
          "type": "string",
          "description": "加密类型",
          "enum": [
            "MD5",
            "HMACSHA256"
          ]
        },
        "key": {
          "type": "string",
          "description": "回调秘钥,主要用于鉴权。为了保护用户数据信息安全,建议填写。",
          "maxLength": 32,
          "minLength": 1
        }
      }
    }
  },
