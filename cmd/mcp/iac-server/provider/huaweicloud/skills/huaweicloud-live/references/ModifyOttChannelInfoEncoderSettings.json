  "definitions": {
    "ModifyOttChannelEncoderSettings": {
      "description": "OTT频道通用消息",
      "required": [
        "domain",
        "app_name",
        "id"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "description": "频道推流域名",
          "minLength": 1,
          "maxLength": 255,
          "example": "www.huaweiott.pushdomain.com"
        },
        "app_name": {
          "type": "string",
          "description": "组名或应用名",
          "minLength": 1,
          "maxLength": 64,
          "example": "live"
        },
        "id": {
          "type": "string",
          "description": "频道ID。频道唯一标识,为必填项",
          "minLength": 2,
          "maxLength": 512,
          "example": "channelId"
        },
        "encoder_settings": {
          "description": "转码模板配置",
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "description": "转码模板配置项",
            "properties": {
              "template_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "description": "转码模板ID"
              }
            }
          }
        }
      },
      "type": "object"
    },
    "SourceRsp": {
      "type": "object",
      "description": "RTMP推流地址。只有频道入流协议为RTMP_PUSH时,会返回RTMP推流地址",
      "properties": {
        "url": {
          "type": "string",
          "example": "string",
          "description": "RTMP推流地址",
          "minLength": 1,
          "maxLength": 1024
        },
        "bitrate": {
          "type": "integer",
          "format": "int32",
          "example": 104857600,
          "description": "码率。\n\n单位:bps。取值范围:(0,104,857,600](100Mbps)",
          "minimum": 0,
          "maximum": 104857600
        },
        "width": {
          "type": "integer",
          "format": "int32",
          "example": 4096,
          "description": "分辨率对应宽的值。取值范围:0 - 4096(4K)",
          "minimum": 0,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "format": "int32",
          "example": 2160,
          "description": "分辨率对应高的值。取值范围:0 - 2160(4K)",
          "minimum": 0,
          "maximum": 2160
        },
        "enable_snapshot": {
          "type": "boolean",
          "example": false,
          "description": "描述是否使用该流做截图"
        }
      }
    },
    "SuccessRsp": {
      "description": "创建成功响应",
      "properties": {
        "result_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "description": "错误码"
        },
        "result_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "错误描述"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "推流域名"
        },
        "app_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "组名或应用名,为必填项"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "频道ID。频道唯一标识,为必填项"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/SourceRsp"
          },
          "description": "推流URL列表。创建频道时,只有入流协议为RTMP_PUSH时,会返回推流URL列表",
          "type": "array",
          "minItems": 1,
          "maxItems": 12
        }
      },
      "type": "object"
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "result_code",
        "result_msg"
      ],
      "properties": {
