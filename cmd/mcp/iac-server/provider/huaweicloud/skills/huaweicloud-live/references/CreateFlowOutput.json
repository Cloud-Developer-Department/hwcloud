{
  "name": "CreateFlowOutput",
  "summary": "创建转推输出",
  "tags": "流连接管理",
  "productshort": "Live",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/flows/outputs": {
      "post": {
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/flows/outputs",
        "x-request-examples-text-1": [
          {
            "name": "test",
            "protocol": "srt-caller",
            "destination": "10.10.10.10",
            "port": 2000,
            "cidr_whitelist": [
              "0.0.0.0/0"
            ],
            "encryption": {
              "algorithm": "aes256",
              "key_type": "srt-password",
              "passphrase": "aaabbbcccd"
            },
            "output_status": "ENABLED",
            "description": "aaaaa",
            "min_latency": 1000
          }
        ],
        "x-request-examples-1": [
          {
            "name": "test",
            "protocol": "srt-caller",
            "destination": "10.10.10.10",
            "port": 2000,
            "cidr_whitelist": [
              "0.0.0.0/0"
            ],
            "encryption": {
              "algorithm": "aes256",
              "key_type": "srt-password",
              "passphrase": "******"
            },
            "output_status": "ENABLED",
            "description": "aaaaa",
            "min_latency": 1000
          }
        ],
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "tags": [
          "流连接管理"
        ],
        "summary": "创建转推输出",
        "description": "创建转推输出",
        "operationId": "CreateFlowOutput",
        "produces": [
          "application/json;charset=utf-8"
        ],
        "consumes": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "flow_id",
            "in": "query",
            "required": true,
            "description": "流id",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "CreateFlowOutputRequestBody",
            "in": "body",
            "description": "创建output消息体",
            "required": true,
            "schema": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "$ref": "#/definitions/AddFlowOutputsRequest"
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/AddFlowOutputsResponse"
            },
            "examples": {
              "application/json": {
                "flow_id": "ec897482-d24b-4d64-aa39-407980902b1d",
                "outputs": [
                  {
                    "name": "test",
                    "type": "Standard output",
                    "protocol": "srt-caller",
                    "destination": "10.10.10.10",
                    "min_latency": 1000,
                    "port": 2000,
                    "cidr_whitelist": [
                      "0.0.0.0/0"
                    ],
                    "encryption": {
                      "algorithm": "aes256",
                      "key_type": "srt-password",
                      "passphrase": "******"
                    },
                    "health_status": "DISCONNECTED",
                    "output_status": "ENABLED",
                    "description": "aaaaa"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "流输出创建失败响应",
            "schema": {
              "$ref": "#/definitions/DefaultErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "outputs[0] name test has been exist"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "FlowsOutput": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "cidr_whitelist": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "string",
            "readOnly": true,
            "minLength": 0,
            "maxLength": 1024
          },
          "description": "ip白名单,最大20条ip白名单",
          "example": "[0.0.0.0/0, 10.10.11.1/24]"
        },
        "destination": {
          "type": "string",
          "description": "推流地址,支持ip和域名,最大值64",
          "minLength": 1,
          "maxLength": 64,
          "example": "10.1.2.30"
        },
        "name": {
          "type": "string",
          "description": "output名称,有效字符:大小写字母,数字,中划线,下划线;且只能以字母开头",
          "minLength": 1,
          "maxLength": 64,
          "example": "output_name_xxx"
        },
        "encryption": {
          "$ref": "#/definitions/FlowSourceDecryption"
        },
        "output_status": {
          "type": "string",
          "default": "ENABLED",
          "description": "输出状态,ENABLED:启用,DISABLED:禁用",
          "enum": [
            "ENABLED",
            "DISABLED"
          ],
          "example": "ENABLED"
        },
        "listener_address": {
          "type": "string",
          "description": "srt-listener模式,监听地址,不支持修改",
          "minLength": 7,
          "maxLength": 15,
          "example": "10.1.2.30"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "minimum": 1024,
          "maximum": 65535,
          "description": "端口,如果ssrt-listener为监听端口,那么srt-caller为对端端口",
          "example": 2025
        },
        "protocol": {
          "type": "string",
          "description": "协议,srt-caller,srt-listener",
          "enum": [
            "srt-listener",
            "srt-caller"
          ],
          "example": "srt-caller"
        },
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "srt-caller模式支持设置streamid",
          "example": "m=request"
        },
        "description": {
          "type": "string",
          "description": "输出描述",
          "minLength": 1,
          "maxLength": 255,
          "example": "这是个srt-caller的输出"
        },
        "min_latency": {
          "type": "integer",
          "format": "int32",
          "description": "最小时延,单位毫秒,默认值2000,最小值10,最大值15000",
          "default": 2000,
          "minimum": 10,
          "maximum": 15000,
          "example": 2000
        },
        "health_status": {
          "type": "string",
          "description": "转推流状态,CONNECTED:转推中,DISCONNECTED:转推中断",
          "default": "DISCONNECTED",
          "enum": [
            "DISCONNECTED",
            "CONNECTED"
          ],
          "example": "DISCONNECTED"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "输出类型",
          "example": "Standard output"
        }
      }
    },
    "AddFlowOutputsRequest": {
      "type": "object",
      "required": [
        "name",
        "protocol"
      ],
      "properties": {
        "cidr_whitelist": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "string",
            "readOnly": true,
            "minLength": 0,
            "maxLength": 1024
          },
          "description": "ip白名单,最大20条ip白名单",
          "example": "[0.0.0.0/0, 10.10.11.1/24]"
        },
        "destination": {
          "type": "string",
          "description": "推流地址,支持ip和域名,最大值64",
          "minLength": 1,
          "maxLength": 64,
          "example": "10.1.2.30"
        },
        "name": {
          "type": "string",
          "description": "output名称,有效字符:大小写字母,数字,中划线,下划线;且只能以字母开头",
          "minLength": 1,
          "maxLength": 64,
          "example": "output_name_xxx"
        },
        "encryption": {
          "$ref": "#/definitions/FlowSourceDecryption"
        },
        "output_status": {
          "type": "string",
          "description": "输出状态,ENABLED:启用,DISABLED:禁用",
          "default": "ENABLED",
          "enum": [
            "ENABLED",
            "DISABLED"
          ],
          "example": "ENABLED"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "minimum": 1024,
          "maximum": 65535,
          "description": "端口,如果ssrt-listener为监听端口,那么srt-caller为对端端口",
          "example": 2025
        },
        "protocol": {
          "description": "协议,srt-caller,srt-listener",
          "type": "string",
          "enum": [
            "srt-listener",
            "srt-caller"
          ],
          "example": "srt-caller"
        },
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "srt-caller模式支持设置streamid",
          "example": "m=request"
        },
        "description": {
          "type": "string",
          "description": "输出描述",
          "minLength": 1,
          "maxLength": 255,
          "example": "这是个srt-listener的输出"
        },
        "min_latency": {
          "type": "integer",
          "format": "int32",
          "description": "最小时延,单位毫秒,默认值2000,最小值10,最大值15000",
          "default": 2000,
          "minimum": 10,
          "maximum": 15000,
          "example": 2000
        }
      }
    },
    "AddFlowOutputsResponse": {
      "type": "object",
      "properties": {
        "flow_id": {
          "type": "string",
          "description": "流ID",
          "minLength": 1,
          "maxLength": 64,
          "example": "87a09506-ab0f-4b42-8e15-e282f7b9e17e"
        },
        "outputs": {
          "description": "所有输出信息",
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/FlowsOutput"
          }
        }
      }
    },
    "FlowSourceDecryption": {
      "type": "object",
      "description": "StreamConnect flow解密信息",
      "required": [
        "key_type",
        "passphrase"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "aes128",
            "aes192",
            "aes256"
          ],
          "default": "aes256",
          "description": "加密算法,aes128: 加密算法为aes-128,aes192:加密算法为aes-192,aes256: 加密算法为AES-256"
        },
        "key_type": {
          "type": "string",
          "description": "秘钥类型,speke:使用speke协议获取秘钥,static-key:静态秘钥,srt-password:SRT协议秘钥\n目前仅支持srt-password类型,其他类型暂不支持",
          "enum": [
            "speke",
            "static-key",
            "srt-password"
          ]
        },
        "passphrase": {
          "type": "string",
          "minLength": 10,
          "maxLength": 79,
          "description": "srt解密秘钥,用于flow对srt流进行解密"
        }
      }
    },
    "DefaultErrorResp": {
      "type": "object",
      "description": "参数失败响应。",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "LIVE.10001100",
          "description": "错误码。",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "type": "string",
          "example": "Request parameters is invalid",
          "description": "错误描述。",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "required": false,
      "minLength": 1,
      "maxLength": 256,
      "description": "使用AK/SK方式认证时必填,携带的鉴权信息。",
      "type": "string",
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": false,
      "description": "用户Token,使用Token鉴权方式时必填。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目ID,获取方法请参考[获取项目ID](live_03_0023.xml)。",
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,携带项目ID信息。",
      "minLength": 1,
      "maxLength": 64,
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,请求的发生时间。",
      "minLength": 1,
      "maxLength": 256,
      "type": "string",
      "x-example": "20191115T033655Za"
    }
  },
  "host": "live.cn-east-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}