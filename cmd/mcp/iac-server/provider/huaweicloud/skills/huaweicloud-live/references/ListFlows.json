{
  "name": "ListFlows",
  "summary": "获取流列表",
  "tags": "流连接管理",
  "productshort": "Live",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/{project_id}/flows": {
      "get": {
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "tags": [
          "流连接管理"
        ],
        "summary": "获取流列表",
        "description": "获取流列表",
        "consumes": [
          "application/json;charset=utf-8"
        ],
        "operationId": "ListFlows",
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/limit"
          },
          {
            "$ref": "#/parameters/offset"
          }
        ],
        "responses": {
          "200": {
            "description": "查询流列表响应",
            "schema": {
              "$ref": "#/definitions/ListFlowsResp"
            },
            "examples": {
              "application/json": {
                "total": 8,
                "flows": [
                  {
                    "name": "test",
                    "region": "cn-north-5",
                    "flow_id": "fcbc63d1-06d8-47ba-8fd9-cd0096b72f6d",
                    "status": "STANDBY",
                    "description": "test",
                    "protocol": "srt-caller"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/FlowErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Request parameters is invalid"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "FlowErrorResp": {
      "type": "object",
      "description": "流失败响应",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "example": "LIVE.10301101",
          "minLength": 1,
          "maxLength": 64,
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "The resource to create is already exists",
          "minLength": 1,
          "maxLength": 64,
          "description": "错误描述"
        }
      }
    },
    "ListFlowsResp": {
      "type": "object",
      "description": "获取流列表响应",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "总数",
          "minimum": 0,
          "maximum": 1000
        },
        "flows": {
          "type": "array",
          "description": "流列表",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/ListFlowRespItem"
          }
        }
      },
      "required": [
        "total",
        "flows"
      ]
    },
    "ListFlowRespItem": {
      "type": "object",
      "description": "响应流列表项",
      "required": [
        "name",
        "region",
        "flow_id",
        "status",
        "protocol"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "",
          "description": "流名称",
          "minLength": 1,
          "maxLength": 64
        },
        "region": {
          "type": "string",
          "example": "cn-north-5",
          "description": "区域",
          "minLength": 1,
          "maxLength": 64
        },
        "flow_id": {
          "type": "string",
          "example": "6b415329-808f-4736-bc24-7d2e4866bd5c",
          "description": "流id",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "example": "STANDBY",
          "description": "当前状态,ACTIVE运行中,STANDBY未启动",
          "enum": [
            "ACTIVE",
            "STANDBY"
          ],
          "minLength": 1,
          "maxLength": 16
        },
        "description": {
          "type": "string",
          "example": "",
          "description": "描述",
          "minLength": 1,
          "maxLength": 255
        },
        "protocol": {
          "type": "string",
          "example": "srt-caller",
          "description": "协议,srt-caller,srt-listener",
          "enum": [
            "srt-caller",
            "srt-listener"
          ],
          "minLength": 1,
          "maxLength": 16
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "required": false,
      "minLength": 1,
      "maxLength": 256,
      "description": "使用AK/SK方式认证时必填,携带的鉴权信息。",
      "type": "string",
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": false,
      "description": "用户Token,使用Token鉴权方式时必填。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目ID,获取方法请参考[获取项目ID](live_03_0023.xml)。",
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "offset": {
      "name": "offset",
      "in": "query",
      "required": false,
      "description": "偏移量,表示从此偏移量开始查询,offset大于等于0",
      "default": 0,
      "minimum": 0,
      "type": "integer",
      "format": "int32",
      "allowEmptyValue": false
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,携带项目ID信息。",
      "minLength": 1,
      "maxLength": 64,
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,请求的发生时间。",
      "minLength": 1,
      "maxLength": 256,
      "type": "string",
      "x-example": "20191115T033655Za"
    },
    "limit": {
      "name": "limit",
      "in": "query",
      "required": false,
      "description": "每页记录数\n\n取值范围[1,100]\n\n默认值:10",
      "default": 10,
      "minimum": 1,
      "maximum": 100,
      "type": "integer",
      "format": "int32"
    }
  },
  "host": "live.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}