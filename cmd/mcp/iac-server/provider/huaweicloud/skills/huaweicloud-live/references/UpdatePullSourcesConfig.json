  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "ModifyPullSourcesConfig": {
      "type": "object",
      "required": [
        "play_domain",
        "source_type"
      ],
      "properties": {
        "play_domain": {
          "type": "string",
          "description": "直播播放域名",
          "example": "pull.test.com"
        },
        "source_type": {
          "type": "string",
          "description": "回源方式。\n\n包含如下取值:\n- domain: 回源客户源站,源站地址是域名格式。回源域名,可配置多个,如果回源失败,将按照配置顺序进行轮循。\n- ipaddr: 回源客户源站,源站地址是IP格式。回源IP,可配置多个,如果回源失败,将按照配置顺序进行轮循。同时,最多可以配置一个回源域名,如果配置,回源时httpflv HOST头填该域名,RTMP tcurl字段填该域名,否则按当前IP作为HOST。\n- huawei: 回源华为源站,域名创建后的默认值。",
          "example": "domain",
          "enum": [
            "domain",
            "ipaddr",
            "huawei"
          ]
        },
        "sources": {
          "type": "array",
          "description": "回源域名列表,最多可配置10个。\n- 当回源方式是“domain”时,此参数必选,域名配置多个时,如果回源失败,将按照配置顺序进行轮循。\n- 当回源方式是“ipaddr”时,最多可以配置一个回源域名,如果配置,回源时httpflv HOST头填该域名,RTMP tcurl 字段填该域名,否则按当前IP作为HOST。",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "sources_ip": {
          "type": "array",
          "description": "回源IP地址列表,最多可配置10个。当回源方式是“ipaddr”时,此参数必选,IP配置多个时,如果回源失败,将按照配置顺序进行轮循。",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "source_port": {
          "type": "integer",
          "description": "回源端口。",
          "example": 1934,
          "minimum": 1,
          "maximum": 65535
        },
        "scheme": {
          "type": "string",
          "description": "回源协议,回源方式非“huawei”时必选。\n\n包含如下取值:\n- http\n- rtmp",
          "example": "http",
          "enum": [
            "http",
            "rtmp"
          ]
        },
        "additional_args": {
          "type": "object",
          "description": "回源客户源站时在URL携带的参数。",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
