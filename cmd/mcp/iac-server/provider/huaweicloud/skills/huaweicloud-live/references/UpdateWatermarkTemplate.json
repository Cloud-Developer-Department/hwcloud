  "definitions": {
    "WordWaterMarkInfo": {
      "type": "object",
      "required": [
        "format",
        "location"
      ],
      "properties": {
        "format": {
          "type": "string",
          "description": "水印文字内容,必填 字幕内容1-64\ntype为1或2时必填,type为0时非必填",
          "minLength": 1,
          "maxLength": 64
        },
        "font_color": {
          "type": "string",
          "description": "参数校验:首位为#、除#外为6位或8位,每位字符由 0-9、a~f、A~F 组成【务必校验,错误时转码默认白色】",
          "default": "#000000",
          "minLength": 7,
          "maxLength": 9
        },
        "font_size": {
          "type": "integer",
          "format": "int32",
          "description": "字体大小",
          "default": 14,
          "minimum": 4,
          "maximum": 72
        },
        "font": {
          "type": "string",
          "description": "字体,缺省值 空,可选值:harmonyRegular(鸿蒙)、douyu2.0(斗鱼追光体)",
          "minLength": 1,
          "maxLength": 20
        },
        "time_zone": {
          "type": "string",
          "description": "时区,【取值参考 UTC-1200 至 UTC+1200,前三位UTC,第四位+或-,五六位表示小时,七八位固定00】",
          "default": "UTC+0800",
          "example": "UTC+0800",
          "minLength": 8,
          "maxLength": 8
        },
        "shadow_color": {
          "type": "string",
          "description": "缺省值 none,参数校验:首位为#、除#外为6位或8位,每位字符由 0-9、a~f、A~F 组成【务必校验,错误时转码默认黑色】",
          "example": "#000000",
          "minLength": 7,
          "maxLength": 9
        },
        "location": {
          "description": "location位置必填",
          "$ref": "#/definitions/WatermarkLocation"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "WatermarkTemplate": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "水印模板名称",
          "maxLength": 255,
          "minLength": 1
        },
        "type": {
          "type": "integer",
          "description": "水印类型,0图片,1文字,2图文共存",
          "maximum": 1,
          "minimum": 0
        },
        "description": {
          "type": "string",
          "description": "模板注释",
          "maxLength": 512,
          "minLength": 0
        },
        "picture_url": {
          "type": "string",
          "description": "图片下载路径\n校验规则:图片URL长度大于0,最大长度2048,能够正常按URL格式解析,必须是 http 或 https 协议。(OTT 场景限制只支持https)\n图片格式: .png/.jpg/.PNG/.JPG结尾",
          "maxLength": 2048,
          "minLength": 1
        },
        "width": {
          "type": "number",
          "description": "1)整数型代表水印图片宽的像素值,范围0或[8,4096],单位px。\n2)小数型代表相对输出视频分辨率宽的比率,范围[0,1)\n建议宽高只设置一项,另外一项会自适应缩放,避免变形。宽高全部设置为0表示水印图片原始宽高\n百分比限制最多保留小数点后4位,width和height 只支持同时为像素或是百分比,不支持一个像素,一个百分比",
          "maximum": 4096,
          "minimum": 0
        },
        "height": {
          "type": "number",
          "description": "水印图片高,值有两种形式:\n1)整数型代表水印图片高的像素值,范围0或[8,4096],单位px。\n2)小数型代表相对输出视频分辨率高的比率,范围[0,1)\n建议宽高只设置一项,另外一项会自适应缩放,避免变形。宽高全部设置为0表示水印图片原始宽高\n百分比限制最多保留小数点后4位,width和height 只支持同时为像素或是百分比,不支持一个像素,一个百分比",
          "maximum": 4096,
          "minimum": 0
        },
        "location": {
          "description": "水印位置",
          "$ref": "#/definitions/WatermarkLocation"
        },
        "text": {
          "description": "文字水印信息",
          "$ref": "#/definitions/WordWaterMarkInfo"
        },
        "scene": {
          "type": "string",
          "description": "业务属性,cloud_live:云直播,默认值;media_live:媒体直播,不支持修改",
          "default": "cloud_live",
          "enum": [
            "cloud_live",
            "media_live"
          ],
          "minLength": 1,
          "maxLength": 32
        }
      },
      "type": "object"
    },
    "WatermarkLocation": {
      "properties": {
        "location": {
          "type": "string",
          "description": "水印位置。\n\n包含如下选项:\n- TOPLEFT:左上\n- TOPRIGHT:右上\n- BOTTOMLEFT:左下\n- BOTTOMRIGHT:右下\n- RANDOM:随机模式,图片水印将随机在视频流的左上、右上、左下、右下四个位置展示。",
          "maxLength": 255,
          "minLength": 1,
          "enum": [
            "TOPLEFT",
            "TOPRIGHT",
            "BOTTOMLEFT",
            "BOTTOMRIGHT",
            "RANDOM"
          ]
        },
        "x_offset": {
          "type": "number",
          "description": "水印相对输出视频的水平偏移量。\n说明:值有两种形式:\n1)整数型代表偏移像素,范围[1,4096],单位px。\n2)小数型代表水平偏移量与输出分辨率宽的比率,范围[0,1)\n百分比限制最多保留小数点后4位",
          "maximum": 4096,
          "minimum": 0
        },
        "y_offset": {
          "type": "number",
          "description": "水印相对输出视频的垂直偏移量\n说明: 值有两种形式:\n1)整数型代表偏移像素,范围[1,4096],单位px。\n2)小数型代表垂直偏移量与输出分辨率高的比率,范围[0,1)\n百分比限制最多保留小数点后4位",
          "maximum": 4096,
          "minimum": 0
        }
      },
      "type": "object"
    }
  },
