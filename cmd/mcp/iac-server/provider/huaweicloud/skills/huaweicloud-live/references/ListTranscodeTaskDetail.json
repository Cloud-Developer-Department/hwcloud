{
  "name": "ListTranscodeTaskDetail",
  "summary": "查询转码明细",
  "tags": "数据统计分析",
  "productshort": "Live",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v2/{project_id}/stats/transcode/detail": {
      "get": {
        "tags": [
          "DataStatisticsAnalysis"
        ],
        "summary": "查询转码明细",
        "description": "查询流粒度转码明细,包含流名、模版、格式、时长。\n最大查询跨度1天,最大查询周期14天。\n",
        "operationId": "ListTranscodeTaskDetail",
        "deprecated": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-external-api": true,
        "x-interface-frequency": "HIGH",
        "x-api-type": "open-api",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息, 与路径参数中的项目ID相同。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-live/live_03_0023.html)。\n",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "query",
            "name": "domain",
            "description": "推流域名。\n",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "required": true
          },
          {
            "name": "stream_name_list",
            "in": "query",
            "description": "流名列表,以逗号分隔,最多支持查询100个流名。\n如果不传入流名,则查询域名下所有转码流的数据。\n",
            "type": "array",
            "minItems": 0,
            "maxItems": 100,
            "required": false,
            "items": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "start_time",
            "description": "起始时间。日期格式按照ISO8601表示法,并使用UTC时间。\n\n格式为:YYYY-MM-DDThh:mm:ssZ。最大查询跨度1天,最大查询周期14天。\n\n若参数为空,默认查询1天数据。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 64
          },
          {
            "in": "query",
            "name": "end_time",
            "description": "结束时间。日期格式按照ISO8601表示法,并使用UTC时间。\n\n格式为:YYYY-MM-DDThh:mm:ssZ。最大查询跨度1天,最大查询周期14天。\n\n若参数为空,默认为当前时间。结束时间需大于起始时间。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 64
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。\n",
            "schema": {
              "$ref": "#/definitions/TranscodeDetailRsp"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求的唯一标识。"
              }
            },
            "examples": {
              "application/json": {
                "domain": "publish.example.***.com",
                "start_time": "2024-10-24T10:00:00Z",
                "end_time": "2024-10-25T10:00:00Z",
                "transcode_detail_list": [
                  {
                    "stream_name": "stream-xxxxxx_ld",
                    "template": "ld",
                    "code_rate_format": "H264",
                    "duration": 1000
                  },
                  {
                    "stream_name": "stream-xxxxxx_hd5",
                    "template": "hd5",
                    "code_rate_format": "H265",
                    "duration": 1300
                  }
                ]
              }
            }
          },
          "400": {
            "description": "处理失败返回。\n",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求的唯一标识。"
              }
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Invalid request parameter: domain"
              }
            }
          }
        },
        "x-request-examples-description-1": "查询转码详情",
        "x-request-examples-url-1": "GET /v2/{project_id}/stats/transcode/detail?domain=publish.example.com\n"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "TranscodeDetailRsp": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "description": "推流域名",
          "minLength": 0,
          "maxLength": 512
        },
        "start_time": {
          "type": "string",
          "description": "采样开始时间。日期格式按照ISO8601表示法,并使用UTC时间。 格式为:YYYY-MM-DDThh:mm:ssZ。",
          "minLength": 0,
          "maxLength": 64
        },
        "end_time": {
          "type": "string",
          "description": "采样结束时间。日期格式按照ISO8601表示法,并使用UTC时间。 格式为:YYYY-MM-DDThh:mm:ssZ。",
          "minLength": 0,
          "maxLength": 64
        },
        "transcode_detail_list": {
          "type": "array",
          "description": "流粒度转码明细",
          "minItems": 0,
          "maxItems": 86400,
          "items": {
            "$ref": "#/definitions/TranscodeDetailInfo"
          }
        }
      }
    },
    "TranscodeDetailInfo": {
      "type": "object",
      "properties": {
        "stream_name": {
          "type": "string",
          "description": "流名",
          "minLength": 0,
          "maxLength": 512
        },
        "template": {
          "type": "string",
          "description": "转码模板",
          "minLength": 0,
          "maxLength": 64
        },
        "code_rate_format": {
          "type": "string",
          "description": "转码格式(H264/H265)",
          "minLength": 0,
          "maxLength": 64
        },
        "duration": {
          "type": "integer",
          "format": "int64",
          "description": "转码时长",
          "minimum": 0,
          "maximum": 1844674407
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "live.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}