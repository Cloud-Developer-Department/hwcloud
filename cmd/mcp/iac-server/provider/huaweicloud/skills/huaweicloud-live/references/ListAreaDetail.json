{
  "name": "ListAreaDetail",
  "summary": "查询直播各区域指标分布接口",
  "tags": "数据统计分析",
  "productshort": "Live",
  "region_id": "cn-north-1",
  "paths": {
    "/v2/{project_id}/stats/area/detail": {
      "get": {
        "tags": [
          "DataStatisticsAnalysis"
        ],
        "summary": "查询直播各区域指标分布接口",
        "description": "查询直播全球区域维度的详细数据接口。\n\n如果不传入域名,则查询租户下所有播放域名的详细数据。\n\n当查询租户级别数据时,参数app、stream不生效。\n\n最大查询跨度1天,最大查询周期90天。\n\n支持查询当天,当前数据延时少于5分钟。\n",
        "operationId": "ListAreaDetail",
        "deprecated": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-external-api": true,
        "x-interface-frequency": "HIGH",
        "x-constraint": "该接口暂只支持查询部署在新版视频直播服务上的域名的相关数据(不包含“华北-北京一”)。此约束条件仅适用于中国站。",
        "x-open-region-cloud": "hc,hk",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息, 与路径参数中的项目ID相同。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-live/live_03_0023.html)。\n",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "query",
            "name": "start_time",
            "description": "查询起始时间。日期格式按照ISO8601表示法,并使用UTC时间。\n\n格式为:YYYY-MM-DDThh:mm:ssZ。最大查询跨度1天,最大查询周期90天。\n",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "2021-12-20T07:00:00Z"
          },
          {
            "in": "query",
            "name": "end_time",
            "description": "查询结束时间。日期格式按照ISO8601表示法,并使用UTC时间。\n\n格式为:YYYY-MM-DDThh:mm:ssZ。最大查询跨度1天,最大查询周期90天。\n",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "2021-12-20T09:00:00Z"
          },
          {
            "in": "query",
            "name": "play_domains",
            "description": "需查询的播放域名列表,最多支持查询100个域名。\n",
            "type": "array",
            "items": {
              "type": "string"
            },
            "required": false,
            "minItems": 1,
            "maxItems": 15,
            "x-example": "pull.sswvisit.com"
          },
          {
            "in": "query",
            "name": "app",
            "description": "需查询的app。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "live"
          },
          {
            "in": "query",
            "name": "stream",
            "type": "string",
            "description": "流名称。",
            "required": false,
            "minLength": 1,
            "maxLength": 256
          },
          {
            "in": "query",
            "name": "interval",
            "description": "查询数据的时间粒度。支持300(默认值)、3600和86400秒。若参数为空,则默认为300秒。\n\n注意,若metric的值为player(观众数),则interval填入的值不起效果,查询粒度interval默认为60秒。\n",
            "type": "integer",
            "format": "int32",
            "required": false,
            "default": 300,
            "enum": [
              300,
              3600,
              86400
            ],
            "minimum": 300,
            "maximum": 86400
          },
          {
            "in": "query",
            "name": "isp",
            "description": "运营商列表,取值如下:\n- CMCC:移动\n- CTCC:电信\n- CUCC:联通\n- OTHER:其他\n\n若参数为空,则查询所有运营商。\n",
            "type": "array",
            "items": {
              "type": "string"
            },
            "required": false,
            "minItems": 0,
            "maxItems": 4,
            "x-example": "CMCC"
          },
          {
            "in": "query",
            "name": "area",
            "description": "需查询的计费大区,取值如下:\n- CN:中国内地。\n- AP1:亚太1区。\n- AP2:亚太2区。\n- AP3:亚太3区。\n- MEAA:中东非洲。\n- SA:南美。\n- EU:欧洲。\n- ALL:全部。\n\n中国内地返回结果为省份/直辖市的中文名称,比如:广东、上海;\n海外大区与地区/国家的对应关系请参考[地区/国家代码对照表](https://support.huaweicloud.com/api-live/live_03_0049.html)。\n",
            "type": "array",
            "items": {
              "type": "string"
            },
            "required": true,
            "minItems": 1,
            "maxItems": 8,
            "x-example": "CN"
          },
          {
            "in": "query",
            "name": "metric",
            "description": "指标,取值如下:\n- bandwidth:带宽\n- traffic:流量\n- player:观众数\n",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "traffic"
          },
          {
            "in": "query",
            "name": "protocol",
            "description": "请求协议,取值如下:\n- flv\n- hls\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "hls"
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。\n",
            "schema": {
              "$ref": "#/definitions/QueryAreaDetailRsp"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求的唯一标识。"
              }
            },
            "examples": {
              "application/json": {
                "data_list": [
                  {
                    "area": "AP2",
                    "summary": [
                      {
                        "time": "2021-12-20T07:00:00Z",
                        "value": 323
                      },
                      {
                        "time": "2021-12-20T09:05:00Z",
                        "value": 325
                      }
                    ],
                    "detail": [
                      {
                        "name": "TH",
                        "data": [
                          {
                            "time": "2021-12-20T07:00:00Z",
                            "value": 223
                          },
                          {
                            "time": "2021-12-20T09:05:00Z",
                            "value": 123
                          }
                        ]
                      },
                      {
                        "name": "PH",
                        "data": [
                          {
                            "time": "2021-12-20T07:00:00Z",
                            "value": 123
                          },
                          {
                            "time": "2021-12-20T09:05:00Z",
                            "value": 223
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误。\n",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求的唯一标识。"
              }
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Invalid request parameter: play_domains"
              }
            }
          }
        },
        "x-request-examples-description-1": "查询区域直播播放域名指标详情",
        "x-request-examples-url-1": "GET /v2/{project_id}/stats/area/detail?start_time=2021-12-20T07:00:00Z&end_time=2021-12-20T07:00:00Z&play_domains=example.xxx.com&area=CN&metric=traffic\n"
      }
    }
  },
  "definitions": {
    "AreaDetail": {
      "required": [
        "area",
        "summary",
        "detail"
      ],
      "type": "object",
      "properties": {
        "area": {
          "type": "string",
          "description": "各个计费大区名称,例如CN",
          "minLength": 1,
          "maxLength": 64
        },
        "summary": {
          "type": "array",
          "description": "时间戳及相应时间的指标数值",
          "minItems": 0,
          "maxItems": 1844674407,
          "items": {
            "$ref": "#/definitions/TimeValue"
          }
        },
        "detail": {
          "type": "array",
          "description": "各个大区下的具体省份、区域、国家的时间戳及相应时间的指标数值",
          "minItems": 0,
          "maxItems": 1844674407,
          "items": {
            "$ref": "#/definitions/AreaTimeValue"
          }
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "AreaTimeValue": {
      "required": [
        "name",
        "data"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "各个大区下的具体省份、区域、国家的名称。\n\n中国内地返回结果为省份/直辖市的中文名称,比如:广东、上海;\n海外大区下的地区/国家对应关系请参考[地区/国家代码对照表](https://support.huaweicloud.com/api-live/live_03_0049.html)。\n",
          "minLength": 1,
          "maxLength": 64
        },
        "data": {
          "type": "array",
          "description": "当前时间返回指定指标的值",
          "minItems": 0,
          "maxItems": 1844674407,
          "items": {
            "$ref": "#/definitions/TimeValue"
          }
        }
      }
    },
    "TimeValue": {
      "type": "object",
      "properties": {
        "time": {
          "description": "采样时间。日期格式按照ISO8601表示法,并使用UTC时间。格式为YYYY-MM-DDThh:mm:ssZ",
          "type": "string",
          "minLength": 20,
          "maxLength": 20
        },
        "value": {
          "description": "当前时间返回指定指标的值",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1844674407
        }
      }
    },
    "QueryAreaDetailRsp": {
      "required": [
        "data_list"
      ],
      "type": "object",
      "properties": {
        "data_list": {
          "type": "array",
          "description": "时间戳及相应时间的指标数值",
          "minItems": 0,
          "maxItems": 1844674407,
          "items": {
            "$ref": "#/definitions/AreaDetail"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "live.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}