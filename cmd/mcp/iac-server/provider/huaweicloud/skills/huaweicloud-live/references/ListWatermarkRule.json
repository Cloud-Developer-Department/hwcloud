      "minLength": 1,
      "maxLength": 64,
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,请求的发生时间。",
      "minLength": 1,
      "maxLength": 256,
      "type": "string",
      "x-example": "20191115T033655Za"
    }
  },
  "host": "live.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
