      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目ID,获取方法请参考[获取项目ID](live_03_0023.xml)。",
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Project-Id": {
