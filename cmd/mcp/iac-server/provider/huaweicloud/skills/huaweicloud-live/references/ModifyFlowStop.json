        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-apiexplorer-hide": "N",
        "tags": [
          "流连接管理"
        ],
        "summary": "停止流任务",
        "description": "停止流任务",
        "consumes": [
          "application/json;charset=utf-8"
        ],
        "operationId": "ModifyFlowStop",
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
