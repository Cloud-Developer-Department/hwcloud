            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        ],
        "responses": {
          "200": {
            "description": "修改流状态成功响应",
            "schema": {
              "$ref": "#/definitions/FlowStatusModifyResp"
            },
            "examples": {
              "application/json": {
                "flow_id": "ec897482-d24b-4d64-aa39-407980902b1d",
                "status": "STANDBY"
              }
            }
          },
          "400": {
            "description": "失败响应",
            "schema": {
              "$ref": "#/definitions/FlowErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "flow task is in standby status"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "FlowErrorResp": {
      "type": "object",
      "description": "流失败响应",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "example": "LIVE.10301101",
          "minLength": 1,
          "maxLength": 64,
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "The resource to create is already exists",
          "minLength": 1,
          "maxLength": 64,
          "description": "错误描述"
        }
      }
    },
    "FlowStatusModifyResp": {
      "type": "object",
      "description": "修改流状态响应",
      "required": [
        "status",
        "flow_id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "description": "状态,ACTIVE状态为运行状态,STANDBY状态为未启动状态",
          "minLength": 1,
          "maxLength": 16,
          "example": "ACTIVE",
          "enum": [
            "ACTIVE",
            "STANDBY"
          ]
        },
        "flow_id": {
          "type": "string",
          "description": "流id",
          "minLength": 1,
          "maxLength": 64,
          "example": "03d1bc39-1c13-444e-ae5f-ce20d1e7dc44"
        }
      }
    }
  },
