{
  "name": "CreateDomainMapping",
  "summary": "域名映射",
  "tags": "域名管理",
  "productshort": "Live",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/{project_id}/domains_mapping": {
      "put": {
        "tags": [
          "域名管理"
        ],
        "summary": "域名映射",
        "description": "将用户已创建的播放域名和推流域名建立域名映射关系",
        "operationId": "CreateDomainMapping",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "x-interface-frequency": "HIGH",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-live/live_03_0023.html)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "name": "CreateDomainMappingRequestBody",
            "in": "body",
            "description": "域名映射信息",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DomainMapping"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "直播域名映射成功",
            "schema": {
              "$ref": "#/definitions/DomainMapping"
            },
            "examples": {
              "application/json": {
                "pull_domain": "play.example.huawei.com",
                "push_domain": "publish.example.huawei.com"
              }
            }
          },
          "404": {
            "description": "直播域名映射失败",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.103011019",
                "error_msg": "Request Illegal"
              }
            }
          }
        },
        "x-request-examples-url-1": "PUT https://{endpoint}/v1/{project_id}/domains_mapping",
        "x-request-examples-1": {
          "pull_domain": "play.example.huawei.com",
          "push_domain": "publish.example.huawei.com"
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "DomainMapping": {
      "type": "object",
      "required": [
        "pull_domain",
        "push_domain"
      ],
      "properties": {
        "pull_domain": {
          "type": "string",
          "description": "直播播放域名",
          "minLength": 1,
          "maxLength": 64,
          "example": "play.example.huawei.com"
        },
        "push_domain": {
          "type": "string",
          "description": "直播播放域名关联的推流域名",
          "minLength": 1,
          "maxLength": 64,
          "example": "publish.example.huawei.com"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "live.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}