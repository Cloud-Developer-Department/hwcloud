{
  "name": "ListPullTasks",
  "summary": "查询直播拉流转推任务",
  "tags": "拉流管理",
  "productshort": "Live",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/{project_id}/pull/stream/task": {
      "get": {
        "x-api-type": "open-api",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/pull/stream/task?region=cn-north-4&task_id=xxxxxx",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "x-open-region-cloud": "hc,hk",
        "tags": [
          "拉流管理"
        ],
        "summary": "查询直播拉流转推任务",
        "description": "查询直播拉流转推任务。",
        "operationId": "ListPullTasks",
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "任务所在区域",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "偏移量",
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 2147483647
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页记录数",
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          },
          {
            "name": "task_id",
            "in": "query",
            "required": false,
            "description": "任务id",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询直播拉流转推任务成功",
            "schema": {
              "$ref": "#/definitions/ListPullTasksResponseBody"
            },
            "examples": {
              "application/json": {
                "request_id": "85968475-e92f-42db-a754-08e627b6d8dd",
                "total": 1,
                "task_infos": [
                  {
                    "task_id": "7864b3dc-e92f-42db-a754-08e627b6d8dd",
                    "status": "suspend",
                    "create_time": "2018-05-19T10:00:00Z",
                    "region": "cn-north-4",
                    "source_type": "PullLivePushLive",
                    "source_urls": [
                      "rtmp://play.example.huawei.com/live/stream1"
                    ],
                    "domain": "publish.example.huawei.com",
                    "app_name": "live",
                    "stream_name": "test",
                    "start_time": "2018-05-19T18:00:00Z",
                    "end_time": "2018-05-19T21:00:00Z",
                    "push_args": "arg1=value1",
                    "destination_url": "",
                    "callback_events": [
                      "TaskStart",
                      "TaskExit",
                      "TaskAlarm"
                    ],
                    "callback_url": "callback.example.com",
                    "backup_source_type": "PullLivePushLive",
                    "backup_source_urls": [
                      "rtmp://play.example.huawei.com/live/stream1_bak"
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "查询直播拉流转推任务失败",
            "schema": {
              "$ref": "#/definitions/PullPushErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Request Illegal",
                "request_id": "85968475-e92f-42db-a754-08e627b6d8dd"
              }
            }
          },
          "404": {
            "description": "任务不存在",
            "schema": {
              "$ref": "#/definitions/PullPushErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Request Illegal",
                "request_id": "85968475-e92f-42db-a754-08e627b6d8dd"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "PullPushErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "maxLength": 32,
          "minLength": 1
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "maxLength": 1024,
          "minLength": 0
        },
        "request_id": {
          "type": "string",
          "description": "请求id",
          "minLength": 1,
          "maxLength": 64,
          "example": "58684758-e92f-42db-a754-08e627b6d8dd"
        }
      }
    },
    "ListPullTasksResponseBody": {
      "type": "object",
      "properties": {
        "task_infos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LivePullTaskInfo"
          },
          "description": "直播拉流任务列表",
          "minimum": 0,
          "maximum": 100
        },
        "request_id": {
          "type": "string",
          "description": "请求id",
          "minLength": 1,
          "maxLength": 64,
          "example": "58684758-e92f-42db-a754-08e627b6d8dd"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 10000,
          "description": "任务条目数"
        }
      }
    },
    "LivePullTaskInfo": {
      "type": "object",
      "description": "直播拉流转推任务信息",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务id"
        },
        "status": {
          "type": "string",
          "description": "任务状态"
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间"
        },
        "region": {
          "type": "string",
          "description": "任务执行区域"
        },
        "source_type": {
          "type": "string",
          "description": "拉流源类型\nPullLivePushLive:拉转推(拉直播推直播)\nPullVodPushLive:轮播(拉点播推直播)"
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "拉流源URL\n当 source_type 为 PullLivePushLive 时,只能填写一个URL\n当 source_type 为 PullVodPushLive 时,可以指定多个轮播源文件URL"
        },
        "domain": {
          "type": "string",
          "description": "推流域名"
        },
        "app_name": {
          "type": "string",
          "description": "推流app"
        },
        "stream_name": {
          "type": "string",
          "description": "推流流名"
        },
        "push_args": {
          "type": "string",
          "description": "推流参数"
        },
        "destination_url": {
          "type": "string",
          "description": "完整的目标URL。\n如果指定此参数,domain、app_name和stream_name需要传入空字符串或不传。"
        },
        "start_time": {
          "type": "string",
          "description": "任务启动时间,时间格式:\n\"2006-01-02T15:04:05Z\""
        },
        "end_time": {
          "type": "string",
          "description": "任务结束时间,时间格式:\n\"2006-01-02T15:04:05Z\"\n\n1. 结束时间必须大于开始时间;\n2. 结束时间必须大于当前时间;\n3. 结束时间 和 开始时间 间隔必须小于七天。"
        },
        "callback_events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "要回调的事件列表(不填则回调全部)\n- TaskStart:任务启动回调\n- TaskExit:任务停止回调\n- VodSourceFileStart:仅PullVodPushLive可用,文件启动切换\n- VodSourceFileFinish:仅PullVodPushLive可用,文件播放完毕\n- ResetTaskConfig:仅PullVodPushLive可用,任务更新\n- TaskAlarm:用于告警事件通知"
        },
        "callback_url": {
          "type": "string",
          "description": "回调接收地址"
        },
        "backup_source_type": {
          "type": "string",
          "description": "备源的类型\n- PullLivePushLive:直播\n注意事项:\n1. 仅当source_type为PullVodPushLive生效。\n2. 主直播源拉流中断时,自动使用备源进行拉流。"
        },
        "backup_source_urls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "备源URL,仅当source_type为PullVodPushLive生效。"
        },
        "vod_loop_time": {
          "type": "string",
          "description": "缺省值”-1”\n-1:无限轮播,以结束时间为准;N:按文件列表播放N轮,以播放完成和结束时间先到为准。\n不传、为空(\"\")时按缺省值生效",
          "example": -1,
          "minLength": 0,
          "maxLength": 10
        },
        "vod_start_video_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192,
          "description": "指定播放文件的下标,从0开始表示第一个文件,最大值 len(source_urls)-1"
        },
        "vod_start_video_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2100000000,
          "description": "指定从上述指定文件的第几秒开始播放"
        },
        "vod_refresh_type": {
          "type": "string",
          "enum": [
            "immediate_new_source",
            "continue_from_file_start",
            "continue_from_break_point"
          ],
          "description": "修改任务时文件切换方式\nimmediate_new_source:立即播放新的拉流源内容\ncontinue_from_file_start:从上次断流url文件重新开始推流\ncontinue_from_break_point:从上次断流url文件断流位置开始推流(续上)"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目ID,获取方法请参考[获取项目ID](live_03_0023.xml)。",
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": false,
      "description": "用户Token,使用Token鉴权方式时必填。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "host": "live.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}