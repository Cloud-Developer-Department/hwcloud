{
  "name": "ShowRecordCallbackConfig",
  "summary": "查询录制回调配置",
  "tags": "录制回调管理",
  "productshort": "Live",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/record/callbacks/{id}": {
      "get": {
        "x-navigation-title": "录制回调管理",
        "description": "查询录制回调配置接口",
        "summary": "查询录制回调配置",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-open-region-cloud": "hc,hk",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-live/live_03_0023.html)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "name": "id",
            "in": "path",
            "description": "配置ID",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "查询录制配置成功",
            "schema": {
              "$ref": "#/definitions/RecordCallbackConfig"
            },
            "examples": {
              "application/json": {
                "id": "e2fe84def7e476651034ec4b9e92bc30",
                "publish_domain": "publish.xxx.com",
                "app": "*",
                "notify_callback_url": "http://100.95.129.234:8456/base_record_notify",
                "notify_event_subscription": [
                  "RECORD_FILE_COMPLETE",
                  "RECORD_NEW_FILE_START"
                ],
                "on_demand_callback_url": "http://100.95.129.234:8456/record_auth",
                "sign_type": "MD5",
                "key": "ca3e25e5dc17a6f9909a9ae7281e300d",
                "create_time": "2020-03-02T08:59:45Z",
                "update_time": "2020-03-09T08:59:45Z"
              }
            }
          },
          "404": {
            "description": "记录不存在",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Request Illegal"
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/record/callback/e89b76xxxxxx3425ui80af501cdxxxxxx",
        "operationId": "ShowRecordCallbackConfig",
        "tags": [
          "录制回调管理"
        ]
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "RecordCallbackConfig": {
      "required": [
        "publish_domain",
        "app"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "配置id,由服务端返回。创建或修改的时候不携带",
          "maxLength": 128,
          "minLength": 1
        },
        "publish_domain": {
          "type": "string",
          "description": "直播推流域名",
          "maxLength": 256,
          "minLength": 1
        },
        "app": {
          "type": "string",
          "description": "app名称。如果匹配任意需填写为*。录制规则匹配的时候,优先精确app匹配,如果匹配不到,则匹配*",
          "maxLength": 128,
          "minLength": 1
        },
        "notify_callback_url": {
          "type": "string",
          "description": "录制回调通知url地址",
          "maxLength": 1024,
          "minLength": 1
        },
        "notify_event_subscription": {
          "type": "array",
          "description": "订阅录制通知消息。消息类型。RECORD_NEW_FILE_START开始创建新的录制文件。RECORD_FILE_COMPLETE录制文件生成完成。RECORD_OVER录制结束。RECORD_FAILED表示录制失败。如果不填写,默认订阅RECORD_FILE_COMPLETE",
          "maxItems": 10,
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "RECORD_NEW_FILE_START",
              "RECORD_FILE_COMPLETE",
              "RECORD_OVER",
              "RECORD_FAILED"
            ],
            "default": "RECORD_FILE_COMPLETE",
            "maxLength": 64,
            "minLength": 1
          }
        },
        "sign_type": {
          "type": "string",
          "description": "加密类型",
          "enum": [
            "MD5",
            "HMACSHA256"
          ]
        },
        "create_time": {
          "type": "string",
          "description": "创建时间,格式:yyyy-mm-ddThh:mm:ssZ,UTC时间。 在查询的时候返回",
          "maxLength": 64,
          "minLength": 1,
          "format": "date"
        },
        "update_time": {
          "type": "string",
          "description": "修改时间,格式:yyyy-mm-ddThh:mm:ssZ,UTC时间。 在查询的时候返回",
          "maxLength": 64,
          "minLength": 1,
          "format": "date"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "live.cn-east-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}