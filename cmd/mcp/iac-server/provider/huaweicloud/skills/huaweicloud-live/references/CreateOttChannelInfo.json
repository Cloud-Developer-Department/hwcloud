              ],
              "dash_package": [
                {
                  "url": "pull.testott.hls.com/ott/test/index.mpd",
                  "stream_selection": [
                    {
                      "key": "bitrate=900000-1800000",
                      "max_bandwidth": 1800000,
                      "min_bandwidth": 900000
                    }
                  ],
                  "segment_duration_seconds": 4,
                  "playlist_window_seconds": 3600
                }
              ],
              "mss_package": [
                {
                  "url": "pull.testott.hls.com/ott/channel/manifest",
                  "stream_selection": [
                    {
                      "key": "bitrate=900000-1800000",
                      "max_bandwidth": 1800000,
                      "min_bandwidth": 900000
                    }
                  ],
                  "segment_duration_seconds": 4,
                  "playlist_window_seconds": 3600
                }
              ]
            }
          ],
          "state": "OFF"
        },
        "x-request-examples-1": {
          "domain": "push.testott.hls.com",
          "app_name": "ott",
          "id": "test",
          "name": "testname",
          "input": {
            "input_protocol": "FLV_PULL",
            "sources": [
              {
                "url": "http://192.168.0.1/ott/test.flv?vhost=pull.testott.hls.com",
                "bitrate": 1024,
                "width": 100,
                "height": 100
              }
            ],
            "failover_conditions": {
              "input_loss_threshold_msec": 100,
              "input_preference": "EQUAL"
            }
          },
          "record_settings": {
            "rollingbuffer_duration": 86400
          },
          "endpoints": [
            {
              "hls_package": [
                {
                  "url": "pull.testott.hls.com/ott/test/index.m3u8",
                  "stream_selection": [
                    {
                      "key": "sss",
                      "max_bandwidth": 100,
                      "min_bandwidth": 100
                    }
                  ],
                  "hls_version": "1",
                  "segment_duration_seconds": 4,
                  "playlist_window_seconds": 3600
                }
              ],
              "dash_package": [
                {
                  "url": "pull.testott.hls.com/ott/test/index.mpd",
                  "stream_selection": [
                    {
                      "key": "bitrate=900000-1800000",
                      "max_bandwidth": 1800000,
                      "min_bandwidth": 900000
                    }
                  ],
                  "segment_duration_seconds": 4,
                  "playlist_window_seconds": 3600
                }
              ],
              "mss_package": [
                {
                  "url": "pull.testott.hls.com/ott/channel/manifest",
                  "stream_selection": [
                    {
                      "key": "bitrate=900000-1800000",
                      "max_bandwidth": 1800000,
                      "min_bandwidth": 900000
                    }
                  ],
                  "segment_duration_seconds": 4,
                  "playlist_window_seconds": 3600
                }
              ]
            }
          ],
          "state": "OFF"
        },
        "tags": [
          "OTT频道管理"
        ],
        "operationId": "CreateOttChannelInfo",
        "summary": "新建OTT频道",
        "description": "创建频道接口,支持创建OTT频道。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,使用Token鉴权方式时必选。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Access-Control-Allow-Internal",
            "in": "header",
            "description": "服务鉴权Token,服务开启鉴权,必须携带Access-Control-Allow-Internal访问服务。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          {
            "name": "Access-Control-Allow-External",
            "in": "header",
            "description": "服务鉴权Token,服务开启鉴权,必须携带Access-Control-Allow-External访问服务。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](live_26_0018.xml)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "body",
            "name": "CreateOttChannelInfoRequestBody",
            "description": "DemoInfo object that needs to be created",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateOttChannelInfoReq"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Demo Information",
            "schema": {
              "$ref": "#/definitions/CreateSuccessRsp"
            },
            "examples": {
              "application/json": {
                "result_code": "LIVE.100000000",
                "result_msg": "SUCCESS",
                "domain": "push.testott.hls.com",
                "app_name": "ott",
                "id": "test",
                "sources": [
                  {
                    "url": "rtmp://push.testott.hls.com/ott/test_1024?request_source=ott&channel_id=test",
                    "bitrate": 1024,
                    "width": 100,
                    "height": 100
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "examples": {
              "application/json": {
                "result_code": "LIVE.100011001",
                "result_msg": "output url pull.testott.hls.com/ott/test/index.m3u8 is exist",
                "domain": "push.testott.hls.com",
                "app_name": "ott",
                "id": "test"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "EndpointItem": {
      "type": "object",
      "description": "拉流打包信息",
      "properties": {
        "hls_package": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HlsPackageItem"
          },
          "description": "HLS打包信息"
        },
        "dash_package": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DashPackageItem"
          },
          "description": "DASH打包信息"
        },
        "mss_package": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MssPackageItem"
          },
          "description": "MSS打包信息"
        }
      }
    },
    "StreamSelectionItem": {
      "type": "object",
      "description": "从全量流中过滤出一个码率在[min, max]区间的流。如果不需要码率过滤可不选。",
      "properties": {
        "key": {
          "type": "string",
          "description": "拉流URL中用于码率过滤的参数",
          "minLength": 1,
          "maxLength": 1024,
          "example": "your.pull.domain.com/ott/test.manifest"
        },
        "max_bandwidth": {
          "type": "integer",
          "description": "最大码率,单位:bps\n\n取值范围:0 - 104,857,600(100Mbps)"
        },
        "min_bandwidth": {
          "type": "integer",
          "format": "int32",
          "description": "最小码率,单位:bps\n\n取值范围:0 - 104,857,600(100Mbps)"
        }
      }
    },
    "InputAudioSelector": {
      "type": "object",
      "description": "音频选择器",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "音频选择器的名称。仅支持大小写字母、数字、中划线和下划线。\n\n同一个频道中每个选择器的名称需要唯一。",
          "minLength": 1,
          "maxLength": 255
        },
        "selector_settings": {
          "description": "设置音频选择器",
          "$ref": "#/definitions/AudioSelectorSettings"
        }
      }
    },
    "VideoDescriptions": {
      "type": "object",
      "properties": {
        "gop_duration_seconds": {
          "type": "integer",
          "format": "int32",
          "description": "自定义gop时长,单位秒,有效取值[0,10]. 默认值0,表示跟随源流,不支持7和9,值无效时按默认值处理",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "enum": [
            0,
            1,
            2,
            3,
            4,
            5,
            6,
            8,
            10
          ]
        }
      }
    },
    "AudioSelectorHlsSelection": {
      "type": "object",
      "description": "hls音频选择器",
      "required": [
        "name",
        "group_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "hls音频选择器名",
          "minLength": 1,
          "maxLength": 255
        },
        "group_id": {
          "type": "string",
          "description": "hls音频选择器gid"
        }
      }
    },
    "HttpHeader": {
      "type": "object",
      "description": "drm加密信息,添加在请求头中的鉴权信息",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "请求头中key字段名",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "description": "请求头中key对应的value值",
          "minLength": 1,
          "maxLength": 8000
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "result_code",
        "result_msg"
      ],
      "properties": {
        "result_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "description": "错误码"
        },
        "result_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "错误描述"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "推流域名"
        },
        "app_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "组名或应用名,为必填项"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "频道ID。频道唯一标识,为必填项"
        }
      }
    },
    "AudioSelectorSettings": {
      "type": "object",
      "description": "设置音频选择器",
      "properties": {
        "audio_language_selection": {
          "description": "设置语言选择器",
          "$ref": "#/definitions/AudioSelectorLangSelection"
        },
        "audio_pid_selection": {
          "description": "设置PID选择器",
          "$ref": "#/definitions/AudioSelectorPidSelection"
        },
        "audio_hls_selection": {
          "description": "设置Hls选择器",
          "$ref": "#/definitions/AudioSelectorHlsSelection"
        }
      }
    },
    "AudioSelectorPidSelection": {
      "type": "object",
      "description": "PID选择器",
      "required": [
        "pid"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "format": "int32",
          "description": "设置PID的值",
          "minimum": 0,
          "maximum": 8191
        }
      }
    },
    "RecordRequestArgs": {
      "type": "object",
      "description": "录制相关配置参数",
      "properties": {
        "start_time": {
          "type": "string",
          "description": "开始时间",
          "minLength": 0,
          "maxLength": 20
        },
        "end_time": {
          "type": "string",
          "description": "结束时间",
          "minLength": 0,
          "maxLength": 20
        },
        "format": {
          "type": "string",
          "description": "格式",
          "minLength": 0,
          "maxLength": 20
        },
        "unit": {
          "type": "string",
          "description": "单位",
          "minLength": 0,
          "maxLength": 20
        }
      }
    },
    "SourcesInfo": {
      "description": "主入流信息",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "频道源流URL,用于外部拉流"
        },
        "bitrate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600,
          "description": "码率。无需直播转码时,此参数为必填项\n\n单位:bps。取值范围:(0,104,857,600](100Mbps)"
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096,
          "description": "分辨率对应宽的值,非必填项\n\n取值范围:0 - 4096(4K)"
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2160,
          "description": "分辨率对应高的值,非必填项\n\n取值范围:0 - 2160(4K)"
        },
        "enable_snapshot": {
          "type": "boolean",
          "description": "描述是否使用该流做截图",
          "default": false
        },
        "bitrate_for3u8": {
          "type": "boolean",
          "description": "是否使用bitrate来固定码率。默认值:false"
        },
        "passphrase": {
          "type": "string",
          "description": "协议为SRT_PUSH时的加密信息",
          "minLength": 10,
          "maxLength": 79
        },
        "pbkeylen": {
          "type": "integer",
          "description": "srt加密算法",
          "minimum": 16,
          "maximum": 32
        },
        "backup_urls": {
          "type": "array",
          "description": "备入流地址列表",
          "maxItems": 12,
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "stream_id": {
          "type": "string",
          "description": "频道为SRT_PULL类型时,拉流地址的Stream ID。"
        },
        "latency": {
          "type": "integer",
          "format": "int32",
          "description": "频道为SRT_PULL类型时的拉流时延。"
        }
      },
      "type": "object"
    },
    "AudioSelectorLangSelection": {
      "type": "object",
      "description": "音频选择器语言设置",
      "required": [
        "language_code"
      ],
      "properties": {
        "language_code": {
          "type": "string",
          "description": "语言简称,输入2或3个小写字母的语言代码。",
          "minLength": 2,
          "maxLength": 3
        },
        "language_selection_policy": {
          "type": "string",
          "description": "语言输出策略。\n\n取值如下:\n- LOOSE:宽松匹配,示例“eng”会优先匹配源流中语言为English的音轨,如果匹配不到,则选择PID最小的音轨。\n- STRICT:严格匹配,示例“eng”会严格匹配源流中语言为English的音轨,如果匹配不到,媒体直播服务会自动补齐一个静音分片,当终端使用此音频选择器播放视频时,会静音播放。",
          "enum": [
            "LOOSE",
            "STRICT"
          ]
        }
      }
    },
    "HlsPackageItem": {
      "description": "HLS频道出流信息",
      "properties": {
        "id": {
          "type": "string",
          "description": "package唯一标识id,由服务创建并在查询时返回,修改endpoints时需要携带。",
          "minLength": 0,
          "maxLength": 32,
          "example": "374e48f3ce"
        },
        "url": {
          "type": "string",
          "description": "客户自定义的拉流地址,包括方法、域名、路径",
          "minLength": 1,
          "maxLength": 1024,
          "example": "your.pull.domain.com/ott/test/index.m3u8"
        },
        "stream_selection": {
          "description": "从全量流中过滤出一个码率在[min, max]区间的流。如果不需要码率过滤可不选。",
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "description": "从全量流中过滤出一个码率在[min, max]区间的流。如果不需要码率过滤可不选。",
            "$ref": "#/definitions/StreamSelectionItem"
          }
        },
        "hls_version": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "description": "HLS版本号"
        },
        "segment_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "频道输出分片的时长,为必选项\n\n单位:秒。取值范围:1-10\n> 修改分片时长会影响已录制内容的时移和回看服务,请谨慎修改!"
        },
        "playlist_window_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400,
          "description": "频道直播返回分片的窗口长度,为频道输出分片的时长乘以数量后得到的值。实际返回的分片数不小于3个。\n\n单位:秒。取值范围:0 - 86400(24小时转化成秒后的取值)"
        },
        "encryption": {
          "description": "加密信息",
          "$ref": "#/definitions/Encryption"
        },
        "ads": {
          "type": "object",
          "description": "广告配置"
        },
        "ext_args": {
          "type": "object",
          "description": "其他额外参数"
        },
        "request_args": {
          "description": "播放相关配置",
          "$ref": "#/definitions/PackageRequestArgs"
        },
        "ad_marker": {
          "type": "array",
          "description": "广告标识。\n\nHLS取值:[\"ENHANCED_SCTE35\"]。",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "enable_access": {
          "type": "boolean",
          "description": "当频道mode是ONLY_OS类型时,允许本输出可以直接从源站拉流,默认:false\ntrue:允许output访问\nfalse:禁止output访问",
          "default": false
        },
        "allow_all_ip_access": {
          "type": "boolean",
          "description": "是否放通所有的IP访问,默认:false\ntrue:允许所有的IP地址访问,ip_whitelist配置不生效\nfalse:不允许所有的IP地址访问,ip_whitelist生效,仅在ip_whitelist配置的ip地址才能访问",
          "default": false
        },
        "ip_whitelist": {
          "type": "string",
          "description": "当频道类型mode是ONLY_OS类型时,允许直接从源站拉流的IP白名单",
          "minLength": 0,
          "maxLength": 2048
        },
        "cdn_identifier_header": {
          "description": "HttpHeader CDN认证头域",
          "$ref": "#/definitions/HttpHeader"
        },
        "origin_domain_master": {
          "type": "string",
          "description": "源站分发域名-主region\n跟CreateOttChannelInfoReq.region一致\n满足正则:^(\\[a-zA-Z0-9]([a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9])?\\.){2,}[a-zA-Z]{2,16}$\n最大长度255",
          "minLength": 0,
          "maxLength": 255
        },
        "origin_domain_slave": {
          "type": "string",
          "description": "源站分发域名-备region\n满足正则:^(\\[a-zA-Z0-9]([a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9])?\\.){2,}[a-zA-Z]{2,16}$\n最大长度255",
          "minLength": 0,
          "maxLength": 255
        },
        "manifest_name": {
          "type": "string",
          "description": "output的索引文件名字\n默认:index\n长度:0-128\n字符集:大小写字母、数字、\"-\"、\".\"、\"_\",不能有/路径",
          "default": "index",
          "minLength": 0,
          "maxLength": 128
        },
        "slave_url": {
          "type": "string",
          "description": "客户自定义的拉流地址,包括方法、域名、路径",
          "minLength": 0,
          "maxLength": 1024
        },
        "manifest_selection": {
          "$ref": "#/definitions/ManifestSelection",
          "description": "**参数解释**:\n流选择配置\n**约束限制**:\n不涉及"
        }
      },
      "required": [
        "segment_duration_seconds"
      ],
      "type": "object"
    },
    "ManifestSelection": {
      "type": "object",
      "description": "流选择配置",
      "properties": {
        "stream_order": {
          "type": "string",
