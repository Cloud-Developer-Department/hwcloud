            ],
            "failover_conditions": {
              "input_loss_threshold_msec": 100,
              "input_preference": "EQUAL"
            }
          },
          "record_settings": {
            "rollingbuffer_duration": 86400
          },
          "endpoints": [
            {
              "hls_package": [
                {
                  "url": "pull.testott.hls.com/ott/test/index.m3u8",
                  "stream_selection": [
                    {
                      "key": "sss",
                      "max_bandwidth": 100,
                      "min_bandwidth": 100
                    }
                  ],
                  "hls_version": "1",
                  "segment_duration_seconds": 4,
                  "playlist_window_seconds": 3600
