{
  "name": "CreateOttChannelInfo",
  "summary": "新建OTT频道",
  "tags": "OTT频道管理",
  "productshort": "Live",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/ott/channels": {
      "post": {
        "x-request-examples-url-1": "POST https://{endpoint}/v1/{project_id}/ott/channels",
        "x-request-examples-text-1": {
