        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096,
          "description": "分辨率对应宽的值,非必填项\n\n取值范围:0 - 4096(4K)"
        },
        "height": {
          "type": "integer",
          "minimum": 0,
