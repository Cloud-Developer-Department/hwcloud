{
  "name": "ShowDomain",
  "summary": "查询直播域名",
  "tags": "域名管理",
  "productshort": "Live",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/{project_id}/domain": {
      "get": {
        "tags": [
          "域名管理"
        ],
        "summary": "查询直播域名",
        "description": "查询直播域名",
        "operationId": "ShowDomain",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "x-interface-frequency": "HIGH",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-live/live_03_0023.html)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "name": "domain",
            "in": "query",
            "description": "直播域名,如果不设置此字段,则返回租户所有的域名信息",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "play.example.huawei.com"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "required": false,
            "description": "企业项目ID,如果不设置此字段,则不进行该字段过滤,返回所有域名信息",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "直播域名查询成功",
            "schema": {
              "$ref": "#/definitions/DecoupledLiveDomainNameQueryRsp"
            },
            "examples": {
              "application/json": {
                "total": 2,
                "domain_info": [
                  {
                    "domain": "play.example.huawei.com",
                    "domain_type": "pull",
                    "vendor": "uCDN",
                    "domain_cname": "play.example.huawei.com.c.cdnhwc3.com",
                    "region": "cn-north-1",
                    "status": "on",
                    "related_domain": "publish.example.huawei.com",
                    "create_time": "2020-01-19T02:57:00Z",
                    "status_describe": "arrear",
                    "service_area": "mainland_china"
                  },
                  {
                    "domain": "publish.example.huawei.com",
                    "domain_type": "push",
                    "vendor": "Tencent",
                    "domain_cname": "publish.example.huawei.com.c.cdnhwc3.com",
                    "region": "cn-north-1",
                    "status": "on",
                    "related_domain": "",
                    "create_time": "2020-01-19T02:58:00Z",
                    "status_describe": "arrear",
                    "service_area": "mainland_china"
                  }
                ]
              }
            }
          },
          "404": {
            "description": "直播域名查询失败",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.103011019",
                "error_msg": "Request Illegal"
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/domain"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "DecoupledLiveDomainNameQueryRsp": {
      "type": "object",
      "required": [
        "total",
        "domain_info"
      ],
      "properties": {
        "total": {
          "type": "number",
          "description": "查询结果的总数量"
        },
        "domain_info": {
          "type": "array",
          "description": "直播域名列表",
          "items": {
            "$ref": "#/definitions/DecoupledLiveDomainInfo"
          }
        }
      }
    },
    "DecoupledLiveDomainInfo": {
      "type": "object",
      "required": [
        "domain",
        "domain_type",
        "vendor",
        "region",
        "domain_cname",
        "status",
        "related_domain",
        "domain_source",
        "create_time"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "description": "直播域名",
          "minLength": 1,
          "maxLength": 64
        },
        "domain_type": {
          "type": "string",
          "description": "域名类型",
          "enum": [
            "pull",
            "push"
          ]
        },
        "vendor": {
          "type": "string",
          "description": "CDN厂商",
          "enum": [
            "ChinaNetCenter",
            "KingSoft",
            "Tencent",
            "uCDN",
            "TencentOutside",
            "Dnion",
            "Baishan",
            "Baidu",
            "Onething"
          ]
        },
        "region": {
          "type": "string",
          "description": "直播所属直播中心"
        },
        "domain_cname": {
          "type": "string",
          "description": "直播域名的CName"
        },
        "status": {
          "type": "string",
          "description": "直播域名的状态",
          "enum": [
            "on",
            "off",
            "configuring"
          ]
        },
        "related_domain": {
          "type": "string",
          "description": "播放域名关联的推流域名(只有domain_type为pull的时候有效)",
          "minLength": 1,
          "maxLength": 64
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "域名创建时间,格式:yyyy-mm-ddThh:mm:ssZ,UTC时间"
        },
        "status_describe": {
          "type": "string",
          "description": "状态描述",
          "maxLength": 256,
          "minLength": 0,
          "example": "arrear"
        },
        "service_area": {
          "type": "string",
          "description": "域名应用区域\n- mainland_china表示中国大陆区域\n- outside_mainland_china表示中国大陆以外区域\n- global表示全球加速区域",
          "enum": [
            "mainland_china",
            "outside_mainland_china",
            "global"
          ]
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID"
        },
        "pull_protocol": {
          "type": "string",
          "description": "域名支持的拉流协议;仅domain_type为pull时生效。若不填写此字段,视为默认支持FLV、RTMP拉流协议\n- flv_rtmp表示支持FLV、RTMP协议\n- hls表示支持HLS协议",
          "enum": [
            "flv_rtmp",
            "hls"
          ]
        },
        "is_ipv6": {
          "type": "boolean",
          "description": "IPV6开关是否开启,默认关闭,true为开启;false或空为关闭"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "live.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}