{
  "name": "ListLiveStreamsOnline",
  "summary": "查询直播中的流信息",
  "tags": "流管理",
  "productshort": "Live",
  "region_id": "ap-southeast-2",
  "paths": {
    "/v1/{project_id}/realtime/streams": {
      "get": {
        "tags": [
          "流管理"
        ],
        "summary": "查询直播中的流信息",
        "description": "查询直播中的流信息",
        "operationId": "ListLiveStreamsOnline",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-live/live_03_0023.html)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "name": "publish_domain",
            "in": "query",
            "description": "推流域名",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "push.example.huawei.com"
          },
          {
            "name": "app",
            "in": "query",
            "description": "应用名",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "live"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,表示从此偏移量开始查询, offset大于等于0",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页记录数,取值范围[1,100],默认值10",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 10,
            "minimum": 1,
            "maximum": 100
          },
          {
            "name": "stream",
            "in": "query",
            "required": false,
            "description": "流名,用于单流查询,携带stream参数时app不能缺省",
            "maxLength": 128,
            "minLength": 1,
            "type": "string",
            "x-example": "test"
          }
        ],
        "responses": {
          "200": {
            "description": "查询直播中的流信息数据成功",
            "schema": {
              "$ref": "#/definitions/OnlineInfoRsp"
            },
            "examples": {
              "application/json": {
                "total_page": 1,
                "total_num": 10,
                "offset": 0,
                "limit": 10,
                "request_id": "56b9f4dc-b282-48e0-a1a9-c50ffb06b687",
                "streams": [
                  {
                    "publish_domain": "push.example.huawei.com",
                    "app": "live",
                    "stream": "test",
                    "video_codec": "H264",
                    "audio_codec": "AAC",
                    "video_frame_rate": 15,
                    "audio_frame_rate": 43,
                    "video_bitrate": 588,
                    "audio_bitrate": 68,
                    "resolution": "640x360",
                    "client_ip": "192.168.0.100",
                    "start_time": "2006-01-02T15:04:05Z"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "查询直播中的流信息数据失败",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Request Illegal"
              }
            }
          }
        },
        "x-request-examples-1": "GET https://{endpoint}/v1/{project_id}/realtime/streams?publish_domain=push.example.huawei.com&app=live&offset=0&limit=10"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "OnlineInfo": {
      "required": [
        "publish_domain",
        "app",
        "stream",
        "video_codec",
        "audio_codec",
        "client_ip",
        "start_time"
      ],
      "properties": {
        "publish_domain": {
          "type": "string",
          "description": "域名",
          "maxLength": 64,
          "minLength": 1
        },
        "app": {
          "type": "string",
          "description": "应用名",
          "maxLength": 128,
          "minLength": 1
        },
        "stream": {
          "type": "string",
          "description": "流名",
          "maxLength": 64,
          "minLength": 1
        },
        "video_codec": {
          "type": "string",
          "description": "视频编码方式\n- H264\n- H265",
          "enum": [
            "H264",
            "H265"
          ]
        },
        "audio_codec": {
          "type": "string",
          "description": "音频编码方式\n- AAC",
          "enum": [
            "AAC"
          ]
        },
        "video_frame_rate": {
          "type": "integer",
          "format": "int64",
          "description": "视频帧率"
        },
        "audio_frame_rate": {
          "type": "integer",
          "format": "int64",
          "description": "音频帧率"
        },
        "video_bitrate": {
          "type": "integer",
          "format": "int64",
          "description": "视频码率"
        },
        "audio_bitrate": {
          "type": "integer",
          "format": "int64",
          "description": "音频码率"
        },
        "resolution": {
          "type": "string",
          "description": "视频分辨率"
        },
        "client_ip": {
          "type": "string",
          "description": "推流设备的ip",
          "maxLength": 15,
          "minLength": 1
        },
        "start_time": {
          "type": "string",
          "description": "开始推流时刻 UTC格式 2006-01-02T15:04:05Z"
        }
      }
    },
    "OnlineInfoRsp": {
      "required": [
        "total_page",
        "total_num",
        "offset",
        "limit",
        "request_id",
        "streams"
      ],
      "properties": {
        "total_page": {
          "type": "integer",
          "format": "int64",
          "description": "总条页数"
        },
        "total_num": {
          "type": "integer",
          "format": "int64",
          "description": "总条目数"
        },
        "offset": {
          "type": "integer",
          "format": "int64",
          "description": "偏移量"
        },
        "limit": {
          "type": "integer",
          "format": "int64",
          "description": "每页条目数"
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识",
          "maxLength": 36,
          "minLength": 36
        },
        "streams": {
          "type": "array",
          "description": "推流统计",
          "items": {
            "$ref": "#/definitions/OnlineInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "live.ap-southeast-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}