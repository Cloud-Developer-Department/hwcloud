{
  "name": "ListHistoryStreams",
  "summary": "查询历史推流列表接口",
  "tags": "数据统计分析",
  "productshort": "Live",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/{project_id}/stats/history/streams": {
      "get": {
        "tags": [
          "DataStatisticsAnalysis"
        ],
        "summary": "查询历史推流列表接口",
        "description": "查询历史推流列表。\n\n不能查询现推流。\n\n最大查询跨度1天。\n",
        "operationId": "ListHistoryStreams",
        "deprecated": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-external-api": true,
        "x-interface-frequency": "HIGH",
        "x-constraint": "该接口暂只支持查询部署在新版视频直播服务上的域名的相关数据(不包含“华北-北京一”)。此约束条件仅适用于中国站。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息, 与路径参数中的项目ID相同。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-live/live_03_0023.html)。\n",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "query",
            "name": "domain",
            "description": "推流域名列表,最多支持查询100个域名,多个域名以逗号分隔。\n\n若查询多个域名,则返回的是多个域名合并数据。\n",
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "required": true,
            "items": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "app",
            "type": "string",
            "description": "应用名称。",
            "required": false,
            "minLength": 1,
            "maxLength": 128
          },
          {
            "in": "query",
            "name": "stream",
            "type": "string",
            "description": "流名称。",
            "required": false,
            "minLength": 1,
            "maxLength": 256
          },
          {
            "in": "query",
            "name": "start_time",
            "description": "起始时间。日期格式按照ISO8601表示法,并使用UTC时间。\n\n格式为:YYYY-MM-DDThh:mm:ssZ。最大查询跨度1天。\n\n若参数为空,默认查询1天数据。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 64
          },
          {
            "in": "query",
            "name": "end_time",
            "description": "结束时间。日期格式按照ISO8601表示法,并使用UTC时间。 格式为:YYYY-MM-DDThh:mm:ssZ。\n\n若参数为空,默认为当前时间,最大查询跨度1天。结束时间需大于起始时间。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 64
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "minimum": 0,
            "maximum": 2147483647,
            "description": "分页编号,默认为0"
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "description": "每页记录数。\n\n取值范围:[1,100]\n\n默认值:10。\n"
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。\n",
            "schema": {
              "$ref": "#/definitions/QueryHistoryStreamsRsp"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求的唯一标识。"
              }
            },
            "examples": {
              "application/json": {
                "history_stream_list": [
                  {
                    "domain": "example.huawei.com",
                    "app": "live",
                    "stream": "stream",
                    "type": 0,
                    "video_codec": "H264",
                    "audio_codec": "AAC",
                    "client_ip": "127.0.0.1",
                    "start_time": "2020-06-04T07:00:00Z",
                    "end_time": "2020-06-05T07:00:00Z"
                  }
                ],
                "total": 100
              }
            }
          },
          "400": {
            "description": "参数错误。\n",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求的唯一标识。"
              }
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Invalid request parameter: domain"
              }
            }
          }
        },
        "x-request-examples-description-1": "查询历史推流域名数据",
        "x-request-examples-url-1": "GET /v2/{project_id}/stats/history/streams?domain=example.huawei.com&limit=10&offset=1\n"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "HistoryStreamInfo": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "description": "推流域名。\n\n-\ttype为0表主播推流域名。\n\n-\ttype为1表示第三方推流域名\n",
          "minLength": 1,
          "maxLength": 64
        },
        "app": {
          "type": "string",
          "description": "应用名称。",
          "minLength": 1,
          "maxLength": 128
        },
        "stream": {
          "type": "string",
          "description": "流名。",
          "minLength": 1,
          "maxLength": 256
        },
        "type": {
          "description": "推流类型,取值如下:\n\n-\t0:表示主播推流\n\n-\t1:表示第三方推流\n",
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "video_codec": {
          "type": "string",
          "description": "视频编码格式。",
          "minLength": 1,
          "maxLength": 64
        },
        "audio_codec": {
          "type": "string",
          "description": "音频编码格式。",
          "minLength": 1,
          "maxLength": 64
        },
        "client_ip": {
          "type": "string",
          "description": "主播ip。",
          "minLength": 1,
          "maxLength": 64
        },
        "start_time": {
          "type": "string",
          "description": "采样开始时间。日期格式按照ISO8601表示法,并使用UTC时间。 格式为:YYYY-MM-DDThh:mm:ssZ。",
          "minLength": 1,
          "maxLength": 64
        },
        "end_time": {
          "type": "string",
          "description": "采样结束时间。日期格式按照ISO8601表示法,并使用UTC时间。 格式为:YYYY-MM-DDThh:mm:ssZ。",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "QueryHistoryStreamsRsp": {
      "type": "object",
      "properties": {
        "history_stream_list": {
          "description": "历史流信息列表。",
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/HistoryStreamInfo"
          }
        },
        "total": {
          "description": "总记录数。",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "live.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}