  "definitions": {
    "ShowChannelStatisticSuccessRsp": {
      "type": "object",
      "description": "查询频道统计信息的响应体。",
      "required": [
        "domain",
        "app_name",
        "id",
        "type"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "example": "www.huaweiott.pushdomain.com",
          "description": "频道推流域名。",
          "minLength": 1,
          "maxLength": 255
        },
        "app_name": {
          "type": "string",
          "example": "live",
          "description": "组名或应用名。",
          "minLength": 1,
          "maxLength": 255
        },
        "id": {
          "type": "string",
          "example": "channelId",
          "description": "频道ID。频道唯一标识,为必填项。",
          "minLength": 2,
          "maxLength": 255
        },
        "type": {
          "type": "string",
          "example": "scte35",
          "description": "统计信息的类型,scte35。",
          "enum": [
            "scte35"
          ],
          "minLength": 1,
          "maxLength": 32
        },
        "scte35": {
          "$ref": "#/definitions/SCTE35StatisticRsp"
        }
      }
    },
    "SCTE35InfoItem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "example": "splice_insert",
          "description": "信号类型,splice_insert/time_signal。",
          "enum": [
            "splice_insert",
            "time_signal"
          ],
          "minLength": 1,
          "maxLength": 16
        },
        "event_id": {
          "type": "integer",
          "format": "int32",
          "example": 100,
          "description": "广告信号的Event ID,Time Signal打印数组第一个。",
          "minimum": 1,
          "maximum": 2147483648
        },
        "start_date": {
          "type": "integer",
          "format": "int64",
          "example": 1741594376,
          "description": "广告信号的执行时间,unix time,单位:秒。",
          "minimum": 1,
          "maximum": 4294967295
        },
        "duration": {
          "type": "integer",
          "format": "int32",
          "example": 120,
          "description": "广告信号时长,-1表示没有携带,单位:秒。",
          "minimum": -1,
          "maximum": 2147483648
        },
        "segmentation_type": {
          "type": "string",
          "example": "ProviderAdvertisementStart",
          "description": "// Splice Insert填空\"-\";\n// Time Signal,支持0x30,0x31,0x32,0x33,0x34,0x35,0x36,0x37\n// 0x30: ProviderAdvertisementStart\n// 0x31: ProviderAdvertisementEnd\n// 0x32: DistributorAdvertisementStart\n// 0x33: DistributorAdvertisementEnd\n// 0x34: ProviderPlacementOpportunityStart\n// 0x35: ProviderPlacementOpportunityEnd\n// 0x36: DistributorPlacementOpportunityStart\n// 0x37: DistributorPlacementOpportunityEnd",
          "enum": [
            "-",
            "ProviderAdvertisementStart",
            "ProviderAdvertisementEnd",
            "DistributorAdvertisementStart",
            "DistributorAdvertisementEnd",
            "ProviderPlacementOpportunityStart",
            "ProviderPlacementOpportunityEnd",
            "DistributorPlacementOpportunityStart",
            "DistributorPlacementOpportunityEnd"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "base64_data": {
          "type": "string",
          "example": "/DAlAAAAAAAAAP/wFAUAAAABf+/+AGAhYP4AKTLgAAEAAAAAjhdvmA==",
          "description": "广告信号原始数据的base64值。",
          "minLength": 1,
          "maxLength": 1024
        },
        "raw_splice": {
          "description": "广告信号全量信息。",
          "type": "string",
          "example": "{\"tableId\":252,\"selectionSyntaxIndicator\":false,\"privateIndicator\":false,\"sectionLength\":52,\"protocolVersion\":0,\"encryptedPacket\":false,\"encryptedAlgorithm\":0,\"ptsAdjustment\":0,\"cwIndex\":0,\"tier\":4095,\"spliceCommandLength\":5,\"spliceCommandType\":6,\"spliceCommand\":{\"specified\":true,\"pts\":6300000},\"descriptorLoopLength\":30,\"descriptors\":[{\"spliceDescriptorTag\":2,\"descriptorLength\":28,\"identifier\":\"CUEI\",\"segmentationEventId\":1,\"segmentationEventCancelIndicator\":false,\"programSegmentationFlag\":true,\"segmentationDurationFlag\":true,\"deliveryNotRestrictedFlag\":true,\"segmentationDuration\":2700000,\"segmentationUpidType\":8,\"segmentationUpidLength\":8,\"segmentationUpid\":{\"0\":48,\"1\":120,\"2\":48,\"3\":48,\"4\":48,\"5\":48,\"6\":48,\"7\":48},\"segmentationTypeId\":48,\"segmentNum\":2,\"segmentsExpected\":0}],\"crc\":1501593624}",
          "minLength": 1,
          "maxLength": 8096
        },
        "region_type": {
          "type": "string",
          "description": "**参数解释**:\n该广告信号对应的region类型,是主region,还是备region\n**取值范围**:\n - master: 主region\n - slave: 备region",
          "enum": [
            "master",
            "slave"
          ],
          "minLength": 5,
          "maxLength": 6
        },
        "region": {
          "type": "string",
          "description": "**参数解释**:\n该广告信号对应的region区域\n**取值范围**:\n华为云的region",
          "minLength": 3,
          "maxLength": 20
        }
      },
      "description": "SCTE35信号信息的item结构。",
      "required": [
        "type",
        "event_id",
        "start_date",
        "duration",
        "segmentation_type",
        "base64_data",
        "raw_splice"
      ]
    },
    "SCTE35StatisticReq": {
      "type": "object",
      "description": "请求频道scte35信号的字段。",
      "required": [
        "type",
        "start_time",
        "end_time"
      ],
      "properties": {
        "type": {
          "type": "string",
          "example": "all",
          "description": "信号类型:all/splice_insert/time_signal。",
          "enum": [
            "all",
            "splice_insert",
            "time_signal"
          ],
          "minLength": 1,
          "maxLength": 16
        },
        "start_time": {
          "type": "integer",
          "format": "int64",
          "example": 1741650609,
          "description": "查询信号的起始时间,unix time,单位:秒。",
          "minimum": 1,
          "maximum": 4294967295
        },
        "end_time": {
          "type": "integer",
          "format": "int64",
          "example": 1741658609,
          "description": "查询信号的结束时间,unix time,单位:秒;实际使用使用比start_time大。",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "SCTE35StatisticRsp": {
      "type": "object",
      "description": "获取SCTE35信号的响应体。",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "example": 50,
          "description": "查询到scet35信息的总个数。",
          "minimum": 1,
          "maximum": 2147483648
        },
        "scte35_info": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SCTE35InfoItem"
          },
          "minItems": 0,
          "maxItems": 1000,
          "description": "详细的scte35信号的数组。"
        }
      },
      "required": [
        "total"
      ]
    },
    "ShowChannelStatisticReq": {
      "type": "object",
      "description": "查询OTT频道统计信息消息体。",
      "required": [
        "domain",
        "app_name",
        "id",
        "type"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "example": "www.huaweiott.pushdomain.com",
          "description": "频道推流域名。",
          "minLength": 1,
          "maxLength": 64
        },
        "app_name": {
          "type": "string",
          "example": "live",
          "description": "组名或应用名。",
          "minLength": 1,
          "maxLength": 64
        },
        "id": {
          "type": "string",
          "example": "channelId",
          "description": "频道ID。频道唯一标识,为必填项。",
          "minLength": 2,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "example": "scte35",
          "description": "统计信息的类型,scte35。",
          "enum": [
            "scte35"
          ],
          "minLength": 1,
          "maxLength": 32
        },
        "scte35": {
          "$ref": "#/definitions/SCTE35StatisticReq"
        },
        "region_type": {
          "type": "string",
          "description": "**参数解释**:\n频道对应的region类型,是主region,还是备region\n**约束限制**:\n如果region_type不填,或是没有该字段,则按照主region处理\n**取值范围**:\n- master: 主region\n- slave: 备region\n- all: 所有region",
          "default": "master",
          "enum": [
            "master",
            "slave",
            "all"
          ],
          "minLength": 3,
          "maxLength": 6
        }
      }
    },
    "DefaultErrorResp": {
      "type": "object",
      "description": "参数失败响应。",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "LIVE.10001100",
          "description": "错误码。",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "type": "string",
          "example": "Request parameters is invalid",
          "description": "错误描述。",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
