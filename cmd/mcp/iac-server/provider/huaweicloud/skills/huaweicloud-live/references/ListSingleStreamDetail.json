  "definitions": {
    "QuerySingleStreamDetailRsp": {
      "required": [
        "publish_domain",
        "app",
        "stream",
        "video_framerate",
        "video_bitrate"
      ],
      "properties": {
        "publish_domain": {
          "type": "string",
          "description": "推流域名",
          "minLength": 1,
          "maxLength": 64
        },
        "app": {
          "type": "string",
          "description": "应用名",
          "minLength": 1,
          "maxLength": 64
        },
        "stream": {
          "type": "string",
          "description": "流名",
          "minLength": 1,
          "maxLength": 256
        },
        "video_framerate": {
          "type": "array",
          "description": "展示流视频帧率情况,帧率单位为fps。\n\n如果出现断流则会出现多个时间段流信息,如:\n```\n\"video_framerate\": [\n    {\n      \"start_time\": \"2022-02-04T07:00:00Z\",\n      \"end_time\": \"2022-02-04T07:00:02Z\",\n      \"data_list\": [\n        21,\n        22\n      ]\n    },\n    {\n      \"start_time\": \"2022-02-04T07:00:05Z\",\n      \"end_time\": \"2022-02-04T07:00:07Z\",\n      \"data_list\": [\n        13,\n        34,\n        21\n      ]\n    }\n  ]\n",
          "minItems": 0,
          "maxItems": 1844674407,
          "items": {
            "$ref": "#/definitions/StreamDetail"
          }
        },
        "video_bitrate": {
          "type": "array",
          "description": "展示流视频码率情况,码率单位为Kbps。\n\n如果出现断流则会出现多个时间段流信息,如:\n```\n\"video_bitrate\": [\n    {\n      \"start_time\": \"2022-02-04T07:00:00Z\",\n      \"end_time\": \"2022-02-04T07:00:02Z\",\n      \"data_list\": [\n        1326,\n        1268,\n        775\n      ]\n    },\n    {\n      \"start_time\": \"2022-02-04T07:00:05Z\",\n      \"end_time\": \"2022-02-04T07:00:07Z\",\n      \"data_list\": [\n        1021,\n        2022\n      ]\n    }\n  ]\n",
          "minItems": 0,
          "maxItems": 1844674407,
          "items": {
            "$ref": "#/definitions/StreamDetail"
          }
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "StreamDetail": {
      "required": [
        "start_time",
        "end_time",
        "data_list"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "description": "采样开始时间。日期格式按照ISO8601表示法,并使用UTC时间。 格式为:YYYY-MM-DDThh:mm:ssZ。",
          "minLength": 1,
          "maxLength": 64
        },
        "end_time": {
          "type": "string",
          "description": "采样结束时间。日期格式按照ISO8601表示法,并使用UTC时间。 格式为:YYYY-MM-DDThh:mm:ssZ。",
          "minLength": 1,
          "maxLength": 64
        },
        "data_list": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "description": "流监控数据列表。",
          "minItems": 0,
          "maxItems": 24000
        }
      }
    }
  },
