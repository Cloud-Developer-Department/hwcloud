{
  "name": "UpdateDomain",
  "summary": "修改直播域名",
  "tags": "域名管理",
  "productshort": "Live",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/{project_id}/domain": {
      "put": {
        "tags": [
          "域名管理"
        ],
        "summary": "修改直播域名",
        "description": "修改直播播放、RTMP推流加速域名相关信息",
        "operationId": "UpdateDomain",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-external-api": true,
        "x-interface-frequency": "HIGH",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-live/live_03_0023.html)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "name": "UpdateDomainRequestBody",
            "in": "body",
            "description": "域名信息",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LiveDomainModifyReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "直播域名修改成功",
            "schema": {
              "$ref": "#/definitions/LiveDomainCreateRsp"
            },
            "examples": {
              "application/json": {
                "domain": "play.example.huawei.com",
                "domain_type": "pull",
                "domain_cname": "play.example.huawei.com.c.cdnhwc3.com",
                "region": "cn-north-1",
                "status": "off",
                "create_time": "2020-01-19T02:57:00Z"
              }
            }
          },
          "400": {
            "description": "参数错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Request Illegal"
              }
            }
          }
        },
        "x-request-examples-url-1": "PUT https://{endpoint}/v1/{project_id}/domain",
        "x-request-examples-1": {
          "domain": "play.example.huawei.com",
          "status": "off"
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "LiveDomainModifyReq": {
      "type": "object",
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "description": "直播域名,不允许修改",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "直播域名状态,通过修改此字段,实现域名的启用和停用。注意:域名处于“配置中”状态时,不允对该域名执行启停操作。",
          "enum": [
            "on",
            "off"
          ]
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID"
        }
      }
    },
    "LiveDomainCreateRsp": {
      "type": "object",
      "required": [
        "domain",
        "domain_type",
        "domain_cname",
        "region",
        "status",
        "create_time"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "description": "直播域名",
          "minLength": 1,
          "maxLength": 64
        },
        "domain_type": {
          "type": "string",
          "description": "域名类型\n- pull表示播放域名\n- push表示推流域名",
          "enum": [
            "pull",
            "push"
          ]
        },
        "domain_cname": {
          "type": "string",
          "description": "直播域名的CNAME"
        },
        "region": {
          "type": "string",
          "description": "直播所属直播中心"
        },
        "status": {
          "type": "string",
          "description": "直播域名的状态",
          "enum": [
            "on",
            "off",
            "configuring",
            "disable"
          ]
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "域名创建时间,格式:yyyy-mm-ddThh:mm:ssZ,UTC时间"
        },
        "status_describe": {
          "maxLength": 256,
          "minLength": 0,
          "type": "string",
          "description": "状态描述",
          "example": "arrear"
        },
        "service_area": {
          "type": "string",
          "description": "域名应用区域\n- mainland_china表示中国大陆区域\n- outside_mainland_china表示中国大陆以外区域\n- global表示全球加速区域",
          "enum": [
            "mainland_china",
            "outside_mainland_china",
            "global"
          ]
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID"
        },
        "pull_protocol": {
          "type": "string",
          "description": "域名支持的拉流协议;仅domain_type为pull时生效。若不填写此字段,视为默认支持FLV、RTMP拉流协议\n- flv_rtmp表示支持FLV、RTMP协议\n- hls表示支持HLS协议",
          "enum": [
            "flv_rtmp",
            "hls"
          ]
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "live.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}