  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "WatermarkRule": {
      "required": [
        "template_id",
        "domain"
      ],
      "properties": {
        "rule_name": {
          "type": "string",
          "description": "水印规则名称,如果不填会使用默认名称。默认名称的构造规则为“域名:应用名:流名”,示例“example.com:live:stream”。",
          "maxLength": 255,
          "minLength": 1
        },
        "template_id": {
          "type": "string",
          "description": "水印模板ID,只包含数字字母中划线,创建模板时生成",
          "maxLength": 255,
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "description": "域名",
          "maxLength": 255,
          "minLength": 1
        },
        "app": {
          "type": "string",
          "description": "APP名。须知:云直播场景是可选配置,媒体直播场景为必选配置。",
          "maxLength": 128,
          "minLength": 1
        },
        "stream": {
          "type": "string",
          "description": "流名OTT场景下,可以不填",
          "maxLength": 255,
          "minLength": 1
        },
        "location": {
          "description": "水印位置",
          "$ref": "#/definitions/WatermarkLocation"
        },
        "channel_id": {
          "type": "string",
          "description": "OTT场景使用,填对应频道的频ID",
          "minLength": 1,
          "maxLength": 64
        },
        "transcode_template_name": {
          "type": "string",
          "description": "OTT场景时,填频道对应的转码模板名称",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "type": "object"
    },
    "WatermarkLocation": {
      "properties": {
        "location": {
          "type": "string",
          "description": "水印位置。\n\n包含如下选项:\n- TOPLEFT:左上\n- TOPRIGHT:右上\n- BOTTOMLEFT:左下\n- BOTTOMRIGHT:右下\n- RANDOM:随机模式,图片水印将随机在视频流的左上、右上、左下、右下四个位置展示。",
          "maxLength": 255,
          "minLength": 1,
          "enum": [
            "TOPLEFT",
            "TOPRIGHT",
            "BOTTOMLEFT",
            "BOTTOMRIGHT",
            "RANDOM"
          ]
        },
        "x_offset": {
          "type": "number",
          "description": "水印相对输出视频的水平偏移量。\n说明:值有两种形式:\n1)整数型代表偏移像素,范围[1,4096],单位px。\n2)小数型代表水平偏移量与输出分辨率宽的比率,范围[0,1)\n百分比限制最多保留小数点后4位",
          "maximum": 4096,
          "minimum": 0
        },
        "y_offset": {
          "type": "number",
          "description": "水印相对输出视频的垂直偏移量\n说明: 值有两种形式:\n1)整数型代表偏移像素,范围[1,4096],单位px。\n2)小数型代表垂直偏移量与输出分辨率高的比率,范围[0,1)\n百分比限制最多保留小数点后4位",
          "maximum": 4096,
          "minimum": 0
        }
      },
      "type": "object"
    }
  },
