{
  "name": "ListGeoBlockingConfig",
  "summary": "获取地域限制配置列表",
  "tags": "鉴权管理",
  "productshort": "Live",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/domain/geo-blocking": {
      "get": {
        "tags": [
          "鉴权管理"
        ],
        "summary": "获取地域限制配置列表",
        "operationId": "ListGeoBlockingConfig",
        "description": "查询播放域名的地域限制列表。",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "play_domain",
            "in": "query",
            "description": "播放域名",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "x-example": "play.example.huawei.com"
          }
        ],
        "responses": {
          "200": {
            "description": "查询地域限制配置列表成功",
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。格式为:request_id-timestamp-hostname(request_id在服务器端生成UUID,timestamp为当前时间戳,hostname为处理当前接口的服务器名称)"
              }
            },
            "schema": {
              "$ref": "#/definitions/ListGeoBlockingConfigRsp"
            },
            "examples": {
              "application/json": {
                "play_domain": "play.example.huawei.com",
                "apps": [
                  {
                    "app": "live",
                    "area_whitelist": [
                      "CN-IN",
                      "CN-HK",
                      "CN-MO",
                      "CN-TW",
                      "BR"
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "查询地域限制配置列表失败",
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。格式为:request_id-timestamp-hostname(request_id在服务器端生成UUID,timestamp为当前时间戳,hostname为处理当前接口的服务器名称)"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Request Illegal"
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/domain/geo-blocking?play_domain=play.example.huawei.com"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "ListGeoBlockingConfigRsp": {
      "type": "object",
      "required": [
        "play_domain",
        "apps"
      ],
      "properties": {
        "play_domain": {
          "description": "直播播放域名",
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "example": "play.example.huawei.com"
        },
        "apps": {
          "type": "array",
          "description": "应用列表",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/GeoBlockingConfigInfo",
            "type": "object"
          }
        }
      }
    },
    "GeoBlockingConfigInfo": {
      "type": "object",
      "required": [
        "app"
      ],
      "properties": {
        "app": {
          "description": "应用名",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "example": "live"
        },
        "area_whitelist": {
          "type": "array",
          "description": "限制区域列表, 空列表表示不限制。\n除中国以外,其他地区代码,2位字母大写。代码格式参阅[ISO 3166-1\nalpha-2](https://www.iso.org/obp/ui/#search/code/)\n包含如下部分取值:\n- CN-IN:中国大陆\n- CN-HK:中国香港\n- CN-MO:中国澳门\n- CN-TW:中国台湾\n- BR:巴西",
          "minItems": 0,
          "maxItems": 500,
          "example": [
            "CN-IN",
            "CN-HK",
            "CN-MO",
            "CN-TW",
            "BR"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "required": false,
      "minLength": 1,
      "maxLength": 256,
      "description": "使用AK/SK方式认证时必填,携带的鉴权信息。",
      "type": "string",
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": false,
      "description": "用户Token,使用Token鉴权方式时必填。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目ID,获取方法请参考[获取项目ID](live_03_0023.xml)。",
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,携带项目ID信息。",
      "minLength": 1,
      "maxLength": 64,
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,请求的发生时间。",
      "minLength": 1,
      "maxLength": 256,
      "type": "string",
      "x-example": "20191115T033655Za"
    }
  },
  "host": "live.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}