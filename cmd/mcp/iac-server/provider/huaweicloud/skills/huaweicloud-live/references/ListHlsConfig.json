{
  "name": "ListHlsConfig",
  "summary": "查询域名HLS配置",
  "tags": "域名管理",
  "productshort": "Live",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/{project_id}/domain/hls": {
      "get": {
        "tags": [
          "域名管理"
        ],
        "summary": "查询域名HLS配置",
        "description": "查询域名HLS配置。",
        "operationId": "ListHlsConfig",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "push_domain",
            "in": "query",
            "description": "推流域名",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        ],
        "responses": {
          "200": {
            "description": "查询推流域名HLS配置成功",
            "schema": {
              "$ref": "#/definitions/HlsConfigResp"
            },
            "examples": {
              "application/json": {
                "push_domain": "push.example.com",
                "application": [
                  {
                    "name": "live",
                    "hls_fragment": 2,
                    "hls_ts_count": 3,
                    "hls_min_frags": 3
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Request Illegal"
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/domain/hls?push_domain=push.example.com"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "HlsConfigResp": {
      "type": "object",
      "required": [
        "push_domain",
        "application"
      ],
      "properties": {
        "push_domain": {
          "type": "string",
          "description": "推流域名",
          "example": "push.example.com",
          "minLength": 1,
          "maxLength": 255
        },
        "application": {
          "type": "array",
          "description": "推流域名APP配置",
          "items": {
            "$ref": "#/definitions/PushDomainApplication"
          }
        }
      }
    },
    "PushDomainApplication": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "应用名,默认为live",
          "default": "live"
        },
        "hls_fragment": {
          "type": "integer",
          "description": "HLS切片时长,单位:s。",
          "default": 2,
          "maximum": 10,
          "minimum": 1,
          "example": 3
        },
        "hls_ts_count": {
          "type": "integer",
          "description": "每个M3U8文件内ts切片个数",
          "default": 6,
          "maximum": 10,
          "minimum": 3,
          "example": 10
        },
        "hls_min_frags": {
          "type": "integer",
          "description": "每个M3U8文件内最小ts分片数",
          "default": 2,
          "maximum": 10,
          "minimum": 2,
          "example": 3
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "required": false,
      "minLength": 1,
      "maxLength": 256,
      "description": "使用AK/SK方式认证时必填,携带的鉴权信息。",
      "type": "string",
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": false,
      "description": "用户Token,使用Token鉴权方式时必填。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目ID,获取方法请参考[获取项目ID](live_03_0023.xml)。",
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,携带项目ID信息。",
      "minLength": 1,
      "maxLength": 64,
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,请求的发生时间。",
      "minLength": 1,
      "maxLength": 256,
      "type": "string",
      "x-example": "20191115T033655Za"
    }
  },
  "host": "live.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}