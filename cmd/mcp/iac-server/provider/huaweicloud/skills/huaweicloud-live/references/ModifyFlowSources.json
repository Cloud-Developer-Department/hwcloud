{
  "name": "ModifyFlowSources",
  "summary": "修改流来源",
  "tags": "流连接管理",
  "productshort": "Live",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/flows/sources": {
      "put": {
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/flows/sources?flow_id={flow_id}&source_name={source_name}",
        "x-request-examples-text-1": {
          "source": {
            "description": "test_caller",
            "min_latency": 2000,
            "source_listener_port": 5000,
            "source_listener_address": "srt://100.10.10.10",
            "cidr_whitelist": [
              "0.0.0.0/32"
            ],
            "protocol": "srt-caller",
            "name": "test_caller",
            "decryption": {
              "algorithm": "aes256",
              "key_type": "srt-password",
              "passphrase": "******"
            }
          }
        },
        "x-request-examples-1": {
          "source": {
            "description": "test_caller",
            "min_latency": 2000,
            "source_listener_port": 5000,
            "source_listener_address": "srt://100.10.10.10",
            "cidr_whitelist": [
              "0.0.0.0/32"
            ],
            "protocol": "srt-caller",
            "name": "test_caller",
            "decryption": {
              "algorithm": "aes256",
              "key_type": "srt-password",
              "passphrase": "******"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-apiexplorer-hide": "N",
        "tags": [
          "流连接管理"
        ],
        "summary": "修改流来源",
        "description": "修改流来源",
        "consumes": [
          "application/json;charset=utf-8"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "operationId": "ModifyFlowSources",
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "flow_id",
            "in": "query",
            "required": true,
            "description": "流id",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "ModifyFlowSourcesRequestBody",
            "in": "body",
            "required": true,
            "description": "修改流来源信息请求体",
            "schema": {
              "$ref": "#/definitions/ModifyFlowSourcesRequestBody"
            }
          },
          {
            "name": "source_name",
            "in": "query",
            "required": true,
            "description": "流源名称",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        ],
        "responses": {
          "200": {
            "description": "修改状态状态成功响应",
            "schema": {
              "$ref": "#/definitions/FlowSourceModityResp"
            },
            "examples": {
              "application/json": {
                "flow_id": "ec897482-d24b-4d64-aa39-407980902b1d",
                "source": {
                  "description": "test",
                  "source_listener_port": 5000,
                  "source_listener_address": "10.10.10.10",
                  "protocol": "srt-caller",
                  "name": "test",
                  "decryption": {
                    "algorithm": "aes256",
                    "key_type": "srt-password",
                    "passphrase": "******"
                  }
                }
              }
            }
          },
          "400": {
            "description": "失败响应",
            "schema": {
              "$ref": "#/definitions/FlowErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.103011019",
                "error_msg": "flow_id not exist"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "FlowErrorResp": {
      "type": "object",
      "description": "流失败响应",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "example": "LIVE.10301101",
          "minLength": 1,
          "maxLength": 64,
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "example": "The resource to create is already exists",
          "minLength": 1,
          "maxLength": 64,
          "description": "错误描述"
        }
      }
    },
    "ModifyFlowSourcesRequestBody": {
      "type": "object",
      "description": "修改入流信息请求体",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "description": "源流信息",
          "$ref": "#/definitions/FlowSource"
        }
      }
    },
    "FlowSourceModityResp": {
      "type": "object",
      "description": "修改入流信息响应体",
      "required": [
        "flow_id",
        "source"
      ],
      "properties": {
        "flow_id": {
          "type": "string",
          "description": "流id",
          "minLength": 1,
          "maxLength": 64
        },
        "source": {
          "description": "源流信息",
          "$ref": "#/definitions/FlowSource"
        }
      }
    },
    "FlowSourceDecryption": {
      "type": "object",
      "description": "StreamConnect flow解密信息",
      "required": [
        "key_type",
        "passphrase"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "aes128",
            "aes192",
            "aes256"
          ],
          "default": "aes256",
          "description": "加密算法,aes128: 加密算法为aes-128,aes192:加密算法为aes-192,aes256: 加密算法为AES-256"
        },
        "key_type": {
          "type": "string",
          "description": "秘钥类型,speke:使用speke协议获取秘钥,static-key:静态秘钥,srt-password:SRT协议秘钥\n目前仅支持srt-password类型,其他类型暂不支持",
          "enum": [
            "speke",
            "static-key",
            "srt-password"
          ]
        },
        "passphrase": {
          "type": "string",
          "minLength": 10,
          "maxLength": 79,
          "description": "srt解密秘钥,用于flow对srt流进行解密"
        }
      }
    },
    "FlowSource": {
      "type": "object",
      "description": "入流信息",
      "required": [
        "protocol",
        "name"
      ],
      "properties": {
        "source_listener_address": {
          "type": "string",
          "example": "",
          "description": "拉流地址",
          "minLength": 0,
          "maxLength": 255
        },
        "source_listener_port": {
          "type": "integer",
          "format": "int32",
          "example": 5000,
          "description": "拉流端口,2077/2088不可选",
          "minimum": 1024,
          "maximum": 65535
        },
        "stream_id": {
          "type": "string",
          "example": "",
          "description": "srt拉流streamid",
          "minLength": 1,
          "maxLength": 512
        },
        "min_latency": {
          "type": "integer",
          "format": "int32",
          "example": null,
          "description": "最小时延,单位ms",
          "minimum": 10,
          "maximum": 15000
        },
        "cidr_whitelist": {
          "type": "array",
          "example": "0.0.0.0/0",
          "description": "推流CIDR IP白名单列表",
          "maxItems": 20,
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "description": {
          "type": "string",
          "example": "",
          "description": "描述",
          "minLength": 0,
          "maxLength": 255
        },
        "protocol": {
          "type": "string",
          "example": "srt-caller",
          "description": "协议,srt-caller,srt-listener",
          "enum": [
            "srt-caller",
            "srt-listener"
          ],
          "minLength": 1,
          "maxLength": 16
        },
        "name": {
          "type": "string",
          "example": "",
          "description": "入流资源名称",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^([a-zA-Z0-9\\-_]){1,64}$"
        },
        "decryption": {
          "$ref": "#/definitions/FlowSourceDecryption"
        },
        "health_status": {
          "type": "string",
          "description": "**参数解释**:\n转推流状态\n**约束限制**:\n不涉及\n**取值范围**:\n- CONNECTED:转推中\n- DISCONNECTED:转推中断",
          "default": "DISCONNECTED",
          "enum": [
            "CONNECTED",
            "DISCONNECTED"
          ]
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "required": false,
      "minLength": 1,
      "maxLength": 256,
      "description": "使用AK/SK方式认证时必填,携带的鉴权信息。",
      "type": "string",
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": false,
      "description": "用户Token,使用Token鉴权方式时必填。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目ID,获取方法请参考[获取项目ID](live_03_0023.xml)。",
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,携带项目ID信息。",
      "minLength": 1,
      "maxLength": 64,
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,请求的发生时间。",
      "minLength": 1,
      "maxLength": 256,
      "type": "string",
      "x-example": "20191115T033655Za"
    }
  },
  "host": "live.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}