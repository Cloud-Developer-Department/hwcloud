{
  "name": "CreateRecordIndex",
  "summary": "创建录制视频索引文件",
  "tags": "录制索引管理",
  "productshort": "Live",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/record/indexes": {
      "post": {
        "tags": [
          "录制索引管理"
        ],
        "x-navigation-title": "录制索引管理",
        "operationId": "CreateRecordIndex",
        "summary": "创建录制视频索引文件",
        "description": "Create Record Index",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "\"项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-live/live_03_0023.html)\"",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "body",
            "name": "CreateRecordIndexRequestBody",
            "description": "Create Record Index Body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RecordIndexRequestBody"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "创建录制视频索引操作成功",
            "schema": {
              "$ref": "#/definitions/RecordIndexInfo"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。 格式为 request_id-timestamp-hostname(request_id在服务器端生成UUID, timestamp为当前时间戳,hostname为处理当前接口的服务器名称)"
              }
            }
          },
          "400": {
            "description": "创建录制视频索引操作失败",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。 格式为 request_id-timestamp-hostname(request_id在服务器端生成UUID, timestamp为当前时间戳,hostname为处理当前接口的服务器名称)"
              }
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "参数校验失败"
              }
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v1/{project_id}/record/indexes",
        "x-request-examples-1": {
          "publish_domain": "push.example.com",
          "app": "live",
          "stream": "index",
          "start_time": "2022-07-25T16:20:00+08:00",
          "end_time": "2022-07-25T16:30:00+08:00",
          "object": "Index/{publish_domain}/{app}/{stream}/{stream}-{start_time}-{end_time}"
        }
      }
    }
  },
  "definitions": {
    "RecordIndexInfo": {
      "properties": {
        "index_url": {
          "type": "string",
          "description": "索引文件地址",
          "format": "url",
          "example": "http://obs***.com/***/***/stream.m3u8"
        },
        "publish_domain": {
          "type": "string",
          "description": "直播推流域名",
          "format": "url",
          "example": "push.example.com"
        },
        "app": {
          "type": "string",
          "description": "应用名,如果任意应用填写*。录制规则匹配的时候,优先精确app匹配,如果匹配不到,则匹配*",
          "maxLength": 128,
          "minLength": 1,
          "example": "live"
        },
        "stream": {
          "type": "string",
          "description": "录制的流名,如果任意流名则填写*。录制规则匹配的时候,优先精确stream匹配,如果匹配不到,则匹配*",
          "maxLength": 128,
          "minLength": 1,
          "example": "stream-example"
        },
        "start_time": {
          "type": "string",
          "description": "开始时间。格式为:yyyy-MM-ddTHH:mm:ssZ(UTC时间)。(实际视频的开始时间)",
          "format": "date-time",
          "example": "2012-06-12T17:59:58Z"
        },
        "end_time": {
          "type": "string",
          "description": "结束时间。格式为:yyyy-MM-ddTHH:mm:ssZ(UTC时间)。(实际视频的结束时间)",
          "format": "date-time",
          "example": "2012-06-13T06:00:01Z"
        },
        "duration": {
          "type": "integer",
          "format": "int32",
          "description": "录制时长。单位:秒。",
          "minimum": 0,
          "maximum": 72000,
          "example": 1800
        },
        "width": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 65535,
          "description": "视频宽。",
          "example": 1080
        },
        "height": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 65535,
          "description": "视频高。",
          "example": 720
        },
        "location": {
          "type": "string",
          "description": "OBS Bucket所在RegionID",
          "enum": [
            "cn-north-4",
            "cn-north-5",
            "cn-north-6"
          ],
          "example": "cn-north-4"
        },
        "bucket": {
          "type": "string",
          "description": "桶名称",
          "minLength": 1,
          "maxLength": 255,
          "example": "Bucket"
        },
        "object": {
          "type": "string",
          "description": "m3u8文件路径。默认Index/{publish_domain}/{app}/{stream}-{start_time}-{end_time}",
          "example": "push.example.com/live/stream-example-2012-06-12T17:59:58Z-2012-06-13T06:00:01"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "RecordIndexRequestBody": {
      "required": [
        "publish_domain",
        "app",
        "stream",
        "start_time",
        "end_time"
      ],
      "properties": {
        "publish_domain": {
          "type": "string",
          "description": "推流域名",
          "format": "url",
          "example": "push.example.com"
        },
        "app": {
          "type": "string",
          "description": "app名",
          "minLength": 1,
          "maxLength": 128,
          "example": "live"
        },
        "stream": {
          "type": "string",
          "description": "流名",
          "minLength": 1,
          "maxLength": 128,
          "example": "stream-example"
        },
        "start_time": {
          "type": "string",
          "description": "开始时间。格式为:YYYY-MM-DDTHH:mm:ssZ(UTC时间),开始时间与结束时间的间隔最大为12小时。",
          "format": "date-time",
          "example": "2012-06-12T18:00:00Z"
        },
        "end_time": {
          "type": "string",
          "description": "结束时间。格式为:YYYY-MM-DDTHH:mm:ssZ(UTC时间),开始时间与结束时间的间隔最大为12小时。结束时间不允许大于当前时间。",
          "format": "date-time",
          "example": "2012-06-13T06:00:00Z"
        },
        "object": {
          "type": "string",
          "description": "\"m3u8文件在OBS中的储存路径。支持下列字符串的转义\n  - {publish_domain}\n  - {app}\n  - {stream}\n  - {start_time}\n  - {end_time}\n其中{start_time},{end_time}为返回结果的实际时间。 默认值为Index/{publish_domain}/{app}/{stream}/{stream}-{start_time}-{end_time}\"",
          "example": "{publish_domain}/{app}/{stream}-{start_time}-{end_time}"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "live.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}