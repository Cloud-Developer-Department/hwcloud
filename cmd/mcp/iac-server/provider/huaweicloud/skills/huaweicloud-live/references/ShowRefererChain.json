{
  "name": "ShowRefererChain",
  "summary": "查询Referer防盗链黑白名单",
  "tags": "鉴权管理",
  "productshort": "Live",
  "region_id": "cn-north-1",
  "paths": {
    "/v1/{project_id}/guard/referer-chain": {
      "get": {
        "tags": [
          "鉴权管理"
        ],
        "summary": "查询Referer防盗链黑白名单",
        "description": "查询Referer防盗链黑白名单",
        "operationId": "ShowRefererChain",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Authorization"
          },
          {
            "$ref": "#/parameters/X-Sdk-Date"
          },
          {
            "$ref": "#/parameters/X-Project-Id"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "domain",
            "in": "query",
            "description": "直播播放域名",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "x-example": "play.example.com"
          }
        ],
        "responses": {
          "200": {
            "description": "查询Referer黑白名单成功",
            "schema": {
              "$ref": "#/definitions/SetRefererChainInfo"
            },
            "examples": {
              "application/json": {
                "domain": "play.example.com",
                "guard_switch": "true",
                "referer_config_empty": "true",
                "referer_white_list": "false",
                "referer_auth_list": [
                  "^http://test.*com$",
                  "abc.com"
                ]
              }
            }
          },
          "400": {
            "description": "查询Referer黑白名单失败",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Request Illegal"
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/guard/referer-chain?domain=play.example.com"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string"
        }
      }
    },
    "SetRefererChainInfo": {
      "type": "object",
      "required": [
        "domain",
        "guard_switch"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "description": "直播域名",
          "minLength": 1,
          "maxLength": 255
        },
        "guard_switch": {
          "type": "string",
          "description": "referer防盗链开关:true表示开启;false表示关闭",
          "enum": [
            "true",
            "false"
          ],
          "default": "false"
        },
        "referer_config_empty": {
          "type": "string",
          "description": "是否包含referer头域:true表示包含;false表示不包含;guard_switch为true则必填",
          "enum": [
            "true",
            "false"
          ],
          "default": "false"
        },
        "referer_white_list": {
          "type": "string",
          "description": "是否为referer白名单:true表示白名单;false表示黑名单;guard_switch为true则必填",
          "enum": [
            "true",
            "false"
          ],
          "default": "true"
        },
        "referer_auth_list": {
          "type": "array",
          "description": "域名列表,域名为正则表达式;最多支持配置100个域名,以英文“;”进行分隔;guard_switch为true则必填",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Authorization": {
      "name": "Authorization",
      "in": "header",
      "required": false,
      "minLength": 1,
      "maxLength": 256,
      "description": "使用AK/SK方式认证时必填,携带的鉴权信息。",
      "type": "string",
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": false,
      "description": "用户Token,使用Token鉴权方式时必填。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "required": true,
      "description": "项目ID,获取方法请参考[获取项目ID](live_03_0023.xml)。",
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Project-Id": {
      "name": "X-Project-Id",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,携带项目ID信息。",
      "minLength": 1,
      "maxLength": 64,
      "type": "string",
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-Sdk-Date": {
      "name": "X-Sdk-Date",
      "in": "header",
      "required": false,
      "description": "使用AK/SK方式认证时必填,请求的发生时间。",
      "minLength": 1,
      "maxLength": 256,
      "type": "string",
      "x-example": "20191115T033655Za"
    }
  },
  "host": "live.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}