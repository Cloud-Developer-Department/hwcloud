{
  "name": "ListTranscodeData",
  "summary": "查询转码用量接口",
  "tags": "数据统计分析",
  "productshort": "Live",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/{project_id}/stats/transcode": {
      "get": {
        "tags": [
          "DataStatisticsAnalysis"
        ],
        "summary": "查询转码用量接口",
        "description": "查询直播域名每小时的转码时长数据。  最大查询跨度31天,最大查询周期90天。",
        "operationId": "ListTranscodeData",
        "deprecated": false,
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-external-api": true,
        "x-interface-frequency": "HIGH",
        "x-constraint": "该接口暂只支持查询部署在新版视频直播服务上的域名的相关数据(不包含“华北-北京一”)。此约束条件仅适用于中国站。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息, 与路径参数中的项目ID相同。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](https://support.huaweicloud.com/api-live/live_03_0023.html)。\n",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "query",
            "name": "publish_domain",
            "description": "推流域名。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 64
          },
          {
            "in": "query",
            "name": "stream",
            "description": "流名。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 16384
          },
          {
            "in": "query",
            "name": "start_time",
            "description": "起始时间。日期格式按照ISO8601表示法,并使用UTC时间。格式为:YYYY-MM-DDThh:mm:ssZ。\n\n非整点时间按小时取整,若start_time为2020-08-18T07:20:40Z,则实际查询起始时间为2020-08-18T07:00:00Z。\n\n若start_time为空,则默认查询最近24小时数据。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 64
          },
          {
            "in": "query",
            "name": "end_time",
            "description": "结束时间。日期格式按照ISO8601表示法,并使用UTC时间。格式为:YYYY-MM-DDThh:mm:ssZ。\n\n非整点时间按小时取整,若end_time为2020-08-18T08:20:40Z,则实际查询起始时间为2020-08-18T08:00:00Z。\n\n若参数为空,默认为当前时间。结束时间需大于起始时间。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 64
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。\n",
            "schema": {
              "$ref": "#/definitions/TranscodeDataRsp"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求的唯一标识。"
              }
            },
            "examples": {
              "application/json": {
                "transcode_data_list": [
                  {
                    "time": "2020-08-18T07:00:00Z",
                    "spec_list": [
                      {
                        "type": "H265_PVC_SD",
                        "value": 256.23
                      },
                      {
                        "type": "H265_PVC_HD",
                        "value": 128.41
                      }
                    ]
                  },
                  {
                    "time": "2020-08-18T08:00:00Z",
                    "spec_list": [
                      {
                        "type": "H265_PVC_SD",
                        "value": 52.35
                      },
                      {
                        "type": "H265_PVC_HD",
                        "value": 136.32
                      }
                    ]
                  }
                ],
                "summary_list": [
                  {
                    "type": "H265_PVC_SD",
                    "value": 308.58
                  },
                  {
                    "type": "H265_PVC_HD",
                    "value": 264.73
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误。\n",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求的唯一标识。"
              }
            },
            "examples": {
              "application/json": {
                "error_code": "LIVE.100011001",
                "error_msg": "Invalid request parameter: publish_domain"
              }
            }
          }
        },
        "x-request-examples-description-1": "查询推流域名转码用量",
        "x-request-examples-url-1": "GET /v2/{project_id}/stats/transcode?publish_domain=test.xxx.com&start_time=2020-08-18T07:00:00Z&end_time=2020-08-18T08:00:00Z\n"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "TranscodeSpec": {
      "type": "object",
      "properties": {
        "type": {
          "description": "转码规格,格式是“编码格式_分辨率档位”(未开启高清低码)和“编码格式_PVC_分辨率档位”(开启高清低码)。\n\n其中编码格式包括H264、H265,分辨率档位包括:\n\n4K(3840 x 2160)及以下,2K(2560 x 1440)及以下,FHD(1920 x 1080)及以下,HD(1280 x 720)及以下,SD(640 x 480)及以下。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1.7976931348623157e+308,
          "description": "采样时间点转码时长,单位为分钟,保留两位小数。"
        }
      }
    },
    "TranscodeDataRsp": {
      "type": "object",
      "properties": {
        "transcode_data_list": {
          "description": "采样数据列表。",
          "type": "array",
          "minItems": 0,
          "maxItems": 129600,
          "items": {
            "$ref": "#/definitions/TranscodeData"
          }
        },
        "summary_list": {
          "description": "指定时间区间内各转码规格转码时长总和。",
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/TranscodeSummary"
          }
        }
      }
    },
    "TranscodeData": {
      "type": "object",
      "properties": {
        "spec_list": {
          "description": "每个采样时间中的转码时长信息。",
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/TranscodeSpec"
          }
        },
        "time": {
          "type": "string",
          "description": "采样时间。日期格式按照ISO8601表示法,并使用UTC时间。 格式为:YYYY-MM-DDThh:mm:ssZ 。",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "TranscodeSummary": {
      "type": "object",
      "properties": {
        "type": {
          "description": "转码规格,格式是“编码格式_分辨率档位”(未开启高清低码)和“编码格式_PVC_分辨率档位”(开启高清低码)。\n\n其中编码格式包括H264、H265,分辨率档位包括:\n\n4K(3840 x 2160)及以下,2K(2560 x 1440)及以下,FHD(1920 x 1080)及以下,HD(1280 x 720)及以下,SD(640 x 480)及以下。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1.7976931348623157e+308,
          "description": "总转码时长,单位为分钟,保留两位小数。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "live.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}