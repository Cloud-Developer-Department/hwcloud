{
  "name": "ShowHttpOverviews",
  "summary": "查询攻击域名",
  "tags": "安全总览",
  "productshort": "EdgeSec",
  "region_id": "af-south-1",
  "paths": {
    "/v1/edgesec/stat/http/overviews/classification": {
      "get": {
        "tags": [
          "安全总览"
        ],
        "summary": "查询攻击域名",
        "description": "查询安全总览top信息,包含攻击域名、攻击源ip、攻击url、攻击来源区域、防护类型",
        "operationId": "ShowHttpOverviews",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户 token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id,默认为0",
            "schema": {
              "pattern": "^0$|^all_granted_eps$|^[0-9a-zA-Z]{8}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{12}$",
              "type": "string",
              "default": "0"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "起始时间",
            "required": true,
            "schema": {
              "minimum": 0,
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "结束时间",
            "required": true,
            "schema": {
              "minimum": 0,
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "top",
            "in": "query",
            "description": "要查询的前几的结果",
            "schema": {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "name": "domain_name",
            "in": "query",
            "description": "域名",
            "schema": {
              "pattern": "^[*a-zA-Z0-9_\\-.:]{0,1024}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowClassificationsResponseBody"
                }
              }
            }
          },
          "400": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "401": {
            "description": "token权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-iam-auth-meta-anno": {
          "authLevel": "token",
          "abacAction": "edgesec:wafOverviewsClassification:get",
          "rbac": "{\"op_service\",\"te_admin\",\"op_restricted\",\"readonly\"}"
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "esa.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}