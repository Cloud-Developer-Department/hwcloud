            "schema": {
              "type": "string"
            }
          },
          {
            "name": "policy_id",
            "in": "path",
            "description": "策略id",
            "required": true,
            "schema": {
              "pattern": "^[a-zA-Z0-9-]{32,36}$",
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "规则名称",
            "schema": {
