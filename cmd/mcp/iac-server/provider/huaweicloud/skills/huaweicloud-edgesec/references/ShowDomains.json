{
  "name": "ShowDomains",
  "summary": "查询防护域名列表",
  "tags": "防护域名管理",
  "productshort": "EdgeSec",
  "region_id": "af-south-1",
  "paths": {
    "/v1/edgesec/configuration/domains": {
      "get": {
        "tags": [
          "防护域名管理"
        ],
        "summary": "查询防护域名列表",
        "description": "查询防护域名列表",
        "operationId": "ShowDomains",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询列表的偏移量",
            "schema": {
              "minimum": 0,
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询列表每一页的条数",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          },
          {
            "name": "domain_name",
            "in": "query",
            "description": "域名",
            "schema": {
              "pattern": "^[*a-zA-Z0-9_\\-.:]{0,64}$",
              "type": "string"
            }
          },
          {
            "name": "policy_name",
            "in": "query",
            "description": "策略名称",
            "schema": {
              "pattern": "^[\\一-\\龥0-9a-zA-Z_\\-::.]{1,64}$",
              "type": "string"
            }
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id,默认为0",
            "schema": {
              "pattern": "^[a-zA-Z0-9-_]{0,64}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowDomainsInfo"
                }
              }
            }
          },
          "400": {
            "description": "请求失败",
            "content": {
