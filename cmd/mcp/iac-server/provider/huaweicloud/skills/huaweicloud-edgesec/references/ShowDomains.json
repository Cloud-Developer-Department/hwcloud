                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-iam-auth-meta-anno": {
          "abacAction": "edgesec:wafDomain:list",
          "rbac": "{\"op_service\",\"te_admin\",\"op_restricted\",\"readonly\"}",
          "authLevel": "TOKEN",
          "needApigwJwtAuthCheck": true,
