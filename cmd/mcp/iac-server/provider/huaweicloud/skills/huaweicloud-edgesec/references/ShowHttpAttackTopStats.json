{
  "name": "ShowHttpAttackTopStats",
  "summary": "查询HTTP攻击TOP数据",
  "tags": "Http统计",
  "productshort": "EdgeSec",
  "region_id": "af-south-1",
  "paths": {
    "/v1/edgesec/stat/http-attack-top": {
      "get": {
        "tags": [
          "Http统计"
        ],
        "description": "查询HTTP攻击TOP数据",
        "summary": "查询HTTP攻击TOP数据",
        "operationId": "ShowHttpAttackTopStats",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id,默认为0",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "domain_name",
            "in": "query",
            "description": "域名",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stat_type",
            "in": "query",
            "description": "指标类型。例如:req_num(请求次数)、bw(带宽)。目前只支持req_num",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "req_num",
                "bw"
              ]
            }
          },
          {
            "name": "group_by",
            "in": "query",
            "description": "分组类型。响应值按分组类型进行统计,类型可为:host(请求的服务器域名)、sip(请求的客户端IP)、url(请求URL)、rule(自定义的策略类型描述)、user-agent(用户代理)、method(请求方法)、country(国家维度统计)。",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "限制Top数量(不超过100,默认为10)",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          },
          {
            "name": "time_type",
            "in": "query",
            "description": "时间枚举(LATEST(最近30mins)、TODAY(今天)、CUSTOMIZE(自定义,昨天到近30天任意整数天内))",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "LATEST",
                "TODAY",
                "CUSTOMIZE"
              ]
            }
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "开始时间",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "结束时间",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpTopStatsResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRsp"
                }
              }
            }
          },
          "401": {
            "description": "token权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRsp"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRsp"
                }
              }
            }
          }
        },
        "x-iam-auth-meta-anno": {
          "abacAction": "edgesec:statistics:get",
          "authLevel": "TOKEN",
          "needResourceTagCheck": false,
          "needApigwJwtAuthCheck": true,
          "needAbacCheck": true,
          "needRbacCheck": false,
          "needAbacResourceCheck": false,
          "supportAllGrantedEps": true,
          "needCbcCheck": false,
          "model": "v5-pkitoken",
          "authContextInitializerName": "defaultIamAuthContextInitializer"
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
