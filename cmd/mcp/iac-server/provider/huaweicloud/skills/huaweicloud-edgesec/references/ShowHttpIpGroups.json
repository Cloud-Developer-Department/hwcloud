{
  "name": "ShowHttpIpGroups",
  "summary": "查询IP地址组列表",
  "tags": "Ip地址组管理",
  "productshort": "EdgeSec",
  "region_id": "af-south-1",
  "paths": {
    "/v1/edgesec/configuration/http/ip-groups": {
      "get": {
        "tags": [
          "Ip地址组管理"
        ],
        "summary": "查询IP地址组列表",
        "description": "查询IP地址组列表",
        "operationId": "ShowHttpIpGroups",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id,默认为0",
            "schema": {
              "pattern": "^0$|^all_granted_eps$|^[0-9a-zA-Z]{8}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{12}$",
              "type": "string",
              "default": "0"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "分页查询参数,第page页",
            "schema": {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pagesize",
            "in": "query",
            "description": "分页查询参数,每页显示pagesize条记录",
            "schema": {
              "maximum": 1000,
              "minimum": -1,
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "IP地址组名称",
            "schema": {
              "pattern": "^[\\一-\\龥0-9a-zA-Z_\\-::.]{1,64}$",
              "type": "string"
            }
          },
          {
            "name": "ip",
            "in": "query",
            "description": "IP地址/地址段",
            "schema": {
              "pattern": "[0-9a-zA-Z./:]+",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowHttpIpGroupsResponseBody"
                }
              }
            }
          },
          "400": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "401": {
            "description": "token权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-iam-auth-meta-anno": {
          "authLevel": "token",
          "abacAction": "edgesec:wafIpGroup:list",
          "rbac": "{\"op_service\",\"te_admin\",\"op_restricted\",\"readonly\"}"
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "esa.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}