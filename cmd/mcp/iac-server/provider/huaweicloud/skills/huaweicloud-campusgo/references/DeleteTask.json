{
  "name": "DeleteTask",
  "summary": "删除服务作业",
  "tags": "服务作业管理",
  "productshort": "CampusGo",
  "region_id": "cn-east-3",
  "paths": {
    "/{project_id}/services/{service_name}/tasks/{task_id}": {
      "delete": {
        "tags": [
          "服务作业管理"
        ],
        "operationId": "DeleteTask",
        "summary": "删除服务作业",
        "description": "该接口用于删除服务作业",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,64}$",
            "description": "用户项目ID"
          },
          {
            "name": "service_name",
            "in": "path",
            "required": true,
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^[a-z][a-z-]{0,98}[a-z]$",
            "description": "服务名称"
          },
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-f]{32}|task\\w{8}$",
            "description": "指定的服务作业ID"
          }
        ],
        "responses": {
          "202": {
            "description": "删除服务作业请求已接受"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponseBody": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "服务内部错误码",
          "type": "string",
          "pattern": "^IVA.\\d{4}$",
          "example": "IVA.0004"
        },
        "error_msg": {
          "description": "错误信息",
          "type": "string",
          "minLength": 0,
          "maxLength": 4096,
          "example": "The request param is invalid."
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
