{
  "name": "UpgradeEngineConfig",
  "summary": "更新微服务引擎配置",
  "tags": "引擎管理",
  "productshort": "CSE",
  "region_id": "af-south-1",
  "paths": {
    "/v2/{project_id}/enginemgr/engines/{engine_id}/config": {
      "put": {
        "tags": [
          "引擎管理"
        ],
        "summary": "更新微服务引擎配置",
        "description": "更新微服务引擎配置,更新ServiceComb专享版引擎与注册配置中心引擎的配置",
        "operationId": "UpgradeEngineConfig",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "description": "IAM-Token",
            "type": "string",
            "in": "header",
            "required": true
          },
          {
            "name": "X-Enterprise-Project-ID",
            "description": "如果不带则默认企业项目为\"default\",ID为\"0\"",
            "default": "0",
            "type": "string",
            "in": "header",
            "required": false
          },
          {
            "name": "project_id",
            "description": "项目id",
            "required": true,
            "in": "path",
            "type": "string"
          },
          {
            "name": "engine_id",
            "description": "更新的引擎Id",
            "in": "path",
            "type": "string",
            "required": true
          },
          {
            "name": "UpgradeEngineConfigRequestBody",
            "description": "更新微服务引擎配置请求体",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EngineConfigureReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "升级微服务引擎响应体。",
            "schema": {
              "$ref": "#/definitions/EngineCommonResp"
            }
          },
          "400": {
            "description": "错误的请求",
            "schema": {
              "$ref": "#/definitions/BadRequest"
            }
          },
          "500": {
            "description": "内部错误",
            "schema": {
              "$ref": "#/definitions/InternalServerError"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "EngineConfigureReq": {
      "type": "object",
      "description": "更新微服务引擎配置请求体。",
      "properties": {
        "authType": {
          "type": "string",
          "description": "authType安全认证类型,支持填写NONE和RBAC。"
        }
      },
      "required": [
        "authType"
      ],
      "example": {
        "authType": "RBAC"
      }
    },
    "EngineCommonResp": {
      "type": "object",
      "description": "操作微服务引擎响应结构体",
      "properties": {
        "id": {
          "type": "string",
          "description": "创建的微服务引擎ID"
        },
        "name": {
          "type": "string",
          "description": "创建的微服务引擎名称"
        },
        "jobId": {
          "type": "integer",
          "format": "int32",
          "description": "微服务引擎执行的任务ID"
        }
      }
    },
    "BadRequest": {
      "description": "错误的请求。",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string"
        },
        "error_msg": {
          "description": "错误信息。",
          "type": "string"
        }
      }
    },
    "InternalServerError": {
      "description": "服务内部错误",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string"
        },
        "error_msg": {
          "description": "错误信息。",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cse.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}