{
  "name": "RetryEngine",
  "summary": "对微服务引擎进行重试",
  "tags": "引擎管理",
  "productshort": "CSE",
  "region_id": "af-south-1",
  "paths": {
    "/v2/{project_id}/enginemgr/engines/{engine_id}/actions": {
      "put": {
        "tags": [
          "引擎管理"
        ],
        "summary": "对微服务引擎进行重试",
        "description": "对微服务引擎进行重试,当前支持ServiceComb专享版引擎",
        "operationId": "RetryEngine",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "description": "IAM-Token",
            "type": "string",
            "in": "header",
            "required": true
          },
          {
            "name": "X-Enterprise-Project-ID",
            "description": "如果不带则默认企业项目为\"default\",ID为\"0\"",
            "default": "0",
            "type": "string",
            "in": "header",
            "required": false
          },
          {
            "name": "project_id",
            "description": "项目id",
            "required": true,
            "in": "path",
            "type": "string"
          },
          {
            "name": "engine_id",
            "in": "path",
            "type": "string",
            "required": true,
            "description": "引擎id"
          },
          {
            "name": "RetryEngineRequestBody",
            "in": "body",
            "description": "重试微服务引擎的请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EngineAdditionalActionReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "重试微服务引擎的响应体。",
            "schema": {
              "$ref": "#/definitions/EngineCommonResp"
            }
          },
          "400": {
            "description": "重试失败",
            "schema": {
              "$ref": "#/definitions/BadRequest"
            }
          },
          "500": {
            "description": "服务器内部错误。",
            "schema": {
              "$ref": "#/definitions/InternalServerError"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "EngineCommonResp": {
      "type": "object",
      "description": "操作微服务引擎响应结构体",
      "properties": {
        "id": {
          "type": "string",
          "description": "创建的微服务引擎ID"
        },
        "name": {
          "type": "string",
          "description": "创建的微服务引擎名称"
        },
        "jobId": {
          "type": "integer",
          "format": "int32",
          "description": "微服务引擎执行的任务ID"
        }
      }
    },
    "BadRequest": {
      "description": "错误的请求。",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string"
        },
        "error_msg": {
          "description": "错误信息。",
          "type": "string"
        }
      }
    },
    "EngineAdditionalActionReq": {
      "type": "object",
      "description": "升级微服务引擎请求体",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "description": "操作类型",
          "type": "string",
          "enum": [
            "Retry"
          ]
        }
      },
      "example": {
        "action": "Retry"
      }
    },
    "InternalServerError": {
      "description": "服务内部错误",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string"
        },
        "error_msg": {
          "description": "错误信息。",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cse.af-south-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}