        },
        "error_msg": {
          "description": "错误信息。",
          "type": "string"
        }
      }
    },
    "FlavorBrief": {
      "type": "object",
      "description": "微服务引擎规格及描述",
      "properties": {
        "flavor": {
          "type": "string",
          "description": "微服务引擎规格"
        },
