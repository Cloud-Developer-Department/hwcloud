        "spec": {
          "type": "object",
          "$ref": "#/definitions/EngineSpec"
        }
      }
    },
    "InternalServerError": {
      "description": "服务内部错误",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string"
