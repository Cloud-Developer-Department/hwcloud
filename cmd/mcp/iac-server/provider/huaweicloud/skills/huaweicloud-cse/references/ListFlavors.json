{
  "name": "ListFlavors",
  "summary": "查询微服务引擎的规格列表",
  "tags": "引擎管理",
  "productshort": "CSE",
  "region_id": "af-south-1",
  "paths": {
    "/v2/{project_id}/enginemgr/flavors": {
      "get": {
        "tags": [
          "引擎管理"
        ],
        "summary": "查询微服务引擎的规格列表",
        "description": "查询微服务引擎的规格列表。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ListFlavors",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "description": "用户Token。",
            "in": "header",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户子项目的唯一标识。字符长度为1~64。",
            "required": true,
            "type": "string",
            "x-example": "79c4086f5f3a4e34a92601dfc64b1e8c"
          },
          {
            "name": "spec_type",
            "in": "query",
            "description": "微服务引擎应用部署类型,查询ServiceComb引擎专享版需要将该值设置为CSE2,查询注册配置中心需要将该值设置为Nacos2,查询网关需要将该值设置为MicroGateway。",
            "required": false,
            "type": "string",
            "x-example": "CSE2"
          }
        ],
        "responses": {
          "200": {
            "description": "查询微服务引擎的规格列表响应结构体。",
            "schema": {
              "$ref": "#/definitions/FlavorGetListResp"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "data": [
                  {
                    "flavor": "cse.s1.small2",
                    "description": "string"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "错误的请求。",
            "schema": {
              "$ref": "#/definitions/BadRequest"
            }
          },
          "500": {
            "description": "服务器内部错误。",
            "schema": {
              "$ref": "#/definitions/InternalServerError"
            }
          }
        }
      }
    }
  },
  "definitions": {
