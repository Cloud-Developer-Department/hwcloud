      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "微服务引擎规格总个数"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlavorBrief"
          },
          "description": "微服务引擎规格详情"
        }
      }
    },
    "EngineSpec": {
      "type": "object",
      "description": "微服务引擎相关参数。",
      "properties": {
        "availableCpuMemory": {
          "description": "CPU及内存规格。",
          "type": "string"
        },
        "linear": {
          "description": "是否为线性规格。",
          "type": "string"
        },
        "availablePrefix": {
          "description": "可用节点规格类型前缀。",
          "type": "string"
        }
      }
    },
    "BadRequest": {
      "description": "错误的请求。",
      "properties": {
        "error_code": {
          "description": "错误码。",
