{
  "name": "BatchExportPrivateKey",
  "summary": "批量导出密钥对私钥",
  "tags": "密钥对管理",
  "productshort": "KPS",
  "region_id": "cn-east-5",
  "paths": {
    "/v3/{project_id}/keypairs/private-key/batch-export": {
      "post": {
        "x-request-examples-description-1": "批量导出名称为”demo2,demo3, demo4\"的SSH密钥对。",
        "x-request-examples-text-1": [
          {
            "keypair": {
              "name": "demo2"
            }
          },
          {
            "keypair": {
              "name": "demo3"
            }
          },
          {
            "keypair": {
              "name": "demo4"
            }
          }
        ],
        "x-request-examples-1": [
          {
            "keypair": {
              "name": "demo2"
            }
          },
          {
            "keypair": {
              "name": "demo3"
            }
          },
          {
            "keypair": {
              "name": "demo4"
            }
          }
        ],
        "tags": [
          "密钥对管理"
        ],
        "summary": "批量导出密钥对私钥",
        "description": "批量导出密钥对私钥,单次最多导出10条数据",
        "operationId": "BatchExportPrivateKey",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "BatchExportPrivateKeyRequestBody",
            "in": "body",
            "required": true,
            "description": "待导出的密钥列表",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Keypairs"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/octet-stream": "keypairs.zip"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Keypairs": {
      "required": [
        "keypair"
      ],
      "properties": {
        "keypair": {
          "$ref": "#/definitions/Keypair"
        }
      },
      "type": "object"
    },
    "Keypair": {
      "description": "密钥对信息",
      "properties": {
        "name": {
          "type": "string",
          "description": "SSH密钥对的名称",
          "pattern": "^[A-Za-z0-9_-]{1,255}$"
        },
        "type": {
          "type": "string",
          "description": "SSH密钥对的类型,值为“ssh”或“x509”",
          "enum": [
            "ssh",
            "x509"
          ]
        },
        "scope": {
          "type": "string",
          "description": "租户级或者用户级。domain或user。",
          "enum": [
            "domain",
            "user"
          ]
        },
        "public_key": {
          "type": "string",
          "description": "SSH密钥对对应的publicKey信息",
          "minLength": 0,
          "maxLength": 1024
        },
        "fingerprint": {
          "type": "string",
          "description": "SSH密钥对应指纹信息",
          "minLength": 0,
          "maxLength": 255
        },
        "is_key_protection": {
          "type": "boolean",
          "description": "是否托管密钥"
        },
        "frozen_state": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "冻结状态\n- 0:正常状态\n- 1:普通冻结\n- 2:公安冻结\n- 3:普通冻结及公安冻结\n- 4:违规冻结\n- 5:普通冻结及违规冻结\n- 6:公安冻结及违规冻结\n- 7:普通冻结、公安冻结及违规冻结\n- 8:未实名认证冻结\n- 9:普通冻结及未实名认证冻结\n- 10:公安冻结及未实名认证冻结"
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.cn-east-5.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}