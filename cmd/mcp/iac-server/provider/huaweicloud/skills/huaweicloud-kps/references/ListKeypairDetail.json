{
  "name": "ListKeypairDetail",
  "summary": "查询SSH密钥对详细信息",
  "tags": "密钥对管理",
  "productshort": "KPS",
  "region_id": "cn-east-2",
  "paths": {
    "/v3/{project_id}/keypairs/{keypair_name}": {
      "get": {
        "tags": [
          "密钥对管理"
        ],
        "operationId": "ListKeypairDetail",
        "summary": "查询SSH密钥对详细信息",
        "description": "查询SSH密钥对详细信息",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "keypair_name",
            "in": "path",
            "description": "密钥对名称",
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "required": true,
            "x-example": "keyalias"
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "schema": {
              "$ref": "#/definitions/ListKeypairDetailResponseBody"
            },
            "examples": {
              "application/json": {
                "keypair": {
                  "name": "1hprr3TI",
                  "id": 116248,
                  "type": "ssh",
                  "scope": "user",
                  "public_key": "ssh-rsa AAAGenerated-by-Nova\n",
                  "fingerprint": "65:ca:87:0a:16:86:59:ea:57:ea:18:37:58:e2:04:b0",
                  "is_key_protection": false,
                  "deleted": false,
                  "description": "12345",
                  "user_id": "6c2a33b1b8474d0dbac0a24297127525",
                  "create_time": 1581507580000,
                  "delete_time": null,
                  "update_time": null,
                  "frozen_state": 0
                }
              }
            }
          },
          "400": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "KPS.XXX",
                "error_msg": "XXX"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ListKeypairDetailResponseBody": {
      "description": "SSH密钥对详情信息",
      "properties": {
        "keypair": {
          "$ref": "#/definitions/KeypairDetail"
        }
      }
    },
    "KeypairDetail": {
      "description": "密钥对详细信息",
      "properties": {
        "name": {
          "type": "string",
          "description": "SSH密钥对的名称",
          "pattern": "^[A-Za-z0-9_-]{1,255}$"
        },
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "SSH密钥对的ID",
          "minimum": 0,
          "maximum": 1000000000
        },
        "type": {
          "type": "string",
          "description": "SSH密钥对的类型。ssh或x509。",
          "enum": [
            "ssh",
            "x509"
          ]
        },
        "scope": {
          "type": "string",
          "description": "租户级或者用户级。domain或user。",
          "enum": [
            "domain",
            "user"
          ]
        },
        "public_key": {
          "type": "string",
          "description": "SSH密钥对对应的publicKey信息",
          "minLength": 0,
          "maxLength": 1024
        },
        "fingerprint": {
          "type": "string",
          "description": "SSH密钥对应指纹信息",
          "minLength": 0,
          "maxLength": 255
        },
        "is_key_protection": {
          "type": "boolean",
          "description": "是否托管密钥"
        },
        "deleted": {
          "type": "boolean",
          "description": "SSH密钥对删除的标记"
        },
        "description": {
          "type": "string",
          "description": "SSH密钥对的描述信息",
          "minLength": 0,
          "maxLength": 255
        },
        "user_id": {
          "type": "string",
          "description": "SSH密钥对所属的用户信息",
          "pattern": "^[0-9a-zA-Z]{1,64}$"
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 10000000000000,
          "description": "SSH密钥对创建的时间,时间戳,即从1970年1月1日至该时间的总秒数"
        },
        "delete_time": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 10000000000000,
          "description": "SSH密钥对删除的时间,时间戳,即从1970年1月1日至该时间的总秒数"
        },
        "update_time": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 10000000000000,
          "description": "SSH密钥对的更新时间,时间戳,即从1970年1月1日至该时间的总秒数"
        },
        "frozen_state": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 64,
          "description": "冻结状态\n- 0:正常状态\n- 1:普通冻结\n- 2:公安冻结\n- 3:普通冻结及公安冻结\n- 4:违规冻结\n- 5:普通冻结及违规冻结\n- 6:公安冻结及违规冻结\n- 7:普通冻结、公安冻结及违规冻结\n- 8:未实名认证冻结\n- 9:普通冻结及未实名认证冻结\n- 10:公安冻结及未实名认证冻结"
        },
        "key_id": {
          "type": "string",
          "description": "密钥ID。",
          "minLength": 0,
          "maxLength": 64
        },
        "algorithm": {
          "type": "string",
          "description": "生成算法。",
          "minLength": 0,
          "maxLength": 32
        }
      },
      "type": "object"
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.cn-east-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}