{
  "name": "ListKeypairTask",
  "summary": "查询任务信息",
  "tags": "密钥对任务管理",
  "productshort": "KPS",
  "region_id": "me-east-1",
  "paths": {
    "/v3/{project_id}/tasks/{task_id}": {
      "get": {
        "tags": [
          "密钥对任务管理"
        ],
        "operationId": "ListKeypairTask",
        "summary": "查询任务信息",
        "description": "根据SSH密钥对接口返回的task_id,查询SSH密钥对当前任务的执行状态。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "task_id",
            "in": "path",
            "description": "任务ID",
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "required": true,
            "x-example": "1f48bb43-1730-4f09-9457-f18faae68c24"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/TaskInfoResponseBody"
            },
            "examples": {
              "application/json": {
                "task_id": "aee8d2fe-5484-4753-9177-5a38dc15546c",
                "task_status": "RUNNING_RESET",
                "server_id": "c9aa197b-a6b6-4c33-b3a6-fa0b4ec50006"
              }
            }
          },
          "400": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "KPS.XXX",
                "error_msg": "XXX"
              }
            }
          }
        },
        "x-order": 3
      }
    }
  },
  "definitions": {
    "TaskInfoResponseBody": {
      "description": "任务响应信息。",
      "properties": {
        "server_id": {
          "type": "string",
          "description": "租户虚拟机ID",
          "minLength": 0,
          "maxLength": 64
        },
        "task_id": {
          "type": "string",
          "description": "任务下发成功返回的ID",
          "minLength": 36,
          "maxLength": 36
        },
        "task_status": {
          "type": "string",
          "description": "密钥对正在处理的状态。\n- READY_RESET 准备重置\n- RUNNING_RESET 正在重置\n- FAILED_RESET 重置失败\n- SUCCESS_RESET 重置成功\n- READY_REPLACE 准备替换\n- RUNNING_REPLACE 正在替换\n- FAILED_RESET 替换失败\n- SUCCESS_RESET 替换成功\n- READY_UNBIND 准备解绑\n- RUNNING_UNBIND 正在解绑\n- FAILED_UNBIND 解绑失败\n- SUCCESS_UNBIND 解绑成功",
          "enum": [
            "READY_RESET",
            "RUNNING_RESET",
            "FAILED_RESET",
            "SUCCESS_RESET",
            "READY_REPLACE",
            "RUNNING_REPLACE",
            "READY_UNBIND",
            "RUNNING_UNBIND",
            "FAILED_UNBIND",
            "SUCCESS_UNBIND"
          ]
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.me-east-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}