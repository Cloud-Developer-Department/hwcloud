{
  "name": "ExportPrivateKey",
  "summary": "导出私钥",
  "tags": "密钥对管理",
  "productshort": "KPS",
  "region_id": "my-kualalumpur-1",
  "paths": {
    "/v3/{project_id}/keypairs/private-key/export": {
      "post": {
        "x-request-examples-text-1": {
          "keypair": {
            "name": "demo2"
          }
        },
        "tags": [
          "密钥对管理"
        ],
        "operationId": "ExportPrivateKey",
        "summary": "导出私钥",
        "description": "导出指定密钥对的私钥。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "ExportPrivateKeyRequestBody",
            "in": "body",
            "description": "导出私钥消息体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ExportPrivateKeyRequestBody"
            }
          }
        ],
        "x-request-examples-1": {
          "keypair": {
            "name": "demo2"
          }
        },
        "responses": {
          "200": {
            "description": "请求已成功",
            "schema": {
              "$ref": "#/definitions/ExportPrivateKeyResponseBody"
            },
            "examples": {
              "application/json": {
                "keypair": {
                  "name": "demo2",
                  "private_key": "-----BEGIN RSA PRIVATE KEY-----..."
                }
              }
            }
          },
          "400": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "KPS.XXX",
                "error_msg": "XXX"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "KeypairBean": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "SSH密钥对名称。",
          "pattern": "^[A-Za-z0-9_-]{1,255}$"
        }
      },
      "required": [
        "name"
      ]
    },
    "ExportPrivateKeyResponseBody": {
      "type": "object",
      "properties": {
        "keypair": {
          "$ref": "#/definitions/ExportPrivateKeyKeypairBean"
        }
      },
      "description": "导出私钥响应体。",
      "required": [
        "keypair"
      ]
    },
    "ExportPrivateKeyKeypairBean": {
      "type": "object",
      "required": [
        "name",
        "private_key"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "SSH密钥对的名称。",
          "pattern": "^[A-Za-z0-9_-]{1,255}$"
        },
        "private_key": {
          "type": "string",
          "description": "SSH密钥对的私钥",
          "minLength": 0,
          "maxLength": 65535
        }
      }
    },
    "ExportPrivateKeyRequestBody": {
      "type": "object",
      "properties": {
        "keypair": {
          "$ref": "#/definitions/KeypairBean"
        }
      },
      "description": "导出私钥请求体",
      "required": [
        "keypair"
      ]
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.my-kualalumpur-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}