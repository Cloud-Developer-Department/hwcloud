{
  "name": "ImportPrivateKey",
  "summary": "导入私钥",
  "tags": "密钥对管理",
  "productshort": "KPS",
  "region_id": "tr-west-1",
  "paths": {
    "/v3/{project_id}/keypairs/private-key/import": {
      "post": {
        "x-request-examples-text-1": {
          "keypair": {
            "name": "demo2",
            "key_protection": {
              "private_key": "-----BEGIN RSA PRIVATE KEY-----...",
              "encryption": {
                "type": "kms",
                "kms_key_name": "kps/default"
              }
            }
          }
        },
        "tags": [
          "密钥对管理"
        ],
        "operationId": "ImportPrivateKey",
        "summary": "导入私钥",
        "description": "导入私钥到指定密钥对。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "ImportPrivateKeyRequestBody",
            "in": "body",
            "description": "导入私钥消息体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ImportPrivateKeyRequestBody"
            }
          }
        ],
        "x-request-examples-1": {
          "keypair": {
            "name": "demo2",
            "key_protection": {
              "private_key": "-----BEGIN RSA PRIVATE KEY-----...",
              "encryption": {
                "type": "kms",
                "kms_key_name": "kps/default"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "请求已成功",
            "schema": {
              "$ref": "#/definitions/ImportPrivateKeyResponseBody"
            },
            "examples": {
              "application/json": {
                "keypair": {
                  "name": "demo2"
                }
              }
            }
          },
          "400": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "KPS.XXX",
                "error_msg": "XXX"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "KeyProtection": {
      "description": "SSH密钥对私钥托管与保护。",
      "properties": {
        "private_key": {
          "type": "string",
          "description": "导入SSH密钥对的私钥。",
          "minLength": 0,
          "maxLength": 65535
        },
        "encryption": {
          "$ref": "#/definitions/Encryption"
        }
      },
      "type": "object",
      "required": [
        "encryption"
      ]
    },
    "ImportPrivateKeyRequestBody": {
      "type": "object",
      "required": [
        "keypair"
      ],
      "properties": {
        "keypair": {
          "$ref": "#/definitions/ImportPrivateKeyKeypairBean"
        }
      },
      "description": "导入私钥请求体"
    },
    "ImportPrivateKeyKeypairBean": {
      "type": "object",
      "required": [
        "name",
        "key_protection"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "SSH密钥对的名称。 - 新创建的密钥对名称不能和已有密钥对的名称相同。 - SSH密钥对名称由英文字母、数字、下划线、中划线组成,长度不能超过64个字节",
          "pattern": "^[A-Za-z0-9_-]{1,255}$"
        },
        "user_id": {
          "type": "string",
          "description": "SSH密钥对所属的用户信息",
          "pattern": "^[0-9a-zA-Z]{1,64}$"
        },
        "key_protection": {
          "$ref": "#/definitions/ImportPrivateKeyProtection"
        }
      }
    },
    "ImportPrivateKeyProtection": {
      "description": "SSH密钥对私钥托管与保护。",
      "properties": {
        "private_key": {
          "type": "string",
          "description": "导入SSH密钥对的私钥。",
          "minLength": 0,
          "maxLength": 65535
        },
        "encryption": {
          "$ref": "#/definitions/Encryption"
        }
      },
      "type": "object",
      "required": [
        "private_key",
        "encryption"
      ]
    },
    "ImportPrivateKeyResponseBody": {
      "type": "object",
      "properties": {
        "keypair": {
          "required": true,
          "$ref": "#/definitions/ImportPrivateKeyAction"
        }
      },
      "description": "导入私钥响应体"
    },
    "ImportPrivateKeyAction": {
      "type": "object",
      "required": [
        "name",
        "key_protection"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "SSH密钥对的名称。 - 新创建的密钥对名称不能和已有密钥对的名称相同。 - SSH密钥对名称由英文字母、数字、下划线、中划线组成,长度不能超过64个字节。",
          "pattern": "^[A-Za-z0-9_-]{1,255}$"
        },
        "user_id": {
          "type": "string",
          "description": "SSH密钥对所属的用户信息",
          "pattern": "^[0-9a-zA-Z]{1,64}$"
        },
        "key_protection": {
          "$ref": "#/definitions/KeyProtection"
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    },
    "Encryption": {
      "description": "对私钥进行加密存储的方式。",
      "properties": {
        "type": {
          "type": "string",
          "description": "取值范围:“kms”或“default”。\n- “default”为默认加密方式,适用于没有kms服务的局点。\n- “kms”为采用kms服务加密方式。\n若局点没有kms服务,请填“default”。",
          "enum": [
            "default",
            "kms"
          ]
        },
        "kms_key_name": {
          "type": "string",
          "description": "kms密钥的名称。\n - 若“type”为“kms”,则必须填入\"kms_key_name\"或\"kms_key_id\"。",
          "minLength": 0,
          "maxLength": 255
        },
        "kms_key_id": {
          "type": "string",
          "description": "kms密钥的ID。\n - 若“type”为“kms”,则必须填入\"kms_key_name\"或\"kms_key_id\"。",
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$",
          "minLength": 36,
          "maxLength": 36
        }
      },
      "type": "object",
      "required": [
        "type"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.tr-west-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}