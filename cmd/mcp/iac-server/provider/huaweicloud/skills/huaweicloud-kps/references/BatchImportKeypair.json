{
  "name": "BatchImportKeypair",
  "summary": "批量导入SSH密钥对",
  "tags": "密钥对管理",
  "productshort": "KPS",
  "region_id": "cn-southwest-3",
  "paths": {
    "/v3/{project_id}/keypairs/batch-import": {
      "post": {
        "x-request-examples-description-1": "批量导入名称为”demo2,demo3\"的SSH密钥对。",
        "x-request-examples-text-1": [
          {
            "keypair": {
              "name": "demo2",
              "public_key": "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAAA... Generated-by-Nova\n"
            }
          },
          {
            "keypair": {
              "name": "demo3",
              "public_key": "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAAA... Generated-by-Nova\n"
            }
          }
        ],
        "x-request-examples-1": [
          {
            "keypair": {
              "name": "demo2",
              "public_key": "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAAA... Generated-by-Nova\n"
            }
          },
          {
            "keypair": {
              "name": "demo3",
              "public_key": "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAAA... Generated-by-Nova\n"
            }
          }
        ],
        "tags": [
          "密钥对管理"
        ],
        "summary": "批量导入SSH密钥对",
        "description": "批量导入SSH密钥对,单次批量导入不得超过10条记录。",
        "operationId": "BatchImportKeypair",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "BatchImportKeypairRequestBody",
            "in": "body",
            "required": true,
            "description": "待批量导入的密钥对列表",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/CreateKeypairRequestBody"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "批量导入SSH密钥对响应信息",
            "schema": {
              "$ref": "#/definitions/BatchImportKeypairResponseBody"
            },
            "examples": {
              "application/json": {
                "failed_keypairs": [
                  {
                    "keypair_name": "demo3",
                    "failed_reason": "{\"error_code\":\"KPS.7004\", \"error_msg\":\"Key pair 'demo3' already exists.\"}"
                  }
                ],
                "succeeded_keypairs": [
                  {
                    "keypair": {
                      "name": "demo2",
                      "fingerprint": "SHA256:Wm91+h496cPk5JleSp4RdD2n4Z/5KdlDeD51lmiZ11M",
                      "type": "ssh",
                      "public_key": "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAAA... Generated-by-Nova\n",
                      "user_id": "6c2a33b1b8474d0dbac0a24297127525"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CreateKeypairAction": {
      "required": [
        "name"
      ],
      "description": "创建密钥对请求体请求参数",
      "properties": {
        "name": {
          "type": "string",
          "description": "SSH密钥对的名称。\n- 新创建的密钥对名称不能和已有密钥对的名称相同。\n- SSH密钥对名称由英文字母、数字、下划线、中划线组成,长度不能超过255个字节",
          "pattern": "^[A-Za-z0-9_-]{1,255}$"
        },
        "type": {
          "type": "string",
          "description": "SSH密钥对的类型。ssh或x509。",
          "enum": [
            "ssh",
            "x509"
          ]
        },
        "public_key": {
          "type": "string",
          "description": "导入公钥的字符串信息。",
          "minLength": 0,
          "maxLength": 1024
        },
        "scope": {
          "type": "string",
          "description": "租户级或者用户级。domain或user。",
          "enum": [
            "domain",
            "user"
          ]
        },
        "user_id": {
          "type": "string",
          "description": "SSH密钥对所属的用户信息",
          "pattern": "^[0-9a-zA-Z]{1,64}$"
        },
        "key_protection": {
          "$ref": "#/definitions/KeyProtection"
        }
      },
      "type": "object"
    },
    "FailedKeypair": {
      "type": "object",
      "required": [
        "keypair_name",
        "failed_reason"
      ],
      "properties": {
        "keypair_name": {
          "type": "string",
          "description": "SSH密钥对名称",
          "minLength": 2,
          "maxLength": 255
        },
        "failed_reason": {
          "type": "string",
          "description": "导入失败的原因",
          "minLength": 2,
          "maxLength": 512
        }
      }
    },
    "KeyProtection": {
      "description": "SSH密钥对私钥托管与保护。",
      "properties": {
        "private_key": {
          "type": "string",
          "description": "导入SSH密钥对的私钥。",
          "minLength": 0,
          "maxLength": 65535
        },
        "encryption": {
          "$ref": "#/definitions/Encryption"
        }
      },
      "type": "object",
      "required": [
        "encryption"
      ]
    },
    "CreateKeypairResp": {
      "description": "SSH密钥对信息详情",
      "properties": {
        "name": {
          "type": "string",
          "description": "SSH密钥对的名称",
          "pattern": "^[A-Za-z0-9_-]{1,255}$"
        },
        "type": {
          "type": "string",
          "description": "SSH密钥对的类型。ssh或x509。",
          "enum": [
            "ssh",
            "x509"
          ]
        },
        "public_key": {
          "type": "string",
          "description": "SSH密钥对对应的publicKey信息",
          "minLength": 0,
          "maxLength": 1024
        },
        "private_key": {
          "type": "string",
          "description": "SSH密钥对对应的privateKey信息\n- 创建SSH密钥对时,响应中包括private_key的信息。\n- 导入SSH密钥对时,响应中不包括private_key的信息。",
          "minLength": 0,
          "maxLength": 65535
        },
        "fingerprint": {
          "type": "string",
          "description": "SSH密钥对应指纹信息",
          "minLength": 0,
          "maxLength": 255
        },
        "user_id": {
          "type": "string",
          "description": "SSH密钥对所属的用户信息",
          "pattern": "^[0-9a-zA-Z]{1,64}$"
        }
      }
    },
    "CreateKeypairRequestBody": {
      "required": [
        "keypair"
      ],
      "description": "创建密钥对请求体",
      "properties": {
        "keypair": {
          "$ref": "#/definitions/CreateKeypairAction"
        }
      }
    },
    "BatchImportKeypairResponseBody": {
      "type": "object",
      "required": [
        "failed_keypairs",
        "succeeded_keypairs"
      ],
      "properties": {
        "failed_keypairs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FailedKeypair"
          },
          "description": "导入失败的SSH密钥对信息及导入失败的原因"
        },
        "succeeded_keypairs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CreateKeypairResponseBody"
          },
          "description": "成功导入的SSH密钥对信息"
        }
      }
    },
    "CreateKeypairResponseBody": {
      "description": "SSH密钥对的详情",
      "properties": {
        "keypair": {
          "$ref": "#/definitions/CreateKeypairResp"
        }
      }
    },
    "Encryption": {
      "description": "对私钥进行加密存储的方式。",
      "properties": {
        "type": {
          "type": "string",
          "description": "取值范围:“kms”或“default”。\n- “default”为默认加密方式,适用于没有kms服务的局点。\n- “kms”为采用kms服务加密方式。\n若局点没有kms服务,请填“default”。",
          "enum": [
            "default",
            "kms"
          ]
        },
        "kms_key_name": {
          "type": "string",
          "description": "kms密钥的名称。\n - 若“type”为“kms”,则必须填入\"kms_key_name\"或\"kms_key_id\"。",
          "minLength": 0,
          "maxLength": 255
        },
        "kms_key_id": {
          "type": "string",
          "description": "kms密钥的ID。\n - 若“type”为“kms”,则必须填入\"kms_key_name\"或\"kms_key_id\"。",
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$",
          "minLength": 36,
          "maxLength": 36
        }
      },
      "type": "object",
      "required": [
        "type"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.cn-southwest-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}