{
  "name": "DownloadKeystore",
  "summary": "KeyStore文件下载",
  "tags": "编译构建(旧)",
  "productshort": "CodeArtsBuild",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v3/keystore": {
      "get": {
        "tags": [
          "CodeArtsBuild"
        ],
        "summary": "KeyStore文件下载",
        "description": "下载指定租户下的KeyStore文件",
        "operationId": "DownloadKeystore",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/octet-stream"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "name": "file_name",
            "in": "query",
            "description": "下载的文件名称",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "x-example": "android.keystore"
          },
          {
            "name": "domain_id",
            "in": "query",
            "description": "租户ID。32位数字、小写字母组合",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-z]{32}$",
            "x-example": "60021bab32fd450aa2cb89226f425e06"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "string",
              "format": "binary"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "GET https://{endpoint}/v3/keystore?file_name=android.keystore&domain_id=60021bab32fd450aa2cb89226f425e06",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-internel": "false",
        "x-apigateway-ratelimit": "cloudbuild_ext",
        "x-api-type": "open-api"
      }
    }
  },
  "definitions": {
    "ErrorResponseBody": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "CB.00060200"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "Invalid param"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务接口获取\n(响应消息头中X-Subject-Token的值)。\n不支持租户全局token,请使用scope为project的region级token。",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
    }
  },
  "host": "cloudbuild-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}