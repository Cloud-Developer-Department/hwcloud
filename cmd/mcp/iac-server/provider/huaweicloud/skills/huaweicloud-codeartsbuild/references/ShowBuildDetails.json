{
  "name": "ShowBuildDetails",
  "summary": "根据持续构建名称,获取任务构建状态、百分比、剩余时间",
  "tags": "构建任务管理",
  "productshort": "CodeArtsBuild",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/job/{job_id}/{build_no}/build-info": {
      "get": {
        "tags": [
          "JobManager"
        ],
        "summary": "根据持续构建名称,获取任务构建状态、百分比、剩余时间",
        "description": "根据持续构建名称,获取任务构建状态、百分比、剩余时间",
        "operationId": "ShowBuildDetails",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Job_Id"
          },
          {
            "$ref": "#/parameters/Build_No"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/JobStatusResultResponseBody"
            },
            "examples": {
              "application/json": {
                "result": {
                  "building": false,
                  "build_result": "FAILURE",
                  "region": "xx-xxxx-xx"
                },
                "error": null,
                "status": "success"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "GET https://{endpoint}/v1/job/{job_id}/{build_no}/build-info",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-internel": "false",
        "x-apigateway-ratelimit": "ten_50_min",
        "x-api-type": "open-api"
      }
    }
  },
  "definitions": {
    "ErrorResponseBody": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "CB.00060200"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "Invalid param"
        }
      }
    },
    "JobStatusResultResponseBody": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "结果",
          "properties": {
            "building": {
              "type": "boolean",
              "description": "是否构建中",
              "example": false
            },
            "build_result": {
              "type": "string",
              "description": "构建结果",
              "example": "FAILURE"
            },
            "region": {
              "type": "string",
              "description": "region",
              "example": {
                "region": null
              }
            }
          }
        },
        "error": {
          "type": "string",
          "description": "返回错误信息",
          "example": "error_message"
        },
        "status": {
          "type": "string",
          "description": "返回状态信息",
          "example": "success"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Build_No": {
      "name": "build_no",
      "in": "path",
      "description": "构建任务的构建编号,从1开始,每次构建递增1",
      "required": true,
      "type": "integer",
      "default": 1,
      "format": "int32",
      "minimum": 1,
      "maximum": 2147483647,
      "x-example": 1
    },
    "Job_Id": {
      "name": "job_id",
      "in": "path",
      "description": "构建的任务ID;\n编辑构建任务时,浏览器URL末尾的32位数字、字母组合的字符串。",
      "required": true,
      "type": "string",
      "pattern": "^[0-9a-z]{32}$",
      "x-example": "901878212b1a49be9c1a1054c272762a"
    }
  },
  "host": "cloudbuild-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}