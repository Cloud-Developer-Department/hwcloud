{
  "name": "ListRepoBranch",
  "summary": "获取该任务所有分支信息",
  "tags": "构建报告",
  "productshort": "CodeArtsBuild",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/report/branches": {
      "get": {
        "tags": [
          "ReportManager"
        ],
        "summary": "获取该任务所有分支信息",
        "description": "获取该任务所有分支信息",
        "operationId": "ListRepoBranch",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Job_Id_Query"
          },
          {
            "name": "repository_name",
            "in": "query",
            "description": "代码仓库名,不支持中文",
            "required": true,
            "type": "string",
            "pattern": "^[^一-龥]{0,}$",
            "x-example": "maven-demo"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/BranchesBody"
            },
            "examples": {
              "application/json": {
                "result": [
                  "master"
                ],
                "status": "success"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "GET https://{endpoint}/v1/report/branches",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-internel": "false",
        "x-apigateway-ratelimit": "ten_120_min",
        "x-api-type": "open-api"
      }
    }
  },
  "definitions": {
    "BranchesBody": {
      "title": "ResponseString",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "状态",
          "example": "success"
        },
        "result": {
          "type": "array",
          "description": "结果",
          "items": {
            "type": "string",
            "description": "分支名称",
            "example": "master"
          }
        }
      }
    },
    "ErrorResponseBody": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "CB.00060200"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "Invalid param"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Job_Id_Query": {
      "name": "job_id",
      "in": "query",
      "description": "构建的任务ID;\n编辑构建任务时,浏览器URL末尾的32位数字、字母组合的字符串。",
      "required": true,
      "type": "string",
      "pattern": "^[0-9a-z]{32}$",
      "x-example": "901878212b1a49be9c1a1054c272762a"
    }
  },
  "host": "cloudbuild-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}