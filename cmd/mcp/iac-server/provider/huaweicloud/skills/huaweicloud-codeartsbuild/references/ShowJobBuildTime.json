  "definitions": {
    "ShowJobBuildTime": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "返回结果",
          "properties": {
            "job_id": {
              "type": "string",
              "description": "任务ID",
              "example": "f5af662119404ad187437cd272b5099b"
            },
            "avg_build_time": {
              "type": "number",
              "description": "平均构建时长",
              "format": "double"
            },
            "max_build_time": {
              "type": "integer",
              "description": "最长时间",
              "format": "int64",
              "example": 542477536
            },
            "min_build_time": {
              "type": "integer",
              "description": "最短时间",
              "format": "int64",
              "example": 542477536
            },
            "chart": {
              "type": "array",
              "description": "每日构建数据",
              "items": {
                "properties": {
                  "daily_build_number": {
                    "type": "string",
                    "description": "构建每日编号",
                    "example": "20200612.20"
                  },
                  "build_number": {
                    "type": "integer",
                    "description": "构建编号",
                    "format": "int32",
                    "example": 1
                  },
                  "build_time": {
                    "type": "integer",
                    "description": "步骤执行时长,单位s",
                    "example": 20
                  },
                  "build_result": {
                    "type": "string",
                    "description": "构建结果",
                    "example": "SUCCESS"
                  }
                }
              }
            }
          }
        },
        "status": {
          "type": "string",
          "description": "返回状态信息",
          "example": "success"
        }
      }
    },
    "ErrorResponseBody": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "CB.00060200"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "Invalid param"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Interval_Query": {
      "name": "interval",
      "in": "query",
      "description": "查询时间,查最近几天的。",
      "required": true,
      "type": "integer",
      "default": 0,
      "format": "int32",
      "minimum": 1,
      "maximum": 30
    },
    "Job_Id_Query": {
      "name": "job_id",
      "in": "query",
      "description": "构建的任务ID;\n编辑构建任务时,浏览器URL末尾的32位数字、字母组合的字符串。",
      "required": true,
      "type": "string",
      "pattern": "^[0-9a-z]{32}$",
      "x-example": "901878212b1a49be9c1a1054c272762a"
    },
    "Branch_Query": {
      "name": "branch",
      "in": "query",
      "description": "代码仓分支名。",
      "required": false,
      "type": "string",
      "minLength": 0,
      "maxLength": 200,
      "x-example": "all"
    },
    "Repository_Name_Query": {
      "name": "repository_name",
      "in": "query",
      "description": "代码仓名称。",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-example": "reckoning"
    }
  },
  "host": "cloudbuild-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}