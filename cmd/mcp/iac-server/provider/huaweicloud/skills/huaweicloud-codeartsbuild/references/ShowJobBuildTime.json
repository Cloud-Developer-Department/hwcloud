{
  "name": "ShowJobBuildTime",
  "summary": "洞察构建时长",
  "tags": "构建报告",
  "productshort": "CodeArtsBuild",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/report/time": {
      "get": {
