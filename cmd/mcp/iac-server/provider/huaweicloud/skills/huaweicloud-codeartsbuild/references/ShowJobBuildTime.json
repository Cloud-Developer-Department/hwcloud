          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "GET https://{endpoint}/v1/report/time?job_id=cd190925db6e4ac4a784f754faffebfc&repository_name=Android&branch=all&interval=7",
        "x-support-sdk": "Y",
