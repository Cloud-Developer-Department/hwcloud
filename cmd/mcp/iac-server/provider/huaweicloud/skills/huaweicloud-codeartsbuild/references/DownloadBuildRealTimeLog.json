  "definitions": {
    "OctopusV3LogResponseBody": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "结果",
          "properties": {
            "has_more": {
              "type": "boolean",
              "description": "**参数解释**:\n是否还有剩余日志标识。\n**约束限制**:\n不涉及。\n**取值范围**:\ntrue或false。\n**默认取值**:\n不涉及。"
            },
            "start_offset": {
              "type": "string",
              "description": "**参数解释**:\n日志查询起始偏移量。\n**约束限制**:\n不涉及。\n**取值范围**:\n数字组成。\n**默认取值**:\n不涉及。"
            },
            "end_offset": {
              "type": "string",
              "description": "**参数解释**:\n日志查询结束偏移量。\n**约束限制**:\n不涉及。\n**取值范围**:\n数字组成。\n**默认取值**:\n不涉及。"
            },
            "log": {
              "type": "string",
              "description": "**参数解释**:\n返回日志内容,可能会空,请再次请求。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
            },
            "location": {
              "type": "string",
              "description": "**参数解释**:\n日志来源。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
            }
          }
        },
        "error": {
          "type": "string",
          "description": "返回错误信息",
          "example": "error_message"
        },
        "status": {
          "type": "string",
          "description": "返回状态信息",
          "example": "success"
        }
      }
    },
    "ErrorResponseBody": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "CB.00060200"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "Invalid param"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Sort": {
      "name": "sort",
      "in": "query",
      "description": "**参数解释**:\n排序方式。\n**约束限制**:\n不涉及。\n**取值范围**:\nAES|DESC。",
      "required": false,
      "type": "string"
    },
    "End_Offset_False": {
      "name": "end_offset",
      "in": "query",
      "description": "**参数解释**:\n结束偏移量,表示查询到此结束。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能使用数字,大于等于0。",
      "required": false,
      "type": "integer",
      "default": 0,
      "format": "int32",
      "minimum": 0
    },
    "Build_No": {
      "name": "build_no",
      "in": "path",
      "description": "构建任务的构建编号,从1开始,每次构建递增1",
      "required": true,
      "type": "integer",
      "default": 1,
      "format": "int32",
      "minimum": 1,
      "maximum": 2147483647,
      "x-example": 1
    },
    "Start_Offset_False": {
      "name": "start_offset",
      "in": "query",
      "description": "**参数解释**:\n起始偏移量,表示从此开始查询。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能使用数字,大于等于0。",
      "required": false,
      "type": "integer",
      "default": 0,
      "format": "int32",
      "minimum": 0
    },
    "Job_Id": {
      "name": "job_id",
      "in": "path",
      "description": "构建的任务ID;\n编辑构建任务时,浏览器URL末尾的32位数字、字母组合的字符串。",
      "required": true,
      "type": "string",
      "pattern": "^[0-9a-z]{32}$",
      "x-example": "901878212b1a49be9c1a1054c272762a"
    },
    "Size": {
      "name": "size",
      "in": "query",
      "description": "**参数解释**:\n可控制返回内容长度,固定1000。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能使用数字,大于等于0。\n**默认取值**:\n1000",
      "required": true,
      "type": "string"
    }
  },
  "host": "cloudbuild-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
