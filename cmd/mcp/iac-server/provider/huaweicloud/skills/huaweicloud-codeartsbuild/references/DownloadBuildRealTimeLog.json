{
  "name": "DownloadBuildRealTimeLog",
  "summary": "获取运行全量日志",
  "tags": "LogManager",
  "productshort": "CodeArtsBuild",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/log/{job_id}/{build_no}/real-time-log": {
      "get": {
        "tags": [
          "LogManager"
        ],
        "summary": "获取运行全量日志",
        "description": "获取运行全量日志",
        "operationId": "DownloadBuildRealTimeLog",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Job_Id"
          },
          {
