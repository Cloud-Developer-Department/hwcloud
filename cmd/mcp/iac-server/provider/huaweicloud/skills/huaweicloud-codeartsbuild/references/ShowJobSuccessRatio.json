{
  "name": "ShowJobSuccessRatio",
  "summary": "根据开始时间和结束时间查看构建任务的构建成功率",
  "tags": "编译构建(旧)",
  "productshort": "CodeArtsBuild",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v3/jobs/{job_id}/success-ratio": {
      "get": {
        "tags": [
          "CodeArtsBuild"
        ],
        "summary": "根据开始时间和结束时间查看构建任务的构建成功率",
        "description": "根据开始时间和结束时间查看构建任务的构建成功率",
        "operationId": "ShowJobSuccessRatio",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Job_Id"
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "区间开始时间,格式yyyy-MM-dd。",
            "required": true,
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "default": "2022-01-04"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "区间结束时间,格式yyyy-MM-dd。",
            "required": true,
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "default": "2022-02-03"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/SuccessRatioResponse"
            },
            "examples": {
              "application/json": {
                "success_count": 2,
                "total_count": 3,
                "success_ratio": 0.67
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "GET https://{endpoint}/v3/jobs/{job_id}/success-ratio?start_time=2021-12-01&end_time=2021-12-01",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-internel": "false",
        "x-apigateway-ratelimit": "cloudbuild_ext",
        "x-api-type": "open-api"
      }
    }
  },
  "definitions": {
    "ErrorResponseBody": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "CB.00060200"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "Invalid param"
        }
      }
    },
    "SuccessRatioResponse": {
      "title": "SuccessRatioResponse",
      "type": "object",
      "properties": {
        "success_count": {
          "type": "integer",
          "description": "任务成功构建次数",
          "format": "int32"
        },
        "total_count": {
          "type": "integer",
          "description": "任务构建总次数",
          "format": "int32"
        },
        "success_ratio": {
          "type": "number",
          "description": "任务成功率,精确到小数点后两位",
          "format": "double"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务接口获取\n(响应消息头中X-Subject-Token的值)。\n不支持租户全局token,请使用scope为project的region级token。",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
    },
    "Job_Id": {
      "name": "job_id",
      "in": "path",
      "description": "构建的任务ID;\n编辑构建任务时,浏览器URL末尾的32位数字、字母组合的字符串。",
      "required": true,
      "type": "string",
      "pattern": "^[0-9a-z]{32}$",
      "x-example": "901878212b1a49be9c1a1054c272762a"
    }
  },
  "host": "cloudbuild-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}