            "description": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RunJobRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/RunJobResponseBody"
            },
            "examples": {
              "application/json": {
                "octopus_job_name": "j_Oaqg...",
                "actual_build_number": "20",
                "daily_build_number": "20200612.20"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "POST https://{endpoint}/v3/jobs/build",
        "x-request-examples-description-1": "执行任务ID为“f9d6c8466d614a9788e9a0acf6c15f46”,代码仓名称为“codeBranch”,代码仓分支为“master”的构建任务",
        "x-request-examples-text-1": "{\n  \"job_id\":\"f9d6c8466d614a9788e9a0acf6c15f46\",\n  \"parameter\":[\n      {\n          \"name\":\"codeBranch\",\n          \"value\":\"master\"\n      }],\n  \"scm\":{\n      \"build_tag\":null,\n      \"build_commit_id\":\"build_commit_id\"\n  }\n}",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-internel": "false",
        "x-apigateway-ratelimit": "cloudbuild_ext",
        "x-api-type": "open-api"
      }
    }
  },
  "definitions": {
    "ParameterItem": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "参数名称",
          "example": "codeBranch"
        },
        "value": {
          "type": "string",
          "description": "参数值",
          "example": "master"
        }
      }
    },
    "RunJobRequestBody": {
      "type": "object",
      "description": "执行任务接口请求体",
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "构建任务ID;编辑构建任务时,浏览器URL末尾的32位数字、字母组合的字符串",
          "example": "f5af662119404ad187437cd272b5099b"
        },
        "parameter": {
          "$ref": "#/definitions/Parameters"
        },
        "scm": {
          "$ref": "#/definitions/Scm"
        }
      }
    },
    "Parameters": {
      "type": "array",
      "description": "自定义参数",
      "items": {
        "$ref": "#/definitions/ParameterItem"
      }
    },
    "RunJobResponseBody": {
      "type": "object",
      "properties": {
        "octopus_job_name": {
          "type": "string",
          "description": "临时任务名称",
          "example": "j_Oaqg3PCN"
        },
        "actual_build_number": {
          "type": "string",
          "description": "实际构建次数",
          "example": "20"
        },
        "daily_build_number": {
          "type": "string",
          "description": "构建每日编号",
          "example": "20200612.20"
        }
      },
      "title": "buildjobResponseBody"
    },
    "ErrorResponseBody": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "CB.00060200"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "Invalid param"
        }
      }
    },
    "Scm": {
      "type": "object",
      "description": "代码信息",
      "properties": {
        "build_tag": {
          "type": "string",
          "description": "代码Tag",
          "example": "build_tag_test"
        },
        "build_commit_id": {
          "type": "string",
          "description": "代码提交ID",
          "example": "f5af662119404ad187437cd272b5099b"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务接口获取\n(响应消息头中X-Subject-Token的值)。\n不支持租户全局token,请使用scope为project的region级token。",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
    }
  },
  "host": "cloudbuild-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}