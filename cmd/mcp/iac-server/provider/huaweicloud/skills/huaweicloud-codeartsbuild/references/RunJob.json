{
  "name": "RunJob",
  "summary": "执行构建任务",
  "tags": "编译构建(旧)",
  "productshort": "CodeArtsBuild",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v3/jobs/build": {
      "post": {
        "tags": [
          "CodeArtsBuild"
        ],
        "summary": "执行构建任务",
        "description": "执行构建任务,可传自定义参数",
        "operationId": "RunJob",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "in": "body",
