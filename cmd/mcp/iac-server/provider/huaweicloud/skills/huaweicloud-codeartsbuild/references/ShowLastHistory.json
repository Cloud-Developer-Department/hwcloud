{
  "name": "ShowLastHistory",
  "summary": "查询指定代码仓库最近一次成功的构建历史",
  "tags": "编译构建(旧)",
  "productshort": "CodeArtsBuild",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v3/jobs/{project_id}/last-history": {
      "get": {
        "tags": [
          "CodeArtsBuild"
        ],
        "summary": "查询指定代码仓库最近一次成功的构建历史",
        "description": "查询指定代码仓库最近一次成功的构建历史",
        "operationId": "ShowLastHistory",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/Project_Id"
          },
          {
            "name": "repository_name",
            "in": "query",
            "description": "代码仓库名,不支持中文",
            "required": true,
            "type": "string",
            "pattern": "^[^一-龥]{0,}$",
            "x-example": "maven-demo"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/LastHistoryRecord"
            },
            "examples": {
              "application/json": {
                "record_id": "20210722.16",
                "job_id": "37be03edd1da430c8079504d546cc499",
                "job_name": "测试任务01",
                "build_number": 16,
                "start_time": "2021-07-22T16:26:52+08:00",
                "end_time": "2021-07-22T16:27:15+08:00",
                "result": "SUCCESS",
                "commit_id": "e311c54476e0e536f0ecdeeba8dc184216fa2057"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "GET https://{endpoint}/v3/jobs/6ecbc5bac7c8442fb3d2563d53c13582/last-history?repository_name=maven-demo",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-internel": "false",
        "x-apigateway-ratelimit": "cloudbuild_ext",
        "x-api-type": "open-api"
      }
    }
  },
  "definitions": {
    "LastHistoryRecord": {
      "title": "LastHistoryRecord",
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "description": "构建记录id--唯一key"
        },
        "job_id": {
          "type": "string",
          "description": "构建任务ID"
        },
        "job_name": {
          "type": "string",
          "description": "构建任务名称"
        },
        "build_number": {
          "type": "integer",
          "description": "构建编号"
        },
        "start_time": {
          "type": "string",
          "description": "构建开始时间"
        },
        "end_time": {
          "type": "string",
          "description": "构建结束时间"
        },
        "result": {
          "type": "string",
          "description": "构建执行结果"
        },
        "commit_id": {
          "type": "string",
          "description": "commitId"
        }
      }
    },
    "ErrorResponseBody": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "CB.00060200"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "Invalid param"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Project_Id": {
      "name": "project_id",
      "in": "path",
      "description": "CodeArts项目ID,32位数字、小写字母组合。",
      "required": true,
      "type": "string",
      "pattern": "^[0-9a-z]{32}$",
      "x-example": "6ecbc5bac7c8442fb3d2563d53c13582"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n通过调用IAM服务接口获取\n(响应消息头中X-Subject-Token的值)。\n不支持租户全局token,请使用scope为project的region级token。",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
    }
  },
  "host": "cloudbuild-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
