{
  "name": "ListRepository",
  "summary": "查看仓库",
  "tags": "构建报告",
  "productshort": "CodeArtsBuild",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/report/{job_id}/repositories": {
      "get": {
        "tags": [
          "ReportManager"
        ],
        "summary": "查看仓库",
        "description": "查看仓库",
        "operationId": "ListRepository",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Job_Id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Repositories"
            },
            "examples": {
              "application/json": {
                "result": {
                  "repositories": [
                    "APITestCreateMaven01"
                  ],
                  "latest": "APITestCreateMaven01"
                },
                "status": "success"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "GET https://{endpoint}/v1/report/5103b68833be4030839bdf816c6611bf/repositories",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-internel": "false",
        "x-apigateway-ratelimit": "ten_120_min",
        "x-api-type": "open-api"
      }
    }
  },
  "definitions": {
    "Repositories": {
      "title": "Repositories",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "状态"
        },
        "error": {
          "type": "object",
          "description": "错误"
        },
        "result": {
          "type": "object",
          "description": "结果",
          "properties": {
            "latest": {
              "type": "string",
              "description": "最后一次仓库名称",
              "example": 502193898
            },
            "repositories": {
              "type": "array",
              "description": "本次任务的构建步骤详情,返回的步骤为页面可见步骤",
              "items": {
                "type": "string",
                "description": "仓库信息列表",
                "example": [
                  502193898,
                  502193898
                ]
              }
            }
          }
        }
      }
    },
    "ErrorResponseBody": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "CB.00060200"
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "Invalid param"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Job_Id": {
      "name": "job_id",
      "in": "path",
      "description": "构建的任务ID;\n编辑构建任务时,浏览器URL末尾的32位数字、字母组合的字符串。",
      "required": true,
      "type": "string",
      "pattern": "^[0-9a-z]{32}$",
      "x-example": "901878212b1a49be9c1a1054c272762a"
    }
  },
  "host": "cloudbuild-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
