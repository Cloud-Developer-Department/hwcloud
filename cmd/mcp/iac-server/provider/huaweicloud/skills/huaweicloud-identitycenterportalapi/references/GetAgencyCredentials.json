{
  "name": "GetAgencyCredentials",
  "summary": "获取委托凭证",
  "tags": "凭证管理",
  "productshort": "IdentityCenterPortalAPI",
  "region_id": "cn-south-1",
  "paths": {
    "/v1/credentials": {
      "get": {
        "tags": [
          "Credential"
        ],
        "description": "获取分配给用户的指定委托或信任委托的STS短期凭证",
        "summary": "获取委托凭证",
        "operationId": "GetAgencyCredentials",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-auth": false,
        "parameters": [
          {
            "$ref": "#/components/parameters/accessToken"
          },
          {
            "name": "target_account_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9-]{1,64}$"
            },
            "description": "目标账户的全局唯一标识符(ID)"
          },
          {
            "name": "agency_urn",
            "in": "query",
            "required": true,
            "description": "委托或信任委托的统一资源名称(URN)",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/=\\-_]+:[A-Za-z0-9+/=\\-_*]{0,64}:[A-Za-z0-9+/=\\-_]{1,128}:[A-Za-z0-9+/=\\-_]{1,64}:[\\w-/*_.+:()#@?=&%,]{1,512}$"
            }
          }
        ],
        "x-request-examples-url-1": "GET https://{hostname}/v1/credentials",
        "x-request-examples-description-1": "获取委托凭证",
        "responses": {
          "200": {
            "description": "Successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAgencyCredentialsResp"
                },
                "example": {
                  "agency_credentials": {
                    "access_key_id": "example-access-key-id",
                    "expiration": 1684955360,
                    "secret_access_key": "example-secret-access-key",
                    "session_token": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.3",
  "parameters": null,
  "host": "portal-identitycenter.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}