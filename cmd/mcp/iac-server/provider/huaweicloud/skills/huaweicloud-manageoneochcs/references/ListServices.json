{
  "name": "ListServices",
  "summary": "查询云服务列表",
  "tags": "驱动管理",
  "productshort": "ManageOneOCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/serviceaccess/v3.0/services": {
      "get": {
        "x-filter": "ManageOne,openapi,interservice,erservice,cloudservice",
        "x-plane": "Tenant",
        "summary": "查询云服务列表",
        "description": "查询云服务列表",
        "tags": [
          "驱动管理"
        ],
        "operationId": "ListServices",
        "x-resource": "云服务",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "cloud_infra_id",
            "in": "query",
            "description": "资源池 ID,长度范围1~64字符。",
            "type": "string",
            "required": true
          },
          {
            "name": "service_name",
            "in": "query",
            "description": "服务名称,长度范围0~64字符,如nova、cinder、neutron。",
            "type": "string",
            "required": false
          },
          {
            "name": "x-auth-token",
            "description": "IAM token。IAM的token,必须具有mo_bss_adm,vdc_adm,vdc_user,res_adm和vdc_readonly中任意角色。",
            "in": "header",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取资源池下云服务信息。",
            "schema": {
              "$ref": "#/definitions/ServiceInfos"
            },
            "examples": {
              "application/json": {
                "total": 7,
                "services": [
                  {
                    "id": "225207e0cf1e4a82ba4258e655a24568",
                    "name": "neutron",
                    "type": "network",
                    "ip": "x.x.x.x",
                    "port": "443",
                    "status": "enabled",
                    "description": null,
                    "locales": "{\"en_us\":\"Virtual Private Cloud\",\"zh_cn\":\"Virtual Private Cloud\"}"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "Token 鉴权失败。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/rest/serviceaccess/v3.0/services?cloud_infra_id={cloud_infra_id}",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {
    "ServiceInfos": {
      "properties": {
        "total": {
          "description": "云服务总数。",
          "type": "integer",
          "format": "int32"
        },
        "services": {
          "description": "云服务列表信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Service"
          }
        }
      }
    },
    "Service": {
      "properties": {
        "id": {
          "description": "服务ID。",
          "type": "string",
          "required": true
        },
        "name": {
          "description": "服务名称。",
          "type": "string",
          "required": true
        },
        "type": {
          "description": "服务类型。",
          "type": "string",
          "required": true
        },
        "ip": {
          "description": "服务的IP地址。",
          "type": "string",
          "required": true
        },
        "port": {
          "description": "服务的端口地址。",
          "type": "string",
          "required": true
        },
        "status": {
          "description": "服务是否启用。",
          "type": "string",
          "required": true
        },
        "description": {
          "description": "服务描述信息。",
          "type": "string",
          "required": true
        },
        "locales": {
          "description": "服务名称多语言。",
          "type": "string",
          "required": false
        }
      }
    }
  },
