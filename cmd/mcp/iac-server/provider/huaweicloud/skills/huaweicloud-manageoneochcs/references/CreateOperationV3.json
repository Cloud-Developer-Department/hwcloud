{
  "name": "CreateOperationV3",
  "summary": "新建操作V3",
  "tags": "自动化运维",
  "productshort": "ManageOneOCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/moautoops/v3/operations": {
      "post": {
        "summary": "新建操作V3",
        "description": "新建操作接口V3",
        "x-filter": "ManageOne,irservice,openapi",
        "x-plane": "OM",
        "x-precautions": "1.权限码:(自动作业-操作库-创建操作/编排) moocapp:moautoops-operate-workflow:create; \n2.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运维面API参考 > 错误码说明 > ManageOne运维面错误码说明 > 自动化运维”章节。\n",
        "tags": [
          "自动化运维"
        ],
        "operationId": "CreateOperationV3",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "timestamp",
            "in": "query",
            "description": "发送操作请求时间,毫秒级时间戳。",
            "type": "integer",
            "format": "int64",
            "required": true
          },
          {
            "name": "noise",
            "in": "query",
            "description": "加密密文,用于验证回调请求。",
            "type": "string",
            "required": true,
            "maxLength": 64
          },
          {
            "name": "certsn",
            "in": "query",
            "description": "证书的序列号,证书在ManageOne运维面“系统>系统集成>信任证书”页面上传,用于建立回调用的HTTPS连接并将noise值加密回调给用户。建议在导入页面的附加信息内添加说明信息,明确证书作用。",
            "type": "string",
            "required": true
          },
          {
            "name": "verifyUrl",
            "in": "query",
            "description": "用户自行创建的回调服务器地址,用于用户接收回调请求验证脚本内容,需使用HTTPS协议,用脚本内容计算出的SHA256值作为路径参数置于末尾。",
            "type": "string",
            "required": true
          },
          {
            "name": "operationRequest",
            "in": "body",
            "description": "操作请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OperationMapRequestV3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "新建操作结果。",
            "schema": {
              "$ref": "#/definitions/OperationResponseV3"
            },
            "examples": {
              "application/json": {
                "id": "0",
                "success": true,
                "message": null
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "403": {
            "description": "URL鉴权"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/rest/moautoops/v3/operations?timestamp=${1731921597280}&noise=${xxxxxxx}&certsn=${xxxx}&verifyUrl=https://x.x.x.x:xx/xxxx/{sha256}",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "name": "重启FMService",
          "execEnv": "remote",
          "status": "published",
          "cloudService": "ManageOne",
          "cloudServiceVersion": "1.0",
          "packageName": "ManageOne",
          "packageVersion": "1.0",
          "version": 0,
          "description": "重启FMService",
          "resourceLimit": {
            "policy": "default",
            "limits": [
              {
                "limitResourceType": "memory",
                "limitType": "absolute",
                "value": "10"
              },
              {
                "limitResourceType": "cpu",
                "limitType": "absolute",
                "value": "1"
              }
            ]
          },
          "execution": {
            "language": "shell",
            "content": "echo 'hello, autoops'",
            "timeoutSeconds": "300",
            "runner": "opsuser",
            "scriptId": 123
          },
          "inputs": [
            {
              "name": "product_name",
              "nameTip": "product name",
              "paramType": "text",
              "description": "product name",
              "required": true,
              "encrypted": false,
              "defaultValue": "ManageOne",
              "validateRule": "[a-zA-Z0-9]{2,30}",
              "paramExtValues": []
            },
            {
              "name": "published_time",
              "nameTip": "published time",
              "paramType": "date",
              "description": "published time",
              "required": true,
              "encrypted": false,
              "defaultValue": "1730535034000",
              "validateRule": null,
              "paramExtValues": []
            }
          ],
          "outputs": [
            {
              "name": "execute_result",
              "description": "execute_result",
              "paramType": "text",
              "encrypted": false
            }
          ]
        }
      }
    }
  },
