{
  "name": "ShowDataSet",
  "summary": "查询数据集的统计信息",
  "tags": "数据分析平台",
  "productshort": "ManageOneOCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/analysis/v1/datasets/{dataSet}": {
      "post": {
        "summary": "查询数据集的统计信息",
        "x-filter": "oc,openapi",
        "x-precautions": " 1.查询监控数据时,为确保兼容性,请使用object.id、object.nativeId,或oridim维度查询。如果使用其他维度,可能导致大规格场景下数据查询失败。 2.查询数据集的统计信息时,建议指定时间范围参数,若不指定时间范围,查询有可能会超时失败。 3.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运维面API参考 > 错误码说明 > 数据分析平台特性”章节。",
        "description": "查询数据集的统计信息。",
        "tags": [
          "数据分析平台"
        ],
        "x-plane": "OM",
        "produces": [
          "application/json"
        ],
        "operationId": "ShowDataSet",
        "responses": {
          "200": {
            "schema": {
              "type": "string"
            },
            "description": "返回指定数据集的统计信息",
            "examples": {
              "application/json": {
                "totalSize": 2,
                "pageNo": 1,
                "datas": [
                  {
                    "cpuUsage": 3.4898023219081944,
                    "diskIoOut": 2.265506626763383,
                    "region": "5827121EF72E342BAFC63532DB7034C0",
                    "azone": "D6671B03944330E3B2142F00800A7143",
                    "month": 2,
                    "weekday": 1
                  },
                  {
                    "cpuUsage": 0.005333333280351427,
                    "diskIoOut": 0,
                    "region": "5827121EF72E342BAFC63532DB7034C0",
                    "azone": "EF30ACBB90533B7BA239F34B8454763D",
                    "month": 2,
                    "weekday": 1
                  }
                ],
                "pageSize": 100
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          },
          "502": {
            "description": "网关错误。"
          },
          "503": {
            "description": "服务不可用。"
          },
          "504": {
            "description": "表示时间超时,总线超时时间300s。"
          },
          "888": {
            "description": "服务摘机,不提供服务。"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "x-auth-token",
            "description": "IAM_OP token、SSO token",
            "type": "string",
            "required": true
          },
          {
            "in": "path",
            "name": "dataSet",
            "description": "数据集名称,取值参考数据集说明文档",
            "type": "string",
            "required": true
          },
          {
            "default": 1,
            "in": "query",
            "name": "pageNo",
            "format": "int32",
            "description": "页数,支持1到1000的整数,默认值为1",
            "type": "integer",
            "required": false
          },
          {
            "default": 100,
            "in": "query",
            "name": "pageSize",
            "format": "int32",
            "description": "分页大小,支持1到1000的整数,默认值为100",
            "type": "integer",
            "required": false
          },
          {
            "schema": {
              "$ref": "#/definitions/QueryCondition"
            },
            "in": "body",
            "name": "queryCondition",
            "description": "查询条件:timeRange:时间范围参数,查询资源数据时必须指定时间范围,查询性能数据时可以不指定时间范围,如果不指定,默认查询时间范围是最近5分钟|filters:查询过滤器,当前支持ranges以及dimensions。",
            "required": true
          }
        ],
        "consumes": [
          "application/json"
        ],
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/rest/analysis/v1/datasets/perf-ecs?pageNo=1&pageSize=1",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "timeRange": {
            "beginTime": 1526888529000,
            "endTime": 1526892129000
          },
          "filters": {
            "ranges": [
              {
                "fieldName": "dimensions.time.month",
                "gt": "1",
                "lt": "3"
              },
              {
                "fieldName": "dimensions.time.weekday",
                "gte": "1",
                "lte": "1"
              }
            ],
            "dimensions": [
              {
                "field": "dimensions.logicLoc._regionId",
                "values": [
                  "5827121EF72E342BAFC63532DB7034C0"
                ]
              }
            ]
          },
          "dimensions": [
            {
              "field": "dimensions.time.month",
              "index": 9
            },
            {
              "field": "dimensions.time.weekday",
              "index": 10
            },
            {
              "field": "dimensions.logicLoc._azoneId",
              "index": 12
            },
            {
              "field": "dimensions.logicLoc._regionId",
              "index": 10
            }
          ],
          "metrics": [
            {
              "aggType": "avg",
              "field": "metrics.cpuUsage"
            },
            {
              "aggType": "avg",
              "field": "metrics.memoryUsage"
            },
            {
              "aggType": "avg",
              "field": "metrics.diskIoOut"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "MetricMeta": {
      "required": [
        "field",
        "aggType"
      ],
      "properties": {
        "fieldAlias": {
          "description": "指标域名称别名,非必选,如果指标域名称别名非空,返回的查询结果中将按照指标域名称别名作为键值,如果指标域名称别名为空,将按照指标域名称作为键值。当在查询请求中对同一个指标域进行多种聚合计算时(例如,在一个查询请求中同时对CPU使用率指标计算最大值、最小值、平均值),必须指定指标域名称别名。此字段仅限2.0版本接口中使用。",
          "type": "string"
        },
        "field": {
          "description": "指标域名称,取值参考数据集说明文档中的指标说明",
          "type": "string"
        },
        "aggType": {
          "description": "汇聚类型,取值范围sum,avg,min,max,count,参考数据集说明文档中的指标说明",
          "type": "string"
        }
      }
    },
    "DimensionMeta": {
      "required": [
        "field",
        "index"
      ],
      "properties": {
        "field": {
          "description": "维度域名称,取值参考数据集说明文档具体数据集维度说明中的关键字",
          "type": "string"
        },
        "index": {
          "format": "int32",
          "description": "维度查询次序,取值从1开始依次递增整数,最大不超过1000",
          "type": "integer"
        }
      }
    },
    "FilterCondition": {
      "properties": {
        "ranges": {
          "x-length-message": "filter中可传入对象个数不能大于1000",
          "x-maxLength": 1000,
          "description": "维度范围过滤条件,多用于对维度值为数字类型的维度进行区间过滤",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RangeMeta"
          }
        },
        "dimensions": {
          "x-length-message": "filter中可传入对象个数不能大于1000",
          "x-maxLength": 1000,
          "description": "维度精确过滤条件,取值请参考数据集说明文档的维度说明,用于指定查询或排查维度中的某些值",
          "type": "array",
          "items": {
            "$ref": "#/definitions/DimensionFilter"
          }
        }
      }
    },
    "TimeRangeConditionV2": {
      "required": [
        "beginTime",
        "endTime"
      ],
      "properties": {
        "granularity": {
          "description": "粒度选项,取值为1m(1分钟)、5m(5分钟)、30m(30分钟)、1h(1小时)、1d(1天)、1M(1个月)、auto,用于指定查询的数据集粒度,不同的粒度选项,允许查询的时间范围不同。此字段仅限2.0版本接口中使用。",
          "type": "string"
        },
        "interval": {
          "description": "时间跨度,取值为数字+[m|h|M|y(分别代表分钟,天,小时,月,年选一)|auto]。此字段仅限2.0版本接口中使用。",
          "type": "string"
        },
        "beginTime": {
          "format": "int64",
          "description": "开始时间,和结束时间组成一个查询时间范围,时间戳格式的日期时间",
          "type": "integer"
        },
        "endTime": {
          "format": "int64",
          "description": "结束时间,时间戳格式的日期时间",
          "type": "integer"
        }
      }
    },
    "QueryCondition": {
      "required": [
        "dimensions"
      ],
      "properties": {
        "filters": {
          "description": "查询过滤器,当前支持ranges以及dimensions",
          "$ref": "#/definitions/FilterCondition"
        },
        "metrics": {
          "x-maxLength": 1000,
          "description": "查询指标集,只支持数据集中的基础指标(汇聚方式为sum,avg,max,count的指标),支持多个。维度和指标需要同时添加前缀或同时不加前缀,否则无法正常返回数据。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MetricMeta"
          }
        },
        "timeRange": {
          "description": "时间范围参数,建议查询时指定时间范围,若不指定时间范围,查询有可能会超时失败;stat-business-new数据集查询时间范围建议最近12小时",
          "$ref": "#/definitions/TimeRangeConditionV2"
        },
        "dimensions": {
          "x-maxLength": 1000,
          "description": "维度条件,指定需要查询哪些维度,建议只查询所需维度,取值请参考数据集说明文档的维度说明。维度和指标需要同时添加前缀或同时不加前缀,否则无法正常返回数据。确保查询的维度有数据,若查询的维度无数据,则返回数据为空。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/DimensionMeta"
          }
        }
      }
    },
    "DimensionFilter": {
      "description": "dimension filter",
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RangeMeta": {
      "description": "range meta",
      "type": "object",
      "properties": {
        "fieldName": {
          "type": "string"
        },
        "fieldValue": {
          "type": "string"
        },
        "gte": {
          "type": "string"
        },
        "lte": {
          "type": "string"
        },
        "gt": {
          "type": "string"
        },
        "lt": {
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}