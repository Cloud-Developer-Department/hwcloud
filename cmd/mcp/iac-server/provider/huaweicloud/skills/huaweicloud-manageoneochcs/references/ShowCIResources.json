{
  "name": "ShowCIResources",
  "summary": "租户资源查询接口",
  "tags": "资源管理",
  "productshort": "ManageOneOCHCS",
  "region_id": "cn-north-4",
  "paths": {
    "/rest/tenant-resource/v1/tenant/resources/{class-name}": {
      "get": {
        "summary": "租户资源查询接口",
        "description": "该接口提供分页查询租户资源的能力,并支持根据条件的增量查询。",
        "x-resource": "租户资源查询接口",
        "x-opseverity": "Minor",
        "x-precautions": "使用前请参考《资源北向模型》,获取系统支持的资源类型、视图类型及属性列表。注:不建议全量查询安全组和安全组规则,在查询安全组和安全组规则时,必须要传入部署的regionId(通过/rest/cmdb/v1/instances/{className}接口获取,{className}参数需要为SYS_Region)。如果没有对应云服务,调用云服务资源类型时会报cmdb.meta.type_not_support。调用该接口需要“查询实例详情”权限,归属权限组:运维中心>资源实例管理。\n错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运维面API参考 > 错误码说明 > 资源管理特性”章节。\n",
        "tags": [
          "资源管理"
        ],
        "operationId": "ShowCIResources",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "IAM/AUTH token。"
          },
          {
            "name": "class-name",
            "in": "path",
            "type": "string",
            "required": true,
            "maxLength": 60,
            "minLength": 1,
            "description": "资源类型,和《资源北向模型》中的资源类型与视图类型保持一致。"
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "format": "int32",
            "default": 100,
            "minimum": 1,
            "maximum": 1000,
            "description": "查询数据数目上限,如果不配置取默认值100。"
          },
          {
            "name": "offset",
            "in": "query",
            "type": "integer",
            "format": "int32",
            "description": "偏移量。偏移量的值必须能被limit整除。"
          },
          {
            "name": "condition",
            "in": "query",
            "type": "string",
            "description": "增量查询条件,格式示例: last_Modified+%3e%3d+timeStamp1+%26+last_Modified+%3c+timeStamp2,为last_Modified ≥ timeStamp1 & last_Modified < timeStamp2编码后的内容。\n其中:\n  * last_Modified为资源变更时间,通过该字段实现增量查询;\n  * timeStamp1和timeStamp2为last_Modified查询条件的值,单位为毫秒。"
          }
        ],
        "responses": {
          "200": {
            "description": "租户资源数据。",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": {
                "objList": [
                  {
                    "regionName": "Global",
                    "ownerId": 5318291468231165000,
                    "portId": 8649569718647558,
                    "resId": 5124422638412484000,
                    "floatingIpAddress": "127.0.0.1",
                    "unuseTime": "",
                    "regionId": 1,
                    "routerId": 8894869722586954000,
                    "useTime": "2016-11-12T10:30:13",
                    "fixedIpAddress": "127.0.0.1",
                    "networkId": 1498198737218387000,
                    "last_Modified": 1478927053253,
                    "id": 3182629408092289,
                    "nativeId": "floatingip_419",
                    "projectId": "tenant_300_84",
                    "status": "ACTIVE"
                  }
                ],
                "totalNum": 88,
                "pageSize": 1,
                "totalPageNo": 88,
                "currentPage": 1
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "406": {
            "description": "流控限流。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          },
          "502": {
            "description": "网关错误。"
          },
          "503": {
            "description": "服务不可用。"
          },
          "504": {
            "description": "表示时间超时,总线超时时间300s。"
          },
          "888": {
            "description": "服务摘机,不提供服务。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/rest/tenant-resource/v1/tenant/resources/CLOUD_FLOATING_IPS_VIEW?",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {},
  "version": "2.0",
  "parameters": {},
