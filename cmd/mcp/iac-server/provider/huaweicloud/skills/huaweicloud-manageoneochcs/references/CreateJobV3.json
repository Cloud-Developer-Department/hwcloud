  "definitions": {
    "JobRequest": {
      "description": "作业信息请求。",
      "properties": {
        "name": {
          "description": "作业名称,最大长度256。",
          "type": "string"
        },
        "operationId": {
          "description": "操作Id,最大长度64。",
          "type": "string"
        },
        "executeMode": {
          "description": "执行方式,可取值为:\n* manual  (手动执行)\n* once    (定时单次执行)\n* repeat  (周期执行)",
          "type": "string"
        },
        "workflowExecuteMode": {
          "description": "执行模式,可取值为(操作不使用该字段):\n* NONBLOCK  (执行异常时不挂起)\n* BLOCK     (执行异常时挂起)",
          "type": "string"
        },
        "executeNow": {
          "description": "是否立即执行。",
          "type": "boolean"
        },
        "sameParams": {
          "description": "所有target是否共用输入参数。可取值为:\n*  true  (共用输入参数)",
          "type": "boolean"
        },
        "jobType": {
          "description": "作业类型,可取值为:\n*  operation  (操作)\n*  workflow (编排)",
          "type": "string"
        },
        "startTime": {
          "description": "开始时间,执行方式为once或者repeat时,必须填写,且执行时间必须大于当前时间。",
          "type": "integer",
          "format": "int64"
        },
        "fretime": {
          "description": "频率次数,执行方式为repeat时,必须填写。可取值为:\n*  频率为hour时,取值范围:1-23\n*  频率为day时,取值范围:1-31\n*  频率为week时,取值范围:1-4\n*  频率为month时,取值范围:1,2,3,4,6",
          "type": "integer",
          "format": "int32"
        },
        "frequency": {
          "description": "频率。执行方式为repeat时,必须填写。可取值为:\n*  hour  (时)\n*  day (天)\n*  week (周)\n* month (月)",
          "type": "string"
        },
        "params": {
          "description": "输入参数。",
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/definitions/JobParam"
          }
        },
        "targets": {
          "description": "执行目标。",
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/JobTarget"
          }
        },
        "regionIds": {
          "description": "字段已废弃,不建议使用。如需使用,请联系华为工程师确认。",
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "string"
          }
        },
        "executeSingle": {
          "description": "是否编排单独执行(操作不使用该字段)。",
          "type": "boolean"
        },
        "remark": {
          "description": "备注,最大长度128。",
          "type": "string"
        },
        "triggerEvents": {
          "description": "触发事件集合。",
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/TriggerEvent"
          }
        },
        "ciType": {
          "description": "归属资源类型,类型列表参照资源管理(CMDB),最大长度64。",
          "type": "string"
        },
        "ciInstanceId": {
          "description": "归属资源实例ID,最大长度36。",
          "type": "string"
        }
