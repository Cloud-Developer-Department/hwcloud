          "type": "integer",
          "format": "int32"
        },
        "fileName": {
          "description": "文件名称,最大长度256。",
          "type": "string"
        },
        "paramValueExt": {
          "description": "参数扩展信息,文件类型参数包含文件名、id,枚举类型参数包含枚举名、id,设备类型参数包含设备名、id、类型、ip、状态。",
          "type": "array",
          "maxItems": 30,
          "items": {
