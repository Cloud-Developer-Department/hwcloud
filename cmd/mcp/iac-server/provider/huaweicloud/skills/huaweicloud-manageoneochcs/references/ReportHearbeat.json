        "namespace": {
          "description": "资源类型(SYS.ECS,SYS.SERVER)。",
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]{0,64}$",
          "default": "SYS.ECS"
        },
        "time": {
          "type": "integer",
          "format": "int64",
          "description": "Agent端时间戳。"
        },
        "meta_data": {
