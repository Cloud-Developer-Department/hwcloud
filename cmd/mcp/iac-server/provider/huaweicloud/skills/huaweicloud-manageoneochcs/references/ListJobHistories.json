  "definitions": {
    "JobHistoryListRequest": {
      "description": "查询历史作业列表请求。",
      "properties": {
        "name": {
          "description": "作业名称,最大长度256。",
          "type": "string"
        },
        "operationName": {
          "description": "操作名称,最大长度256。",
          "type": "string"
        },
        "executor": {
          "description": "执行人,最大长度64。",
          "type": "string"
        },
        "executeMode": {
          "description": "执行方式,可取值为:\n* manual  (手动执行)\n* once    (定时单次执行)\n* repeat   (周期执行)",
          "type": "string"
        },
        "startTimeSince": {
          "description": "查询该时间之后执行的任务,格式为时间戳。",
          "type": "integer",
          "format": "int64"
        },
        "startTimeBefore": {
          "description": "查询该时间之前执行的任务,格式为时间戳。",
          "type": "integer",
          "format": "int64"
        },
        "executeStatus": {
          "description": "作业状态,可取值为:\n* success (执行成功)\n* failed (执行失败)\n* partial_success (部分成功)\n* executing (执行中)\n* timeout (执行超时)\n* stop (执行终止)",
          "type": "string"
        },
        "jobId": {
          "description": "作业Id,最大长度64。",
          "type": "string"
        },
        "jobType": {
          "description": "作业类型,可取值为:\n*  operation  (操作)\n*  workflow (编排)",
          "type": "string"
        },
        "operationId": {
          "description": "操作Id,最大长度64。",
          "type": "string"
        },
        "sort": {
          "description": "排序字段,最大长度64,'-'开头表示降序。可取值为:\n*  startTime \n*  endTime\n*  costTime \n*  name",
          "type": "string"
        },
        "limit": {
          "description": "数量,最大1000。",
          "type": "integer",
          "format": "int32"
        },
        "offset": {
          "description": "偏移。",
          "type": "integer",
          "format": "int32"
        },
        "remark": {
          "description": "备注,最大长度128。",
          "type": "string"
        },
        "eventType": {
          "description": "触发事件类型,最大长度128。可取值为:\n* alarm:告警",
          "type": "string"
        },
        "eventInstanceId": {
          "description": "事件实例ID。",
          "type": "string"
        }
      }
    },
    "JobHistoryListResponse": {
      "description": "查询历史作业列表响应。",
      "properties": {
        "total": {
          "description": "总数。",
          "type": "integer",
          "format": "int64"
        },
        "jobHistories": {
          "description": "历史作业返回列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/JobHistoryListEntry"
          }
        }
      }
    },
    "JobHistoryListEntry": {
      "description": "历史作业列表返回体。",
      "properties": {
        "id": {
          "description": "作业历史ID。",
          "type": "string"
        },
        "name": {
          "description": "作业名称。",
          "type": "string"
        },
        "executor": {
          "description": "执行人。",
          "type": "string"
        },
        "startTime": {
          "description": "开始时间。",
          "type": "string"
        },
        "endTime": {
          "description": "结束时间。",
          "type": "string"
        },
        "operationId": {
          "description": "操作Id。",
          "type": "string"
        },
        "operationName": {
          "description": "操作名称。",
          "type": "string"
        },
        "executeMode": {
          "description": "执行方式。",
          "type": "string"
        },
        "jobStatus": {
          "description": "作业状态。",
          "type": "string"
        },
        "costTime": {
          "description": "执行用时。",
          "type": "integer",
          "format": "int64"
        },
        "successCount": {
          "description": "成功的数量。",
          "type": "integer",
          "format": "int32"
        },
        "failedCount": {
          "description": "失败的数量。",
          "type": "integer",
          "format": "int32"
        },
        "executingCount": {
          "description": "执行中的数量。",
          "type": "integer",
          "format": "int32"
        },
        "waitingCount": {
          "description": "等待执行的数量。",
          "type": "integer",
          "format": "int32"
        },
        "jobId": {
          "description": "作业Id。",
          "type": "string"
        },
        "jobName": {
          "description": "作业名称。",
          "type": "string"
        },
        "jobType": {
          "description": "作业类型。",
          "type": "string"
        },
        "failCode": {
          "description": "失败类型。",
          "type": "string"
        },
        "supportDownload": {
          "description": "是否支持下载结果。",
          "type": "boolean"
        },
        "supportHtml": {
          "description": "是否支持html查看。",
          "type": "boolean"
        },
        "remark": {
          "description": "备注。",
          "type": "string"
        },
        "executeDimension": {
          "description": "执行维度。",
          "type": "string"
        }
      }
    }
