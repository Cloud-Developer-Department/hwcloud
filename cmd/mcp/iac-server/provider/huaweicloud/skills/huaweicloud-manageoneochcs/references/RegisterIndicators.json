{
  "name": "RegisterIndicators",
  "summary": "性能模型注册",
  "tags": "性能监控",
  "productshort": "ManageOneOCHCS",
  "region_id": "cn-north-4",
  "paths": {
    "/rest/performance/v2/classes/{className}": {
      "put": {
        "summary": "性能模型注册",
        "description": "性能模型注册",
        "tags": [
          "性能监控"
        ],
        "operationId": "RegisterIndicators",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "x-precautions": "错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运维面API参考 > 错误码说明 > 性能监控特性”章节。\n",
        "x-filter": "manageone,interservice,openapi,cloudservice",
        "x-plane": "OM",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "IAM_OP token、SSO token。"
          },
          {
            "name": "className",
            "type": "string",
            "in": "path",
            "required": true,
            "description": "资源类型标识。云服务以CLOUD_开头,物理资源以SYS_开头,只支持大写字母和下划线。新增资源需和注册资源模型保持一致,原始资源类型扩展参考性能指标统一模型表的资源类型列。(表格以最终资料发布版本为准)。",
            "x-range": "无",
            "x-example": "CLOUD_ECS"
          },
          {
            "name": "RegisterInfo",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/RegisterInfo"
            },
            "description": "性能模型注册请求体",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "性能模型注册返回结果。",
            "schema": {
              "$ref": "#/definitions/Response"
            },
            "examples": {
              "application/json": {
                "errorMsg": ""
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          },
          "502": {
            "description": "网关错误。"
          },
          "503": {
            "description": "服务不可用。"
          },
          "504": {
            "description": "表示时间超时,总线超时时间300s。"
          },
          "888": {
            "description": "服务摘机,不提供服务。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "PUT https://{endpoint}/rest/performance/v2/classes/CLOUD_VM",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "namespace": "",
          "system": {
            "systemType": "TestDriver01",
            "enUs": "TestDriver01",
            "zhCn": "TestDriver01"
          },
          "indicators": [
            {
              "name": "cpuUsageTest",
              "dataType": "float",
              "dataUnit": "KB/s",
              "displayName": {
                "enUs": "cpu_Usage",
                "zhCn": "CPU使用率"
              }
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "RegisterInfo": {
      "description": "注册指标模型信息",
      "type": "object",
      "properties": {
        "namespace": {
          "description": "命名空间",
          "type": "string"
        },
        "system": {
          "$ref": "#/definitions/SystemInfo",
          "description": "来源系统",
          "required": true
        },
        "indicators": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/Indicators"
          },
          "description": "新增指标信息",
          "required": true
        },
        "extraCondition": {
          "$ref": "#/definitions/ExtraCondition",
          "description": "额外的过滤条件"
        },
        "resourceCondition": {
          "type": "string",
          "description": "过滤条件扩展能力"
        },
        "extraParam": {
          "$ref": "#/definitions/ExtraParam",
          "description": "扩展能力"
        }
      }
    },
    "Response": {
      "description": "响应体。",
      "properties": {
        "retCode": {
          "description": "接口响应码。",
          "type": "string"
        },
        "errorMsg": {
          "description": "错误信息。",
          "type": "string"
        }
      }
    },
    "ImpactDesc": {
      "required": [
        "enUs",
        "zhCn"
      ],
      "properties": {
        "enUs": {
          "type": "string",
          "description": "可用性指标的英文国际化"
        },
        "zhCn": {
          "type": "string",
          "description": "可用性指标的中文国际化"
        }
      }
    },
    "HighLevelDisplayName": {
      "required": [
        "enUs",
        "zhCn"
      ],
      "properties": {
        "enUs": {
          "type": "string",
          "description": "指标英文描述。"
        },
        "zhCn": {
          "type": "string",
          "description": "指标中文描述。"
        }
      }
    },
    "ExtraCondition": {
      "properties": {
        "name": {
          "type": "string",
          "description": "过滤资源字段。",
          "required": true
        },
        "value": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string"
          },
          "description": "过滤值。",
          "required": true
        }
      }
    },
    "SubSystemInfo": {
      "description": "子系统版本信息",
      "required": [
        "name",
        "alias",
        "product_name",
        "product_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "下级网元标识。"
        },
        "alias": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "下级网元名称。"
        },
        "product_name": {
          "type": "string",
          "description": "下级网元产品名称。"
        },
        "product_version": {
          "type": "string",
          "description": "下级软件版本。"
        },
        "product_patch_version": {
          "type": "array",
          "description": "下级网元补丁版本。",
          "maxItems": 1000,
          "items": {
            "type": "string"
          }
        },
        "ipaddress": {
          "type": "string",
          "description": "下级IP地址。"
        }
      }
    },
    "ExtraParam": {
      "properties": {
        "classNameEN": {
          "type": "string",
          "description": "资源类型英文--高阶云服务用。",
          "required": false
        },
        "classNameZH": {
          "type": "string",
          "description": "资源类型中文--高阶云服务用。",
          "required": false
        },
        "cmdbType": {
          "type": "string",
          "description": "对应cmdb名称",
          "required": false
        }
      }
    },
    "Alarm": {
      "required": [
        "alarmSeverity",
        "trigExpression",
        "trigTimes",
        "clearExpression",
        "clearTimes",
        "alarmGroupId",
        "alarmId"
      ],
      "properties": {
        "alarmSeverity": {
          "type": "string",
          "description": "告警级别。",
          "pattern": "CRITICAL|MAJOR|MINOR|WARNING"
        },
        "trigExpression": {
          "type": "string",
          "description": "触发条件。"
        },
        "trigTimes": {
          "type": "integer",
          "format": "int64",
          "description": "触发次数。",
          "minimum": 1,
          "maximum": 10
        },
        "clearExpression": {
          "type": "string",
          "description": "清除条件。"
        },
        "clearTimes": {
          "type": "integer",
          "format": "int64",
          "description": "清除次数。",
          "minimum": 1,
          "maximum": 10
        },
        "alarmGroupId": {
          "type": "string",
          "description": "告警分组。",
          "pattern": "^[0-9]{1,15}$"
        },
        "alarmId": {
          "type": "string",
          "description": "告警ID。",
          "pattern": "^[0-9]{1,15}$"
        }
      }
    },
    "Indicators": {
      "required": [
        "name",
        "displayName",
        "dataUnit"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "指标Id"
        },
        "name": {
          "type": "string",
          "description": "指标名称。"
        },
        "dataType": {
          "type": "string",
          "description": "数据类型。"
        },
        "dataUnit": {
          "type": "string",
          "description": "数据单位。"
        },
        "displayName": {
          "type": "object",
          "$ref": "#/definitions/DisplayName",
          "description": "国际化指标名称。"
        },
        "description": {
          "$ref": "#/definitions/HighLevelDisplayName",
          "description": "指标详情描述信息"
        },
        "isSupportAlarm": {
          "type": "boolean",
          "default": false,
          "description": "是否支持告警"
        },
        "isSLI": {
          "type": "boolean",
          "default": false,
          "description": "是否为可用性指标"
        },
        "valet": {
          "type": "string",
          "default": false,
          "description": "用性指标的类别,枚举:capacity\\availability\\latency\\error\\ticket"
        },
        "impactDesc": {
          "$ref": "#/definitions/ImpactDesc",
          "description": "可用性指标的影响描述国际化信息"
        },
        "isKeyMetric": {
          "type": "boolean",
          "default": false,
          "description": "是否关键指标"
        },
        "indicatorGroupId": {
          "type": "integer",
          "format": "int64",
          "description": "指标分组Id"
        },
        "isHidden": {
          "type": "boolean",
          "default": false,
          "description": "是否在报表/大屏隐藏该指标。"
        },
        "alarms": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/Alarm"
          },
          "description": "指标"
        }
      }
    },
    "DisplayName": {
      "properties": {
        "enUs": {
          "type": "string",
          "description": "指标英文描述。",
          "required": true
        },
        "zhCn": {
          "type": "string",
          "description": "指标中文描述。",
          "required": true
        }
      }
    },
    "SystemInfo": {
      "description": "系统版本信息",
      "required": [
        "name",
        "alias",
        "product_name",
        "product_version",
        "ipaddress"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "网元唯一标识。"
        },
        "alias": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "网元名称。"
        },
        "product_name": {
          "type": "string",
          "description": "产品名称。"
        },
        "product_version": {
          "type": "string",
          "description": "软件版本。"
        },
        "product_patch_version": {
          "type": "array",
          "description": "补丁版本。",
          "maxItems": 1000,
          "items": {
            "type": "string"
          }
        },
        "ipaddress": {
          "type": "string",
          "description": "IP地址。"
        },
        "sub_system_infos": {
          "type": "array",
          "description": "子系统信息。",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/SubSystemInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}