  "definitions": {
    "CesEvent": {
      "required": [
        "namespace",
        "type",
        "dimensions"
      ],
      "description": "完整的主机配置信息定义。",
      "properties": {
        "namespace": {
          "description": "指标命名空间,必须以字母开头,只能包含0-9/a-z/AZ/_,总长度最短为3,最大为32。",
          "type": "string"
        },
        "type": {
          "description": "事件类型,只允许字母、下划线、中划线,以字母或汉字开头,长度不超过64,如instance_host_info。",
          "type": "string"
        },
        "dimensions": {
          "description": "指标维度列表。目前支持维度列表长度最大为3。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CesDimensions"
          },
          "maxItems": 1000
        }
      }
    },
    "CesDimensions": {
      "required": [
        "name",
        "value"
      ],
      "description": "CES告警维度。",
      "properties": {
        "name": {
          "description": "告警描述,只能包含0-9/az/A-Z/_/-或汉字,长度0-256。",
          "type": "string"
        },
        "value": {
          "description": "告警描述,只能包含0-9/az/A-Z/_/-或汉字,长度0-256。",
          "type": "string"
        }
      }
    },
    "CesEventData": {
      "required": [
        "value",
        "collect_time",
        "ttl",
        "event"
      ],
      "description": "主机配置信息。",
      "properties": {
        "value": {
          "description": "主机配置信息,可以为任意字符串,最大长度为4k。",
          "type": "string"
        },
        "collect_time": {
          "description": "数据采集的时间,格式为timestamp (ms)。",
          "type": "integer",
          "format": "int64"
        },
        "ttl": {
          "description": "数据的有效期,超出该有效期则自动删除该数据,取值范围(0-604800](1周),单位为秒。",
          "type": "integer",
          "format": "int64"
        },
        "event": {
          "description": "完整的主机配置信息定义。",
          "$ref": "#/definitions/CesEvent"
        }
      }
    }
  },
