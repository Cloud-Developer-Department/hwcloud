      "properties": {
        "id": {
          "type": "integer",
          "format": "int32",
          "description": "资源分类ID,创建时不需要"
        },
        "displayName": {
          "description": "显示名称,同一个父分类下的displayName要唯一,支持中文、字母、数字、下划线、中划线、空格,最大长度500。",
