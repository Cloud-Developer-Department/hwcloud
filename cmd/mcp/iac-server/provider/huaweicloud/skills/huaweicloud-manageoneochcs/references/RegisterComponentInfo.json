    "ComponentInfo": {
      "properties": {
        "componentId": {
          "type": "integer",
          "description": "部件id"
        },
        "serviceId": {
          "type": "string",
          "description": "服务Id"
        },
        "serviceName": {
          "type": "string",
          "description": "部件名称"
        },
        "microServiceName": {
          "type": "string",
          "description": "服务名称"
        },
        "region": {
          "type": "string",
          "description": "所属区域名称"
        },
        "regionId": {
          "type": "integer",
          "description": "所属区域id"
        },
        "serviceUrlStr": {
          "type": "string",
          "description": "部件接口地址toString"
        },
        "serviceUrl": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "部件接口地址"
        },
        "componentDescribe": {
          "type": "string",
          "description": "部件描述"
        },
        "updateType": {
          "type": "integer",
          "description": "更新方式 0 默认接口调用   1 cac方式更新",
