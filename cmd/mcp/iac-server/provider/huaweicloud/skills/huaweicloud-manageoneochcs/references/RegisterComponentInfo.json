        },
        "certs": {
          "type": "array",
          "x-maxLength": 100,
          "items": {
            "$ref": "#/definitions/CertInfo"
          },
          "description": "证书列表,服务端部件必填"
        },
        "dateTime": {
          "type": "string",
          "description": "当前时间"
        },
        "isPreset": {
          "type": "boolean",
          "description": "是否预制",
          "default": true
        }
      },
      "required": [
        "serviceName",
        "region",
        "certs"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
