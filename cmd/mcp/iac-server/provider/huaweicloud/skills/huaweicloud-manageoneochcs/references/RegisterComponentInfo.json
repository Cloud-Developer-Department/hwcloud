{
  "name": "RegisterComponentInfo",
  "summary": "部件注册",
  "tags": "证书管理",
  "productshort": "ManageOneOCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/unify-cert/components": {
      "post": {
        "tags": [
          "证书管理"
        ],
        "operationId": "RegisterComponentInfo",
        "summary": "部件注册",
        "description": "部件相关信息注册。",
        "x-plane": "Tenant,OM",
        "x-precautions": " 接口请求参数中x-auth-token使用有效token(op_serv权限的用户token)。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "IAM_OP token、SSO token"
          },
          {
            "name": "componentInfo",
            "in": "body",
            "required": true,
            "description": "部件注册时的所有相关信息。",
            "schema": {
              "$ref": "#/definitions/ComponentInfo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Addition succeeded.",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": {
                "errorMsg": "success",
                "resultCode": "00000000"
              }
            }
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/rest/unify-cert/components",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "serviceName": "serviceName",
          "region": "region",
          "serviceUrl": {
            "checkStatus": "/om/v1/certificate-om/checkStatus",
            "update": "/om/v1/certificate-om/update",
            "notice": "/om/v1/certificate-om/notice"
          },
          "certs": [
            {
              "certName": "service",
              "use": "SSL",
              "certFormat": "jks",
              "description": "tomcat certs",
              "subjectName": "C=CN, O=Huawei, CN=www.huawei.com, L=XiAn, OU=HuaweiSoftware, ST=ShanXi,E=test@xxx.xxx",
              "strExtentions": "",
              "keyAlgorithm": "rsa",
              "keySize": 2048,
              "dependServiceName": "",
              "dependCertName": "",
              "dependCertFormat": "",
              "dependType": ""
            },
            {
              "certName": "gaussdb-server",
              "use": "SSL",
              "certFormat": "pem",
              "description": "two way ahthen",
              "subjectName": "C=CN, O=Huawei, CN=www.huawei.com, L=XiAn, OU=HuaweiSoftware, ST=ShanXi,E=tests@xxx.xxx",
              "strExtentions": "",
              "keyAlgorithm": "rsa",
              "keySize": 2048,
              "dependServiceName": "",
              "dependCertName": "",
              "dependCertFormat": "",
              "dependType": ""
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "InterlockCert": {
      "properties": {
        "interlockCertName": {
          "type": "string",
          "description": "联动证书名称"
        },
        "interlockServiceName": {
          "type": "string",
          "description": "联动部件名称"
        }
      }
    },
    "CertInfo": {
      "required": [
        "certName",
        "certType",
        "serviceName",
        "certFormat",
        "keyAlgorithm"
      ],
      "properties": {
        "certId": {
          "type": "integer",
          "description": "证书ID"
        },
        "certIdSop": {
          "type": "string",
          "description": "属于平台的证书ID"
        },
        "domains": {
          "type": "array",
          "x-maxLength": 100,
          "items": {
            "type": "string"
          }
        },
        "usage": {
          "type": "string",
          "description": "证书使用场景列表"
        },
        "prefabricateCert": {
          "type": "boolean",
          "description": "是否是预制证书",
          "default": false
        },
        "supportUpdates": {
          "type": "boolean",
          "description": "是否支持更新",
          "default": true
        },
        "certInstanceId": {
          "type": "string",
          "description": "证书Id uuid"
        },
        "updateType": {
          "type": "integer",
          "description": "更新方式 0 默认接口调用   1 cac方式更新",
          "default": 0
        },
        "serviceName": {
          "type": "string",
          "description": "所属部件名称"
        },
        "microServiceName": {
          "type": "string",
          "description": "所属服务名称"
        },
        "certAlias": {
          "type": "string",
          "description": "证书别名"
        },
        "certAliasEn": {
          "type": "string",
          "description": "证书别名"
        },
        "serviceId": {
          "type": "integer",
          "description": "所属部件ID"
        },
        "regionId": {
          "type": "integer",
          "description": "区域ID"
        },
        "regionName": {
          "type": "string",
          "description": "区域名称"
        },
        "certName": {
          "type": "string",
          "description": "证书名称,即场景名称"
        },
        "certType": {
          "type": "integer",
          "description": "证书类型"
        },
        "use": {
          "type": "string",
          "description": "证书用途"
        },
        "certFormat": {
          "type": "string",
          "description": "证书格式"
        },
        "version": {
          "type": "integer",
          "description": "证书版本"
        },
        "subjectName": {
          "type": "string",
          "description": "证书主体信息"
        },
        "strExtentions": {
          "type": "string",
          "description": "扩展项"
        },
        "notBefore": {
          "type": "string",
          "description": "证书起始时间"
        },
        "notAfter": {
          "type": "string",
          "description": "证书的截止时间"
        },
        "keyAlgorithm": {
          "type": "string",
          "description": "生成密钥对的算法"
        },
        "keySize": {
          "type": "integer",
          "description": "生成密钥对的长度"
        },
        "updateStatus": {
          "type": "string",
          "description": "证书更新状态"
        },
        "updateProgress": {
          "type": "integer",
          "description": "证书更新进度"
        },
        "updateDetail": {
          "type": "string",
          "description": "证书更新详情"
        },
        "updateCertId": {
          "type": "integer",
          "description": "旧证书的ID"
        },
        "updateTime": {
          "type": "string",
          "description": "证书更新时间"
        },
        "dependType": {
          "type": "string",
          "description": "依赖类型"
        },
        "dependCertId": {
          "type": "integer",
          "description": "客户端所属的服务端证书ID"
        },
        "dependCertName": {
          "type": "string",
          "description": "客户端所属的服务端证书名称"
        },
        "dependCertFormat": {
          "type": "string",
          "description": "客户端所属的服务端证书格式"
        },
        "dependComponentId": {
          "type": "integer",
          "description": "客户端所属的服务端部件ID"
        },
        "dependServiceName": {
          "type": "string",
          "description": "客户端所属的服务端部件名称"
        },
        "belongCAId": {
          "type": "integer",
          "description": "所属CA的ID"
        },
        "belongCAName": {
          "type": "string",
          "description": "所属CA的Name"
        },
        "componentDescribe": {
          "type": "string",
          "description": "部件描述"
        },
        "description": {
          "type": "string",
          "description": "证书描述"
        },
        "supportCA": {
          "type": "array",
          "x-maxLength": 100,
          "items": {
            "type": "string"
          },
          "description": "所属的CA列表"
        },
        "relatedComponents": {
          "type": "array",
          "x-maxLength": 100,
          "items": {
            "$ref": "#/definitions/CertInfo"
          },
          "description": "关联的客户端部件"
        },
        "extendMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "扩展接口"
        },
        "interlockCertStrings": {
          "type": "string",
          "description": "联动证书链"
        },
        "interlockCertList": {
          "type": "array",
          "x-maxLength": 100,
          "items": {
            "$ref": "#/definitions/InterlockCert"
          },
          "description": "联动证书列表"
        },
        "supportSM": {
          "type": "boolean",
          "description": "该证书是否支持商密"
        },
        "caType": {
          "type": "integer",
          "description": "证书类型: 0:国际证书, 1:国密证书, 默认为0。",
          "default": 0,
          "minimum": 0,
          "maximum": 1
        },
        "certUsage": {
          "type": "string",
          "description": "SIGNATURE: 商密签名证书, ENCRYPTION: 商密加密证书, COMMON: 国际证书, 默认国际证书",
          "enum": [
            "SIGNATURE",
            "ENCRYPTION",
            "COMMON"
          ],
          "default": "COMMON"
        },
        "smCertList": {
          "type": "array",
          "x-maxLength": 100,
          "items": {
            "$ref": "#/definitions/CertInfo"
          },
          "description": "国密双证书"
        },
        "secretName": {
          "type": "string",
          "description": "cdk证书 秘钥名称"
        },
        "supportHotUpgrade": {
          "type": "boolean",
          "description": "cdk证书 是否支持热升级"
        },
        "certContent": {
          "type": "string",
          "description": "证书内容"
        },
        "certChain": {
          "type": "string",
          "description": "证书链"
        },
        "priKey": {
          "type": "string",
          "description": "私钥"
        },
        "namespace": {
          "type": "string",
          "description": "cdk 命名空间"
        },
        "clusterId": {
          "type": "string",
          "description": "cdk 集群空间"
        }
