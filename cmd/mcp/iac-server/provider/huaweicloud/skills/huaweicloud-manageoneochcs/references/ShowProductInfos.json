            "minimum": 1,
            "description": "页码。"
          },
          {
            "name": "pageSize",
            "in": "query",
            "type": "integer",
            "format": "int32",
            "minimum": 10,
            "description": "每页大小。"
          },
          {
            "name": "condition",
            "in": "query",
            "type": "string",
            "maxLength": 512,
            "description": "查询条件。参见#/definitions/RequestLicenseQueryProductCondition"
          }
