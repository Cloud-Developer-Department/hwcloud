              "$ref": "#/definitions/ProductResponseBody"
            }
          },
          "500": {
            "description": "Get Product Information failed",
            "schema": {
              "$ref": "#/definitions/ProductResponseBody"
            },
            "examples": {
              "application/json": {
                "retDesc": "internal error",
                "retCode": "00000003"
              }
            }
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/rest/unifiedlicense/v1/products?pageNo=1&pageSize=10&condition=xxx",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
