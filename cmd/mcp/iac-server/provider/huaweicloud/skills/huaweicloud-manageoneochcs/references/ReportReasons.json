          "告警管理"
        ],
        "operationId": "ReportReasons",
        "parameters": [
          {
            "name": "data",
            "in": "body",
            "description": "告警可能原因与修复建议数组。",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AlarmReason"
              }
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "添加告警可能原因与修复建议成功。",
            "examples": {
              "application/json": {
                "resultCode": "success"
              }
            }
          },
          "400": {
            "description": "参数非法。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "PUT https://{endpoint}/rest/fault/v1/alarm-reasons",
        "x-request-examples-description-1": "",
        "x-request-examples-1": [
          {
            "alarmId": "222",
            "originSystemType": "XXX",
            "reasonId": 1,
            "causes": "link exception",
            "repairAction": "check link",
            "expFormat": "expFormat",
            "operationType": 1,
            "description": "description",
            "defineField": 1
          }
        ]
      }
    }
  },
  "definitions": {
    "AlarmReason": {
      "description": "告警原因及对应修复建议信息",
      "required": [
        "alarmId",
        "operationType"
      ],
      "properties": {
        "alarmId": {
          "description": "告警标识。来自driver的告警唯一标识,driver内唯一。",
          "type": "string"
        },
        "alarmGroupId": {
          "description": "告警分组标识。各领域使用的分组标识,应遵循SingleEMS集成规范。(注意:出于兼容性考虑,如果上报者没有填写,告警服务使用originSystemType补填,即两者选填其一)",
          "type": "string"
        },
        "originSystemType": {
          "description": "来源系统类型(特殊:对接的是设备而不是系统时,该字段对应设备类型标识, 与alarmGroupId, 两者选填其一)。",
          "type": "string"
        },
        "reasonId": {
          "description": "告警原因标识。该字段表示导致本告警产生的具体原因的说明。一条告警可能有多个产生原因,该字段用于标识本条告警的具体原因。该具体原因的原因描述和修复建议,保存在静态信息的帮助信息表中。如未填写,则默认值为0。",
          "type": "integer",
          "format": "int32"
        },
        "causes": {
          "description": "告警原因。如未填写,则默认值为空。(注意:causes与repairAction二者选填其一,或者都填)",
          "type": "string"
        },
        "repairAction": {
          "description": "告警修复建议。如未填写,则默认值为空。(注意:causes与repairAction二者选填其一,或者都填)",
          "type": "string"
        },
        "expFormat": {
          "description": "特殊字段的拼接格式。",
          "type": "string"
        },
        "operationType": {
          "description": "操作类型。(预留字段)",
          "type": "integer",
          "format": "int32"
        },
        "description": {
          "description": "告警含义。",
          "type": "string"
        },
        "defineField": {
          "description": "字段定义。",
          "type": "integer",
          "format": "int32"
        }
      }
    }
  },
