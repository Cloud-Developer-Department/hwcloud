{
  "name": "ShowMetricData",
  "summary": "查询指定条件的监控数据",
  "tags": "租户保障",
  "productshort": "ManageOneOCHCS",
  "region_id": "cn-north-4",
  "paths": {
    "/V1.0/{project_id}/metric-data": {
      "get": {
        "summary": "查询指定条件的监控数据",
        "description": "查询指定时间范围指定指标的指定粒度的监控数据。\n\ncurl命令调用示例:\n```\ncurl -v -H \"Content-Type:application/json\" -X GET \"https://ip:port/v1.0/{projectId}/metric-data\"\n```",
        "x-filter": "ManageOne,openapi",
        "x-precautions": "错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运维面API参考 > 错误码说明 > 租户保障特性”章节。\n",
        "x-plane": "Tenant,OM",
        "tags": [
          "租户保障"
        ],
        "operationId": "ShowMetricData",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": false,
            "type": "string",
            "description": "有效的token(op_service权限的用户token),token中需要包含project信息。"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "project Id。",
            "required": true,
            "type": "string"
          },
          {
            "name": "namespace",
            "in": "query",
            "description": "命名空间,如 SYS.ECS。",
            "required": true,
            "type": "string"
          },
          {
            "name": "metric_name",
            "in": "query",
            "description": "指标名称。",
            "required": true,
            "type": "string"
          },
          {
            "name": "from",
            "in": "query",
            "description": "查询数据起始时间。UNIX时间戳,单位毫秒。",
            "required": true,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "to",
            "in": "query",
            "description": "查询数据截止时间UNIX时间戳,单位毫秒。from必须小于to。",
            "required": true,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "period",
            "in": "query",
            "description": "监控数据粒度,取值范围{1:实时数据,300:5分钟粒度,1200:20分钟粒度,3600:1小时粒度,14400:4小时粒度,86400:1天粒度}。",
            "required": true,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "filter",
            "in": "query",
            "description": "数据聚合方式,max,min,average,sum,variance。",
            "required": true,
            "type": "string"
          },
          {
            "name": "dim.0",
            "in": "query",
            "description": "指标的维度,目前最大支持3个维度,key只支持instance_id,维度格式为dim.0=key,value参考弹性云服务器维度。例如dim.0=instance_id,i-12345。",
            "required": true,
            "type": "string"
          },
          {
            "name": "dim.1",
            "in": "query",
            "description": "指标的维度,目前最大支持3个维度。",
            "required": false,
            "type": "string"
          },
          {
            "name": "dim.2",
            "in": "query",
            "description": "指标的维度,目前最大支持3个维度。",
            "required": false,
            "type": "string"
          },
          {
            "name": "sequenceType",
            "in": "query",
            "description": "序列类型",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "返回指标数据。获取响应体请参考《资源北向模型》。",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": {
                "datapoints": [
                  {
                    "average": 0,
                    "timestamp": 1450231200000,
                    "unit": "%"
                  }
                ],
                "metric_name": "cpu_util"
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "406": {
            "description": "流控限流。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          },
          "502": {
            "description": "网关错误。"
          },
          "503": {
            "description": "服务不可用。"
          },
          "504": {
            "description": "表示时间超时,总线超时时间300s。"
          },
          "888": {
            "description": "服务摘机,不提供服务。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
  "definitions": {},
  "version": "2.0",
  "parameters": {},
  "host": "hcs.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}