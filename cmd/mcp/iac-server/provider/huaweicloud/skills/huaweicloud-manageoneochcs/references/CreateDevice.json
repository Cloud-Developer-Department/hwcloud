{
  "name": "CreateDevice",
  "summary": "添加物理设备",
  "tags": "资源管理",
  "productshort": "ManageOneOCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/cmdb/v1/devices/{className}": {
      "post": {
        "summary": "添加物理设备",
        "description": "添加物理设备,单次最多添加10条设备实例数据。\n\n**接口SLA:**\n\n|SLA项|定义|\n|-----|-----|\n|请求成功率| ≥ 99%|\n|可用性|Tier1|\n|数据一致性|最终一致,不一致时长<1分钟|\n|吞吐量|10 tps|\n|TP50请求时延|1000 ms|\n|TP99.9请求时延|2000 ms|",
        "x-precautions": "使用前请参考《资源北向模型》,获取系统支持的资源类型、关系类型、请求body体、资源分类及属性列表。资源实例数据放在请求的body参数中。支持批量创建,数据格式为List<Map>形式,Map的key为资源的属性名,value为属性值,可参考请求示例。调用该接口需要“创建资源实例”权限,归属权限组:运维中心>资源实例管理。\n错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运维面API参考 > 错误码说明 > 资源管理特性”章节。\n",
        "tags": [
          "资源管理"
        ],
        "operationId": "CreateDevice",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "IAM_OP token、SSO token。"
          },
          {
            "name": "className",
            "in": "path",
            "type": "string",
            "description": "资源类型名称",
            "required": true
          },
          {
            "name": "data",
            "x-maxLength": 100,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/DeviceData"
              }
            },
            "in": "body",
            "description": "资源信息和资源对接协议",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "创建资源实例成功。",
            "schema": {
              "$ref": "#/definitions/ResourceReturnIdList"
            },
            "examples": {
              "application/json": {
                "idList": [
                  {
                    "id": "97D998D842423F68B83C7B86FD667B91",
                    "resId": "97D998D842423F68B83C7B86FD667B91"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          },
          "502": {
            "description": "网关错误。"
          },
          "503": {
            "description": "服务不可用。"
          },
          "504": {
            "description": "表示时间超时,总线超时时间300s。"
          },
          "888": {
            "description": "服务摘机,不提供服务。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/rest/cmdb/v1/devices/SYS_Switch",
        "x-request-examples-description-1": "",
        "x-request-examples-1": [
          {
            "instance": {
              "name": "nbtest",
              "ipAddress": "127.0.0.1",
              "deviceType": "rack",
              "sn": "sn1",
              "encCard": true,
              "logicalRegionId": "88D998D842423F68B83C7B86FD667B66"
            },
            "mainProtocol": {
              "protocolType": "SYS_RedfishProtocol",
              "protocol": {
                "userName": "xxxx",
                "password": "xxxxx",
                "restPort": 443
              }
            },
            "auxProtocol": {
              "protocolType": "SYS_SNMPProtocol",
              "protocol": {
                "protocolVersion": "V3",
                "port": 161,
                "restPort": 443,
                "authProtocol": "HMAC_SHA256",
                "privProtocol": "AES_256",
                "timeout": 15,
                "retryTimes": 3
              }
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "ResourceReturnIdList": {
      "description": "实例批量操作的返回结果",
      "properties": {
        "idList": {
          "type": "array",
          "description": "资源实例ID列表",
          "items": {
            "$ref": "#/definitions/ResourceReturnId"
          }
        }
      }
    },
    "DeviceProtocol": {
      "description": "设备协议参数",
      "properties": {
        "protocolType": {
          "type": "string",
          "description": "协议类型。"
        },
        "protocol": {
          "description": "协议信息。请参考《资源北向模型》,获取协议模型的属性列表。",
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "DeviceData": {
      "description": "设备信息与协议参数。",
      "properties": {
        "instance": {
          "description": "设备信息。支持添加服务器、服务器机框、路由器、防火墙、交换机和负均衡器设备,请参考《资源北向模型》,获取资源类型的属性列表。Map的key为资源的属性名,value为属性值,可参考请求示例。",
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "mainProtocol": {
          "description": "设备对接协议。服务器支持SNMP协议和Redfish+SNMP协议;网络设备支持SNMP协议。请参考《资源北向模型》,获取协议模型的属性列表。",
          "type": "object",
          "$ref": "#/definitions/DeviceProtocol"
        },
        "auxProtocol": {
          "description": "辅助协议。",
          "type": "object",
          "$ref": "#/definitions/DeviceProtocol"
        }
      }
    },
    "ResourceReturnId": {
      "description": "资源实例ID",
      "properties": {
        "id": {
          "type": "string",
          "description": "资源实例ID"
        },
        "resId": {
          "type": "string",
          "description": "实例ID"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}