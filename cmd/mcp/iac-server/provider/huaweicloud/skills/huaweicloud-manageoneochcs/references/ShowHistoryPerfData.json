  "definitions": {
    "RestResponse": {
      "description": "公共返回结果基类。",
      "type": "object",
      "properties": {
        "status_code": {
          "type": "integer",
          "format": "int32",
          "description": "状态码。",
          "default": 200
        },
        "error_code": {
          "type": "integer",
          "format": "int32",
          "description": "错误码。",
          "default": 0
        },
        "error_msg": {
          "type": "string",
          "description": "错误消息。",
          "default": "Successful."
        }
      }
    },
    "HistoryPerfData": {
      "description": "历史性能数据。",
      "type": "object",
      "properties": {
        "series": {
          "type": "array",
          "description": "满足条件的历史数据值序列,按时间升序排列。如果是汇聚数据,则序列值来自平均值汇聚表。",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "min": {
          "type": "object",
          "description": "满足条件的历史数据值序列中最小值。",
          "additionalProperties": {
            "type": "string"
          }
        },
        "max": {
          "type": "object",
          "description": "满足条件的历史数据值序列中最大值。",
          "additionalProperties": {
            "type": "string"
          }
        },
        "avg": {
          "type": "object",
          "description": "满足条件的历史数据值序列平均值。",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "BaseQueryRequest": {
      "description": "基础查询性能数据请求对象。",
      "type": "object",
      "properties": {
        "obj_type_id": {
          "description": "监控对象类型标识。监控对象类型标识获取参考“性能监控”章节中“获取所有监控对象类型”接口,接口url为“/rest/performance/v1/mgr-svc/obj-types”,具体值为响应示例中“obj_type_id”。",
          "type": "integer",
          "format": "int64"
        },
        "obj_type": {
          "description": "监控对象类型。",
          "type": "string"
        },
        "projectIds": {
          "description": "租户项目ID列表。",
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "indicator_ids": {
          "description": "监控指标标识列表。监控指标标识列表获取参考“性能监控”章节中“获取监控对象类型支持的监控指标”接口,接口url为“/rest/performance/v1/mgr-svc/obj-types/{obj-type-id}/indicators”,具体值为响应示例中“indicator_ids”。",
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "integer",
            "format": "int64"
          }
        },
        "indicators": {
          "description": "监控指标列表。",
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string"
          }
        },
        "obj_ids": {
          "description": "监控对象标识列表,对应资源管理实例ID。管理实例ID获取参考“资源管理”章节中“查询指定资源类型的所有实例”接口,接口url为“/rest/cmdb/v1/instances/{className}”或 “租户保障”章节中“租户资源查询接口”接口,接口url为“/rest/tenant-resource/v1/tenant/resources/{class-name}”,管理实例ID的具体值为响应示例中“objList” 中“resId”。 查询资源管理实例ID前需要调用“性能监控”章节“获取所有监控对象类型”接口查询“obj_type_id”和“resource_category”的对应关系。如果“obj_type_id”对应的“resource_category”值为“CLOUD_BANDWIDTHS”,“CLOUD_BMS”,“CLOUD_DCS”,“CLOUD_ELB”,“CLOUD_FLOATING_IPS”、“CLOUD_HOST_NIC”、“CLOUD_LISTENER”、“CLOUD_NODE”、“CLOUD_OBS”、“CLOUD_ODS_CDB”、“CLOUD_ODS_PDB”、“CLOUD_RDS”、“CLOUD_SFS_SHARE”、“CLOUD_TASK”、“CLOUD_VM”、“CLOUD_VM_NIC”、“CLOUD_VOLUME”、“CLOUD_VSM”则查询接口“/rest/tenant-resource/v1/tenant/resources/{class-name}”,调用接口时“class-name”的值传“resource_category”的值。如果“obj_type_id”对应的“resource_category”为“SYS_BigDataCluster”、“SYS_BigDataHost”、“SYS_CHSM”、“SYS_Cluster”、“SYS_Controller”、“SYS_FCSwitch”、“SYS_FCSwitchPort”、“SYS_Lun”、“SYS_NPU”、“SYS_NetworkDevice”、“SYS_NetworkDeviceBoard”、“SYS_NetworkDevicePort”、“SYS_OpticalTerminationPoint”、“SYS_PhysicalHost”、“SYS_PhysicalServer”、“SYS_Psu”、“SYS_StorDevice”、“SYS_StorageDisk”、“SYS_StoragePool”、“SYS_StoragePort”、“SYS_VM”、“SYS_VM_NIC”、“SYS_X86Server”则查询接口“/rest/cmdb/v1/instances/{className}”,调用接口时“className”的值传“resource_category”的值。",
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string"
          }
        },
        "ext_dimensions": {
          "description": "扩展维度信息列表。",
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/ExtendSimpleDimension"
          }
        }
      },
      "required": [
        "obj_type_id",
        "indicator_ids",
        "obj_ids"
      ]
    },
    "ExtendSimpleDimension": {
      "description": "扩展维度信息。",
      "properties": {
        "field": {
          "description": "性能指标维度的名称。",
          "type": "string"
        },
        "value": {
          "type": "string",
          "description": "性能指标维度的值。"
        }
      },
      "required": [
        "field",
        "value"
      ]
    },
    "HistoryPerfDataRequest": {
      "description": "历史性能数据请求。",
      "allOf": [
        {
          "$ref": "#/definitions/BaseQueryRequest"
        },
        {
          "type": "object",
          "properties": {
            "interval": {
              "type": "string",
              "description": "间隔粒度枚举字符串,要求全大写",
              "enum": [
                "ORIGINAL",
                "ONE_MINUTE",
                "MINUTE",
                "HALF_HOUR",
                "HOUR",
                "DAY",
                "WEEK",
                "MONTH"
              ]
            },
            "range": {
              "type": "string",
              "description": "时间范围枚举字符串,要求全大写。",
              "enum": [
                "LAST_5_MINUTE",
                "LAST_1_HOUR",
                "LAST_1_DAY",
                "LAST_1_WEEK",
                "LAST_1_MONTH",
                "LAST_1_QUARTER",
                "HALF_1_YEAR",
                "LAST_1_YEAR",
                "BEGIN_END_TIME",
                "INVALID"
              ],
              "default": "INVALID"
            },
            "begin_time": {
              "type": "integer",
              "format": "int64",
              "description": "查询开始时刻,必须比 end_time 小,仅 range 为 BEGIN_END_TIME 时生效。"
            },
            "end_time": {
              "type": "integer",
              "format": "int64",
              "description": "查询结束时刻,必须比 begin_time 大,仅 range 为 BEGIN_END_TIME 时生效。"
            }
          }
        }
      ]
    },
    "HistoryPerfDataResponse": {
      "description": "历史性能数据响应。",
      "allOf": [
        {
          "$ref": "#/definitions/RestResponse"
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "description": "历史数据查询结果。",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/HistoryPerfData"
                }
              }
            }
          }
        }
      ]
    }
  },
