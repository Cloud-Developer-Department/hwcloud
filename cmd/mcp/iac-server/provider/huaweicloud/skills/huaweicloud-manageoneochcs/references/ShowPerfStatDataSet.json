{
  "name": "ShowPerfStatDataSet",
  "summary": "查询资源性能数据集的明细信息(3.0版本),目前仅支持VDC配额明细数据集(perf-stat-vdc-quota-details)查询,且不支持排序(options.topN)和趋势(options.trend)查询。",
  "tags": "数据分析平台",
  "productshort": "ManageOneOCHCS",
  "region_id": "cn-north-4",
  "paths": {
    "/rest/analysis/v3/perf-datasets/{dataSet}": {
      "post": {
        "summary": "查询资源性能数据集的明细信息(3.0版本),目前仅支持VDC配额明细数据集(perf-stat-vdc-quota-details)查询,且不支持排序(options.topN)和趋势(options.trend)查询。",
        "x-filter": "oc,openapi",
        "x-precautions": " 1.查询监控数据时,为确保兼容性,请使用object.id、object.nativeId,或oridim维度查询。如果使用其他维度,可能导致大规格场景下数据查询失败。 2.查询监控数据时,请保持PerfQueryCondition中atributes的属性包含在filters属性中。 3.错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运维面API参考 > 错误码说明 > 数据分析平台特性”章节。",
        "description": "查询资源性能数据集的明细信息(3.0版本)。",
        "tags": [
          "数据分析平台"
        ],
        "x-plane": "OM",
        "produces": [
          "application/json"
        ],
        "operationId": "ShowPerfStatDataSet",
        "responses": {
          "200": {
            "schema": {
              "type": "string"
            },
            "description": "返回指定性能数据集的明细信息",
            "examples": {
              "application/json": {
                "totalSize": 3,
                "pageNo": 1,
                "datas": [
                  {
                    "cpuUsage": 0.04124651373138089,
                    "memoryUsage": 100,
                    "object.name": "ecs-8547",
                    "object.id": "17884C3276543519B992B0D2A10B5865",
                    "object.nativeId": "651407d4-2b15-4923-91e0-21a1873ad597",
                    "diskIoIn": 0
                  },
                  {
                    "cpuUsage": 0.041383155156616815,
                    "memoryUsage": 100,
                    "object.name": "vAPP-ecs-7663",
                    "object.id": "9E2A0B0F1E9131FE8CE9F273C783BEBB",
                    "object.nativeId": "392b9faf-4e71-4483-9b4a-502bad5040f0",
                    "diskIoIn": 0.00014361821647201266
                  },
                  {
                    "cpuUsage": 0.04181414538134749,
                    "memoryUsage": 100,
                    "object.name": "ecs-d2a4",
                    "object.id": "5FD33F09B00536F2B8B44F54979C8CD0",
                    "object.nativeId": "5e09d59d-9564-4a16-be86-171a510bf179",
                    "diskIoIn": 0
                  }
                ],
                "pageSize": 5
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          },
          "502": {
            "description": "网关错误。"
          },
          "503": {
            "description": "服务不可用。"
          },
          "504": {
            "description": "表示时间超时,总线超时时间300s。"
          },
          "888": {
            "description": "服务摘机,不提供服务。"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "x-auth-token",
            "description": "IAM_OP token、SSO token",
            "type": "string",
            "required": true
          },
          {
            "in": "path",
            "name": "dataSet",
            "description": "数据集名称,取值参考数据集说明文档中性能相关数据集。目前仅支持VDC配额明细(perf-stat-vdc-quota-details)数据集查询",
            "type": "string",
            "required": true
          },
          {
            "default": 1,
            "in": "query",
            "name": "pageNo",
            "format": "int32",
            "description": "页数,支持1到1000的整数,默认值为1",
            "type": "integer",
            "required": false
          },
          {
            "default": 100,
            "in": "query",
            "name": "pageSize",
            "format": "int32",
            "description": "分页大小,支持1到1000的整数,默认值为100",
            "type": "integer",
            "required": false
          },
          {
            "schema": {
              "$ref": "#/definitions/StatPerfQueryCondition"
            },
            "in": "body",
            "name": "statPerfQueryCondition",
            "description": "查询条件",
            "required": true
          }
        ],
        "consumes": [
          "application/json"
        ],
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/rest/analysis/v3/perf-datasets/perf-stat-vdc-quota-details",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "timeRange": {
            "beginTime": 1719452995000,
            "endTime": 1719539395000
          },
          "attributes": [
            "vdc.name",
            "vdc.level",
            "otherInfo.serviceName",
            "otherInfo.resourceTypeName",
            "logicLoc.regionName"
          ],
          "metrics": [
            {
              "field": "localLimit",
              "aggType": "sum"
            },
            {
              "field": "localUsed",
              "aggType": "sum"
            },
            {
              "field": "localLeft",
              "aggType": "sum"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "MetricMeta": {
      "required": [
        "field",
        "aggType"
      ],
      "properties": {
        "fieldAlias": {
          "description": "指标域名称别名,非必选,如果指标域名称别名非空,返回的查询结果中将按照指标域名称别名作为键值,如果指标域名称别名为空,将按照指标域名称作为键值。当在查询请求中对同一个指标域进行多种聚合计算时(例如,在一个查询请求中同时对CPU使用率指标计算最大值、最小值、平均值),必须指定指标域名称别名。此字段仅限2.0版本接口中使用。",
          "type": "string"
        },
        "field": {
          "description": "指标域名称,取值参考数据集说明文档中的指标说明",
          "type": "string"
        },
        "aggType": {
          "description": "汇聚类型,取值范围sum,avg,min,max,count,参考数据集说明文档中的指标说明",
          "type": "string"
        }
      }
    },
    "StatPerfQueryCondition": {
      "required": [
        "attributes"
      ],
      "properties": {
        "attributes": {
          "x-maxLength": 10000,
          "description": "属性条件,用于指定需要返回的字段,最大长度为127个字符。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "x-maxLength": 1000,
          "description": "查询指标集,只支持数据集中的基础指标(汇聚方式为sum,avg,max,count的指标),支持多个。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MetricMeta"
          }
        },
        "filters": {
          "description": "查询过滤器,当前支持attributefilter",
          "$ref": "#/definitions/AttributeFilterCondition"
        },
        "timeRange": {
          "description": "时间范围参数,由开始时间和结束时间确定一个查询范围",
          "$ref": "#/definitions/TimeRangeConditionV2"
        }
      }
    },
    "TimeRangeConditionV2": {
      "required": [
        "beginTime",
        "endTime"
      ],
      "properties": {
        "granularity": {
          "description": "粒度选项,取值为1m(1分钟)、5m(5分钟)、30m(30分钟)、1h(1小时)、1d(1天)、1M(1个月)、auto,用于指定查询的数据集粒度,不同的粒度选项,允许查询的时间范围不同。此字段仅限2.0版本接口中使用。",
          "type": "string"
        },
        "interval": {
          "description": "时间跨度,取值为数字+[m|h|M|y(分别代表分钟,天,小时,月,年选一)|auto]。此字段仅限2.0版本接口中使用。",
          "type": "string"
        },
        "beginTime": {
          "format": "int64",
          "description": "开始时间,和结束时间组成一个查询时间范围,时间戳格式的日期时间",
          "type": "integer"
        },
        "endTime": {
          "format": "int64",
          "description": "结束时间,时间戳格式的日期时间",
          "type": "integer"
        }
      }
    },
    "AttributeFilterCondition": {
      "properties": {
        "attributes": {
          "x-length-message": "filter中可传入对象个数不能大于1000",
          "x-maxLength": 1000,
          "description": "属性过滤条件",
          "type": "array",
          "items": {
            "$ref": "#/definitions/AttributeFilter"
          }
        }
      }
    },
    "AttributeFilter": {
      "properties": {
        "excludes": {
          "x-maxLength": 10000,
          "description": "排除维度的值,取值长度不超过20000",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field": {
          "description": "域,取值参考数据集说明文档中的维度名称",
          "type": "string"
        },
        "values": {
          "x-maxLength": 10000,
          "description": "维度的值,取值长度不超过20000",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
