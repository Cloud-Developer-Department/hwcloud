  "definitions": {
    "CIRelationDef": {
      "description": "资源关系定义",
      "required": [
        "name",
        "sourceClassName",
        "targetClassName",
        "sourceRemark",
        "targetRemark",
        "cardinality"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "关系类型标识,字母或下划线开头,支持数字字母下划线,最大长度60",
          "maxLength": 32,
          "minLength": 1
        },
        "sourceClassName": {
          "type": "string",
          "description": "源端资源类型的标示"
        },
        "targetClassName": {
          "type": "string",
          "description": "目的端资源类型的标示"
        },
        "sourceRemark": {
          "$ref": "#/definitions/I18nObj",
          "description": "源端到目的端关系的描述,默认值null, 格式为{\"key1\":\"value1\",\"key2\":\"value2\"},最大长度500,其中key是国际化locale标识,如zh_CN、en_US等",
          "maxLength": 500,
          "minLength": 1
        },
        "targetRemark": {
          "$ref": "#/definitions/I18nObj",
          "description": "目的端到源端关系的描述,默认值null, 格式为{\"key1\":\"value1\",\"key2\":\"value2\"},最大长度500,其中key是国际化locale标识,如zh_CN、en_US等",
          "maxLength": 500,
          "minLength": 1
        },
        "targetReportAttrName": {
          "type": "string",
          "maxLength": 30,
          "minLength": 1,
          "description": "目的端上报关系的字段名称,目的端上报资源信息时使用该字段上报关系,字母或下划线开头,支持数字字母下划线,最大长度60"
        },
        "sourceReportAttrName": {
          "type": "string",
          "maxLength": 30,
          "minLength": 1,
          "description": "源端上报关系的字段名称,源端上报资源信息时使用该字段上报关系,字母或下划线开头,支持数字字母下划线,最大长度60"
        },
        "cardinality": {
          "type": "integer",
          "format": "int32",
          "description": "基数类型:1{1:1},2{1:N},3{M:1}:4{M:N}"
        },
        "preset": {
          "type": "boolean",
          "description": "是否预置模型,创建时不需要。"
        },
        "type": {
          "type": "string",
          "description": "关系类型"
        }
      }
    },
    "I18nObj": {
      "description": "国际化对象",
      "required": [
        "en_US",
        "zh_CN"
      ],
      "properties": {
        "en_US": {
          "type": "string",
          "description": "英文信息"
        },
        "zh_CN": {
          "type": "string",
          "description": "中文信息"
        }
      }
    }
