{
  "name": "ReportDefinitions",
  "summary": "上报告警定义信息",
  "tags": "告警管理",
  "productshort": "ManageOneOCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/fault/v1/alarm-definitions": {
      "put": {
        "summary": "上报告警定义信息",
        "description": "上报告警定义信息。如果记录不存在就增加,已存在就更新。\n\n|SLA项|定义|\n|-----|-----|\n|请求成功率| >=99.90%|\n|可用性|Tier2|\n|数据一致性|最终一致,不一致时长<1分钟|\n|吞吐量(tiny2)|5tps|\n|吞吐量(small)|5tps|\n|吞吐量(medium)|5tps|\n|吞吐量(large)|5tps|\n|TP50请求时延|150ms|\n|TP99.9请求时延|1000ms|",
        "x-precautions": "此接口必须在HTTPS通道上访问。",
        "tags": [
          "告警管理"
        ],
        "operationId": "ReportDefinitions",
        "parameters": [
          {
            "name": "data",
            "in": "body",
            "description": "告警定义信息数组。",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AlarmDefinition"
              }
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "上报告警定义信息成功。",
            "examples": {
              "application/json": {
                "resultCode": "success"
              }
            }
          },
          "400": {
            "description": "参数非法。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "PUT https://{endpoint}/rest/fault/v1/alarm-definitions",
        "x-request-examples-description-1": "",
        "x-request-examples-1": [
          {
            "alarmId": "alarmId",
            "originSystemType": "originSystemType",
            "alarmGroupId": "alarmGroupId",
            "category": 1,
            "eventType": 1,
            "alarmName": "alarmName",
            "alarmGroupName": "alarmGroupName",
            "description": "description",
            "severity": 1,
            "reasonType": 1,
            "relativeAlmId": 1,
            "clearStrategy": 1
          }
        ]
      }
    }
  },
  "definitions": {
    "AlarmDefinition": {
      "description": "告警定义。",
      "properties": {
        "alarmId": {
          "description": "告警标识。来自Driver的告警唯一标识,driver内唯一。",
          "type": "string"
        },
        "alarmGroupId": {
          "description": "告警分组标识。各领域使用的分组标识,应遵循SingleEMS集成规范。(注意:该字段为必填,出于兼容性考虑,如果上报者没有填写,告警服务使用originSystemType补填。)",
          "type": "string"
        },
        "originSystemType": {
          "description": "来源系统类型(特殊:对接设备而不是系统时,对应于设备类型标识)。",
          "type": "string"
        },
        "category": {
          "description": "告警or事件:\n* 1-告警\n* 2-事件",
          "type": "integer",
          "format": "int32"
        },
        "eventType": {
          "description": "事件类型。",
          "type": "integer",
          "format": "int32"
        },
        "alarmGroupName": {
          "description": "告警分组名称。如未填写,则使用alarmGroupId替代。",
          "type": "string"
        },
        "alarmName": {
          "description": "告警名称。(注意:该字段为必填,出于兼容性考虑,如果上报者没有填写,告警服务使用alarmId补填。)",
          "type": "string"
        },
        "description": {
          "description": "告警描述。",
          "type": "string"
        },
        "severity": {
          "description": "告警级别:\n* 1-紧急\n* 2-重要\n* 3-次要\n* 4-提示",
          "type": "integer",
          "format": "int32"
        },
        "clearCategory": {
          "description": "告警清除类别:\n* 0 默认值\n* 1 自动清除\n* 2 手动清除",
          "type": "integer",
          "format": "int32"
        },
        "reasonType": {
          "description": "原因类型。",
          "type": "integer",
          "format": "int32"
        },
        "relativeAlmId": {
          "description": "相关性告警id。",
          "type": "integer",
          "format": "int32"
        },
        "clearStrategy": {
          "description": "告警清除策略。",
          "type": "integer",
          "format": "int32"
        },
        "domainType": {
          "description": "告警领域。",
          "type": "integer",
          "format": "int32",
          "default": -1
        },
        "service": {
          "description": "静态信息归属服务。",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}