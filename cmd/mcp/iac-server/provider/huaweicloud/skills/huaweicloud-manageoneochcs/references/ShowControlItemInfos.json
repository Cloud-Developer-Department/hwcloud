            "name": "pageNo",
            "in": "query",
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "description": "页码。"
          },
          {
            "name": "pageSize",
            "in": "query",
            "type": "integer",
            "format": "int32",
            "minimum": 10,
            "description": "每页大小。"
          },
          {
            "name": "condition",
