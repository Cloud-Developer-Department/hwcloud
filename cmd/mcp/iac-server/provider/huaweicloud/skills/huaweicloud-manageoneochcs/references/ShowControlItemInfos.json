{
  "name": "ShowControlItemInfos",
  "summary": "查询控制项列表信息",
  "tags": "证书管理",
  "productshort": "ManageOneOCHCS",
  "region_id": "cn-north-4",
  "paths": {
    "/rest/unifiedlicense/v1/controlitems": {
      "get": {
