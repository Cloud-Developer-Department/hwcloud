                      "regionName": "test_regionName",
                      "azId": "",
                      "azName": "",
                      "preExcessesThreshold": 90,
                      "isSendThresholdAlarm": true,
                      "gracePeriodTime": 1772323200000,
                      "licenseExpiryRemainingDays": 22,
                      "serviceExpiryRemainingDays": -1,
                      "gracePeriodRemainingDays": 82,
                      "itemType": 1,
                      "usedLink": "",
                      "usedDetailStr": "",
                      "usedDetailList": [],
                      "excessesAlarmId": "",
                      "preExcessesAlarmId": "",
