{
  "name": "CreateAlarmRule",
  "summary": "创建一条告警规则",
  "tags": "租户保障",
  "productshort": "ManageOneOCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/V1.0/{project_id}/alarms": {
