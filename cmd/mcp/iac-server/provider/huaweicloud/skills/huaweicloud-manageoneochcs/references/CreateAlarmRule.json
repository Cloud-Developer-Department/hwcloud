            "type": "string",
            "description": "有效的token(op_service权限的用户token),token中需要包含project信息。"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "project Id。",
            "required": true,
            "type": "string"
          },
          {
            "name": "alarm_rule",
            "in": "body",
            "description": "CES告警规则。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CesAlarmRule"
            }
          }
        ],
        "responses": {
