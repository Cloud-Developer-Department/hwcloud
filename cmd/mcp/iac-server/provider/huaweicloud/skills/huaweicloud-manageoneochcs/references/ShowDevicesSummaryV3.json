  "definitions": {
    "DeviceSummaryRequestV3": {
      "description": "查询资源设备列表请求V3。",
      "properties": {
        "deviceType": {
          "description": "资源类型V3。可取值为:\n* vm  (弹性云服务器)\n* bms(裸金属服务器)\n* host(主机, 即管理节点、网络节点、计算节点等)\n* all(所有资源类型,默认值)",
          "type": "string"
        },
