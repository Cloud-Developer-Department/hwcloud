                },
                "defaultValue": null,
                "enumInfo": null,
                "unit": null,
                "analysisType": null
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          },
          "502": {
            "description": "网关错误。"
          },
          "503": {
            "description": "服务不可用。"
          },
          "504": {
            "description": "表示时间超时,总线超时时间300s。"
