  "definitions": {
    "CIAttributeDef": {
      "description": "资源属性定义",
      "required": [
        "name",
        "type",
        "displayName"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "属性名称,约束:只能包含数字、字母、下划线,且只能以字母或下划线开头,最大长度30。"
        },
        "writeable": {
          "type": "boolean",
          "description": "属性值是否可修改,默认值false。"
        },
        "unique": {
          "type": "boolean",
          "description": "属性值是否惟一,默认值false。"
        },
        "type": {
          "type": "string",
          "description": "属性类型,包括int、string、float、boolean、long、double。"
        },
        "length": {
          "type": "integer",
          "format": "int32",
          "description": "当属性类型为string时,该字段有效,默认值0。"
        },
        "defaultValue": {
          "type": "string",
          "description": "属性默认值,约束:最大长度100。"
        },
        "enumInfo": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/EnumInfoDef"
          },
          "description": "当属性类型为enum时,该字段有效,默认值null。"
        },
        "dimensionType": {
          "type": "string",
          "description": "分析维度,对资源进行分析时该字段的维度,默认值null,长度不超过64"
        },
        "unit": {
          "type": "string",
          "description": "属性单位。"
        },
        "preset": {
          "type": "boolean",
          "description": "是否预置属性。"
        },
        "displayName": {
          "$ref": "#/definitions/I18nObj",
          "description": "显示名称,约束:格式为{\"en_US\":\"xxx\",\"zh_CN\":\"xxx\"},最大长度500。"
        },
        "decimalDigit": {
          "type": "integer",
          "format": "int32",
          "description": "小数位数,当属性类型为float、double时有效,取值范围[0,5],默认值0。"
        },
        "minValue": {
          "type": "string",
          "description": "最小值,当属性类型为float、double、int、long时有效。"
        },
        "maxValue": {
          "type": "string",
          "description": "最大值,当属性类型为float、double、int、long时有效。"
        },
        "regExpress": {
          "type": "string",
          "description": "正则表达式(预留字段,暂不支持),用于校验属性值,当属性类型为string时有效。"
        }
      }
    },
    "EnumInfoDef": {
      "description": "枚举信息定义",
      "required": [
        "value",
        "en_US",
        "zh_CN"
      ],
      "properties": {
        "value": {
          "type": "string",
          "description": "枚举值,最大长度64。"
        },
        "en_US": {
          "type": "string",
          "description": "枚举值英文描述,最大长度128。"
        },
        "zh_CN": {
          "type": "string",
          "description": "枚举值中文描述,最大长度128。"
        },
        "category": {
          "type": "string",
          "description": "对枚举值进行分类,默认值null,最大长度64。"
        }
      }
    },
    "I18nObj": {
      "description": "国际化对象",
      "required": [
        "en_US",
        "zh_CN"
      ],
      "properties": {
        "en_US": {
          "type": "string",
          "description": "英文信息"
        },
        "zh_CN": {
          "type": "string",
          "description": "中文信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
