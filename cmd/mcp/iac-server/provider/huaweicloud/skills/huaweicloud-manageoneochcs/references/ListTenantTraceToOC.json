{
  "name": "ListTenantTraceToOC",
  "summary": "查询操作日志接口",
  "tags": "租户操作日志",
  "productshort": "ManageOneOCHCS",
  "region_id": "cn-north-4",
  "paths": {
    "/rest/octrace/v3.0/traces": {
      "get": {
        "summary": "查询操作日志接口",
        "description": "查询租户侧操作日志数据\n\n|SLA项|定义|\n|-----|-----|\n|请求成功率| ≥ 99%|\n|可用性| Tier 2|\n|数据一致性|最终一致,不一致时长<1 分钟|\n|吞吐量|60 次/分钟|\n|TP50请求时延|200 ms|\n|TP99.9请求时延|2000 ms|",
        "x-filter": "manageone,openapi,cloudservice",
        "x-plane": "OM,TENANT",
        "x-precautions": "该接口用于查询租户侧的操作日志。调用该接口时需要带上token,接口中的时间均为utc时间毫秒数。",
        "x-resource": "查询操作日志接口",
        "x-opseverity": "Minor",
        "tags": [
          "租户操作日志"
        ],
        "operationId": "ListTenantTraceToOC",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "description": "操作发生时的语言环境,中文是zh-cn。英文是en-us。"
          },
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "maxLength": 65535,
            "minLength": 1,
            "description": "IAM token。"
          },
          {
            "name": "language",
            "in": "query",
            "required": true,
            "type": "string",
            "pattern": "^(zh-cn|en-us)$",
            "description": "语言:中文(zh-cn)、英文(en-us)。只能是两者之一。"
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "0",
            "description": "分页起始数据索引"
          },
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "分页大小,可取值为:0~1000的整数"
          },
          {
            "name": "sort_key",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "排序字段,可取值为:“trace_name”,“resource_name”, “trace_level”, “trace_result”, “user_name”, “start_time”, “resource_type”, “source_ip”, “resource_type”, “service_type”。"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "required": false,
            "type": "string",
            "pattern": "^(asc|desc|)$",
            "description": "排序方式:asc 升序, desc 降序"
          },
          {
            "name": "domain_id",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "description": "Domain Id"
          },
          {
            "name": "domain_name",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "description": "Domain名称"
          },
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "description": "Project Id"
          },
          {
            "name": "project_name",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "description": "Project名称"
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "description": "用户Id"
          },
          {
            "name": "user_name",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "description": "用户名称"
          },
          {
            "name": "service_type",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "description": "发送方的简写,比如VPC,ECS等"
          },
          {
            "name": "resource_type",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "description": "发送方资源类型,比如vm,vpn等"
          },
          {
            "name": "resource_id",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 512,
            "minLength": 0,
            "description": "资源id。例如ecs服务中某个虚拟机的id"
          },
          {
            "name": "resource_name",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 512,
            "minLength": 0,
            "description": "资源名称。例如ecs服务中某个虚拟机的名称"
          },
          {
            "name": "source_ip",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 0,
            "description": "客户端ip"
          },
          {
            "name": "trace_name",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "description": "事件名称。"
          },
          {
            "name": "trace_rating",
            "in": "query",
            "required": false,
            "type": "string",
            "pattern": "^(message|normal|warning|risk|high_risk|)$",
            "description": "事件等级\n提示:message\n一般:normal\n警告:warning\n危险:risk\n高危:high_risk"
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "事件状态码。例:200,400。长度在1-4之间",
            "maxLength": 4
          },
          {
            "name": "trace_result",
            "in": "query",
            "required": false,
            "type": "string",
            "pattern": "^(successed|failed|doing|)$",
            "description": "事件结果,只能是下列选择项\n成功:successed\n失败:failed\n处理中:doing"
          },
          {
            "name": "start_time",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64",
            "default": 0,
            "description": "事件操作开始时间--起始。"
          },
          {
            "name": "end_time",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64",
            "default": 0,
            "description": "事件操作开始时间--结束。"
          },
          {
            "name": "request_id",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 2048,
            "minLength": 0,
            "description": "业务请求ID"
          },
          {
            "name": "service_name",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "description": "发送方服务名称,如ECS_01"
          },
          {
            "name": "trace_id",
            "in": "query",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "description": "操作日志表主键"
          },
          {
            "name": "trackerName",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "trackerName默认值为system,记录OCC日志时,值为occsystem。不对此值进行校验和约束"
          }
        ],
