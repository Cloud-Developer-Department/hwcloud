    }
  },
  "definitions": {
    "CesDimensions": {
      "required": [
        "name",
        "value"
      ],
      "description": "CES告警维度。",
      "properties": {
        "name": {
          "description": "告警描述,只能包含0-9/az/A-Z/_/-或汉字,长度0-256。",
          "type": "string"
        },
        "value": {
          "description": "告警描述,只能包含0-9/az/A-Z/_/-或汉字,长度0-256。",
          "type": "string"
        }
      }
    },
    "CesMetric": {
      "required": [
        "namespace",
        "metric_name",
        "dimensions"
      ],
      "description": "CES告警指标信息。",
      "properties": {
        "namespace": {
          "description": "指标命名空间,必须以字母开头,只能包含0-9/a-z/AZ/_,总长度最短为3,最大为32。",
          "type": "string"
        },
        "metric_name": {
          "description": "指标名称,必须以字母开头,只能包含0-9/a-z/AZ/_,长度最短为1,最大为64。",
          "type": "string"
        },
        "dimensions": {
          "description": "指标维度列表。目前支持维度列表长度最大为3。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CesDimensions"
          },
          "maxItems": 1000
        }
      }
    },
    "CesBatchMetricData": {
      "required": [
        "metrics",
        "from",
        "to",
        "period",
        "filter"
      ],
      "properties": {
        "metrics": {
          "description": "指标数据。",
          "required": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/CesMetric"
          },
          "maxItems": 1000
        },
        "from": {
          "description": "查询数据起始时间。UNIX时间戳,单位毫秒。",
          "required": true,
          "type": "integer",
          "format": "int64"
        },
        "to": {
          "description": "查询数据截止时间UNIX时间戳,单位毫秒。from必须小于to。",
          "required": true,
          "type": "integer",
          "format": "int64"
        },
        "period": {
          "description": "监控数据粒度,取值范围{1:实时数据,300:5分钟粒度,1200:20分钟粒度,3600:1小时粒度,14400:4小时粒度,86400:1天粒度}。",
          "required": true,
          "type": "integer",
          "format": "int32"
        },
        "filter": {
          "description": "数据聚合方式,max,min,average,sum,variance。",
          "required": true,
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}