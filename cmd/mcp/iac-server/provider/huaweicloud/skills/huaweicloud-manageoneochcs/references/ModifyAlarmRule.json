            "description": "服务摘机,不提供服务。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "PUT https://{endpoint}",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "alarm_name": "alarm-rp0f",
          "alarm_description": "",
          "condition": {
            "period": 300,
            "filter": "average",
            "comparison_operator": ">=",
            "value": 5,
            "count": 1
          },
          "alarm_action_enabled": false
        }
      }
    }
  },
  "definitions": {
    "CesAlarmRuleSub": {
      "description": "CES告警规则,可变部分,更新时使用该对象。",
      "properties": {
        "alarm_name": {
          "description": "告警名称,只能包含0-9/az/A-Z/_/-或汉字,长度1-128,该字段不支持修改。",
          "type": "string"
        },
        "alarm_description": {
          "description": "告警描述,只能包含0-9/az/A-Z/_/-或汉字,长度0-256。",
          "type": "string"
        },
        "condition": {
          "description": "告警触发条件。",
          "$ref": "#/definitions/CesCondition"
        },
        "alarm_action_enabled": {
          "description": "是否启用该条告警触发的动作,默认为true。注:若alarm_action_enabled为true,对应的alarm_actions、insufficientdata_actions、ok_actions至少有一个不能为空。",
          "type": "boolean",
          "default": true
        },
        "ok_actions": {
          "description": "告警恢复触发的动作。当前一直只支持传入一条动作。传入多条取第一条。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CesActionInfo"
          },
          "maxItems": 1000
        },
        "insufficientdata_actions": {
          "description": "数据不足触发的动作。当前一直只支持传入一条动作。传入多条取第一条。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CesActionInfo"
          },
          "maxItems": 1000
        },
        "alarm_actions": {
          "description": "告警触发的动作。当前一直只支持传入一条动作。传入多条取第一条。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CesActionInfo"
          },
          "maxItems": 1000
        },
        "regionId": {
          "description": "区域ID。",
          "type": "string"
        }
      }
    },
    "CesCondition": {
      "required": [
        "period",
        "filter",
        "comparison_operator",
        "value",
        "count"
      ],
      "description": "CES告警条件。更新时只更新一个字段也要传全量字段。",
      "properties": {
        "period": {
          "description": "告警条件判断周期,单位为秒,支持的值为1(实时),300,1200,3600,14400,86400。",
          "type": "integer",
          "format": "int32"
        },
        "filter": {
          "description": "数据聚合的方式,支持max、min、average、sum、variance,分别表示最大值、最小值、平均值、求和值、方差值。",
          "type": "string"
        },
        "comparison_operator": {
          "description": "告警阈值的比较条件,可以是>、=、<、>=、<=。",
          "type": "string"
        },
        "value": {
          "description": "告警阈值。取值范围[0,Number.MAX_VALUE],Number.MAX_VALUE值为1.7976931348623157e+308",
          "type": "string"
        },
        "unit": {
          "description": "数据的单位,长度1-10。",
          "type": "string"
        },
        "count": {
          "description": "连续发生次数,取值范围[1,5]。",
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "CesActionInfo": {
      "required": [
        "type",
        "notificationList"
      ],
      "description": "CES告警通知规则。",
      "properties": {
        "type": {
          "description": "告警动作类型,notification(邮件通知,暂不支持),autoscaling(AS使用),groupwatch(RTS使用)",
          "type": "string"
        },
        "notificationList": {
          "description": "被通知人topicUrn列表,列表最长为5,topicUrn可从SMN获取。当前不支持该字段。",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}