          {
            "name": "project_id",
            "in": "path",
            "description": "project Id。",
            "required": true,
            "type": "string"
          },
          {
            "name": "alarm_id",
            "in": "path",
            "description": "告警规则Id。",
            "required": true,
            "type": "string"
          },
          {
            "name": "alarm_rule",
            "in": "body",
            "description": "CES告警规则。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CesAlarmRuleSub"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "无返回值,更新成功。",
