{
  "name": "ModifyAlarmRule",
  "summary": "修改告警规则",
  "tags": "租户保障",
  "productshort": "ManageOneOCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/V1.0/{project_id}/alarms/{alarm_id}": {
      "put": {
        "summary": "修改告警规则",
        "description": "修改告警规则。\n\ncurl命令调用示例:\n```\ncurl -v -H \"Content-Type:application/json\" -X PUT -d \"{json}\" \"https://ip:port/v1.0/{projectId}/alarms/{alarm_id}\"\n```",
        "x-filter": "ManageOne,openapi",
        "x-precautions": "错误码:当请求不成功时,响应体内的错误码信息请参见“ManageOne 运维面API参考 > 错误码说明 > 租户保障特性”章节。\n",
        "x-plane": "Tenant,OM",
        "tags": [
          "租户保障"
        ],
        "operationId": "ModifyAlarmRule",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": false,
            "type": "string",
