            "source_ip": "",
            "resource_name": "",
            "resource_name_cn": "",
            "resource_id": "",
            "trace_name": "",
            "trace_rating": "",
            "trace_result": ""
          },
          {
            "time": "",
            "end_time": "",
            "domain_id": "",
            "domain_name": "",
            "project_id": "",
            "project_name": "",
            "user_id": "",
            "user_name": "",
            "service_type": "",
            "resource_type": "",
            "source_ip": "",
            "resource_name": "",
            "resource_name_cn": "",
            "resource_id": "",
            "trace_name": "",
            "trace_rating": "",
            "trace_result": "",
            "user": "{\"name\":\"bss_admin\",\"id\":\"e81f0f3b4e234d2fbb227b9105cdb8fc\",\"domain\":{\"name\":\"cmdb_domain_test\",\"id\":\"127f0c815a9b4d74a11997561200e55e\"}}",
            "extension_info": "{\"vdc_name\":\"aaaa\",\"azone_name\":\"aaaaa\"}"
          }
        ]
      }
    }
  },
  "definitions": {
    "TenantTraceSaveModel": {
      "description": "请求体对象",
      "properties": {
        "service_type": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "required": true,
          "description": "发送方的简写,比如VPC,ECS等,长度在1-64之间"
        },
        "resource_type": {
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "description": "发送方资源类型,比如vm,vpn等,长度在0-64之间"
        },
        "resource_id": {
          "type": "string",
          "maxLength": 512,
          "minLength": 0,
          "description": "资源id。例如ecs服务中某个虚拟机的id,长度在0-512之间"
        },
        "resource_name": {
          "type": "string",
          "maxLength": 512,
          "minLength": 0,
          "description": "资源名称(英文)。例如ecs服务中某个虚拟机的名称,长度在0-512之间"
        },
        "resource_name_cn": {
          "type": "string",
          "maxLength": 512,
          "minLength": 0,
          "description": "资源名称(中文)。例如ecs服务中某个虚拟机的名称,长度在0-512之间"
        },
        "source_ip": {
          "type": "string",
          "description": "客户端ip。长度在0-128之间",
          "maxLength": 128,
          "minLength": 0
        },
        "trace_name": {
          "type": "string",
          "required": true,
          "maxLength": 128,
          "minLength": 1,
          "description": "事件名称(英文)。比如:startServer, shutDown等,长度在1-128之间"
        },
        "trace_name_cn": {
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "description": "事件名称(中文)。比如:开机, 关机等,长度在0-64之间"
        },
        "trace_rating": {
          "type": "string",
          "required": true,
          "pattern": "^(message|normal|warning|risk|high_risk)$",
          "description": "事件等级,取值为:\n  提示:message\n  一般:normal\n  警告:warning\n  危险:risk\n  高危:high_risk"
        },
        "trace_result": {
          "type": "string",
          "pattern": "^(successed|failed|doing|)$",
          "description": "事件结果,取值为:\n   成功:successed\n   失败:failed\n   处理中:doing"
        },
        "trace_type": {
          "type": "string",
          "pattern": "^(ConsoleAction|ApiCall|SystemAction|)$",
          "description": "事件发生源头类型,取值为:\n  ConsoleAction:标识从Console来的请求,认为是页面操作。\n  ApiCall:标识从外部APIGateway来的请求,认为是开放API调用\n  SystemAction:标示系统内部主动产生的资源变动,非租户请求。比如:AS定时触发调用ECS创建虚拟机。"
        },
        "message": {
          "type": "string",
          "maxLength": 65535,
          "minLength": 0,
          "description": "事件详情(英文)。长度在0-65535之间"
        },
        "trace_message_cn": {
          "type": "string",
          "maxLength": 65535,
          "minLength": 0,
          "description": "事件详情(中文)。长度在0-65535之间"
        },
        "time": {
          "type": "integer",
          "required": true,
          "format": "int64",
          "default": 0,
          "description": "事件操作开始时间的毫秒数,不小于0"
        },
        "end_time": {
          "type": "integer",
          "format": "int64",
          "default": 0,
          "description": "事件操作结束时间的毫秒数,不小于0,不能小于起始时间。"
        },
        "code": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 9999,
          "default": 0,
          "description": "事件状态码。例:200,400。4位以内的正整数。"
        },
        "api_version": {
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "description": "发送方接口的版本。长度在0-64之间,包含字母、数字、中划线、点号、下划线"
        },
        "request": {
          "type": "string",
          "maxLength": 65535,
          "minLength": 0,
          "description": "事件请求内容。长度在0-65535之间,当前设置为空。"
        },
        "response": {
          "type": "string",
          "maxLength": 65535,
          "minLength": 0,
          "description": "事件响应内容。长度在0-65535之间"
        },
        "user": {
          "type": "string",
          "maxLength": 2048,
          "minLength": 0,
          "description": "本次请求发起用户详情。格式为json字符串,其中可包含name,id,domain信息domain信息亦为json字符串包含name和id长度在0-2048之间"
        },
        "service_name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "description": "发送方服务名称,如ECS_01。长度在0-64之间"
        },
        "request_id": {
          "type": "string",
          "maxLength": 2048,
          "minLength": 0,
          "description": "业务请求ID。长度在0-2048之间"
        },
        "invoke_trace_id": {
          "type": "string",
          "maxLength": 2048,
          "minLength": 0,
          "description": "调用链ID。长度在0-2048之间"
        },
        "extension_info": {
          "type": "string",
          "maxLength": 65535,
          "minLength": 0,
          "description": "扩展属性。长度在0-65535之间,格式为json字符串,其中可包含vdc_name与azone_name"
        },
        "log_type": {
          "type": "string",
          "pattern": "^(tenant|secure|system|operation|)$",
          "description": "日志类型(tenant:租户日志,secure:安全日志,system:系统日志,operation操作日志)"
        },
        "location_info": {
          "type": "string",
          "maxLength": 65535,
          "minLength": 0,
          "description": "运维侧的定位信息。长度在0-65535之间"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}