{
  "name": "SaveTenantTrace",
  "summary": "记录操作日志接口",
  "tags": "租户操作日志",
  "productshort": "ManageOneOCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1.0/{projectId}/{trackerName}/trace": {
      "post": {
        "summary": "记录操作日志接口",
        "description": "记录操作日志数据的接口,供其他服务调用,需要验证token\n\n  |SLA项|定义|\n  |-----|-----|\n  |请求成功率| ≥ 99%|\n  |可用性| Tier 2|\n  |数据一致性|最终一致,不一致时长<1 分钟|\n  |吞吐量|34 次/分钟|\n  |TP50请求时延|200 ms|\n  |TP99.9请求时延|2000 ms|",
        "x-filter": "ManageOne,openapi,cloudservice",
        "x-plane": "OM,TENANT",
        "x-precautions": "该接口用于各服务记录本服务产生的操作,以供审计。调用该接口时需要带上token,接口中的时间均为utc时间毫秒数。",
        "x-resource": "记录操作日志接口",
        "x-opseverity": "Minor",
        "tags": [
          "租户操作日志"
        ],
        "operationId": "SaveTenantTrace",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "maxLength": 65535,
            "minLength": 1,
            "description": "IAM token。"
          },
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "description": "projectId 与token中的projectId保持一致,token中没有时管理服务传固定值MO,长度在1-64之间"
          },
          {
            "name": "trackerName",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "trackerName默认值为system,记录OCC日志时,值为occsystem。不对此值进行校验和约束"
          },
          {
            "name": "TenantTraceSaveModelList",
            "in": "body",
            "required": true,
            "description": "请求体对象",
            "x-maxLength": 1000,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TenantTraceSaveModel"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功保存操作日志",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": {
                "traceId": [
                  "0153585544514adaa038d661bb53dd7a",
                  "0153585544514adaa038d661bb53dd7a"
                ]
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "URL鉴权失败"
          },
          "403": {
            "description": "无权限"
          },
          "404": {
            "description": "rest接口未找到"
          },
          "500": {
            "description": "服务器内部错误"
          },
          "503": {
            "description": "服务不可用"
          },
          "504": {
            "description": "表示时间超时。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/v1.0/system/system/trace",
        "x-request-examples-description-1": "",
        "x-request-examples-1": [
          {
            "time": "",
            "end_time": "",
            "domain_id": "",
            "domain_name": "",
            "project_id": "",
            "project_name": "",
            "user_id": "",
            "user_name": "",
