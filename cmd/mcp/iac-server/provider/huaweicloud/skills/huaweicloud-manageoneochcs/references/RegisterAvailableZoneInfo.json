            "description": "IAM_OP、SSO token,IAM的token,必须具有op_service角色。",
            "in": "header",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "注册可用分区信息成功。",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": {
                "description": "success",
                "language": "en_us"
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "Token 鉴权失败。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/rest/system/v1/available-zone/register",
        "x-request-examples-description-1": "",
        "x-request-examples-1": [
          {
            "availableZones": [
              {
                "azId": "test_azId_bai",
                "extendParam": "{\"cloud_location\":\"localcloud\"}",
                "name": "test_name",
                "status": "normal",
                "type": "test_type_az_bai"
              }
            ],
            "cloudInfraId": "testType_us-west-2",
            "regionId": "us-west-2"
          }
        ]
      }
    }
  },
  "definitions": {
    "CloudInfraWithAvailableZone": {
      "description": "可用分区列表",
      "properties": {
        "cloudInfraId": {
          "description": "资源池的nativeId。",
          "type": "string"
        },
        "regionId": {
          "description": "地域的nativeId。",
          "type": "string"
        },
        "availableZones": {
          "type": "array",
          "x-maxLength": 500,
          "description": "可用分区列表",
          "items": {
            "$ref": "#/definitions/AvailableZone"
          }
        }
      }
    },
    "AvailableZone": {
      "properties": {
        "az_id": {
          "description": "可用分区ID,长度范围0~128字符。",
          "type": "string",
          "required": false
        },
        "region_id": {
          "description": "Region ID,长度范围0~32字符。",
          "type": "string",
          "required": false
        },
        "cloud_infra_id": {
          "description": "云资源池id。长度范围0~64字符。",
          "type": "string",
          "required": true
        },
        "name": {
          "description": "可用分区名称,长度范围0~255字符,只能是中文、英文、中划线、下划线及.号组成。",
          "type": "string",
          "required": true
        },
        "type": {
          "description": "可用分区类型:长度范围0~32字符。",
          "type": "string",
          "required": false
        },
        "status": {
          "description": "可用分区状态:normal,正常,abnormal异常。",
          "type": "string",
          "required": false
        },
        "extend_param": {
          "description": "可用分区属性,长度范围0~512字符。",
          "type": "string",
          "required": false
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
