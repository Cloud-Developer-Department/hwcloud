{
  "name": "RegisterAvailableZoneInfo",
  "summary": "对接系统注册可用分区信息",
  "tags": "驱动管理",
  "productshort": "ManageOneOCHCS",
  "region_id": "ap-southeast-3",
  "paths": {
    "/rest/system/v1/available-zone/register": {
      "post": {
        "tags": [
          "驱动管理"
        ],
        "operationId": "RegisterAvailableZoneInfo",
        "summary": "对接系统注册可用分区信息",
        "description": "用于给对接系统注册可用分区信息的接口。",
        "x-filter": "manageone,interservice,openapi,cloudservice",
        "x-plane": "OM",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "cloudInfraWithAvailableZones",
            "description": "可用分区列表",
