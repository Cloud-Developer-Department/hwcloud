          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "description": "实时数据查询结果。object为监控对象标识。",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
