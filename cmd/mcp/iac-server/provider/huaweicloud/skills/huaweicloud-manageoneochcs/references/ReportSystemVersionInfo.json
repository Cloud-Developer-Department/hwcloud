        },
        "product_patch_version": {
          "type": "array",
          "description": "下级网元补丁版本。",
          "maxItems": 1000,
          "items": {
            "type": "string"
          }
        },
        "ipaddress": {
          "type": "string",
          "description": "下级IP地址。"
        }
      }
