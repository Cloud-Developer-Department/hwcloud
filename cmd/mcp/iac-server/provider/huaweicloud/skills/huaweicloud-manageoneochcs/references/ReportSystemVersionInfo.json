      "required": [
        "name",
        "alias",
        "product_name",
        "product_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "下级网元标识。"
        },
        "alias": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "下级网元名称。"
        },
        "product_name": {
          "type": "string",
          "description": "下级网元产品名称。"
        },
        "product_version": {
          "type": "string",
