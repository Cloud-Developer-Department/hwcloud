            "type": "string"
          }
        },
        "ipaddress": {
          "type": "string",
          "description": "IP地址。"
        },
        "sub_system_infos": {
          "type": "array",
          "description": "子系统信息。",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/SubSystemInfo"
          }
        }
      }
    }
