{
  "name": "AddAccessSystem",
  "summary": "备份注册",
  "tags": "统一备份",
  "productshort": "ManageOneOCHCS",
  "region_id": "cn-north-4",
  "paths": {
    "/rest/mounibackupservice/v1/access": {
      "post": {
        "summary": "备份注册",
        "description": "备份注册",
        "tags": [
          "统一备份"
        ],
        "operationId": "AddAccessSystem",
        "x-filter": "ManageOne,openapi",
        "x-plane": "Tenant,OM",
        "x-precautions": "接口请求参数中x-auth-token使用有效token(op_svc_oc_service权限的用户token)。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "IAM_OP token。",
            "minLength": 1,
            "maxLength": 65535
          },
          {
            "name": "AccessSystemInfo",
            "in": "body",
            "description": "备份注册信息",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AccessSystemInfo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "系统注册成功",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": {
                "resultCode": "success"
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          },
          "502": {
            "description": "网关错误。"
          },
          "503": {
            "description": "服务不可用。"
          },
          "504": {
            "description": "表示时间超时,总线超时时间300s。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/rest/mounibackupservice/v1/access",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "region": "华北",
          "systemType": "CCE",
          "ip": "xxx.xxx.xxx.xxx",
          "port": "443",
          "backupType": [
            "full"
          ],
          "tranProtocal": [
            "SFTP"
          ],
          "actionJson": {
            "taskstatus": "/api/v3/etcdbackup/tasks",
            "bkserver": "/api/v3/etcdbackup/backup_server",
            "backupaction": "/api/v3/etcdbackup/tasks",
            "connection": "/api/v3/etcdbackup/health_check"
          }
        }
      }
    }
  },
  "definitions": {
    "BackupActionInfo": {
      "description": "备份操作信息",
      "properties": {
        "subsystem": {
          "description": "查询子系统url",
          "type": "string"
        },
        "taskstatus": {
          "description": "查询任务状态url",
          "type": "string"
        },
        "bkserver": {
          "description": "备份服务器操作url",
          "type": "string"
        },
        "backupaction": {
          "description": "下发备份任务url",
          "type": "string"
        },
        "backuppolicy": {
          "description": "备份策略操作url",
          "type": "string"
        },
        "connection": {
          "description": "检验联通性url",
          "type": "string"
        }
      }
    },
    "AccessSystemInfo": {
      "description": "接入系统注册信息",
      "properties": {
        "region": {
          "description": "区域名称",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "regionId": {
          "description": "区域id",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "systemType": {
          "description": "接入系统名称",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "ip": {
          "description": "接入系统访问IP地址",
          "type": "string"
        },
        "port": {
          "description": "接入系统访问端口号",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "backupType": {
          "description": "支持的备份类型,[\"full\",\"increment\"]",
          "type": "array",
          "x-maxLength": 1000,
          "items": {
            "type": "string"
          }
        },
        "tranProtocal": {
          "description": "支持的传输协议,[\"SFTP\"]",
          "type": "array",
          "x-maxLength": 1000,
          "items": {
            "type": "string"
          }
        },
        "actionJson": {
          "description": "接入系统注册的url信息",
          "$ref": "#/definitions/BackupActionInfo"
        }
      },
      "required": [
        "region",
        "systemType",
        "ip",
        "port",
        "backupType",
        "tranProtocal",
        "actionJson"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}