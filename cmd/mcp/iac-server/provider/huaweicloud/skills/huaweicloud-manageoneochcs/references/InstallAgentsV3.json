  "definitions": {
    "InstallAgentRequestV3": {
      "description": "批量安装agent请求体V3。",
      "properties": {
        "targets": {
          "description": "待安装agent的目标设备列表。",
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/InstallAgentTargetV3"
          }
        }
      },
      "required": [
        "targets"
      ]
    },
    "InstallAgentCredentialV3": {
      "description": "设备安装凭据。",
      "properties": {
        "protocol": {
          "description": "安全协议。可取值为:\n* SSH2 (SSH连接协议)\n* CredSSP (WinRM连接协议)\n* Negotiate (WinRM连接协议)",
          "type": "string"
        },
        "ip": {
          "description": "连接到主机使用的IP地址,多IP用\";\"分割,优先使用mgmtIp。",
          "type": "string"
        },
        "port": {
          "description": "连接到主机使用的端口。",
          "type": "integer",
          "format": "int16"
        },
        "loginUser": {
          "description": "登录账号,使用SSH2协议时此字段必填。",
          "type": "string"
        },
        "loginPwd": {
          "description": "登录密码,使用SSH2协议时此字段必填。",
          "type": "string"
        },
        "rootPwd": {
          "description": "root账户密码,使用SSH2协议时此字段必填。",
          "type": "string"
        },
        "adminUser": {
          "description": "管理员账号,使用WinRM协议时此字段必填。",
          "type": "string"
        },
        "adminPwd": {
          "description": "管理员密码,使用WinRM协议时此字段必填。",
          "type": "string"
        },
        "suCommand": {
          "description": "切root用户的命令,使用SSH2协议时此字段必填,可选值:\n* auto (自动配置)\n* su - root\n* sudo su - root",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "ip",
        "port"
      ]
    },
    "InstallAgentTargetV3": {
      "description": "待安装agent的目标设备",
      "properties": {
        "credential": {
          "description": "登录主机使用的凭据。",
          "$ref": "#/definitions/InstallAgentCredentialV3"
        },
        "useSystemPython": {
          "description": "是否使用系统默认python。",
          "type": "boolean"
        },
        "id": {
          "description": "设备的resId。",
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "useSystemPython",
        "credential"
      ]
    },
    "RestResponseV3": {
      "description": "通用结果返回体V3。",
      "properties": {
        "id": {
          "description": "id",
          "type": "string",
          "maxLength": 128
        },
        "success": {
          "description": "是否成功",
          "type": "boolean"
        },
        "message": {
          "description": "失败的原因",
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "id",
        "success"
      ]
    },
    "InstallAgentResponseV3": {
      "description": "批量安装agent返回体V3。",
      "properties": {
        "targets": {
          "description": "安装agent的目标设备返回消息列表。",
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/RestResponseV3"
          }
        }
      },
      "required": [
        "targets"
      ]
    }
