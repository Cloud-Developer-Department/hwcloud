{
  "name": "ShowDefinitionList",
  "summary": "查询告警定义列表",
  "tags": "告警管理",
  "productshort": "ManageOneOCHCS",
  "region_id": "cn-north-4",
  "paths": {
    "/rest/fault/v1/alarm-definitions/list": {
      "post": {
        "summary": "查询告警定义列表",
        "description": "查询告警的定义信息列表。\n\n|SLA项|定义|\n|-----|-----|\n|请求成功率| >=99%|\n|可用性|Tier1|\n|数据一致性|最终一致,不一致时长<1分钟|\n|吞吐量(tiny2)|5tps|\n|吞吐量(small)|5tps|\n|吞吐量(medium)|5tps|\n|吞吐量(large)|5tps|\n|TP50请求时延|150ms|\n|TP99.9请求时延|1000ms|",
        "x-precautions": "此接口必须在HTTPS通道上访问。",
        "tags": [
          "告警管理"
        ],
        "operationId": "ShowDefinitionList",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "queryParam",
            "in": "body",
            "description": "告警定义信息查询参数。",
            "schema": {
              "$ref": "#/definitions/DefinitionQueryParam"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "告警定义列表。",
            "examples": {
              "application/json": {
                "totalCount": 5346,
                "offset": 0,
                "limit": 2,
                "definitions": [
                  {
                    "alarmId": "1100230",
                    "originSystemType": "XXX",
                    "alarmGroupId": "100000",
                    "category": 1,
                    "eventType": 2,
                    "alarmName": "VER_MISMATCH",
                    "description": "VER_MISMATCH",
                    "severity": 1
                  },
                  {
                    "alarmId": "3068078",
                    "originSystemType": "XXX",
                    "alarmGroupId": "100000",
                    "category": 1,
                    "eventType": 2,
                    "alarmName": "FAN_FAULT",
                    "description": "FAN_FAULT",
                    "severity": 3
                  }
                ]
              }
            }
          },
          "400": {
            "description": "参数非法。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/rest/fault/v1/alarm-definitions/list",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "originSystemTypes": [
            "XXX"
          ],
          "alarmGroupIds": [
            "100000"
