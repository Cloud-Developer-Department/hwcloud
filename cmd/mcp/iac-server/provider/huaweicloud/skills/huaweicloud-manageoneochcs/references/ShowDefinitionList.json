        "alarmGroupId": {
          "description": "告警分组标识。各领域使用的分组标识,应遵循SingleEMS集成规范。(注意:该字段为必填,出于兼容性考虑,如果上报者没有填写,告警服务使用originSystemType补填。)",
          "type": "string",
          "x-blackList": {
            "blackChars": ";?#%/\\\\<>"
          },
          "x-sqlInjection": null,
          "maxLength": 64,
          "x-groups": [
            "DeleteAction.class"
          ]
        },
        "alarmId": {
          "description": "告警标识。(该字段业务上为必填。)",
          "type": "string",
          "x-blackList": {
            "blackChars": ";?#%/\\\\<>"
          },
          "x-sqlInjection": null,
          "minLength": 1,
          "maxLength": 128,
          "x-groups": [
