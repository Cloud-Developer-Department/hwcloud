{
  "name": "ShowCloudInfra",
  "summary": "查询云资源池详情信息",
  "tags": "驱动管理",
  "productshort": "ManageOneOCHCS",
  "region_id": "cn-north-4",
  "paths": {
    "/rest/serviceaccess/v3.0/cloud-infras/{cloud_infra_id}": {
      "get": {
        "x-filter": "ManageOne,openapi,interservice,erservice,cloudservice",
        "x-plane": "Tenant",
        "summary": "查询云资源池详情信息",
        "description": "查询云资源池详情信息,包括:版本号,是否支持安全组,同一网络是否支持多网卡,资源池属性配置信息。",
        "tags": [
          "驱动管理"
        ],
        "operationId": "ShowCloudInfra",
        "x-resource": "资源池",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "cloud_infra_id",
            "in": "path",
            "description": "云资源池ID,长度范围0~64字符。",
            "required": true,
            "type": "string"
          },
          {
            "name": "access_status",
            "in": "query",
            "description": "云资源池接入状态,有以下四种状态,init,connected,deprecated,deleted;取值为init时,为第一次接入查询,第一次接入需要从FusionSphere OpenStack进行查询。",
            "type": "string",
            "required": false
          },
          {
            "name": "is_query_switch",
            "in": "query",
            "description": "是否查询资源池属性",
            "type": "boolean",
            "required": false
          },
          {
            "name": "x-auth-token",
            "description": "IAM token。IAM的token,必须具有mo_bss_adm,vdc_adm,vdc_user,res_adm和vdc_readonly中任意角色。",
            "in": "header",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询云资源池详情信息成功。",
            "schema": {
              "$ref": "#/definitions/CloudInfra"
            },
            "examples": {
              "application/json": {
                "id": "NFVI_xian-alpha-2",
                "name": "NFVI_xian-alpha-2",
                "type": "NFVI",
                "version": "V100R006C10",
                "status": "normal",
                "description": null,
                "region_name": "xian-alpha-2",
                "region_id": "xian-alpha-2",
                "region_locales": "{\"zh_cn\":\"alpha-2\",\"en_us\":\"xian-alpha-2\"}",
                "create_time": "2018-02-03 03:49:07",
                "access_status": "connected",
                "cloud_infra_attrs": {
                  "records": [
                    {
                      "key": "router",
                      "value": "True",
                      "cloudInfraId": "NFVI_xian-alpha-2"
                    },
                    {
                      "key": "snat",
                      "value": "True",
                      "cloudInfraId": "NFVI_xian-alpha-2"
                    },
                    {
                      "key": "allowDuplicateNetworks",
                      "value": "False",
                      "cloudInfraId": "NFVI_xian-alpha-2"
                    }
                  ]
                },
                "available_zones": null
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "Token 鉴权失败。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "默认ServiceException异常码,应用内部错误。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "GET https://{endpoint}/rest/serviceaccess/v3.0/cloud-infras/cn-global-1",
        "x-request-examples-description-1": "",
        "x-request-examples-1": ""
      }
    }
  },
