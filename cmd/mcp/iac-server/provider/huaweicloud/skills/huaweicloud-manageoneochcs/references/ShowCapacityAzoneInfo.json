                      "unit": "MB",
                      "capacityValue": "55639",
                      "displayCapacity": "54.33 GB"
                    },
                    "usedCapacity": {
                      "ratio": 0
                    },
                    "freeCapacity": {
                      "ratio": 100
                    }
                  },
                  "collectTime": "2016-11-15 22:06:29 CST"
                },
                "storagePool": null,
                "eip": null,
                "bms": {
                  "cpu": {
                    "actualCapacity": {
                      "freeCapacity": {
                        "capacityValue": "28057",
                        "displayCapacity": "28057 cores",
                        "ratio": 50.43,
                        "unit": "cores"
                      },
                      "totalCapacity": {
                        "capacityValue": "55639",
                        "displayCapacity": "28057 cores",
                        "unit": "cores"
                      },
                      "usedCapacity": {
                        "capacityValue": "27582",
                        "displayCapacity": "28057 cores",
                        "ratio": 49.57,
                        "unit": "cores"
                      }
                    },
                    "collectTime": "2018-05-17 20:23:22 455",
                    "isDataEmpty": "false",
                    "updateTime": 1526559802455
                  },
                  "memory": {
                    "actualCapacity": {
                      "freeCapacity": {
                        "capacityValue": "28057",
                        "displayCapacity": "27.4 GB",
                        "ratio": 50.43,
                        "unit": "MB"
                      },
                      "totalCapacity": {
                        "capacityValue": "55639",
                        "displayCapacity": "54.33 GB",
                        "unit": "MB"
                      },
                      "usedCapacity": {
                        "capacityValue": "27582",
                        "displayCapacity": "26.94 GB",
                        "ratio": 49.57,
                        "unit": "MB"
                      }
                    },
                    "collectTime": "2018-05-17 20:23:22 455",
                    "isDataEmpty": "false",
