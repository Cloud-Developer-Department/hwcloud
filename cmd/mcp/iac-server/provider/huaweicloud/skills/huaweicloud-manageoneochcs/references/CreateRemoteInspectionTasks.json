{
  "name": "CreateRemoteInspectionTasks",
  "summary": "创建远程巡检任务",
  "tags": "系统维护",
  "productshort": "ManageOneOCHCS",
  "region_id": "cn-north-4",
  "paths": {
    "/oc/fusioncare/v1/tasks": {
      "post": {
        "summary": "创建远程巡检任务",
        "description": "创建远程巡检任务\n\n  |SLA项|定义|\n  |-----|-----|\n  |请求成功率| ≥99%|\n  |可用性|Tier 1|\n  |数据一致性|最终一致,不一致时长<1min|\n  |吞吐量|150 次/分钟|\n  |TP50请求时延|500 ms|\n  |TP99.9请求时延|1000 ms|",
        "x-resource": "信息收集管理",
        "tags": [
          "系统维护"
        ],
        "operationId": "CreateRemoteInspectionTasks",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "x-filter": "cloudvpn,clouddc,oc,openapi,cloudservice",
        "x-plane": "OM",
        "x-opseverity": "Minor",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "type": "string",
            "maxLength": 65535,
            "minLength": 1,
            "description": "IAM token、SSO token, 使用IAM token用户必须为care_admin。"
          },
          {
            "name": "remoteInspectionTasks",
            "in": "body",
            "description": "远程巡检任务信息",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RemoteInspectTask"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "返回远程巡检任务创建结果。",
            "schema": {
              "$ref": "#/definitions/ResultInfo"
            },
            "examples": {
              "application/json": {
                "data": "F68B65CF79A7397080DEFA90FCC2336C",
                "message": "success",
                "resultCode": "00000000"
              }
            }
          },
          "400": {
            "description": "参数错误。"
          },
          "401": {
            "description": "token错误或者缺失。"
          },
          "403": {
            "description": "URL鉴权失败。"
          },
          "404": {
            "description": "rest接口未找到。"
          },
          "500": {
            "description": "系统内部异常。"
          },
          "502": {
            "description": "网关错误。"
          },
          "503": {
            "description": "服务不可用。"
          },
          "504": {
            "description": "表示时间超时,总线超时时间300s。"
          },
          "888": {
            "description": "服务摘机,不提供服务。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "POST https://{endpoint}/oc/fusioncare/v1/tasks",
        "x-request-examples-description-1": "",
        "x-request-examples-1": {
          "deviceId": "57635ea8-bcf2-43c6-bed0-bb10c4984bde",
          "items": "{\"11013\":\"inspect_remote.py 11013\",\"10004\":\"inspect.sh -c 10004\"}",
          "method": "python",
          "serviceName": "AOM"
        }
      }
    }
  },
  "definitions": {
    "ResultInfo": {
      "required": [
        "resultCode",
        "data",
        "message"
      ],
      "description": "响应结果",
      "properties": {
        "resultCode": {
          "description": "响应码",
          "type": "string"
        },
        "data": {
          "description": "响应内容,值为执行结果或任务ID,参考响应示例。",
          "type": "string"
        },
        "message": {
          "description": "响应消息",
          "type": "string"
        }
      }
    },
    "RemoteInspectTask": {
      "required": [
        "items",
        "deviceId",
        "method",
        "serviceName"
      ],
      "description": "远程巡检任务信息",
      "properties": {
        "items": {
          "description": "巡检项集合,值为json格式字符串,key为巡检项ID从FusionCare创建任务中获取,value为巡检脚本命令从FusionCare巡检包中获取巡检项对应的remoteCmd字段,例如:{\\\"1103\\\":\\\"preinspect_remote.sh\\\",\\\"1104\\\":\\\"preinspect_remote.sh\\\"}。",
          "type": "string",
          "maxLength": 65535,
          "minLength": 1
        },
        "deviceId": {
          "description": "设备ID,获取参考“自动化运维”章节中“查询资源设备列表”接口,接口url为“/rest/moautoops/v1/resource-types/{resourceType}/devices”,具体值为响应示例中“devices” 中“id”。",
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "method": {
          "description": "脚本执行方式有2种:\n* python\n* shell",
          "type": "string",
          "pattern": "^(python|shell)$"
        },
        "serviceName": {
          "description": "服务名称,从FusionCare系统管理中的巡检包管理获取,具体值为“分类”列。",
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "version": {
          "description": "版本信息",
          "type": "string",
          "maxLength": 32,
          "minLength": 12
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}