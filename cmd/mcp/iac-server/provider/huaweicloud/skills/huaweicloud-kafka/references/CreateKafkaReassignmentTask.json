  "definitions": {
    "PartitionReassignRequest": {
      "type": "object",
      "required": [
        "reassignments"
      ],
      "properties": {
        "reassignments": {
          "items": {
            "$ref": "#/definitions/PartitionReassignEntity"
          },
          "description": "分区平衡分配方案。",
          "type": "array"
        },
        "throttle": {
          "type": "integer",
          "format": "int32",
          "example": 10000000,
          "description": "分区平衡门限值。"
        },
        "is_schedule": {
          "type": "boolean",
          "description": "**参数解释**:\n是否作为定时任务执行。若非定时执行,is_schedule和execute_at字段可为空。若为定时执行,is_schedule为true,execute_at字段非空。\n**约束限制**:\n不涉及。"
        },
        "execute_at": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**:\n定时时间,格式为Unix时间戳,单位为毫秒\n**约束限制**:\n不涉及。"
        },
        "time_estimate": {
          "type": "boolean",
          "example": true,
          "default": false,
          "description": "**参数解释**:\n设为true表示执行时间预估任务,false为执行分区平衡任务。\n**约束限制**:\n不涉及。"
        }
      }
    },
    "PartitionReassignmentResp": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID(当执行分区平衡任务时仅返回job_id)。"
        },
        "reassignment_time": {
          "type": "integer",
          "description": "预估时间,单位为秒(当执行预估时间任务时仅返回reassignment_time)。"
        }
      }
    },
    "PartitionReassignEntity": {
      "type": "object",
      "required": [
        "topic"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "example": "topic-1513476102",
          "description": "Topic名称"
        },
        "brokers": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "example": [
            0,
            1,
            2
          ],
          "description": "分区平衡到的broker列表,自动生成分配方案时需指定该参数。"
        },
        "replication_factor": {
          "type": "integer",
          "format": "int32",
          "example": 3,
          "description": "副本因子,自动生成分配方案时可指定。"
        },
        "assignment": {
          "type": "array",
          "description": "手动指定的分配方案。brokers参数与该参数不能同时为空。",
          "items": {
            "$ref": "#/definitions/TopicAssignment"
          }
        }
      }
    },
    "TopicAssignment": {
      "type": "object",
      "properties": {
        "partition": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "手动指定分配方案时的分区号。"
        },
        "partition_brokers": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "example": [
            0,
            1,
            2
          ],
          "description": "手动指定某个分区将要分配的broker列表"
        }
      }
    }
  },
