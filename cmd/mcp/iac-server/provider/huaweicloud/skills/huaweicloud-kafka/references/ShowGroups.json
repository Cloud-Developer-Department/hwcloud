  "definitions": {
    "ShowGroupsResp": {
      "type": "object",
      "properties": {
        "group": {
          "type": "object",
          "description": "**参数解释**:\n消费组信息。",
          "properties": {
            "group_id": {
              "type": "string",
              "description": "**参数解释**:\n消费组名称。\n**取值范围**:\n不涉及。"
            },
            "state": {
              "type": "string",
              "description": "**参数解释**:\n消费组状态。\n**取值范围**:\n- Dead:消费组内没有任何成员,且没有任何元数据。\n- Empty:消费组内没有任何成员,存在元数据。\n- PreparingRebalance:准备开启rebalance。\n- CompletingRebalance:所有成员加入group。\n- Stable:消费组内成员可正常消费。"
            },
            "coordinator_id": {
              "type": "integer",
              "description": "**参数解释**:\n协调器编号。\n**取值范围**:\n不涉及。"
            },
            "members": {
              "type": "array",
              "description": "**参数解释**:\n消费者列表。",
              "items": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string",
                    "description": "**参数解释**:\n消费组consumer地址。\n**取值范围**:\n不涉及。"
                  },
                  "assignment": {
                    "type": "array",
                    "description": "**参数解释**:\nconsumer分配到的分区信息。",
                    "items": {
                      "type": "object",
                      "properties": {
                        "topic": {
                          "type": "string",
                          "description": "**参数解释**:\nTopic名称。\n**取值范围**:\n不涉及。"
                        },
                        "partitions": {
                          "type": "array",
                          "description": "**参数解释**:\n分区列表。",
                          "items": {
                            "type": "integer",
                            "format": "int32",
                            "description": "**参数解释**:\n分区。\n**取值范围**:\n不涉及。"
                          }
                        }
                      }
                    }
                  },
                  "member_id": {
                    "type": "string",
                    "description": "**参数解释**:\n消费组consumer的ID。\n**取值范围**:\n不涉及。"
                  },
                  "client_id": {
                    "type": "string",
                    "description": "**参数解释**:\n客户端ID。\n**取值范围**:\n不涉及。"
                  }
                }
              }
            },
            "group_message_offsets": {
              "type": "array",
              "description": "**参数解释**:\n消费进度。",
              "items": {
                "type": "object",
                "properties": {
                  "partition": {
                    "type": "integer",
                    "description": "**参数解释**:\n分区编号。\n**取值范围**:\n不涉及。"
                  },
                  "lag": {
                    "type": "integer",
                    "format": "int64",
                    "description": "**参数解释**:\n剩余可消费消息数,即消息堆积数。\n**取值范围**:\n不涉及。"
                  },
                  "topic": {
                    "type": "string",
                    "description": "**参数解释**:\nTopic名称。\n**取值范围**:\n不涉及。"
                  },
                  "message_current_offset": {
                    "type": "integer",
                    "format": "int64",
                    "description": "**参数解释**:\n当前消费进度。\n**取值范围**:\n不涉及。"
                  },
                  "message_log_end_offset": {
                    "type": "integer",
                    "format": "int64",
                    "description": "**参数解释**:\n最大消息位置(LEO)。\n**取值范围**:\n不涉及。"
                  }
                }
              }
            },
            "assignment_strategy": {
              "type": "string",
              "description": "**参数解释**:\n分区分配策略。\n**取值范围**:\n不涉及。"
            }
          }
        }
      }
    }
