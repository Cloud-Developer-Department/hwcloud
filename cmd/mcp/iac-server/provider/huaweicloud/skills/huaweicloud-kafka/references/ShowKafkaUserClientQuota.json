  "definitions": {
    "QuotaResp": {
      "type": "object",
      "description": "用户/客户端流控配置",
      "properties": {
        "user": {
          "type": "string",
          "description": "用户名。\n\n不对全部用户/客户端限流时,用户名和客户端ID不能同时为空。"
        },
        "client": {
          "type": "string",
          "description": "客户端ID。\n\n不对全部用户/客户端限流时,用户名和客户端ID不能同时为空。"
        },
        "user-default": {
          "type": "boolean",
          "description": "是否使用用户默认设置。\n  - 是:表示对全部用户限流。此时不能同时设置用户名。\n  - 否:表示对特定用户限流。此时需要设置用户名。"
        },
        "client-default": {
          "type": "boolean",
          "description": "是否使用客户端默认设置。\n  - 是:表示对全部客户端限流。此时不能设置客户端ID。\n  - 否:表示对特定客户端限流。此时需要设置客户端ID。"
        },
        "producer-byte-rate": {
          "type": "integer",
          "format": "int64",
          "description": "生产上限速率(单位为B/s)。"
        },
        "consumer-byte-rate": {
          "type": "integer",
          "format": "int64",
          "description": "消费上限速率(单位为B/s)。\n\n> “生产上限速率”和“消费上限速率”不可同时为空。"
        }
      }
    },
    "GetKafkaUserClientQuotaResp": {
      "type": "object",
      "properties": {
        "quotas": {
          "type": "array",
          "description": "客户端流控配置列表。",
          "items": {
            "$ref": "#/definitions/QuotaResp"
          }
        },
        "count": {
          "type": "integer",
          "description": "用户/客户端流控配置数目。"
        }
      }
    }
