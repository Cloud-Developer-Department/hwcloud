  "definitions": {
    "PlainSslEnableRequest": {
      "type": "object",
      "description": "修改Kafka实例的接入方式。",
      "properties": {
        "protocol": {
          "description": "需要开启或者关闭的接入方式。",
          "type": "string",
          "enum": [
            "private_plain_enable",
            "private_sasl_ssl_enable",
            "private_sasl_plaintext_enable",
            "public_plain_enable",
            "public_sasl_ssl_enable",
            "public_sasl_plaintext_enable"
          ]
        },
        "enable": {
          "type": "boolean",
          "description": "- true:开启指定的接入方式。\n- false:关闭指定的接入方式。"
        },
        "user_name": {
          "type": "string",
          "description": "首次开启SASL时,需要输入用户名。\n实例创建后,关闭SASL并不会删除已经创建的用户,再次开启SASL时无需传入用户名,传入的用户名将无效。"
        },
        "pass_word": {
          "type": "string",
          "description": "首次开启SASL时,需要输入用户名的密码。"
        },
        "sasl_enabled_mechanisms": {
          "description": "开启SASL后使用的认证机制。仅在第一次开启SASL时传入生效。生效后再次传入无效。\n- PLAIN:简单的用户名密码校验。\n- SCRAM-SHA-512:用户凭证校验,安全性比PLAIN机制更高。",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "SCRAM-SHA-512",
              "PLAIN"
            ]
          }
        }
      },
      "example": {
        "protocol": "private_sasl_ssl_enable",
        "enable": true,
        "user_name": "root",
        "pass_word": "password",
        "sasl_enabled_mechanisms": [
          "SCRAM-SHA-512",
          "PLAIN"
        ]
      },
      "required": [
        "protocol",
        "enable"
      ]
    },
    "PlainSslEnableResponse": {
      "type": "object",
      "properties": {
        "job_id": {
          "description": "后台任务id。",
          "type": "string"
        },
        "protocol": {
          "description": "开启或者关闭的Kafka接入方式。",
          "type": "string",
          "enum": [
            "private_plain_enable",
            "private_sasl_ssl_enable",
            "private_sasl_plaintext_enable",
            "public_plain_enable",
            "public_sasl_ssl_enable",
            "public_sasl_plaintext_enable"
          ]
        },
        "enable": {
          "description": "开启动作或者关闭动作。",
          "type": "boolean"
        }
      },
      "example": {
        "job_id": "8abfa7b38fdbdf79018fdd6340c437e6",
        "protocol": "private_sasl_ssl_enable",
        "enable": true
      }
    }
  },
