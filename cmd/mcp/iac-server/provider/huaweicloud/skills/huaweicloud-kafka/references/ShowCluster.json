                    "type": "string",
                    "description": "**参数解释**:\n节点IP。\n**取值范围**:\n不涉及。"
                  },
                  "port": {
                    "type": "integer",
                    "description": "**参数解释**:\n端口号。\n**取值范围**:\n不涉及。"
                  },
