                    "type": "string",
                    "description": "**参数解释**:\n节点ID。\n**取值范围**:\n不涉及。"
                  },
                  "is_controller": {
                    "type": "boolean",
                    "description": "**参数解释**:\n是否为controller节点。\n**取值范围**:\n- true:是controller节点。\n- false:不是controller节点。"
                  },
                  "version": {
                    "type": "string",
                    "description": "**参数解释**:\n服务端版本。\n**取值范围**:\n- 1.1.0\n\n- 2.7\n- 3.x"
                  },
                  "register_time": {
                    "type": "integer",
                    "format": "int64",
                    "description": "**参数解释**:\nbroker注册时间,为unix时间戳格式。\n**取值范围**:\n不涉及。"
                  },
                  "is_health": {
                    "type": "boolean",
                    "description": "**参数解释**:\nKafka实例节点的连通性是否正常。\n**取值范围**:\n- true:正常。\n- false:不正常。"
                  }
                }
              }
            },
            "topics_count": {
              "type": "integer",
              "description": "**参数解释**:\n主题数量。\n**取值范围**:\n不涉及。"
            },
            "partitions_count": {
              "type": "integer",
              "description": "**参数解释**:\n分区数量。\n**取值范围**:\n不涉及。"
            },
