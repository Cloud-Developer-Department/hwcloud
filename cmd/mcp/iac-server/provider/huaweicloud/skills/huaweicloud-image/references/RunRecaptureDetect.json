  "region_id": "cn-north-1",
  "paths": {
    "/v2/{project_id}/image/recapture-detect": {
      "post": {
        "tags": [
          "翻拍识别"
        ],
        "summary": "翻拍识别",
        "description": "零售行业通常根据零售店的销售量进行销售奖励,拍摄售出商品的条形码上传后台是常用的统计方式。翻拍识别利用深度神经网络算法判断条形码图片为原始拍摄,还是经过二次翻拍、打印翻拍等手法二次处理的图片。利用翻拍识别,可以检测出经过二次处理的不合规范图片,使得统计数据更准确、有效。。",
        "operationId": "RunRecaptureDetect",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "用户的project_id\n\n登陆华为云 -> 用户中心 -> 我的凭证 -> api凭证 即可查看对应区域的项目ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "x-order": 1
          },
          {
            "name": "RunRecaptureDetectRequestBody",
            "in": "body",
            "description": "This is a auto create Body Object",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RecaptureDetectReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应结果",
            "examples": {
              "application/json": {
                "result": {
                  "suggestion": "false",
                  "category": "recapture",
                  "score": "0.9998",
                  "detail": [
                    {
                      "label": "recapture",
                      "confidence": "0.9998"
                    }
                  ]
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/RecaptureDetectResponse"
            }
          },
          "400": {
            "description": "失败响应结果",
            "examples": {
              "application/json": {
                "error_code": "AIS.0105",
                "error_msg": "Recognize Failed"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          }
        },
        "x-order": 1,
        "x-request-examples-description-1": "方式一:使用图片的BASE64编码",
        "x-request-examples-url-1": "POST https://{endpoint}/v2/{project_id}/image/recapture-detect",
        "x-request-examples-1": {
          "image": "/9j/4AAQSkZJRgABAgEASABIAAD/4RFZRXhpZgAATU0AKgAAAAgABwESAAMAAAABAAEAAAEaAAUAAAABAAAAYgEbAA...",
          "url": "",
          "threshold": ""
        },
        "x-request-examples-description-2": "方式二:使用图片URL",
        "x-request-examples-url-2": "POST https://{endpoint}/v2/{project_id}/image/recapture-detect",
        "x-request-examples-2": {
          "image": "",
          "url": "https://BucketName.obs.myhuaweicloud.com/ObjectName",
          "threshold": 0.99
        },
        "x-apigateway-request-type": "public"
      }
    }
  },
  "definitions": {
    "RecaptureDetectReq": {
      "properties": {
        "image": {
          "type": "string",
          "example": "/9j/4AAQSkZJRgABAgEASABIAAD/4RFZRXhpZgAATU0AKgAAAAgABwESAAMAAAABAAEAAAEaAAUAAAABAAAAYgEbAA...\n",
          "description": "与url二选一\n\n图像数据,base64编码,要求base64编码后大小不超过10MB,最短边至少15px,最长边最大4096px,支持JPG、PNG、BMP格式。"
        },
        "url": {
          "type": "string",
          "example": "",
          "description": "与image二选一\n\n图片的URL路径,目前支持:\n\n- 公网HTTP/HTTPS URL\n\n- 华为云OBS提供的URL,使用OBS数据需要进行授权。包括对服务授权、临时授权、匿名公开授权。详请参见[配置OBS服务的访问权限](https://support.huaweicloud.com/api-image/image_03_0037.html)。\n\n> - 接口响应时间依赖于图片的下载时间,如果图片下载时间过长,会返回接口调用失败。\n> - 请保证被检测图片所在的存储服务稳定可靠,建议您使用华为云OBS存储。"
        },
        "threshold": {
          "type": "number",
          "format": "float",
          "minimum": 0,
          "maximum": 100,
          "default": 0,
          "description": "判断图片真实或虚假的阈值,默认值为0.95,取值范围(0~1),输入非该范围内值算法即取默认值。"
        }
      }
    },
    "CommonErrorResponse": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "调用失败时的错误码,具体请参见错误码。\n\n调用成功时无此字段。",
          "example": "AIS.0005"
        },
        "error_msg": {
          "type": "string",
          "description": "调用失败时的错误信息。\n\n调用成功时无此字段。",
          "example": "The service does not exist."
        }
      },
      "description": ""
    },
    "RecaptureDetectResponse": {
      "properties": {
        "result": {
          "type": "object",
          "description": "调用成功时为图片标签内容。调用失败时无此字段。",
          "properties": {
            "suggestion": {
              "type": "string",
              "description": "总体的结论:\ntrue:真实\nfalse:虚假\nuncertainty:不确定"
            },
            "category": {
              "type": "string",
              "description": "标签(如果suggestion为真时,则该值为空字符串,否则不为空)。recapture:翻拍图"
            },
            "score": {
              "type": "string",
              "description": "总体置信度,取值范围(0~1)。"
            },
            "detail": {
              "type": "array",
              "description": "识别结果详情。",
              "items": {
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "标签值。| original:原始图 recapture:翻拍图"
                  },
                  "confidence": {
                    "type": "string",
                    "description": "置信度,取值范围(0~1)。"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "image.cn-north-1.myhuaweicloud.com",
  "base_path": "/",
