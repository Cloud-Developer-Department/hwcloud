{
  "name": "ListIsapComponents",
  "summary": "列出组件",
  "tags": "组件管理",
  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces/{workspace_id}/components": {
      "get": {
        "tags": [
          "组件管理"
        ],
        "summary": "列出组件",
        "description": "列出组件",
        "operationId": "ListIsapComponents",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。[获取用户Token](secmaster_03_0010.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 32,
            "x-example": "156*******************341da6"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "工作空间ID",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "x-example": "458********************e64c3"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "examples": {
              "application/json": {
                "count": 1,
                "records": [
                  {
                    "component_id": "160363xxx1444",
                    "component_name": "logstash",
                    "create_time": 1671171503419,
                    "description": "Logstash is an engine.",
                    "history_version": "",
                    "maintainer": "sys",
                    "time_zone": "",
                    "update_time": 1671171503419,
                    "upgrade": "NEED_UPGRADE",
                    "upgrade_fail_message": "",
                    "version": "1.0.0"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListComponentsResponseBody"
            }
          },
          "400": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/IsapErrorRsp"
            }
          }
        },
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-surpport-hcs": "Y",
        "x-surpport-apiexplorer": "true",
        "x-api-service-plane": "Control-plane",
        "x-sec-data-level": "L1"
      }
    }
  },
  "definitions": {
    "IsapErrorRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误对象"
    },
    "ComponentId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 36,
      "description": "组件id.",
      "example": "00000000-0000-0000-0000-000000000000"
    },
    "IsapTimeStamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775800,
      "format": "int64",
      "description": "毫秒时间戳",
      "example": 0
    },
    "ComponentDetailInfo": {
      "type": "object",
      "properties": {
        "component_id": {
          "$ref": "#/definitions/ComponentId"
        },
        "component_name": {
          "$ref": "#/definitions/ComponentName"
        },
        "create_time": {
          "$ref": "#/definitions/IsapTimeStamp"
        },
        "description": {
          "type": "string",
          "description": "相关描述",
          "minLength": 1,
          "maxLength": 256
        },
        "history_version": {
          "type": "string",
          "example": "23.9.0",
          "description": "历史版本",
          "minLength": 32,
          "maxLength": 64
        },
        "maintainer": {
          "type": "string",
          "example": "isap",
          "description": "保持",
          "minLength": 1,
          "maxLength": 1024
        },
        "time_zone": {
          "type": "string",
          "description": "时区",
          "minLength": 3,
          "maxLength": 40
        },
        "update_time": {
          "$ref": "#/definitions/IsapTimeStamp"
        },
        "upgrade": {
          "type": "string",
          "example": "UPGRADING",
          "description": "**参数解释**:\n升级\n- NEED_UPGRADE 需要升级\n- UPGRADING 升级中\n- SUCCESS_UPGRADE 升级成功\n- FAIL_UPGRADE 升级失败\n\n**约束限制**\n不涉及\n**取值范围**:\n- NEED_UPGRADE\n- UPGRADING\n- SUCCESS_UPGRADE\n- FAIL_UPGRADE\n\n**默认值**\n不涉及",
          "enum": [
            "NEED_UPGRADE",
            "UPGRADING",
            "SUCCESS_UPGRADE",
            "FAIL_UPGRADE"
          ]
        },
        "upgrade_fail_message": {
          "type": "string",
          "description": "更新失败的消息",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "example": "23.9.0",
          "description": "安全云脑版本",
          "minLength": 32,
          "maxLength": 64
        }
      },
      "description": "插件定义简介"
    },
    "ComponentName": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1024,
      "description": "组件名称",
      "example": "Logstash"
    },
    "ListComponentsResponseBody": {
      "required": [
        "count",
        "records"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "description": "组件数量",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "records": {
          "type": "array",
          "description": "组件",
          "items": {
            "$ref": "#/definitions/ComponentDetailInfo"
          },
          "maxItems": 100,
          "minItems": 0
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "secmaster.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}