{
  "name": "ImportIncidents",
  "summary": "导入事件",
  "tags": "事件管理",
  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces/{workspace_id}/soc/incidents/import": {
      "post": {
        "tags": [
          "事件管理"
        ],
        "summary": "导入事件",
        "description": "导入事件,根据template下载的模板填写事件,事件的所有字段根据是否必填来限制,参照:安全事件数据对象定义中的类型和说明来确定, 后台实现时需要校验",
        "operationId": "ImportIncidents",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。[获取用户Token](secmaster_03_0010.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "content-type",
            "in": "header",
            "description": "**参数解释:**\n内容类型\n- application/json;charset=UTF-8    普通API请求的类型\n\n**约束限制:**\n不涉及\n**取值范围:**\n- application/json;charset=UTF-8\n\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "default": "application/json;charset=UTF-8",
            "maxLength": 64,
            "minLength": 0
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 32
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "**参数解释:**\n工作空间id。\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 32
          },
          {
            "name": "uploadFile",
            "in": "formData",
            "description": "导入事件文件",
            "required": true,
            "type": "file"
          }
        ],
        "responses": {
          "200": {
            "description": "导入事件返回body体",
            "examples": {
              "application/json": {
                "code": "00000000",
                "message": "message",
                "data": {
                  "ids": [
                    "909494e3-558e-46b6-a9eb-07a8e18ca622",
                    "909494e3-558e-46b6-a9eb-07a8e18ca623"
                  ]
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ImportIncidentsResponseBody"
            }
          },
          "400": {
            "description": "导入事件错误返回body体",
            "schema": {
              "$ref": "#/definitions/DataobjectErrorRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-surpport-apiexplorer": true,
        "x-api-type": "open-api",
        "x-surpport-hcs": "Y",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/workspaces/{workspace_id}/soc/incidents/import",
        "x-request-examples-description-1": "导入文件名称为incident_template.xlsx表格里的所有事件",
        "x-request-examples-1": {
          "uploadFile": "incident_template.xlsx"
        }
      }
    }
  },
