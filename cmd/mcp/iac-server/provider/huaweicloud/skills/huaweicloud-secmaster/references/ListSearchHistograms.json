{
  "name": "ListSearchHistograms",
  "summary": "获取数据分布直方图",
  "tags": "查询分析",
  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces/{workspace_id}/siem/search/histograms": {
      "post": {
        "tags": [
          "查询分析"
        ],
        "summary": "获取数据分布直方图",
        "description": "获取数据分布直方图",
        "operationId": "ListSearchHistograms",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。[获取用户Token](secmaster_03_0010.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 32,
            "x-example": "156*******************341da6"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "工作空间ID",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "x-example": "458********************e64c3"
          },
          {
            "in": "body",
            "name": "ListSearchHistogramsRequestBody",
            "description": "show histograms request body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListHistogramsRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "examples": {
              "application/json": {
                "histograms": [
                  {
                    "count": 1,
                    "from": 1584883694354,
                    "to": 1584883694360
                  }
                ],
                "total_count": 1
              }
            },
            "schema": {
              "$ref": "#/definitions/ListHistogramsResponseBody"
            }
          },
          "400": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/IsapErrorRsp"
            }
          }
        },
        "x-api-type": "open-api",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-surpport-hcs": "Y",
        "x-api-service-plane": "Control-plane",
        "x-sec-data-level": "L1",
        "x-surpport-apiexplorer": "true"
      }
    }
  },
  "definitions": {
    "IsapErrorRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误对象"
    },
    "Histogram": {
      "required": [
        "count",
        "from",
        "to"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "description": "当前时间段内的数据条数",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "from": {
          "type": "integer",
          "format": "int64",
          "description": "开始时间点",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "to": {
          "type": "integer",
          "format": "int64",
          "description": "结束时间点",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "ListHistogramsRequestBody": {
      "required": [
        "dataspace_id",
        "from",
        "pipe_id",
        "query",
        "to"
      ],
      "properties": {
        "dataspace_id": {
          "type": "string",
          "description": "数据空间ID",
          "minLength": 36,
          "maxLength": 36
        },
        "from": {
          "type": "integer",
          "format": "int64",
          "description": "查询开始时间点",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "pipe_id": {
          "type": "string",
          "description": "数据管道ID",
          "minLength": 36,
          "maxLength": 36
        },
        "query": {
          "type": "string",
          "description": "查询语句",
          "minLength": 0,
          "maxLength": 65535
        },
        "to": {
          "type": "integer",
          "format": "int64",
          "description": "查询结束时间点",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "example": {
        "dataspace_id": "a00106ba-bede-453c-8488-b60c70bd6aed",
        "from": 1584883694354,
        "pipe_id": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
        "query": "xxx",
        "to": 1584883694654
      }
    },
    "ListHistogramsResponseBody": {
      "required": [
        "histograms",
        "total_count"
      ],
      "properties": {
        "histograms": {
          "type": "array",
          "description": "直方图",
          "items": {
            "$ref": "#/definitions/Histogram"
          },
          "maxItems": 50,
          "minItems": 0
        },
        "total_count": {
          "type": "integer",
          "format": "int64",
          "description": "数据总条数",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "secmaster.af-north-1.myhuaweicloud.com",
  "base_path": null,
