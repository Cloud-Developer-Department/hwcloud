{
  "name": "ListComponentConfiguration",
  "summary": "列出组件配置",
  "tags": "组件管理",
  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces/{workspace_id}/components/{component_id}/configurations": {
      "get": {
        "tags": [
          "组件管理"
        ],
        "summary": "列出组件配置",
        "description": "列出组件配置",
        "operationId": "ListComponentConfiguration",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 32,
            "x-example": "156*******************341da6"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "工作空间ID",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "x-example": "458********************e64c3"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。[获取用户Token](secmaster_03_0010.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "component_id",
            "in": "path",
            "description": "组件ID",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "x-example": "458********************e64c3"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页数量",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 500,
            "minimum": 0,
            "format": "int64",
            "x-example": 10
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数解释:**\n偏移量\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 9223372036854776000,
            "minimum": 0
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "按照属性排序。",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序顺序,支持 `ASC` 或 `DESC`。",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "examples": {
              "application/json": {
                "count": 1,
                "records": [
                  {
                    "component_id": "1603635xxx1444",
                    "component_name": "logstash",
                    "config_status": "APPLIED",
                    "create_time": 1768550588077,
                    "list": [
                      {
                        "component_id": "1603635xxx1444",
                        "configuration_id": "174",
                        "file_name": "log4j2.properties",
                        "file_type": "LOG4J2",
                        "node_id": "9c77d412xxx89d2",
                        "param": "{\"a.eventEol\":\"true\"}",
                        "type": "CURRENT_APPLY"
                      },
                      {
                        "component_id": "1603635xxx1444",
                        "configuration_id": "174",
                        "file_name": "jvm.options",
                        "file_type": "JVM",
                        "node_id": "9c77d412xxx89d2",
                        "param": "{\"-Xmx\":\"2048M\"}",
                        "type": "CURRENT_APPLY"
                      }
                    ],
                    "node_id": "9c77d412xxx89d2",
                    "node_name": "ecs-xxx-isap",
                    "specification": "2U|4G|140G"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListComponentConfigurationResponseBody"
            }
          },
          "400": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/IsapErrorRsp"
            }
          }
        },
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-surpport-hcs": "Y",
        "x-surpport-apiexplorer": "true",
        "x-api-service-plane": "Control-plane",
        "x-sec-data-level": "L1"
      }
    }
  },
  "definitions": {
    "ComponentId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 36,
      "description": "组件id.",
      "example": "00000000-0000-0000-0000-000000000000"
    },
    "IsapCommonDescription": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "描述信息",
      "example": "description"
    },
    "IsapTimeStamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775800,
      "format": "int64",
      "description": "毫秒时间戳",
      "example": 0
    },
    "ComponentConfigurationParam": {
      "type": "object",
      "properties": {
        "component_id": {
          "$ref": "#/definitions/ComponentId"
        },
        "configuration_id": {
          "type": "string",
          "example": "909494e3-558e-46b6-a9eb-07a8e18ca621",
          "description": "配置ID",
          "minLength": 0,
          "maxLength": 30
        },
        "file_name": {
          "type": "string",
          "description": "文件名称",
          "minLength": 0,
          "maxLength": 63
        },
        "file_path": {
          "type": "string",
          "description": "文件路径",
          "minLength": 0,
          "maxLength": 1024
        },
        "file_type": {
          "$ref": "#/definitions/FileType"
        },
        "node_id": {
          "type": "string",
          "example": "909494e3-558e-46b6-a9eb-07a8e18ca621",
          "description": "节点ID",
          "minLength": 0,
          "maxLength": 36
        },
        "param": {
          "type": "string",
          "description": "参数",
          "minLength": 0,
          "maxLength": 1024
        },
        "type": {
          "type": "string",
          "description": "**参数解释**:\n配置类型\n- HISTORY 历史版本\n- CURRENT_SAVE 当前保存\n- CURRENT_APPLY 当前使用\n\n**约束限制**\n不涉及\n**取值范围**:\n- HISTORY\n- CURRENT_SAVE\n- CURRENT_APPLY\n\n**默认值**\n不涉及",
          "enum": [
            "HISTORY",
            "CURRENT_SAVE",
            "CURRENT_APPLY"
          ]
        },
        "version": {
          "type": "integer",
          "format": "int32",
          "description": "版本",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "ComponentConfigurationParamList": {
      "type": "array",
      "description": "组件配置参数列表",
      "items": {
        "$ref": "#/definitions/ComponentConfigurationParam"
      },
      "minItems": 0,
      "maxItems": 50
    },
    "ComponentName": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1024,
      "description": "组件名称",
      "example": "Logstash"
    },
    "FileType": {
      "type": "string",
      "description": "**参数解释**:\n文件类型\n- JVM JVM配置文件类型\n- LOG4J2 Log4j2日志配置文件类型\n- YML YAML配置文件类型\n\n**约束限制**\n不涉及\n**取值范围**:\n- JVM\n- LOG4J2\n- YML \n\n**默认值**\n不涉及",
      "enum": [
        "JVM",
        "LOG4J2",
        "YML"
      ]
    },
    "Monitor": {
      "properties": {
        "cpu_idle": {
          "type": "string",
          "description": "CPU 空闲时间的百分比",
          "minLength": 0,
          "maxLength": 1024
        },
        "cpu_usage": {
          "type": "string",
          "description": "CPU 当前的使用率",
          "minLength": 0,
          "maxLength": 1024
        },
        "disk_count": {
          "type": "string",
          "description": "系统中磁盘设备的数量",
          "minLength": 0,
          "maxLength": 1024
        },
        "disk_usage": {
          "type": "string",
          "description": "当前磁盘空间使用量",
          "minLength": 0,
          "maxLength": 1024
        },
        "down_pps": {
          "type": "string",
          "description": "下载数据包每秒数量",
          "minLength": 0,
          "maxLength": 1024
        },
        "health_status": {
          "$ref": "#/definitions/NodeHealthStatus"
        },
        "heart_beat": {
          "type": "string",
          "example": "ONLINE",
          "description": "**参数解释**:\n节点是否成功收到心跳信号\n- ONLINE 在线\n- OFFLINE 离线\n\n**约束限制**\n不涉及\n**取值范围**:\n- ONLINE\n- OFFLINE\n\n**默认值**\n不涉及",
          "enum": [
            "ONLINE",
            "OFFLINE"
          ]
        },
        "heart_beat_time": {
          "type": "integer",
          "format": "int64",
          "description": "最后一次接收到心跳信号的时间",
          "minimum": 0,
          "maximum": 9223372036854775800
        },
        "memory_cache": {
          "type": "string",
          "description": "缓存数据的内存大小",
          "minLength": 0,
          "maxLength": 1024
        },
        "memory_count": {
          "type": "string",
          "description": "物理内存条数量",
          "minLength": 0,
          "maxLength": 1024
        },
        "memory_free": {
          "type": "string",
          "description": "当前空闲的物理内存量",
          "minLength": 0,
          "maxLength": 1024
        },
        "memory_shared": {
          "type": "string",
          "description": "多个进程共享使用的内存总量",
          "minLength": 0,
          "maxLength": 1024
        },
        "memory_usage": {
          "type": "string",
          "description": "已使用的物理内存量",
          "minLength": 0,
          "maxLength": 1024
        },
        "mini_on_online": {
          "type": "string",
          "description": "是否在线",
          "minLength": 1,
          "maxLength": 32
        },
        "read_rate": {
          "type": "string",
          "description": "磁盘读取速率",
          "minLength": 0,
          "maxLength": 1024
        },
        "up_pps": {
          "type": "string",
          "description": "上传数据包每秒数量",
          "minLength": 0,
          "maxLength": 1024
        },
        "write_rate": {
          "type": "string",
          "description": "磁盘写入速率",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "description": "监视器"
    },
    "IsapErrorRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误对象"
    },
    "ListComponentConfigurationResponseBody": {
      "required": [
        "count",
        "records"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "description": "组件配置数量",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "records": {
          "type": "array",
          "description": "组件配置列表",
          "items": {
            "$ref": "#/definitions/ComponentConfiguration"
          },
          "maxItems": 100,
          "minItems": 0
        }
      }
    },
    "IsapNodeExpansion": {
      "properties": {
        "custom_label": {
          "type": "string",
          "description": "自定义标签",
          "minLength": 0,
          "maxLength": 1024
        },
        "data_center": {
          "type": "string",
          "description": "数据中心",
          "minLength": 0,
          "maxLength": 1024
        },
        "description": {
          "$ref": "#/definitions/IsapCommonDescription"
        },
        "maintainer": {
          "type": "string",
          "description": "维护人",
          "minLength": 0,
          "maxLength": 1024
        },
        "network_plane": {
          "type": "string",
          "description": "网络平面",
          "minLength": 0,
          "maxLength": 1024
        },
        "node_id": {
          "$ref": "#/definitions/IsapUuid"
        }
      },
      "description": "节点扩展信息"
    },
    "IsapUuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "description": "UUID",
      "example": "00000000-0000-0000-0000-000000000000"
    },
    "IsapIpAddress": {
      "type": "string",
      "minLength": 7,
      "maxLength": 15,
      "pattern": "((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)",
      "description": "IP地址",
      "example": "0.0.0.0"
    },
    "NodeHealthStatus": {
      "type": "string",
      "description": "**参数解释**:\n节点的健康状态\n- NORMAL 正常\n- ANOMALIES 异常\n- FAULTS 故障\n- LOST_CONTACT 失联\n\n**约束限制**\n不涉及\n**取值范围**:\n- NORMAL\n- ANOMALIES\n- FAULTS\n- LOST_CONTACT\n\n**默认值**\n不涉及",
      "example": "NORMAL",
      "enum": [
        "NORMAL",
        "ANOMALIES",
        "FAULTS",
        "LOST_CONTACT"
      ]
    },
    "ComponentConfiguration": {
      "type": "object",
      "properties": {
        "component_id": {
          "$ref": "#/definitions/ComponentId"
        },
        "component_name": {
          "$ref": "#/definitions/ComponentName"
        },
        "config_status": {
          "type": "string",
          "description": "**参数解释**:\n节点配置状态\n- UN_SAVED 待保存\n- SAVE_AND_UN_APPLY 待应用\n- MOVE_AND_UN_APPLY 待移除\n- APPLYING 应用中\n- FAIL_APPLY 应用失败\n- APPLIED 应用完成\n\n**约束限制**\n不涉及\n**取值范围**:\n- UN_SAVED\n- SAVE_AND_UN_APPLY\n- MOVE_AND_UN_APPLY\n- APPLYING\n- FAIL_APPLY\n- APPLIED\n\n**默认值**\n不涉及",
          "enum": [
            "UN_SAVED",
            "SAVE_AND_UN_APPLY",
            "MOVE_AND_UN_APPLY",
            "APPLYING",
            "FAIL_APPLY",
            "APPLIED"
          ]
        },
        "create_time": {
          "$ref": "#/definitions/IsapTimeStamp"
        },
        "fail_deploy_message": {
          "type": "string",
          "description": "部署失败的消息",
          "minLength": 1,
          "maxLength": 1024
        },
        "ip_address": {
          "$ref": "#/definitions/IsapIpAddress"
        },
        "list": {
          "$ref": "#/definitions/ComponentConfigurationParamList"
        },
        "monitor": {
          "$ref": "#/definitions/Monitor"
        },
        "node_apply_fail_enum": {
          "$ref": "#/definitions/NodeApplyFailEnum"
        },
        "node_expansion": {
          "$ref": "#/definitions/IsapNodeExpansion"
        },
        "node_id": {
          "type": "string",
          "example": "909494e3-558e-46b6-a9eb-07a8e18ca621",
          "description": "节点ID",
          "minLength": 0,
          "maxLength": 36
        },
        "node_name": {
          "type": "string",
          "description": "节点名称",
          "minLength": 0,
          "maxLength": 63
        },
        "private_ip_address": {
          "$ref": "#/definitions/IsapIpAddress"
        },
        "region": {
          "type": "string",
          "description": "地区",
          "minLength": 0,
          "maxLength": 1024
        },
        "specification": {
          "type": "string",
          "description": "规范",
          "minLength": 1,
          "maxLength": 1024
        },
        "vpc_endpoint_address": {
          "type": "string",
          "description": "VPC端点地址",
          "minLength": 0,
          "maxLength": 1024
        },
        "vpc_endpoint_id": {
          "type": "string",
          "description": "VPC端点ID",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "description": "插件配置定义简介"
    },
    "NodeApplyFailEnum": {
      "type": "string",
      "description": "**参数解释**:\n节点应用成功与否状态、原因\n- COLLECTOR_USE 采集器使用中,无法移除\n- NODE_OFFLINE 节点失联状态,无法应用\n\n**约束限制**\n不涉及\n**取值范围**:\n- COLLECTOR_USE\n- NODE_OFFLINE\n\n**默认值**\n不涉及",
      "enum": [
        "COLLECTOR_USE",
        "NODE_OFFLINE"
      ]
    }
  },
