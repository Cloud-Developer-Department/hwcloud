{
  "name": "UploadAttachment",
  "summary": "上传附件",
  "tags": "附件管理",
  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces/{workspace_id}/soc/attachment/upload": {
      "post": {
        "tags": [
          "附件管理"
        ],
        "summary": "上传附件",
        "description": "上传附件至OBS",
        "operationId": "UploadAttachment",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 32,
            "x-example": "156*******************341da6"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "**参数解释**:\n工作空间ID\n**取值范围**:\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "x-example": "458********************e64c3"
          },
          {
            "name": "fileType",
            "in": "formData",
            "description": "固定枚举,当前仅支持user_task/用户任务",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "enum": [
              "user_task"
            ]
          },
          {
            "name": "uploadFile",
            "in": "formData",
            "description": "上传的附件",
            "required": true,
            "type": "file"
          }
        ],
        "responses": {
          "200": {
            "description": "响应成功返回对象",
            "examples": {
              "application/json": {
                "code": "00000000",
                "message": "message",
                "success": true,
                "request_id": "xxxxxx",
                "data": {
                  "id": "5d4157f4-4811-430c-9d69-25f3137cbc80",
                  "file_name": "test.doc",
                  "workspace_id": "909494e3-558e-46b6-a9eb-07a8e18ca624"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/UploadAttachmentResponseBody"
            }
          },
          "400": {
            "description": "响应错误返回对象",
            "schema": {
              "$ref": "#/definitions/ComponentErrorRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-surpport-apiexplorer": true,
        "x-api-type": "open-api",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/workspaces/{workspace_id}/soc/attachment/upload",
        "x-request-examples-description-1": "导入名称为test.doc的附件",
        "x-request-examples-1": {
          "uploadFile": "test.doc"
        },
        "x-surpport-hcs": "Y"
      }
    }
  },
  "definitions": {
    "UploadAttachmentResponseBody": {
      "properties": {
        "code": {
          "type": "string",
          "example": "CSB.20040001",
          "description": "错误码",
          "minLength": 0,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "example": "Parameter error.",
          "description": "错误信息",
          "minLength": 0,
          "maxLength": 1024
        },
        "success": {
          "type": "boolean",
          "example": true,
          "description": "请求状态"
        },
        "request_id": {
          "type": "string",
          "example": "xxxxxx",
          "description": "请求id",
          "minLength": 0,
          "maxLength": 256
        },
        "data": {
          "$ref": "#/definitions/UploadAttachmentInfo"
        }
      },
      "description": "上传附件响应体"
    },
    "UploadAttachmentInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "5d4157f4-4811-430c-9d69-25f3137cbc80",
          "description": "附件id",
          "minLength": 1,
          "maxLength": 128
        },
        "file_name": {
          "type": "string",
          "example": "test.doc",
          "description": "附件名称",
          "minLength": 0,
          "maxLength": 64
        },
        "workspace_id": {
          "type": "string",
          "example": "909494e3-558e-46b6-a9eb-07a8e18ca624",
          "description": "当前的工作空间id",
          "minLength": 0,
          "maxLength": 64
        }
