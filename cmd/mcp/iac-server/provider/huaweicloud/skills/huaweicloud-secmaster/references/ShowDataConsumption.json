{
  "name": "ShowDataConsumption",
  "summary": "获取实时消费配置",
  "tags": "数据消费管理",
  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/workspaces/{workspace_id}/siem/tables/{table_id}/consumption": {
      "get": {
        "tags": [
          "数据消费管理"
        ],
        "summary": "获取实时消费配置",
        "description": "获取实时消费配置",
        "operationId": "ShowDataConsumption",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。[获取用户Token](secmaster_03_0010.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 32,
            "x-example": "156*******************341da6"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "工作空间ID",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "x-example": "458********************e64c3"
          },
          {
            "name": "table_id",
            "in": "path",
            "description": "表ID",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "x-example": "458********************e64c3"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "examples": {
              "application/json": {
                "status": "disable"
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowDataConsumptionResponseBody"
            }
          },
          "400": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/IsapErrorRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-surpport-hcs": "Y",
        "x-api-type": "open-api",
        "x-surpport-apiexplorer": true,
        "x-sec-data-level": "L1",
        "x-api-service-plane": "Control-plane"
      }
    }
  },
  "definitions": {
    "IsapErrorRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误对象"
    },
    "ShowDataConsumptionResponseBody": {
      "properties": {
        "table_name": {
          "$ref": "#/definitions/IsapTableName"
        },
        "dataspace_id": {
          "$ref": "#/definitions/IsapDataSpaceId"
        },
        "pipe_id": {
          "type": "string",
          "description": "管道ID",
          "minLength": 0,
          "maxLength": 36
        },
        "pipe_name": {
          "type": "string",
          "example": "pipe_name",
          "description": "管道名称",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "type": "string",
          "example": "ENABLED",
          "description": "**参数解释**:\n状态\n- ENABLED 启用\n- DISABLED 禁用\n\n**约束限制**\n不涉及\n**取值范围**:\n- ENABLED\n- DISABLED\n\n**默认值**\n不涉及",
          "enum": [
            "ENABLED",
            "DISABLED"
          ]
        },
        "type": {
          "type": "string",
          "example": "INTRANET",
          "description": "**参数解释**:\n网络类型\n- INTERNET 互联网\n- INTRANET 内联网\n\n**约束限制**\n不涉及\n**取值范围**:\n- INTERNET\n- INTRANET\n\n**默认值**\n不涉及",
          "enum": [
            "INTERNET",
            "INTRANET"
          ]
        },
        "access_point": {
          "type": "string",
          "description": "接入点域名信息(格式:{dataspace}.{endpoint})",
          "minLength": 1,
          "maxLength": 255
        },
        "subscription": {
          "type": "string",
          "description": "订阅名称",
          "minLength": 5,
          "maxLength": 63
        },
        "table_id": {
          "type": "string",
          "description": "表Id",
          "minLength": 0,
          "maxLength": 32
        }
      }
    },
    "IsapTableName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!_)[a-zA-Z][a-zA-Z0-9_]*(?<!_)$",
      "description": "表名称",
      "example": "tableName"
    },
    "IsapDataSpaceId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "description": "数据空间ID",
      "example": "00000000-0000-0000-0000-000000000000"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "secmaster.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
