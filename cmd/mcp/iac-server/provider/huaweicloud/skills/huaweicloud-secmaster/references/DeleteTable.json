        "CREATING",
        "UPDATING",
        "DELETING",
        "TRUNCATING",
        "UPGRADING",
        "CREATE_FAILED",
        "UPDATE_FAILED",
        "DELETING_FAILED",
        "TRUNCATE_FAILED",
        "UPGRADE_FAILED"
