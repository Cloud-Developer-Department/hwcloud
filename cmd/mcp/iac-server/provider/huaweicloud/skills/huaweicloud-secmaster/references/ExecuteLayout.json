        ],
        "produces": [
          "application/json",
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。[获取用户Token](secmaster_03_0010.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "content-type",
            "in": "header",
            "description": "**参数解释:**\n内容类型\n- application/json;charset=UTF-8    普通API请求的类型\n\n**约束限制:**\n不涉及\n**取值范围:**\n- application/json;charset=UTF-8\n\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "default": "application/json;charset=UTF-8",
            "maxLength": 64,
            "minLength": 0
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 32
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "**参数解释:**\n工作空间id。\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 32
          },
          {
            "name": "action",
            "in": "formData",
            "description": "对布局的操作\nVERIFY 校验导入布局压缩包文件\nIMPORT  导入布局压缩包文件\nEXPORT 导出布局文件",
            "required": true,
            "type": "string",
            "default": "IMPORT",
            "maxLength": 64,
            "minLength": 1,
            "enum": [
              "VERIFY",
              "IMPORT",
              "EXPORT"
            ]
          },
          {
            "name": "ids",
            "in": "formData",
            "description": "操作布局的id列表",
            "required": false,
            "type": "string",
            "maxLength": 10,
            "minLength": 1
          },
          {
            "name": "uploadFile",
            "in": "formData",
            "description": "上传的文件",
            "required": false,
            "type": "file"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "examples": {
              "application/json": {
                "code": "00000000",
                "message": "success"
              }
            },
            "headers": {
              "X-request-id": {
                "type": "string",
