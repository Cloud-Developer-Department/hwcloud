            }
          }
        },
        "x-support-sdk": "Y",
        "x-surpport-apiexplorer": true,
        "x-surpport-hcs": "N",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-request-examples-description-1": "校验导入布局文件是否有效",
        "x-request-examples-1": {
          "uploadFile": "Test.zip",
          "action": "verify"
        }
      }
