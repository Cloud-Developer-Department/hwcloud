          "type": "string",
          "example": "78ce06b9b2484e9a8c40d38ca081c222",
          "description": "角色id",
          "minLength": 32,
          "maxLength": 36
        },
        "display_name": {
          "type": "string",
          "example": "RMS ReadOnlyAccess",
          "description": "角色名称",
          "minLength": 2,
          "maxLength": 256
