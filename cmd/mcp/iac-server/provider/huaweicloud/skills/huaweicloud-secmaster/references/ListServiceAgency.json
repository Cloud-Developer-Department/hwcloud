{
  "name": "ListServiceAgency",
  "summary": "查看委托信息",
  "tags": "委托管理",
  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/agency": {
      "get": {
        "tags": [
          "委托管理"
        ],
        "summary": "查看委托信息",
        "description": "check service linked agency",
        "operationId": "ListServiceAgency",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 32
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "maxLength": 100000,
            "minLength": 100,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "required": false,
            "type": "string",
            "maxLength": 20,
            "minLength": 2
          }
        ],
        "responses": {
          "200": {
            "description": "所需权限列表",
            "schema": {
              "$ref": "#/definitions/ListServiceAgencyResponseBody"
            }
          },
          "403": {
            "description": "请求权限不足",
            "examples": {
              "application/json": {
                "error_code": "csb.00180004",
                "error_msg": "Do not have the permission to query agency details. Ask the administrator to add the iam:agencies:getAgency permission."
              }
            },
            "schema": {
              "$ref": "#/definitions/WorkspaceErrorRsp"
            }
          },
          "500": {
            "description": "系统内部错误",
            "examples": {
              "application/json": {
                "error_code": "csb.00180001",
                "error_msg": "The system is busy. Please try again later."
              }
            },
            "schema": {
              "$ref": "#/definitions/WorkspaceErrorRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-surpport-apiexplorer": true,
        "x-api-type": "open-api"
      }
    }
  },
  "definitions": {
    "WorkspaceErrorRsp": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "example": "SecMaster.20040001",
          "description": "**参数解释**:\n错误码\n**取值范围**:\n不涉及",
          "minLength": 0,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "example": "Parameter error.",
          "description": "**参数解释**:\n错误描述\n**取值范围**:\n不涉及",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "description": "请求失败错误响应体"
