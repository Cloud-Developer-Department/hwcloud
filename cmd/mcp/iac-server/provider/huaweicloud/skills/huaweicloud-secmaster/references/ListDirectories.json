      "example": "主机告警规则目录分组"
    },
    "IsapWorkspaceId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "description": "工作空间ID",
      "example": "00000000-0000-0000-0000-000000000000"
    }
  },
