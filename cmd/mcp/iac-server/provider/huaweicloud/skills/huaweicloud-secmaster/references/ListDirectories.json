{
  "name": "ListDirectories",
  "summary": "列出目录分组",
  "tags": "目录管理",
  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/workspaces/{workspace_id}/siem/directories": {
      "get": {
        "tags": [
          "目录管理"
        ],
        "summary": "列出目录分组",
        "description": "列出目录分组",
        "operationId": "ListDirectories",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 32,
            "x-example": "156*******************341da6"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "工作空间ID",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "x-example": "458********************e64c3"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。[获取用户Token](secmaster_03_0010.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "category",
            "in": "query",
            "description": "**参数解释**:\n目录类型\n- TABLE 表\n- PIPE 管道\n- RETRIEVE_SCRIPT 检索脚本\n- ANALYSIS_SCRIPT 分析脚本\n- DATA_TRANSFORMATION 数据加工\n- ALERT_RULE 告警规则\n\n**约束限制**\n不涉及\n**取值范围**:\n- TABLE\n- PIPE\n- RETRIEVE_SCRIPT\n- ANALYSIS_SCRIPT\n- DATA_TRANSFORMATION\n- ALERT_RULE\n\n**默认值**\n不涉及",
            "required": true,
            "type": "string",
            "enum": [
              "TABLE",
              "PIPE",
              "RETRIEVE_SCRIPT",
              "ANALYSIS_SCRIPT",
              "DATA_TRANSFORMATION",
              "ALERT_RULE"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "examples": {
              "application/json": {
                "directories": [
                  "1"
                ],
                "directory_i18ns": [
                  {
                    "directory": "1",
                    "directory_en": "1",
                    "directory_fr": "1"
                  }
                ],
                "project_id": "c796dfc5f1644915ae072b7642a2cd93",
                "workspace_id": "5317af6c-aea0-4bd2-bd6b-08de5fd3b155"
              }
            },
            "schema": {
              "$ref": "#/definitions/ListDirectoriesResponseBody"
            }
          },
          "400": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/IsapErrorRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-surpport-hcs": "Y",
        "x-api-type": "open-api",
        "x-surpport-apiexplorer": true,
        "x-sec-data-level": "L1",
        "x-api-service-plane": "Control-plane"
      }
    }
  },
  "definitions": {
    "IsapErrorRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误对象"
    },
    "IsapProjectId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "description": "项目ID",
      "example": 0
    },
    "DirectoryI18N": {
      "properties": {
        "directory": {
          "$ref": "#/definitions/Directory"
        },
        "directory_en": {
          "$ref": "#/definitions/Directory"
        },
        "directory_fr": {
          "$ref": "#/definitions/Directory"
        }
