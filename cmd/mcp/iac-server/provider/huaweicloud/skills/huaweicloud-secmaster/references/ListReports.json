{
  "name": "ListReports",
  "summary": "获取报告列表",
  "tags": "安全报告",
  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces/{workspace_id}/sa/reports": {
      "get": {
        "tags": [
          "安全报告"
        ],
        "summary": "获取报告列表",
        "description": "获取报告列表",
        "operationId": "ListReports",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。[获取用户Token](secmaster_03_0010.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "content-type",
            "in": "header",
            "description": "**参数解释:**\n内容类型\n- application/json;charset=UTF-8    普通API请求的类型\n\n**约束限制:**\n不涉及\n**取值范围:**\n- application/json;charset=UTF-8\n\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "default": "application/json;charset=UTF-8",
            "maxLength": 64,
            "minLength": 0
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 32
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "**参数解释:**\n工作空间id。\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 32
          },
          {
            "name": "report_period",
            "in": "query",
            "description": "报告周期",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "name": "status",
            "in": "query",
            "description": "状态",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "examples": {
              "application/json": [
                {
                  "id": "909494e3-558e-46b6-a9eb-07a8e18ca62f",
                  "language": "zh-cn",
                  "layout_id": "909494e3-558e-46b6-a9eb-07a8e18ca62f",
                  "notification_task": "909494e3-558e-46b6-a9eb-07a8e18ca62f",
                  "report_name": "test",
                  "report_period": "daily",
                  "report_rule_infos": [],
                  "status": "enable"
                }
              ]
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID,格式为:request_uuid-timestamp-hostname"
              }
            },
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ReportInfo"
              }
            }
          },
          "400": {
            "description": "请求失败",
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID,格式为:request_uuid-timestamp-hostname"
              }
            },
            "schema": {
              "$ref": "#/definitions/LayoutErrorRsp"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-surpport-apiexplorer": true,
        "x-surpport-hcs": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api"
      }
    }
  },
  "definitions": {
    "LayoutErrorRsp": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "example": "SecMaster.20040001",
          "description": "**参数解释**:\n错误码\n**取值范围**:\n不涉及",
          "minLength": 0,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "example": "Parameter error.",
          "description": "**参数解释**:\n错误描述\n**取值范围**:\n不涉及",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "description": "请求失败错误响应体"
    },
    "ReportRuleInfo": {
      "type": "object",
      "required": [
        "cycle",
        "emailContent",
        "emailTitle",
        "emailTo",
        "endTime",
        "reportFileType",
        "rule",
        "startTime"
      ],
      "properties": {
        "id": {
          "type": "string",
          "example": "1dd7b1ff142b4905b89ab98a2de2f6da",
          "description": "报告发送规则id",
          "pattern": "[a-f0-9]{32}"
        },
        "project_id": {
          "type": "string",
          "example": "1dd7b1ff142b4905b89ab98a2de2f6da",
          "description": "租户ID",
          "minLength": 1,
          "maxLength": 256
        },
        "workspace_id": {
          "type": "string",
          "example": "1dd7b1ff142b4905b89ab98a2de2f6da",
          "description": "工作空间ID",
          "minLength": 1,
          "maxLength": 256
        },
        "cycle": {
          "type": "string",
          "example": "NOW",
          "description": "数据周期",
          "minLength": 1,
          "maxLength": 256
        },
        "rule": {
          "type": "string",
          "example": "0 50 0/9 * * ?",
          "description": "cron表达式",
          "minLength": 1,
          "maxLength": 256
        },
        "start_time": {
          "type": "string",
          "example": "00:00:00",
          "description": "报告数据周期开始时间",
          "minLength": 1,
          "maxLength": 256
        },
        "end_time": {
          "type": "string",
          "example": "00:00:00",
          "description": "报告数据周期结束时间",
          "minLength": 1,
          "maxLength": 256
        },
        "email_title": {
          "type": "string",
          "example": "tittle",
          "description": "邮件标题",
          "minLength": 1,
          "maxLength": 256
        },
        "email_to": {
          "type": "string",
          "example": "xx@xxx.com",
          "description": "收件人邮箱",
          "minLength": 1,
          "maxLength": 256
        },
        "email_content": {
          "type": "string",
          "example": "content",
          "description": "邮件内容",
          "minLength": 1,
          "maxLength": 256
        },
        "report_file_type": {
          "type": "string",
          "example": "pdf",
          "description": "报告类型,支持图片、pdf、html",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "description": "报告发送规则"
    },
    "ReportInfo": {
      "type": "object",
      "required": [
        "id",
        "is_generated",
        "language",
        "layout_id",
        "notification_task",
        "report_name",
        "report_period",
        "report_range",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "example": "1dd7b1ff142b4905b89ab98a2de2f6da",
          "description": "报告id",
          "pattern": "[a-f0-9]{32}"
        },
        "report_name": {
          "type": "string",
          "example": "report",
          "description": "报告名称",
          "minLength": 1,
          "maxLength": 256
        },
        "report_period": {
          "type": "string",
          "example": "weekly",
          "description": "报告周期 weekly, daily, annual, monthly",
          "enum": [
            "weekly",
            "daily",
            "annual",
            "monthly"
          ]
        },
        "report_range": {
          "type": "object",
          "description": "数据范围",
          "properties": {
            "start": {
              "type": "string",
              "example": "1662900406226",
              "description": "起始时间",
              "minLength": 1,
              "maxLength": 16
            },
            "end": {
              "type": "string",
              "example": "1662900406226",
              "description": "终止时间",
              "minLength": 1,
              "maxLength": 16
            }
          },
          "required": [
            "end",
            "start"
          ]
        },
        "language": {
          "type": "string",
          "example": "zh-CN",
          "description": "语言",
          "minLength": 1,
          "maxLength": 16
        },
        "notification_task": {
          "type": "string",
          "example": "b6940c3beee4413381be3f257ab6fb2d",
          "description": "通知任务id",
          "pattern": "[a-f0-9]{32}"
        },
        "layout_id": {
          "type": "string",
          "example": "aa7b6b904d794e228e6b65b19af4bcbd",
          "description": "布局id",
          "pattern": "[a-f0-9]{32}"
        },
        "status": {
          "type": "string",
          "example": "enable",
          "description": "报告状态 enable, disable",
          "enum": [
            "enable",
            "disable"
          ]
        },
        "is_generated": {
          "type": "boolean",
          "example": true,
          "description": "报告是否已生成"
        },
        "report_rule_infos": {
          "type": "array",
          "description": "报告发送规则",
          "items": {
            "$ref": "#/definitions/ReportRuleInfo"
          },
          "maxItems": 999,
          "minItems": 0
        }
      },
      "description": "报告详情"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "secmaster.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}