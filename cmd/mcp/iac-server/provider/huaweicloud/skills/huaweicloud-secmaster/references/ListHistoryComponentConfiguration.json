            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 32,
            "x-example": "156*******************341da6"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "工作空间ID",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "x-example": "458********************e64c3"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。[获取用户Token](secmaster_03_0010.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "component_id",
            "in": "path",
            "description": "组件ID",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "x-example": "00000000-0000-0000-0000-000000000000"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "第几页",
            "required": false,
            "type": "integer",
            "maximum": 1000000,
            "minimum": 0,
            "format": "int64",
            "x-example": 20
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页数量",
            "required": false,
            "type": "integer",
            "maximum": 1000,
            "format": "int64",
            "x-example": 10
