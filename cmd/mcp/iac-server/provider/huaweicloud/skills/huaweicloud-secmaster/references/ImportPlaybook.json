        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户token",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 1
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 32,
            "x-example": "156*******************341da6"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "**参数解释**:\n工作空间ID\n**取值范围**:\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "x-example": "458********************e64c3"
          },
          {
            "name": "uploadFile",
            "in": "formData",
            "description": "导入文件",
            "required": true,
            "type": "file"
          },
          {
            "name": "upload_model",
            "in": "formData",
            "description": "剧本文件上传模式\nimport 剧本上传导入\nverify 剧本上传校验",
            "required": false,
            "type": "string",
            "default": "import",
            "maxLength": 64,
            "minLength": 1,
            "enum": [
              "verify",
              "import"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "剧本导入响应",
            "examples": {
              "application/json": {
                "code": "00000000",
                "message": ""
              }
            },
            "schema": {
              "$ref": "#/definitions/SuccessEmptyResp"
            }
          },
          "400": {
            "description": "请求错误",
            "schema": {
              "$ref": "#/definitions/PlaybookErrorRsp"
            }
          }
        },
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/workspaces/{workspace_id}/soc/playbooks/import",
        "x-request-examples-description-1": "导入名称为Test的剧本",
        "x-request-examples-1": {
          "uploadFile": "Test.zip",
          "upload_model": "import"
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-surpport-hcs": "Y",
        "x-surpport-apiexplorer": true,
