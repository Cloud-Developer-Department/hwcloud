        },
        "table_name": {
          "$ref": "#/definitions/SqlValiTableName"
        },
        "table_alias": {
          "$ref": "#/definitions/TableAlias"
        },
        "directory": {
          "$ref": "#/definitions/Directory"
        },
        "description": {
          "$ref": "#/definitions/TableDescription"
        },
        "category": {
          "$ref": "#/definitions/TableCategory"
        },
        "lock_status": {
          "$ref": "#/definitions/TableLockStatus"
        },
        "process_status": {
          "$ref": "#/definitions/TableProcessStatus"
        },
        "process_error": {
          "$ref": "#/definitions/TableProcessError"
        },
        "edit_type": {
          "$ref": "#/definitions/TableEditType"
        },
        "format": {
          "$ref": "#/definitions/TableFormat"
        },
        "rw_type": {
          "$ref": "#/definitions/TableRWType"
        },
        "owner_type": {
          "$ref": "#/definitions/TableOwnerType"
        },
        "data_layering": {
          "$ref": "#/definitions/DataLayering"
        },
        "data_classification": {
          "$ref": "#/definitions/DataClassification"
        },
        "create_time": {
          "$ref": "#/definitions/IsapTimeStamp"
        },
        "update_time": {
          "$ref": "#/definitions/IsapTimeStamp"
        },
        "delete_time": {
          "$ref": "#/definitions/IsapTimeStamp"
        },
