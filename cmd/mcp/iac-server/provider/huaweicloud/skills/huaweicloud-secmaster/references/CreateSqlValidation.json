          "type": "integer",
          "format": "int64",
          "example": 0,
          "description": "已使用存储容量",
          "minimum": 0,
          "maximum": 4,
          "default": 0
        }
      }
    },
    "DataLayering": {
      "type": "string",
      "description": "**参数解释**:\n数据分层\n- ODS 操作数据存储层\n- DWS 数据汇总层\n- ADS 应用数据服务层\n\n**约束限制**\n不涉及\n**取值范围**:\n- ODS\n- DWS\n- ADS\n\n**默认值**\n不涉及",
      "example": "ODS",
      "enum": [
        "ODS",
        "DWS",
        "ADS"
      ],
      "default": "ODS"
    },
    "TableAlias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "表别名",
      "example": "table_alias"
    },
    "TableDescription": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "表描述",
      "example": "Table description"
    },
    "TableRWType": {
      "type": "string",
      "description": "**参数解释**:\n表读写类型\n- READ_ONLY 只读\n- READ_WRITE 读写\n- WRITE_ONLY 只写\n\n**约束限制**\n不涉及\n**取值范围**:\n- READ_ONLY\n- READ_WRITE\n- WRITE_ONLY\n\n**默认值**\n不涉及",
      "example": "READ_WRITE",
      "enum": [
        "READ_ONLY",
        "READ_WRITE",
        "WRITE_ONLY"
      ],
      "default": "READ_WRITE"
    },
    "TableFormat": {
      "type": "string",
      "description": "**参数解释**:\n表格式\n- JSON Json格式\n- DEBEZIUM_JSON Debezium JSON 格式\n- CSV CSV格式\n- PARQUET PARQUET格式\n- ORC ORC格式\n\n**约束限制**\n不涉及\n**取值范围**:\n- JSON\n- DEBEZIUM_JSON\n- CSV\n- PARQUET\n- ORC\n\n**默认值**\n不涉及",
      "example": "JSON",
      "enum": [
        "JSON",
        "DEBEZIUM_JSON",
        "CSV",
        "PARQUET",
        "ORC"
      ],
      "default": "JSON"
    },
    "SqlValiTableName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Table name 表名",
      "example": "security_alert"
    },
    "CreateSqlValidationRequestBody": {
      "required": [
        "script"
      ],
      "properties": {
        "script": {
          "$ref": "#/definitions/JobScript"
        }
      }
    },
    "TableEditType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "**参数解释**:\n表编辑类型\n- MODIFIABLE 可任意修改态\n- APPENDED 追加态 (原来的内容锁定,只可追加)\n- LOCKED 锁定态 (完全锁定,不可修改)\n\n**约束限制**\n不涉及\n**取值范围**:\n- MODIFIABLE\n- APPENDED\n- LOCKED\n\n**默认值**\n不涉及",
      "example": "MODIFIABLE",
      "enum": [
        "MODIFIABLE",
        "APPENDED",
        "LOCKED"
      ]
    },
    "TableProcessError": {
      "type": "string",
      "description": "**参数解释**:\n表处理错误\n- NONE 无\n\n**约束限制**\n不涉及\n**取值范围**:\n- NONE\n\n**默认值**\n不涉及",
      "example": "NONE",
      "enum": [
        "NONE"
      ]
    },
    "IsapUuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "description": "UUID",
      "example": "00000000-0000-0000-0000-000000000000"
    },
    "Directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "directory 目录分组",
      "example": "主机告警规则目录分组"
    },
    "TableCategory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "**参数解释**:\n表类别\n- STREAMING 流式传输\n- INDEX 索引\n- APPLICATION 应用\n- TENANT_OBS 租户对象存储\n- LAKE 数据湖\n\n**约束限制**\n不涉及\n**取值范围**:\n- STREAMING\n- INDEX\n- APPLICATION\n- TENANT_OBS\n- LAKE\n\n**默认值**\n不涉及",
      "example": "STREAMING",
      "enum": [
        "STREAMING",
        "INDEX",
        "APPLICATION",
        "TENANT_OBS",
        "LAKE"
      ]
    },
    "JobScript": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10240,
      "description": "Job Script 作业脚本",
      "example": "select status, count(*) as count from table group by status"
    },
    "IsapWorkspaceId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "description": "工作空间ID",
      "example": "00000000-0000-0000-0000-000000000000"
    },
    "CreateSqlValidationResponseBody": {
      "required": [
        "modes",
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "description": "源表",
          "items": {
            "$ref": "#/definitions/TableItem"
          },
          "maxItems": 100,
          "minItems": 1
        },
        "modes": {
          "type": "array",
          "description": "模式",
          "items": {
            "type": "string",
            "example": "STREAMING",
            "description": "**参数解释**:\nsql模式\n- STREAMING 流式处理\n- BATCH 批处理\n\n**约束限制**\n不涉及\n**取值范围**:\n- STREAMING\n- BATCH\n\n**默认值**\n不涉及",
            "minLength": 1,
            "maxLength": 256,
            "enum": [
              "STREAMING",
              "BATCH"
            ]
          },
          "maxItems": 5,
          "minItems": 1
        }
      }
    },
    "TableLockStatus": {
      "type": "string",
      "description": "**参数解释**:\n表锁状态\n- LOCKED 已锁\n- UNLOCKED 未锁\n\n**约束限制**\n不涉及\n**取值范围**:\n- LOCKED\n- UNLOCKED\n\n**默认值**\n不涉及",
      "example": "LOCKED",
      "enum": [
        "LOCKED",
        "UNLOCKED"
      ]
    }
