  "definitions": {
    "TableProcessStatus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "**参数解释**:\n表处理状态\n- COMPLETED 处理完成\n- CREATING 创建中\n- UPDATING 更新中\n- DELETING 删除中\n- TRUNCATING 清空中\n- CREATE_FAILED 创建失败\n- UPDATING_FAILED 更新失败\n- DELETING_FAILED 删除失败\n- TRUNCATE_FAILED 清空失败\n\n**约束限制**\n不涉及\n**取值范围**:\n- COMPLETED\n- CREATING\n- UPDATING\n- DELETING\n- TRUNCATING\n- CREATE_FAILED\n- UPDATING_FAILED\n- DELETING_FAILED\n- TRUNCATE_FAILED\n\n**默认值**\n不涉及",
      "example": "COMPLETED",
      "enum": [
        "COMPLETED",
        "CREATING",
        "UPDATING",
        "DELETING",
        "TRUNCATING",
        "CREATE_FAILED",
        "UPDATING_FAILED",
        "DELETING_FAILED",
        "TRUNCATE_FAILED"
      ]
    },
    "TableOwnerType": {
      "type": "string",
      "description": "**参数解释**:\n拥有者类型\n- SYSTEM 系统\n- USER 用户\n- SYSTEM_ALLOWED_DELETE 系统可删除\n- USER_ALLOWED_DELETE 用户可删除\n\n**约束限制**\n不涉及\n**取值范围**:\n- SYSTEM\n- USER\n- SYSTEM_ALLOWED_DELETE\n- USER_ALLOWED_DELETE\n\n**默认值**\n不涉及",
      "example": "USER",
      "enum": [
        "SYSTEM",
        "USER",
        "SYSTEM_ALLOWED_DELETE",
        "USER_ALLOWED_DELETE"
      ]
    },
    "IsapTimeStamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2366841600000,
      "format": "int64",
      "description": "毫秒时间戳",
      "example": 0
    },
    "IsapProjectId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "description": "项目ID",
      "example": 0
    },
    "DataClassification": {
      "type": "string",
      "description": "**参数解释**:\n数据分类\n- FACTUAL_DATA 事实数据\n- DIMENSION_DATA 维度数据\n\n**约束限制**\n不涉及\n**取值范围**:\n- FACTUAL_DATA\n- DIMENSION_DATA\n\n**默认值**\n不涉及",
      "example": "FACTUAL_DATA",
      "enum": [
        "FACTUAL_DATA",
        "DIMENSION_DATA"
      ],
      "default": "FACTUAL_DATA"
    },
    "TableItem": {
      "type": "object",
