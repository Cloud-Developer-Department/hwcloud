{
  "name": "ListResourceInstance",
  "summary": "查询资源实例列表",
  "tags": "资源实例管理",
  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/{resource_type}/resource-instances/filter": {
      "post": {
        "tags": [
          "资源实例管理"
        ],
        "summary": "查询资源实例列表",
        "description": "使用标签过滤实例,查询资源实例列表",
        "operationId": "ListResourceInstance",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 32,
            "x-example": "156*******************341da6"
          },
          {
            "name": "resource_type",
            "in": "path",
            "description": "资源类型",
            "required": true,
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询记录数(action为count时无此参数)如果action为filter默认为1000,limit最多为1000,不能为负数,最小值为1",
            "required": false,
            "type": "string",
            "default": "1000",
            "maxLength": 1000,
            "minLength": 0,
            "pattern": "[1-9][0-9]{0,2}|1000"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "索引位置,偏移量(action为count时无此参数)从第一条数据偏移offset条数据后开始查询,如果action为filter默认为0(偏移0条数据,表示从第一条数据开始查询),必须为数字,不能为负数",
            "required": false,
            "type": "string",
            "default": "0",
            "maxLength": 100,
            "minLength": 0,
            "pattern": "\\d+$"
          },
          {
            "in": "body",
            "name": "ListResourceInstanceRequestBody",
            "description": "请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/QueryResourceInstanceRequestBody"
            }
          },
          {
            "name": "Content-type",
            "in": "header",
            "description": "**参数解释:**\n内容类型\n- application/json;charset=UTF-8    普通API请求的类型\n\n**约束限制:**\n不涉及\n**取值范围:**\n- application/json;charset=UTF-8\n\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "default": "application/json;charset=UTF-8",
            "maxLength": 100,
            "minLength": 0
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "maxLength": 100,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "examples": {
              "application/json": {
                "resources": [
                  {
                    "resource_id": "1*****************2",
                    "resource_name": "resource***1"
                  }
                ],
                "total_count": 100
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryResourceInstanceListResponse"
            }
          },
          "400": {
            "description": "参数非法",
            "schema": {
              "$ref": "#/definitions/WorkspaceErrorResponseBody"
            }
          },
          "401": {
            "description": "鉴权失败",
            "schema": {
              "$ref": "#/definitions/WorkspaceErrorResponseBody"
            }
          },
          "403": {
            "description": "权限不足",
            "schema": {
              "$ref": "#/definitions/WorkspaceErrorResponseBody"
            }
          },
          "404": {
            "description": "资源未找到",
            "schema": {
              "$ref": "#/definitions/WorkspaceErrorResponseBody"
            }
          },
          "500": {
            "description": "系统异常",
            "schema": {
              "$ref": "#/definitions/WorkspaceErrorResponseBody"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-surpport-apiexplorer": true,
        "x-request-examples-url-1": "POST /v1/{project_id}/{resource_type}/resource-instances/filter",
        "x-request-examples-text-1": {
          "matches": [
            {
              "key": "resource_name",
              "value": "resource1"
            }
          ],
          "without_any_tag": true,
          "tags": [
            {
              "key": "tag_name",
              "values": [
                "tag_value",
                "tag_value1"
              ]
            }
          ],
          "sys_tags": [
            {
              "key": "_sys_enterprise_project_id",
              "values": [
                "5aa119a8-d25b-45a7-8d1b-88e127885635"
              ]
            }
          ]
        },
        "x-order": 6
      }
    }
  },
  "definitions": {
    "QueryResourceInstanceRequestBody": {
      "type": "object",
      "properties": {
        "without_any_tag": {
          "type": "boolean",
          "description": "不包含任意一个标签,该字段为true时查询所有不带标签的资源,此时忽略 “tags”、“tags_any”、“not_tags”、“not_tags_any”字段。"
        },
        "tags": {
          "type": "array",
          "description": "包含标签,最多包含50个key,每个key下面的value最多10个,每个key对应的value可以为空数组但结构体不能缺失 。Key不能重复,同一个key中values不能重复。结果返回包含所有标签的资源列表,key之间是与的关系,key-value结构中value是或的关系。无tag过滤条件时返回全量数据。",
          "items": {
            "$ref": "#/definitions/WorkspaceTag"
          },
          "maxItems": 50,
          "minItems": 0
        },
        "sys_tags": {
          "type": "array",
          "description": "仅op_service权限可以使用此字段做资源实例过滤条件。目前TMS调用时只包含一个tag结构体。key:_sys_enterprise_project_idvalue:企业项目id列表目前TMS调用时,key下面只包含一个value。0表示默认企业项目sys_tags和租户标签过滤条件(without_any_tag 、tags、tags_any、not_tags、not_tags_any)不能同时使用无sys_tags时按照tag接口处理,无tag过滤条件时返回全量数据。",
          "items": {
            "$ref": "#/definitions/WorkspaceTag"
          },
          "maxItems": 1,
          "minItems": 0
        },
        "matches": {
          "type": "array",
          "description": "搜索字段,key为要匹配的字段,如resource_name等。value为匹配的值。key为固定字典值,不能包含重复的key或不支持的key。根据key的值确认是否需要模糊匹配,如resource_name默认为模糊搜索(不区分大小写),如果value为空字符串精确匹配(多数服务不存在资源名称为空的情况,因此此类情况返回空列表)。resource_id为精确匹配。第一期只做resource_name,后续再扩展。",
          "items": {
            "$ref": "#/definitions/Match"
          },
          "maxItems": 1,
          "minItems": 0
        }
      }
    },
    "WorkspaceTag": {
      "type": "object",
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "键。最大长度128个unicode字符。 key不能为空。(搜索时不对此参数做字符集校验),key不能为空或者空字符串,不能为空格,校验和使用之前先trim 前后半角空格。",
          "minLength": 1,
          "maxLength": 128
        },
        "values": {
          "type": "array",
          "description": "值列表。每个值最大长度255个unicode字符,校验和使用之前先trim 前后半角空格。\nvalue可为空数组但不可缺省。\n如果values为空列表,则表示any_value(查询任意value)。value之间为或的关系。",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "maxItems": 10,
          "minItems": 0
        }
      }
    },
    "ResourceInfo": {
      "type": "object",
      "required": [
        "resource_id",
        "resource_name"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "description": "资产ID",
          "minLength": 1,
          "maxLength": 100
        },
        "tags": {
          "type": "array",
          "description": "标签",
          "items": {
            "$ref": "#/definitions/Match"
          },
          "maxItems": 50,
          "minItems": 0
        },
        "sys_tags": {
          "type": "array",
          "description": "系统标签",
          "items": {
            "$ref": "#/definitions/Match"
          },
          "maxItems": 50,
          "minItems": 0
        },
        "resource_name": {
          "type": "string",
          "description": "资产名称",
          "minLength": 0,
          "maxLength": 127
        },
        "resource_detail": {
          "type": "object",
          "description": "资产细节",
          "properties": {}
        }
      }
    },
    "QueryResourceInstanceListResponse": {
      "type": "object",
      "required": [
        "resources",
        "total_count"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "description": "资产信息",
          "items": {
            "$ref": "#/definitions/ResourceInfo"
          },
          "maxItems": 1000,
          "minItems": 0
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "资产总数",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "WorkspaceErrorResponseBody": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "example": "SecMaster.20011001",
          "description": "Error code.",
          "minLength": 0,
          "maxLength": 64
        },
        "error_msg": {
          "type": "string",
          "example": "Parameter error.",
          "description": "Error description.",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "description": "Error response for failed request."
    },
    "Match": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "键。第一期限定为resource_name,后续扩展。",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "description": "值。每个值最大长度255个unicode字符。",
          "minLength": 1,
          "maxLength": 255
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "secmaster.af-north-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}