{
  "name": "ShowPlatformManaged",
  "summary": "获取行管信息",
  "tags": "云日志资源",
  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/siem/cloud-logs/managers": {
      "get": {
        "tags": [
          "云日志资源"
        ],
        "summary": "获取行管信息",
        "description": "获取行管信息",
        "operationId": "ShowPlatformManaged",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 32,
            "x-example": "156*******************341da6"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。[获取用户Token](secmaster_03_0010.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "examples": {
              "application/json": {
                "create_time": 1767006589268,
                "dw_region": "test_region",
                "publish_status": "PROD",
                "tenant_managed_domain_id": "0000000000000000000000000000",
                "update_time": 1767013804231,
                "whitelist": true
              }
            },
            "schema": {
              "$ref": "#/definitions/ListManagersResponseBody"
            }
          },
          "400": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/IsapErrorRsp"
            }
          }
        },
        "x-api-type": "open-api",
        "x-is-registered": "N",
        "x-support-sdk": "Y",
        "x-surpport-hcs": "Y",
        "x-api-service-plane": "Control-plane",
        "x-sec-data-level": "L1",
        "x-surpport-apiexplorer": "true"
      }
    }
  },
  "definitions": {
