          "example": "cn-north-7",
          "description": "区域."
        },
        "platform_managed_domain_id": {
          "type": "string",
          "example": "39d29606d49b483a9914c581ce190d54",
          "description": "平台租户ID."
        },
        "publish_status": {
          "type": "string",
