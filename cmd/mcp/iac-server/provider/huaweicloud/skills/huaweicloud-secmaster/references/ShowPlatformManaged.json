        },
        "update_time": {
          "type": "integer",
          "format": "int64",
          "example": 1762924978235,
          "description": "更新时间."
        },
        "whitelist": {
          "type": "boolean",
          "example": false,
          "description": "是否在白名单中."
        }
      }
