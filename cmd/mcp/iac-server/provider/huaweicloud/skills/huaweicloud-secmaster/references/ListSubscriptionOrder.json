            "name": "project_id",
            "in": "path",
            "description": "租户projectId",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 2
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。 通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "maxLength": 640000,
            "minLength": 2
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "用户当前语言环境",
            "required": true,
            "type": "string",
            "maxLength": 6,
            "minLength": 2
          },
          {
            "name": "offset",
            "in": "query",
            "description": "smn订阅偏移量",
            "required": false,
            "type": "integer",
            "maximum": 1000000,
            "minimum": 0
