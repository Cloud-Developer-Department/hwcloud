          {
            "name": "limit",
            "in": "query",
            "description": "smn订阅返回数量",
            "required": false,
            "type": "integer",
            "maximum": 100,
            "minimum": 1
          },
          {
            "name": "page",
            "in": "query",
            "description": "订单资源详情信息枚举,DEFAULT:默认缺省值,获取开通的资源列表,不包含套餐包;PURCHASE:在DEFAULT基础上返回租户名下ECS数量;RESOURCE_LIST在DEFAULT基础上返回套餐包列表;USAGE:返回资源用量信息;SMN:返回已订阅的smn topic列表",
            "required": false,
            "type": "string",
            "maxLength": 20,
            "minLength": 3,
            "enum": [
              "DEFAULT",
              "PURCHASE",
              "SMN",
              "USAGE",
              "RESOURCE_LIST"
            ],
            "x-example": "PURCHASE"
