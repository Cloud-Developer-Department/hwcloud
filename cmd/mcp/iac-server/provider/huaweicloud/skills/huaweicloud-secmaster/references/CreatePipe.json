    "KeyIndex": {
      "properties": {
        "is_chinese_exist": {
          "type": "boolean",
          "description": "是否包含中文"
        },
        "properties": {
          "type": "object",
          "description": "嵌套结构",
          "additionalProperties": {
            "$ref": "#/definitions/KeyIndex"
          }
        },
        "type": {
