        "pipe_type": {
          "type": "string",
          "example": "system-defined",
          "description": "管道类型(system-defined,系统预定义)、1(user-defined,用户自定义)",
          "minLength": 5,
          "maxLength": 128
        },
        "project_id": {
          "type": "string",
