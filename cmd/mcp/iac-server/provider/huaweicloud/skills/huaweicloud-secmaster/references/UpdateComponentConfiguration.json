  "definitions": {
    "ConfigurationDetail": {
      "type": "object",
      "required": [
        "list"
      ],
      "properties": {
        "config_status": {
          "type": "string",
          "example": "UN_SAVED",
          "description": "**参数解释**:\n节点部署状态\n- UN_SAVED 待保存\n- SAVE_AND_UN_APPLY 待应用\n- MOVE_AND_UN_APPLY 待移除\n- APPLYING 应用中\n- FAIL_APPLY 应用失败\n- APPLIED 应用完成\n\n**约束限制**\n不涉及\n**取值范围**:\n- UN_SAVED\n- SAVE_AND_UN_APPLY\n- MOVE_AND_UN_APPLY\n- APPLYING\n- FAIL_APPLY\n- APPLIED\n\n**默认值**\n不涉及",
          "enum": [
            "UN_SAVED",
            "SAVE_AND_UN_APPLY",
            "MOVE_AND_UN_APPLY",
            "APPLYING",
            "FAIL_APPLY",
            "APPLIED"
          ]
        },
        "list": {
          "type": "array",
          "description": "文件配置列表",
          "items": {
            "$ref": "#/definitions/FileConfiguration"
          },
          "maxItems": 50,
          "minItems": 0
        },
        "node_id": {
          "type": "string",
          "example": "00000000-0000-0000-0000-000000000000",
          "description": "节点ID",
          "minLength": 0,
          "maxLength": 36
        },
        "node_name": {
          "type": "string",
          "description": "节点名称",
          "minLength": 0,
          "maxLength": 63
        },
        "specification": {
          "type": "string",
          "description": "规范",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "FileConfiguration": {
      "type": "object",
      "required": [
        "file_type",
        "param"
      ],
      "properties": {
        "file_name": {
          "type": "string",
          "description": "文件名称",
          "minLength": 0,
          "maxLength": 63
        },
        "file_type": {
          "$ref": "#/definitions/FileType"
        },
        "node_id": {
          "type": "string",
          "example": "909494e3-558e-46b6-a9eb-07a8e18ca621",
          "description": "节点ID",
          "minLength": 0,
          "maxLength": 36
        },
        "param": {
          "type": "object",
          "description": "参数",
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1024
          }
        },
        "type": {
          "type": "string",
          "description": "**参数解释**:\n配置类型\n- HISTORY 历史版本\n- CURRENT_SAVE 当前保存\n- CURRENT_APPLY 当前使用\n\n**约束限制**\n不涉及\n**取值范围**:\n- HISTORY\n- CURRENT_SAVE\n- CURRENT_APPLY\n\n**默认值**\n不涉及",
          "enum": [
            "HISTORY",
            "CURRENT_SAVE",
            "CURRENT_APPLY"
          ]
        }
      }
    },
    "ConfigurationInfoDto": {
      "type": "object",
      "properties": {
        "configuration": {
          "type": "array",
          "description": "节点配置信息",
          "items": {
            "$ref": "#/definitions/ConfigurationDetail"
          },
          "maxItems": 256,
          "minItems": 0
        }
      }
    },
    "FileType": {
      "type": "string",
      "description": "**参数解释**:\n文件类型\n- JVM JVM配置文件类型\n- LOG4J2 Log4j2日志配置文件类型\n- YML YAML配置文件类型\n\n**约束限制**\n不涉及\n**取值范围**:\n- JVM\n- LOG4J2\n- YML \n\n**默认值**\n不涉及",
      "enum": [
        "JVM",
        "LOG4J2",
        "YML"
      ]
    },
    "ResultResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "example": "数据获取失败",
          "description": "结果详情",
          "minLength": 0,
          "maxLength": 32
        },
        "result": {
          "type": "string",
          "example": "失败",
          "description": "结果",
          "minLength": 0,
          "maxLength": 32
        }
      }
    }
