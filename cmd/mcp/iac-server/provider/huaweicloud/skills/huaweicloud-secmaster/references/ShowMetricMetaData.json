          "minLength": 0,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "example": "Parameter error.",
          "description": "**参数解释**:\n错误描述\n**取值范围**:\n不涉及",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "description": "请求失败错误响应体"
    },
    "LayoutMetricFormat": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "description": "数据格式",
          "minLength": 1,
          "maxLength": 128
        },
        "display": {
          "type": "string",
          "description": "显示格式",
          "minLength": 1,
          "maxLength": 128
        },
        "display_param": {
          "type": "object",
          "description": "显示参数",
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          }
        },
        "data_param": {
          "type": "object",
          "description": "数据参数",
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          }
        }
      }
    },
    "ShowMetricMetaDataResponseBody": {
      "allOf": [
        {
          "$ref": "#/definitions/MetricMetaData"
        },
        {
          "type": "object",
          "required": [
            "metric_id"
          ],
          "properties": {
            "metric_id": {
              "type": "string",
              "example": "aaba0b018234425a80001db96b82568a",
              "description": "指标Id",
              "pattern": "[a-f0-9]{32}"
            }
          }
        }
      ]
    },
    "MetricMetaData": {
      "type": "object",
      "required": [
        "cache_ttl",
        "data_type",
        "metric_type",
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "TOP5",
          "description": "指标名称",
          "minLength": 1,
          "maxLength": 512
        },
        "id": {
          "type": "string",
          "example": "aaba0b018234425a80001db96b82568a",
          "description": "指标Id",
          "minLength": 1,
          "maxLength": 64
        },
        "metric_type": {
          "type": "string",
          "example": "LOGGING",
          "description": "指标类型, 当前仅支持创建日志类型指标",
          "minLength": 1,
          "maxLength": 64
        },
        "data_type": {
          "type": "string",
          "example": "STATISTICS",
          "description": "数据类型, 当前仅支持创建统计指标",
          "minLength": 1,
          "maxLength": 64
        },
        "metric_dimension": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "指标结果维度,0维:单个数字,2维:图表或表格,3+维:多标签图表, metric_type为DERIVED必填,其他类型选填(COMPOUND时必为0)",
          "minimum": 0,
          "maximum": 5
        },
        "cache_ttl": {
          "type": "integer",
          "format": "int64",
          "example": 10,
          "description": "缓存生命周期,单位s",
          "minimum": 0,
          "maximum": 86400
        },
        "report_period": {
          "type": "integer",
          "format": "int64",
          "example": 0,
          "description": "上报周期,埋点指标时必填,单位s",
          "minimum": 0,
          "maximum": 864000
        },
        "is_built_in": {
          "type": "boolean",
          "example": true,
          "description": "是否为系统指标"
        },
        "effective_column": {
          "type": "string",
          "example": "0:2",
          "description": "生效的列, 当有该参数时,使用指定列作为指标数据结果",
          "pattern": "\\d+:\\d+"
        },
        "max_query_range": {
          "type": "integer",
          "format": "int32",
          "example": 5,
          "description": "指标支持的最大检索范围,单位:天;复合指标时,数值为derived_metrics列表元素中最小值",
          "minimum": 0,
          "maximum": 864000
        },
        "derived_metrics": {
          "type": "array",
          "description": "衍生指标列表,非复合指标时只有一个元素,复合指标时,为各衍生指标的定义",
          "items": {
            "type": "object",
            "properties": {
              "metric_dimension": {
                "type": "integer",
                "format": "int32",
                "example": 0,
                "description": "衍生指标结果维度,0维:单个数字,2维:图表或表格,3+维:多标签图表",
                "minimum": 0,
                "maximum": 5
              },
              "max_query_range": {
                "type": "integer",
                "format": "int32",
                "example": 5,
                "description": "指标支持的最大检索范围,单位:天;",
                "minimum": 0,
                "maximum": 864000
              },
              "date_start": {
                "type": "string",
                "example": "now-7d",
                "description": "指标查询范围相对起始时间 datemath表达式",
                "pattern": "^((now)|(20))[+-][0-9]+[yMwdhHms](\\/[yMwdhHms]){0,1}$"
              },
              "date_end": {
                "type": "string",
                "example": "now-5d",
                "description": "指标查询范围相对截止时间 datemath表达式",
                "pattern": "^((now)|(20))[+-][0-9]+[yMwdhHms](\\/[yMwdhHms]){0,1}$"
              },
              "date_format": {
                "type": "string",
                "example": "yyyy-MM-dd'T'HH:mm:ss.SSSZ",
                "description": "时间格式,epoch_millis;epoch_second;yyyy-MM-dd'T'HH:mm:ss.SSSZ",
                "minLength": 4,
                "maxLength": 128
              },
              "query_type": {
                "type": "string",
                "example": "cbsl",
                "description": "获取指标结果方式,cbsl, api, dsl, sql",
                "enum": [
                  "cbsl",
                  " api",
                  " dsl",
                  " sql"
                ]
              },
              "query_function": {
                "type": "string",
                "example": "{\"dataspace_id\":\"3939573a-12a0-436f-b0e5-ab2872a1fde9\",\"pipe_id\":\"9db9d8a6-d9e6-4b32-990e-40f0afe4655d\",\"query\":\"* | select ack_pps, device_type as type\",\"sort\":\"desc\",\"from\":1663203171317,\"to\":1663204071317}",
                "minLength": 1,
                "maxLength": 65535
              }
            },
            "required": [
              "metric_dimension",
              "query_function",
              "query_type"
            ]
          },
          "maxItems": 16,
          "minItems": 1
        },
        "compound_expression": {
          "type": "string",
          "example": "($1+$3)/$2",
          "description": "metric_type为DERIVED时填写, 复合指标的表达式",
          "minLength": 1,
          "maxLength": 65535
        },
        "metric_format": {
          "type": "array",
          "description": "指标格式",
          "items": {
            "$ref": "#/definitions/LayoutMetricFormat"
          },
          "maxItems": 64,
          "minItems": 1
        },
        "metric_expand_dim": {
          "$ref": "#/definitions/MetricDimensionExpandParam"
        },
        "version": {
          "type": "string",
          "example": "23.9.0",
          "description": "安全云脑版本",
          "minLength": 32,
          "maxLength": 64
        }
      },
      "description": "指标元数据"
    }
  },
