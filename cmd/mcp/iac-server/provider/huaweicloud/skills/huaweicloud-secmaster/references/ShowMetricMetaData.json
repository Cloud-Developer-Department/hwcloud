  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces/{workspace_id}/soc/metrics/{metric_id}": {
      "get": {
        "tags": [
          "指标定义"
        ],
        "summary": "获取指标元数据",
        "description": "获取指标元数据",
        "operationId": "ShowMetricMetaData",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。[获取用户Token](secmaster_03_0010.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "content-type",
            "in": "header",
            "description": "**参数解释:**\n内容类型\n- application/json;charset=UTF-8    普通API请求的类型\n\n**约束限制:**\n不涉及\n**取值范围:**\n- application/json;charset=UTF-8\n\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "default": "application/json;charset=UTF-8",
            "maxLength": 64,
            "minLength": 0
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 32
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "**参数解释:**\n工作空间id。\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 32
          },
          {
            "name": "metric_id",
            "in": "path",
            "description": "指标ID",
            "required": true,
            "type": "string",
            "pattern": "[a-f0-9]{32}"
          }
        ],
        "responses": {
          "200": {
            "description": "响应成功",
            "examples": {
              "application/json": {
                "cache_ttl": 10,
                "data_type": "STATISTICS",
                "derived_metrics": [],
                "id": "b1f1e000-59d0-4030-bfb7-c4bff9c5ddb4",
                "is_built_in": false,
                "max_query_range": 5,
                "metric_dimension": 0,
                "metric_format": [],
                "metric_type": "LOGGING",
                "name": "name",
                "report_period": 0
              }
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID,格式为:request_uuid-timestamp-hostname"
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowMetricMetaDataResponseBody"
            }
          },
          "400": {
            "description": "错误响应",
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求ID,格式为:request_uuid-timestamp-hostname"
              }
            },
            "schema": {
              "$ref": "#/definitions/LayoutErrorRsp"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-surpport-apiexplorer": true,
        "x-surpport-hcs": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api"
      }
    }
  },
  "definitions": {
    "MetricDimensionExpandParam": {
      "type": "object",
      "required": [
        "functions",
        "labels"
      ],
      "properties": {
        "labels": {
          "type": "array",
          "example": [
            "level",
            "score"
          ],
          "description": "维度扩充标签",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 10,
          "minItems": 1
        },
        "functions": {
          "type": "array",
          "example": [
            "getLevel($1)",
            "getSuggestion($1)"
          ],
          "description": "维度扩充方法,填写指标数据面内置方法, 参数index从1开始",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 10,
          "minItems": 1
        }
      },
      "description": "指标维度扩充参数"
    },
    "LayoutErrorRsp": {
      "type": "object",
