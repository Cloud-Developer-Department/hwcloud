  "definitions": {
    "SubscriptionTag": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "example": "dept",
          "description": "键。\n最大长度36个字符。 字符集:A-Z,a-z , 0-9,‘-’,‘_’,UNICODE字符(\\一-\\鿿)",
          "minLength": 1,
          "maxLength": 36
        },
        "value": {
          "type": "string",
          "example": "dev",
          "description": "值。 最大长度43个字符,可以为空字符串。 字符集:A-Z,a-z , 0-9,‘.’,‘-’,‘_’,UNICODE字符(\\一-\\鿿)",
          "minLength": 0,
          "maxLength": 43
        }
      }
    },
    "UpdateOrderInfoReq": {
      "type": "object",
      "required": [
        "operate_type",
        "scene"
      ],
      "properties": {
        "scene": {
          "type": "string",
          "example": "PREPAID",
          "description": "操作场景,包周期场景:PREPAID 或者 按需场景:POSTPAID",
          "minLength": 2,
          "maxLength": 20,
          "enum": [
            "PREPAID",
            "POSTPAID"
          ]
        },
        "operate_type": {
          "type": "string",
          "example": "UPGRADE",
          "description": "按需或者包周期场景下,要进行的操作类型\n比如增减配额,规格升降配,按需转包周期\n规格升级:UPGRADE,配额增加:ADDITION,配额减少:DECREASE,按需转包周期:POSTPAID_2_PREPAID\n注:目前不支持规格降级,比如不支持从专业版降级为标准版或基础版",
          "minLength": 2,
          "maxLength": 10,
          "enum": [
            "UPGRADE",
            "ADDITION",
            "DECREASE",
            "POSTPAID_2_PREPAID"
          ]
        },
        "promotion_info": {
          "type": "string",
          "example": "0",
          "description": "促销折扣信息",
          "minLength": 2,
          "maxLength": 64
        },
        "tag_list": {
          "type": "array",
          "description": "计费标签",
          "items": {
            "$ref": "#/definitions/SubscriptionTag"
          },
          "maxItems": 20,
          "minItems": 0
        },
        "product_list": {
          "type": "array",
          "description": "要进行变更的商品列表",
          "items": {
            "$ref": "#/definitions/UpdateProduct"
          },
          "maxItems": 20,
          "minItems": 0
        }
      },
      "description": "云脑订单更新接口,包括包周期、按需场景,关联的变更场景"
    },
    "OrderInfoResp": {
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string",
          "example": "CS2510212051NLDL4",
          "description": "创建或变更订单ID,只有scene为PREPAID时返回有此数据",
          "minLength": 2,
          "maxLength": 64
        },
        "order_status": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "订单更新状态,1:变更订单成功,5,订单变更失败",
          "enum": [
            1,
            5
          ]
        }
      }
    },
    "UpdateProduct": {
      "type": "object",
      "required": [
        "resource_id",
        "resource_spec_code"
      ],
      "properties": {
        "resource_type": {
          "type": "string",
          "example": "xxx.resource.type.secmaster.typical",
          "description": "变更后的资源类型",
          "minLength": 2,
          "maxLength": 64
        },
        "resource_spec_code": {
          "type": "string",
          "example": "secmaster.professional",
          "description": "变更后的商品规格编码",
          "minLength": 2,
          "maxLength": 64
        },
        "resource_size": {
          "type": "integer",
          "example": 1,
          "description": "变更后的资源配额\n如果operate_type为addition时,resource_size必须要大于原来的resource_id,decrease时要小于原来的resource_size,并且大于等于当前project下的ecs数量",
          "minimum": 1,
          "maximum": 10000
        },
        "resource_id": {
          "type": "string",
          "example": "29862637-8c2f-4e99-a7bf-abb725500c25",
          "description": "要进行变更的资源ID",
          "minLength": 2,
          "maxLength": 64
        }
      }
    },
    "SubscriptionErrorResp": {
      "properties": {
        "error_code": {
          "type": "string",
          "example": "SecMaster.20040001",
          "description": "**参数解释**:\n错误码\n**取值范围**:\n不涉及",
          "minLength": 0,
          "maxLength": 64
        },
        "error_msg": {
          "type": "string",
          "example": "Parameter error.",
          "description": "**参数解释**:\n错误描述\n**取值范围**:\n不涉及",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "description": "请求失败错误响应体"
    }
  },
