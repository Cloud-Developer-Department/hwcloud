          "enum": [
            "ONLINE",
            "OFFLINE"
          ]
        },
        "heart_beat_time": {
          "type": "integer",
          "format": "int64",
          "description": "最后一次接收到心跳信号的时间",
          "minimum": 0,
          "maximum": 9223372036854775800
        },
        "memory_cache": {
          "type": "string",
          "description": "缓存数据的内存大小",
          "minLength": 0,
          "maxLength": 1024
        },
        "memory_count": {
          "type": "string",
          "description": "物理内存条数量",
          "minLength": 0,
          "maxLength": 1024
        },
        "memory_free": {
          "type": "string",
          "description": "当前空闲的物理内存量",
          "minLength": 0,
          "maxLength": 1024
        },
        "memory_shared": {
          "type": "string",
          "description": "多个进程共享使用的内存总量",
          "minLength": 0,
          "maxLength": 1024
        },
        "memory_usage": {
          "type": "string",
          "description": "已使用的物理内存量",
          "minLength": 0,
          "maxLength": 1024
        },
        "mini_on_online": {
          "type": "string",
          "description": "是否在线",
          "minLength": 1,
          "maxLength": 32
        },
        "read_rate": {
          "type": "string",
          "description": "磁盘读取速率",
          "minLength": 0,
          "maxLength": 1024
        },
        "up_pps": {
          "type": "string",
          "description": "上传数据包每秒数量",
          "minLength": 0,
          "maxLength": 1024
        },
        "write_rate": {
          "type": "string",
          "description": "磁盘写入速率",
          "minLength": 0,
          "maxLength": 1024
        }
