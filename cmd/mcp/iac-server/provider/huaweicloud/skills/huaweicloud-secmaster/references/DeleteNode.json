        },
        "vpc_endpoint_id": {
          "$ref": "#/definitions/VpcEndpointId"
        },
        "vpc_id": {
          "$ref": "#/definitions/IsapUuid"
        },
        "vpcep_service_ip": {
          "$ref": "#/definitions/IsapIpAddress"
        }
      }
    },
    "VpcEndpointAddress": {
      "type": "string",
      "minLength": 5,
      "maxLength": 63,
