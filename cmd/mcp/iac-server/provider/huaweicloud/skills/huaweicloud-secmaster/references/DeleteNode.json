      "example": "00000000-0000-0000-0000-000000000000"
    },
    "DeleteNodeResponseBody": {
      "properties": {
        "delete_fail_list": {
          "type": "array",
          "description": "删除失败列表",
          "items": {
            "$ref": "#/definitions/Node"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "delete_success_list": {
          "type": "array",
