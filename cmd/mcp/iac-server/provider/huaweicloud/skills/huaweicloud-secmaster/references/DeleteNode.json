      "required": [
        "delete_ids"
      ],
      "properties": {
        "delete_ids": {
          "type": "array",
          "description": "节点ID列表",
          "items": {
            "type": "string",
            "description": "节点ID",
            "minLength": 36,
            "maxLength": 36,
            "x-example": "560cc079-c8e2-47cf-bc62-ffcc2e1cb718"
          },
          "maxItems": 10,
          "minItems": 1
        }
      }
    },
    "Monitor": {
      "properties": {
        "cpu_idle": {
          "type": "string",
          "description": "CPU 空闲时间的百分比",
          "minLength": 0,
          "maxLength": 1024
        },
        "cpu_usage": {
          "type": "string",
          "description": "CPU 当前的使用率",
          "minLength": 0,
          "maxLength": 1024
        },
        "disk_count": {
          "type": "string",
          "description": "系统中磁盘设备的数量",
