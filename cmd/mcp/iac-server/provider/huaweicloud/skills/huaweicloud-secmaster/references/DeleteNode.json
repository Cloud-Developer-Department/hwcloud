    "IsapIpAddress": {
      "type": "string",
      "minLength": 7,
      "maxLength": 15,
      "pattern": "((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)",
      "description": "IP地址",
      "example": "0.0.0.0"
    },
    "IsapDomainName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "description": "所属租户名称",
      "example": "demo"
