{
  "name": "DeleteNode",
  "summary": "通过节点id删除节点",
  "tags": "节点管理",
  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces/{workspace_id}/nodes": {
      "delete": {
        "tags": [
          "节点管理"
        ],
        "summary": "通过节点id删除节点",
        "description": "删除节点",
        "operationId": "DeleteNode",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。[获取用户Token](secmaster_03_0010.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 32,
            "x-example": "156*******************341da6"
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "工作空间ID",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 0,
            "x-example": "458********************e64c3"
          },
          {
            "in": "body",
            "name": "DeleteNodeRequestBody",
            "description": "删除节点请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DeleteNodeRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "$ref": "#/definitions/DeleteNodeResponseBody"
            }
          },
          "400": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/IsapErrorRsp"
            }
          }
        },
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-surpport-hcs": "Y",
        "x-surpport-apiexplorer": "true",
        "x-api-service-plane": "Control-plane",
        "x-sec-data-level": "L1"
      }
    }
  },
  "definitions": {
    "IsapCommonDescription": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "描述信息",
      "example": "description"
    },
    "IsapTimeStamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775800,
      "format": "int64",
      "description": "毫秒时间戳",
      "example": 0
    },
    "IsapRegion": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1024,
      "description": "区域"
    },
