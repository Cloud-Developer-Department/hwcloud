{
  "name": "ExecuteReportAction",
  "summary": "操作安全报告",
  "tags": "安全报告",
  "productshort": "SecMaster",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/workspaces/{workspace_id}/sa/reports/{report_id}/action": {
      "post": {
        "tags": [
          "安全报告"
        ],
        "summary": "操作安全报告",
        "description": "操作安全报告",
        "operationId": "ExecuteReportAction",
        "produces": [
          "application/json",
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。[获取用户Token](secmaster_03_0010.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 2097152,
            "minLength": 0,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释:**\n项目ID,用于明确项目归属,配置后可通过该ID查询项目下资产,可以通过调用API获取,也可以从控制台获取。[获取项目ID](secmaster_03_0014.xml)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 32
          },
          {
            "name": "workspace_id",
            "in": "path",
            "description": "**参数解释:**\n工作空间id。\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "maxLength": 36,
            "minLength": 32
          },
          {
            "name": "report_id",
            "in": "path",
            "description": "报告ID",
            "required": true,
            "type": "string",
            "pattern": "[a-f0-9]{32}"
          },
          {
            "in": "body",
            "name": "ExecuteReportActionRequestBody",
            "description": "下载报告的请求",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ExecuteReportActionInfo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "下载文件",
            "examples": {
              "application/json": {
                "code": "00000000",
                "message": "success"
              }
            },
            "schema": {
              "$ref": "#/definitions/DownloadFileRsp"
            }
          },
          "400": {
            "description": "错误响应",
            "schema": {
              "$ref": "#/definitions/LayoutErrorRsp"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-surpport-apiexplorer": true,
        "x-surpport-hcs": "N",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-request-examples-description-1": "发送报告请求体",
        "x-request-examples-1": {
          "email_to": "xx@xxx.com",
          "report_page": "",
          "page_config": {
            "margin": {
              "top": 0,
              "left": 50,
              "bottom": 0,
              "right": 50
            },
            "width": 1612,
            "height": 730
          },
          "report_file_type": "word",
          "email_content": "content",
          "action": "download",
          "report_content": "123",
          "email_cc": "xx@xxx.com",
          "email_title": "tittle"
        }
      }
    }
  },
