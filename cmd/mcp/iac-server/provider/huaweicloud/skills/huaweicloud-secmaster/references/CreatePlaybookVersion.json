            "$ref": "#/definitions/ConditionItem"
          },
          "maxItems": 99,
          "minItems": 0
        },
        "logics": {
          "type": "array",
          "example": "['logic1', 'and', ['logic2', 'or', 'logic3'], 'or', 'logic4']",
          "description": "条件逻辑组合。事件触发剧本必填",
          "items": {
            "type": "string",
            "example": "condition_0",
            "description": "表达式类型。默认为common,事件触发剧本必填",
            "minLength": 0,
            "maxLength": 64
          },
          "maxItems": 99,
          "minItems": 0
        },
        "cron": {
          "type": "string",
          "example": "*/5 * * * * ?",
          "description": "Cron 表达式(定时任务)。定时触发剧本必填",
          "minLength": 0,
          "maxLength": 64
        },
        "schedule_type": {
          "type": "string",
          "example": "second",
          "description": "**参数解释:**\n定时重复类型(second--秒, hour--小时,day--天,week-周)。\n- second  秒\n- hour 小时\n- day 天\n- week 周\n\n**约束限制:**\n定时触发剧本必填\n**取值范围:**\n- second\n- hour\n- day\n- week\n\n**默认取值:**\n无",
          "minLength": 0,
          "maxLength": 64
        },
        "start_type": {
          "type": "string",
          "example": "IMMEDIATELY",
          "description": "**参数解释:**\n剧本开始执行类型\n- IMMEDIATELY 创建完成立即执行\n- CUSTOM 自定义执行时间\n\n**约束限制:**\n定时触发剧本必填\n**取值范围:**\n- IMMEDIATELY\n- CUSTOM\n\n**默认取值:**\n无",
          "minLength": 0,
          "maxLength": 64
        },
        "end_type": {
          "type": "string",
          "example": "FOREVER",
          "description": "**参数解释:**\n剧本结束执行类型\n- FOREVER 一直执行\n- CUSTOM 自定义结束时间\n\n**约束限制:**\n定时触发剧本必填\n**取值范围:**\n- FOREVER\n- CUSTOM\n\n**默认取值:**\n无",
          "minLength": 0,
          "maxLength": 64
        },
        "end_time": {
          "type": "string",
          "example": "2021-01-30T23:00:00Z+0800",
          "description": "定时结束时间。定时触发剧本必填",
          "minLength": 0,
          "maxLength": 64
        },
        "start_time": {
          "type": "string",
          "example": "2021-01-30T23:00:00Z+0800",
          "description": "定时开始时间。定时触发剧本必填",
          "minLength": 0,
          "maxLength": 64
        },
        "repeat_range": {
          "type": "string",
          "example": "2021-01-30T23:00:00Z+0800~2021-01-30T23:00:00Z+0800",
