    "ConditionInfo": {
      "properties": {
        "expression_type": {
          "type": "string",
          "example": "common",
          "description": "**参数解释:**\n表达式类型\n- common  通用表达式\n\n**约束限制:**\n事件触发剧本必填\n**取值范围:**\n- common\n\n**默认取值:**\ncommon",
          "minLength": 0,
          "maxLength": 64
        },
        "conditions": {
          "type": "array",
          "description": "触发条件。事件触发剧本必填",
