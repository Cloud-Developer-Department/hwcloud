            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "minLength": 32,
            "maxLength": 64,
            "type": "string",
            "description": "项目ID。",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          }
        ],
        "responses": {
          "200": {
            "description": "租户的凭据检测配置响应体。",
            "schema": {
              "$ref": "#/definitions/CheckSecretsConfigResponseBody"
            }
          },
          "400": {
            "description": "请求参数有误。",
            "schema": {
