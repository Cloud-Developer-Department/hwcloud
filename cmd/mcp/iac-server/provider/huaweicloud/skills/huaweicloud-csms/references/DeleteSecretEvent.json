{
  "name": "DeleteSecretEvent",
  "summary": "立即删除事件",
  "tags": "事件管理",
  "productshort": "CSMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/csms/events/{event_name}": {
      "delete": {
        "tags": [
          "事件管理"
        ],
        "operationId": "DeleteSecretEvent",
        "summary": "立即删除事件",
        "description": "立即删除指定的事件,且无法恢复。如事件存在凭据引用,则无法删除,请先解除关联。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-constraint": "调用此接口删除指定凭据后,不可恢复。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "event_name",
            "in": "path",
            "description": "事件通知的名称。",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "required": true,
            "x-example": "event-name-test"
          }
        ],
        "responses": {
          "204": {
