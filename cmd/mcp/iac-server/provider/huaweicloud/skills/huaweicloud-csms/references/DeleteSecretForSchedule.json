{
  "name": "DeleteSecretForSchedule",
  "summary": "创建凭据的定时删除任务",
  "tags": "生命周期管理",
  "productshort": "CSMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/secrets/{secret_name}/scheduled-deleted-tasks/create": {
      "post": {
        "x-request-examples-description-1": "创建凭据定时删除任务,15天后进行删除。",
        "x-request-examples-text-1": {
          "recovery_window_in_days": 15
        },
        "tags": [
          "生命周期管理"
        ],
        "operationId": "DeleteSecretForSchedule",
        "summary": "创建凭据的定时删除任务",
        "description": "指定延迟删除时间,创建删除凭据的定时任务,可设置7~30天的的延迟删除时间。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-constraint": "处于“定时删除”状态的凭据对象无法更新元数据信息,也无法查看凭据值。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "secret_name",
            "in": "path",
            "description": "凭据名称。",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "required": true,
            "x-example": "secret-name-test"
          },
          {
            "in": "body",
            "name": "DeleteSecretForScheduleRequestBody",
            "description": "计划删除凭据请求消息体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DeleteSecretForScheduleRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "examples": {
              "application/json": {
                "secret": {
                  "id": "bb6a3d22-dc93-47ac-b5bd-88df7ad35f1e",
                  "name": "test",
                  "state": "ENABLED",
                  "kms_key_id": "b168fe00ff56492495a7d22974df2d0b",
                  "description": "description",
                  "create_time": 1581507580000,
                  "update_time": 1581507580000,
                  "scheduled_delete_time": 1581507580000
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/SecretResponseBody"
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-request-examples-1": {
          "recovery_window_in_days": 15
        }
      }
    }
  },
  "definitions": {
    "SecretResponseBody": {
      "properties": {
        "secret": {
          "$ref": "#/definitions/Secret"
        }
      },
      "type": "object"
    },
    "Secret": {
      "description": "凭据对象。",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$",
          "description": "凭据的资源标识符。",
          "example": "2d1152f2-290d-4756-a1d2-e12c14992416"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "凭据名称。",
          "example": "demo"
        },
        "state": {
          "type": "string",
          "minLength": 4,
          "maxLength": 8,
          "description": "凭据状态,取值如下:\n\nENABLED:表示启用状态\n\nDISABLED:表示禁用状态\n\nPENDING_DELETE:表示待删除状态\n\nFROZEN:表示冻结状态",
          "example": 1
        },
        "kms_key_id": {
          "type": "string",
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$",
          "description": "用于加密凭据值的KMS主密钥的ID值。",
          "example": "0d0466b0-e727-4d9c-b35d-f84bb474a37f"
        },
        "description": {
          "type": "string",
          "description": "凭据的描述信息。",
          "minLength": 0,
          "maxLength": 255,
          "example": "凭据的描述。"
        },
        "create_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "凭据创建时间,时间戳,即从1970年1月1日至该时间的总秒数。",
          "example": 1581507580000
        },
        "update_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "凭据上次更新时间,时间戳,即从1970年1月1日至该时间的总秒数。",
          "example": 1581507580000
        },
        "scheduled_delete_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "凭据计划删除时间,时间戳,即从1970年1月1日至该时间的总秒数。\n\n凭据不在删除计划中时,本项值为null。",
          "example": 1581507580000
        },
        "secret_type": {
          "type": "string",
          "description": "凭据类型\n\n- COMMON:通用凭据(默认)。用于应用系统中的各种敏感信息储存。\n- RDS:RDS凭据 。专门针对RDS的凭据,用于存储RDS的账号信息。(已不支持,使用RDS-FG替代)\n- RDS-FG:RDS凭据 。专门针对RDS的凭据,用于存储RDS的账号信息。\n- GaussDB-FG:TaurusDB凭据。专门针对TaurusDB的凭据,用于存储TaurusDB的账号信息。",
          "example": "COMMON",
          "enum": [
            "COMMON",
            "RDS-FG",
            "GaussDB-FG"
          ]
        },
        "auto_rotation": {
          "type": "boolean",
          "description": "自动轮转\n\n取值:true 开启, false 关闭(默认)",
          "example": "this is a demo secret auto rotation"
        },
        "rotation_period": {
          "type": "string",
          "description": "轮转周期\n\n约束:6小时-8,760小时 (365天)\n\n类型:Integer[unit] ,Integer表示时间长度 。unit表示时间单位,d(天)、h(小时)、m(分钟)、s(秒)。例如 1d 表示一天,24h也表示一天\n\n说明:当开启自动轮转时,必须填写该值",
          "minLength": 0,
          "maxLength": 50,
          "example": "this is a demo secret rotation period"
        },
        "rotation_config": {
          "type": "string",
          "description": "轮转配置\n\n约束:范围不超过1024个字符。\n\n当secret_type为RDS-FG、GaussDB-FG时,配置为{\"InstanceId\":\"\",\"SecretSubType\":\"\"}\n\n说明:当secret_type为RDS-FG、GaussDB-FG时,必须填写该值\n\nInstanceId为实例ID,SecretSubType为轮转子类型,取值为:SingleUser,MultiUser。\n\nSingleUser:指定轮转类型为单用户模式轮转,每次轮转将指定账号重置为新的口令。\n\nMultiUser:指定轮转类型为双用户模式轮转,SYSCURRENT和SYSPREVIOUS分别引用其中一个账号。凭据轮转时,SYSPREVIOUS引用的账号口令会被重置为新的随机口令,随后凭据交换SYSCURRENT和SYSPREVIOUS对账号的引用。",
          "minLength": 0,
          "maxLength": 1024,
          "example": {
            "InstanceId": "63616bceef2c45409575d762a498318bin01",
            "SecretSubType": "MultiUser"
          }
        },
        "rotation_time": {
          "format": "int64",
          "type": "integer",
          "description": "轮转时间戳",
          "minimum": 0,
          "maximum": 13,
          "example": 1679488984000
        },
        "next_rotation_time": {
          "format": "int64",
          "type": "integer",
          "description": "下一次轮转时间戳",
          "minimum": 0,
          "maximum": 13,
          "example": "this is a demo secret next rotation time"
        },
        "event_subscriptions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1,
          "description": "凭据订阅的事件列表,当前最大可订阅一个事件。当事件包含的基础事件触发时,通知消息将发送到事件对应的通知主题。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 32,
            "description": "基础事件类型。"
          },
          "example": "pocEvent"
        },
        "enterprise_project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "企业项目ID",
          "example": 0
        },
        "rotation_func_urn": {
          "type": "string",
          "description": "FunctionGraph函数的urn。",
          "example": "urn:fss:{region}:46b6f338fc3445b8846c71dfb1fbxxxx:function:default:test2-0:latest"
        }
      },
      "type": "object"
    },
    "DeleteSecretForScheduleRequestBody": {
      "required": [
        "recovery_window_in_days"
      ],
      "properties": {
        "recovery_window_in_days": {
          "format": "int32",
          "type": "integer",
          "minimum": 7,
          "maximum": 30,
          "description": "创建定时删除凭据的任务,且指定可恢复的天数。\n\n约束:7~30。\n\n默认值:30。",
          "example": 15
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "CSMS.XXXX"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "XXXX"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}