  "definitions": {
    "ActionResources": {
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "资源ID。"
        },
        "resource_detail": {
          "$ref": "#/definitions/Secret"
        },
        "resource_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "资源名称,默认为空字符串。"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "description": "标签列表,没有标签,数组默认为空。",
          "items": {
            "$ref": "#/definitions/TagItem"
          }
        },
        "sys_tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SysTag"
          },
          "description": "系统标签列表,没有标签,数组默认为空"
        }
      },
      "type": "object"
    },
    "ListResourceInstancesRequestBody": {
      "properties": {
        "limit": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4,
          "description": "查询记录数(“action”为“count”时,无需设置此参数),如果“action”为“filter”,默认为“10”。\nlimit的取值范围为“1-1000”。"
        },
        "offset": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4,
          "description": "索引位置。从offset指定的下一条数据开始查询。查询第一页数据时,将查询前一页数据时响应体中的值带入此参数(“action”为“count”时,无需设置此参数)。如果“action”为“filter”,offset默认为“0”。\noffset必须为数字,不能为负数。"
        },
        "action": {
          "type": "string",
          "minLength": 5,
          "maxLength": 6,
          "description": "操作标识(可设置为“filter”或者“count”)。\n - filter:表示过滤。\n - count:表示查询总条数。"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "description": "标签列表,key和value键值对的集合。最多不超过10个。",
          "items": {
            "$ref": "#/definitions/Tag"
          }
        },
        "matches": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "description": "搜索字段。\n - key为搜索的字段,目前仅支持搜索凭据名称,值为“resource_name”。\n - value为模糊匹配的值,最大长度为255个字符。为空返回空值。",
          "items": {
            "$ref": "#/definitions/TagMatches"
          }
        },
        "sequence": {
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "description": "请求消息序列号,36字节序列号。\n例如:919c82d4-8046-4722-9094-35c3c6524cff"
        }
      },
      "type": "object",
      "required": [
        "action"
      ]
    },
    "Tag": {
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "标签键。"
        },
        "values": {
          "type": "array",
          "description": "标签值集合。\n\n约束:最多包含10个value。标签列表中的标签value值不允许重复。标签列表如果为空列表,表示匹配任意值。标签列表中多个value之间是“或”的关系,在key已经满足要求的前提下,满足请求中的某个value就会匹配出来。",
          "items": {
            "minLength": 0,
            "maxLength": 255,
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 10
        }
      },
      "type": "object"
    },
    "SysTag": {
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "标签键。"
        },
        "value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "标签值。"
        }
      },
      "type": "object"
    },
    "Secret": {
      "description": "凭据对象。",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$",
          "description": "凭据的资源标识符。",
          "example": "2d1152f2-290d-4756-a1d2-e12c14992416"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "凭据名称。",
          "example": "demo"
        },
        "state": {
          "type": "string",
          "minLength": 4,
          "maxLength": 8,
          "description": "凭据状态,取值如下:\n\nENABLED:表示启用状态\n\nDISABLED:表示禁用状态\n\nPENDING_DELETE:表示待删除状态\n\nFROZEN:表示冻结状态",
          "example": 1
        },
        "kms_key_id": {
          "type": "string",
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$",
          "description": "用于加密凭据值的KMS主密钥的ID值。",
          "example": "0d0466b0-e727-4d9c-b35d-f84bb474a37f"
        },
        "description": {
          "type": "string",
          "description": "凭据的描述信息。",
          "minLength": 0,
          "maxLength": 255,
          "example": "凭据的描述。"
        },
        "create_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "凭据创建时间,时间戳,即从1970年1月1日至该时间的总秒数。",
          "example": 1581507580000
        },
        "update_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "凭据上次更新时间,时间戳,即从1970年1月1日至该时间的总秒数。",
          "example": 1581507580000
        },
        "scheduled_delete_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "凭据计划删除时间,时间戳,即从1970年1月1日至该时间的总秒数。\n\n凭据不在删除计划中时,本项值为null。",
          "example": 1581507580000
        },
        "secret_type": {
          "type": "string",
          "description": "凭据类型\n\n- COMMON:通用凭据(默认)。用于应用系统中的各种敏感信息储存。\n- RDS:RDS凭据 。专门针对RDS的凭据,用于存储RDS的账号信息。(已不支持,使用RDS-FG替代)\n- RDS-FG:RDS凭据 。专门针对RDS的凭据,用于存储RDS的账号信息。\n- GaussDB-FG:TaurusDB凭据。专门针对TaurusDB的凭据,用于存储TaurusDB的账号信息。",
          "example": "COMMON",
          "enum": [
            "COMMON",
            "RDS-FG",
            "GaussDB-FG"
          ]
        },
        "auto_rotation": {
          "type": "boolean",
          "description": "自动轮转\n\n取值:true 开启, false 关闭(默认)",
          "example": "this is a demo secret auto rotation"
        },
        "rotation_period": {
          "type": "string",
          "description": "轮转周期\n\n约束:6小时-8,760小时 (365天)\n\n类型:Integer[unit] ,Integer表示时间长度 。unit表示时间单位,d(天)、h(小时)、m(分钟)、s(秒)。例如 1d 表示一天,24h也表示一天\n\n说明:当开启自动轮转时,必须填写该值",
          "minLength": 0,
          "maxLength": 50,
          "example": "this is a demo secret rotation period"
        },
        "rotation_config": {
          "type": "string",
          "description": "轮转配置\n\n约束:范围不超过1024个字符。\n\n当secret_type为RDS-FG、GaussDB-FG时,配置为{\"InstanceId\":\"\",\"SecretSubType\":\"\"}\n\n说明:当secret_type为RDS-FG、GaussDB-FG时,必须填写该值\n\nInstanceId为实例ID,SecretSubType为轮转子类型,取值为:SingleUser,MultiUser。\n\nSingleUser:指定轮转类型为单用户模式轮转,每次轮转将指定账号重置为新的口令。\n\nMultiUser:指定轮转类型为双用户模式轮转,SYSCURRENT和SYSPREVIOUS分别引用其中一个账号。凭据轮转时,SYSPREVIOUS引用的账号口令会被重置为新的随机口令,随后凭据交换SYSCURRENT和SYSPREVIOUS对账号的引用。",
          "minLength": 0,
          "maxLength": 1024,
          "example": {
            "InstanceId": "63616bceef2c45409575d762a498318bin01",
            "SecretSubType": "MultiUser"
          }
        },
        "rotation_time": {
          "format": "int64",
          "type": "integer",
          "description": "轮转时间戳",
          "minimum": 0,
          "maximum": 13,
          "example": 1679488984000
        },
        "next_rotation_time": {
          "format": "int64",
          "type": "integer",
          "description": "下一次轮转时间戳",
          "minimum": 0,
          "maximum": 13,
          "example": "this is a demo secret next rotation time"
        },
        "event_subscriptions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1,
          "description": "凭据订阅的事件列表,当前最大可订阅一个事件。当事件包含的基础事件触发时,通知消息将发送到事件对应的通知主题。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 32,
            "description": "基础事件类型。"
          },
          "example": "pocEvent"
        },
        "enterprise_project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "企业项目ID",
          "example": 0
        },
        "rotation_func_urn": {
          "type": "string",
          "description": "FunctionGraph函数的urn。",
          "example": "urn:fss:{region}:46b6f338fc3445b8846c71dfb1fbxxxx:function:default:test2-0:latest"
        }
      },
      "type": "object"
    },
    "Error": {
      "properties": {
        "error": {
          "$ref": "#/definitions/ErrorDetail",
          "description": "错误信息返回体。"
        }
      },
      "type": "object"
    },
    "TagItem": {
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "标签的名称。\n同一个凭据,一个标签键只能对应一个标签值;不同的凭据可以使用相同的标签键。\n用户最多可以给单个凭据添加20个标签。\n\n约束:取值范围为1到128个字符,满足正则匹配\"^((?!\\\\s)(?!_sys_)[\\\\p{L}\\\\p{Z}\\\\p{N}_.:=+\\\\-@]*)(?<!\\\\s)$\""
        },
        "value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "标签的值。\n\n约束:取值范围不超过255个字符,满足正则匹配\"^([\\\\p{L}\\\\p{Z}\\\\p{N}_.:\\\\/=+\\\\-@]*)$\""
        }
      },
      "type": "object",
      "required": [
        "key"
      ]
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    },
    "TagMatches": {
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "为要匹配的字段。\n约束:值只能为resource_name。",
          "pattern": "resource_name"
        },
        "value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "模糊匹配的值。\n\n约束:最大长度为255个字符,为空返回空值。"
        }
      },
      "type": "object"
    },
    "ListResourceByTagsResponse": {
      "properties": {
        "resources": {
          "description": "资源实例列表,详情请参见resource字段数据结构说明。",
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/ActionResources"
          }
        },
        "total_count": {
          "type": "integer",
          "description": "总记录数。",
          "format": "int32",
          "minimum": 0,
          "maximum": 100
        }
      },
      "type": "object"
    }
  },
