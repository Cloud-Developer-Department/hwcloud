{
  "name": "ListNotificationRecords",
  "summary": "查询已触发的事件通知记录",
  "tags": "事件管理",
  "productshort": "CSMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/csms/notification-records": {
      "get": {
        "tags": [
          "事件管理"
        ],
        "operationId": "ListNotificationRecords",
        "summary": "查询已触发的事件通知记录",
        "description": "查询三个月内所有已触发的事件通知记录。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-constraint": "仅保存三个月以内的事件通知记录。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "examples": {
              "application/json": {
                "records": [
                  {
                    "event_name": "demo-event",
                    "trigger_event_type": "SECRET_VERSION_EXPIRED",
                    "create_time": 1581507580000,
                    "secret_name": "demo-secret",
                    "secret_type": "COMMON",
                    "notification_target_name": "SecertExpirationNotificationTest",
                    "notification_target_id": "urn:smn:cn-north-4:SecertExpirationTest",
                    "notification_content": "{\"eventName\":\"TestEvent20221112\",\"eventType\":\"SECRET_VERSION_EXPIRED\",\"eventTime\":\"2023-04-14T20:25:10.126Z\",\"data\":{\"secretId\":\"fde3d6ba-cb31-40b0-b6c4-78757050f8c8\",\"secretName\":\"Secret20230325\",\"createTime\":\"2023-03-22T20:43:04.000Z\",\"updateTime\":\"2023-04-14T20:18:29.000Z\",\"versionId\":\"v18\",\"versionExpireTime\":\"2023-03-29T17:07:23.000Z\"}}",
                    "notification_status": "SUCCESS"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListEventNotifyRecordsResponseBody"
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "PageInfo": {
      "description": "分页信息。",
      "properties": {
        "next_marker": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "下一页查询地址(本页的末尾凭据名称,下一页起始凭据名称)。",
          "example": "secret-name-test"
        },
        "previous_marker": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "本页的起始凭据名称,上一页末尾凭据名称。",
          "example": "secret-name-test"
        },
        "current_count": {
          "format": "int32",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "本页返回条目数量。",
          "example": 1000
        }
      }
    },
    "ListEventNotifyRecordsResponseBody": {
      "properties": {
        "records": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "description": "Record对象。",
          "items": {
            "$ref": "#/definitions/Record"
          }
        },
        "page_info": {
          "$ref": "#/definitions/PageInfo"
        }
      }
    },
    "Error": {
      "properties": {
        "error": {
          "$ref": "#/definitions/ErrorDetail",
          "description": "错误信息返回体。"
        }
      },
      "type": "object"
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    },
    "Record": {
      "description": "事件通知记录。",
      "properties": {
        "event_name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "凭据名称。",
          "example": "demo-secret"
        },
        "trigger_event_type": {
          "type": "string",
          "description": "事件类型。\n- SECRET_VERSION_CREATED:版本创建\n- SECRET_VERSION_EXPIRED:版本过期\n- SECRET_ROTATED:凭据轮转成功\n- SECRET_DELETED:凭据删除\n- SECRET_ROTATED_FAILED:凭据轮转失败",
          "example": "SECRET_VERSION_CREATED",
          "enum": [
            "SECRET_VERSION_CREATED",
            "SECRET_VERSION_EXPIRED",
            "SECRET_ROTATED",
            "SECRET_DELETED",
            "SECRET_ROTATED_FAILED"
          ]
        },
        "create_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "事件通知记录的创建时间,时间戳,即从1970年1月1日至该时间的总秒数。",
          "example": 1581507580000
        },
        "secret_name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "凭据名称。",
          "example": "demo"
        },
        "secret_type": {
          "type": "string",
          "description": "凭据类型\n\n- COMMON:通用凭据(默认)。用于应用系统中的各种敏感信息储存。\n- RDS:RDS凭据 。专门针对RDS的凭据,用于存储RDS的账号信息。(已不支持,使用RDS-FG替代)\n- RDS-FG:RDS凭据 。专门针对RDS的凭据,用于存储RDS的账号信息。\n- GaussDB-FG:TaurusDB凭据。专门针对TaurusDB的凭据,用于存储TaurusDB的账号信息。",
          "example": "COMMON",
          "enum": [
            "COMMON",
            "RDS-FG",
            "GaussDB-FG"
          ]
        },
        "notification_target_name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "事件通知的对象名称。",
          "example": "test-poc"
        },
        "notification_target_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9\\-._:]{1,256}$",
          "description": "事件通知的对象ID。",
          "example": "urn:smn:cn-north-4:dc3b7c857ccc91da17423c0f2068:test-poc"
        },
        "notification_content": {
          "type": "string",
          "description": "事件通知的内容。",
          "minLength": 0,
          "maxLength": 255,
          "example": {
            "eventName": "TestEvent20221112",
            "eventType": "SECRET_VERSION_EXPIRED",
            "eventTime": "2023-03-29T21:00:42.308Z",
            "data": {
              "secretId": "fde3d6ba-cb31-40b0-b6c4-78757050f8c8",
              "secretName": "Secret20230325",
              "createTime": "2023-03-22T20:43:04.000Z",
              "updateTime": "2023-03-29T17:02:13.000Z",
              "versionId": "v1",
              "versionExpireTime": "2023-03-27T22:28:21.000Z"
            }
          }
        },
        "notification_status": {
          "type": "string",
          "description": "事件通知状态。\n\n- SUCCESS:事件通知成功。\n- FAIL:事件通知失败。\n- INVALID:事件通知配置主题信息无效或不正确,无法触发通知。",
          "example": "SUCCESS",
          "enum": [
            "SUCCESS",
            "FAIL",
            "INVALID"
          ]
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}