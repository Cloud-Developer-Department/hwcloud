{
  "name": "ListSecretVersions",
  "summary": "查询凭据的版本列表",
  "tags": "凭据版本管理",
  "productshort": "CSMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/secrets/{secret_name}/versions": {
      "get": {
        "tags": [
          "凭据版本管理"
        ],
        "operationId": "ListSecretVersions",
        "summary": "查询凭据的版本列表",
        "description": "查询指定凭据下的版本列表信息。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-constraint": "此接口返回的信息为凭据版本的元数据信息,不包含凭据值。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "secret_name",
            "in": "path",
            "description": "凭据名称。",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "required": true,
            "x-example": "secret-name-test"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "分页参数,取值为上一页数据的最后一条记录的版本号。",
            "type": "string",
            "pattern": "v[0-9]{1,10}|latest",
            "required": false,
            "x-example": "v10"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量。默认值50。",
            "type": "integer",
            "required": false,
            "x-example": "10",
            "maximum": 1000,
            "minimum": 1
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "examples": {
              "application/json": {
                "version_metadatas": [
                  {
                    "id": "v1",
                    "kms_key_id": "b168fe00ff56492495a7d22974df2d0b",
                    "create_time": 1581507580000,
                    "secret_name": "secret-name-demo",
                    "version_stages": [
                      "SYSCURRENT"
                    ]
                  }
                ],
                "page_info": {
                  "next_marker": "v10",
                  "previous_marker": "v1",
                  "current_count": 10
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ListSecretVersionsResponseBody"
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-order": 1
      }
    }
  },
  "definitions": {
    "VersionMetadata": {
      "description": "凭据版本被标记的状态。",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "v[0-9]{1,10}",
          "description": "凭据的版本号标识符,凭据对象下唯一。",
          "example": "v1"
        },
        "create_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "凭据版本创建时间,时间戳,即从1970年1月1日至该时间的总秒数。",
          "example": 1581507580000
        },
        "expire_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "凭据版本过期时间,时间戳,即从1970年1月1日至该时间的总秒数。默认为空,凭据订阅“版本过期”事件类型时,有效期判断所依据的值。",
          "example": 1581507580000
        },
        "kms_key_id": {
          "type": "string",
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$",
          "description": "加密版本凭据值的KMS主密钥ID。",
          "example": "0d0466b0-e727-4d9c-b35d-f84bb474a37f"
        },
        "secret_name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "凭据名称。",
          "example": "demo"
        },
        "version_stages": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "description": "凭据版本被标记的状态列表。每个版本标签对于凭据对象下版本是唯一存在的,如果创建版本时,指定的是同一凭据对象下的一个已经标记在其他版本上的状态,该标签将自动从其他版本上删除,并附加到此版本上。\n\n如果未指定version_stage的值,则凭据管理服务会自动移动临时标签SYSCURRENT到此新版本。",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "凭据版本在存入时需要被同时标记的版本状态。"
          }
        }
      },
      "type": "object"
    },
    "PageInfo": {
      "description": "分页信息。",
      "properties": {
        "next_marker": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "下一页查询地址(本页的末尾凭据名称,下一页起始凭据名称)。",
          "example": "secret-name-test"
        },
        "previous_marker": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "本页的起始凭据名称,上一页末尾凭据名称。",
          "example": "secret-name-test"
        },
        "current_count": {
          "format": "int32",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "本页返回条目数量。",
          "example": 1000
        }
      }
    },
    "ListSecretVersionsResponseBody": {
      "properties": {
        "version_metadatas": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "description": "version_metadata对象。",
          "items": {
            "$ref": "#/definitions/VersionMetadata"
          }
        },
        "page_info": {
          "$ref": "#/definitions/PageInfo"
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "CSMS.XXXX"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "XXXX"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}