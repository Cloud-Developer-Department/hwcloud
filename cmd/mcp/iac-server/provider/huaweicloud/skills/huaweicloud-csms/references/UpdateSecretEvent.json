{
  "name": "UpdateSecretEvent",
  "summary": "更新事件",
  "tags": "事件管理",
  "productshort": "CSMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/csms/events/{event_name}": {
      "put": {
        "x-request-examples-description-1": "更新指定事件。",
        "x-request-examples-text-1": {
          "notification": {
            "target_type": "SMN",
            "target_id": "demo-smn-id",
            "target_name": "demo-smn-name"
          }
        },
        "tags": [
          "事件管理"
        ],
        "operationId": "UpdateSecretEvent",
        "summary": "更新事件",
        "description": "更新指定事件的元数据信息。支持更新的元数据包含事件启用状态、基础类型列表、通知主题。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-constraint": "此接口仅能修改凭据事件通知的元数据信息。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "event_name",
            "in": "path",
            "description": "事件通知名称。",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "required": true,
            "x-example": "event-name-test"
          },
          {
            "in": "body",
            "name": "UpdateSecretEventRequestBody",
            "description": "更新事件通知的请求消息体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateSecretEventRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "examples": {
              "application/json": {
                "event": {
                  "name": "event-test",
                  "event_id": "bb6a3d22-dc93-47ac-b5bd-88df7ad35f1e",
                  "state": "ENABLED",
                  "event_types": [
                    "SECRET_VERSION_EXPIRED"
                  ],
                  "create_time": 1581507580000,
                  "update_time": 1581507580000,
                  "notification": {
                    "target_type": "SMN",
                    "target_id": "urn:smn:cn-north-4:SecertExpirationTest",
                    "target_name": "SecertExpirationNotificationTest"
                  }
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/SecretEventResponseBody"
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "x-request-examples-1": {
          "notification": {
            "target_type": "SMN",
            "target_id": "demo-smn-id",
            "target_name": "demo-smn-name"
          }
        }
      }
    }
  },
  "definitions": {
    "Notification": {
      "description": "通知主题对象。",
      "required": [
        "target_type",
        "target_id",
        "target_name"
      ],
      "properties": {
        "target_type": {
          "type": "string",
          "pattern": "^SMN$",
          "description": "事件通知的对象类型。",
          "example": "SMN"
        },
        "target_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9\\-._:]{1,256}$",
          "description": "事件通知的对象ID。",
          "example": "urn:smn:cn-north-4:dc3b7c85759141accc0f2068:test-poc"
        },
        "target_name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "事件通知的对象名称。",
          "example": "test-poc"
        }
      },
      "type": "object"
    },
    "Error": {
      "properties": {
        "error": {
          "$ref": "#/definitions/ErrorDetail",
          "description": "错误信息返回体。"
        }
      },
      "type": "object"
    },
    "Event": {
      "description": "事件通知对象。",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "事件通知名称。",
          "example": "demo"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$",
          "description": "事件通知的资源标识符。",
          "example": "2d1152f2-290d-4756-a1d2-e12c14992416"
        },
        "event_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "description": "设置事件的基础事件类型列表,。\n\n约束:数组大小:最小1,最大12。",
          "items": {
            "type": "string",
            "description": "本次事件通知的基础事件列表,基础事件类型如下。\n\nSECRET_VERSION_CREATED:版本创建\nSECRET_VERSION_EXPIRED:版本过期\nSECRET_ROTATED:凭据轮转\nSECRET_DELETED:凭据删除\n\n列表包含的基础事件类型不能重复。",
            "enum": [
              "SECRET_VERSION_CREATED",
              "SECRET_VERSION_EXPIRED",
              "SECRET_ROTATED",
              "SECRET_DELETED",
              "SECRET_ROTATED_FAILED"
            ]
          },
          "example": "eventDemo"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "description": "事件通知状态,取值如下。\n\nENABLED:表示启用状态\nDISABLED:表示禁用状态",
          "enum": [
            "ENABLED",
            "DISABLED"
          ],
          "example": "ENABLED"
        },
        "create_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "事件通知创建时间,时间戳,即从1970年1月1日至该时间的总秒数。",
          "example": 1581507580000
        },
        "update_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "事件通知上次更新时间,时间戳,即从1970年1月1日至该时间的总秒数。",
          "example": 1581507580000
        },
        "notification": {
          "$ref": "#/definitions/Notification"
        }
      },
      "type": "object"
    },
    "SecretEventResponseBody": {
      "properties": {
        "event": {
          "$ref": "#/definitions/Event"
        }
      }
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    },
    "UpdateSecretEventRequestBody": {
      "description": "更新凭据事件通知请求体。",
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "description": "事件通知状态,取值如下。\n\nENABLED:表示启用状态\nDISABLED:表示禁用状态",
          "enum": [
            "ENABLED",
            "DISABLED"
          ]
        },
        "event_types": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "description": "本次事件通知的基础事件列表,基础事件类型如下。\n\n- SECRET_VERSION_CREATED:版本创建\n- SECRET_VERSION_EXPIRED:版本过期\n- SECRET_ROTATED:凭据轮转成功\n- SECRET_DELETED:凭据删除\n- SECRET_ROTATED_FAILED:凭据轮转失败\n\n列表包含的基础事件类型不能重复。",
          "items": {
            "type": "string",
            "description": "基础事件类型。",
            "example": "SECRET_VERSION_CREATED",
            "enum": [
              "SECRET_VERSION_CREATED",
              "SECRET_VERSION_EXPIRED",
              "SECRET_ROTATED",
              "SECRET_DELETED",
              "SECRET_ROTATED_FAILED"
            ]
          },
          "example": "[\"SECRET_VERSION_CREATED\",\"SECRET_VERSION_EXPIRED\",\"SECRET_ROTATED\",\"SECRET_ROTATED_FAILED\"]"
        },
        "notification": {
          "$ref": "#/definitions/Notification"
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}