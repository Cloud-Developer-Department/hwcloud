{
  "name": "ShowSecretVersion",
  "summary": "查询凭据的版本与凭据值",
  "tags": "凭据版本管理",
  "productshort": "CSMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/secrets/{secret_name}/versions/{version_id}": {
      "get": {
        "tags": [
          "凭据版本管理"
        ],
        "operationId": "ShowSecretVersion",
        "summary": "查询凭据的版本与凭据值",
        "description": "查询指定凭据版本的信息和版本中的明文凭据值,只能查询ENABLED状态的凭据。\n通过/v1/{project_id}/secrets/{secret_name}/versions/latest (即将当前接口URL中的{version_id}赋值为latest)可访问凭据最新版本的凭据值。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "secret_name",
            "in": "path",
            "description": "凭据名称。",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "required": true,
            "x-example": "secret-name-test"
          },
          {
            "name": "version_id",
            "in": "path",
            "description": "凭据的版本标识符。",
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-_.]{0,63}",
            "required": true,
            "x-example": "version_id"
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "examples": {
              "application/json": {
                "version": {
                  "version_metadata": {
                    "id": "v6",
                    "kms_key_id": "b168fe00ff56492495a7d22974df2d0b",
                    "create_time": 1581507580000,
                    "secret_name": "secret-name-demo",
                    "version_stages": [
                      "SYSCURRENT"
                    ]
                  },
                  "secret_string": "\\\"demo_key\\\":\\\"demo_value\\\""
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowSecretVersionResponseBody"
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-order": 3
      }
    }
  },
  "definitions": {
    "ShowSecretVersionResponseBody": {
      "properties": {
        "version": {
          "$ref": "#/definitions/Version"
        }
      }
    },
    "VersionMetadata": {
      "description": "凭据版本被标记的状态。",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "v[0-9]{1,10}",
          "description": "凭据的版本号标识符,凭据对象下唯一。",
          "example": "v1"
        },
        "create_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "凭据版本创建时间,时间戳,即从1970年1月1日至该时间的总秒数。",
          "example": 1581507580000
        },
        "expire_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "凭据版本过期时间,时间戳,即从1970年1月1日至该时间的总秒数。默认为空,凭据订阅“版本过期”事件类型时,有效期判断所依据的值。",
          "example": 1581507580000
        },
        "kms_key_id": {
          "type": "string",
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$",
          "description": "加密版本凭据值的KMS主密钥ID。",
          "example": "0d0466b0-e727-4d9c-b35d-f84bb474a37f"
        },
        "secret_name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "凭据名称。",
          "example": "demo"
        },
        "version_stages": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "description": "凭据版本被标记的状态列表。每个版本标签对于凭据对象下版本是唯一存在的,如果创建版本时,指定的是同一凭据对象下的一个已经标记在其他版本上的状态,该标签将自动从其他版本上删除,并附加到此版本上。\n\n如果未指定version_stage的值,则凭据管理服务会自动移动临时标签SYSCURRENT到此新版本。",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "凭据版本在存入时需要被同时标记的版本状态。"
          }
        }
      },
      "type": "object"
    },
    "Version": {
      "description": "凭据版本。",
      "properties": {
        "version_metadata": {
          "$ref": "#/definitions/VersionMetadata"
        },
        "secret_binary": {
          "type": "string",
          "description": "二进制类型凭据在base64编码后的明文,凭据管理服务将其加密后,存入凭据的初始版本中。\n\n类型:base64编码的二进制数据对象。",
          "minLength": 0,
          "maxLength": 32768,
          "example": "this is a demo secret binary"
        },
        "secret_string": {
          "type": "string",
          "description": "文本类型凭据的明文,凭据管理服务将其加密后,存入凭据的初始版本中。",
          "minLength": 0,
          "maxLength": 32768,
          "example": "this is a demo secret string"
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "CSMS.XXXX"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "XXXX"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}