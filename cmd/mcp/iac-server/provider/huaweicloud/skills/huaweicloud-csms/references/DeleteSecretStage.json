        "operationId": "DeleteSecretStage",
        "summary": "删除凭据的版本状态",
        "description": "删除指定的凭据版本状态。",
        "x-constraint": "不可删除内建的版本状态:SYSCURRENT,SYSPREVIOUS。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "secret_name",
            "in": "path",
            "description": "凭据的资源标识符。",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "required": true,
            "x-example": "secret-name-test"
          },
          {
            "name": "stage_name",
            "in": "path",
            "description": "凭据版本状态的名称。",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "required": true,
            "x-example": "stage_name"
          }
        ],
        "responses": {
          "204": {
            "description": "请求已成功"
          },
          "400": {
