{
  "name": "ListSecretEvents",
  "summary": "查询事件列表",
  "tags": "事件管理",
  "productshort": "CSMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/csms/events": {
      "get": {
        "tags": [
          "事件管理"
        ],
        "operationId": "ListSecretEvents",
        "summary": "查询事件列表",
        "description": "查询当前用户在本项目下创建的所有事件。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-constraint": "此接口返回的信息为事件通知的元数据信息,不包含凭据值。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页返回的个数。\n\n默认值:50。",
            "type": "string",
            "minLength": 1,
            "maxLength": 4,
            "x-example": "50",
            "required": false
          },
          {
            "name": "marker",
            "in": "query",
            "description": "分页查询起始的事件名称,为空时为查询第一页",
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]{1,64}$",
            "x-example": "test_123",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "examples": {
              "application/json": {
                "events": [
                  {
                    "state": "ENABLED",
                    "name": "TestEvent1",
                    "event_id": "120eeafd-eca5-4098-8733-c1b369f3a450",
                    "event_types": [
                      "SECRET_VERSION_CREATED",
                      "SECRET_VERSION_EXPIRED",
                      "SECRET_VERSION_NEAR_EXPIRY",
                      "SECRET_DELETED"
                    ],
                    "create_time": 1669042498000,
                    "update_time": 1669042498000,
                    "notification": {
                      "target_type": "SMN",
                      "target_id": "urn:smn:cn-north-4:dc3b7c85759141a991da17423c0f2068:smn-target-name",
                      "target_name": "smn-target-name"
                    }
                  },
                  {
                    "state": "ENABLED",
                    "name": "TestEvent2",
                    "event_id": "1d251c99-37d2-4396-86ce-f000d3aa9850",
                    "event_types": [
                      "SECRET_VERSION_CREATED",
                      "SECRET_VERSION_EXPIRED",
                      "SECRET_VERSION_NEAR_EXPIRY",
                      "SECRET_DELETED"
                    ],
                    "create_time": 1669041491000,
                    "update_time": 1669041491000,
                    "notification": {
                      "target_type": "SMN",
                      "target_id": "urn:smn:cn-north-4:dc3b7c85759141a991da17423c0f2068:smn-target-name",
                      "target_name": "smn-target-name"
                    }
                  }
                ],
                "page_info": {
                  "next_marker": "TestEvent2",
                  "previous_marker": "TestEvent3",
                  "current_count": 2
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ListEventResponseBody"
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ListEventResponseBody": {
      "properties": {
        "events": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "description": "事件详情列表。",
          "items": {
            "$ref": "#/definitions/Event"
          }
        },
        "page_info": {
          "$ref": "#/definitions/PageInfo"
        }
      },
      "type": "object"
    },
    "Notification": {
      "description": "通知主题对象。",
      "required": [
        "target_type",
        "target_id",
        "target_name"
      ],
      "properties": {
        "target_type": {
          "type": "string",
          "pattern": "^SMN$",
          "description": "事件通知的对象类型。",
          "example": "SMN"
        },
        "target_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9\\-._:]{1,256}$",
          "description": "事件通知的对象ID。",
          "example": "urn:smn:cn-north-4:dc3b7c85759141accc0f2068:test-poc"
        },
        "target_name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "事件通知的对象名称。",
          "example": "test-poc"
        }
      },
      "type": "object"
    },
    "PageInfo": {
      "description": "分页信息。",
      "properties": {
        "next_marker": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "下一页查询地址(本页的末尾凭据名称,下一页起始凭据名称)。",
          "example": "secret-name-test"
        },
        "previous_marker": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "本页的起始凭据名称,上一页末尾凭据名称。",
          "example": "secret-name-test"
        },
        "current_count": {
          "format": "int32",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "本页返回条目数量。",
          "example": 1000
        }
      }
    },
    "Error": {
      "properties": {
        "error": {
          "$ref": "#/definitions/ErrorDetail",
          "description": "错误信息返回体。"
        }
      },
      "type": "object"
    },
    "Event": {
      "description": "事件通知对象。",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "事件通知名称。",
          "example": "demo"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$",
          "description": "事件通知的资源标识符。",
          "example": "2d1152f2-290d-4756-a1d2-e12c14992416"
        },
        "event_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "description": "设置事件的基础事件类型列表,。\n\n约束:数组大小:最小1,最大12。",
          "items": {
            "type": "string",
            "description": "本次事件通知的基础事件列表,基础事件类型如下。\n\nSECRET_VERSION_CREATED:版本创建\nSECRET_VERSION_EXPIRED:版本过期\nSECRET_ROTATED:凭据轮转\nSECRET_DELETED:凭据删除\n\n列表包含的基础事件类型不能重复。",
            "enum": [
              "SECRET_VERSION_CREATED",
              "SECRET_VERSION_EXPIRED",
              "SECRET_ROTATED",
              "SECRET_DELETED",
              "SECRET_ROTATED_FAILED"
            ]
          },
          "example": "eventDemo"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "description": "事件通知状态,取值如下。\n\nENABLED:表示启用状态\nDISABLED:表示禁用状态",
          "enum": [
            "ENABLED",
            "DISABLED"
          ],
          "example": "ENABLED"
        },
        "create_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "事件通知创建时间,时间戳,即从1970年1月1日至该时间的总秒数。",
          "example": 1581507580000
        },
        "update_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "事件通知上次更新时间,时间戳,即从1970年1月1日至该时间的总秒数。",
          "example": 1581507580000
        },
        "notification": {
          "$ref": "#/definitions/Notification"
        }
      },
      "type": "object"
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}