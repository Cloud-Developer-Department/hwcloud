{
  "name": "UpdateSecretStage",
  "summary": "更新凭据的版本状态",
  "tags": "凭据版本状态管理",
  "productshort": "CSMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/secrets/{secret_name}/stages/{stage_name}": {
      "put": {
        "x-request-examples-description-1": "更新凭据的版本状态,版本为version_id。",
        "x-request-examples-text-1": {
          "version_id": "version_id"
        },
        "tags": [
          "凭据版本状态管理"
        ],
        "operationId": "UpdateSecretStage",
        "summary": "更新凭据的版本状态",
        "description": "更新凭据的版本状态。",
        "x-constraint": "* 凭据的版本状态在同一凭据对象下仅能唯一标识一个版本,将版本状态设置到新版本上的同时,将自动从老版本上移除其对应的版本状态。没有任何版本状态标识的版本将被视为已弃用,可由凭据管理服务自动删除。\n* 凭据管理服务的每个凭据中最多可支持12个凭据版本状态,每个凭据版本状态同时仅能标识一个凭据版本。SYSCURRENT,SYSPREVIOUS为服务内建的凭据状态。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "type": "string",
            "minLength": 32,
            "maxLength": 64,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "secret_name",
            "in": "path",
            "description": "凭据名称。",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "required": true,
            "x-example": "secret-name-test"
          },
          {
            "name": "stage_name",
            "in": "path",
            "description": "凭据版本状态的名称。满足 '^[a-zA-Z0-9_-]{1,64}$'",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "required": true,
            "x-example": "stage_name"
          },
          {
            "in": "body",
            "name": "UpdateSecretStageRequestBody",
            "description": "创建凭据版本状态请求消息体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateSecretStageRequestBody"
            }
          }
        ],
        "x-request-examples-1": {
          "version_id": "version_id"
        },
        "responses": {
          "200": {
            "description": "请求已成功",
            "examples": {
              "application/json": {
                "stage": {
                  "name": "name",
                  "version_id": "v1",
                  "update_time": 1581507580000,
                  "secret_name": "secret-name-demo"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/SecretStageResponseBody"
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "SecretStageResponseBody": {
      "properties": {
        "stage": {
          "$ref": "#/definitions/Stage"
        }
      }
    },
    "UpdateSecretStageRequestBody": {
      "required": [
        "version_id"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "description": "凭据的版本号标识符。",
          "pattern": "^v[0-9]{0,63}",
          "example": "version_id"
        }
      }
    },
    "Stage": {
      "description": "凭据状态。",
      "properties": {
        "name": {
          "type": "string",
          "description": "凭据的版本状态名称。\n\n约束:最小长度1,最大长度64。",
          "minLength": 1,
          "maxLength": 64,
          "example": "name"
        },
        "update_time": {
          "format": "int64",
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "凭据的版本状态更新的时间戳,时间戳,即从1970年1月1日至该时间的总秒数。",
          "example": 1581507580000
        },
        "secret_name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "description": "凭据名称。",
          "example": "demo"
        },
        "version_id": {
          "type": "string",
          "description": "凭据的版本号标识符。",
          "pattern": "^v[0-9]{0,63}",
          "example": "version_id"
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "CSMS.XXXX"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "XXXX"
        }
      }
    }
  },
