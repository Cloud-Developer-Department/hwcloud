{
  "name": "ListSecretTask",
  "summary": "查询任务列表",
  "tags": "凭据轮转管理",
  "productshort": "CSMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/csms/tasks": {
      "get": {
        "x-request-examples-url-1": "/v1/xxxxx/csms/tasks?task_id=xxxxx",
        "x-request-examples-description-1": "查询凭据任务,任务ID为xxxxx。",
        "x-request-examples-url-2": "/v1/xxxxx/csms/tasks?secret_name=xx&status=FAILED&limit=10&marker=xxxx",
        "x-request-examples-description-2": "查询凭据任务,凭据名称为xx,任务状态为FAILED,每页返回个数为10个,分页起始任务ID为xxxx。",
        "tags": [
          "凭据轮转管理"
        ],
        "summary": "查询任务列表",
        "description": "查询任务列表。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ListSecretTask",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID。",
            "minLength": 32,
            "maxLength": 64
          },
          {
            "name": "secret_name",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "凭据的名称。",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "任务状态。取值 : \n- SUCCESS :任务轮转成功。\n- FAILED :任务轮转失败。",
            "enum": [
              "SUCCESS",
              "FAILED"
            ]
          },
          {
            "name": "task_id",
            "in": "query",
            "required": false,
            "description": "任务ID。\n该参数与其他参数不能同时存在。",
            "type": "string",
            "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页返回的个数。 默认值:50。",
            "type": "integer",
            "format": "int32",
            "exclusiveMinimum": true,
            "maximum": 1000
          },
          {
            "name": "marker",
            "in": "query",
            "required": false,
            "description": "分页查询起始的任务ID,为空时为查询第一页。",
            "type": "string",
            "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$"
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功。",
            "schema": {
              "$ref": "#/definitions/ListSecretTaskResponseBody"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "tasks": [
                  {
                    "task_id": "xxxx",
                    "secret_name": "xxxx",
                    "rotation_func_urn": "urn:fss:cn-north-4:xxxxxxxx:function:default:xxxx:xxxxx",
                    "task_status": "SUCCESS",
                    "attempt_nums": 3,
                    "operate_type": "MULTI_USER",
                    "task_time": 1715436899000
                  }
                ],
                "next_marker": "xxxxxx"
              }
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "SecretTask": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务ID"
        },
        "secret_name": {
          "type": "string",
          "description": "凭据名称。"
        },
        "rotation_func_urn": {
          "type": "string",
          "description": "FunctionGraph函数的urn。",
          "example": "urn:fss:{region}:46b6f338fc3445b8846c71dfb1fbxxxx:function:default:test2-0:latest"
        },
        "task_status": {
          "type": "string",
          "description": "任务状态。"
        },
        "operate_type": {
          "type": "string",
          "description": "轮转类型。"
        },
        "task_time": {
          "format": "int64",
          "type": "integer",
          "description": "任务创建时间。"
        },
        "attempt_nums": {
          "type": "integer",
          "format": "int32",
          "description": "轮转尝试次数。"
        },
        "task_error_code": {
          "type": "string",
          "description": "任务错误码。"
        },
        "task_error_msg": {
          "type": "string",
          "description": "任务错误信息。"
        }
      }
    },
    "ListSecretTaskResponseBody": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "任务数量"
        },
        "tasks": {
          "description": "凭据任务列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SecretTask"
          }
        },
        "next_marker": {
          "type": "string",
          "description": "下一页查询地址(本页的末尾任务ID)。"
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36,
          "example": "CSMS.XXXX"
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "example": "XXXX"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}