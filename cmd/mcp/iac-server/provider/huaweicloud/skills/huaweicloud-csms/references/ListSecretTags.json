{
  "name": "ListSecretTags",
  "summary": "查询凭据标签",
  "tags": "凭据标签管理",
  "productshort": "CSMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/csms/{secret_id}/tags": {
      "get": {
        "tags": [
          "凭据标签管理"
        ],
        "summary": "查询凭据标签",
        "description": "查询凭据标签。",
        "operationId": "ListSecretTags",
        "produces": [
          "application/json"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "secret_id",
            "in": "path",
            "description": "凭据ID",
            "minLength": 36,
            "maxLength": 36,
            "type": "string",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "schema": {
              "$ref": "#/definitions/ListSecretTagsResponseBody"
            },
            "examples": {
              "application/json": {
                "tags": [
                  {
                    "key": "key1",
                    "value": "value1"
                  },
                  {
                    "key": "key2",
                    "value": "value2"
                  }
                ],
                "sys_tags": null
              }
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "SysTag": {
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "标签键。"
        },
        "value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "标签值。"
        }
      },
      "type": "object"
    },
    "Error": {
      "properties": {
        "error": {
          "$ref": "#/definitions/ErrorDetail",
          "description": "错误信息返回体。"
        }
      },
      "type": "object"
    },
    "TagItem": {
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "标签的名称。\n同一个凭据,一个标签键只能对应一个标签值;不同的凭据可以使用相同的标签键。\n用户最多可以给单个凭据添加20个标签。\n\n约束:取值范围为1到128个字符,满足正则匹配\"^((?!\\\\s)(?!_sys_)[\\\\p{L}\\\\p{Z}\\\\p{N}_.:=+\\\\-@]*)(?<!\\\\s)$\""
        },
        "value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "标签的值。\n\n约束:取值范围不超过255个字符,满足正则匹配\"^([\\\\p{L}\\\\p{Z}\\\\p{N}_.:\\\\/=+\\\\-@]*)$\""
        }
      },
      "type": "object",
      "required": [
        "key"
      ]
    },
    "ListSecretTagsResponseBody": {
      "properties": {
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "description": "标签列表,key和value键值对的集合。\n - key:表示标签键,一个凭据下最多包含20个key,key不能为空,不能重复,同一个key中value不能重复。key最大长度为128个字符。\n - value:表示标签值。每个值最大长度255个字符,value之间为“与”的关系。",
          "items": {
            "$ref": "#/definitions/TagItem"
          }
        },
        "sys_tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "description": "系统标签列表。",
          "items": {
            "$ref": "#/definitions/SysTag"
          }
        }
      },
      "type": "object"
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
