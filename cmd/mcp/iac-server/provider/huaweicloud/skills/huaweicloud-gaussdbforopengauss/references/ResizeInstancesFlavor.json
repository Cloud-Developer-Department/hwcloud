  "definitions": {
    "OpenGaussResizeRequestBody": {
      "required": [
        "flavor_ref"
      ],
      "description": "规格变更时必填。",
      "properties": {
        "flavor_ref": {
          "type": "string",
          "description": "**参数解释**:\n规格变更的新规格的资源规格编码。参考表1中的“规格编码”列内容获取。参考查询数据库规格 - QueryingInstanceSpecifications中“spec_code”字段获取。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
        },
        "is_auto_pay": {
          "type": "boolean",
          "description": "**参数解释**:\n包周期实例时可指定,表示是否自动从账户中支付,此字段不影响自动续订的支付方式。\n**约束限制**:\n不涉及。\n**取值范围**:\n- true,表示自动从账户中支付。\n- false,表示手动从账户中支付,默认为该方式。\n\n**默认取值**:\nfalse"
        },
        "cn_concurrent_resize_num": {
          "type": "integer",
          "description": "**参数解释**:\n指定CN节点的规格变更并行数。\n调整CN节点并行变更数可以加快规格变更的过程,建议使用系统默认配置的规格。如需调整,请根据当前系统负载评估剩余CN节点业务负载变化情况,确保业务稳定性和中断时长在可接受范围内。\n**约束限制**:\n仅对独立部署形态实例生效。\n**取值范围**:\n[1, floor(总协调节点数/2)],单批次最多变更20个协调节点。\n**默认取值**:\n1"
        },
        "dn_concurrent_resize_num": {
          "type": "integer",
          "description": "**参数解释**:\n指定DN节点的规格变更并行数。\n调整DN节点并行变更数可以加快规格变更的过程,建议使用系统默认配置的规格。如需调整,建议根据当前系统负载评估短时间内倒换DN节点数量情况,确保业务稳定性和中断时长在可接受范围内。\n**约束限制**:\n不涉及。\n**取值范围**:\n- 当总分片数<=5时,取值范围为[1, 总分片数]。\n- 当总分片数>5时,取值范围为[1, max(floor(分片数/2),5)],单批次最多变更20个分片。\n\n**默认取值**:\n不指定分片并发数时,分为以下两种情况:\n- 当总分片数<=5时,默认一起变更。\n- 当总分片数>5时,默认每次变更5个,最后一批可不足5个。"
        }
      }
    },
    "OpengaussResizeRsp": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务id。按需实例时仅返回任务id。"
        },
        "order_id": {
          "type": "string",
          "description": "订单id。仅变更包周期实例会返回该参数。"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    }
  },
