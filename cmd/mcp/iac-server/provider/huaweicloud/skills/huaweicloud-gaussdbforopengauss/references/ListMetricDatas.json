{
  "name": "ListMetricDatas",
  "summary": "查询实例列表指标",
  "tags": "指标管理",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/instances/metric-data": {
      "get": {
        "tags": [
          "指标管理"
        ],
        "operationId": "ListMetricDatas",
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "false",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "summary": "查询实例列表指标",
        "description": "查询实例列表指标。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "0611f1bd8b00d5d32f17c017f15b599f"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "**参数解释**:\n语言。\n**约束限制**:\n不涉及。\n**取值范围**:\n  - zh-cn\n  - en-us\n\n**默认取值**:\nen-us",
            "type": "string",
            "x-example": "zh-cn",
            "enum": [
              "zh-cn",
              "en-us"
            ]
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数解释**:\n索引位置,偏移量。从第一条数据偏移offset条数据后开始查询。例如:该参数指定为1,limit指定为10,则只展示第2~11条数据。\n**约束限制**:\n不涉及。\n**取值范围**:\n[0, 2^31-1]\n**默认取值**:\n默认为0(偏移0条数据,表示从第一条数据开始查询)。",
            "type": "integer",
            "required": false,
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数解释**:\n查询记录数。例如该参数设定为10,则查询结果最多只显示10条记录。\n**约束限制**:\n不涉及。\n**取值范围**:\n[1, 50]\n**默认取值**:\n默认为50。",
            "type": "integer",
            "required": false,
            "x-example": 100
          },
          {
            "name": "name",
            "in": "query",
            "description": "**参数解释**:\n实例名称。\n用于表示实例的名称,同一租户下,同类型的实例名可重名。\n**约束限制**:\n不涉及。\n**取值范围**:\n4~64个字符之间,必须以字母开头,区分大小写,可以包含字母、数字、中划线或者下划线,不能包含其他的特殊字符。\n**默认取值**:\n不涉及。",
            "required": false,
            "type": "string",
            "x-example": "gauss-6gf2"
          },
          {
            "name": "instance_id",
            "in": "query",
            "description": "**参数解释**:\n实例名称。\n实例ID,此参数是用户创建实例的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。\n**默认取值**:\n不涉及。",
            "required": false,
            "type": "string",
            "x-example": "06315a7be8fc479cb9888d38fb493ab5in14"
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/ListMetricDatasResponseBody"
            },
            "examples": {
              "application/json": {
                "instances": [
                  {
                    "id": "ad8cd1440aa94a02ae4580fcbebb3143in14",
                    "name": "user1-v3-independent",
                    "status": "BUILD",
                    "mode": "Ha",
                    "engine_name": "GaussDB",
                    "engine_version": "8.0.92",
                    "solution": "1主2备",
                    "disk_used_size": 1.05,
                    "disk_total_size": 160,
                    "disk_usage": 0.62,
                    "p80": 342,
                    "p95": 501,
                    "deadlocks": 0,
                    "buffer_hit_ratio": 0,
                    "nodes": [
                      {
                        "id": "6b7616dfb1c14721b1a11dd5654c1515no14",
                        "name": "DataNode1",
                        "role": "master",
                        "component_ids": [
                          "dn_6001",
                          "dn_6002"
                        ]
                      }
                    ]
                  }
                ],
                "total_count": 100
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "查询实例列表指标。",
        "x-request-examples-url-1": "GET https://{Endpoint}/v3/0611f1bd8b00d5d32f17c017f15b599f/instances/metric-data?instance_id=e73893ef73754465a8bd2e0857bbf13ein14"
      }
    }
  },
  "definitions": {
    "InstancesNodesResult": {
      "properties": {
        "id": {
          "type": "string",
          "description": "**参数解释**:\n节点ID。\n**取值范围**:\n不涉及。",
          "example": "6b7616dfb1c14721b1a11dd5654c1515no14"
        },
        "name": {
          "type": "string",
          "description": "**参数解释**:\n节点名称。\n**取值范围**:\n不涉及。",
          "example": "DataNode1"
        },
        "role": {
          "type": "string",
          "description": "**参数解释**:\n节点角色。\n**取值范围**:\n- master:主节点。\n- slave:备节点。\n- secondary:日志节点。\n- readreplica:只读节点。",
          "example": "master"
        },
        "component_ids": {
          "type": "array",
          "description": "**参数解释**:\n组件ID列表。",
          "items": {
            "type": "string"
          },
          "example": [
            "dn_6001",
            "dn_6002"
          ]
        }
      }
    },
    "InstancesMetricResult": {
      "properties": {
        "id": {
          "type": "string",
          "description": "**参数解释**:\n实例ID。\n**取值范围**:\n不涉及。",
          "example": "cc6fd964d93f4003851dfc29d57d30a5in14"
        },
        "name": {
          "type": "string",
          "description": "**参数解释**:\n实例名称。\n**取值范围**:\n不涉及。",
          "example": "gauss-6gf2"
        },
        "status": {
          "type": "string",
          "description": "**参数解释**:\n实例状态。\n**取值范围**:\n- creating,表示实例正在创建。\n- normal,表示实例正常。\n- abnormal,表示实例异常。\n- createfail,表示实例创建失败。",
          "example": "BUILD"
        },
        "mode": {
          "type": "string",
          "description": "**参数解释**:\n实例类型。\n**取值范围**:\n不涉及。",
          "example": "主备版"
        },
        "engine_name": {
          "type": "string",
          "description": "**参数解释**:\n引擎名称。\n**取值范围**:\n不涉及。",
          "example": "GaussDB"
        },
        "engine_version": {
          "type": "string",
          "description": "**参数解释**:\n引擎版本。\n**取值范围**:\n不涉及。",
          "example": "8.0.92"
        },
        "solution": {
          "type": "string",
          "description": "**参数解释**:\n部署形态。\n**取值范围**:\n不涉及。",
          "example": "1主2备"
        },
        "disk_used_size": {
          "type": "string",
          "description": "**参数解释**:\n实例数据磁盘已使用大小。\n**取值范围**:\n不涉及。",
          "example": 1.05
        },
        "disk_total_size": {
          "type": "string",
          "description": "**参数解释**:\n实例数据磁盘总大小。\n**取值范围**:\n不涉及。",
          "example": 160
        },
        "disk_usage": {
          "type": "string",
          "description": "**参数解释**:\n实例数据磁盘已使用百分比。\n**取值范围**:\n不涉及。",
          "example": 0.62
        },
        "p80": {
          "type": "string",
          "description": "**参数解释**:\n80% SQL的响应时间。\n**取值范围**:\n不涉及。",
          "example": 342
        },
        "p95": {
          "type": "string",
          "description": "**参数解释**:\n95% SQL的响应时间。\n**取值范围**:\n不涉及。",
          "example": 501
        },
        "deadlocks": {
          "type": "string",
          "description": "**参数解释**:\n死锁次数。\n**取值范围**:\n不涉及。",
          "example": 0
        },
        "buffer_hit_ratio": {
          "type": "string",
          "description": "**参数解释**:\nbuffer 命中率。\n**取值范围**:\n不涉及。",
          "example": 0
        },
        "nodes": {
          "type": "array",
          "description": "**参数解释**:\n实例节点信息列表。",
          "items": {
            "$ref": "#/definitions/InstancesNodesResult"
          }
        }
      }
    },
    "ListMetricDatasResponseBody": {
      "properties": {
        "instances": {
          "type": "array",
          "description": "**参数解释**:\n实例信息。",
          "items": {
            "$ref": "#/definitions/InstancesMetricResult"
          }
        },
        "total_count": {
          "type": "integer",
          "description": "**参数解释**:\n总记录数。\n**取值范围**:\n不涉及。",
          "example": 100
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
