{
  "name": "ListStorageTypes",
  "summary": "查询数据库磁盘类型",
  "tags": "数据库磁盘类型",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/storage-type": {
      "get": {
        "tags": [
          "数据库磁盘类型"
        ],
        "operationId": "ListStorageTypes",
        "summary": "查询数据库磁盘类型",
        "description": "查询指定数据库引擎对应的磁盘类型。",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "version",
            "in": "query",
            "description": "数据库版本号。",
            "required": true,
            "type": "string",
            "x-example": "V2.0-1.4"
          },
          {
            "name": "ha_mode",
            "in": "query",
            "description": "实例类型:\nenterprise(企业版),\ncentralization_standard(主备版),不区分大小写。",
            "type": "string",
            "enum": [
              "enterprise",
              "centralization_standard"
            ],
            "x-example": "enterprise"
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/StorageTypeListResponse"
            },
            "examples": {
              "application/json": {
                "storage_type": [
                  {
                    "name": "ULTRAHIGH",
                    "az_status": {
                      "az1": "normal",
                      "az2": "normal"
                    }
                  }
                ]
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/storage-type?version=2.3"
      }
    }
  },
  "definitions": {
    "AzStatus": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "其中key是可用区编号,value是规格所在az的状态,包含以下状态:\n- normal,在售。\n- unsupported,暂不支持该规格。\n- sellout,售罄。",
      "example": {
        "az1": "normal"
      }
    },
    "StorageTypeListResponse": {
      "required": [
        "storage_type"
      ],
      "properties": {
        "storage_type": {
          "description": "实例磁盘类型信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Storage"
          }
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "Storage": {
      "description": "实例磁盘类型信息。",
      "required": [
        "name",
        "az_status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "磁盘类型名称,可能取值如下:\n- ULTRAHIGH,表示SSD。\n- ESSD,表示急速云盘",
          "example": "ULTRAHIGH"
        },
        "az_status": {
          "$ref": "#/definitions/AzStatus"
        },
        "support_compute_group_type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "性能规格,包含以下状态:\n- normal:通用增强型。\n- normal2:通用增强II型。\n- armFlavors:鲲鹏通用计算增强型。\n- armFlavors2Shared:鲲鹏通用计算增强II型(共享型)。",
          "example": [
            "normal",
            "normal2",
            "armFlavors"
          ]
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}