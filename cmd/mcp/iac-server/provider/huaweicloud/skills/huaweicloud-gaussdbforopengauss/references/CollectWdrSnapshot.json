  "definitions": {
    "CollectWdrSnapshotRequestBody": {
      "required": [
        "start_time",
        "end_time",
        "wdr_type"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "description": "**参数解释**:\n快照开始时间。\n**约束限制**:\n格式为“yyyy-mm-ddThh:mm:ssZ”。其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "example": "2023-08-01T11:10:31+0800"
        },
        "end_time": {
          "type": "string",
          "description": "**参数解释**:\n快照结束时间。\n**约束限制**:\n格式为“yyyy-mm-ddThh:mm:ssZ”。其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "example": "2023-08-02T11:10:31+0800"
        },
        "wdr_type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "**参数解释**:\n采集类型,包括实例级和组件级。\n**约束限制**:\n实例级则需要输入\"cluster\",组件级则需要输入组件ID。实例级和组件级无法同时输入。",
          "example": [
            "dn_6001",
            "dn_6002"
          ]
        }
      }
    },
    "CollectWdrSnapshotResponseBody": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "description": "**参数解释**:\n任务ID。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "12810e81c2a86330e070f78b97e2c5ec"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
