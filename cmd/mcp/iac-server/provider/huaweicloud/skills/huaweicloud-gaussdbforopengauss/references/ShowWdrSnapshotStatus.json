        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "**参数解释**:\n语言。\n**约束限制**:\n不涉及。\n**取值范围**:\n- zh-cn \n- en-us\n\n**默认取值**:\nen-us",
            "type": "string",
            "x-example": "en-us",
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "default": "en-us",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "x-example": "43391853d5634d7e98fdcce8192e414c",
            "pattern": "^[a-zA-Z0-9]{1,32}$"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "**参数解释**:\n实例ID,此参数是用户创建实例的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "x-example": "d414353314304bb3942517fe7f23b459in14",
            "pattern": "^[a-zA-Z0-9]{1,36}$"
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/QueryWdrSnapshotResponse"
            },
            "examples": {
              "application/json": {
                "status": "ON",
                "start_time": "2024-02-23 16:31:16.309938+08",
                "end_time": "2024-02-27 12:31:40.153449+08"
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description": "查询wdr快照开关状态",
        "x-request-examples-url-1": "GET   https://{Endpoint}/v3/43391853d5634d7e98fdcce8192e414c/instances/d414353314304bb3942517fe7f23b459in14/wdr-snapshot/status",
        "x-api-type": "open-api"
      }
    }
  },
  "definitions": {
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "QueryWdrSnapshotResponse": {
      "properties": {
        "status": {
          "type": "string",
          "description": "**参数解释**:\n开关状态。\n**取值范围**:\n- ON:WDR快照开启。\n- OFF:WDR快照关闭。",
          "example": "ON"
        },
        "start_time": {
          "type": "string",
          "description": "**参数解释**:\n快照生成的最早时间,格式为“yyyy-mm-dd hh:mm:ss timezone”。其中timezone是指指时区偏移量,例如北京时间偏移显示为+08。若内核未生成快照,则该值为空。\n**取值范围**:\n不涉及。",
          "example": "2024-02-23 16:31:16.309938+08"
        },
        "end_time": {
          "type": "string",
          "description": "**参数解释**:\n快照生成的最新时间,格式为“yyyy-mm-dd hh:mm:ss timezone”。其中timezone是指指时区偏移量,例如北京时间偏移显示为+08。若内核未生成快照,则该值为空。\n**取值范围**:\n不涉及。",
          "example": "2024-02-27 12:31:40.153449+08"
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
