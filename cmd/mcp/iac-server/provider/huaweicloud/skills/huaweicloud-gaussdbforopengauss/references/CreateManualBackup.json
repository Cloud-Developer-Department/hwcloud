  "definitions": {
    "BackupInfo": {
      "description": "备份信息。",
      "required": [
        "id",
        "name",
        "description",
        "begin_time",
        "status",
        "type",
        "instance_id"
      ],
      "properties": {
        "id": {
          "description": "备份ID。",
          "type": "string",
          "example": "2f4ddb93b9014b0893d81d2e472f30febr14"
        },
        "name": {
          "description": "备份名称。",
          "type": "string",
          "example": "backup-1"
        },
        "description": {
          "description": "备份描述。",
          "type": "string",
          "example": ""
        },
        "begin_time": {
          "description": "备份开始时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。",
          "type": "string",
          "example": "2020-07-07T01:17:05+0800"
        },
        "status": {
          "description": "备份状态,取值:\n\n- BUILDING: 备份中。\n- COMPLETED: 备份完成。\n- FAILED:备份失败。\n- DELETING:备份删除中。",
          "type": "string",
          "example": "BUILDING",
          "enum": [
            "BUILDING",
            "COMPLETED",
            "FAILED",
            "DELETING"
          ]
        },
        "type": {
          "description": "备份类型,取值:\n- “manual”: 手动全量备份",
          "type": "string",
          "enum": [
            "manual"
          ]
        },
        "instance_id": {
          "description": "**参数解释**:\n实例ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "type": "string",
          "example": "43e4feaab48f11e89039fa163ebaa7e4in14"
        }
      }
    },
    "CreateManualBackupResponseBody": {
      "required": [
        "backup",
        "job_id"
      ],
      "properties": {
        "backup": {
          "$ref": "#/definitions/BackupInfo"
        },
        "job_id": {
          "type": "string",
          "description": "任务id。",
          "example": "dff1d289-4d03-4942-8b9f-463ea07c000d"
        }
      }
    },
    "CreateManualBackupRequestBody": {
      "required": [
        "instance_id",
        "name"
      ],
      "properties": {
        "instance_id": {
          "description": "**参数解释**:\n实例ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "type": "string",
          "example": "ef25188419f941309882d2986b2210b9in14"
        },
        "name": {
          "description": "备份名称,不可重复,4~64个字符,必须以英文字母开头,区分大小写,可以包含英文字母、数字、中划线或者下划线,不能包含其他特殊字符。",
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "example": "backup-1"
        },
        "description": {
          "description": "备份描述,不能包含>!<\"&'=特殊字符,不大于256个字符。",
          "type": "string",
          "maxLength": 256,
          "example": ""
        }
      }
