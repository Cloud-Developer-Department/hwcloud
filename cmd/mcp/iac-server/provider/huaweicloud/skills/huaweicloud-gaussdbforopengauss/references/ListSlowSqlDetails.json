{
  "name": "ListSlowSqlDetails",
  "summary": "查询慢SQL详情",
  "tags": "慢SQL",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/slow-sql-detail": {
      "post": {
        "tags": [
          "慢SQL"
        ],
        "operationId": "ListSlowSqlDetails",
        "summary": "查询慢SQL详情",
        "description": "根据归一化SQLID,查询该SQL模板详情。",
        "x-constraint": "仅支持包含有CN或DN(主、备)组件的节点。",
        "x-api-type": "open-api",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "**参数解释**:\n语言。\n**约束限制**:\n不涉及。\n**取值范围**:\n- zh-cn \n- en-us\n\n**默认取值**:\nen-us",
            "type": "string",
            "x-example": "en-us",
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "default": "en-us",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "0483b6b16e954cb88930a360d2c4e663"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "**参数解释**:\n实例ID,此参数是用户创建实例的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "cc6fd964d93f4003851dfc29d57d30a5in14",
            "required": true
          },
          {
            "name": "ListSlowSqlDetailRequestBody",
            "in": "body",
            "description": "**参数解释**:\n慢SQL详情。\n**约束限制**:\n不涉及。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SlowSqlDetailRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/SlowSqlDetailResponseBody"
            },
            "examples": {
              "application/json": {
                "slow_sql_details": [
                  {
                    "sql_id": "12345",
                    "user_name": "john_doe",
                    "client_ip": "192.168.0.1",
                    "client_port": "5432",
                    "sql_text": "SELECT * FROM large_table WHERE column1 = 'value';",
                    "query_plan": "Seq Scan on large_table ...",
                    "start_time": 1619452000,
                    "finish_time": 1619453000,
                    "returned_rows": 1000,
                    "fetched_rows": 5000,
                    "fetched_pages": 50,
                    "hit_pages": 25,
                    "total_time": "1000000",
                    "cpu_time": "500000",
                    "plan_time": "100000",
                    "io_time": "400000",
                    "lock_count": 1,
                    "lock_time": "1000",
                    "node_id": "88391813e1cb4e93899b210e880fdb1bno20",
                    "node_name": "Node1"
                  }
                ],
                "total": 1
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ParaErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "查询慢SQL详情。",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/instances/cc6fd964d93f4003851dfc29d57d30a5in14/slow-sql-detail",
        "x-request-examples-1": {
          "instance_id": "d04686c6baae4f65a742771186f47b7ain14",
          "node_ids": [
            "88391813e1cb4e93899b210e880fdb1bno20"
          ],
          "start_time": 1686903754933,
          "end_time": 1686990154933,
          "sql_id": 123
        }
      }
    }
  },
  "definitions": {
    "ParaErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "MultiQueryConditionOption": {
      "type": "object",
      "required": [
        "name",
        "condition",
        "values"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "**参数解释**:\n查询字段名称。\n**约束限制**:\n只支持字符串\"query\"。\n**取值范围**:\n由英文字母(大小写)、数字或下划线组成,长度为 1 至 128 个字符。\n**默认取值**:\n不涉及。",
          "example": "query"
        },
        "condition": {
          "type": "string",
          "description": "**参数解释**:\n组合条件类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n仅限字符串:\"AND\"、\"OR\"。\n**默认取值**:\n不涉及。",
          "enum": [
            "OR",
            "AND"
          ],
          "example": "AND"
        },
        "is_fuzzy": {
          "type": "boolean",
          "description": "**参数解释**:\n多个过滤检索条件内容集合。\n**约束限制**:\n只支持为true进行模糊查询。\n**取值范围**:\n- true:模糊查询。\n- false:精确匹配。\n\n**默认取值**:\ntrue",
          "enum": [
            true,
            false
          ],
          "example": true
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "**参数解释**:\n多个过滤检索条件内容集合。由 1 至 5 个字符串组成的列表。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "example": [
            "select"
          ]
        }
      }
    },
    "SlowSqlDetailRequestBody": {
      "required": [
        "start_time",
        "end_time",
        "instance_id",
        "sql_id",
        "node_ids"
      ],
      "properties": {
        "start_time": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**:\n起始日期。\n**约束限制**:\n格式:13位UNIX时间戳格式,单位是毫秒,时区是UTC。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "example": "1619452000"
        },
        "end_time": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**:\n结束日期。\n**约束限制**:\n格式:13位UNIX时间戳格式,单位是毫秒,时区是UTC。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "example": "1619452000"
        },
        "instance_id": {
          "type": "string",
          "description": "**参数解释**:\n实例ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "minLength": 2,
          "maxLength": 512,
          "example": "this is a demo"
        },
        "multi_queries": {
          "description": "**参数解释**:\n字符型组合过滤多条件查询列表。\n**约束限制**:\n不涉及。",
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/MultiQueryConditionOption"
          }
        },
        "sql_id": {
          "type": "string",
          "description": "**参数解释**:\n慢SQL的SQL ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "example": 1231241
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "**参数解释**:\n节点ID数组。\n**约束限制**:\n不涉及。",
          "example": [
            "03170e7c-4f51-4483-99c0-74129404b31f"
          ]
        }
      },
      "type": "object"
    },
    "SlowSqlDetailResponseBody": {
      "properties": {
        "total": {
          "type": "integer",
          "description": "**参数解释**:\n总条数。\n**取值范围**:\n不涉及。"
        },
        "slow_sql_details": {
          "type": "array",
          "description": "**参数解释**:\n慢SQL详情信息列表。",
          "items": {
            "$ref": "#/definitions/SlowSqlDetailResult"
          }
        }
      }
    },
    "SlowSqlDetailResult": {
      "properties": {
        "db_name": {
          "type": "string",
          "description": "**参数解释**:\n数据库名称。\n**取值范围**:\n不涉及。",
          "example": "gaussdb_test"
        },
        "schema_name": {
          "type": "string",
          "description": "**参数解释**:\nSCHEMA名称。\n**取值范围**:\n不涉及。",
          "example": "gaussdb_test"
        },
        "sql": {
          "type": "string",
          "description": "**参数解释**:\n变量替换后的完整SQL。当sql_text不返回变量值时,sql返回空字符串。\n**取值范围**:\n不涉及。",
          "example": "select * from gaussdb"
        },
        "sql_id": {
          "type": "string",
          "description": "**参数解释**:\nSQL ID。\n**取值范围**:\n不涉及。",
          "example": 12345
        },
        "user_name": {
          "type": "string",
          "description": "**参数解释**:\n用户名称。\n**取值范围**:\n不涉及。",
          "example": "john_doe"
        },
        "client_ip": {
          "type": "string",
          "description": "**参数解释**:\n客户端IP。\n**取值范围**:\n不涉及。",
          "example": "192.168.0.1"
        },
        "client_port": {
          "type": "string",
          "description": "**参数解释**:\n客户端端口。\n**取值范围**:\n不涉及。",
          "example": 5432
        },
        "node_id": {
          "type": "string",
          "description": "**参数解释**:\n节点ID。\n**取值范围**:\n不涉及。",
          "example": "d04686c6baae4f65a742771186f47b7ain14"
        },
        "node_name": {
          "type": "string",
          "description": "**参数解释**:\n节点名称。\n**取值范围**:\n不涉及。",
          "example": "cn_5002"
        },
        "sql_text": {
          "type": "string",
          "description": "**参数解释**:\nSQL模版。\n**取值范围**:\n不涉及。",
          "example": "SELECT * FROM large_table WHERE column1 = 'value';"
        },
        "query_plan": {
          "type": "string",
          "description": "**参数解释**:\n执行计划。\n**取值范围**:\n不涉及。",
          "example": "Seq Scan on large_table ..."
        },
        "start_time": {
          "type": "integer",
          "description": "**参数解释**:\n开始时间UTC时间。\n**取值范围**:\n格式为yyyy-mm-ddThh:mm:ss+0000。",
          "example": 1619452000
        },
        "finish_time": {
          "type": "integer",
          "description": "**参数解释**:\n结束时间UTC时间。\n**取值范围**:\n格式为yyyy-mm-ddThh:mm:ss+0000。",
          "example": 1619453000
        },
        "returned_rows": {
          "type": "integer",
          "description": "**参数解释**:\n返回行。\n**取值范围**:\n不涉及。",
          "example": 1000
        },
        "fetched_rows": {
          "type": "integer",
          "description": "**参数解释**:\n扫描行。\n**取值范围**:\n不涉及。",
          "example": 5000
        },
        "fetched_pages": {
          "type": "integer",
          "description": "**参数解释**:\n扫描页。\n**取值范围**:\n不涉及。",
          "example": 50
        },
        "hit_pages": {
          "type": "integer",
          "description": "**参数解释**:\n命中页。\n**取值范围**:\n不涉及。",
          "example": 25
        },
        "total_time": {
          "type": "integer",
          "description": "**参数解释**:\n总耗时(单位:微秒)。\n**取值范围**:\n不涉及。",
          "example": 1000000
        },
        "cpu_time": {
          "type": "integer",
          "description": "**参数解释**:\nCPU耗时(单位:微秒)。\n**取值范围**:\n不涉及。",
          "example": 500000
        },
        "plan_time": {
          "type": "integer",
          "description": "**参数解释**:\n计划耗时(单位:微秒)。\n**取值范围**:\n不涉及。",
          "example": 100000
        },
        "io_time": {
          "type": "integer",
          "description": "**参数解释**:\nIO耗时(单位:微秒)。\n**取值范围**:\n不涉及。",
          "example": 400000
        },
        "lock_count": {
          "type": "integer",
          "description": "**参数解释**:\n加锁次数。\n**取值范围**:\n不涉及。",
          "example": 1
        },
        "lock_time": {
          "type": "integer",
          "description": "**参数解释**:\n加锁耗时(单位:微秒)。\n**取值范围**:\n不涉及。",
          "example": 1
        }
      },
      "type": "object"
    }
  },
