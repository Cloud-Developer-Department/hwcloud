{
  "name": "AddInstanceTags",
  "summary": "添加实例标签。",
  "tags": "标签管理",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/tags": {
      "post": {
        "tags": [
          "标签管理"
        ],
        "operationId": "AddInstanceTags",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "false",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "x-request-examples-description-1": "添加实例标签",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/0611f1bd8b00d5d32f17c017f15b599f/instances/994b108886b34dcbae104bd8fe5a8c39in14/tags",
        "x-request-examples-1": {
          "tags": [
            {
              "key": "1",
              "value": "1"
            },
            {
              "key": "2",
              "value": "2"
            }
          ]
        },
        "summary": "添加实例标签。",
        "description": "对指定实例添加用户标签信息。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "**参数解释**:\n语言。\n**约束限制**:\n不涉及。\n**取值范围**:\n  - zh-cn\n  - en-us\n\n**默认取值**:\nen-us",
            "type": "string",
            "required": false,
            "x-example": "zh-cn",
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "default": "en-us"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "054e292c9880d4992f02c0196d3ea468"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "**参数解释**:\n实例ID,此参数是用户创建实例的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "11c4c867415f4811842b05dcac665c29in14"
          },
          {
            "name": "addTagsRequestBody",
            "in": "body",
            "required": true,
            "description": "请求体。",
            "schema": {
              "$ref": "#/definitions/AddTagsRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "添加标签的结果。",
            "schema": {
              "$ref": "#/definitions/AddTagsResponseBody"
            },
            "examples": {
              "application/json": {
                "instance_id": "994b108886b34dcbae104bd8fe5a8c39in14",
                "instance_name": "gauss-ee74"
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ParaErrorResponseBody"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ParaErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "AddTagsRequestBody": {
      "required": [
        "tags"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TagsOption"
          }
        }
      }
    },
    "AddTagsResponseBody": {
      "description": "添加实例标签成功响应。",
      "required": [
        "instance_id",
        "instance_name"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "description": "添加标签的实例ID。",
          "example": "994b108886b34dcbae104bd8fe5a8c39in14"
        },
        "instance_name": {
          "type": "string",
          "description": "添加标签的实例名称。",
          "example": "gauss-ee74"
        }
      }
    },
    "TagsOption": {
      "description": "所添加的标签具体内容,可批量添加标签,单个实例标签上限为20个。",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "标签键。最大长度36个unicode字符,不能为null或者空字符串,不能为空格,校验和使用之前会自动过滤掉前后空格。",
          "example": "department"
        },
        "value": {
          "type": "string",
          "description": "标签值。最大长度43个unicode字符,可以为空字符串,不能为空格,校验和使用之前会自动过滤掉前后空格。",
          "example": "Technical department"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}