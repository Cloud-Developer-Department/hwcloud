{
  "name": "ListDatabaseSchemas",
  "summary": "查询数据库SCHEMA列表",
  "tags": "管理数据库和用户",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/schemas": {
      "get": {
        "tags": [
          "管理数据库和用户"
        ],
        "operationId": "ListDatabaseSchemas",
        "summary": "查询数据库SCHEMA列表",
        "description": "查询指定实例的数据库SCHEMA列表。",
        "x-support-sdk": "Y",
        "x-constraint": "- 实例在异常或冻结状态下不能执行该操作。\n- 不支持查询只读实例的数据库SCHEMA列表。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "**参数解释**:\n实例ID,此参数是用户创建实例的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein01"
          },
          {
            "name": "db_name",
            "in": "query",
            "description": "数据库名称。",
            "required": true,
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量表示从此偏移量开始查询, offset大于等于0。",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量,取值范围[1, 100]。",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/ListDatabaseSchemaResponseBody"
            },
            "examples": {
              "application/json": {
                "database_schemas": [
                  {
                    "owner": "root",
                    "schema_name": "rds-test"
                  },
                  {
                    "owner": "root",
                    "schema_name": "testdb1"
                  }
                ],
                "total_count": 2
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/instances/dsfae23fsfdsae3435in01/schemas?db_name=rds_test&offset=1&limit=10"
      }
    }
  },
  "definitions": {
    "ListDatabaseSchemaResponseBody": {
      "required": [
        "database_schemas",
        "total_count"
      ],
      "properties": {
        "database_schemas": {
          "description": "列表中每个元素表示一个数据库schema。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/GaussDBforOpenGaussDatabaseForListSchema"
          }
        },
        "total_count": {
          "description": "数据库schema总数。",
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "GaussDBforOpenGaussDatabaseForListSchema": {
      "description": "数据库schema信息。",
      "required": [
        "schema_name",
        "owner"
      ],
      "properties": {
        "schema_name": {
          "description": "schema名称。",
          "type": "string"
        },
        "owner": {
          "description": "schema所属用户。",
          "type": "string"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
