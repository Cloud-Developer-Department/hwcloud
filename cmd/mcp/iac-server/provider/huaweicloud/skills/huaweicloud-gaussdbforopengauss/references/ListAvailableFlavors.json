{
  "name": "ListAvailableFlavors",
  "summary": "查询实例可变更规格",
  "tags": "引擎版本和规格",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/available-flavors": {
      "get": {
        "tags": [
          "引擎版本和规格"
        ],
        "operationId": "ListAvailableFlavors",
        "summary": "查询实例可变更规格",
        "description": "查询实例可变更规格列表。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "false",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn",
            "default": "en-us",
            "enum": [
              "zh-cn",
              "en-us"
            ]
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "**参数解释**:\n实例ID,此参数是用户创建实例的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0(偏移0条数据,表示从第一条数据开始查询),必须为数字,不能为负数。",
            "type": "integer",
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询记录数。默认为100,不能为负数,最小值为1,最大值为100。",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/AvailableFlavorsResponseBody"
            },
            "examples": {
              "application/json": {
                "flavors": [
                  {
                    "spec_code": "gaussdb.opengauss.ee.m6.2xlarge.x868.ha",
                    "vcpus": "8",
                    "ram": "64",
                    "az_status": [
                      {
                        "az2xahz": "normal"
                      }
                    ]
                  }
                ],
                "total_count": 1
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ParaErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/instances/3ea6d6463c9a4baf9a47c5b74464307cin14/available-flavors"
      }
    }
  },
  "definitions": {
    "AvailableFlavorsResponseBody": {
      "required": [
        "flavors",
        "total_count"
      ],
      "properties": {
        "flavors": {
          "description": "实例可变更规格信息列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/AvailableFlavorInfoResult"
          }
        },
        "total_count": {
          "description": "总记录数。",
          "type": "integer",
          "example": 10
        }
      }
    },
    "ParaErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "AvailableFlavorInfoResult": {
      "description": "实例可变更规格信息。",
      "properties": {
        "spec_code": {
          "type": "string",
          "description": "资源规格编码。",
          "example": "gaussdb.opengauss.ee.ld.20xlarge.arm8.ha"
        },
        "vcpus": {
          "type": "string",
          "description": "CPU核数。",
          "example": "4"
        },
        "ram": {
          "type": "string",
          "description": "内存大小,单位:GB。",
          "example": "8"
        },
        "az_status": {
          "description": "其中key是可用区编号,value是规格所在az的状态。",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "example": {
            "az2xahz": "normal"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
