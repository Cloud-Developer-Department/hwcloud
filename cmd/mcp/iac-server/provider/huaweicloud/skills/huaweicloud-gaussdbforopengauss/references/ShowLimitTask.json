{
  "name": "ShowLimitTask",
  "summary": "查询限流任务详情",
  "tags": "SQL限流",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/limit-task/{task_id}": {
      "get": {
        "tags": [
          "SQL限流"
        ],
        "x-file": "limit_task",
        "x-is-registered": "Y",
        "operationId": "ShowLimitTask",
        "summary": "查询限流任务详情",
        "description": "查询限流任务详情",
        "x-support-sdk": "Y",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "required": true,
            "x-example": "******"
          },
          {
            "name": "task_id",
            "in": "path",
            "description": "限流任务id。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "4f07d3f50ce2466a9a7c014337b36409"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "**参数解释**:\n实例ID,此参数是用户创建实例的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "7912cd1077b2413fbd6f39a044777537in14"
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/LimitTaskInfoResponseBody"
            },
            "examples": {
              "application/json": {
                "limit_type": "SQL_ID",
                "task_name": "test1",
                "parallel_size": 100,
                "start_time": "2023-06-06T01:47:20+0800",
                "end_time": "2023-06-07T01:47:20+0800",
                "rule_name": "dsa48119d86512e0000bin066a1a27",
                "limit_count": 10000,
                "task_running_time": 1000,
                "limit_task_rule_info_list": [
                  {
                    "node_id": "test1",
                    "rule_id": 9,
                    "status": "WAIT_EXCUTE"
                  }
                ]
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "查询限流任务详情",
        "x-request-examples-url-1": "GET https://{endpoint}/rds/gaussdb/v3/4f07d3f50ce2466a9a7c014337b36409/instances/7912cd1077b2413fbd6f39a044777537in14/limit-task/be68bc5"
      }
    }
  },
  "definitions": {
    "LimitTaskInfoResponseBody": {
      "required": [
        "limit_type",
        "parallel_size",
        "task_running_time",
        "limit_count"
      ],
      "properties": {
        "task_name": {
          "description": "限流任务名传。",
          "type": "string"
        },
        "limit_type": {
          "description": "任务限流类型。",
          "type": "string"
        },
        "parallel_size": {
          "description": "并发数。",
          "type": "integer"
        },
        "start_time": {
          "description": "限流任务开始时间,格式为yyyy-mm-ddThh:mm:ssZ,当前时间指UTC时间。",
          "type": "string"
        },
        "end_time": {
          "description": "限流任务结束时间,格式为yyyy-mm-ddThh:mm:ssZ,当前时间指UTC时间。",
          "type": "string"
        },
        "task_running_time": {
          "description": "限流任务已执行时间,单位秒。",
          "type": "integer"
        },
        "limit_count": {
          "description": "限流任务拦截次数。",
          "type": "integer"
        },
        "rule_name": {
          "description": "规则名。",
          "type": "string"
        },
        "memory_utilization": {
          "description": "内存利用率,仅当任务类型为SESSION_ACTIVE_MAX_COUNT时,返回该值且与请求参数相同。",
          "type": "integer"
        },
        "cpu_utilization": {
          "description": "cpu利用率,仅当任务类型为SESSION_ACTIVE_MAX_COUNT时,返回该值且与请求参数相同。",
          "type": "integer"
        },
        "limit_task_rule_info_list": {
          "description": "限流任务列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/LimitTaskRuleInfoOption"
          }
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "LimitTaskRuleInfoOption": {
      "required": [
        "node_id",
        "rule_id",
        "status"
      ],
      "properties": {
        "node_id": {
          "description": "节点id。",
          "type": "string"
        },
        "rule_id": {
          "description": "规则id。",
          "type": "string"
        },
        "status": {
          "description": "状态,当前支持:CREATING,UPDATEING,DELETING,WAIT_EXCUTE,EXCUTING,TIME_OVER,DELETED,CREATE_FAILED,UPDATE_FAILED,DELETE_FAILED,EXCEPTION。",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}