{
  "name": "CreateLimitTask",
  "summary": "创建限流任务",
  "tags": "SQL限流",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/limit-task": {
      "post": {
        "tags": [
          "SQL限流"
        ],
        "x-file": "limit_task",
        "x-is-registered": "Y",
        "operationId": "CreateLimitTask",
        "summary": "创建限流任务",
        "description": "根据具体范围和类型,进行限流任务的创建",
        "x-support-sdk": "Y",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "required": true,
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "4f07d3f50ce2466a9a7c014337b36409"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "**参数解释**:\n实例ID,此参数是用户创建实例的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "7912cd1077b2413fbd6f39a044777537in14"
          },
          {
            "name": "CreateLimitTaskRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateLimitTaskRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/CreateLimitTaskResponseBody"
            },
            "examples": {
              "application/json": {
                "task_id": "59b6a1a278844ac48119d86512e0000",
                "task_name": "test1",
                "limit_type": "SQL_TYPE",
                "limit_type_value": "select",
                "key_words": "test",
                "databases": "test1",
                "status": "creating",
                "parallel_size": 100,
                "rule_name": "dsa48119d86512e0000bin066a1a27",
                "start_time": "2023-06-06T01:47:20+0800",
                "end_time": "2023-06-07T01:47:20+0800",
                "created": "2023-06-06T01:47:20+0800",
                "updated": "2023-06-06T01:47:20+0800",
                "creator": "dbs_01"
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "创建限流任务",
        "x-request-examples-url-1": "POST https://{endpoint}/rds/gaussdb/v3/4f07d3f50ce2466a9a7c014337b36409/instances/7912cd1077b2413fbd6f39a044777537in14/limit-task",
        "x-request-examples-1": {
          "task_scope": "SQL",
          "start_time": "2023-06-06T01:47:20+0800",
          "end_time": "2023-06-07T01:47:20+0800",
          "limit_type": "SQL_ID",
          "limit_type_value": "39b6a1a",
          "task_name": "test1",
          "sql_model": "select * from a where b = ?",
          "parallel_size": 100,
          "databases": "test1",
          "node_infos": [
            {
              "node_id": "e603348513654c209e4b955d98324655no14",
              "sql_id": "39b6a1a"
            }
          ]
        },
        "x-request-examples-url-2": "POST https://{endpoint}/rds/gaussdb/v3/4f07d3f50ce2466a9a7c014337b36409/instances/7912cd1077b2413fbd6f39a044777537in14/limit-task",
        "x-request-examples-2": {
          "task_scope": "SQL",
          "start_time": "2023-06-06T01:47:20+0000",
          "end_time": "2023-06-07T01:47:20+0000",
          "limit_type": "SQL_TYPE",
          "limit_type_value": "select",
          "task_name": "test1",
          "key_words": "table1,id",
          "parallel_size": 100,
          "databases": "test1"
        },
        "x-request-examples-url-3": "POST https://{endpoint}/rds/gaussdb/v3/4f07d3f50ce2466a9a7c014337b36409/instances/7912cd1077b2413fbd6f39a044777537in14/limit-task",
        "x-request-examples-3": {
          "task_scope": "SESSION",
          "start_time": "2023-06-06T01:47:20+0800",
          "end_time": "2023-06-07T01:47:20+0800",
          "limit_type": "SESSION_ACTIVE_MAX_COUNT",
          "limit_type_value": "CPU_OR_MEMORY",
          "cpu_utilization": 80,
          "memory_utilization": 80,
          "parallel_size": 100
        }
      }
    }
  },
  "definitions": {
    "CreateLimitTaskNodeOption": {
      "required": [
        "node_id",
        "sql_id"
      ],
      "properties": {
        "node_id": {
          "description": "**参数解释**:\n节点ID。\n**约束限制**:\n必须是当前实例的某一个节点ID。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "type": "string"
        },
        "sql_id": {
          "description": "**参数解释**:\n该节点执行的SQL语句ID。\n**约束限制**:\n如果“limit_type”为SQL_ID,必须与“limit_type_value”值一致。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "type": "string"
        }
      }
    },
    "CreateLimitTaskRequestBody": {
      "required": [
        "task_scope",
        "limit_type",
        "limit_type_value",
        "parallel_size",
        "task_name"
      ],
      "properties": {
        "task_scope": {
          "description": "限流任务范围,目前支持SQL,SESSION级别范围。",
          "type": "string"
        },
        "start_time": {
          "description": "任务开始时间,取值范围:非空且大于等于当前时间的前俩分钟,格式必须为yyyy-mm-ddThh:mm:ssZ,当前时间指UTC时间,SQL范围必传。",
          "type": "string"
        },
        "end_time": {
          "description": "任务结束时间,取值范围:非空且大于任务开始时间,格式必须为yyyy-mm-ddThh:mm:ssZ,当前时间指UTC时间,SQL范围必传。",
          "type": "string"
        },
        "limit_type": {
          "description": "限流类型:当限流范围为SQL级别时,可选SQL_ID、SQL_TYPE类型,当限流范围为SESSION级别时,可选SESSION_ACTIVE_MAX_COUNT类型。",
          "type": "string"
        },
        "limit_type_value": {
          "description": "限流类型,当限流类型为SQL_ID类型时,该值为选中模板的sqlId,当限流类型为SQL_TYPE类型时,值为SQL类型,目前支持select,update,insert,delete,meger五种值,当限流类型为SESSION_ACTIVE_MAX_COUNT类型时,只支持CPU_OR_MEMORY一种值。",
          "type": "string"
        },
        "key_words": {
          "description": "关键词,当且仅当类型为SQL_TYPE,必传,多个关键词以逗号隔开,数量范围为[2,100]个,每个关键词长度范围[2,64]位,关键词不允许包含 \" 或 \\ 或 {} 或 null值 以及非首尾的空格符。",
          "type": "string"
        },
        "task_name": {
          "description": "限流任务名,必传,只能为英文字母大小写,下划线,数字和$符,最大长度为100个字符。",
          "type": "string"
        },
        "sql_model": {
          "description": "CN节点执行过的SQL模板,如果类型为SQLID,则为必传。",
          "type": "string"
        },
        "parallel_size": {
          "description": "并发数,大于等于零的正整数,取值范围[0, 2147483647]。",
          "type": "integer"
        },
        "cpu_utilization": {
          "description": "cpu利用率阈值,正整数,取值范围[0,100),如果类型为SESSION_ACTIVE_MAX_COUNT,必传,不支持和内存利用率阈值同时为0,如果选择只限制CPU、内存中的其中一个,则另一个必须传值0。",
          "type": "integer"
        },
        "memory_utilization": {
          "description": "内存利用率阈值,正整数,取值范围[0,100),如果类型为SESSION_ACTIVE_MAX_COUNT,必传,不支持和cpu利用率阈值同时为0,如果选择只限制CPU、内存中的其中一个,则另一个必须传值0。",
          "type": "integer"
        },
        "databases": {
          "description": "CN节点数据库组,每个数据库字符串以逗号形式隔,如果类型为SQL_TYPE,则为必传。",
          "type": "string"
        },
        "node_infos": {
          "type": "array",
          "description": "CN节点信息列表,如果类型为SQL_ID,则为必传",
          "items": {
            "$ref": "#/definitions/CreateLimitTaskNodeOption"
          }
        }
      }
    },
    "CreateLimitTaskResponseBody": {
      "properties": {
        "task_id": {
          "description": "限流任务ID。",
          "type": "string"
        },
        "task_scope": {
          "description": "任务限流范围,与请求参数相同。",
          "type": "string"
        },
        "limit_type": {
          "description": "任务限流类型,与请求参数相同。",
          "type": "string"
        },
        "limit_type_value": {
          "description": "任务限流类型值,与请求参数相同。",
          "type": "string"
        },
        "databases": {
          "description": "CN节点数据库组,每个数据库字符串以逗号形式隔开。",
          "type": "string"
        },
        "task_name": {
          "description": "限流任务名。",
          "type": "string"
        },
        "sql_model": {
          "description": "SQL模板,仅当任务类型为SQL_ID时,返回该值且与请求参数相同。",
          "type": "string"
        },
        "key_words": {
          "description": "关键词,仅当任务类型为SQL_TYPE时,返回该值且与请求参数相同。",
          "type": "string"
        },
        "status": {
          "description": "限流任务状态,当前支持:CREATING,UPDATEING,DELETING,WAIT_EXCUTE,EXCUTING,TIME_OVER,DELETED,CREATE_FAILED,UPDATE_FAILED,DELETE_FAILED,EXCEPTION,NODE_SHUT_DOWN。",
          "type": "string"
        },
        "instance_id": {
          "description": "**参数解释**:\n实例ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "type": "string"
        },
        "rule_name": {
          "description": "规则名。",
          "type": "string"
        },
        "parallel_size": {
          "description": "并发数,与请求参数相同。",
          "type": "integer"
        },
        "cpu_utilization": {
          "description": "cpu利用率阈值,仅当任务类型为SESSION_ACTIVE_MAX_COUNT时,返回该值且只保留正整数。",
          "type": "integer"
        },
        "memory_utilization": {
          "description": "内存利用率阈值,仅当任务类型为SESSION_ACTIVE_MAX_COUNT时,返回该值且只保留正整数。",
          "type": "integer"
        },
        "start_time": {
          "description": "限流任务开始时间,与请求参数相同,格式为yyyy-mm-ddThh:mm:ssZ,当前时间指UTC时间。",
          "type": "string"
        },
        "end_time": {
          "description": "限流任务结束时间,与请求参数相同,格式为yyyy-mm-ddThh:mm:ssZ,当前时间指UTC时间。",
          "type": "string"
        },
        "created": {
          "description": "创建时间为本地时间,格式为yyyy-mm-ddThh:mm:ssZ。",
          "type": "string"
        },
        "updated": {
          "description": "更新时间为本地时间,格式为yyyy-mm-ddThh:mm:ssZ。",
          "type": "string"
        },
        "creator": {
          "description": "创建者。",
          "type": "string"
        },
        "modifier": {
          "description": "更新者。",
          "type": "string"
        },
        "node_infos": {
          "type": "array",
          "description": "CN节点信息列表,如果类型为SQLID,必返。",
          "items": {
            "$ref": "#/definitions/CreateLimitTaskNodeResult"
          }
        },
        "job_id": {
          "type": "string",
          "description": "工作流ID。"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "CreateLimitTaskNodeResult": {
      "properties": {
        "node_id": {
          "description": "节点id。",
          "type": "string"
        },
        "sql_id": {
          "description": "该节点执行的sql语句id。",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}