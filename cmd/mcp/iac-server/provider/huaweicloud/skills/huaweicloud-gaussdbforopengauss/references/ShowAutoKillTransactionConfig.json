        "type": {
          "type": "string",
          "example": "exec_time",
          "description": "**参数解释**:\n配置类型。\n**取值范围**:\n不涉及。"
        },
        "usernames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "root"
          ],
          "description": "**参数解释**:\n筛选用户名。"
        },
        "threshold": {
          "type": "integer",
          "format": "int64",
          "example": 86400,
          "description": "**参数解释**:\n阈值。\n**取值范围**:\n不涉及。"
        },
        "auto_stop": {
          "type": "boolean",
          "example": false,
          "description": "**参数解释**:\n配置是否开启。\n**取值范围**:\n不涉及。"
        },
        "database_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "postgres"
          ],
          "description": "**参数解释**:\n当前实例包含的所有数据库。"
        },
        "database_names_select": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "postgres"
          ],
          "description": "**参数解释**:\n筛选数据库名。"
        }
      }
    }
  },
