                  "root"
                ],
                "threshold": 86400,
                "auto_stop": false,
                "database_names": [
                  "postgres"
                ],
                "database_names_select": [
                  "postgres"
                ]
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ParaErrorResponseBody"
            }
          }
