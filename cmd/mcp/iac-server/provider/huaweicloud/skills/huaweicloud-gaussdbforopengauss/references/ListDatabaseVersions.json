{
  "name": "ListDatabaseVersions",
  "summary": "查询数据库引擎的版本",
  "tags": "引擎版本和规格",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3.2/{project_id}/datastore/versions": {
      "get": {
        "tags": [
          "引擎版本和规格"
        ],
        "operationId": "ListDatabaseVersions",
        "summary": "查询数据库引擎的版本",
        "description": "查询数据库引擎的版本。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "**参数解释**:\n语言。\n**约束限制**:\n不涉及。\n**取值范围**:\n- zh-cn \n- en-us\n\n**默认取值**:\nen-us",
            "type": "string",
            "x-example": "en-us",
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "default": "en-us",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "0483b6b16e954cb88930a360d2c4e663"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数解释**:\n索引位置,偏移量。从第一条数据偏移offset条数据后开始查询。例如:该参数指定为1,limit指定为10,则只展示第2-11条数据。\n**约束限制**:\n不涉及。\n**取值范围**:\n[0, 2^31-1]\n**默认取值**:\n不涉及。",
            "type": "integer",
            "x-example": 0,
            "required": false
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数解释**:\n查询记录数。例如该参数设定为10,则查询结果最多只显示10条记录。\n**约束限制**:\n不涉及。\n**取值范围**:\n[1, 100]\n**默认取值**:\n100",
            "type": "integer",
            "x-example": 10,
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/DatabaseVersionResponseBody"
            },
            "examples": {
              "application/json": {
                "database_versions": [
                  {
                    "software_version": "3.208.0",
                    "hotfixes": [
                      {
                        "version": "3.208.0.1",
                        "default_version": true,
                        "create_time": 1652084311000,
                        "deploy_modes": [
                          {
                            "default_upgrade": true,
                            "update_time": 1652084311000
                          }
                        ]
                      }
                    ]
                  }
                ],
                "total": 1
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "GET https://gaussdb-opengauss.cn-north-1.myhuaweicloud.com/v3.2/0483b6b16e954cb88930a360d2c4e663/datastore/versions",
        "x-order": 2
      }
    }
  },
  "definitions": {
    "HotfixDeployMode": {
      "properties": {
        "default_upgrade": {
          "description": "**参数解释**:\n补丁默认升级策略。\n**取值范围**:\n- true:无需选择,默认升级该版本。\n- false:用户可选,选择后升级该版本。",
          "type": "boolean"
        },
        "update_time": {
          "description": "**参数解释**:\n热补丁升级策略的修改时间,UNIX时间戳格式,单位是毫秒。\n**取值范围**:\n不涉及。",
          "type": "integer",
          "format": "int64"
        },
        "mode": {
          "description": "**参数解释**:\n可升级该补丁的实例部署形态。\n**取值范围**:\n- distributed:包括独立部署,基础版混合部署。\n- centralization_standard:包括主备版。",
          "type": "string",
          "enum": [
            "centralization_standard",
            "distributed"
          ]
        }
      }
    },
    "DatabaseVersionResult": {
      "properties": {
        "software_version": {
          "description": "**参数解释**:\n数据库三位引擎版本。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "hotfixes": {
          "description": "**参数解释**:\n数据库三位引擎版本对应的热补丁信息。\n**取值范围**:\n不涉及。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/DbHotfixInfoResult"
          }
        }
      }
    },
    "DatabaseVersionResponseBody": {
      "properties": {
        "database_versions": {
          "description": "**参数解释**:\n数据库版本列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/DatabaseVersionResult"
          }
        },
        "total": {
          "description": "**参数解释**:\n数据库三位引擎版本总个数。\n**取值范围**:\n不涉及。",
          "type": "integer"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "DbHotfixInfoResult": {
      "properties": {
        "version": {
          "description": "**参数解释**:\n热补丁版本。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "create_time": {
          "description": "**参数解释**:\n热补丁的创建时间,UNIX时间戳格式,单位是毫秒。\n**取值范围**:\n不涉及。",
          "type": "integer",
          "format": "int64"
        },
        "deploy_modes": {
          "description": "**参数解释**:\n可升级该补丁的实例部署形态信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/HotfixDeployMode"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
