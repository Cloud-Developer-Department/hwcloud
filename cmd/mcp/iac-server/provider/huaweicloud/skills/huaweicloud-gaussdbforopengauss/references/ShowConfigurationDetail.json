        "need_restart": {
          "type": "boolean",
          "description": "参数是否需要重启。\n- 取值为\"true\",需要重启。\n- 取值为\"false\",不需要重启。",
          "example": false
        },
        "readonly": {
          "type": "boolean",
          "description": "该参数是否只读(true:只读;false:可编辑)。",
          "example": false
