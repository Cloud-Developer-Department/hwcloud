  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/configurations/{config_id}": {
      "get": {
        "tags": [
          "参数配置"
        ],
        "operationId": "ShowConfigurationDetail",
        "summary": "查询参数模板详情",
        "description": "根据参数模板ID获取指定参数模板详情。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "false",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言,默认:en-us。",
            "type": "string",
            "x-example": "zh-cn",
            "enum": [
              "zh-cn",
              "en-us"
            ]
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "config_id",
            "in": "path",
            "description": "参数模板ID",
            "required": true,
            "type": "string",
            "x-example": "3ca44134a16d4bbab8eb701e025b19f7pr14"
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/ConfigurationDetailResponseBody"
            },
            "examples": {
              "application/json": {
                "id": "3ca44134a16d4bbab8eb701e025b19f7pr14",
                "name": "paramTemplate-a867",
                "description": "测试勿删",
                "engine_version": "2.3",
                "instance_mode": "independent",
                "created_at": "2022-08-05T08:15:07+0800",
                "updated_at": "2022-08-05T08:15:07+0800",
                "configuration_parameters": [
                  {
                    "name": "audit_system_object",
                    "value": "12294",
                    "need_restart": true,
                    "readonly": true,
                    "value_range": "0-2097151",
                    "data_type": "integer",
                    "description": "Determines whether to audit the CREATE, DROP, and ALTER operations on GaussDB Kernel database objects. GaussDB Kernel database objects include databases, users, schemas, and tables. You can change the parameter value to audit only the operations on required database objects. During a forcible primary/standby failover, set audit_system_object to the maximum value and audit all DDL objects. If the parameter value is incorrectly changed, DDL audit logs will be lost. Contact customer service personnel to change it."
                  }
                ]
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ParaErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/619d3e78f61b4be68bc5aa0b59edcf7b/configurations/3ca44134a16d4bbab8eb701e025b19f7pr14",
        "x-order": 10
      }
    }
  },
  "definitions": {
