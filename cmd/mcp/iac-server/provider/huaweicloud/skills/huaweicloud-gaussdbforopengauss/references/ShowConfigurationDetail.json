          "type": "string",
          "enum": [
            "string",
            "integer",
            "boolean",
            "list",
            "float"
          ],
          "example": "integer"
        },
        "description": {
          "description": "参数描述。",
          "type": "string",
          "example": "Determines whether to audit the CREATE, DROP, and ALTER operations on GaussDB Kernel database objects"
        }
      }
