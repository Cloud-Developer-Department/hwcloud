{
  "name": "ListFeatures",
  "summary": "查询实例特性列表",
  "tags": "实例管理",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/advance-features": {
      "get": {
        "tags": [
          "实例管理"
        ],
        "summary": "查询实例特性列表",
        "description": "查询当前实例高级特性列表。",
        "operationId": "ListFeatures",
        "x-apiexplorer-hide": "false",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "x-api-type": "open-api",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "**参数解释**:\n语言。\n**约束限制**:\n不涉及。\n**取值范围**:\n- zh-cn \n- en-us\n\n**默认取值**:\nen-us",
            "type": "string",
            "x-example": "en-us",
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "default": "en-us",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "**参数解释**:\n实例ID,此参数是用户创建实例的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein14"
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/ListFeaturesResponseBody"
            },
            "examples": {
              "application/json": {
                "features": [
                  {
                    "name": "ledger",
                    "status": true,
                    "description": "防篡改",
                    "type": "boolean",
                    "range": "on|off",
                    "range_description": "on代表开启,off代表关闭。",
                    "value": true
                  },
                  {
                    "name": "alt",
                    "status": false,
                    "description": "应用无损切换",
                    "type": "integer",
                    "range": "0-3600",
                    "range_description": "0表示关闭计划外应用无损透明设置,大于0表示开启。对应值表示在计划外应用无损透明特性中,session异常断开或者主备切换DN升主后暂时不回收旧版本数据的时间(单位为秒)。",
                    "value": 0
                  }
                ]
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/GaussDBErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "查询当前实例的高级特性列表,以及每个特性是否开启。",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/instances/e73893ef73754465a8bd2e0857bbf13ein14/advance-features"
      }
    }
  },
  "definitions": {
    "GaussDBErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "FeatureResult": {
      "properties": {
        "name": {
          "description": "特性名称。",
          "type": "string",
          "example": "ledger"
        },
        "status": {
          "description": "特性是否开启。",
          "type": "string",
          "example": true,
          "enum": [
            true,
            false
          ]
        },
        "description": {
          "description": "特性中文描述。",
          "type": "string",
          "example": "防篡改"
        },
        "type": {
          "description": "特性值类型。",
          "type": "string",
          "example": "integer",
          "enum": [
            "integer",
            "string",
            "boolean"
          ]
        },
        "value": {
          "description": "特性值。",
          "type": "string",
          "example": "on|off"
        },
        "range": {
          "description": "特性值范围。",
          "type": "string",
          "example": "on|off"
        },
        "range_description": {
          "description": "特性范围描述。",
          "type": "string",
          "example": "on代表开启,off代表关闭。"
        }
      }
    },
    "ListFeaturesResponseBody": {
      "properties": {
        "features": {
          "description": "高级特性列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FeatureResult"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}