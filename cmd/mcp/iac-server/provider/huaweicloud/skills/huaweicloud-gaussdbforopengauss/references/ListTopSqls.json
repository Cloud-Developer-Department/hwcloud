        "calls": {
          "description": "**参数解释**\nTop SQL的调用次数。\n**取值范围**\n大于等于0。",
          "type": "string",
          "example": "1"
        },
        "returned_rows": {
          "description": "**参数解释**\nTop SQL的返回元组数。\n**取值范围**\n大于等于0。",
          "type": "string",
          "example": "0"
        },
        "tuple_read": {
          "description": "**参数解释**\nTop SQL的读取元组数。\n**取值范围**\n大于等于0。",
          "type": "string",
          "example": "318"
        },
        "avg_elapse_time": {
          "description": "**参数解释**\nTop SQL的平均时间开销。单位ms。\n**取值范围**\n大于等于0。",
          "type": "string",
          "example": "21799"
        },
        "total_elapse_time": {
          "description": "**参数解释**\nTop SQL的总时间开销。单位ms。\n**取值范围**\n大于等于0。",
          "type": "string",
          "example": "21799"
        },
        "cpu_time": {
          "description": "**参数解释**:\nTop SQL的CPU开销。单位ms。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "21869"
        },
        "io_time": {
          "description": "**参数解释**:\nTop SQL的IO开销。单位ms。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "42"
        },
        "min_elapse_time": {
          "description": "**参数解释**:\nTop SQL的最小执行时间。单位ms。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "21799"
        },
        "max_elapse_time": {
          "description": "**参数解释**:\nTop SQL最大执行时间。单位ms。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "21799"
        },
        "sql_hit_ratio": {
          "description": "**参数解释**\nTop SQL的SQL命中率。\n**取值范围**\n大于等于0。",
          "type": "string",
          "example": "1.00"
        },
        "node_id": {
          "description": "**参数解释**:\nTop SQL的节点ID。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "0b46316a1c4d44fb8627042c82af6b29no14"
        },
        "db_name": {
          "description": "**参数解释**:\nTop SQL的数据库名(引擎版本8.200及以上支持)。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "postgres"
        },
        "node_name": {
          "description": "**参数解释**:\nTop SQL的节点名称。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "gauss-3c75-lc_root_0"
        }
      }
    },
