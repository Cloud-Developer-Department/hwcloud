{
  "name": "ListBackupsDetails",
  "summary": "查询备份列表",
  "tags": "备份管理",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3.2/{project_id}/backups": {
      "get": {
        "tags": [
          "备份管理"
        ],
        "operationId": "ListBackupsDetails",
        "summary": "查询备份列表",
        "x-constraint": "该接口支持查询GaussDB的手动全量备份及自动全量备份。",
        "description": "获取备份列表。",
        "x-apiexplorer-hide": "false",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "实例ID。",
            "x-example": "ef25188419f941309882d2986b2210b9in14"
          },
          {
            "name": "backup_id",
            "in": "query",
            "type": "string",
            "description": "备份ID。",
            "required": false
          },
          {
            "name": "backup_type",
            "in": "query",
            "type": "string",
            "enum": [
              "auto",
              "manual"
            ],
            "description": "备份类型,取值:\n  \"auto\":自动全量备份\n  \"manual\":手动全量备份",
            "required": false
          },
          {
            "name": "offset",
            "in": "query",
            "type": "integer",
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0(偏移0条数据,表示从第一条数据开始查询),必须为数字,不能为负数。",
            "minimum": 0,
            "required": false
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "description": "查询记录数。默认为100,不能为负数,最小值为1,最大值为100。",
            "minimum": 1,
            "maximum": 100,
            "required": false
          },
          {
            "name": "begin_time",
            "in": "query",
            "type": "string",
            "description": "查询开始时间,格式为“yyyy-mm-ddThh:mm:ssZ”。其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。与end_time必须同时使用。",
            "required": false
          },
          {
            "name": "end_time",
            "in": "query",
            "type": "string",
            "description": "查询结束时间,格式为“yyyy-mm-ddThh:mm:ssZ”,且大于查询开始时间。其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。与begin_time必须同时使用。",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/ListBackupsDetailsResponseBody"
            },
            "examples": {
              "application/json": {
                "backups": [
                  {
                    "id ": "43e4feaab48f11e89039fa163ebaa7e4br14",
                    "name": "xxxx.xxx",
                    "type": "manual",
                    "size": 2803,
                    "status": "COMPLETED",
                    "begin_time": "2018-08-06T12:41:14+0800",
                    "end_time": "2018-08-06T12:43:14+0800",
                    "datastore": {
                      "type": "GaussDB",
                      "version": "V2.0-1.4"
                    },
                    "databases": [
                      {
                        "name": "user01"
                      },
                      {
                        "name": "user02"
                      }
                    ],
                    "instance_id": "a48e43ff268f4c0e879652d65e63d0fbin14",
                    "associated_with_ddm": false
                  }
                ],
                "total_count": 1
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ResourceErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v3.2/054e292c9880d4992f02c0196d3ea468/backups?instance_id=a48e43ff268f4c0e879652d65e63d0fbin14"
      }
    }
  },
  "definitions": {
    "ListBackupsDetailsResponseBody": {
      "properties": {
        "backups": {
          "type": "array",
          "description": "备份信息。",
          "items": {
            "$ref": "#/definitions/ListBackupsResult"
          }
        },
        "total_count": {
          "type": "integer",
          "format": "int64",
          "description": "备份文件的总数。",
          "example": 11
        }
      }
    },
    "ListBackupsResult": {
      "properties": {
        "id": {
          "type": "string",
          "description": "备份ID。",
          "example": "1fe4feaab48f11e6654hfa163eba87e4b66u"
        },
        "name": {
          "type": "string",
          "description": "备份名称。",
          "example": "backups"
        },
        "description": {
          "type": "string",
          "description": "备份文件描述信息。"
        },
        "begin_time": {
          "type": "string",
          "description": "备份开始时间,格式为\"yyyy-mm-ddThh:mm:ssZ\"。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。",
          "example": "2018-08-06T12:41:14+0800"
        },
        "end_time": {
          "type": "string",
          "description": "备份结束时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。",
          "example": "2018-08-06T12:51:14+0800"
        },
        "status": {
          "enum": [
            "BUILDING:备份中。",
            "COMPLETED:备份完成。",
            "FAILED:备份失败。。"
          ],
          "type": "string",
          "description": "备份状态",
          "example": "BUILDING"
        },
        "size": {
          "type": "number",
          "format": "double",
          "description": "备份大小(单位:MB)",
          "example": 2803
        },
        "type": {
          "enum": [
            "auto:自动全量备份。",
            "manual:手动全量备份。"
          ],
          "type": "string",
          "description": "备份类型",
          "example": "auto"
        },
        "datastore": {
          "description": "数据库信息。",
          "$ref": "#/definitions/DatastoreResult"
        },
        "instance_id": {
          "type": "string",
          "description": "**参数解释**:\n实例ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "example": "43e4feaab48f11e89039fa163ebaa7e4in14"
        }
      }
    },
    "ResourceErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.200044"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "访问资源不存在,或者无访问权限。"
        }
      }
    },
    "DatastoreResult": {
      "required": [
        "type",
        "version"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "数据库引擎,不区分大小写,取值如下:\n\nGaussDB",
          "enum": [
            "GaussDB"
          ],
          "example": "GaussDB"
        },
        "version": {
          "type": "string",
          "description": "数据库版本。",
          "example": "V2.0-1.4"
        }
      },
      "description": "数据库版本。不填时,默认为当前最新版本。\n\n数据库支持版本可根据查询数据库引擎版本接口获取"
    }
  },
  "version": "2.0",
  "parameters": {},
