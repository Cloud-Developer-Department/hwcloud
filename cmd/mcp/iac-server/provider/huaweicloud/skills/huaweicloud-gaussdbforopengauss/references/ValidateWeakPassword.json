{
  "name": "ValidateWeakPassword",
  "summary": "弱密码校验",
  "tags": "实例管理",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/weak-password-verification": {
      "post": {
        "tags": [
          "实例管理"
        ],
        "operationId": "ValidateWeakPassword",
        "summary": "弱密码校验",
        "description": "校验数据库root用户密码的安全性。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "false",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "parameters": [
          {
            "name": "X-Auth-token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "**参数解释**:\n语言。\n**约束限制**:\n不涉及。\n**取值范围**:\n  - zh-cn\n  - en-us\n\n**默认取值**:\nen-us",
            "type": "string",
            "x-example": "zh-cn",
            "enum": [
              "zh-cn",
              "en-us"
            ]
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "0611f1bd8b00d5d32f17c017f15b599f"
          },
          {
            "name": "WeakPasswordRequestBody",
            "in": "body",
            "description": "弱密码请求参数。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/WeakPasswordRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/WeakPasswordResponseBody"
            },
            "examples": {
              "application/json": {
                "is_weak_password": false
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ParaErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v3/619d3e78f61b4be68bc5aa0b59edcf7b/weak-password-verification",
        "x-request-examples-1": {
          "password": "test_567@@"
        }
      }
    }
  },
  "definitions": {
    "ParaErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "WeakPasswordRequestBody": {
      "required": [
        "password"
      ],
      "properties": {
        "password": {
          "type": "string",
          "description": "数据库帐号密码。",
          "example": "***************"
        }
      }
    },
    "WeakPasswordResponseBody": {
      "properties": {
        "is_weak_password": {
          "type": "boolean",
          "description": "是否为弱密码。\n- 返回\"true\",是弱密码。\n- 返回\"false\",不是弱密码。",
          "example": false
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}