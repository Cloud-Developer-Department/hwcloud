        "operationId": "RunInstanceAction",
        "summary": "CN横向扩容/DN分片扩容/磁盘扩容",
        "description": "CN横向扩容/DN分片扩容/磁盘扩容",
        "x-apiexplorer-hide": "false",
        "x-support-sdk": "Y",
        "x-constraint": "- CN扩容\n  - CN横向扩容步长1~9。\n  - CN横向扩容后最大到256。\n  - 若创建实例时指定的可用区为1个,CN横向扩容需选择同一可用区。\n  - 扩容后,实例中CN节点的数量必须小于或等于两倍的分片数量。\n- DN扩容\n  - DN分片扩容单次步长限制1~9。\n  - DN分片扩容后最大到256。\n- 扩容实例磁盘\n  - 磁盘大小要求(分片数*40GB )的整数倍。\n  - 所有节点状态正常。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token",
            "type": "string",
            "x-example": "******",
            "required": false
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "**参数解释**:\n实例ID,此参数是用户创建实例的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "cc6fd964d93f4003851dfc29d57d30a5in14"
          },
          {
            "name": "InstanceActionRequest",
            "in": "body",
            "description": "请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OpenGaussInstanceActionRequest"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/JobIdResponseBody"
            },
            "examples": {
              "application/json": {
                "job_id": "2b414788a6004883a02390e2eb0ea227"
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "扩多CN",
        "x-request-examples-url-1": "POST https://gaussdb-opengauss.cn-north-1.myhuaweicloud.com/v3/0483b6b16e954cb88930a360d2c4e663/instances/cc6fd964d93f4003851dfc29d57d30a5in14/action",
        "x-request-examples-1": {
          "expand_cluster": {
            "coordinators": [
              {
                "az_code": "cn-north-4a"
              },
              {
                "az_code": "cn-north-4a"
              },
              {
                "az_code": "cn-north-4a"
              }
            ]
          }
        },
        "x-request-examples-description-2": "DN扩容",
        "x-request-examples-url-2": "POST https://gaussdb-opengauss.cn-north-1.myhuaweicloud.com/v3/0483b6b16e954cb88930a360d2c4e663/instances/cc6fd964d93f4003851dfc29d57d30a5in14/action",
        "x-request-examples-2": {
          "expand_cluster": {
            "shard": {
              "count": "1"
            }
          }
        },
        "x-request-examples-description-3": "磁盘扩容",
        "x-request-examples-url-3": "POST https://gaussdb-opengauss.cn-north-1.myhuaweicloud.com/v3/0483b6b16e954cb88930a360d2c4e663/instances/cc6fd964d93f4003851dfc29d57d30a5in14/action",
        "x-request-examples-3": {
          "enlarge_volume": {
            "size": 400
          }
        }
      }
    }
  },
  "definitions": {
    "OpenGaussShard": {
      "description": "DN分片扩容时必填",
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "description": "新增的DN分片扩容数大小",
          "type": "integer",
          "format": "int32",
          "example": 1
        }
      }
    },
    "OpenGaussCoordinators": {
      "description": "CN横向扩容时必填",
      "required": [
        "az_code"
      ],
      "properties": {
        "az_code": {
          "type": "string",
          "description": "新增CN横向扩容每个节点的可用区。如果需要扩容多个CN,请分别填写待扩容CN所在的可用区。\n\n不同区域的可用区请参考[地区和终端节点](https://developer.huaweicloud.com/endpoint)。\n\n说明:\n扩容后,实例中CN节点的数量必须小于或等于两倍的分片数量。",
          "example": "cn-north-4a"
        }
      }
    },
    "OpenGaussExpandCluster": {
      "description": "CN横向扩容/DN分片扩容时必填",
      "properties": {
        "coordinators": {
          "description": "CN横向扩容时必填",
          "type": "array",
          "items": {
            "$ref": "#/definitions/OpenGaussCoordinators"
          }
        },
        "shard": {
          "type": "object",
          "$ref": "#/definitions/OpenGaussShard"
        }
      }
    },
    "JobIdResponseBody": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "**参数解释**:\n任务ID。按需实例时仅返回任务ID。\n**取值范围**:\n不涉及。",
          "example": "6ad4eb1f-73bd-4876-aa31-aa9a1e41c4bc"
        },
        "order_id": {
          "type": "string",
          "description": "**参数解释**:\n订单ID。包周期实例时仅返回订单ID。\n**取值范围**:\n不涉及。",
          "example": "CS2205191100OWHLL"
        }
      },
      "description": ""
    },
    "OpenGaussEnlargeVolume": {
      "description": "扩容实例磁盘时必填。\n所需扩容到的磁盘容量大小。",
      "properties": {
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "GaussDB磁盘大小要求(分片数*40GB)的倍数;取值范围:(分片数*40GB)~(分片数*16TB)",
          "example": 400
        }
      },
      "required": [
        "size"
      ]
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "OpenGaussInstanceActionRequest": {
      "properties": {
        "expand_cluster": {
          "$ref": "#/definitions/OpenGaussExpandCluster"
        },
        "enlarge_volume": {
          "$ref": "#/definitions/OpenGaussEnlargeVolume"
        },
        "is_auto_pay": {
          "type": "string",
          "description": "包周期实例时可指定,表示是否自动从账户中支付,此字段不影响自动续订的支付方式。\n\ntrue,表示自动从账户中支付。\nfalse,表示手动从账户中支付,默认为该方式。",
          "enum": [
            true,
            false
          ]
        }
      },
      "description": ""
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}