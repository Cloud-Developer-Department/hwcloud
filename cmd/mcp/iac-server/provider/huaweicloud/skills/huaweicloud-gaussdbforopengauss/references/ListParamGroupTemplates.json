{
  "name": "ListParamGroupTemplates",
  "summary": "获取参数模板列表",
  "tags": "参数配置",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3.1/{project_id}/configurations": {
      "get": {
        "tags": [
          "参数配置"
        ],
        "operationId": "ListParamGroupTemplates",
        "summary": "获取参数模板列表",
        "description": "获取参数模板列表,包括所有数据库的默认参数模板和用户创建的参数模板。",
        "x-apiexplorer-hide": "false",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn",
            "enum": [
              "zh-cn",
              "en-us"
            ]
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0(偏移0条数据,表示从第一条数据开始查询),必须为数字,不能为负数。",
            "type": "integer",
            "x-example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询记录数。默认为100,不能为负数,最小值为1,最大值为100。",
            "type": "integer",
            "x-example": 4
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/ConfigurationsListResponseBody"
            },
            "examples": {
              "application/json": {
                "count": 1,
                "configurations": [
                  {
                    "id": "3bc1e9cc0d34404b9225ed7a58fb284epr14",
                    "name": "Default-Enterprise-Edition-GaussDB-2.0-INDEP",
                    "description": "Default parameter template for Enterprise Edition GaussDB 2.0-Independent",
                    "datastore_version": "2.0",
                    "datastore_name": "GaussDB",
                    "ha_mode": "enterprise",
                    "created": "2019-05-27T03:38:51+0000",
                    "updated": "2019-05-27T03:38:51+0000",
                    "user_defined": false
                  }
                ]
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{endpoint}/v3.1/054e292c9880d4992f02c0196d3ea468/configurations",
        "x-order": 8
      }
    }
  },
  "definitions": {
    "ConfigurationsListResponseBody": {
      "required": [
        "configurations",
        "count"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "description": "参数模板数量。",
          "example": 1
        },
        "configurations": {
          "description": "参数模板列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ConfigurationResult"
          }
        }
      }
    },
    "ConfigurationResult": {
      "description": "参数模板信息。",
      "required": [
        "id",
        "name",
        "datastore_version",
        "datastore_name",
        "ha_mode",
        "created",
        "updated",
        "user_defined"
      ],
      "properties": {
        "id": {
          "description": "参数组ID。",
          "type": "string",
          "example": "00902c3a047d48ebb05e9c79fd9f56a3pr14"
        },
        "name": {
          "description": "参数组名称。",
          "type": "string",
          "example": "Default-Enterprise-Edition-GaussDB-2.0-INDEP"
        },
        "description": {
          "description": "参数组描述。",
          "type": "string",
          "example": "Default parameter template for Enterprise Edition GaussDB 2.0-Independent"
        },
        "datastore_version": {
          "description": "引擎版本。",
          "type": "string",
          "example": "2.0"
        },
        "datastore_name": {
          "description": "引擎名称。",
          "type": "string",
          "example": "GaussDB"
        },
        "ha_mode": {
          "description": "实例类型。",
          "type": "string",
          "example": "enterprise"
        },
        "created": {
          "description": "创建时间,格式为\"yyyy-MM-dd HH:mm:ss\"。",
          "type": "string",
          "example": "2018-10-11 11:40:44"
        },
        "updated": {
          "description": "更新时间,格式为\"yyyy-MM-dd HH:mm:ss\"。",
          "type": "string",
          "example": "2018-10-11 11:40:44"
        },
        "user_defined": {
          "description": "是否是用户自定义参数模板:\n\n- false,表示为系统默认参数模板。\n- true,表示为用户自定义参数模板。",
          "type": "boolean",
          "example": "true"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
