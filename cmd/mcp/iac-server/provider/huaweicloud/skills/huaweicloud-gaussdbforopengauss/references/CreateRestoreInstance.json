{
  "name": "CreateRestoreInstance",
  "summary": "恢复到新实例",
  "tags": "备份恢复管理",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/instances": {
      "post": {
        "tags": [
          "备份恢复管理"
        ],
        "operationId": "CreateRestoreInstance",
        "summary": "恢复到新实例",
        "description": "根据备份恢复新实例。",
        "x-support-sdk": "Y",
        "x-constraint": "- 该接口只支持恢复到按需计费的实例。\n- 目标实例与源实例的数据库类型必须一致。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn",
            "enum": [
              "zh-cn",
              "en-us"
            ]
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "CreateInstanceRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OpengaussRestoreInstanceRequest"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/CreateInstanceResponseBody"
            },
            "examples": {
              "application/json": {
                "instance": {
                  "id": "2gfdsh844a4023a776fc5c5fb71fb4in14",
                  "name": "opengauss-instance-rep2",
                  "status": "BUILD",
                  "datastore": {
                    "type": "GaussDB(for openGauss)",
                    "version": "1.4"
                  },
                  "ha": {
                    "mode": "enterprise",
                    "consistency": "strong",
                    "replication_mode": "sync"
                  },
                  "volume": {
                    "type": "ULTRAHIGH",
                    "size": 160
                  },
                  "port": "8000",
                  "replica_num": 3,
                  "region": "regionA",
                  "backup_strategy": {
                    "start_time": "08:00-09:00",
                    "keep_days": 12
                  },
                  "enable_parallel_restore": false,
                  "flavor_ref": "gaussdb.opengauss.ee.dn.m6.2xlarge.8.in",
                  "availability_zone": "bbb,ccc",
                  "vpc_id": "490a4a08-ef4b-44c5-94be-3051ef9e4fce",
                  "subnet_id": "0e2eda62-1d42-4d64-a9d1-4e9aa9cd994f",
                  "security_group_id": "2a1f7fc8-3307-42a7-aa6f-42c8b9b8f8c5",
                  "charge_info": {
                    "charge_mode": "postPaid"
                  },
                  "configuration_id": "452408-ef4b-44c5-94be-305145fg",
                  "enterprise_project_id": "fdsa-3rds",
                  "time_zone": "UTC+04:00"
                },
                "job_id": "dff1d289-4d03-4942-8b9f-463ea07c000d"
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-4": "使用备份文件恢复到新实例",
        "x-request-examples-url-4": "POST https://rds.cn-north-1.myhuaweicloud.com/v3/054e292c9880d4992f02c0196d3ea468/instances",
        "x-request-examples-4": {
          "name": "targetInst",
          "availability_zone": "bbb,ccc",
          "flavor_ref": "gaussdb.opengauss.ee.dn.m6.2xlarge.8.in",
          "volume": {
            "type": "ULTRAHIGH",
            "size": 160
          },
          "disk_encryption_id": "2gfdsh-844a-4023-a776-fc5c5fb71fb4",
          "vpc_id": "490a4a08-ef4b-44c5-94be-3051ef9e4fce",
          "subnet_id": "0e2eda62-1d42-4d64-a9d1-4e9aa9cd994f",
          "security_group_id": "2a1f7fc8-3307-42a7-aa6f-42c8b9b8f8c5",
          "password": "Demo@12345678",
          "restore_point": {
            "instance_id": "d8e6ca5a624745bcb546a227aa3ae1cfin14",
            "backup_id": "2f4ddb93b9014b0893d81d2e472f30febr14"
          },
          "enable_parallel_restore": false,
          "backup_strategy": {
            "keep_days": 7,
            "start_time": "19:00-20:00"
          },
          "configuration_id": "52e86e87445847a79bf807ceda213165pr01",
          "enterprise_project_id": "ba1f7fc8-3307-42a7-aa6f-42c8b9b8f85c",
          "port": 8000,
          "time_zone": "UTC+04:00",
          "enable_force_switch": true
        }
      }
    }
  },
  "definitions": {
    "OpenGaussChargeInfo": {
      "description": "计费类型信息,仅支持按需和包周期。",
      "required": [
        "charge_mode"
      ],
      "properties": {
        "charge_mode": {
          "type": "string",
          "description": "计费模式。postPaid:后付费,即按需付费。prePaid:预付费,即包年/包月。",
          "enum": [
            "postPaid",
            "prePaid"
          ]
        },
        "period_type": {
          "type": "string",
          "description": "订购周期类型。month:包月。year:包年。\n说明:\n“charge_mode”为“prePaid”时生效,且为必选值。",
          "enum": [
            "month",
            "year"
          ]
        },
        "period_num": {
          "type": "integer",
          "description": "“charge_mode”为“prePaid”时生效,且为必选值,指定订购的时间。\n\n取值范围:\n\n当“period_type”为“month”时,取值为1~9。\n当“period_type”为“year”时,取值为1~3。\n\n当传入浮点型时,会自动截取为整型。"
        },
        "is_auto_renew": {
          "type": "boolean",
          "description": "创建包周期实例时可指定,表示是否自动续订,续订时会自动支付。\n按月订购时续订周期默认为1个月,按年订购时续订周期默认为1年,续订周期可自定义修改。\n\ntrue,表示自动续订。\nfalse,表示不自动续订,默认为该方式。"
        },
        "is_auto_pay": {
          "type": "boolean",
          "description": "创建包周期实例时可指定,表示是否自动从账户中支付,该字段不影响自动续订的支付方式。\n\ntrue,表示自动从账户中支付。\nfalse,表示手动从账户中支付,默认为该支付方式。"
        }
      }
    },
    "RestorePoint": {
      "required": [
        "instance_id",
        "backup_id"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "description": "源实例ID。",
          "example": "b000d7c91f1749da87315700793a11d4in14"
        },
        "backup_id": {
          "type": "string",
          "description": "用于恢复的备份ID。",
          "example": "8f643d252d834a4c916b2db4322f99552734br14"
        }
      }
    },
    "OpenGaussBackupStrategy": {
      "required": [
        "start_time"
      ],
      "description": "备份策略。",
      "properties": {
        "start_time": {
          "type": "string",
          "description": "备份时间段。自动备份将在该时间段内触发。\n\n取值范围:非空,格式必须为hh:mm-HH:MM且有效,当前时间指UTC时间。\n\n- HH取值必须比hh大1。\n- mm和MM取值必须相同,且取值必须为00。\n取值示例:\n\n- 08:00-09:00\n- 23:00-00:00",
          "example": "23:00-00:00"
        },
        "keep_days": {
          "type": "integer",
          "format": "int32",
          "description": "指定备份文件的可保存天数。\n\n取值范围:0~732。该参数缺省或为0时,默认填写为7天。"
        }
      }
    },
    "OpenGaussDatastoreResponse": {
      "required": [
        "type",
        "version"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "数据库引擎,不区分大小写,取值如下:\n\nGaussDB(for openGauss)",
          "enum": [
            "GaussDB",
            "GaussDB(for openGauss)"
          ],
          "example": "GaussDB"
        },
        "version": {
          "type": "string",
          "description": "数据库版本。",
          "example": "1.4"
        }
      },
      "description": "数据库版本。不填时,默认为当前最新版本。\n\n数据库支持版本可根据查询数据库引擎版本接口获取"
    },
    "OpenGaussBackupStrategyForResponse": {
      "required": [
        "start_time",
        "keep_days"
      ],
      "description": "自动备份策略。",
      "properties": {
        "start_time": {
          "type": "string",
          "description": "备份时间段。自动备份将在该时间段内触发。\n\n取值范围:非空,格式必须为hh:mm-HH:MM且有效,当前时间指UTC时间。\n\n- HH取值必须比hh大1。\n- mm和MM取值必须相同,且取值必须为00。\n取值示例:\n\n- 08:00-09:00\n- 23:00-00:00",
          "example": "23:00-00:00"
        },
        "keep_days": {
          "type": "integer",
          "format": "int32",
          "description": "指定已生成备份文件的可保存天数。\n\n取值范围:1~732。\n\n如果请求体中不填写“backup_strategy”字段,则响应体中 “keep_days”默认返回“7”。"
        }
      }
    },
    "OpenGaussVolume": {
      "required": [
        "type",
        "size"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "磁盘类型。  仅支持ULTRAHIGH和ESSD,区分大小写,分别表示SSD和急速云盘。",
          "enum": [
            "ULTRAHIGH",
            "ESSD"
          ],
          "example": "ULTRAHIGH"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "磁盘大小。例如:该参数填写为“40”,表示为创建的实例分配40GB的磁盘空间。\n\n取值范围:(分片数*40GB)~(分片数*16TB),且大小只能为分片数*40的整数倍。",
          "example": 40
        }
      },
      "description": "volume信息。"
    },
    "CreateInstanceResponseBody": {
      "required": [
        "instance",
        "job_id"
      ],
      "properties": {
        "instance": {
          "description": "实例信息。",
          "$ref": "#/definitions/CreateInstanceRespItem"
        },
        "job_id": {
          "type": "string",
          "description": "恢复新实例的任务id。\n\n仅恢复按需实例时会返回该参数。",
          "example": "dff1d289-4d03-4942-8b9f-463ea07c000d"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "OpenGaussHaResponse": {
      "required": [
        "mode",
        "replication_mode",
        "consistency"
      ],
      "description": "实例部署形态。",
      "properties": {
        "mode": {
          "type": "string",
          "description": "GaussDB 分布式模式,返回值为:Enterprise(企业版);主备版,返回值为:Ha(主备版)。",
          "enum": [
            "Enterprise",
            "Ha"
          ],
          "example": "Enterprise"
        },
        "replication_mode": {
          "type": "string",
          "description": "备机同步参数。\n\n取值:\n\nGaussDB为“sync”。\n说明:\n- “sync”为同步模式。",
          "enum": [
            "sync"
          ]
        },
        "consistency": {
          "type": "string",
          "description": "GaussDB的预留参数:指定实例一致性类型,取值范围:strong(强一致性) | eventual(最终一致性)。",
          "enum": [
            "strong",
            "eventual"
          ],
          "example": "strong"
        }
      }
    },
    "CreateInstanceRespItem": {
      "description": "实例信息。",
      "required": [
        "id",
        "name",
        "datastore",
        "status",
        "ha",
        "port",
        "replica_num",
        "backup_strategy",
        "charge_info",
        "flavor_ref",
        "volume",
        "region",
        "availability_zone",
        "vpc_id",
        "subnet_id",
        "security_group_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "实例id",
          "example": "b000d7c91f1749da87315700793a11d4in14"
        },
        "name": {
          "type": "string",
          "description": "实例名称。\n用于表示实例的名称,同一租户下,同类型的实例名可重名。\n取值范围:4~64个字符之间,必须以字母开头,区分大小写,可以包含字母、数字、中划线或者下划线,不能包含其他的特殊字符。"
        },
        "status": {
          "type": "string",
          "description": "实例状态。如BUILD,表示创建中。\n仅创建按需实例时会返回该参数。",
          "example": "BUILD"
        },
        "datastore": {
          "description": "数据库信息。",
          "$ref": "#/definitions/OpenGaussDatastoreResponse"
        },
        "ha": {
          "description": "数据库部署形态。",
          "$ref": "#/definitions/OpenGaussHaResponse"
        },
        "port": {
          "type": "string",
          "description": "数据库端口信息。 当不传该参数时,默认端口8000。",
          "example": "8000"
        },
        "volume": {
          "description": "实例存储信息。",
          "$ref": "#/definitions/OpenGaussVolumeResponse"
        },
        "replica_num": {
          "type": "integer",
          "description": "实例副本数。",
          "example": 3,
          "format": "int32"
        },
        "region": {
          "type": "string",
          "description": "区域ID。创建主实例时必选,其它场景不可选。\n取值参见[地区和终端节点](https://developer.huaweicloud.com/endpoint)。",
          "example": "regionA"
        },
        "backup_strategy": {
          "description": "自动备份策略。",
          "$ref": "#/definitions/OpenGaussBackupStrategyForResponse"
        },
        "flavor_ref": {
          "type": "string",
          "description": "规格码。",
          "example": "gaussdb.opengauss.ee.dn.m6.large.8.in"
        },
        "availability_zone": {
          "type": "string",
          "description": "可用区ID。GaussDB取值范围:非空,可选部署在同一可用区或三个不同可用区,可用区之间用逗号隔开。\n取值参见[地区和终端节点](https://developer.huaweicloud.com/endpoint)。",
          "example": "az1,az2"
        },
        "vpc_id": {
          "type": "string",
          "description": "虚拟私有云ID。",
          "example": "674e9b42-cd8d-4d25-a2e6-5abcc565b961"
        },
        "subnet_id": {
          "type": "string",
          "description": "子网ID。",
          "example": "f1df08c5-71d1-406a-aff0-de435a51007b"
        },
        "security_group_id": {
          "type": "string",
          "description": "安全组ID。",
          "example": "7aa51dbf-5b63-40db-9724-dad3c4828b58"
        },
        "charge_info": {
          "description": "付费方式信息,仅支持按需。",
          "$ref": "#/definitions/OpenGaussChargeInfo"
        }
      }
    },
    "OpenGaussVolumeResponse": {
      "required": [
        "type",
        "size"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "磁盘类型。\n\n取值如下,区分大小写:\n\n- ULTRAHIGH,表示SSD。\n- ESSD,表示急速云盘",
          "enum": [
            "ULTRAHIGH",
            "ESSD"
          ],
          "example": "ULTRAHIGH"
        },
        "size": {
          "type": "integer",
          "description": "磁盘大小。\n\nGaussDB分布式实例创建时需指定大小:要求必须为(分片数 * 40GB)的倍数,取值范围:(分片数*40GB)~(分片数*16TB)。",
          "example": 40
        }
      },
      "description": "volume信息。"
    },
    "OpengaussRestoreInstanceRequest": {
      "description": "实例信息。",
      "properties": {
        "name": {
          "type": "string",
          "description": "实例名称。\n用于表示实例的名称,同一租户下,同类型的实例名可重名。\n取值范围:4~64个字符之间,必须以字母开头,区分大小写,可以包含字母、数字、中划线或者下划线,不能包含其他的特殊字符。",
          "example": "test"
        },
        "availability_zone": {
          "type": "string",
          "description": "可用区ID。\n\nGaussDB取值范围:非空,可选部署在同一可用区或三个不同可用区,可用区之间用逗号隔开。详见示例。\n\n- 部署在同一可用区:需要输入三个相同的可用区。例如:部署在“cn-north-4a”可用区,则需要在此处输入\"cn-north-4a,cn-north-4a,cn-north-4a\"。\n- 部署在三个不同可用区:需要分别输入三个不同的可用区。\n取值范围:非空,请参见[地区和终端节点](https://developer.huaweicloud.com/endpoint)。",
          "example": "az1,az2"
        },
        "flavor_ref": {
          "type": "string",
          "description": "规格码,取值范围:非空。参考[表1](https://support.huaweicloud.com/api-opengauss/opengauss_api_0037.html#opengauss_api_0037__ted9b9d433c8a4c52884e199e17f94479)中GaussDB 的“规格编码”列内容获取。",
          "example": "gaussdb.opengauss.ee.dn.m6.2xlarge.8.in"
        },
        "volume": {
          "description": "磁盘信息。",
          "$ref": "#/definitions/OpenGaussVolume"
        },
        "disk_encryption_id": {
          "type": "string",
          "description": "用于磁盘加密的密钥ID,默认为空。",
          "example": "24ae42b5-4009-4ea2-b66a-0b211e424dab"
        },
        "vpc_id": {
          "type": "string",
          "description": "虚拟私有云ID,获取方法如下:\n\n- 方法1:登录虚拟私有云服务的控制台界面,在虚拟私有云的详情页面查找VPC ID。\n- 方法2:通过虚拟私有云服务的API接口查询,具体操作可参考[查询VPC列表](https://support.huaweicloud.com/api-vpc/vpc_api01_0003.html)。",
          "example": "674e9b42-cd8d-4d25-a2e6-5abcc565b961"
        },
        "subnet_id": {
          "type": "string",
          "description": "子网的网络ID信息,获取方法如下:\n\n- 方法1:登录虚拟私有云服务的控制台界面,单击VPC下的子网,进入子网详情页面,查找网络ID。\n- 方法2:通过虚拟私有云服务的API接口查询,具体操作可参考[查询子网列表](https://support.huaweicloud.com/api-vpc/vpc_subnet01_0003.html)。",
          "example": "f1df08c5-71d1-406a-aff0-de435a51007b"
        },
        "security_group_id": {
          "type": "string",
          "description": "指定实例所属的安全组。如果不需要指定安全组,请联系客服申请白名单。\n\n- 方法1:登录虚拟私有云服务的控制台界面,在安全组的详情页面查找安全组ID。\n- 方法2:通过虚拟私有云服务的API接口查询,具体操作可参考[查询安全组列表](https://support.huaweicloud.com/api-vpc/vpc_sg01_0003.html)。",
          "example": "7aa51dbf-5b63-40db-9724-dad3c4828b58"
        },
        "password": {
          "type": "string",
