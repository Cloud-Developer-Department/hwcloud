  "definitions": {
    "ShowUpgradeCandidateVersionsDetailsResponseBody": {
      "required": [
        "upgrade_type_list",
        "rollback_enabled",
        "source_version",
        "target_version",
        "roll_upgrade_progress",
        "upgrade_candidate_versions",
        "hotfix_upgrade_candidate_versions",
        "hotfix_rollback_candidate_versions",
        "hotfix_upgrade_infos",
        "hotfix_rollback_infos"
      ],
      "description": "版本升级信息",
      "properties": {
        "upgrade_type_list": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UpgradeTypeInfo"
          },
          "description": "升级类型信息列表",
          "minItems": 0,
          "maxItems": 1000
        },
        "rollback_enabled": {
          "type": "boolean",
          "description": "是否可以回滚,true可以回滚,false不可以回滚。"
        },
        "source_version": {
          "type": "string",
          "description": "原版本",
          "example": "V2.0-3.103.0",
          "minLength": 0,
          "maxLength": 1000
        },
        "target_version": {
          "type": "string",
          "description": "升级目标版本,没有在滚动升级中返回null。",
          "example": "V2.0-3.200.0",
          "minLength": 0,
          "maxLength": 1000
        },
        "roll_upgrade_progress": {
          "description": "滚动升级dn、az信息",
          "$ref": "#/definitions/RollUpgradeProgress"
        },
        "upgrade_candidate_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          "description": "可以升级的版本,包括大小版本,滚动升级中返回空数组。",
          "minItems": 0,
          "maxItems": 1000,
          "example": [
            "V2.0-3.200.0",
            "V2.0-4.200.0"
          ]
        },
        "hotfix_upgrade_candidate_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          "description": "可以升级的热补丁版本,滚动升级中返回空数组。",
          "minItems": 0,
          "maxItems": 1000,
          "example": [
            "V2.0-3.103.0.1",
            "V2.0-3.103.0.2"
          ]
        },
        "hotfix_rollback_candidate_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          "description": "可以回滚的热补丁版本,滚动升级中返回空数组。",
          "minItems": 0,
          "maxItems": 1000,
          "example": [
            "V2.0-3.103.0.1",
            "V2.0-3.103.0.2"
          ]
        },
        "hotfix_upgrade_infos": {
          "type": "array",
          "description": "可以升级的热补丁信息。",
          "items": {
            "$ref": "#/definitions/CanBeUpgradedHotfixDetail"
          }
        },
        "hotfix_rollback_infos": {
          "type": "array",
          "description": "可以回滚的热补丁信息。",
          "items": {
            "$ref": "#/definitions/CanBeRollbackedHotfixDetail"
          }
        }
      },
      "type": "object"
    },
    "UpgradeTypeInfo": {
      "description": "升级类型信息。",
      "properties": {
        "upgrade_type": {
          "type": "string",
          "description": "升级类型,grey=灰度升级,inplace=就地升级,hotfix=热补丁升级。",
          "minLength": 0,
          "maxLength": 1000,
          "example": "inplace",
          "enum": [
            "grey",
            "inplace",
            "hotfix"
          ]
        },
        "enable": {
          "type": "boolean",
          "description": "可用,不可用。",
          "example": false
        },
        "upgrade_action_list": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UpgradeActionInfo"
          },
          "description": "升级操作列表。",
          "minItems": 0,
          "maxItems": 1000
        },
        "is_parallel_upgrade": {
          "type": "boolean",
          "description": "是否正在进行AZ内并行升级。\n-true:当前实例处于灰度升级的升级待观察升级方式中,已选择了AZ内并行升级方式,后续无法更改。 -false:当前实例处于升级流程中,未选择AZ内并行升级的方式,后续无法更改。null:当前实例尚未处于升级流程中。",
          "example": false
        }
      },
      "type": "object"
    },
    "RollUpgradeProgress": {
      "description": "滚动升级信息。",
      "properties": {
        "upgraded_dn_group_numbers": {
          "type": "string",
          "description": "已升级分片数,非独立部署返回null。",
          "minLength": 0,
          "maxLength": 1000,
          "example": 1
        },
        "total_dn_group_numbers": {
          "type": "string",
          "description": "总分片数,非独立部署返回null。",
          "minLength": 0,
          "maxLength": 1000,
          "example": 10
        },
        "not_fully_upgraded_az": {
          "type": "string",
          "description": "未完成升级的az,以“,”隔开,独立部署返回null。",
          "minLength": 0,
          "maxLength": 1000,
          "example": "az1"
        },
        "already_upgraded_az": {
          "type": "string",
          "description": "已升级az,以“,”隔开,独立部署返回null。",
          "minLength": 0,
          "maxLength": 1000,
          "example": "az2,az3"
        },
        "az_description_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 100
          },
          "description": "az描述键值对Map<String,String>。",
          "example": {
            "az1.dc0": "可用区1",
            "az0.dc0": "az1"
          }
        }
      },
      "type": "object"
    },
    "CanBeRollbackedHotfixDetail": {
      "description": "可以回退的热补丁信息。",
      "properties": {
        "version": {
          "type": "string",
          "description": "热补丁版本。",
          "minLength": 0,
          "maxLength": 1000,
          "example": "V2.0-3.223.0.1"
        },
        "common_patch": {
          "type": "string",
          "description": "通用/非通用补丁信息。\n枚举值:\n  \"common\": 通用补丁。\n  \"certain\": 定制补丁。",
          "minLength": 0,
          "maxLength": 1000,
          "example": "common"
        },
        "backup_sensitive": {
          "type": "boolean",
          "description": "是否和备份相关。",
          "example": false
        },
        "descripition": {
          "type": "string",
          "description": "补丁的描述信息。",
          "minLength": 0,
          "maxLength": 1000,
          "example": "热补丁回退。"
        }
      },
      "type": "object"
    },
    "UpgradeActionInfo": {
      "description": "升级操作信息。",
      "properties": {
        "upgrade_action": {
          "type": "string",
          "description": "升级操作,upgrade=升级,upgradeAutoCommit=升级自动提交,commit=提交,rollback=回滚。",
          "minLength": 0,
          "maxLength": 1000,
          "example": "upgrade",
          "enum": [
            "upgrade",
            "upgradeAutoCommit",
            "commit",
            "rollback"
          ]
        },
        "enable": {
          "type": "boolean",
          "description": "可用,不可用。",
          "example": false
        }
      },
      "type": "object"
    },
    "UpgradeErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "CanBeUpgradedHotfixDetail": {
      "description": "可以升级的热补丁信息。",
      "properties": {
        "version": {
          "type": "string",
          "description": "热补丁版本。",
          "minLength": 0,
          "maxLength": 1000,
          "example": "V2.0-3.223.0.2"
        },
        "common_patch": {
          "type": "string",
          "description": "通用/非通用补丁信息。\n枚举值:\n  \"common\": 通用补丁。\n  \"certain\": 定制补丁。",
          "minLength": 0,
          "maxLength": 1000,
          "example": "common"
        },
        "backup_sensitive": {
          "type": "boolean",
          "description": "是否和备份相关。",
          "example": false
        },
        "descripition": {
          "type": "string",
          "description": "补丁的描述信息。",
          "minLength": 0,
          "maxLength": 1000,
          "example": "热补丁升级。"
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
