                    },
                    "job_id": "2cc16e0b-75ab-4a28-9453-16517e990bba",
                    "name": "DeleteGaussDBV5Instance",
                    "status": "Completed",
                    "process": "",
                    "created_at": 1660198168706,
                    "ended_at": 1660198535229,
                    "fail_reason": null
                  }
                ],
                "total_count": 2
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ParaErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v3/0611f1bd8b00d5d32f17c017f15b599f/tasks?status=Running&name=CreateGaussDBV5Instance&offset=1&limit=10"
      }
    }
  },
  "definitions": {
    "ParaErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "InstanceInfoResult": {
      "properties": {
        "instance_id": {
          "type": "string",
          "description": "**参数解释**:\n实例ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
        },
        "instance_name": {
          "type": "string",
          "description": "实例名称。"
        },
        "instance_status": {
          "type": "string",
          "description": "实例状态。"
        }
      }
    },
