{
  "name": "ListTasks",
  "summary": "查询任务列表",
  "tags": "任务管理",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/tasks": {
      "get": {
        "tags": [
          "任务管理"
        ],
        "operationId": "ListTasks",
        "summary": "查询任务列表",
        "description": "获取任务中心的任务列表。",
        "x-apiexplorer-hide": "false",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "x-constraint": "最多查询最近一个月的任务列表。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "**参数解释**:\n语言。\n**约束限制**:\n不涉及。\n**取值范围**:\n  - zh-cn\n  - en-us\n\n**默认取值**:\nen-us",
            "type": "string",
            "x-example": "zh-cn",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "status",
            "in": "query",
            "description": "任务状态。",
            "required": false,
            "type": "string",
            "enum": [
              "Running",
              "Completed",
              "Failed"
            ]
          },
          {
            "name": "name",
            "in": "query",
            "description": "任务名称。",
            "required": false,
            "type": "string",
            "enum": [
              "CreateGaussDBV5Instance",
              "BackupSnapshotGaussDBV5InInstance",
              "CloneGaussDBV5NewInstance",
              "RestoreGaussDBV5InInstance",
              "RestoreGaussDBV5InInstanceToExistedInst",
              "DeleteGaussDBV5Instance",
              "EnlargeGaussDBV5Volume",
              "ResizeGaussDBV5Flavor",
              "GaussDBV5ExpandClusterCN",
              "GaussDBV5ExpandClusterDN"
            ]
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "开始时间。",
            "required": false,
            "type": "string",
            "x-example": "1607731200000"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "结束时间。",
            "required": false,
            "type": "string",
            "x-example": "1607756414000"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0(偏移0条数据,表示从第一条数据开始查询),必须为数字,不能为负数。",
            "type": "integer",
            "required": false
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询记录数。默认为100,不能为负数,最小值为1,最大值为100",
            "type": "integer",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/ListTasksResponseBody"
            },
