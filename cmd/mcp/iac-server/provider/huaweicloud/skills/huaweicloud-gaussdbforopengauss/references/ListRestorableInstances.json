{
  "name": "ListRestorableInstances",
  "summary": "查询可用于备份恢复的实例列表",
  "tags": "备份管理",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/restorable-instances": {
      "get": {
        "tags": [
          "备份管理"
        ],
        "operationId": "ListRestorableInstances",
        "summary": "查询可用于备份恢复的实例列表",
        "description": "查询可用于备份恢复的实例列表,实例信息要符合备份条件。",
        "x-apiexplorer-hide": "false",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "**参数解释**:\n语言。\n**约束限制**:\n不涉及。\n**取值范围**:\n  - zh-cn\n  - en-us\n\n**默认取值**:\nen-us",
            "type": "string",
            "x-example": "zh-cn",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "source_instance_id",
            "in": "query",
            "description": "源实例id,需要恢复的实例ID。",
            "required": true,
            "type": "string",
            "x-example": "11c4c867415f4811842b05dcac665c29in14"
          },
          {
            "name": "backup_id",
            "in": "query",
            "description": "实例备份信息ID,根据备份ID查询实例拓扑信息,过滤查询出来的实例,包含节点数,副本数等。参数为空时,根据restore_time查询。。",
            "required": false,
            "type": "string",
            "x-example": "11c4c867415f4811842b05dcac665c29in14"
          },
          {
            "name": "restore_time",
            "in": "query",
            "description": "恢复点,当备份ID为空时,通过此参数查询实例拓扑信息,过滤实例列表。",
            "required": false,
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0(偏移0条数据,表示从第一条数据开始查询),必须为数字,不能为负数。",
            "type": "integer",
            "required": false
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询记录数。默认为100,不能为负数,最小值为1,最大值为100。",
            "type": "integer",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/ListRestorableInstancesResponseBody"
            },
            "examples": {
              "application/json": {
                "instance_list": [
                  {
                    "instance_name": "gaussdb_hzx",
                    "instance_id": "3ea6d6463c9a4baf9a47c5b74464307cin14",
                    "volume_type": "ULTRAHIGH",
                    "data_volume_size": 500,
                    "version": 1.3,
                    "mode": "Ha",
                    "instance_mode": "enterprise"
                  }
                ],
                "total_count": 1
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ParaErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v3/0611f1bd8b00d5d32f17c017f15b599f/restore-candidates?source_instance_id=88efb3753dc844829c380edff7798eecin14&backup_id=d3f223e9c35d450ea0692bdbff686e45br14"
      }
    }
  },
  "definitions": {
    "ParaErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "InstancesResult": {
      "properties": {
        "instance_name": {
          "type": "string",
          "description": "实例名称。"
        },
        "instance_id": {
          "type": "string",
          "description": "**参数解释**:\n实例ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
        },
        "volume_type": {
          "type": "string",
          "description": "存储类型。"
        },
        "data_volume_size": {
          "type": "number",
          "description": "磁盘大小,单位:GB。"
        },
        "version": {
          "type": "string",
          "description": "实例版本信息。"
        },
        "mode": {
          "type": "string",
          "description": "部署形态。",
          "enum": [
            "Ha",
            "Independent"
          ]
        },
        "instance_mode": {
          "type": "string",
          "description": "实例模型,企业版,标准版,基础版。",
          "enum": [
            "enterprise",
            "standard",
            "basic"
          ]
        }
      }
    },
    "ListRestorableInstancesResponseBody": {
      "properties": {
        "instances": {
          "type": "array",
          "description": "返回可用于备份恢复的实例列表。",
          "items": {
            "$ref": "#/definitions/InstancesResult"
          }
        },
        "total_count": {
          "type": "integer",
          "description": "查询出来的实例总数。",
          "example": 10
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}