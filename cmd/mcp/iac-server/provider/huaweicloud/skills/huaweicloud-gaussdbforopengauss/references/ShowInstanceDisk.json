            "required": true,
            "type": "string",
            "x-example": "054e292c9880d4992f02c0196d3ea468"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "**参数解释**:\n实例ID,此参数是用户创建实例的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "11c4c867415f4811842b05dcac665c29in14"
          }
        ],
        "responses": {
