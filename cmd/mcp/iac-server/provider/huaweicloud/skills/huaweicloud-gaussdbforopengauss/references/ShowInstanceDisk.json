                "used": "15.0",
                "total": "185.0"
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ParaErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v3/054e292c9880d4992f02c0196d3ea468/instances/11c4c867415f4811842b05dcac665c29in14/volume-usage"
      }
    }
  },
  "definitions": {
    "ParaErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
