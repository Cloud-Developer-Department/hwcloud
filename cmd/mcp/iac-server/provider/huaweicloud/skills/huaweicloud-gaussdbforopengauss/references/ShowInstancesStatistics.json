{
  "name": "ShowInstancesStatistics",
  "summary": "实例状态统计",
  "tags": "首页总览",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/instances-statistics": {
      "get": {
        "tags": [
          "首页总览"
        ],
        "operationId": "ShowInstancesStatistics",
        "summary": "实例状态统计",
        "description": "实例状态统计。",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/instances-statistics",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "**参数解释**:\n语言。\n**约束限制**:\n不涉及。\n**取值范围**:\n  - zh-cn\n  - en-us\n\n**默认取值**:\nen-us",
            "type": "string",
            "default": "en-us",
            "x-example": "en-us",
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/InstancesStatisticsResponseBody"
            },
            "examples": {
              "application/json": {
                "total_count": "10,",
                "instances_statistics": [
                  {
                    "status": "normal",
                    "count": 1
                  },
                  {
                    "status": "abnormal",
                    "count": 2
                  },
                  {
                    "status": "creating",
                    "count": 3
                  },
                  {
                    "status": "createfail",
                    "count": 4
                  }
                ]
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "InstancesStatisticsResponseBody": {
      "required": [
        "total_count",
        "instances_statistics"
      ],
      "properties": {
        "total_count": {
          "type": "integer",
          "description": "**参数解释**:\n实例总数。\n**取值范围**:\n不涉及。",
          "example": 2
        },
        "instances_statistics": {
          "type": "array",
          "description": "**参数解释**:\n实例统计信息。\n**取值范围**:\n不涉及。",
          "items": {
            "type": "object",
            "required": [
              "status",
              "count"
            ],
            "properties": {
              "status": {
                "type": "string",
                "example": "normal",
                "description": "**参数解释**:\n实例状态。\n**取值范围**:\n- normal:实例状态正常。\n- abnormal:实例状态异常。\n- creating:实例创建中。\n- createfail:实例创建失败。\n- shutdown:实例已关机。\n- deleted:实例已删除。"
              },
              "count": {
                "type": "integer",
                "description": "**参数解释**:\n实例数量。\n**取值范围**:\n不涉及。",
                "example": 2
              }
            }
          }
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}