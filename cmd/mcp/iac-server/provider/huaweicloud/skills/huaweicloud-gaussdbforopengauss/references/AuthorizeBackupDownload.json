{
  "name": "AuthorizeBackupDownload",
  "summary": "授权备份文件下载",
  "tags": "备份管理",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/backups/{backup_id}/download/authorization": {
      "post": {
        "tags": [
          "备份管理"
        ],
        "summary": "授权备份文件下载",
        "description": "授权租户使用OBS Browser+方式下载备份文件,支持实例级、表级的全量备份及差量备份。",
        "operationId": "AuthorizeBackupDownload",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "en-us",
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "default": "en-us",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "backup_id",
            "in": "path",
            "description": "**参数解释**:\n备份ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "afbf982b46ca421e9118f7db916058b5br14"
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/DownloadObsBackupResponseBody"
            },
            "examples": {
              "application/json": {
                "bucket": "dbsbucket.cn.xianhz.1.078ed4a64e00d4ae0fabc00f65551980",
                "file_paths": [
                  "078ed4ac3c00d4ac1fd0c00fe39354bf_948249a358984ebe83cb6b2f380ad190in14/Snapshot/1703233711888"
                ]
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/backups/afbf982b46ca421e9118f7db916058b5br14/download/authorization",
        "x-order": 0,
        "x-api-type": "open-api",
        "x-file": "haoqian"
      }
    }
  },
  "definitions": {
