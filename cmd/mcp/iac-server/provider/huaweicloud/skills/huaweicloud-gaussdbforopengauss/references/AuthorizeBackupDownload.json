      "required": [
        "bucket",
        "file_paths"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "description": "**参数解释**:\n文件所在桶名。\n**取值范围**:\n不涉及。",
          "example": "dbsbucket.cn.xianhz.1.078ed4a64e00d4ae0fabc00f65551980"
        },
        "file_paths": {
          "type": "array",
