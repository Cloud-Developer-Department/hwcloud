              "$ref": "#/definitions/OpenGaussInstanceRequest"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/OpenGaussCreateInstanceResponse"
            },
            "examples": {
