  },
  "definitions": {
    "OpenGaussInstanceRequest": {
      "description": "实例信息",
      "required": [
        "name",
        "datastore",
        "ha",
        "password",
        "flavor_ref",
        "volume",
        "region",
        "availability_zone",
        "vpc_id",
        "subnet_id",
        "security_group_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "实例名称。\n用于表示实例的名称,同一租户下,同类型的实例名可重名。\n\n取值范围:4~64个字符之间,必须以字母开头,区分大小写,可以包含字母、数字、中划线或者下划线,不能包含其他的特殊字符。"
        },
        "datastore": {
          "$ref": "#/definitions/OpenGaussDatastore"
        },
        "ha": {
          "$ref": "#/definitions/OpenGaussHa"
        },
        "configuration_id": {
          "type": "string",
          "description": "参数模板ID。当不传该参数时,使用系统默认的参数模板。",
          "example": "452408-ef4b-44c5-94be-305145fg"
        },
        "port": {
          "type": "string",
          "description": "数据库对外开放的端口,不填默认为8000,可选范围为:1024-39998。限制端口: 2378,2379,2380,4999,5000,5999,6000,6001,8097,8098,12016,12017,20049,20050,21731,21732,32122,32123,32124。\n\n- GaussDB数据库端口当前只支持设置为8000,当不传该参数时,默认端口为8000。",
          "example": "3306"
        },
        "password": {
          "type": "string",
          "description": "数据库密码。必选。\n\n取值范围:\n\n'非空; 至少包含大写字母(A-Z),小写字母(a-z),数字(0-9),非字母数字字符(限定为~!@#%^*-_=+?,)四类字符中的三类字符;长度8~32个字符。'\n\n'建议您输入高强度密码,以提高安全性,防止出现密码被暴力破解等安全风险。'"
        },
        "backup_strategy": {
          "$ref": "#/definitions/OpenGaussBackupStrategy"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。只有企业租户时该参数才生效。\n\n使用请参考《企业管理 API参考》的“[查询企业项目列表](https://support.huaweicloud.com/api-em/zh-cn_topic_0121230880.html)”响应消息表“enterprise_project字段数据结构说明”的“id”。"
        },
        "disk_encryption_id": {
          "type": "string",
          "description": "用于磁盘加密的密钥ID,默认为空。"
        },
        "flavor_ref": {
          "type": "string",
          "description": "规格码,取值范围:非空。参考[表1](https://support.huaweicloud.com/api-opengauss/opengauss_api_0037.html#opengauss_api_0037__ted9b9d433c8a4c52884e199e17f94479)中GaussDB 的“规格编码”列内容获取。",
          "example": "gaussdb.opengauss.ee.dn.m6.large.8.in"
        },
        "volume": {
          "$ref": "#/definitions/OpenGaussVolume"
        },
        "region": {
          "type": "string",
          "description": "区域ID。\n\n取值范围:非空,请参见[地区和终端节点](https://developer.huaweicloud.com/endpoint)。"
        },
        "availability_zone": {
          "type": "string",
          "description": "可用区ID。\n\nGaussDB取值范围:非空,可选部署在同一可用区或三个不同可用区,可用区之间用逗号隔开。详见示例。\n\n- 部署在同一可用区:需要输入三个相同的可用区。例如:部署在“cn-north-4a”可用区,则需要在此处输入\"cn-north-4a,cn-north-4a,cn-north-4a\"。\n- 部署在三个不同可用区:需要分别输入三个不同的可用区。\n取值范围:非空,请参见[地区和终端节点](https://developer.huaweicloud.com/endpoint)。",
          "example": "cn-north-4a,cn-north-4a,cn-north-4a"
        },
        "vpc_id": {
          "type": "string",
          "description": "虚拟私有云ID,获取方法如下:\n\n- 方法1:登录虚拟私有云服务的控制台界面,在虚拟私有云的详情页面查找VPC ID。\n- 方法2:通过虚拟私有云服务的API接口查询,具体操作可参考[查询VPC列表](https://support.huaweicloud.com/api-vpc/vpc_api01_0003.html)。"
        },
        "subnet_id": {
          "type": "string",
          "description": "子网的网络ID信息,获取方法如下:\n\n- 方法1:登录虚拟私有云服务的控制台界面,单击VPC下的子网,进入子网详情页面,查找网络ID。\n- 方法2:通过虚拟私有云服务的API接口查询,具体操作可参考[查询子网列表](https://support.huaweicloud.com/api-vpc/vpc_subnet01_0003.html)。"
        },
        "security_group_id": {
          "type": "string",
          "description": "指定实例所属的安全组。如果不需要指定安全组,请联系客服申请白名单。\n\n- 方法1:登录虚拟私有云服务的控制台界面,在安全组的详情页面查找安全组ID。\n- 方法2:通过虚拟私有云服务的API接口查询,具体操作可参考[查询安全组列表](https://support.huaweicloud.com/api-vpc/vpc_sg01_0003.html)。"
        },
        "charge_info": {
          "$ref": "#/definitions/OpenGaussChargeInfo"
        },
        "time_zone": {
          "type": "string",
          "description": "UTC时区。\n\n- 不选择时,GaussDB国内站、默认为UTC时间。\n- 选择填写时,取值范围为UTC-12:00~UTC+12:00,且只支持整段时间,如UTC+08:00,不支持UTC+08:30。"
        },
        "sharding_num": {
          "type": "integer",
          "format": "int32",
          "description": "仅分布式形态需要填写该参数。分片数量,取值范围1~9。",
          "example": 1
        },
        "coordinator_num": {
          "type": "integer",
          "format": "int32",
          "description": "仅分布式形态需要填写该参数。协调节点数量,取值范围1~9。CN数量必须小于或等于两倍的分片数。",
          "example": 1
        },
        "replica_num": {
          "type": "integer",
          "description": "实例副本数,支持取值3。不填默认为3。仅支持1.3.0及以上版本的实例。",
          "example": 3,
          "enum": [
            3
          ],
          "format": "int32"
        },
        "enable_force_switch": {
          "type": "boolean",
          "description": "enable_force_switch表示是否开启备机强升主功能,enable_force_switch=true表示开启备机强升主功能,enable_force_switch=false表示关闭,默认关闭。仅支持1.2.2及以上版本。\n\n说明:\n\n备机强升主功能适用场景:在主机发生故障后,为了保障集群的可用性,强制拉起备机作为新主机对外提供服务的场景。 本功能在集群故障状态下,以丢失部分数据为代价换取集群尽可能快的恢复服务。本功能是集群状态为不可用时的一个逃生方法,如果操作者不清楚备机强升后丢失数据对业务的影响,请勿使用本功能。 备机强升主相关介绍请参考《故障处理》备机强升主章节。",
          "example": false
        }
      }
    },
    "OpenGaussChargeInfo": {
      "description": "计费类型信息,仅支持按需和包周期。",
      "required": [
        "charge_mode"
      ],
      "properties": {
        "charge_mode": {
          "type": "string",
          "description": "计费模式。postPaid:后付费,即按需付费。prePaid:预付费,即包年/包月。",
          "enum": [
            "postPaid",
            "prePaid"
          ]
        },
        "period_type": {
          "type": "string",
          "description": "订购周期类型。month:包月。year:包年。\n说明:\n“charge_mode”为“prePaid”时生效,且为必选值。",
          "enum": [
            "month",
            "year"
          ]
        },
        "period_num": {
          "type": "integer",
          "description": "“charge_mode”为“prePaid”时生效,且为必选值,指定订购的时间。\n\n取值范围:\n\n当“period_type”为“month”时,取值为1~9。\n当“period_type”为“year”时,取值为1~3。\n\n当传入浮点型时,会自动截取为整型。"
        },
        "is_auto_renew": {
          "type": "boolean",
          "description": "创建包周期实例时可指定,表示是否自动续订,续订时会自动支付。\n按月订购时续订周期默认为1个月,按年订购时续订周期默认为1年,续订周期可自定义修改。\n\ntrue,表示自动续订。\nfalse,表示不自动续订,默认为该方式。"
        },
        "is_auto_pay": {
          "type": "boolean",
          "description": "创建包周期实例时可指定,表示是否自动从账户中支付,该字段不影响自动续订的支付方式。\n\ntrue,表示自动从账户中支付。\nfalse,表示手动从账户中支付,默认为该支付方式。"
        }
      }
    },
    "OpenGaussBackupStrategy": {
      "required": [
        "start_time"
      ],
      "description": "备份策略。",
      "properties": {
        "start_time": {
          "type": "string",
          "description": "备份时间段。自动备份将在该时间段内触发。\n\n取值范围:非空,格式必须为hh:mm-HH:MM且有效,当前时间指UTC时间。\n\n- HH取值必须比hh大1。\n- mm和MM取值必须相同,且取值必须为00。\n取值示例:\n\n- 08:00-09:00\n- 23:00-00:00",
          "example": "23:00-00:00"
        },
        "keep_days": {
          "type": "integer",
          "format": "int32",
          "description": "指定备份文件的可保存天数。\n\n取值范围:0~732。该参数缺省或为0时,默认填写为7天。"
        }
      }
    },
    "OpenGaussDatastore": {
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "数据库引擎,不区分大小写,取值如下:\n\nGaussDB(for openGauss)。",
          "enum": [
            "GaussDB(for openGauss)",
            "GaussDB"
          ],
          "example": "GaussDB(for openGauss)"
        },
        "version": {
          "type": "string",
          "description": "数据库版本。不填时,默认为当前最新版本。\n\nGaussDB支持的版本参考[查询数据库引擎的版本](https://apiexplorer.developer.huaweicloud.com/apiexplorer/doc?product=GaussDBforopenGauss&api=ListDatastores)。",
          "example": "1.4"
        }
      },
      "description": "数据库信息。"
    },
    "OpenGaussDatastoreResponse": {
      "required": [
        "type",
        "version"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "数据库引擎,不区分大小写,取值如下:\n\nGaussDB(for openGauss)",
          "enum": [
            "GaussDB",
            "GaussDB(for openGauss)"
          ],
          "example": "GaussDB"
        },
        "version": {
          "type": "string",
          "description": "数据库版本。",
          "example": "1.4"
        }
      },
      "description": "数据库版本。不填时,默认为当前最新版本。\n\n数据库支持版本可根据查询数据库引擎版本接口获取"
    },
    "OpenGaussVolumeResponse": {
      "required": [
        "type",
        "size"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "磁盘类型。\n\n取值如下,区分大小写:\n\n- ULTRAHIGH,表示SSD。\n- ESSD,表示急速云盘",
          "enum": [
            "ULTRAHIGH",
            "ESSD"
          ],
          "example": "ULTRAHIGH"
        },
        "size": {
          "type": "integer",
          "description": "磁盘大小。\n\nGaussDB分布式实例创建时需指定大小:要求必须为(分片数 * 40GB)的倍数,取值范围:(分片数*40GB)~(分片数*16TB)。",
          "example": 40
        }
      },
      "description": "volume信息。"
    },
    "OpenGaussInstanceResponse": {
      "description": "实例信息。",
      "required": [
        "id",
        "name",
        "status",
        "datastore",
        "backup_strategy",
        "port",
        "enterprise_project_id",
        "flavor_ref",
        "volume",
        "region",
        "availability_zone",
        "vpc_id",
        "subnet_id",
        "security_group_id",
        "charge_info"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "实例ID。",
          "example": "cc6fd964d93f4003851dfc29d57d30a5in14"
        },
        "name": {
          "type": "string",
          "description": "实例名称。用于表示实例的名称,同一租户下,同类型的实例名称可相同。\n\n取值范围:4~64个字符之间,必须以字母开头,不区分大小写,可以包含字母、数字、中划线或者下划线,不能包含其他的特殊字符。"
        },
        "status": {
          "type": "string",
          "description": "实例状态。如BUILD,表示创建中。\n\n仅创建按需实例时会返回该参数。",
          "example": "BUILD"
        },
        "datastore": {
          "$ref": "#/definitions/OpenGaussDatastoreResponse"
        },
        "ha": {
          "$ref": "#/definitions/OpenGaussHaResponse"
        },
        "replica_num": {
          "type": "integer",
          "description": "实例副本数。",
          "example": 3,
          "format": "int32"
        },
        "backup_strategy": {
          "$ref": "#/definitions/OpenGaussBackupStrategyForResponse"
        },
        "port": {
          "type": "string",
          "description": "数据库端口信息,与请求参数相同。",
          "example": 3306
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "项目标签。"
        },
        "flavor_ref": {
          "type": "string",
