  "definitions": {
    "UpdateSqlLimitTaskResponseBody": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "**参数解释**:\n工作流ID。\n**取值范围**:\n不涉及。"
        }
      },
      "type": "object"
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "UpdateSqlLimitTaskRequestBody": {
      "required": [
        "node_id"
      ],
      "properties": {
        "start_time": {
          "description": "**参数解释**:\n任务开始时间,如果该值小于当前时间,会取当前时间的前两分钟。\n**约束限制**:\n当“task_scope”为SQL时必传。\n**取值范围**:\n格式必须为yyyy-mm-ddThh:mm:ssZ,当前时间指UTC时间。\n**默认取值**:\n不涉及。",
          "type": "string"
        },
        "end_time": {
          "description": "**参数解释**:\n任务结束时间。\n**约束限制**:\n当“task_scope”为SQL时必传。\n**取值范围**:\n格式为yyyy-mm-ddThh:mm:ssZ,大于任务开始时间,当前时间指UTC时间。\n**默认取值**:\n不涉及。",
          "type": "string"
        },
        "key_words": {
          "description": "**参数解释**:\n关键词。\n**约束限制**:\n当且仅当“limit_type”为SQL_TYPE,选传。\n**取值范围**:\n多个关键词以逗号隔开,最大长度为64位,最大关键词数量为100个。\n**默认取值**:\n不涉及。",
          "type": "string"
        },
        "parallel_size": {
          "description": "**参数解释**:\n并发数。\n**约束限制**:\n不涉及。\n**取值范围**:\n大于等于零的整数。\n**默认取值**:\n不涉及。",
          "type": "integer"
        },
        "task_name": {
          "description": "**参数解释**:\n限流任务名。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能为英文字母大小写,下划线,数字和$符。\n**默认取值**:\n不涉及。",
          "type": "string"
        },
        "cpu_utilization": {
          "description": "**参数解释**:\nCPU利用率阈值。\n**约束限制**:\n如果“limit_type”为SESSION_ACTIVE_MAX_COUNT,与内存利用率两者至少传一个。\n**取值范围**:\n整数,取值范围[0,100)。\n**默认取值**:\n不涉及。",
          "type": "integer"
        },
        "memory_utilization": {
          "description": "**参数解释**:\n内存利用率阈值。\n**约束限制**:\n如果“limit_type”为SESSION_ACTIVE_MAX_COUNT,与CPU利用率两者至少传一个。\n**取值范围**:\n整数,取值范围[0,100)。\n**默认取值**:\n不涉及。",
          "type": "integer"
        },
        "databases": {
          "description": "**参数解释**:\nCN节点数据库组。\n**约束限制**:\n不涉及。\n**取值范围**:\n每个数据库字符串以逗号形式隔开。\n**默认取值**:\n不涉及。",
          "type": "string"
        },
        "node_id": {
          "description": "**参数解释**:\n限流任务所在的节点ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "type": "string"
        }
      }
    }
  },
