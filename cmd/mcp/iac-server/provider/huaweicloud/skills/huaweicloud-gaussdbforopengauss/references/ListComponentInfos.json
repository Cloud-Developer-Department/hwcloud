  "definitions": {
    "Nodes": {
      "description": "节点信息",
      "required": [
        "id",
        "components"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "节点ID。"
        },
        "name": {
          "type": "string",
          "description": "节点名字。"
        },
        "availability_zone_id": {
          "type": "string",
          "description": "节点所在可用区编码。"
        },
        "description": {
          "type": "string",
          "description": "可用区描述信息。"
        },
        "status": {
          "type": "string",
          "description": "节点状态。"
        },
        "components": {
          "type": "array",
          "description": "组件列表。",
          "items": {
            "$ref": "#/definitions/Components"
          }
        }
      }
    },
    "NodesRespone": {
      "required": [
        "nodes",
        "total_count"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "description": "组件信息。",
          "items": {
            "$ref": "#/definitions/Nodes"
          }
        },
        "total_count": {
          "type": "integer",
          "description": "总记录数。"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "Components": {
      "description": "组件列表",
      "properties": {
        "id": {
          "type": "string",
          "description": "组件id,当组件类型为DN,组件id为6001,则对应的值为dn_6001。"
        },
        "role": {
          "type": "string",
          "description": "节点类型,取值为“master”、“slave”,分别对应于主节点、备节点。"
        },
        "status": {
          "type": "string",
          "description": "组件状态。\nPrimary:该组件为主。\nNormal:该组件状态正常。\nDown:该组件处于宕机状态。\nStandby:该组件为备。\nStateFollower:该ETCD为备。\nStateLeader:该ETCD为主。\nStateCandidate:该ETCD为仲裁。"
        },
        "distributed_id": {
          "type": "string",
          "description": "分组id,只有dn组件有分组id,用于区分是否是同一个分片下的组件。其他组件为空字符串。"
        },
        "type": {
          "type": "string",
          "description": "节点类型,包括:DN, CN, GTM, CM, ETCD。"
        },
        "detail": {
          "type": "string",
          "description": "详情。"
        }
      }
    }
  },
