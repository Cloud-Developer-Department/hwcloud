  "definitions": {
    "GaussDBUpgradeInstancesVersionRequest": {
      "description": "GaussDB批量实例版本升级接口传参参数。",
      "properties": {
        "instance_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "批量实例ID。"
        },
        "upgrade_type": {
          "type": "string",
          "description": "实例升级类型,包括就地升级,灰度升级、热补丁升级三种。",
          "enum": [
            "inplace",
            "grey",
            "hotfix"
          ]
        },
        "upgrade_action": {
          "type": "string",
          "description": "实例升级操作,就地升级无需传值。灰度升级包括升级自动提交,升级待观察,提交升级,升级回退四种。",
          "enum": [
            "upgradeAutoCommit",
            "upgrade",
            "commit",
            "rollback"
          ]
        },
        "target_version": {
          "type": "string",
          "description": "批量实例升级目标版本,非必填。如果未传值灰度升级和就地升级默认升级到当前实例的优选版本,热补丁升级无需传该值,默认升级实例所有可升级热补丁。"
        }
      },
      "required": [
        "upgrade_type",
        "instance_ids"
      ]
    },
    "InstancesUpgradeRsp": {
      "properties": {
        "job_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "任务id。"
        },
        "succeeded_num": {
          "type": "integer",
          "description": "下发成功的实例数量。"
        },
        "failed_num": {
          "type": "integer",
          "description": "下发失败的实例数量。"
        },
        "failed_instance_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "下发失败的实例ID列表。"
        },
        "error_messages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "下发失败错误信息列表。"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
