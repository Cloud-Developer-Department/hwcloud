  "definitions": {
    "GaussDBforOpenGaussRoleAttributes": {
      "description": "用户的权限属性。",
      "required": [
        "name",
        "schema",
        "readonly"
      ],
      "properties": {
        "name": {
          "description": "数据库角色名称。 不能使用系统用户或角色,且名称必须存在。 系统用户/角色包括“rdsAdmin”,“rdsMetric”, “rdsBackup”, “rdsRepl”, “root”。",
          "type": "string"
        },
        "schema": {
          "description": "SCHEMA名称。 不能和模板库以及系统内schema重名,且schema名称必须存在。 模板库包括postgres, template0 ,template1, 系统内schema包括public,information_schema。",
          "type": "string"
        },
        "readonly": {
          "description": "数据库角色权限。\n- true:只读。\n- false:可读可写。",
          "type": "boolean",
          "default": true
        },
        "default_privilege_grantee": {
          "description": "数据库用户/角色名称。 该字段的含义是将此用户/角色的权限授予给name字段指定的角色,通过readonly字段判断是否授予只读权限。 不能和系统用户/角色名称相同,且用户/角色名称必须存在,系统用户/角色包括“rdsAdmin”,“ rdsMetric”, “rdsBackup”, “rdsRepl”, “root”。",
          "type": "string"
        }
      }
    },
    "AllowDbRolePrivilegesRequestBody": {
      "description": "授权数据库角色。",
      "required": [
        "db_name",
        "user"
      ],
      "properties": {
        "db_name": {
          "description": "数据库名称。 不能使用模板库,且是已存在的数据库名称。 模板库包括postgres, template0 ,template1,templatea,template_pdb,templatem。",
          "type": "string"
        },
        "user": {
          "description": "角色权限信息。",
          "type": "object",
          "$ref": "#/definitions/GaussDBforOpenGaussRoleAttributes"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    }
  },
