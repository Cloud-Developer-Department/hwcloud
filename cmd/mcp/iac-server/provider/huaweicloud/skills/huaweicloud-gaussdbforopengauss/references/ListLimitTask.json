                    "start_time": "2023-06-06T01:47:20+0800",
                    "end_time": "2023-06-07T01:47:20+0800",
                    "rule_name": "dsa48119d86512e0000bin066a1a27",
                    "cpu_utilization": null,
                    "memory_utilization": null,
                    "node_infos": [
                      {
                        "node_id": "e603348513654c209e4b955d98324655no14",
                        "sql_id": "39b6a1a"
                      }
                    ]
                  }
                ],
                "total_count": 1,
                "limit": 10,
                "offset": 1
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "根据指定条件查询限流任务列表",
        "x-request-examples-url-1": "GET https://{endpoint}/rds/gaussdb/v3/4f07d3f50ce2466a9a7c014337b36409/instances/7912cd1077b2413fbd6f39a044777537in14/limit-task-list?offset=1&limit=10&type=SQL_ID",
        "x-request-examples-description-2": "根据指定条件查询限流任务列表",
        "x-request-examples-url-2": "GET https://{endpoint}/rds/gaussdb/v3/4f07d3f50ce2466a9a7c014337b36409/instances/7912cd1077b2413fbd6f39a044777537in14/limit-task-list?offset=1&limit=10&type=SQL_ID&start_time=2023-06-06T01:47:20+0800&end_time=2023-06-07T01:47:20+0800"
      }
    }
  },
  "definitions": {
    "ListLimitTaskResponseResult": {
      "properties": {
        "task_id": {
          "description": "**参数解释**:\n限流任务ID。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "task_scope": {
          "description": "**参数解释**:\n任务限流范围。\n**取值范围**:\n目前支持SQL,SESSION两种级别范围。",
          "type": "string"
        },
        "limit_type": {
          "description": "**参数解释**:\n任务限流类型。\n**取值范围**:\n- 当“task_scope”为SQL时,可选SQL_ID、SQL_TYPE类型。\n- 当“task_scope”为SESSION时,可选SESSION_ACTIVE_MAX_COUNT类型。",
          "type": "string"
        },
        "limit_type_value": {
          "description": "**参数解释**:\n任务限流类型值。\n**取值范围**:\n- 当“limit_type”为SQL_ID类型时,该值为选中模板的sql_id。\n- 当“limit_type”为SQL_TYPE类型时,值为SQL类型,为select,update,insert,delete,merge的一种。\n- 当“limit_type”为SESSION_ACTIVE_MAX_COUNT类型时,该值为CPU_OR_MEMORY。",
          "type": "string"
        },
        "task_name": {
          "description": "**参数解释**:\n限流任务名。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "databases": {
          "description": "**参数解释**:\n实例的数据库列表,每个数据库以英文逗号形式隔开。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "sql_model": {
          "description": "**参数解释**:\nSQL模板,仅当任务类型为SQL_ID时,返回该值。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "key_words": {
          "description": "**参数解释**:\n关键词,仅当任务类型为SQL_TYPE时,返回该值。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "status": {
          "description": "**参数解释**:\n限流任务状态。\n**取值范围**:\n当前支持:CREATING,UPDATING,DELETING,WAIT_EXECUTE,EXCUTING,TIME_OVER,DELETED,CREATE_FAILED,UPDATE_FAILED,DELETE_FAILED,EXCEPTION,NODE_SHUT_DOWN。",
          "type": "string"
        },
        "instance_id": {
          "description": "**参数解释**:\n实例ID。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "rule_name": {
          "description": "**参数解释**:\n规则名。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "parallel_size": {
          "description": "**参数解释**:\n并发数。\n**取值范围**:\n[0, 2147483647]",
          "type": "integer"
        },
        "start_time": {
          "description": "**参数解释**:\n限流任务开始时间。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "end_time": {
          "description": "**参数解释**:\n限流任务结束时间。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "cpu_utilization": {
          "description": "**参数解释**:\nCPU利用率阈值,仅当任务类型为SESSION_ACTIVE_MAX_COUNT时,返回该值且只保留整数部分。\n**取值范围**:\n[0, 100)",
          "type": "integer"
        },
        "memory_utilization": {
          "description": "**参数解释**:\n内存利用率阈值,仅当任务类型为SESSION_ACTIVE_MAX_COUNT时,返回该值且只保留整数部分。\n**取值范围**:\n[0, 100)",
          "type": "integer"
        },
        "created": {
          "description": "**参数解释**:\n限流任务创建时间。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "updated": {
          "description": "**参数解释**:\n限流任务更新时间。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "creator": {
          "description": "**参数解释**:\n创建者。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "modifier": {
          "description": "**参数解释**:\n更新者。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "node_infos": {
          "description": "**参数解释**:\nCN节点信息列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShowLimitTaskNodeOption"
          }
        }
      }
    },
    "ShowLimitTaskNodeOption": {
      "required": [
        "node_id",
        "sql_id"
      ],
      "properties": {
        "node_id": {
          "description": "**参数解释**:\n节点ID。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "sql_id": {
          "description": "**参数解释**:\n该节点执行的sql语句ID。\n**取值范围**:\n不涉及。",
          "type": "string"
        }
      }
    },
    "ListLimitTaskResponseBody": {
      "required": [
        "limit_task_list",
        "limit",
        "offset",
        "total_count"
      ],
      "properties": {
        "limit_task_list": {
          "description": "限流任务列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ListLimitTaskResponseResult"
          }
        },
        "limit": {
          "description": "查询记录数。",
          "type": "integer"
        },
        "offset": {
          "description": "索引位置。",
          "type": "integer"
        },
        "total_count": {
          "description": "总数。",
          "type": "integer"
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    }
  },
