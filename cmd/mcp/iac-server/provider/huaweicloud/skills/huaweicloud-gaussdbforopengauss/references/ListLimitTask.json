  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/limit-task-list": {
      "get": {
        "tags": [
          "SQL限流"
        ],
        "x-file": "limit_task",
        "x-is-registered": "Y",
        "operationId": "ListLimitTask",
        "summary": "根据指定条件查询限流任务列表",
        "description": "根据指定条件查询限流任务列表",
        "x-support-sdk": "Y",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "parameters": [
          {
