{
  "name": "ShowDeploymentForm",
  "summary": "查询解决方案模板配置",
  "tags": "实例管理",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/deployment-form": {
      "get": {
        "tags": [
          "实例管理"
        ],
        "operationId": "ShowDeploymentForm",
        "summary": "查询解决方案模板配置",
        "description": "根据解决方案模板名称或实例ID查询副本数、分片数、节点数",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "false",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "x-constraint": "请求参数solution和instance_id不能都为空。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "**参数解释**:\n语言。\n**约束限制**:\n不涉及。\n**取值范围**:\n  - zh-cn\n  - en-us\n\n**默认取值**:\nen-us",
            "type": "string",
            "x-example": "zh-cn",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "solution",
            "in": "query",
            "description": "解决方案模板名称。",
            "required": false,
            "type": "string",
            "x-example": "triset",
            "enum": [
              "triset",
              "single"
            ]
          },
          {
            "name": "instance_id",
            "in": "query",
            "description": "实例ID。",
            "required": false,
            "type": "string",
            "x-example": "ef25188419f941309882d2986b2210b9in14"
          },
          {
            "name": "consistency",
            "in": "query",
            "description": "**参数解释**:\n事务一致性类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n- strong\n- eventual\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "strong",
            "required": false
          },
          {
            "name": "consistency_protocol",
            "in": "query",
            "description": "**参数解释**:\n副本一致性协议类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n- quorum\n- paxos\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "paxos",
            "required": false
          },
          {
            "name": "engine_version",
            "in": "query",
            "description": "**参数解释**:\n引擎版本号。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": 8.218,
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "schema": {
              "$ref": "#/definitions/DeploymentFormResponseBody"
            },
            "examples": {
              "application/json": {
                "initial_node_num": 3,
                "solution": "triset",
                "shard_num": 1,
                "replica_num": 3
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/ParaErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "GET https://console.huaweicloud.com/gaussdb/v3/fff3cb7f644d4fc9a3c58f2bfe239b9e/deployment_form?solution=triset",
        "x-order": 15
      }
    }
  },
  "definitions": {
    "ParaErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "DeploymentFormResponseBody": {
      "properties": {
        "initial_node_num": {
          "type": "integer",
          "description": "初始节点数。"
        },
        "solution": {
          "type": "string",
          "description": "解决方案模板名称。"
        },
        "shard_num": {
          "type": "integer",
          "description": "分片数。"
        },
        "replica_num": {
          "type": "integer",
          "description": "副本数。"
        },
        "each_expand_nodes": {
          "type": "integer",
          "description": "**参数解释**:\n每次扩容的最小节点数。\n**取值范围**:\n不涉及。"
        },
        "max_shard_count": {
          "type": "integer",
          "description": "**参数解释**:\n最大分片数。\n**取值范围**:\n不涉及。"
        },
        "each_shard_num": {
          "type": "integer",
          "description": "**参数解释**:\n每分片节点数。\n**取值范围**:\n不涉及。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
