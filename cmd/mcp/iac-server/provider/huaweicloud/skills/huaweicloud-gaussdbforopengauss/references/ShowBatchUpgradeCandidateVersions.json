          ]
        },
        "tags": [
          "版本升级"
        ],
        "summary": "查询批量实例可升级的版本和升级类型。",
        "description": "查询批量实例可升级的版本和升级类型。",
        "operationId": "ShowBatchUpgradeCandidateVersions",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一Region下的项目ID。",
            "maxLength": 100,
            "minLength": 32
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "x-example": "******",
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "语言[zh-cn, en-us]。",
            "type": "string",
            "default": "en-us",
            "x-example": "en-us",
            "enum": [
              "zh-cn",
              "en-us"
            ]
          },
          {
            "name": "ShowBatchUpgradeCandidateVersionsRequestBody",
            "in": "body",
            "description": "请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpgradeInstancesRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前批量实例只支持就地升级。",
            "schema": {
              "$ref": "#/definitions/BatchUpgradeCandidateVersionsResponse"
            },
            "examples": {
              "application/json": {
                "upgrade_type_list": [
                  {
                    "upgrade_type": "inplace",
                    "enable": true,
                    "upgrade_action_list": [
                      {
                        "upgrade_action": "upgradeAutoCommit",
                        "enable": true
                      }
                    ]
                  },
                  {
                    "upgrade_type": "grey",
                    "enable": false
                  }
                ],
                "upgrade_candidate_versions": [
                  "8.100.0",
                  "8.101.0"
                ]
              }
            }
          },
          "default": {
            "description": "系统内部错误。",
            "schema": {
              "$ref": "#/definitions/UpgradeErrorResponseBody"
            }
          }
        },
        "x-order": 1
      }
    }
  },
  "definitions": {
    "UpgradeTypeInfo": {
      "description": "升级类型信息。",
      "properties": {
        "upgrade_type": {
          "type": "string",
          "description": "升级类型,grey=灰度升级,inplace=就地升级,hotfix=热补丁升级。",
          "minLength": 0,
          "maxLength": 1000,
          "example": "inplace",
          "enum": [
            "grey",
            "inplace",
            "hotfix"
          ]
        },
        "enable": {
          "type": "boolean",
          "description": "可用,不可用。",
          "example": false
        },
        "upgrade_action_list": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UpgradeActionInfo"
          },
          "description": "升级操作列表。",
          "minItems": 0,
          "maxItems": 1000
        },
        "is_parallel_upgrade": {
          "type": "boolean",
          "description": "是否正在进行AZ内并行升级。\n-true:当前实例处于灰度升级的升级待观察升级方式中,已选择了AZ内并行升级方式,后续无法更改。 -false:当前实例处于升级流程中,未选择AZ内并行升级的方式,后续无法更改。null:当前实例尚未处于升级流程中。",
          "example": false
        }
      },
      "type": "object"
    },
    "BatchUpgradeCandidateVersionsResponse": {
      "required": [
        "upgrade_type_list",
        "upgrade_candidate_versions"
      ],
      "description": "版本升级信息。",
      "properties": {
        "upgrade_type_list": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UpgradeTypeInfo"
          },
          "description": "升级类型信息列表。",
          "minItems": 0,
          "maxItems": 1000
        },
        "target_version": {
          "type": "string",
          "description": "升级目标版本,没有在滚动升级中返回null。",
          "example": "3.200.0",
          "minLength": 0,
          "maxLength": 1000
        },
        "upgrade_candidate_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          "description": "可以升级的版本,包括大小版本。",
          "minItems": 0,
          "maxItems": 1000,
          "example": [
            "3.200.0",
            "4.200.0"
          ]
        },
        "hotfix_upgrade_infos": {
          "description": "可以升级的热补丁信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/HotfixInfoResult"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "hotfix_rollback_infos": {
          "description": "可以回滚的热补丁信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/HotfixInfoResult"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "type": "object"
    },
    "UpgradeInstancesRequestBody": {
      "description": "GaussDB批量升级查询接口传参参数。",
      "properties": {
        "instance_ids": {
          "type": "array",
          "description": "批量实例ID。",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "UpgradeActionInfo": {
      "description": "升级操作信息。",
      "properties": {
        "upgrade_action": {
          "type": "string",
          "description": "升级操作,upgrade=升级,upgradeAutoCommit=升级自动提交,commit=提交,rollback=回滚。",
          "minLength": 0,
          "maxLength": 1000,
          "example": "upgrade",
          "enum": [
            "upgrade",
            "upgradeAutoCommit",
            "commit",
            "rollback"
          ]
        },
        "enable": {
          "type": "boolean",
          "description": "可用,不可用。",
          "example": false
        }
      },
      "type": "object"
    },
    "HotfixInfoResult": {
      "description": "热补丁信息",
      "properties": {
        "version": {
          "type": "string",
          "description": "热补丁版本",
          "example": "V2.0-2.7.2.1"
        },
        "common_patch": {
          "type": "string",
          "description": "通用非通用信息,common=通用补丁,certain=定制补丁",
          "example": "certain",
          "enum": [
            "common",
            "certain"
          ]
        },
        "backup_sensitive": {
          "type": "boolean",
          "description": "是否和备份相关",
          "example": false
        },
        "descripition": {
          "type": "string",
          "description": "补丁的描述信息",
          "example": "解决了xx问题"
        }
      },
      "type": "object"
    },
    "UpgradeErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
