  "definitions": {
    "OpenGaussChargeInfoListResponse": {
      "description": "计费类型信息,支持按需和包周期。",
      "required": [
        "charge_mode"
      ],
      "properties": {
        "charge_mode": {
          "type": "string",
          "description": "计费模式。\n\n取值范围:\n\npostPaid:后付费,即按需付费。\n\nprePaid:预付费,即包年/包月。",
          "enum": [
            "postPaid"
          ]
        }
      }
    },
    "OpenGaussListInstanceResponseBody": {
      "required": [
        "instances",
        "total_count"
      ],
      "properties": {
        "instances": {
          "type": "array",
          "description": "实例信息。",
          "items": {
            "$ref": "#/definitions/ListInstancesResult"
          }
        },
        "total_count": {
          "type": "integer",
          "description": "总记录数。"
        }
      }
    },
    "ListInstancesResult": {
      "description": "实例信息。",
      "required": [
        "id",
        "name",
        "status",
        "private_ips",
        "public_ips",
        "port",
        "type",
        "ha",
        "region",
        "datastore",
        "created",
        "updated",
        "db_user_name",
        "vpc_id",
        "subnet_id",
        "security_group_id",
        "flavor_ref",
        "flavor_info",
        "volume",
        "switch_strategy",
        "backup_strategy",
        "maintenance_window",
        "nodes",
        "enterprise_project_id",
        "instance_mode",
        "disk_encryption_id",
        "charge_info",
        "time_zone",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "实例ID。",
          "example": "cc6fd964d93f4003851dfc29d57d30a5in14"
        },
        "name": {
          "type": "string",
          "description": "创建的实例名称。"
        },
        "status": {
          "type": "string",
          "description": "实例状态。\n\n取值:\n\n值为“BUILD”,表示实例正在创建。\n\n值为“ACTIVE”,表示实例正常。\n\n值为“FAILED”,表示实例异常。\n\n值为“FROZEN”,表示实例冻结。\n\n值为“EXPANDING”,表示实例正在扩容CN或DN。\n\n值为“REBOOTING”,表示实例正在重启。\n\n值为“UPGRADING”,表示实例正在升级。\n\n值为“RESTORING”,表示实例正在恢复。\n\n值为“BACKING UP”,表示实例正在进行备份。\n\n值为“REDUCING REPLICATION”,表示实例正在降副本。\n\n值为“STORAGE FULL”,表示实例磁盘空间满。\n\n值为“REPAIRING”,表示实例正在修复。",
          "example": "BUILD"
        },
        "private_ips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "实例内网IP地址列表。分布式CN所在的弹性云服务器创建成功后该值存在,主备版DN所在的弹性云服务器创建成功后该值存在,其他情况下为空字符串。"
        },
        "public_ips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "实例外网IP地址列表。绑定弹性公网IP后,该值不为空。"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "description": "数据库端口号。GaussDB数据库端口设置范围为1024~39998(其中2378,2379,2380,4999,5000,5999,6000,6001,8097,8098,20049,20050,21731,21732被系统占用不可设置)。\n\n当不传该参数时,默认端口如下:8000。",
          "example": 3306
        },
        "type": {
          "type": "string",
          "description": "实例类型,取值为 \"Enterprise\",对应于分布式实例(企业版)。取值为\"Ha\",对应于主备版实例。"
        },
        "ha": {
          "$ref": "#/definitions/ListHaResult"
        },
        "replica_num": {
          "type": "integer",
          "format": "int32",
          "description": "实例副本数。"
        },
        "region": {
          "type": "string",
          "description": "实例所在区域。"
        },
        "datastore": {
          "$ref": "#/definitions/ListInstanceDatastore"
        },
        "created": {
          "type": "string",
          "description": "创建时间,格式为“yyyy-mm-dd hh:mm:ss timezone”。\n\n其中timezone是指时区。\n\n说明:创建时该值为实例下发创建的时间,创建完成后,该值为创建完成时间。"
        },
        "updated": {
          "type": "string",
          "description": "更新时间,格式与“created”字段对应格式完全相同。\n\n说明:创建时返回值为空,数据库实例创建成功后该值不为空。"
        },
        "db_user_name": {
          "type": "string",
          "description": "默认用户名。",
          "example": "root"
        },
        "vpc_id": {
          "type": "string",
          "description": "虚拟私有云ID。"
        },
        "subnet_id": {
          "type": "string",
          "description": "子网的网络ID信息。"
        },
        "security_group_id": {
          "type": "string",
          "description": "安全组ID。"
        },
        "flavor_ref": {
          "type": "string",
          "description": "规格码。参考[表1](https://support.huaweicloud.com/api-opengauss/opengauss_api_0037.html#opengauss_api_0037__ted9b9d433c8a4c52884e199e17f94479)中GaussDB的“规格编码”列内容获取。",
          "example": "rds.mysql.s1.large"
        },
        "flavor_info": {
          "$ref": "#/definitions/ListFlavorInfo"
        },
        "volume": {
          "$ref": "#/definitions/ListVolume"
        },
        "switch_strategy": {
          "type": "string",
          "description": "数据库切换策略。取值为“reliability”或“availability”,分别对应于可靠性优先和可用性优先。\n若创建时没有选择切换策略,则不予显示。"
        },
        "backup_strategy": {
          "$ref": "#/definitions/OpenGaussBackupStrategyForListResponse"
        },
        "maintenance_window": {
          "type": "string",
          "description": "可维护时间窗,为UTC时间。"
        },
        "nodes": {
          "type": "array",
          "description": "实例节点信息列表。",
          "items": {
            "$ref": "#/definitions/NodeResult"
          }
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目标签ID。非企业项目账号的实例,企业项目默认0。"
        },
        "instance_mode": {
          "type": "string",
          "description": "basic为基础版 ,enterprise为企业版。"
        },
        "disk_encryption_id": {
          "type": "string",
          "description": "磁盘加密密钥ID。只有创建磁盘加密实例才会显示该参数。"
        },
        "charge_info": {
          "$ref": "#/definitions/OpenGaussChargeInfoListResponse"
        },
        "time_zone": {
          "type": "string",
          "description": "时区。"
        },
        "tags": {
          "type": "array",
          "description": "标签列表,没有标签不返回该参数。",
          "items": {
            "$ref": "#/definitions/TagResult"
          }
        },
        "disk_usage": {
          "type": "string",
          "description": "实例磁盘的可使用率,值范围[0-1],值保留四位小数。"
        },
        "mysql_compatibility": {
          "description": "实例MySQL兼容配置,",
          "$ref": "#/definitions/MySQLCompatibilityResult"
        }
      }
    },
    "TagResult": {
      "description": "标签信息。",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "标签键。"
        },
        "value": {
          "type": "string",
          "description": "标签值。"
        }
      }
    },
    "ListHaResult": {
      "description": "获取分布式/主备版实例时返回。",
      "required": [
        "consistency",
        "replication_mode"
      ],
      "properties": {
        "consistency": {
          "type": "string",
          "description": "数据库一致性类型,分布式模式实例仅有。取值为“strong”、“eventual”,分别表示强一致性、最终一致性。",
          "example": "strong",
          "enum": [
            "strong",
            "eventual"
          ]
        },
        "replication_mode": {
          "type": "string",
          "description": "备机同步参数。  取值:非空。  GaussDB为 “sync”\n说明:\n“sync”为同步模式。",
          "example": "sync"
        }
      }
    },
    "ListVolume": {
      "description": "Volume信息。",
      "required": [
        "type",
        "size"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "磁盘类型。"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "磁盘大小。"
        }
      }
    },
    "ListInstanceDatastore": {
      "description": "数据库信息。",
      "required": [
        "type",
        "version"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "数据库引擎。"
        },
        "version": {
          "type": "string",
          "description": "数据库大版本。"
        },
        "complete_version": {
          "type": "string",
          "description": "数据库小版本。"
        },
        "target_version": {
          "type": "string",
          "description": "数据库正在升级的目标版本。"
        },
        "complete_kernel_version": {
          "type": "string",
          "description": "数据库内核版本"
        },
        "hotfix_version_infos": {
          "description": "热补丁信息列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/HotfixVersionInfo"
          }
        }
      }
    },
    "OpenGaussBackupStrategyForListResponse": {
      "required": [
        "start_time",
        "keep_days"
      ],
      "description": "备份策略。",
      "properties": {
        "start_time": {
          "type": "string",
          "description": "备份时间段。自动备份将在该时间段内触发。\n\n当前时间指UTC时间。"
        },
        "keep_days": {
          "type": "integer",
          "description": "已生成的备份文件可以保存的天数。\n\n取值范围:1~732。"
        }
      }
    },
    "ListFlavorInfo": {
      "description": "规格信息。",
      "required": [
        "vcpu",
        "mem"
      ],
      "properties": {
        "vcpu": {
          "type": "integer",
          "format": "int32",
          "description": "cpu核数。"
        },
        "mem": {
          "type": "integer",
          "description": "内存大小。",
          "format": "int32"
        }
      }
    },
    "HotfixVersionInfo": {
      "description": "热补丁信息。",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "description": "热补丁版本。"
        },
        "upgrade_finished_time": {
          "type": "string",
          "description": "热补丁升级完成时间列表。\n\n热补丁升级完成时间,格式为“yyyy-mm-dd hh:mm:ss timezone”。\n\n其中timezone是指时区。"
        }
      }
    },
    "NodeResult": {
      "description": "实例节点信息。",
      "required": [
        "id",
        "name",
        "role",
        "status",
        "availability_zone",
        "private_ip",
        "public_ip"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "节点ID。"
        },
        "name": {
          "type": "string",
          "description": "节点名称。"
        },
        "role": {
          "type": "string",
          "description": "节点类型,取值为“master”、“slave”,分别对应于主节点、备节点。"
        },
        "status": {
          "type": "string",
          "description": "节点状态。"
        },
        "availability_zone": {
          "type": "string",
          "description": "可用区。"
        },
        "private_ip": {
          "type": "string",
          "description": "节点内网IP。分布式实例类型下该参数仅针对CN节点有效,主备版实例类型下该参数对所有节点有效,且在弹性云服务器创建成功后参数值存在。"
        },
        "public_ip": {
          "type": "string",
          "description": "绑定的外网IP。分布式实例类型下该参数仅针对CN节点有效,主备版实例类型下该参数对所有节点有效,且在弹性云服务器创建成功并绑定弹性公网IP后参数值存在。"
        },
        "component_names": {
          "type": "string",
          "description": "节点上组件信息(例组件ID:分布式ID),多个组件信息用;隔开。"
        }
      }
    },
    "MySQLCompatibilityResult": {
      "properties": {
        "port": {
          "description": "MySQL兼容端口",
          "type": "string",
          "example": 3306
        }
      }
    },
    "ErrorResponseBody": {
