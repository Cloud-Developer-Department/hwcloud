  "definitions": {
    "AlarmHistoryRecordResult": {
      "required": [
        "alarm_id",
        "name",
        "status",
        "alarm_type",
        "level",
        "instance_id",
        "instance_name",
        "begin_time",
        "update_time"
      ],
      "properties": {
        "alarm_id": {
          "type": "string",
          "description": "**参数解释**:\n告警规则ID。\n**取值范围**:\n不涉及。",
          "example": "al1603131199286dzxpqK3Ez"
        },
        "name": {
          "type": "string",
          "description": "**参数解释**:\n告警规则名称。\n**取值范围**:\n不涉及。",
          "example": "磁盘资源不足"
        },
        "status": {
          "type": "string",
          "description": "**参数解释**:\n告警记录的状态。\n**取值范围**:\n- ok:正常。\n- alarm:告警。\n- invalid:已失效。",
          "example": "alarm"
        },
        "alarm_type": {
          "type": "string",
          "description": "**参数解释**:\n告警规则类型。\n**取值范围**:\n- EVENT.SYS:系统事件告警。\n- EVENT.CUSTOM:自定义事件告警。\n- DNSHealthCheck:DNS健康检查告警。\n- RESOURCE_GROUP:资源分组告警。\n- MULTI_INSTANCE:指定资源告警。",
          "example": "EVENT.SYS"
        },
        "level": {
          "type": "integer",
          "description": "**参数解释**:\n告警历史的告警级别。\n**取值范围**:\n- 1:紧急。\n- 2:重要。\n- 3:次要。\n- 4:提示。",
          "example": 1
        },
        "instance_id": {
          "type": "string",
          "description": "**参数解释**:\n实例ID。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。",
          "example": "d8e6ca5a624745bcb546a227aa3ae1cfin14"
        },
        "instance_name": {
          "type": "string",
          "description": "**参数解释**:\n实例名称。\n**取值范围**:\n不涉及。",
          "example": "gauss_test"
        },
        "begin_time": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**:\n告警开始时间。\n**取值范围**:\nUNIX时间戳,单位毫秒,例如:1603131199000。",
          "example": 1756953311000
        },
        "update_time": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**:\n告警规则的最后更新时间。\n**取值范围**:\nUNIX时间戳,单位毫秒,例如:1603131199000。",
          "example": 1756953311000
        }
      }
    },
    "AlarmHistoryResponse": {
      "required": [
        "total_count",
        "history_records"
      ],
      "properties": {
        "total_count": {
          "type": "integer",
          "description": "**参数解释**:\n总数量。\n**默认取值**:\n不涉及。",
          "example": 99
        },
        "history_records": {
          "type": "array",
          "description": "**参数解释**:\n告警记录列表。",
          "items": {
            "$ref": "#/definitions/AlarmHistoryRecordResult"
          }
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
