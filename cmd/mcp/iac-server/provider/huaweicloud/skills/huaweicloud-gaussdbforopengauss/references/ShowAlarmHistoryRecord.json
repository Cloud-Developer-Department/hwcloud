        "x-request-examples-description-1": "告警统计",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/9a29cc53af2f499cb48a6d81839264cb/instances/alarm-history-record?start_time=2022-06-22T16:38:02+0800&offset=0&limit=100",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "x-file": "haoqian"
      }
