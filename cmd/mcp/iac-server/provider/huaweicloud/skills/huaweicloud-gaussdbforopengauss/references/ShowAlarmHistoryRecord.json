                "history_records": [
                  {
                    "alarm_id": "al1603131199286dzxpqK3Ez",
                    "name": "磁盘资源不足",
                    "status": "alarm",
                    "alarm_type": "EVENT.SYS",
                    "level": "critical",
                    "instance_id": "d8e6ca5a624745bcb546a227aa3ae1cfin14",
