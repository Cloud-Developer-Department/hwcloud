{
  "name": "ShowGlobalSlowSqlDetail",
  "summary": "查询全局慢SQL详情",
  "tags": "慢SQL",
  "productshort": "GaussDBforopenGauss",
  "region_id": "af-north-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/global-slow-sql-detail": {
      "post": {
        "tags": [
          "慢SQL"
        ],
        "operationId": "ShowGlobalSlowSqlDetail",
        "summary": "查询全局慢SQL详情",
        "description": "根据唯一SQLID,查询指定组件的慢SQL详情。",
        "x-constraint": "仅支持包含有CN或DN(主、备)组件的节点。",
        "x-api-type": "open-api",
        "x-apigateway-ratelimit": "opengauss_default_policy",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释**:\n用户Token。\n通过调用IAM服务[获取用户token](https://support.huaweicloud.com/intl/zh-cn/api-iam/iam_30_0001.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "**参数解释**:\n语言。\n**约束限制**:\n不涉及。\n**取值范围**:\n- zh-cn \n- en-us\n\n**默认取值**:\nen-us",
            "type": "string",
            "x-example": "en-us",
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "default": "en-us",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "**参数解释**:\n租户在某一Region下的项目ID。\n获取方法请参见[获取项目ID](https://support.huaweicloud.com/api-gaussdb/gaussdb_api_196.html)。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为32个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "0483b6b16e954cb88930a360d2c4e663"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "**参数解释**:\n实例ID,此参数是用户创建实例的唯一标识。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。\n**默认取值**:\n不涉及。",
            "required": true,
            "type": "string",
            "x-example": "cc6fd964d93f4003851dfc29d57d30a5in14"
          },
          {
            "in": "body",
            "name": "ShowGlobalSlowSqlDetailRequestBody",
            "required": true,
            "description": "**参数解释**:\n查询参数。\n**约束限制**:\n不涉及。",
            "schema": {
              "$ref": "#/definitions/ShowGlobalSlowSqlDetailRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "正常",
            "schema": {
              "$ref": "#/definitions/GlobalSlowSqlDetailResponseBody"
            },
            "examples": {
              "application/json": {
                "slow_sql_details": [
                  {
                    "db_name": "db_tpcc",
                    "schema_name": "db_tpcc",
                    "sql_id": "72339069014681397",
                    "user_name": "john_doe",
                    "client_ip": "192.168.0.1",
                    "client_port": "5432",
                    "sql_text": "SELECT * FROM large_table WHERE column1 = 'value';",
                    "sql": "",
                    "query_plan": "Seq Scan on large_table ...",
                    "start_time": "2025-03-17 02:38:37 +0000",
                    "finish_time": "2025-03-17 08:09:57 +0000",
                    "returned_rows": 1000,
                    "fetched_rows": 5000,
                    "fetched_pages": 50,
                    "hit_pages": 25,
                    "total_time": "100000079.2812",
                    "cpu_time": "5000000.0170",
                    "plan_time": "1000000.0001",
                    "io_time": "4000000.0045",
                    "lock_count": 1,
                    "lock_time": "10000.0000",
                    "node_id": "2f3c74e9f2454d3fa3d9b848ca95f5d0no14",
                    "node_name": "Node1"
                  }
                ],
                "total": 1
              }
            }
          },
          "default": {
            "description": "异常",
            "schema": {
              "$ref": "#/definitions/ErrorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/gaussdb/v3/0483b6b16e954cb88930a360d2c4e663/instances/f65049fe0c1840b4b0b3c9cedf5ab530in14/global-slow-sql-detail",
        "x-request-examples-description-1": "根据唯一SQLID查询指定组件的慢SQL详情",
        "x-request-examples-body-1": "{\n  \"instance_id\": \"f65049fe0c1840b4b0b3c9cedf5ab530in14\",\n  \"node_ids\": [\"2f3c74e9f2454d3fa3d9b848ca95f5d0no14\"],\n  \"start_time\": 1742179117000,\n  \"end_time\": 1742198997000,\n  \"start_time_utc\": \"2025-03-17T02:38:37+0000\",\n  \"end_time_utc\": \"2025-03-17T08:09:57+0000\",\n  \"component_type\": \"dn\",\n  \"sql_id\": \"72339069014681397\"\n}\n"
      }
    }
