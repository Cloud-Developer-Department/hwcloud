  "definitions": {
    "ShowGlobalSlowSqlDetailRequestBody": {
      "type": "object",
      "required": [
        "instance_id",
        "node_ids",
        "start_time",
        "end_time",
        "sql_id",
        "component_type"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "description": "**参数解释**:\n实例ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "example": "f65049fe0c1840b4b0b3c9cedf5ab530in14"
        },
        "node_ids": {
          "type": "array",
          "description": "**参数解释**:\n节点ID列表。\n**约束限制**:\n节点ID数组不能为空。",
          "items": {
            "type": "string"
          },
          "example": [
            "2f3c74e9f2454d3fa3d9b848ca95f5d0no14"
          ]
        },
        "start_time": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**:\n起始日期。\n**约束限制**:\n13位UNIX时间戳格式,单位是毫秒,时区是UTC。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "example": 1742179117000
        },
        "end_time": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**:\n结束日期。\n**约束限制**:\n13位UNIX时间戳格式,单位是毫秒,时区是UTC。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "example": 1742198997000
        },
        "sql_id": {
          "type": "string",
          "description": "**参数解释**:\n慢SQL的SQL ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。",
          "example": "72339069014681397"
        },
        "component_type": {
          "type": "string",
          "description": "**参数解释**:\n组件类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n- cn:CN组件类型。\n- dn:DN组件类型。\n\n**默认取值**:\n不涉及。",
          "enum": [
            "cn",
            "dn"
          ],
          "example": "dn"
        }
      }
    },
    "SlowSqlDetailResult": {
      "properties": {
        "db_name": {
          "type": "string",
          "description": "**参数解释**:\n数据库名称。\n**取值范围**:\n不涉及。",
          "example": "gaussdb_test"
        },
        "schema_name": {
          "type": "string",
          "description": "**参数解释**:\nSCHEMA名称。\n**取值范围**:\n不涉及。",
          "example": "gaussdb_test"
        },
        "sql": {
          "type": "string",
          "description": "**参数解释**:\n变量替换后的完整SQL。当sql_text不返回变量值时,sql返回空字符串。\n**取值范围**:\n不涉及。",
          "example": "select * from gaussdb"
        },
        "sql_id": {
          "type": "string",
          "description": "**参数解释**:\nSQL ID。\n**取值范围**:\n不涉及。",
          "example": 12345
        },
        "user_name": {
          "type": "string",
          "description": "**参数解释**:\n用户名称。\n**取值范围**:\n不涉及。",
          "example": "john_doe"
        },
        "client_ip": {
          "type": "string",
          "description": "**参数解释**:\n客户端IP。\n**取值范围**:\n不涉及。",
          "example": "192.168.0.1"
        },
        "client_port": {
          "type": "string",
          "description": "**参数解释**:\n客户端端口。\n**取值范围**:\n不涉及。",
          "example": 5432
        },
        "node_id": {
          "type": "string",
          "description": "**参数解释**:\n节点ID。\n**取值范围**:\n不涉及。",
          "example": "d04686c6baae4f65a742771186f47b7ain14"
        },
        "node_name": {
          "type": "string",
          "description": "**参数解释**:\n节点名称。\n**取值范围**:\n不涉及。",
          "example": "cn_5002"
        },
        "sql_text": {
          "type": "string",
          "description": "**参数解释**:\nSQL模版。\n**取值范围**:\n不涉及。",
          "example": "SELECT * FROM large_table WHERE column1 = 'value';"
        },
        "query_plan": {
          "type": "string",
          "description": "**参数解释**:\n执行计划。\n**取值范围**:\n不涉及。",
          "example": "Seq Scan on large_table ..."
        },
        "start_time": {
          "type": "integer",
          "description": "**参数解释**:\n开始时间UTC时间。\n**取值范围**:\n格式为yyyy-mm-ddThh:mm:ss+0000。",
          "example": 1619452000
        },
        "finish_time": {
          "type": "integer",
          "description": "**参数解释**:\n结束时间UTC时间。\n**取值范围**:\n格式为yyyy-mm-ddThh:mm:ss+0000。",
          "example": 1619453000
        },
        "returned_rows": {
          "type": "integer",
          "description": "**参数解释**:\n返回行。\n**取值范围**:\n不涉及。",
          "example": 1000
        },
        "fetched_rows": {
          "type": "integer",
          "description": "**参数解释**:\n扫描行。\n**取值范围**:\n不涉及。",
          "example": 5000
        },
        "fetched_pages": {
          "type": "integer",
          "description": "**参数解释**:\n扫描页。\n**取值范围**:\n不涉及。",
          "example": 50
        },
        "hit_pages": {
          "type": "integer",
          "description": "**参数解释**:\n命中页。\n**取值范围**:\n不涉及。",
          "example": 25
        },
        "total_time": {
          "type": "integer",
          "description": "**参数解释**:\n总耗时(单位:微秒)。\n**取值范围**:\n不涉及。",
          "example": 1000000
        },
        "cpu_time": {
          "type": "integer",
          "description": "**参数解释**:\nCPU耗时(单位:微秒)。\n**取值范围**:\n不涉及。",
          "example": 500000
        },
        "plan_time": {
          "type": "integer",
          "description": "**参数解释**:\n计划耗时(单位:微秒)。\n**取值范围**:\n不涉及。",
          "example": 100000
        },
        "io_time": {
          "type": "integer",
          "description": "**参数解释**:\nIO耗时(单位:微秒)。\n**取值范围**:\n不涉及。",
          "example": 400000
        },
        "lock_count": {
          "type": "integer",
          "description": "**参数解释**:\n加锁次数。\n**取值范围**:\n不涉及。",
          "example": 1
        },
        "lock_time": {
          "type": "integer",
          "description": "**参数解释**:\n加锁耗时(单位:微秒)。\n**取值范围**:\n不涉及。",
          "example": 1
        }
      },
      "type": "object"
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "GlobalSlowSqlDetailResponseBody": {
      "type": "object",
      "properties": {
        "slow_sql_details": {
          "type": "array",
          "description": "**参数解释**:\n慢SQL详情列表。",
          "items": {
            "$ref": "#/definitions/SlowSqlDetailResult"
          }
        },
        "total": {
          "type": "integer",
          "description": "**参数解释**:\n返回的慢SQL数量。\n**取值范围**:\n不涉及。",
          "example": 1
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "gaussdb.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}