  "definitions": {
    "AlarmStatisticsResponseBody": {
      "properties": {
        "total_alarm_count": {
          "type": "integer",
          "description": "**参数解释**:\n告警总数。\n**取值范围**:\n不涉及。",
          "example": 18
        },
        "ring_percentage": {
          "type": "number",
          "format": "double",
          "description": "**参数解释**:\n环比比率。\n**取值范围**:\n值为0表示环比没有变化,值为空表示上一周期没有告警。",
          "example": 0.2
        },
        "instance_alarm_level_statistics": {
          "type": "array",
          "description": "**参数解释**:\n实例级别的告警统计。",
          "items": {
            "$ref": "#/definitions/InstanceAlarmLevelStatisticResult"
          }
        },
        "total_alarm_level_statistics": {
          "type": "array",
          "description": "**参数解释**:\n全量告警统计。",
          "items": {
            "$ref": "#/definitions/AlarmLevelStatisticsResult"
          }
        }
      }
    },
    "InstanceAlarmLevelStatisticResult": {
      "properties": {
        "instance_id": {
          "type": "string",
          "description": "**参数解释**:\n实例ID。\n**取值范围**:\n只能由英文字母、数字组成,且长度为36个字符。",
          "example": "d9ac4ef180454c16944b56830f2fd5c1in14"
        },
        "instance_name": {
          "type": "string",
          "description": "**参数解释**:\n实例名称。\n**取值范围**:\n不涉及。",
          "example": "gaussdb_test"
        },
        "total_count": {
          "type": "integer",
          "description": "**参数解释**:\n告警总数。\n**取值范围**:\n不涉及。",
          "example": 50
        },
        "alarm_level_statistics": {
          "type": "array",
          "description": "**参数解释**:\n实例级别的各等级告警数量统计。",
          "items": {
            "$ref": "#/definitions/AlarmLevelStatisticsResult"
          }
        }
      }
    },
    "ErrorResponseBody": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n错误码。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "DBS.00114000"
        },
        "error_msg": {
          "description": "**参数解释**:\n错误消息。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "系统内部错误"
        }
      }
    },
    "AlarmLevelStatisticsResult": {
      "properties": {
        "count": {
          "type": "integer",
          "description": "**参数解释**:\n告警数量。\n**取值范围**:\n不涉及。",
          "example": 43
        },
        "level_name": {
          "type": "string",
          "description": "**参数解释**:\n告警级别名称。\n**取值范围**:\n- critical\n- major\n- minor\n- notice",
          "example": "critical"
        }
      }
    }
  },
