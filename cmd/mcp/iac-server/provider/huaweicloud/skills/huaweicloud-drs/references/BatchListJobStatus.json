        "count": {
          "type": "integer",
          "format": "int32",
          "description": "返回任务数量"
        }
      },
      "description": "批量查询任务状态返回体"
    },
    "PageReq": {
      "properties": {
        "cur_page": {
          "type": "integer",
          "format": "int32",
          "description": "当前页, 不能超过item除每页任务数量的最大页",
          "default": 1
        },
        "per_page": {
          "type": "integer",
          "format": "int32",
          "description": "每页item数量,填0获取全部item",
          "minimum": 0,
          "maximum": 100,
          "default": 5
        }
      },
      "description": "分页请求体"
    }
  },
