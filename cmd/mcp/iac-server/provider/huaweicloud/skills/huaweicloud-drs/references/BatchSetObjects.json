  "definitions": {
    "BatchUpdateDatabaseObjectReq": {
      "required": [
        "jobs"
      ],
      "properties": {
        "jobs": {
          "type": "array",
          "description": "批量更新数据库对象请求任务ID列表",
          "items": {
            "description": "",
            "$ref": "#/definitions/UpdateDatabaseObjectReq"
          }
        }
      },
      "description": "批量更新数据库对象选择消息体"
    },
    "DatabaseInfo": {
      "properties": {
        "id": {
          "type": "string",
          "description": "object_type为database时,为库名;object_type为table或者view时,字段值参考示例。"
        },
        "parent_id": {
          "type": "string",
          "description": "object_type为table或view时需要填写,为库名"
        },
        "object_type": {
          "type": "string",
          "description": "类型",
          "enum": [
            "database",
            "table",
            "schema",
            "view"
          ]
        },
        "object_name": {
          "type": "string",
          "description": "数据库对象名称,库名、表名、视图名"
        },
        "object_alias_name": {
          "type": "string",
          "description": "别名,映射的新名称。"
        },
        "select": {
          "type": "string",
          "description": "是否选中,值为true会进行迁移,false该数据库对象不会迁移,partial为迁移库下面的部分表,不填默认为false"
        }
      },
      "description": "数据库对象选择信息"
    },
    "UpdateDatabaseObjectReq": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID"
        },
        "selected": {
          "type": "boolean",
          "description": "是否进行对象选择,是:自定义迁移对象,否:全部迁移,不填默认为否。"
        },
        "sync_database": {
          "type": "boolean",
          "description": "是否库级同步"
        },
        "job": {
          "type": "array",
          "description": "数据对象选择信息,selected为true时必填。",
          "items": {
            "description": "",
            "$ref": "#/definitions/DatabaseInfo"
          }
        }
      },
      "description": "更新对象选择信息体"
    },
    "BatchUpdateDatabaseObjectsResp": {
      "properties": {
        "all_counts": {
          "type": "integer",
          "format": "int64",
          "description": "总数"
        },
        "results": {
          "type": "array",
          "description": "批量对象选择响应列表",
          "items": {
            "description": "",
            "$ref": "#/definitions/DatabaseObjectResp"
          }
        }
      },
      "description": "批量对象选择任务任务返回体"
    },
    "DatabaseObjectResp": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID"
        },
        "status": {
          "type": "boolean",
          "description": "选择对象任务成功标志:true,false"
        },
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "description": "对象选择返回体",
      "type": "object"
    }
  },
