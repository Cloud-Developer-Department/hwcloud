  "definitions": {
    "QueryDataLevelTableCompareJobsResp": {
      "type": "object",
      "description": "查询表对比任务列表返回",
      "properties": {
        "compare_jobs": {
          "description": "表对比任务信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CompareJobInfo"
          }
        },
        "count": {
          "type": "integer",
          "format": "int64",
          "description": "任务数量"
        }
      }
    },
    "CompareJobInfo": {
      "type": "object",
      "description": "对比列表信息体",
      "properties": {
        "id": {
          "type": "string",
          "description": "对比任务ID。"
        },
        "type": {
          "type": "string",
          "description": "对比类型。\n- lines:行数对比\n- contents:内容对比\n- random:抽样对比,当前仅支持gaussdbv5、gaussdbv5-to-postgresql、gaussdbv5ha-to-postgresql链路。"
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "对比配置项,key-value形式。\n内容对比支持以下配置项:\n-\t对比方式配置,key:contentCompareType,value:dynamic表示动态对比,static表示静态对比。\n-\tlob字段对比类型配置,key:lobCompare,value:ignore表示忽略,length表示长度对比。\n\n行数对比支持以下配置项:\n-\t对比策略配置,多表归一情况下适用,key:comparePolicy,value:normal表示正常对比,manyToOne表示多对一对比。"
        },
        "start_time": {
          "type": "string",
          "description": "开始时间,UTC时间,例如:2020-09-01T18:50:20Z。"
        },
        "end_time": {
          "type": "string",
          "description": "结束时间,UTC时间,例如:2020-09-01T18:50:20Z。"
        },
        "status": {
          "type": "string",
          "description": "对比任务的状态。\n- RUNNING-运行中\n- WAITING_FOR_RUNNING-等待启动中\n- SUCCESSFUL-完成\n- FAILED-失败\n- CANCELLED-已取消\n- TIMEOUT_INTERRUPT-超时中断\n- FULL_DOING-全量校验中\n- INCRE_DOING-增量校验中"
        },
        "export_status": {
          "type": "string",
          "description": "导出对比结果状态。\n- INIT:初始状态\n- EXPORTING:对比结果导出中\n- EXPORT_COMPLETE:对比结果导出完成\n- EXPORT_COMMON_FAILED:对比结果导出失败"
        },
        "report_remain_seconds": {
          "type": "integer",
          "format": "int64",
          "description": "导出比对结果有效期剩余时间。"
        },
        "compare_job_tag": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "对比任务的标签,当前仅涉及对比策略时返回。"
        },
        "proportion_value": {
          "type": "string",
          "description": "抽样比例,对比类型为抽样对比时填写。"
        }
      }
    }
  },
