  "definitions": {
    "SubscriptionDetailResp": {
      "type": "object",
      "description": "查询订阅任务详情响应体",
      "properties": {
        "id": {
          "type": "string",
          "description": "任务id"
        },
        "name": {
          "type": "string",
          "description": "任务名称\n约束:任务名称在4位到50位之间,不区分大小写,可以包含字母、数字、中划线或下划线,不能包括其他特殊字符。\n-\t最小长度:4\n-\t最大长度:50"
        },
        "ip": {
          "type": "string",
          "description": "内网ip"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目id"
        },
        "status": {
          "type": "string",
          "description": "任务状态,取值:\nCONFIGURATION:配置中\nCREATING:创建中\nCREATE_FAILED:创建失败\nSTARTJOBING:启动中\nSTARTJOB_FAILED:任务启动失败\nSUBSCRIPTION_STARTED:正常\nSUBSCRIPTION_FAILED:异常\nDELETED:已删除\nFROZEN:冻结状态\nREBUILD_NODE_STARTED:订阅任务恢复中\nREBUILD_NODE_FAILED:订阅任务恢复失败\nNODE_UPGRADE_START:升级开始\nNODE_UPGRADE_COMPLETE:升级完成\nNODE_UPGRADE_FAILED:升级失败"
        },
        "subscription_data_type": {
          "description": "订阅的数据类型,包含数据操作语言(DDL)和数据定义语言(DML)",
          "$ref": "#/definitions/SubscriptionDataType"
        },
        "source_endpoint": {
          "description": "订阅源数据库实例信息",
          "$ref": "#/definitions/SubscriptionEndpointInfo"
        },
        "created_time": {
          "type": "string",
          "description": "创建时间,以时间戳表示"
        },
        "begin_time": {
          "type": "string",
          "description": "开始时间,以时间戳表示"
        },
        "now_time": {
          "type": "string",
          "description": "当前时间,以时间戳表示"
        },
        "engine_type": {
          "type": "string",
          "description": "链路类型,当前仅支持“mysql”"
        },
        "charge_info": {
          "description": "计费方式,不收费时为NULL。",
          "$ref": "#/definitions/ChargeInfoVo"
        },
        "description": {
          "type": "string",
          "description": "描述"
        }
      },
      "required": [
        "id",
        "name",
        "ip",
        "enterprise_project_id",
        "status",
        "subscription_data_type",
        "source_endpoint",
        "created_time",
        "begin_time",
        "now_time",
        "engine_type"
      ]
    },
    "ErrorResp": {
      "description": "请求失败时返回的错误对象响应体。",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 12,
          "maxLength": 12,
          "example": "DRS.00000000"
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "example": "Success"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object"
    },
    "ChargeInfoVo": {
      "type": "object",
      "properties": {
        "charge_mode": {
          "type": "string",
          "example": "period",
          "description": "计费模式,取值:\n - on_demand: 按需\n - period: 包周期"
        },
        "period_type": {
          "type": "string",
          "example": "month",
          "description": "订购周期类型,“charge_mode”为“period”时生效,且为必选值。取值:\n - month: 包月\n - year: 包年"
        },
        "period_num": {
          "type": "integer",
          "format": "int32",
          "example": 3,
          "description": "订购时长,“charge_mode”为“period”时生效,且为必选值,指定订购的时间。\n当“period_type”为“month”时,取值为1~9。\n当“period_type”为“year”时,取值为1~3和5。"
        },
        "is_auto_renew": {
          "type": "boolean",
          "example": true,
          "description": "是否自动续订,创建包周期实例时可指定,表示是否自动续订,续订的周期和原周期相同,且续订时会自动支付。取值:\n - true: 自动续订\n - false: 不自动续订"
        },
        "is_auto_pay": {
          "type": "boolean",
          "example": false,
          "description": "是否自动支付,创建包周期时可指定,表示是否自动从客户的账户中支付,此字段不影响自动续订的支付方式。\n - true: 自动支付\n - false: 手动支付"
        }
      }
    },
    "SubscriptionDataType": {
      "type": "object",
      "description": "订阅的数据类型是否包含DDL/DML语句,返回值:\ntrue:是。\nfalse:否。",
      "required": [
        "is_dml_subscribed",
        "is_ddl_subscribed"
      ],
      "properties": {
        "is_dml_subscribed": {
          "type": "boolean",
          "description": "数据操作语言,取值:\ntrue:订阅DML\nfalse:不订阅DML"
        },
        "is_ddl_subscribed": {
          "type": "boolean",
          "description": "数据定义语言,取值:\ntrue:订阅DDL\nfalse:不订阅DDL"
        }
      }
    },
    "SubscriptionEndpointInfo": {
      "type": "object",
      "properties": {
        "db_instance_id": {
          "type": "string",
          "description": "数据库实例id"
        },
        "name": {
          "type": "string",
          "description": "数据库名称"
        },
        "ip": {
          "type": "string",
          "description": "数据库内网ip"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "description": "数据库端口"
        },
        "type": {
          "type": "string",
          "description": "数据库类型"
        },
        "user_name": {
          "type": "string",
          "description": "数据库用户名"
        }
      },
      "required": [
        "db_instance_id",
        "name",
        "ip",
        "port",
        "type",
        "user_name"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
