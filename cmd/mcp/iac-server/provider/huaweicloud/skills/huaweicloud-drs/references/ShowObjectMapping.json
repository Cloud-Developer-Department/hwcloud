            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型。",
            "type": "string",
            "default": "en-us",
            "enum": [
              "en-us",
              "zh-cn"
            ]
          },
          {
            "name": "ShowObjectMappingRequestBody",
            "in": "body",
            "required": true,
            "description": "查询同步映射请求体。",
