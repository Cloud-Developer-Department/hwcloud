  "definitions": {
    "ErrorResp": {
      "description": "请求失败时返回的错误对象响应体。",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 12,
          "maxLength": 12,
          "example": "DRS.00000000"
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "example": "Success"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object"
    },
    "ModifyComparePolicyReq": {
      "type": "object",
      "description": "修改对比策略请求体。",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "description": "对比策略开关-open|close。"
        },
        "period": {
          "type": "string",
          "description": "对比策略周期。\n- 每周对比:格式示例:“* * 1,3,5” ,其中“1,3,5”对应星期一、星期三、星期五,根据实际填写。\n- 每天对比:固定填写“* * 1,2,3,4,5,6,7”。\n- 按小时对比:固定填写“* * 1,2,3,4,5,6,7”。",
          "example": "* * 1,2,3,4,5,6,7"
        },
        "begin_time": {
          "type": "string",
          "description": "对比策略生效开始时间,UTC时间,24小时制,时间格式HH:mm:ss,例如:00:00:00,表示UTC时间的00:00:00,北京时间(UTC+08:00)的08:00:00。",
          "example": "00:00:00"
        },
        "end_time": {
          "type": "string",
          "description": "对比策略生效结束时间,UTC时间,24小时制,时间格式HH:mm:ss,例如:04:00:00,表示UTC时间的04:00:00,北京时间(UTC+08:00)的12:00:00。",
          "example": "04:00:00"
        },
        "compare_type": {
          "type": "array",
          "description": "对比类型列表:\n- object_comparison:对象对比。\n- lines:行对比。\n- account:用户对比。",
          "items": {
            "type": "string"
          }
        },
        "compare_policy": {
          "type": "string",
          "description": "对比策略:\n- normal:普通对比。\n- manyToOne:多对一对比。",
          "enum": [
            "normal",
            "manyToOne"
          ]
        },
        "interval_hour": {
          "type": "integer",
          "format": "int32",
          "description": "间隔时间,按小时对比时填写,表示每隔多久执行一次对比,单位是小时。"
        }
      }
    },
    "ApiHttpResp": {
      "type": "object",
      "description": "空响应体。"
    }
  },
  "version": "2.0",
