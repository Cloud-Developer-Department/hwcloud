  "definitions": {
    "BatchModifyJobReq": {
      "required": [
        "jobs"
      ],
      "properties": {
        "jobs": {
          "type": "array",
          "description": "修改任务请求体",
          "items": {
            "description": "",
            "$ref": "#/definitions/ModifyJobReq"
          }
        }
      },
      "description": "批量修改任务请求体"
    },
    "BatchModifyJobResp": {
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "总数"
        },
        "results": {
          "type": "array",
          "description": "批量修改任务返回列表",
          "items": {
            "description": "",
            "$ref": "#/definitions/ModifyJobResp"
          }
        }
      },
      "description": "批量修改任务返回体"
    },
    "AlarmNotifyInfo": {
      "properties": {
        "delay_time": {
          "type": "integer",
          "format": "int64",
          "description": "订阅延迟时间(单位为s)",
          "minimum": 1,
          "maximum": 3600,
          "default": 0
        },
        "rto_delay": {
          "type": "integer",
          "format": "int64",
          "description": "rto延迟时间",
          "minimum": 1,
          "maximum": 3600,
          "default": 0
        },
        "rpo_delay": {
          "type": "integer",
          "format": "int64",
          "description": "rpo延迟时间",
          "minimum": 1,
          "maximum": 3600,
          "default": 0
        },
        "alarm_to_user": {
          "type": "boolean",
          "description": "异常告警是否通知用户"
        },
        "subscriptions": {
          "type": "array",
          "description": "收件方式与信息体",
          "items": {
            "description": "收件方式与信息体",
            "$ref": "#/definitions/SubscriptionInfo"
          }
        }
      },
      "description": "异常通知信息"
    },
    "ModifyJobReq": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务id",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "description": {
          "type": "string",
          "description": "任务描述,修改任务描述时必填。",
          "minLength": 0,
          "maxLength": 256,
          "pattern": "^[^!<>=&\"\\\\']{0,256}$"
        },
        "name": {
          "type": "string",
          "description": "任务名称,修改任务名称时必填"
        },
        "alarm_notify": {
          "description": "设置异常通知信息",
          "$ref": "#/definitions/AlarmNotifyInfo"
        },
        "task_type": {
          "type": "string",
          "example": "FULL_INCR_TRANS",
          "description": "任务模式,FULL_TRANS:全量;FULL_INCR_TRANS:全量+增量;INCR_TRANS:增量。",
          "enum": [
            "FULL_TRANS",
            "INCR_TRANS",
            "FULL_INCR_TRANS"
          ]
        },
        "source_endpoint": {
          "description": "源库信息,测试连接之后调用必填。",
          "$ref": "#/definitions/Endpoint"
        },
        "target_endpoint": {
          "description": "目标库信息,测试连接之后调用必填。",
          "$ref": "#/definitions/Endpoint"
        },
        "node_type": {
          "type": "string",
          "example": "high",
          "description": "node规格类型,测试连接之后修改调用时必填。取值:\n- micro:极小规格。\n- small:小规格。\n- medium:中规格。\n- high:大规格。\n- xlarge:超大规格。\n- 2xlarge:极大规格。",
          "enum": [
            "micro",
            "small",
            "medium",
            "high",
            "xlarge",
            "2xlarge"
          ],
          "default": "high"
        },
        "engine_type": {
          "type": "string",
          "description": "引擎类型,测试连接之后修改调用时必填。mysql:迁移,同步使用。mongodb:迁移使用。cloudDataGuard-mysql:灾备使用",
          "enum": [
            "mysql",
            "mongodb",
            "cloudDataGuard-mysql",
            "gaussdbv5",
            "postgresql",
            "mysql-to-kafka",
            "taurus-to-kafka",
            "gaussdbv5ha-to-kafka"
          ]
        },
        "net_type": {
          "type": "string",
          "description": "网络类型,测试连接之后修改调用时必填。",
          "enum": [
            "vpc",
            "vpn",
            "eip"
          ]
        },
        "store_db_info": {
          "type": "boolean",
          "description": "保存数据库信息,测试连接之后修改调用时必填为true。"
        },
        "is_recreate": {
          "type": "boolean",
          "description": "是否为重建任务。"
        },
        "job_direction": {
          "type": "string",
          "description": "迁移方向,up 入云 灾备场景时对应本云为备,down 出云 灾备场景时对应本云为主,non-dbs 自建",
          "enum": [
            "up",
            "down",
            "non-dbs"
          ]
        },
        "is_target_readonly": {
          "type": "boolean",
          "description": "目标实例是否限制为只读。"
        },
        "replace_definer": {
          "type": "boolean",
          "example": true,
          "description": "所有Definer是否迁移到该用户下,MySQL数据库支持该设置,测试连接之后修改调用时必填。\n- true:迁移后,所有源数据库对象的Definer都会迁移至该用户下,其他用户需要授权后才具有数据库对象权限\n- false:迁移后,将保持源数据库对象Definer定义不变,选择此选项,需要配合下一步用户权限迁移功能,将源数据库的用户全部迁移,这样才能保持源数据库的权限体系完全不变。"
        },
        "tags": {
          "type": "array",
          "description": "标签信息",
          "items": {
            "$ref": "#/definitions/ResourceTag"
          }
        },
        "db_use_type": {
          "type": "string",
          "description": "迁移类型,migration-实时迁移,sync-实时同步,cloudDataGuard-实时灾备",
          "enum": [
            "migration",
            "sync",
            "cloudDataGuard"
          ]
        },
        "product_id": {
          "type": "string",
          "description": "产品ID。"
        }
      },
      "description": "修改任务描述信息、名称,设置异常通知信息、限速等。",
      "required": [
        "job_id"
      ],
      "type": "object"
    },
    "SubscriptionInfo": {
      "properties": {
        "endpoints": {
          "type": "array",
          "example": [
            "string"
          ],
          "description": "短信或者邮件列表",
          "items": {
            "type": "string"
          }
        },
        "protocol": {
          "type": "string",
          "example": "sms",
          "description": "收件方式,sms:短信,email:邮件",
          "enum": [
            "sms",
            "email"
          ]
        }
      },
      "description": "收件方式与信息体"
    },
    "ModifyJobResp": {
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "任务ID"
        },
        "status": {
          "type": "string",
          "description": "状态。\n- success 成功\n- failed 失败",
          "enum": [
            "success",
            "failed"
          ]
        },
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "type": "object"
    },
    "ResourceTag": {
      "properties": {
        "key": {
          "type": "string",
          "description": "标签键,最大长度36,只能包含字母、数字、下划线、中划线和中文,需要修改标签时填写。"
        },
        "value": {
          "type": "string",
          "description": "标签值,最大长度43,只能包含字母、数字、下划线、中划线和中文,需要修改标签时填写。"
        }
      },
      "description": "标签信息体"
    },
    "Endpoint": {
      "properties": {
        "db_type": {
          "type": "string",
          "example": "mysql",
          "description": "数据库类型,测试连接之后修改调用时必填。",
          "enum": [
            "mysql",
            "mongodb",
            "gaussdbv5",
            "postgresql",
            "kafka",
            "gaussdbv5ha",
            "taurus"
          ]
        },
        "az_code": {
          "type": "string",
          "description": "数据库所在可用区azCode"
        },
        "region": {
          "type": "string",
          "example": "cn-xianhz-1",
          "description": "RDS实例所在Region,数据库为RDS实例时必填(灾备场景下job_direction为down时source_endpoint中该值为必填,job_direction为up时target_endpoint中该值为必填)。"
        },
        "inst_id": {
          "type": "string",
          "example": "e05a3679efe241d8b5dee80b17c1a863in01",
          "description": "RDS实例ID,数据库为RDS实例必填(灾备场景下job_direction为down时source_endpoint中该值为必填,job_direction为up时target_endpoint中该值为必填)。"
        },
        "vpc_id": {
          "type": "string",
          "description": "数据库所在的虚拟私有云id"
        },
        "subnet_id": {
          "type": "string",
          "description": "数据库所在的子网id"
        },
        "security_group_id": {
          "type": "string",
          "description": "数据库所在的安全组id。"
        },
        "project_id": {
          "type": "string",
          "description": "RDS实例projectId"
        },
        "db_name": {
          "type": "string",
          "description": "服务名serviceName,源库为oracle场景时必填。约束:不能超过128位,不能包含!<>&'\"\\特殊字符。待还原数据库名称是指备份文件中包含的数据库名称,当您选择部分数据库恢复时,需要选择恢复一个或者多个数据库。"
        },
        "db_password": {
          "type": "string",
          "description": "数据库密码。"
        },
        "db_port": {
          "type": "integer",
          "format": "int32",
          "description": "数据库端口。约束:输入范围为1-65535之间的整数。"
        },
        "db_user": {
          "type": "string",
          "description": "数据库用户。"
        },
        "inst_name": {
          "type": "string",
          "description": "RDS实例名称。"
        },
        "ip": {
          "type": "string",
          "description": "数据库ip"
        },
        "mongo_ha_mode": {
          "type": "string",
          "description": "mongo ha模式。"
        },
        "safe_mode": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "MRS集群运行模式,取值:\n- 0普通集群\n- 1安全集群"
        },
        "ssl_cert_password": {
          "type": "string",
          "description": "SSL证书密码,证书文件后缀为.p12"
        },
        "ssl_cert_check_sum": {
          "type": "string",
