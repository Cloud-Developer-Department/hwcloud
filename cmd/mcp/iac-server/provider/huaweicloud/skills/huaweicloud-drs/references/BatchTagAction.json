  "definitions": {
    "BatchDealResourceTagReq": {
      "type": "object",
      "description": "批量添加或删除资源标签请求体。",
      "properties": {
        "action": {
          "type": "string",
          "description": "操作标识(区分大小写):\n- 创建时为“create”\n- 删除时为“delete”",
          "enum": [
            "create",
            "delete"
          ]
        },
        "tags": {
          "items": {
            "$ref": "#/definitions/BatchResourceTag"
          },
          "description": "标签列表。最多添加10个标签。",
          "type": "array"
        }
      },
      "required": [
        "action",
        "tags"
      ]
    },
    "BatchResourceTag": {
      "type": "object",
      "description": "标签信息体",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "标签键。\n- 长度为1-128个unicode字符。\n- 可以包含任何语种字母、数字、空格和_.:=+-@,但首尾不能含有空格,不能以_sys_开头。",
          "maxLength": 128,
          "minLength": 1
        },
        "value": {
          "type": "string",
          "description": "标签值,删除标签时非必填。\n- 最大长度255个unicode字符。\n- 可以包含任何语种字母、数字、空格和_.:=+-@。",
          "maxLength": 255
        }
      }
    }
  },
