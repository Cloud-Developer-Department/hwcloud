        ],
        "summary": "批量设置同步策略",
        "description": "- 批量设置同步策略,包括冲突策略、过滤DROP Datase、对象同步范围。\n- 设置kafka同步策略",
        "operationId": "BatchSetPolicy",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一Region下的Project ID。"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "指定类型为application/json。",
            "type": "string",
            "default": "application/json",
            "enum": [
              "application/json"
            ]
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "从IAM服务获取的用户Token。",
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型。",
            "type": "string",
            "default": "en-us",
            "enum": [
              "en-us",
              "zh-cn"
            ]
          },
          {
            "name": "requestBody",
            "in": "body",
