  "definitions": {
    "ConfigTransformationVo": {
      "required": [
        "col_names",
        "db_name",
        "db_table_name",
        "indexs",
        "prim_key_or_index",
        "table_name",
        "values"
      ],
      "properties": {
        "db_table_name": {
          "type": "string",
          "description": "库名.表名。"
        },
        "db_name": {
          "type": "string",
          "description": "库名。长度限制256。"
        },
        "table_name": {
          "type": "string",
          "description": "表名。长度限制256。"
        },
        "col_names": {
          "type": "string",
          "description": "列名。长度限制256。"
        },
        "prim_key_or_index": {
          "type": "string",
          "description": "主键或唯一索引。长度限制256。"
        },
        "indexs": {
          "type": "string",
          "description": "优化查询所需的索引。长度限制256。"
        },
        "values": {
          "type": "string",
          "description": "过滤条件。长度限制256。"
        }
      },
      "description": "数据同步配置库规则信息体"
    },
    "BatchDataTransformationReq": {
      "required": [
        "jobs"
      ],
      "properties": {
        "jobs": {
          "type": "array",
          "description": "批量数据加工规则请求列表",
          "items": {
            "description": "",
            "$ref": "#/definitions/CheckDataTransformationReq"
          }
        }
      },
      "description": "批量数据加工规则请求体"
    },
    "DatabaseObjectVO": {
      "properties": {
        "id": {
          "type": "string",
          "description": "数据库对象和数据库表名称,例如格式为hec-*-*-drs_test1。"
        },
        "select": {
          "type": "string",
          "description": "是否选择高级配置,值为true。"
        }
      },
      "description": "数据库对象信息体"
    },
    "BatchDataTransformationResp": {
      "properties": {
        "results": {
          "type": "array",
          "description": "批量数据加工响应列表",
          "items": {
            "description": "",
            "$ref": "#/definitions/DataTransformationResp"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "总数"
        }
      },
      "description": "批量数据加工规则返回体"
    },
    "DataTransformationResp": {
      "properties": {
        "id": {
          "type": "string",
          "description": "任务id"
        },
        "status": {
          "type": "string",
          "description": "状态",
          "enum": [
            "success",
            "failed"
          ]
        },
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "description": "数据加工返回体"
    },
    "TransformationInfo": {
      "required": [
        "transformation_type",
        "value"
      ],
      "properties": {
        "transformation_type": {
          "type": "string",
          "description": "- 生成加工规则值为contentConditionalFilter\n- 生成配置规则值为configConditionalFilter",
          "enum": [
            "contentConditionalFilter",
            "configConditionalFilter"
          ]
        },
        "value": {
          "type": "string",
          "description": "过滤条件,生成加工规则值为sql条件语句,生成配置规则值为config。长度限制256。"
        }
      },
      "description": "数据加工信息"
    },
    "CheckDataTransformationReq": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务id"
        },
        "object_info": {
          "type": "array",
          "description": "对象信息,生成加工规则时需要填写。",
          "items": {
            "$ref": "#/definitions/DatabaseObjectVO"
          }
        },
        "transformation_info": {
          "description": "加工信息。",
          "$ref": "#/definitions/TransformationInfo"
        },
        "config_transformation": {
          "description": "- 配置信息,如果存在多张关联表,请生成多条配置规则。满足配置条件的数据将暂存到缓存中,在数据过滤的场景进行使用。\n- 配置的库名和表名支持数字、字母和下划线。\n- 配置的列名、主键、索引,请确保与源库配置表的字段名保持大小写一致。",
          "$ref": "#/definitions/ConfigTransformationVo"
        }
      },
      "description": "校验数据加工规则请求体",
      "required": [
        "transformation_info"
      ]
    }
  },
