  "definitions": {
    "CreateDataCompareTransformationInfo": {
      "type": "object",
      "description": "数据加工信息。",
      "required": [
        "transformation_type",
        "value"
      ],
      "properties": {
        "transformation_type": {
          "type": "string",
          "description": "加工规则,值为contentConditionalFilter。"
        },
        "value": {
          "type": "string",
          "description": "过滤条件,值为sql条件语句,例如id>100,长度限制256。"
        }
      }
    },
    "CompareObjectInfo": {
      "required": [
        "db_name"
      ],
      "properties": {
        "db_name": {
          "type": "string",
          "description": "库名。"
        },
        "table_name": {
          "type": "array",
          "description": "该库下的表名列表。",
          "items": {
            "type": "string",
            "description": ""
          }
        }
      },
      "description": ""
    },
    "CompareObjectInfoWithToken": {
      "required": [
        "db_name"
      ],
      "properties": {
        "db_name": {
          "type": "string",
          "description": "库名。"
        },
        "table_name_with_token": {
          "type": "array",
          "example": "[{\"table_name\":\"\",\"min_token\":\"\",\"max_token\":\"\"}]",
          "description": "该库下的表信息列表(带token)。",
          "items": {
            "description": "",
            "$ref": "#/definitions/CompareTableInfoWithToken"
          }
        }
      },
      "description": ""
    },
    "CompareTableInfoWithToken": {
      "required": [
        "table_name"
      ],
      "properties": {
        "table_name": {
          "type": "string",
          "description": "表名。"
        },
        "min_token": {
          "type": "string",
          "description": "该表的min token。"
        },
        "max_token": {
          "type": "string",
          "description": "该表的max token。"
        }
      },
      "description": ""
    },
    "CreateDataLevelTableCompareJobReq": {
      "type": "object",
      "description": "创建数据级对比任务请求",
      "properties": {
        "type": {
          "type": "string",
          "description": "对比类型。\n- lines:行数对比\n- contents:内容对比\n- random:抽样对比,当前仅支持gaussdbv5、gaussdbv5-to-postgresql、gaussdbv5ha-to-postgresql链路。"
        },
        "start_time": {
          "type": "string",
          "description": "对比任务启动时间,时间戳格式,取值为空代表立即启动。"
        },
        "compare_mode": {
          "type": "string",
          "description": "数据级对比模式,取值为空时需要在compare_object或者compare_object_with_token传对象信息,quick_comparison-快速对比。\n取值:quick_comparison",
          "default": "quick_comparison"
        },
        "compare_object": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CompareObjectInfo"
          },
          "description": "数据级对比的对象。"
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "对比配置项,key-value形式。\n内容对比支持以下配置项:\n-\t对比方式配置,key:contentCompareType,value:dynamic表示动态对比,static表示静态对比。\n-\tlob字段对比类型配置,key:lobCompare,value:ignore表示忽略,length表示长度对比。\n\n行数对比支持以下配置项:\n-\t对比策略配置,多表归一情况下适用,key:comparePolicy,value:normal表示正常对比,manyToOne表示多对一对比。"
        },
        "compare_object_with_token": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CompareObjectInfoWithToken"
          },
          "description": "数据级对比的对象(Cassandra灾备专用,带token信息)。"
        },
        "compare_task_num": {
          "type": "integer",
          "format": "int32",
          "description": "对比任务线程数量,当前仅cloudDataGuard-cassandra和cloudDataGuard-gausscassandra-to-gausscassandra链路支持。"
        },
        "compare_transformation_infos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AddDataTransformationReq"
          },
          "description": "过滤数据信息。"
        },
        "proportion_value": {
          "type": "number",
          "format": "double",
          "description": "抽样比例,对比类型为抽样对比时填写。"
        }
      },
      "required": [
        "type"
      ]
    },
    "CreateDataCompareJobResp": {
      "type": "object",
      "description": "创建表对比任务结果",
      "properties": {
        "id": {
          "type": "string",
          "description": "对比任务ID"
        }
      }
    },
    "AddDataTransformationReq": {
      "type": "object",
      "description": "数据加工规则",
      "properties": {
        "object_info": {
          "description": "对象信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CreateDataCompareDatabaseObject"
          }
        },
        "transformation_info": {
          "description": "数据过滤信息。",
          "$ref": "#/definitions/CreateDataCompareTransformationInfo"
        }
      },
      "required": [
        "object_info",
        "transformation_info"
      ]
    },
    "CreateDataCompareDatabaseObject": {
      "type": "object",
      "description": "数据加工对象信息",
      "properties": {
        "id": {
          "type": "string",
          "description": "两层数据库场景:\n数据库名称和数据库表名称,例如格式为t_auto_db-*-*-users,其中t_auto_db为数据库名称,users为表名称。\n\n三层数据库场景:\n数据库名称、数据库schema名称、数据库表名称,例如格式为t_auto_db-*-*-schema1-*-*-users,其中t_auto_db为数据库名称,schema1为数据库schema名称,users为表名称。"
        }
      }
    }
  },
