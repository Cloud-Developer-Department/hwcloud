{
  "name": "UploadDbObjectTemplate",
  "summary": "对象选择(文件导入 - 模板上传)",
  "tags": "实例数据库对象配置",
  "productshort": "DRS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v5/{project_id}/jobs/{job_id}/db-object/template": {
      "post": {
        "x-constraint": "- 目前Oracle->GaussDB分布式同步场景支持 .xls/xlsx, 文件阈值是5MB\n- GaussDB for (MySQL)/MySQL-Kafka导入支持json/txt文件 以及 包含JSON/TXT的ZIP文件(ZIP中仅支持一个文件) \n- GaussDB for (MySQL)/MySQL-Kafka导入的文件内容仅支持JSON格式, 参考更新指定ID任务详情接口中,更新对象信息请求参数\n- GaussDB for (MySQL)/MySQL-Kafka导入支持JSON/TXT文件的阈值限制是5MB,ZIP阈值是1MB,  ZIP中文件大小阈值是20MB",
        "x-request-examples-url-1": "https://{endpoint}/v5/054ba152d480d55b2f5dc0069e7ddef0/jobs/c7debc9c-8e09-4a5d-8dd6-cc44f78jb20r/db-object/template",
        "x-request-examples-description-1": "导入该任务的对象选择模板。",
        "tags": [
          "实例数据库对象配置"
        ],
        "operationId": "UploadDbObjectTemplate",
        "consumes": [
          "multipart/form-data"
        ],
        "summary": "对象选择(文件导入 - 模板上传)",
        "description": "对象选择(文件导入 - 模板上传)。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一Region下的Project ID。\n获取方法请参见[获取项目ID。](https://support.huaweicloud.com/api-drs/drs_api_0106.html)"
          },
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "任务ID。"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "发送的实体的MIME类型。使用multipart/form-data,如果API是对象、镜像上传等接口,媒体类型可按照流类型的不同进行确定。",
            "type": "string",
            "default": "multipart/form-data"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "从IAM服务获取的用户Token。\n\n用户Token也就是调用获取用户Token接口的响应值,该接口是唯一不需要认证的接口。\n\n请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。",
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型。",
            "type": "string",
            "default": "en-us",
            "enum": [
              "en-us",
              "zh-cn"
            ]
          },
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "type": "file",
            "description": "待上传的模板文件。"
          },
          {
            "name": "file_import_db_level",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "文件模板支持数据同步级别,不填默认为table表级。\n- database:库级\n- table:表级\n- column:列级\n- partition:partition分区级导入",
            "default": "table",
            "enum": [
              "database",
              "table",
              "column",
              "partition"
            ]
          },
          {
            "name": "file_import_mapping_type",
            "in": "query",
            "required": false,
            "description": "导入文件模板的映射场景,取值:\n- table_mapping:表名映射\n- topic_mapping:topic名映射",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "send_success": true
              }
            },
            "schema": {
              "$ref": "#/definitions/DbObjectTemplateProgressResp"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "DRS.10000010",
                "error_msg": "Job does not exist, please check job ID."
              }
            }
          }
        },
        "x-order": 6
      }
    }
  },
  "definitions": {
    "ErrorResp": {
      "description": "请求失败时返回的错误对象响应体。",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 12,
          "maxLength": 12,
          "example": "DRS.00000000"
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "example": "Success"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object"
    },
    "DbObjectTemplateProgressResp": {
      "type": "object",
      "properties": {
        "send_success": {
          "type": "boolean",
          "example": true,
          "description": "是否上传完成。"
        },
        "process_status": {
          "type": "string",
          "example": "success",
          "description": "文件解析状态。\n取值:success,failed"
        },
        "parsed_success_number": {
          "type": "string",
          "example": 1,
          "description": "解析成功的行数。"
        }
      },
      "description": "对象选择模板导入进度返回体。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "drs.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v5",
  "method": "post",
  "uri": null
}