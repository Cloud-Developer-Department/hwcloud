{
  "name": "ListJobs",
  "summary": "查询任务列表",
  "tags": "实例管理",
  "productshort": "DRS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v5/{project_id}/jobs": {
      "get": {
        "x-request-examples-url-2": "https://{endpoint}/v5/054ba152d480d55b2f5dc0069e7ddef0/jobs?job_type=sync&name=&status=&engine_type=&net_type=&enterprise_project_id=&offset=0&limit=10&sort_key=create_time&sort_dir=desc",
        "x-request-examples-description-2": "查询实时同步任务列表。",
        "x-request-examples-url-3": "https://{endpoint}/v5/054ba152d480d55b2f5dc0069e7ddef0/jobs?job_type=cloudDataGuard&name=&status=&engine_type=&net_type=&enterprise_project_id=&offset=0&limit=10&sort_key=create_time&sort_dir=desc",
        "x-request-examples-description-3": "查询实时灾备任务列表。",
        "x-request-examples-url-1": "https://{endpoint}/v5/054ba152d480d55b2f5dc0069e7ddef0/jobs?job_type=migration&name=&status=&engine_type=&net_type=&enterprise_project_id=&offset=0&limit=10&sort_key=create_time&sort_dir=desc",
        "x-request-examples-description-1": "查询实时迁移任务列表。",
        "x-request-examples-url-4": "https://{endpoint}/v5/054ba152d480d55b2f5dc0069e7ddef0/jobs?job_type=cloudDataGuard&name=&status=&engine_type=&net_type=&enterprise_project_id=&offset=0&limit=10&sort_key=create_time&sort_dir=desc&instance_ids=id1&instance_ids=id2",
        "x-request-examples-description-4": "查询实时灾备任务列表,按数据库实例ID过滤。",
        "x-request-examples-url-5": "https://{endpoint}/v5/054ba152d480d55b2f5dc0069e7ddef0/jobs?job_type=cloudDataGuard&name=&status=&engine_type=&net_type=&enterprise_project_id=&offset=0&limit=10&sort_key=create_time&sort_dir=desc&instance_ip=127.0.0.1",
        "x-request-examples-description-5": "查询实时灾备任务列表,按数据库实例IP过滤。",
        "tags": [
          "实例管理"
        ],
        "operationId": "ListJobs",
        "consumes": [
          "application/json"
        ],
        "summary": "查询任务列表",
        "description": "查询租户任务列表,可以根据企业项目,引擎类型,网络类型,任务状态,任务名称,任务ID进行查询。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一Region下的Project ID。\n获取方法请参见[获取项目ID。](https://support.huaweicloud.com/api-drs/drs_api_0106.html)"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "发送的实体的MIME类型。推荐用户默认使用application/json,如果API是对象、镜像上传等接口,媒体类型可按照流类型的不同进行确定。",
            "type": "string",
            "default": "application/json"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "从IAM服务获取的用户Token。\n\n用户Token也就是调用获取用户Token接口的响应值,该接口是唯一不需要认证的接口。\n\n请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。",
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型。",
            "type": "string",
            "default": "en-us",
            "enum": [
              "en-us",
              "zh-cn"
            ]
          },
          {
            "name": "job_type",
            "in": "query",
            "required": true,
            "description": "任务场景。取值:\n- migration:实时迁移。\n- sync:实时同步。\n- cloudDataGuard:实时灾备。",
            "type": "string",
            "enum": [
              "migration",
              "sync",
              "cloudDataGuard"
            ]
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "任务ID或名称。",
            "type": "string"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "任务状态。取值:\n- CREATING:创建中。\n- CREATE_FAILED:创建失败。\n- CONFIGURATION:配置中。\n- STARTJOBING:启动中。\n- WAITING_FOR_START:等待启动中。\n- START_JOB_FAILED:任务启动失败。\n- FULL_TRANSFER_STARTED:全量迁移中,灾备场景为初始化。\n- FULL_TRANSFER_FAILED:全量迁移失败,灾备场景为初始化失败。\n- FULL_TRANSFER_COMPLETE:全量迁移完成,灾备场景为初始化完成。\n- INCRE_TRANSFER_STARTED:增量迁移中,灾备场景为灾备中。\n- INCRE_TRANSFER_FAILED:增量迁移失败,灾备场景为灾备异常。\n- RELEASE_RESOURCE_STARTED:结束任务中。\n- RELEASE_RESOURCE_FAILED:结束任务失败。\n- RELEASE_RESOURCE_COMPLETE:已结束。\n- CHANGE_JOB_STARTED:任务变更中。\n- CHANGE_JOB_FAILED:任务变更失败。\n- CHILD_TRANSFER_STARTING:子任务启动中。\n- CHILD_TRANSFER_STARTED:子任务迁移中。\n- CHILD_TRANSFER_COMPLETE:子任务迁移完成。\n- CHILD_TRANSFER_FAILED:子任务迁移失败。\n- RELEASE_CHILD_TRANSFER_STARTED:子任务结束中。\n- RELEASE_CHILD_TRANSFER_COMPLETE:子任务已结束。\n其中,异常状态可单独查询,也可以通过以下方式查询全部异常任务:\nCREATE_FAILED,START_JOB_FAILED,FULL_TRANSFER_FAILED,INCRE_TRANSFER_FAILED,RELEASE_RESOURCE_FAILED,CHANGE_JOB_FAILED,CHILD_TRANSFER_FAILED",
            "type": "string",
            "enum": [
              "CREATING",
              "CREATE_FAILED",
              "CONFIGURATION",
              "STARTJOBING",
              "WAITING_FOR_START",
              "START_JOB_FAILED",
              "FULL_TRANSFER_STARTED",
              "FULL_TRANSFER_FAILED",
              "FULL_TRANSFER_COMPLETE",
              "INCRE_TRANSFER_STARTED",
              "INCRE_TRANSFER_FAILED",
              "RELEASE_RESOURCE_STARTED",
              "RELEASE_RESOURCE_FAILED",
              "RELEASE_RESOURCE_COMPLETE",
              "CHANGE_JOB_STARTED",
              "CHANGE_JOB_FAILED",
              "CHILD_TRANSFER_STARTING",
              "CHILD_TRANSFER_STARTED",
              "CHILD_TRANSFER_COMPLETE",
              "CHILD_TRANSFER_FAILED",
              "RELEASE_CHILD_TRANSFER_STARTED",
              "RELEASE_CHILD_TRANSFER_COMPLETE"
            ]
          },
          {
            "name": "engine_type",
            "in": "query",
            "required": false,
            "description": "引擎类型。取值:\n- oracle-to-gaussdbv5:Oracle同步到GaussDB分布式版,实时同步场景使用。\n- redis-to-gaussredis:Redis同步到GeminiDB Redis,实时迁移场景使用。\n- rediscluster-to-gaussredis:Redis集群同步到GeminiDB Redis,实时迁移场景使用。",
            "type": "string",
            "enum": [
              "oracle-to-gaussdbv5",
              "redis-to-gaussredis",
              "rediscluster-to-gaussredis"
            ]
          },
          {
            "name": "net_type",
            "in": "query",
            "required": false,
            "description": "网络类型。取值:\n- eip:公网网络。\n- vpc:VPC网络。\n- vpn:VPN、专线网络。",
            "type": "string",
            "enum": [
              "eip",
              "vpc",
              "vpn"
            ]
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "required": false,
            "description": "企业项目ID。 缺省值:\"\",表示查询所有企业项目任务。",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "偏移量,表示查询该偏移量后面的记录。",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "查询返回记录的数量限制。",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "sort_key",
            "in": "query",
            "required": false,
            "description": "返回结果按该关键字排序,默认为“create_time”。\n当前支持排序的关键字:\n- name\n- status\n- create_time\n- net_type\n- job_direction\n- pay_mode",
            "type": "string",
            "enum": [
              "name",
              "status",
              "create_time",
              "net_type",
              "job_direction",
              "pay_mode"
            ]
          },
          {
            "name": "sort_dir",
            "in": "query",
            "required": false,
            "description": "降序或升序(分别对应desc和asc,默认为“desc”)。",
            "type": "string"
          },
          {
            "name": "instance_ids",
            "in": "query",
            "required": false,
            "description": "数据库实例ID列表,最多支持10个",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "name": "instance_ip",
            "in": "query",
            "required": false,
            "description": "数据库实例IP",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/QueryJobsResp"
            },
            "examples": {
              "application/json": {
                "jobs": [
                  {
                    "id": "c7debc9c-8e09-4a5d-8dd6-cc44f78jb20r",
                    "name": "DRS-1234",
                    "status": "CONFIGURATION",
                    "create_time": "2022-11-07T16:15:18Z",
                    "engine_type": "oracle-to-gaussdbv5",
                    "job_direction": "up",
                    "task_type": "FULL_INCR_TRANS",
                    "job_action": {
                      "available_actions": [
                        "FREE_RESOURCE",
                        "PRE_CHECK",
                        "MODIFY_CONFIGURATION",
                        "CHANGE"
                      ],
                      "unavailable_actions": [
                        "CREATE",
                        "START",
                        "CHOOSE_OBJECT",
                        "RETRY",
                        "RESET",
                        "DELETE",
                        "QUERY_PRE_CHECK",
                        "CHANGE_MODE",
                        "MODIFY_DB_CONFIG",
                        "SWITCH_OVER",
                        "RESET_DB_PWD",
                        "PAUSE",
                        "JUMP_RETRY",
                        "START_INCR",
                        "MODIFY_TASK_NUMBER",
                        "CONTINUE_JOB",
                        "STOP_JOB",
                        "CONTINUE_CAPTURE",
                        "STOP_CAPTURE",
                        "CONTINUE_APPLY",
                        "API_CONFIGURATION_ACTION",
                        "STOP_APPLY",
                        "PAY_ORDER",
                        "UNSUBSCRIBE",
                        "TO_PERIOD",
                        "TO_RENEW",
                        "ORDER_INFO",
                        "CLONE"
                      ],
                      "current_action": null
                    }
                  }
                ],
                "total_count": 1
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "examples": {
              "application/json": {
                "error_code": "DRS.10000001",
                "error_msg": "Failed."
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            }
          }
        },
        "x-order": 1
      }
    }
  },
  "definitions": {
    "QueryJobsResp": {
      "description": "查询任务列表响应体。",
      "allOf": [
        {
          "$ref": "#/definitions/BaseResp"
        },
        {
          "required": [
            "jobs"
          ],
          "type": "object",
          "properties": {
            "jobs": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/JobListResp"
              },
              "description": "任务信息列表。"
            }
          }
        }
      ]
    },
    "JobActions": {
      "properties": {
        "available_actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "任务可操作命令集合。\n- CREATE:创建任务\n- CHOOSE_OBJECT:选择对象,任务增量中再编辑\n- PRE_CHECK:预检查\n- CHANGE_MODE:修改任务模式\n- FREE_RESOURCE:释放资源\n- MODIFY_DB_CONFIG:修改数据库配置\n- RESET_DB_PWD:重置数据库密码(源库、目标库)\n- MODIFY_CONFIGURATION:修改任务配置\n- PAUSE:暂停任务\n- START:启动任务\n- CHANGE:修改任务\n- RETRY:重试任务\n- RESET:重置任务\n- DELETE:删除任务\n- QUERY_PRE_CHECK:预检查\n- SWITCH_OVER:容灾倒换\n- START_INCR:CASSANDRA启动增量任务\n- MODIFY_TASK_NUMBER:CASSANDRA修改线程数配置\n- CONTINUE_JOB:oracle-GaussDB分布式:启动失败或者停止的任务\n- STOP_JOB:oracle-GaussDB分布式:停止任务\n- CONTINUE_CAPTURE:启动抓取\n- STOP_CAPTURE:停止抓取\n- CONTINUE_APPLY:启动回放\n- STOP_APPLY:停止回放\n- PAY_ORDER:包年包月支付订单\n- UNSUBSCRIBE:包年包月退订\n- TO_PERIOD:转包周期\n- TO_RENEW:包周期续费\n- ORDER_INFO:订单详情\n- CHANGE_FLAVOR:规格变更\n- CLONE:克隆任务"
        },
        "unavailable_actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "任务可操作命令集合。\n- CREATE:创建任务\n- CHOOSE_OBJECT:选择对象,任务增量中再编辑\n- PRE_CHECK:预检查\n- CHANGE_MODE:修改任务模式\n- FREE_RESOURCE:释放资源\n- MODIFY_DB_CONFIG:修改数据库配置\n- RESET_DB_PWD:重置数据库密码(源库、目标库)\n- MODIFY_CONFIGURATION:修改任务配置\n- PAUSE:暂停任务\n- START:启动任务\n- CHANGE:修改任务\n- RETRY:重试任务\n- RESET:重置任务\n- DELETE:删除任务\n- QUERY_PRE_CHECK:预检查\n- SWITCH_OVER:容灾倒换\n- START_INCR:CASSANDRA启动增量任务\n- MODIFY_TASK_NUMBER:CASSANDRA修改线程数配置\n- CONTINUE_JOB:oracle-GaussDB分布式:启动失败或者停止的任务\n- STOP_JOB:oracle-GaussDB分布式:停止任务\n- CONTINUE_CAPTURE:启动抓取\n- STOP_CAPTURE:停止抓取\n- CONTINUE_APPLY:启动回放\n- STOP_APPLY:停止回放\n- PAY_ORDER:包年包月支付订单\n- UNSUBSCRIBE:包年包月退订\n- TO_PERIOD:转包周期\n- TO_RENEW:包周期续费\n- ORDER_INFO:订单详情\n- CHANGE_FLAVOR:规格变更\n- CLONE:克隆任务"
        },
        "current_action": {
          "type": "string",
          "description": "任务当前操作命令。取值:\n- API_CONFIGURATION_ACTION:OPEN API配置中的任务能调用。\n- CHANGE:修改任务。\n- CHANGE_MODE:修改任务模式。\n- CHOOSE_OBJECT:选择对象。\n- CLONE:克隆任务。\n- CONTINUE_APPLY:启动回放,Oracle同步到GaussDB分布式适用。\n- CONTINUE_CAPTURE:启动抓取,Oracle同步到GaussDB分布式适用。\n- CONTINUE_JOB:启动失败或者停止的任务,Oracle同步到GaussDB分布式适用。\n- CREATE:创建任务。\n- DELETE:删除任务。\n- FREE_RESOURCE:释放资源。\n- JUMP_RETRY:跳跃续传任务。\n- MODIFY_CONFIGURATION:修改任务配置。\n- MODIFY_DB_CONFIG:修改数据库配置。\n- MODIFY_TASK_NUMBER:修改线程数配置。\n- NODE_FLAVOR_MODIFY:规格变更。\n- ORDER_INFO:订单详情。\n- PAUSE:暂停任务。\n- PAY_ORDER:包年/包月支付订单。\n- PRE_CHECK:预检查。\n- QUERY_PRE_CHECK:查询预检查结果。\n- RESET:重置任务。\n- RESET_DB_PWD:重置数据库密码(源库、目标库)。\n- RETRY:重试任务。\n- START:启动任务。\n- START_INCR:启动增量任务。\n- STOP_APPLY:停止回放,Oracle同步到GaussDB分布式适用。\n- STOP_CAPTURE:停止抓取,Oracle同步到GaussDB分布式适用。\n- STOP_JOB:停止任务,Oracle同步到GaussDB分布式适用。\n- SWITCH_OVER:灾备倒换。\n- TO_PERIOD:转包年/包月任务。\n- TO_RENEW:包年/包月任务续费。\n- UNSUBSCRIBE:包年/包月任务退订。",
          "enum": [
            "API_CONFIGURATION_ACTION",
            "CHANGE",
            "CHANGE_MODE",
            "CHOOSE_OBJECT",
            "CLONE",
            "CONTINUE_APPLY",
            "CONTINUE_CAPTURE",
            "CONTINUE_JOB",
            "CREATE",
            "DELETE",
            "FREE_RESOURCE",
            "JUMP_RETRY",
            "MODIFY_CONFIGURATION",
            "MODIFY_DB_CONFIG",
            "MODIFY_TASK_NUMBER",
            "NODE_FLAVOR_MODIFY",
            "ORDER_INFO",
            "PAUSE",
            "PAY_ORDER",
            "PRE_CHECK",
            "QUERY_PRE_CHECK",
            "RESET",
            "RESET_DB_PWD",
            "RETRY",
            "START",
            "START_INCR",
            "STOP_APPLY",
            "STOP_CAPTURE",
            "STOP_JOB",
            "SWITCH_OVER",
            "TO_PERIOD",
            "TO_RENEW",
            "UNSUBSCRIBE"
          ]
        }
      },
      "description": "任务操作命令集合。",
      "required": [
        "available_actions",
        "unavailable_actions",
        "current_action"
      ],
      "type": "object"
    },
    "ErrorResp": {
      "description": "请求失败时返回的错误对象响应体。",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 12,
          "maxLength": 12,
          "example": "DRS.00000000"
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "example": "Success"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object"
    },
    "ChildrenJobListResp": {
      "description": "子任务列表响应体。",
      "properties": {
        "id": {
          "type": "string",
          "description": "任务ID。"
        },
        "name": {
          "type": "string",
          "description": "任务名称。"
        },
        "status": {
          "type": "string",
          "description": "任务状态。取值:\n- CREATING:创建中。\n- CREATE_FAILED:创建失败。\n- CONFIGURATION:配置中。\n- STARTJOBING:启动中。\n- WAITING_FOR_START:等待启动中。\n- START_JOB_FAILED:任务启动失败。\n- FULL_TRANSFER_STARTED:全量迁移中,灾备场景为初始化。\n- FULL_TRANSFER_FAILED:全量迁移失败,灾备场景为初始化失败。\n- FULL_TRANSFER_COMPLETE:全量迁移完成,灾备场景为初始化完成。\n- INCRE_TRANSFER_STARTED:增量迁移中,灾备场景为灾备中。\n- INCRE_TRANSFER_FAILED:增量迁移失败,灾备场景为灾备异常。\n- RELEASE_RESOURCE_STARTED:结束任务中。\n- RELEASE_RESOURCE_FAILED:结束任务失败。\n- RELEASE_RESOURCE_COMPLETE:已结束。\n- CHANGE_JOB_STARTED:任务变更中。\n- CHANGE_JOB_FAILED:任务变更失败。\n- CHILD_TRANSFER_STARTING:子任务启动中。\n- CHILD_TRANSFER_STARTED:子任务迁移中。\n- CHILD_TRANSFER_COMPLETE:子任务迁移完成。\n- CHILD_TRANSFER_FAILED:子任务迁移失败。\n- RELEASE_CHILD_TRANSFER_STARTED:子任务结束中。\n- RELEASE_CHILD_TRANSFER_COMPLETE:子任务已结束。",
          "enum": [
            "CREATING",
            "CREATE_FAILED",
            "CONFIGURATION",
            "STARTJOBING",
            "WAITING_FOR_START",
            "START_JOB_FAILED",
            "FULL_TRANSFER_STARTED",
            "FULL_TRANSFER_FAILED",
            "FULL_TRANSFER_COMPLETE",
            "INCRE_TRANSFER_STARTED",
            "INCRE_TRANSFER_FAILED",
            "RELEASE_RESOURCE_STARTED",
            "RELEASE_RESOURCE_FAILED",
            "RELEASE_RESOURCE_COMPLETE",
            "CHANGE_JOB_STARTED",
            "CHANGE_JOB_FAILED",
            "CHILD_TRANSFER_STARTING",
            "CHILD_TRANSFER_STARTED",
            "CHILD_TRANSFER_COMPLETE",
            "CHILD_TRANSFER_FAILED",
            "RELEASE_CHILD_TRANSFER_STARTED",
            "RELEASE_CHILD_TRANSFER_COMPLETE"
          ]
        },
        "description": {
          "type": "string",
          "description": "任务描述。"
        },
        "create_time": {
          "type": "string",
          "description": "任务创建时间。"
        },
