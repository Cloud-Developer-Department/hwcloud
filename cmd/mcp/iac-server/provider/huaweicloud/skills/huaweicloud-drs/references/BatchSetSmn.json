        "summary": "批量配置异常通知",
        "description": "批量设置异常通知,已结束的任务不支持设置。\n- 支持选择已有的SMN主题和手动输入手机号、邮箱两种方式,具体根据自己使用情况选择",
        "operationId": "BatchSetSmn",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一Region下的Project ID。"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "从IAM服务获取的用户Token。",
            "type": "string"
          },
          {
            "name": "batchImportSmnInfoReq",
            "in": "body",
            "required": true,
            "description": "录入、修改收件方式与信息请求体",
            "schema": {
              "$ref": "#/definitions/BatchImportSmnInfoReq"
            }
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型",
            "type": "string",
            "default": "en-us",
            "enum": [
              "en-us",
              "zh-cn"
            ]
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "Content-Type,指定类型为application/json。",
            "type": "string",
            "default": "application/json"
          }
