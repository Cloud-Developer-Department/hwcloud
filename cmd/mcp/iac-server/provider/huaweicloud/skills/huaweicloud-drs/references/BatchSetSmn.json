  "definitions": {
    "SubscriptionInfo": {
      "properties": {
        "endpoints": {
          "type": "array",
          "example": [
            "string"
          ],
          "description": "短信或者邮件列表",
          "items": {
            "type": "string"
          }
        },
        "protocol": {
          "type": "string",
          "example": "sms",
          "description": "收件方式,sms:短信,email:邮件",
          "enum": [
            "sms",
            "email"
          ]
        }
      },
      "description": "收件方式与信息体"
    },
    "SelectedSetAlarmTaskReq": {
      "description": "需要设置SMN的任务信息。",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID"
        },
        "status": {
          "type": "string",
          "description": "任务状态\nCREATING:创建中 - CREATE_FAILED:创建失败 - CONFIGURATION:配置中 - STARTJOBING:启动中 - WAITING_FOR_START:等待启动中 - START_JOB_FAILED:启动失败 - PAUSING:已暂停 - FULL_TRANSFER_STARTED:全量开始,灾备场景下为初始化 - FULL_TRANSFER_FAILED:全量失败,灾备场景下为初始化失败 - FULL_TRANSFER_COMPLETE:全量完成,灾备场景下为初始化完成 - INCRE_TRANSFER_STARTED:增量开始,灾备场景下为灾备中 - INCRE_TRANSFER_FAILED:增量失败,灾备场景下为灾备异常 - RELEASE_RESOURCE_STARTED:结束任务中 - RELEASE_RESOURCE_FAILED:结束任务失败 - RELEASE_RESOURCE_COMPLETE:已结束 - REBUILD_NODE_STARTED:故障恢复中 - REBUILD_NODE_FAILED:故障恢复失败 - CHANGE_JOB_STARTED:任务变更中 - CHANGE_JOB_FAILED:任务变更失败 - DELETED:已删除 - CHILD_TRANSFER_STARTING:再编辑子任务启动中 - CHILD_TRANSFER_STARTED:再编辑子任务迁移中 - CHILD_TRANSFER_COMPLETE:再编辑子任务迁移完成 - CHILD_TRANSFER_FAILED:再编辑子任务迁移失败 - RELEASE_CHILD_TRANSFER_STARTED:再编辑子任务结束中 - RELEASE_CHILD_TRANSFER_COMPLETE:再编辑子任务已结束 - NODE_UPGRADE_START:升级开始 - NODE_UPGRADE_COMPLETE:升级完成 - NODE_UPGRADE_FAILED:升级失败"
        },
        "engine_type": {
          "type": "string",
          "description": "引擎类型"
        }
      },
      "required": [
        "job_id",
        "status",
        "engine_type"
      ],
      "type": "object"
    },
    "BatchImportSmnInfoReq": {
      "description": "录入、修改收件方式与信息请求体。",
      "properties": {
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SelectedSetAlarmTaskReq"
          },
          "description": "任务信息"
        },
        "alarm_notify_info": {
          "description": "收件方式与信息",
          "$ref": "#/definitions/BatchSetAlarmNotifyInfo"
        }
      },
      "required": [
        "jobs",
        "alarm_notify_info"
      ]
    },
    "BatchSetAlarmNotifyInfo": {
      "description": "修改收件方式与信息体",
      "properties": {
        "subscriptions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SubscriptionInfo"
          },
          "description": "手动输入手机号、邮箱模式时填写"
        },
        "topic_urn": {
          "type": "string",
          "description": "主题资源标识"
        },
        "delay_time": {
          "type": "integer",
          "format": "int64",
          "description": "订阅延迟时间"
        },
        "rto_delay": {
          "type": "integer",
          "format": "int64",
          "description": "rto延迟时间"
        },
        "rpo_delay": {
          "type": "integer",
          "format": "int64",
          "description": "rpo延迟时间"
        },
        "alarm_to_user": {
          "type": "boolean",
          "description": "异常告警是否通知用户,不填默认为false"
        }
      }
    },
    "ImportSmnResp": {
      "description": "录入SMN返回体",
      "properties": {
        "id": {
          "type": "string",
          "description": "任务ID"
        },
        "status": {
          "type": "string",
          "description": "状态\n取值:success,failed"
        },
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "type": "object"
    },
    "BatchImportSmnResp": {
      "description": "批量录入收件方式返回体",
      "properties": {
        "results": {
          "items": {
            "$ref": "#/definitions/ImportSmnResp"
          },
          "type": "array"
        },
        "count": {
          "type": "integer",
          "format": "int32"
        }
      }
    }
  },
