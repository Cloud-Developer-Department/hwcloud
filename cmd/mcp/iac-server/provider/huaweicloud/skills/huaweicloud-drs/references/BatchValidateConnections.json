  "definitions": {
    "BatchTestConnectionReq": {
      "properties": {
        "jobs": {
          "type": "array",
          "description": "批量测试连接请求列表。",
          "items": {
            "description": "测试连接请求体",
            "$ref": "#/definitions/TestEndPoint"
          }
        }
      },
      "description": "批量测试连接任务请求体",
      "required": [
        "jobs"
      ]
    },
    "TestEndPoint": {
      "properties": {
        "id": {
          "type": "string",
          "description": "任务ID"
        },
        "net_type": {
          "type": "string",
          "description": "网络类型",
          "enum": [
            "vpn",
            "vpc",
            "eip"
          ]
        },
        "db_type": {
          "type": "string",
          "description": "数据库类型",
          "enum": [
            "mysql",
            "mongodb",
            "gaussdbv5",
            "postgresql",
            "kafka",
            "gaussdbv5ha",
            "taurus"
          ]
        },
        "ip": {
          "type": "string",
          "description": "数据库IP"
        },
        "db_port": {
          "type": "integer",
          "format": "int32",
          "description": "数据库端口,Mongo、DDS必填为0。"
        },
        "inst_id": {
          "type": "string",
          "description": "RDS实例id,RDS实例必填。"
        },
        "db_user": {
          "type": "string",
          "description": "数据库帐号。"
        },
        "db_password": {
          "type": "string",
          "description": "数据库密码。"
        },
        "ssl_link": {
          "type": "boolean",
          "description": "是否SSL安全连接。"
        },
        "ssl_cert_key": {
          "type": "string",
          "description": "SSL证书内容,base64加密后的值,源库安全连接必选。"
        },
        "ssl_cert_name": {
          "type": "string",
          "description": "SSL证书名字,源库安全连接必选。"
        },
        "ssl_cert_check_sum": {
          "type": "string",
          "description": "SSL证书内容checksum值,证书经过sha256加密后的值,后端校验,源库安全连接必选。"
        },
        "ssl_cert_password": {
          "type": "string",
          "description": "SSL证书密码,证书文件后缀为.p12,需要密码。"
        },
        "vpc_id": {
          "type": "string",
          "description": "vpcid,数据库为RDS时必选。"
        },
        "subnet_id": {
          "type": "string",
          "description": "subnetid,数据库为RDS必选。"
        },
        "end_point_type": {
          "type": "string",
          "example": "so",
          "description": "源库:so,目标库:ta",
          "enum": [
            "so",
            "ta"
          ]
        },
        "region": {
          "type": "string",
          "description": "rds实例region,数据库为RDS时必填。"
        },
        "project_id": {
          "type": "string",
          "description": "用户所处region的projectId。"
        },
        "db_name": {
          "type": "string",
          "description": "数据库用户名,DDS的账号认证数据库,Oracle的serviceName。"
        },
        "kafka_security_config": {
          "description": "Kafka安全认证相关,非安全认证不需要此参数。",
          "$ref": "#/definitions/KafkaSecurity"
        },
        "customized_dns": {
          "description": "客户自定义DNS服务。",
          "$ref": "#/definitions/CustomizedDns"
        }
      },
      "description": "测试连接信息体",
      "required": [
        "id",
        "net_type",
        "db_type",
        "ip",
        "db_user",
        "db_password",
        "end_point_type"
      ],
      "type": "object"
    },
    "CustomizedDns": {
      "type": "object",
      "description": "客户自定义DNS服务。",
      "required": [
        "is_set_dns",
        "set_dns_action",
        "dns_ip"
      ],
      "properties": {
        "is_set_dns": {
          "type": "boolean",
          "description": "是否设置客户自定义DNS。"
        },
        "set_dns_action": {
          "type": "string",
          "description": "设置客户自定义DNS的行为。\n- add:新增客户自定义DNS IP。\n- keep:保持客户自定义DNS IP。\n- update:更新客户自定义DNS IP(当DNS IP变化时更新生效)。\n- recover:还原系统默认DNS IP(还原时可能会导致域名解析失败,请谨慎操作)。",
          "enum": [
            "add",
            "keep",
            "update",
            "recover"
          ]
        },
        "dns_ip": {
          "type": "string",
          "description": "设置客户自定义DNS IP。",
          "minLength": 0,
          "maxLength": 15
        }
      }
    },
    "CheckJobResp": {
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "任务id。"
        },
        "status": {
          "type": "string",
          "description": "测试结果。\n- true:成功\n- false:失败",
          "enum": [
            "true",
            "false"
          ]
        },
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息。"
        },
        "success": {
          "type": "boolean",
          "description": "是否成功"
        }
      },
      "description": "响应体",
      "type": "object"
    },
    "BatchTestConnectionJobResp": {
      "required": [
        "count",
        "results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "description": "批量测试连接响应体集合。",
          "items": {
            "description": "测试连接响应体",
            "$ref": "#/definitions/CheckJobResp"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "总记录数。"
        }
      },
      "description": "批量测试连接响应体"
    },
    "KafkaSecurity": {
      "description": "Kafka安全认证相关参数",
      "properties": {
        "type": {
          "type": "string",
          "description": "安全协议,安全认证时必填,对应Kafka字段:security.protocol。\n- PLAINTEXT:无安全认证方式,仅需输入IP和端口进行连接。\n- SASL_PLAINTEXT:使用SASL机制连接Kafka,需要设置SASL相关配置。\n- SSL:使用SSL加密方式连接Kafka,需要设置SSL相关配置。\n- SASL_SSL:使用SASL及SSL加密认证方式,需要设置SSL及SASL相关参数配置信息。",
          "enum": [
            "PLAINTEXT",
            "SASL_PLAINTEXT",
            "SASL_SSL",
            "SSL"
          ]
        },
        "trust_store_key_name": {
          "type": "string",
          "description": "证书名称,安全协议为SSL、SASL_SSL时必填。"
        },
        "trust_store_key": {
          "type": "string",
          "description": "安全证书base64转码后的值,安全协议为SSL、SASL_SSL时必填。"
        },
        "trust_store_password": {
          "type": "string",
          "description": "证书密码,证书设置了密码时必填。"
        },
        "endpoint_algorithm": {
          "type": "string",
          "description": "主机名端点识别算法,指定通过服务端证书验证服务端主机名的端点识别算法,不填表示禁用主机名验证。对应Kafka字段:ssl.endpoint.identification.algorithm。"
        },
        "sasl_mechanism": {
          "type": "string",
          "description": "SASL机制,用于客户端连接的SASL机制,对应Kafka字段:sasl.mechanism,支持以下四项,取值:\n- GSSAPI\n- PLAIN\n- SCRAM-SHA-256\n- SCRAM-SHA-512"
        },
        "delegation_tokens": {
          "type": "boolean",
          "description": "是否为委托令牌鉴权,安全协议为SASL_SSL和SASL_PLAINTEXT时,SASL机制选择“SCRAM-SHA-256”或者“SCRAM-SHA-512”时生效。"
        },
        "enable_key_store": {
          "type": "boolean",
          "description": "是否开启SSL双向认证。"
        },
        "key_store_key": {
          "type": "string",
          "description": "Keystore证书,开启SSL双向认证时需要。"
        },
        "key_store_key_name": {
          "type": "string",
          "description": "Keystore证书名称,开启SSL双向认证时需要。"
        },
        "key_store_password": {
          "type": "string",
          "description": "Keystore证书密码,证书设置了密码时需要。对应Kafka字段:ssl.keystore.password。"
        },
        "set_private_key_password": {
          "type": "boolean",
          "description": "是否设置Keystore私钥密码,默认为false。"
        },
