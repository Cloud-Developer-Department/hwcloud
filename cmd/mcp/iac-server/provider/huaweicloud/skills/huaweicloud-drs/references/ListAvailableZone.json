  "definitions": {
    "QueryAvailableNodeTypeReq": {
      "description": "查询可用的AZ请求",
      "required": [
        "engine_type",
        "db_use_type",
        "job_direction",
        "node_type"
      ],
      "properties": {
        "engine_type": {
          "type": "string",
          "example": "mysql",
          "description": "引擎类型"
        },
        "db_use_type": {
          "type": "string",
          "example": "sync",
          "description": "迁移场景\nmigration实时迁移,sync实时同步,dataGuard实时灾备,subscription实时订阅,replay流量回放",
          "enum": [
            "migration",
            "sync",
            "cloudDataGuard"
          ]
        },
        "job_direction": {
          "type": "string",
          "example": "up",
          "description": "迁移方向,up :入云 ,灾备场景时对应本云为备,down:出云,灾备场景时对应本云为主,non-dbs:自建",
          "enum": [
            "up",
            "down",
            "non-dbs"
          ]
        },
        "node_type": {
          "type": "string",
          "example": "medium",
          "description": "规格类型。\nmicro:极小,small:小,medium:中,high:高,xlarge:超高,2xlarge:极高"
        },
        "multi_write": {
          "type": "string",
          "description": "是否是双主灾备,不填默认为false"
        }
      },
      "type": "object"
    },
    "AzInfoResp": {
      "properties": {
        "code": {
          "type": "string",
          "description": "可用区标识代码"
        },
        "name": {
          "type": "string",
          "description": "可用区名称"
        },
        "status": {
          "type": "string",
          "description": "可用区状态,ENABLED:可用,DISABLED:不可用"
        }
      },
      "description": "可用区信息",
      "type": "object"
    },
    "QueryAvailableZoneResp": {
      "description": "查询可用区信息返回体",
      "properties": {
        "az_infos": {
          "items": {
            "$ref": "#/definitions/AzInfoResp"
          },
          "type": "array",
          "description": "可用区信息"
        }
      }
    }
  },
