{
  "name": "ShowReplayResults",
  "summary": "查询录制回放结果",
  "tags": "录制回放",
  "productshort": "DRS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v5/{project_id}/jobs/{job_id}/replay-results": {
      "get": {
        "x-request-examples-url-1": "https://{endpoint}/v5/5237e10fe9aa4ad5b16b6a5245248314/jobs/7b35723d-1525-410e-90c3-70f9ed3jb601/replay-results?type=shard_statistics&start_time=1700421943000&end_time=1700439961000",
        "x-request-examples-url-2": "https://{endpoint}/v5/5237e10fe9aa4ad5b16b6a5245248314/jobs/7b35723d-1525-410e-90c3-70f9ed3jb601/replay-results?type=slow_sql&start_time=1700421943&end_time=1700439961&offset=1&limit=10",
        "x-request-examples-url-3": "https://{endpoint}/v5/5237e10fe9aa4ad5b16b6a5245248314/jobs/7b35723d-1525-410e-90c3-70f9ed3jb601/replay-results?type=slow_sql_template&offset=1&limit=10",
        "x-request-examples-url-4": "https://{endpoint}/v5/5237e10fe9aa4ad5b16b6a5245248314/jobs/7b35723d-1525-410e-90c3-70f9ed3jb601/replay-results?type=error_sql&start_time=1700421943&end_time=1700439961&offset=1&limit=10",
        "x-request-examples-url-5": "https://{endpoint}/v5/5237e10fe9aa4ad5b16b6a5245248314/jobs/7b35723d-1525-410e-90c3-70f9ed3jb601/replay-results?type=error_sql_template&offset=1&limit=10",
        "x-request-examples-url-6": "https://{endpoint}/v5/5237e10fe9aa4ad5b16b6a5245248314/jobs/7b35723d-1525-410e-90c3-70f9ed3jb601/replay-results?type=replaying_sql",
        "x-request-examples-description-1": "查询指定时间范围内回放详情基于时间序统计信息",
        "x-request-examples-description-2": "分页查询指定时间范围内回放的慢SQL详情",
        "x-request-examples-description-3": "分页查询回放中慢SQL统计信息",
        "x-request-examples-description-4": "分页查询指定时间范围内异常SQL详情",
        "x-request-examples-description-5": "分页查询回放过程中异常SQL统计信息",
        "x-request-examples-description-6": "查询正在回放的SQL信息",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "录制回放"
        ],
        "summary": "查询录制回放结果",
        "description": "获取录制回放结果数据,包括:回放基于时间维度统计信息,异常SQL及统计结果、慢SQL及统计结果",
        "operationId": "ShowReplayResults",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一Region下的Project ID。 获取方法请参见[获取项目ID。](https://support.huaweicloud.com/api-drs/drs_api_0106.html)"
          },
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "任务ID。"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "发送的实体的MIME类型。推荐用户默认使用application/json,如果API是对象、镜像上传等接口,媒体类型可按照流类型的不同进行确定。",
            "type": "string",
            "default": "application/json"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "从IAM服务获取的用户Token。用户Token也就是调用IAM获取用户Token接口的响应值,请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。",
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型。",
            "type": "string",
            "default": "en-us",
            "enum": [
              "en-us",
              "zh-cn"
            ]
          },
          {
            "name": "type",
            "in": "query",
            "required": true,
            "description": "结果类型。取值:\n- shard_statistics:回放概览基于时间维度统计信息。\n- slow_sql:慢SQL详情。\n- error_sql: 回放异常SQL详情。\n- slow_sql_template:慢SQL统计信息。 \n- error_sql_template:异常SQL统计信息。\n- replaying_sql:正在回放SQL详情。\n- error_classification:回放异常SQL分类。",
            "type": "string",
            "enum": [
              "shard_statistics",
              "slow_sql",
              "error_sql",
              "slow_sql_template",
              "error_sql_template",
              "replaying_sql",
              "error_classification"
            ]
          },
          {
            "name": "start_time",
            "in": "query",
            "required": false,
            "description": "查询数据的起始时间,在type为shard_statistics、slow_sql、error_sql时必填",
            "type": "string"
          },
          {
            "name": "end_time",
            "in": "query",
            "required": false,
            "description": "查询数据的结束时间,在type为shard_statistics、slow_sql、error_sql时必填",
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "分页查询数据表当前超始偏移量, 在type为slow_sql、error_sql、slow_sql_template、error_sql_template必填",
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "分页查询数据表当前页数据总量,在type为slow_sql、error_sql、slow_sql_template、error_sql_template必填",
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "sort_key",
            "in": "query",
            "required": false,
            "description": "返回结果按该关键字排序(slow_sql_template支持count,maxLatency、avgLatency关键字,error_sql_template支持count关键字)",
            "type": "string"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "required": false,
            "description": "排序规则,取值如下:\n- asc:升序\n- desc:降序",
            "type": "string",
            "default": "desc",
            "enum": [
              "asc",
              "desc"
            ]
          },
          {
            "name": "target_name",
            "in": "query",
            "required": false,
            "description": "回放数据库名称,用于在一致性回放策略场景,过滤目标库与源库镜像库回放结果。参数非必须,不提供则默认查询所有数据,其取值如下:\n- target:查询目标库回放结果\n- target_mirror:查询源库镜像库回放结果",
            "type": "string",
            "enum": [
              "target",
              "target_mirror"
            ]
          },
          {
            "name": "is_sample",
            "in": "query",
            "required": false,
            "description": "是否查询样例true/false,type=slow_sql/error_sql时生效,值为true时只查询一条样例数据。",
            "type": "boolean"
          },
          {
            "name": "error_type",
            "in": "query",
            "required": false,
            "description": "错误分类,type=error_sql/error_sql_template时生效,根据错误分类过滤数据。",
            "type": "string"
          },
          {
            "name": "sql_template_md5",
            "in": "query",
            "required": false,
            "description": "sql模板md5,type=slow_sql/error_sql时生效,根据模板过滤对应的异常SQL和慢SQL,该值为本接口type=slow_sql_template/error_sql_template时的返回字段。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ReplayResultResp"
            },
            "examples": {
              "application/json": {
                "total_count": 2,
                "shard_statics": null,
                "slow_sqls": null,
                "slow_sql_templates": null,
                "error_sqls": null,
                "error_sql_templates": null,
                "error_classifications": null,
                "replaying_sqls": [
                  {
                    "schema_name": "db",
                    "sql_statement": "select * from preple where id = 1",
                    "latency": 0,
                    "execute_latency": 0,
                    "status": "running",
                    "replay_start_time": "2024-04-23T12:07:53Z"
                  },
                  {
                    "schema_name": "db",
                    "sql_statement": "select * from preple where id = 1",
                    "latency": 0,
                    "execute_latency": 1,
                    "status": "running",
                    "replay_start_time": "2024-04-23T12:07:53Z"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "DRS.10020000",
                "error_msg": "Incorrect parameter type."
              }
            }
          }
        },
        "x-order": 1
      }
    }
  },
  "definitions": {
    "ReplayResultResp": {
      "type": "object",
      "description": "回放结果查询响应体,包含了提供的慢SQL详情、异常SQL详情、慢SQL统计信息、异常SQL统计信息、回放时间片信息、回放基于时间统计详细信息,针对不同的结果类型提供提供不同的数据响应",
      "properties": {
        "total_count": {
          "type": "integer",
          "format": "int64",
          "description": "数据总量"
        },
        "shard_statics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReplayShardStaticsResp"
          },
          "description": "回放基于时间统计详细信息列表,在type为shard_statistics时返回",
          "example": [
            {
              "time": "2023-11-20T03:25:43Z",
              "total": 1,
              "finish": 1,
              "abnormal": 0,
              "slow": 0
            }
          ]
        },
        "slow_sqls": {
          "type": "array",
          "description": "慢SQL信息列表,在type为slow_sql时返回",
          "example": [
            {
              "object_type": "DDL",
              "slow_sql": "logout!",
              "old_time": "1",
              "replay_time": "4"
            }
          ],
          "items": {
            "$ref": "#/definitions/ReplaySlowSqlResp"
          }
        },
        "slow_sql_templates": {
          "type": "array",
          "description": "慢SQL统计信息列表,在type为slow_sql_template时返回",
          "example": [
            {
              "sql_template": "logout!",
              "target_name": "null",
              "schema_name": "autotest_polardb_test",
              "query_type": "DDL",
              "min_latency": 2,
              "max_latency": 5,
              "avg_latency": 3,
              "total_latency": 16,
              "target_type": "taurus",
              "count": 5
            }
          ],
          "items": {
            "$ref": "#/definitions/ReplaySlowSqlTemplateResp"
          }
        },
        "error_sqls": {
          "type": "array",
          "description": "异常SQL信息列表,在type为error_sql时返回",
          "example": [
            {
              "object_type": "DDL",
              "abnormal_sql": "login success!",
              "abnormal_info": "java.sql.SQLSyntaxErrorException[(conn=434780) You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'l]"
            }
          ],
          "items": {
            "$ref": "#/definitions/ReplayErrorSqlResp"
          }
        },
        "error_sql_templates": {
          "type": "array",
          "description": "异常SQL统计信息列表,在type为error_sql_template时返回",
          "example": [
            {
              "sql_template": "SELECT ?",
              "target_name": "null",
              "schema_name": "incr_ddl_rename_db1",
              "query_type": "SELECT",
              "target_type": "taurus",
              "count": 1
            }
          ],
          "items": {
            "$ref": "#/definitions/ReplayErrorSqlTemplateResp"
          }
        },
        "replaying_sqls": {
          "type": "array",
          "description": "正在回放SQL信息列表,在type为replaying_sql时返回",
          "example": [
            {
              "schema_name": "testdb",
              "sql_statement": "select * from table1",
              "latency": 10,
              "execute_latency": 12,
              "status": "running",
              "client": "192.168.0.33",
              "connection_id": 1278414,
              "replay_start_time": "2024-03-14T16:23:39Z"
            }
          ],
          "items": {
            "$ref": "#/definitions/ReplayingSqlResp"
          }
        },
        "error_classifications": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReplayErrorClassification"
          },
          "description": "回放异常SQL分类信息,在type为error_classification时返回"
        }
      },
      "required": [
        "total_count"
      ]
    },
    "ReplaySlowSqlTemplateResp": {
      "type": "object",
      "description": "慢SQL统计信息数据项",
      "properties": {
        "sql_template": {
          "type": "string",
          "example": "set global sql_tracer=ON",
          "description": "SQL语句模板"
        },
        "sql_template_md5": {
          "type": "string",
          "description": "SQL语句模板MD5"
        },
        "target_name": {
          "type": "string",
          "example": "",
          "description": "目标库别名"
        },
        "schema_name": {
          "type": "string",
          "example": "",
          "description": "schema名称"
        },
        "query_type": {
          "type": "string",
          "example": "INSERT",
          "description": "SQL类型\n取值:SELECT, INSERT, DELETE, UPDATE, DDL"
        },
        "min_latency": {
          "type": "integer",
          "format": "int64",
          "example": 0,
          "description": "SQL执行最小耗时"
        },
        "max_latency": {
          "type": "integer",
          "format": "int64",
          "example": 0,
          "description": "SQL执行最大耗时"
        },
        "avg_latency": {
          "type": "integer",
          "format": "int64",
          "example": 0,
          "description": "SQL执行平均耗时"
        },
        "total_latency": {
          "type": "integer",
          "format": "int64",
          "example": 0,
          "description": "SQL执行总的耗时"
        },
        "target_type": {
          "type": "string",
          "example": "",
          "description": "目标库类型"
        },
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 0,
          "description": "SQL数量"
        }
      },
      "required": [
        "sql_template",
        "avg_latency",
        "count"
      ]
    },
    "ErrorResp": {
      "description": "请求失败时返回的错误对象响应体。",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 12,
          "maxLength": 12,
          "example": "DRS.00000000"
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "example": "Success"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object"
    },
    "ReplayErrorSqlResp": {
      "type": "object",
      "description": "回放异常SQL数据项",
      "properties": {
        "object_type": {
          "type": "string",
          "example": "DDL",
          "description": "SQL类型"
        },
        "abnormal_sql": {
          "type": "string",
          "example": "",
          "description": "SQL语句"
        },
        "abnormal_info": {
          "type": "string",
          "example": "",
          "description": "异常原因描述"
        }
      }
    },
    "ReplayShardStaticsResp": {
      "type": "object",
      "description": "回放概览信息基于进间点的统计结果",
      "properties": {
        "time": {
          "type": "string",
          "example": "2023-11-20T03:25:43Z",
          "description": "回放时间点"
        },
        "total": {
          "type": "integer",
          "format": "int64",
          "example": 0,
          "description": "SQL总量"
        },
        "finish": {
          "type": "integer",
          "format": "int64",
          "example": 0,
          "description": "SQL执行量"
        },
        "abnormal": {
          "type": "integer",
          "format": "int64",
          "example": 0,
          "description": "SQL异常量"
        },
        "slow": {
          "type": "integer",
          "format": "int64",
          "example": 0,
          "description": "慢SQL数量"
        }
      },
      "required": [
        "time",
        "total",
        "finish",
        "abnormal",
        "slow"
      ]
    },
    "ReplayErrorClassification": {
      "type": "object",
      "description": "回放异常SQL分类数据项",
      "required": [
        "error_type"
      ],
      "properties": {
        "target_name": {
          "type": "string",
          "description": "目标库标识"
        },
        "error_type": {
          "type": "string",
          "description": "异常SQL分类"
        },
        "error_cnt": {
          "type": "string",
          "description": "异常SQL数量"
        },
        "error_template_cnt": {
          "type": "string",
          "description": "异常SQL模板数量"
        }
      }
    },
    "ReplayErrorSqlTemplateResp": {
      "type": "object",
      "description": "回放异常SQL数据项",
      "properties": {
        "sql_template": {
          "type": "string",
          "example": "set global sql_tracer=ON",
          "description": "SQL模板"
        },
        "sql_template_md5": {
          "type": "string",
          "description": "SQL模板MD5"
        },
        "target_name": {
          "type": "string",
          "example": null,
          "description": "目标库昵称"
        },
        "schema_name": {
          "type": "string",
          "example": "",
          "description": "schema名称"
        },
        "query_type": {
          "type": "string",
          "example": "DDL",
          "description": "SQL类型\n取值:SELECT, INSERT, DELETE, UPDATE, DDL"
        },
        "target_type": {
          "type": "string",
          "example": "taurus",
          "description": "目标库类型\n取值:mysql,taurusha,sqlserver,postgresql,ddm,mongodb,awsdocumentdb,hwmongodb,hwpostgresql,oracle,taurus,gaussdb,kafka,mrsKafka,cassandra,dynamo,dws,gaussdbv5,gaussdbv5ha,gaussmongodb,multigaussdbv5,dmq,gaussdbt,gaussdbtha,gaussdb300,elasticsearch,db2,tidb,redis,gaussredis,rediscluster,mariadb,oceanbase,informix,gaussdbv1,gausscassandra,geminidynamo,dds,tauruslite"
        },
        "count": {
          "type": "integer",
          "format": "int64",
          "example": 1,
          "description": "归类的SQL数量"
        }
      }
    },
    "ReplayingSqlResp": {
      "type": "object",
      "description": "正在回放的SQL信息",
      "properties": {
        "schema_name": {
          "type": "string",
          "example": "",
          "description": "库名或shema名称"
        },
        "sql_statement": {
          "type": "string",
          "example": "",
          "description": "SQL语句"
        },
        "latency": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "原始执行耗时"
        },
        "execute_latency": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "回放执行耗时"
        },
        "status": {
          "type": "string",
          "example": "",
          "description": "执行状态\n取值:INIT,RUNNING,FAILED,PAUSE,SUCCESS,FINISHED"
        },
        "client": {
          "type": "string",
          "description": "客户端IP"
        },
        "connection_id": {
          "type": "string",
          "description": "连接ID"
        },
        "replay_start_time": {
          "type": "string",
          "description": "回放开始时间"
        }
      }
    },
    "ReplaySlowSqlResp": {
      "type": "object",
      "description": "回放慢SQL数据结果对象",
      "properties": {
        "object_type": {
          "type": "string",
          "example": "DDL",
          "description": "SQL语句类型\n取值:SELECT, INSERT, DELETE, UPDATE, DDL"
        },
        "slow_sql": {
          "type": "string",
          "example": "",
          "description": "SQL语句"
        },
        "old_time": {
          "type": "string",
          "example": 0,
          "description": "源库执行耗时"
        },
        "replay_time": {
          "type": "string",
          "example": 0,
          "description": "目标库回放执行耗时"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "drs.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v5",
  "method": "get",
  "uri": null
}