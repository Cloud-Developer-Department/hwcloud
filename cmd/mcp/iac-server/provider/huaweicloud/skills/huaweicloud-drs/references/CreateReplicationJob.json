        "tags": [
          "备份迁移"
        ],
        "summary": "创建备份迁移任务",
        "description": "该接口主要用于三种常见场景下备份迁移任务的配置。\n备份迁移支持如下的常见场景:\n- 通过OBS桶备份文件进行全量数据迁移。\n- 通过OBS桶备份文件进行全量+增量数据迁移。\n- 通过RDS全量备份进行全量数据迁移。",
        "operationId": "CreateReplicationJob",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "租户在某一Region下的Project ID。 获取方法请参见[获取项目ID。](https://support.huaweicloud.com/api-drs/drs_api_0106.html)"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "发送的实体的MIME类型。推荐用户默认使用application/json,如果API是对象、镜像上传等接口,媒体类型可按照流类型的不同进行确定。",
            "type": "string",
            "minLength": 0,
            "maxLength": 128,
            "default": "application/json"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "从IAM服务获取的用户Token。 用户Token也就是调用获取用户Token接口的响应值,该接口是唯一不需要认证的接口。 请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。",
            "type": "string",
            "minLength": 0,
            "maxLength": 50000
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型。",
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          },
          {
            "name": "CreateReplicationJobRequestBody",
            "in": "body",
            "required": true,
            "description": "创建备份迁移任务请求体。",
            "schema": {
              "$ref": "#/definitions/CreateOfflineTaskReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/CreateOfflineTaskResp"
            },
            "examples": {
              "application/json": {
                "job_id": "0667845a-6291-4e2a-95b0-190c0abjb703"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "DRS.10000001",
                "error_msg": "Failed."
              }
            }
          }
        },
        "x-order": 0
      }
    }
  },
  "definitions": {
    "BackupRestoreOptionInfo": {
      "type": "object",
      "description": "备份迁移参数。",
      "required": [
        "is_last_backup",
        "is_precheck",
        "recovery_mode"
      ],
      "properties": {
        "is_cover": {
          "type": "boolean",
          "description": "是否覆盖目标数据库,不填默认为false。\n\t值为“true”表示覆盖。\n\t值为“false”表示不覆盖。",
          "enum": [
            true,
            false
          ]
        },
        "is_default_restore": {
          "type": "boolean",
          "description": "是否默认恢复,默认恢复所有数据库。\n\t“true”是代表默认恢复还原备份文件中的全部数据库。\n\t“false”代表需要在db_names这个字段中指定需要恢复的数据库名。",
          "enum": [
            true,
            false
          ]
        },
        "is_last_backup": {
          "type": "boolean",
          "description": "一次典型的增量恢复过程,会涉及多次恢复增量备份。每个增量备份恢复均会使目标数据库保持还原中状态,此时数据库不可读写,直至最后一个增量备份恢复完成后,数据库才能变成可用状态。此后数据库将无法继续进行增量恢复,所以确定为最后一个备份的场景有:\n\t一次性全量迁移,后续将不再进行增量恢复时,设置该字段值为“true”。\n\t增量恢复流程中,确定为最后割接阶段的最后一个增量备份时,设置该字段值为“false”。",
          "enum": [
            true,
            false
          ]
        },
        "is_precheck": {
          "type": "boolean",
          "description": "是否执行预校验。\ntrue:执行。\nfalse:不执行。",
          "enum": [
            true,
            false
          ]
        },
        "recovery_mode": {
          "type": "string",
          "description": "恢复模式:\n\t“full”表示全量迁移。\n\t“incre”表示增量迁移 。",
          "minLength": 0,
          "maxLength": 128,
          "enum": [
            "full",
            "incre"
          ]
        },
        "db_names": {
          "type": "array",
          "description": "数据库名称。",
          "minItems": 0,
          "maxItems": 512,
          "items": {
            "minLength": 0,
            "maxLength": 128,
            "type": "string"
          }
        },
        "reset_db_name_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 256
          },
          "description": "该字段为一个map,目前使用格式key是\"\",value是新数据库名字。\n该功能将忽略备份文件中原有的数据库名,通过DRS将其恢复为指定的新数据库名。\n使用条件:\n- 备份文件中只有一个数据库。\n- 备份文件是全量备份类型(待恢复备份类型选择:全量备份),且是一次性恢复(最后一个备份选择:是)。"
        },
        "is_delete_backup_file": {
          "type": "boolean",
          "description": "该参数控制使用OBS桶中备份文件恢复时,当任务结束时是否删除下载到RDS for SQL server磁盘中的OBS备份文件,默认删除。\n- true 删除\n- false 不删除"
        }
      }
    },
    "ErrorResp": {
      "description": "请求失败时返回的错误对象响应体。",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 12,
          "maxLength": 12,
          "example": "DRS.00000000"
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "example": "Success"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object"
    },
    "BackupInfo": {
      "type": "object",
      "description": "备份文件信息。",
      "required": [
        "file_source",
        "files"
      ],
      "properties": {
        "file_source": {
          "type": "string",
          "description": "备份文件来源:(全部大写)\n-\tOBS:存放在OBS中的备份文件。\n-\tRDS:RDS实例的备份文件。",
          "enum": [
            "OBS",
            "RDS"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "bucket_name": {
          "type": "string",
          "description": "OBS桶名称,使用OBS桶备份文件恢复时必填。\n约束:长度范围为3~63个字符,仅支持小写字母、数字、中划线(-)、点(.),且只能以字母或数字开头和结尾,禁止使用IP地址。\n如果选择从OBS桶获取备份文件必填,参考登录[客户端登录](https://support.huaweicloud.com/clientogw-obs/zh-cn_topic_0045829058.html)OBS Browser客户端,首页为OBS桶列表,可以获取到备份文件所在桶的名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BackupFileInfo"
          },
          "description": "备份文件信息列表。",
          "minItems": 0,
          "maxItems": 256
        }
      }
    },
    "BackupFileInfo": {
      "type": "object",
      "description": "备份文件信息。",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "备份文件名称。",
          "minLength": 0,
          "maxLength": 512
        },
        "obs_path": {
          "type": "string",
          "description": "OBS桶中文件路径。\n\tOBS场景:必选\n\tRDS场景:缺省",
          "minLength": 0,
          "maxLength": 512
        },
        "rds_version": {
          "type": "string",
          "description": "bak文件数据库版本。\n\tOBS场景:缺省\n\tRDS场景:必选",
          "minLength": 0,
          "maxLength": 512
        },
        "rds_source_instance_id": {
          "type": "string",
          "description": "bak文件所属实例。\n\tOBS场景:缺省\n\tRDS场景:必选",
          "minLength": 0,
          "maxLength": 512
        }
      }
    },
    "CreateOfflineTaskResp": {
      "type": "object",
      "description": "创建备份迁移返回体。",
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID。",
          "minLength": 1,
          "maxLength": 128
        }
      }
