      ]
    },
    "JobBaseInfo": {
      "properties": {
        "name": {
          "type": "string",
          "description": "任务名称。\n约束:任务名称在4位到50位之间,不区分大小写,可以包含字母、数字、中划线或下划线,不能包括其他特殊字符。\n- 最小长度:4\n- 最大长度:50",
          "example": "DRS-0001",
          "minLength": 4,
          "maxLength": 50
        },
        "job_type": {
          "type": "string",
          "description": "任务场景。取值:\n- migration:实时迁移。\n- sync:实时同步。\n- cloudDataGuard:实时灾备。",
          "enum": [
            "migration",
            "sync",
            "cloudDataGuard"
          ]
        },
        "multi_write": {
          "type": "boolean",
          "description": "灾备类型是否双主灾备。说明:\n- job_type 是cloudDataGuard时,必填,灾备类型是双主灾备时,multi_write取值true, 否则为false。\n- job_type 是其他类型时,multi_write是非必选参数。",
          "example": ""
        },
        "engine_type": {
          "type": "string",
          "description": "引擎类型。取值:\n- oracle-to-gaussdbv5:Oracle同步到GaussDB分布式版,实时同步场景使用。\n- redis-to-gaussredis:Redis同步到GeminiDB Redis,实时迁移场景使用。\n- rediscluster-to-gaussredis:Redis集群同步到GeminiDB Redis,实时迁移场景使用。\n- mysql-to-mysql:MySQL同步到MySQL,实时同步场景使用。",
          "enum": [
            "oracle-to-gaussdbv5",
            "redis-to-gaussredis",
            "rediscluster-to-gaussredis",
            "mysql-to-mysql"
          ]
        },
        "job_direction": {
          "type": "string",
          "description": "迁移方向。取值:\n- up:入云 ,灾备场景时对应本云为备。\n- down:出云,灾备场景时对应本云为主。\n- non-dbs:自建。",
          "enum": [
            "up",
            "down",
            "non-dbs"
          ]
        },
        "task_type": {
          "type": "string",
          "description": "迁移模式。取值:\n- FULL_TRANS :全量。\n- FULL_INCR_TRANS:全量+增量。\n- INCR_TRANS:增量。",
          "enum": [
            "FULL_TRANS",
            "FULL_INCR_TRANS",
            "INCR_TRANS"
          ]
        },
        "net_type": {
          "type": "string",
          "description": "网络类型。取值:\n- eip:公网网络。\n- vpc:VPC网络,灾备场景不支持选择VPC网络。\n- vpn:VPN、专线网络。",
          "example": "",
          "enum": [
            "eip",
            "vpc",
            "vpn"
          ]
        },
        "charging_mode": {
          "type": "string",
          "description": "计费模式,默认按需。取值:\n- period:包周期。\n- on_demand:按需。",
          "enum": [
            "period",
            "on_demand"
          ]
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。\n缺省值:\"0\",表示\"default\"企业项目。",
          "default": "0"
        },
        "description": {
          "type": "string",
          "description": "任务描述。\n约束:任务描述不能超过256位,且不能包含!<>&'\"\\特殊字符。",
          "minLength": 0,
          "maxLength": 256
        },
        "start_time": {
          "type": "string",
          "description": "任务定时启动时间。"
        },
        "expired_days": {
          "type": "string",
          "description": "任务处于异常状态一段时间后,将会自动结束。单位为天。(范围14-100),不传默认为14天。",
          "default": "14",
          "example": "14"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceTag"
          },
          "description": "标签信息,最多添加10个标签。",
          "example": [
            {
              "key": "1",
              "value": "a"
            },
            {
              "key": "2",
              "value": "b"
            }
          ]
        },
        "is_open_fast_clean": {
          "type": "boolean",
          "description": "是否开启云数据库RDS for MySQL/MariaDB的binlog快速清理。"
        }
      },
      "description": "创建任务基本信息体。",
      "type": "object"
    },
    "JobNodeVpcInfo": {
      "description": "任务实例VPC信息体。",
      "properties": {
        "vpc_id": {
          "type": "string",
          "description": "任务实例所在虚拟私有云ID。",
