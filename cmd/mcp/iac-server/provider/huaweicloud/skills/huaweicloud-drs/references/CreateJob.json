  "definitions": {
    "SingleCreateJobReq": {
      "description": "创建单个任务请求体。",
      "properties": {
        "job": {
          "description": "创建单个任务请求体。",
          "$ref": "#/definitions/CreateJobReq"
        }
      },
      "required": [
        "job"
      ],
      "type": "object"
    },
    "PublicIpConfig": {
      "type": "object",
      "description": "租户公网IP信息",
      "properties": {
        "id": {
          "type": "string",
          "description": "指定公网IP的ID"
        },
        "public_ip": {
          "type": "string",
          "description": "指定公网IP"
        },
        "type": {
          "type": "string",
          "description": "指定公网IP绑定任务的类型:\n- 主备任务:主是master,备是slave\n- 其他固定为master",
          "enum": [
            "master",
            "slave"
          ]
        }
      },
      "required": [
        "id",
        "public_ip",
        "type"
      ]
    },
    "BaseEndpoint": {
      "description": "数据库基本信息体。",
      "properties": {
        "id": {
          "type": "string",
          "description": "数据库信息ID。"
        },
        "endpoint_name": {
          "type": "string",
          "description": "数据库场景类型。取值:\n- oracle:云下自建Oracle数据库。\n- ecs_oracle:华为云ECS自建Oracle数据库。\n- cloud_gaussdbv5:华为云数据库GaussDB分布式。\n- mysql:他云/本地自建MySQL数据库。\n- ecs_mysql:华为云ECS自建MySQL数据库。\n- cloud_mysql:华为云数据库RDS for MySQL。\n- redis:云下自建Redis数据。\n- ecs_redis:华为云ECS自建Redis数据。\n- rediscluster:云下自建Redis集群数据库。\n- ecs_rediscluster:华为云ECS自建Redis集群数据库。\n- cloud_gaussdb_redis:华为云数据库GeminiDB Redis。\n- postgresql: 云下自建PostgreSQL数据库。\n- ecs_postgresql: 华为云ECS自建PostgreSQL数据库。\n- cloud_postgresql: 华为云数据库RDS for PostgreSQL。\n- mongodb: 云下自建MongoDB数据库。\n- ecs_mongodb: 华为云ECS自建MongoDB数据库。\n- cloud_mongodb: 华为云文档数据库服务DDS。",
          "enum": [
            "oracle",
            "ecs_oracle",
            "cloud_gaussdbv5",
            "mysql",
            "ecs_mysql",
            "cloud_mysql",
            "redis",
            "ecs_redis",
            "rediscluster",
            "ecs_rediscluster",
            "cloud_gaussdb_redis",
            "postgresql",
            "ecs_postgresql",
            "cloud_postgresql",
            "mongodb",
            "ecs_mongodb",
            "cloud_mongodb"
          ]
        },
        "ip": {
          "type": "string",
          "description": "数据库IP。\n约束:\n- 数据库为自建MongoDB时,数据库IP与端口之间用“:”英文冒号拼接,多个值之间请用“,”英文逗号隔开,最多支持填写3个IP地址或域名。\n- 数据库为DDS实例时,数据库IP与端口之间用“:”英文冒号拼接,多个IP端口之间请用“,”英文逗号分隔。\n- 数据库为Redis集群时,请填写源端Redis集群所有分片的IP地址和对应端口,数据库IP与端口之间用“:”英文冒号拼接,多个IP端口之间请用“,”英文逗号分隔,并且推荐填写集群分片的Slave节点的IP地址。最多支持填写32个IP地址或域名,多个值之间请用英文逗号隔开。\n示例:\n- MySQL:ip\n- MongoDB:ip:port,ip:port,ip:port\n- DDS:ip:port,ip:port\n - Redis集群:ip:port,ip:port",
          "example": "MySQL:ip;MongoDB:ip:port,ip:port,ip:port;DDS:ip:port,ip:port;Redis集群:ip:port,ip:port;"
        },
        "db_port": {
          "type": "string",
          "description": "数据库端口。\n\n约束:输入范围为1-65535之间的整数。",
          "example": "3306"
        },
        "db_user": {
          "type": "string",
          "description": "数据库用户名。",
          "example": "root"
        },
        "db_password": {
          "type": "string",
          "description": "数据库密码。",
          "example": "******"
        },
        "instance_id": {
          "type": "string",
          "description": "华为云数据库实例ID。"
        },
        "instance_name": {
          "type": "string",
          "description": "华为云数据库实例名称。"
        },
        "db_name": {
          "type": "string",
          "description": "指定数据库名称。例如:\n- oracle:serviceName.orcl。"
        },
        "source_sharding": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BaseEndpoint"
          },
          "description": "物理源库信息。"
        }
      },
      "required": [
        "endpoint_name",
        "db_user",
        "db_password"
      ],
      "type": "object"
    },
    "CreateJobReq": {
      "description": "创建单个任务请求体。",
      "properties": {
        "base_info": {
          "$ref": "#/definitions/JobBaseInfo",
          "description": "创建任务基本信息体。"
        },
        "source_endpoint": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JobEndpointInfo"
          },
          "description": "创建任务数据库信息体。"
        },
        "target_endpoint": {
          "items": {
            "$ref": "#/definitions/JobEndpointInfo"
          },
          "description": "创建任务数据库信息体。",
          "type": "array"
        },
        "period_order": {
          "description": "包年/包月信息体。",
          "$ref": "#/definitions/PeriodOrderInfo"
        },
        "node_info": {
          "$ref": "#/definitions/JobNodeInfo",
          "description": "创建任务实例信息体。"
        },
        "public_ip_list": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PublicIpConfig"
          },
          "description": "指定公网IP的信息"
        }
      },
      "required": [
        "base_info",
        "source_endpoint",
        "target_endpoint",
        "node_info"
      ],
      "type": "object"
    },
    "ResourceTag": {
      "description": "标签信息体。",
      "properties": {
        "key": {
          "type": "string",
          "description": "标签键。\n约束:最大长度36,只能包含字母、数字、下划线、中划线和中文。",
          "maxLength": 36,
          "minLength": 1
        },
        "value": {
          "type": "string",
          "description": "标签值。标签的值可以包含任意语种字母、数字、空格和_ . : / = + - @。",
          "maxLength": 43,
          "minLength": 1
        }
      },
      "type": "object"
    },
    "JobNodeBaseInfo": {
      "description": "任务实例基本信息体。",
      "properties": {
        "instance_type": {
          "type": "string",
          "description": "实例类型。取值:\n- single:单机。\n- ha:主备。",
          "enum": [
            "single",
            "ha"
          ]
        },
        "arch": {
          "type": "string",
          "description": "CPU架构。取值:\n- x86\n- arm",
          "enum": [
            "x86",
            "arm"
          ]
        },
        "availability_zone": {
          "type": "string",
          "description": "可用区ID。\n约束:对于任务实例类型不是单机的实例,需要分别为实例所有节点指定可用区,并用“,”英文逗号隔开。示例:\n- 实例类型为single:\"cn-north-4a\"\n- 实例类型为ha:\"cn-north-4a,cn-north-4b\""
        },
        "status": {
          "type": "string",
          "description": "状态。\nCREATING:创建中,CREATE_FAILED:创建失败,CONFIGURATION:配置中,WAITING_FOR_START:等待启动中,RELEASE_RESOURCE_COMPLETE:已结束,DELETED:已删除,INCRE_TRANSFER_STARTED:增量迁移中,INCRE_TRANSFER_FAILED:增量迁移失败,FULL_TRANSFER_STARTED:全量迁移中,FULL_TRANSFER_COMPLETE:全量迁移完成,PAUSING:暂停中,FULL_TRANSFER_FAILED:全量迁移失败"
        },
        "role": {
          "type": "string",
          "description": "任务主备角色。"
        }
      },
      "required": [
        "instance_type",
        "arch",
        "availability_zone"
      ],
      "type": "object"
    },
    "JobEndpointInfo": {
      "properties": {
        "db_type": {
          "type": "string",
          "description": "数据库类型。取值: \n- oracle:Oracle。\n- gaussdbv5:GaussDB分布式版。\n- redis:Redis。\n- rediscluster:Redis集群版。\n- gaussredis: GeminiDB Redis。\n- mysql:MySQL。",
          "example": "oracle",
          "enum": [
            "oracle",
            "gaussdbv5",
            "redis",
            "rediscluster",
            "gaussredis",
            "mysql"
          ]
