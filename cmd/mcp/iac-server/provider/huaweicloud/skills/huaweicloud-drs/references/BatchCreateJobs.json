  "definitions": {
    "PublicIpConfig": {
      "type": "object",
      "description": "租户公网IP信息",
      "required": [
        "id",
        "public_ip",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "指定公网IP的ID"
        },
        "public_ip": {
          "type": "string",
          "description": "指定公网IP"
        },
        "type": {
          "type": "string",
          "description": "指定公网IP绑定任务的类型:\n- 主备任务:主是master,备是slave\n- 其他固定传master",
          "enum": [
            "master",
            "slave"
          ]
        }
      }
    },
    "CreateJobResp": {
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "example": "e11eaf8f-71ef-4fad-8890-aed7572ajb11",
          "description": "任务ID"
        },
        "name": {
          "type": "string",
          "example": "DRS-zltest1",
          "description": "任务名称"
        },
        "status": {
          "type": "string",
          "example": "CREATING",
          "description": "任务状态\nCREATING:创建中,CREATE_FAILED:创建失败,CONFIGURATION:配置中,WAITING_FOR_START:等待启动中,RELEASE_RESOURCE_COMPLETE:已结束,DELETED:已删除,INCRE_TRANSFER_STARTED:增量迁移中,INCRE_TRANSFER_FAILED:增量迁移失败,FULL_TRANSFER_STARTED:全量迁移中,FULL_TRANSFER_COMPLETE:全量迁移完成,PAUSING:暂停中,FULL_TRANSFER_FAILED:全量迁移失败"
        },
        "create_time": {
          "type": "string",
          "example": "1599188556112",
          "description": "创建时间,时间戳"
        },
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        },
        "child_ids": {
          "type": "array",
          "description": "子任务ID,有子任务时返回该字段。",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "创建任务响应体",
      "type": "object"
    },
    "CreateJobReq": {
      "properties": {
        "bind_eip": {
          "type": "boolean",
          "example": true,
          "description": "是否绑定eip,网络类型为eip时必填且为true"
        },
        "db_use_type": {
          "type": "string",
          "example": "migration",
          "description": "迁移场景,migration-实时迁移,sync-实时同步,cloudDataGuard-实时灾备",
          "enum": [
            "migration",
            "sync",
            "cloudDataGuard"
          ]
        },
        "name": {
          "type": "string",
          "example": "DRS-9228",
          "description": "任务名称,约束:任务名称在4位到50位之间,不区分大小写,可以包含字母、数字、中划线或下划线,不能包括其他特殊字符。",
          "minLength": 4,
          "maxLength": 50
        },
        "description": {
          "type": "string",
          "description": "任务描述。\n **约束**:任务描述不能超过256位,且不能包含!<>&'\"\\特殊字符。"
        },
        "engine_type": {
          "type": "string",
          "example": "mysql",
          "description": "引擎类型\n- mysql:MySQL到MySQL迁移,MySQL到MySQL同步\n- mongodb:MongoDB到DDS迁移\n- cloudDataGuard-mysql:MySQL到MySQL灾备\n- gaussdbv5:GaussDB同步\n- mysql-to-kafka:MySQL到Kafka同步\n- taurus-to-kafka:GaussDB(for MySQL)到Kafka同步\n- gaussdbv5ha-to-kafka:GaussDB主备版到Kafka同步\n- postgresql:PostgreSQL到PostgreSQL同步",
          "enum": [
            "mysql",
            "mongodb",
            "cloudDataGuard-mysql",
            "gaussdbv5",
            "postgresql",
            "mysql-to-kafka",
            "taurus-to-kafka",
            "gaussdbv5ha-to-kafka"
          ]
        },
        "is_target_readonly": {
          "type": "boolean",
          "description": "指定目标实例是否限制为只读,MySQL迁移和灾备,且job_direction为up时设置有效。(灾备场景下,单主灾备且本云为备为必填且为true,不填默认设置为true)。"
        },
        "job_direction": {
          "type": "string",
          "example": "up",
          "description": "迁移方向,up :入云 ,灾备场景时对应本云为备,down:出云,灾备场景时对应本云为主,non-dbs:自建",
          "enum": [
            "up",
            "down",
            "non-dbs"
          ]
        },
        "multi_write": {
          "type": "boolean",
          "example": false,
          "description": "- db_use_type 是cloudDataGuard时,必填,灾备类型是双主灾备时 muti_write取值true, 否则为false。\n- db_use_type 是其他类型时,muti_write是非必选参数",
          "default": false
        },
        "net_type": {
          "type": "string",
          "example": "eip",
          "description": "网络类型",
          "enum": [
            "vpn",
            "vpc",
            "eip"
          ]
        },
        "node_num": {
          "type": "integer",
          "format": "int32",
          "description": "节点个数。MongoDB数据库时对应源端分片个数,源库为集群时必填,[1-32],MySQL双主灾备时会默认设置为2。",
          "minimum": 1,
          "maximum": 32
        },
        "node_type": {
          "type": "string",
          "example": "high",
          "description": "规格类型。取值:\n- micro:极小规格。\n- small:小规格。\n- medium:中规格。\n- high:大规格。\n- xlarge:超大规格。\n- 2xlarge:极大规格。\n具体某种场景支持的取值可以通过[查询可用的Node规格接口](https://support.huaweicloud.com/api-drs/drs_03_0239.html)获取。",
          "enum": [
            "micro",
            "small",
            "medium",
            "high",
            "xlarge",
            "2xlarge"
          ],
          "default": "high"
        },
        "source_endpoint": {
          "description": "源库信息",
          "$ref": "#/definitions/Endpoint"
        },
        "target_endpoint": {
          "description": "目标库信息",
          "$ref": "#/definitions/Endpoint"
        },
        "tags": {
          "type": "array",
          "description": "标签信息。",
          "items": {
            "$ref": "#/definitions/ResourceTag"
          }
        },
        "task_type": {
          "type": "string",
          "example": "FULL_INCR_TRANS",
          "description": "迁移模式,FULL_TRANS 全量,FULL_INCR_TRANS 全量+增量,INCR_TRANS 增量,灾备场景单主灾备仅支持全量加增量(FULL_INCR_TRANS)",
          "enum": [
            "FULL_TRANS",
            "FULL_INCR_TRANS",
            "INCR_TRANS"
          ]
        },
        "customize_sutnet_id": {
          "type": "string",
          "example": "352ad828-3467-4f03-987a-c55a5a9dd417",
          "description": "DRS实例所在子网ID,对应目标库相同VPC下已创建的子网(subnet)的网络ID,UUID格式。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "product_id": {
          "type": "string",
          "description": "产品id。"
        },
        "sys_tags": {
          "type": "array",
          "description": "企业项目,不填默认为default,key值必须为_sys_enterprise_project_id,value为企业项目ID,只能填一个企业项目。",
          "items": {
            "$ref": "#/definitions/ResourceTag"
          }
        },
        "expired_days": {
          "type": "string",
          "example": "14",
          "description": "任务处于异常状态一段时间后,将会自动结束,单位为天。(范围14-100),不传默认为14天。"
        },
        "master_az": {
          "type": "string",
          "description": "主备任务主任务所在可用区code,可以通过查询规格未售罄的可用区接口获取\n- master_az和slave_az同时填写时生效\n- 目前支持mysql,gaussdbv5ha-to-kafka",
          "example": "az2xahz"
        },
        "slave_az": {
          "type": "string",
          "description": "主备任务备任务所在可用区code,可以通过查询规格未售罄的可用区接口获取\n- master_az和slave_az同时填写时生效\n- 目前支持mysql,gaussdbv5ha-to-kafka",
          "example": "az2xahz"
        },
        "charging_mode": {
          "type": "string",
          "description": "计费模式,不填默认为按需计费。\n取值范围:\n- period:包年包月。\n- on_demand:按需计费。",
          "enum": [
            "period",
            "on_demand"
          ]
        },
        "period_order": {
          "description": "包年包月信息。",
          "$ref": "#/definitions/PeriodOrderInfo"
        },
        "public_ip_list": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PublicIpConfig"
          },
          "description": "指定公网IP的信息。"
        },
        "is_open_fast_clean": {
          "type": "boolean",
          "description": "是否开启云数据库RDS for MySQL/MariaDB的binlog快速清理。不传默认为false,不开启快速清理。"
        }
      },
      "description": "创建任务请求体",
      "required": [
        "db_use_type",
        "name",
