{
  "name": "ShowComparePolicy",
  "summary": "查询对比策略",
  "tags": "对比管理",
  "productshort": "DRS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v5/{project_id}/jobs/{job_id}/compare-policy": {
      "get": {
        "x-request-examples-url-1": "https://{endpoint}/v5/5237e10fe9aa4ad5b16b6a5245248314/jobs/163b98e8-6088-46c3-8b86-c18fea6jb502/compare-policy",
        "x-request-examples-description-1": "查询对比策略请求示例。",
        "tags": [
          "对比管理"
        ],
        "operationId": "ShowComparePolicy",
        "consumes": [
          "application/json"
        ],
        "summary": "查询对比策略",
        "description": "查询对比策略。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户在某一Region下的Project ID。\n获取方法请参见[获取项目ID。](https://support.huaweicloud.com/api-drs/drs_api_0106.html)"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "发送的实体的MIME类型。推荐用户默认使用application/json,如果API是对象、镜像上传等接口,媒体类型可按照流类型的不同进行确定。",
            "type": "string",
            "default": "application/json"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "从IAM服务获取的用户Token。\n\n用户Token也就是调用获取用户Token接口的响应值,该接口是唯一不需要认证的接口。\n\n请求响应成功后在响应消息头中包含的“X-Subject-Token”的值即为Token值。",
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "请求语言类型。",
            "type": "string",
            "enum": [
              "en-us",
              "zh-cn"
            ],
            "default": "en-us"
          },
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "任务ID。"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/QueryComparePolicyResp"
            },
            "examples": {
              "application/json": {
                "period": "* * 1,2,3,4,5,6,7",
                "status": "OPEN",
                "begin_time": "08:00:00",
                "end_time": "10:00:00",
                "compare_type": [
                  "lines",
                  "account",
                  "object_comparison"
                ],
                "next_compare_time": "2023-06-12T08:00:00Z",
                "compare_policy": "normal"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResp"
            },
            "examples": {
              "application/json": {
                "error_code": "DRS.10000001",
                "error_msg": "Failed."
              }
            }
          }
        },
        "x-order": 0
      }
    }
  },
  "definitions": {
    "ErrorResp": {
      "description": "请求失败时返回的错误对象响应体。",
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 12,
          "maxLength": 12,
          "example": "DRS.00000000"
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "example": "Success"
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object"
    },
    "QueryComparePolicyResp": {
      "type": "object",
      "description": "查询对比策略响应。",
      "properties": {
        "period": {
          "type": "string",
          "example": "* * 1,2,3,4,5,6,7",
          "description": "对比时间。"
        },
        "status": {
          "type": "string",
          "example": "OPEN",
          "description": "对比策略状态。\n- OPEN:开启\n- CLOSED:关闭\n- NO_SUPPORT:不支持",
          "enum": [
            "OPEN",
            "CLOSED",
            "NO_SUPPORT"
          ]
        },
        "begin_time": {
          "type": "string",
          "example": "08:00:00",
          "description": "对比开始时间。"
        },
        "end_time": {
          "type": "string",
          "example": "10:00:00",
          "description": "对比结束时间。"
        },
        "compare_type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "lines",
            "account",
            "object_comparison"
          ],
          "description": "对比类型:\n- object_comparison:对象对比。\n- lines:行对比。\n- account:用户对比。"
        },
        "next_compare_time": {
          "type": "string",
          "example": "2023-06-12T08:00:00Z",
          "description": "下次对比时间,UTC时间,例如:2023-06-12T08:00:00Z"
        },
        "compare_policy": {
          "type": "string",
          "example": "normal",
          "description": "对比策略。\n- normal:普通对比\n- manyToOne:多对一对比"
        },
        "interval_hour": {
          "type": "integer",
          "format": "int32",
          "description": "间隔时间。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "drs.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v5",
  "method": "get",
  "uri": null
}