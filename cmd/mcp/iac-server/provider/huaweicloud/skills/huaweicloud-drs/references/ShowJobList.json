    "JobActionResp": {
      "type": "object",
      "properties": {
        "available_actions": {
          "type": "array",
          "items": {
            "enum": [
              "CREATE",
              "CHOOSE_OBJECT",
              "PRE_CHECK",
              "CHANGE_MODE",
              "FREE_RESOURCE",
              "MODIFY_DB_CONFIG",
