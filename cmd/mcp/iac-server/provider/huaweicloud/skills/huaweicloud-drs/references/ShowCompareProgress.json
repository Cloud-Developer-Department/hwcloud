          "description": "行对比与内容对比会返回该字段,全量对比信息。",
          "properties": {
            "progress": {
              "type": "number",
              "format": "float",
              "example": 100.0,
              "description": "增量数据对比进度,单位为%。",
              "minimum": 0.0,
              "maximum": 100.0
