            "src_speed": {
              "type": "string",
              "example": "0.00B/s",
              "description": "全量数据对比速率。",
              "minLength": 0,
              "maxLength": 256
            },
            "recheck_entities": {
              "type": "integer",
              "format": "int32",
              "example": 0,
              "description": "差异待复查行数。",
              "exclusiveMaximum": true,
              "minimum": 0,
              "readOnly": true
            }
          }
        },
        "incre_info": {
          "description": "动态内容对比会返回该字段,增量对比信息。",
          "properties": {
            "delay": {
              "type": "number",
              "format": "float",
              "example": 9.58,
