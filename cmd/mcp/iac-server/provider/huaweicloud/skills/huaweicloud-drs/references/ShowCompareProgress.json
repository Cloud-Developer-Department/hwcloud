              "minimum": 0,
              "maximum": 1000000
            },
            "src_speed": {
              "type": "string",
              "example": "0.00B/s",
              "description": "增量数据对比速率。",
              "minLength": 0,
              "maxLength": 256
            },
            "rps": {
