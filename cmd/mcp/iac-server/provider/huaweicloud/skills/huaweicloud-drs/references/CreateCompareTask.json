  "definitions": {
    "CreateCompareTaskReq": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务id。"
        },
        "object_level_compare_type": {
          "type": "string",
          "example": "objects",
          "description": "对象级对比类型,取值为空代表不创建对象级对比。object_level_compare_type和data_level_compare_info都为空时,只查询已创建的对比任务列表。",
          "enum": [
            "objects"
          ]
        },
        "data_level_compare_info": {
          "example": "{\"conflict_policy\":\"\",\"compare_type\":\"\",\"compare_mode\":\"\",\"start_time\":\"\",\"CompareObjectInfo\":[{\"db_name\":\"\",\"table_name\":[]}],\"CompareObjectInfoWithToken\":[{\"db_name\":\"\",\"CompareTableInfoWithToken\":[{\"table_name\":\"\",\"min_token\":\"\",\"max_token\":\"\"}]}]}",
          "description": "数据级对比信息,不创建数据级对比时可以不传。object_level_compare_type和data_level_compare_info都为空时,只查询已创建的对比任务列表。",
          "$ref": "#/definitions/CreateDataLevelCompareReq"
        }
      },
      "description": ""
    },
    "CreateCompareTaskResp": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务id。"
        },
        "object_level_compare_create_result": {
          "example": "{\"compare_task_id\":\"\",\"status\":\"\",\"error_code\":\"\",\"error_msg\":\"\"}",
          "description": "创建对象级对比的结果。",
          "$ref": "#/definitions/CreateCompareTaskResult"
        },
        "data_level_compare_create_result": {
          "description": "创建数据级对比的结果。",
          "$ref": "#/definitions/CreateCompareTaskResult"
        },
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息。"
        }
      },
      "description": ""
    },
    "CreateCompareTaskResult": {
      "properties": {
        "compare_task_id": {
          "type": "string",
          "description": "对比任务创建成功后,返回对比任务的id,用于查询该对比任务的结果。"
        },
        "error_code": {
          "type": "string",
          "description": "错误码。"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息。"
        }
      },
      "description": ""
    },
    "CompareObjectInfo": {
      "required": [
        "db_name"
      ],
      "properties": {
        "db_name": {
          "type": "string",
          "description": "库名。"
        },
        "table_name": {
          "type": "array",
          "description": "该库下的表名列表。",
          "items": {
            "type": "string",
            "description": ""
          }
        }
      },
      "description": ""
    },
    "CompareObjectInfoWithToken": {
      "required": [
        "db_name"
      ],
      "properties": {
        "db_name": {
          "type": "string",
          "description": "库名。"
        },
        "table_name_with_token": {
          "type": "array",
          "example": "[{\"table_name\":\"\",\"min_token\":\"\",\"max_token\":\"\"}]",
          "description": "该库下的表信息列表(带token)。",
          "items": {
            "description": "",
            "$ref": "#/definitions/CompareTableInfoWithToken"
          }
        }
      },
      "description": ""
    },
    "CompareTableInfoWithToken": {
      "required": [
        "table_name"
      ],
      "properties": {
        "table_name": {
          "type": "string",
          "description": "表名。"
        },
        "min_token": {
          "type": "string",
          "description": "该表的min token。"
        },
        "max_token": {
          "type": "string",
          "description": "该表的max token。"
        }
      },
      "description": ""
    },
    "CreateDataLevelCompareReq": {
      "required": [
        "compare_type",
        "conflict_policy"
      ],
      "properties": {
        "conflict_policy": {
          "type": "string",
          "example": "keep",
          "description": "一个任务只允许有一个未完成的数据级对比任务,该字段决定对未完成数据级对比任务的处理方式。cancel-取消后重新创建,keep-保持未完成的不再创建。",
          "enum": [
            "cancel",
            "keep"
          ]
        },
        "compare_type": {
          "type": "string",
          "example": "lines",
          "description": "数据级对比类型,lines-行对比,contents-内容对比。",
          "enum": [
            "lines",
            "contents"
          ]
        },
        "compare_mode": {
          "type": "string",
          "example": "quick_comparison",
          "description": "数据级对比模式,取值为空时需要在compare_object_infos或者compare_object_infos_with_token传对象信息,quick_comparison-快速对比,需要加入该功能的白名单才能使用。",
          "enum": [
            "quick_comparison"
          ],
          "default": "quick_comparison"
        },
        "start_time": {
          "type": "string",
          "description": "对比任务启动时间,取值为空代表立即启动。"
        },
        "compare_object_infos": {
          "type": "array",
          "example": "[{\"db_name\":\"\",\"table_name\":[]}]",
          "description": "数据级对比的对象。非“快速对比”模式时,compare_object_infos和compare_object_infos_with_token根据链路二选一传值,不允许都为空。",
          "items": {
            "description": "",
            "$ref": "#/definitions/CompareObjectInfo"
          }
        },
        "compare_object_infos_with_token": {
          "type": "array",
          "example": "[{\"db_name\":\"\",\"CompareTableInfoWithToken\":[{\"table_name\":\"\",\"min_token\":\"\",\"max_token\":\"\"}]}]",
          "description": "数据级对比的对象(Cassandra灾备专用,带token信息)。非“快速对比”模式时,compare_object_infos和compare_object_infos_with_token根据链路二选一传值,不允许都为空。",
          "items": {
            "description": "",
            "$ref": "#/definitions/CompareObjectInfoWithToken"
          }
        }
      },
      "description": ""
    }
  },
