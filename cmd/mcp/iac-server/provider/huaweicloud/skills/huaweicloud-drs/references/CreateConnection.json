{
  "name": "CreateConnection",
  "summary": "创建连接",
  "tags": "连接管理",
  "productshort": "DRS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v5/{project_id}/connections": {
      "post": {
        "x-request-examples-url-1": "https://{endpoint}/v5/5237e10fe9aa4ad5b16b6a5245248314/connections",
        "x-request-examples-description-1": "创建一个MySQL连接示例。",
        "x-request-examples-text-1": {
          "name": "DRS-mysql",
          "db_type": "mysql",
          "description": "description",
          "endpoint": {
            "endpoint_name": "mysql",
            "ip": "127.0.0.1",
            "db_port": "3306",
            "db_user": "root",
