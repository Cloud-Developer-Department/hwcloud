{
  "name": "ShowOpsSynthesisTask",
  "summary": "查询评测集合成任务详情",
  "tags": "评测集管理",
  "productshort": "AgentArts",
  "region_id": "cn-southwest-2",
  "paths": {
    "/v1/ops/datasets-synthesis/{synthesis_id}": {
      "get": {
        "tags": [
          "Dataset"
        ],
        "summary": "查询评测集合成任务详情",
        "description": "该接口用于通过任务ID检索特定评测集合成任务的完整信息,涵盖任务配置快照、实时执行状态及生成统计。",
        "operationId": "ShowOpsSynthesisTask",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "synthesis_id",
            "in": "path",
            "description": "**参数解释:**\n合成任务的唯一标识符(ID),该参数用于在路径中指定特定的合成任务,以便执行查询、停止或删除等操作。\n**约束限制:**\n字符串长度限制为1到64个字符。通常采用标准 UUID格式。\n**取值范围:**\n1-64位字符。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "examples": {
              "application/json": {
                "id": "task_uuid",
                "status": "running",
                "stats": {
                  "total": 50
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowOpsSynthesisTaskResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "GET https://*.com/agentarts/v1/ops/datasets-synthesis/a67452bf21f819-6f91-4568-9f2f-57ef9562ab7",
        "x-request-examples-text-1": "",
        "x-request-examples-1": "",
        "x-request-examples-description-1": "请求查询评测集合成任务详情",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-open-api": true,
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-service-plane": "Management-plane",
        "x-sec-data-level": "L4"
      }
    }
  },
  "definitions": {
    "EvaluationOpsTaskBaseInfo": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "example": "2026-02-27T03:09:53.799Z",
          "description": "**参数解释:**\n任务在系统中创建的时间戳。\n**取值范围:**\n日期时间字符串。",
          "minLength": 1,
          "maxLength": 64
        },
        "start_at": {
          "type": "string",
          "example": "2026-02-27T03:09:53.799Z",
          "description": "**参数解释:**\n任务正式开始执行的精确时刻。\n**取值范围:**\n日期时间字符串。",
          "minLength": 1,
          "maxLength": 64
        },
        "updated_at": {
          "type": "string",
          "example": "2026-02-27T03:09:53.799Z",
          "description": "**参数解释:**\n任务状态或元数据最后一次变更的时间。\n**取值范围:**\n日期时间字符串。",
          "minLength": 1,
          "maxLength": 64
        },
        "completed_at": {
          "type": "string",
          "example": "2026-02-27T03:09:53.799Z",
          "description": "**参数解释:**\n任务执行完毕(无论成败)的时间。\n**取值范围:**\n日期时间字符串。",
          "minLength": 1,
          "maxLength": 64
        },
        "duration_seconds": {
          "type": "integer",
          "format": "int64",
          "example": 325,
          "description": "**参数解释:**\n任务的有效运行总时长(秒)。\n**取值范围:**\n非负整数。",
          "minimum": 0,
          "maximum": 31536000
        },
        "created_by": {
          "description": "**参数解释:**\n创建该任务的用户详细信息。\n**取值范围:**\n参考UserInfoObj。",
          "$ref": "#/definitions/UserInfoObj"
        },
        "started_by": {
          "description": "**参数解释:**\n启动该任务的用户详细信息。\n**取值范围:**\n参考UserInfoObj。",
          "$ref": "#/definitions/UserInfoObj"
        }
      }
    },
    "ShowOpsSynthesisTaskResponseBody": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "task_uuid",
          "description": "**参数解释:**\n合成任务的唯一标识符。",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "example": "task_uuid",
          "description": "**参数解释:**\n用户为合成任务定义的描述性名称。",
          "minLength": 1,
          "maxLength": 100
        },
        "scenario_type": {
          "type": "string",
          "example": "seed_data",
          "description": "**参数解释:**\n合成任务所属的技术场景分类标识。",
          "minLength": 1,
          "maxLength": 64
        },
        "scenario_name": {
          "type": "string",
          "example": "基于种子数据泛化",
          "description": "**参数解释:**\n合成场景的友好展示名称。",
          "minLength": 1,
          "maxLength": 4000
        },
        "scenario_description": {
          "type": "string",
          "example": "基于现有100条React问答,生成50条更复杂的面试题",
          "description": "**参数解释:**\n该合成任务具体业务逻辑或目标的详细说明。",
          "minLength": 1,
          "maxLength": 4000
        },
        "status": {
          "type": "string",
          "example": "running",
          "description": "**参数解释:**\n合成任务当前的生命周期运行状态。\n**取值范围:**\n字符长度1-100,pending(等待执行),running(正在运行),completed(已完成),failed(执行失败),stopped(已人工停止)。",
          "minLength": 1,
          "maxLength": 100,
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "stopped"
          ]
        },
        "stats": {
          "description": "**参数解释:**\n任务执行的统计数据快照。\n**取值范围:**\n参考EvaluationOpsSynthesisStats定义。",
          "$ref": "#/definitions/EvaluationOpsSynthesisStats"
        },
        "usage": {
          "description": "**参数解释:**\n本次合成任务消耗的模型Token资源统计。\n**取值范围:**\n参考EvaluationOpsTokenUsage定义。",
          "$ref": "#/definitions/EvaluationOpsTokenUsage"
        },
        "model_config": {
          "description": "**参数解释:**\n任务发起时所采用的模型参数配置。\n**取值范围:**\n参考EvaluationOpsModelConfig定义。",
          "$ref": "#/definitions/EvaluationOpsModelConfig"
        },
        "seed_data": {
          "description": "**参数解释:**\n任务依赖的种子数据配置信息。\n**取值范围:**\n参考EvaluationOpsSeedDataConfig定义。",
          "$ref": "#/definitions/EvaluationOpsSeedDataConfig"
        },
        "schemas": {
          "type": "array",
          "description": "**参数解释:**\n合成数据所遵循的字段结构定义(Schema)列表。\n**取值范围:**\n包含字段名称、类型、描述等元数据的对象数组。",
          "items": {
            "$ref": "#/definitions/EvaluationOpsSynthesisSchema"
          },
          "maxItems": 50,
          "minItems": 1
        },
        "base_info": {
          "description": "**参数解释:**\n任务的基础管理元数据。\n**取值范围:**\n参考EvaluationOpsTaskBaseInfo定义。",
          "$ref": "#/definitions/EvaluationOpsTaskBaseInfo"
        }
      }
    },
    "EvaluationOpsSynthesisStats": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "example": 50,
          "description": "**参数解释:**  \n任务计划生成的总样本条数。\n**取值范围:**  \n0-500。",
          "minimum": 0,
          "maximum": 500
        },
        "progress": {
          "type": "integer",
          "format": "int32",
          "example": 65,
          "description": "**参数解释:**  \n当前任务执行的百分比进度。\n**取值范围:**  \n0-100。",
          "minimum": 0,
          "maximum": 100
        },
        "success": {
          "type": "integer",
          "format": "int32",
          "example": 33,
          "description": "**参数解释:**  \n当前已成功生成的样本总数。\n**取值范围:**  \n0-500。",
          "minimum": 0,
          "maximum": 500
        },
        "failed": {
          "type": "integer",
          "format": "int32",
          "example": 2,
          "description": "**参数解释:**  \n在合成过程中失败的样本总数。\n**取值范围:**  \n0-500。",
          "minimum": 0,
          "maximum": 500
        },
        "running": {
          "type": "integer",
          "format": "int32",
          "example": 5,
          "description": "**参数解释:**  \n当前正处于活跃生成阶段的样本条数。\n**取值范围:**  \n0-500。",
          "minimum": 0,
          "maximum": 500
        },
        "pending": {
          "type": "integer",
          "format": "int32",
          "example": 10,
          "description": "**参数解释:**  \n尚未开始执行、在队列中等待的样本条数。\n**取值范围:**  \n0-500。",
          "minimum": 0,
          "maximum": 500
        }
      },
      "description": "**参数解释:**  \n数据合成任务的运行明细统计对象。\n**取值范围:**  \n不涉及。"
    },
    "UserInfoObj": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "op_svc_modelartsversatile_container0",
          "description": "**参数解释:**\n用户的显示名称。\n**取值范围:**\n任意字符串。",
          "minLength": 0,
          "maxLength": 1200
        },
        "user_id": {
          "type": "string",
          "example": "6f80301edacc43728bf47b6a6484d512",
          "description": "**参数解释:**\n用户在账号系统中的唯一身份ID。\n**取值范围:**\n不涉及",
          "minLength": 0,
          "maxLength": 1200
        }
      }
    },
    "EvaluationOpsSeedDataConfig": {
      "type": "object",
      "required": [
        "seed_data_type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "example": "dataset",
          "description": "**参数解释:**  \n种子数据的来源类型。\n**取值范围:**  \ndataset(评测集),file(文件)。",
          "enum": [
            "dataset",
            "file"
          ]
        },
        "dataset_id": {
          "type": "string",
          "example": "c3c2571d-a8b0-4447-8b79-a67cac076768",
          "description": "**参数解释:**  \n种子评测集的唯一ID。\n**取值范围:**  \n符合通用唯一识别码(UUID)标准的字符串。",
          "minLength": 0,
          "maxLength": 64
        },
        "dataset_name": {
          "type": "string",
          "example": "种子评测集名称",
          "description": "**参数解释:**  \n种子评测集的展示名称。\n**取值范围:**  \n任意字符串。",
          "minLength": 0,
          "maxLength": 200
        },
        "dataset_version_id": {
          "type": "string",
          "example": "c3c2571d-a8b0-4447-8b79-a67cac076768",
          "description": "**参数解释:**  \n种子评测集版本的内部唯一标识符。\n**取值范围:**  \n符合通用唯一识别码(UUID)标准的字符串。",
          "minLength": 0,
          "maxLength": 64
        },
        "dataset_version": {
          "type": "string",
          "example": "0.0.1",
          "description": "**参数解释:**  \n种子评测集的可读版本号。\n**取值范围:**  \n如0.0.1。",
          "minLength": 0,
          "maxLength": 64
        },
        "file_name": {
          "type": "string",
          "example": "seed.jsonl",
          "description": "**参数解释:**  \n作为种子源的临时文件名称。\n**取值范围:**  \n文件名。",
          "minLength": 1,
          "maxLength": 200
        },
        "obs_tmp_file_id": {
          "type": "string",
          "example": "obs:../path/to/seed.jsonl",
          "description": "**参数解释:**  \n种子数据文件在对象存储中的路径。\n**取值范围:**  \nOBS路径。",
          "minLength": 0,
          "maxLength": 10000
        }
      }
    },
    "EvaluationOpsTokenUsage": {
      "type": "object",
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "format": "int64",
          "example": 12500,
          "description": "**参数解释:**  \n输入提示词所消耗的Token数量。\n**取值范围:**  \n0-9,999,999,999。",
          "minimum": 0,
          "maximum": 9999999999
        },
        "completion_tokens": {
          "type": "integer",
          "format": "int64",
          "example": 8450,
          "description": "**参数解释:**  \n模型生成内容所消耗的Token数量。\n**取值范围:**  \n0-9,999,999,999。",
          "minimum": 0,
          "maximum": 9999999999
        },
        "total_tokens": {
          "type": "integer",
          "format": "int64",
          "example": 20950,
          "description": "**参数解释:**  \n本次任务产生的Token消耗总量。\n**取值范围:**  \n0-9,999,999,999。",
          "minimum": 0,
          "maximum": 9999999999
        }
      },
      "description": "**参数解释:**  \n大模型调用产生的Token资源消耗统计对象。\n**取值范围:**  \n不涉及。"
    },
    "EvaluationOpsModelConfig": {
      "type": "object",
      "required": [
        "model_id",
        "model_name"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "example": "1749615103",
          "description": "**参数解释:**  \n指定调用的大模型唯一标识符,通过模型列表接口获取。",
          "minLength": 1,
          "maxLength": 64
        },
        "model_name": {
          "type": "string",
          "example": "豆包·1.6·自动深度思考",
          "description": "**参数解释:**  \n模型的显示名称。\n**取值范围:**  \n任意字符串。",
          "minLength": 2,
          "maxLength": 100
        },
        "temperature": {
          "type": "number",
          "format": "float",
          "example": 0.1,
          "description": "**参数解释:**  \n采样温度参数,用于控制输出的随机性。数值低更聚焦,数值高更具创造性。\n**取值范围:**  \n0.0到2.0。",
          "minimum": 0,
          "maximum": 2,
          "default": 0.7
        },
        "max_tokens": {
          "type": "integer",
          "example": 4096,
          "description": "**参数解释:**  \n单次推理生成的最大Token数量限制。\n**取值范围:**  \n1-32000。",
          "minimum": 1,
          "maximum": 32000
        },
        "top_p": {
          "type": "number",
          "format": "float",
          "example": 0.7,
          "description": "**参数解释:**  \n核采样参数。\n**取值范围:**  \n0.0到1.0。",
          "minimum": 0,
          "maximum": 1,
          "default": 1.0
        },
        "frequency_penalty": {
          "type": "number",
          "format": "float",
          "example": 0.0,
          "description": "**参数解释:**  \n频率惩罚系数,降低内容重复倾向。\n**取值范围:**  \n-2.0到2.0。",
          "minimum": -2.0,
          "maximum": 2.0,
          "default": 0.0
        }
      }
    },
    "EvaluationOpsSynthesisSchema": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "**参数解释:**  \n合成字段的id。\n**取值范围:**  \n由字母、数字、下划线组成。",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "example": "input",
          "description": "**参数解释:**  \n合成字段的名称。\n**取值范围:**  \n长度1-100字符,由字母、数字、下划线组成。",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "example": "作为输入投递给评测对象",
          "description": "**参数解释:**  \n合成字段的业务含义描述。\n**取值范围:**  \n任意字符串。",
          "minLength": 0,
          "maxLength": 400
        },
        "synthesis_requirement": {
          "type": "string",
          "example": "生成技术深度适中、具有实践意义的React问题。",
          "description": "**参数解释:**  \n合成要求,用于指导LLM生成该字段的思考路径。\n**取值范围:**  \n0-4000字符,详细的指令说明。",
          "minLength": 0,
          "maxLength": 4000
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "agentarts.cn-southwest-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}