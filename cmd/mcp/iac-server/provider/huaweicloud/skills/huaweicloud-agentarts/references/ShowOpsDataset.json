  "paths": {
    "/v1/ops/datasets/{dataset_id}": {
      "get": {
        "tags": [
          "Dataset"
        ],
        "summary": "获取评测集详情",
        "description": "该接口用于根据评测集ID获取其完整的元数据配置,包括字段结构定义、基本属性及关联的历史发布版本列表。\n适用场景:\n- 评测配置校验:在启动评估任务前,开发者通过此接口确认评测集的字段是否符合评估任务输入要求。\n- 版本回溯与管理:获取评测集下属的所有版本信息,以便进行版本对比或指定特定版本进行操作。",
        "operationId": "ShowOpsDataset",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "description": "**参数解释:**\n评测集的唯一标识符(ID)\n**约束限制:**\n由英文、数字、“-”、“_”组成,长度为1到64个字符。\n**取值范围:**\n由英文、数字、连字符(-)、下划线(_)组成的1-64位字符串。\n**默认取值:**\n无。",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "examples": {
