{
  "name": "CreateCoreSpaceApiKey",
  "summary": "创建 API Key",
  "tags": "记忆访问密钥管理",
  "productshort": "AgentArts",
  "region_id": "cn-southwest-2",
  "paths": {
    "/v1/core/space-keys": {
      "post": {
        "tags": [
          "记忆访问密钥管理"
        ],
        "summary": "创建 API Key",
        "description": "创建新的 API Key,用于数据面访问认证。\nAPI Key 先于 Space 创建,创建后通过 CreateSpace 的 api_key_id 参数绑定到 Space。",
        "operationId": "CreateCoreSpaceApiKey",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-api-service-plane": "Control-plane",
        "x-is-registered": "Y",
        "x-sec-data-level": "L3",
        "x-apigateway-request-type": "public",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-request-examples-url-1": "/v1/core/space-keys",
        "responses": {
          "201": {
            "description": "API Key 创建成功",
            "schema": {
              "$ref": "#/definitions/CreateCoreSpaceApiKeyResponseBody"
            }
          },
          "400": {
            "description": "请求参数错误。",
            "schema": {
              "$ref": "#/definitions/CoreSpaceCommonError"
            }
          },
          "401": {
            "description": "认证失败。",
            "schema": {
              "$ref": "#/definitions/CoreSpaceCommonError"
            }
          },
          "403": {
            "description": "权限不足。",
            "schema": {
              "$ref": "#/definitions/AuthorizationError"
            }
          },
          "429": {
            "description": "请求频率超限。",
            "schema": {
              "$ref": "#/definitions/CoreSpaceCommonError"
            }
          },
          "500": {
            "description": "内部服务器错误",
            "schema": {
              "$ref": "#/definitions/CoreSpaceCommonError"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CreateCoreSpaceApiKeyResponseBody": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "**参数解释:**\nAPI Key ID,唯一标识一个 API Key,可通过\"创建 API Key\"接口获取。用于创建space时,指定入参api_key_id。\n**取值范围:**\n不涉及。"
        },
        "api_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "**参数解释:**\nAPI Key 明文(仅创建时返回一次,请妥善保存)。用于调用数据面API时的接口认证,请求头如下:Authorization: Bearer ${api_key}。\n**取值范围:**\n不涉及。"
        }
      }
    },
    "AuthorizationError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n错误码,标识错误类型,格式为 AgentArts.XXXXXXXX。\n**取值范围:**\n不涉及。",
          "pattern": "^AgentArts\\.[0-9]{8}$",
          "minLength": 18,
          "maxLength": 18
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n错误信息,描述错误详情,供问题排查使用。\n**取值范围:**\n不涉及。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "**参数解释:**\n编码后的授权失败信息。\n**取值范围:**\n不涉及。",
          "minLength": 1,
          "maxLength": 4096
        },
        "details": {
          "type": "array",
          "description": "**参数解释:**\n依赖的下游服务错误信息列表,包含导致当前请求失败的下游服务错误详情。\n**取值范围:**\n不涉及。",
          "items": {
            "$ref": "#/definitions/CoreSpaceCommonError"
          },
          "minItems": 0,
          "maxItems": 10
        }
      }
    },
    "CoreSpaceCommonError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n错误码,标识错误类型,格式为 AgentArts.01XXXXXX。\n**取值范围:**\n不涉及。",
          "pattern": "^AgentArts\\.[0-9]{8}$",
          "minLength": 18,
          "maxLength": 18
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n错误信息,描述错误详情,供问题排查使用。\n**取值范围:**\n不涉及。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },
