{
  "name": "ResetCoreSpaceApiKey",
  "summary": "重置 API Key",
  "tags": "记忆访问密钥管理",
  "productshort": "AgentArts",
  "region_id": "cn-east-4",
  "paths": {
    "/v1/core/spaces/{space_id}/reset-key": {
      "post": {
        "tags": [
          "记忆访问密钥管理"
        ],
        "summary": "重置 API Key",
        "description": "异步重置指定 Space 的 API Key,旧 Key 立即失效",
        "operationId": "ResetCoreSpaceApiKey",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-api-service-plane": "Control-plane",
        "x-is-registered": "Y",
        "x-sec-data-level": "L3",
        "x-apigateway-request-type": "public",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-request-examples-url-1": "/v1/core/spaces/123e4567-e89b-12d3-a456-426614174000/reset-key",
        "parameters": [
          {
            "$ref": "#/parameters/SpaceIdPath"
          }
        ],
        "responses": {
          "202": {
            "description": "API Key 重置请求已接受",
            "schema": {
              "$ref": "#/definitions/ResetCoreSpaceApiKeyResponseBody"
            }
          },
          "400": {
            "description": "请求参数错误。",
            "schema": {
              "$ref": "#/definitions/CoreSpaceCommonError"
            }
          },
          "401": {
            "description": "认证失败。",
            "schema": {
              "$ref": "#/definitions/CoreSpaceCommonError"
            }
          },
          "403": {
            "description": "权限不足。",
            "schema": {
              "$ref": "#/definitions/AuthorizationError"
            }
          },
          "404": {
            "description": "记忆库未找到",
            "schema": {
              "$ref": "#/definitions/CoreSpaceCommonError"
            }
          },
          "429": {
            "description": "请求频率超限。",
            "schema": {
              "$ref": "#/definitions/CoreSpaceCommonError"
            }
          },
          "500": {
            "description": "内部服务器错误",
            "schema": {
              "$ref": "#/definitions/CoreSpaceCommonError"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "GetCoreSpaceJobResponseBody": {
      "type": "object",
      "required": [
        "id",
        "job_name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "**参数解释:**\n异步任务 ID,唯一标识一个异步任务,可通过创建异步任务的接口返回获取。\n**取值范围:**\n不涉及。"
        },
        "job_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "**参数解释:**\n异步任务名称,标识任务的类型。\n**取值范围:**\n- create_space: 创建记忆库\n- update_network: 更新网络配置"
        },
        "status": {
          "type": "string",
          "description": "**参数解释:**\n异步任务的当前执行状态。\n**取值范围:**\n- running: 执行中\n- success: 成功\n- failed: 失败",
          "enum": [
            "running",
            "success",
            "failed"
          ]
        }
      }
    },
    "ResetCoreSpaceApiKeyResponseBody": {
      "type": "object",
      "description": "**参数解释:**\n重置 API Key 响应体,组合异步任务信息和新的 API Key 信息。\n使用 allOf 继承 GetCoreSpaceJobResponseBody(任务信息)和 CreateCoreSpaceApiKeyResponseBody(API Key 信息)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
      "allOf": [
        {
          "$ref": "#/definitions/GetCoreSpaceJobResponseBody"
        },
        {
          "type": "object",
          "properties": {
            "key_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "**参数解释:**\nAPI Key ID(与任务 ID 区分),可通过\"创建 API Key\"接口获取。\n**取值范围:**\n不涉及。"
            },
            "api_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "**参数解释:**\nAPI Key 明文(仅创建时返回一次,请妥善保存)。\n**取值范围:**\n不涉及。"
            }
          }
        }
      ]
    },
    "AuthorizationError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n错误码,标识错误类型,格式为 AgentArts.XXXXXXXX。\n**取值范围:**\n不涉及。",
          "pattern": "^AgentArts\\.[0-9]{8}$",
          "minLength": 18,
          "maxLength": 18
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n错误信息,描述错误详情,供问题排查使用。\n**取值范围:**\n不涉及。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "**参数解释:**\n编码后的授权失败信息。\n**取值范围:**\n不涉及。",
          "minLength": 1,
          "maxLength": 4096
        },
        "details": {
          "type": "array",
          "description": "**参数解释:**\n依赖的下游服务错误信息列表,包含导致当前请求失败的下游服务错误详情。\n**取值范围:**\n不涉及。",
          "items": {
            "$ref": "#/definitions/CoreSpaceCommonError"
          },
          "minItems": 0,
          "maxItems": 10
        }
      }
    },
    "CoreSpaceCommonError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n错误码,标识错误类型,格式为 AgentArts.01XXXXXX。\n**取值范围:**\n不涉及。",
          "pattern": "^AgentArts\\.[0-9]{8}$",
          "minLength": 18,
          "maxLength": 18
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n错误信息,描述错误详情,供问题排查使用。\n**取值范围:**\n不涉及。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "SpaceIdPath": {
      "name": "space_id",
      "in": "path",
      "required": true,
      "type": "string",
      "format": "uuid",
      "description": "**参数解释:** \n记忆库 ID,唯一标识一个记忆库,可以通过AgentArts智能体记忆库控制台或者记忆库查询接口获取。\n**约束限制:**\n仅支持字母、数字和中划线。\n**取值范围:**\n匹配标准的UUID格式(8-4-4-4-12的十六进制数字串,由连字符分隔),符合正则条件^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$。\n**默认取值:**\n不涉及。"
    }
  },
  "host": "agentarts.cn-east-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}