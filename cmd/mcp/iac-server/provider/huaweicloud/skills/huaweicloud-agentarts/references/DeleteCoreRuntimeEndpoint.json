        "summary": "删除runtime访问方式",
        "description": "该接口用于根据Agent运行时ID以及访问方式ID删除对应的Agent运行时访问方式。访问方式删除后无法通过该访问方式进行Agent调用。\n**适用场景:**\n删除某一个具体的Agent运行时访问方式及其相关记录。",
        "operationId": "DeleteCoreRuntimeEndpoint",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "$ref": "#/parameters/RuntimeId"
          },
          {
            "$ref": "#/parameters/EndpointId"
          }
        ],
        "responses": {
          "204": {
            "description": "删除成功。"
          },
          "401": {
            "description": "未授权(认证令牌缺失、无效或已过期)。",
            "schema": {
              "$ref": "#/definitions/CoreRunUnauthorizedError"
            }
          },
          "403": {
            "description": "禁止访问(认证后权限不足)。",
            "schema": {
              "$ref": "#/definitions/CoreRunForbiddenError"
            }
          },
          "409": {
            "description": "资源冲突(如访问方式名称已存在)。",
            "schema": {
              "$ref": "#/definitions/CoreRunConflictError"
            }
          },
          "429": {
            "description": "请求过于频繁(触发限流)。",
            "schema": {
              "$ref": "#/definitions/CoreRunTooManyRequestsError"
            }
          },
          "500": {
            "description": "服务器内部错误。",
            "schema": {
              "$ref": "#/definitions/CoreRunInternalServerError"
            }
          }
        }
      }
    }
