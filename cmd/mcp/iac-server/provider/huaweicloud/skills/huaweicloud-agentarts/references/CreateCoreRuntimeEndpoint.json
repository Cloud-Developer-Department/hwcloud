{
  "name": "CreateCoreRuntimeEndpoint",
  "summary": "创建runtime访问方式",
  "tags": "运行时访问方式",
  "productshort": "AgentArts",
  "region_id": "cn-east-4",
  "paths": {
    "/v1/core/runtimes/{runtime_id}/endpoints": {
      "post": {
        "x-api-type": "open-api",
        "x-api-service-plane": "Control-plane",
        "x-sec-data-level": "L3",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "tags": [
          "运行时访问方式"
        ],
        "summary": "创建runtime访问方式",
        "description": "该接口用于为某一个具体的Agent运行时创建访问方式,支持为该访问方式绑定版本以及对应的灰度策略。\n**适用场景:**\n某一个具体的Agent运行时存在多个版本,通过配置访问方式来指定调用某一个具体版本。\n某一个具体的Agent运行时修改后需要进行灰度发布,通过配置访问方式,为老版本和新版本配置流量权重。",
        "operationId": "CreateCoreRuntimeEndpoint",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "$ref": "#/parameters/RuntimeId"
          },
          {
            "in": "body",
            "name": "CreateCoreRuntimeEndpointRequestBody",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateCoreRuntimeEndpointRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "创建成功,返回创建的访问方式信息。",
            "schema": {
              "$ref": "#/definitions/CreateCoreRuntimeEndpointResponseBody"
            }
          },
          "400": {
            "description": "请求参数错误(如name格式错误等)。",
            "schema": {
              "$ref": "#/definitions/CoreRunBadRequestError"
            }
          },
          "401": {
            "description": "未授权(认证令牌缺失、无效或已过期)。",
            "schema": {
              "$ref": "#/definitions/CoreRunUnauthorizedError"
            }
          },
          "403": {
            "description": "禁止访问(认证后权限不足)。",
            "schema": {
              "$ref": "#/definitions/CoreRunForbiddenError"
            }
          },
          "404": {
            "description": "资源不存在(指定的runtime_id未找到)。",
            "schema": {
              "$ref": "#/definitions/CoreRunNotFoundError"
            }
          },
          "409": {
            "description": "资源冲突(如访问方式名称已存在)。",
            "schema": {
              "$ref": "#/definitions/CoreRunConflictError"
            }
          },
          "429": {
            "description": "请求过于频繁(触发限流)。",
            "schema": {
              "$ref": "#/definitions/CoreRunTooManyRequestsError"
            }
          },
          "500": {
            "description": "服务器内部错误。",
            "schema": {
              "$ref": "#/definitions/CoreRunInternalServerError"
            }
          }
        }
      }
    }
  },
