          "example": "AgentArts.03000404"
        },
        "error_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "**参数解释**:\n错误详细信息。",
          "example": "资源不存在:runtime_id为xxx的资源未找到"
        }
      }
    },
