  "definitions": {
    "CoreToolBasic": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "**参数解释:**\n工具ID。\n**取值范围:**\n符合UUID规则^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$的36位字符串。"
        },
        "name": {
          "type": "string",
          "description": "**参数解释:**\n工具的名称。\n**取值范围:**\n符合正则^[a-z][a-z0-9-]{0,38}[a-z0-9]$,即必须以小写字母开头,小写字母或数字结尾,中间可包含数字、小写字母、中划线,字符长度必须在2-40个字符之间。",
          "minLength": 2,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "description": "**参数解释:**\n工具的描述。\n**取值范围:**\n任意字符,长度不能超过4096个字符",
          "minLength": 0,
          "maxLength": 4096
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释:**\n创建时间。\n**取值范围:**\nISO 8601格式的时间字符串,例如:2026-04-09T08:29:59.922+00:00。"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释:**\n更新时间。\n**取值范围:**\nISO 8601格式的时间字符串,例如:2026-04-09T08:29:59.922+00:00。"
        },
        "execution_agency_name": {
          "type": "string",
          "description": "**参数解释:**\n为工具提供访问云服务的权限的IAM委托名。\n**取值范围:**\nIAM委托名长度必须在1-64个字符之间,字符规则以IAM服务校验规则为准。",
          "minLength": 1,
          "maxLength": 64
        },
        "agent_gateway_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "**参数解释:**\n工具入口的AgentGateway的ID。\n**取值范围:**\n符合UUID规则 ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$的36位字符串。",
          "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
        },
        "workload_identity": {
          "$ref": "#/definitions/CoreToolsWorkloadIdentity",
          "description": "**参数解释:**\n认证信息。\n**取值范围:**\n不涉及。"
        },
        "access_endpoint": {
          "type": "string",
          "minLength": 16,
          "maxLength": 71,
          "pattern": "^https://(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,}$",
          "description": "**参数解释:**\n访问域名。\n**取值范围:**\n不涉及。",
          "example": "https://xxxx.agentarts.cn-north-4.xxx.com"
        },
        "observability": {
          "description": "**参数解释:**\n可观测性信息。\n**取值范围:**\n不涉及。",
          "$ref": "#/definitions/CoreToolsObservability"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CoreToolsTag"
          },
          "minItems": 0,
          "maxItems": 50,
          "description": "**参数解释:**\n资源标签。\n**取值范围:**\n不涉及。"
        },
        "status": {
          "type": "string",
          "description": "**参数解释:**\n工具状态。\n**取值范围:**\n- RUNNING:运行中。\n- DELETING:删除中。\n- DELETE_FAILED:删除失败。",
          "readOnly": true
        }
      }
    },
    "CoreToolsLogsConfig": {
      "type": "object",
      "description": "日志采集配置。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "**参数解释:**\n是否开启日志采集。\n- 未开启,工具运行过程产生的日志无法上报至云日志服务(LTS)。\n- 开启后,工具运行过程产生的日志会上报至云日志服务(LTS)。\n\n**约束限制:**\n不涉及。\n**取值范围:**\n- true打开。\n- false关闭。\n\n**默认取值:**\nfalse。",
          "default": false,
          "example": true
        },
        "group_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "**参数解释:**\n工具的日志组ID。\n**约束限制:**\n当前不支持更新、指定。\n**取值范围:**\n长度不能超过64个字符。\n**默认取值:**\n不涉及。",
          "example": "xx-xx"
        },
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "**参数解释:**\n工具的日志流ID。\n**约束限制:**\n当前不支持更新、指定。\n**取值范围:**\n长度不能超过64个字符。\n**默认取值:**\n不涉及。",
          "example": "end_user_lts_stream"
        }
      }
    },
    "ShowCoreCodeInterpreterResponseBody": {
      "description": "代码解释器响应体。",
      "allOf": [
        {
          "$ref": "#/definitions/CoreToolBasic"
        },
        {
          "type": "object",
          "properties": {
            "auth_type": {
              "type": "string",
              "description": "**参数解释:**\n工具认证方式。\n**取值范围:**\n`API_KEY`: 使用 API 密钥认证。\n`IAM`: 使用 IAM方式认证。",
              "enum": [
                "API_KEY",
                "IAM"
              ]
            },
            "api_key_name": {
              "type": "string",
              "description": "**参数解释:**\napiKey名称。\n**取值范围:**\n只能包含数字、字母、下划线、中划线,且长度必须在1-64个字符之间。",
              "pattern": "^[a-zA-Z0-9_-]{1,64}$",
              "maxLength": 64
            },
            "network_config": {
              "description": "**参数解释:**\n出方向网络配置。\n**取值范围:**\n不涉及。",
              "$ref": "#/definitions/CoreToolsVpcConfig"
            }
          }
        }
      ]
    },
    "CoreToolsTag": {
      "type": "object",
      "description": "标签。",
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n标签键。\n**约束限制:**\n不能为空,且单个资源标签键不能重复。\n**取值范围:**\n符合规则^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)(?<!\\s)$,即可以包含任意语种的字母、数字和空格,以及_.:=+-@字符,但首尾不能包含空格,且不能以_sys_开头,且长度在1到128之间。\n**默认取值:**\n不涉及。",
          "example": "environment",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)(?<!\\s)$"
        },
        "value": {
          "type": "string",
          "description": "**参数解释:**\n标签值。\n**约束限制:**\n不涉及。\n**取值范围:**\n符合规则^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$,即可以包含任意语种的字母、数字和空格,以及_.:/=+-@字符,且长度不能超过255个字符。\n**默认取值:**\n不涉及",
          "example": "production",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$"
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    "CoreToolsTracingObservabilityConfig": {
      "type": "object",
      "description": "调用链采集配置。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "**参数解释:**\n是否开启调用链采集。\n**约束限制:**\n不涉及。\n**取值范围:**\n- true 开启。\n- false 关闭。\n**默认取值:**\nfalse。",
          "default": false,
          "example": true
        },
        "service_group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "**参数解释:**\n调用链服务组名。\n**约束限制:**\n不涉及。\n**取值范围:**\n长度不能超过64个字符。\n**默认取值:**\n不涉及。",
          "example": "app-user"
        }
      }
    },
    "CoreToolsAuthorizationError": {
      "allOf": [
        {
          "$ref": "#/definitions/CoreToolsCommonError"
        },
        {
          "type": "object",
          "properties": {
            "encoded_authorization_message": {
              "type": "string",
              "description": "**参数解释:**\n编码后的授权失败信息,可找IAM服务oncall提供解码方式获取详细授权失败原因。\n**取值范围:**\n不涉及。",
              "minLength": 1,
              "maxLength": 4096
            },
            "details": {
              "type": "array",
              "description": "**参数解释:**\n依赖的下游服务错误信息列表。\n**取值范围:**\n不涉及。",
              "minItems": 0,
              "maxItems": 10,
              "items": {
                "$ref": "#/definitions/CoreToolsCommonError"
              }
            }
          }
        }
      ]
    },
    "CoreToolsMetricsObservabilityConfig": {
      "type": "object",
      "description": "自定义指标采集详细配置。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "**参数解释:**\n是否开启自定义指标采集。\n**约束限制:**\n不涉及。\n**取值范围:**\n- true 开启。\n- false 关闭。\n**默认取值:**\nfalse。",
          "default": false,
          "example": true
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "**参数解释:**\n自定义指标实例ID。\n**约束限制:**\n不涉及。\n**取值范围:**\n长度不能超过64个字符。\n**默认取值:**\n不涉及。",
          "example": "xx-xx"
        }
      }
    },
    "CoreToolsVpcConfig": {
      "type": "object",
      "description": "vpc网络配置。",
      "required": [
        "vpc_id",
        "subnet_id"
      ],
      "properties": {
        "vpc_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "**参数解释:**\n工具使用的VPC的ID,获取方式请参见[创建VPC](https://support.huaweicloud.com/usermanual-vpc/zh-cn_topic_0013935842.html)。\n**约束限制:**\n不涉及。\n**取值范围:**\n只能由英文字母、数字及\"-\"组成,且长度为36个字符。\n**默认取值:**\n不涉及。",
          "example": "1a2ac6ec-c5ae-40f9-9677-bd73f37c0de5"
        },
        "subnet_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "**参数解释:**\n工具使用的VPC子网的ID,获取方式请参见[创建VPC子网](https://support.huaweicloud.com/usermanual-vpc/zh-cn_topic_0013748726.html)。\n**约束限制:**\n不涉及。\n**取值范围:**\n只能由英文字母、数字及“-”组成,且长度为36个字符。\n**默认取值:**\n不涉及。",
          "example": "2e79ba05-8e10-41f6-9650-00fea3ca24cc"
        },
        "security_group_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "description": "Security group id list allowed for vpc。"
          },
          "example": [
            "a6f126ca-cb81-4323-9597-72eee3de4439"
          ],
          "description": "**参数解释:**\n工具使用的安全组id列表,获取方式请参见[创建安全组](https://support.huaweicloud.com/usermanual-vpc/zh-cn_topic_0013748715.html)。\n**约束限制:**\n不涉及。\n**取值范围:**\n只能由英文字母、数字及\"-\"组成,且长度为36个字符。\n**默认取值:**\n不涉及。"
        }
      }
    },
    "CoreToolsObservability": {
      "type": "object",
      "description": "可观测性配置(日志+指标)。",
      "properties": {
        "logs": {
          "$ref": "#/definitions/CoreToolsLogsConfig",
          "description": "**参数解释:**\n工具的日志配置。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "metrics": {
          "$ref": "#/definitions/CoreToolsMetricsObservabilityConfig",
          "description": "**参数解释:**\n工具的自定义指标采集详细配置。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "tracing": {
          "$ref": "#/definitions/CoreToolsTracingObservabilityConfig",
          "description": "**参数解释:**\n工具的调用链采集配置。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        }
      }
    },
    "CoreToolsWorkloadIdentityUrn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "工作负载身份的URN。",
      "example": "agentarts:cn-north-7:123456789:codeInterpreter:123312"
    },
    "CoreToolsCommonError": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n错误码。\n**取值范围:**\n满足正则^AgentArts\\.0400\\d{4}$,例如AgentArts.04000404。",
          "pattern": "^AgentArts\\.0400\\d{4}$",
          "minLength": 18,
          "maxLength": 18
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n错误信息。\n**取值范围:**\n不涉及。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ]
    },
    "CoreToolsWorkloadIdentity": {
      "type": "object",
      "description": "认证信息。",
      "properties": {
        "urn": {
          "$ref": "#/definitions/CoreToolsWorkloadIdentityUrn",
          "description": "**参数解释:**\n工作负载身份的URN。\n**取值范围:**\n不涉及。"
        }
      },
      "required": [
        "urn"
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "CodeInterpreterId": {
      "name": "code_interpreter_id",
      "in": "path",
      "required": true,
      "description": "**参数解释:**\n代码解释器ID,可通过[查询代码解释器列表](https://support.huaweicloud.com/api-agentarts/ListCoreCodeInterpreters.html)接口获取。\n**约束限制:**\n不涉及。\n**取值范围:**\n符合UUID正则^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$的36位字符串。\n**默认取值:**\n不涉及。",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "host": "agentarts.cn-east-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}