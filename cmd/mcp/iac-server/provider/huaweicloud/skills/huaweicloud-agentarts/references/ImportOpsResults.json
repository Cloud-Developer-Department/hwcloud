        ],
        "parameters": [
          {
            "in": "body",
            "name": "ImportOpsResultsRequestBody",
            "description": "**参数解释:**\n导入评估结果的请求主体。用于将评估数据或模型输出批量上传至系统中。\n**约束限制:**\n必须包含有效的task_id或数据来源。\n**取值范围:**\n符合评估结果导入规范的JSON对象。\n**默认取值:**\n不涉及。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ImportOpsResultsRequestBody"
            }
          }
        ],
