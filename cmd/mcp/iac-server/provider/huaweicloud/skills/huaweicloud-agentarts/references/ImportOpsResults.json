  "definitions": {
    "ImportOpsResultsRequestBody": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "example": "evaluation-task",
          "description": "**参数解释:**\n指定导入来源的任务类型。\n**约束限制:**\n枚举值。\n**取值范围:**\n字符长度1-100,evaluation-task(评测记录),datasets-synthesis(合成样本)。\n**默认取值:**\n不涉及。",
          "enum": [
            "evaluation-task",
            "datasets-synthesis"
          ]
        },
        "dataset_id": {
          "type": "string",
          "example": "target_dataset_uuid",
          "description": "**参数解释:**\n目标评测集的唯一标识符。为空时将触发创建新评测集。\n**约束限制:**\n1-64个字符。\n**取值范围:**\n字符长度1-64,已存在的评测集ID。\n**默认取值:**\n不涉及。",
          "minLength": 1,
          "maxLength": 64
        },
        "task_id": {
          "type": "string",
          "description": "**参数解释:**\n待导入数据所属的源任务ID。\n**约束限制:**\n1-64个字符。\n**取值范围:**\n字符长度1-64,合法的任务ID。\n**默认取值:**\n不涉及。",
          "minLength": 1,
          "maxLength": 64
        },
        "dataset_name": {
          "type": "string",
          "example": "新建评测集",
          "description": "**参数解释:**\n当 dataset_id 为空时,定义新建评测集的名称。\n**约束限制:**\n2-100个字符。\n**取值范围:**\n任意字符串。\n**默认取值:**\n不涉及。",
          "minLength": 2,
          "maxLength": 100
        },
        "dataset_description": {
          "type": "string",
          "example": "从合成任务导入的数据",
          "description": "**参数解释:**\n为新建评测集提供的详细功能或内容描述。\n**约束限制:**\n0-400个字符。\n**取值范围:**\n字符长度0-400,任意描述性文本。\n**默认取值:**\n不涉及。",
          "minLength": 0,
          "maxLength": 400
        },
        "is_published": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释:**\n是否在导入完成后自动发布为一个正式版本。\n**约束限制:**\n布尔值。\n**取值范围:**\ntrue(自动发布),false(存入草稿)。\n**默认取值:**\nfalse。",
          "default": false
        },
        "overwrite": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释:**\n当目标评测集已存在数据时,是否清空原有数据再执行导入。\n**约束限制:**\n布尔值。\n**取值范围:**\ntrue(全量覆盖),false(增量追加)。\n**默认取值:**\nfalse。",
          "default": false
        },
        "schema_mapping": {
          "type": "array",
          "description": "**参数解释:**\n字段映射规则列表,定义源字段如何对应到目标评测集字段。\n**约束限制:**\n数组长度1-100。\n**取值范围:**\n包含source, target, type的对象。\n**默认取值:**\n不涉及。",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "example": "field_0",
                "description": "**参数解释:**\n源任务结果中的原始字段键名。\n**约束限制:**\n1-255个字符。\n**取值范围:**\n合法的字段键。\n**默认取值:**\n不涉及。",
                "minLength": 1,
                "maxLength": 255
              },
              "target": {
                "type": "string",
                "example": "input",
                "description": "**参数解释:**\n目标评测集定义的字段键名。\n**约束限制:**\n1-255个字符。\n**取值范围:**\n字符长度1-255,目标Schema定义的键。\n**默认取值:**\n不涉及。",
                "minLength": 1,
                "maxLength": 255
              },
              "type": {
                "type": "string",
                "description": "**参数解释:**\n字段的数据类型,确保数据校验准确性。\n**约束限制:**\n1-64个字符。\n**取值范围:**\n1-64个字符,String, Integer 等。\n**默认取值:**\n不涉及。",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "source",
              "target",
              "type"
            ]
          },
          "maxItems": 100,
          "minItems": 1
        },
        "ids": {
          "type": "array",
          "description": "**参数解释:**\n需要执行导入操作的具体条目ID列表,通过数据集列表接口获取。\n**约束限制:**\n包含1-500个数据项ID。\n**取值范围:**\n每项1-64个字符。\n**默认取值:**\n不涉及。",
          "items": {
            "type": "string",
            "example": "7590080423130108162",
            "description": "**参数解释:**\n单条数据项的唯一标识符。\n**约束限制:**\n1-64个字符。\n**取值范围:**\n合法的ID字符串。\n**默认取值:**\n不涉及。",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 500,
          "minItems": 1
        }
      }
    }
  },
