{
  "name": "ShowOpsEvaluationModel",
  "summary": "获取单个模型信息",
  "tags": "模型管理",
  "productshort": "AgentArts",
  "region_id": "cn-east-4",
  "paths": {
    "/v1/ops/evaluation-models/{model_id}": {
      "get": {
        "tags": [
          "EvaluationModel"
        ],
        "summary": "获取单个模型信息",
        "description": "该接口用于通过模型ID获取特定大模型的详细元数据,包含其技术规格、版本信息、支持的协议能力及服务终点。",
        "operationId": "ShowOpsEvaluationModel",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "description": "**参数解释:**\n大模型的唯一标识符(ID)。该参数用于在路径中指定当前操作所针对的具体模型资源。获取方法请参考9.1-获取模型信息 - ListOpsEvaluationModels。\n**约束限制:**\n长度为 1到100个字符。\n**取值范围:**\n存在的模型ID。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "获取模型信息成功",
            "examples": {
              "application/json": {
                "model": {
                  "model_id": "mod_gpt4_v1",
                  "model_name": "GPT-4-Turbo",
                  "max_tokens_top": 90,
                  "max_tokens_bottom": 45,
                  "temperature_top": "15",
                  "temperature_bottom": "3",
                  "top_p_top": "55",
                  "top_p_bottom": "20",
                  "supported_scenes": [
                    "a",
                    "b"
                  ]
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowOpsEvaluatorModelResponseBody"
            }
          },
          "400": {
            "description": "错误码",
            "examples": {
              "application/json": {
                "error_code": "AgentArts.03400001",
                "error_msg": "请求错误"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "GET https://*.com/agentarts/v1/ops/evaluation-models/mod_gpt4_v1",
        "x-request-examples-description-1": "通过模型ID\"mod_gpt4_v1\" 获取该模型的详细元数据。",
        "x-request-examples-text-1": "",
        "x-request-examples-1": "",
        "x-open-api": true,
        "x-api-type": "open-api",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-service-plane": "Management-plane",
        "x-sec-data-level": "L4",
        "x-order": 1
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n系统定义的标准化错误代码。\n**取值范围:**\n业务异常编码字符串。",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n对错误的详细描述,包含异常原因或解决建议。\n**约束限制:**\n字符串类型,最小长度为2,最大长度为512。\n**取值范围:**\n字符长度2-512,任意文本内容。",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "**参数解释:**\n接口调用失败时的统一错误响应格式。\n**取值范围:**\n不涉及。"
    },
    "Model": {
      "type": "object",
      "properties": {
        "max_tokens_top": {
          "type": "integer",
          "format": "int32",
          "example": 4096,
          "description": "**参数解释:**\n模型生成文本的最大长度上限。\n**取值范围:**\n0 - 10000。",
          "minimum": 0,
          "maximum": 10000
        },
        "max_tokens_bottom": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "**参数解释:**\n模型生成文本的最小长度下限。\n**取值范围:**\n0 - 10000。",
          "minimum": 0,
          "maximum": 10000
        },
        "model_id": {
          "type": "string",
          "example": "ModelID",
          "description": "**参数解释:**\n模型的唯一标识符。\n**取值范围:**\n不涉及。",
          "minLength": 0,
          "maxLength": 10000
        },
        "model_name": {
          "type": "string",
          "example": "ModelName",
          "description": "**参数解释:**\n模型的显示名称。\n**取值范围:**\n不涉及。",
          "minLength": 0,
          "maxLength": 10000
        },
        "temperature_top": {
          "type": "string",
          "example": "1.0",
          "description": "**参数解释:**\n模型生成随机性(Temperature)的上限值。\n**取值范围:**\n不涉及。",
          "minLength": 0,
          "maxLength": 10000
        },
        "temperature_bottom": {
          "type": "string",
          "example": "0.0",
          "description": "**参数解释:**\n模型生成随机性的下限值。\n**约束限制:**\n0到10000字符。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "minLength": 0,
          "maxLength": 10000
        },
        "top_p_top": {
          "type": "string",
          "example": "1.0",
          "description": "**参数解释:**\nTopP采样策略的上限值。\n**取值范围:**\n不涉及。",
          "minLength": 0,
          "maxLength": 10000
        },
        "top_p_bottom": {
          "type": "string",
          "example": "0.0",
          "description": "**参数解释:**\nTopP采样策略的下限值。\n**取值范围:**\n不涉及。",
          "minLength": 0,
          "maxLength": 10000
        },
        "supported_scenes": {
          "type": "array",
          "example": [
            "evaluators",
            "datasets-synthesis"
          ],
          "description": "**参数解释:**\n模型支持的应用场景列表。\n**取值范围:**\n数组长度为0到100。可选枚举值包括:\n- evaluators:评估器场景,用于质量评估。\n- datasets-synthesis:数据合成场景,用于生成评测集。",
          "items": {
            "type": "string",
            "enum": [
              "evaluators",
              "datasets-synthesis"
            ]
          },
          "maxItems": 100,
          "minItems": 0
        }
      },
      "description": "**参数解释:**\n大模型的核心配置信息及支持的参数范围。\n**取值范围:**\n不涉及。"
    },
    "ShowOpsEvaluatorModelResponseBody": {
      "type": "object",
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "description": "**参数解释:**\n单个模型的详细信息对象。\n**取值范围:**\n参考Model定义。",
          "$ref": "#/definitions/Model"
        }
      },
      "description": "**参数解释:**\n获取单个评估器模型详细信息的响应体。\n**取值范围:**\n不涉及。"
    }
  },
  "version": "2.0",
  "parameters": {},
