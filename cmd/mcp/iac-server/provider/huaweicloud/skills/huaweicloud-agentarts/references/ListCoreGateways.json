{
  "name": "ListCoreGateways",
  "summary": "列出所有网关",
  "tags": "网关资源管理",
  "productshort": "AgentArts",
  "region_id": "cn-southwest-2",
  "paths": {
    "/v1/core/gateways": {
      "get": {
        "x-api-type": "open-api",
        "x-api-service-plane": "Control-plane",
        "x-sec-data-level": "L3",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "tags": [
          "网关资源管理"
        ],
        "summary": "列出所有网关",
        "description": "检索所有网关的列表,支持可选的过滤和分页功能。",
        "operationId": "ListCoreGateways",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-open-api": true,
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "按名称过滤网关,支持模糊匹配。",
            "required": false,
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          {
            "name": "status",
            "in": "query",
            "description": "按状态过滤网关。",
            "required": false,
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "creating",
              "deleting",
              "updating",
              "failed"
            ]
          },
          {
            "name": "gateway_id",
            "in": "query",
            "description": "按网关ID过滤,支持多个ID(最多支持20个ID)。",
            "required": false,
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "返回的最大结果数。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          {
            "name": "offset",
            "in": "query",
            "description": "返回结果偏移量。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 100000,
            "default": 0
          }
        ],
        "responses": {
          "200": {
            "description": "成功检索网关列表",
            "schema": {
              "$ref": "#/definitions/ListCoreGatewaysResponseBody"
            }
          },
          "400": {
            "description": "无效的请求参数",
            "schema": {
              "$ref": "#/definitions/CoreGatewayCommonError"
            }
          },
          "500": {
            "description": "内部服务器错误",
            "schema": {
              "$ref": "#/definitions/CoreGatewayCommonError"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CoreGatewayCommonError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n错误码。\n**取值范围:**\n取值为固定18个字符,匹配以 AgentArts. 开头、后接恰好8位数字的字符串,符合正则条件^AgentArts\\.[0-9]{8}$。",
          "pattern": "^AgentArts\\.[0-9]{8}$",
          "minLength": 18,
          "maxLength": 18,
          "example": "AgentArts.02000000"
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n错误消息。\n**取值范围:**\n取值为 1-256 个字符,匹配由字母、数字、空格、中文汉字以及常见中英文标点符号组成的非空字符串,符合正则条件^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()''\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "error_reason": {
          "type": "string",
          "description": "**参数解释:**\n错误原因。\n**取值范围:**\n取值为 1-256 个字符,匹配由字母、数字、空格、中文汉字以及常见中英文标点符号组成的非空字符串,符合正则条件^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()''\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "error_suggestion": {
          "type": "string",
          "description": "**参数解释:**\n错误处理建议。\n**取值范围:**\n取值为 1-256 个字符,匹配由字母、数字、空格、中文汉字以及常见中英文标点符号组成的非空字符串,符合正则条件^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()''\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "CoreGatewayTag": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n标签键。\n**取值范围:**\n最大长度128个unicode字符,可用 UTF-8 格式表示的字母、数字和空格,以及以下字符:_ . : / = + - @。",
          "minLength": 1,
          "maxLength": 128,
          "example": "key1"
        },
        "value": {
          "type": "string",
          "description": "**参数解释:**\n标签值。\n**取值范围:**\n最大长度255个unicode字符,可用 UTF-8 格式表示的字母、数字和空格,以及以下字符:_ . : / = + - @。",
          "example": "value1",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "example": {
        "key": "Environment",
        "value": "production"
      }
    },
    "ListCoreGatewaysResponseBody": {
      "type": "object",
      "required": [
        "gateways",
        "size",
        "total"
      ],
      "properties": {
        "gateways": {
          "type": "array",
          "description": "网关列表。",
          "items": {
            "$ref": "#/definitions/CoreGatewaySummary"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 100,
          "description": "当前页返回的网关数量。"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1000000,
          "description": "网关总数。"
        }
      }
    },
    "CoreGatewaySummary": {
      "type": "object",
      "required": [
        "gateway_id",
        "name",
        "status",
        "protocol_type",
        "authorizer_type",
        "agency_name",
        "created_at"
      ],
      "properties": {
        "gateway_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "网关的唯一标识符。"
        },
        "name": {
          "type": "string",
          "description": "网关名称。",
          "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$",
          "minLength": 2,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "description": "网关的当前状态。",
          "enum": [
            "active",
            "inactive",
            "creating",
            "deleting",
            "updating",
            "failed"
          ]
        },
        "protocol_type": {
          "type": "string",
          "description": "网关协议类型。",
          "enum": [
            "mcp"
          ]
        },
        "authorizer_type": {
          "type": "string",
          "description": "授权器类型。",
          "enum": [
            "custom_jwt",
            "iam",
            "api_key"
          ]
        },
        "agency_name": {
          "type": "string",
          "description": "委托名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "tags": {
          "type": "array",
          "description": "资源标签列表。",
          "items": {
            "$ref": "#/definitions/CoreGatewayTag"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "网关创建时间戳。"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "网关最后更新时间戳。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "agentarts.cn-southwest-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}