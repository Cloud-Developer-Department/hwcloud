{
  "name": "ShowCoreIngress",
  "summary": "查询网关详情",
  "tags": "入站网络",
  "productshort": "AgentArts",
  "region_id": "cn-east-4",
  "paths": {
    "/v1/core/ingresses/{ingress_id}": {
      "get": {
        "x-api-type": "open-api",
        "x-api-service-plane": "Control-plane",
        "x-sec-data-level": "L3",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "tags": [
          "入站网络"
        ],
        "summary": "查询网关详情",
        "description": "该接口用于根据ingress_id查询Ingress的详细信息。",
        "operationId": "ShowCoreIngress",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "$ref": "#/parameters/IngressId"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功,返回Ingress详情。",
            "schema": {
              "$ref": "#/definitions/CoreIngressResponse"
            }
          },
          "400": {
            "description": "请求参数错误。",
            "schema": {
              "$ref": "#/definitions/CoreRunBadRequestError"
            }
          },
          "401": {
            "description": "未授权。",
            "schema": {
              "$ref": "#/definitions/CoreRunUnauthorizedError"
            }
          },
          "403": {
            "description": "禁止访问。",
            "schema": {
              "$ref": "#/definitions/CoreRunForbiddenError"
            }
          },
          "404": {
            "description": "资源不存在。",
            "schema": {
              "$ref": "#/definitions/CoreRunNotFoundError"
            }
          },
          "429": {
            "description": "请求过于频繁。",
            "schema": {
              "$ref": "#/definitions/CoreRunTooManyRequestsError"
            }
          },
          "500": {
            "description": "服务器内部错误。",
            "schema": {
              "$ref": "#/definitions/CoreRunInternalServerError"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CoreRunNotFoundError": {
      "description": "**参数解释**:\n资源不存在。",
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:\n错误码。",
          "enum": [
            "AgentArts.03000404"
          ],
          "example": "AgentArts.03000404"
        },
        "error_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "**参数解释**:\n错误详细信息。",
          "example": "资源不存在:runtime_id为xxx的资源未找到"
        }
      }
    },
    "CoreRunTooManyRequestsError": {
      "description": "**参数解释**:\n请求过于频繁(触发限流)。",
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:\n错误码。",
          "enum": [
            "AgentArts.03000429"
          ],
          "example": "AgentArts.03000429"
        },
        "error_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "**参数解释**:\n错误详细信息。",
          "example": "请求过于频繁,请稍后重试"
        }
      }
    },
    "CoreIngressResponse": {
      "description": "**参数解释**:\nIngress响应体。",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "minLength": 1,
          "maxLength": 64,
          "description": "**参数解释**:\nIngress ID。",
          "example": "a3bad420-33b8-4e26-e99b-bdf67aa8e72b"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48,
          "pattern": "^[a-z][a-z0-9-]+$",
          "description": "**参数解释**:\nIngress名称。",
          "example": "test-ingress"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "**参数解释**:\nIngress描述。",
          "example": "test create policy"
        },
        "status": {
          "type": "string",
          "description": "**参数解释**:\nIngress状态。",
          "enum": [
            "PENDING",
            "ACTIVE",
            "FAILED",
            "UPDATE_FAILED",
            "DELETE_FAILED"
          ],
          "example": "ACTIVE"
        },
        "enable_public_network": {
          "type": "boolean",
          "description": "**参数解释**:\n是否启用公网访问。",
          "example": true
        },
        "public_domain_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "**参数解释**:\n公网域名。",
          "example": "www.public.com"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释**:\n资源创建时间。",
          "example": "2023-01-01T01:01:01Z"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释**:\n资源最后更新时间。",
          "example": "2023-01-01T01:01:01Z"
        }
      }
    },
    "CoreRunUnauthorizedError": {
      "description": "**参数解释**:\n未授权(认证令牌缺失、无效或已过期)。",
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:\n错误码。",
          "enum": [
            "AgentArts.03000401"
          ],
          "example": "AgentArts.03000401"
        },
        "error_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "**参数解释**:\n错误详细信息。",
          "example": "认证令牌已过期,请重新登录"
        }
      }
    },
    "CoreRunErrorDetail": {
      "type": "object",
      "description": "**参数解释**:\n错误详情结构体。",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:\n错误码。",
          "minLength": 18,
          "maxLength": 18
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释**:\n错误信息。",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "error_code",
        "error_msg"
      ]
    },
    "CoreRunBadRequestError": {
      "description": "**参数解释**:\n客户端请求参数错误。",
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:\n错误码。",
          "enum": [
            "AgentArts.03000400"
          ],
          "example": "AgentArts.03000400"
        },
        "error_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "**参数解释**:\n错误详细信息。",
          "example": "请求参数错误:name字段不能为空"
        }
      }
    },
    "CoreRunInternalServerError": {
      "description": "**参数解释**:\n服务器内部错误。",
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:\n错误码。",
          "enum": [
            "AgentArts.03000500"
          ],
          "example": "AgentArts.03000500"
        },
        "error_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "**参数解释**:\n错误详细信息。",
          "example": "服务器内部错误,请稍后重试"
        }
      }
    },
    "CoreRunForbiddenError": {
      "description": "**参数解释**:\n禁止访问(认证后权限不足)。",
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释**:\n错误码。",
          "enum": [
            "AgentArts.03000403"
          ],
          "example": "AgentArts.03000403"
        },
        "error_msg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "**参数解释**:\n错误详细信息。",
          "example": "无权访问该资源"
        },
        "coded_authorization_message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "**参数解释**:\nIAM5 当OpenAPI无权限时报错信息。",
          "example": "eyJlcnJvciI6ICJVbmF1dGhvcml6ZWQifQ=="
        },
        "details": {
          "type": "array",
          "description": "**参数解释**:\n依赖的下游服务错误信息列表。",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/CoreRunErrorDetail"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "IngressId": {
      "name": "ingress_id",
      "in": "path",
      "required": true,
      "description": "Ingress ID,用于唯一标识一个Ingress实例。",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  },
  "host": "agentarts.cn-east-4.myhuaweicloud.com",
  "base_path": "/",
