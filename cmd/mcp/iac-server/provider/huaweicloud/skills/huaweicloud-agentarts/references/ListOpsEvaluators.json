  "definitions": {
    "ListOpsEvaluatorsRequestBody": {
      "type": "object",
      "properties": {
        "builtin": {
          "type": "boolean",
          "example": false,
          "description": "**参数解释:**\n是否为系统预置评估器的过滤开关。\n**约束限制:**\n布尔值。\n**取值范围:**\n- true: 仅查询预置评估器\n- false: 仅查询用户自定义评估器\n**默认取值:**\n无(查询全部)。"
        },
        "filter_option": {
          "description": "**参数解释:**\n评估器的详细过滤条件(如名称、标签等)。\n**约束限制:**\n符合 EvaluationOpsFilterOption定义。\n**取值范围:**\n对象结构。\n**默认取值:**\n不涉及。",
          "$ref": "#/definitions/EvaluationOpsFilterOption"
        },
        "page_size": {
          "type": "integer",
          "format": "int32",
          "example": 12,
          "description": "**参数解释:**\n分页查询时每页返回的记录数量。\n**约束限制:**\n0到10000。\n**取值范围:**\n0到10000之间的整数。\n**默认取值:**\n10。",
          "minimum": 0,
          "maximum": 10000
        },
        "page_number": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "**参数解释:**\n分页查询的当前页码。\n**约束限制:**\n0到10000。\n**取值范围:**\n0到10000 之间的整数。\n**默认取值:**\n1。",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "description": "**参数解释:**\n获取评估器列表信息的请求体。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
    },
    "EvaluationOpsFilterOption": {
      "type": "object",
      "properties": {
        "filters": {
          "description": "**参数解释:**\n评估器的过滤详细配置,支持包含和模糊查询。\n**约束限制:**\n不涉及。\n**取值范围:**\n参考EvaluationOpsFilters定义。\n**默认取值:**\n不涉及。",
          "$ref": "#/definitions/EvaluationOpsFilters"
        }
      },
      "description": "**参数解释:**\n评估操作的过滤选项包装对象。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
    },
    "EvaluationOpsFilters": {
      "type": "object",
      "properties": {
        "logic_op": {
          "type": "string",
          "example": "And",
          "description": "**参数解释:**\n过滤条件的逻辑运算符。And表示全显,Or表示任一。\n**约束限制:**\n0到10000字符。\n**取值范围:**\nAnd, Or。\n**默认取值:**\n不涉及。",
          "minLength": 0,
          "maxLength": 10000
        },
        "filter_conditions": {
          "type": "array",
          "description": "**参数解释:**\n具体的过滤条件列表。每个元素为一个JSON格式的字符串。\n**约束限制:**\n数组长度为0到10000。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "items": {
            "type": "object",
            "properties": {}
          },
          "maxItems": 10000,
          "minItems": 0
        }
      },
      "description": "**参数解释:**\n评估操作的过滤条件对象。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
    }
