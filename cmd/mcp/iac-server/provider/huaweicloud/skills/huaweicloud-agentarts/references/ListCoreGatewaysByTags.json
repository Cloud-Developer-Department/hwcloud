  "definitions": {
    "CoreGatewaysTagValuesForTMS": {
      "type": "object",
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n标签键。\n**约束限制:**\nkey不能为空或者空字符串,不能为空格。\n**取值范围:**\n最大长度128个unicode字符。 \n**默认取值:**\n不涉及。",
          "minLength": 1,
          "maxLength": 128,
          "example": "key1"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 255
          },
          "description": "**参数解释:**\n标签值列表。\n**约束限制:**\n如果values为空列表,则表示查询任意value。value之间为或的关系。\n**取值范围:**\n数组长度0-20,每个值最大长度255个unicode字符。\n**默认取值:**\n不涉及。",
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        }
      }
    },
    "CoreGatewayCommonError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n错误码。\n**取值范围:**\n取值为固定18个字符,匹配以 AgentArts. 开头、后接恰好8位数字的字符串,符合正则条件^AgentArts\\.[0-9]{8}$。",
          "pattern": "^AgentArts\\.[0-9]{8}$",
          "minLength": 18,
          "maxLength": 18,
          "example": "AgentArts.02000000"
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n错误消息。\n**取值范围:**\n取值为 1-256 个字符,匹配由字母、数字、空格、中文汉字以及常见中英文标点符号组成的非空字符串,符合正则条件^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()''\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "error_reason": {
          "type": "string",
          "description": "**参数解释:**\n错误原因。\n**取值范围:**\n取值为 1-256 个字符,匹配由字母、数字、空格、中文汉字以及常见中英文标点符号组成的非空字符串,符合正则条件^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()''\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "error_suggestion": {
          "type": "string",
          "description": "**参数解释:**\n错误处理建议。\n**取值范围:**\n取值为 1-256 个字符,匹配由字母、数字、空格、中文汉字以及常见中英文标点符号组成的非空字符串,符合正则条件^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()''\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "CoreGatewayTag": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n标签键。\n**取值范围:**\n最大长度128个unicode字符,可用 UTF-8 格式表示的字母、数字和空格,以及以下字符:_ . : / = + - @。",
          "minLength": 1,
          "maxLength": 128,
          "example": "key1"
        },
        "value": {
          "type": "string",
          "description": "**参数解释:**\n标签值。\n**取值范围:**\n最大长度255个unicode字符,可用 UTF-8 格式表示的字母、数字和空格,以及以下字符:_ . : / = + - @。",
          "example": "value1",
          "minLength": 0,
          "maxLength": 255
        }
      },
      "example": {
        "key": "Environment",
        "value": "production"
      }
    },
    "CoreGatewaysMatchForTMS": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n搜索字段,key为要匹配的字段。\n**约束限制:**\n当前只支持按照网关名称resource_name过滤资源。\n**取值范围:**\n固定为resource_name。\n**默认取值:**\nresource_name。",
          "enum": [
            "resource_name"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "**参数解释:**\n搜索匹配值,用于与网关名称做搜索。\n**约束限制:**\n支持前缀搜索,如果value为空字符串精确匹配(不存在资源名称为空的情况,因此此类情况会返回空列表)。\n**取值范围:**\n最大长度255个unicode字符。 \n**默认取值:**\n不涉及。"
        }
      }
    },
    "ListCoreGatewaysByTagsRequestBody": {
      "type": "object",
      "properties": {
        "without_any_tag": {
          "type": "boolean",
          "description": "**参数解释:**\n是否查询所有不带标签的资源。\n**约束限制:**\n不涉及。\n**取值范围:**\n- true:查询所有不带标签的资源,此时忽略 “tags”字段;\n- false:返回所有资源或按“tags”、“matches”等条件过滤。\n**默认取值:**\nfalse。",
          "example": true,
          "default": false
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CoreGatewaysTagValuesForTMS"
          },
          "description": "**参数解释:**\n指定查询的资源中需要包含哪些标签,结果返回包含所有标签的资源列表,key之间是与的关系,key-value结构中value是或的关系。\n**约束限制:**\n数组内key不能重复,同一个key中values不能重复,每个key对应的value可以为空数组但结构体不能缺失。\n**取值范围:**\n数组长度最大为20。\n**默认取值:**\n不涉及。",
          "minItems": 0,
          "maxItems": 20
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CoreGatewaysMatchForTMS"
          },
          "description": "**参数解释:**\n标签键值匹配字段,key为要匹配的字段。\n**约束限制:**\nkey为固定字典值,只支持resource_name,不能包含重复的key或不支持的key。支持根据value的值做前缀搜索。\n**取值范围:**\n数组长度最大为1。\n**默认取值:**\n不涉及。",
          "minItems": 0,
          "maxItems": 1
        }
      }
    },
    "ListCoreGatewaysByTagsResponseBody": {
      "type": "object",
      "properties": {
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释:**\n总记录数。\n**取值范围:**\n非负整数。",
          "example": 1
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CoreGatewaysResourceInstanceForTMS"
          },
          "description": "**参数解释:**\n根据标签查询网关的资源实例列表。\n**取值范围:**\n数组长度0-1000。",
          "minItems": 0,
          "maxItems": 1000
        }
      }
    },
    "CoreGatewayAuthorizationError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n错误码。\n**取值范围:**\n取值为固定18个字符,匹配以 AgentArts. 开头、后接恰好8位数字的字符串,符合正则条件^AgentArts\\.[0-9]{8}$。",
          "pattern": "^AgentArts\\.[0-9]{8}$",
          "minLength": 18,
          "maxLength": 18
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n错误消息。\n**取值范围:**\n取值为 1-256 个字符,匹配由字母、数字、空格、中文汉字以及常见中英文标点符号组成的非空字符串,符合正则条件^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()''\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "**参数解释:**\n编码后的授权失败信息,可通过统一身份认证服务IAM的解密鉴权失败的原因接口解码获取详细授权失败原因。\n**取值范围:**\n取值为 1-4096 个字符。",
          "minLength": 1,
          "maxLength": 4096
        },
        "details": {
          "type": "array",
          "description": "**参数解释:**\n依赖的下游服务错误信息列表。\n**取值范围:**\n数组长度为 0-10。",
          "items": {
            "$ref": "#/definitions/CoreGatewayCommonError"
          },
          "minItems": 0,
          "maxItems": 10
        }
      }
    },
    "CoreGatewaysResourceInstanceForTMS": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "**参数解释:**\n网关ID,网关的唯一标识符。\n**取值范围:**\n匹配标准的UUID格式(8-4-4-4-12的十六进制数字串,由连字符分隔),符合正则条件^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$。"
        },
        "resource_name": {
          "type": "string",
          "description": "**参数解释:**\n网关名称。\n**取值范围:**\n长度为 2-40 个字符,匹配以小写字母开头、以小写字母或数字结尾、中间可包含0到38个小写字母、数字或连字符的字符串,符合正则条件^[a-z][a-z0-9-]{0,38}[a-z0-9]$。",
          "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$",
          "minLength": 2,
          "maxLength": 40
        },
        "tags": {
          "type": "array",
          "description": "**参数解释:**\n资源标签列表,没有标签默认为空数组。\n**取值范围:**\n数组长度为0-20。",
          "items": {
            "$ref": "#/definitions/CoreGatewayTag"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "resource_detail": {
          "type": "object",
          "description": "**参数解释:**\n资源详情,资源对象用于扩展。默认为空。\n**取值范围:**\n不涉及。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Offset": {
      "name": "offset",
      "in": "query",
      "description": "**参数解释:**\n返回结果偏移量。\n**约束限制:**\n必须为非负整数。\n**取值范围:**\n0-100000。\n**默认取值:**\n0。",
      "required": false,
      "type": "integer",
      "minimum": 0,
      "maximum": 100000,
      "default": 0
    },
    "TagLimit": {
      "name": "limit",
      "in": "query",
      "description": "**参数解释:**\n查询记录数。\n**约束限制:**\n必须为正整数。\n**取值范围:**\n1-1000。\n**默认取值:**\n1000。",
      "required": false,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 1000
    }
  },
