  },
  "definitions": {
    "DebugOpsEvaluatorRequestBody": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "example": "llm",
          "description": "**参数解释:**\n评估器的调试类型。\n**约束限制:**\n长度为0到100个字符。\n**取值范围:**\n- llm: 基于大语言模型的调试\n- code: 基于代码脚本的调试\n**默认取值:**\n不涉及。",
          "minLength": 0,
          "maxLength": 100
        },
        "turn_type": {
          "type": "string",
          "example": "multi",
          "description": "**参数解释:**\n评估器的轮次类型。\n**约束限制:**\n长度为0到100个字符。\n**取值范围:**\n- single: 单轮评估器\n- multi: 多轮评估器\n**默认取值:**\n不涉及。",
          "minLength": 0,
          "maxLength": 100
        },
        "llm_config": {
          "description": "**参数解释:**\n大模型评估器的具体配置信息。\n**约束限制:**\n仅当type为 llm 时生效。\n**取值范围:**\n参考EvaluationOpsLLMConfig定义。\n**默认取值:**\n不涉及。",
          "$ref": "#/definitions/EvaluationOpsLLMConfig"
        }
      },
      "description": "**参数解释:**\n调试评估器的请求体。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
    },
    "EvaluationOpsLLMConfig": {
      "type": "object",
      "properties": {
        "system_prompt": {
          "type": "string",
          "example": "system_prompt",
          "description": "**参数解释:**\n系统提示词(System Prompt),定义模型的角色与规则。\n**约束限制:**\n0到10000字符。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "minLength": 0,
          "maxLength": 10000
        },
        "model_config": {
          "description": "**参数解释:**\n具体的模型参数配置对象。\n**约束限制:**\n不涉及。\n**取值范围:**\n参考EvaluationOpsModelConfig定义。\n**默认取值:**\n不涉及。",
          "$ref": "#/definitions/EvaluationOpsModelConfig"
        }
      },
      "description": "**参数解释:**\n大语言模型(LLM)的评估配置对象。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
    },
    "DebugOpsEvaluatorResponseBody": {
      "type": "object",
      "properties": {
        "status_code": {
          "type": "integer",
          "format": "int32",
          "example": 200,
          "description": "**参数解释:**\n调试执行的状态码。\n**取值范围:**\n遵循 HTTP 状态码或自定义业务状态码。",
          "minimum": 0,
          "maximum": 2147483647
        },
        "error": {
          "type": "string",
          "example": "Invalid Prompt Template",
          "description": "**参数解释:**\n调试过程中产生的错误详细信息。\n**取值范围:**\n描述性错误字符串。",
          "minLength": 0,
          "maxLength": 2147483647
        },
        "score": {
          "type": "integer",
          "format": "int32",
          "example": 85,
          "description": "**参数解释:**\n评估器根据当前输入调试出的评分结果。\n**取值范围:**\n按评估逻辑定义的评分区间返回。",
          "minimum": 0,
          "maximum": 2147483647
        },
        "reason": {
          "type": "string",
          "example": "回复内容过于笼统。",
          "description": "**参数解释:**\n评估结果的详细理由或推导过程。\n**取值范围:**\n详细的描述性文本。",
          "minLength": 0,
          "maxLength": 2147483647
        },
        "input_token_usage": {
          "type": "integer",
          "format": "int32",
          "example": 386,
          "description": "**参数解释:**\n调试请求中输入内容消耗的Token数量。\n**取值范围:**\n0到2,147,483,647之间的整数。",
          "minimum": 0,
          "maximum": 2147483647
        },
        "output_token_usage": {
          "type": "integer",
          "format": "int32",
          "example": 703,
          "description": "**参数解释:**\n调试请求中输出内容消耗的Token数量。\n**取值范围:**\n0到2,147,483,647之间的整数。",
          "minimum": 0,
          "maximum": 2147483647
        },
        "latency": {
          "type": "integer",
          "format": "int32",
          "example": 2200,
          "description": "**参数解释:**\n本次调试操作的耗时。\n**取值范围:**\n0 - 2,147,483,647 之间的整数。",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "description": "**参数解释:**\n调试评估器的响应体。\n**取值范围:**\n不涉及。"
    },
    "EvaluationOpsModelConfig": {
      "type": "object",
      "required": [
        "model_id",
        "model_name"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "example": "1749615103",
          "description": "**参数解释:**  \n指定调用的大模型唯一标识符,通过模型列表接口获取。",
          "minLength": 1,
          "maxLength": 64
        },
        "model_name": {
          "type": "string",
          "example": "豆包·1.6·自动深度思考",
          "description": "**参数解释:**  \n模型的显示名称。\n**取值范围:**  \n任意字符串。",
          "minLength": 2,
          "maxLength": 100
        },
        "temperature": {
          "type": "number",
          "format": "float",
          "example": 0.1,
          "description": "**参数解释:**  \n采样温度参数,用于控制输出的随机性。数值低更聚焦,数值高更具创造性。\n**取值范围:**  \n0.0到2.0。",
          "minimum": 0,
          "maximum": 2,
          "default": 0.7
        },
        "max_tokens": {
          "type": "integer",
          "example": 4096,
          "description": "**参数解释:**  \n单次推理生成的最大Token数量限制。\n**取值范围:**  \n1-32000。",
          "minimum": 1,
          "maximum": 32000
        },
        "top_p": {
          "type": "number",
          "format": "float",
          "example": 0.7,
          "description": "**参数解释:**  \n核采样参数。\n**取值范围:**  \n0.0到1.0。",
          "minimum": 0,
          "maximum": 1,
          "default": 1.0
        },
        "frequency_penalty": {
          "type": "number",
          "format": "float",
          "example": 0.0,
          "description": "**参数解释:**  \n频率惩罚系数,降低内容重复倾向。\n**取值范围:**  \n-2.0到2.0。",
          "minimum": -2.0,
          "maximum": 2.0,
          "default": 0.0
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "agentarts.cn-southwest-2.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
