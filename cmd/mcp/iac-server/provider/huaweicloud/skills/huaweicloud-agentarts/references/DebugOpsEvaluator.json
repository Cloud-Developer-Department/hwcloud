{
  "name": "DebugOpsEvaluator",
  "summary": "评估器调试",
  "tags": "评估器管理",
  "productshort": "AgentArts",
  "region_id": "cn-southwest-2",
  "paths": {
    "/v1/ops/evaluators/debug": {
      "post": {
        "tags": [
          "Evaluator"
        ],
        "summary": "评估器调试",
        "description": "该接口用于对评估器的判分逻辑进行实时调试,通过输入样例数据验证评估器的解析能力、Prompt 效果及评分准确性。",
        "operationId": "DebugOpsEvaluator",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "DebugOpsEvaluatorRequestBody",
            "description": "**参数解释:**\n调试评估器的请求主体。通过提供样本数据验证评估器的逻辑、评分机制或输出格式是否符合预期。\n**约束限制:**\n符合调试接口定义的JSON结构。\n**取值范围:**\n符合评估器调试规范的JSON对象。\n**默认取值:**\n不涉及。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DebugOpsEvaluatorRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应",
            "examples": {
              "application/json": {
                "status_code": 200,
                "error": "Invalid Prompt Template",
                "score": 85,
                "reason": "回复内容过于笼统。",
                "input_token_usage": 386,
                "output_token_usage": 703,
                "latency": 2200
              }
            },
            "schema": {
              "$ref": "#/definitions/DebugOpsEvaluatorResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "POST https://*.com/agentarts/v1/ops/evaluators/debug",
        "x-request-examples-description-1": "通过输入样例数据实时调试评估器的判分逻辑和 Prompt 效果。",
        "x-request-examples-text-1": {
