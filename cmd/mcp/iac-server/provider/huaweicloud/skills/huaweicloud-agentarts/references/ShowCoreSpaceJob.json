  "region_id": "cn-southwest-2",
  "paths": {
    "/v1/core/spaces/{space_id}/job/{job_id}": {
      "get": {
        "tags": [
          "记忆异步任务管理"
        ],
        "summary": "查询异步任务状态",
        "description": "查询服务异步任务的执行状态",
        "operationId": "ShowCoreSpaceJob",
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-api-service-plane": "Control-plane",
        "x-is-registered": "Y",
        "x-sec-data-level": "L3",
        "x-apigateway-request-type": "public",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-request-examples-url-1": "/v1/core/spaces/123e4567-e89b-12d3-a456-426614174000/job/123e4567-e89b-12d3-a456-426614174000",
        "parameters": [
          {
            "$ref": "#/parameters/SpaceIdPath"
          },
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "description": "**参数解释:**\n异步任务 ID,唯一标识一个异步任务。\n**约束限制:**\n仅支持字母、数字和中划线。\n**取值范围:**\n长度1-48字符。\n**默认取值:**\n不涉及。",
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取任务状态",
