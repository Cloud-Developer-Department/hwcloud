              "$ref": "#/definitions/CoreSpaceCommonError"
            }
          },
          "429": {
            "description": "请求频率超限。",
            "schema": {
              "$ref": "#/definitions/CoreSpaceCommonError"
            }
          },
          "500": {
            "description": "内部服务器错误",
