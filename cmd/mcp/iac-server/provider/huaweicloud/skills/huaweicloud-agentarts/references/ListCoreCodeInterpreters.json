            "schema": {
              "$ref": "#/definitions/CoreToolsCommonError"
            },
            "examples": {
              "application/json": {
                "error_code": "AgentArts.04000429",
                "error_msg": "The interface has been limited."
              }
            }
          },
          "500": {
            "description": "内部系统错误。",
            "schema": {
              "$ref": "#/definitions/CoreToolsCommonError"
            },
            "examples": {
              "application/json": {
                "error_code": "AgentArts.04000500",
                "error_msg": "Internal error"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CoreToolBasic": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "**参数解释:**\n工具ID。\n**取值范围:**\n符合UUID规则^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$的36位字符串。"
        },
        "name": {
          "type": "string",
          "description": "**参数解释:**\n工具的名称。\n**取值范围:**\n符合正则^[a-z][a-z0-9-]{0,38}[a-z0-9]$,即必须以小写字母开头,小写字母或数字结尾,中间可包含数字、小写字母、中划线,字符长度必须在2-40个字符之间。",
          "minLength": 2,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "description": "**参数解释:**\n工具的描述。\n**取值范围:**\n任意字符,长度不能超过4096个字符",
          "minLength": 0,
          "maxLength": 4096
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释:**\n创建时间。\n**取值范围:**\nISO 8601格式的时间字符串,例如:2026-04-09T08:29:59.922+00:00。"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释:**\n更新时间。\n**取值范围:**\nISO 8601格式的时间字符串,例如:2026-04-09T08:29:59.922+00:00。"
        },
        "execution_agency_name": {
          "type": "string",
          "description": "**参数解释:**\n为工具提供访问云服务的权限的IAM委托名。\n**取值范围:**\nIAM委托名长度必须在1-64个字符之间,字符规则以IAM服务校验规则为准。",
          "minLength": 1,
          "maxLength": 64
        },
        "agent_gateway_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "**参数解释:**\n工具入口的AgentGateway的ID。\n**取值范围:**\n符合UUID规则 ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$的36位字符串。",
          "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
        },
        "workload_identity": {
          "$ref": "#/definitions/CoreToolsWorkloadIdentity",
          "description": "**参数解释:**\n认证信息。\n**取值范围:**\n不涉及。"
        },
        "access_endpoint": {
          "type": "string",
          "minLength": 16,
          "maxLength": 71,
          "pattern": "^https://(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,}$",
          "description": "**参数解释:**\n访问域名。\n**取值范围:**\n不涉及。",
          "example": "https://xxxx.agentarts.cn-north-4.xxx.com"
        },
        "observability": {
          "description": "**参数解释:**\n可观测性信息。\n**取值范围:**\n不涉及。",
          "$ref": "#/definitions/CoreToolsObservability"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CoreToolsTag"
          },
          "minItems": 0,
          "maxItems": 50,
          "description": "**参数解释:**\n资源标签。\n**取值范围:**\n不涉及。"
        },
        "status": {
          "type": "string",
          "description": "**参数解释:**\n工具状态。\n**取值范围:**\n- RUNNING:运行中。\n- DELETING:删除中。\n- DELETE_FAILED:删除失败。",
          "readOnly": true
        }
      }
    },
    "ListCoreCodeInterpretersResponseBody": {
      "allOf": [
        {
          "$ref": "#/definitions/CorePaginatedResponse"
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/CoreToolBasic"
              },
              "minItems": 0,
              "maxItems": 50,
              "description": "**参数解释:**\n查询列表数组\n**取值范围:**\n不涉及"
            }
          },
          "required": [
            "items"
          ]
        }
      ]
    },
    "CoreToolsLogsConfig": {
      "type": "object",
      "description": "日志采集配置。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "**参数解释:**\n是否开启日志采集。\n- 未开启,工具运行过程产生的日志无法上报至云日志服务(LTS)。\n- 开启后,工具运行过程产生的日志会上报至云日志服务(LTS)。\n\n**约束限制:**\n不涉及。\n**取值范围:**\n- true打开。\n- false关闭。\n\n**默认取值:**\nfalse。",
          "default": false,
          "example": true
        },
        "group_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "**参数解释:**\n工具的日志组ID。\n**约束限制:**\n当前不支持更新、指定。\n**取值范围:**\n长度不能超过64个字符。\n**默认取值:**\n不涉及。",
          "example": "xx-xx"
        },
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "**参数解释:**\n工具的日志流ID。\n**约束限制:**\n当前不支持更新、指定。\n**取值范围:**\n长度不能超过64个字符。\n**默认取值:**\n不涉及。",
          "example": "end_user_lts_stream"
        }
      }
    },
    "CoreToolsTag": {
      "type": "object",
      "description": "标签。",
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n标签键。\n**约束限制:**\n不能为空,且单个资源标签键不能重复。\n**取值范围:**\n符合规则^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)(?<!\\s)$,即可以包含任意语种的字母、数字和空格,以及_.:=+-@字符,但首尾不能包含空格,且不能以_sys_开头,且长度在1到128之间。\n**默认取值:**\n不涉及。",
          "example": "environment",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^((?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)(?<!\\s)$"
        },
        "value": {
          "type": "string",
          "description": "**参数解释:**\n标签值。\n**约束限制:**\n不涉及。\n**取值范围:**\n符合规则^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$,即可以包含任意语种的字母、数字和空格,以及_.:/=+-@字符,且长度不能超过255个字符。\n**默认取值:**\n不涉及",
          "example": "production",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*)$"
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    "CoreToolsTracingObservabilityConfig": {
      "type": "object",
      "description": "调用链采集配置。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "**参数解释:**\n是否开启调用链采集。\n**约束限制:**\n不涉及。\n**取值范围:**\n- true 开启。\n- false 关闭。\n**默认取值:**\nfalse。",
          "default": false,
          "example": true
        },
        "service_group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "**参数解释:**\n调用链服务组名。\n**约束限制:**\n不涉及。\n**取值范围:**\n长度不能超过64个字符。\n**默认取值:**\n不涉及。",
          "example": "app-user"
        }
      }
    },
    "CoreToolsAuthorizationError": {
      "allOf": [
        {
          "$ref": "#/definitions/CoreToolsCommonError"
        },
        {
          "type": "object",
          "properties": {
            "encoded_authorization_message": {
              "type": "string",
              "description": "**参数解释:**\n编码后的授权失败信息,可找IAM服务oncall提供解码方式获取详细授权失败原因。\n**取值范围:**\n不涉及。",
              "minLength": 1,
              "maxLength": 4096
            },
            "details": {
              "type": "array",
              "description": "**参数解释:**\n依赖的下游服务错误信息列表。\n**取值范围:**\n不涉及。",
              "minItems": 0,
              "maxItems": 10,
              "items": {
                "$ref": "#/definitions/CoreToolsCommonError"
              }
            }
          }
        }
      ]
    },
    "CorePaginatedResponse": {
      "type": "object",
      "description": "分页响应基础结构。",
      "properties": {
        "total_count": {
          "type": "integer",
          "description": "**参数解释:**\n总记录数。\n**取值范围:**\n正整数。",
          "minimum": 0,
          "maximum": 1000000,
          "example": 1
        }
      },
      "required": [
        "total_count"
      ]
    },
    "CoreToolsMetricsObservabilityConfig": {
      "type": "object",
      "description": "自定义指标采集详细配置。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "**参数解释:**\n是否开启自定义指标采集。\n**约束限制:**\n不涉及。\n**取值范围:**\n- true 开启。\n- false 关闭。\n**默认取值:**\nfalse。",
          "default": false,
          "example": true
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "**参数解释:**\n自定义指标实例ID。\n**约束限制:**\n不涉及。\n**取值范围:**\n长度不能超过64个字符。\n**默认取值:**\n不涉及。",
          "example": "xx-xx"
        }
      }
    },
    "CoreToolsObservability": {
      "type": "object",
      "description": "可观测性配置(日志+指标)。",
      "properties": {
        "logs": {
          "$ref": "#/definitions/CoreToolsLogsConfig",
          "description": "**参数解释:**\n工具的日志配置。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "metrics": {
          "$ref": "#/definitions/CoreToolsMetricsObservabilityConfig",
          "description": "**参数解释:**\n工具的自定义指标采集详细配置。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        },
        "tracing": {
          "$ref": "#/definitions/CoreToolsTracingObservabilityConfig",
          "description": "**参数解释:**\n工具的调用链采集配置。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        }
      }
    },
    "CoreToolsWorkloadIdentityUrn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "工作负载身份的URN。",
      "example": "agentarts:cn-north-7:123456789:codeInterpreter:123312"
    },
    "CoreToolsCommonError": {
      "type": "object",
      "properties": {
