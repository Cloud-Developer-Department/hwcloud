{
  "name": "ListOpsEvaluationModels",
  "summary": "获取模型信息",
  "tags": "模型管理",
  "productshort": "AgentArts",
  "region_id": "cn-east-4",
  "paths": {
    "/v1/ops/evaluation-models": {
      "get": {
        "tags": [
          "EvaluationModel"
        ],
        "summary": "获取模型信息",
        "description": "该接口用于获取系统中所有可用的基础大模型及微调模型的详细列表,涵盖模型能力类型、状态及访问参数。",
        "operationId": "ListOpsEvaluationModels",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "获取大模型信息列表成功",
            "examples": {
              "application/json": {
                "models": [
                  {
                    "model_id": "mod_llama3_70b_001",
                    "model_name": "Llama-3-70B-Instruct"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListOpsEvaluatorModelsResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "GET https://*.com/agentarts/v1/ops/evaluation-models",
        "x-request-examples-description-1": "获取当前租户下所有可用的评估模型列表,用于评测任务的资源选型。",
        "x-request-examples-text-1": "",
        "x-request-examples-1": "",
        "x-open-api": true,
        "x-api-type": "open-api",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-service-plane": "Management-plane",
        "x-sec-data-level": "L4",
        "x-order": 0
      }
    }
  },
  "definitions": {
    "ListOpsEvaluatorModelsResponseBody": {
      "type": "object",
      "required": [
        "models"
      ],
      "properties": {
        "models": {
          "type": "array",
          "description": "**参数解释:**\n模型信息的列表,包含多个模型的配置参数、阈值范围以及支持的业务场景。\n**取值范围:**\n符合模型定义的对象数组。",
          "items": {
            "type": "object",
            "properties": {
              "max_tokens_top": {
                "type": "integer",
                "format": "int32",
                "example": 4096,
                "description": "**参数解释:**\n模型生成文本的最大Token长度上限。\n**取值范围:**\n0到2,147,483,647之间的整数。",
                "minimum": 0,
                "maximum": 2147483647
              },
              "max_tokens_bottom": {
                "type": "integer",
                "format": "int32",
                "example": 256,
                "description": "**参数解释:**\n模型生成文本的最大Token长度下限配置值。\n**取值范围:**\n0到2,147,483,647之间的整数。",
                "minimum": 0,
                "maximum": 2147483647
              },
              "model_id": {
                "type": "string",
                "example": "1749615085",
                "description": "**参数解释:**\n模型的唯一标识符ID。\n**取值范围:**\n系统生成的唯一标识符。",
                "minLength": 0,
                "maxLength": 100
              },
              "model_name": {
                "type": "string",
                "example": "豆包·1.6·深度思考",
                "description": "**参数解释:**\n模型的显示名称。\n**取值范围:**\n任意字符串。",
                "minLength": 0,
                "maxLength": 100
              },
              "temperature_top": {
                "type": "string",
                "example": "0.9",
                "description": "**参数解释:**\n模型生成随机性(Temperature)的上限值。\n**取值范围:**\n符合浮点数格式的字符串。",
                "minLength": 0,
                "maxLength": 10000
              },
              "temperature_bottom": {
                "type": "string",
                "example": "0.1",
                "description": "**参数解释:**\n模型生成随机性(Temperature)的下限值。\n**取值范围:**\n符合浮点数格式的字符串。",
                "minLength": 0,
                "maxLength": 10000
              },
              "top_p_top": {
                "type": "string",
                "example": "0.95",
                "description": "**参数解释:**\n核采样(TopP)的概率上限值。\n\n**取值范围:**\n符合浮点数格式的字符串。",
                "minLength": 0,
                "maxLength": 10000
              },
              "top_p_bottom": {
                "type": "string",
                "example": "0.85",
                "description": "**参数解释:**\n核采样(TopP)的概率下限值。\n**取值范围:**\n符合浮点数格式的字符串。",
                "minLength": 0,
                "maxLength": 10000
              },
              "supported_scenes": {
                "type": "array",
                "description": "**参数解释:**\n模型支持的应用场景列表。\n**取值范围:**\n- evaluators: 评估器场景,用于评估任务。\n- datasets-synthesis: 数据合成场景,用于生成评测数据集。",
                "items": {
                  "type": "string",
                  "enum": [
                    "evaluators",
                    "datasets-synthesis"
                  ]
                },
                "maxItems": 100,
                "minItems": 0
              }
            },
            "required": [
              "max_tokens_bottom",
              "max_tokens_top",
              "model_id",
              "model_name",
              "supported_scenes",
              "temperature_bottom",
              "temperature_top",
              "top_p_bottom",
              "top_p_top"
            ]
          },
          "maxItems": 10000,
          "minItems": 0
        }
      },
      "description": "**参数解释:**\n获取可用模型列表信息的响应体。\n**取值范围:**\n不涉及。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "agentarts.cn-east-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}