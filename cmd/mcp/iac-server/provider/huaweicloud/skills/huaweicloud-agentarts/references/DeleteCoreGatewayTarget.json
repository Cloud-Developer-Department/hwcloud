  "region_id": "cn-east-4",
  "paths": {
    "/v1/core/gateways/{gateway_id}/targets/{target_id}": {
      "delete": {
        "operationId": "DeleteCoreGatewayTarget",
        "summary": "删除目标服务",
        "description": "永久删除指定目标服务。",
        "tags": [
          "网关后端管理"
        ],
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-api-service-plane": "Control-plane",
        "x-is-registered": "Y",
        "x-sec-data-level": "L3",
        "x-apigateway-request-type": "public",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "parameters": [
          {
            "name": "gateway_id",
            "in": "path",
            "description": "**参数解释:**\n网关的唯一标识符。\n网关ID获取方式:\n1. 进入AgentArts平台,在左侧导航栏选择“开发中心 > 组件库 ”,选择“网关”页签。\n2. 在网关列表中“网关名称/ID”处复制网关ID即可。\n**约束限制:**\n不涉及。\n**取值范围:**\n匹配标准的UUID格式(8-4-4-4-12的十六进制数字串,由连字符分隔),符合正则条件^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          {
            "name": "target_id",
            "in": "path",
            "description": "**参数解释:**\n目标服务的唯一标识符。\n**约束限制:**\n不涉及。\n**取值范围:**\n匹配标准的UUID格式(8-4-4-4-12的十六进制数字串,由连字符分隔),符合正则条件^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        ],
        "responses": {
          "204": {
            "description": "目标服务删除成功"
          },
          "400": {
            "description": "无效的请求参数",
            "schema": {
              "$ref": "#/definitions/CoreGatewayCommonError"
            },
            "examples": {
              "application/json": {
                "error_code": "AgentArts.02000002",
                "error_msg": "请求参数不正确"
              }
            }
          },
          "404": {
            "description": "网关或目标服务未找到",
            "schema": {
              "$ref": "#/definitions/CoreGatewayCommonError"
            },
            "examples": {
              "application/json": {
                "error_code": "AgentArts.02000201",
                "error_msg": "网关或目标服务未找到"
              }
            }
          },
          "500": {
            "description": "内部服务器错误",
            "schema": {
              "$ref": "#/definitions/CoreGatewayCommonError"
