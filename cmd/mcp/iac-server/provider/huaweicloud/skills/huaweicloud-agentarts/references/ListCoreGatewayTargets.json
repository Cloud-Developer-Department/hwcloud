{
  "name": "ListCoreGatewayTargets",
  "summary": "列出目标服务",
  "tags": "网关后端管理",
  "productshort": "AgentArts",
  "region_id": "cn-east-4",
  "paths": {
    "/v1/core/gateways/{gateway_id}/targets": {
      "get": {
        "operationId": "ListCoreGatewayTargets",
        "summary": "列出目标服务",
        "description": "列出指定网关的所有目标服务,支持分页功能。",
        "tags": [
          "网关后端管理"
        ],
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "x-api-service-plane": "Control-plane",
        "x-is-registered": "Y",
        "x-sec-data-level": "L3",
        "x-apigateway-request-type": "public",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "parameters": [
          {
            "name": "gateway_id",
            "in": "path",
            "description": "**参数解释:**\n网关的唯一标识符。\n网关ID获取方式:\n1. 进入AgentArts平台,在左侧导航栏选择“开发中心 > 组件库 ”,选择“网关”页签。\n2. 在网关列表中“网关名称/ID”处复制网关ID即可。\n**约束限制:**\n不涉及。\n**取值范围:**\n匹配标准的UUID格式(8-4-4-4-12的十六进制数字串,由连字符分隔),符合正则条件^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$。\n**默认取值:**\n不涉及。",
            "required": true,
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数解释:**\n返回的最大结果数。\n**约束限制:**\n不涉及。\n**取值范围:**\n整数类型,取值为1-100。\n**默认取值:**\n50",
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数解释:**\n返回结果偏移量。\n**约束限制:**\n不涉及。\n**取值范围:**\n整数类型,取值为1-100000。\n**默认取值:**\n0",
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 100000,
            "default": 0
          }
        ],
        "responses": {
          "200": {
            "description": "成功检索目标服务列表",
            "schema": {
              "$ref": "#/definitions/ListCoreGatewayTargetsResponseBody"
            },
            "examples": {
              "application/json": {
                "targets": [
                  {
                    "target_id": "25497155-11d8-44ca-be20-8ab1904a4107",
                    "gateway_id": "b2fc0463-8b28-46c5-87ba-6267295ffc57",
                    "name": "my-target",
                    "status": "ready",
                    "target_type": "mcp_server",
                    "created_at": "2024-01-15T10:30:00Z",
                    "updated_at": "2024-01-15T10:30:00Z"
                  }
                ],
                "size": 1,
                "total": 1
              }
            }
          },
          "400": {
            "description": "无效的请求参数",
            "schema": {
              "$ref": "#/definitions/CoreGatewayCommonError"
            },
            "examples": {
              "application/json": {
                "error_code": "AgentArts.02000002",
                "error_msg": "请求参数不正确"
              }
            }
          },
          "404": {
            "description": "网关未找到",
            "schema": {
              "$ref": "#/definitions/CoreGatewayCommonError"
            },
            "examples": {
              "application/json": {
                "error_code": "AgentArts.02000102",
                "error_msg": "网关未找到"
              }
            }
          },
          "500": {
            "description": "内部服务器错误",
            "schema": {
              "$ref": "#/definitions/CoreGatewayCommonError"
            },
            "examples": {
              "application/json": {
                "error_code": "AgentArts.02000500",
                "error_msg": "内部服务器错误"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ListCoreGatewayTargetsResponseBody": {
      "type": "object",
      "required": [
        "targets",
        "size",
        "total"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CoreGatewayTargetSummary"
          },
          "description": "**参数解释:**\n目标服务列表。\n**取值范围:**\n数组长度为 0-100。",
          "minItems": 0,
          "maxItems": 100
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 100,
          "description": "**参数解释:**\n当前页返回的目标服务数量。\n**取值范围:**\n取值为 0-100。"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1000000,
          "description": "**参数解释:**\n目标服务总数。\n**取值范围:**\n取值为 0-1000000。"
        }
      }
    },
    "CoreGatewayCommonError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n错误码。\n**取值范围:**\n取值为固定18个字符,匹配以 AgentArts. 开头、后接恰好8位数字的字符串,符合正则条件^AgentArts\\.[0-9]{8}$。",
          "pattern": "^AgentArts\\.[0-9]{8}$",
          "minLength": 18,
          "maxLength": 18,
          "example": "AgentArts.02000000"
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n错误消息。\n**取值范围:**\n取值为 1-256 个字符,匹配由字母、数字、空格、中文汉字以及常见中英文标点符号组成的非空字符串,符合正则条件^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()''\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "error_reason": {
          "type": "string",
          "description": "**参数解释:**\n错误原因。\n**取值范围:**\n取值为 1-256 个字符,匹配由字母、数字、空格、中文汉字以及常见中英文标点符号组成的非空字符串,符合正则条件^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()''\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "error_suggestion": {
          "type": "string",
          "description": "**参数解释:**\n错误处理建议。\n**取值范围:**\n取值为 1-256 个字符,匹配由字母、数字、空格、中文汉字以及常见中英文标点符号组成的非空字符串,符合正则条件^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()''\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "CoreGatewayTargetSummary": {
      "type": "object",
      "required": [
        "target_id",
        "gateway_id",
        "name",
        "status",
        "target_type",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "**参数解释:**\n目标服务的唯一标识符。\n**取值范围:**\n匹配标准的UUID格式(8-4-4-4-12的十六进制数字串,由连字符分隔),符合正则条件^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$。"
        },
        "gateway_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "**参数解释:**\n所属网关的标识符。\n**取值范围:**\n匹配标准的UUID格式(8-4-4-4-12的十六进制数字串,由连字符分隔),符合正则条件^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$。"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,48}[a-zA-Z0-9])?$",
          "description": "**参数解释:**\n目标服务名称。\n**取值范围:**\n长度为 1-50 个字符,匹配以字母数字开头和结尾、中间可含0到48个字母数字或短横线的字符串,符合正则条件^[a-zA-Z0-9]\\([a-zA-Z0-9-]{0,48}[a-zA-Z0-9])?$。",
          "minLength": 1,
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "enum": [
            "creating",
            "updating",
            "ready",
            "failed",
            "deleting",
            "synchronize_pending",
            "synchronizing",
            "active",
            "inactive"
          ],
          "description": "**参数解释:**\n目标服务状态。\n**取值范围:**\n- `creating`: 创建中\n- `updating`: 更新中\n- `ready`: 就绪可用\n- `failed`: 失败\n- `deleting`: 删除中\n- `synchronize_pending`: 等待同步中\n- `synchronizing`: 同步中\n- `active`: 在线\n- `inactive`: 离线"
        },
        "inactive_reason": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1,
          "description": "**参数解释:**\n目标服务离线状态原因。\n**取值范围:**\n长度为 1-100 个字符。"
        },
        "target_type": {
          "type": "string",
          "enum": [
            "mcp_server",
            "openapi"
          ],
          "description": "**参数解释:**\n目标服务类型。\n**取值范围:**\n- `mcp_server`: MCP 服务器\n- `openapi`: 基于 OpenAPI 规范的 REST API"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释:**\n创建时间。\n**取值范围:**\n不涉及。"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释:**\n更新时间。\n**取值范围:**\n不涉及。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "agentarts.cn-east-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}