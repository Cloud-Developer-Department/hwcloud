        "x-support-sdk": "Y",
        "x-api-service-plane": "Management-plane",
        "x-sec-data-level": "L4"
      }
    }
  },
  "definitions": {
    "OpsItemDetail": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "507f1f77bcf86cd799439011",
          "description": "**参数解释:**\n数据条目的唯一标识符。\n**取值范围:**\n通常为符合 MongoDB ObjectID 规范的 24 位十六进制字符串。",
          "minLength": 0,
          "maxLength": 100
        },
        "turns": {
          "type": "array",
          "description": "**参数解释:**\n包含该条目具体业务内容的轮次数据列表,支持多轮对话格式。\n**取值范围:**\n符合OpsTurn定义的对象数组。",
          "items": {
            "$ref": "#/definitions/OpsTurn"
          },
          "maxItems": 10000,
          "minItems": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "example": "2024-01-15T10:30:00Z",
          "description": "**参数解释:**\n该条目被首次创建的时间。\n**取值范围:**\nUTC 时间字符串。"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "example": "2024-01-15T10:30:00Z",
          "description": "**参数解释:**\n该条目最后一次被修改的时间。\n**取值范围:**\nUTC 时间字符串。"
        }
      },
      "description": "**参数解释:**\n评测集中具体条目的详细信息。\n**取值范围:**\n不涉及。"
    },
