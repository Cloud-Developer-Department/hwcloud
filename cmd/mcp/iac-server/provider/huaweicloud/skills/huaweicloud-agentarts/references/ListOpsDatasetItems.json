{
  "name": "ListOpsDatasetItems",
  "summary": "获取评测集条目列表",
  "tags": "评测集管理",
  "productshort": "AgentArts",
  "region_id": "cn-east-4",
  "paths": {
    "/v1/ops/datasets/{dataset_id}/items": {
      "get": {
        "tags": [
          "Dataset"
        ],
        "summary": "获取评测集条目列表",
        "description": "该接口用于分页检索指定评测集的具体数据记录,支持查看当前草稿态数据或特定历史发布版本的数据样本。\n适用场景:\n- 内容预览:在评测集详情页分页展示具体的数据行,供用户直观核查数据质量。\n- 版本溯源:通过指定版本ID,检索并对比历史发布版本中的样本数据。",
        "operationId": "ListOpsDatasetItems",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "description": "**参数解释:**\n评测集的唯一标识符(ID)\n**约束限制:**\n由英文、数字、“-”、“_”组成,长度为1到64个字符。\n**取值范围:**\n由英文、数字、连字符(-)、下划线(_)组成的1-64位字符串。\n**默认取值:**\n无。",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "name": "version_id",
            "in": "query",
            "description": "**参数解释:**\n评测集的版本标识符(ID),用于指定查询特定历史版本下的数据条目。\n**约束限制:**\n字符串长度限制为0到100个字符。\n**取值范围:**\n有效的版本ID字符串。\n**默认取值:**\n若为空,默认指向当前的草稿版本(Draft)。",
            "required": false,
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数解释:**\n分页查询的起始偏移量。用于指定从满足条件的第几条记录开始返回,常与 limit参数配合实现分页功能。\n**约束限制:**\n必须为整数,且大小在0到10,000之间。\n**取值范围:**\n0-10000。\n**默认取值:**\n0。",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 10000,
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数解释:**\n单次查询返回的最大记录数量。用于控制分页查询时每页显示的数据条数。\n**约束限制:**\n必须为整数,且大小在1到100之间。\n**取值范围:**\n1-100。\n**默认取值:**\n10。",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 100,
            "minimum": 1
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "examples": {
              "application/json": {
                "total": 1,
                "items": [
                  {
                    "id": "69db711057456f5c7d422aa9",
                    "turns": [
                      {
                        "fields": {
                          "input": {
                            "type": "String",
                            "content_type": "text",
                            "value": "中国首都是哪里"
                          },
                          "reference_output": {
                            "type": "String",
                            "content_type": "text",
                            "value": "北京"
                          }
                        }
                      }
                    ],
                    "created_at": "2026-04-12T10:16:48Z",
                    "updated_at": "2026-04-12T10:16:48Z"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListOpsDatasetItemsResponseBody"
            }
          }
        },
        "x-request-examples-url-1": "https://*.com/agentarts/v1/ops/datasets/8a77718d-ce32-40f6-aca1-8ef4ffd339fa/items?offset=0&limit=100",
        "x-request-examples-description-1": "分页查看评测集 \"8a77718d...\" 中的数据项,包含具体的输入问题和参考答案。",
        "x-request-examples-text-1": "",
        "x-request-examples-1": "",
        "x-api-framework": "RestfulAPI",
