          "additionalProperties": {
            "$ref": "#/definitions/OpsFieldValue"
          }
        }
      },
      "description": "**参数解释:**\n定义对话或数据记录中的单次交互轮次。\n**取值范围:**\n不涉及。"
    },
    "OpsFieldValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "example": "string",
          "description": "**参数解释:**\n字段的数据类型。\n**取值范围:**\n如 string, integer, float 等。",
          "minLength": 0,
          "maxLength": 10000
