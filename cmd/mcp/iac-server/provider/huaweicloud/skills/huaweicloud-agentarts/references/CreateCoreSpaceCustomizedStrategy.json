  "definitions": {
    "CreateCoreSpaceCustomizedStrategyRequestBody": {
      "type": "object",
      "description": "**参数解释:**\n记忆策略配置,定义记忆的抽取、合并等处理流程。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
      "required": [
        "name",
        "type",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9-]{1,48}$",
          "description": "**参数解释:** \n策略名。\n**约束限制:** \n仅支持字母、数字和中划线。\n**取值范围:** \n长度1-48字符。\n**默认取值:**\n不涉及。"
        },
        "type": {
          "type": "string",
          "description": "**参数解释:**\n策略类型,决定记忆的存储和使用方式。\n**约束限制:**\n不涉及。\n**取值范围:**\n*semantic*: 语义记忆\n*summary*: 摘要记忆\n*user_preference*: 用户偏好\n*episodic*: 情景记忆\n**默认取值:**\n不涉及。",
          "enum": [
            "semantic",
            "summary",
            "user_preference",
            "episodic"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "description": "**参数解释:**\n策略步骤列表,按 step_order 顺序执行。\n**约束限制:**\n数组长度0-20个。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "items": {
            "$ref": "#/definitions/CoreSpaceMemoryStrategyStepRequestBody"
          }
        }
      }
    },
    "CoreSpaceMemoryStrategyStepRequestBody": {
      "type": "object",
      "description": "**参数解释:**\n记忆策略执行步骤,定义策略中每个阶段的具体操作。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
      "required": [
        "step_order"
      ],
      "properties": {
        "step_order": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 20,
          "description": "**参数解释:**\n步骤执行顺序,从 1 开始。\n**约束限制:**\n不涉及。\n**取值范围:**\n1-20\n**默认取值:**\n不涉及。"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000,
          "description": "**参数解释:**\n步骤指令(Prompt 模板)。\n**约束限制:**\n长度不超过50000字符。\n**取值范围:**\n长度0-50000字符。\n**默认取值:**\n不传使用默认模板。"
        }
      }
    },
    "CreateCoreSpaceCustomizedStrategyResponseBody": {
      "type": "object",
      "description": "**参数解释:**\n记忆策略配置,定义记忆的抽取、合并等处理流程。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
      "required": [
        "id",
        "name",
        "type",
        "origin_type",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "**参数解释:**\n策略 ID。\n**取值范围:**\n不涉及。"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9-]{1,48}$",
          "description": "**参数解释:**\n策略名称。\n**取值范围:**\n不涉及。"
        },
        "type": {
          "type": "string",
          "description": "**参数解释:**\n策略类型。\n当前包含 4 种内置策略:\n- **semantic**:语义记忆提取(extraction → consolidation)\n- **user_preference**:用户偏好提取(extraction → consolidation)\n- **summary**:会话摘要生成(consolidation)\n- **episodic**:情景记忆提取(extraction → consolidation → reflection)       \n**取值范围:**\n不涉及。",
          "enum": [
            "semantic",
            "summary",
            "user_preference",
            "episodic"
          ]
        },
        "origin_type": {
          "type": "string",
          "description": "**参数解释:**\n策略来源类型。\n**取值范围:**\n- builtin: 系统内置\n- user: 用户自定义",
          "enum": [
            "builtin",
            "user"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "description": "**参数解释:**\n策略步骤列表。\n**取值范围:**\n0-20个。",
          "items": {
            "$ref": "#/definitions/CoreSpaceMemoryStrategyStep"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释:**\n创建时间,格式为 ISO 8601(YYYY-MM-DDTHH:mm:ssZ)。\n**取值范围:**\n不涉及。"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释:**\n更新时间,格式为 ISO 8601(YYYY-MM-DDTHH:mm:ssZ)。\n**取值范围:**\n不涉及。"
        }
      }
    },
    "AuthorizationError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n错误码,标识错误类型,格式为 AgentArts.XXXXXXXX。\n**取值范围:**\n不涉及。",
          "pattern": "^AgentArts\\.[0-9]{8}$",
          "minLength": 18,
          "maxLength": 18
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n错误信息,描述错误详情,供问题排查使用。\n**取值范围:**\n不涉及。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "**参数解释:**\n编码后的授权失败信息。\n**取值范围:**\n不涉及。",
          "minLength": 1,
          "maxLength": 4096
        },
        "details": {
          "type": "array",
          "description": "**参数解释:**\n依赖的下游服务错误信息列表,包含导致当前请求失败的下游服务错误详情。\n**取值范围:**\n不涉及。",
          "items": {
            "$ref": "#/definitions/CoreSpaceCommonError"
          },
          "minItems": 0,
          "maxItems": 10
        }
      }
    },
    "CoreSpaceCommonError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n错误码,标识错误类型,格式为 AgentArts.01XXXXXX。\n**取值范围:**\n不涉及。",
          "pattern": "^AgentArts\\.[0-9]{8}$",
          "minLength": 18,
          "maxLength": 18
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n错误信息,描述错误详情,供问题排查使用。\n**取值范围:**\n不涉及。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "CoreSpaceMemoryStrategyStep": {
      "type": "object",
      "description": "**参数解释:**\n记忆策略执行步骤(响应体)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
      "required": [
        "id",
        "step_order",
        "step_type",
        "enabled",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "**参数解释:**\n步骤 ID。\n**取值范围:**\n不涉及。"
        },
        "step_order": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 20,
          "description": "**参数解释:**\n步骤执行顺序。\n**取值范围:**\n不涉及。"
        },
        "step_type": {
          "type": "string",
          "description": "**参数解释:**\n步骤类型。\n**取值范围:**\n- extraction: 提取\n- consolidation: 合并\n- reflection: 反思",
          "enum": [
            "extraction",
            "consolidation",
            "reflection"
          ]
        },
        "isolation_level": {
          "type": "string",
          "description": "**参数解释:**\n隔离级别。\n**取值范围:**\n- actor: 按用户隔离\n- session: 按会话隔离\n- null: step_type=extraction时,isolation_level=null",
          "enum": [
            "actor",
            "session"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "**参数解释:**\n步骤指令。\n**取值范围:**\n不涉及。"
        },
        "output_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "**参数解释:**\n输出格式模板。\n**取值范围:**\n不涉及。"
        },
        "enabled": {
          "type": "boolean",
          "description": "**参数解释:**\n是否启用。\n**取值范围:**\n不涉及。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释:**\n创建时间,格式为 ISO 8601(YYYY-MM-DDTHH:mm:ssZ)。\n**取值范围:**\n不涉及。"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释:**\n更新时间,格式为 ISO 8601(YYYY-MM-DDTHH:mm:ssZ)。\n**取值范围:**\n不涉及。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "SpaceIdPath": {
      "name": "space_id",
      "in": "path",
      "required": true,
      "type": "string",
      "format": "uuid",
      "description": "**参数解释:** \n记忆库 ID,唯一标识一个记忆库,可以通过AgentArts智能体记忆库控制台或者记忆库查询接口获取。\n**约束限制:**\n仅支持字母、数字和中划线。\n**取值范围:**\n匹配标准的UUID格式(8-4-4-4-12的十六进制数字串,由连字符分隔),符合正则条件^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$。\n**默认取值:**\n不涉及。"
    }
  },
  "host": "agentarts.cn-east-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
