      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n系统定义的标准化错误代码。\n**取值范围:**\n业务异常编码字符串。",
