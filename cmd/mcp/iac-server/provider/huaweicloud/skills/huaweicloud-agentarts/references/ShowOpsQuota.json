{
  "name": "ShowOpsQuota",
  "summary": "获取当前项目的配额",
  "tags": "配额管理",
  "productshort": "AgentArts",
  "region_id": "cn-southwest-2",
  "paths": {
    "/v1/ops/quotas": {
      "get": {
        "tags": [
          "Quotas"
        ],
        "summary": "获取当前项目的配额",
        "description": "该接口用于获取当前项目的配额信息,支持查询各类任务的数量上限和剩余配额,适用于资源管理和容量规划的场景。\n适用场景:\n- 任务创建前查询当前项目的资源限制和剩余容量,避免因配额不足导致任务创建失败。\n- 查看各类任务的已用配额和总量,掌握项目的资源消耗状况。\n- 当配额接近上限时,通过查询结果进行容量规划和预警。",
        "operationId": "ShowOpsQuota",
        "parameters": [
          {
            "name": "task_type",
            "in": "query",
            "description": "**参数解释:**\n任务的类型分类标识。该参数用于在查询列表时进行过滤,以便区分并获取特定类别的任务(例如:评估任务、数据合成任务等)。\n**约束限制:**\n字符串长度为0-1,200。\n**取值范围:**\n0-1200字符。\n**默认取值:**\n不涉及。",
            "required": false,
            "type": "string",
            "maxLength": 1200,
            "minLength": 0
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "examples": {
              "application/json": {
                "quotas": [
                  {
                    "task_type": "evaluation",
                    "total_task_count": 10,
                    "free_task_quota_limit": 10
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowOpsQuotaResponseBody"
            }
          },
          "400": {
            "description": "请求错误",
            "examples": {
              "application/json": {
                "error_code": "AgentArts.03400001",
                "error_msg": "请求错误"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "GET https://*.com/agentarts/v1/ops/quotas",
        "x-request-examples-description-1": "请求获取当前项目的配额信息",
        "x-api-framework": "RestfulAPI",
        "x-api-user": "IAM普通租户",
        "x-open-api": true,
