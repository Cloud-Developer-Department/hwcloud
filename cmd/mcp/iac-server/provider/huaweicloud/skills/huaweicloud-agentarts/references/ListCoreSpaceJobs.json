  "definitions": {
    "ListCoreSpaceJobsResponseBody": {
      "type": "object",
      "required": [
        "jobs",
        "size",
        "total"
      ],
      "properties": {
        "jobs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "description": "**参数解释:**\n异步任务列表。\n**取值范围:**\n不涉及。",
          "items": {
            "$ref": "#/definitions/CoreSpaceJobSummary"
          }
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 100,
          "description": "**参数解释:**\n当前页返回的任务数量(条)。\n**取值范围:**\n不涉及。"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1000000,
          "description": "**参数解释:**\n任务总数(条)。\n**取值范围:**\n不涉及。"
        }
      }
    },
    "CoreSpaceJobSummary": {
      "type": "object",
      "description": "**参数解释:**\n异步任务摘要信息(用于列表接口)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
      "required": [
        "id",
        "job_name",
        "status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "**参数解释:**\n异步任务 ID,唯一标识一个异步任务,可通过创建异步任务的接口返回获取。\n**取值范围:**\n不涉及。"
        },
        "job_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "**参数解释:**\n异步任务名称,标识任务的类型。\n**取值范围:**\n- create_space: 创建记忆库\n- update_network: 更新网络配置\n- [待补充]: 其他任务类型"
        },
        "status": {
          "type": "string",
          "description": "**参数解释:**\n异步任务的当前执行状态。\n**取值范围:**\n- running: 执行中\n- success: 成功\n- failed: 失败",
          "enum": [
            "running",
            "success",
            "failed"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释:**\n记录的创建时间,由系统自动生成,格式为 ISO 8601(YYYY-MM-DDTHH:mm:ssZ)。\n**取值范围:**\n不涉及。"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释:**\n记录的最近更新时间,由系统自动更新,格式为 ISO 8601(YYYY-MM-DDTHH:mm:ssZ)。\n**取值范围:**\n不涉及。"
        }
      }
    },
    "AuthorizationError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n错误码,标识错误类型,格式为 AgentArts.XXXXXXXX。\n**取值范围:**\n不涉及。",
          "pattern": "^AgentArts\\.[0-9]{8}$",
          "minLength": 18,
          "maxLength": 18
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n错误信息,描述错误详情,供问题排查使用。\n**取值范围:**\n不涉及。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "**参数解释:**\n编码后的授权失败信息。\n**取值范围:**\n不涉及。",
          "minLength": 1,
          "maxLength": 4096
        },
        "details": {
          "type": "array",
          "description": "**参数解释:**\n依赖的下游服务错误信息列表,包含导致当前请求失败的下游服务错误详情。\n**取值范围:**\n不涉及。",
          "items": {
            "$ref": "#/definitions/CoreSpaceCommonError"
          },
          "minItems": 0,
          "maxItems": 10
        }
      }
    },
    "CoreSpaceCommonError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "**参数解释:**\n错误码,标识错误类型,格式为 AgentArts.01XXXXXX。\n**取值范围:**\n不涉及。",
          "pattern": "^AgentArts\\.[0-9]{8}$",
          "minLength": 18,
          "maxLength": 18
        },
        "error_msg": {
          "type": "string",
          "description": "**参数解释:**\n错误信息,描述错误详情,供问题排查使用。\n**取值范围:**\n不涉及。",
          "pattern": "^[a-zA-Z0-9\\s\\一-\\鿿.,!?;:()'\"\\-\\。\\，\\！\\？\\；\\：\\（\\）]+$",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "SpaceIdPath": {
      "name": "space_id",
      "in": "path",
      "required": true,
      "type": "string",
      "format": "uuid",
      "description": "**参数解释:** \n记忆库 ID,唯一标识一个记忆库,可以通过AgentArts智能体记忆库控制台或者记忆库查询接口获取。\n**约束限制:**\n仅支持字母、数字和中划线。\n**取值范围:**\n匹配标准的UUID格式(8-4-4-4-12的十六进制数字串,由连字符分隔),符合正则条件^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$。\n**默认取值:**\n不涉及。"
    }
  },
