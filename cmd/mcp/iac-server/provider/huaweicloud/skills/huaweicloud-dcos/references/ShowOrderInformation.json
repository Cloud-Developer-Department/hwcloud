{
  "name": "ShowOrderInformation",
  "summary": "获取服务服务单项目信息",
  "tags": "服务单管理",
  "productshort": "DCOS",
  "region_id": "cn-north-9",
  "paths": {
    "/v1/orders/information/{model_code}": {
      "get": {
        "tags": [
          "服务单管理"
        ],
        "summary": "获取服务服务单项目信息",
        "description": "获取服务服务单项目信息",
        "operationId": "ShowOrderInformation",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "model_code",
            "description": "服务单类型编码",
            "in": "path",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        ],
        "responses": {
          "200": {
            "description": "联系电话 & sop列表",
            "schema": {
              "$ref": "#/definitions/ProjectOrderInformation"
            }
          },
          "400": {
            "description": "错误信息",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-iam-auth-meta-anno": {
          "abacAction": "dcos:order:showOrderInformation",
          "authLevel": "NO_INSTANCE",
          "needResourceTagCheck": false,
          "needApigwJwtAuthCheck": true,
          "needAbacCheck": true,
          "needAbacResourceCheck": false,
          "supportAllGrantedEps": false,
          "needRbacCheck": true,
          "needCbcCheck": false,
          "model": "v5",
          "authContextInitializerName": "defaultIamAuthContextInitializer"
        },
        "x-order": 8
      }
    }
  },
  "definitions": {
    "DefaultSop": {
      "type": "object",
      "description": "默认的附件sop",
      "properties": {
        "file_cn_name": {
          "type": "string",
          "description": "中文版本文件名称",
          "example": "下电SOP.txt",
          "minLength": 1,
          "maxLength": 128
        },
        "file_cn_id": {
          "type": "string",
          "description": "中文版本文件id",
          "example": "454354",
          "minLength": 1,
          "maxLength": 128
        },
        "file_en_name": {
          "type": "string",
          "description": "英文版本文件名称"
        },
        "file_en_id": {
          "type": "string",
          "description": "英文版本文件id"
        },
        "ownership": {
          "type": "string",
          "description": "归属组织",
          "example": "hw",
          "minLength": 0,
          "maxLength": 8
        },
        "default_options": {
          "type": "boolean",
          "description": "是否默认"
        }
      },
      "required": [
        "default_options"
      ]
    },
    "UserPhone": {
      "type": "object",
      "description": "客户电话号码",
      "properties": {
        "id": {
          "type": "string",
          "description": "唯一标识",
          "minLength": 0
        },
        "country_code": {
          "type": "string",
          "description": "国家码",
          "example": "86",
          "minLength": 0,
          "maxLength": 10
        },
        "phone": {
          "type": "string",
          "description": "电话号码",
          "example": "130000000",
          "minLength": 0,
          "maxLength": 32
        },
        "default_option": {
          "type": "boolean",
          "description": "是否默认",
          "example": false
        }
      }
    },
    "ProjectOrderInformation": {
      "type": "object",
      "description": "服务单-项目信息",
      "properties": {
        "phone": {
          "type": "array",
          "description": "联系号码",
          "example": "+86-18888888888",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/UserPhone"
          }
        },
        "sop": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DefaultSop"
          },
          "description": "sop信息"
        }
      }
    },
    "ErrorRsp": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "编码",
          "minLength": 0,
          "maxLength": 200
        },
        "error_msg": {
          "type": "string",
          "description": "信息",
          "minLength": 0,
          "maxLength": 200
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dcos.cn-north-9.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}