{
  "name": "UploadFile",
  "summary": "上传附件",
  "tags": "文件管理",
  "productshort": "DCOS",
  "region_id": "cn-north-9",
  "paths": {
    "/v1/files/upload-file": {
      "post": {
        "tags": [
          "文件管理"
        ],
        "operationId": "UploadFile",
        "consumes": [
          "multipart/form-data"
        ],
        "summary": "上传附件",
        "description": "上传附件",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "scene_code",
            "in": "formData",
            "required": true,
            "description": "文件上传场景,如服务单附件上传:order",
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          },
          {
            "name": "file_name",
            "in": "formData",
            "required": true,
            "description": "文件名称,用户上传服务单附件的文件名",
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "description": "文件,用户上传的服务单附件",
            "type": "file"
          }
        ],
        "responses": {
          "200": {
            "description": "上传文件返回类,包括文件标识id, 文件名, 文件的大小",
            "schema": {
              "$ref": "#/definitions/UploadFileInfo"
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "This field is the request ID number for task tracking. Format is request_uuid-timestamp-hostname."
              }
            }
          },
          "400": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "This field is the request ID number for task tracking. Format is request_uuid-timestamp-hostname."
              }
            }
          }
        },
        "x-iam-auth-meta-anno": {
          "abacAction": "dcos::createFile",
          "authLevel": "NO_INSTANCE",
          "needResourceTagCheck": false,
          "needApigwJwtAuthCheck": true,
          "needAbacCheck": true,
          "needAbacResourceCheck": false,
          "supportAllGrantedEps": false,
          "needRbacCheck": true,
          "needCbcCheck": false,
          "model": "v5",
          "authContextInitializerName": "defaultIamAuthContextInitializer"
        }
      }
    }
  },
  "definitions": {
    "UploadFileInfo": {
      "type": "object",
      "description": "上传文件信息",
      "properties": {
        "file_name": {
          "type": "string",
          "description": "用户上传附件名称",
          "minLength": 0,
          "maxLength": 256
        },
        "file_id": {
          "type": "string",
          "description": "用户上传附件唯一id",
          "minLength": 0,
          "maxLength": 512
        },
        "file_type": {
          "type": "string",
          "description": "文件类型"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "用户上传附件大小",
          "minimum": 0,
          "maximum": 100000000
        }
      },
      "required": [
        "file_id"
      ]
    },
    "ErrorRsp": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "编码",
          "minLength": 0,
          "maxLength": 200
        },
        "error_msg": {
          "type": "string",
          "description": "信息",
          "minLength": 0,
          "maxLength": 200
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dcos.cn-north-9.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}