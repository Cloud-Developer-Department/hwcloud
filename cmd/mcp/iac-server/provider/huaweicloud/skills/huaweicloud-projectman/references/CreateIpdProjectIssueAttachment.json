{
  "name": "CreateIpdProjectIssueAttachment",
  "summary": "上传issue附件",
  "tags": "IPD项目接口",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/ipdprojectservice/projects/{project_id}/issues/{issue_id}/attachments/upload": {
      "post": {
        "tags": [
          "IPD项目接口"
        ],
        "summary": "上传issue附件",
        "operationId": "CreateIpdProjectIssueAttachment",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "pattern": "^[0-9a-z]{32}$",
            "required": true,
            "type": "string",
            "description": "devcloud项目的32位id"
          },
          {
            "name": "issue_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "工作项Id"
          },
          {
            "name": "attachment",
            "in": "formData",
            "required": true,
            "type": "file",
            "description": "附件文件, 最大上传大小为200M"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/AttachmentResponse"
            },
            "examples": {
              "application/json": "{\n    \"status\": \"success\",\n    \"message\": null,\n    \"result\": [\n        {\n            \"id\": \"885253285802455040\",\n            \"workitem_id\": \"885184223792504833\",\n            \"disk_directory\": \"/projects/a2647f4187a44cc7a3223dede0572d7b/attachments/66411944a2234067b33287cc35d43765.jpg\",\n            \"filesize\": \"41239\",\n            \"store_filename\": \"20210912-001541(WeLinkPC)1.jpg\",\n            \"title\": \"66411944a2234067b33287cc35d43765.jpg\",\n            \"description\": null,\n            \"attachment_type\": \"jpg\",\n            \"created_date\": \"1688990430000\"\n        }\n    ]\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "description": "上传issue附件",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-hcs-visible": "Y",
        "x-sre-api-type": "A1",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "Post https://{endpoint}/v1/ipdprojectservice/projects/a2647f4187a44cc7a3223dede0572d7b/issues/885184223792504833/attachments/upload"
      }
    }
  },
  "definitions": {
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "AttachmentVO": {
      "type": "object",
      "properties": {
        "attachment_type": {
          "type": "string",
          "description": "附件类型",
          "example": "jpg"
        },
        "created_by": {
          "type": "object",
          "description": "创建人信息"
        },
        "created_date": {
          "type": "string",
          "description": "创建时间",
          "example": "1688990430000"
        },
        "description": {
          "type": "string",
          "description": "附件描述",
          "example": "这是一个附件"
        },
        "disk_directory": {
          "type": "string",
          "description": "存储路径",
          "example": "/projects/a2647f4187a44cc7a3223dede055555b/attachments/66411944a2234067b33287cc35d45555.jpg"
        },
        "filesize": {
          "type": "string",
          "description": "文件大小",
          "example": "41239"
        },
        "id": {
          "type": "string",
          "description": "文件id",
          "example": "885253285802455040"
        },
        "modified_by": {
          "type": "object",
          "description": "更新人信息"
        },
        "store_filename": {
          "type": "string",
          "description": "文件名称",
          "example": "demo.jpg"
        },
        "title": {
          "type": "string",
          "description": "文件hash名称",
          "example": "66411944a2234067b33287cc35d43765.jpg"
        },
        "workitem_id": {
          "type": "string",
          "description": "工作项id",
          "example": "885184223792504833"
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    },
    "AttachmentResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "返回信息"
        },
        "result": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AttachmentVO"
          },
          "description": "返回附件对象"
        },
        "status": {
          "type": "string",
          "description": "返回状态"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "post",
  "uri": null
}