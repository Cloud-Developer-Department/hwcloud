{
  "name": "ShowProjectInfoV4",
  "summary": "获取项目详情",
  "tags": "项目信息",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}": {
      "get": {
        "tags": [
          "项目信息"
        ],
        "summary": "获取项目详情",
        "operationId": "ShowProjectInfoV4",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "pattern": "^[0-9a-z]{32}$",
            "required": true,
            "type": "string",
            "description": "devcloud项目的32位id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/GetProjectInfoV4Result"
            },
            "examples": {
              "application/json": "{\n  \"project\": {\n    \"project_num_id\": 3183801,\n    \"project_id\": \"41bd3eab86544863b8fc92ffcd35e3c8\",\n    \"name\": \"aaa\",\n    \"created_on\": 1576114296000,\n    \"updated_on\": 1576114296000,\n    \"project_type\": \"scrum\",\n    \"archive\": 1,\n    \"enterprise_id\": \"041bd3eab86544863b8f92ffcd35e218\",\n    \"project_code\": \"abc_123\",\n    \"creator\": {\n      \"user_num_id\": 4097,\n      \"user_id\": \"c4bd39f0573a436589714bedbcca8536\",\n      \"user_name\": \"mobile_user\",\n      \"domain_id\": \"2489d8cbba804db8bcd35384685ff3ac\",\n      \"domain_name\": \"mobile_user\",\n      \"nick_name\": \"Tom.M.Riddle\"\n    }\n  }\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "description": "获取项目详情",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "Get https://{endpoint}/v4/projects/0792b7d26cb74bd799cbae80063dc74a"
      }
    }
  },
  "definitions": {
    "GetProjectInfoV4Result": {
      "type": "object",
      "properties": {
        "project": {
          "type": "object",
          "description": "项目信息",
          "properties": {
            "project_num_id": {
              "type": "integer",
              "format": "int32",
              "description": "项目numId",
              "example": 3183801
            },
            "project_id": {
              "type": "string",
              "description": "项目uuid",
              "example": "41bd3eab86544863b8fc92ffcd35e3c8"
            },
            "name": {
              "type": "string",
              "description": "项目名称",
              "example": "aaa"
            },
            "created_on": {
              "type": "integer",
              "format": "int64",
              "description": "项目创建时间",
              "example": 1576114296000
            },
            "updated_on": {
              "type": "integer",
              "format": "int64",
              "description": "项目更新时间",
              "example": 1576114296000
            },
            "project_type": {
              "type": "string",
              "description": "项目类型",
              "example": "scrum"
            },
            "archive": {
              "type": "integer",
              "format": "int32",
              "description": "是否归档",
              "example": 1
            },
            "enterprise_id": {
              "type": "string",
              "description": "企业项目id",
              "example": "041bd3eab86544863b8f92ffcd35e218"
            },
            "project_code": {
              "type": "string",
              "description": "项目代号",
              "example": "abc_123"
            },
            "creator": {
              "type": "object",
              "description": "创建者信息",
              "properties": {
                "user_num_id": {
                  "type": "integer",
                  "format": "int32",
                  "description": "创建人num_id",
                  "example": 4097
                },
                "user_id": {
                  "type": "string",
                  "description": "创建人uuid",
                  "example": "c4bd39f0573a436589714bedbcca8536"
                },
                "user_name": {
                  "type": "string",
                  "description": "创建人姓名",
                  "example": "mobile_user"
                },
                "domain_id": {
                  "type": "string",
                  "description": "创建人租户id",
                  "example": "2489d8cbba804db8bcd35384685ff3ac"
                },
                "domain_name": {
                  "type": "string",
                  "description": "创建人租户名称",
                  "example": "mobile_user"
                },
                "nick_name": {
                  "type": "string",
                  "description": "创建人昵称",
                  "example": "Tom.M.Riddle"
                }
              }
            }
          }
        }
      }
    },
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
