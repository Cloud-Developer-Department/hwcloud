{
  "name": "UploadIssueImg",
  "summary": "上传图片",
  "tags": "Scrum项目的工作项",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v2/{project_id}/img": {
      "post": {
        "tags": [
          "Scrum项目的工作项"
        ],
        "summary": "上传图片",
        "operationId": "UploadIssueImg",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "devcloud项目的32位id"
          },
          {
            "name": "file",
            "in": "formData",
            "description": "图片文件",
            "required": true,
            "type": "file"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/IssueUploadImgV1Result"
            },
            "examples": {
              "application/json": {
                "img_id": 1,
                "img_url": "/v1/upload/0792b7d26cb74bd799cbae80063dc74a/202006/1591339394752881984.gif"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "x-request-examples-url-1": "Post https://{endpoint}/v2/99be3c6242d74ad180292a689f95d666/img",
        "x-request-examples-1": "Post https://{endpoint}/v2/99be3c6242d74ad180292a689f95d666/img",
        "deprecated": false,
        "description": "上传图片",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "IssueUploadImgV1Result": {
      "type": "object",
      "properties": {
        "img_id": {
          "type": "string",
          "description": "图片id",
          "example": 1
        },
        "img_url": {
          "type": "string",
          "description": "图片url v1改成v3作为下载图片请求",
          "example": "/v1/upload/0792b7d26cb74bd799cbae80063dc74a/202006/1591339394752881984.gif"
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "post",
  "uri": null
}