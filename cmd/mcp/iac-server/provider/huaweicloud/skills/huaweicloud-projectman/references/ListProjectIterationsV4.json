{
  "name": "ListProjectIterationsV4",
  "summary": "获取指定项目的迭代列表",
  "tags": "Scrum项目的迭代",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/iterations": {
      "get": {
        "tags": [
          "Scrum项目的迭代"
        ],
        "summary": "获取指定项目的迭代列表",
        "operationId": "ListProjectIterationsV4",
        "produces": [
          "*/*"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "minLength": 10,
            "maxLength": 32768,
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "devcloud项目的32位id",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-z]{32}$",
            "maxLength": 32,
            "minLength": 32,
            "x-example": "e2da96a5d2c845e284f0ad47f8ca8cb1"
          },
          {
            "name": "updated_time_interval",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "更新迭代的时间(查询的起始时间,查询的结束时间)",
            "x-example": "1576114296000,1576114396000"
          },
          {
            "in": "query",
            "name": "include_deleted",
            "type": "boolean",
            "description": "是否包含被删除的迭代,默认false不包含被删除的迭代",
            "x-example": false
          }
        ],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListProjectVersionsV4ResponseBody"
            },
            "examples": {
              "application/json": "{\n  \"total\": 3,\n  \"iterations\": [\n    {\n      \"description\": \"description\",\n      \"end_time\": \"2019-10-17\",\n      \"id\": 9725885,\n      \"name\": \"完成html\",\n      \"begin_time\": \"2019-10-10\",\n      \"status\": \"0\",\n      \"updated_time\": 1640231944000,\n      \"deleted\": false\n    }\n  ]\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "description": "获取项目迭代",
        "x-request-examples-url-1": "Get https://{endpoint}/v4/projects/e2da96a5d2c845e284f0ad47f8ca8cb1/iterations",
        "x-request-examples-1": "Get https://{endpoint}/v4/projects/e2da96a5d2c845e284f0ad47f8ca8cb1/iterations"
      }
    }
  },
  "definitions": {
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "ListProjectVersionsV4ResponseBody": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "迭代总数",
          "example": 3
        },
        "iterations": {
          "description": "迭代信息",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "description": "迭代描述",
                "example": "完成html"
              },
              "end_time": {
                "type": "string",
                "description": "迭代结束时间",
                "example": "2019-10-17"
              },
              "id": {
                "type": "integer",
                "format": "int32",
                "description": "迭代id",
                "example": 9725885
              },
              "name": {
                "type": "string",
                "description": "迭代标题",
                "example": "完成html"
              },
              "begin_time": {
                "type": "string",
                "description": "迭代开始时间",
                "example": "2019-10-10"
              },
              "status": {
                "type": "string",
                "description": "迭代状态",
                "example": "0"
              },
              "updated_time": {
                "type": "integer",
                "format": "int64",
                "description": "迭代更新时间,长整型时间戳",
                "example": 1640231944000
              },
              "deleted": {
                "type": "boolean",
                "description": "迭代是否已经删除,false, 未删除, true已经删除",
                "example": false
              }
            }
          }
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "get",
  "uri": null
}