{
  "name": "ListStatusStatistic",
  "summary": "查询迭代下工作项状态的统计数据(处理人维度)",
  "tags": "Scrum项目的工作项",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/status-statistic": {
      "get": {
        "tags": [
          "Scrum项目的工作项"
        ],
        "operationId": "ListStatusStatistic",
        "summary": "查询迭代下工作项状态的统计数据(处理人维度)",
        "description": "查询迭代下工作项状态的统计数据(处理人维度)",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "minLength": 10,
            "maxLength": 32768,
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "pattern": "^[0-9a-z]{32}$",
            "required": true,
            "type": "string",
            "description": "devcloud项目的32位id",
            "x-example": "2c42a6d37ccc4197bf0b3dbe91be021a"
          },
          {
            "name": "iteration_id",
            "in": "query",
            "required": true,
            "description": "迭代数字id",
            "x-example": 1234,
            "type": "integer",
            "format": "int32"
          },
          {
            "in": "query",
            "name": "tracker_id",
            "type": "integer",
            "format": "int32",
            "required": true,
            "description": "自定义字段支持的工作项类型 2任务/Task,3缺陷/Bug,7Story",
            "x-example": 7
          },
          {
            "name": "status_id",
            "in": "query",
            "required": true,
            "description": "工作项状态数字id",
            "type": "integer",
            "format": "int32",
            "x-example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/UserStatusStatistic"
              }
            },
            "examples": {
              "application/json": "[\n    {\n        \"user\": {\n            \"user_id\": \"112a642015cf11eca152fa163ec9f6c1\",\n            \"user_num_id\": 5055,\n            \"name\": \"devcloud_devcloud_test_01_05\"\n        },\n        \"item_count\": 1,\n        \"data\": {\n            \"5874579\": 1\n        }\n    },\n    {\n        \"user\": {\n            \"user_id\": \"1139ffb615cf11eca152fa163ec9f6c1\",\n            \"user_num_id\": 5255,\n            \"name\": \"devcloud_devcloud_test_01_test\"\n        },\n        \"item_count\": 1,\n        \"data\": {\n            \"5874580\": 1\n        }\n    },\n    {\n        \"user\": {\n            \"user_id\": \"a360371833bf4c558f796fd707b44daf\",\n            \"user_num_id\": 9078,\n            \"nick_name\": \"sstest5\",\n            \"name\": \"devcloud_devcloud_test_01\"\n        },\n        \"item_count\": 2,\n        \"data\": {\n            \"5874581\": 1,\n            \"5874584\": 1\n        }\n    },\n    {\n        \"user\": {\n            \"user_id\": \"D0XCOQMxQ9Nujj9lybk51lFEQzpdpzMc\",\n            \"user_num_id\": 15437,\n            \"name\": \"devcloud_devcloud_test_01_FederationUser\"\n        },\n        \"item_count\": 1,\n        \"data\": {\n            \"5874582\": 2\n        }\n    }\n]"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hws",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "IssueUser": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "description": "用户uuid",
          "example": "6d9b5b7052b549e79145ef218ec1cb6d"
        },
        "user_num_id": {
          "type": "integer",
          "format": "int32",
          "description": "用户数字id",
          "example": 1223
        },
        "id": {
          "type": "integer",
          "format": "int32",
          "example": 4091,
          "description": "用户id"
        },
        "name": {
          "type": "string",
          "example": "demo_user_name",
          "description": "用户名"
        },
        "nick_name": {
          "type": "string",
          "example": "张三",
          "description": "昵称"
        }
      }
    },
    "UserStatusStatistic": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/IssueUser"
        },
        "item_count": {
          "type": "integer",
          "format": "int32",
          "description": "满足条件的工作项总数"
        },
        "data": {
          "type": "object",
          "description": "工作项对应状态的统计计数",
          "additionalProperties": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
