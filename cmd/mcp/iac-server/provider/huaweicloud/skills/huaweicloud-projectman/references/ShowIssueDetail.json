{
  "name": "ShowIssueDetail",
  "summary": "查询工作项详情",
  "tags": "IPD工作项",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/ipdprojectservice/projects/{project_id}/issues/{issue_id}": {
      "get": {
        "tags": [
          "IPD工作项"
        ],
        "summary": "查询工作项详情",
        "operationId": "ShowIssueDetail",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "devcloud项目的32位id",
            "x-example": "39d30be0842e4e5d8e28ee7e1712c6a2"
          },
          {
            "name": "issue_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "工作项唯一Id",
            "x-example": 981935538274476033
          },
          {
            "name": "issue_type",
            "in": "query",
            "description": "工作项分类",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "x-example": "Bug"
          },
          {
            "name": "domain_id",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "项目所属domainId",
            "minLength": 18,
            "maxLength": 32
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应",
            "schema": {
              "$ref": "#/definitions/IssuesResponseBody"
            },
            "examples": {
              "application/json": "{\n  \"status\": \"success\",\n  \"message\": null,\n  \"result\": [\n    {\n      \"id\": \"1135239465657217024\",\n      \"number\": \"BUG20250530487304\",\n      \"title\": \"Test_bug_关键问题\",\n      \"type\": \"bug\",\n      \"stay_days\": 1,\n      \"tenant_id\": \"4e919d73499648e3b0292cd3cbef806a\",\n      \"created_date\": \"1748591780337\"\n    }\n  ]\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "description": "查询工作项详情",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/ipdprojectservice/projects/e4b0424709934bd1a54753e70336564d/issues/981935538274476033?issue_type=RR"
      }
    }
  },
  "definitions": {
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    },
    "IssuesResponseBody": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "状态",
          "minLength": 0,
          "maxLength": 512
        },
        "message": {
          "type": "string",
          "description": "信息",
          "minLength": 1,
          "maxLength": 512
        },
        "result": {
          "type": "array",
          "description": "查询结果",
          "items": {
            "type": "object",
            "additionalProperties": {
              "description": "信息",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "工作项ID"
                },
                "number": {
                  "type": "string",
                  "description": "工作项编号"
                },
                "title": {
                  "type": "string",
                  "description": "工作项标题"
                },
                "type": {
                  "type": "string",
                  "description": "工作项类型"
                },
                "stay_days": {
                  "type": "integer",
                  "format": "int32",
                  "description": "停留天数"
                },
                "tenant_id": {
                  "type": "string",
                  "description": "项目ID"
                },
                "created_date": {
                  "type": "string",
                  "description": "创建时间"
                }
              }
            }
          },
          "minItems": 0,
          "maxItems": 1000
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "get",
  "uri": null
}