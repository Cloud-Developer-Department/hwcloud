{
  "name": "ListIssueFields",
  "summary": "查询字段模板列表",
  "tags": "IPD工作项",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/ipdprojectservice/projects/{project_id}/categories/{category_id}/field/templates": {
      "get": {
        "tags": [
          "IPD工作项"
        ],
        "summary": "查询字段模板列表",
        "operationId": "ListIssueFields",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "devcloud项目的32位id",
            "x-example": "39d30be0842e4e5d8e28ee7e1712c6a2"
          },
          {
            "name": "category_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "工作项类型5位id",
            "x-example": 10001
          },
          {
            "name": "page",
            "in": "query",
            "required": true,
            "description": "页码",
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          },
          {
            "name": "size",
            "in": "query",
            "required": true,
            "description": "每页查询数据数量",
            "type": "integer",
            "format": "int32",
            "minimum": 10,
            "maximum": 1000
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应",
            "schema": {
              "$ref": "#/definitions/IssueFieldsResponseBody"
            },
            "examples": {
              "application/json": "{\n  \"page\": {\n    \"page\": 1,\n    \"size\": 10,\n    \"count\": 15\n  },\n  \"result\": [\n    {\n      \"display_name\": \"优先级\",\n      \"created_by\": \"系统\",\n      \"field_type\": \"pick\",\n      \"show_on_card\": false,\n      \"optional\": true,\n      \"all_options\": [\n        {\n          \"id\": \"1135144056192544813\",\n          \"code\": \"高\",\n          \"display_value\": \"高\",\n          \"value\": \"高\",\n          \"level\": 1,\n          \"sequence\": 1\n        }\n      ],\n      \"default_value\": \"\"\n    }\n  ]\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "description": "工作项类型中查询字段模板列表",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/ipdprojectservice/projects/05c7d8bcf3db4829bc841e4ba93aaea5/categories/10021/field/templates?page=1&size=10"
      }
    }
  },
  "definitions": {
    "PageVO": {
      "type": "object",
      "description": "分页参数返回体",
      "properties": {
        "page": {
          "type": "string",
          "format": "int",
          "example": 1,
          "description": "当前页"
        },
        "size": {
          "type": "string",
          "format": "int",
          "example": 200,
          "description": "每页条数"
        },
        "count": {
          "type": "string",
          "format": "int",
          "example": 3,
          "description": "数据总数"
        }
      }
