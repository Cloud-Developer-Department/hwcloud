        "id": {
          "type": "string",
          "example": 995623980368965648,
          "description": "选项id",
          "minLength": 2,
          "maxLength": 32
        },
        "code": {
          "type": "string",
          "example": "高",
          "description": "选项code值",
          "minLength": 1,
          "maxLength": 32
        },
        "display_value": {
          "type": "string",
          "example": "高",
          "description": "选项显示名称",
          "minLength": 2,
          "maxLength": 15
        },
        "value": {
          "type": "string",
          "example": 995629787545247744,
          "description": "选项唯一标识",
          "minLength": 0,
          "maxLength": 32
        },
        "level": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "选项层级。用于区分层级字段的层级",
          "minimum": 1,
          "maximum": 4
        },
        "sequence": {
          "type": "integer",
          "format": "int32",
          "description": "选项顺序",
          "minimum": 0,
          "maximum": 2147483647
        },
        "parent_id": {
          "type": "string",
          "description": "父选项id",
          "example": 1078369543904079872,
          "minLength": 2,
          "maxLength": 32
        }
      },
      "description": "字段选项"
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    },
    "IssueFieldsResponseBody": {
      "type": "object",
      "description": "查询字段模板列表返回值",
      "properties": {
        "page": {
          "description": "分页信息",
          "$ref": "#/definitions/PageVO"
        },
        "result": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FieldVO"
          },
          "description": "返回数据"
        }
      }
    }
