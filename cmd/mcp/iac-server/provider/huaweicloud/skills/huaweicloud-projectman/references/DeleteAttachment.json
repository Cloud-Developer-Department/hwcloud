            "type": "string",
            "description": "devcloud项目的32位id",
            "x-example": "2c42a6d37ccc4197bf0b3dbe91be021a"
          },
          {
            "name": "issue_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "工作项id",
            "x-example": "12234"
          },
          {
            "name": "attachment_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "附件id",
            "x-example": "1234"
          }
        ],
        "responses": {
