            "maxLength": 32,
            "minLength": 32,
            "description": "devcloud项目的32位id",
            "required": true,
            "type": "string",
            "x-example": "526cefde62004de2b62b5e8dd2c2b3af"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListBugStatisticResponseV4"
            },
            "examples": {
              "application/json": "{\n  \"bug_statistics\": [\n    {\n      \"critical_num\": 0,\n      \"defect_index\": 1,\n      \"module\": \"统计分数\",\n      \"normal_num\": 1,\n      \"serious_num\": 0,\n      \"tip_num\": 0,\n      \"total\": 1\n    }\n  ]\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "GET https://{endpoint}/v4/projects/526cefde62004de2b62b5e8dd2c2b3af/bug-statistic",
        "x-request-examples-1": "GET https://{endpoint}/v4/projects/526cefde62004de2b62b5e8dd2c2b3af/bug-statistic"
      }
    }
  },
