{
  "name": "UploadAttachments",
  "summary": "上传工作项附件",
  "tags": "Scrum项目的工作项",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/issues/{issue_id}/attachments/upload": {
      "post": {
        "tags": [
          "Scrum项目的工作项"
        ],
        "description": "上传工作项附件",
        "summary": "上传工作项附件",
        "operationId": "UploadAttachments",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目id",
            "x-example": "2c42a6d37ccc4197bf0b3dbe91be021a"
          },
          {
            "name": "issue_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "工作项id",
            "x-example": 123
          },
          {
            "name": "attachment",
            "in": "formData",
            "required": true,
            "type": "file",
            "description": "附件文件, 最大上传大小为50M"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/AttachmentAssociate"
            },
            "examples": {
              "application/json": {
                "id": "1234,",
                "issue_id": "1232,",
                "project_id": "2c42a6d37ccc4197bf0b3dbe91be021a",
                "disk_filename": "adfadsfasdfa.jpg",
                "file_name": "demo.jpg",
                "size": "1233"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "Post https://{endpoint}/v4/projects/0792b7d26cb74bd799cbae80063dc74a/attachments/upload"
      }
    }
  },
  "definitions": {
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "AttachmentAssociate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32",
          "description": "关联id"
        },
        "issue_id": {
          "type": "integer",
          "format": "int32",
          "description": "工作项id"
        },
        "project_id": {
          "type": "string",
          "description": "项目id"
        },
        "disk_filename": {
          "type": "string",
          "description": "云盘存贮名"
        },
        "file_name": {
          "type": "string",
          "description": "文件名"
        },
        "size": {
          "type": "string",
          "description": "文件大小"
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
