{
  "name": "ListWorkitemStatusRecordsV4",
  "summary": "查询看板项目下工作项的状态历史记录",
  "tags": "看板项目的工作项",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/work-items/status-records": {
      "get": {
        "tags": [
          "看板项目的工作项"
        ],
        "summary": "查询看板项目下工作项的状态历史记录",
        "description": "分页查询看板项目下工作项的状态历史记录",
        "operationId": "ListWorkitemStatusRecordsV4",
        "x-apiexplorer-hide": "N",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "minLength": 10,
            "maxLength": 32768,
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "devcloud项目的32位id",
            "pattern": "^[0-9a-z]{32}$",
            "maxLength": 32,
            "minLength": 32,
            "required": true,
            "type": "string",
            "x-example": "526cefde62004de2b62b5e8dd2c2b3af"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "description": "偏移量 从0开始",
            "minimum": 0,
            "default": 0
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "description": "每页数量 最小1,最大100",
            "maximum": 100,
            "minimum": 1,
            "default": 100
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ProjectWorkitemStatusRecords"
            },
            "examples": {
              "application/json": "{\n  \"records\": [\n    {\n      \"work_item_record_id\": \"7401906a85de466c81fd90e22824eb19\",\n      \"work_item_id\": \"4633454879781163008\",\n      \"project_id\": \"526cefde62004de2b62b5e8dd2c2b3af\",\n      \"work_item_statuses\": [\n        {\n          \"id\": \"7401906a85de466c81fd90e22824eb19\",\n          \"status\": {\n            \"id\": \"d25fe91f7f6b489db5f804e66ac3b360\",\n            \"name\": \"7401906a85de466c81fd90e22824eb19\",\n            \"type\": \"BACKLOG\",\n            \"description\": \"demo\",\n            \"parent_status_id\": \"7401906a85de466c81fd90e22824aaaa\"\n          }\n        }\n      ]\n    }\n  ],\n  \"total\": 1\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-open-region-cloud": "hws",
        "x-request-examples-url-1": "GET https://{endpoint}/v4/projects/526cefde62004de2b62b5e8dd2c2b3af/work-items/status-records",
        "x-request-examples-1": "GET https://{endpoint}/v4/projects/526cefde62004de2b62b5e8dd2c2b3af/work-items/status-records"
      }
    }
  },
  "definitions": {
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "WorkitemStatusRecords": {
      "type": "object",
      "properties": {
        "work_item_record_id": {
          "pattern": "^[0-9a-z]{32}$",
          "maxLength": 32,
          "minLength": 32,
          "description": "工作项的记录id,一个工作项对应一条记录",
          "type": "string",
          "example": "7401906a85de466c81fd90e22824eb19"
        },
        "work_item_id": {
          "description": "工作项id",
          "type": "string",
          "example": "4633454879781163008"
        },
        "project_id": {
          "pattern": "^[0-9a-z]{32}$",
          "maxLength": 32,
          "minLength": 32,
          "description": "devcloud项目的32位id",
          "type": "string",
          "example": "526cefde62004de2b62b5e8dd2c2b3af"
        },
        "work_item_statuses": {
          "type": "array",
          "description": "操作历史",
          "items": {
            "$ref": "#/definitions/WorkitemStatus"
          }
        }
      }
    },
    "ProjectWorkitemStatusRecords": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "description": "操作历史",
          "items": {
            "$ref": "#/definitions/WorkitemStatusRecords"
          }
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "总数"
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    },
    "WorkitemStatus": {
      "type": "object",
      "properties": {
        "id": {
          "pattern": "^[0-9a-z]{1,32}$",
          "maxLength": 32,
          "minLength": 1,
          "description": "工作项状态变更记录的id,每次变更产生一条新的记录id",
          "type": "string",
          "example": "7401906a85de466c81fd90e22824eb19"
        },
        "status": {
          "description": "工作项的状态",
          "type": "object",
          "properties": {
            "id": {
              "pattern": "^[0-9a-z]{1,32}$",
              "maxLength": 32,
              "minLength": 1,
              "description": "工作项的状态id",
              "type": "string",
              "example": "d25fe91f7f6b489db5f804e66ac3b360"
            },
            "name": {
              "maxLength": 60,
              "minLength": 1,
              "description": "状态名称",
              "type": "string",
              "example": "7401906a85de466c81fd90e22824eb19"
            },
            "type": {
              "description": "工作项状态的类型,\nBACKLOG( \"初始化\"),\nREADY(\"待启动\"),\nIN_PROGRESS(\"进行中\"),\nCOMPLETE(\"已完成\"),\nDONE(\"已结束\"),",
              "type": "string",
              "example": "BACKLOG"
            },
            "description": {
              "description": "工作项状态的描述",
              "type": "string",
              "example": "这个初始化的状态"
            },
            "parent_status_id": {
              "pattern": "^[0-9a-z]{1,32}$",
              "maxLength": 32,
              "minLength": 1,
              "description": "工作项状态的父状态id",
              "type": "string",
              "example": "7401906a85de466c81fd90e22824aaaa"
            }
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "get",
  "uri": null
}