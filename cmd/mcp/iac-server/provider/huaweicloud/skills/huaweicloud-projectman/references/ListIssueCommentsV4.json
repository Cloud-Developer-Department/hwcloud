{
  "name": "ListIssueCommentsV4",
  "summary": "获取指定工作项的评论列表",
  "tags": "Scrum项目的工作项",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/issues/{issue_id}/comments": {
      "get": {
        "tags": [
          "Scrum项目的工作项"
        ],
        "summary": "获取指定工作项的评论列表",
        "operationId": "ListIssueCommentsV4",
        "produces": [
          "*/*"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "minLength": 10,
            "maxLength": 32768,
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "devcloud项目的32位id",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-z]{32}$",
            "maxLength": 32,
            "minLength": 32,
            "x-example": "e2da96a5d2c845e284f0ad47f8ca8cb1"
          },
          {
            "name": "issue_id",
            "in": "path",
            "description": "工作项id",
            "required": true,
            "type": "integer",
            "format": "int32",
            "x-example": 123
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页索引,偏移量",
            "type": "integer",
            "format": "int32",
            "allowEmptyValue": true,
            "default": 0,
            "minimum": 0,
            "x-example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条数,最大显示100条",
            "type": "integer",
            "format": "int32",
            "allowEmptyValue": true,
            "default": 10,
            "maximum": 100,
            "minimum": 1,
            "x-example": 2
          }
        ],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/IssueCommentsResponseBodyV4"
            },
            "examples": {
              "application/json": "{\n  \"total\": 3,\n  \"comments\": [\n    {\n      \"comment\": \"<p>打的费</p>\",\n      \"id\": 2777430,\n      \"created_time\": \"2019-10-18\",\n      \"timestamp\": \"1684220287000\",\n      \"user\": {\n        \"user_num_id\": 4091,\n        \"user_name\": \"demo_user_name\",\n        \"nick_name\": \"name\"\n      }\n    }\n  ]\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "description": "获取工作项的评论",
        "x-request-examples-url-1": "Get https://{endpoint}/v4/projects/e2da96a5d2c845e284f0ad47f8ca8cb1/issues/1232495/comments",
        "x-request-examples-1": "Get https://{endpoint}/v4/projects/e2da96a5d2c845e284f0ad47f8ca8cb1/issues/1232495/comments"
      }
    }
  },
  "definitions": {
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "IssueCommentsResponseBodyV4": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "example": 3,
          "description": "评论总数"
        },
        "comments": {
          "description": "品论列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/IssueCommentV4"
          }
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    },
    "IssueCommentV4": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string",
          "description": "评论内容",
          "example": "<p>打的费</p>"
        },
        "id": {
          "type": "integer",
          "format": "int32",
          "description": "评论id",
          "example": 2777430
        },
        "created_time": {
          "type": "string",
          "example": "2019-10-18",
          "description": "评论时间"
        },
        "timestamp": {
          "type": "string",
          "example": "1684220287000",
          "description": "评论时间戳"
        },
        "user": {
          "$ref": "#/definitions/CommentUserV4"
        }
      }
    },
    "CommentUserV4": {
      "type": "object",
      "properties": {
        "user_num_id": {
          "type": "integer",
          "format": "int32",
          "description": "发表评论用户id",
          "example": 4091
        },
        "user_name": {
          "type": "string",
          "description": "发表评论用户名称",
          "example": "demo_user_name"
        },
        "nick_name": {
          "type": "string",
          "description": "发表评论用户昵称",
          "example": "我的名字要非常非常长才能测出问题"
        }
      },
      "title": "CommentUserV4"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "get",
  "uri": null
}