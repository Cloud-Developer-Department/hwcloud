{
  "name": "ShowIterationV4",
  "summary": "查看迭代详情",
  "tags": "Scrum项目的迭代",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/iterations/{iteration_id}": {
      "get": {
        "tags": [
          "Scrum项目的迭代"
        ],
        "summary": "查看迭代详情",
        "description": "查看迭代详情",
        "operationId": "ShowIterationV4",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "minLength": 10,
            "maxLength": 32768,
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "required": true,
            "type": "string"
          },
          {
            "name": "iteration_id",
            "in": "path",
            "description": "迭代id",
            "required": true,
            "type": "integer",
            "format": "int32",
            "x-example": 456
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/IterationDetailV4"
            },
            "examples": {
              "application/json": "{\n  \"begin_time\": \"2020-07-12\",\n  \"charts\": [\n    {\n      \"date\": \"2020-09-12\",\n      \"finished_num\": 1,\n      \"iteration_id\": 3789,\n      \"project_num_id\": 36587463,\n      \"remaining_num\": 3,\n      \"total\": 4\n    }\n  ],\n  \"closed_total\": 1,\n  \"created_time\": \"2020-06-31 09:10:03\",\n  \"end_time\": \"2020-07-19\",\n  \"have_task\": false,\n  \"iteration_id\": 35789,\n  \"name\": \"迭代1\",\n  \"opened_total\": 3,\n  \"progress\": \"25%\",\n  \"total\": 4,\n  \"updated_time\": \"2020-06-31 09:10:03\",\n  \"status\": \"0\"\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "Get https://{endpoint}/v4/iterations/11225793",
        "x-request-examples-1": "Get https://{endpoint}/v4/iterations/11225793"
      }
    }
  },
  "definitions": {
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "Chart": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "example": "2020-09-12",
          "description": "统计时间"
        },
        "finished_num": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "完成story工单"
        },
        "iteration_id": {
          "type": "integer",
          "format": "int32",
          "example": 3789,
          "description": "迭代id"
        },
        "project_num_id": {
          "type": "integer",
          "format": "int32",
          "example": 36587463,
          "description": "项目id"
        },
        "remaining_num": {
          "type": "integer",
          "format": "int32",
          "example": 3,
          "description": "未完成story数"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "example": 4,
          "description": "总story数"
        }
      },
      "title": "Chart"
    },
    "IterationDetailV4": {
      "type": "object",
      "properties": {
        "begin_time": {
          "type": "string",
          "example": "2020-07-12",
          "description": "迭代结束时间,年-月-日"
        },
        "charts": {
          "type": "array",
          "description": "燃尽图",
          "items": {
            "$ref": "#/definitions/Chart"
          }
        },
        "closed_total": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "已关闭的工单数"
        },
        "created_time": {
          "type": "string",
          "example": "2020-06-31 09:10:03",
          "description": "迭代创建时间"
        },
        "end_time": {
          "type": "string",
          "example": "2020-07-19",
          "description": "迭代开始时间,年-月-日"
        },
        "have_task": {
          "type": "boolean",
          "example": false,
          "description": "是否有task"
        },
        "iteration_id": {
          "type": "integer",
          "format": "int32",
          "example": 35789,
          "description": "迭代id"
        },
        "name": {
          "type": "string",
          "example": "迭代1",
          "description": "迭代标题"
        },
        "opened_total": {
          "type": "integer",
          "format": "int32",
          "example": 3,
          "description": "开启的工单数"
        },
        "progress": {
          "type": "string",
          "example": "25%",
          "description": "工作进展"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "example": 4,
          "description": "工单总数"
        },
        "updated_time": {
          "type": "string",
          "example": "2020-06-31 09:10:03",
          "description": "迭代更新时间"
        },
        "status": {
          "type": "string",
          "example": "0",
          "description": "迭代的状态,0 未开始,1 进行中,2 结束"
        }
      },
      "title": "IterationDetailV4"
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "get",
  "uri": null
