          }
        },
        "deprecated": false,
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "PUT https://{endpoint}/v4/projects/526cefde62004de2b62b5e8dd2c2b3af/modules/662086",
        "x-request-examples-text-1": "{\n  \"description\": \"module demo\",\n  \"module_name\": \"demo\",\n  \"owner\": {\n    \"user_id\": \"09d75cde5180d4481f91c018e89cb8e2\"\n  }\n}"
      }
