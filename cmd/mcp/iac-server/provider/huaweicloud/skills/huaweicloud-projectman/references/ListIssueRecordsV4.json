  "tags": "Scrum项目的工作项",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/issue/{issue_id}/records": {
      "get": {
        "tags": [
          "Scrum项目的工作项"
        ],
        "summary": "获取工作项历史记录",
        "operationId": "ListIssueRecordsV4",
        "produces": [
          "*/*"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "minLength": 10,
            "maxLength": 32768,
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "devcloud项目的32位id",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-z]{32}$",
            "maxLength": 32,
            "minLength": 32,
            "x-example": "e2da96a5d2c845e284f0ad47f8ca8cb1"
          },
          {
            "name": "issue_id",
            "in": "path",
            "description": "工作项id",
            "required": true,
            "type": "integer",
            "format": "int32",
            "pattern": "[0-9]+",
            "x-example": 657833
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页索引,偏移量,offset是limit的整数倍,limit=10,offset=0,10,20...",
            "type": "integer",
            "format": "int32",
            "allowEmptyValue": true,
            "default": 0,
            "minimum": 0,
            "x-example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的数量,每页最多显示100条",
            "type": "integer",
            "format": "int32",
            "allowEmptyValue": true,
            "default": 10,
            "maximum": 1000,
            "minimum": 1,
            "x-example": 1
          }
        ],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListIssueRecordsV4ResponseBody"
            },
            "examples": {
              "application/json": "{\n  \"id\": 1221,\n  \"created_time\": \"1597116605000\",\n  \"records\": [\n    {\n      \"id\": 1234,\n      \"created_time\": 1617764919000,\n      \"user\": {\n        \"user_num_id\": 4091,\n        \"user_name\": \"demo_user_name\",\n        \"nick_name\": \"aaa\",\n        \"user_id\": \"a360371833bf4c558f796fd707b44daf\"\n      },\n      \"details\": [\n        {\n          \"property\": 1,\n          \"old_value\": 1,\n          \"new_value\": 2,\n          \"operation\": \"批量编辑\",\n          \"id\": 3597,\n          \"name\": \"标题\"\n        }\n      ]\n    }\n  ],\n  \"total\": 1\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "description": "获取工作项历史记录",
        "x-request-examples-url-1": "Get https://{endpoint}/v4/projects/e2da96a5d2c845e284f0ad47f8ca8cb1/issue/3458/records",
        "x-request-examples-1": "Get https://{endpoint}/v4/projects/e2da96a5d2c845e284f0ad47f8ca8cb1/issue/3458/records"
      }
    }
