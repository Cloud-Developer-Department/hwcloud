{
  "name": "ListIssueCustomFields",
  "summary": "查询Scrum工作项自定义字段",
  "tags": "Scrum项目的工作项",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/issues/custom-fields": {
      "post": {
        "tags": [
          "Scrum项目的工作项"
        ],
        "summary": "查询Scrum工作项自定义字段",
        "operationId": "ListIssueCustomFields",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "devcloud项目的32位id"
          },
          {
            "in": "body",
            "name": "ListIssueCustomFieldsRequestBody",
            "description": "requestJson",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListIssueCustomFieldsRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListIssueCustomFieldsResponseBody"
            },
            "examples": {
              "application/json": "{\n  \"datas\": [\n    {\n      \"name\": \"selectName\",\n      \"custom_field\": \"custom_field16\",\n      \"options\": \"selectName1,selectName2\",\n      \"type\": \"ratio\",\n      \"tracker_ids\": [\n        7\n      ],\n      \"create_time\": \"2023-05-17T09:50:04+08:00\"\n    }\n  ]\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "description": "查询Scrum工作项自定义字段的可选列表,符合custom_fields或者names条件的都返回,2个值都不传,返回所有的自定义字段列表",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "Post https://{endpoint}/v4/projects/0792b7d26cb74bd799cbae80063dc74a/issues/custom-fields",
        "x-request-examples-1": {
          "names": [
            "下拉框Demo"
          ],
          "included_not_in_use": true
        }
      }
    }
  },
  "definitions": {
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    },
    "ListIssueCustomFieldsRequestBody": {
      "type": "object",
      "description": "查询Scrum工作项的自定义字段,custom_fields和names的相关自定义字段都返回",
      "properties": {
        "custom_fields": {
          "type": "array",
          "description": "自定义字段",
          "items": {
            "type": "string",
            "description": "自定义字段",
            "example": "custom_field16"
          }
        },
        "names": {
          "type": "array",
          "description": "自定义字段页面显示的含义",
          "items": {
            "type": "string",
            "description": "自定义字段页面显示的含义",
            "example": "下拉框Demo"
          }
        },
        "included_not_in_use": {
          "type": "boolean",
          "description": "查询结果是否包括未使用的自定义字段,默认仅查询使用中的自定义字段,设为true时查询项目中所有自定义字段",
          "example": true
        }
      }
    },
    "ListIssueCustomFieldsResponseBody": {
      "type": "object",
      "description": "查询Scrum工作项的自定义字段返回可选值列表",
      "properties": {
        "datas": {
          "type": "array",
          "description": "自定义字段返回数据",
          "items": {
            "$ref": "#/definitions/IssueCustomField"
          }
        }
      }
    },
    "IssueCustomField": {
      "type": "object",
      "description": "自定义字段",
      "properties": {
        "name": {
          "type": "string",
          "description": "自定义字段",
          "example": "下拉框"
        },
        "custom_field": {
          "type": "string",
          "description": "自定义字段",
          "example": "custom_field16"
        },
        "options": {
          "type": "string",
          "description": "自定义字段的可选值,多个值以英文逗号区分",
          "example": "下拉选项1,下拉选项2"
        },
        "type": {
          "type": "string",
          "description": "自定义字段类型,\ntextArea 多行文本,只能包含汉字、英文大小写字母、数字、下划线和连接符,不能超过500字符;\ntext 单行文本, 只能包含汉字、英文大小写字母、数字、下划线和连接符,不能超过500字符;\nselect 下拉框,只能包含汉字、英文大小写字母、数字、下划线和连接符,每个选项最大长度40个字符,最多可定义60个选项;\nnumber 数字,取值范围由用户创建自定义字段时设置;\ndate 日期 精确到年月日, time_date 日期 精确到时分秒, 长整型时间戳;\ncheckbox 多选框,只能包含汉字、英文大小写字母、数字、下划线和连接符,每个选项最大长度40个字符,最多可定义60个选项;\nradio 单选框,只能包含汉字、英文大小写字母、数字、下划线和连接符,每个选项最大长度40个字符,最多可定义60个选项;",
          "example": "ratio"
        },
        "tracker_ids": {
          "type": "array",
          "description": "自定义字段支持的工作项类型 2任务/Task,3缺陷/Bug,5Epic,6Feature,7Story",
          "items": {
            "type": "integer",
            "format": "int32",
            "description": "自定义字段支持的工作项类型 2任务/Task,3缺陷/Bug,5Epic,6Feature,7Story",
            "example": 7
          }
        },
        "create_time": {
          "type": "string",
          "description": "自定义字段创建时间"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "post",
  "uri": null
}