{
  "name": "ListAssociatedWikis",
  "summary": "查询当前工作项已经关联的关联Wiki",
  "tags": "Scrum项目的工作项",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/issues/{issue_id}/associated-wikis": {
      "get": {
        "tags": [
          "Scrum项目的工作项"
        ],
        "summary": "查询当前工作项已经关联的关联Wiki",
        "description": "查询当前工作项已经关联的关联Wiki",
        "operationId": "ListAssociatedWikis",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "minLength": 10,
            "maxLength": 32768,
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "devcloud项目的32位id",
            "pattern": "^[0-9a-z]{32}$",
            "maxLength": 32,
            "minLength": 32,
            "required": true,
            "type": "string",
            "x-example": "526cefde62004de2b62b5e8dd2c2b3af"
          },
          {
            "name": "issue_id",
            "in": "path",
            "required": true,
            "description": "工作项ID",
            "type": "integer",
            "format": "int32",
            "x-example": 12345
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页数量",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "偏移量",
            "type": "integer",
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/ListAttachWikiResult"
            },
            "examples": {
              "application/json": "{\n  \"wikis\": [\n    {\n      \"issue_id\": 1234,\n      \"wiki_title\": \"wikidemo\",\n      \"wiki_author\": {\n        \"user_num_id\": 4091,\n        \"user_id\": \"a360371833bf4c558f796fd707b44daf\",\n        \"user_name\": \"demo_user_name_xiongzhitest001\",\n        \"nick_name\": \"demo\"\n      },\n      \"project\": {\n        \"project_name\": \"demo\",\n        \"project_id\": \"58d9050550c847c89885c1797a718b0c\"\n      },\n      \"created_date\": \"2021-11-18 19:47:34\",\n      \"wiki_id\": \"1839097\",\n      \"region\": \"cn-north-xxx\"\n    }\n  ],\n  \"total\": \"success\"\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "GET https://{endpoint}/v4/projects/{project_id}/issues/{issue_id}/associated-wikis"
      }
    }
  },
  "definitions": {
    "SimpleProject": {
      "type": "object",
      "properties": {
        "project_name": {
          "type": "string",
          "description": "项目名称",
