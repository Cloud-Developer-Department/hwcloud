          "example": "2021-11-18 19:47:34"
        },
        "wiki_id": {
          "type": "string",
          "description": "wiki ID",
          "example": "1839097"
        },
        "region": {
          "type": "string",
          "description": "region值",
          "example": "cn-north-7"
        }
      }
    },
    "SimpleUser": {
      "properties": {
        "user_num_id": {
          "type": "integer",
          "example": 4091,
          "description": "用户数字id"
        },
        "user_id": {
          "type": "string",
          "example": "a360371833bf4c558f796fd707b44daf",
          "description": "用户uuid"
        },
        "user_name": {
          "type": "string",
          "example": "demo_user_name_xiongzhitest001",
          "description": "账号名"
        },
        "nick_name": {
          "type": "string",
          "example": "大熊",
          "description": "用户昵称"
        }
      }
    }
