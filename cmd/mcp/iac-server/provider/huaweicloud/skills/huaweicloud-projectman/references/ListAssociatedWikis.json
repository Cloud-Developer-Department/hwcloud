        },
        "project_id": {
          "type": "string",
          "description": "项目id",
          "example": "58d9050550c847c89885c1797a718b0c"
        }
      }
    },
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
