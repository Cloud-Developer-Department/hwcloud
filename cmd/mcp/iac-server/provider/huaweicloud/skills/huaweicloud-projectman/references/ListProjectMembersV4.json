{
  "name": "ListProjectMembersV4",
  "summary": "获取指定项目的成员用户列表",
  "tags": "项目成员",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/members": {
      "get": {
        "tags": [
          "项目成员"
        ],
        "summary": "获取指定项目的成员用户列表",
        "operationId": "ListProjectMembersV4",
        "produces": [
          "*/*"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "minLength": 10,
            "maxLength": 32768,
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "devcloud项目的32位id",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-z]{32}$",
            "maxLength": 32,
            "minLength": 32,
            "x-example": "e2da96a5d2c845e284f0ad47f8ca8cb1"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "分页索引,偏移量,offset是limit的整数倍,limit=10,offset=0,10,20...",
            "type": "integer",
            "format": "int32",
            "default": 0,
            "minimum": 0,
            "maximum": 10000,
            "x-example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的数量,每页最多显示100条",
            "type": "integer",
            "format": "int32",
            "default": 100,
            "maximum": 100,
            "minimum": 1,
            "x-example": 1
          }
        ],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/MemberListV4"
            },
            "examples": {
              "application/json": "{\n  \"members\": [\n    {\n      \"domain_id\": \"4e919d73499648e3b0292cd3cbef806a\",\n      \"domain_name\": \"demo_user_name\",\n      \"user_id\": \"a360371833bf4c558f796fd707b44daf\",\n      \"user_name\": \"demo_user_name\",\n      \"user_num_id\": 4097,\n      \"role_id\": 7,\n      \"nick_name\": \"name\",\n      \"role_name\": \"项目创建者\",\n      \"user_type\": \"User\",\n      \"forbidden\": 0\n    }\n  ],\n  \"total\": 1\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "description": "获取项目成员列表",
        "x-request-examples-url-1": "Get https://{endpoint}/v4/projects/e2da96a5d2c845e284f0ad47f8ca8cb1/members",
        "x-request-examples-1": "Get https://{endpoint}/v4/projects/e2da96a5d2c845e284f0ad47f8ca8cb1/members"
      }
    }
  },
  "definitions": {
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    },
    "MemberListV4": {
      "type": "object",
      "properties": {
        "members": {
          "description": "项目成员列表",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "domain_id": {
                "type": "string",
                "description": "租户id",
                "pattern": "^[0-9a-z]{32}$",
                "maxLength": 32,
                "minLength": 32,
                "example": "4e919d73499648e3b0292cd3cbef806a"
              },
              "domain_name": {
                "type": "string",
                "description": "租户名",
                "example": "demo_user_name"
              },
              "user_id": {
                "type": "string",
                "description": "用户id",
                "example": "a360371833bf4c558f796fd707b44daf"
              },
              "user_name": {
                "type": "string",
                "description": "用户名",
                "example": "demo_user_name"
              },
              "user_num_id": {
                "type": "integer",
                "format": "int32",
                "description": "创建人numId",
                "example": 4097
              },
              "role_id": {
                "type": "integer",
                "format": "int32",
                "description": "成员角色,\n-1 项目创建者,\n3 项目经理,\n4 开发人员,\n5 测试经理,\n6 测试人员,\n7 参与者,\n8 浏览者,\n9 运维经理",
                "example": 7
              },
              "nick_name": {
                "type": "string",
                "description": "用户昵称",
                "example": "我的名字要非常非常长才能测出问题"
              },
              "role_name": {
                "type": "string",
                "description": "用户角色",
                "example": "项目创建者"
              },
              "user_type": {
                "type": "string",
                "description": "用户类型,\nUser iam用户,\nFederation 联邦账号,",
                "example": "User",
                "pattern": "User|Federation"
              },
              "forbidden": {
                "type": "integer",
                "format": "int32",
                "description": "是否是禁用账号,1 禁用账号, 0非禁用账号",
                "example": 0
              }
            }
          }
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "总数",
          "example": 1
        }
      },
      "title": "MemberListV4"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "get",
  "uri": null
}