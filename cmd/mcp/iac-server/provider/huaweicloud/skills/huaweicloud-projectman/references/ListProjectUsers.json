{
  "name": "ListProjectUsers",
  "summary": "查询项目下的用户",
  "tags": "IPD项目接口",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/ipdprojectservice/projects/{project_id}/users": {
      "get": {
        "tags": [
          "IPD项目接口"
        ],
        "summary": "查询项目下的用户",
        "operationId": "ListProjectUsers",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "pattern": "^[0-9a-z]{32}$",
            "description": "devcloud项目的32位id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/IPDUserListResponse"
            },
            "examples": {
              "application/json": "{\n    \"status\": \"success\",\n    \"message\": null,\n    \"result\": [\n        {\n            \"user_id\": \"a360371833bf4c558f796fd70888888\",\n            \"user_num_id\": 4091,\n            \"user_name\": \"devcloud_devcloud_s3812_01\",\n            \"domain_id\": \"4e919d73499648e3b0292cd3c8888888\",\n            \"domain_name\": \"devcloud_devcloud_s3812_01\",\n            \"nick_name\": \"test\"\n        }\n    ]\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "description": "查询项目下的所有用户",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "N",
        "x-sre-api-type": "A1",
        "x-is-registered": "Y",
        "x-hcs-visible": "Y",
        "x-request-examples-url-1": "Get https://{endpoint}/v1/ipdprojectservice/projects/cb41a2a2cb4347028289709296e263e7/users"
      }
    }
  },
  "definitions": {
    "IPDUserListResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "返回信息",
          "example": null
        },
        "result": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UserVO"
          },
          "description": "返回用户列表"
        },
        "status": {
          "type": "string",
          "description": "返回状态",
          "example": "success"
        }
      }
    },
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "UserVO": {
      "type": "object",
      "properties": {
        "domain_id": {
          "type": "string",
          "example": "868551927720357888",
          "description": "用户的租户ID"
        },
        "domain_name": {
          "type": "string",
          "example": "Test_CodeArtsReq",
          "description": "用户的租户名称"
        },
        "nick_name": {
          "type": "string",
          "example": "Test_CodeArtsReq_nickname",
          "description": "用户的昵称"
        },
        "user_id": {
          "type": "string",
          "example": "eab51c9c46f84d3aab838e1db6401232",
          "description": "用户Iam id"
        },
        "user_name": {
          "type": "string",
          "example": "Test_CodeArtsReq",
          "description": "用户名"
        },
        "user_num_id": {
          "type": "integer",
          "format": "int32",
          "example": 700370955,
          "description": "用户索引id"
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "get",
  "uri": null
}