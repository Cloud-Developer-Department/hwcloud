    "CreateProjectV4ResponseBody": {
      "type": "object",
      "properties": {
        "project_num_id": {
          "type": "integer",
          "format": "int32",
          "example": 3056544,
          "description": "项目数字id"
        },
        "project_id": {
          "description": "项目id",
          "type": "string",
          "pattern": "^[0-9a-z]{32}$",
          "maxLength": 32,
          "minLength": 32,
          "example": "e2da96a5d2c845e284f0ad47f8ca8cb1"
        },
        "project_name": {
          "type": "string",
          "description": "项目名",
          "example": "dsadasdsasss",
          "maxLength": 128,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "项目描述",
          "example": "这是一个demo"
        },
        "project_type": {
          "type": "string",
          "description": "项目类型",
          "example": "scrum",
          "pattern": "scrum|xboard|basic|normal"
        },
        "user_num_id": {
          "type": "integer",
          "format": "int32",
          "example": 4091,
          "description": "创建者的数字id"
        }
      }
