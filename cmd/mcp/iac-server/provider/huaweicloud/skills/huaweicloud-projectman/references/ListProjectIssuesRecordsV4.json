        "x-request-examples-url-1": "GET https://{endpoint}/v4/projects/526cefde62004de2b62b5e8dd2c2b3af/issues/records",
        "x-request-examples-1": "GET https://{endpoint}/v4/projects/526cefde62004de2b62b5e8dd2c2b3af/issues/records"
