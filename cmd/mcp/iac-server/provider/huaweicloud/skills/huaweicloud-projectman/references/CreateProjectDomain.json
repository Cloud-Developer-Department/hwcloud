        },
        "deprecated": false,
        "description": "查询项目的领域列表",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "Post https://{endpoint}/v4/projects/0792b7d26cb74bd799cbae80063dc74a/domains",
