{
  "name": "ListProjectDomains",
  "summary": "查询项目的领域列表",
  "tags": "Scrum项目的领域",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/domains": {
      "get": {
        "tags": [
          "Scrum项目的领域"
        ],
        "summary": "查询项目的领域列表",
        "operationId": "ListProjectDomains",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "pattern": "^[0-9a-z]{32}$",
            "required": true,
            "type": "string",
            "description": "devcloud项目的32位id"
          },
          {
            "in": "query",
            "name": "offset",
            "type": "integer",
            "format": "int32",
            "description": "查询偏移量",
            "required": false,
            "default": 0
          },
          {
            "in": "query",
            "name": "limit",
            "type": "integer",
            "format": "int32",
            "required": false,
            "description": "一次返回的数据,最小1,最大100",
            "maximum": 100,
            "minimum": 1,
            "default": 10
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListProjectDomainsResponseBody"
            },
            "examples": {
              "application/json": "{\n  \"total\": 1,\n  \"domains\": [\n    {\n      \"domain_name\": \"demo\",\n      \"domain_id\": \"123cefde62004de2b62b5e8dd2c2b3af\"\n    }\n  ]\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "description": "查询项目的领域列表",
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "Get https://{endpoint}/v4/projects/0792b7d26cb74bd799cbae80063dc74a/domains"
      }
    }
  },
  "definitions": {
    "ListProjectDomainsResponseBody": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "领域总数",
          "example": 1
        },
        "domains": {
          "description": "领域列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CreateProjectDomainResponseBody"
          }
        }
      }
    },
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "CreateProjectDomainResponseBody": {
      "type": "object",
      "properties": {
        "domain_name": {
          "type": "string",
          "description": "领域名称",
          "example": "领域demo"
        },
        "domain_id": {
          "description": "领域id",
          "type": "string",
          "example": "123cefde62004de2b62b5e8dd2c2b3af"
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "get",
  "uri": null
