            },
            "examples": {
              "application/json": "{\n  \"issues\": [\n    {\n      \"actual_work_hours\": 10,\n      \"assigned_user\": {\n        \"id\": 4091,\n        \"name\": \"demo_user_name\",\n        \"nick_name\": \"demo\"\n      },\n      \"author\": {\n        \"id\": 4091,\n        \"name\": \"demo_user_name\",\n        \"nick_name\": \"demo\"\n      },\n      \"begin_time\": 1590940800000,\n      \"closed_time\": 1590940800000,\n      \"created_time\": 1590940800000,\n      \"custom_feilds\": [\n        {\n          \"key\": \"customField15\",\n          \"name\": \"single\",\n          \"value\": \"15Demo\"\n        }\n      ],\n      \"developer\": {\n        \"id\": 4091,\n        \"name\": \"demo_user_name\",\n        \"nick_name\": \"demo\"\n      },\n      \"discover_version\": \"ProjectMan 8.0.0\",\n      \"end_time\": 1590940800000,\n      \"done_ratio\": 0,\n      \"expected_work_hours\": 9,\n      \"order\": 1,\n      \"parent_issue_id\": 123,\n      \"release_version\": \"ProjectMan 8.0.0\",\n      \"root_issue_id\": 0,\n      \"story_point\": {\n        \"id\": 1,\n        \"name\": \"0\"\n      },\n      \"domain\": {\n        \"id\": 14,\n        \"name\": \"性能\"\n      },\n      \"iteration\": {\n        \"id\": 456,\n        \"name\": \"迭代1\"\n      },\n      \"module\": {\n        \"id\": 456,\n        \"name\": \"Project\"\n      },\n      \"priority\": {\n        \"id\": 1,\n        \"name\": \"低\"\n      },\n      \"severity\": {\n        \"id\": 12,\n        \"name\": \"一般\"\n      },\n      \"status\": {\n        \"id\": 1,\n        \"name\": \"新建\"\n      },\n      \"tracker\": {\n        \"id\": 7,\n        \"name\": \"story\"\n      },\n      \"subject\": \"demo\",\n      \"updated_time\": 1576114296000\n    }\n  ],\n  \"total\": 1\n}"
