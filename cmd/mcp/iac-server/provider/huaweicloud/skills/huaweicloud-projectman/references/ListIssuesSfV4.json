        },
        "deprecated": false,
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "Get https://{endpoint}/v4/projects/526cefde62004de2b62b5e8dd2c2b3af/issues",
