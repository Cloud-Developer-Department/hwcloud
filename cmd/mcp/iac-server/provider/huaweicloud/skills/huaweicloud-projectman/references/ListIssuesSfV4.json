          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "description": "每页数量 最小1,最大100",
            "maximum": 100,
            "minimum": 1
          },
          {
            "name": "tracker_id",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "description": "工作项类型",
            "x-example": 7,
            "enum": [
              2,
              3,
              4,
              5,
              6,
              7
            ]
          },
          {
            "name": "created_time_interval",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "创建工作项的时间(查询的起始时间,查询的结束时间)",
            "x-example": "1576114296000,1576114396000"
          },
          {
            "name": "updated_time_interval",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "更新工作项的时间(查询的起始时间,查询的结束时间)",
            "x-example": "1576114296000,1576114396000"
          }
        ],
