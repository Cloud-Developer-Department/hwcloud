{
  "name": "ShowIssueCompletionRate",
  "summary": "获取工作项完成率",
  "tags": "Scrum项目的工作项",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/issue-completion-rate": {
      "get": {
        "tags": [
          "Scrum项目的工作项"
        ],
        "summary": "获取工作项完成率",
        "operationId": "ShowIssueCompletionRate",
        "produces": [
          "*/*"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "minLength": 10,
            "maxLength": 32768,
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "devcloud项目的32位id",
            "required": true,
            "type": "string",
            "pattern": "^[0-9a-z]{32}$",
            "maxLength": 32,
            "minLength": 32,
            "x-example": "e2da96a5d2c845e284f0ad47f8ca8cb1"
          }
        ],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/IssueCompletionRateV4"
            },
            "examples": {
              "application/json": "{\n  \"issue_completion_rates\": [\n    {\n      \"issue_status\": {\n        \"closed_num\": 0,\n        \"new_num\": 0,\n        \"process_num\": 0,\n        \"rejected_num\": 0,\n        \"solved_num\": 0,\n        \"test_num\": 0\n      },\n      \"tracker_id\": 3\n    }\n  ],\n  \"total\": 2\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "GET https://{endpoint}/v4/projects/e2da96a5d2c845e284f0ad47f8ca8cb1/issue-completion-rate",
        "description": "获取工作项的完成率"
      }
    }
  },
  "definitions": {
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    },
    "IssueCompletionRateV4": {
      "type": "object",
      "properties": {
        "issue_completion_rates": {
          "type": "array",
          "description": "不同类型的工作项完成率",
          "items": {
            "type": "object",
            "properties": {
              "issue_status": {
                "description": "工作项不同状态下的数量",
                "type": "object",
                "properties": {
                  "closed_num": {
                    "type": "integer",
                    "description": "已关闭的工作项",
                    "format": "int32"
                  },
                  "new_num": {
                    "type": "integer",
                    "description": "新建的工作项",
                    "format": "int32"
                  },
                  "process_num": {
                    "type": "integer",
                    "description": "进行中的工作项数目",
                    "format": "int32"
                  },
                  "rejected_num": {
                    "type": "integer",
                    "description": "已经拒绝的工作项",
                    "format": "int32"
                  },
                  "solved_num": {
                    "type": "integer",
                    "description": "已经解决的工作项",
                    "format": "int32"
                  },
                  "test_num": {
                    "type": "integer",
                    "description": "测试中的工作项",
                    "format": "int32"
                  }
                }
              },
              "tracker_id": {
                "type": "integer",
                "example": 3,
                "description": "工作项类型id,1需求,2任务/Task,3缺陷/Bug,5Epic,6Feature,7Story"
              }
            }
          }
        },
        "total": {
          "type": "integer",
          "example": 2,
          "description": "总数"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "get",
  "uri": null
}