{
  "name": "DownloadImageFile",
  "summary": "下载图片",
  "tags": "Scrum项目的工作项",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/image-file": {
      "get": {
        "tags": [
          "Scrum项目的工作项"
        ],
        "summary": "下载图片",
        "description": "下载图片",
        "operationId": "DownloadImageFile",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "pattern": "^[0-9a-z]{32}$",
            "required": true,
            "type": "string",
            "description": "devcloud项目的32位id",
            "x-example": "2c42a6d37ccc4197bf0b3dbe91be021a"
          },
          {
            "name": "image_uri",
            "in": "query",
            "type": "string",
            "description": "图片URI",
            "required": true,
            "x-example": "/v1/upload/2c42a6d37ccc4197bf0b3dbe91be021a/202209/1662003438194761550.png"
          }
        ],
        "responses": {
          "200": {
            "description": "二进制文件",
            "schema": {
              "type": "file"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "Get https://{endpoint}/v4/projects/2c42a6d37ccc4197bf0b3dbe91be021a/image-file?image_uri=/v1/upload/2c42a6d37ccc4197bf0b3dbe91be021a/202209/1662003438194761550.png"
      }
    }
  },
  "definitions": {
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "get",
  "uri": null
}