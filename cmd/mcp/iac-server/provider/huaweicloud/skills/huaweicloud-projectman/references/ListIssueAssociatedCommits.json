{
  "name": "ListIssueAssociatedCommits",
  "summary": "查询当前工作项已经关联的代码提交记录 / 分支创建记录",
  "tags": "Scrum项目的工作项",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/issues/{issue_id}/associated-commits": {
      "get": {
        "tags": [
          "Scrum项目的工作项"
        ],
        "summary": "查询当前工作项已经关联的代码提交记录 / 分支创建记录",
        "description": "查询当前工作项已经关联的代码提交记录 / 分支创建记录",
        "operationId": "ListIssueAssociatedCommits",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "minLength": 10,
            "maxLength": 32768,
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "devcloud项目的32位id",
            "pattern": "^[0-9a-z]{32}$",
            "maxLength": 32,
            "minLength": 32,
            "required": true,
            "type": "string",
            "x-example": "526cefde62004de2b62b5e8dd2c2b3af"
          },
          {
            "name": "issue_id",
            "in": "path",
            "required": true,
            "description": "工作项ID",
            "type": "integer",
            "format": "int32",
            "x-example": 12345
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "查询类型:commit(提交记录) || branch(分支记录)",
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页数量",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "偏移量",
            "type": "integer",
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/ListCommitsResult"
            },
            "examples": {
              "application/json": "{\n  \"commits\": [\n    {\n      \"repository_id\": \"1865706\",\n      \"branch_name\": \"master\",\n      \"commit_id\": \"f608b02311d90f311c41711fdf67003c31305b89\",\n      \"commit_short_id\": \"f608b023\",\n      \"commit_msg\": \"demo\",\n      \"commit_url\": \"https://xxx.xxx/xxxx/commit/791877f7d0e0b2032bc5e38425c1245e804e8741?ref=master\",\n      \"user\": {\n        \"user_num_id\": 4091,\n        \"user_id\": \"a360371833bf4c558f796fd707b44daf\",\n        \"user_name\": \"demo_user_name_xiongzhitest001\",\n        \"nick_name\": \"bear\"\n      },\n      \"type\": \"branch\",\n      \"create_date\": \"2021-11-18 19:47:34\",\n      \"update_date\": \"2021-11-18 19:47:34\"\n    }\n  ],\n  \"total\": \"success\"\n}"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
