{
  "name": "AddMemberV4",
  "summary": "添加项目成员",
  "tags": "项目成员",
  "productshort": "ProjectMan",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v4/projects/{project_id}/member": {
      "post": {
        "tags": [
          "项目成员"
        ],
        "summary": "添加项目成员",
        "description": "添加项目成员,可以添加跨租户成员",
        "operationId": "AddMemberV4",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "minLength": 10,
            "maxLength": 32768,
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "pattern": "^[0-9a-z]{32}$",
            "maxLength": 32,
            "minLength": 32,
            "description": "devcloud项目的32位id",
            "required": true,
            "type": "string",
            "x-example": "526cefde62004de2b62b5e8dd2c2b3af"
          },
          {
            "in": "body",
            "name": "AddMemberV4RequestBody",
            "description": "添加的成员实体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AddMemberRequestV4"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-request-examples-url-1": "POST https://{endpoint}/v4/projects/526cefde62004de2b62b5e8dd2c2b3af/member",
        "x-request-examples-1": {
          "user_id": "665b542eb4c14b53a15ead449f28b0ba",
          "role_id": 5,
          "domain_id": "4e919d73499648e3b0292cd3cbef806a"
        }
      }
    }
  },
  "definitions": {
    "AddMemberRequestV4": {
      "type": "object",
      "required": [
        "domain_id",
        "user_id"
      ],
      "properties": {
        "domain_name": {
          "type": "string",
          "example": "demo_user_name",
          "description": "租户名称(跨租户添加用户时,填写正确的租户名称,可将未授权的租户主动授权,将用户添加为项目成员)"
        },
        "domain_id": {
          "type": "string",
          "example": "4e919d73499648e3b0292cd3cbef806a",
          "description": "租户id"
        },
        "role_id": {
          "type": "integer",
          "format": "int32",
          "example": 5,
          "description": "'用户在项目中的角色ID'\n成员角色,\n-1 项目创建者,\n3 项目经理,\n4 开发人员,\n5 测试经理,\n6 测试人员,\n7 参与者,\n8 浏览者,\n9 运维经理"
        },
        "user_id": {
          "type": "string",
          "example": "6d9b5b7052b549e79145ef218ec1cb6d",
          "description": "用户32位uuid"
        }
      },
      "title": "AddMemberRequestV4"
    },
    "UnauthorizedRequestError": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "type": "object",
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "认证信息过期"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "DEV.00000003"
        }
      }
    },
    "BadRequestError": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "example": "参数错误"
        },
        "error_code": {
          "type": "string",
          "description": "错误码",
          "example": "PM.00000001"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "projectman-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v4",
  "method": "post",
  "uri": null
}