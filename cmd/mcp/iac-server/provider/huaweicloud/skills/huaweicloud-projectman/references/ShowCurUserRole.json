            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/BadRequestError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthorizedRequestError"
            }
          }
        },
        "deprecated": false,
        "description": "获取用户在项目中的角色",
        "x-request-examples-url-1": "Get https://{endpoint}/v4/projects/526cefde62004de2b62b5e8dd2c2b3af/user-role"
      }
    }
  },
