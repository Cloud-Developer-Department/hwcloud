              },
              "user_name": {
                "type": "string",
                "description": "用户名"
              },
              "user_nick_name": {
                "type": "string",
                "description": "用户昵称"
              },
              "work_date": {
                "type": "string",
                "description": "工时日期"
              },
              "work_hours": {
                "type": "string",
                "description": "工时数"
              },
              "work_hours_type_name": {
                "type": "string",
                "description": "工时类型名称"
              }
            }
          }
        }
