        "summary": "导入IDC离线资源",
        "description": "管理线下设备提供IDC离线资源纳管功能-导入IDC离线资源。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "consumes": [
          "multipart/form-data"
        ],
        "operationId": "ImportOtherResource",
        "parameters": [
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "description": "**参数解释:**\n上传的物理机/虚拟机/中间件设备下载模板excel(相关的设备信息)。\n**约束限制:**\n不涉及。\n**取值范围:**\n物理机/虚拟机/中间件设备下载模板excel(相关的设备信息)。\n**默认取值:**\n不涉及。",
            "type": "file"
          },
          {
            "name": "type",
            "in": "formData",
            "required": true,
            "description": "**参数解释:**\n导入类型。\n**约束限制:**\n不涉及。\n**取值范围:**\n- vm:虚拟机。\n- PM:物理机。\n- Middleware:中间件设备。\n**默认取值:**\n不涉及。",
            "type": "string",
            "enum": [
              "PM",
              "VM",
              "Middleware"
            ]
          },
          {
            "name": "region_id",
            "in": "formData",
            "required": true,
            "description": "**参数解释:**\n区域id。\n**约束限制:**\n不涉及。\n**取值范围:**\n字符串,长度在[0,64]之间。\n**默认取值:**\n不涉及。",
            "type": "string",
            "minLength": 0,
            "maxLength": 64
          }
        ],
        "responses": {
          "200": {
            "description": "导入资源结果成功。",
            "schema": {
              "$ref": "#/definitions/ImportResult"
            },
            "examples": {
              "导入资源无失败数据": {
                "value": {
                  "data": {
                    "success": 25,
                    "total": 25,
                    "errorList": []
                  }
                }
              },
              "导入资源有失败数据": {
                "value": {
                  "data": {
                    "success": 0,
                    "total": 1,
                    "errorList": [
                      "import context invalid, xrn: test, reason: private ip is invalid."
                    ]
                  }
                }
              }
            }
          }
        },
        "x-order": 0,
        "x-request-examples-url-1": "POST https://{endpoint}/v1/other-resources/import",
        "x-request-examples-description-1": "导入IDC离线资源。"
      }
    }
  },
  "definitions": {
    "ImportResult": {
      "type": "object",
      "description": "导入资源结果。",
      "properties": {
        "success": {
          "type": "integer",
          "description": "**参数解释:**\n成功数即excel表中数据通过校验成功的数据条数。\n**取值范围:**\n不涉及。",
          "format": "int32"
        },
        "total": {
          "type": "integer",
          "description": "**参数解释:**\n总条数即excel表中数据的总数据条数。\n**取值范围:**\n不涉及。",
          "format": "int32"
        },
        "error_list": {
          "type": "array",
          "description": "**参数解释:**\n失败信息集合即excel表格中校验失败报错信息组合。\n**取值范围:**\n不涉及。",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
