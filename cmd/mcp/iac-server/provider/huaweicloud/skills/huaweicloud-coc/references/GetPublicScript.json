          "description": "风险等级\nLOW:低风险\nMEDIUM:中风险\nHIGH:高风险",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "version": {
          "type": "string",
          "example": "v1.0.0",
          "description": "脚本版本号",
          "minLength": 1,
          "maxLength": 10
        }
      },
      "description": "公共脚本附加属性"
    },
