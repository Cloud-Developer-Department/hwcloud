                    }
                  ],
                  "gmt_created": 1686059454716,
                  "provider": "HWC.ECS",
                  "properties": {
                    "risk_level": "LOW",
                    "version": "v1.0.0"
                  }
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowPublicScriptDetailRes"
