      "type": "object",
      "required": [
        "param_description",
        "param_name",
        "param_value",
        "param_order",
        "sensitive"
      ],
      "properties": {
        "param_name": {
          "type": "string",
          "example": "value",
          "description": "参数名仅支持字母、数字以及下划线",
          "minLength": 1,
          "maxLength": 64
        },
        "param_value": {
          "type": "string",
          "example": "test",
          "description": "1.参数长度为1-4096位\n2.可以包含大写字母、小写字母、数字及特殊字符(_-/.* ?:\",=+@#\\[{]})\n3.禁止出现连续'.'",
          "minLength": 0,
          "maxLength": 4096
        },
        "param_description": {
          "type": "string",
          "example": "测试参数",
          "description": "参数描述",
          "minLength": 0,
          "maxLength": 256
        },
        "param_order": {
          "type": "integer",
          "format": "int32",
          "description": "该参数已废弃,传入该参数不会生效。"
        },
        "sensitive": {
          "type": "boolean",
          "example": false,
          "description": "是否是敏感参数"
        }
      },
      "description": "顺序参数,没有参数名字段\n参数顺序,从1开始,不连续会报错\n\napi层用不同的vo对象接收,管理面没有order字段。service层统一处理差异\n\n拼接:sh xxx.sh  'aaa' 'a' 'b'\n执行时值为空:sh xxx.sh  '' 'a' 'b'"
    }
  },
