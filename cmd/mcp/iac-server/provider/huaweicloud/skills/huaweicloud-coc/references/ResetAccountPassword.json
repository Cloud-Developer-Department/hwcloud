{
  "name": "ResetAccountPassword",
  "summary": "主机密码重置",
  "tags": "AccountManagement",
  "productshort": "COC",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/account-mgmt/accounts/password/reset": {
      "post": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-methodAnnotations": [
          "@IamAuthMeta(needApigwJwtAuthCheck = false, authLevel = IamAuthLevel.INSTANCE_LIST, abacAction = \"coc:instance:resetAccountPassword\", needAbacResourceCheck = true, authContextInitializer = ResourceInstanceActionInitializer.class, opType = BssOpType.RESOURCE)",
          "@CtsMeta(resourceType = \"Resource\", traceName = \"resetAccountPassword\", operationId = \"ResetAccountPassword\")",
          "@CtsExtendMeta(resourceId = \"#resetAccountPasswordRequestBody.resourceId\", resourceName = \"resourceId\", resourceParamKey = \"resource_id\")",
          "@CheckQuota",
          "@QuotaV2Check(featureId = \"coc.account_mgmt\")"
        ],
        "x-returnType": "AccountBaseResponse<Object>",
        "x-api-type": "open-api",
        "tags": [
          "AccountManagement"
        ],
        "summary": "主机密码重置",
        "description": "主机密码重置",
        "operationId": "ResetAccountPassword",
        "parameters": [
          {
            "name": "ResetAccountPasswordRequestBody",
            "in": "body",
            "required": true,
            "description": "重置密码请求body",
            "schema": {
              "$ref": "#/definitions/ResetAccountPasswordRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应",
            "schema": {
              "$ref": "#/definitions/AccountStringResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ResetAccountPasswordRequestBody": {
      "description": "重置密码所需要的信息",
      "type": "object",
      "required": [
        "vendor",
        "resource_provider",
        "resource_type",
        "instance_type",
        "resources_id"
      ],
      "properties": {
        "vendor": {
          "type": "string",
          "description": "云服务厂商",
          "default": "HuaweiCloud",
          "example": "HuaweiCloud",
          "pattern": "HuaweiCloud",
          "minLength": 1,
          "maxLength": 36
        },
        "resource_provider": {
          "type": "string",
          "description": "云服务",
          "default": "ecs",
          "example": "ecs",
          "pattern": "ecs|rds|dcs|dms|gaussdb",
          "minLength": 1,
          "maxLength": 36
        },
        "resource_type": {
          "type": "string",
          "description": "资源类型",
          "default": "cloudservers",
          "example": "cloudservers",
          "minLength": 1,
          "maxLength": 36
        },
        "instance_type": {
          "type": "string",
          "description": "实例类型",
          "default": "linux",
          "example": "linux",
          "minLength": 1,
          "maxLength": 36
        },
        "accounts_password_change_status": {
          "type": "array",
          "description": "需要改密的账号的状态,枚举值\n\nTO_BE_CHANGED:待改密\nFAILED:改密失败\nSUCCESSFUL:改密成功\nPROCESSING:改密中\n\n不传默认修改所有状态的账号",
          "items": {
            "example": "SUCCESSFUL",
            "pattern": "TO_BE_CHANGED|FAILED|SUCCESSFUL|PROCESSING",
            "minLength": 1,
            "maxLength": 36,
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 10,
          "x-minLength": 0,
          "x-maxLength": 10
        },
        "resources_id": {
          "type": "array",
          "description": "实例id列表",
          "minItems": 1,
          "maxItems": 10000,
          "x-minLength": 1,
          "x-maxLength": 10000,
          "items": {
            "example": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
            "minLength": 1,
            "maxLength": 64,
            "type": "string"
          }
        }
      }
    },
    "AccountBaseResponse": {
      "type": "object",
      "description": "基本响应体,需要增加data属性",
      "required": [
        "provider_code",
        "error_code"
      ],
      "properties": {
        "provider_code": {
          "type": "string",
          "description": "服务标识",
          "minLength": 0,
          "maxLength": 256
        },
        "error_code": {
          "type": "string",
          "example": 0,
          "description": "请求响应代码,范围:0000~9999,正常时取值:0",
          "minLength": 0,
          "maxLength": 256
        },
        "error_msg": {
          "type": "string",
          "example": "",
          "description": "请求响应描述",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "AccountStringResponse": {
      "description": "data为String的基本响应体",
      "allOf": [
        {
          "$ref": "#/definitions/AccountBaseResponse"
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "description": "响应数据",
              "type": "string",
              "minLength": 0,
              "maxLength": 64,
              "example": "success"
            }
          }
        }
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "coc-intl.myhuaweicloud.com",
  "base_path": "/",
