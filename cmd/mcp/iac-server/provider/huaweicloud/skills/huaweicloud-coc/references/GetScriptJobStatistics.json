{
  "name": "GetScriptJobStatistics",
  "summary": "展示实例状态统计信息",
  "tags": "ScriptExecutionManagement",
  "productshort": "COC",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/job/script/orders/{execute_uuid}/statistics": {
      "get": {
        "tags": [
          "ScriptExecutionManagement"
        ],
        "summary": "展示实例状态统计信息",
        "description": "查询:实例状态统计信息。",
        "operationId": "GetScriptJobStatistics",
        "parameters": [
          {
            "name": "execute_uuid",
            "in": "path",
            "description": "脚本工单的执行Id,取自executeJobScript和ListJobScriptOrders返回体中",
            "required": true,
            "type": "string",
            "maxLength": 26,
            "minLength": 1
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户token",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "国际化标记,zh-cn表示中文,en-us或不传表示英文",
            "required": false,
            "type": "string"
          },
          {
            "name": "x-project-id",
            "in": "header",
            "description": "项目ID,一个项目对应一个region",
            "required": false,
            "type": "string"
          },
          {
            "name": "x-user-profile",
            "in": "header",
            "description": "IAM5.0用户信息",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "展示实例状态统计信息返回体",
            "examples": {
              "application/json": {
                "data": {
                  "total_instance": 1,
                  "execute_statistics": [
                    {
                      "instance_status": "READY",
                      "instance_count": 0,
                      "batch_indexes": []
                    },
                    {
                      "instance_status": "PROCESSING",
                      "instance_count": 0,
                      "batch_indexes": []
                    },
                    {
                      "instance_status": "ABNORMAL",
                      "instance_count": 0,
                      "batch_indexes": []
                    },
                    {
                      "instance_status": "CANCELED",
                      "instance_count": 1,
                      "batch_indexes": [
                        1
                      ]
                    },
                    {
                      "instance_status": "FINISHED",
                      "instance_count": 0,
                      "batch_indexes": []
                    }
                  ]
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowScriptOrderStatisticsRes"
            }
          }
        },
        "x-apiexplorer-hide": false,
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "ShowScriptOrderStatisticsRes": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "description": "展示实例状态统计信息",
          "$ref": "#/definitions/JobScriptOrderStatisticsModel"
        }
      },
      "description": "展示实例状态统计信息"
    },
    "JobScriptOrderStatisticsModel": {
      "type": "object",
      "properties": {
        "total_instance": {
          "type": "integer",
          "format": "int32",
          "description": "实例总量"
        },
        "execute_statistics": {
          "type": "array",
          "description": "每个状态一个count,里面记录该状态的总数量,以及包含该状态的批次列表",
          "items": {
            "$ref": "#/definitions/ExectuionStatistic"
          }
        }
      },
      "description": "任务统计信息\n\n讨论:\nstatistics属性里用状态声明key合理么?\n还要统计什么内容,怎么扩展?"
    },
    "ExectuionStatistic": {
      "type": "object",
      "required": [
        "batch_indexes",
        "instance_count",
        "instance_status"
      ],
      "properties": {
        "instance_status": {
          "type": "string",
          "description": "执行实例状态"
        },
        "instance_count": {
          "type": "integer",
          "format": "int32",
          "description": "该状态下执行实例个数"
        },
        "batch_indexes": {
          "type": "array",
          "description": "该状态下批次index列表",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "description": "执行实例状态和批次统计"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "coc-intl.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}