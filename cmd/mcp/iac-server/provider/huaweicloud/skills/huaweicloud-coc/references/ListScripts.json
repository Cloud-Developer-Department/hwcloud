{
  "name": "ListScripts",
  "summary": "查询脚本列表",
  "tags": "ScriptManagement",
  "productshort": "COC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/job/scripts": {
      "get": {
        "tags": [
          "ScriptManagement"
        ],
        "summary": "查询脚本列表",
        "description": "作业脚本列表:自定义脚本\n\nlimit最大为100",
        "operationId": "ListScripts",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "分页参数:每页返回记录个数限制",
            "required": true,
            "type": "integer",
            "maximum": 100,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "分页参数:上一页最后一个记录id",
            "required": false,
            "type": "integer",
            "maximum": 9223372036854775807,
            "minimum": 0,
            "format": "int64"
          },
          {
            "name": "name_like",
            "in": "query",
            "description": "脚本名(模糊)",
            "required": false,
            "type": "string",
            "maxLength": 32,
            "minLength": 1
          },
          {
            "name": "creator",
            "in": "query",
            "description": "创建人",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "name": "risk_level",
            "in": "query",
            "description": "风险等级\nLOW:低风险\nMEDIUM:中风险\nHIGH:高风险",
            "required": false,
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          {
            "name": "type",
            "in": "query",
            "description": "脚本类型\nSHELL:shell脚本\nPYTHON:python脚本\nBAT:Bat脚本",
            "required": false,
            "type": "string",
            "enum": [
              "SHELL",
              "PYTHON",
              "BAT"
            ]
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目id",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户token",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "国际化标记,zh-cn表示中文,en-us或不传表示英文",
            "required": false,
            "type": "string"
          },
          {
            "name": "x-project-id",
            "in": "header",
            "description": "项目ID,一个项目对应一个region",
            "required": false,
            "type": "string"
          },
          {
            "name": "x-user-profile",
            "in": "header",
            "description": "IAM5.0用户信息",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "脚本分页数据",
            "examples": {
              "application/json": {
                "data": {
                  "total": 70,
                  "data": [
                    {
                      "id": 6229,
                      "name": "测试111",
                      "type": "SHELL",
                      "creator": "runbook_notif",
                      "creator_id": "e56462d17f334b8789ff0b5b9cca3bb9",
                      "gmt_created": 1701314214271,
                      "status": "APPROVED",
                      "script_uuid": "SC20231130111654023511657",
                      "usage_count": 0,
                      "properties": {
                        "risk_level": "HIGH",
                        "reviewers": [],
                        "version": "1.0.0"
                      },
                      "enterprise_project_id": 0
                    },
                    {
                      "id": 6228,
                      "name": "测试11",
                      "type": "SHELL",
                      "creator": "runbook_notif",
                      "creator_id": "e56462d17f334b8789ff0b5b9cca3bb9",
                      "gmt_created": 1701314090063,
                      "status": "APPROVED",
                      "script_uuid": "SC20231130111450026f7f8b2",
                      "usage_count": 0,
                      "properties": {
                        "risk_level": "LOW",
                        "reviewers": [],
                        "version": "1.0.0"
                      },
                      "enterprise_project_id": 0
                    }
                  ]
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ScriptListPageResponse"
            }
          },
          "400": {
            "description": "包含错误信息",
            "examples": {
              "application/json": {
                "error_code": "COC.00040701",
                "error_msg": "error_msg"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-apiexplorer-hide": false,
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-order": 2
      }
    }
  },
  "definitions": {
    "ScriptPropertiesModel": {
      "type": "object",
      "required": [
        "risk_level",
        "version"
      ],
      "properties": {
        "risk_level": {
          "type": "string",
          "example": "LOW",
          "description": "风险等级\nLOW:低风险\nMEDIUM:中风险\nHIGH:高风险",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "version": {
          "type": "string",
          "example": "v1.0.0",
          "description": "脚本版本号",
          "minLength": 1,
          "maxLength": 10
        },
        "reviewers": {
          "type": "array",
          "description": "审批人,不填写不需要审批",
          "items": {
            "$ref": "#/definitions/ReviewerInfo"
          },
          "maxItems": 5,
          "minItems": 0,
          "x-internal": "false"
        },
        "protocol": {
          "type": "string",
          "example": "WECHAT",
          "description": "审批消息通知协议,用于通知审批人\nDEFAULT:默认\nSMS:短信\nEMAIL:邮件\nDING_TALK:钉钉\nWE_LINK:welink\nWECHAT:微信\nCALLNOTIFY:语言\nNOT_TO_NOTIFY:不通知",
          "enum": [
            "DEFAULT",
            "SMS",
            "EMAIL",
            "DING_TALK",
            "WE_LINK",
            "WECHAT",
            "CALLNOTIFY",
            "NOT_TO_NOTIFY"
          ],
          "x-internal": false
        }
      },
      "description": "脚本标签:风险等级risk_level(取值范围:LOW/MEDIUM/HIGH)、审批人reviewer、脚本解释器interpreter等"
    },
    "ReviewerInfo": {
      "type": "object",
      "required": [
        "reviewer_id",
        "reviewer_name"
      ],
      "properties": {
        "reviewer_name": {
          "type": "string",
          "example": "test",
          "description": "审批人名称(IAM用户名)",
          "minLength": 1,
          "maxLength": 64
        },
        "reviewer_id": {
          "type": "string",
          "example": "e99a6f27cfe7497084ac9c07bfa573d7",
          "description": "审批人ID(IAM用户Id)",
          "minLength": 0,
          "maxLength": 32
        }
      },
      "description": "审批人信息"
    },
    "ScriptListModel": {
      "type": "object",
      "required": [
        "creator",
        "creator_id",
        "enterprise_project_id",
        "gmt_created",
        "id",
        "name",
        "properties",
        "script_uuid",
        "status",
        "type"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "example": 12,
          "description": "脚本自增id",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "script_uuid": {
          "type": "string",
          "example": "SC2023082920065102fc49ec0",
          "description": "脚本uuid",
          "minLength": 1,
          "maxLength": 25
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID,默认为:0"
        },
        "name": {
          "type": "string",
          "example": "echotest",
          "description": "脚本名称",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "description": "脚本类型\nSHELL:shell脚本\nPYTHON:python脚本\nBAT:bat脚本",
          "enum": [
            "SHELL",
            "PYTHON",
            "BAT"
          ]
        },
        "status": {
          "type": "string",
          "description": "脚本状态\nPENDING_APPROVE:待审批\nAPPROVED:正常(审批通过)\nREJECTED:驳回(审批人,驳回该脚本",
          "enum": [
            "PENDING_APPROVE",
            "APPROVED",
            "REJECTED"
          ]
        },
        "gmt_created": {
          "type": "integer",
          "format": "int64",
          "example": 1691750512367,
          "description": "创建时间",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "gmt_modified": {
          "type": "integer",
          "format": "int64",
          "example": 1691750512367,
          "description": "修改时间",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "creator": {
          "type": "string",
          "example": "testacc",
          "description": "创建人",
          "minLength": 1,
          "maxLength": 64
        },
        "creator_id": {
          "type": "string",
          "example": "9fec03ee5b1040818b91bef6e16213df",
          "description": "创建人Id",
          "minLength": 1,
          "maxLength": 64
        },
        "operator": {
          "type": "string",
          "example": "operator",
          "description": "修改人",
          "minLength": 1,
          "maxLength": 64
        },
        "properties": {
          "description": "脚本标签:风险等级risk_level(取值范围:LOW/MEDIUM/HIGH)、审批人reviewer",
          "$ref": "#/definitions/ScriptPropertiesModel"
        }
      },
      "description": "**遗留问题**\n1. 脚本入参限制:参数个数、参数长度、参数合法范围\n2. 字段长度和范围待定义"
    },
    "ScriptListPage": {
      "type": "object",
      "required": [
        "data",
        "total"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "format": "int64",
          "example": 37,
          "description": "总条数",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "data": {
          "type": "array",
          "description": "单页数据列表",
          "items": {
            "$ref": "#/definitions/ScriptListModel"
          },
          "maxItems": 100,
          "minItems": 1
        }
      },
      "description": "脚本列表分页数据"
    },
    "ScriptListPageResponse": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "description": "脚本列表返回体",
          "$ref": "#/definitions/ScriptListPage"
        }
      },
      "description": "脚本列表返回体"
    },
    "ErrorRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误对象"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "coc.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}