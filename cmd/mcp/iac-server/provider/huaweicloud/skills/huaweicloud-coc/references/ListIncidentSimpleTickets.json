        ],
        "x-sre-api-type": "D",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-publish": true,
        "operationId": "ListIncidentSimpleTickets",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "列表查询接口分页参数,表示当前查询第几页,1表示查询第一页。",
            "type": "integer",
            "format": "int32",
            "default": 1,
            "allowEmptyValue": true,
            "minimum": 1,
            "maximum": 2147483647
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "列表查询接口分页参数,表示一页查询多少条数据,该值需大于等于1且为整数,表示分页查询时每一页最多查到的数量。",
            "type": "integer",
            "format": "int32",
            "default": 50,
            "allowEmptyValue": true,
            "minimum": 1,
            "maximum": 100
          }
        ],
        "responses": {
