  "definitions": {
    "CapacityWebListRequest": {
      "required": [
        "provider_obj"
      ],
      "type": "object",
      "description": "**参数解释:**\n应用容量数据请求体。\n**约束限制:**\n不涉及。\n**取值范围:**\n请求体内容按照properties下的参数说明传参。\n**默认取值:**\n不涉及。",
      "properties": {
        "group_id": {
          "type": "string",
          "description": "**参数解释:**\n用户选择当前分组对应的id值。\n**约束限制:**\n应用、组件和分组ID,有且仅有1个有值。\n**取值范围:**\n字符串,长度24个字符。\n**默认取值:**\n不涉及。",
          "example": "6823fb3a2717d06da880477f",
          "minLength": 24,
          "maxLength": 24
        },
        "component_id": {
          "type": "string",
          "description": "**参数解释:**\n用户选择当前组件对应的id值。\n**约束限制:**\n应用、组件和分组ID,有且仅有1个有值。\n**取值范围:**\n字符串,长度24个字符。\n**默认取值:**\n不涉及。",
          "example": "6823fb1d2717d06da8804777",
          "minLength": 24,
          "maxLength": 24
        },
        "application_id": {
          "type": "string",
          "description": "**参数解释:**\n用户选择当前应用对应的id值。\n**约束限制:**\n应用、组件和分组ID,有且仅有1个有值。\n**取值范围:**\n字符串,长度24个字符。\n**默认取值:**\n不涉及。",
          "example": "6780dec23f1b240bc0295d11",
          "minLength": 24,
          "maxLength": 24
        },
        "domain_id": {
          "type": "string",
          "description": "**参数解释:**\n用户登录租户对应的账号ID即租户id。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "minLength": 32,
          "maxLength": 32
        },
        "provider_obj": {
          "type": "array",
          "description": "**参数解释:**\n资源对象。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "description": "**参数解释:**\n云服务名称。\n**约束限制:**\n不涉及。\n**取值范围:**\n字符串,长度1到64个字符。\n**默认取值:**\n不涉及。",
                "example": "ecs",
                "minLength": 1,
                "maxLength": 64
              },
              "type": {
                "type": "string",
                "description": "**参数解释:**\n资源类型名称。\n**约束限制:**\n不涉及。\n**取值范围:**\n资源类型较多,根据实际业务选择资源类型、常用资源类型如下:\n- cloudservers:弹性云服务器。\n- servers:裸金属服务器。\n- clusters:云容器引擎。\n- instances:云数据库。\n**默认取值:**\n不涉及。",
                "example": "cloudservers"
              }
            }
          }
        }
      }
    },
    "CapacityOverviewResponse": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "maxItems": 500,
          "description": "**参数解释:**\n容量数据列表。\n**取值范围:**\n查询已选应用下的云服务容量数据组成列表,大小在0到500之间。",
          "items": {
            "type": "object",
            "properties": {
              "sum_size": {
                "type": "string",
                "readOnly": true,
                "description": "**参数解释:**\n硬盘大小总量。\n**取值范围:**\n云服务对应的总内存。"
              },
              "sum_cpu": {
                "type": "string",
                "readOnly": true,
                "description": "**参数解释:**\nCPU分配量总量。\n**取值范围:**\n不涉及。"
              },
              "sum_mem": {
                "type": "string",
                "readOnly": true,
                "description": "**参数解释:**\n内存分配量总量。\n**取值范围:**\n不涉及。"
              },
              "provider": {
                "type": "string",
                "readOnly": true,
                "description": "**参数解释:**\n云服务类型。\n**取值范围:**\n不涉及。",
                "minLength": 1,
                "maxLength": 64
              },
              "type": {
                "type": "string",
                "description": "**参数解释:**\n云服务资源类型。。\n**取值范围:**\n资源类型较多,根据实际业务选择资源类型、常用资源类型如下:\n- cloudservers:弹性云服务器。\n- servers:裸金属服务器。\n- clusters:云容器引擎。\n- instances:云数据库。"
              }
            }
          }
        }
      }
    }
  },
