{
  "name": "ListScriptJobs",
  "summary": "展示工单列表",
  "tags": "ScriptExecutionManagement",
  "productshort": "COC",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/job/script/orders": {
      "get": {
        "tags": [
          "ScriptExecutionManagement"
        ],
        "summary": "展示工单列表",
        "description": "查询作业工单列表,分页查询\n过滤:创建时间开始,创建时间结束、创建人\n返回:id、脚本名称、区域、创建人、创建时间、结束时间、总耗时、状态",
        "operationId": "ListScriptJobs",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "分页参数",
            "required": false,
            "type": "integer",
            "maximum": 100,
            "minimum": 1,
            "format": "int32"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "分页参数",
            "required": false,
            "type": "integer",
            "maximum": 2147483647,
            "minimum": 1,
            "format": "int64"
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "创建时间开始",
            "required": false,
            "type": "integer",
            "maximum": 2147483647,
            "minimum": 1,
            "format": "int64"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "创建时间结束",
            "required": false,
            "type": "integer",
            "maximum": 2147483647,
            "minimum": 1,
            "format": "int64"
          },
          {
            "name": "creator",
            "in": "query",
            "description": "创建人",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "name": "status",
            "in": "query",
            "description": "工单状态\nPROCESSING:执行中\nABNORMAL:异常\nPAUSED:暂停\nCANCELED:已取消\nFINISHED:成功",
            "required": false,
            "type": "string",
            "enum": [
              "PROCESSING",
              "ABNORMAL",
              "PAUSED",
              "CANCELED",
              "FINISHED"
            ]
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户token",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "国际化标记,zh-cn表示中文,en-us或不传表示英文",
            "required": false,
            "type": "string"
          },
          {
            "name": "x-project-id",
            "in": "header",
            "description": "项目ID,一个项目对应一个region",
            "required": false,
            "type": "string"
          },
          {
            "name": "x-user-profile",
            "in": "header",
            "description": "IAM5.0用户信息",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "执行分页数据",
            "examples": {
              "application/json": "{\n    \"data\": {\n        \"total\": 222,\n        \"data\": [\n            {\n                \"order_id\": 74,\n                \"order_name\": \"071201\",\n                \"execute_uuid\": \"SCT20230724201xxxxxxxxxxxx\",\n                \"gmt_created\": 1690200829451,\n                \"gmt_finished\": 1690200850293,\n                \"execute_costs\": 20842,\n                \"creator\": \"xxxxxxxxxxxcontainer1\",\n                \"status\": \"CANCELED\",\n                \"properties\": {\n                    \"region_ids\": \"cn-north-7\"\n                }\n            },\n            {\n                \"order_id\": 73,\n                \"order_name\": \"071201\",\n                \"execute_uuid\": \"SCT2023072411xxxxxxxxxxxxx\",\n                \"gmt_created\": 1690168434460,\n                \"gmt_finished\": 1690168443277,\n                \"execute_costs\": 8817,\n                \"creator\": \"xxxxxxxxxxxcontainer1\",\n                \"status\": \"FINISHED\",\n                \"properties\": {\n                    \"region_ids\": \"cn-north-7\"\n                }\n            },\n            {\n                \"order_id\": xx,\n                \"order_name\": \"xxx\",\n                \"execute_uuid\": \"SCT2023072217181xxxxxxxxxx\",\n                \"gmt_created\": 1690017490247,\n                \"gmt_finished\": null,\n                \"execute_costs\": null,\n                \"creator\": \"xxxxxxxxxxxcontainer1\",\n                \"status\": \"ABNORMAL\",\n                \"properties\": {\n                    \"region_ids\": \"cn-north-7\"\n                }\n            },\n            {\n                \"order_id\": 71,\n                \"order_name\": \"patch_730\",\n                \"execute_uuid\": \"SCT2023071915xxxxxxxxxxxxx\",\n                \"gmt_created\": 1689753553241,\n                \"gmt_finished\": 1689753579363,\n                \"execute_costs\": 26122,\n                \"creator\": \"xxxxxxxxxxxcontainer1\",\n                \"status\": \"FINISHED\",\n                \"properties\": {\n                    \"region_ids\": \"cn-north-7\"\n                }\n            },\n            {\n                \"order_id\": 70,\n                \"order_name\": \"111\",\n                \"execute_uuid\": \"SCT2023071915xxxxxxxxxxxxx\",\n                \"gmt_created\": 1689751168547,\n                \"gmt_finished\": null,\n                \"execute_costs\": null,\n                \"creator\": \"xxxxxxxxxxxcontainer1\",\n                \"status\": \"ABNORMAL\",\n                \"properties\": {\n                    \"region_ids\": \"cn-north-7\"\n                }\n            }\n        ]\n    }\n}"
            },
            "schema": {
              "$ref": "#/definitions/ListScriptOrdersRes"
            }
          }
        },
        "x-apiexplorer-hide": false,
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "JobScriptOrderListPage": {
      "type": "object",
      "required": [
        "data",
        "total"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "format": "int64",
          "description": "总条数"
        },
        "data": {
          "type": "array",
          "description": "单页数据列表",
          "items": {
            "$ref": "#/definitions/JobScriptOrderListModel"
          },
          "maxItems": 100,
          "minItems": 1
        }
      },
      "description": "脚本工单列表,分页数据"
    },
    "JobScriptOrderListModel": {
      "type": "object",
      "required": [
        "execute_uuid",
        "order_id",
        "order_name"
      ],
      "properties": {
        "order_id": {
          "type": "integer",
          "format": "int64",
          "example": 23,
          "description": "主键id,对应job_order_do的主键",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "order_name": {
          "type": "string",
          "example": "testEcho",
          "description": "工单名称",
          "minLength": 1,
          "maxLength": 64
        },
        "execute_uuid": {
          "type": "string",
          "description": "列表跳转到详情时,用这个uuid,对应execute_data_do的execute_uuid"
        },
        "gmt_created": {
          "type": "integer",
          "format": "int64",
          "description": "创建时间"
        },
        "gmt_finished": {
          "type": "integer",
          "format": "int64",
          "description": "完成时间"
        },
        "execute_costs": {
          "type": "integer",
          "format": "int64",
          "description": "执行耗时,单位:秒"
        },
        "creator": {
          "type": "string",
          "description": "创建人"
        },
        "status": {
          "type": "string",
          "description": "工单状态",
          "enum": [
            "READY",
            "PROCESSING",
            "ABNORMAL",
            "PAUSED",
            "CANCELED",
            "FINISHED"
          ]
        },
        "properties": {
          "description": "标签:区域信息等",
          "$ref": "#/definitions/JobScriptOrderListProp"
        }
      },
      "description": "作业脚本工单列表"
    },
    "ListScriptOrdersRes": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "description": "展示工单列表返回结果",
          "$ref": "#/definitions/JobScriptOrderListPage"
        }
      },
      "description": "展示工单列表"
    },
    "JobScriptOrderListProp": {
      "type": "object",
      "properties": {
        "region_ids": {
          "type": "string",
          "description": "CMDB服务实例区域id,可能有多个"
        }
      },
      "description": "脚本工单属性"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "coc-intl.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}