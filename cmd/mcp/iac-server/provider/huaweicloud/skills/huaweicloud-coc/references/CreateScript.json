{
  "name": "CreateScript",
  "summary": "创建脚本",
  "tags": "ScriptManagement",
  "productshort": "COC",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/job/scripts": {
      "post": {
        "tags": [
          "ScriptManagement"
        ],
        "summary": "创建脚本",
        "description": "创建作业脚本:自定义脚本\n- 脚本有标签属性,表示是高危脚本。创建时候不需要对脚本进行是否是高危的二次校验。\n- 进行租户隔离;北向接口创建的脚本,审批人字段不填写,默认不需要审批\n- 约束条件:\n- 脚本名称:同一租户下,脚本名称不能重复,最大字符64个字符,支持中文+字母+数字+下划线。\n- 脚本内容最大100kb。\n- 脚本参数个数最多20个。\n- 脚本描述:最大256个字符。\n- 单个参数的参数名称 64个字符,只支持字母+数字+下划线。\n- 单个参数的值最大1024个字符,正则表达式如下:^((?!\\.{2,})[a-zA-Z0-9_\\-\\/\\.\\*\\x20\\?:\",=+@\\\\\\[\\{\\]\\}])*$。\n- 审批人最多支持5人。\n- 脚本输出的日志总量只支持1MB。",
        "operationId": "CreateScript",
        "parameters": [
          {
            "in": "body",
            "name": "CreateScriptsRequestBody",
            "description": "添加脚本的请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AddScriptModel"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户token",
            "required": true,
            "type": "string"
          },
          {
            "name": "x-project-id",
            "in": "header",
            "description": "项目ID,一个项目对应一个region",
            "required": false,
            "type": "string"
          },
          {
            "name": "x-user-profile",
            "in": "header",
            "description": "IAM5.0用户信息",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "国际化标记,zh-cn表示中文,en-us或不传表示英文",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "脚本uuid",
            "examples": {
              "application/json": {
                "data": "SC2023102521413701c4a8a62"
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateScriptsResponse"
            }
          },
          "400": {
            "description": "包含错误信息",
            "examples": {
              "application/json": {
                "error_code": "COC.00040701",
                "error_msg": "script_params size must be between 0 and 50"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-apiexplorer-hide": false,
        "x-request-examples-url-1": "https://coc.myhuaweicloud.com/v1/job/scripts",
        "x-request-examples-description-1": "实例请求体",
        "x-request-examples-text-1": {
          "type": "SHELL",
          "content": "echo ${value}",
          "name": "09101112",
          "description": "实例脚本",
          "properties": {
            "risk_level": "HIGH",
            "version": "1.0.0",
            "reviewers": [
              {
                "reviewer_name": "test",
                "reviewer_id": "7a8513cd87b7448283a1d5190eb91234"
              }
            ],
            "protocol": "WECHAT"
          },
          "script_params": [
            {
              "param_name": "a",
              "param_value": "string",
              "param_description": "string",
              "param_order": 1,
              "sensitive": true
            }
          ]
        },
        "x-request-examples-1": {
          "type": "SHELL",
          "content": "echo ${value}",
          "name": "09101112",
          "description": "实例脚本",
          "properties": {
            "risk_level": "HIGH",
            "version": "1.0.0",
            "reviewers": [
              {
                "reviewer_name": "test",
                "reviewer_id": "7a8513cd87b7448283a1d5190eb91234"
              }
            ],
            "protocol": "WECHAT"
          },
          "script_params": [
            {
              "param_name": "a",
              "param_value": "string",
              "param_description": "string",
              "param_order": 1,
              "sensitive": true
            }
          ]
        },
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-order": 0
      }
    }
  },
  "definitions": {
    "AddScriptModel": {
      "type": "object",
      "required": [
        "content",
        "description",
        "name",
        "properties",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "exampleScript",
          "description": "脚本名称:只能包含中文、英文、数字、下划线",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[\\一-\\龥A-Za-z0-9_]+$"
        },
        "properties": {
          "description": "脚本标签:\n- 风险等级risk_level(取值范围:LOW/MEDIUM/HIGH)、审批人reviewer、脚本解释器interpreter等",
          "$ref": "#/definitions/ScriptPropertiesModel"
        },
        "description": {
          "type": "string",
          "example": "示例脚本",
          "description": "脚本描述",
          "minLength": 1,
          "maxLength": 256
        },
        "type": {
          "type": "string",
          "example": "SHELL",
          "description": "脚本类型:\n对于脚本后缀:\nSHELL:.sh\nPYTHON:.py\nBAT:.bat",
          "enum": [
            "SHELL",
            "PYTHON",
            "BAT"
          ]
        },
        "content": {
          "type": "string",
          "example": "echo ${value}",
          "description": "脚本内容",
          "minLength": 1,
          "maxLength": 4096
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID,默认为:0",
          "default": "0"
        },
        "script_params": {
          "type": "array",
          "description": "脚本入参",
          "items": {
            "$ref": "#/definitions/ScriptParamDefine"
          },
          "maxItems": 20,
          "minItems": 0
        }
      },
      "description": "**约束:**\n- 1. 同poject_id下不允许同名脚本\n- 2. 修改脚本时,不允许修改:脚本名称、project_id\n- 3. 字段长度和范围限制\n\n- 脚本内容长度,创建时为做校验"
    },
    "ScriptPropertiesModel": {
      "type": "object",
      "required": [
        "risk_level",
        "version"
      ],
      "properties": {
        "risk_level": {
          "type": "string",
          "example": "LOW",
          "description": "风险等级\nLOW:低风险\nMEDIUM:中风险\nHIGH:高风险",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "version": {
          "type": "string",
          "example": "v1.0.0",
          "description": "脚本版本号",
          "minLength": 1,
          "maxLength": 10
        },
        "reviewers": {
          "type": "array",
          "description": "审批人,不填写不需要审批",
          "items": {
            "$ref": "#/definitions/ReviewerInfo"
          },
          "maxItems": 5,
          "minItems": 0,
          "x-internal": "false"
        },
        "protocol": {
          "type": "string",
          "example": "WECHAT",
          "description": "审批消息通知协议,用于通知审批人\nDEFAULT:默认\nSMS:短信\nEMAIL:邮件\nDING_TALK:钉钉\nWE_LINK:welink\nWECHAT:微信\nCALLNOTIFY:语言\nNOT_TO_NOTIFY:不通知",
          "enum": [
            "DEFAULT",
            "SMS",
            "EMAIL",
            "DING_TALK",
            "WE_LINK",
            "WECHAT",
            "CALLNOTIFY",
            "NOT_TO_NOTIFY"
          ],
          "x-internal": false
        }
      },
      "description": "脚本标签:风险等级risk_level(取值范围:LOW/MEDIUM/HIGH)、审批人reviewer、脚本解释器interpreter等"
    },
    "ReviewerInfo": {
      "type": "object",
      "required": [
        "reviewer_id",
        "reviewer_name"
      ],
      "properties": {
        "reviewer_name": {
          "type": "string",
          "example": "test",
          "description": "审批人名称(IAM用户名)",
          "minLength": 1,
          "maxLength": 64
        },
        "reviewer_id": {
          "type": "string",
          "example": "e99a6f27cfe7497084ac9c07bfa573d7",
          "description": "审批人ID(IAM用户Id)",
          "minLength": 0,
          "maxLength": 32
        }
      },
      "description": "审批人信息"
    },
    "CreateScriptsResponse": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "string",
          "example": "SC2023102521413701cxxxx",
          "description": "script_uuid",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "description": "创建脚本的返回体:script_uuid"
    },
    "ScriptParamDefine": {
      "type": "object",
      "required": [
        "param_description",
        "param_name",
        "param_value",
        "param_order",
        "sensitive"
      ],
      "properties": {
        "param_name": {
          "type": "string",
          "example": "value",
          "description": "参数名仅支持字母、数字以及下划线",
          "minLength": 1,
          "maxLength": 64
        },
        "param_value": {
          "type": "string",
          "example": "test",
          "description": "1.参数长度为1-4096位\n2.可以包含大写字母、小写字母、数字及特殊字符(_-/.* ?:\",=+@#\\[{]})\n3.禁止出现连续'.'",
          "minLength": 0,
          "maxLength": 4096
        },
        "param_description": {
          "type": "string",
          "example": "测试参数",
          "description": "参数描述",
          "minLength": 0,
          "maxLength": 256
        },
        "param_order": {
          "type": "integer",
          "format": "int32",
          "description": "该参数已废弃,传入该参数不会生效。"
        },
        "sensitive": {
          "type": "boolean",
          "example": false,
          "description": "是否是敏感参数"
        }
      },
      "description": "顺序参数,没有参数名字段\n参数顺序,从1开始,不连续会报错\n\napi层用不同的vo对象接收,管理面没有order字段。service层统一处理差异\n\n拼接:sh xxx.sh  'aaa' 'a' 'b'\n执行时值为空:sh xxx.sh  '' 'a' 'b'"
    },
    "ErrorRsp": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      },
      "description": "失败时返回的错误对象"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "coc-intl.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}