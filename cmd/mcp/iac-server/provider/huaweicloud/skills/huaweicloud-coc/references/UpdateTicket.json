              "example": "phase_change_end",
              "minLength": 0,
              "maxLength": 255
            },
            "work_flow_status": {
              "type": "string",
              "description": "工单状态。",
              "example": "COMPLETE",
              "minLength": 0,
              "maxLength": 255
            }
          },
          "example": null
        },
        "sub_tickets": {
          "description": "变更子单信息。",
