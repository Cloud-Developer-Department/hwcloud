              "verified_docs": {
                "type": "string",
                "description": "验证文档ID。",
                "example": "170b5-8756-489a-9f23-12e7",
                "minLength": 0,
                "maxLength": 1000
              },
              "comment": {
                "type": "string",
                "description": "变更失败原因描述。",
                "example": "备注信息",
                "minLength": 0,
                "maxLength": 10000
