              "rollback_end_time": {
                "type": "integer",
                "format": "int64",
                "description": "回退结束时间。",
                "example": 1677674295413,
                "minimum": 0,
                "maximum": 9999999999999
              },
              "is_rollback_success": {
                "type": "boolean",
                "description": "是否回退成功。"
              },
              "is_monitor_found": {
                "type": "boolean",
                "description": "是否被监控发现。"
              }
            }
          },
          "type": "array"
        },
        "history_info": {
          "description": "变更历史信息。",
