{
  "name": "AcceptScript",
  "summary": "审批待审批的脚本",
  "tags": "ScriptManagement",
  "productshort": "COC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/job/scripts/{script_uuid}/action": {
      "post": {
        "x-apiexplorer-hide": false,
        "x-api-type": "open-api",
