        "x-is-registered": "Y",
        "tags": [
          "ScriptManagement"
        ],
        "summary": "审批待审批的脚本",
        "description": "功能:审批脚本。\n约束条件:只有创建脚本填写了审批人,脚本为待审批状态才能审批。",
        "operationId": "AcceptScript",
        "parameters": [
          {
            "name": "script_uuid",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "脚本Uuid",
            "minLength": 1,
            "maxLength": 25
          },
          {
            "name": "AcceptScriptRequestBody",
            "in": "body",
            "required": true,
            "description": "脚本审批",
            "schema": {
              "$ref": "#/definitions/ApprovalJobScriptModel"
            }
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/x-project-id"
          },
          {
            "$ref": "#/parameters/x-user-profile"
          },
          {
            "$ref": "#/parameters/X-Language"
          }
        ],
        "responses": {
          "200": {
            "description": "审批结果。\n更多状态码请参考[状态码](coc_api_05_03.xml)。",
            "schema": {
              "$ref": "#/definitions/AcceptScriptRes"
            }
          }
        },
        "x-order": 1
      }
    }
  },
  "definitions": {
    "ApprovalJobScriptModel": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "example": "APPROVED",
          "description": "审批状态\nAPPROVED:审批通过\nREJECTED:审批不通过",
          "enum": [
            "APPROVED",
            "REJECTED"
          ]
        },
        "comments": {
          "type": "string",
          "example": "通过",
          "description": "审批意见",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "description": "审批脚本\n\ncomments 长度未做限制"
    },
    "AcceptScriptRes": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "boolean",
          "description": "审批结果"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "type": "string",
      "description": "租户token。"
