{
  "name": "OperateScriptJob",
  "summary": "操作脚本工单",
  "tags": "ScriptExecutionManagement",
  "productshort": "COC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/job/script/orders/{execute_uuid}/operation": {
      "put": {
        "tags": [
          "ScriptExecutionManagement"
        ],
        "summary": "操作脚本工单",
        "description": "操作类型:取消实例、跳过批次、取消整个工单、暂停整个工单、继续整个工单",
        "operationId": "OperateScriptJob",
        "parameters": [
          {
            "name": "execute_uuid",
            "in": "path",
            "description": "脚本工单的执行Id,取自executeJobScript和ListJobScriptOrders返回体中",
            "required": true,
            "type": "string",
            "maxLength": 26,
            "minLength": 1
          },
          {
            "in": "body",
            "name": "UpdateScriptOrderRequestBody",
            "description": "工单操作请求体",
            "required": false,
            "schema": {
              "$ref": "#/definitions/JobScriptOrderOperationBody"
            }
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "租户token",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "国际化标记,zh-cn表示中文,en-us或不传表示英文",
            "required": false,
            "type": "string"
          },
          {
            "name": "x-project-id",
            "in": "header",
            "description": "项目ID,一个项目对应一个region",
            "required": false,
            "type": "string"
          },
          {
            "name": "x-user-profile",
            "in": "header",
            "description": "IAM5.0用户信息",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "execution_uuid",
            "examples": {
              "application/json": {
                "data": "SCT2023121119543302aa91a06"
              }
            },
            "schema": {
              "$ref": "#/definitions/UpdateScriptOrderRes"
            }
          }
        },
        "x-apiexplorer-hide": false,
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "JobScriptOrderOperationBody": {
      "type": "object",
      "required": [
        "operation_type"
      ],
      "properties": {
        "batch_index": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "适用于批次操作时",
          "minimum": 1,
          "maximum": 20
        },
        "instance_id": {
          "type": "integer",
          "format": "int64",
          "example": 9223,
          "description": "适用于实例操作时\n非script_execute_instance_do中iD,需要新增字段",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "operation_type": {
          "type": "string",
          "example": "CANCEL_INSTANCE",
          "description": "操作类型:取消实例、跳过批次、取消整个工单、暂停整个工单、继续整个工单\nCANCEL_INSTANCE:取消实例\nSKIP_BATCH:跳过批次\nCANCEL_ORDER:取消整个工单\nPAUSE_ORDER:暂停整个工单\nCONTINUE_ORDER:继续整个工单",
          "enum": [
            "CANCEL_INSTANCE",
            "SKIP_BATCH",
            "CANCEL_ORDER",
            "PAUSE_ORDER",
            "CONTINUE_ORDER"
          ]
        }
      },
      "description": "工单操作对象\noperation_type为\nCANCEL_INSTANCE:取消实例,instance_id 不能为空;\nSKIP_BATCH: 跳过当前批次,batch_index不能为空;\nCANCEL_ORDER:取消工单,batch_index和instance_id可为空;\nPAUSE_ORDER:暂停工单,batch_index和instance_id可为空;\nCONTINUE_ORDER:继续工单,batch_index和instance_id可为空"
    },
    "UpdateScriptOrderRes": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "string",
          "example": "SCT2023083109562601af694bf",
          "description": "操作的工单execute_uuid"
        }
      },
      "description": "操作脚本工单返回结果"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "coc.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}