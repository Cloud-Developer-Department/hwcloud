{
  "name": "ListInstancesBatch",
  "summary": "获取自动分批结果",
  "tags": "ScriptManagement",
  "productshort": "COC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/instances/batches": {
      "post": {
        "x-apiexplorer-hide": false,
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "tags": [
          "ScriptManagement"
        ],
        "summary": "获取自动分批结果",
        "description": "根据分批策略获取分批结果,只支持自动分批:\n规则如下:\n1.单个批次的所有实例必须属于同一个区域;\n     * 2.单个批次的所有实例必须属于同一个可用区;\n     * 3.单个批次的所有实例必须属于同一个应用;\n     * 4.单个批次内同一分组下的实例不超过50%(除分组下仅以一个实例的情况外);\n     * 5.前三批每批节点数量不超过10。\n     * 6.每批次实例数量不超过10。\n\n   总机器数量为200。",
        "operationId": "ListInstancesBatch",
        "parameters": [
          {
            "name": "ListInstancesBatchRequestBody",
            "in": "body",
            "required": true,
            "description": "分批请求体。",
            "schema": {
              "$ref": "#/definitions/InstancesBatchesMode"
            }
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/X-Language"
          },
          {
            "$ref": "#/parameters/x-project-id"
          },
          {
            "$ref": "#/parameters/x-user-profile"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。\n更多状态码请参考[状态码](coc_api_05_03.xml)。",
            "schema": {
              "$ref": "#/definitions/ListInstancesBatchRes"
            }
          }
        },
        "x-order": 8
      }
    }
  },
  "definitions": {
    "ResourceInstance": {
      "type": "object",
      "required": [
        "provider",
        "region_id",
        "resource_id",
        "type"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "example": "66006c8e-dc6b-45bb-a65b-6f8a3700392f",
          "description": "实例唯一id"
        },
        "provider": {
          "type": "string",
          "description": "资源提供者:ECS。单个脚本工单, 每个实例的provider是一致的"
        },
        "region_id": {
          "type": "string",
          "description": "机器所属region的ID"
        },
        "type": {
          "type": "string",
          "description": "资源提供者下资源类型,不传默认为CLOUDSERVER\nCLOUDSERVER:CLOUDSERVER类型",
          "enum": [
            "CLOUDSERVER"
          ]
        },
        "custom_attributes": {
          "type": "array",
          "description": "支持用户自定义5个key_value形式的属性。\n约束条件:\n\t- key值长度为20\n    - value长度为50\n    - map长度最大为5",
          "items": {
            "$ref": "#/definitions/Customttribute"
          }
        },
        "agent_sn": {
          "type": "string",
          "example": "7aec98ca0edd45bc8145005c1892cb3a",
          "description": "agent纳管id。该参数即将废弃,请勿使用。"
        },
        "agent_status": {
          "type": "string",
          "example": "ONLINE",
          "description": "agent纳管状态。该参数即将废弃,请勿使用。"
        },
        "properties": {
          "description": "主机附加属性。该参数即将废弃,请勿使用。",
          "$ref": "#/definitions/ResourceInstanceProp"
        }
      }
    },
    "InstancesBatchesMode": {
      "type": "object",
      "required": [
        "batch_strategy",
        "target_instances"
      ],
      "properties": {
        "batch_strategy": {
          "type": "string",
          "example": "AUTO_BATCH",
          "description": "分批策略:只支持自动分批",
          "enum": [
            "AUTO_BATCH"
          ]
        },
        "target_instances": {
          "type": "array",
          "description": "目标主机实例",
          "items": {
            "$ref": "#/definitions/ResourceInstance"
          },
          "maxItems": 200,
          "minItems": 1
        }
      },
      "description": "需要分批的机器"
    },
    "InstancesBatchResultMode": {
      "type": "object",
      "required": [
        "batch_index",
        "target_instances"
      ],
      "properties": {
        "batch_index": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "批次Id",
          "minimum": 1,
          "maximum": 20
        },
        "target_instances": {
          "type": "array",
          "description": "当前批次内机器",
          "items": {
            "$ref": "#/definitions/ResourceInstance"
          },
          "maxItems": 10,
          "minItems": 1
        }
      },
      "description": "获取分批结果返回体"
    },
    "ResourceInstanceProp": {
      "type": "object",
      "required": [
        "fixed_ip",
        "host_name",
        "region_id",
        "zone_id"
      ],
      "properties": {
        "host_name": {
          "type": "string",
          "example": "coc-cdr001-0002",
          "description": "主机名\n未校验:长度"
        },
        "fixed_ip": {
          "type": "string",
          "example": "192.168.0.163",
          "description": "内网ip\n未校验:\n格式,长度"
        },
        "floating_ip": {
          "type": "string",
          "example": "1.1.1.1",
          "description": "弹性公网ip\n未校验:\n格式,长度"
        },
        "region_id": {
          "type": "string",
          "example": "cn-north-7",
          "description": "区域\n未校验:\n长度"
        },
        "zone_id": {
          "type": "string",
          "example": "cn-north-7a",
          "description": "可用区"
        },
        "application": {
          "type": "string",
          "description": "CMDB应用,CMDB应用视图才有值。类似管理面的云服务"
        },
        "group": {
          "type": "string",
          "description": "CMDB分组,CMDB应用视图才有值。类似管理面的schema"
        },
        "project_id": {
          "type": "string",
          "example": "1076d5e8a93f4fd383ad8b40498fcf7d",
          "description": "实例的 project_id\n\n需要消费,建议必填\n未校验长度"
        }
      },
      "description": "主机附加属性"
    },
    "ListInstancesBatchRes": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "description": "分批结果",
          "type": "array",
          "items": {
            "$ref": "#/definitions/InstancesBatchResultMode"
          }
        }
      },
      "description": "自动分批返回结果"
    },
    "Customttribute": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "example": "1kkkkkk",
          "description": "自定义属性key",
          "minLength": 0,
          "maxLength": 10
        },
        "value": {
          "type": "string",
          "example": "1lhkjh",
          "description": "自定义属性的value",
          "minLength": 0,
          "maxLength": 20
        }
      },
      "description": "当前执行脚本的自定义属性,仅用于表示本次执行的产生工单的信息"
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "type": "string",
      "description": "租户token。"
    },
    "X-Language": {
      "name": "X-Language",
      "in": "header",
      "required": false,
      "type": "string",
      "description": "国际化标记,zh-cn表示中文,en-us或不传表示英文。"
    },
    "x-user-profile": {
      "name": "x-user-profile",
      "in": "header",
      "required": false,
      "type": "string",
      "description": "IAM5.0用户信息。"
    },
    "x-project-id": {
      "name": "x-project-id",
      "in": "header",
      "required": false,
      "type": "string",
      "description": "项目ID。"
    }
  },
  "host": "coc.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}