  "definitions": {
    "TagKeyValue": {
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "example": "key1",
          "description": "标签的键"
        },
        "value": {
          "type": "string",
          "example": "value",
          "description": "标签的值"
        }
      },
      "description": "镜像标签"
    },
    "ErrorMessageInfo": {
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "错误码"
        },
        "message": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "description": "错误信息"
    },
    "JobResultBody": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "example": "4010a32b5f909853015f90aaa24b0015",
          "description": "异步任务ID。"
        }
      },
      "description": "异步任务响应体"
    },
    "CreateWholeImageRequestBody": {
      "required": [
        "name"
      ],
      "properties": {
        "description": {
          "type": "string",
          "example": "弹性云服务器制作镜像",
          "description": "镜像描述信息。\n支持字母、数字、中文等,不支持回车、<、 >,长度不能超过1024个字符。",
          "minLength": 0,
          "maxLength": 1024
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "表示当前镜像所属的企业项目。取值为0或无该值,表示属于default企业项目。取值为UUID,表示属于该UUID对应的企业项目。关于企业项目ID的获取及企业项目特性的详细信息,请参考《企业管理用户指南》。",
          "default": "0"
        },
        "image_tags": {
          "type": "array",
          "description": "新规范的镜像标签列表。默认为空。tags和image_tags只能使用一个。",
          "items": {
            "$ref": "#/definitions/TagKeyValue"
          }
        },
        "instance_id": {
          "type": "string",
          "description": "弹性云服务器ID。使用弹性云服务器制作整机镜像时使用此参数且必填。\n如果使用备份创建整机镜像,该参数应换成backup_id。\n非必填的原因是需要兼容“使用备份创建整机镜像”和“使用弹性云服务器制作整机镜像”两种场景的body体。"
        },
        "name": {
          "type": "string",
          "example": "instance_whole_image",
          "description": "镜像名称。\n名称的首尾字母不能为空格。\n名称的长度至为1~128位。\n名称包含以下4种字符:\n大写字母\n小写字母\n数字\n特殊字符包含-、.、_、空格和中文。",
          "minLength": 1,
          "maxLength": 128
        },
        "tags": {
          "type": "array",
          "description": "镜像标签列表。tags和image_tags只能使用一个。",
          "items": {
            "type": "string"
          }
        },
        "backup_id": {
          "type": "string",
          "description": "使用云服务器备份创建整机镜像使用此参数且必填。\n如果使用ECS创建整机镜像,则该参数应传为instance_id。\n非必填的原因是需要兼容“使用备份创建整机镜像”和“使用弹性云服务器制作整机镜像”两种场景的body体。"
        },
        "whole_image_type": {
          "type": "string",
          "description": "使用备份创建整机镜像时,该字段区分是CBR服务的备份还是CSBS服务的备份,取值为:CBR/CSBS。\n使用ECS创建整机镜像时,该字段不填"
        },
        "max_ram": {
          "type": "integer",
          "format": "int32",
          "description": "表示镜像支持的最大内存,单位为MB,默认不设置。"
        },
        "min_ram": {
          "type": "integer",
          "format": "int32",
          "description": "表示镜像支持的最小内存,单位为MB,默认为0。",
          "default": 0
        },
        "vault_id": {
          "type": "string",
          "description": "表示云服务器待加入的或已加入的存储库的ID。\n使用云服务器创建整机镜像的过程为:先创建一个备份,再将备份创建为整机镜像。如果这个备份为CBR,vault_id为必填项;如果备份为CSBS,vault_id参数可不填。"
        }
      }
    },
    "FailResponseBody": {
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "example": "{ \"error\": {\"message\": \"string.\", \"code\": \"string\" } }",
          "description": "请求失败响应体",
          "$ref": "#/definitions/ErrorMessageInfo"
        }
      },
      "description": "请求失败响应体"
    }
  },
