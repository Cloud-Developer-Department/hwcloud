  "definitions": {
    "CreateDataImageRequestBody": {
      "required": [
        "image_url",
        "min_disk",
        "name"
      ],
      "properties": {
        "cmk_id": {
          "type": "string",
          "description": "创建加密镜像的用户主密钥,具体取值请参考《密钥管理服务用户指南》获取。"
        },
        "description": {
          "type": "string",
          "description": "镜像描述信息。_description参数说明请参考镜像属性。支持字母、数字、中文等,不支持回车、<、 >,长度不能超过1024个字符。默认为空。",
          "minLength": 0,
          "maxLength": 1024
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "表示当前镜像所属的企业项目。取值为0或无该值,表示属于default企业项目;取值为UUID,表示属于该UUID对应的企业项目。",
          "default": "0"
        },
        "image_tags": {
          "type": "array",
          "description": "新规范的镜像标签列表。默认为空。\ntags和image_tags只能使用一个。",
          "items": {
            "description": "",
            "$ref": "#/definitions/ImageTag"
          },
          "x-huawei-extraAnnotation": ""
        },
        "image_url": {
          "type": "string",
          "description": "OBS桶中外部镜像文件地址。格式为<OBS桶名>:<OBS镜像文件名称>。 此处的OBS桶和镜像文件的存储类别必须是OBS标准存储。"
        },
        "min_disk": {
          "type": "integer",
          "format": "int32",
          "description": "最小数据盘大小。取值范围40-2048GB。",
          "minimum": 40,
          "maximum": 2048
        },
        "name": {
          "type": "string",
          "description": "镜像名称。"
        },
        "os_type": {
          "type": "string",
          "description": "操作系统类型。只能是Windows、Linux二者之一,默认Linux。",
          "enum": [
            "Windows",
            "Linux"
          ]
        },
        "tags": {
          "type": "array",
          "description": "镜像标签列表。默认为空。\ntags和image_tags只能使用一个。",
          "items": {
            "type": "string",
            "description": ""
          },
          "x-huawei-extraAnnotation": ""
        }
      },
      "description": "创建镜像请求体"
    },
    "ImageTag": {
      "properties": {
        "key": {
          "type": "string",
          "example": "key1",
          "description": "标签key值"
        },
        "value": {
          "type": "string",
          "example": "value1",
          "description": "标签value值"
        }
      },
      "description": "镜像标签"
    },
    "ErrorMessageInfo": {
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "错误码"
        },
        "message": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "description": "错误信息"
    },
    "JobResultBody": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "example": "4010a32b5f909853015f90aaa24b0015",
          "description": "异步任务ID。"
        }
      },
      "description": "异步任务响应体"
    },
    "FailResponseBody": {
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "example": "{ \"error\": {\"message\": \"string.\", \"code\": \"string\" } }",
          "description": "请求失败响应体",
          "$ref": "#/definitions/ErrorMessageInfo"
        }
      },
      "description": "请求失败响应体"
    }
  },
