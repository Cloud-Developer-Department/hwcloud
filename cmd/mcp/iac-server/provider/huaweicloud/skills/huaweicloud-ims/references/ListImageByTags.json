  "definitions": {
    "ShowImageByTagsResource": {
      "required": [
        "resource_detail",
        "resource_id",
        "resource_name",
        "tags"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "description": "镜像ID"
        },
        "resource_detail": {
          "description": "镜像详情",
          "$ref": "#/definitions/QueryImageByTagsResourceDetail"
        },
        "tags": {
          "type": "array",
          "description": "镜像的标签列表",
          "items": {
            "$ref": "#/definitions/TagKeyValue"
          }
        },
        "resource_name": {
          "type": "string",
          "description": "镜像名称"
        }
      },
      "description": "resource字段数据结构说明"
    },
    "TagKeyValue": {
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "example": "key1",
          "description": "标签的键"
        },
        "value": {
          "type": "string",
          "example": "value",
          "description": "标签的值"
        }
      },
      "description": "镜像标签"
    },
    "QueryImageByTagsResourceDetail": {
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "description": "镜像状态"
        }
      },
      "description": "镜像详情"
    },
    "ListImageByTagsRequestBody": {
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "description": "操作标识(区分大小写),支持filter、count。filter就是分页查询;count是只需按照条件将总条数返回即可。",
          "enum": [
            "filter",
            "count"
          ]
        },
        "tags": {
          "type": "array",
          "description": "包含标签,最多包含10个key,每个key对应的values最多包含10个值,且key和values都不能重复。不能为空列表。",
          "items": {
            "$ref": "#/definitions/Tags"
          }
        },
        "tags_any": {
          "type": "array",
          "description": "包含任意标签,最多包含10个key,每个key对应的values最多包含10个值,且key和values都不能重复。不允许为空列表,但可以不传递参数。",
          "items": {
            "$ref": "#/definitions/Tags"
          }
        },
        "not_tags": {
          "type": "array",
          "description": "不包含标签,最多包含10个key,每个key对应的values最多包含10个值,且key和values都不能重复。不能为空列表。",
          "items": {
            "$ref": "#/definitions/Tags"
          }
        },
        "not_tags_any": {
          "type": "array",
          "description": "不包含任意标签,最多包含10个key,每个key对应的values最多包含10个值,且key和values都不能重复。不能为空列表。",
          "items": {
            "$ref": "#/definitions/Tags"
          }
        },
        "limit": {
          "type": "string",
          "description": "最大查询记录数(action为count,时此参数无效)如果action为filter默认为10,limit最多为1000,不能为负数,最小值为1。"
        },
        "offset": {
          "type": "string",
          "description": "索引位置, 从offset指定的下一条数据开始查询。 查询第一页数据时,不需要传入此参数(action为count时,此参数无效),如果action为filter默认为0,不能为负数。"
        },
        "matches": {
          "type": "array",
          "description": "搜索字段,key为要匹配的字段,如resource_name、resource_id等。value为匹配的值。多个matches的key不允许重复。不允许为空列表,但可以不传递参数。",
          "items": {
            "$ref": "#/definitions/TagKeyValue"
          }
        },
        "without_any_tag": {
          "type": "boolean",
          "description": "不包含任意一个标签,该字段为true时查询所有不带标签的资源,此时忽略tag、not_tags、tags_any、not_tags_any字段。"
        }
      },
      "description": "请求参数"
    },
    "ErrorMessageInfo": {
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "错误码"
        },
        "message": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "description": "错误信息"
    },
    "Tags": {
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "标签的键。最大长度127个unicode字符,key不能为空。"
        },
        "values": {
          "type": "array",
          "description": "标签的值列表。每个值最大长度255个unicode字符,如果values为空列表,则标签的值可以是任意值。值列表中的值之间为或的关系。",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "镜像标签"
    },
    "ListImageByTagsResponseBody": {
      "required": [
        "resources",
        "total_count"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "description": "镜像信息列表",
          "items": {
            "$ref": "#/definitions/ShowImageByTagsResource"
          }
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "总记录数"
        }
      },
      "description": "响应参数"
    },
    "FailResponseBody": {
      "required": [
        "error"
      ],
      "properties": {
