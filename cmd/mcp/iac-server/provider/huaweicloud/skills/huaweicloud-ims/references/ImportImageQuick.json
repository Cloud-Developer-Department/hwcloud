        "x-request-examples-text-2": "{  \n    \"name\": \"ims_test_file\",  \n    \"description\": \"OBS文件制作镜像\",  \n    \"image_url\": \"ims-image:centos70.qcow2\",  \n    \"os_type\": \"Linux\",  \n    \"min_disk\": 40,  \n    \"type\": \"DataImage\",  \n    \"tags\": [    \n        \"aaa.111\",    \n        \"bbb.333\",    \n        \"ccc.444\"    \n    ]\n}\n",
