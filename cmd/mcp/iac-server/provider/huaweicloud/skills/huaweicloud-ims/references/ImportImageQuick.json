          "min_disk": 40,
          "type": "ECS",
          "tags": [
            "aaa.111",
            "bbb.333",
            "ccc.444"
          ]
        },
        "x-request-examples-text-1": "{  \n    \"name\": \"ims_test_file\",  \n    \"description\": \"OBS文件制作镜像\",  \n    \"image_url\": \"ims-image:centos70.zvhd2\",  \n    \"os_version\": \"CentOS 7.0 64bit\",  \n    \"min_disk\": 40,  \n    \"type\": \"ECS\", \n    \"tags\":\n        [\n            \"aaa.111\",    \n            \"bbb.333\",    \n            \"ccc.444\"    \n        ]\n}\n",
        "x-request-examples-description-2": "外部文件制作数据盘镜像",
