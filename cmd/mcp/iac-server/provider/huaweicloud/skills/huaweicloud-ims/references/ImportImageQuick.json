  "definitions": {
    "QuickImportImageByFileRequestBody": {
      "required": [
        "image_url",
        "min_disk",
        "name",
        "os_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "镜像名称",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "description": "镜像描述信息。_description参数说明请参考镜像属性。支持字母、数字、中文等,不支持回车、<、 >,长度不能超过1024个字符。默认为空。",
          "minLength": 0,
          "maxLength": 1024
        },
        "os_version": {
          "type": "string",
          "description": "操作系统版本。使用上传至OBS桶中的外部镜像文件制作镜像时生效"
        },
        "image_url": {
          "type": "string",
          "description": "OBS桶中外部镜像文件地址。在使用OBS桶的外部镜像文件制作镜像时生效且为必选字段。格式为<OBS桶名>:<OBS镜像文件名称>。注意:此处的OBS桶和镜像文件的存储类别必须是OBS标准存储。"
        },
        "min_disk": {
          "type": "integer",
          "format": "int32",
          "description": "最小系统盘大小。在使用OBS桶的外部镜像文件制作镜像时生效且为必选字段。取值为1至1024GB。",
          "minimum": 1,
          "maximum": 1024
        },
        "license_type": {
          "type": "string",
          "description": "操作系统使用的许可证类型。取值范围:\nplatform:华为云官方许可证\nbyol:自带许可证(Bring Your Own License)\n目前仅Windows操作系统支持设置该参数。"
        },
        "tags": {
          "type": "array",
          "description": "镜像标签列表。默认为空。\ntags和image_tags只能使用一个。",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "type": "string",
          "description": "制作的镜像类型。系统盘镜像为ECS/BMS,数据盘镜像为DataImage.\n制作数据盘镜像时该参数必选.",
          "enum": [
            "ECS",
            "BMS",
            "DataImage"
          ],
          "default": "ECS"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "表示当前镜像所属的企业项目。\n取值为0或无该值,表示属于default企业项目。\n取值为UUID,表示属于该UUID对应的企业项目。\n关于企业项目ID的获取及企业项目特性的详细信息,请参考《企业管理用户指南》。",
          "default": "0"
        },
        "architecture": {
          "type": "string",
          "description": "镜像的架构类型。取值包括:\nx86\narm\n默认使用“x86”。",
          "enum": [
            "x86",
            "arm"
          ],
          "default": "x86"
        },
        "hw_firmware_type": {
          "type": "string",
          "description": "云主机云服务器的启动方式。目前支持:\nbios:表示bios引导启动。\nuefi:表示uefi引导启动。",
          "enum": [
            "bios",
            "uefi"
          ]
        },
        "os_type": {
          "type": "string",
          "description": "操作系统版本。\n创建数据盘镜像时该参数取值为Linux或Windows,默认Linux。",
          "enum": [
            "Linux",
            "Windows"
          ]
        },
        "image_tags": {
          "type": "array",
          "description": "新规范的镜像标签列表。默认为空。\ntags和image_tags只能使用一个。",
          "items": {
            "$ref": "#/definitions/ResourceTag"
          }
        }
      },
      "description": "快速通道创建镜像的请求体"
    },
    "ResourceTag": {
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "标签的键"
        },
        "value": {
          "type": "string",
          "description": "标签的值"
        }
      },
      "description": "标签键值"
    },
    "ErrorMessageInfo": {
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "错误码"
        },
        "message": {
          "type": "string",
          "description": "错误信息"
        }
      },
      "description": "错误信息"
    },
    "JobResultBody": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "example": "4010a32b5f909853015f90aaa24b0015",
          "description": "异步任务ID。"
        }
      },
      "description": "异步任务响应体"
    },
    "FailResponseBody": {
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "example": "{ \"error\": {\"message\": \"string.\", \"code\": \"string\" } }",
          "description": "请求失败响应体",
          "$ref": "#/definitions/ErrorMessageInfo"
        }
      },
      "description": "请求失败响应体"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ims.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}