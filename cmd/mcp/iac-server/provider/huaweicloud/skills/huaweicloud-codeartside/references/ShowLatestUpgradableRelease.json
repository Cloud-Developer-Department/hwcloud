            "required": false,
            "description": "CPU架构",
            "type": "string",
            "enum": [
              "X86-64",
              "Arm64",
              "Universal"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "result": {
                  "hash": "xxx",
                  "available": true,
                  "sub_product_name": "ai",
                  "version": "26.2.11",
                  "url": "https://example.com/codearts/ai/latest/codearts-agent-26.2.11.zip"
                },
                "status": "success"
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowLatestUpgradableReleaseResponseBody"
            }
          }
        }
      }
    }
  },
