  "definitions": {
    "Disk": {
      "required": [
        "disk_type",
        "size"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "example": 40,
          "description": "磁盘大小,容量单位为GB。系统盘输入大小不小于镜像中系统盘的最小(min_disk属性)值。"
        },
        "volume_type": {
          "type": "string",
          "example": "SATA",
          "description": "云服务器数据盘对应的磁盘类型,需要与系统所提供的磁盘类型相匹配。当对接CCS时,使用的磁盘类型是通过CCS获取的,如business_type_01表示普通IO磁盘类型;未对接CCS时,磁盘类型枚举值:SATA:普通IO磁盘类型。SAS:高IO磁盘类型。SSD:超高IO磁盘类型。co-p1:高IO(性能优化I型)磁盘类型。uh-l1:超高IO (时延优化)磁盘类型。说明:对于HL1型云服务器,需使用co-p1和uh-l1两种磁盘类型。对于其他类型的云服务器,不能使用co-p1和uh-l1两种磁盘类型。"
        },
        "disk_type": {
          "type": "string",
          "example": "SYS",
          "description": "系统盘还是数据盘,DATA表示为数据盘,SYS表示为系统盘。",
          "enum": [
            "SYS",
            "DATA"
          ]
        }
      }
    },
    "SecurityGroups": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "23b7b999-0a30-4b48-ae8f-ee201a88a6ab",
          "description": "安全组ID。"
        }
      }
    },
    "CreateScalingConfigReq": {
      "required": [
        "instance_config",
        "scaling_configuration_name"
      ],
      "properties": {
        "scaling_configuration_name": {
          "type": "string",
          "example": "as-config-tlzq",
          "description": "伸缩配置名称(1-64个字符),只能包含中文、字母、数字、下划线或中划线。",
          "pattern": "/[a-zA-Z0-9_\\-\\一-\\龥]{1,64}/"
        },
        "instance_config": {
          "description": "实例配置信息。",
          "$ref": "#/definitions/InstanceConfig"
        }
      }
    },
    "Bandwidth": {
      "required": [
        "charging_mode",
        "size"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "description": "带宽(Mbit/s),取值范围为[0,300],0表示带宽不限制。当share_type值为PER时,为必选参数。"
        },
        "share_type": {
          "type": "string",
          "description": "带宽的共享类型。共享类型枚举:PER,表示独享;WHOLE,表示共享。",
          "enum": [
            "PER",
            "WHOLE"
          ]
        },
        "charging_mode": {
          "type": "string",
          "description": "带宽的计费类型。字段值为“bandwidth”,表示按带宽计费。字段值为“traffic”,表示按流量计费。字段为其它值,会导致创建云服务器失败。当share_type值为PER时,为必选参数。",
          "enum": [
            "bandwidth",
            "traffic"
          ]
        },
        "id": {
          "type": "string",
          "description": "带宽ID。"
        }
      }
    },
    "InstanceConfig": {
      "required": [
        "disk",
        "flavorRef",
        "imageRef"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "example": "dfc7b874-9ec4-42c6-a14a-9e608db8b26d",
          "description": "云服务器ID,当使用已存在的云服务器的规格为模板创建弹性伸缩配置时传入该字段,此时flavorRef、imageRef、disk字段不生效。当不传入instance_id字段时flavorRef、imageRef、disk字段为必选。"
        },
        "flavorRef": {
          "type": "string",
          "example": "103",
          "description": "云服务器的规格ID。通过查询弹性云服务规格详情和扩展信息列表接口获取,详见《弹性云服务器(ECS) 8.6.1 使用指南(for 华为云Stack 8.6.1)》的“弹性云服务器(ECS) 8.6.1 API参考(for 华为云Stack 8.6.1)  > 规格查询  > 查询规格详情和规格扩展信息列表”。"
        },
        "imageRef": {
          "type": "string",
          "example": "627a1223-2ca3-46a7-8d5f-7aef22c74ee6",
          "description": "镜像ID,同image_id,通过查询镜像服务镜像列表接口获取,详见《镜像服务(IMS) 8.6.1 使用指南(for 华为云Stack 8.6.1)》的“镜像服务(IMS) 8.6.1 API参考(for 华为云Stack 8.6.1) > 镜像 > 查询镜像列表信息”。"
        },
        "disk": {
          "type": "array",
          "description": "磁盘组信息,系统盘必选,数据盘可选。",
          "items": {
            "$ref": "#/definitions/Disk"
          }
        },
        "personality": {
          "type": "array",
          "description": "用户输入的,vm启动脚本。",
          "items": {
            "type": "string",
            "description": "用户输入的,vm启动脚本。"
          }
        },
        "key_name": {
          "type": "string",
          "example": "100vm_key",
          "description": "登录云服务器的SSH密钥名称,只有支持cloudinit或者cloudbase-init的镜像才需要,此时与secret_params互斥,且必选一个。"
        },
        "secret_params": {
          "description": "表示Linux云服务器登录用户名密码。只有支持cloud-init的镜像才需要。其中,Linux管理员账户为root。",
          "$ref": "#/definitions/SecretParams"
        },
        "public_ip": {
          "description": "配置云服务器的弹性IP信息,弹性IP有两种配置方式。不使用(无该字段)自动分配,需要指定新创建弹性IP的信息",
          "$ref": "#/definitions/PublicIp"
        },
        "user_data": {
          "type": "string",
          "example": " ",
          "description": "cloud-init用户数据。支持注入文本、文本文件或gzip文件。文件内容需要进行base64格式编码,注入内容(编码之前的内容)最大为32KB。"
        },
        "metadata": {
          "description": "创建云服务器元数据。说明:创建密码方式鉴权的Windows弹性云服务器时,为必填字段。该字段暂不支持用户写入数据,但是当使用Windows镜像创建弹性云服务器时,该字段为必选字段。",
          "$ref": "#/definitions/Metadata"
        },
        "security_groups": {
          "type": "array",
          "description": "安全组信息。使用vpc_id通过查询VPC服务安全组列表接口获取,详见《虚拟私有云(VPC) 8.6.1 使用指南(for 华为云Stack 8.6.1)》的“虚拟私有云(VPC) 8.6.1 API参考(for 华为云Stack 8.6.1) > 安全组 > 查询安全组”。当伸缩配置和伸缩组同时指定安全组时,将以伸缩配置中的安全组为准;当伸缩配置和伸缩组都没有指定安全组时,将使用默认安全组。为了使用灵活性更高,推荐在伸缩配置中指定安全组。",
          "items": {
            "$ref": "#/definitions/SecurityGroups"
          }
        }
      }
    },
    "CreateScalingConfigResp": {
      "properties": {
        "scaling_configuration_id": {
          "type": "string",
          "example": "f8327883-6a07-4497-9a61-68c03e8e72a2",
          "description": "伸缩配置ID"
        }
      }
    },
    "PublicIp": {
      "required": [
        "eip"
      ],
      "properties": {
        "eip": {
          "description": "配置云服务器自动分配弹性IP时,创建弹性IP的配置参数。",
          "$ref": "#/definitions/Eip"
        }
      }
    },
    "SecretParams": {
      "required": [
        "admin_password"
      ],
      "properties": {
        "admin_password": {
          "type": "string",
          "description": "root用户密码。长度为8-26位;密码至少必须包含大写字母(A~Z)、小写字母(a~z)、数字(0~9)和特殊字符(`~!@#$%^&*()-_=+|[{}];:'\",<.>/?)中的三种;密码不能包含用户名或用户名的逆序。"
        },
        "custom_user": {
          "type": "string",
          "description": "自定义用户名,长度为3-20位,只能由数字、小写英文字母、下划线组成。",
          "pattern": "[a-z0-9_]{3,20}"
        },
        "custom_password": {
          "type": "string",
          "description": "自定义用户密码。长度为8-26位;密码至少必须包含大写字母(A~Z)、小写字母(a~z)、数字(0~9)和特殊字符(`~!@#$%^&*()-_=+|[{}];:'\",<.>/?)中的三种;密码不能包含用户名或用户名的逆序。"
        }
      }
    },
    "Metadata": {
      "properties": {
        "User-defined_key-value_pair": {
          "type": "string",
          "example": " ",
          "description": "用户自定义数据,总长度不大于512字节。用户自定义键不能是空串,不能包含符号.,以及不能以符号$开头。说明:1、为保证创建的伸缩配置可以正常使用,需要自定义键az_code和az_info,值为相应可用az的值。2、Windows弹性云服务器Administrator用户的密码。示例:键(固定):admin_pass值:cloud.1234创建密码方式鉴权的Windows弹性云服务器时为必选字段。"
        }
      }
    },
    "Eip": {
      "required": [
        "bandwidth",
        "ip_type"
      ],
      "properties": {
        "ip_type": {
          "type": "string",
          "description": "弹性IP地址类型。私有云或者混合云场景下从vpc读取。"
        },
        "external_network_id": {
          "type": "string",
          "description": "外部网络ID。"
        },
        "bandwidth": {
          "description": "IP地址带宽参数。",
          "$ref": "#/definitions/Bandwidth"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.ap-southeast-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
