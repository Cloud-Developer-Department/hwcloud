      "post": {
        "tags": [
          "弹性伸缩配置"
        ],
        "summary": "创建弹性伸缩配置",
        "description": "创建弹性伸缩配置。伸缩配置是伸缩组内实例(弹性云服务器)的模板,定义了伸缩组内待添加的实例的规格数据。弹性伸缩为某个伸缩组自动添加实例时,会根据配置创建实例。",
        "operationId": "CreateScalingConfig",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "发送的实体的MIME类型,媒体类型可按照流类型的不同进行确定。",
            "required": true,
            "type": "string",
            "default": "application/json",
            "enum": [
              "application/json"
            ]
          },
          {
            "name": "Content-Length",
            "in": "header",
            "description": "请求body长度,单位为Byte。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "project id,项目编号。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,请参考《华为云Stack 8.6.1 API参考》的“ManageOne 8.6.1 API参考 >  ManageOne xxx OTenantSecurity服务API参考 > API参考 > Token > 获取用户Token”章节。",
            "required": true,
            "type": "string",
            "pattern": "[\\\\w\\\\-\\\\+=]*"
          },
          {
            "name": "tenant_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "pattern": "[0-9a-f]{32}"
          },
          {
            "in": "body",
            "name": "CreateScalingConfigReq",
            "description": "This is a auto create Body Object",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateScalingConfigReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK  请求正常。",
            "examples": {
