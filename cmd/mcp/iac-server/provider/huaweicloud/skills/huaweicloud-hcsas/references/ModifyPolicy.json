        },
        "x-request-examples-1": {
          "scaling_policy_type": "RECURRENCE",
          "scheduled_policy": {
            "launch_time": "20:00",
            "recurrence_value": "4",
            "start_time": "2015-12-14T03:34Z",
            "end_time": "2025-12-27T03:34Z",
            "recurrence_type": "Weekly"
          },
          "scaling_policy_action": {
            "instance_number": 1,
            "operation": "ADD"
          },
          "cool_down_time": 900,
