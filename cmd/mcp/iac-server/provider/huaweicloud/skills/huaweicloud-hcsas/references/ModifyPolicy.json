            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "pattern": "[0-9a-f]{32}"
          },
          {
            "name": "scaling_policy_id",
            "in": "path",
            "description": "伸缩策略ID。",
            "required": true,
            "type": "string",
            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
          },
          {
            "in": "body",
            "name": "ModifyPolicyReq",
            "description": "This is a auto create Body Object",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ModifyPolicyReq"
            }
          }
        ],
        "responses": {
