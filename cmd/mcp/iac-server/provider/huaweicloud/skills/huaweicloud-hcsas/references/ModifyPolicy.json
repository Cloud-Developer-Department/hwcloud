        ],
        "summary": "修改弹性伸缩策略",
        "description": "修改指定弹性伸缩策略。",
        "operationId": "ModifyPolicy",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
