  "definitions": {
    "CreatePolicyReq": {
      "required": [
        "scaling_group_id",
        "scaling_policy_name",
        "scaling_policy_type"
      ],
      "properties": {
        "scaling_policy_name": {
          "type": "string",
          "example": "as-policy-7a75",
          "description": "策略名称(1-64字符),可以用中文、字母、数字、下划线、中划线的组合。",
          "pattern": "/[a-zA-Z0-9_\\-\\一-\\龥]{1,64}/"
        },
        "scaling_group_id": {
          "type": "string",
          "example": "5bc3aa02-b83e-454c-aba1-4d2095c68f8b",
          "description": "伸缩组ID,通过查询弹性伸缩组列表获取,详见“查询弹性伸缩组列表”章节。"
        },
        "scaling_policy_type": {
          "type": "string",
          "example": "RECURRENCE",
          "description": "策略类型。告警策略:ALARM(与alarm_id对应);定时策略:SCHEDULED(与scheduled_policy对应);周期策略:RECURRENCE(与scheduled_policy对应)。",
          "enum": [
            "ALARM",
            "SCHEDULED",
            "RECURRENCE"
          ]
        },
        "alarm_id": {
          "type": "string",
          "description": "告警ID,即告警规则的ID,调用oc的接口(POST /V1.0/{tenantId}/alarms)得到。当scaling_policy_type为ALARM时该项必选,此时scheduled_policy不生效。创建告警策略成功后,会自动为该告警ID对应的告警规则的alarm_actions字段增加类型为autoscaling的告警触发动作。"
        },
        "scheduled_policy": {
          "description": "定时、周期任务策略,当scaling_policy_type为SCHEDULED或RECURRENCE时该项必选,此时alarm_id不生效。",
          "$ref": "#/definitions/ScheduledPolicy"
        },
        "scaling_policy_action": {
          "description": "策略执行具体动作。",
          "$ref": "#/definitions/ScalingPolicyAction"
        },
        "cool_down_time": {
          "type": "integer",
          "example": 900,
          "description": "冷却时间,取值范围0-86400,默认为900,单位是秒。",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "ScalingPolicyAction": {
      "properties": {
        "operation": {
          "type": "string",
          "example": "ADD",
          "description": "操作选项,默认为ADD。ADD:添加实例;REMOVE:移除实例;SET:设置实例数。",
          "enum": [
            "ADD",
            "REMOVE",
            "SET"
          ]
        },
        "instance_number": {
          "type": "integer",
          "example": 1,
          "description": "操作实例个数。当operation的值为ADD或REMOVE时,实例个数取值范围为1~300;当operation的值为SET时,实例个数取值范围为0~300。",
          "maximum": 300
        }
      }
    },
    "CreatePolicyResp": {
      "properties": {
        "scaling_policy_id": {
          "type": "string",
          "example": "0h327883-324n-4dzd-9c61-68d03ee191dd",
          "description": "伸缩策略ID。"
        }
      }
    },
    "ScheduledPolicy": {
      "required": [
        "launch_time"
      ],
      "properties": {
        "launch_time": {
          "type": "string",
          "example": "960",
          "description": "触发时间,遵循UTC时间。如果scaling_policy_type为SCHEDULED,则格式为:YYYY-MM-DDThh:mmZ。如果scaling_policy_type为RECURRENCE,则格式为:hh:mm。"
        },
        "recurrence_type": {
          "type": "string",
          "example": "Daily",
          "description": "周期触发类型,scaling_policy_type为RECURRENCE时该项必选。Daily:每天执行一次。Weekly:每周指定天执行一次。Monthly:每月指定天执行一次。",
          "enum": [
            "Daily",
            "Weekly",
            "Monthly"
          ]
        },
        "recurrence_value": {
          "type": "string",
          "description": "周期触发任务数值,scaling_policy_type为RECURRENCE时该项必选。类型为Daily时,该字段为null,表示每天执行类型为Weekly时,该字段取值范围为1-7,1表示星期日,以此类推,以”,”分隔,例如:1,3,5。类型为Monthly时,该字段取值范围为1-31,分别表示每月的日期,以“,”分隔,例如:1,10,13,28。"
        },
        "start_time": {
          "type": "string",
          "example": "2021-08-14T03:34Z",
          "description": "周期策略重复执行开始时间,遵循UTC时间。默认为当前时间,格式为:YYYY-MM-DDThh:mmZ。"
        },
        "end_time": {
          "type": "string",
          "example": "2021-08-27T03:34Z",
          "description": "周期策略重复执行结束时间,遵循UTC时间,scaling_policy_type为RECURRENCE时该项必选。当为周期类型策略时,不得早于当前时间和开始时间。格式为:YYYY-MM-DDThh:mmZ。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}