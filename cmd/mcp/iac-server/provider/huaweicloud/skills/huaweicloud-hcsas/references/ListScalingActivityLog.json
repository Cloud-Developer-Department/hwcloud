              "description": "{\"reason\":[{\"change_reason\":\"DIFF\",\"old_value\":0,\"scaling_policy_name\":\"policy_for_test\",\"scaling_policy_id\":\"f8924393-1024-4c24-8ac6-e4d481360856\",\"change_time\":\"2015-07-23T15:11:52Z\",\"new_value\":1}]}",
