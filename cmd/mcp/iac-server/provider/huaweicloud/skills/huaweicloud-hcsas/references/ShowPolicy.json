{
  "name": "ShowPolicy",
  "summary": "查询弹性伸缩策略详情",
  "tags": "弹性伸缩策略",
  "productshort": "HCSAS",
  "region_id": "cn-north-4",
  "paths": {
    "/autoscaling-api/v1/{tenant_id}/scaling_policy/{scaling_policy_id}": {
      "get": {
        "tags": [
          "弹性伸缩策略"
        ],
        "summary": "查询弹性伸缩策略详情",
        "description": "查询指定弹性伸缩策略信息。",
        "operationId": "ShowPolicy",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "发送的实体的MIME类型,媒体类型可按照流类型的不同进行确定。",
            "required": true,
            "type": "string",
            "default": "application/json",
            "enum": [
              "application/json"
            ]
          },
          {
            "name": "Content-Length",
            "in": "header",
            "description": "请求body长度,单位为Byte。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "project id,项目编号。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,请参考《华为云Stack 8.6.1 API参考》的“ManageOne 8.6.1 API参考 >  ManageOne xxx OTenantSecurity服务API参考 > API参考 > Token > 获取用户Token”章节。",
            "required": true,
            "type": "string",
            "pattern": "[\\\\w\\\\-\\\\+=]*"
          },
          {
            "name": "tenant_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "pattern": "[0-9a-f]{32}"
          },
          {
            "name": "scaling_policy_id",
            "in": "path",
            "description": "伸缩策略ID。",
            "required": true,
            "type": "string",
            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
          }
        ],
        "responses": {
          "200": {
            "description": "OK  请求正常。",
            "examples": {
              "application/json": {
                "scaling_policy": {
                  "scaling_group_id": "093ccf84-3aeb-447c-aedc-ce18de6bc6a3",
                  "scaling_policy_id": "51f9308d-6ca4-49ef-9c5b-8eb72dba6397",
                  "scaling_policy_name": "as-policy-63b8",
                  "scaling_policy_type": "SCHEDULED",
                  "scheduled_policy": {
                    "launch_time": "2025-01-18T02:46Z"
                  },
                  "cool_down_time": 900,
                  "scaling_policy_action": {
                    "operation": "SET",
                    "instance_number": 0
                  },
                  "policy_status": "INSERVICE",
                  "create_time": "2025-01-16T02:46:29Z"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryPolicyResp"
            }
          },
          "400": {
            "description": "Bad Request  服务器未能处理请求。"
          },
          "401": {
            "description": "Unauthorized  被请求的页面需要用户名和密码。"
          },
          "403": {
            "description": "Forbidden  对被请求的页面访问禁止。"
          },
          "404": {
            "description": "Not Found  服务器无法找到被请求的页面。"
          },
          "405": {
            "description": "Method Not Allowed  请求中指定的方法不被允许。"
          },
          "406": {
            "description": "Not Acceptable  服务器生成的响应无法被客户端所接受。"
          },
          "407": {
            "description": "Proxy Authentication  用户必须首先使用代理服务器进行验证,这样请求才会被处理"
          },
          "408": {
            "description": "Request Timeout  请求超出了服务器的等待时间。"
          },
          "409": {
            "description": "Conflict  由于冲突,请求无法被完成。"
          },
          "500": {
            "description": "Internal Server Error  请求未完成。服务异常。"
          },
          "501": {
            "description": "Not Implemented  请求未完成。服务器不支持所请求的功能。"
          },
          "502": {
            "description": "Bad Gateway  请求未完成。服务器从上游服务器收到一个无效的响应。"
          },
          "503": {
            "description": "Service Unavailable  请求未完成。系统暂时异常。"
          },
          "504": {
            "description": "Gateway Timeout  网关超时。"
          }
        },
        "x-support-sdk": "N",
        "x-request-examples-url-1": "/v1/a1c25915e3014ee0b612b471b724152a/scaling_policy/51f9308d-6ca4-49ef-9c5b-8eb72dba6397",
        "x-request-examples-description-1": "查询伸缩策略详情",
        "x-order": 3,
        "x-Auth_admin": "open",
        "x-Auth_user": "open",
        "x-native": "close",
        "x-native_extended": "close",
        "x-web_portal": "close"
      }
    }
  },
  "definitions": {
    "ScalingPolicies": {
      "properties": {
        "scaling_group_id": {
          "type": "string",
          "description": "伸缩组ID。"
        },
        "scaling_policy_name": {
          "type": "string",
          "description": "伸缩策略名称。"
        },
        "scaling_policy_id": {
          "type": "string",
          "description": "伸缩策略ID。"
        },
        "scaling_policy_type": {
          "type": "string",
          "example": "ALARM",
          "description": "伸缩策略类型:ALARM:告警策略,此时alarm_id有返回,scheduled_policy不会返回。SCHEDULED:定时策略,此时alarm_id不会返回,scheduled_policy有返回,并且recurrence_type、recurrence_value、start_time和end_time不会返回。RECURRENCE:周期策略,此时alarm_id不会返回,scheduled_policy有返回,并且recurrence_type、recurrence_value、start_time和end_time有返回。"
        },
        "alarm_id": {
          "type": "string",
          "example": "al1513822380493GvlJKZwA8",
          "description": "告警ID,即告警规则的ID,当scaling_policy_type为ALARM时该项必选,此时scheduled_policy不生效。创建告警策略成功后,会自动为该告警ID对应的告警规则的alarm_actions字段增加类型为autoscaling的告警触发动作。"
        },
        "scheduled_policy": {
          "description": "定时、周期任务策略,当scaling_policy_type为SCHEDULED或RECURRENCE时该项必选,此时alarm_id不生效。",
          "$ref": "#/definitions/ScheduledPolicy"
        },
        "scaling_policy_action": {
          "description": "策略执行具体动作。",
          "$ref": "#/definitions/ScalingPolicyAction"
        },
        "cool_down_time": {
          "type": "integer",
          "example": 900,
          "description": "冷却时间,取值范围0-86400,默认为300,单位是秒。",
          "minimum": 0,
          "maximum": 86400
        },
        "policy_status": {
          "type": "string",
          "description": "策略状态。"
        },
        "create_time": {
          "type": "string",
          "description": "创建伸缩策略时间,遵循UTC时间。"
        }
      }
    },
    "ScalingPolicyAction": {
      "properties": {
        "operation": {
          "type": "string",
          "example": "ADD",
          "description": "操作选项,默认为ADD。ADD:添加实例;REMOVE:移除实例;SET:设置实例数。",
          "enum": [
            "ADD",
            "REMOVE",
            "SET"
          ]
        },
        "instance_number": {
          "type": "integer",
          "example": 1,
          "description": "操作实例个数。当operation的值为ADD或REMOVE时,实例个数取值范围为1~300;当operation的值为SET时,实例个数取值范围为0~300。",
          "maximum": 300
        }
      }
    },
    "ScheduledPolicy": {
      "required": [
        "launch_time"
      ],
      "properties": {
        "launch_time": {
          "type": "string",
          "example": "960",
          "description": "触发时间,遵循UTC时间。如果scaling_policy_type为SCHEDULED,则格式为:YYYY-MM-DDThh:mmZ。如果scaling_policy_type为RECURRENCE,则格式为:hh:mm。"
        },
        "recurrence_type": {
          "type": "string",
          "example": "Daily",
          "description": "周期触发类型,scaling_policy_type为RECURRENCE时该项必选。Daily:每天执行一次。Weekly:每周指定天执行一次。Monthly:每月指定天执行一次。",
          "enum": [
            "Daily",
            "Weekly",
            "Monthly"
          ]
        },
        "recurrence_value": {
          "type": "string",
          "description": "周期触发任务数值,scaling_policy_type为RECURRENCE时该项必选。类型为Daily时,该字段为null,表示每天执行类型为Weekly时,该字段取值范围为1-7,1表示星期日,以此类推,以”,”分隔,例如:1,3,5。类型为Monthly时,该字段取值范围为1-31,分别表示每月的日期,以“,”分隔,例如:1,10,13,28。"
        },
        "start_time": {
          "type": "string",
          "example": "2021-08-14T03:34Z",
          "description": "周期策略重复执行开始时间,遵循UTC时间。默认为当前时间,格式为:YYYY-MM-DDThh:mmZ。"
        },
        "end_time": {
          "type": "string",
          "example": "2021-08-27T03:34Z",
          "description": "周期策略重复执行结束时间,遵循UTC时间,scaling_policy_type为RECURRENCE时该项必选。当为周期类型策略时,不得早于当前时间和开始时间。格式为:YYYY-MM-DDThh:mmZ。"
        }
      }
    },
    "QueryPolicyResp": {
      "properties": {
        "scaling_policy": {
          "description": "伸缩策略详情",
          "$ref": "#/definitions/ScalingPolicies"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}