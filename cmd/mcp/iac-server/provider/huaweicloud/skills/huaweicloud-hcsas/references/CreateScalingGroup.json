      "post": {
        "tags": [
          "弹性伸缩组"
        ],
        "summary": "创建弹性伸缩组",
        "description": "本接口用于创建弹性伸缩组。伸缩组是具有相同应用场景配置的实例集合。伸缩组内定义了实例最大数量和最小数量等信息。",
        "operationId": "CreateScalingGroup",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "发送的实体的MIME类型,媒体类型可按照流类型的不同进行确定。",
            "required": true,
            "type": "string",
            "default": "application/json",
