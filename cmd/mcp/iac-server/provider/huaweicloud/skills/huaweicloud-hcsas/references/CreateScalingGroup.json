  "definitions": {
    "IbaasListeners": {
      "required": [
        "listener_id",
        "protocol_port",
        "weight"
      ],
      "properties": {
        "listener_id": {
          "type": "string",
          "description": "负载均衡监听器ID。"
        },
        "protocol_port": {
          "type": "integer",
          "format": "int32",
          "description": "后端协议号,指后端云服务器监听的端口,取值范围[1,65535]。",
          "minimum": 1,
          "maximum": 65535
        },
        "weight": {
          "type": "integer",
          "format": "int32",
          "description": "权重,指后端云服务器经分发得到的请求数量比例,取值范围[0,100],默认为1。",
          "minimum": 0,
          "maximum": 100,
          "default": 1
        }
      }
    },
    "Networks": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "3cd35bca-5a10-416f-8994-f79169559870",
          "description": "网络ID。"
        }
      }
    },
    "SecurityGroups": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "23b7b999-0a30-4b48-ae8f-ee201a88a6ab",
          "description": "安全组ID。"
        }
      }
    },
    "CreateScalingGroupResp": {
      "properties": {
        "scaling_group_id": {
          "type": "string",
          "example": "a8327883-6b07-4497-9c61-68d03ee193a1",
          "description": "伸缩组ID"
        }
      }
    },
    "CreateScalingGroupReq": {
      "required": [
        "networks",
        "scaling_group_name",
        "security_groups",
        "vpc_id"
      ],
      "properties": {
        "scaling_group_name": {
          "type": "string",
          "example": "GroupNameTest",
          "description": "伸缩组名称(1-64个字符),只能包含中文、字母、数字、下划线、中划线。",
          "pattern": "/[a-zA-Z0-9_\\-\\一-\\龥]{1,64}/"
        },
        "scaling_configuration_id": {
          "type": "string",
          "example": "47683a91-93ee-462a-a7d7-484c006f4440",
          "description": "伸缩配置ID,通过查询弹性伸缩配置列表接口获取,详见“查询弹性伸缩配置列表”章节。"
        },
        "desire_instance_number": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "期望实例数量,默认值为最小实例数。最小实例数<=期望实例数<=最大实例数"
        },
        "min_instance_number": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "最小实例数量,默认值为0。",
          "default": 0
        },
        "max_instance_number": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "最大实例数量,默认值为0。",
          "default": 0
        },
        "cool_down_time": {
          "type": "integer",
          "format": "int32",
          "example": 200,
          "description": "冷却时间,取值范围0-86400,默认为900,单位是秒。 只针对告警策略生效,定时、周期策略和手动触发策略不受该参数限制。",
          "minimum": 0,
          "maximum": 86400,
          "default": 900
        },
        "lb_listener_id": {
          "type": "string",
          "description": "弹性负载均衡(经典型)监听器ID,最多支持绑定3个负载均衡监听器,多个负载均衡监听器ID以逗号分隔。首先使用vpc_id通过查询ELB服务负载均衡器列表接口获取负载均衡器的ID,详见《弹性负载均衡(ELB) 8.6.1 使用指南(for 华为云Stack 8.6.1)》中“弹性负载均衡(ELB) 8 API参考(for 华为云Stack 8.6.1)”的“查询负载均衡”章节,再使用该ID查询监听器列表获取,详见《弹性负载均衡(ELB) 8.6.1 使用指南(for 华为云Stack 8.6.1)》中“弹性负载均衡(ELB) 8.6.1 API参考(for 华为云Stack 8.6.1)”的“查询监听”章节。"
        },
        "lbaas_listeners": {
          "type": "array",
          "description": "弹性负载均衡器(增强型)信息,最多支持绑定3个负载均衡。该字段与lb_listener_id互斥。",
          "items": {
            "$ref": "#/definitions/IbaasListeners"
          }
        },
        "available_zones": {
          "type": "array",
          "description": "可用分区信息。弹性伸缩活动中自动添加的云服务器会被创建在指定的可用区中。如果没有指定可用分区,会由系统自动指定可用分区。",
          "items": {
            "type": "string"
          }
        },
        "networks": {
          "type": "array",
          "description": "网络信息,最多支持选择5个子网,传入的第一个子网默认作为云服务器的主网卡。使用vpc_id通过查询VPC服务子网列表接口获取,详见《虚拟私有云(VPC) 8.6.1 使用指南(for 华为云Stack 8.6.1)》的“虚拟私有云(VPC) 8.6.1 API参考(for 华为云Stack 8.6.1) > 子网 > 查询子网列表”。",
          "items": {
            "$ref": "#/definitions/Networks"
          }
        },
        "security_groups": {
          "type": "array",
          "description": "安全组信息,支持选择多个安全组。使用vpc_id通过查询VPC服务安全组列表接口获取,详见《虚拟私有云(VPC) 8.6.1 使用指南(for 华为云Stack 8.6.1)》的“虚拟私有云(VPC) 8.6.1 API参考(for 华为云Stack 8.6.1) > 安全组 > 查询安全组”。当伸缩配置和伸缩组同时指定安全组时,将以伸缩配置中的安全组为准;当伸缩配置和伸缩组都没有指定安全组时,将使用默认安全组。为了使用灵活性更高,推荐在伸缩配置中指定安全组。",
          "items": {
            "$ref": "#/definitions/SecurityGroups"
          }
        },
        "vpc_id": {
          "type": "string",
          "example": "a8327883-6b07-4497-9c61-68d03ee193a",
          "description": "VPC信息,通过查询VPC服务VPC列表接口获取,详见《虚拟私有云(VPC) 8.6.1 使用指南(for 华为云Stack 8.6.1)》的“虚拟私有云(VPC) 8.6.1 API参考(for 华为云Stack 8.6.1) > 网络 > 查询网络列表”。"
        },
        "health_periodic_audit_method": {
          "type": "string",
          "example": "NOVA_AUDIT",
          "description": "伸缩组实例健康检查方式:ELB_AUDIT和NOVA_AUDIT。当伸缩组参数中设置负载均衡时,默认为ELB_AUDIT;否则默认为NOVA_AUDIT。ELB_AUDIT表示负载均衡健康检查方式,在有监听器的伸缩组中有效。NOVA_AUDIT表示弹性伸缩自带的健康检查方式。",
          "enum": [
            "ELB_AUDIT",
            "NOVA_AUDIT"
          ]
        },
        "health_periodic_audit_time": {
          "type": "integer",
          "format": "int32",
          "example": 5,
          "description": "伸缩组实例健康检查周期,有5、15、60、180(分钟)四种选项,默认为5。",
          "default": 5
        },
        "instance_terminate_policy": {
          "type": "string",
          "example": "OLD_CONFIG_OLD_INSTANCE",
          "description": "伸缩组实例移除策略:OLD_CONFIG_OLD_INSTANCE(默认):从根据“较早创建的配置”创建的实例中筛选出较早创建的实例被优先移除。OLD_CONFIG_NEW_INSTANCE:从根据“较早创建的配置”创建的实例中筛选出较新创建的实例被优先移除。OLD_INSTANCE:较早创建的实例被优先移除。NEW_INSTANCE:较新创建的实例将被优先移除。",
          "enum": [
            "OLD_CONFIG_OLD_INSTANCE",
            "OLD_CONFIG_NEW_INSTANCE",
            "OLD_INSTANCE",
            "NEW_INSTANCE"
          ],
          "default": "OLD_CONFIG_OLD_INSTANCE"
        },
        "notifications": {
          "type": "array",
          "description": "通知方式:EMAIL为发送邮件通知。该通知方式即将被废除,建议给弹性伸缩组配置通知功能。详见“配置伸缩组通知”章节。",
          "items": {
            "type": "string",
            "example": "EMAIL"
          }
        },
        "delete_publicip": {
          "type": "boolean",
          "example": false,
          "description": "配置删除云服务器时是否删除云服务器绑定的弹性IP。取值为true或false,默认为false。true:删除云服务器时,会同时删除绑定在云服务器上的弹性IP。当弹性IP的计费方式为包年包月时,不会被删除。false:删除云服务器时,仅解绑定在云服务器上的弹性IP,不删除弹性IP。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "hcs.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
