              "application/json"
            ]
          },
          {
            "name": "Content-Length",
            "in": "header",
            "description": "请求body长度,单位为Byte。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "project id,项目编号。",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token,请参考《华为云Stack 8.6.1 API参考》的“ManageOne 8.6.1 API参考 >  ManageOne xxx OTenantSecurity服务API参考 > API参考 > Token > 获取用户Token”章节。",
            "required": true,
            "type": "string",
            "pattern": "[\\\\w\\\\-\\\\+=]*"
          },
          {
            "name": "tenant_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "pattern": "[0-9a-f]{32}"
          },
          {
            "in": "body",
            "name": "CreateScalingGroupReq",
            "description": "This is a auto create Body Object",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateScalingGroupReq"
            }
          }
        ],
        "responses": {
