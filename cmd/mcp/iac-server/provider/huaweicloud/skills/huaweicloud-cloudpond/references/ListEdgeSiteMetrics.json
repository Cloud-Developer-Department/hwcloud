{
  "name": "ListEdgeSiteMetrics",
  "summary": "查看站点容量信息",
  "tags": "边缘小站监控",
  "productshort": "CloudPond",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{domain_id}/edge-sites/{site_id}/metric-data": {
      "get": {
        "tags": [
          "monitor"
        ],
        "summary": "查看站点容量信息",
        "description": "查看站点容量信息。",
        "operationId": "ListEdgeSiteMetrics",
        "parameters": [
          {
            "$ref": "#/components/parameters/XAuthToken"
          },
          {
            "$ref": "#/components/parameters/DomainIdInPath"
          },
          {
            "$ref": "#/components/parameters/EdgeSiteIdInPath"
          },
          {
            "name": "dim",
            "in": "query",
            "description": "指定维度查询\n- site_id: 按站点维度,查询站点下计算、存储资源容量信息\n- flavor: 按规格维度,查询站点下各flavor的计算资源使用情况\n- storage: 按存储维度,查询站点下各存储资源类型的使用情况\n- flavor_capacity: 按规格容量维度,查询站点下各规格可发放数量预测\n- storage_pool:按存储池维度,查询站点下各存储池的使用情况",
            "required": false,
            "schema": {
              "type": "string",
              "default": "site_id",
              "enum": [
                "site_id",
                "flavor",
                "storage",
                "flavor_capacity",
                "storage_pool"
              ]
            }
          }
        ],
        "responses": {
