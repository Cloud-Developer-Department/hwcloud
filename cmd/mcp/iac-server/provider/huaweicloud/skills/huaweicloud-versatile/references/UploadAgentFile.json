{
  "name": "UploadAgentFile",
  "summary": "上传文件",
  "tags": "VersatileRuntime",
  "productshort": "Versatile",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/agent-runtime/upload-file": {
      "post": {
        "tags": [
          "VersatileRuntime"
        ],
        "summary": "上传文件",
        "description": "上传文件,以供agent或者工作流使用",
        "operationId": "UploadAgentFile",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/projectId"
          },
          {
            "name": "workspace_id",
            "in": "query",
            "description": "**参数解释**:\n空间ID,当前资源所属工作空间\n\n**取值范围**:\n由英文,数字,“-”,“_”组成,不超过64位字符",
            "required": true,
            "type": "string",
            "maxLength": 64
          },
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "description": "待上传的文件",
            "type": "file"
          },
          {
            "name": "expires",
            "in": "query",
            "required": false,
            "description": "访问授权过期时间(天)",
            "type": "integer",
            "format": "int32",
            "maximum": 180,
            "minimum": 1
          },
          {
            "name": "is_image",
            "in": "query",
            "required": false,
            "description": "是否是图片上传",
            "type": "boolean",
            "default": false
          },
          {
            "$ref": "#/parameters/xAuthToken"
          }
        ],
        "responses": {
          "200": {
            "description": "文件上传响应体",
            "schema": {
              "$ref": "#/definitions/FileUploadRsp"
            }
          },
          "400": {
            "description": "Bad Request 请求错误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "Unauthorized 鉴权失败",
            "schema": {
              "type": "string"
            }
          },
          "403": {
            "description": "Forbidden 没有操作权限",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "404": {
            "description": "Not Found 找不到资源",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "500": {
            "description": "Internal Server Error 服务内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc",
        "x-request-examples-url-1": "https://{endpoint}/v1/{project_id}/agent-runtime/upload-file"
      }
    }
  },
  "definitions": {
    "ErrorDetail": {
      "type": "object",
      "description": "错误信息",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        }
      }
    },
    "FileUploadRsp": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "临时url"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "headers"
        },
        "file_name": {
          "type": "string",
          "description": "文件名"
        }
      }
    },
    "ErrorRsp": {
      "type": "object",
      "description": "完整错误信息",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        },
        "error_reason": {
          "type": "string",
          "description": "错误原因"
        },
        "error_suggestion": {
          "type": "string",
          "description": "错误建议"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ErrorDetail"
          },
          "description": "调用接口返回的错误信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "projectId": {
      "name": "project_id",
      "in": "path",
      "description": "**参数解释**:\n当前租户项目ID。\n\n**取值范围**:\n由英文,数字,“-”,“_”组成,不超过64位字符。",
      "required": true,
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "maxLength": 64
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数解释**:\n用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n\n**取值范围**:\n不涉及。",
      "required": true,
      "type": "string",
      "maxLength": 15000
    }
  },
  "host": "versatile.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}