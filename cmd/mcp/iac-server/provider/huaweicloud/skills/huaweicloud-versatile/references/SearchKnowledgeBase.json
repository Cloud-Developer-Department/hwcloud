{
  "name": "SearchKnowledgeBase",
  "summary": "知识库检索",
  "tags": "OpenKnowledgeBase",
  "productshort": "Versatile",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/{project_id}/knowledge-bases/retrieve": {
      "post": {
        "tags": [
          "OpenKnowledgeBase"
        ],
        "operationId": "SearchKnowledgeBase",
        "summary": "知识库检索",
        "description": "提供多知识库并行检索能力,支持语义、关键词、混合及FAQ四种检索模式,并允许自定义相似度阈值与返回结果数量,实现精准高效的信息匹配。\n\n**适用场景**:\n- 同时从多个知识库或文档集合中搜索相关内容。\n- 在预设的问答列表中快速定位最相关的答案(FAQ检索)。\n- 通过混合模式或调整阈值,兼顾搜索结果的准确性和全面性。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/projectId"
          },
          {
            "$ref": "#/parameters/xAuthToken"
          },
          {
            "in": "body",
            "name": "KnowledgeBaseRetrievalReq",
            "description": "知识库检索请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/KnowledgeBaseRetrievalReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "知识库检索结果。",
            "schema": {
              "$ref": "#/definitions/KnowledgeBaseRetrievalRsp"
            },
            "x-response-examples-1": {
              "application/json": {
                "total": 1,
                "retrieve_result_list": [
                  {
                    "file_id": "687c7914cbddcc8702cb6698f6230...",
                    "title": "test",
                    "chunk_id": "840003a72d6f4325958920e52c5a9...",
                    "content": "测试检索召回内容。",
                    "similarity": 0.9785156,
                    "knowledge_base_id": "b56c5138-96e3-4630-8381-7846dfdbcdd5"
                  }
                ]
              }
            }
          }
        },
        "x-request-examples-url-1": "https://{endpoint}/v2/{project_id}/knowledge-bases/retrieve",
        "x-request-examples-1": {
          "knowledge_base_ids": [
            "bad2ef8771e6443096b528a8a7gh...."
          ],
          "query": "测试检索问题。",
          "search_mode": "DOC",
          "top_k": 10,
          "similarity_threshold": 0.5
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-open-region-cloud": "hc"
      }
    }
  },
  "definitions": {
    "KnowledgeBaseRetrievalRsp": {
      "type": "object",
      "description": "知识检索响应体。",
      "required": [
        "total"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n检索结果总数。\n\n**取值范围**:\n不涉及。",
          "maximum": 65535
        },
        "retrieve_result_list": {
          "type": "array",
          "description": "**参数解释**:\n检索结果列表。\n\n**取值范围**:\n不涉及。",
          "items": {
            "$ref": "#/definitions/RetrievalResultInfo"
          }
        }
      }
    },
    "KnowledgeBaseRetrievalReq": {
      "type": "object",
      "description": "知识检索请求体。",
      "required": [
        "knowledge_base_ids",
        "query"
      ],
      "properties": {
        "knowledge_base_ids": {
          "type": "array",
          "description": "**参数解释**:\n知识库ID列表。\n\n**约束限制**:\n最多可同时检索3个知识库。\n\n**取值范围**:\n不涉及。\n\n**默认取值**:\n不涉及。",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "description": "知识库ID。",
            "minLength": 0,
            "maxLength": 100
          },
          "example": [
            "781d380d-ac06-11f0-8c32-fa163ea89...",
            "82e8dda0-ac06-11f0-8c32-fa163ea89..."
          ]
        },
        "query": {
          "type": "string",
          "description": "**参数解释**:\n用户输入的问题或关键词。\n\n**约束限制**:\n不涉及。\n\n**取值范围**:\n长度 1 至 4096 字符。\n\n**默认取值**:\n不涉及。",
          "example": "测试检索问题。",
          "minLength": 1,
          "maxLength": 4096
        },
        "search_mode": {
          "type": "string",
          "description": "**参数解释**:\n检索策略模式。\n\n**约束限制**:\n不涉及。\n\n**取值范围**:\n- doc:语义检索。\n- keyword:关键词检索。\n- mix:混合检索。\n- faq:FAQ检索。\n\n**默认取值**:\ndoc。",
          "default": "doc",
          "minLength": 1,
          "maxLength": 16,
          "enum": [
            "doc",
            "keyword",
            "mix",
            "faq"
          ]
        },
        "top_k": {
          "type": "integer",
          "description": "**参数解释**:\n每个知识库最多返回的检索结果数量。\n\n**约束限制**:\n若传入小数,系统会默认截断小数部分。\n\n**取值范围**:\n1 至 100(含)。\n\n**默认取值**:\n10。",
          "format": "int32",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        },
        "similarity_threshold": {
          "description": "**参数解释**:\n检索结果的最低相关度得分,低于此值的片段将被过滤。\n\n**约束限制**:\n不涉及。\n\n**取值范围**:\n[0.0, 1.0],包含两端。\n\n**默认取值**:\n0.5。",
          "type": "number",
          "format": "float",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1
        },
        "image_mask_policy": {
          "type": "string",
          "description": "**参数解释**:\n知识检索结果切片中,对图片标签进行处理和保留的具体方式。\n\n**约束限制**:\n该功能要求被检索的知识库本身支持返回图片信息。\n\n**取值范围**:\n- RETAIN_IMAGE_ID:保留图片ID,格式:{KI|imageId}。\n- RETAIN_PLACEHOLDER:保留占位符,格式:{KI|N},N为序号。\n- REMOVE_IMAGE:移除图片(即替换为空字符串)。\n\n**默认取值**:\nREMOVE_IMAGE。",
          "default": "REMOVE_IMAGE",
          "minLength": 1,
          "maxLength": 64,
          "enum": [
            "RETAIN_IMAGE_ID",
            "RETAIN_PLACEHOLDER",
            "REMOVE_IMAGE"
          ]
        }
      }
    },
    "RetrievalResultInfo": {
      "type": "object",
      "description": "检索结果。",
      "properties": {
        "file_id": {
          "type": "string",
          "description": "**参数解释**:\n文件ID(或FAQ ID)。\n\n**取值范围**:\n不涉及。",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "**参数解释**:\n文档标题(如果是FAQ,返回QUESTION)。\n\n**取值范围**:\n不涉及。"
        },
        "chunk_id": {
          "type": "string",
          "description": "**参数解释**:\n分片ID。\n\n**取值范围**:\n不涉及。",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "content": {
          "type": "string",
          "description": "**参数解释**:\n文本内容(如果是FAQ,返回ANSWER)。\n\n**取值范围**:\n不涉及。",
          "minLength": 1,
          "maxLength": 65535
        },
        "similarity": {
          "type": "number",
          "format": "float",
          "description": "**参数解释**:\n相似度。\n\n**取值范围**:\n[0.0, 1.0],包含两端。"
        },
        "knowledge_base_id": {
          "type": "string",
          "description": "**参数解释**:\n知识库ID。\n\n**取值范围**:\n不涉及。",
          "minLength": 1,
          "maxLength": 64
        },
        "image_ids": {
          "type": "array",
          "description": "**参数解释**:\n检索到的图片列表(需知识库支持),与content中的图片占位符{KI|N}保持一一对应关系,N为图片索引值,从0开始。\n\n**取值范围**:\n不涉及。",
          "items": {
            "type": "string",
            "description": "图片ID。"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "projectId": {
      "name": "project_id",
      "in": "path",
      "description": "**参数解释**:\n当前租户项目ID。\n\n**取值范围**:\n由英文,数字,“-”,“_”组成,不超过64位字符。",
      "required": true,
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "maxLength": 64
    },
    "xAuthToken": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数解释**:\n用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n\n**取值范围**:\n不涉及。",
      "required": true,
      "type": "string",
      "maxLength": 15000
    }
  },
  "host": "versatile.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}