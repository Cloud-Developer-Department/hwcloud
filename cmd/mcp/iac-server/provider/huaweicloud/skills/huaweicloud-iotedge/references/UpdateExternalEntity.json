{
  "name": "UpdateExternalEntity",
  "summary": "修改节点下指定的外部实体信息",
  "tags": "外部实体管理",
  "productshort": "IoTEdge",
  "region_id": "cn-east-3",
  "paths": {
    "/{project_id}/edge-nodes/{edge_node_id}/externals/{external_id}": {
      "put": {
        "tags": [
          "EdgeExternals"
        ],
        "x-imports": "org.springframework.http.ResponseEntity",
        "summary": "修改节点下指定的外部实体信息",
        "description": "用户通过在指定边缘节点上修改指定外部实体的接入信息",
        "operationId": "UpdateExternalEntity",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/edge_node_id"
          },
          {
            "name": "external_id",
            "in": "path",
            "minLength": 1,
            "maxLength": 64,
            "description": "外部实体ID",
            "required": true,
            "type": "string"
          },
          {
            "name": "UpdateExternalEntityRequestBody",
            "in": "body",
            "description": "指定边缘节点的创建外部实体请求的结构体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateExternalEntityReqDTO"
            }
          }
        ],
        "x-returnType": "ResponseEntity<ExternalEntityRespDTO>",
        "responses": {
          "200": {
            "description": "OK",
            "x-SuccessCode": true,
            "examples": {
              "application/json": {
                "node_id": "string",
                "space_id": "jeQDJQZltU8iKgFFoW060F5SGZka",
                "external_id": "string",
                "protocol": "string",
                "connection_type": "string",
                "create_time": "string",
                "last_modify_time": "string"
              }
            },
            "schema": {
              "$ref": "#/definitions/ExternalEntityRespDTO"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-request-examples-url-1": "PUT https://{endpoint}/v2/{project_id}/edge-nodes/{edge_node_id}/externals/{external_id}",
        "x-request-examples-1": {
          "protocol": "MQTT",
          "connection_type": "CLIENT",
          "mqtt_connection_info": {
            "server_address": "ssl://127.0.0.1:88883",
            "client_id": "client_id",
            "auth_type": "SECRET",
            "private_key": "MIIGsDCCBJigAwIBAgIIdrfb4YBBxtQwDQYJKoZIhvcNAQELBQAwgZIxCzAJBgNV",
            "certificate": "MIIGsDCCBJigAwIBAgIIdrfb4YBBxtQwDQYJKoZIhvcNAQELBQAwgZIxCzAJBgNV",
            "user_name": "user_name",
            "password": "password",
            "qos": 0
          }
        }
      }
    }
  },
  "definitions": {
    "UpdateExternalEntityReqDTO": {
      "title": "更新外部实体请求结构体",
      "description": "更新外部实体请求结构体",
      "type": "object",
      "required": [
        "protocol",
        "connection_type"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "pattern": "(MQTT|HTTPS)",
          "description": "连接外部实体的协议类型",
          "example": "MQTT"
        },
        "connection_type": {
          "type": "string",
          "pattern": "(CLIENT|SERVER)",
          "description": "连接类型",
          "example": "CLIENT"
        },
        "mqtt_connection_info": {
          "description": "mqtt连接信息",
          "$ref": "#/definitions/MqttConnectionInfo"
        }
      }
    },
    "ExternalEntityRespDTO": {
      "title": "外部应用信息返回结构体",
      "description": "创建外部实体后返回的信息结构体",
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "description": "节点ID",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "space_id": {
          "description": "资源空间ID。此参数为非必选参数,存在多资源空间的用户需要使用该接口时,建议携带该参数指定创建的外部实体归属到IoDA哪个资源空间下的边缘节点设备下,否则创建的外部实体将会归属到默认资源空间下对应的边缘节点下,对应于IoDA的app_id.",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 36,
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka"
        },
        "external_id": {
          "type": "string",
          "description": "外部实体ID",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "protocol": {
          "type": "string",
          "description": "接入协议类型",
          "pattern": "(MQTT|HTTP)"
        },
        "connection_type": {
          "type": "string",
          "description": "连接类型(client和server)",
          "pattern": "(CLIENT|SERVER)"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间",
          "minLength": 0,
          "maxLength": 256
        },
        "last_modify_time": {
          "type": "string",
          "description": "最后修改时间",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "MqttConnectionInfo": {
      "title": "mqtt连接信息",
      "description": "边缘hub与外部实体的mqtt连接信息",
      "type": "object",
      "properties": {
        "server_address": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "description": "采用cleint方式连接时,mqtt服务器地址",
          "example": "ssl://127.0.0.1:88883"
        },
        "client_id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 256,
          "description": "mqtt连接时,client_id",
          "example": "client_id"
        },
        "auth_type": {
          "description": "鉴权类型。支持密钥认证接入(SECRET)和证书认证接入(CERTIFICATES)两种方式。使用密钥认证接入方式(SECRET)填写user_name和user_name字段,使用证书认证接入方式(CERTIFICATES)填写privateKey和certificate字段",
          "x-annotations": null,
          "pattern": "(SECRET|CERTIFICATES)",
          "type": "string",
          "example": "SECRET"
        },
        "private_key": {
          "description": "证书秘钥",
          "minLength": 4,
          "maxLength": 20000,
          "type": "string",
          "example": "MIIGsDCCBJigAwIBAgIIdrfb4YBBxtQwDQYJKoZIhvcNAQELBQAwgZIxCzAJBgNV"
        },
        "certificate": {
          "description": "证书",
          "minLength": 4,
          "maxLength": 20000,
          "type": "string",
          "example": "MIIGsDCCBJigAwIBAgIIdrfb4YBBxtQwDQYJKoZIhvcNAQELBQAwgZIxCzAJBgNV"
        },
        "user_name": {
          "type": "string",
          "minLength": 4,
          "maxLength": 256,
          "description": "用户名",
          "example": "user_name"
        },
        "password": {
          "type": "string",
          "minLength": 4,
          "maxLength": 256,
          "description": "密码",
          "example": "password"
        },
        "qos": {
          "type": "integer",
          "minLength": 1,
          "maxLength": 1,
          "description": "服务质量,默认为0,表示最多一次的传输,1表示至少一次,2表示仅一次.",
          "pattern": "(0|1|2)",
          "example": "0",
          "default": 0
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "edge_node_id": {
      "name": "edge_node_id",
      "in": "path",
      "description": "边缘节点ID",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]*$",
      "x-example": "446007715895193600"
    }
  },
  "host": "iotedge-api.cn-east-3.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "put",
  "uri": null
}