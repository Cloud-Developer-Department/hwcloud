{
  "name": "CreateApp",
  "summary": "创建应用模板",
  "tags": "边缘应用模板管理",
  "productshort": "IoTEdge",
  "region_id": "cn-north-4",
  "paths": {
    "/{project_id}/apps": {
      "post": {
        "operationId": "CreateApp",
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity",
        "tags": [
          "App"
        ],
        "summary": "创建应用模板",
        "description": "应用服务器可调用此接口为创建批量处理任务,对多个设备进行批量操作。当前支持批量软固件升级、批量创建设备、批量删除设备、批量冻结、批量解冻、批量下发同步命令、批量下发异步命令。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "CreateAppRequestBody",
            "in": "body",
            "description": "创建应用请求结构体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateAppRequestDTO"
            }
          }
        ],
        "x-returnType": "ResponseEntity<QueryAppBriefResponseDTO>",
        "responses": {
          "201": {
            "description": "Created",
            "x-SuccessCode": true,
            "examples": {
              "app_id": "string",
              "description": "string",
              "app_type": "string",
              "provider_type": "string",
              "create_time": "string",
              "update_time": "string"
            },
            "schema": {
              "$ref": "#/definitions/QueryAppBriefResponseDTO"
            }
          },
          "400": {
            "description": "BAD REQUEST",
            "x-Error": [
              "IoTEdge.014204"
            ]
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "FORBIDDEN",
            "x-Error": [
              "IoTEdge.014206"
            ]
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v3/{project_id}/apps",
        "x-request-examples-1": {
          "app_id": "test-app",
          "app_name": "test-app",
          "description": "this is a test app",
          "app_type": "CloudService"
        }
      }
    }
  },
  "definitions": {
    "QueryAppBriefResponseDTO": {
      "title": "查询应用结列表项构体",
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "应用模板ID"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "应用描述"
        },
        "app_type": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "应用类型"
        },
        "provider_type": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "应用来源"
        },
        "create_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "创建时间"
        },
        "update_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "最后一次修改时间"
        }
      }
    },
    "CreateAppRequestDTO": {
      "title": "创建应用请求结构体",
      "type": "object",
      "required": [
        "app_id",
        "app_type"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "description": "应用ID",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9-_]*$",
          "example": "test-app"
        },
        "app_name": {
          "type": "string",
          "description": "应用名称",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-\\一-\\龥]*$",
          "example": "test-app"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_;:?!,;:、,.?!。\\-\\s\\一-\\龥]*$",
          "description": "应用描述",
          "example": "this is a test app"
        },
        "app_type": {
          "type": "string",
          "description": "应用类型",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "(CloudService|Middleware|PlatformSoftware)",
          "example": "CloudService"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    }
  },
  "host": "iotedge-api.cn-north-4.myhuaweicloud.com",
  "base_path": "/v3",
  "info_version": "v3",
  "method": "post",
  "uri": null
}