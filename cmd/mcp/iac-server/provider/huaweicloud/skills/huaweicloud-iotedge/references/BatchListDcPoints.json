{
  "name": "BatchListDcPoints",
  "summary": "查询点位表配置列表",
  "tags": "边缘数据源点位配置管理",
  "productshort": "IoTEdge",
  "region_id": "cn-north-4",
  "paths": {
    "/{project_id}/edge-nodes/{edge_node_id}/ots/data-sources/{ds_id}/points": {
      "get": {
        "tags": [
          "EdgeDcPointManagement"
        ],
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-requestHandler": true,
        "summary": "查询点位表配置列表",
        "description": "查询点位表配置列表",
        "operationId": "BatchListDcPoints",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-externalAPI": true,
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/edge_node_id"
          },
          {
            "$ref": "#/parameters/ds_id"
          },
          {
            "name": "point_id",
            "in": "query",
            "required": false,
            "description": "采集点位表id,创建点位表时设置,数据源下唯一。",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9-_]*$",
            "x-example": "MotorVoltage"
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\-\\一-\\龥#%()()*]*$",
            "description": "点位名称,允许中、数字、英文大小写、下划线、中划线、#%()*特殊字符.模糊查询",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "property",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "属性,允许中、数字、英文大小写、下划线、中划线,精确查询",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "device_id",
            "in": "query",
            "required": false,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$",
            "description": "设备标识,精确查询"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询的起始位置,取值范围为非负整数,默认为0",
            "required": false,
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 1000000,
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页记录数,默认值为10,取值区间为1-1000",
            "required": false,
            "type": "integer",
            "default": 10,
            "minimum": 0,
            "maximum": 1000000,
            "format": "int32"
          }
        ],
        "x-returnType": "ResponseEntity<QueryDcPointsPageDTO>",
        "responses": {
          "200": {
            "description": "OK",
            "x-SuccessCode": true,
            "examples": {
              "count": 1000000,
              "page_info": {
                "offset": 1000000,
                "limit": 1000
              },
              "points": [
                {
                  "point_id": "MotorVoltage",
                  "name": "马达电压",
                  "collection_config": {
                    "address": "ns=2;s=Root/Motor/Voltage",
                    "data_type": "int",
                    "cycle": 10000
                  },
                  "device_id": "MotorVoltage",
                  "property": "Motor/Voltage",
                  "data_type": "int",
                  "ds_id": "opcua_1",
                  "processing_config": {
                    "validity": {
                      "min": 60,
                      "max": 100
                    },
                    "stream_formula": "bit(0).bool()|string_to_double(-1.0)|string_to_int(0)",
                    "scaling": {
                      "ratio": 1,
                      "base": 100,
                      "accuracy": 2
                    },
                    "clean": {
                      "silent_window": 60,
                      "deviation": 0.1
                    }
                  },
                  "create_time": "2020-05-28T11:31:29.740Z",
                  "update_time": "2020-05-28T11:31:29.740Z"
                }
              ]
            },
            "schema": {
              "$ref": "#/definitions/QueryDcPointsPageDTO"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "definitions": {
    "CreateDcPointRespDTO": {
      "title": "创建点位表配置响应结构体",
      "description": "创建点位表配置响应结构体",
      "type": "object",
      "properties": {
        "point_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-_]*$",
          "description": "点位表id,数据源下唯一",
          "minLength": 1,
          "maxLength": 64,
          "example": "MotorVoltage"
        },
        "name": {
          "type": "string",
          "description": "点位名称,允许中、数字、英文大小写、下划线、中划线、#%()*特殊字符",
          "pattern": "^[a-zA-Z0-9_\\-\\一-\\龥#%()()*]*$",
          "minLength": 1,
          "maxLength": 64,
          "example": "马达电压"
        },
        "collection_config": {
          "type": "object",
          "description": "点位采集配置",
          "example": {
            "address": "ns=2;s=Root/Motor/Voltage",
            "data_type": "int",
            "cycle": 10000
          }
        },
        "device_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$",
          "description": "设备id",
          "example": "MotorVoltage"
        },
        "property": {
          "type": "string",
          "description": "属性,允许中、数字、英文大小写、下划线、中划线",
          "pattern": "^[一-龥a-zA-Z0-9_?/'#().,&%@!-]*$",
          "minLength": 1,
          "maxLength": 128,
          "example": "Motor/Voltage"
        },
        "data_type": {
          "type": "string",
          "description": "点位数据类型",
          "minLength": 1,
          "maxLength": 32,
          "example": "int"
        },
        "ds_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-_]*$",
          "description": "采集数据源id,节点下唯一",
          "minLength": 1,
          "maxLength": 64,
          "example": "opcua_1"
        },
        "processing_config": {
          "description": "点位处理配置",
          "$ref": "#/definitions/ProcessingConfigDTO"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间",
          "example": "2020-05-28T11:31:29.740Z",
          "minLength": 0,
          "maxLength": 256
        },
        "update_time": {
          "type": "string",
          "description": "最后一次修改时间",
          "example": "2020-05-28T11:31:29.740Z",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "ProcessingConfigDTO": {
      "title": "点位处理配置结构体",
      "description": "点位处理配置结构体",
      "type": "object",
      "properties": {
        "validity": {
          "description": "点位校验",
          "type": "object",
          "$ref": "#/definitions/PointValidityingDTO"
        },
        "stream_formula": {
          "title": "点位流公式配置字段",
          "description": "点位流公式配置字段",
          "type": "string",
          "pattern": "^bit\\(([0-9]|[1-2][0-9]|3[0-1])\\)(\\.bool\\(\\))?$|^string_to_int\\(((-?[1-9]\\d*)|0)\\)$|^string_to_double\\((-?(?:[1-9]\\d*\\.\\d*|0\\.\\d*|[1-9]\\d*)|0)\\)$",
          "minLength": 0,
          "maxLength": 128,
          "example": "bit(0).bool()|string_to_double(-1.0)|string_to_int(0)"
        },
        "scaling": {
          "description": "点位缩放规则列表",
          "type": "object",
          "$ref": "#/definitions/PointScalingDTO"
        },
        "clean": {
          "description": "点位计算规则列表",
          "type": "object",
          "$ref": "#/definitions/PointCleanDTO"
        }
      }
    },
    "PointCleanDTO": {
      "title": "点位清洗配置结构体",
      "description": "点位清洗配置结构体",
      "type": "object",
      "required": [
        "silent_window",
        "deviation"
      ],
      "properties": {
        "silent_window": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 86400,
          "description": "静默时间窗口,在该时间窗口内,没有触发上报条件,点位将不会上",
          "example": 60
        },
        "deviation": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 100,
          "description": "偏差,在该偏差范围内表示是正常波动,点位将不进行上报",
          "example": 0.1
        }
      }
    },
    "PageInfoDTO": {
      "title": "分页列表响应结构体",
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "maximum": 1000000,
          "minimum": 0,
          "description": "页码"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "maximum": 1000,
          "minimum": 1,
          "description": "每页记录数"
        }
      }
    },
    "PointScalingDTO": {
      "title": "点位缩放配置结构体",
      "description": "点位缩放配置结构体",
      "type": "object",
      "required": [
        "ratio",
        "base"
      ],
      "properties": {
        "ratio": {
          "type": "number",
          "format": "double",
          "minimum": -10000,
          "maximum": 10000,
          "description": "缩放的倍率",
          "example": 1
        },
        "base": {
          "type": "number",
          "format": "double",
          "minimum": -10000,
          "maximum": 10000,
          "description": "基准值",
          "example": 100
        },
        "accuracy": {
          "type": "integer",
          "format": "int32",
          "minimum": -1,
          "maximum": 8,
          "description": "缩放后结果的精度,精确到小数点后几位,-1表示全部保留,0表示只保留整数位",
          "example": 2,
          "default": -1
        }
      }
    },
    "PointValidityingDTO": {
      "title": "点位校验配置结构体",
      "description": "点位校验配置结构体",
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "format": "int64",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "点位上报值的最小值,小于该值则上报告警",
          "example": 60
        },
        "max": {
          "type": "integer",
          "format": "int64",
          "minimum": -9007199254740992,
          "maximum": 9007199254740992,
          "description": "点位上报值的最大值,大于该值则上报告警",
          "example": 100
        }
      }
    },
    "QueryDcPointsPageDTO": {
      "title": "查询点位表配置列表响应结构体",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1000000,
          "description": "总记录数"
        },
        "page_info": {
          "description": "分页信息",
          "$ref": "#/definitions/PageInfoDTO"
        },
        "points": {
          "type": "array",
          "description": "每页记录数",
          "minItems": 0,
          "maxItems": 1000000,
          "items": {
            "$ref": "#/definitions/CreateDcPointRespDTO"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ds_id": {
      "name": "ds_id",
      "in": "path",
      "description": "采集数据源id,创建数据源配置时设置,节点下唯一。",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9-_]*$",
      "x-example": "opc"
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "edge_node_id": {
      "name": "edge_node_id",
      "in": "path",
      "description": "边缘节点ID",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]*$",
      "x-example": "446007715895193600"
    }
  },
  "host": "iotedge-api.cn-north-4.myhuaweicloud.com",
  "base_path": "/v2",
