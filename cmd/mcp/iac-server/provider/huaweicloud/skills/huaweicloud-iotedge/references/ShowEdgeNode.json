{
  "name": "ShowEdgeNode",
  "summary": "查询边缘节点详情",
  "tags": "节点管理",
  "productshort": "IoTEdge",
  "region_id": "cn-south-1",
  "paths": {
    "/{project_id}/edge-nodes/{edge_node_id}": {
      "get": {
        "tags": [
          "BasicNode"
        ],
        "summary": "查询边缘节点详情",
        "description": "查询边缘节点详情",
        "operationId": "ShowEdgeNode",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-externalAPI": true,
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/edge_node_id"
          }
        ],
        "x-returnType": "ResponseEntity<QueryEdgeNodeResponse>",
        "responses": {
          "200": {
            "description": "Ok",
            "x-SuccessCode": true,
            "examples": {
              "application/json": {
                "log_configs": [
                  {
                    "size": 1000,
                    "level": "string",
                    "rotate_num": 10,
                    "rotate_period": "string",
                    "type": "LTS",
                    "component": "string"
                  }
                ],
                "ha_config": {
                  "ha_type": "ACTIVE_STANDBY",
                  "active_standby_config": {
                    "work_node": "DEFAULT",
                    "master_interface_name": "eth0",
                    "slave_interface_name": "eth0",
                    "virtual_ip_address": "127.0.0.1",
                    "virtual_ipv6_address": "ABCD:EF01:2345:6789:ABCD:EF01:2345:6789"
                  }
                },
                "edge_node_id": "string",
                "instance_id": "string",
                "product_id": "string",
                "product_name": "jeQDJQZltU8iKgFFoW060F5SGZka",
                "space_id": "jeQDJQZltU8iKgFFoW060F5SGZka",
                "resource_spec_types": [
                  "iotedge.campus.1000tps.10000device"
                ],
                "resource_ids": [
                  "jeQDJQZltU8iKgFFoW060F5SGZka"
                ],
                "ips": [
                  "string"
                ],
                "name": "string",
                "state": "string",
                "software_version": "1.0.0",
                "create_time": "string",
                "update_time": "string",
                "os_name": "string",
                "arch": "string",
                "host_name": "string",
                "nics": [
                  {
                    "eth": "string",
                    "ip": "string"
                  }
                ],
                "specification": "string",
                "ai_card_type": "string",
                "container_version": "17.0.1",
                "type": "string",
                "security_level": "HIGH",
                "reliability_level": "LOW",
                "storage_period": 7,
                "base_path": [
                  {
                    "log_base_path": "string",
                    "config_base_path": "string",
                    "db_base_path": "string"
                  }
                ],
                "hardware_model": "string",
                "offline_cache_configs": {
                  "publish_order": "realtime_first",
                  "period": 7,
                  "capacity": 2048
                },
                "device_auth_info": {
                  "auth_type": "CERTIFICATES",
                  "local_path": {
                    "cert_path": "/opt/device-cert/cert.pem",
                    "key_path": "/opt/device-cert/key.pem"
                  }
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryEdgeNodeResponse"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error",
            "x-Error": [
              "IoTEdge.00000001"
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "OfflineCacheConfigsDTO": {
      "title": "节点缓存配置结构体",
      "type": "object",
      "description": "节点离线缓存配置",
      "properties": {
        "publish_order": {
          "type": "string",
          "description": "数据上报优先级,可选项:realtime_first实时数据优先 sequential按时序上报,默认realtime_first",
          "pattern": "(sequential|realtime_first)",
          "default": "realtime_first"
        },
        "period": {
          "type": "integer",
          "format": "int32",
          "description": "节点离线缓存数据的储存天数,默认7,取值范围-1~14,-1表示存储天数没有限制",
          "minimum": -1,
          "maximum": 14,
          "default": 7
        },
        "capacity": {
          "type": "integer",
          "format": "int32",
          "description": "节点离线缓存容量,单位MB,默认2048,取值范围500-8192",
          "minimum": 500,
          "maximum": 8192,
          "default": 2048
        }
      }
    },
    "QueryEdgeNodeResponse": {
      "type": "object",
      "description": "创建边缘节点及查询边缘节点响应体",
      "x-imports": "java.util.Map;java.util.List;",
      "properties": {
        "log_configs": {
          "type": "array",
          "maxItems": 10,
          "minItems": 0,
          "description": "边缘节点在IEF的日志配置",
          "items": {
            "$ref": "#/definitions/LogConfigDTO"
          }
        },
        "ha_config": {
          "description": "节点根目录配置",
          "$ref": "#/definitions/HaConfigDTO"
        },
        "edge_node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]*$",
          "description": "边缘节点Id"
        },
        "instance_id": {
          "type": "string",
          "description": "实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。",
          "pattern": "^[a-f0-9-]{1,36}$",
          "minLength": 1,
          "maxLength": 36,
          "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
        },
        "product_id": {
          "description": "边缘节点关联的产品ID,用于唯一标识一个产品模型。",
          "type": "string",
          "pattern": "^[a-f0-9-]{1,36}$",
          "minLength": 1,
          "maxLength": 36,
          "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
        },
        "product_name": {
          "description": "边缘节点关联的产品名称。",
          "type": "string",
          "pattern": "^[一-龥a-zA-Z0-9_?'#().,&%@!-]{1,64}$",
          "minLength": 1,
          "maxLength": 64,
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka"
        },
        "space_id": {
          "description": "资源空间id,对应IOTDA云服务接口参数中的app_id。",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64,
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka"
        },
        "resource_spec_types": {
          "type": "array",
          "description": "节点所购买的资源类型的列表",
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 16,
            "example": "iotedge.campus.1000tps.10000device"
          }
        },
        "resource_ids": {
          "description": "资源id列表,创建节点时需绑定已购买的资源包,可以叠加节点功能。",
          "type": "array",
          "x-type": "List<@Pattern(regexp = \"^[a-zA-Z0-9-_/]*$\")String>",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]*$",
            "minLength": 1,
            "maxLength": 64,
            "example": "jeQDJQZltU8iKgFFoW060F5SGZka"
          }
        },
        "ips": {
          "type": "array",
          "maxItems": 10,
          "minItems": 0,
          "description": "边缘节点主机ip",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-\\一-\\龥]*$",
          "description": "边缘节点名称"
        },
        "state": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "description": "边缘节点状态"
        },
        "software_version": {
          "description": "边缘应用id,只允许数字、英文小写、中划线,切必须以字母或数字结尾",
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9-_$]*$",
          "example": "1.0.0"
        },
        "create_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "边缘节点创建时间"
        },
        "update_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "边缘节点更新时间"
        },
        "os_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "边缘节点操作系统名称"
        },
        "arch": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "description": "边缘节点操作系统架构"
        },
        "host_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "边缘节点主机名"
        },
        "nics": {
          "type": "array",
          "maxItems": 10,
          "minItems": 0,
          "description": "边缘节点网络网卡信息",
          "items": {
            "$ref": "#/definitions/Nic"
          }
        },
        "specification": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "网络规格,如4 cores | 3867 MB"
        },
        "ai_card_type": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "description": "AI加速卡类型,如华为昇腾AI加速卡NPU、图像处理加速卡GPU。"
        },
        "npu_library_path": {
          "type": "string",
          "description": "npu驱动动态库路径",
          "pattern": "^/([a-zA-Z_0-9-]+/)*$",
          "minLength": 0,
          "maxLength": 256,
          "example": "/usr/local/Ascend/driver/lib64/"
        },
        "container_version": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "容器运行时版本",
          "example": "17.0.1"
        },
        "type": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "description": "节点所属资源类型:advanced|standard"
        },
        "security_level": {
          "description": "节点的安全等级,MEDIUM边缘节数据上报不进行加密,HIGH对数据上报进行加密。",
          "type": "string",
          "pattern": "(MEDIUM|HIGH)",
          "minLength": 1,
          "maxLength": 64,
          "example": "HIGH"
        },
        "reliability_level": {
          "description": "节点的可靠性等级。",
          "type": "string",
          "pattern": "(MEDIUM|LOW)",
          "minLength": 1,
          "maxLength": 64,
          "example": "LOW",
          "default": "LOW"
        },
        "storage_period": {
          "type": "integer",
          "format": "int32",
          "description": "节点的存储周期,默认0天,取值范围0~7天,0天则不存储。",
          "minimum": 0,
          "maximum": 7
        },
        "base_path": {
          "description": "节点根目录配置",
          "$ref": "#/definitions/BasePathDTO"
        },
        "hardware_model": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "注册节点网关配置"
        },
        "offline_cache_configs": {
          "description": "边缘节点离线缓存配置",
          "$ref": "#/definitions/OfflineCacheConfigsDTO"
        },
        "device_auth_info": {
          "description": "边缘节点设备认证方式",
          "$ref": "#/definitions/DeviceAuthInfoDisplayDTO"
        },
        "device_data_format": {
          "type": "string",
          "pattern": "(iotda_1.0|flat_json)",
          "minLength": 0,
          "maxLength": 16,
          "description": "节点使用的数据格式,默认为iotda物模型1.0格式,可以选择属性平铺数据格式flat_json"
        },
        "automatic_upgrade": {
          "type": "string",
          "pattern": "(OFF|IMMEDIATE)",
          "minLength": 0,
          "maxLength": 16,
          "description": "自动升级系统应用的节点开关,默认为关闭:OFF,IMMEDIATE表示节点开关打开"
        },
        "device_data_record": {
          "description": "边缘节点设备数据上报打印配置",
          "$ref": "#/definitions/DeviceDataRecord"
        },
        "metric_report": {
          "description": "omagent监控运维工具是否上报指标",
          "type": "string",
          "pattern": "(off|on)",
          "minLength": 0,
          "maxLength": 16
        }
      }
    },
    "DeviceAuthInfoDisplayDTO": {
      "description": "边缘节点认证方式信息。",
      "type": "object",
      "required": [
        "auth_type"
      ],
      "properties": {
        "auth_type": {
          "type": "string",
          "description": "边缘节点认证方式。",
          "pattern": "(SECRET|CERTIFICATES)",
          "default": "SECRET",
          "example": "CERTIFICATES"
        },
        "local_path": {
          "type": "object",
          "description": "证书文件的本地存储路径",
          "$ref": "#/definitions/CertificateLocalPathDTO"
        }
      }
    },
    "CertificateLocalPathDTO": {
      "description": "证书文件的本地存储路径",
      "type": "object",
      "required": [
        "cert_path",
        "key_path"
      ],
      "properties": {
        "cert_path": {
          "type": "string",
          "description": "节点数字证书的本地存储路径。",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^/([a-zA-Z0-9-_]+/?)+(.pem|.crt){1}$",
          "example": "/opt/device-cert/cert.pem"
        },
        "key_path": {
          "type": "string",
          "description": "证书私钥的本地存储路径。",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^/([a-zA-Z0-9-_]+/?)+(.pem|.key){1}$",
          "example": "/opt/device-cert/key.pem"
        }
      }
    },
    "BasePathDTO": {
      "title": "节点根目录结构体",
      "type": "object",
      "properties": {
        "log_base_path": {
          "type": "string",
          "pattern": "^/([a-zA-Z_0-9-]+/)*$",
          "minLength": 1,
          "maxLength": 64,
          "description": "节点日志根目录"
        },
        "config_base_path": {
          "type": "string",
          "pattern": "^/([a-zA-Z_0-9-]+/)*$",
          "minLength": 1,
          "maxLength": 64,
          "description": "节点配置根目录"
        },
        "db_base_path": {
          "type": "string",
          "pattern": "^/([a-zA-Z_0-9-]+/)*$",
          "minLength": 1,
          "maxLength": 64,
          "description": "节点数据存储根目录"
        },
        "offline_cache_configs": {
          "description": "边缘节点离线缓存配置",
          "$ref": "#/definitions/OfflineCacheConfigsDTO"
        }
      }
    },
    "Nic": {
      "type": "object",
      "description": "网络网卡信息",
      "properties": {
        "eth": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "网卡信息,如eth0,eth1"
        },
        "ip": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "网卡ip"
        }
      }
    },
    "DeviceDataRecord": {
      "description": "设备上报数据打印开关",
      "type": "object",
      "required": [
        "disk_quota",
        "age",
        "state"
      ],
      "properties": {
        "disk_quota": {
          "description": "磁盘配额,单位MB,参考值,只能保证在这个值左右",
          "type": "integer",
          "format": "int32",
          "minimum": 512,
          "maximum": 10240,
          "default": 512
        },
        "age": {
          "description": "老化时间,日志压缩文件名时间戳老于这个时间就会发生老化删除",
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 7,
          "default": 1
        },
        "state": {
          "description": "配置开关,true启用数据打印,false不启用数据打印",
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "pattern": "(on|off)",
          "example": "off"
        }
      }
    },
    "LogConfigDTO": {
      "type": "object",
      "description": "日志配置",
      "properties": {
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "应用日志文件大小限制,单位MB,默认50,取值范围10-1000",
          "minimum": 10,
          "maximum": 1000
        },
        "level": {
          "type": "string",
          "description": "应用日志级别,可选项:on/off/trace/debug/info/warn/error/fatal,当type为LTS时有效。当选择非on/off的选项时,将只采集大于等于指定级别的日志。",
          "pattern": "(on|off|trace|debug|info|warn|error|fatal)"
        },
        "rotate_num": {
          "type": "integer",
          "format": "int32",
          "description": "应用日志rotate个数,默认5,取值范围1-10",
          "minimum": 1,
          "maximum": 10
        },
        "rotate_period": {
          "type": "string",
          "description": "应用日志rotate周期,可选项: daily/monthly/weekly/yearly",
          "pattern": "(daily|monthly|weekly|yearly)"
        },
        "type": {
          "type": "string",
          "description": "LTS:将日志发送到LTS, local 本地日志",
          "pattern": "(LTS|local)",
          "default": "LTS"
        },
        "component": {
          "type": "string",
          "description": "app:部署到边缘设备上的应用的日志, system 边缘设备上系统的日志",
          "pattern": "(app|system)"
        }
      }
    },
    "HaConfigDTO": {
      "title": "高可用配置请求结构体",
      "description": "高可用配置请求结构体",
      "type": "object",
      "properties": {
        "ha_type": {
          "type": "string",
          "pattern": "(ACTIVE_ACTIVE|ACTIVE_STANDBY)",
          "description": "节点高可用类型双活或者主备",
          "default": "ACTIVE_STANDBY",
          "example": "ACTIVE_STANDBY"
        },
        "active_standby_config": {
          "description": "主备详细配置",
          "$ref": "#/definitions/ActiveStandbyConfigDTO"
        }
      }
    },
    "ActiveStandbyConfigDTO": {
      "title": "高可用主备类型配置请求结构体",
      "description": "高可用主备配置请求结构体",
      "type": "object",
      "properties": {
        "work_node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9-_]*$",
          "description": "当前的工作节点,主节点还是备节点在工作,初始创建时工作节点为DEFAULT节点,(DEFAULT|MASTER|SLAVE)",
          "default": "DEFAULT",
          "example": "DEFAULT"
        },
        "master_interface_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9-_]*$",
          "description": "主节点网卡名称",
          "example": "eth0"
        },
        "slave_interface_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9-_]*$",
          "description": "备节点网卡名称",
          "example": "eth0"
        },
        "virtual_ip_address": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "网卡ip",
          "example": "127.0.0.1"
        },
        "virtual_ipv6_address": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "网卡ipv6地址",
          "example": "ABCD:EF01:2345:6789:ABCD:EF01:2345:6789"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    },
    "edge_node_id": {
      "name": "edge_node_id",
      "in": "path",
      "description": "边缘节点ID",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]*$",
      "x-example": "446007715895193600"
    },
    "X-Auth-Token": {
