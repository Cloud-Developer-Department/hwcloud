{
  "name": "ShowAppVersion",
  "summary": "查询应用版本详情",
  "tags": "边缘应用模板版本管理",
  "productshort": "IoTEdge",
  "region_id": "cn-north-4",
  "paths": {
    "/{project_id}/apps/{app_id}/versions/{version}": {
      "get": {
        "operationId": "ShowAppVersion",
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity",
        "tags": [
          "AppVersion"
        ],
        "summary": "查询应用版本详情",
        "description": "应用服务器可调用此接口查询应用版本详情。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "app_id",
            "in": "path",
            "description": "应用ID",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9-_]*$"
          },
          {
            "name": "version",
            "in": "path",
            "description": "应用版本",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "[0-9]{1,9}\\.[0-9]{1,9}\\.[0-9]{1,9}"
          }
        ],
        "x-returnType": "ResponseEntity<QueryAppVersionResponseDTO>",
        "responses": {
          "200": {
            "description": "OK",
            "x-SuccessCode": true,
            "examples": {
              "count": 1000000,
              "page_info": {
                "offset": 1000000,
                "limit": 1000
              },
              "app_versions": [
                {
                  "app_id": "string",
                  "version": "string",
                  "values": {},
                  "create_time": "string",
                  "update_time": "string"
                }
              ]
            },
            "schema": {
              "$ref": "#/definitions/QueryAppVersionResponseDTO"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v3/{project_id}/apps/{app_id}/versions/{version}"
      }
    }
  },
  "definitions": {
    "QueryAppVersionResponseDTO": {
      "title": "应用模板简要信息",
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string",
          "description": "应用模板ID"
        },
        "version": {
          "type": "string",
          "description": "应用版本"
        },
        "values": {
          "type": "object",
          "description": "应用版本配置"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间"
        },
        "update_time": {
          "type": "string",
          "description": "最后一次修改时间"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    }
  },
  "host": "iotedge-api.cn-north-4.myhuaweicloud.com",
  "base_path": "/v3",
  "info_version": "v3",
  "method": "get",
  "uri": null
}