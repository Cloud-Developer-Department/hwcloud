{
  "name": "ImportPoints",
  "summary": "批量导入点位表",
  "tags": "点位表模板管理",
  "productshort": "IoTEdge",
  "region_id": "cn-north-4",
  "paths": {
    "/{project_id}/edge-nodes/{edge_node_id}/ots/data-sources/{ds_id}/import-points": {
      "post": {
        "tags": [
          "EdgePointTemplatesManagement"
        ],
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-requestHandler": true,
        "summary": "批量导入点位表",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-externalAPI": true,
        "description": "用户通过Console接口在指定边缘节点上点位表配置",
        "operationId": "ImportPoints",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/edge_node_id"
          },
          {
            "$ref": "#/parameters/ds_id"
          },
          {
            "in": "formData",
            "name": "file",
            "required": true,
            "type": "file",
            "description": "上传点位映射文件。当前仅支持xlsx/xls文件格式,且文件最大行数为10000行。"
          },
          {
            "name": "update_type",
            "in": "query",
            "required": true,
            "description": "该字段PARTIAL则增量覆盖,已有点位更新,新增点位插入;该字段为COMPLETE则全量覆盖,则删除数据源下所有点位,插入当前导入所有点位",
            "type": "string",
            "pattern": "(PARTIAL|COMPLETE)",
            "enum": [
              "PARTIAL",
              "COMPLETE"
            ]
          }
        ],
        "x-returnType": "ResponseEntity<String>",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "string"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "definitions": {},
  "version": "2.0",
  "parameters": {
    "ds_id": {
      "name": "ds_id",
      "in": "path",
      "description": "采集数据源id,创建数据源配置时设置,节点下唯一。",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9-_]*$",
      "x-example": "opc"
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "edge_node_id": {
      "name": "edge_node_id",
      "in": "path",
      "description": "边缘节点ID",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]*$",
      "x-example": "446007715895193600"
    }
  },
  "host": "iotedge-api.cn-north-4.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "post",
  "uri": null
}