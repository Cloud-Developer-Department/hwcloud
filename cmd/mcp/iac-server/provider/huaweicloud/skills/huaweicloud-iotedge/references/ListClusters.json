{
  "name": "ListClusters",
  "summary": "查询边缘集群列表",
  "tags": "边缘集群管理",
  "productshort": "IoTEdge",
  "region_id": "cn-north-4",
  "paths": {
    "/{project_id}/clusters": {
      "get": {
        "operationId": "ListClusters",
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity",
        "tags": [
          "Cluster"
        ],
        "summary": "查询边缘集群列表",
        "description": "应用服务器可调用此接口查询边缘集群列表。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-iftype": "OpenAPI_new",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "cluster_name",
            "in": "query",
            "description": "边缘集群名称",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9-_]*$"
          },
          {
            "name": "state",
            "in": "query",
            "description": "边缘集群状态",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "(UNINSTALLED|UNCONNECTED|RUNNING)"
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 1000,
            "default": 10,
            "description": "每页记录数,默认值为10,取值区间为1-1000。"
          },
          {
            "in": "query",
            "name": "offset",
            "description": "查询的起始位置,取值范围为非负整数,默认为0。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 1000000,
            "minimum": 0
          }
        ],
        "x-returnType": "ResponseEntity<QueryClusterPageDTO>",
        "responses": {
          "200": {
            "description": "OK",
            "x-SuccessCode": true,
            "examples": {
              "count": 1000000,
              "page_info": {
                "offset": 1000000,
                "limit": 1000
              },
              "clusters": [
                {
                  "cluster_id": "123343534",
                  "cluster_name": "test-cluster",
                  "description": "this is a test cluster",
                  "version": "string",
                  "state": "string",
                  "create_time": "string",
                  "update_time": "string",
                  "is_upgradeable": true
                }
              ]
            },
            "schema": {
              "$ref": "#/definitions/QueryClusterPageDTO"
            }
          },
          "400": {
            "description": "BAD REQUEST",
            "x-Error": [
              "IoTEdge.014204"
            ]
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "FORBIDDEN",
            "x-Error": [
              "IoTEdge.014206"
            ]
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v3/{project_id}/clusters"
      }
    }
  },
  "definitions": {
    "QueryClusterBriefResponseDTO": {
      "title": "边缘集群简略信息",
      "type": "object",
      "properties": {
        "cluster_id": {
          "type": "string",
          "description": "集群ID",
          "example": "123343534"
        },
        "cluster_name": {
          "type": "string",
          "description": "集群名称",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9-_]*$",
          "example": "test-cluster"
        },
        "description": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_;:?!,;:、,.?!。\\-\\s\\一-\\龥]*$",
          "description": "集群描述",
          "example": "this is a test cluster"
        },
        "version": {
          "type": "string",
          "description": "边缘集群版本"
        },
        "state": {
          "type": "string",
          "description": "边缘集群状态"
        },
        "create_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "创建时间"
        },
        "update_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "最后一次修改时间"
        },
        "is_upgradeable": {
          "type": "boolean",
          "description": "是否可升级"
        }
      }
    },
    "PageInfoDTO": {
      "title": "分页列表响应结构体",
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "maximum": 1000000,
          "minimum": 0,
          "description": "页码"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "maximum": 1000,
          "minimum": 1,
          "description": "每页记录数"
        }
      }
    },
    "QueryClusterPageDTO": {
      "title": "查询边缘集群列表响应结构体",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "总记录数",
          "minimum": 0,
          "maximum": 1000000
        },
        "page_info": {
          "description": "分页信息",
          "$ref": "#/definitions/PageInfoDTO"
        },
        "clusters": {
          "type": "array",
          "description": "每页记录数",
          "minItems": 0,
          "maxItems": 1000000,
          "items": {
            "$ref": "#/definitions/QueryClusterBriefResponseDTO"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    }
  },
  "host": "iotedge-api.cn-north-4.myhuaweicloud.com",
  "base_path": "/v3",
  "info_version": "v3",
  "method": "get",
  "uri": null
}