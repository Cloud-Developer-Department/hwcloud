{
  "name": "DownloadAppVersion",
  "summary": "下载应用版本Chart包",
  "tags": "边缘应用模板版本管理",
  "productshort": "IoTEdge",
  "region_id": "cn-east-3",
  "paths": {
    "/{project_id}/apps/{app_id}/versions/{version}/archive": {
      "get": {
        "operationId": "DownloadAppVersion",
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity",
        "tags": [
          "AppVersion"
        ],
        "summary": "下载应用版本Chart包",
        "description": "应用服务器可调用此接口下载应用版本Chart包。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/octet-stream"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "app_id",
            "in": "path",
            "description": "应用ID",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9-_]*$"
          },
          {
            "name": "version",
            "in": "path",
            "description": "应用版本",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "[0-9]{1,9}\\.[0-9]{1,9}\\.[0-9]{1,9}"
          }
        ],
        "x-returnType": "ResponseEntity<byte[]>",
        "responses": {
          "200": {
            "description": "OK",
            "x-SuccessCode": true,
            "schema": {
              "type": "string",
              "format": "binary"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v3/{project_id}/apps/{app_id}/versions/{version}/download"
      }
    }
  },
  "definitions": {},
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    }
  },
  "host": "iotedge-api.cn-east-3.myhuaweicloud.com",
  "base_path": "/v3",
  "info_version": "v3",
  "method": "get",
  "uri": null
}