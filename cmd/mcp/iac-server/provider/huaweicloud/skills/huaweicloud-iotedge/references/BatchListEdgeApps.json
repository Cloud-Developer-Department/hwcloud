{
  "name": "BatchListEdgeApps",
  "summary": "查询应用列表",
  "tags": "应用管理",
  "productshort": "IoTEdge",
  "region_id": "cn-east-3",
  "paths": {
    "/{project_id}/edge-apps": {
      "get": {
        "tags": [
          "EdgeAppManagement"
        ],
        "summary": "查询应用列表",
        "description": "查询应用列表",
        "operationId": "BatchListEdgeApps",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-externalAPI": true,
        "consumes": [
          "application/json"
