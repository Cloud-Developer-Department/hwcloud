            "maxLength": 32,
            "description": "应用ID搜索关键字",
            "required": false,
            "type": "string"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询的起始位置,取值范围为非负整数,默认为0",
            "required": false,
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 1000000,
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页记录数,默认值为10,取值区间为1-1000",
            "required": false,
            "type": "integer",
            "default": 10,
            "minimum": 0,
            "maximum": 1000000,
            "format": "int32"
          },
          {
            "name": "app_type",
            "in": "query",
            "description": "应用id搜索关键字",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "pattern": "(SYSTEM_OPTIONAL|USER|SYSTEM_REQUIRED)",
            "enum": [
              "SYSTEM_REQUIRED",
              "SYSTEM_OPTIONAL",
              "USER"
            ]
          },
          {
            "name": "function_type",
            "in": "query",
            "description": "功能类型",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "pattern": "(DATA_PROCESSING|PROTOCOL_PARSING|ON_PREMISE_INTEGRATION|GATEWAY_MANAGER|COMPOSITE_APPLICATION|DATA_COLLECTION)",
            "enum": [
              "DATA_PROCESSING",
              "PROTOCOL_PARSING",
              "ON_PREMISE_INTEGRATION",
              "GATEWAY_MANAGER",
              "COMPOSITE_APPLICATION",
              "DATA_COLLECTION"
            ]
          }
        ],
        "x-returnType": "ResponseEntity<QueryEdgeAppPageDTO>",
        "responses": {
          "200": {
            "description": "OK",
            "x-SuccessCode": true,
            "examples": {
              "application/json": {
                "count": 0,
                "page_info": {
                  "offset": 0,
                  "limit": 0
                },
                "edge_apps": [
                  {
                    "edge_app_id": "string",
                    "description": "string",
                    "create_time": "string",
                    "update_time": "string",
                    "last_published_version": "string",
                    "app_type": "string",
                    "function_type": "string",
                    "protocol": "string",
                    "edge_app_name": "string",
                    "deploy_type": "string"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryEdgeAppPageDTO"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
