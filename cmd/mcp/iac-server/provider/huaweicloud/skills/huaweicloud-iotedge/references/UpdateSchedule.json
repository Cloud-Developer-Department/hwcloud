  "definitions": {
    "TimeSpans": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^(20|21|22|23|[0-1]\\d):[0-5]\\d:[0-5]\\d$",
          "description": "开始时间;不包含日期,为本地时刻,根据网关侧的本地时间进行调度",
          "minLength": 1,
          "maxLength": 10,
          "example": "11:40:00"
        },
        "end": {
          "type": "string",
          "pattern": "^(20|21|22|23|[0-1]\\d):[0-5]\\d:[0-5]\\d$",
          "description": "结束时间,不包含日期,为本地时刻,根据网关侧的本地时间进行调度",
          "minLength": 1,
          "maxLength": 10,
          "example": "11:49:00"
        }
      }
    },
    "ScheduleTask": {
      "type": "object",
      "description": "调度计划结构体",
      "required": [
        "device_ids",
        "action",
        "paras"
      ],
      "properties": {
        "device_ids": {
          "type": "array",
          "description": "设备id数组",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]*$",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "action": {
          "type": "string",
          "description": "任务执行的动作,当前支持SetProperties",
          "pattern": "(SetProperties)",
          "example": "SetProperties"
        },
        "paras": {
          "type": "object",
          "description": "对应action的参数",
          "example": [
            {
              "service_id": "dataService",
              "properties": {
                "Switch": 1
              }
            }
          ]
        }
      }
    },
    "ExceptionalDates": {
      "type": "object",
      "description": "例外的日期,valid_dates表示需要执行的日期,invalid_dates表示不执行的日期。其优先级最高,优先级:ExceptionalDates > weekdays > start_time-endtime",
      "properties": {
        "valid_dates": {
          "description": "例外日期",
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^(\\d{4})-(0[1-9]|1[0-2])-([0-2]\\d|3[01])$",
            "example": "2023-01-01"
          }
        },
        "invalid_dates": {
          "description": "无效日期",
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^(\\d{4})-(0[1-9]|1[0-2])-([0-2]\\d|3[01])$",
            "example": "2023-01-01"
          }
        }
      }
    },
    "ScheduleDetailRspDTO": {
      "title": "调度计划详情结构体",
      "description": "调度计划详情结构体",
      "x-imports": "java.util.Map;",
      "type": "object",
      "properties": {
        "schedule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-_]*$",
          "description": "调度计划id,租户下唯一",
          "minLength": 1,
          "maxLength": 64,
          "example": "1A"
        },
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "节点id",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "x-example": "446007715895193600"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-\\一-\\龥]*$",
          "description": "调度计划名称",
          "minLength": 1,
          "maxLength": 64,
          "example": "H1照明控制"
        },
        "cycle_type": {
          "type": "string",
          "pattern": "(once|daily)",
          "description": "调度计划的循环类型",
          "minLength": 1,
          "maxLength": 64,
          "example": "daily"
        },
        "enabled": {
          "type": "boolean",
          "description": "调度计划是否生效",
          "minLength": 1,
          "maxLength": 64,
          "example": true
        },
        "start_time": {
          "description": "调度计划起始时间,毫秒级别的时间戳",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 4828176000000,
          "example": 1691572410000
        },
        "end_time": {
          "description": "调度计划结束时间,毫秒级别的时间戳",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 4828176000000,
          "example": 1691572410000
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 16,
          "description": "调度计划优先级, 1-16",
          "example": 8
        },
        "daily": {
          "$ref": "#/definitions/DailyDto"
        },
        "tasks": {
          "type": "array",
          "description": "调度任务信息",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/ScheduleTask"
          }
        }
      }
    },
    "DailyDto": {
      "title": "每天的时间描述结构体",
      "description": "每天的时间描述结构体",
      "x-imports": "java.util.Map;",
      "type": "object",
      "required": [
        "time_spans"
      ],
      "properties": {
        "exceptional_dates": {
          "$ref": "#/definitions/ExceptionalDates"
        },
        "time_spans": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "description": "时间段描述",
          "items": {
            "$ref": "#/definitions/TimeSpans"
          }
        },
        "weekdays": {
          "type": "object",
          "x-type": "List<@Min(0) @Max(7) Integer>",
          "description": "描述此任务有效的星期几,为数组。如果为null,则表示start_time-endtime之间,每天都执行;如果为空数组,则表示start_time-endtime之间,每天都不执行;如果为[1, 2],则表示每周一、二执行。"
        }
      }
    },
    "UpdateScheduleReqDTO": {
      "title": "更新调度计划请求结构体",
      "description": "更新调度计划请求结构体",
      "x-imports": "java.util.Map;",
      "type": "object",
      "required": [
        "name",
        "enabled",
        "end_time",
        "priority",
        "tasks"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-\\一-\\龥]*$",
          "description": "调度计划名称",
          "minLength": 1,
          "maxLength": 64,
          "example": "H1照明控制"
        },
        "enabled": {
          "type": "boolean",
          "description": "调度计划是否生效",
          "minLength": 1,
          "maxLength": 64,
          "example": true
        },
        "start_time": {
          "description": "调度计划起始时间,毫秒级别的时间戳",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 4828176000000,
          "example": 1691572410000
        },
        "end_time": {
          "description": "调度计划结束时间,毫秒级别的时间戳",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 4828176000000,
          "example": 1691572410000
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 16,
          "description": "调度计划优先级。",
          "example": 8
        },
        "daily": {
          "$ref": "#/definitions/DailyDto"
        },
        "tasks": {
          "type": "array",
          "description": "调度任务信息",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/ScheduleTask"
          }
        }
      }
    }
  },
