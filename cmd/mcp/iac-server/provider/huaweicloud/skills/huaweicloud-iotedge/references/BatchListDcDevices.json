{
  "name": "BatchListDcDevices",
  "summary": "查数采连接子设备列表",
  "tags": "边缘数据源点位配置管理",
  "productshort": "IoTEdge",
  "region_id": "cn-east-3",
  "paths": {
    "/{project_id}/edge-nodes/{edge_node_id}/ots/data-sources/{ds_id}/devices": {
      "get": {
        "tags": [
          "EdgeDcPointManagement"
        ],
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-requestHandler": true,
        "summary": "查数采连接子设备列表",
        "description": "查询数采连接下子设备列表",
        "operationId": "BatchListDcDevices",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-externalAPI": true,
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/edge_node_id"
          },
          {
            "$ref": "#/parameters/ds_id"
          },
          {
            "name": "device_id",
            "in": "query",
            "required": false,
            "description": "设备标识码。",
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9-_]*$",
            "x-example": "MotorVoltage"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询的起始位置,取值范围为非负整数,默认为0",
            "required": false,
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 1000000,
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页记录数,默认值为10,取值区间为1-1000",
            "required": false,
            "type": "integer",
            "default": 10,
            "minimum": 0,
            "maximum": 1000000,
            "format": "int32"
          }
        ],
        "x-returnType": "ResponseEntity<QueryDcDevicesPageDTO>",
        "responses": {
          "200": {
            "description": "OK",
            "x-SuccessCode": true,
            "examples": {
              "count": 1000000,
              "page_info": {
                "offset": 1000000,
                "limit": 1000
              },
              "devices": [
                {
                  "device_id": "MotorVoltage"
                }
              ]
            },
            "schema": {
              "$ref": "#/definitions/QueryDcDevicesPageDTO"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "definitions": {
    "PageInfoDTO": {
      "title": "分页列表响应结构体",
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "maximum": 1000000,
          "minimum": 0,
          "description": "页码"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "maximum": 1000,
          "minimum": 1,
          "description": "每页记录数"
        }
      }
    },
    "QueryDcDeviceRespDTO": {
      "title": "查询数采设备响应结构体",
      "description": "查询数采设备响应结构体",
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$",
          "description": "设备id",
          "example": "MotorVoltage"
        }
      }
    },
    "QueryDcDevicesPageDTO": {
      "title": "查询数采连接下设备列表响应结构体",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1000000,
          "description": "总记录数"
        },
        "page_info": {
          "description": "分页信息",
          "$ref": "#/definitions/PageInfoDTO"
        },
        "devices": {
          "type": "array",
          "description": "每页记录数",
          "minItems": 0,
          "maxItems": 1000000,
          "items": {
            "$ref": "#/definitions/QueryDcDeviceRespDTO"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ds_id": {
      "name": "ds_id",
      "in": "path",
      "description": "采集数据源id,创建数据源配置时设置,节点下唯一。",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9-_]*$",
      "x-example": "opc"
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "edge_node_id": {
      "name": "edge_node_id",
      "in": "path",
      "description": "边缘节点ID",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]*$",
      "x-example": "446007715895193600"
    }
  },
  "host": "iotedge-api.cn-east-3.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
  "uri": null
}