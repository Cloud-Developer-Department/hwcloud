{
  "name": "ListEdgeNodes",
  "summary": "查询边缘节点列表",
  "tags": "节点管理",
  "productshort": "IoTEdge",
  "region_id": "cn-north-4",
  "paths": {
    "/{project_id}/edge-nodes": {
      "get": {
        "tags": [
          "BasicNode"
        ],
        "summary": "查询边缘节点列表",
        "description": "查询边缘节点列表",
        "operationId": "ListEdgeNodes",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-externalAPI": true,
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "name": "name",
            "in": "query",
            "description": "节点名称",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9_\\-\\一-\\龥]*$"
          },
          {
            "name": "state",
            "in": "query",
            "description": "节点状态,OFFLINE|ONLINE|UNINSTALLED|INSTALLED|DELETING|UPGRADING",
            "required": false,
            "type": "string",
            "pattern": "(OFFLINE|ONLINE|UNINSTALLED|INSTALLED|DELETING|UPGRADING)",
            "minLength": 1,
            "maxLength": 32
          },
          {
            "name": "type",
            "in": "query",
            "description": "节点所属资源类型,advanced|standard",
            "required": false,
            "type": "string",
            "pattern": "(advanced|standard)",
            "minLength": 1,
            "maxLength": 32
          },
          {
            "name": "instance_id",
            "in": "query",
            "description": "实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。",
            "required": false,
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "minLength": 1,
            "maxLength": 36
          },
          {
            "name": "space_id",
            "in": "query",
            "description": "资源空间ID。此参数为非必选参数,存在多资源空间的用户需要使用该接口时,可以携带该参数查询指定资源空间下的设备列表,不携带该参数则会查询该用户下所有设备列表。",
            "required": false,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,36}$",
            "minLength": 1,
            "maxLength": 36
          },
          {
            "name": "node_ids",
            "in": "query",
            "description": "节点id列表,查询ID在给的节点ID列表内的节点信息",
            "required": false,
            "type": "array",
            "minItems": 0,
            "maxItems": 1000,
            "x-example": "[111,222,333]",
            "items": {
              "pattern": "^[a-zA-Z0-9_-]{1,36}$",
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询的起始位置,取值范围为非负整数,默认为0",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "minimum": 0,
            "maximum": 1000000
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页记录数,默认值为10,取值区间为1-1000",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 10,
            "minimum": 1,
            "maximum": 1000
          }
        ],
        "x-returnType": "ResponseEntity<QueryNodePageDTO>",
        "responses": {
          "200": {
            "description": "Ok",
            "x-SuccessCode": true,
            "examples": {
              "application/json": {
                "count": 1000000,
                "page_info": {
                  "offset": 1000000,
                  "limit": 1000
                },
                "nodes": [
                  {
                    "edge_node_id": "string",
                    "name": "string",
                    "state": "string",
                    "instance_id": "string",
                    "space_id": "jeQDJQZltU8iKgFFoW060F5SGZka",
                    "type": "string",
                    "resource_ids": [
                      "iotedge.campus.1000tps.10000device"
                    ],
                    "resource_spec_types": [
                      "iotedge.campus.1000tps.10000device"
                    ],
                    "ips": [
                      "string"
                    ],
                    "create_time": "2020-05-28T11:31:29.740Z"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryNodePageDTO"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "definitions": {
    "PageInfoDTO": {
      "title": "分页列表响应结构体",
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "maximum": 1000000,
          "minimum": 0,
          "description": "页码"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "maximum": 1000,
          "minimum": 1,
          "description": "每页记录数"
        }
      }
    },
    "EdgeNodeDTO": {
      "type": "object",
      "description": "查询边缘节点列表响应体",
      "properties": {
        "edge_node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]*$",
          "description": "边缘节点ID"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-\\一-\\龥]*$",
          "description": "边缘节点名称"
        },
        "state": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "description": "边缘节点状态UNINSTALLED|INSTALLED|OFFLINE|ONLINE|DELETING|FROZEN"
        },
        "instance_id": {
          "type": "string",
          "description": "实例ID。物理多租下各实例的唯一标识,一般华为云租户无需携带该参数,仅在物理多租场景下从管理面访问API时需要携带该参数。",
          "pattern": "^[a-f0-9-]{1,36}$",
          "minLength": 1,
          "maxLength": 36,
          "x-example": "1a7ffc5c-d89c-44dd-8265-b1653d951ce0"
        },
        "space_id": {
          "description": "资源空间id,对应IOTDA云服务接口参数中的app_id。",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64,
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka"
        },
        "type": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "description": "节点所属资源类型:advanced|standard"
        },
        "resource_ids": {
          "type": "array",
          "description": "节点所购买的资源类型的列表",
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 16,
            "example": "iotedge.campus.1000tps.10000device"
          }
        },
        "resource_spec_types": {
          "type": "array",
          "description": "节点所购买的资源类型的列表",
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 16,
            "example": "iotedge.campus.1000tps.10000device"
          }
        },
        "ips": {
          "type": "array",
          "maxItems": 10,
          "minItems": 0,
          "items": {
            "type": "string"
          },
          "description": "边缘节点ip列表"
        },
        "create_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "边缘节点创建时间",
          "example": "2020-05-28T11:31:29.740Z"
        }
      }
    },
    "QueryNodePageDTO": {
      "type": "object",
      "description": "边缘节点列表结构体",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1000000,
          "description": "总记录数"
        },
        "page_info": {
          "description": "分页信息",
          "$ref": "#/definitions/PageInfoDTO"
        },
        "nodes": {
          "type": "array",
          "maxItems": 1000,
          "minItems": 0,
          "description": "节点列表",
          "items": {
            "$ref": "#/definitions/EdgeNodeDTO"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    }
  },
  "host": "iotedge-api.cn-north-4.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
  "uri": null
}