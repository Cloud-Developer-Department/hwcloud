{
  "name": "CreateAppVersion",
  "summary": "创建应用版本",
  "tags": "边缘应用模板版本管理",
  "productshort": "IoTEdge",
  "region_id": "cn-north-4",
  "paths": {
    "/{project_id}/apps/{app_id}/versions": {
      "post": {
        "operationId": "CreateAppVersion",
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity",
        "tags": [
          "AppVersion"
        ],
        "summary": "创建应用版本",
        "description": "应用服务器可调用此接口为创建应用版本。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "app_id",
            "in": "path",
            "description": "应用ID",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9-_]*$"
          },
          {
            "name": "version",
            "in": "query",
            "description": "应用版本",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "[0-9]{1,9}\\.[0-9]{1,9}\\.[0-9]{1,9}"
          },
          {
            "name": "chart",
            "in": "formData",
            "required": true,
            "type": "file",
            "description": "chart包。当前仅支持tgz文件格式。"
          },
          {
            "name": "images",
            "in": "formData",
            "required": false,
            "type": "string",
            "description": "应用包含的镜像列表"
          }
        ],
        "x-returnType": "ResponseEntity<QueryAppVersionResponseDTO>",
        "responses": {
          "201": {
            "description": "Created",
            "x-SuccessCode": true,
            "examples": {
              "app_id": "string",
              "version": "string",
              "values": {},
              "create_time": "string",
              "update_time": "string"
            },
            "schema": {
              "$ref": "#/definitions/QueryAppVersionResponseDTO"
            }
          },
          "400": {
            "description": "BAD REQUEST",
            "x-Error": [
              "IoTEdge.014204"
            ]
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "FORBIDDEN",
            "x-Error": [
              "IoTEdge.014206"
            ]
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v3/{project_id}/apps/{app_id}/versions"
      }
    }
  },
  "definitions": {
    "QueryAppVersionResponseDTO": {
      "title": "应用模板简要信息",
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string",
          "description": "应用模板ID"
        },
        "version": {
          "type": "string",
          "description": "应用版本"
        },
        "values": {
          "type": "object",
          "description": "应用版本配置"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间"
        },
        "update_time": {
          "type": "string",
          "description": "最后一次修改时间"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    }
  },
  "host": "iotedge-api.cn-north-4.myhuaweicloud.com",
  "base_path": "/v3",
  "info_version": "v3",
  "method": "post",
  "uri": null
}