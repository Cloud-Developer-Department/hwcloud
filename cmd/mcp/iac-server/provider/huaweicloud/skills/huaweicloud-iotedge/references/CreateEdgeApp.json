  "definitions": {
    "QueryApplicationBriefResponseDTO": {
      "title": "查询应用结列表项构体",
      "type": "object",
      "properties": {
        "edge_app_id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "description": "应用id"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "应用描述"
        },
        "create_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "创建时间"
        },
        "update_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "最后一次修改时间"
        },
        "last_published_version": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "最新发布版本"
        },
        "app_type": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "应用类型SYSTEM_REQUIRED|SYSTEM_OPTIONAL|USER"
        },
        "function_type": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "应用类型DATA_PROCESSING|PROTOCOL_PARSING"
        },
        "deploy_type": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "部署类型docker|process"
        },
        "protocol": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "驱动协议类型OPCUA|Modbus-TCP"
        },
        "edge_app_name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 0,
          "description": "应用名称"
        }
      }
    },
    "CreateEdgeApplicationRequestDTO": {
      "title": "创建应用请求结构体",
      "type": "object",
      "required": [
        "edge_app_id"
      ],
      "properties": {
        "edge_app_id": {
          "type": "string",
          "description": "应用ID",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9-_]*$",
          "example": "test-app"
        },
        "edge_app_name": {
          "type": "string",
          "description": "应用名称",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-\\一-\\龥]*$",
          "example": "test-app"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_;:?!,;:、,.?!。\\-\\s\\一-\\龥]*$",
          "description": "应用描述",
          "example": "this is a test app"
        },
        "function_type": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "(DATA_PROCESSING|PROTOCOL_PARSING|ON_PREMISE_INTEGRATION|GATEWAY_MANAGER|COMPOSITE_APPLICATION|DATA_COLLECTION)",
          "description": "功能类型,分为数据处理(DATA_PROCESSING)、协议解析(PROTOCOL_PARSING)、IT集成(ON_PREMISE_INTEGRATION)和混合应用(COMPOSITE_APPLICATION),数据默认为DATA_PROCESSING,数据处理模块可以传输消息,协议解析为驱动类型,IT集成为部署南向3rdIA使用,混合应用可同时实现数据处理和协议解析。",
          "example": "DATA_PROCESSING",
          "enum": [
            "DATA_PROCESSING",
            "PROTOCOL_PARSING",
            "ON_PREMISE_INTEGRATION",
            "GATEWAY_MANAGER",
            "COMPOSITE_APPLICATION",
            "DATA_COLLECTION"
          ]
        },
        "protocol": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "pattern": "(OPCUA|Modbus-TCP|Modbus-RTU|IEC104|OPCDA|Http|JDBC|Other|ONVIF)",
          "description": "驱动协议类型OPCUA|Modbus-TCP"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    }
  },
  "host": "iotedge-api.cn-south-1.myhuaweicloud.com",
