  "definitions": {
    "CreateDcDsRespDTO": {
      "title": "创建数据源配置响应结构体",
      "description": "创建数据表请求结构体",
      "type": "object",
      "x-imports": "java.util.Map;",
      "properties": {
        "ds_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-_]*$",
          "description": "采集数据源id,节点下唯一",
          "minLength": 1,
          "maxLength": 64,
          "example": "opcua_1"
        },
        "config": {
          "type": "object",
          "description": "数据源的连接及采集信息",
          "example": {
            "connection_info": {
              "endpoint": "opc.tcp://127.0.0.1:53530/OPCUA",
              "username": "admin",
              "password": "*****"
            },
            "collection_paras": {
              "default_cycle": 1000
            }
          }
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-\\一-\\龥]*$",
          "description": "采集数据源名称,允许中、数字、英文大小写、下划线、中划线",
          "minLength": 1,
          "maxLength": 64,
          "example": "电力子系统"
        },
        "edge_node_id": {
          "type": "string",
          "description": "边缘节点id",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64,
          "example": 446007715895193600
        },
        "module_id": {
          "type": "string",
          "description": "模块id",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64,
          "example": "user_opc_ua_yz"
        },
        "tpl_id": {
          "type": "string",
          "description": "模板id,节点下唯一",
          "pattern": "^[A-Za-z0-9-_]*$",
          "minLength": 1,
          "maxLength": 64,
          "example": "sys_general_opcua"
        },
        "quality_report": {
          "type": "boolean",
          "description": "质量上报开关,不携带或值不为true,默认为false",
          "example": false
        },
        "edge_app_name": {
          "type": "string",
          "description": "应用ID",
          "minLength": 0,
          "maxLength": 64,
          "example": "西门子OPCUA驱动"
        },
        "connection_info": {
          "type": "object",
          "description": "数采连接信息"
        },
        "module_state": {
          "type": "string",
          "description": "数采连接状态,stopped|running",
          "minLength": 1,
          "maxLength": 32,
          "example": "stopped"
        },
        "count": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1000000,
          "description": "数采连接下点位数"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间",
          "example": "2020-05-28T11:31:29.740Z",
          "minLength": 0,
          "maxLength": 256
        },
        "update_time": {
          "type": "string",
          "description": "最后一次修改时间",
          "example": "2020-05-28T11:31:29.740Z",
          "minLength": 0,
          "maxLength": 256
        },
        "synchronized": {
          "type": "boolean",
          "description": "数采配置是否已同步,已同步:true,未同步:false",
          "example": true
        },
        "synchronized_time": {
          "type": "string",
          "description": "数采配置同步时间",
          "example": "2020-05-28T11:31:29.740Z",
          "minLength": 0,
          "maxLength": 256
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ds_id": {
      "name": "ds_id",
      "in": "path",
      "description": "采集数据源id,创建数据源配置时设置,节点下唯一。",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9-_]*$",
      "x-example": "opc"
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "edge_node_id": {
      "name": "edge_node_id",
      "in": "path",
      "description": "边缘节点ID",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]*$",
      "x-example": "446007715895193600"
    }
  },
  "host": "iotedge-api.cn-east-3.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
  "uri": null
