{
  "name": "ListExternalEntity",
  "summary": "查询指定边缘节点下的外部实体",
  "tags": "外部实体管理",
  "productshort": "IoTEdge",
  "region_id": "cn-south-1",
  "paths": {
    "/{project_id}/edge-nodes/{edge_node_id}/externals": {
      "get": {
        "tags": [
          "EdgeExternals"
        ],
        "summary": "查询指定边缘节点下的外部实体",
        "description": "用户在指定边缘节点上查询外部实体列表",
        "operationId": "ListExternalEntity",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/edge_node_id"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询的起始位置,取值范围为非负整数,默认为0",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "minimum": 0,
            "maximum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页记录数,取值范围为非负整数,默认值为10",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 10,
            "minimum": 10,
            "maximum": 10
          }
        ],
        "x-returnType": "ResponseEntity<QueryExternalEntitysDTO>",
        "responses": {
          "200": {
            "description": "Ok",
            "x-SuccessCode": true,
            "examples": {
              "application/json": {
                "externals": [
                  {
                    "node_id": "string",
                    "space_id": "jeQDJQZltU8iKgFFoW060F5SGZka",
                    "external_id": "string",
                    "protocol": "string",
                    "connection_type": "string",
                    "create_time": "string",
                    "last_modify_time": "string"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryExternalEntitysDTO"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "definitions": {
    "ExternalEntityRespDTO": {
      "title": "外部应用信息返回结构体",
      "description": "创建外部实体后返回的信息结构体",
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "description": "节点ID",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "space_id": {
          "description": "资源空间ID。此参数为非必选参数,存在多资源空间的用户需要使用该接口时,建议携带该参数指定创建的外部实体归属到IoDA哪个资源空间下的边缘节点设备下,否则创建的外部实体将会归属到默认资源空间下对应的边缘节点下,对应于IoDA的app_id.",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 36,
          "example": "jeQDJQZltU8iKgFFoW060F5SGZka"
        },
        "external_id": {
          "type": "string",
          "description": "外部实体ID",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "protocol": {
          "type": "string",
          "description": "接入协议类型",
          "pattern": "(MQTT|HTTP)"
        },
        "connection_type": {
          "type": "string",
          "description": "连接类型(client和server)",
          "pattern": "(CLIENT|SERVER)"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间",
          "minLength": 0,
          "maxLength": 256
        },
        "last_modify_time": {
          "type": "string",
          "description": "最后修改时间",
          "minLength": 0,
          "maxLength": 256
        }
      }
    },
    "QueryExternalEntitysDTO": {
      "title": "查询外部实体列表响应结构体",
      "type": "object",
      "properties": {
        "externals": {
          "type": "array",
          "maxItems": 10,
          "minItems": 0,
          "description": "外部实体列表",
          "items": {
            "$ref": "#/definitions/ExternalEntityRespDTO"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "edge_node_id": {
      "name": "edge_node_id",
      "in": "path",
      "description": "边缘节点ID",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]*$",
      "x-example": "446007715895193600"
    }
  },
  "host": "iotedge-api.cn-south-1.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
  "uri": null
}