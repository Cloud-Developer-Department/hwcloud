{
  "name": "CreateCluster",
  "summary": "创建边缘集群",
  "tags": "边缘集群管理",
  "productshort": "IoTEdge",
  "region_id": "cn-south-1",
  "paths": {
    "/{project_id}/clusters": {
      "post": {
        "operationId": "CreateCluster",
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/{project_id}/clusters",
        "x-request-examples-1": {
          "cluster_name": "test-cluster",
          "description": "this is a test cluster",
          "cluster_node_config": {
            "master_node_vip": "string",
            "master_nodes": [
              {
                "node_ip": "string",
                "node_name": "string"
              }
            ],
            "work_nodes": [
              {
                "node_ip": "string",
                "node_name": "string"
              }
            ]
          }
        },
        "tags": [
          "Cluster"
        ],
        "summary": "创建边缘集群",
        "description": "应用服务器可调用此接口为创建边缘集群。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-iftype": "OpenAPI_new",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "CreateClusterRequestBody",
            "in": "body",
            "description": "创建边缘集群请求结构体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateClusterRequestDTO"
            }
          }
        ],
        "x-returnType": "ResponseEntity<QueryClusterBriefResponseDTO>",
        "responses": {
          "201": {
            "description": "Created",
            "x-SuccessCode": true,
            "examples": {
              "application/json": {
                "cluster_id": "123343534",
                "cluster_name": "test-cluster",
                "description": "this is a test cluster",
                "version": "0.1.1",
                "state": "string",
                "create_time": "string",
                "update_time": "string",
                "is_upgradeable": true
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryClusterBriefResponseDTO"
            }
          },
          "400": {
            "description": "BAD REQUEST",
            "x-Error": [
              "IoTEdge.014204"
            ]
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "FORBIDDEN",
            "x-Error": [
              "IoTEdge.014206"
            ]
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "definitions": {
    "QueryClusterBriefResponseDTO": {
      "title": "边缘集群简略信息",
      "type": "object",
      "properties": {
        "cluster_id": {
          "type": "string",
          "description": "集群ID",
          "example": "123343534"
        },
        "cluster_name": {
          "type": "string",
          "description": "集群名称",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9-_]*$",
          "example": "test-cluster"
        },
        "description": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_;:?!,;:、,.?!。\\-\\s\\一-\\龥]*$",
          "description": "集群描述",
          "example": "this is a test cluster"
        },
        "version": {
          "type": "string",
          "description": "边缘集群版本"
        },
        "state": {
          "type": "string",
          "description": "边缘集群状态"
        },
        "create_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "创建时间"
        },
        "update_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "最后一次修改时间"
        },
        "is_upgradeable": {
          "type": "boolean",
          "description": "是否可升级"
        }
      }
    },
    "ClusterNodeConfig": {
      "type": "object",
      "description": "集群节点配置",
      "properties": {
        "master_node_vip": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^((25[0-5])|(2[0-4]\\d)|(1\\d\\d)|([1-9]\\d)|\\d)(\\.((25[0-5])|(2[0-4]\\d)|(1\\d\\d)|([1-9]\\d)|\\d)){3}$",
          "description": "master虚拟ip"
        },
        "master_nodes": {
          "type": "array",
          "maxItems": 50,
          "description": "master节点数",
          "x-type": "List<@NotNull NodeConfig>",
          "items": {
            "$ref": "#/definitions/NodeConfig"
          }
        },
        "work_nodes": {
          "type": "array",
          "maxItems": 150,
          "description": "work节点数",
          "x-type": "List<@NotNull NodeConfig>",
          "items": {
            "$ref": "#/definitions/NodeConfig"
          }
        }
      }
    },
    "NodeConfig": {
      "type": "object",
      "description": "集群节点信息",
      "properties": {
        "node_ip": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^((25[0-5])|(2[0-4]\\d)|(1\\d\\d)|([1-9]\\d)|\\d)(\\.((25[0-5])|(2[0-4]\\d)|(1\\d\\d)|([1-9]\\d)|\\d)){3}$",
          "description": "节点IP"
        },
        "node_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9-_.]*$",
          "description": "节点名称"
        }
      }
    },
    "CreateClusterRequestDTO": {
      "title": "创建边缘集群请求结构体",
      "type": "object",
      "required": [
        "cluster_name"
      ],
      "properties": {
        "cluster_name": {
          "type": "string",
          "description": "集群名称",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9-_]*$",
          "example": "test-cluster"
        },
        "description": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_;:?!,;:、,.?!。\\-\\s\\一-\\龥]*$",
          "description": "集群描述",
          "example": "this is a test cluster"
        },
        "cluster_node_config": {
          "description": "集群节点配置",
          "$ref": "#/definitions/ClusterNodeConfig"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    }
  },
  "host": "iotedge-api.cn-south-1.myhuaweicloud.com",
  "base_path": "/v3",
  "info_version": "v3",
  "method": "post",
  "uri": null
}