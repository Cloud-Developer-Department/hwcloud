{
  "name": "ListAppImage",
  "summary": "查询应用版本包含的镜像列表",
  "tags": "边缘应用模板版本管理",
  "productshort": "IoTEdge",
  "region_id": "cn-north-4",
  "paths": {
    "/{project_id}/apps/{app_id}/versions/{version}/images": {
      "get": {
        "operationId": "ListAppImage",
        "x-imports": "org.springframework.web.bind.annotation.ModelAttribute;javax.validation.Valid;org.springframework.http.ResponseEntity",
        "tags": [
          "AppVersion"
        ],
        "summary": "查询应用版本包含的镜像列表",
        "description": "应用服务器可调用此接口查询应用版本包含的镜像列表。",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "app_id",
            "in": "path",
            "description": "应用ID",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9-_]*$"
          },
          {
            "name": "version",
            "in": "path",
            "description": "应用版本",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "[0-9]{1,9}\\.[0-9]{1,9}\\.[0-9]{1,9}"
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 1000,
            "default": 10,
            "description": "每页记录数,默认值为10,取值区间为1-1000。"
          },
          {
            "in": "query",
            "name": "offset",
            "description": "查询的起始位置,取值范围为非负整数,默认为0。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 1000000,
            "minimum": 0
          }
        ],
        "x-returnType": "ResponseEntity<QueryAppImagePageDTO>",
        "responses": {
          "200": {
            "description": "OK",
            "x-SuccessCode": true,
            "examples": {
              "count": 1000000,
              "page_info": {
                "offset": 1000000,
                "limit": 1000
              },
              "app_images": [
                {
                  "image_namespace": "iot",
                  "name": "edge_manager",
                  "tag": "1.0.0",
                  "digest": "sha256:38f3f34301cec3cabd9de3f65f2b313ed7e44d6b211254e7156d12229c5b459f",
                  "create_time": "string"
                }
              ]
            },
            "schema": {
              "$ref": "#/definitions/QueryAppImagePageDTO"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v3/{project_id}/apps/{app_id}/versions/{version}/images"
      }
    }
  },
  "definitions": {
    "QueryAppImagePageDTO": {
      "title": "查询应用镜像列表响应结构体",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "总记录数",
          "minimum": 0,
          "maximum": 1000000
        },
        "page_info": {
          "description": "分页信息",
          "$ref": "#/definitions/PageInfoDTO"
        },
        "app_images": {
          "type": "array",
          "description": "每页记录数",
          "minItems": 0,
          "maxItems": 1000000,
          "items": {
            "$ref": "#/definitions/QueryAppImageResponseDTO"
          }
        }
      }
    },
    "QueryAppImageResponseDTO": {
      "type": "object",
      "title": "应用镜像列表信息",
      "description": "应用镜像列表信息",
      "properties": {
        "image_namespace": {
          "type": "string",
          "example": "iot",
          "description": "镜像组织"
        },
        "name": {
          "type": "string",
          "example": "edge_manager",
          "description": "镜像仓库名称"
        },
        "tag": {
          "type": "string",
          "example": "1.0.0",
          "description": "镜像tag"
        },
        "digest": {
          "type": "string",
          "description": "镜像摘要",
          "example": "sha256:38f3f34301cec3cabd9de3f65f2b313ed7e44d6b211254e7156d12229c5b459f"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间"
        }
      }
    },
    "PageInfoDTO": {
      "title": "分页列表响应结构体",
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "maximum": 1000000,
          "minimum": 0,
          "description": "页码"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "maximum": 1000,
          "minimum": 1,
          "description": "每页记录数"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    }
  },
  "host": "iotedge-api.cn-north-4.myhuaweicloud.com",
  "base_path": "/v3",
  "info_version": "v3",
  "method": "get",
  "uri": null
}