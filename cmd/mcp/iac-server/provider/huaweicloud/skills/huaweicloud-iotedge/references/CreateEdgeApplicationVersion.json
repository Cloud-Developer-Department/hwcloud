    "ProbeDTO": {
      "title": "探测结构体",
      "type": "object",
      "required": [
        "initial_delay_seconds",
        "timeout_seconds"
      ],
      "properties": {
        "exec_command": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_;:?!,;:、,.?!。/\\-\\s\\一-\\龥]*$",
          "description": "执行探测的命令行命令",
          "minLength": 0,
          "maxLength": 256
