        },
        "http_get": {
          "description": "执行http探测",
          "$ref": "#/definitions/HttpGetDTO"
        },
        "initial_delay_seconds": {
          "type": "integer",
          "format": "int32",
          "maximum": 3600,
          "minimum": 0,
          "description": "表示从工作负载启动后从多久开始探测"
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "int32",
          "maximum": 3600,
          "minimum": 1,
          "description": "表示探测超时时间"
        },
        "period_seconds": {
          "type": "integer",
          "format": "int32",
          "maximum": 3600,
          "minimum": 5,
          "default": 30,
          "description": "检查周期"
        },
        "failure_threshold": {
          "type": "integer",
          "format": "int32",
          "default": 3,
          "maximum": 3600,
          "minimum": 1,
          "description": "失败多少次算不健康"
        }
