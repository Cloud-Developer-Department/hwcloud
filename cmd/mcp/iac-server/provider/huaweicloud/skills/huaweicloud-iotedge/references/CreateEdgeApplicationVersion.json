        },
        "source": {
          "type": "string",
          "pattern": "^/([a-zA-Z_0-9-]+/?)+$",
          "description": "源路径"
        },
        "destination": {
          "type": "string",
          "pattern": "^/*(?!boot/|dev/|etc/|lib/|pro/|sys/)([a-zA-Z_0-9-]+/?)+$",
          "description": "卷挂载路径"
        },
        "read_only": {
          "type": "boolean",
          "description": "只读,默认只读"
        }
      }
    },
    "ContainerConfigsDTO": {
      "title": "容器特殊配置结构体",
      "type": "object",
      "required": [
        "restart_policy"
      ],
      "properties": {
        "privileged": {
          "type": "boolean",
          "description": "开启容器特权模式",
          "default": false
        },
        "host_network": {
          "type": "boolean",
          "description": "是否使用主机网络模式",
          "default": true
        },
        "restart_policy": {
          "type": "string",
          "description": "重启策略,容器执行健康检查后失败后的策略",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "Always|OnFailure|Never"
        },
        "container_port_list": {
          "type": "array",
          "description": "容器端口映射值",
          "minItems": 0,
          "maxItems": 1000000,
          "items": {
            "$ref": "#/definitions/ContainerPortDTO"
          }
        }
      }
    },
    "HttpGetDTO": {
      "title": "执行http探测",
      "type": "object",
      "required": [
        "path",
        "scheme",
        "port"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/(\\w+/?)+$",
          "description": "请求路径",
          "minLength": 2,
          "maxLength": 64
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "maximum": 65535,
          "minimum": 1,
          "description": "端口"
        },
        "host": {
          "type": "string",
          "pattern": "^((https?:\\/\\/)?(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()!@:%_\\+.~#?&\\/\\/=]*))*$",
          "description": "主机地址",
          "minLength": 0,
          "maxLength": 64
        },
        "scheme": {
          "type": "string",
          "description": "协议类型",
          "minLength": 1,
          "maxLength": 64,
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        }
      }
    }
  },
