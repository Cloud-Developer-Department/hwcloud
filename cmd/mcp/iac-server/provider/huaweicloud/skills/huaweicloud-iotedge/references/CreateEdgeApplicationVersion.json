          "description": "容器特殊参数",
          "$ref": "#/definitions/ContainerConfigsDTO"
        },
        "image_url": {
          "type": "string",
          "description": "镜像存储地址",
          "minLength": 1,
          "maxLength": 1000000,
          "pattern": "[-A-Za-z0-9+&@#/%?=~_|!:,.;]+[-A-Za-z0-9+&@#/%=~_|]"
        },
        "envs": {
          "type": "object",
          "x-type": "Map<@Pattern(regexp = \"^[_a-zA-Z][_a-zA-Z0-9]*$\")String, @Pattern(regexp = \"^[a-zA-Z0-9_;:?!,;:、,.+=?!@>。/\\\\-\\\\s\\一-\\龥]*$\")String>",
          "description": "环境变量"
        },
        "volumes": {
          "type": "array",
          "description": "卷配置",
          "minItems": 0,
          "maxItems": 1000000,
          "items": {
            "$ref": "#/definitions/VolumeDTO"
          }
        },
        "npu_type": {
          "type": "string",
          "pattern": "(D310|D310P|D910)",
          "description": "NPU类型, D310:昇腾310推理卡,D910:昇腾910训练卡;D310P:昇腾710或者310P加速卡",
          "minLength": 0,
          "maxLength": 16,
          "enum": [
            "D310",
            "D910",
            "D310P"
          ]
        },
        "vnpu_template": {
          "type": "string",
          "pattern": "(vir01|vir02|vir04|vir08|vir02_1c|vir04_3c|vir04_3c_ndvpp|vir04_4c_dvpp)",
          "minLength": 0,
          "maxLength": 32,
          "description": "NPU算力切分模板,昇腾D310Pro,支持:vir01、vir02、vir02_1c、vir04、vir04_4c_dvpp、vir04_3c、vir04_3c_ndvpp 昇腾D910芯片支持:vir01|vir02|vir04|vir08 可在对应芯片的机器上通过npu-smi info -t template-info命令查询其详细信息",
          "example": "vir01",
          "enum": [
            "vir01",
            "vir02",
            "vir04",
            "vir08",
            "vir02_1c",
            "vir04_3c",
            "vir04_3c_ndvpp",
            "vir04_4c_dvpp"
          ]
        },
        "resources": {
          "description": "资源配额",
          "$ref": "#/definitions/ResourceDTO"
        },
        "ext_devices": {
          "type": "array",
          "description": "外挂设备配置",
          "minItems": 0,
          "maxItems": 1000000,
          "items": {
            "$ref": "#/definitions/ExtDevice"
          }
