          },
          "404": {
            "description": "Not Found"
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v2/{project_id}/edge-nodes/{edge_node_id}/ots/data-sources/{ds_id}/points",
        "x-request-example-1": {
          "point_id": "MotorVoltage",
          "name": "马达电压",
          "data_type": "int",
          "collection_config": {
            "address": "ns=2;s=Root/Motor/Voltage",
            "data_type": "int",
            "cycle": 10000
          },
          "device_id": "MotorVoltage",
          "property": "Motor/Voltage",
          "processing_config": {
            "validity": {
              "min": 60,
              "max": 100
            },
            "stream_formula": "bit(0).bool()|string_to_double(-1.0)|string_to_int(0)",
            "scaling": {
              "ratio": 1,
              "base": 100,
