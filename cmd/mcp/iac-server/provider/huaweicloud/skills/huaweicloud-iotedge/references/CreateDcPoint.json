{
  "name": "CreateDcPoint",
  "summary": "创建点位表配置",
  "tags": "边缘数据源点位配置管理",
  "productshort": "IoTEdge",
  "region_id": "cn-south-1",
  "paths": {
    "/{project_id}/edge-nodes/{edge_node_id}/ots/data-sources/{ds_id}/points": {
      "post": {
        "tags": [
          "EdgeDcPointManagement"
        ],
        "x-imports": "org.springframework.http.ResponseEntity;",
        "x-requestHandler": true,
        "summary": "创建点位表配置",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-externalAPI": true,
        "description": "用户通过Console接口在指定边缘节点上点位表配置",
        "operationId": "CreateDcPoint",
