{
  "name": "BatchListModules",
  "summary": "查询边缘模块列表",
  "tags": "模块管理",
  "productshort": "IoTEdge",
  "region_id": "cn-east-3",
  "paths": {
    "/{project_id}/edge-nodes/{edge_node_id}/modules": {
      "get": {
        "tags": [
          "EdgeModuleManagement"
        ],
        "summary": "查询边缘模块列表",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "description": "用户通过Console接口查询指定边缘节点上边缘模块列表",
        "operationId": "BatchListModules",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/edge_node_id"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "查询的起始位置,取值范围为非负整数,默认为0",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 1000000,
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页记录数,默认值为10,取值区间为1-1000",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 10,
            "maximum": 1000,
            "minimum": 1
          },
          {
            "name": "app_type",
            "in": "query",
            "description": "应用类型",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "pattern": "(SYSTEM_OPTIONAL|USER|SYSTEM_REQUIRED)",
            "enum": [
              "SYSTEM_REQUIRED",
              "SYSTEM_OPTIONAL",
              "USER"
            ]
          },
          {
            "name": "function_type",
            "in": "query",
            "description": "功能类型",
            "required": false,
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "pattern": "(DATA_PROCESSING|PROTOCOL_PARSING|ON_PREMISE_INTEGRATION)",
            "enum": [
              "DATA_PROCESSING",
              "PROTOCOL_PARSING",
              "ON_PREMISE_INTEGRATION"
            ]
          }
        ],
        "x-returnType": "ResponseEntity<QueryEdgeModulePageDTO>",
        "responses": {
          "200": {
            "description": "OK",
            "x-SuccessCode": true,
            "examples": {
              "application/json": {
                "count": 1000000,
                "page_info": {
                  "offset": 1000000,
                  "limit": 1000
                },
                "modules": [
                  {
                    "edge_app_id": "test-app",
                    "app_version": "1.0.0",
                    "state": "PENDING",
                    "control_status": "0000000000000000",
                    "node_id": "test-node",
                    "module_name": "edge_module",
                    "module_id": "test-module-id",
                    "create_time": "2020-05-28T11:31:29.740Z",
                    "update_time": "2020-05-28T11:31:29.740Z",
                    "app_type": "SYSTEM_REQUIRED",
                    "function_type": "DATA_PROCESSING"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/QueryEdgeModulePageDTO"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "definitions": {
    "PageInfoDTO": {
      "title": "分页列表响应结构体",
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "maximum": 1000000,
          "minimum": 0,
          "description": "页码"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "maximum": 1000,
          "minimum": 1,
          "description": "每页记录数"
        }
      }
    },
    "QueryEdgeModulePageDTO": {
      "title": "查询模块列表响应结构体",
      "type": "object",
      "properties": {
        "count": {
          "minimum": 0,
          "maximum": 1000000,
          "type": "integer",
          "format": "int64",
          "description": "总记录数"
        },
        "page_info": {
          "description": "分页信息",
          "$ref": "#/definitions/PageInfoDTO"
        },
        "modules": {
          "type": "array",
          "maxItems": 1000,
          "minItems": 0,
          "description": "每页记录数",
          "items": {
            "$ref": "#/definitions/EdgeModuleDTO"
          }
        }
      }
    },
    "EdgeModuleDTO": {
      "title": "查询模块列表模块相关信息",
      "description": "查询模块列表模块相关信息",
      "type": "object",
      "properties": {
        "edge_app_id": {
          "type": "string",
          "description": "应用ID",
          "example": "test-app",
          "minLength": 0,
          "maxLength": 64
        },
        "app_version": {
          "type": "string",
          "description": "应用版本",
          "example": "1.0.0",
          "minLength": 0,
          "maxLength": 64
        },
        "state": {
          "type": "string",
          "description": "模块运行状态",
          "enum": [
            "PENDING",
            "PENDING_DELETE",
            "DELETE_FAILED",
            "RUNNING",
            "FAILED",
            "SUCCEEDED",
            "UNKNOWN",
            "DELETE_SUCCESS",
            "STOPPED"
          ]
        },
        "control_status": {
          "type": "string",
          "description": "模块管控状态",
          "example": "0000000000000000"
        },
        "node_id": {
          "type": "string",
          "description": "边缘节点(同deviceID)ID",
          "example": "test-node",
          "minLength": 0,
          "maxLength": 64
        },
        "module_name": {
          "type": "string",
          "description": "模块名称",
          "example": "edge_module",
          "minLength": 0,
          "maxLength": 256
        },
        "module_id": {
          "type": "string",
          "description": "模块ID",
          "example": "test-module-id",
          "minLength": 0,
          "maxLength": 64
        },
        "create_time": {
          "type": "string",
          "description": "创建时间",
          "example": "2020-05-28T11:31:29.740Z",
          "minLength": 0,
          "maxLength": 256
        },
        "update_time": {
          "type": "string",
          "description": "最后一次修改时间",
          "example": "2020-05-28T11:31:29.740Z",
          "minLength": 0,
          "maxLength": 256
        },
        "app_type": {
          "type": "string",
          "description": "应用类型",
          "enum": [
            "SYSTEM_REQUIRED",
            "SYSTEM_OPTIONAL",
            "USER"
          ]
        },
        "function_type": {
          "type": "string",
          "description": "功能类型",
          "enum": [
            "DATA_PROCESSING",
            "PROTOCOL_PARSING",
            "ON_PREMISE_INTEGRATION",
            "GATEWAY_MANAGER",
            "COMPOSITE_APPLICATION",
            "DATA_COLLECTION"
          ]
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID。获取方法请参见 [获取项目ID](x-wc://file=zh-cn_topic_0225049489.xml)。",
      "required": true,
      "type": "string",
      "pattern": "^[a-fA-F0-9]{1,32}$",
      "minLength": 1,
      "maxLength": 64,
      "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。通过调用IAM服务 [获取IAM用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取,接口返回的响应消息头中“X-Subject-Token”就是需要获取的用户Token。简要的获取方法样例请参见 [Token认证](https://support.huaweicloud.com/api-iothub/iot_06_v5_0091.html#section0)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "minLength": 0,
      "maxLength": 20000
    },
    "edge_node_id": {
      "name": "edge_node_id",
      "in": "path",
      "description": "边缘节点ID",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]*$",
      "x-example": "446007715895193600"
    }
  },
  "host": "iotedge-api.cn-east-3.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
  "uri": null
}