          "minLength": 1,
          "maxLength": 64,
          "example": "电力子系统"
        },
        "edge_node_id": {
          "type": "string",
          "description": "边缘节点id",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64,
          "example": 446007715895193600
