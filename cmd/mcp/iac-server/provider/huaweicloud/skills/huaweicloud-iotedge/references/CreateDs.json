        "module_id": {
          "type": "string",
          "description": "模块id",
          "pattern": "^[a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64,
          "example": "user_opc_ua_yz"
        },
        "tpl_id": {
          "type": "string",
          "description": "模板id,节点下唯一",
          "pattern": "^[A-Za-z0-9-_]*$",
          "minLength": 1,
          "maxLength": 64,
          "example": "sys_general_opcua"
        },
        "quality_report": {
          "type": "boolean",
          "description": "质量上报开关,不携带或值不为true,默认为false",
          "example": false
        },
        "edge_app_name": {
          "type": "string",
