      "description": "北向数据接收端点ID",
      "required": true,
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "(^[a-z0-9]([a-z0-9-])*[a-z0-9]$)|(^[a-z0-9]$)",
      "x-example": "abcdefg"
    }
  },
