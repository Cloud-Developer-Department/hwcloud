  "definitions": {
    "QueryNaResponseDTO": {
      "title": "创建及查询北向NA返回结构体",
      "description": "创建及查询北向NA返回结构体",
      "type": "object",
      "properties": {
        "na_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "(^[a-z0-9]([a-z0-9-])*[a-z0-9]$)|(^[a-z0-9]$)",
          "description": "NA系统ID,提供给其他系统访问的唯一标识",
          "example": "na1"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "NA系统名称",
          "example": "北向系统1",
          "pattern": "^[a-zA-Z0-9_\\-\\一-\\龥]*$"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_;:?!,;:、,.?!\\-\\s\\一-\\龥]*$",
          "description": "北向NA系统描述",
          "example": "这是一个北向NA"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()!@:%_\\+.~#?&\\/\\/=]*)",
          "description": "访问URL地址",
          "example": "https://068b72f3b75444dda67cc6e2286a4c20.apic.cn-south-1.huaweicloudapis.com"
        },
        "auth_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "(AKSK)",
          "description": "鉴权方式",
          "example": "AKSK"
        },
        "access_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "(ROMA|APIG)",
          "description": "接入类型",
          "example": "ROMA"
        },
        "access_roma_info": {
          "type": "object",
          "description": "接入方式为ROMA的鉴权信息结构返回体",
          "$ref": "#/definitions/AccessRomaBriefInfo"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间",
          "minLength": 0,
          "maxLength": 256,
          "example": "2020-05-28T11:31:29.740Z"
        },
        "update_time": {
          "type": "string",
          "description": "更新时间",
          "minLength": 0,
          "maxLength": 256,
          "example": "2020-05-28T11:31:29.740Z"
        }
      }
    },
    "AccessRomaBriefInfo": {
      "title": "接入方式为ROMA的鉴权信息结构体",
      "type": "object",
      "properties": {
        "app_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "认证key,加密存储",
          "example": "ebf59208-4c6b-4b06-9b69-494e9df475a3"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
