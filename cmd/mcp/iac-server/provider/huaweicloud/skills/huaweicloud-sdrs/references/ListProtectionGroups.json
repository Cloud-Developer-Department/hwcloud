      "required": [
        "count",
        "server_groups"
      ],
      "properties": {
        "server_groups": {
          "type": "array",
          "description": "保护组的信息列表。",
          "items": {
            "$ref": "#/definitions/ShowProtectionGroupParams"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "此参数为满足过滤条件的列表中包含的保护组个数。"
        }
      },
      "description": "查询保护组列表响应体"
    }
  },
