        },
        "name": {
          "type": "string",
          "description": "保护组的名称。"
        },
        "description": {
          "type": "string",
          "description": "保护组的描述。"
        },
        "status": {
          "type": "string",
          "description": "保护组的状态。"
        },
        "progress": {
          "type": "integer",
          "format": "int32",
          "description": "保护组的同步进度。单位:百分比(%)。",
          "minimum": 0,
          "maximum": 100
        },
        "source_availability_zone": {
          "type": "string",
          "description": "保护组创建时的生产站点可用区名称。注意:保护组切换、故障切换后,该值不变。"
        },
        "target_availability_zone": {
          "type": "string",
          "description": "保护组创建时的容灾站点可用区名称。注意:保护组切换、故障切换后,该值不变。"
        },
        "domain_id": {
          "type": "string",
          "description": "双活域ID。"
        },
        "domain_name": {
          "type": "string",
          "description": "双活域名称。"
        },
        "priority_station": {
          "type": "string",
          "description": "用于标识保护组的当前生产站点。\nsource:表示当前生产站点可用区为source_availability_zone的值。\ntarget:表示当前生产站点可用区为target_availability_zone的值。"
        },
        "protected_instance_num": {
          "type": "integer",
          "format": "int32",
          "description": "该保护组中保护实例的个数。"
        },
        "replication_num": {
          "type": "integer",
          "format": "int32",
          "description": "该保护组中复制对的个数。"
        },
        "disaster_recovery_drill_num": {
          "type": "integer",
          "format": "int32",
          "description": "该保护组中容灾演练的个数。"
        },
        "protected_status": {
          "type": "string",
          "description": "保护状态。started:表示该保护组开始保护。stopped:表示该保护组停止保护。\n说明:系统近期进行了升级,对于升级后创建的保护组,该字段值为null,无实际意义。",
          "enum": [
            "started",
            "stopped"
          ]
        },
        "replication_status": {
          "type": "string",
          "description": "数据同步状态。\nactive:表示数据已同步完成。\ninactive:表示数据未同步。\ncopying:表示数据正在同步。\nactive-stopped:表示数据已停止同步。\n 说明:系统近期进行了升级,对于升级后创建的保护组,该字段值为null,无实际意义。",
          "enum": [
            "active",
            "inactive",
            "copying",
            "active-stopped"
          ]
        },
        "health_status": {
          "type": "string",
          "description": "健康状态。\nnormal:表示该保护组处于正常状态。\nabnormal:表示该保护组处于非正常状态。 \n说明:系统近期进行了升级,对于升级后创建的保护组,该字段值为null,无实际意义。",
          "enum": [
            "normal",
            "abnormal",
            "null"
          ]
        },
        "source_vpc_id": {
          "type": "string",
          "description": "生产站点虚拟私有云ID。"
        },
        "target_vpc_id": {
          "type": "string",
          "description": "容灾站点虚拟私有云ID。"
        },
        "test_vpc_id": {
          "type": "string",
          "description": "容灾演练虚拟私有云ID。(该参数暂未使用)"
        },
        "dr_type": {
          "type": "string",
          "description": "部署模式。默认值为“migration”,migration表示VPC内迁移。"
        },
        "created_at": {
          "type": "string",
          "description": "创建时间。默认格式为:\"yyyy-MM-dd'T'HH:mm:ss.SSSZ\",例:\"2019-04-01T12:00:00.000Z\"。",
          "x-huawei-extraAnnotation": ""
        },
        "updated_at": {
          "type": "string",
          "description": "更新时间。默认格式为:\"yyyy-MM-dd'T'HH:mm:ss.SSSZ\",例:\"2019-04-01T12:00:00.000Z\"。",
          "x-huawei-extraAnnotation": ""
        },
        "protection_type": {
          "type": "string",
          "description": "保护模式。\nreplication-pair:表示以复制对为单位进行数据同步。\nnull:表示将保护组中的所有复制对作为一个整体进行数据同步。\n 说明:当保护组中的所有复制对作为一个整体进行数据同步时,如果数据同步失败,保护组中的所有复制对都会受到影响。因此,SDRS服务对系统做了优化升级:\n对于升级后创建的资源,默认以复制对为单位进行数据同步,返回值为replication-pair;\n对于已有资源,仍以一个整体进行数据同步,返回值为null。",
          "enum": [
            "replication-pair",
            "null"
          ]
        },
        "replication_model": {
          "type": "string",
          "description": "复制类型。\n说明:预留参数,暂未启用。"
        },
        "server_type": {
          "type": "string",
          "description": "管理的服务器类型\nECS:表示管理的服务器类型为云服务器。",
          "x-huawei-extraAnnotation": ""
        }
      },
      "description": "查询保护组数据结构"
    },
    "UpdateProtectionGroupNameRequestParams": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "保护组的名称。\n最大支持长度为64个字节。\n只包含中文字符、英文字母(a~z、A~Z)、数字(0~9)、小数点(.)、下划线(_)、中划线(-)。",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "description": "更新保护组名称请求数据结构"
    },
