    "BatchCreateProtectedInstancesRequestParams": {
      "required": [
        "name_prefix",
        "server_group_id",
        "servers"
      ],
      "properties": {
        "name_prefix": {
          "type": "string",
          "description": "保护实例的名称前缀,批量创建保护实例时,为区分不同保护实例,创建过程中系统会自动在名称后加\"-0001\"的类似标记,故此时名称的长度为[1-59]个字符。只包含中文字符、英文字母(a~z、A~Z)、数字(0~9)、小数点(.)、下划线(_)、中划线(-)。",
          "minLength": 1,
          "maxLength": 59,
          "x-ctc": "N",
          "x-hc": "Y",
          "x-hk": "Y",
          "x-is_admin": "False",
          "x-is_inner_param": "False",
          "x-obc": "Y",
          "x-otc": "Y",
          "x-tlf": "N"
        },
        "description": {
          "type": "string",
          "description": "保护实例的描述,最大支持长度为64个字符。不能包含左尖括号(<)或右尖括号(>)。",
          "minLength": 1,
          "maxLength": 64
        },
        "server_group_id": {
          "type": "string",
          "description": "需要加入的保护组ID。"
        },
        "cluster_id": {
          "type": "string",
          "description": "专属分布式存储池ID。当容灾站点磁盘选择专属分布式存储时指定该字段。"
        },
        "primary_subnet_id": {
          "type": "string",
          "description": "容灾站点云服务器主网卡所在的子网subnetID,与neutron_network_id字段值一致。"
        },
        "tenancy": {
          "type": "string",
          "description": "在专属主机或共享池中创建容灾站点云服务器,默认为在共享池中创建。值为:shared或dedicated。shared:表示共享池。dedicated:表示专属主机。",
          "enum": [
            "shared",
            "dedicated"
          ],
          "default": "shared"
        },
        "dedicated_host_id": {
          "type": "string",
          "description": "专属主机id,此属性仅在tenancy值为dedicated时有效。若不指定此属性,系统将自动分配租户可以自动放置弹性云服务器的专属主机。"
        },
        "servers": {
          "type": "array",
