        "name": {
          "type": "string",
          "description": "复制对的名称。"
        },
        "description": {
          "type": "string",
          "description": "复制对的描述。"
        },
        "status": {
          "type": "string",
          "description": "复制对的状态。"
        },
        "volume_ids": {
          "type": "string",
          "description": "复制对使用的云硬盘ID。"
        },
        "attachment": {
          "type": "array",
