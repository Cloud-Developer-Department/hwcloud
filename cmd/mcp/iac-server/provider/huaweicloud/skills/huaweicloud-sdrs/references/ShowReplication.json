          "items": {
            "$ref": "#/definitions/ReplicationAttachment"
          }
        },
        "created_at": {
          "type": "string",
          "description": "创建时间。默认格式为:\"yyyy-MM-ddTHH:mm:ss.SSSZ\",例如:\"2019-04-01T12:00:00.000Z\"",
          "x-huawei-extraAnnotation": ""
        },
        "updated_at": {
          "type": "string",
          "description": "更新时间。默认格式为:\"yyyy-MM-ddTHH:mm:ss.SSSZ\",例如:\"2019-04-01T12:00:00.000Z\"",
          "x-huawei-extraAnnotation": ""
        },
        "replication_model": {
          "type": "string",
          "description": "复制对的复制类型。默认值为“hypermetro”,表示同步复制。"
        },
        "progress": {
          "type": "integer",
          "format": "int32",
          "description": "复制对的同步进度。单位:百分比(%)。"
        },
        "failure_detail": {
          "type": "string",
          "description": "仅在复制对的状态“status”为“error”时,返回的错误码。"
        },
        "record_metadata": {
          "description": "复制对的话单数据。",
          "$ref": "#/definitions/ReplicationRecordMetadata"
        },
        "fault_level": {
          "type": "string",
          "description": "复制对的故障等级。0:表示无故障。2:表示当前生产站点的云硬盘无读写数据权限,此时建议执行故障切换操作。5:表示复制链路已断,不能执行故障切换操作,需联系技术支持工程师。"
        },
        "server_group_id": {
          "type": "string",
          "description": "保护组的ID。"
        },
        "priority_station": {
          "type": "string",
          "description": "标识复制对所在保护组的当前生产站点可用区。source:表示当前生产站点可用区为保护组source_availability_zone的值。target:表示当前生产站点可用区为保护组target_availability_zone的值。"
        },
        "replication_status": {
          "type": "string",
          "description": "数据同步状态。active:表示数据已同步完成。inactive:表示数据未同步。copying:表示数据正在同步。active-stopped:表示数据已停止同步。",
          "enum": [
            "active",
            "inactive",
            "copying",
            "active-stopped"
          ]
        }
      },
      "description": "查询复制对数据结构"
    }
