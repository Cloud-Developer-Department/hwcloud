  "definitions": {
    "JobFailResponse": {
      "properties": {
        "error": {
          "description": "失败返回结构",
          "$ref": "#/definitions/ErrorInfo"
        }
      },
      "description": "Job失败返回"
    },
    "ErrorInfo": {
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "description": "错误信息"
        },
        "code": {
          "type": "string",
          "description": "错误码"
        }
      },
      "description": "失败返回信息"
    },
    "CreateProtectedInstanceRequestParams": {
      "required": [
        "name",
        "server_group_id",
        "server_id"
      ],
      "properties": {
        "server_group_id": {
          "type": "string",
          "description": "需要加入的保护组ID。"
        },
        "server_id": {
          "type": "string",
          "description": "指定的生产站点云服务器ID。"
        },
        "name": {
          "type": "string",
          "description": "指定保护实例的名称,最大支持长度为64个字节。只包含中文字符、英文字母(a~z、A~Z)、数字(0~9)、小数点(.)、下划线(_)、中划线(-)。",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "description": "指定保护实例的描述,最大支持长度为64个字节。不能包含左尖括号(<)或右尖括号(>)。",
          "minLength": 1,
          "maxLength": 64
        },
        "cluster_id": {
          "type": "string",
          "description": "专属分布式存储池ID。\n当容灾站点磁盘选择专属分布式存储时指定该字段。"
        },
        "primary_subnet_id": {
          "type": "string",
          "description": "容灾站点云服务器主网卡所在的子网subnetID,与neutron_network_id字段值一致。"
        },
        "primary_ip_address": {
          "type": "string",
          "description": "容灾站点云服务器主网卡IP地址。此参数仅在传入primary_subnet_id时有效。指定primary_subnet_id时,如果不指定该参数,将自动分配容灾站点云服务器主网卡IP地址。"
        },
        "tags": {
          "type": "array",
          "description": "标签列表。",
          "items": {
            "$ref": "#/definitions/ResourceTag"
          }
        },
        "flavorRef": {
          "type": "string",
          "description": "指定的容灾站点云服务器的flavor ID。\n查询flavor列表,请参见查询云服务器规格变更支持列表。\n 说明:不指定此参数时,容灾站点云服务器的flavor ID默认和生产站点云服务器保持一致。\n不同规格的云服务器在性能上存在差异,可能会对云服务器上运行的应用产生影响。为保证切换/故障切换后云服务器的性能,建议容灾站点服务器的规格(CPU、内存)不低于生产站点云服务器的规格(CPU、内存)。\n生产站点云服务器和容灾站点云服务器的flavor存在匹配关系,可以通过上述接口使用生产站点云服务器过滤出满足要求的容灾站点云服务器flavor。"
        },
        "tenancy": {
          "type": "string",
          "description": "在专属主机或共享池中创建容灾站点云服务器,默认为在共享池中创建。\n值为:shared或dedicated。shared:表示共享池。\ndedicated:表示专属主机。",
          "enum": [
            "shared",
            "dedicated"
          ],
          "default": "shared"
        },
        "dedicated_host_id": {
          "type": "string",
          "description": "专属主机id,此属性仅在tenancy值为dedicated时有效。\n若不指定此属性,系统将自动分配租户可以自动放置弹性云服务器的专属主机。"
        }
      },
      "description": "创建保护实例数据结构"
    },
    "JobSuccessResponse": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "成功返回jobId信息"
        }
      },
      "description": "Job成功返回"
    },
    "ResourceTag": {
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "键。同一资源的key值不能重复。最大长度为36个UNICODE字符。key不能为空,不允许为空字符串。不能包含以下字符:非打印字符ASCII(0-31)特殊字符“*”,“<”,“>”,“\\”,“=”,“,”,“|”,“/”键。不能为空。对于同一资源键值唯一。"
        },
        "value": {
          "type": "string",
          "description": "值。最大长度为43个UNICODE字符。value不能为空,可以为空字符串。不能包含以下字符:非打印字符ASCII(0-31)特殊字符“*”,“<”,“>”,“\\”,“=”,“,”,“|”,“/”。长度不超过43个字符。"
        }
      },
      "description": "单个标签资源结构"
    },
    "CreateProtectedInstanceRequestBody": {
      "required": [
        "protected_instance"
      ],
      "properties": {
        "protected_instance": {
          "description": "保护实例的信息。",
          "$ref": "#/definitions/CreateProtectedInstanceRequestParams"
        }
      },
      "description": "创建保护实例请求体"
    }
  },
