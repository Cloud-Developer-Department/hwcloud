{
  "name": "ListOrders",
  "summary": "查询订单列表",
  "tags": "查询订单",
  "productshort": "Marketplace",
  "region_id": "ap-southeast-3",
  "paths": {
    "/api/mkp-openapi-public/global/v1/query-orders": {
      "post": {
        "tags": [
          "查询订单"
        ],
        "summary": "查询订单列表",
        "description": "查询订单列表",
        "x-order": 1,
        "x-readOnly": true,
        "produces": [
          "application/json"
        ],
        "operationId": "ListOrders",
        "parameters": [
          {
            "name": "OrderListQueryReq",
            "in": "body",
            "required": true,
            "description": " 订单查询条件: start_time(开始时间), end_time(结束时间), offset(分页参数), limit(分页参数)",
            "schema": {
              "$ref": "#/definitions/OrderListQueryOpenApiReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "正常请求成功",
            "schema": {
              "$ref": "#/definitions/OrderListQueryOpenApiResp"
            }
          },
          "400": {
            "description": "请求参数有误"
          },
          "401": {
            "description": "权限不足"
          },
          "500": {
            "description": "服务器错误"
          }
        }
      }
    }
  },
  "definitions": {
    "OrderDataOpenApi": {
      "description": "订单列表数据",
      "properties": {
        "total_count": {
          "type": "integer",
          "description": "订单总数"
        },
        "orders": {
          "type": "array",
          "description": "订单列表",
          "items": {
            "$ref": "#/definitions/OrderInfoOpenApi"
          }
        }
      }
    },
    "OrderListQueryOpenApiResp": {
      "description": "查询订单列表出参",
      "properties": {
        "error_code": {
          "description": "返回码",
          "type": "string"
        },
        "error_msg": {
          "description": "返回描述",
          "type": "string"
        },
        "data": {
          "$ref": "#/definitions/OrderDataOpenApi"
        }
      }
    },
    "OrderListQueryOpenApiReq": {
      "description": "订单列表查询条件",
      "required": [
        "start_time"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "description": "开始时间",
          "minLength": 1,
          "maxLength": 64
        },
        "end_time": {
          "type": "string",
          "description": "结束时间",
          "minLength": 1,
          "maxLength": 64
        },
        "offset": {
          "type": "integer",
          "description": "分页参数,记录偏移量,从0开始",
          "maximum": 999999999,
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "description": "分页参数,分页大小,最大100",
          "maximum": 100,
          "minimum": 0
        }
      }
    },
    "OrderInfoOpenApi": {
      "description": "订单信息",
      "properties": {
        "order_id": {
          "type": "string",
          "description": "订单id"
        },
        "base_order_id": {
          "type": "string",
          "description": "父订单id"
        },
        "order_type": {
          "type": "integer",
          "description": "订单类型"
        },
        "status": {
          "type": "integer",
          "description": "订单状态"
        },
        "currency_after_discount": {
          "type": "number",
          "format": "double",
          "description": "订单优惠后金额"
        },
        "measure_id": {
          "type": "integer",
          "description": "订单金额度量单位"
        },
        "create_time": {
          "type": "string",
          "description": "订单创建时间"
        },
        "update_time": {
          "type": "string",
          "description": "更新时间"
        },
        "payment_time": {
          "type": "string",
          "description": "支付时间"
        },
        "service_types": {
          "type": "string",
          "description": "云服务类型"
        },
        "order_actual_amount": {
          "type": "number",
          "format": "double",
          "description": "订单实际支付金额,浮点数精度为:小数点后两位。"
        },
        "order_payable_amount": {
          "type": "number",
          "format": "double",
          "description": "订单应付金额,浮点数精度为:小数点后两位。"
        },
        "order_amount": {
          "type": "number",
          "format": "double",
          "description": "订单金额,浮点数精度为:小数点后两位。"
        },
        "customer_id": {
          "type": "string",
          "description": "客户id"
        },
        "customer_name": {
          "type": "string",
          "description": "客户账户名"
        },
        "channel_code": {
          "type": "string",
          "description": "下单渠道码"
        }
      }
    }
