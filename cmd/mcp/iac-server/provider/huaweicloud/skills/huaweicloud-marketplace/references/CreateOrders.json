            "$ref": "#/definitions/OrderInfoV2OpenApi"
          },
          "description": "OrderInfo 数组",
          "minItems": 1,
          "maxItems": 30
        }
      },
      "type": "object"
    },
    "BatchCreateOrderOpenApiResp": {
      "description": "订单批量下单结果返回",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "返回码",
          "maxLength": 16,
          "minLength": 0
