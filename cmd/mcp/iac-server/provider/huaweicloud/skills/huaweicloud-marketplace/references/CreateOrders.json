          "minLength": 0,
          "maxLength": 20
        },
        "cycle_number": {
          "type": "integer",
          "format": "int32",
          "description": "周期数量"
        },
        "extend_params": {
          "type": "string",
          "description": "JSON字符串,扩展参数",
          "minLength": 0,
