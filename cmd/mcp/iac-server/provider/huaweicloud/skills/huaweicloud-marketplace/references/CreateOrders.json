          "description": "是否自动支付:\nYES:是\nNO:否\n默认值为“NO”。",
          "type": "string",
          "enum": [
            "YES",
            "NO"
          ]
        },
        "agreement_params": {
          "description": "下单待签署协议列表",
          "type": "array",
          "maxItems": 99,
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/AgreementParamOpenApi"
          }
        },
        "extend_params": {
          "description": "JSON字符串,扩展参数",
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    }
