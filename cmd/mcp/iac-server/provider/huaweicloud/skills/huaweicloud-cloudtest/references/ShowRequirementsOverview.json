{
  "name": "ShowRequirementsOverview",
  "summary": "质量报告需求测试情况统计",
  "tags": "测试报表管理",
  "productshort": "Cloudtest",
  "region_id": "ap-southeast-3",
  "paths": {
    "/testreport/v4/{project_id}/versions/{version_id}/requirements/overview": {
      "post": {
        "tags": [
          "测试报表管理"
        ],
        "summary": "质量报告需求测试情况统计",
        "operationId": "ShowRequirementsOverview",
        "description": "质量报告需求测试情况统计",
        "x-constraint": "",
        "x-name": "页面报表展示",
        "x-scope": "",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "schemes": [
          "https"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "version_id",
            "in": "path",
            "description": "版本id",
            "required": true,
            "type": "string",
            "x-example": "932opbu6aaf"
          },
          {
            "name": "QueryRequirementsOverviewInfo",
            "in": "body",
            "description": "质量报告看板统计请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/QueryRequirementsOverviewInfo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ApiResultRequirementsOverviewVo"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "RequirementsOverviewVo": {
      "title": "本次查询的记录结果",
      "type": "object",
      "properties": {
        "total_number": {
          "type": "integer",
          "description": "质量报告需求测试情况总数",
          "format": "int32",
          "example": 100
        },
        "requirement_overview_list": {
          "type": "array",
          "description": "质量报告需求测试情况列表",
          "items": {
            "$ref": "#/definitions/RequirementOverviewVo"
          }
        }
      },
      "description": "实际的数据类型:单个对象,集合 或 NULL"
    },
    "PiFilterInfo": {
      "type": "object",
      "properties": {
        "pi_sprints": {
          "type": "array",
          "description": "pi迭代筛选条件",
          "items": {
            "$ref": "#/definitions/PiInfo"
          }
        },
        "all_pi": {
          "type": "boolean",
          "description": "pi下拉框全选标识,全选时为true",
          "example": true
        }
      },
      "description": "pi筛选条件"
    },
    "QueryRequirementsOverviewInfo": {
      "type": "object",
      "properties": {
        "fixed_version_id": {
          "type": "string",
          "description": "筛选迭代ID",
          "example": "0001719bab7a4b1fba9bc2631ad1fe7b,0000b05bc97c47b1a84ad18106ee7b3c"
        },
        "module_id": {
          "type": "string",
          "description": "模块ID",
          "example": "60ace553eaf7c955f8cf1615"
        },
        "key_word": {
          "type": "string",
          "description": "关键字",
          "example": "关键字"
        },
        "page_size": {
          "type": "integer",
          "description": "每页数量",
          "format": "int32",
          "example": 15
        },
        "page_no": {
          "type": "integer",
          "description": "页码",
          "format": "int32",
          "example": 1
        },
        "pi_filter": {
          "$ref": "#/definitions/PiFilterInfo"
        }
      }
    },
    "ApiResultRequirementsOverviewVo": {
      "title": "ApiResult",
      "type": "object",
      "properties": {
        "status": {
          "title": "本次请求的处理状态",
          "type": "string",
          "description": "success|error;"
        },
        "result": {
          "$ref": "#/definitions/ResultValueRequirementsOverviewVo"
        },
        "error": {
          "$ref": "#/definitions/ApiError"
        }
      }
    },
    "NameAndValueVo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "名称",
          "example": "新建"
        },
        "value": {
          "type": "integer",
          "description": "值",
          "format": "int32",
          "example": 22
        }
      },
      "description": "用户自定义状态对应的用例数目"
    },
    "CaseExecuteVo": {
      "type": "object",
      "properties": {
        "execute_rate": {
          "type": "string",
          "description": "需求关联用例执行率",
          "example": "12.3%"
        },
        "executed_number": {
          "type": "integer",
          "description": "需求关联已执行用例总数",
          "format": "int32",
          "example": 10
        },
        "not_executed_number": {
          "type": "integer",
          "description": "需求关联未执行用例总数",
          "format": "int32",
          "example": 5
        }
      },
      "description": "需求关联用例执行率情况"
    },
    "PiInfo": {
      "type": "object",
      "properties": {
        "sprints": {
          "type": "array",
          "description": "迭代列表",
          "example": [
            "883650474778079233",
            "883650474778079234"
          ],
          "items": {
            "type": "string",
            "description": "迭代列表",
            "example": "[\"883650474778079233\",\"883650474778079234\"]"
          }
        },
        "pi_id": {
          "type": "string",
          "description": "pi的id,层级关系:pi -> 迭代 -> 需求",
          "example": "883309798865547265"
        }
      },
      "description": "pi迭代筛选条件"
    },
    "ApiError": {
      "title": "失败原因",
      "type": "object",
      "properties": {
        "code": {
          "title": "错误编码",
          "type": "string",
          "description": "业务失败的错误码"
        },
        "reason": {
          "title": "错误信息",
          "type": "string",
          "description": "业务失败的提示内容"
        }
      },
      "description": "失败时的error信息"
    },
    "CasePassVo": {
      "type": "object",
      "properties": {
        "pass_rate": {
          "type": "string",
          "description": "需求关联用例通过率",
          "example": "12.3%"
        },
        "result_number_list": {
          "type": "array",
          "description": "需求关联用例结果与对应的用例数目列表",
          "items": {
            "$ref": "#/definitions/NameAndValueVo"
          }
        }
      },
      "description": "需求关联用例通过情况"
    },
    "ResultValueRequirementsOverviewVo": {
      "title": "ResultValue",
      "type": "object",
      "properties": {
        "total": {
          "title": "符合条件的所有记录数",
          "type": "integer",
          "description": "起始记录数 大于 实际总条数时, 值为0, 分页请求才有此值",
          "format": "int32"
        },
        "value": {
          "type": "object",
          "$ref": "#/definitions/RequirementsOverviewVo"
        },
        "reason": {
          "title": "错误信息",
          "type": "string",
          "description": "业务失败的提示内容,对内接口才有此值"
        },
        "page_size": {
          "title": "每页展示条数",
          "type": "integer",
          "format": "int32"
        },
        "page_no": {
          "title": "页码",
          "type": "integer",
          "format": "int32"
        },
        "has_more": {
          "title": "是否有更多",
          "type": "boolean"
        }
      },
      "description": "请求的返回的数据对象"
    },
    "RequirementOverviewVo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "需求名称",
          "example": "epic1"
        },
        "workitem_id": {
          "type": "string",
          "description": "需求id",
          "example": "6029451"
        },
        "sequence_id": {
          "type": "string",
          "description": "需求序列编号",
          "example": "AR20221203705265"
        },
        "board_id": {
          "type": "string",
          "description": "看板需求id",
          "example": "4082e17c171140168645a766cec1ed32"
        },
        "tracker_id": {
          "type": "string",
          "description": "需求类型id",
          "example": "1"
        },
        "tracker_name": {
          "type": "string",
          "description": "需求类型",
          "example": "需求"
        },
        "relate_case_number": {
          "type": "integer",
          "description": "需求关联用例总数",
          "format": "int32",
          "example": 2
        },
        "case_pass_vo": {
          "$ref": "#/definitions/CasePassVo"
        },
        "case_execute_vo": {
          "$ref": "#/definitions/CaseExecuteVo"
        },
        "relate_defect_number": {
          "type": "integer",
          "description": "需求关联缺陷总数",
          "format": "int32",
          "example": 5
        }
      },
      "description": "质量报告需求测试情况列表"
    }
  },
  "version": "2.0",
  "parameters": {
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,固定长度32位字符(字母和数字)。",
      "required": true,
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9]{32}$",
      "x-example": "968ce2c7784f471f8fd2a8d7c8537c84"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "type": "string",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "minLength": 1,
      "maxLength": 100000,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
    }
  },
  "host": "cloudtest-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}