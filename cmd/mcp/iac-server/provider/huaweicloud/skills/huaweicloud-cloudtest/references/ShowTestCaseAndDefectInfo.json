      "description": "服务类型信息"
    },
    "ShowTestCaseAndDefectInfoResponseBody": {
      "title": "查询用户用例关联缺陷的统计信息响应体",
      "type": "object",
      "description": "查询用户用例关联缺陷的统计信息响应体",
      "properties": {
        "total": {
          "title": "符合条件的所有记录数",
          "type": "integer",
