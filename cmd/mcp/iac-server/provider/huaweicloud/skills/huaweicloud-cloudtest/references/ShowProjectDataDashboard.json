  "productshort": "Cloudtest",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/{project_id}/data-dashboard/overview": {
      "post": {
        "tags": [
          "测试报表管理"
        ],
        "operationId": "ShowProjectDataDashboard",
        "description": "查询质量报告看板统计信息",
        "summary": "查询质量报告看板统计信息",
        "x-constraint": "",
        "x-name": "查询质量报告看板统计信息",
        "x-apigateway-ratelimit": "CloudTest资源查询类流控",
        "x-scope": "",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "schemes": [
          "https"
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/project_id"
          },
          {
            "name": "ShowProjectDataDashboardRequestBody",
            "in": "body",
            "description": "质量报告看板统计请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TestReportInfoRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/OverviewVoResponseBody"
            },
            "examples": {
              "application/json": "{\n    \"defect\": {\n        \"total\": 3,\n        \"not_solved\": 3,\n        \"severity_number_list\": [\n            {\n                \"name\": \"提示\",\n                \"value\": 3\n            }\n        ]\n    },\n    \"case_pass_rate\": {\n        \"pass_rate\": \"99.5%\",\n        \"result_number_list\": [\n            {\n                \"name\": \"成功\",\n                \"value\": 3000\n            },\n            {\n                \"name\": \"未执行\",\n                \"value\": 15\n            }\n        ]\n    },\n    \"project_type\": \"ipd\",\n    \"issue_cover_rate\": {\n        \"epic\": { // epic仅在scrum项目返回\n            \"testing\": 0,\n            \"finished\": 0,\n            \"not_tested\": 1,\n            \"total_number\": 1,\n            \"cover_rate\": \"0.0%\"\n        }\n        \"feature\": { // feature仅在scrum项目返回\n            \"testing\": 0,\n            \"finished\": 0,\n            \"not_tested\": 1,\n            \"total_number\": 1,\n            \"cover_rate\": \"0.0%\"\n        }\n        \"story\": { // story仅在scrum项目返回\n            \"testing\": 0,\n            \"finished\": 0,\n            \"not_tested\": 1,\n            \"total_number\": 1,\n            \"cover_rate\": \"0.0%\"\n        },\n        \"summary\": { // summary仅在非scrum项目返回\n            \"testing\": 0,\n            \"finished\": 0,\n            \"not_tested\": 17,\n            \"total_number\": 17,\n            \"cover_rate\": \"0.0%\"\n        }\n    }\n}"
            }
          },
          "400": {
