            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/OperationResponseBody"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/OperationResponseBody"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/OperationResponseBody"
            }
          }
        },
        "x-api-type": "open-api",
        "x-request-examples-description-1": "查询质量报告看板统计信息",
        "x-request-examples-url-1": "post https://{{endpoint}}/v1/875ab809ae454c808b8565bd8695692d/data-dashboard/overview",
        "x-request-examples-1": {
          "plan_id": "vx785d2300op22kb6c",
          "branch_id": "v9050000uop22kb6",
          "module_id": "889109272257798144,-2",
          "fixed_version_id": "884537509955936256,884770598208577537,-2"
        }
      }
    }
  },
  "definitions": {
    "TestReportInfoRequestBody": {
      "type": "object",
      "description": "查询质量报告看板统计信息请求体",
      "properties": {
        "plan_id": {
          "type": "string",
          "description": "测试计划id,(plan_id和branch_id不能同时为空,优先取plan_id)",
          "example": "0001719bab7a4b1",
          "minLength": 11,
          "maxLength": 34,
          "pattern": "^[A-Za-z0-9]{11,34}$"
        },
        "branch_id": {
          "type": "string",
          "description": "分支id,(plan_id和branch_id不能同时为空,优先取plan_id)",
          "example": "a9bc2631ad1fe7b",
          "minLength": 11,
          "maxLength": 34,
          "pattern": "^[A-Za-z0-9]{11,34}$"
        },
        "module_id": {
          "type": "string",
          "description": "模块ID(查询未设置传入-2)",
          "example": "26016459,26016413,2601641,-2",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^[A-Za-z\\-0-9,]{0,1024}$"
        },
        "fixed_version_id": {
          "type": "string",
          "description": "筛选迭代ID(查询未设置传入-2)",
          "example": "752017,755187,752015,752016,-2",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^[A-Za-z\\-0-9,]{0,1024}$"
        }
      }
    },
    "OverviewVoResponseBody": {
      "title": "查询质量报告看板统计信息响应体",
      "description": "查询质量报告看板统计信息响应体",
      "type": "object",
      "properties": {
        "defect": {
          "$ref": "#/definitions/DefectVo",
          "description": "缺陷统计信息"
        },
        "case_pass_rate": {
          "$ref": "#/definitions/CasePassRateVo",
          "description": "用例通过率信息"
        },
        "case_completion_rate": {
          "$ref": "#/definitions/CaseCompletionRateVo",
          "description": "用例通过率信息"
        },
        "project_type": {
          "type": "string",
          "description": "项目类型",
          "example": "scrum"
        },
        "issue_cover_rate": {
          "$ref": "#/definitions/IssueCoverRateVo",
          "description": "需求覆盖率信息"
        }
      }
    },
    "CasePassRateVo": {
      "type": "object",
      "description": "计算用例通过率",
      "properties": {
        "pass_rate": {
          "type": "string",
          "description": "用例通过率",
          "example": "12.3%"
        },
        "result_number_list": {
          "type": "array",
          "description": "用户自定义结果对应的用例数目",
          "items": {
            "$ref": "#/definitions/NameAndValueVo"
          }
        }
      }
    },
    "IssueCoverRateVo": {
      "type": "object",
      "description": "看板项目的需求覆盖率",
      "properties": {
        "epic": {
          "$ref": "#/definitions/CoverRateVo",
          "description": "epic类型需求覆盖率, 仅scrum项目返回"
        },
        "feature": {
          "$ref": "#/definitions/CoverRateVo",
          "description": "feature类型需求覆盖率, 仅scrum项目返回"
        },
        "story": {
          "$ref": "#/definitions/CoverRateVo",
          "description": "story类型需求覆盖率, 仅scrum项目返回"
        },
        "summary": {
          "$ref": "#/definitions/CoverRateVo",
          "description": "story类型需求覆盖率, 仅scrum项目返回"
        }
      }
    },
    "CoverRateVo": {
      "type": "object",
      "description": "需求覆盖率",
      "properties": {
        "testing": {
          "type": "integer",
          "description": "统计测试中的需求",
          "format": "int32",
          "example": 5
        },
        "finished": {
          "type": "integer",
          "description": "统计已完成的需求",
          "format": "int32",
          "example": 11
        },
        "not_tested": {
          "type": "integer",
          "description": "统计未测试的需求",
          "format": "int32",
          "example": 4
        },
        "total_number": {
          "type": "integer",
          "description": "计算需求总数",
          "format": "int32",
          "example": 55
        },
        "cover_rate": {
          "type": "string",
          "description": "需求覆盖率",
          "example": "10.3%"
        }
      }
    },
    "DefectVo": {
      "type": "object",
      "description": "整体缺陷信息",
      "properties": {
        "total": {
          "type": "integer",
          "description": "缺陷数",
          "format": "int32",
          "example": 123
        },
        "not_solved": {
          "type": "integer",
          "description": "未关闭缺陷数",
          "format": "int32",
          "example": 11
        },
        "severity_number_list": {
          "type": "array",
          "description": "组装缺陷每种重要程度的名称和对应的数目",
          "items": {
            "$ref": "#/definitions/NameAndValueVo"
          }
        }
      }
    },
    "CaseCompletionRateVo": {
      "type": "object",
      "description": "计算用例完成率",
      "properties": {
        "total": {
          "type": "integer",
          "description": "总用例数",
          "format": "int32",
          "example": 123
        },
        "completion_rate": {
          "type": "string",
          "description": "用例完成率",
          "example": "12.3%"
        },
        "status_number_list": {
          "type": "array",
          "description": "用户自定义状态对应的用例数目",
          "items": {
            "$ref": "#/definitions/NameAndValueVo"
          }
        }
      }
    },
    "OperationResponseBody": {
      "properties": {
        "error_code": {
          "type": "string",
          "description": "接口调用失败错误码",
          "example": "CLOUDTEST.000XXXXX"
        },
        "error_msg": {
          "type": "string",
          "description": "接口调用失败错误信息",
          "example": "返回的错误信息"
        }
      }
    },
    "NameAndValueVo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "名称",
          "example": "新建"
        },
        "value": {
          "type": "integer",
          "description": "值",
          "format": "int32",
          "example": 22
        }
      },
      "description": "用户自定义状态对应的用例数目"
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "required": true,
      "type": "string",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "minLength": 1,
      "maxLength": 100000,
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
    },
    "project_id": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,固定长度32位字符(字母和数字)。",
      "required": true,
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9]{32}$",
      "x-example": "968ce2c7784f471f8fd2a8d7c8537c84"
    }
  },
  "host": "cloudtest-ext.ap-southeast-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}