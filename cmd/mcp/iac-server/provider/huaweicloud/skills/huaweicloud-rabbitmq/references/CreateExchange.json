        "responses": {
          "200": {
            "description": "创建Exchange成功。",
            "schema": {
              "$ref": "#/definitions/ExchangeDetails"
            },
            "examples": {
              "application/json": {
                "name": "exchange_name_demo",
                "type": "direct",
                "durable": true,
                "auto_delete": false,
                "internal": false,
                "vhost": "default",
                "arguments": {}
              }
            }
          }
        },
        "x-is-registered": "Y",
