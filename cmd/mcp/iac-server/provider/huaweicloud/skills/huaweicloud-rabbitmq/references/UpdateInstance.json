  "definitions": {
    "UpdateInstanceReq": {
      "type": "object",
      "properties": {
        "name": {
          "description": "实例名称。\n\n由英文字符开头,只能由英文字母、数字、中划线组成,长度为4~64的字符。",
          "type": "string"
        },
        "description": {
          "description": "实例的描述信息。\n\n长度不超过1024的字符串。\n> \\与\"在json报文中属于特殊字符,如果参数值中需要显示\\或者\"字符,请在字符前增加转义字符\\,比如\\\\\\\\或者\\\\\\\"。",
          "type": "string"
        },
        "maintain_begin": {
          "description": "维护时间窗开始时间,格式为HH:mm:ss。\n  - 维护时间窗开始和结束时间必须为指定的时间段。\n  - 开始时间必须为22:00:00、02:00:00、06:00:00、10:00:00、14:00:00和18:00:00。\n  - 该参数不能单独为空,若该值为空,则结束时间也为空。系统分配一个默认开始时间02:00:00。",
          "type": "string"
        },
        "maintain_end": {
          "description": "维护时间窗结束时间,格式为HH:mm:ss。\n  - 维护时间窗开始和结束时间必须为指定的时间段。\n  - 结束时间在开始时间基础上加四个小时,即当开始时间为22:00:00时,结束时间为02:00:00。\n  - 该参数不能单独为空,若该值为空,则开始时间也为空。系统分配一个默认结束时间06:00:00。",
          "type": "string"
        },
        "security_group_id": {
          "description": "安全组ID。\n\n获取方法如下:参考[《虚拟私有云 API参考》](https://support.huaweicloud.com/api-vpc/vpc_apiv3_0011.html),调用“查询安全组列表”接口,从响应体中获取安全组ID。",
          "type": "string"
        },
        "enable_publicip": {
          "type": "boolean",
          "description": "RabbitMQ实例是否开启公网访问功能。\n  - true:开启\n  - false:不开启"
        },
        "publicip_id": {
          "description": "RabbitMQ实例绑定的弹性IP地址的id。\n\n如果开启了公网访问功能(即enable_publicip为true),该字段为必选。\n\n获取方法:参考[《弹性公网IP API参考》](https://support.huaweicloud.com/api-eip/ListPublicipsV3.html),调用“查询弹性公网IP列表”接口,从响应体中获取弹性公网IP的ID。",
          "type": "string"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目。"
        },
        "enable_acl": {
          "description": "ACL访问控制(仅AMQP版本支持此参数)。",
          "x-no-support-region": "ctc,sbc,hk_sbc,g42,hk_g42,tm,hk_tm,hcs,dt,cmcc,ax",
          "type": "boolean"
        }
      },
      "example": {
        "name": "rabbitmq-test",
        "description": "test"
      }
    }
