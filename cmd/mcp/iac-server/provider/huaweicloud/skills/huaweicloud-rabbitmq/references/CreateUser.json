{
  "name": "CreateUser",
  "summary": "创建用户",
  "tags": "用户管理",
  "productshort": "RabbitMQ",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/instances/{instance_id}/users": {
      "post": {
        "tags": [
          "用户管理"
        ],
        "summary": "创建用户",
        "description": "创建用户(仅AMQP版本支持)。",
        "operationId": "CreateUser",
        "x-api-type": "open-api",
        "x-order": 1,
        "parameters": [
          {
            "description": "项目ID,获取方式请参见[获取项目ID](rabbitmq-api-190611012.xml)。",
            "in": "path",
            "name": "project_id",
            "required": true,
            "type": "string"
          },
          {
            "description": "实例ID。",
            "in": "path",
            "name": "instance_id",
            "required": true,
            "type": "string"
          },
          {
            "name": "CreateUserRequestBody",
            "in": "body",
            "description": "请求消息。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AMQPUser"
            }
          }
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-produc-type": "rabbitmq",
        "x-open-region-cloud": "hws,hws_hk,hws_eu",
        "x-hybridcloud": false,
        "responses": {
          "200": {
            "description": "创建用户成功。",
            "schema": {
              "$ref": "#/definitions/AMQPUser"
            },
            "examples": {
              "application/json": {
                "access_key": "admin123",
                "secret_key": "**************",
                "vhosts": [
                  {
                    "vhost": "default",
                    "conf": ".*",
                    "write": ".*",
                    "read": ".*"
                  }
                ]
              }
            }
          }
        },
        "x-request-examples-description-1": "创建一个AMQP用户,允许访问名称为default的Vhost,允许对此Vhost下所有资源进行配置、读、写。",
        "x-request-examples-url-1": "POST https://{endpoint}/v2/{project_id}/instances/{instance_id}/users",
        "x-request-examples-1": {
          "access_key": "admin123",
          "secret_key": "**************",
          "vhosts": [
            {
              "vhost": "default",
              "conf": ".*",
              "write": ".*",
              "read": ".*"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "AMQPUser": {
      "type": "object",
      "required": [
        "access_key",
        "secret_key",
        "vhosts"
      ],
      "properties": {
        "access_key": {
          "description": "**参数解释**:\n用户名。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "secret_key": {
          "description": "**参数解释**:\n密钥。\n**取值范围**:\n- 8-32个字符。\n- 至少包含以下字符中的3种:\n   - 大写字母\n   - 小写字母\n   - 数字\n   - 特殊字符`~!@#$%^&*()-_=+\\\\|[{}];:\\'\\\",<.>/?。\n- 不能与名称或倒序的名称相同。",
          "type": "string"
        },
        "vhosts": {
          "description": "**参数解释**:\n需要配置权限的Vhost,一个用户可以配置多个Vhost下的资源权限。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/AMQPUserPerm"
          }
        }
      },
      "example": {
        "access_key": "admin123",
        "secret_key": "**************",
        "vhosts": [
          {
            "vhost": "default",
            "conf": ".*",
            "write": ".*",
            "read": ".*"
          }
        ]
      }
    },
    "AMQPUserPerm": {
      "type": "object",
      "required": [
        "vhost",
        "conf",
        "write",
        "read"
      ],
      "properties": {
        "vhost": {
          "description": "**参数解释**:\n需要配置权限的Vhost名称,一个用户可以配置多个Vhost下的资源权限。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "conf": {
          "description": "**参数解释**:\n使用正则表达式匹配资源配置权限。例如,在输入框内输入“^janeway-.*”,则表示授权给该用户当前Vhost下,所有名称以“janeway-”开头的资源的配置权限。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "write": {
          "description": "**参数解释**:\n使用正则表达式匹配资源写权限。例如,在输入框内输入“.*”,则表示授权给该用户当前Vhost下,所有资源的写权限。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "read": {
          "description": "**参数解释**:\n使用正则表达式匹配资源读权限。例如,在输入框内输入“.*”,则表示授权给该用户当前Vhost下,所有资源的读权限。\n**取值范围**:\n不涉及。",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}