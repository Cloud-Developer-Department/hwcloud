{
  "name": "CreateBinding",
  "summary": "添加绑定",
  "tags": "Binding管理",
  "productshort": "RabbitMQ",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/rabbitmq/{project_id}/instances/{instance_id}/vhosts/{vhost}/exchanges/{exchange}/binding": {
      "post": {
        "tags": [
          "Binding管理"
        ],
        "summary": "添加绑定",
        "description": "添加绑定。",
        "operationId": "CreateBinding",
        "x-api-type": "open-api",
        "x-order": 1,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID,获取方式请参见[获取项目ID](rabbitmq-api-190611012.xml)。"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "实例ID"
          },
          {
            "name": "vhost",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "vhost名称,名称中包含/时,需要将/替换为__F_SLASH__,否则会调用失败。例如:Vhost名称为/test,入参值为__F_SLASH__test。"
          },
          {
            "name": "exchange",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Exchange名称"
          },
          {
            "name": "CreateBindingRequestBody",
            "in": "body",
            "required": true,
            "description": "创建绑定",
            "schema": {
              "$ref": "#/definitions/CreateBindingBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "添加绑定成功。",
            "schema": {
              "$ref": "#/definitions/CreateBindingResp"
            },
            "examples": {
              "application/json": {
                "source": "exchange_name",
                "destination_type": "Queue",
                "destination": "queue_name",
                "routing_key": "binding_key_demo"
              }
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-produc-type": "rabbitmq",
        "x-open-region-cloud": "hws,hws_hk,sbc,cmcc,hws_eu,tm,hk_tm,ax,hk_sbc,dt",
        "x-hybridcloud": false,
        "x-request-examples-url-1": "POST  /v2/rabbitmq/{project_id}/instances/{instance_id}/vhosts/default/exchanges/test-exchange/binding",
        "x-request-examples-description-1": "将test-exchange作为源端,与目标端为Queue类型的mirror-queue绑定,绑定路由键为routing_key_1。",
        "x-request-examples-text-1": {
          "destination_type": "Queue",
          "destination": "mirror-queue",
          "routing_key": "routing_key_1"
        }
      }
    }
  },
  "definitions": {
    "CreateBindingResp": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "绑定对象"
        },
        "destination_type": {
          "type": "string",
          "description": "**参数解释**:\n绑定目标端类型。\n**取值范围**:\n- exchange:交换机。\n- queue:队列。AMQP版本只支持绑定queue。"
        },
        "destination": {
          "type": "string",
          "description": "要投递的Exchange或Queue名称"
        },
        "routing_key": {
          "type": "string",
          "description": "绑定键值,用于告知Exchange应该将消息投递到哪些Queue中"
        }
      }
    },
    "CreateBindingBody": {
      "type": "object",
      "required": [
        "destination",
        "routing_key",
        "destination_type"
      ],
      "properties": {
        "destination": {
          "type": "string",
          "description": "要投递的Exchange或Queue名称"
        },
        "routing_key": {
          "type": "string",
          "description": "**参数解释**:\n绑定键值,用于告知Exchange应该将消息投递到哪些Queue或Exchange中。\n**约束限制**:\n- 不允许包含+和~。\n- 最长128个字符。\n- 不能包含中文。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
        },
        "destination_type": {
          "type": "string",
          "description": "**参数解释**:\n绑定目标端类型。\n**约束限制**:\nAMQP版本只支持绑定Queue。\n**取值范围**:\n- exchange:交换机。\n- queue:队列。\n**默认取值**:\n不涉及。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
