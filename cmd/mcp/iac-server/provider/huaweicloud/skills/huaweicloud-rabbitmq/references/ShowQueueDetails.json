{
  "name": "ShowQueueDetails",
  "summary": "查询指定Queue详情",
  "tags": "Queue管理",
  "productshort": "RabbitMQ",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/rabbitmq/{project_id}/instances/{instance_id}/vhosts/{vhost}/queues/{queue}": {
      "get": {
        "tags": [
          "Queue管理"
        ],
        "summary": "查询指定Queue详情",
        "description": "查询指定Queue详情。",
        "operationId": "ShowQueueDetails",
        "x-api-type": "open-api",
        "x-order": 5,
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "type": "string",
            "description": "**参数解释**:\n项目ID,获取方式请参见[获取项目ID](rabbitmq-api-190611012.xml)。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
          },
          {
            "in": "path",
            "name": "instance_id",
            "required": true,
            "type": "string",
            "description": "**参数解释**:\n实例ID。获取方法如下:调用[查询所有实例列表](ListInstancesDetails.xml)接口,从响应体中获取实例ID。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
          },
          {
            "in": "path",
            "name": "vhost",
            "required": true,
            "type": "string",
            "description": "**参数解释**:\n Vhost名称。\n**约束限制**:\n不涉及。\n**取值范围**:\n不涉及。\n**默认取值**:\n不涉及。"
          },
          {
            "in": "path",
            "name": "queue",
            "required": true,
            "type": "string",
            "description": "**参数解释**:\n 分页查询偏移量,表示从此偏移量开始查询。\n**约束限制**:\n不涉及。\n**取值范围**:\n大于等于0。\n**默认取值**:\n0。"
          }
        ],
        "responses": {
          "200": {
            "description": "查询指定Queue详情成功。",
            "schema": {
              "$ref": "#/definitions/AMQPQueueDetails"
            },
            "examples": {
              "application/json": {
                "vhost": "default",
                "name": "testQueue",
                "durable": true,
                "auto_delete": false,
                "messages": 100,
                "consumers": 10,
                "policy": "ttl",
                "arguments": {
                  "x-message-ttl": 60000,
                  "x-dead-letter-exchange": "dead-exchange-deal",
                  "x-dead-letter-routing-key": "dead-ex-routing-key",
                  "x-queue-mode": "lazy"
                },
                "consumer_details": {
                  "consumer_tag": "tag",
                  "channel_details": {
                    "name": "channel_name",
                    "number": 1,
                    "user": "root",
                    "connection_name": "connection_name",
                    "peer_host": "192.128.1.254",
                    "peer_port": 12345
                  },
                  "ack_required": true,
                  "prefetch_count": 200
                },
                "queue_bindings": {
                  "source": "amq.direct",
                  "destination_type": "queue",
                  "destination": "testQueue",
                  "routing_key": "info",
                  "properties_key": "info"
                }
              }
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-produc-type": "rabbitmq",
        "x-open-region-cloud": "hws,hws_hk,sbc,cmcc,hws_eu,tm,hk_tm,ax,hk_sbc,dt",
        "x-hybridcloud": false,
        "x-request-examples-url-1": "GET     https://{endpoint}/v2/rabbitmq/{project_id}/instances/{instance_id}/vhosts/{vhost}/queues?offset=0&limit=10",
        "x-request-examples-description-1": "查询指定Queue详情"
      }
    }
  },
  "definitions": {
    "BindingsDetails": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "**参数解释**:\nExchange名称。\n**取值范围**:\n不涉及。"
        },
        "destination_type": {
          "type": "string",
          "description": "**参数解释**:\n绑定目标的类型。\n**取值范围**:\n- exchange:交换机。\n- queue:队列。"
        },
        "destination": {
          "type": "string",
          "description": "**参数解释**:\n绑定目标。\n**取值范围**:\n不涉及。"
        },
        "routing_key": {
          "type": "string",
          "description": "**参数解释**:\n绑定键值。\n**取值范围**:\n不涉及。"
        },
        "properties_key": {
          "type": "string",
          "description": "**参数解释**:\n经过URL转译后routing_key。\n**取值范围**:\n不涉及。"
        }
      }
    },
    "AMQPQueueDetails": {
      "type": "object",
      "properties": {
        "vhost": {
          "type": "string",
          "description": "**参数解释**:\nQueue所属Vhost名称。\n**取值范围**:\n不涉及。"
        },
        "name": {
          "type": "string",
          "description": "**参数解释**:\nQueue名称。\n**取值范围**:\n不涉及。"
        },
        "durable": {
          "type": "boolean",
          "description": "**参数解释**:\nQueue是否开启持久化。\n**取值范围**:\n- true:开启持久化。\n- false:未开启持久化。"
        },
        "auto_delete": {
          "type": "boolean",
          "description": "**参数解释**:\nQueue是否开启自动删除。\n**取值范围**:\n- true:开启自动删除。\n- false:未开启自动删除。"
        },
        "messages": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n待消费消息数。\n**取值范围**:\n不涉及。"
        },
        "consumers": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n连接的消费者数。\n**取值范围**:\n不涉及。"
        },
        "policy": {
          "type": "string",
          "description": "**参数解释**:\n策略(AMQP版本不支持policy,不涉及此参数)。\n**取值范围**:\n不涉及。"
        },
        "arguments": {
          "$ref": "#/definitions/QueueArguments"
        },
        "consumer_details": {
          "description": "**参数解释**:\n订阅该Queue的消费者信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ConsumerDetails"
          }
        },
        "queue_bindings": {
          "description": "**参数解释**:\n以此Queue为目标的绑定信息列表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/BindingsDetails"
          }
        }
      }
    },
    "QueueArguments": {
      "type": "object",
      "description": "**参数解释**:\nQueue参数,如果未配置则不返回。",
      "properties": {
        "x-message-ttl": {
          "description": "**参数解释**:\n消息过期时间,发布到Queue的消息在被丢弃之前可以存活多长时间。\n**取值范围**:\n不涉及。",
          "type": "integer",
          "format": "int64"
        },
        "x-dead-letter-exchange": {
          "description": "**参数解释**:\n死信Exchange名称,消息被拒绝或过期时将重新发布到该Exchange。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "x-dead-letter-routing-key": {
          "description": "**参数解释**:\n死信的RoutingKey,死信Exchange会发送死信消息到绑定对应RoutingKey的Queue上。\n**取值范围**:\n不涉及。",
          "type": "string"
        },
        "x-queue-mode": {
          "type": "string",
          "description": "**参数解释**:\n惰性队列(AMQP版本默认持久化所有消息,不涉及此参数)。\n**取值范围**:\n不涉及。"
        }
      }
    },
    "ConsumerDetails": {
      "type": "object",
      "properties": {
        "consumer_tag": {
          "type": "string",
          "description": "**参数解释**:\n消费者标识。\n**取值范围**:\n不涉及。"
        },
        "channel_details": {
          "description": "**参数解释**:\n消费者连接信息。\n**取值范围**:\n不涉及。",
          "$ref": "#/definitions/ChannelDetails"
        },
        "ack_required": {
          "type": "boolean",
          "description": "**参数解释**:\n消费者客户端是否设置手动ack。\n**取值范围**:\n- true:设置手动ack。\n- false:不设置手动ack。"
        },
        "prefetch_count": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n消费者客户端预取值。\n**取值范围**:\n不涉及。"
        }
      }
    },
    "ChannelDetails": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "**参数解释**:\nchannel信息,包括客户端IP:Port到服务端IP:Port(channel_id)。\n**取值范围**:\n不涉及。"
        },
        "number": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\nchannel数量。\n**取值范围**:\n不涉及。"
        },
        "user": {
          "type": "string",
          "description": "**参数解释**:\n消费者用户名,在开启ACL访问控制后返回真实用户名,未开启ACL时返回null。\n**取值范围**:\n不涉及。"
        },
        "connection_name": {
          "type": "string",
          "description": "**参数解释**:\nconnection信息,包括客户端IP:Port到服务端IP:Port。\n**取值范围**:\n不涉及。"
        },
        "peer_host": {
          "type": "string",
          "description": "**参数解释**:\n连接的消费者IP。\n**取值范围**:\n不涉及。"
        },
        "peer_port": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n连接的消费者进程端口号。\n**取值范围**:\n不涉及。"
        }
      },
      "example": {
        "name": "10.58.235.253:63333 -> 192.168.120.183:5672 (1)",
        "number": 1,
        "user": null,
        "connection_name": "10.58.235.253:63333 -> 192.168.120.183:5672",
        "peer_host": "10.58.235.253",
        "peer_port": 63333
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}