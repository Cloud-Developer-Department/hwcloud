  "definitions": {
    "CreateQueueBody": {
      "type": "object",
      "required": [
        "name",
        "auto_delete"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Queue名称"
        },
        "auto_delete": {
          "type": "boolean",
          "description": "是否自动删除"
        },
        "durable": {
          "type": "boolean",
          "description": "是否持久化(AMQP版本默认持久化,不涉及此字段)"
        },
        "dead_letter_exchange": {
          "type": "string",
          "description": "死信Exchange名称,消息被拒绝或过期时将重新发布到该Exchange。"
        },
        "dead_letter_routing_key": {
          "type": "string",
          "description": "死信Exchange的RoutingKey,死信Exchange会发送死信消息到绑定对应RoutingKey的Queue上。"
        },
        "message_ttl": {
          "type": "integer",
          "format": "int64",
          "description": "发布到Queue的消息在被丢弃之前可以存活多长时间"
        },
        "lazy_mode": {
          "type": "string",
          "description": "若设置惰性队列,请输入lazy。惰性队列模式会在磁盘上存储尽可能多的消息以减少内存使用;若不设置,队列将消息存储在内存缓存以尽可能快地传递消息。(AMQP版本默认将消息存储到磁盘,不涉及此字段)"
        }
      }
    }
