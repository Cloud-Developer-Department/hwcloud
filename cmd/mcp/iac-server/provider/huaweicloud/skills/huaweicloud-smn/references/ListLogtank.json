  "definitions": {
    "GetLogtankListResponseBody": {
      "type": "object",
      "description": "查询云日志信息列表返回体",
      "required": [
        "request_id",
        "count",
        "logtanks"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识",
          "example": "f5c05cb70d264ca58d1080202ceba284"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "云日志信息数量",
