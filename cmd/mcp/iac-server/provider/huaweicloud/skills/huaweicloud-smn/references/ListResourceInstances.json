  "definitions": {
    "ResourceTags": {
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "键。\n\n- 最大长度127个unicode字符。\n\n- key不能为空。"
        },
        "values": {
          "type": "array",
          "description": "值列表。\n\n- 最多10个value。\n\n- value不允许重复。\n\n- 每个值最大长度255个unicode字符。\n\n- 如果values为空则表示any_value。\n\n- value之间为或的关系。",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "资源标签列表结构体。"
    },
    "FailedResp": {
      "required": [
        "request_id",
        "code",
        "message"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "example": "6a63a18b8bab40ffb71ebd9cb80d0085"
        },
        "code": {
          "type": "string",
          "description": "服务异常错误信息编码。",
          "example": "SMN.0167"
        },
        "message": {
          "type": "string",
          "description": "服务异常错误信息描述。",
          "example": "xxxxxxxx"
        }
      }
    },
    "ListInstanceRequestBody": {
      "required": [
        "action"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "description": "最多包含10个key,每个key最多包含10个value,结构体不能缺失。key不能为空或者空字符串。key不能重复,同一个key中value不能重复,不同key对应的资源之间为与的关系。",
          "items": {
            "$ref": "#/definitions/ResourceTags"
          },
          "example": [
            {
              "key": "key1",
              "values": [
                "*value1",
                "value2"
              ]
            }
          ]
        },
        "tags_any": {
          "type": "array",
          "description": "最多包含10个key,每个key最多包含10个value,结构体不能缺失。key不能为空或者空字符串。key不能重复,同一个key中value不能重复,不同key对应的资源之间为或的关系。",
          "items": {
            "$ref": "#/definitions/ResourceTags"
          },
          "example": [
            {
              "key": "key1",
              "values": [
                "value1",
                "value2"
              ]
            }
          ]
        },
        "not_tags": {
          "type": "array",
          "description": "最多包含10个key,每个key最多包含10个value,结构体不能缺失。key不能为空或者空字符串。key不能重复,同一个key中value不能重复,不同key对应的资源之间为与非的关系。",
          "items": {
            "$ref": "#/definitions/ResourceTags"
          },
          "example": [
            {
              "key": "key1",
              "values": [
                "*value1",
                "value2"
              ]
            },
            {
              "key": "key2",
              "values": [
                "*value21",
                "value22"
              ]
            }
          ]
        },
        "not_tags_any": {
          "type": "array",
          "description": "最多包含10个key,每个key最多包含10个value,结构体不能缺失。key不能为空或者空字符串。key不能重复,同一个key中value不能重复,不同key对应的资源之间为或非的关系。",
          "items": {
            "$ref": "#/definitions/ResourceTags"
          },
          "example": [
            {
              "key": "key1",
              "values": [
                "value1",
                "value2"
              ]
            }
          ]
        },
        "offset": {
          "type": "string",
          "description": "索引位置, 从offset指定的下一条数据开始查询。 查询第一页数据时,不需要传入此参数,查询后续页码数据时,将查询前一页数据时响应体中的值带入此参数。\n\naction为count时无此参数。\n\naction为filter时,默认为0,必须为数字,且不能为负数。",
          "example": 0,
          "default": 0
        },
        "limit": {
          "type": "string",
          "description": "查询记录数。\n\naction为count时无此参数。\n\naction为filter时,默认为1000。limit最多为1000,不能为负数,最小值为1。",
          "example": 1000,
          "default": 1000
        },
        "action": {
          "type": "string",
          "description": "操作标识(仅限于filter,count):filter(过滤),count(查询总条数)。\n为filter时表示分页查询,为count只需按照条件将总条数返回即可。",
          "example": "filter"
        },
        "matches": {
          "type": "array",
          "description": "搜索字段。\n\nkey为要匹配的字段,当前只支持resource_name。\n\nvalue为匹配的值,当前为精确匹配。",
          "items": {
            "$ref": "#/definitions/TagMatch"
          },
          "example": [
            {
              "key": "resource_name",
              "value": "resource1"
            }
          ]
        },
        "without_any_tag": {
          "type": "boolean",
          "description": "不包含任意一个标签。该字段为true时查询所有不带标签的资源,此时忽略“tags”、“tags_any”、“not_tags”、“not_tags_any”字段。",
          "example": true
        }
      },
      "type": "object"
    },
    "ResourceDetail": {
      "required": [
        "enterprise_project_id",
        "detailId",
        "topic_urn",
        "display_name"
      ],
      "properties": {
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID",
          "example": "0"
        },
        "detailId": {
          "type": "string",
          "description": "详情ID",
