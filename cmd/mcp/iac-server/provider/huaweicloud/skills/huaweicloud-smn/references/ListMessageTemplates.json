{
  "name": "ListMessageTemplates",
  "summary": "查询消息模板列表",
  "tags": "模板操作",
  "productshort": "SMN",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/notifications/message_template": {
      "get": {
        "tags": [
          "模板操作"
        ],
        "operationId": "ListMessageTemplates",
        "summary": "查询消息模板列表",
        "description": "分页查询模板列表,模板列表按照创建时间进行升序排列。分页查询可以指定offset以及limit。如果不存在模板,则返回空列表。额外的查询参数分别有message_template_name和protocol。",
        "deprecated": false,
        "x-name": "查询消息模板列表",
        "x-request-examples-description-1": "查询消息模板列表",
        "x-request-examples-url-1": "GET https://{SMN_Endpoint}/v2/{project_id}/notifications/message_template?offset=0&limit=2&message_template_name=test1&protocol=email",
        "x-request-examples-1": null,
        "x-request-examples-text-1": null,
        "x-open-region-cloud": "hk,hc,hws_eu,hcso,fcs,hk_vdf,ctc,cmcc,otc,ocb,hws_ocb,g42,tm,sbc,hk_g42,hk_tm,hk_sbc,srg,ax",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-iftype": "externalAPI",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。\n\n获取项目ID请参考 [获取项目ID](smn_api_66000.xml)。",
            "required": true,
            "type": "string",
            "x-example": "2c31ed520xxxxxxebedb6e81xxxxxxxx"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,偏移量为一个大于0小于资源总个数的整数,表示查询该偏移量后面的所有的资源,默认值为0。",
            "type": "integer",
            "required": false,
            "default": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "取值范围:1~100,取值一般为10,20,50。功能说明:每页返回的资源个数。默认值为100。",
            "type": "integer",
            "required": false,
            "default": 100
          },
          {
            "name": "message_template_name",
            "in": "query",
            "description": "模板的名称。\n\n只能包含大写字母、小写字母、数字、-和_,且必须由大写字母、小写字母或数字开头,长度在1到64个字符之间。",
            "type": "string",
            "required": false,
            "x-example": "test1"
          },
          {
            "name": "protocol",
            "in": "query",
            "description": "模板支持的协议类型。\n\n目前支持的协议包括:\n\n“default”:默认协议。\n\n“email”:邮件传输协议。\n\n“sms”:短信传输协议。\n\n“functionstage”:FunctionGraph(函数)传输协议。\n\n“http”、“https”:HTTP/HTTPS传输协议。",
            "type": "string",
            "required": false,
            "x-example": "email"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListMessageTemplatesResponseBody"
            },
            "examples": {
              "application/json": {
                "request_id": "6a63a18b8bab40ffb71ebd9cb80d0085",
                "message_template_count": 3,
                "message_templates": [
                  {
                    "message_template_name": "confirm_message",
                    "protocol": "sms",
                    "update_time": "2016-08-02T08:22:18Z",
                    "create_time": "2016-08-02T08:22:18Z",
                    "tag_names": [
                      "topic_urn"
                    ],
                    "message_template_id": "79227dfdf88d4e52a1820ca1eb411635"
                  },
                  {
                    "message_template_name": "confirm_message",
                    "protocol": "email",
                    "update_time": "2016-08-02T08:22:19Z",
                    "create_time": "2016-08-02T08:22:19Z",
                    "tag_names": [
                      "topic_id"
                    ],
                    "message_template_id": "ecf63465804a4b10a0573980be78ffba"
                  },
                  {
                    "message_template_name": "confirm_message",
                    "protocol": "https",
                    "update_time": "2016-08-02T08:22:20Z",
                    "create_time": "2016-08-02T08:22:20Z",
                    "tag_names": [
                      "topic_id"
                    ],
                    "message_template_id": "57ba8dcecda844878c5dd5815b65d10f"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "403": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "FailedResp": {
      "required": [
        "request_id",
        "code",
        "message"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "example": "6a63a18b8bab40ffb71ebd9cb80d0085"
        },
        "code": {
          "type": "string",
          "description": "服务异常错误信息编码。",
          "example": "SMN.0167"
        },
        "message": {
          "type": "string",
          "description": "服务异常错误信息描述。",
          "example": "xxxxxxxx"
        }
      }
    },
    "ListMessageTemplatesResponseBody": {
      "required": [
        "request_id",
        "message_template_count",
        "message_templates"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "example": "5fcba32bd2814ea39431829c22bda94b"
        },
        "message_template_count": {
          "type": "integer",
          "description": "返回的模板个数。",
          "example": 3
        },
        "message_templates": {
          "type": "array",
          "description": "Message_template结构体数组。",
          "items": {
            "$ref": "#/definitions/MessageTemplate"
          }
        }
      }
    },
    "MessageTemplate": {
      "required": [
        "message_template_id",
        "message_template_name",
        "protocol",
        "tag_names",
        "create_time",
        "update_time"
      ],
      "properties": {
        "message_template_id": {
          "type": "string",
          "description": "模板ID。",
          "example": "79227dfdf88d4e52a1820ca1eb411635"
        },
        "message_template_name": {
          "type": "string",
          "description": "模板名称。",
          "example": "confirm_message"
        },
        "protocol": {
          "type": "string",
          "description": "模板协议类型。\n\n目前支持的协议包括:\n\n“email”:邮件传输协议。\n\n“sms”:短信传输协议。\n\n“functionstage”:FunctionGraph(函数)传输协议。\n\n“http”、“https”:HTTP/HTTPS传输协议。",
          "example": "https"
        },
        "tag_names": {
          "type": "array",
          "description": "模板tag列表",
          "example": [
            "topic_urn"
          ],
          "items": {
            "type": "string"
          }
        },
        "create_time": {
          "type": "string",
          "description": "模板创建时间 时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。",
          "example": "2016-08-02T08:22:18Z"
        },
        "update_time": {
          "type": "string",
          "description": "模板最后更新时间 时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。",
          "example": "2016-08-02T08:22:18Z"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "smn.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
