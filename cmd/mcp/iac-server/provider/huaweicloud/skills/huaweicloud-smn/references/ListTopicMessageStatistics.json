            "type": "string",
            "x-example": "2c31ed520xxxxxxebedb6e81xxxxxxxx"
          },
          {
            "name": "topic_urn",
            "in": "path",
            "description": "Topic的唯一的资源标识,可通过[查询主题列表](smn_api_51004.xml)获取该标识。",
