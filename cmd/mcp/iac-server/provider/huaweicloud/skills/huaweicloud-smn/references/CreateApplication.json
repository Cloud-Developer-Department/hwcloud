  "definitions": {
    "FailedResp": {
      "required": [
        "request_id",
        "code",
        "message"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "example": "6a63a18b8bab40ffb71ebd9cb80d0085"
        },
        "code": {
          "type": "string",
          "description": "服务异常错误信息编码。",
          "example": "SMN.0167"
        },
        "message": {
          "type": "string",
          "description": "服务异常错误信息描述。",
          "example": "xxxxxxxx"
        }
      }
    },
    "CreateApplicationRequestBody": {
      "required": [
        "name",
        "platform",
        "platform_principal",
        "platform_credential"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "应用名。\n\n最大支持64个字符,只能包含英文字母、下划线和数字。",
          "example": "application_name"
        },
        "platform": {
          "type": "string",
          "description": "应用平台。\n\n目前仅支持HMS、APNS、APNS_SANDBOX。\n\nHMS是为开发者提供的消息推送平台。\n\nAPNS和APNS_SANDBOX是用于推送iOS消息的服务平台。",
          "example": "HMS"
        },
        "platform_principal": {
          "type": "string",
          "description": "对于HMS平台是APP ID,只能包含英文字母和数字,最大20个字符。\n对于苹果APNS、APNS_SandBox平台是推送证书,大小不超过8K,且是Base64编码。",
          "example": "appId"
        },
        "platform_credential": {
          "type": "string",
          "description": "对于HMS平台是APP SECRET,\n只能包含英文字母和数字,32到64个字符。\n\n对于苹果APNS、APNS_SandBox平台是推送证书的私钥(private key),\n大小不超过8K,且是Base64编码。",
          "example": "appSecret"
        }
      }
    },
    "CreateApplicationResponseBody": {
      "required": [
        "request_id",
        "application_urn",
        "application_id"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "example": "6a63a18b8bab40ffb71ebd9cb80d0085"
        },
        "application_urn": {
          "type": "string",
          "description": "Application的唯一资源标识。",
          "example": "urn:smn:regionId:f96188c7ccaf4ffba0c9aa149ab2bd57:app-HMS-application_name"
        },
        "application_id": {
          "type": "string",
          "description": "Application资源的ID。",
          "example": "55ccc684db07448aa53562ce23348273"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
