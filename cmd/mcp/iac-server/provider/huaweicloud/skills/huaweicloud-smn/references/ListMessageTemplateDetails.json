        "tag_names",
        "create_time",
        "update_time",
        "content",
        "request_id"
      ],
      "properties": {
        "message_template_id": {
          "type": "string",
          "description": "模板ID。",
          "example": "57ba8dcecda844878c5dd5815b65d10f"
        },
        "message_template_name": {
          "type": "string",
          "description": "模板名称。",
          "example": "confirm_message"
        },
        "protocol": {
          "type": "string",
          "description": "模板支持的协议类型。\n\n目前支持的协议包括:\n\n“default”:默认协议。\n\n“email”:邮件传输协议。\n\n“sms”:短信传输协议。\n\n“functionstage”:FunctionGraph(函数)传输协议。\n\n“http”、“https”:HTTP/HTTPS传输协议。",
          "example": "https"
        },
        "tag_names": {
          "type": "array",
          "description": "模板tag列表。\n\n是消息模板“{}”内的字段,在具体使用消息模板时,可根据实际情况替为该字段赋值。",
          "items": {
            "type": "string"
          },
          "example": [
            "topic_id_id4"
          ]
        },
        "create_time": {
          "type": "string",
          "description": "模板创建时间。 时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。",
          "example": "2016-08-02T08:22:20Z"
        },
        "update_time": {
          "type": "string",
          "description": "模板最后更新时间。时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。",
          "example": "2016-08-02T08:22:25Z"
        },
        "content": {
          "type": "string",
          "description": "模板内容。",
          "example": "(1/24)You are invited to subscribe to topic({topic_id_id4}). Click the following URL to confirm subscription:(If you do not want to subscribe to this topic, ignore this message.)"
        },
