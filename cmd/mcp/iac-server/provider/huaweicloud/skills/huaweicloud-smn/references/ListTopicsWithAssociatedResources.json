{
  "name": "ListTopicsWithAssociatedResources",
  "summary": "查询主题列表及主题关联资源信息",
  "tags": "主题操作",
  "productshort": "SMN",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/notifications/topics-with-associated-resources": {
      "get": {
        "tags": [
          "主题操作"
        ],
        "operationId": "ListTopicsWithAssociatedResources",
        "summary": "查询主题列表及主题关联资源信息",
        "description": "查询Topic及Topic关联资源信息列表,关联资源信息随业务演进会持续扩展。Topic列表默认按照创建时间进行降序排列。分页查询可以指定offset以及limit。如果不存在Topic,则返回空列表。",
        "deprecated": false,
        "x-name": "查询主题列表及主题关联资源信息",
        "x-request-examples-description-1": "查询主题列表及主题关联资源信息",
        "x-request-examples-url-1": "GET https://{SMN_Endpoint}/v2/{project_id}/notifications/topics-with-associated-resources?offset=0&limit=100",
        "x-open-region-cloud": "hk,hc",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-iftype": "externalAPI",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。\n\n获取项目ID请参考 [获取项目ID](smn_api_66000.xml)。",
            "required": true,
            "type": "string",
            "x-example": "2c31ed520xxxxxxebedb6e81xxxxxxxx"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量。\n\n偏移量为一个大于0小于资源总个数的整数,表示查询该偏移量后面的所有的资源,默认值为0。",
            "type": "integer",
            "required": false,
            "default": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询的数量限制。\n\n取值范围:1~100,取值一般为10,20,50。功能说明:每页返回的资源个数。默认值为100。",
            "type": "integer",
            "required": false,
            "default": 100
          },
          {
            "name": "topic_id",
            "in": "query",
            "description": "检索的主题ID,完全匹配。",
            "type": "string",
            "required": false
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目id。",
            "type": "string",
            "required": false
          },
          {
            "name": "name",
            "in": "query",
            "description": "检索的主题名称,完全匹配。",
            "type": "string",
            "required": false
          },
          {
            "name": "fuzzy_name",
            "in": "query",
            "description": "检索的主题名称,模糊匹配。",
            "type": "string",
            "required": false,
            "pattern": "^[-_a-zA-Z0-9]{0,255}$",
            "allowEmptyValue": true
          },
          {
            "name": "fuzzy_display_name",
            "in": "query",
            "required": false,
            "description": "检索的主题显示名。模糊匹配。参数字节长度不能大于192字节。",
            "type": "string",
            "allowEmptyValue": true
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListTopicsWithAssociatedResourcesResponseBody"
            },
            "examples": {
              "application/json": {
                "request_id": "6a63a18b8bab40ffb71ebd9cb80d0085",
                "topic_count": 1,
                "topics": [
                  {
                    "topic_urn": "urn:smn:regionId:8bad8a40e0f7462f8c1676e3f93a8183:test_topic_v2",
                    "display_name": "testtest",
                    "name": "test_topic_v1",
                    "push_policy": 0,
                    "enterprise_project_id": "0",
                    "topic_id": "84698185946d44d08431aa441d8e2cf2",
                    "create_time": "2016-08-02T08:22:18Z",
                    "update_time": "2016-08-02T08:22:18Z",
                    "tags": [
                      {
                        "key": "key1",
                        "value": "value1"
                      },
                      {
                        "key": "key2",
                        "value": "value3"
                      }
                    ],
                    "attributes": {
                      "access_policy": "{\"Version\":\"2016-09-07\",\"Id\":\"__default_policy_ID\",\"Statement\":[{\"Sid\":\"__user_pub_0\",\"Effect\":\"Allow\",\"Principal\":[{\"CSP\":[\"urn:csp:iam::93dc1b4697ac493d9b7d089569f86b32:root\"]}],\"Action\":[\"SMN:Publish\",\"SMN:QueryTopicDetail\"],\"Resource\":\"urn:smn:regionId:8bad8a40e0f7462f8c1676e3f93a8183:aaa\"},{\"Sid\":\"__org_path_pub_0\",\"Effect\":\"Allow\",\"Principal\":{\"OrgPath\":[\"o-bf966fe82ebb4d35d68b791729228788/r-001ebf32880a13eabfc8e1c37eee3ae9/ou-0dbfffe92fd92ddb35feff9b4079459c\"]},\"Action\":[\"SMN:Publish\",\"SMN:QueryTopicDetail\"],\"Resource\":\"urn:smn:regionId:8bad8a40e0f7462f8c1676e3f93a8183:aaa\"},{\"Sid\":\"__service_pub_0\",\"Effect\":\"Allow\",\"Principal\":{\"Service\":[\"obs\"]},\"Action\":[\"SMN:Publish\",\"SMN:QueryTopicDetail\"],\"Resource\":\"urn:smn:regionId:8bad8a40e0f7462f8c1676e3f93a8183:aaa\"}]}",
                      "create_time": "2016-08-01T02:16:38",
                      "update_time": "2016-08-01T02:16:38"
                    },
                    "logtanks": [
                      {
                        "id": "4ea80c8a68b840e19b4efd3a8f0d62ed",
                        "log_group_id": "d1b6c352-ee45-4196-9230-c74b7894e356",
                        "log_stream_id": "114960b4-1c26-48dd-93c2-4caae24aec49",
                        "create_time": "2022-10-10T09:00:00Z",
                        "update_time": "2022-10-10T09:00:00Z"
                      }
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "403": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ListTopicsWithAssociatedResourcesResponseBody": {
      "required": [
        "request_id",
        "topic_count",
        "topics"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。"
        },
        "topic_count": {
          "type": "integer",
          "description": "返回的Topic个数。该参数不受offset和limit影响,即返回的是您账户下所有的Topic个数。"
        },
        "topics": {
          "type": "array",
          "description": "Topic及关联资源信息结构体数组。",
          "items": {
            "$ref": "#/definitions/ListTopicsWithAssociatedResourcesItem"
          }
        }
      },
      "type": "object"
    },
    "FailedResp": {
      "required": [
        "request_id",
        "code",
        "message"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "example": "6a63a18b8bab40ffb71ebd9cb80d0085"
        },
        "code": {
          "type": "string",
          "description": "服务异常错误信息编码。",
          "example": "SMN.0167"
        },
        "message": {
          "type": "string",
          "description": "服务异常错误信息描述。",
          "example": "xxxxxxxx"
        }
      }
    },
    "ListTopicsWithAssociatedResourcesItem": {
      "required": [
        "topic_urn",
        "name",
        "display_name",
        "push_policy",
        "enterprise_project_id",
        "topic_id",
        "create_time",
        "update_time",
        "tags",
        "attributes",
        "logtanks"
      ],
      "properties": {
        "topic_urn": {
          "type": "string",
          "description": "Topic的唯一的资源标识。"
        },
        "name": {
          "type": "string",
          "description": "创建topic的名字。"
        },
        "display_name": {
          "type": "string",
          "description": "Topic的显示名,推送邮件消息时,作为邮件发件人显示。"
        },
        "push_policy": {
          "type": "integer",
          "description": "消息推送的策略,该属性目前不支持修改,后续将支持修改。0表示发送失败,保留到失败队列,1表示直接丢弃发送失败的消息。"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。"
        },
        "topic_id": {
          "type": "string",
          "description": "主题ID。"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间。时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。"
        },
        "update_time": {
          "type": "string",
          "description": "更新时间。时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceTag"
          },
          "description": "资源标签列表。"
        },
        "attributes": {
          "description": "主题策略属性。",
          "$ref": "#/definitions/TopicAccessPolicyAttribute"
        },
        "logtanks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LogtankItem"
          },
          "description": "云日志信息列表。"
        }
      },
      "type": "object"
    },
    "LogtankItem": {
      "type": "object",
      "description": "云日志信息",
      "required": [
        "id",
        "log_group_id",
        "log_stream_id",
        "create_time",
        "update_time"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "云日志信息唯一的资源标识。",
          "example": "4ea80c8a68b840e19b4efd3a8f0d62ed",
          "minLength": 32,
          "maxLength": 32
        },
        "log_group_id": {
          "type": "string",
          "description": "云日志服务日志组ID。",
          "minLength": 36,
          "maxLength": 36,
          "example": "d1b6c352-ee45-4196-9230-c74b7894e356"
        },
        "log_stream_id": {
          "type": "string",
          "description": "云日志服务日志流ID。",
          "minLength": 36,
          "maxLength": 36,
          "example": "114960b4-1c26-48dd-93c2-4caae24aec49"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间。时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。",
          "example": "2022-10-10T09:00:00Z"
        },
        "update_time": {
          "type": "string",
          "description": "更新时间。时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。",
          "example": "2022-10-10T09:00:00Z"
        }
      }
    },
    "ResourceTag": {
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "键。\n\n- 最大长度127个unicode字符。\n\n- key不能为空。",
          "example": "key"
        },
        "value": {
          "type": "string",
          "description": "值。\n\n- 每个值最大长度255个unicode字符。",
          "example": "value"
        }
      },
      "description": "资源标签结构体。",
      "type": "object"
    },
    "TopicAccessPolicyAttribute": {
      "type": "object",
      "properties": {
        "access_policy": {
          "description": "topic的访问策略",
          "example": "{\\\"Version\\\":\\\"2016-09-07\\\",\\\"Id\\\":\\\"__default_policy_ID\\\",\\\"Statement\\\":[{\\\"Sid\\\":\\\"__user_pub_0\\\",\\\"Effect\\\":\\\"Allow\\\",\\\"Principal\\\":[{\\\"CSP\\\":[\\\"urn:csp:iam::93dc1b4697ac493d9b7d089569f86b32:root\\\"]}],\\\"Action\\\":[\\\"SMN:Publish\\\",\\\"SMN:QueryTopicDetail\\\"],\\\"Resource\\\":\\\"urn:smn:regionId:8bad8a40e0f7462f8c1676e3f93a8183:aaa\\\"},{\\\"Sid\\\":\\\"__org_path_pub_0\\\",\\\"Effect\\\":\\\"Allow\\\",\\\"Principal\\\":{\\\"OrgPath\\\":[\\\"o-bf966fe82ebb4d35d68b791729228788/r-001ebf32880a13eabfc8e1c37eee3ae9/ou-0dbfffe92fd92ddb35feff9b4079459c\\\"]},\\\"Action\\\":[\\\"SMN:Publish\\\",\\\"SMN:QueryTopicDetail\\\"],\\\"Resource\\\":\\\"urn:smn:regionId:8bad8a40e0f7462f8c1676e3f93a8183:aaa\\\"},{\\\"Sid\\\":\\\"__service_pub_0\\\",\\\"Effect\\\":\\\"Allow\\\",\\\"Principal\\\":{\\\"Service\\\":[\\\"obs\\\"]},\\\"Action\\\":[\\\"SMN:Publish\\\",\\\"SMN:QueryTopicDetail\\\"],\\\"Resource\\\":\\\"urn:smn:regionId:8bad8a40e0f7462f8c1676e3f93a8183:aaa\\\"}]}",
          "type": "string"
        },
        "create_time": {
          "type": "string",
          "description": "topic的访问策略创建时间。时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。"
        },
        "update_time": {
          "type": "string",
          "description": "topic的访问策略更新时间。时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
