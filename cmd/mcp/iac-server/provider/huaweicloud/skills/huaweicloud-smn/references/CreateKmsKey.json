          "description": "在DEW服务上创建的用户主密钥对应的密钥ID,具体参考在DEW服务上创建密钥章节。",
          "maxLength": 36,
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$",
