{
  "name": "CreateMessageTemplate",
  "summary": "创建消息模板",
  "tags": "模板操作",
  "productshort": "SMN",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/notifications/message_template": {
      "post": {
        "tags": [
          "模板操作"
        ],
        "operationId": "CreateMessageTemplate",
        "summary": "创建消息模板",
        "description": "创建一个模板,用户可以按照模板去发送消息,这样可以减少请求的数据量。\n单用户默认可创建100个消息模板,高并发场景下,可能会出现消息模板数量超过100仍创建成功的情况,此为正常现象。",
        "deprecated": false,
        "x-name": "创建消息模板",
        "x-request-examples-description-1": "创建模板名称为confirm_message,且模板支持的协议类型为https的消息模板\n",
        "x-request-examples-url-1": "POST https://{SMN_Endpoint}/v2/{project_id}/notifications/message_template",
        "x-request-examples-1": {
          "message_template_name": "confirm_message",
          "protocol": "https",
          "content": "(1/2)You are invited to subscribe to topic({topic_id}). Click the following URL to confirm subscription:(If you do not want to subscribe to this topic, ignore this message.)"
        },
        "x-request-examples-text-1": {
          "message_template_name": "confirm_message",
          "protocol": "https",
          "content": "(1/2)You are invited to subscribe to topic({topic_id}). Click the following URL to confirm subscription:(If you do not want to subscribe to this topic, ignore this message.)"
        },
        "x-open-region-cloud": "hk,hc,hws_eu,hcso,fcs,hk_vdf,ctc,cmcc,otc,ocb,hws_ocb,g42,tm,sbc,hk_g42,hk_tm,hk_sbc,srg,ax",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-iftype": "externalAPI",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。\n\n获取项目ID请参考 [获取项目ID](smn_api_66000.xml)。",
            "required": true,
            "type": "string",
            "x-example": "2c31ed520xxxxxxebedb6e81xxxxxxxx"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "in": "body",
            "name": "CreateMessageTemplateRequestBody",
            "schema": {
              "$ref": "#/definitions/CreateMessageTemplateRequestBody"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/CreateMessageTemplateResponseBody"
            },
            "examples": {
              "application/json": {
                "request_id": "6a63a18b8bab40ffb71ebd9cb80d0085",
                "message_template_id": "57ba8dcecda844878c5dd5815b65d10f"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "403": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "FailedResp": {
      "required": [
        "request_id",
        "code",
        "message"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "example": "6a63a18b8bab40ffb71ebd9cb80d0085"
        },
        "code": {
          "type": "string",
          "description": "服务异常错误信息编码。",
          "example": "SMN.0167"
        },
        "message": {
          "type": "string",
          "description": "服务异常错误信息描述。",
          "example": "xxxxxxxx"
        }
      }
    },
    "CreateMessageTemplateRequestBody": {
      "required": [
        "message_template_name",
        "content"
      ],
      "properties": {
        "message_template_name": {
          "type": "string",
          "description": "创建模板的名称。只能包含大写字母、小写字母、数字、-和_,且必须由大写字母、小写字母或数字开头,长度在1到64个字符之间。",
          "example": "confirm_message"
        },
        "protocol": {
          "type": "string",
          "description": "模板支持的协议类型。\n\n目前支持的协议包括:\n\n“default”:默认协议。\n\n“email”:邮件传输协议。\n\n“sms”:短信传输协议。\n\n“functionstage”:FunctionGraph(函数)传输协议。\n\n“http”、“https”:HTTP/HTTPS传输协议。",
          "example": "https"
        },
        "content": {
          "type": "string",
          "description": "模板内容,模板目前仅支持纯文本模式。模板内容不能空,最大支持256KB。",
          "example": "(1/2)You are invited to subscribe to topic({topic_id}). Click the following URL to confirm subscription:(If you do not want to subscribe to this topic, ignore this message.)"
        }
      },
      "type": "object"
    },
    "CreateMessageTemplateResponseBody": {
      "required": [
        "request_id",
        "message_template_id"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "example": "ca03efa691624d8eb2dfeba01a1bcf6e"
        },
        "message_template_id": {
          "type": "string",
          "description": "模板唯一的资源标识。",
          "example": "57ba8dcecda844878c5dd5815b65d10f"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "smn.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}