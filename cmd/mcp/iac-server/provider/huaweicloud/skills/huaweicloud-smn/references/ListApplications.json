{
  "name": "ListApplications",
  "summary": "查询Application",
  "tags": "Application操作",
  "productshort": "SMN",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/notifications/applications": {
      "get": {
        "tags": [
          "Application操作"
        ],
        "operationId": "ListApplications",
        "summary": "查询Application",
        "description": "查询应用平台列表。",
        "deprecated": true,
        "x-name": "查询Application",
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://{SMN_Endpoint}/v2/{project_id}/notifications/applications?offset=0&limit=100&name=application_name&platform=APNS",
        "x-request-examples-1": null,
        "x-request-examples-text-1": null,
        "x-open-region-cloud": "hk,hc",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-iftype": "externalAPI",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。\n\n获取项目ID请参考 [获取项目ID](smn_api_66000.xml)。",
            "required": true,
            "type": "string",
            "x-example": "2c31ed520xxxxxxebedb6e81xxxxxxxx"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量。\n\n偏移量为一个大于0小于资源总个数的整数,表示查询该偏移量后面的所有的资源,默认值为0。",
            "type": "integer",
            "required": false,
            "default": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询的数量限制。\n\n取值范围:1~100,取值一般为10,20,50。功能说明:每页返回的资源个数。默认值为100。",
            "type": "integer",
            "required": false,
            "default": 100
          },
          {
            "name": "name",
            "in": "query",
            "description": "检索应用名称。\n\n支持后向模糊匹配,长度不得超过64个字符,只能包含英文字母、下划线和数字。",
            "required": false,
            "type": "string",
            "x-example": "application_name"
          },
          {
            "name": "platform",
            "in": "query",
            "description": "应用平台。\n\n目前仅支持HMS、APNS、APNS_SANDBOX。\n\nHMS是为开发者提供的消息推送平台。\n\nAPNS和APNS_SANDBOX是用于推送iOS消息的服务平台。",
            "required": false,
            "type": "string",
            "x-example": "HMS"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListApplicationsResponseBody"
            },
            "examples": {
              "application/json": {
                "request_id": "6a63a18b8bab40ffb71ebd9cb80d0085",
                "application_count": 2,
                "applications": [
