  "definitions": {
    "FailedResp": {
      "required": [
        "request_id",
        "code",
        "message"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "example": "6a63a18b8bab40ffb71ebd9cb80d0085"
        },
        "code": {
          "type": "string",
          "description": "服务异常错误信息编码。",
          "example": "SMN.0167"
        },
        "message": {
          "type": "string",
          "description": "服务异常错误信息描述。",
          "example": "xxxxxxxx"
        }
      }
    },
    "ApplicationItem": {
      "required": [
        "name",
        "platform",
        "create_time",
        "application_urn",
        "application_id",
        "enabled"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "创建application的名字。"
        },
        "platform": {
          "type": "string",
          "description": "应用平台。"
        },
        "create_time": {
          "type": "string",
          "description": "创建application的时间。时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。"
        },
        "application_urn": {
          "type": "string",
          "description": "Application的唯一资源标识。"
        },
        "application_id": {
          "type": "string",
          "description": "Application的唯一标识ID。"
        },
        "enabled": {
          "type": "string",
          "description": "应用平台是否启用。"
        },
        "apple_certificate_expiration_date": {
          "type": "string",
          "description": "苹果证书过期时间APNS、APNS_SANDBOX平台特有属性时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。"
        }
      }
    },
    "ListApplicationsResponseBody": {
      "required": [
        "request_id",
        "application_count",
        "applications"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。"
        },
        "application_count": {
          "type": "integer",
          "description": "返回的Application个数。该参数不受offset和limit影响,即返回的是您账户下所有的Application个数。"
        },
        "applications": {
          "type": "array",
          "description": "Application列表。",
          "items": {
            "$ref": "#/definitions/ApplicationItem"
          }
        }
      }
    }
