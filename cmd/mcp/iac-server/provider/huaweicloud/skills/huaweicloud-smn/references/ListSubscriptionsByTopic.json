{
  "name": "ListSubscriptionsByTopic",
  "summary": "查询指定Topic的订阅者列表",
  "tags": "订阅操作",
  "productshort": "SMN",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/notifications/topics/{topic_urn}/subscriptions": {
      "get": {
        "tags": [
          "订阅操作"
        ],
        "operationId": "ListSubscriptionsByTopic",
        "summary": "查询指定Topic的订阅者列表",
        "description": "分页获取特定Topic的订阅列表,订阅列表按照订阅创建时间进行升序排列。分页查询可以指定offset以及limit。如果指定Topic不存在订阅者,返回空列表。",
        "deprecated": false,
        "x-name": "查询指定Topic的订阅者列表",
        "x-request-examples-description-1": "查询名称为test_topic_v2的主题的订阅者列表",
        "x-request-examples-url-1": "GET https://{SMN_Endpoint}/v2/{project_id}/notifications/topics/urn:smn:regionId:762bdb3251034f268af0e395c53ea09b:test_topic_v1/subscriptions?offset=0&limit=100",
        "x-request-examples-1": null,
        "x-request-examples-text-1": null,
        "x-open-region-cloud": "hk,hc,hws_eu,hcso,fcs,hk_vdf,ctc,cmcc,otc,ocb,hws_ocb,g42,tm,sbc,hk_g42,hk_tm,hk_sbc,srg,ax",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-iftype": "externalAPI",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。\n\n获取项目ID请参考 [获取项目ID](smn_api_66000.xml)。",
            "required": true,
            "type": "string",
            "x-example": "2c31ed520xxxxxxebedb6e81xxxxxxxx"
          },
          {
            "name": "topic_urn",
            "in": "path",
            "description": "Topic的唯一的资源标识,可通过[查询主题列表](smn_api_51004.xml)获取该标识。",
            "required": true,
            "type": "string",
            "x-example": "urn:smn:regionId:f96188c7ccaf4ffba0c9aa149ab2bd57:test_topic_v2"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量。\n\n偏移量为一个大于0小于资源总个数的整数,表示查询该偏移量后面的所有的资源,默认值为0。",
            "type": "integer",
            "required": false,
            "default": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询的数量限制。\n\n取值范围:1~100,取值一般为10,20,50。功能说明:每页返回的资源个数。默认值为100。",
            "type": "integer",
            "required": false,
            "default": 100
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "name": "fuzzy_remark",
            "in": "query",
            "required": false,
            "description": "检索的订阅备注字段,模糊匹配。最大长度限制为128字节。",
            "type": "string",
            "pattern": "^[^+]$"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListSubscriptionsResponseBody"
            },
            "examples": {
              "application/json": {
                "request_id": "6a63a18b8bab40ffb71ebd9cb80d0085",
                "subscription_count": 2,
                "subscriptions": [
                  {
                    "topic_urn": "urn:smn:regionId:762bdb3251034f268af0e395c53ea09b:test_topic_v1",
                    "protocol": "sms",
                    "subscription_urn": "urn:smn:regionId:762bdb3251034f268af0e395c53ea09b:test_topic_v1:2e778e84408e44058e6cbc6d3c377837",
                    "owner": "762bdb3251034f268af0e395c53ea09b",
                    "endpoint": "xxxxxxxxxxx",
                    "remark": "",
                    "status": 0,
                    "filter_polices": [
                      {
                        "name": "alarm",
                        "string_equals": [
                          "os",
                          "process"
                        ]
                      },
                      {
                        "name": "service",
                        "string_equals": [
                          "api",
                          "db"
                        ]
                      }
                    ]
                  },
                  {
                    "topic_urn": "urn:smn:regionId:762bdb3251034f268af0e395c53ea09b:test_topic_v1",
                    "protocol": "email",
                    "subscription_urn": "urn:smn:regionId:762bdb3251034f268af0e395c53ea09b:test_topic_v1:a2d52a9f5c3b47f48c3fafb177a58796",
                    "owner": "762bdb3251034f268af0e395c53ea09b",
                    "endpoint": "xx@example.com",
                    "remark": "",
                    "status": 0,
                    "filter_polices": [
                      {
                        "name": "alarm",
                        "string_equals": [
                          "os",
                          "process"
                        ]
                      },
                      {
                        "name": "service",
                        "string_equals": [
                          "api",
                          "db"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "403": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "FailedResp": {
      "required": [
        "request_id",
        "code",
        "message"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "example": "6a63a18b8bab40ffb71ebd9cb80d0085"
        },
        "code": {
          "type": "string",
          "description": "服务异常错误信息编码。",
          "example": "SMN.0167"
        },
        "message": {
          "type": "string",
          "description": "服务异常错误信息描述。",
          "example": "xxxxxxxx"
        }
      }
    },
    "SubscriptionsFilterPolicy": {
      "type": "object",
      "description": "过滤策略。",
      "properties": {
        "name": {
          "type": "string",
          "description": "过滤策略名称。\n包含小写英文字母([a-z])、数字([0-9])、下划线(_),下划线不得开始、结尾或连续出现),长度限制{1,32},不能是smn_开头。",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(?!smn_)(?!.*?_$)(?!^_)(?!.*?__)[a-z0-9_]{1,32}$"
        },
        "string_equals": {
          "type": "array",
          "description": "字符串精确匹配数组。数组长度[1, 10],数组内容不能重复,值不能为null或者空字符串“ ”,长度限制[1,32],中英文、数字、下划线",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[\\一-\\龥A-Za-z0-9_]{1,32}$"
          },
          "minItems": 1,
          "maxItems": 10
        }
      },
      "required": [
        "name",
        "string_equals"
      ]
    },
    "ListSubscriptionsItem": {
      "required": [
        "topic_urn",
        "protocol",
        "subscription_urn",
        "owner",
        "endpoint",
        "remark",
        "status"
      ],
      "properties": {
        "topic_urn": {
          "type": "string",
          "description": "Topic的唯一的资源标识。"
        },
        "protocol": {
          "type": "string",
          "description": "不同协议对应不同的endpoint(接受消息的接入点)。目前支持的协议包括:\n\n\"default\": 默认协议。\n\n“email”:邮件传输协议,endpoint为邮箱地址。\n\n“sms”:短信传输协议,endpoint为手机号码。\n\n“functionstage”:FunctionGraph(函数)传输协议,endpoint为一个函数。\n\n“http”、“https”:HTTP/HTTPS传输协议,endpoint为URL。"
        },
        "subscription_urn": {
          "type": "string",
          "description": "订阅者的唯一资源标识。"
        },
        "owner": {
          "type": "string",
          "description": "Topic创建者的项目ID。"
        },
        "endpoint": {
          "type": "string",
          "description": "接受消息的接入点。"
        },
        "remark": {
          "type": "string",
          "description": "备注。"
        },
        "status": {
          "type": "integer",
          "description": "订阅者状态:0表示订阅还未确认,1表示已经确认,3表示已经取消确认。"
        },
        "filter_polices": {
          "items": {
            "$ref": "#/definitions/SubscriptionsFilterPolicy"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ListSubscriptionsResponseBody": {
      "required": [
        "request_id",
        "subscription_count",
        "subscriptions"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。"
        },
        "subscription_count": {
          "type": "integer",
          "description": "订阅者个数。"
        },
        "subscriptions": {
          "type": "array",
          "description": "Subscription结构体。",
          "items": {
            "$ref": "#/definitions/ListSubscriptionsItem"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "smn.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}