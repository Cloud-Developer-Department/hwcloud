{
  "name": "ShowHttpDetectResult",
  "summary": "获取http探测结果",
  "tags": "发布消息操作",
  "productshort": "SMN",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/notifications/topics/{topic_urn}/detection/{task_id}": {
      "get": {
        "x-request-examples-url-1": "GET https://{SMN_Endpoint}/v2/{project_id}/notifications/topics/urn:smn:regionId:f96188c7ccaf4ffba0c9aa149ab2bd57:test_create_topic_v2/detect/c414cfd4326a488e9c6a315ce8dc5fe3",
        "x-request-examples-description-1": "正确查询的示例",
        "x-name": "获取http探测结果",
        "x-open-region-cloud": "hk,hc,hws_eu,g42,hk_g42,tm,hk_tm,sbc,hk_sbc",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-iftype": "externalAPI",
        "tags": [
          "发布消息操作"
        ],
        "summary": "获取http探测结果",
        "description": "根据http探测发送返回的task_id查询探测结果。",
        "operationId": "ShowHttpDetectResult",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID。 获取项目ID请参考 [获取项目ID](smn_api_66000.xml)。"
          },
          {
            "name": "topic_urn",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Topic的唯一的资源标识,可通过[查询主题列表](smn_api_51004.xml)获取该标识。"
          },
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "http探测任务id"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "responses": {
          "200": {
            "description": "获取http探测正确返回体",
            "schema": {
              "$ref": "#/definitions/GetHttpDetectResponseBody"
            },
            "examples": {
              "application/json": {
                "detail": {
                  "httpCode": 200,
                  "httpResponse": "Http endpoint is available."
                },
                "status": 0,
                "request_id": "e4bde8f67bd64402804011160c9f8772"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "403": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "FailedResp": {
      "required": [
        "request_id",
        "code",
        "message"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "example": "6a63a18b8bab40ffb71ebd9cb80d0085"
        },
        "code": {
          "type": "string",
          "description": "服务异常错误信息编码。",
          "example": "SMN.0167"
        },
        "message": {
          "type": "string",
          "description": "服务异常错误信息描述。",
          "example": "xxxxxxxx"
        }
      }
    },
    "GetHttpDetectResponseBody": {
      "type": "object",
      "description": "http终端探测结果",
      "required": [
        "detail",
        "status",
        "request_id"
      ],
      "properties": {
        "detail": {
          "description": "终端探测详情",
          "required": [
            "httpCode",
            "httpResponse"
          ],
          "properties": {
            "httpCode": {
              "type": "integer",
              "format": "int32",
              "example": 200,
              "description": "探测终端返回的http返回码,0代表用户在黑名单无法发送,-1代表用户终端超过5秒未响应,-2代表队列已满,Http探测任务未执行。其他httpcode为终端实际返回值。"
            },
            "httpResponse": {
              "type": "string",
              "example": "Http endpoint is available.",
              "description": "终端探测响应体,如果httpCode为0,-1,-2, 2xx时响应体内容固定,由SMN定义。其余httpCode的响应体内容为终端返回内容。"
            }
          }
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "http探测任务状态,0代表执行成功,终端可用,1代表未执行,2代表执行失败,终端不可用",
          "enum": [
            0,
            1,
            2
          ]
        },
        "request_id": {
          "type": "string",
          "example": "2a13af94ada84f06817afabfe35b89de",
          "description": "请求ID"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "smn.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}