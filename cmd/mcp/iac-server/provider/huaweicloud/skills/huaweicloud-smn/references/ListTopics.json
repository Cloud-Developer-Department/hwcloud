{
  "name": "ListTopics",
  "summary": "查询主题列表",
  "tags": "主题操作",
  "productshort": "SMN",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/notifications/topics": {
      "get": {
        "tags": [
          "主题操作"
        ],
        "operationId": "ListTopics",
        "summary": "查询主题列表",
        "description": "分页查询Topic列表,Topic列表按照Topic创建时间进行降序排列。分页查询可以指定offset以及limit。如果不存在Topic,则返回空列表。",
        "deprecated": false,
        "x-name": "查询主题列表",
        "x-request-examples-description-1": "查询主题列表",
        "x-request-examples-url-1": "GET https://{SMN_Endpoint}/v2/{project_id}/notifications/topics?offset=0&limit=100",
        "x-request-examples-1": null,
        "x-request-examples-text-1": null,
        "x-open-region-cloud": "hk,hc,hws_eu,hcso,fcs,hk_vdf,ctc,cmcc,otc,ocb,hws_ocb,g42,tm,sbc,hk_g42,hk_tm,hk_sbc,srg,ax",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-iftype": "externalAPI",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。\n\n获取项目ID请参考 [获取项目ID](smn_api_66000.xml)。",
            "required": true,
            "type": "string",
            "x-example": "2c31ed520xxxxxxebedb6e81xxxxxxxx"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量。\n\n偏移量为一个大于0小于资源总个数的整数,表示查询该偏移量后面的所有的资源,默认值为0。",
            "type": "integer",
            "required": false,
            "default": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询的数量限制。\n\n取值范围:1~100,取值一般为10,20,50。功能说明:每页返回的资源个数。默认值为100。",
            "type": "integer",
            "required": false,
            "default": 100
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "企业项目id。",
            "type": "string",
            "required": false
          },
          {
            "name": "name",
            "in": "query",
            "description": "检索的主题名称,完全匹配。",
            "type": "string",
            "required": false
          },
          {
            "name": "fuzzy_name",
            "in": "query",
            "description": "检索的主题名称,模糊匹配。",
            "type": "string",
            "required": false,
            "pattern": "^[-_a-zA-Z0-9]{0,255}$",
            "allowEmptyValue": true
          },
          {
            "name": "topic_id",
            "in": "query",
            "description": "检索的主题ID,完全匹配。",
            "type": "string",
            "required": false
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "name": "fuzzy_display_name",
            "in": "query",
            "required": false,
            "description": "检索的主题显示名。模糊匹配。参数字节长度不能大于192字节。",
            "type": "string",
            "allowEmptyValue": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListTopicsResponseBody"
            },
            "examples": {
              "application/json": {
                "request_id": "6a63a18b8bab40ffb71ebd9cb80d0085",
                "topic_count": 1,
                "topics": [
                  {
                    "topic_urn": "urn:smn:regionId:8bad8a40e0f7462f8c1676e3f93a8183:test_topic_v2",
                    "display_name": "testtest",
                    "name": "test_topic_v1",
                    "push_policy": 0,
                    "enterprise_project_id": "0",
                    "topic_id": "84698185946d44d08431aa441d8e2cf2",
                    "create_time": "2016-08-02T08:22:18Z",
                    "update_time": "2016-08-02T08:22:18Z"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "403": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/FailedResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "FailedResp": {
      "required": [
        "request_id",
        "code",
        "message"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。",
          "example": "6a63a18b8bab40ffb71ebd9cb80d0085"
        },
        "code": {
          "type": "string",
          "description": "服务异常错误信息编码。",
          "example": "SMN.0167"
        },
        "message": {
          "type": "string",
          "description": "服务异常错误信息描述。",
          "example": "xxxxxxxx"
        }
      }
    },
    "ListTopicsItem": {
      "required": [
        "topic_urn",
        "name",
        "display_name",
        "push_policy",
        "enterprise_project_id",
        "topic_id",
        "create_time",
        "update_time"
      ],
      "properties": {
        "topic_urn": {
          "type": "string",
          "description": "Topic的唯一的资源标识。"
        },
        "name": {
          "type": "string",
          "description": "创建topic的名字。"
        },
        "display_name": {
          "type": "string",
          "description": "Topic的显示名,推送邮件消息时,作为邮件发件人显示。"
        },
        "push_policy": {
          "type": "integer",
          "description": "消息推送的策略,该属性目前不支持修改,后续将支持修改。0表示发送失败,保留到失败队列,1表示直接丢弃发送失败的消息。"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。"
        },
        "topic_id": {
          "type": "string",
          "description": "主题ID。"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间。时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。"
        },
        "update_time": {
          "type": "string",
          "description": "更新时间。时间格式为UTC时间,YYYY-MM-DDTHH:MM:SSZ。"
        }
      },
      "type": "object"
    },
    "ListTopicsResponseBody": {
      "required": [
        "request_id",
        "topic_count",
        "topics"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "请求的唯一标识ID。"
        },
        "topic_count": {
          "type": "integer",
          "description": "返回的Topic个数。该参数不受offset和limit影响,即返回的是您账户下所有的Topic个数。"
        },
        "topics": {
          "type": "array",
          "description": "Topic结构体数组。",
          "items": {
            "$ref": "#/definitions/ListTopicsItem"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "smn.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}