{
  "name": "ListBranches",
  "summary": "获取分支列表",
  "tags": "Refs",
  "productshort": "CodeArtsRepo",
  "region_id": "af-north-1",
  "paths": {
    "/v4/repositories/{repository_id}/repository/branches": {
      "get": {
        "tags": [
          "Refs"
        ],
        "summary": "获取分支列表",
        "description": "获取分支列表",
        "operationId": "ListBranches",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token。 通过调用IAM服务[获取用户Token](https://support.huaweicloud.com/api-iam/iam_30_0001.html)接口获取(响应消息头中X-Subject-Token的值)。\n **约束限制:**\n不涉及。\n **取值范围:**\n字符串长度不少于1,不超过10万。\n**默认取值:**\n不涉及。",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "maxLength": 100000,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "name": "repository_id",
            "in": "path",
            "description": "**参数解释:**\n仓库的ID,通过[查询用户所有仓库](https://support.huaweicloud.com/api-codeartsrepo/ListUserAllRepositories.html)接口查询项目列表获取。\n**约束限制:**\n不涉及。\n**默认取值:**\n不涉及。",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "name": "branch_type",
            "in": "query",
            "description": "**参数解释:**\n分支类型,默认返回全部分支,not_protect,返回非保护分支。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "enum": [
                "not_protect"
              ]
            }
          },
          {
            "name": "creator",
            "in": "query",
            "description": "**参数解释:**\n创建者,用户ID或者IamId。\n**取值范围:**\n字符串长度不少于1,不超过100000。",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "maxLength": 100000,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "**参数解释:**\n排序方式\n**约束限制:**\n- name,分支名倒序。\n- updated_desc,更新时间倒序。\n- updated_asc,更新时间正序。",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "default": "updated_desc",
              "enum": [
                "name",
                "updated_desc",
                "updated_asc"
              ]
            }
          },
          {
            "name": "query_view",
            "in": "query",
            "description": "**参数解释:**\n分支类型\n**约束限制:**\n- my_branches,个人分支。\n- active,活跃分支。\n- stale,过时分支。\n- all_branches,所有分支。",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "default": "all_branches",
              "enum": [
                "my_branches",
                "active",
                "stale",
                "all_branches"
              ]
            }
          },
          {
            "name": "view",
            "in": "query",
            "description": "**参数解释:**\n结果集属性,根据给定的参数返回不同的结果\n**约束限制:**\n- all,返回分支的所有信息。\n- basic,返回分支的基本信息。\n- simple,返回分支的简单信息。",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "enum": [
                "simple",
                "basic",
                "all"
              ]
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "**参数解释:**\n偏移量,从0开始。",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "**参数解释:**\n返回数量。",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "分支列表",
            "headers": {
              "X-Total": {
                "description": "**参数解释:**\n分支总数。",
                "style": "simple",
                "explode": false,
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "description": "分支列表",
                  "items": {
                    "$ref": "#/components/schemas/BranchSimpleDto"
                  }
                },
                "example": [
                  {
                    "name": "master",
                    "default": true,
                    "can_delete": null,
                    "can_read": null,
                    "can_download": null,
                    "can_push": null
                  }
                ]
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error_code": "CH.00000001",
                  "error_msg": "未识别到用户认证信息"
                }
              }
            }
          },
          "403": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error_code": "CH.00401008",
                  "error_msg": "您没有操作权限,请升级权限后重试。"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error_code": "CH.00402000",
                  "error_msg": "该仓库不存在,请检查后重试。"
                }
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://{endpoint}/v4/repositories/2112015538/repository/branches",
        "x-open-region-cloud": "hws,hws_hk,hws_eu",
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-api-framework": "RestfulAPI",
        "x-api-position": "Region_ZONE",
        "x-api-user": "IAM_User",
        "x-sec-auditlog": "Y",
        "x-sec-upload-download": 0,
        "x-api-highrisk": "N"
      }
    }
  },
