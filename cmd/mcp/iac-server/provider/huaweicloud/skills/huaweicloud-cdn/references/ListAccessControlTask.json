{
  "name": "ListAccessControlTask",
  "summary": "查询封禁/解禁URL任务",
  "tags": "刷新预热",
  "productshort": "CDN",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1.0/cdn/content/access-control-tasks": {
      "get": {
        "x-request-examples-url-1": "GET https://cdn.myhuaweicloud.com/v1.0/cdn/content/access-control-tasks",
        "summary": "查询封禁/解禁URL任务",
        "description": "查询封禁/解禁URL任务,如需使用本接口,请提交工单申请。\n- 单租户调用频率:30次/s。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-history-api": "N",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "查询起始时间戳(毫秒),不传默认为当前时间,需与结束时间戳同时指定,时间跨度不能超过7天。",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "查询结束时间戳(毫秒),不传默认3天前,需与开始时间戳同时指定,时间跨度不能超过7天。",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量:特定数据字段与起始数据字段位置的距离,默认为0。",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "单次查询数据条数,上限为10000,默认为10。",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "任务状态,状态类型:processing:处理中;succeed:完成;failed:失败。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlTaskResponse"
                },
                "example": {
                  "total": 1,
                  "access_control_tasks": [
                    {
                      "id": "71xxxxxxxxxxxxxxxxxxxxxxxxxxxxff",
                      "urls": [
                        "https://www.example.com/1.txt",
                        "http://www.example.com/2.txt"
                      ],
                      "status": "succeed",
                      "create_time": 1652325740318,
                      "action": "unban"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败响应。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UrlTaskErrorRsp"
                }
              }
            }
          }
        },
        "operationId": "ListAccessControlTask",
        "tags": [
          "刷新预热"
        ]
      }
    }
