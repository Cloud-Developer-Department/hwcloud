{
  "name": "ShowLogs",
  "summary": "日志查询",
  "tags": "日志管理",
  "productshort": "CDN",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1.0/cdn/logs": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "description": "查询日志下载链接,支持查询30天内的日志信息。",
        "summary": "日志查询",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "domain_name",
            "in": "query",
            "description": "只支持单个域名,如:www.test1.com。",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "查询开始时间,时间格式为整点毫秒时间戳,此参数传空值时默认为当天0点。",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "查询结束时间(不包含结束时间),时间格式为整点毫秒时间戳,与开始时间的最大跨度为30天,此参数传空值时默认为开始时间加1天。",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "单页最大数量,取值范围为1-10000,默认值:10。",
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 1
            }
          },
          {
            "name": "page_number",
            "in": "query",
            "description": "当前查询第几页,取值范围为1-65535,默认值:1。",
            "schema": {
              "type": "integer",
              "maximum": 65535,
              "minimum": 1
            }
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "当用户开启企业项目功能时,该参数生效,表示查询资源所属项目,\"all\"表示所有项目。注意:当使用子帐号调用接口时,该参数必传。\n\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogsQueryResponse"
                },
                "example": {
                  "logs": [
                    {
                      "domain_name": "www.example.com",
                      "start_time": 1498838400000,
                      "end_time": 1502380500000,
                      "name": "www.xxxx.com-2017080315",
                      "link": "www.xxxx.web",
                      "size": 4096
                    }
                  ],
                  "total": 1
                }
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://cdn.myhuaweicloud.com/v1.0/cdn/logs?query_date=1502380500000&domain_name=www.example.com&page_size=10&page_number=1&enterprise_project_id=0",
        "operationId": "ShowLogs",
        "tags": [
          "日志管理"
        ],
        "x-order": 0
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "cdn.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}