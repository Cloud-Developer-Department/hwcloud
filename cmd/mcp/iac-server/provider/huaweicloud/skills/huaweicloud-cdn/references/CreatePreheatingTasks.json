                "type": "string"
              }
            },
            "examples": {
              "application/json": {
                "preheating_task": "7620240"
              }
            },
            "schema": {
              "$ref": "#/definitions/PreheatingTaskResponse"
            }
          }
        },
        "x-request-examples-url-1": "POST https://cdn.myhuaweicloud.com/v1.0/cdn/content/preheating-tasks?enterprise_project_id=0",
        "x-request-examples-1": {
          "preheating_task": {
            "urls": [
              "https://www.bxxx/1.txt",
              "http://www.bxxx/2.txt"
            ]
          }
        },
        "operationId": "CreatePreheatingTasks",
        "tags": [
          "刷新预热"
        ]
      }
    }
  },
  "definitions": {
    "PreheatingTaskRequestBody": {
      "required": [
