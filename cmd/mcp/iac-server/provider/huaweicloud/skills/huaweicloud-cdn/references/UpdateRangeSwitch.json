{
  "name": "UpdateRangeSwitch",
  "summary": "开启/关闭Range回源",
  "tags": "域名配置",
  "productshort": "CDN",
  "region_id": "cn-north-1",
  "paths": {
    "/v1.0/cdn/domains/{domain_id}/range-switch": {
      "put": {
        "deprecated": true,
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "description": "Range回源是指源站在收到CDN节点回源请求时,根据http请求头中的Range信息返回指定范围的数据给CDN节点。\n\n开启Range回源前需要确认源站是否支持Range请求,若源站不支持Range请求,开启Range回源将导致资源无法缓存。",
        "summary": "开启/关闭Range回源",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "当用户开启企业项目功能时,该参数生效,表示修改当前企业项目下加速域名的配置,\"all\"代表所有项目。注意:当使用子帐号调用接口时,该参数必传。\n\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。",
            "type": "string"
          },
          {
            "name": "domain_id",
            "in": "path",
            "description": "加速域名id。",
            "required": true,
            "type": "string"
          },
          {
            "name": "range_status",
            "in": "body",
            "description": "range状态(\"off\"/\"on\")",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RangeStatusRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "type": "string"
              }
            },
            "examples": {
              "application/json": {
                "origin_range": {
                  "domain_id": "ff8080826812caa9016812dbfcd400ea",
                  "range_status": "off"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/OriginRangeResponse"
            }
          }
        },
        "x-request-examples-url-1": "PUT https://cdn.myhuaweicloud.com/v1.0/cdn/domains/ff80808266fd001e0166fd21c65d0337/range-switch",
        "x-request-examples-1": {
          "range_status": "on"
        },
        "tags": [
          "域名配置"
        ],
        "operationId": "UpdateRangeSwitch"
      }
    }
  },
  "definitions": {
    "OriginRangeResponse": {
      "properties": {
        "origin_range": {
          "description": "Range回源配置。",
          "$ref": "#/definitions/OriginRangeBody"
        }
      }
    },
    "RangeStatusRequest": {
      "required": [
        "range_status"
      ],
      "properties": {
        "range_status": {
          "type": "string",
          "description": "range状态(\"off\"/\"on\")",
          "enum": [
            "off",
            "on"
          ],
          "example": "ipaddr"
        }
      }
    },
    "OriginRangeBody": {
      "properties": {
        "range_status": {
          "type": "string",
          "description": "range状态(\"off\"/\"on\")",
          "enum": [
            "off",
            "on"
          ],
          "example": "ipaddr"
        },
        "domain_id": {
          "type": "string",
          "description": "加速域名id。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cdn.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}