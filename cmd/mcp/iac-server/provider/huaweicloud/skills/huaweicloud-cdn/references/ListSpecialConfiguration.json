{
  "name": "ListSpecialConfiguration",
  "summary": "查询加速域名的特殊配置",
  "tags": "域名操作",
  "productshort": "CDN",
  "region_id": "cn-north-1",
  "paths": {
    "/v1.0/cdn/configuration/special-configurations": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-history-api": "N",
        "operationId": "ListSpecialConfiguration",
        "tags": [
          "域名操作"
        ],
        "summary": "查询加速域名的特殊配置",
        "description": "查询加速域名的特殊配置,当前支持查询备忘录信息。\n- 单租户调用频率:15次/s。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户鉴权Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "domain_name",
            "in": "query",
            "description": "**参数解释:**\n加速域名\n\n**约束限制:**\n仅支持查询已经在CDN添加成功的域名\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "**参数解释:**\n每页加速域名的数量\n**约束限制:**\n不涉及\n**取值范围:**\n1-10000\n**默认取值:**\n30",
            "schema": {
              "type": "integer"
            },
            "example": 10
          },
          {
            "name": "page_number",
            "in": "query",
            "description": "**参数解释:**\n查询的页码\n**约束限制:**\n不涉及\n**取值范围:**\n1-65535\n**默认取值:**\n1",
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainSpecialConfigurationRsp"
                },
                "example": {
                  "total": 1,
                  "specialConfigurations": [
                    {
                      "create_time": 1735660800000,
                      "note": "备忘录"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "错误响应。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrRsp"
                }
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://cdn.myhuaweicloud.com/v1.0/cdn/configuration/special-configurations?domain_name=www.example.com"
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "cdn.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}