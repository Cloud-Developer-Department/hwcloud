{
  "name": "ListDomains",
  "summary": "查询加速域名",
  "tags": "域名操作",
  "productshort": "CDN",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1.0/cdn/domains": {
      "get": {
        "deprecated": true,
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "description": "查询加速域名信息",
        "summary": "查询加速域名",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "domain_name",
            "in": "query",
            "description": "加速域名,采用模糊匹配的方式。(长度限制为1-255字符)。",
            "type": "string"
          },
          {
            "name": "business_type",
            "in": "query",
            "description": "加速域名的业务类型。取值:\n- web(网站加速)\n- download(文件下载加速)\n- video(点播加速)\n- wholeSite(全站加速)",
            "type": "string",
            "enum": [
              "web",
              "download",
              "video",
              "wholeSite"
            ]
          },
          {
            "name": "domain_status",
            "in": "query",
            "description": "加速域名状态。取值意义:\n- online表示“已开启”\n- offline表示“已停用”\n- configuring表示“配置中”\n- configure_failed表示“配置失败”\n- checking表示“审核中”\n- check_failed表示“审核未通过”\n- deleting表示“删除中”。",
            "type": "string",
            "enum": [
              "online",
              "offline",
              "configuring",
              "configure_failed",
              "checking",
              "check_failed",
              "deleting"
            ]
          },
          {
            "name": "service_area",
            "in": "query",
            "description": "华为云CDN提供的加速服务范围,包含:\n- mainland_china 中国大陆\n- outside_mainland_china 中国大陆境外\n- global 全球。",
            "type": "string",
            "enum": [
              "mainland_china",
              "outside_mainland_china",
              "global"
            ]
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "每页加速域名的数量,取值范围1-10000,默认值为30。",
            "type": "integer",
            "x-example": 10,
            "default": 30,
            "maximum": 10000,
            "minimum": 1
          },
          {
            "name": "page_number",
            "in": "query",
            "description": "查询的页码,即:从哪一页开始查询,取值范围1-65535,默认值为1。",
            "type": "integer",
            "default": 1,
            "x-example": 1,
            "maximum": 65535,
            "minimum": 1
          },
          {
            "name": "show_tags",
            "in": "query",
            "description": "展示标签标识 true:不展示 false:展示。",
            "type": "boolean",
            "default": false,
            "x-example": true,
            "maximum": 1,
            "minimum": 0
          },
          {
            "name": "exact_match",
            "in": "query",
            "description": "精准匹配 on:开启 off:关闭。",
            "type": "boolean",
            "default": true,
            "x-example": true,
            "maximum": 1,
            "minimum": 0
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "当用户开启企业项目功能时,该参数生效,表示查询资源所属项目,\"all\"表示所有项目。注意:当使用子帐号调用接口时,该参数必传。\n\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。",
            "type": "string",
            "x-example": "0"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "type": "string"
              }
            },
            "examples": {
              "application/json": {
                "total": 1,
                "domains": [
                  {
                    "sources": [
                      {
                        "origin_type": "ipaddr",
                        "ip_or_domain": "1.2.3.4",
                        "active_standby": 1
                      }
                    ],
                    "cname": "www.example.com.c.test.com",
                    "id": "ab1234a*********************g56",
                    "user_domain_id": "1e234********************441",
                    "domain_name": "www.example.com",
                    "business_type": "web",
                    "service_area": "mainland_china",
                    "domain_status": "online",
                    "https_status": 0,
                    "create_time": 1516861994806,
                    "modify_time": 1532405346365,
                    "domain_origin_host": {
                      "domain_id": "ab1234a*********************g56",
                      "origin_host_type": "customize",
                      "customize_domain": "www.xxxx.com"
                    },
                    "disabled": 0,
                    "locked": 0,
                    "range_status": "off",
                    "follow_status": "off",
                    "origin_status": "on",
                    "auto_refresh_preheat": 0
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/DomainQueryResponse"
            }
          }
        },
        "x-request-examples-url-1": "GET https://cdn.myhuaweicloud.com/v1.0/cdn/domains?domain_name=www.example.com&page_size=10&page_number=1&enterprise_project_id=0",
        "tags": [
          "域名操作"
        ],
        "operationId": "ListDomains"
      }
    }
  },
  "definitions": {
    "Sources": {
      "description": "源站信息。",
      "required": [
        "ip_or_domain",
        "origin_type",
        "active_standby"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "description": "加速域名id。",
          "example": "ab1234a*********************g56"
        },
        "origin_type": {
          "type": "string",
          "description": "源站类型取值:ipaddr:源站IP、 domain:源站域名、obs_bucket:OBS桶域名。源站为ipaddr时,仅支持IPv4,如需传入多个源站IP,以多个源站对象传入,除IP其他参数请保持一致,主源站最多支持50个源站IP对象,备源站最多支持50个源站IP对象;源站为domain时,仅支持1个源站对象。不支持IP源站和域名源站混用。",
          "enum": [
            "ipaddr",
            "domain",
            "obs_bucket"
          ],
          "example": "ipaddr"
        },
        "ip_or_domain": {
          "type": "string",
          "example": "1.2.3.4",
          "description": "源站IP(非内网IP)或者域名。"
        },
        "active_standby": {
          "type": "integer",
          "example": 1,
          "description": "主备状态,1代表主源站,0代表备源站。"
        },
        "enable_obs_web_hosting": {
          "type": "integer",
          "format": "int32",
          "description": "是否开启Obs静态网站托管(0表示关闭,1表示则为开启),源站类型为obs_bucket时传递。"
        }
      }
    },
    "Domains": {
      "description": "域名信息",
      "properties": {
        "id": {
          "type": "string",
          "example": "ab1234a*********************g56",
          "description": "加速域名ID。"
        },
        "domain_name": {
          "type": "string",
          "example": "example1.example2.example3.com",
          "description": "加速域名。"
        },
        "business_type": {
          "type": "string",
          "example": "web",
          "description": "域名业务类型,若为web,则表示类型为网站加速;若为download,则表示业务类型为文件下载加速;若为video,则表示业务类型为点播加速;若为wholeSite,则表示类型为全站加速。"
        },
        "user_domain_id": {
          "type": "string",
          "example": "1e234********************441",
          "description": "域名所属用户的domain_id。"
        },
        "domain_status": {
          "type": "string",
          "example": "online",
          "description": "加速域名状态。取值意义:\n- online表示“已开启”\n- offline表示“已停用”\n- configuring表示“配置中”\n- configure_failed表示“配置失败”\n- checking表示“审核中”\n- check_failed表示“审核未通过”\n- deleting表示“删除中”。"
        },
        "cname": {
          "type": "string",
          "example": "www.example.com.c.test.com",
          "description": "加速域名对应的CNAME。"
        },
        "sources": {
          "type": "array",
          "description": "源站域名或源站IP,源站为IP类型时,仅支持IPv4,如需传入多个源站IP,以多个源站对象传入,除IP其他参数请保持一致,主源站最多支持15个源站IP对象,备源站最多支持15个源站IP对象;源站为域名类型时仅支持1个源站对象。不支持IP源站和域名源站混用。",
          "items": {
            "$ref": "#/definitions/Sources"
          }
        },
        "domain_origin_host": {
          "description": "域名回源HOST配置。",
          "$ref": "#/definitions/DomainOriginHost"
        },
        "https_status": {
          "type": "integer",
          "format": "int32",
          "description": "是否开启HTTPS加速。"
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "example": 1516861994806,
          "description": "域名创建时间,相对于UTC 1970-01-01到当前时间相隔的毫秒数。"
        },
        "modify_time": {
          "type": "integer",
          "format": "int64",
          "example": 1532405346365,
          "description": "域名修改时间,相对于UTC 1970-01-01到当前时间相隔的毫秒数。"
        },
        "disabled": {
          "type": "integer",
          "format": "int32",
          "description": "封禁状态(0代表未禁用;1代表禁用)。"
        },
        "locked": {
          "type": "integer",
          "format": "int32",
          "description": "锁定状态(0代表未锁定;1代表锁定)。"
        },
        "auto_refresh_preheat": {
          "type": "integer",
          "format": "int32",
          "description": "自动刷新预热(0代表关闭;1代表打开)。"
        },
        "service_area": {
          "type": "string",
          "example": "mainland_china",
          "description": "华为云CDN提供的加速服务范围,包含:mainland_china中国大陆、outside_mainland_china中国大陆境外、global全球。",
          "enum": [
            "mainland_china",
            "outside_mainland_china",
            "global"
          ]
        },
        "range_status": {
          "type": "string",
          "example": "off",
          "description": "Range回源状态。"
        },
        "follow_status": {
          "type": "string",
          "example": "off",
          "description": "回源跟随状态。"
        },
        "origin_status": {
          "type": "string",
          "example": "off",
          "description": "是否暂停源站回源(off代表关闭 on代表开启)。。"
        },
        "banned_reason": {
          "type": "string",
          "example": 152,
          "description": "域名禁用原因。"
        },
        "locked_reason": {
          "type": "string",
          "example": "该域名为特殊配置域名,已被锁定。任何域名相关的操作请提交工单进行处理。",
          "description": "域名锁定原因。"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "当用户开启企业项目功能时,该参数生效,表示查询资源所属项目,不传表示查询默认项目。注意:当使用子帐号调用接口时,该参数必传。\n\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。"
        },
        "tags": {
          "type": "array",
          "description": "标签信息",
          "items": {
            "$ref": "#/definitions/EpResourceTag"
          }
        }
      }
    },
    "DomainOriginHost": {
      "required": [
        "origin_host_type"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "example": "ab1234a*********************g56",
          "description": "域名ID。"
        },
        "origin_host_type": {
          "type": "string",
          "example": "www.xxxx.com",
          "description": "回源host的类型,accelerate:选择加速域名作为回源host域名,customize:使用自定义的域名作为回源host域名。"
        },
        "customize_domain": {
          "type": "string",
          "example": "customize",
          "description": "自定义回源host域名。"
        }
      }
    },
    "DomainQueryResponse": {
      "description": "域名查询返回信息",
      "properties": {
        "total": {
          "type": "integer",
          "example": 1,
          "description": "总条数。"
        },
        "domains": {
          "type": "array",
          "description": "域名信息",
          "items": {
            "$ref": "#/definitions/Domains"
          }
        }
      }
    },
    "EpResourceTag": {
      "description": "标签信息",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "资源标签key。",
          "minLength": 1,
          "maxLength": 135,
          "example": "string"
        },
        "value": {
          "type": "string",
          "description": "资源标签value值。",
          "minLength": 1,
          "maxLength": 135,
          "example": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cdn.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}