{
  "name": "ShowOriginHost",
  "summary": "查询回源HOST",
  "tags": "域名配置",
  "productshort": "CDN",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1.0/cdn/domains/{domain_id}/originhost": {
      "get": {
        "deprecated": true,
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "description": "查询回源HOST。回源HOST是CDN节点在回源过程中,在源站访问的站点域名,即http请求头中的host信息。",
        "summary": "查询回源HOST",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "domain_id",
            "in": "path",
            "description": "加速域名ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "当用户开启企业项目功能时,该参数生效,表示查询资源所属项目,\"all\"表示所有项目。注意:当使用子帐号调用接口时,该参数必传。\n\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "type": "string"
              }
            },
            "examples": {
              "application/json": {
                "origin_host": {
                  "domain_id": "ff80*****************************d71",
                  "origin_host_type": "customize",
                  "customize_domain": "www.example.com"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/OriginHostResponse"
            }
          }
        },
        "x-request-examples-url-1": "GET https://cdn.myhuaweicloud.com/v1.0/cdn/domains/ff80*****************************d71/originhost?enterprise_project_id=0",
        "tags": [
          "域名配置"
        ],
        "operationId": "ShowOriginHost"
      }
    }
  },
  "definitions": {
    "DomainOriginHost": {
      "required": [
        "origin_host_type"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "example": "ab1234a*********************g56",
          "description": "域名ID。"
        },
        "origin_host_type": {
          "type": "string",
          "example": "www.xxxx.com",
          "description": "回源host的类型,accelerate:选择加速域名作为回源host域名,customize:使用自定义的域名作为回源host域名。"
        },
        "customize_domain": {
          "type": "string",
          "example": "customize",
          "description": "自定义回源host域名。"
        }
      }
    },
    "OriginHostResponse": {
      "properties": {
        "origin_host": {
          "description": "回源HOST配置。",
          "$ref": "#/definitions/DomainOriginHost"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cdn.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}