{
  "name": "ShowTopDomainNames",
  "summary": "查询TOP域名",
  "tags": "统计分析",
  "productshort": "CDN",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1/cdn/statistics/top-domain-names": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ShowTopDomainNames",
        "deprecated": true,
        "summary": "查询TOP域名",
        "description": "- 查询TOP域名。\n\n- 支持查询90天内的数据。\n\n- 查询时间跨度不能超过1天。\n\n- 起始时间和结束时间,左闭右开,必须同时指定。如查询2022-10-24 00:00:00 到 2022-10-25 00:00:00 的数据,表示取 [2022-10-24 00:00:00, 2022-10-25 00:00:00)的统计数据。\n\n- 起始时间、结束时间必须传整点毫秒级时间戳。\n\n- 流量类指标单位统一为Byte(字节)、带宽类指标单位统一为bit/s(比特/秒)、请求数类和状态码类指标单位统一为次数。用于查询指定域名、指定统计指标的明细数据。\n\n- 单租户调用频率:5次/s。",
        "tags": [
          "统计分析"
        ],
        "parameters": [
          {
            "name": "start_time",
            "in": "query",
            "required": true,
            "description": "- 查询起始时间戳,时间戳应设置需为整点时间戳,设置方式如下:\n- interval为3600时,start_time设置为整小时时刻点,如:1631239200000(对应2021-09-10 10:00:00)\n- interval为86400时,start_time设置为东8区零点时刻点,如:1631203200000(对应2021-09-10 00:00:00)",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "maximum": 4102416000000
            },
            "example": 1667030400000
          },
          {
            "name": "end_time",
            "in": "query",
            "required": true,
            "description": "- 查询结束时间戳,时间戳应设置需为整点时间戳,设置方式如下:\n- interval为3600时,end_time设置为整小时时刻点,如:1631325600000(对应2021-09-11 10:00:00)\n- interval为86400时,end_time设置为东8区零点时刻点,如:1631376000000(对应2021-09-12 00:00:00)",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "maximum": 4102416000000
            },
            "example": 1667116800000
          },
          {
            "name": "stat_type",
            "in": "query",
            "required": true,
            "description": "- 统计类型\n- 目前只支持bw(带宽),flux(流量),req_num(请求总数)",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "example": "bw"
          },
          {
            "$ref": "#/components/parameters/service_area"
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/enterprise_project_id"
          }
        ],
        "responses": {
          "200": {
            "description": "正常响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopDomainNameResponse"
                },
                "examples": {
                  "TopDomainNameWithFlux": {
                    "$ref": "#/components/examples/TopDomainNameWithFlux"
                  },
                  "TopDomainNameWithBw": {
                    "$ref": "#/components/examples/TopDomainNameWithBw"
                  },
                  "TopDomainNameWithReqNum": {
                    "$ref": "#/components/examples/TopDomainNameWithReqNum"
                  }
                }
              }
            }
          },
          "default": {
            "description": "异常响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrRsp"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "cdn.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}