            "required": true,
            "type": "string"
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "刷新预热的urls所显示单页最大数量,取值范围为1-10000。page_size和page_number必须同时传值。默认值30。",
            "type": "integer",
            "default": 30,
            "maximum": 10000,
            "minimum": 1
          },
          {
            "name": "page_number",
