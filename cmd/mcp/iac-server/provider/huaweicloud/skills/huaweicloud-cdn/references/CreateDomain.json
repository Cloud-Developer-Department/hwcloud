          "$ref": "#/definitions/CreateDomainResponseBodyContent"
        }
      }
    },
    "DomainOriginHost": {
      "required": [
        "origin_host_type"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "example": "ab1234a*********************g56",
          "description": "域名ID。"
        },
        "origin_host_type": {
          "type": "string",
          "example": "www.xxxx.com",
          "description": "回源host的类型,accelerate:选择加速域名作为回源host域名,customize:使用自定义的域名作为回源host域名。"
        },
        "customize_domain": {
          "type": "string",
          "example": "customize",
          "description": "自定义回源host域名。"
        }
      }
    },
    "DomainBody": {
      "description": "创建域名Body",
      "required": [
        "domain_name",
        "business_type",
        "sources"
      ],
      "properties": {
        "domain_name": {
          "type": "string",
          "description": "加速域名。( 由字母(A-Z,a-z,大小写等价)、数字(0-9)和连接符(-)组成,各级域名之间用(.)连接,域名长度不超过75个字符。连接符(-)不能作为域名的开头或结尾字符。)",
          "maxLength": 75
        },
        "business_type": {
          "type": "string",
          "description": "域名业务类型,若为web,则表示类型为网页加速;若为download,则表示业务类型为文件下载加速;若为video,则表示业务类型为点播加速;若为wholeSite,则表示业务类型为全站加速。",
          "enum": [
            "web",
            "download",
            "video",
            "wholeSite"
          ]
        },
        "sources": {
          "type": "array",
          "description": "源站配置。",
          "maxItems": 15,
          "items": {
            "$ref": "#/definitions/Sources"
          }
        },
        "service_area": {
          "type": "string",
          "description": "域名服务范围,若为mainland_china,则表示服务范围为中国大陆;若为outside_mainland_china,则表示服务范围为中国大陆境外;若为global,则表示服务范围为全球。",
          "enum": [
            "mainland_china",
            "outside_mainland_china",
            "global"
          ]
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "当用户开启企业项目功能时,该参数生效,表示添加加速域名到该企业项目。注意:当使用子帐号调用接口时,该参数必传。\n\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。"
        }
      }
    },
    "CreateDomainResponseBodyContent": {
      "description": "创建域名返回信息。",
      "properties": {
        "id": {
          "type": "string",
          "description": "加速域名ID。"
        },
        "domain_name": {
          "type": "string",
          "description": "加速域名。"
        },
        "business_type": {
          "type": "string",
          "description": "域名业务类型:\n- web:网站加速;\n- download:文件下载加速;\n- video:点播加速;\n- wholeSite:全站加速。"
        },
        "service_area": {
          "type": "string",
          "description": "域名服务范围,若为mainland_china,则表示服务范围为中国大陆;若为outside_mainland_china,则表示服务范围为中国大陆境外;若为global,则表示服务范围为全球。"
        },
        "user_domain_id": {
          "type": "string",
          "description": "域名所属用户的domain_id。"
        },
        "domain_status": {
          "type": "string",
          "description": "加速域名状态。取值意义:\n- online表示“已开启”\n- offline表示“已停用”\n- configuring表示“配置中”\n- configure_failed表示“配置失败”\n- checking表示“审核中”\n- check_failed表示“审核未通过”\n- deleting表示“删除中”。"
        },
        "cname": {
          "type": "string",
          "description": "加速域名对应的CNAME。"
        },
        "sources": {
          "type": "array",
          "description": "源站信息。",
          "items": {
            "$ref": "#/definitions/Sources"
          }
        },
        "domain_origin_host": {
          "description": "域名回源HOST配置。",
          "$ref": "#/definitions/DomainOriginHost"
        },
        "https_status": {
          "type": "integer",
          "format": "int32",
          "description": "是否开启HTTPS加速。"
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "description": "域名创建时间,相对于UTC 1970-01-01到当前时间相隔的毫秒数。"
        },
        "modify_time": {
          "type": "integer",
          "format": "int64",
          "description": "域名修改时间,相对于UTC 1970-01-01到当前时间相隔的毫秒数。"
        },
        "disabled": {
          "type": "integer",
          "format": "int32",
          "description": "封禁状态(0代表未禁用;1代表禁用)。"
        },
        "locked": {
          "type": "integer",
          "format": "int32",
          "description": "锁定状态(0代表未锁定;1代表锁定)。"
        },
        "range_status": {
          "type": "string",
          "description": "range状态,off:关闭,on:开启。"
        },
        "follow_status": {
          "type": "string",
          "description": "follow302状态,off:关闭,on:开启。"
        },
        "origin_status": {
          "type": "string",
          "description": "是否暂停源站回源(off代表关闭 on代表开启)。"
        },
        "auto_refresh_preheat": {
          "type": "integer",
          "format": "int32",
          "description": "自动刷新预热(0代表关闭;1代表打开)。"
        }
      }
    }
  },
