{
  "name": "UpdateDomainOrigin",
  "summary": "修改源站信息。",
  "tags": "域名配置",
  "productshort": "CDN",
  "region_id": "cn-north-1",
  "paths": {
    "/v1.0/cdn/domains/{domain_id}/origin": {
      "put": {
        "deprecated": true,
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "description": "修改加速域名的源站配置。",
        "summary": "修改源站信息。",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "domain_id",
            "in": "path",
            "description": "加速域名ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "当用户开启企业项目功能时,该参数生效,表示修改当前企业项目下加速域名的配置,\"all\"代表所有项目。注意:当使用子帐号调用接口时,该参数必传。\n\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。",
            "type": "string"
          },
          {
            "name": "origin",
            "in": "body",
            "description": "This is a auto create Body Object",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OriginRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "type": "string"
              }
            },
            "examples": {
              "application/json": {
                "origin": {
                  "sources": [
                    {
                      "domain_id": "12ab***********************02b71",
                      "origin_type": "ipaddr",
                      "ip_or_domain": "1.2.3.4",
                      "active_standby": 1,
                      "http_port": 80,
                      "https_port": 443
                    }
                  ]
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/OriginResponse"
            }
          }
        },
        "x-request-examples-url-1": "PUT https://cdn.myhuaweicloud.com/v1.0/cdn/domains/ff808**********************2d71/origin?enterprise_project_id=0",
        "x-request-examples-1": {
          "origin": {
            "sources": [
              {
                "ip_or_domain": "1.2.3.4",
                "origin_type": "ipaddr",
                "active_standby": 1,
                "http_port": 80,
                "https_port": 443
              }
            ]
          }
        },
        "tags": [
          "域名配置"
        ],
        "operationId": "UpdateDomainOrigin"
      }
    }
  },
  "definitions": {
    "ResourceBody": {
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 15,
          "description": "源站配置。",
          "items": {
            "$ref": "#/definitions/SourceWithPort"
          }
        }
      }
    },
    "OriginResponse": {
      "description": "源站域名或源站IP,源站为IP类型时,仅支持IPv4,如需传入多个源站IP,以多个源站对象传入,除IP其他参数请保持一致,主源站最多支持15个源站IP对象,备源站最多支持15个源站IP对象;源站为域名类型时仅支持1个源站对象。不支持IP源站和域名源站混用。",
      "properties": {
        "origin": {
          "description": "源站对象。",
          "$ref": "#/definitions/ResourceBody"
        }
      }
    },
    "SourceWithPort": {
      "description": "源站信息",
      "required": [
        "ip_or_domain",
        "origin_type",
        "active_standby"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "description": "加速域名id。",
          "example": "ab1234a*********************g56"
        },
        "ip_or_domain": {
          "type": "string",
          "description": "源站IP(非内网IP)或者域名。"
        },
        "origin_type": {
          "type": "string",
          "description": "源站类型,ipaddr:源站IP、 domain:源站域名、obs_bucket:OBS桶域名。",
          "enum": [
            "ipaddr",
            "domain",
            "obs_bucket"
          ],
          "example": "ipaddr"
        },
        "active_standby": {
          "type": "integer",
          "format": "int32",
          "description": "主备状态(1代表主源站;0代表备源站)。"
        },
        "enable_obs_web_hosting": {
          "type": "integer",
          "format": "int32",
          "description": "是否开启Obs静态网站托管(0表示关闭,1表示则为开启),源站类型为obs_bucket时传递。"
        },
        "http_port": {
          "type": "integer",
          "format": "int32",
          "description": "HTTP端口,默认80"
        },
        "https_port": {
          "type": "integer",
          "format": "int32",
          "description": "HTTPS端口,默认443"
        }
      }
    },
    "OriginRequest": {
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "description": "源站对象。",
          "$ref": "#/definitions/ResourceBody"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cdn.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}