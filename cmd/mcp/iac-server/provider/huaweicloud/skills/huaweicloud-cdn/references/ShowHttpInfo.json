{
  "name": "ShowHttpInfo",
  "summary": "查询HTTPS配置",
  "tags": "域名配置",
  "productshort": "CDN",
  "region_id": "cn-north-1",
  "paths": {
    "/v1.0/cdn/domains/{domain_id}/https-info": {
      "get": {
        "deprecated": true,
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "description": "获取加速域名证书。",
        "summary": "查询HTTPS配置",
        "parameters": [
          {
            "name": "domain_id",
            "in": "path",
            "description": "加速域名ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
            "required": true,
            "type": "string"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "当用户开启企业项目功能时,该参数生效,表示查询资源所属项目,\"all\"表示所有项目。注意:当使用子帐号调用接口时,该参数必传。\n\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "type": "string"
              }
            },
            "examples": {
              "application/json": {
                "https": {
                  "https_status": 2,
                  "force_redirect_https": 1,
                  "http2": 0,
                  "cert_name": "cdn_test_cert",
                  "certificate": "-----BEGIN CERTIFICATE----------END CERTIFICATE-----",
                  "private_key": "",
                  "certificate_type": 0,
                  "expiration_time": 1636183290000
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/HttpInfoResponse"
            }
          }
        },
        "x-request-examples-url-1": "GET https://cdn.myhuaweicloud.com/v1.0/cdn/domains/ff808***********************307d/https-info?enterprise_ptoject_id=0",
        "operationId": "ShowHttpInfo",
        "tags": [
          "域名配置"
        ]
      }
    }
  },
  "definitions": {
    "HttpInfoResponseBody": {
      "properties": {
        "https_status": {
          "type": "integer",
          "format": "int32",
          "description": "HTTPS证书是否启用。0:不启用,此时无需填写证书及私钥参数;1:启用HTTPS加速并协议跟随回源;2:启用HTTPS加速并HTTP回源;3:启用HTTPS加速并HTTPS回源,开启时需要传递证书及私钥"
        },
        "cert_name": {
          "type": "string",
          "description": "证书名称。(长度限制为3-32字符)。"
        },
        "certificate": {
          "type": "string",
          "description": "证书内容。"
        },
        "private_key": {
          "type": "string",
          "description": "功能说明: HTTPS协议使用的私钥,不启用证书则无需输入。(为了客户信息安全,接口返回私钥为空)"
        },
        "certificate_type": {
          "type": "integer",
          "format": "int32",
          "description": "证书类型。1:代表华为云托管证书;0:表示自有证书。"
        },
        "force_redirect_https": {
          "type": "integer",
          "format": "int32",
          "description": "客户端请求是否强制重定向。1是,0否。(如果为2,表示强制跳转HTTP)"
        },
        "force_redirect_config": {
          "description": "强制跳转",
          "$ref": "#/definitions/ForceRedirect"
        },
        "http2": {
          "type": "integer",
          "format": "int32",
          "description": "是否使用HTTP2.0。(1是,0否。)"
        },
        "expiration_time": {
          "type": "integer",
          "format": "int64",
          "description": "证书过期时间"
        }
      }
    },
    "HttpInfoResponse": {
      "properties": {
        "https": {
          "description": "https配置。",
          "$ref": "#/definitions/HttpInfoResponseBody"
        }
      }
    },
    "ForceRedirect": {
      "required": [
        "switch",
        "redirect_type"
      ],
      "properties": {
        "switch": {
          "type": "integer",
          "description": "强制跳转开关。1打开。0关闭。",
          "format": "int32"
        },
        "redirect_type": {
          "type": "string",
          "description": "强制跳转类型。http:强制跳转HTTP。https:强制跳转HTTPS。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cdn.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}