            "type": "string"
          },
          {
            "name": "domain_id",
            "in": "path",
            "description": "加速域名ID。",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "type": "string"
              }
            },
            "examples": {
              "application/json": {
                "referer": {
                  "referer_type": 1,
                  "referer_list": "www.example1.com;www.example2.com",
                  "include_empty": false
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/RefererResponse"
            }
          }
        },
        "x-request-examples-url-1": "GET https://cdn.myhuaweicloud.com/v1.0/cdn/domains/ff8080***********************d71/referer?enterprise_project_id=0",
        "operationId": "ShowRefer",
        "tags": [
          "域名配置"
        ]
      }
    }
  },
  "definitions": {
