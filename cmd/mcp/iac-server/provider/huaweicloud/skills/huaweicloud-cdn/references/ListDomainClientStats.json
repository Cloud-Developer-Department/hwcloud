{
  "name": "ListDomainClientStats",
  "summary": "按域名维度查询每天客户端访问详情统计",
  "tags": "统计分析",
  "productshort": "CDN",
  "region_id": "cn-north-1",
  "paths": {
    "/v1.0/cdn/statistics/domain-client-stats": {
      "get": {
        "x-test": true,
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ListDomainClientStats",
        "summary": "按域名维度查询每天客户端访问详情统计",
        "description": "- 按域名维度查询每天客户端访问详情统计。\n- 支持查询90天内的数据。\n- ip_num查询跨度只支持1天,uv查询跨度只支持5分钟。\n- 起始时间和结束时间,左闭右开,需要同时指定。如查询2022-07-12 00:00:00 到 2022-07-13 00:00:00 的数据,表示取 [2022-07-12 00:00:00, 2022-07-13 00:00:00)的统计数据。\n- ip_num开始时间、结束时间必须传毫秒级时间戳,必须为凌晨0点整时刻点,如果传的不是凌晨0点整时刻点,返回数据可能与预期不一致。\n- uv必须为5分钟整时刻点,如:0分、5分、10分、15分等,如果传的不是5分钟时刻点,返回数据可能与预期不一致",
        "tags": [
          "统计分析"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/start_time_m"
          },
          {
            "$ref": "#/components/parameters/end_time_m"
          },
          {
            "$ref": "#/components/parameters/domain_name_m"
          },
          {
            "name": "stat_type",
            "in": "query",
            "required": true,
            "description": "-  客户端访问资源指标类别: \n- ip_num (去重后ip访问数量)\n- uv(五分钟内的访问独立IP数,一个独立ip记一次。)",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "example": "ip_num"
          },
          {
            "name": "service_area",
            "in": "query",
            "required": false,
            "description": "服务区域:mainland_china(大陆),outside_mainland_china(海外),默认为mainland_china",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          {
            "$ref": "#/components/parameters/enterprise_project_id"
          }
        ],
        "x-request-examples-description-1": "查询客户端访问详情",
        "x-request-examples-url-1": "GET https://cdn.myhuaweicloud.com/v1.0/cdn/statistics/domain-client-stats?&start_time=1577808000000&end_time=1577894400000&domain_name=www.test1.com&stat_type=1000",
        "responses": {
          "200": {
            "description": "正常响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainClientStatsRsp"
                },
                "examples": {
                  "UvStats": {
                    "$ref": "#/components/examples/UvStats"
                  }
                }
              }
            }
          },
          "default": {
            "description": "异常响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrRsp"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "cdn.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}