            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "单次查询数据条数,上限为100,默认为10。",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "url",
