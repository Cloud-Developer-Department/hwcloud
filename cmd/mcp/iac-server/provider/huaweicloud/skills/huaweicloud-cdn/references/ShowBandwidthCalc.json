{
  "name": "ShowBandwidthCalc",
  "summary": "查询域名带宽峰值类数据",
  "tags": "统计分析",
  "productshort": "CDN",
  "region_id": "cn-north-1",
  "paths": {
    "/v1.0/cdn/statistics/bandwidth-calc": {
      "get": {
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "operationId": "ShowBandwidthCalc",
        "deprecated": true,
        "summary": "查询域名带宽峰值类数据",
        "description": "- 查询域名带宽峰值类数据。\n\n- 支持查询90天内的数据。\n\n- 查询时间跨度不能超过31天。\n\n- 起始时间和结束时间,左闭右开。如查询2022-10-24 00:00:00 到 2022-10-25 00:00:00 的数据,表示取 [2022-10-24 00:00:00, 2022-10-25 00:00:00)的统计数据。\n\n- 起始时间、结束时间必须传毫秒级时间戳,起始时间和结束时间必须同时指定。\n\n- 流量类指标单位统一为Byte(字节)、带宽类指标单位统一为bit/s(比特/秒)、峰值类指标单位统一为bps(比特率),请求数类和状态码类指标单位统一为次数。用于查询指定域名、指定统计指标的明细数据。\n\n- 单租户调用频率:2次/s。",
        "tags": [
          "统计分析"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/start_time_m"
          },
          {
            "$ref": "#/components/parameters/end_time_m"
          },
          {
            "$ref": "#/components/parameters/domain_name_m"
          },
          {
            "$ref": "#/components/parameters/service_area"
          },
          {
            "$ref": "#/components/parameters/enterprise_project_id"
          },
          {
            "name": "calc_type",
            "in": "query",
            "required": true,
            "description": "查询类别,目前支持bw_95(95峰值带宽),bw_peak(日峰值月平均带宽),bw_95_average(95月平均带宽)",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "example": "bw_95"
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalcResponse"
                },
                "examples": {
                  "CalcWithBwPeak": {
                    "$ref": "#/components/examples/CalcWithBwPeak"
                  },
                  "CalcWithBw95": {
                    "$ref": "#/components/examples/CalcWithBw95"
                  },
                  "CalcWithBwAverage": {
                    "$ref": "#/components/examples/CalcWithBwAverage"
                  }
                }
              }
            }
          },
          "400": {
            "description": "错误响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrRsp"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "cdn.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v2",
  "method": "get",
  "uri": null
}