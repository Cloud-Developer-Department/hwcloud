        "summary": "一个证书批量设置多个域名",
        "description": "一个证书配置多个域名,设置域名强制https回源参数。",
        "operationId": "UpdateDomainMultiCertificates",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n",
            "required": true,
            "type": "string"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "当用户开启企业项目功能时,该参数生效,表示修改当前企业项目下加速域名的配置,\"all\"代表所有项目。注意:当使用子帐号调用接口时,该参数必传。\n\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。",
            "type": "string"
          },
          {
            "name": "https",
            "in": "body",
            "required": false,
            "description": "https配置。",
            "schema": {
              "$ref": "#/definitions/UpdateDomainMultiCertificatesRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "type": "string"
              }
            },
            "examples": {
              "application/json": {
                "https": {
                  "domain_name": "example1.com",
                  "https_switch": 1,
                  "access_origin_way": 2,
                  "force_redirect_https": 1,
                  "force_redirect_config": {
                    "redirect_type": "https",
                    "switch": 1
                  },
                  "http2": 0,
                  "expiration_time": 1925791912000,
                  "cert_name": "cdn_test_cert",
                  "certificate": "-----BEGIN CERTIFICATE----------END CERTIFICATE-----",
                  "certificate_type": 0
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/UpdateDomainMultiCertificatesResponseBody"
            }
          }
        },
        "x-request-examples-1": {
          "https": {
            "domain_name": "example1.com",
            "access_origin_way": 2,
            "http2": 0,
            "certificate_type": 0,
            "force_redirect_config": {
              "redirect_type": "https",
              "switch": 1
            },
            "https_switch": 1,
            "cert_name": "cdn_test_cert",
            "certificate": "-----BEGIN CERTIFICATE----------END CERTIFICATE-----",
            "private_key": "-----BEGIN RSA PRIVATE KEY---------END RSA PRIVATE KEY-----"
          }
        }
      }
    }
  },
  "definitions": {
    "UpdateDomainMultiCertificatesRequestBody": {
      "properties": {
        "https": {
          "description": "https配置。",
          "$ref": "#/definitions/UpdateDomainMultiCertificatesRequestBodyContent"
        }
      }
    },
    "ForceRedirect": {
      "required": [
        "switch",
        "redirect_type"
      ],
      "properties": {
        "switch": {
          "type": "integer",
          "description": "强制跳转开关。1打开。0关闭。",
          "format": "int32"
        },
        "redirect_type": {
          "type": "string",
          "description": "强制跳转类型。http:强制跳转HTTP。https:强制跳转HTTPS。"
        }
      }
    },
    "UpdateDomainMultiCertificatesResponseBody": {
      "properties": {
        "https": {
          "description": "https配置。",
          "$ref": "#/definitions/UpdateDomainMultiCertificatesResponseBodyContent"
        }
      }
    },
    "UpdateDomainMultiCertificatesRequestBodyContent": {
      "required": [
        "domain_name",
        "https_switch"
      ],
      "properties": {
        "domain_name": {
          "type": "string",
          "description": "域名列表,逗号分割,上限50个域名"
        },
        "https_switch": {
          "type": "integer",
          "description": "https开关(0:\"关闭\";1:\"设置证书\")。",
          "format": "int32"
        },
        "access_origin_way": {
          "type": "integer",
          "description": "回源方式:1:\"回源跟随\";2:\"HTTP\"(默认),3:https(自建)。",
          "format": "int32"
        },
        "force_redirect_https": {
          "type": "integer",
          "description": "强制跳转HTTPS(0:不强制;1:强制) 为空值时默认设置为关闭。(此参数即将下线,建议使用force_redirect_config修改配置).",
          "format": "int32"
        },
        "force_redirect_config": {
          "description": "强制跳转",
          "$ref": "#/definitions/ForceRedirect"
        },
        "http2": {
          "type": "integer",
          "description": "http2.0(0:关闭;1:开启) 为空值时默认设置为关闭",
          "format": "int32"
        },
        "cert_name": {
          "type": "string",
          "description": "证书名称(设置证书必填)(长度限制为3-64字符)。"
        },
        "certificate": {
          "type": "string",
          "description": "HTTPS协议使用的SSL证书内容,仅支持PEM编码格式。不启用证书则无需输入。初次配置证书时必传。"
        },
        "private_key": {
          "type": "string",
          "description": "HTTPS协议使用的SSL证书私钥内容,仅支持PEM编码格式。不启用证书则无需输入。初次配置证书时必传。"
        },
        "certificate_type": {
          "type": "integer",
          "description": "证书类型(0为自有证书 ;1为托管证书,此时不必不传入证书内容和私钥,自动根据证书名称匹配;不传默认为自有证书)",
          "format": "int32"
        }
      }
    },
    "UpdateDomainMultiCertificatesResponseBodyContent": {
      "required": [
        "domain_name"
      ],
      "properties": {
        "domain_name": {
          "type": "string",
