          "description": "回源方式:1:\"回源跟随\";2:\"HTTP\"(默认),3:https(自建)。",
          "format": "int32"
        },
        "force_redirect_https": {
          "type": "integer",
          "description": "强制跳转HTTPS(0:不强制;1:强制) 。",
          "format": "int32"
        },
        "force_redirect_config": {
          "description": "强制跳转。",
          "$ref": "#/definitions/ForceRedirect"
        },
        "http2": {
          "type": "integer",
          "description": "http2.0(0:关闭;1:开启)。",
          "format": "int32"
        },
        "cert_name": {
          "type": "string",
          "description": "证书名称。"
        },
        "certificate": {
          "type": "string",
          "description": "证书内容。"
        },
        "certificate_type": {
          "type": "integer",
          "description": "证书类型(0为自有证书 , 1为托管证书)。",
          "format": "int32"
        },
        "expiration_time": {
          "type": "integer",
          "description": "证书过期时间。",
          "format": "int64"
        }
      }
