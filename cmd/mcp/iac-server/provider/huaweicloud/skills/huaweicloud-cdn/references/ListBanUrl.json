            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UrlTaskErrorRsp"
                }
              }
            }
          }
        },
        "operationId": "ListBanUrl",
        "tags": [
          "刷新预热"
        ]
      }
    }
