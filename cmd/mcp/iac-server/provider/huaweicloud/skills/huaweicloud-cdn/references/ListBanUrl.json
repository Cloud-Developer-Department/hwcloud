{
  "name": "ListBanUrl",
  "summary": "查询已封禁的URL",
  "tags": "刷新预热",
  "productshort": "CDN",
  "region_id": "cn-north-1",
  "paths": {
    "/v1.0/cdn/content/ban-urls": {
      "get": {
        "x-request-examples-url-1": "GET https://cdn.myhuaweicloud.com/v1.0/cdn/content/ban-urls",
        "summary": "查询已封禁的URL",
        "description": "查询已封禁的URL,如需使用本接口,请提交工单申请。\n- 单租户调用频率:30次/s。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-history-api": "N",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "查询起始时间戳(毫秒),需与结束时间戳同时指定。",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "查询结束时间戳(毫秒),需与开始时间戳同时指定。",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "封禁的url所显示单页最大数量,取值范围为1-50。page_size和page_number必须同时传值。默认值10.",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_number",
            "in": "query",
            "description": "封禁的url当前查询为第几页,取值范围为1-65535。默认值1",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "封禁的url地址。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BanUrlListResponse"
                },
                "example": {
                  "total": 1,
                  "ban_urls": [
                    {
                      "type": "static",
                      "url": "http://www.example.com/1.txt",
                      "create_time": 1652325740318,
                      "modify_time": 1652325740318
                    }
                  ]
                }
              }
            }
          },
          "400": {
