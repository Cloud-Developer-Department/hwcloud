        "deprecated": false,
        "summary": "查询用户计费模式",
        "description": "- 查询用户计费模式。\n\n- 服务区域仅支持mainland_china(国内,默认)和outside_mainland_china(海外)\n\n- 计费模式状态支持active(已生效),upcoming(待生效)两种状态,默认为active(已生效)\n\n- 加速类型仅支持base(基础加速)\n\n- 单租户调用频率:5次/s。",
        "operationId": "ShowChargeModes",
        "tags": [
          "计费管理"
        ],
        "parameters": [
          {
            "name": "product_type",
            "in": "query",
            "required": true,
            "description": "加速类型,base(基础加速)",
            "schema": {
              "type": "string"
            },
            "example": "base"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "查询计费模式状态,active(已生效),upcoming(待生效),不传默认为active(已生效)",
            "schema": {
              "type": "string"
            },
            "example": "active"
          },
          {
            "name": "service_area",
            "in": "query",
            "required": false,
            "description": "服务区域,mainland_china(国内),outside_mainland_china(海外),不传默认为mainland_china(国内)",
            "schema": {
              "type": "string"
            },
            "example": "mainland_china"
          }
        ],
        "x-request-examples-description-1": "查询用户计费模式",
        "x-request-examples-url-1": "GET https://cdn.myhuaweicloud.com/v1.0/cdn/charge/charge-modes?&product_type=base&status=active&service_area=mainland_china",
        "responses": {
