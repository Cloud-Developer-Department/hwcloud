{
  "name": "DisableDomain",
  "summary": "停用加速域名",
  "tags": "域名操作",
  "productshort": "CDN",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v1.0/cdn/domains/{domain_id}/disable": {
      "put": {
        "deprecated": true,
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "description": "停用加速域名。",
        "summary": "停用加速域名",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "domain_id",
            "in": "path",
            "description": "加速域名ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "当用户开启企业项目功能时,该参数生效,表示修改当前企业项目下加速域名的配置,\"all\"代表所有项目。注意:当使用子帐号调用接口时,该参数必传。\n\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "type": "string"
              }
            },
            "examples": {
              "application/json": {
                "domain": {
                  "sources": [
                    {
                      "domain_id": "ff8080***********************722",
                      "origin_type": "ipaddr",
                      "ip_or_domain": "1.2.3.4",
                      "active_standby": 1,
                      "http_port": 80,
                      "https_port": 443
                    }
                  ],
                  "cname": "www.example1.example2.0002.example3.com.c.example4.com",
                  "id": "ff8080***********************722",
                  "user_domain_id": "6e358***********************a441",
                  "domain_name": "www.example1.example2.0002.example3.com",
                  "business_type": "web",
                  "service_area": "mainland_china",
                  "domain_status": "configuring",
                  "https_status": 0,
                  "create_time": 1532403213673,
                  "modify_time": 1532403548714,
                  "domain_origin_host": {
                    "domain_id": "ff8080***********************722",
                    "origin_host_type": "accelerate",
                    "customize_domain": "www.example1.example2.0002.example3.com"
                  },
                  "disabled": 0,
                  "locked": 0,
                  "range_status": "off",
                  "follow_status": "off",
                  "origin_status": "off",
                  "auto_refresh_preheat": 0
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/DomainCommonResponse"
            }
          }
        },
        "x-request-examples-url-1": "PUT https://cdn.myhuaweicloud.com/v1.0/cdn/domains/ff8080***********************722/disable?enterprise_project_id=0",
        "tags": [
          "域名操作"
        ],
        "operationId": "DisableDomain"
      }
    }
  },
  "definitions": {
    "DomainOriginHost": {
      "required": [
        "origin_host_type"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "example": "ab1234a*********************g56",
          "description": "域名ID。"
        },
        "origin_host_type": {
          "type": "string",
          "example": "www.xxxx.com",
          "description": "回源host的类型,accelerate:选择加速域名作为回源host域名,customize:使用自定义的域名作为回源host域名。"
        },
        "customize_domain": {
          "type": "string",
          "example": "customize",
          "description": "自定义回源host域名。"
        }
      }
    },
    "DomainsWithPort": {
      "description": "域名信息。",
      "properties": {
        "id": {
          "type": "string",
          "example": "ab1234a*********************g56",
          "description": "加速域名ID。"
        },
        "domain_name": {
          "type": "string",
          "example": "example1.example2.example3.com",
          "description": "加速域名。"
        },
        "business_type": {
          "type": "string",
          "example": "web",
          "description": "域名业务类型,若为web,则表示类型为网站加速;若为download,则表示业务类型为文件下载加速;若为video,则表示业务类型为点播加速;若为wholeSite,则表示类型为全站加速。"
        },
        "user_domain_id": {
          "type": "string",
          "example": "1e234********************441",
          "description": "域名所属用户的domain_id。"
        },
        "domain_status": {
          "type": "string",
          "example": "online",
          "description": "加速域名状态。取值意义:\n- online表示“已开启”\n- offline表示“已停用”\n- configuring表示“配置中”\n- configure_failed表示“配置失败”\n- checking表示“审核中”\n- check_failed表示“审核未通过”\n- deleting表示“删除中”。"
        },
        "cname": {
          "type": "string",
          "example": "www.example.com.c.test.com",
          "description": "加速域名对应的CNAME。"
        },
        "sources": {
          "type": "array",
          "description": "源站配置。",
          "items": {
            "$ref": "#/definitions/SourceWithPort"
          }
        },
        "domain_origin_host": {
          "description": "域名的回源HOST配置。",
          "$ref": "#/definitions/DomainOriginHost"
        },
        "https_status": {
          "type": "integer",
          "format": "int32",
          "description": "是否开启HTTPS加速。\n0:代表未开启HTTPS加速;\n1:代表开启HTTPS加速,且回源方式为协议跟随;\n2:代表开启HTTPS加速,且回源方式为HTTP;\n3:代表开启HTTPS加速,且回源方式为HTTPS。"
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "example": 1516861994806,
          "description": "域名创建时间,相对于UTC 1970-01-01到当前时间相隔的毫秒数。"
        },
        "modify_time": {
          "type": "integer",
          "format": "int64",
          "example": 1532405346365,
          "description": "域名修改时间,相对于UTC 1970-01-01到当前时间相隔的毫秒数。"
        },
        "disabled": {
          "type": "integer",
          "format": "int32",
          "description": "封禁状态(0代表未禁用;1代表禁用)。"
        },
        "locked": {
          "type": "integer",
          "format": "int32",
          "description": "锁定状态(0代表未锁定;1代表锁定)。"
        },
        "auto_refresh_preheat": {
          "type": "integer",
          "format": "int32",
          "description": "自动刷新预热(0代表关闭;1代表打开)。"
        },
        "service_area": {
          "type": "string",
          "example": "mainland_china",
          "description": "华为云CDN提供的加速服务范围,包含:mainland_china中国大陆、outside_mainland_china中国大陆境外、global全球。",
          "enum": [
            "mainland_china",
            "outside_mainland_china",
            "global"
          ]
        },
        "range_status": {
          "type": "string",
          "example": "off",
          "description": "Range回源状态(off代表关闭 on代表开启)。"
        },
        "follow_status": {
          "type": "string",
          "example": "off",
          "description": "回源跟随状态(off代表关闭 on代表开启)。"
        },
        "origin_status": {
          "type": "string",
          "example": "off",
          "description": "是否暂停源站回源(off代表关闭 on代表开启)。"
        },
        "banned_reason": {
          "type": "string",
          "example": 152,
          "description": "域名禁用原因。\n1:该域名涉嫌违规内容(涉黄/涉赌/涉毒/涉政)已被禁用;\n2:该域名因备案失效已被禁用;\n3:该域名遭受攻击,已被禁用;\n150:该域名涉嫌违规内容涉黄已被禁用;\n151:该域名涉嫌违规内容涉政已被禁用;\n152:该域名涉嫌违规内容涉暴已被禁用;\n153:该域名涉嫌违规内容涉赌已被禁用。"
        },
        "locked_reason": {
          "type": "string",
          "example": "该域名为特殊配置域名,已被锁定。任何域名相关的操作请提交工单进行处理。",
          "description": "域名锁定原因(Changing the config, please wait)。"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "当用户开启企业项目功能时,该参数生效,表示查询资源所属项目,不传表示查询默认项目。注意:当使用子帐号调用接口时,该参数必传。\n\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。"
        }
      }
    },
    "SourceWithPort": {
      "description": "源站信息",
      "required": [
        "ip_or_domain",
        "origin_type",
        "active_standby"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "description": "加速域名id。",
          "example": "ab1234a*********************g56"
        },
        "ip_or_domain": {
          "type": "string",
          "description": "源站IP(非内网IP)或者域名。"
        },
        "origin_type": {
          "type": "string",
          "description": "源站类型,ipaddr:源站IP、 domain:源站域名、obs_bucket:OBS桶域名。",
          "enum": [
            "ipaddr",
            "domain",
            "obs_bucket"
          ],
          "example": "ipaddr"
        },
        "active_standby": {
          "type": "integer",
          "format": "int32",
          "description": "主备状态(1代表主源站;0代表备源站)。"
        },
        "enable_obs_web_hosting": {
          "type": "integer",
          "format": "int32",
          "description": "是否开启Obs静态网站托管(0表示关闭,1表示则为开启),源站类型为obs_bucket时传递。"
        },
        "http_port": {
          "type": "integer",
          "format": "int32",
          "description": "HTTP端口,默认80"
        },
        "https_port": {
          "type": "integer",
          "format": "int32",
          "description": "HTTPS端口,默认443"
        }
      }
    },
    "DomainCommonResponse": {
      "description": "域名详细信息。",
      "properties": {
        "domain": {
          "description": "域名信息。",
          "$ref": "#/definitions/DomainsWithPort"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "cdn.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
