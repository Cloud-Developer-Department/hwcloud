            "in": "query",
            "required": false,
            "description": "- 运营商编码\n- 访问区域统计数据时不能填写\n- 访问国家统计数据时不能填写\n- 访问top_url数据时不能填写",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "example": "dianxin"
          }
