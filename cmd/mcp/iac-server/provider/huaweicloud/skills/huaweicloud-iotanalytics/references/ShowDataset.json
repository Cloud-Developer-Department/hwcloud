{
  "name": "ShowDataset",
  "summary": "查询离线作业结果",
  "tags": "离线分析作业运行结果",
  "productshort": "IoTAnalytics",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/batch/jobs/{job_id}/runs/{run_id}/query-dataset": {
      "post": {
        "tags": [
          "dataset"
        ],
        "summary": "查询离线作业结果",
        "description": "在执行SQL查询语句的作业完成后,查看该作业执行的结果。目前仅支持查看“QUERY”类型作业的执行结果。该API只能查看前1000条的结果记录,若要查看全部的结果记录,需要先导出查询结果再进行查看。",
        "operationId": "ShowDataset",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "令牌",
            "required": true,
            "type": "string",
            "maxLength": 65535,
            "pattern": "^\\S+$",
            "x-maxLength": 65535
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号,用于资源隔离。获取方式请参考获取项目ID。",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 32,
            "pattern": "^[a-z0-9]{32}$",
            "x-maxLength": 32,
            "x-minLength": 32
          },
          {
            "name": "job_id",
            "in": "path",
            "description": "作业ID。",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "name": "run_id",
            "in": "path",
            "description": "作业运行ID。",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "name": "offset",
            "in": "query",
            "description": "当前偏移量,默认为0。",
            "required": false,
            "type": "integer",
            "default": 0,
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的最大作业个数,范围: [1, 100]。默认值:10。",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 100,
            "minimum": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "schema": {
              "$ref": "#/definitions/QueryDatasetResponseBody"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "x-Error": [
              "IoTA.99000010",
              "IoTA.04010301",
              "IoTA.04010304",
              "IoTA.04010306"
            ]
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "x-Error": [
              "IoTA.99000003"
            ]
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "x-Error": [
              "IoTA.99000001",
              "IoTA.99000002",
              "IoTA.99000004",
              "IoTA.99000005",
              "IoTA.99000007",
              "IoTA.99000008",
              "IoTA.99000009"
            ]
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "x-Error": [
              "IoTA.04010109",
              "IoTA.04010201"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "x-Error": [
              "IoTA.99999999",
              "IoTA.04010308"
            ]
          }
        },
        "security": [
          {
            "iota_auth": [
              "write:iota",
              "read:iota"
            ]
          }
        ],
        "x-externalAPI": "YES",
        "x-iftype": "OpenAPI",
        "x-open-for-CLOUD": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "QueryDatasetResponseBody": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int64",
          "description": "作业结果总个数。"
        },
        "run_id": {
          "type": "string",
          "description": "作业运行ID。"
        },
        "job_type": {
          "type": "string",
          "description": "作业类型。"
        },
        "sql_job": {
          "$ref": "#/definitions/SqlJobQueryDataset"
        }
      }
    },
    "ErrorMessage": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误编码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误消息"
        }
      }
    },
    "SqlJobQueryDataset": {
      "type": "object",
      "required": [
        "sql_type"
      ],
      "properties": {
        "sql_type": {
          "type": "string",
          "description": "作业类型。DDL, DCL, IMPORT, EXPORT, QUERY, INSERT."
        },
        "schema": {
          "type": "array",
          "description": "当语句类型为DDL时,返回其结果的列名称及类型。",
          "items": {
            "type": "object",
            "properties": {}
          }
        },
        "rows": {
          "type": "array",
          "description": "当语句类型为DDL时,直接返回其执行结果。",
          "items": {
            "type": "object",
            "properties": {}
          }
        }
      },
      "description": "SQL作业运行结果。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iota.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}