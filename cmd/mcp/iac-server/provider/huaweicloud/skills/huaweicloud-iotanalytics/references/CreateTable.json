{
  "name": "CreateTable",
  "summary": "创建离线数据表",
  "tags": "离线数据表管理",
  "productshort": "IoTAnalytics",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/tables": {
      "post": {
        "tags": [
          "table"
        ],
        "summary": "创建离线数据表",
        "description": "创建离线数据表。",
        "operationId": "CreateTable",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "令牌",
            "required": true,
            "type": "string",
            "maxLength": 65535,
            "pattern": "^\\S+$",
            "x-maxLength": 65535
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号,用于资源隔离。获取方式请参考获取项目ID。",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 32,
            "pattern": "^[a-z0-9]{32}$",
            "x-maxLength": 32,
            "x-minLength": 32
          },
          {
            "in": "body",
            "name": "body",
            "description": "表信息。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateTableRequestBody"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/Table"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "x-Error": [
              "IoTA.99000010",
              "IoTA.04010603",
              "IoTA.04010604",
              "IoTA.04010606",
              "IoTA.04010608"
            ]
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "x-Error": [
              "IoTA.99000003"
            ]
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "x-Error": [
              "IoTA.99000001",
              "IoTA.99000002",
              "IoTA.99000004",
              "IoTA.99000005",
              "IoTA.99000007",
              "IoTA.99000008",
              "IoTA.99000009"
            ]
          },
          "409": {
            "description": "Conflict",
            "x-Error": [
              "IoTA.04010610"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "x-Error": [
              "IoTA.99999999"
            ]
          }
        },
        "security": [
          {
            "iota_auth": [
              "write:iota",
              "read:iota"
            ]
          }
        ],
        "x-externalAPI": "YES",
        "x-iftype": "OpenAPI",
        "x-open-for-CLOUD": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "CreateTableRequestBody": {
      "type": "object",
      "required": [
        "columns",
        "data_type",
        "table_name"
      ],
      "properties": {
        "tags": {
          "type": "string",
          "description": "标签。只能包含数字、英文字母、中文字符、下划线、中划线、逗号以及斜杠。长度为0~128。",
          "maxLength": 128,
          "pattern": "^[一-龥-,/_a-zA-Z0-9]*$"
        },
        "table_name": {
          "type": "string",
          "description": "新增表名称。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z]+[_0-9a-zA-Z]*$"
        },
        "table_alias": {
          "type": "string",
          "description": "新增表别名。只能包含数字、英文字母、中文字符、下划线以及中划线。长度为0~32。",
          "maxLength": 32,
          "pattern": "^[一-龥-_a-zA-Z0-9]*$"
        },
        "description": {
          "type": "string",
          "description": "新增表的描述信息。",
          "maxLength": 256
        },
        "columns": {
          "type": "array",
          "description": "新增表的描述信息。",
          "items": {
            "$ref": "#/definitions/Column"
          }
        },
        "data_type": {
          "type": "string",
          "description": "新增表的数据类型,目前支持:Parquet、CSV格式。",
          "minLength": 3,
          "maxLength": 10,
          "pattern": "^parquet|csv|PARQUET|CSV|Parquet|Csv$"
        },
        "data_source": {
          "type": "string",
          "description": "数据来源。来源类型有:pipeline, default. 默认为default.",
          "maxLength": 16,
          "default": "default"
        },
        "data_store_id": {
          "type": "string",
          "description": "仅当数据来源为pipeline时使用。数据的Data Store ID.",
          "maxLength": 36
        },
        "with_column_header": {
          "type": "boolean",
          "description": "表数据是否包含表头。只有CSV类型数据具有该属性。"
        },
        "delimiter": {
          "type": "string",
          "description": "用户自定义数据分隔符。只有CSV类型数据具有该属性。",
          "maxLength": 8
        },
        "quote_char": {
          "type": "string",
          "description": "用户自定义引用字符,默认为双引号(即“\"”)。只有CSV类型数据具有该属性。",
          "maxLength": 8
        },
        "escape_char": {
          "type": "string",
          "description": "用户自定义转义字符,默认为反斜杠(即\\)。只有CSV类型数据具有该属性。",
          "maxLength": 8
        },
        "date_format": {
          "type": "string",
          "description": "用户自定义日期类型,默认格式为“yyyy-MM-dd”。日期格式字符定义详见表3。只有CSV和JSON类型数据具有该属性。",
          "maxLength": 64
        },
        "timestamp_format": {
          "type": "string",
          "description": "用户自定义时间类型。默认格式为“yyyy-MM-dd HH:mm:ss”。时间戳格式字符定义详见表3。只有CSV和JSON类型数据具有该属性。",
          "maxLength": 64
        }
      }
    },
    "Table": {
      "type": "object",
      "properties": {
        "table_id": {
          "type": "string",
          "description": "表ID。"
        },
        "table_name": {
          "type": "string",
          "description": "表名称。"
        },
        "table_alias": {
          "type": "string",
          "description": "表别名。"
        },
        "created_time": {
          "type": "string",
          "description": "表创建时间。"
        },
        "modified_time": {
          "type": "string",
          "description": "表更新时间。"
        },
        "data_location": {
          "type": "string",
          "description": "数据存储位置,分为IoTA和VIEW"
        },
        "data_type": {
          "type": "string",
          "description": "数据类型,包括“csv”,“parquet”。"
        },
        "data_source": {
          "type": "string",
          "description": "数据来源。来源类型有:pipeline, default. 默认为default."
        },
        "table_type": {
          "type": "string",
          "description": "表类型:IoTA表为MANAGED, View为VIEW"
        },
        "description": {
          "type": "string",
          "description": "表的描述信息。"
        },
        "partition_columns": {
          "type": "array",
          "description": "分区字段。只有OBS分区表有该参数,其他表没有该参数。",
          "items": {
            "type": "string"
          }
        },
        "data_store_id": {
          "type": "string",
          "description": "仅当数据来源为pipeline时返回。Data Store ID."
        },
        "tags": {
          "type": "string",
          "description": "标签。"
        }
      }
    },
    "ErrorMessage": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误编码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误消息"
        }
      }
    },
    "Column": {
      "type": "object",
      "required": [
        "column_name",
        "type"
      ],
      "properties": {
        "column_name": {
          "type": "string",
          "description": "列名称。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z]+[_0-9a-zA-Z]*$"
        },
        "description": {
          "type": "string",
          "description": "列描述。",
          "maxLength": 256
        },
        "type": {
          "type": "string",
          "description": "列类型。",
          "maxLength": 32
        },
        "is_partition_column": {
          "type": "boolean",
          "description": "是否分区列。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "iota.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}