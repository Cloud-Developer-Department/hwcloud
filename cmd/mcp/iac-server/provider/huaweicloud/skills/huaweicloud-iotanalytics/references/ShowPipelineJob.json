      "type": "object",
      "title": "管道配置",
      "description": "管道作业详细配置,每个作业可选择不同的算子进行组合,各算子的使用方法详见:数据管道算子配置指南。",
      "example": {
        "definition": {
          "pipelineName": "IoTDAPipeline",
          "pipelineDescription": "IoTDA产品数据接入管道"
        },
        "operatorInstances": [
          {
            "id": "operator1",
            "className": "IoTDASource",
            "configs": {
              "basicConfigs": {
                "name": "xxx",
                "dataSourceId": "xxx",
                "eventTime": {
                  "jsonPath": "body.services[0].event_time",
                  "pattern": "yyyyMMdd’T’HHmmss’Z’"
                }
              }
            }
          },
          {
            "id": "operator2",
            "className": "ProductFilter",
            "fromOperators": [
              {
                "id": "operator1"
              }
            ],
            "configs": {
              "basicConfigs": {
                "name": "xxx产品",
                "appId": "xxx",
                "productId": "xxx"
              }
            }
          },
          {
            "id": "operator3",
            "className": "DataStoreSink",
            "fromOperators": [
              {
                "id": "operator2"
              }
            ],
            "configs": {
              "basicConfigs": {
                "name": "xx产品的数据输出",
                "dataStore": {
                  "dataStoreName": "xxx",
                  "dataStoreId": "xxx",
                  "dataStoreGroupId": "xxx",
                  "dataStoreProperty": {
                    "deviceId": "header.device_id",
                    "properties": [
                      {
                        "name": "xxx",
                        "type": "INTEGER",
                        "existingProperty": "body.services[?(@.service_id=='Battery')].properties.batteryLevel"
                      },
                      {
                        "name": "Battery_batteryThreshold",
                        "type": "INTEGER",
                        "existingProperty": "body.services[?(@.service_id=='Battery')].properties.batteryThreshold"
                      }
                    ]
                  }
                }
              }
            }
          }
        ]
      },
