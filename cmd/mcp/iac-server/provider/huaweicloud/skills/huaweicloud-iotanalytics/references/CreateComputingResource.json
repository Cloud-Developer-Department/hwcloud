              "IoTA.99999999"
            ]
          }
        },
        "security": [
          {
            "iota_auth": [
              "write:iota",
              "read:iota"
            ]
          }
        ],
        "x-externalAPI": "YES",
        "x-iftype": "OpenAPI",
        "x-open-for-CLOUD": "Y",
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "CreateComputingResourceRequestBody": {
      "type": "object",
      "required": [
        "computing_resource_name",
        "cu_count"
      ],
      "properties": {
        "computing_resource_name": {
          "type": "string",
          "description": "新建的计算资源名称,名称只能包含数字、英文字母和下划线,但不能是纯数字,且不能以下划线开头。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?!\\d+$)[0-9a-zA-Z]+[_0-9a-zA-Z]*$"
        },
        "computing_resource_type": {
          "type": "string",
          "description": "计算资源的类型。默认为sql。",
          "minLength": 3,
          "maxLength": 16,
          "pattern": "^[a-zA-z]{3,16}$",
          "default": "sql"
        },
        "description": {
          "type": "string",
          "description": "计算资源的描述信息。",
          "maxLength": 128
        },
        "cu_count": {
          "type": "integer",
          "description": "与计算资源绑定的最小计算单元个数。设置值当前只支持16,64,256。",
          "minimum": 16,
          "maximum": 512
        },
        "charging_mode": {
          "type": "integer",
          "description": "计算资源的收费模式。只能设置为“1”,表示按照CU时收费。"
        }
      }
    },
    "ErrorMessage": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误编码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误消息"
        }
      }
    },
    "CreateComputingResourceResponseBody": {
      "type": "object",
      "properties": {
        "computing_resource_id": {
          "type": "string",
          "description": "新增计算资源ID。"
        },
        "computing_resource_name": {
          "type": "string",
          "description": "新增计算资源名称。"
        },
        "computing_resource_type": {
          "type": "string",
          "description": "计算资源的类型。目前支持:sql。如果不指定,默认为sql。"
        },
        "description": {
          "type": "string",
          "description": "计算资源的描述信息。"
        },
        "cu_count": {
          "type": "integer",
          "description": "与计算资源绑定的最小计算单元个数。设置值当前只支持16,64,256。"
        },
        "charging_mode": {
          "type": "integer",
          "description": "计算资源的收费模式。只能设置为“1”,表示按照CU时收费。"
        },
        "created_time": {
          "type": "string",
          "description": "创建计算资源时间。时间格式为ISO日期时间格式yyyy-MM-dd'T'HH:mm:ss'Z'。"
        }
      }
    }
  },
  "version": "2.0",
