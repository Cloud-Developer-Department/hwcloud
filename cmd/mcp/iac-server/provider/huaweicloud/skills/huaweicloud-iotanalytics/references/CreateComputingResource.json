{
  "name": "CreateComputingResource",
  "summary": "创建批计算资源",
  "tags": "批计算资源管理",
  "productshort": "IoTAnalytics",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/batch-computing-resources": {
      "post": {
        "tags": [
          "computingResource"
        ],
        "summary": "创建批计算资源",
        "description": "创建批计算资源。",
        "operationId": "CreateComputingResource",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "令牌",
            "required": true,
            "type": "string",
            "maxLength": 65535,
            "pattern": "^\\S+$",
            "x-maxLength": 65535
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目编号,用于资源隔离。获取方式请参考获取项目ID。",
            "required": true,
            "type": "string",
            "maxLength": 32,
            "minLength": 32,
            "pattern": "^[a-z0-9]{32}$",
            "x-maxLength": 32,
            "x-minLength": 32
          },
          {
            "in": "body",
            "name": "body",
            "description": "计算资源信息。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateComputingResourceRequestBody"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/CreateComputingResourceResponseBody"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "x-Error": [
              "IoTA.99000010",
              "IoTA.04010501"
            ]
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "x-Error": [
              "IoTA.99000003"
            ]
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "x-Error": [
              "IoTA.99000001",
              "IoTA.99000002",
              "IoTA.99000004",
              "IoTA.99000005",
              "IoTA.99000007",
              "IoTA.99000008",
              "IoTA.99000009",
              "IoTA.04010504"
            ]
          },
          "409": {
            "description": "Conflict",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
            "x-Error": [
              "IoTA.99000011",
              "IoTA.04010506"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            },
