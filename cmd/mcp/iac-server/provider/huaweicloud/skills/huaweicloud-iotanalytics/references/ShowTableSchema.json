          "type": "string",
          "description": "错误编码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误消息"
        }
      }
    },
    "Column": {
      "type": "object",
      "required": [
        "column_name",
        "type"
      ],
      "properties": {
        "column_name": {
          "type": "string",
          "description": "列名称。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z]+[_0-9a-zA-Z]*$"
        },
        "description": {
          "type": "string",
          "description": "列描述。",
          "maxLength": 256
