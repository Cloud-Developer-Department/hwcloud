{
  "name": "ShowApp",
  "summary": "查询单个应用",
  "tags": "应用管理",
  "productshort": "CloudRTC",
  "region_id": "cn-north-4",
  "paths": {
    "/apps/{app_id}": {
      "get": {
        "tags": [
          "应用管理"
        ],
        "summary": "查询单个应用",
        "description": "调用此接口查询单个应用详情。",
        "operationId": "ShowApp",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "内容类型。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "default": "application/json;charset=UTF-8"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "name": "app_id",
            "in": "path",
            "description": "应用id",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "app详细信息",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/App"
            },
            "examples": {
              "application/json": {
                "app_name": "example",
                "app_id": "123456789abcdefghijklmno",
                "state": {
                  "state": "ACTIVATION",
                  "update_time": "2020-07-26T07:03:05.075Z"
                },
                "scope": "DOMESTIC",
                "tenant_name": "hwstaff_pub_videortc",
                "domain": "123456789abcdefghijklmno.rtc.huawei.com",
                "create_time": "2020-07-26T07:03:05.075Z",
                "authentication": {
                  "enable": true,
                  "expire": 300,
                  "app_key": "12345ABCDEF12345",
                  "update_time": "2020-07-26T07:03:05.075Z"
                },
                "callbacks": {
                  "record_callback": {
                    "url": "http://mydomain.com",
                    "auth_key": "78912374ae8cdb38",
                    "update_time": "2020-07-26T07:53:05.075Z"
                  }
                },
                "auto_record_mode": {
                  "mode": "AUTO_RECORD_OFF",
                  "update_time": "2020-07-26T07:53:05.075Z"
                }
              }
            }
          },
          "400": {
            "description": "语义有误,当前请求无法被服务器理解,或参数有误",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "RTC.00001003",
                "error_msg": "InvalidParameterValue"
              }
            }
          },
          "404": {
            "description": "app编号不存在",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "RTC.00001003",
                "error_msg": "InvalidParameterValue"
              }
            }
          },
          "500": {
            "description": "查询失败,服务器端错误",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "RTC.00002xxx",
                "error_msg": "InternalError"
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://rtc-api.myhuaweicloud.com/v2/apps/{app_id}"
      }
    }
  },
  "definitions": {
    "CommonRsp": {
      "description": "通用返回",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "AppState": {
      "description": "app状态信息",
      "properties": {
        "state": {
          "description": "状态\n- ACTIVATION:开启\n- DEACTIVATION:停用\n- ARREARS:欠费\n- DELETED:已删除",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "ACTIVATION",
            "DEACTIVATION",
            "ARREARS",
            "DELETED"
          ]
        },
        "update_time": {
          "description": "app鉴权的更新时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "App": {
      "description": "app详细信息",
      "properties": {
        "app_name": {
          "description": "app名称",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "app_id": {
          "description": "应用id",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "state": {
          "description": "app状态",
          "$ref": "#/definitions/AppState"
        },
        "scope": {
          "description": "RTC覆盖范围。\n\n取值如下:\n\n  - DOMESTIC:国内范围。\n  - OVERSEA:海外范围。\n  - GLOBAL:全球范围。",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "DOMESTIC",
            "OVERSEA",
            "GLOBAL"
          ]
        },
        "tenant_name": {
          "description": "账号名",
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "domain": {
          "description": "域名,App对应域名",
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "create_time": {
          "description": "创建时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "authentication": {
          "description": "鉴权配置",
          "$ref": "#/definitions/AppAuth"
        },
        "callbacks": {
          "description": "回调配置",
          "$ref": "#/definitions/AppCallbacks"
        },
        "auto_record_mode": {
          "description": "自动录制配置",
          "$ref": "#/definitions/AppAutoRecordMode"
        }
      },
      "example": {
        "app_name": "dingkaich_app1",
        "app_id": "5f1d2ab42f29b38b6bae5633",
        "state": {
          "state": "ACTIVATION",
          "update_time": "2020-07-26T07:03:05.075Z"
        },
        "scope": "DOMESTIC",
        "tenant_name": "hwstaff_pub_videortc",
        "domain": "5f1d2ab42f29b38b6bae5633.rtc.huawei.com",
        "project_id": "ad7456ce8ef89adf567",
        "create_time": "2020-07-26T07:03:05.075Z",
        "authentication": {
          "enable": true,
          "expire": 300,
          "app_key": "57560FC44074433E",
          "update_time": "2020-07-26T07:03:05.075Z"
        },
        "callbacks": {
          "push_callback": {
            "url": "",
            "auth_key": "",
            "update_time": ""
          },
          "record_callback": {
            "url": "http://mydomain.com",
            "auth_key": "78912374ae8cdb38",
            "update_time": "2020-07-26T07:53:05.075Z"
          }
        },
        "auto_record_mode": {
          "mode": "AUTO_RECORD_OFF",
          "update_time": "2020-07-26T07:53:05.075Z"
        }
      }
    },
    "AppCallbackUrl": {
      "description": "回调配置",
      "properties": {
        "url": {
          "description": "回调通知url地址,url必须以http://或https://开头,需要支持POST调用。",
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "default": ""
        },
        "auth_key": {
          "description": "回调秘钥,主要用于鉴权。如果不设置或者为空,则回调不会增加鉴权头域字段。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "default": ""
        },
        "notify_event_subscription": {
          "description": "订阅云端录制通知消息。\n\n取值如下:\n\n- RECORD_NEW_FILE_START:开始创建新的录制文件。\n\n- RECORD_FILE_COMPLETE:录制文件生成完成。",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "enum": [
              "RECORD_NEW_FILE_START",
              "RECORD_FILE_COMPLETE"
            ]
          }
        },
        "update_time": {
          "description": "更新时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        }
      }
    },
    "AppAuth": {
      "description": "鉴权配置",
      "properties": {
        "enable": {
          "description": "开启或关闭URL鉴权",
          "type": "boolean",
          "default": true
        },
        "expire": {
          "description": "接入RTC建链认证时的signature的有效期。单位:秒。默认300秒。signature由app_key生成",
          "type": "integer",
          "default": 300,
          "minimum": 60,
          "maximum": 2592000
        },
        "app_key": {
          "description": "app鉴权秘钥",
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "default": ""
        },
        "update_time": {
          "description": "app鉴权的更新时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "example": {
        "enable": true,
        "expire": 300,
        "app_key": "57560FC44074433E",
        "update_time": "2020-07-26T07:03:05.075Z"
      }
    },
    "AppAutoRecordMode": {
      "description": "app自动录制模式",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "description": "录制模式。\n- AUTO_RECORD_OFF:关闭自动录制。\n- AUTO_INDIVIDUAL_RECORD:开启单流自动录制,此时record_rule_id必须非空。",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "default": "AUTO_RECORD_OFF",
          "enum": [
            "AUTO_RECORD_OFF",
            "AUTO_INDIVIDUAL_RECORD"
          ]
        },
        "record_rule_id": {
          "description": "录制规则id。",
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "default": ""
        },
        "update_time": {
          "description": "更新时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        }
      },
      "example": {
        "mode": "AUTO_RECORD_OFF",
        "update_time": "2020-07-26T07:53:05.075Z"
      }
    },
    "AppCallbacks": {
      "description": "app回调配置",
      "properties": {
        "push_callback": {
          "description": "转推回调",
          "$ref": "#/definitions/AppCallbackUrl"
        },
        "record_callback": {
          "description": "录制回调",
          "$ref": "#/definitions/AppCallbackUrl"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rtc-api.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
  "uri": null
}