{
  "name": "ListRtcClientQosDetails",
  "summary": "查询用户通话指标",
  "tags": "数据统计分析",
  "productshort": "CloudRTC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/rtc/client/qos/details": {
      "get": {
        "tags": [
          "RtcStatisticsDataApi"
        ],
        "summary": "查询用户通话指标",
        "description": "查询用户通话质量指标数据。\n\n可查询5天内的数据,mid 不为null,查询实时数据时,查询起止时间不超过24个小时,每次查询单个用户时,支持跨天查询。\n",
        "operationId": "ListRtcClientQosDetails",
        "x-support-sdk": "Y",
        "x-external-api": true,
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 32384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息,与路径参数中的项目ID相同。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](rtc_07_0015.xml)。\n",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "query",
            "name": "domain",
            "description": "域名\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "5f5e17550fa3f268f2ce08ec.sparkrtc.myhuaweicloud.com"
          },
          {
            "in": "query",
            "name": "app_id",
            "description": "应用id\n",
            "type": "string",
            "required": true,
            "minLength": 0,
            "maxLength": 256,
            "x-example": "5fa682b34a974f7ad24d223b"
          },
          {
            "in": "query",
            "name": "room_id",
            "description": "房间ID\n",
            "type": "string",
            "required": true,
            "minLength": 0,
            "maxLength": 256,
            "x-example": "6951a79e9f811ebbd2ac58d7ac82553"
          },
          {
            "in": "query",
            "name": "user_id",
            "description": "发送端用户\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "942f781d7b661634ea1a4d63532e670ca00486facb13b532abe9f28bagent"
          },
          {
            "in": "query",
            "name": "peer_id",
            "description": "需查询接收端用户id\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "956f781d7b661634rt1a4d635"
          },
          {
            "in": "query",
            "name": "stream_id",
            "description": "流号\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 256
          },
          {
            "in": "query",
            "name": "direction",
            "description": "判断上下行数据\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "up"
          },
          {
            "in": "query",
            "name": "mid",
            "enum": [
              "appcpu",
              "syscpu",
              "abit",
              "ablock",
              "vbit",
              "dbit",
              "vfps",
              "dfps",
              "vblock",
              "dblock",
              "aloss",
              "vloss",
              "dloss",
              "vwidth",
              "vheight",
              "dwidth",
              "dheight",
              "ajitter",
              "artt",
              "vjitter",
              "vrtt",
              "djitter",
              "drtt"
            ],
            "description": "需查询的指标,填all则返回所有指标。多个指标使用','分割\n- appcpu:端侧APP CPU使用率(appCpu)\n- syscpu:端侧系统 CPU使用率(deviceCpu)\n- abit:端侧音频码率kpbs(bitrate)\n- vbit:端侧视频码率kbps(bitRate)\n- dbit:端侧辅流码率kbps(bitRate)\n- vfps:端侧视频帧率fps(actFrameRate)\n- dfps:端侧辅流帧率fps(actFrameRate)\n- vblock:端侧视频卡顿率(统计大于等于600ms视频卡顿)\n- dblock:端侧辅流卡顿率(统计大于等于600ms辅流卡顿)\n- aloss:端侧音频丢包率(pktLoss)\n- vloss:端侧视频丢包率(pktLoss)\n- dloss:端侧辅流丢包率(pktLoss)\n- vwidth:端侧视频分辨率宽(actPicW)\n- vheight:端侧视频分辨率高(actPicH)\n- dwidth:端侧辅流分辨率宽(actPicW)\n- dheight:端侧辅流分辨率高(actPicH)\n- ajitter:端侧音频抖动率(jitter)\n- artt:端侧音频时延(rtt)\n- vjitter:端侧视频抖动率(jitter)\n- vrtt:端侧视频时延(rtt)\n- djitter:端侧辅流抖动率(jitter)\n- drtt:端侧辅流时延(rtt)\n",
            "type": "string",
            "required": true,
            "minItems": 0,
            "maxItems": 8928,
            "x-example": "artt"
          },
          {
            "in": "query",
            "name": "start_time",
            "type": "string",
            "description": "查询起始时间。UTC时间,格式:yyyy-mm-ddThh:mm:ssZ,如2020-04-23T06:00:00Z\n",
            "required": true,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "2020-04-23T06:00:00Z"
          },
          {
            "in": "query",
            "name": "end_time",
            "type": "string",
            "description": "查询结束时间。UTC时间,格式:yyyy-mm-ddThh:mm:ssZ,如2020-04-23T07:00:00Z\n",
            "required": true,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "2020-04-23T08:00:00Z"
          },
          {
            "in": "query",
            "name": "time_type",
            "type": "string",
            "description": "查询的时间类型取值:stime 数据库打点时间,不填默认ctime查询",
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "description": "查询结果限制\n",
            "default": 10,
            "type": "integer",
            "format": "int32",
            "required": false,
            "minimum": 1,
            "maximum": 100,
            "x-example": 30
          },
          {
            "in": "query",
            "name": "offset",
            "description": "查询偏移量\n",
            "minimum": 0,
            "maximum": 1844674407,
            "default": 0,
            "required": false,
            "type": "integer",
            "format": "int32",
            "x-example": 300
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功返回。\n",
            "schema": {
              "$ref": "#/definitions/QosQualityDataRsp"
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求的唯一标识"
              }
            },
            "examples": {
              "application/json": {
                "quality": [
                  {
                    "date": "2020-06-04",
                    "join_success_rate": 0.99
                  }
                ]
              }
            }
          },
          "400": {
            "description": "查询失败返回",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DATA.100011001",
                "error_msg": "Required String parameter 'app_id' is not present"
              }
            }
          }
        },
        "x-request-examples-url-1": "GET /v1/{project_id}/rtc/client/qos/details?app_id=5fa682b34a974f7ad24d223b&room_id=6951a79e9f811ebbd2ac58d7ac82553&mid=appcpu&start_time=2020-04-23T06:00:00Z&end_time=2020-04-23T07:00:00Z\n"
      }
    }
  },
  "definitions": {
    "QosQualityDataRsp": {
      "type": "object",
