{
  "name": "ListRtcRoomList",
  "summary": "查询房间列表",
  "tags": "数据统计分析",
  "productshort": "CloudRTC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/rtc/rooms": {
      "get": {
        "tags": [
          "RtcStatisticsDataApi"
        ],
        "summary": "查询房间列表",
        "description": "指定事件范围查询这段期间创建的房间列表。\n\n最大查询跨度90天。\n",
        "operationId": "ListRtcRoomList",
        "x-support-sdk": "Y",
        "x-external-api": true,
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 32384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息,与路径参数中的项目ID相同。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](rtc_07_0015.xml)。\n",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "query",
            "name": "app",
            "description": "应用标识\n",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "5fa682b34a974f7ad24d223b"
          },
          {
            "in": "query",
            "name": "room_id",
            "description": "房间id\n",
            "type": "string",
            "required": false,
            "minLength": 0,
            "maxLength": 256,
            "x-example": "6951a79e9f811ebbd2ac58d7ac82553"
          },
          {
            "in": "query",
            "name": "state",
            "enum": [
              "RUNNING",
              "CLOSED"
            ],
            "description": "房间状态,取值如下:\n- RUNNING:开启中\n- CLOSED:已关闭\n",
            "type": "string",
            "required": false,
            "x-example": "RUNNING"
          },
          {
            "in": "query",
            "name": "start_time",
            "description": "查询起始时间。UTC时间,格式:YYYY-MM-DDThh:mm:ssZ,如2020-04-23T06:00:00Z,不写默认读取过去1小时数据数据。\n",
            "type": "string",
            "required": false,
            "minLength": 0,
            "maxLength": 256,
            "x-example": "2020-04-23T06:00:00Z"
          },
          {
            "in": "query",
            "name": "end_time",
            "description": "查询结束时间。UTC时间,格式:YYYY-MM-DDThh:mm:ssZ,如2020-04-23T07:00:00Z,不写默认为当前时间。\n",
            "type": "string",
            "required": false,
            "minLength": 0,
            "maxLength": 256,
            "x-example": "2020-04-25T06:00:00Z"
          },
          {
            "in": "query",
            "name": "limit",
            "description": "查询结果条数\n",
            "default": 10,
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100,
            "x-example": 2
          },
          {
            "in": "query",
            "name": "offset",
            "description": "查询偏移量\n",
            "minimum": 0,
            "maximum": 1844674407,
            "default": 0,
            "required": false,
            "type": "integer",
            "format": "int32",
            "x-example": 100
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功返回。\n",
            "schema": {
              "$ref": "#/definitions/RtcServerRoomInfoRsp"
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求的唯一标识"
              }
            },
            "examples": {
              "application/json": {
                "total": 1,
                "room_info_list": [
                  {
                    "domain": "603f71bdfa163e500aff1106c8xxxxxx.sparkrtc.myhuaweicloud.com",
                    "app": "603f71bdfa163e500aff1106c8xxxxxx",
                    "room_id": "ac146d0f2779916191716070xxxxxx",
                    "state": "RUNNING",
                    "start_time": "2021-04-23T09:55:30Z",
                    "end_time": "-"
                  }
                ],
                "offset": 0,
                "limit": 2
              }
            }
          },
          "400": {
            "description": "查询失败返回",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DATA.100011001",
                "error_msg": "Required String parameter 'app' is not present"
              }
            }
          }
        },
        "x-request-examples-url-1": "GET /v1/{project_id}/rtc/rooms?app=5fa682b34a974f7ad24d223b\n"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "RtcServerRoomInfoRsp": {
      "type": "object",
      "properties": {
        "total": {
          "description": "总数",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1844674407
        },
        "limit": {
          "description": "查询结果限制",
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "description": "查询偏移量",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1844674407
        },
        "room_info_list": {
          "description": "房间列表信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RtcServerRoomInfo"
          },
          "minItems": 0,
          "maxItems": 8928
        }
      }
    },
    "RtcServerRoomInfo": {
      "type": "object",
      "properties": {
        "domain": {
          "description": "域名",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "app": {
          "description": "应用标识",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "room_id": {
          "description": "房间ID",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "description": "房间状态,取值如下:\n - RUNNING:开启中\n - CLOSED:已关闭\n",
          "type": "string",
          "enum": [
            "RUNNING",
            "CLOSED"
          ]
        },
        "duration": {
          "description": "房间持续时长",
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1844674407
        },
        "start_time": {
          "description": "房间开始时间,即第一个用户加入房间时间,UTC时间,格式:YYYY-MM-DDThh:mm:ssZ,如2020-04-23T07:00:00Z\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "end_time": {
          "description": "房间关闭时间,即最后一个room_uuid关闭的时间,UTC时间,格式:YYYY-MM-DDThh:mm:ssZ,如2020-04-23T07:00:00Z,若房间未关闭,则返回 “-”\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rtc-api.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}