    "IndividualStreamJob": {
      "properties": {
        "job_id": {
          "description": "任务编号",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "stream_name": {
          "description": "流名",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "app_id": {
          "description": "应用id",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "room_id": {
          "description": "房间id",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "user_id": {
          "description": "选看的用户id,单个录制任务内保证唯一",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "is_record_audio": {
          "description": "是否录制音频。\n\n- true:录制音频\n- false:不录制音频\n\n缺省为true。",
          "type": "boolean",
          "default": true
        },
        "video_type": {
          "description": "标识视频流的类型,可选摄像头流或者屏幕分享流,未填写表示不录制视频。\n\n- CAMERASTREAM:摄像头视频流\n- SCREENSTREAM:屏幕分享视频流\n\n默认为CAMERASTREAM。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "enum": [
            "CAMERASTREAM",
            "SCREENSTREAM",
            ""
          ],
          "default": ""
        },
        "select_stream_type": {
          "description": "指定窗口拉取的分辨率档位。\n\n- LD\n- SD\n- HD\n- FHD\n\n缺省为FHD。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "enum": [
            "LD",
            "SD",
            "HD",
            "FHD"
          ],
          "default": "FHD"
        },
        "max_idle_time": {
          "description": "最长空闲频道时间。\n\n取值范围:[5,43200],默认值为30。\n\n单位:秒。\n\n如果频道内无连麦方的状态持续超过该时间,录制程序会自动退出。退出后,再次调用start请求,会产生新的录制任务。\n\n连麦方指:joiner或者publisher的用户。",
          "type": "integer",
          "minimum": 5,
          "maximum": 43200,
          "default": 30
        },
        "record_param": {
          "description": "录制参数",
          "$ref": "#/definitions/RecordParam"
        },
        "create_time": {
          "description": "创建时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "update_time": {
          "description": "更新时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "state": {
          "description": "任务状态。\n\n- INIT:任务正在初始化\n- RUNNING:任务正在运行\n- STOPPED:任务已停止",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "INIT",
            "RUNNING",
            "STOPPED"
          ]
        },
        "stop_reason": {
          "description": "任务结束原因\n- TENANT_STOP\n- EXCEED_MAX_IDLE_TIME\n- INTERNAL_ERROR",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "TENANT_STOP",
            "EXCEED_MAX_IDLE_TIME",
            "INTERNAL_ERROR"
          ]
        },
        "description": {
          "description": "针对任务状态的详细信息描述",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start_time": {
          "description": "任务开始时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "stop_time": {
          "description": "任务完成时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "example": {
        "job_id": "001",
        "app_id": "1",
        "room_id": "100",
        "user_id": "user001",
        "is_record_audio": true,
        "video_type": "CAMERASTREAM",
        "select_stream_type": "FHD",
        "max_idle_time": 30,
        "record_param": {
          "record_rule_id": "5f5e172b9016ed5b0961a43"
        },
        "create_time": "2006-01-02T15:04:05.075Z",
        "start_time": "2006-01-02T15:04:05.075Z"
      }
    },
    "UpdateIndividualJobReq": {
      "description": "更新单流任务请求,转推和录制至少选一个",
