{
  "name": "ShowRecordRule",
  "summary": "查询录制规则",
  "tags": "录制规则管理",
  "productshort": "CloudRTC",
  "region_id": "cn-north-4",
  "paths": {
    "/apps/{app_id}/record-rules/{rule_id}": {
      "get": {
        "tags": [
          "录制规则管理"
        ],
        "summary": "查询录制规则",
        "description": "调用此接口查询指定录制规则。",
        "operationId": "ShowRecordRule",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "内容类型。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "default": "application/json;charset=UTF-8"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "name": "app_id",
            "in": "path",
            "description": "应用id",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          {
            "name": "rule_id",
            "in": "path",
            "description": "规则id",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "获取录制规则配置成功",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/RecordRule"
            },
            "examples": {
              "application/json": {
                "app_id": "123456abc",
                "rule_id": "456789abc",
                "create_time": "2006-01-02T15:04:05.075Z",
                "obs_addr": {
                  "bucket": "obsName",
                  "location": "cn-north-4",
                  "object": "Record/",
                  "project_id": "ad7456ce8ef89adf567"
                },
                "record_formats": [
                  "MP4"
                ],
                "mp4_config": {
                  "record_cycle": 60,
                  "record_max_duration_to_merge_file": 0
                },
                "update_time": "2006-01-02T15:04:05.075Z"
              }
            }
          },
          "400": {
            "description": "获取配置失败,语义有误,当前请求无法被服务器理解,或参数有误",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "RTC.00001003",
                "error_msg": "InvalidParameterValue"
              }
            }
          },
          "404": {
            "description": "获取配置失败,配置不存在",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "RTC.00001003",
                "error_msg": "InvalidParameterValue"
              }
            }
          },
          "500": {
            "description": "获取配置失败,服务器端错误",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "RTC.00002xxx",
                "error_msg": "InternalError"
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://rtc-api.myhuaweicloud.com/v2/apps/{app_id}/record-rules/{rule_id}"
      }
    }
  },
  "definitions": {
    "CommonRsp": {
      "description": "通用返回",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "MP4RecordConfig": {
      "required": [
        "record_cycle"
      ],
      "properties": {
        "record_cycle": {
          "type": "integer",
          "description": "周期录制时长。\n\n取值范围:[60,10800]。\n\n单位:秒。",
          "maximum": 10800,
          "minimum": 60
        },
        "record_prefix": {
          "type": "string",
          "description": "录制文件含路径和文件名的前缀。\n\n默认{app_id}/{record_format}/{stream}\\_{file_start_time}/{stream}\\_{file_start_time}\n\n可自定义以下特殊变量:\n- {app_id}:应用id\n- {record_format}:录制格式\n- {stream}:流名\n- {file_start_time}:文件生成时间",
          "default": "{app_id}/{record_format}/{stream}_{file_start_time}/{stream}_{file_start_time}",
          "minLength": 1,
          "maxLength": 512
        },
        "record_max_duration_to_merge_file": {
          "type": "integer",
          "description": "录制MP4拼接时长,如果流中断超过该时间,则生成新文件。\n\n取值范围:[0,300],缺省为0。\n\n单位:秒。\n\n如果为0表示流中断就生成新文件。",
          "default": 0,
          "maximum": 300,
          "minimum": 0
        }
      }
    },
    "HLSRecordConfig": {
      "required": [
        "record_cycle"
      ],
      "properties": {
        "record_cycle": {
          "type": "integer",
          "description": "周期录制时长。\n\n取值范围:[60,43200]或者0,如果为0则整个流录制为一个文件。\n\n单位:秒。",
          "minimum": 0,
          "maximum": 43200
        },
        "record_prefix": {
          "type": "string",
          "description": "录制m3u8文件含路径和文件名的前缀\n\n默认{app_id}/{record_format}/{stream}\\_{file_start_time}/{stream}\\_{file_start_time}\n\n可自定义以下特殊变量:\n- {app_id}:应用id\n- {record_format}:录制格式\n- {stream}:流名\n- {file_start_time}:文件生成时间",
          "default": "{app_id}/{record_format}/{stream}_{file_start_time}/{stream}_{file_start_time}\n",
          "minLength": 1,
          "maxLength": 512
        },
        "record_slice_duration": {
          "type": "integer",
          "description": "录制HLS时ts的切片时长,非必填。\n\n取值范围:[2,60],缺省为10。\n\n单位:秒。",
          "minimum": 2,
          "maximum": 60,
          "default": 10
        },
        "record_max_duration_to_merge_file": {
          "type": "integer",
          "description": "录制HLS文件拼接时长,如果流中断超过该时间,则生成新文件。\n\n取值范围:[-1,300],缺省为0。\n\n单位:秒。\n\n- 如果为0表示流中断就生成新文件。\n- 如果为-1则表示流中断恢复后追加到原来的文件中(相隔不超过30天)。",
          "minimum": -1,
          "maximum": 300,
          "default": 0
        }
      }
    },
    "RecordObsFileAddr": {
      "required": [
        "location",
        "project_id",
        "bucket"
      ],
      "properties": {
        "location": {
          "type": "string",
          "description": "OBS Bucket所在RegionID\n- cn-north-4",
          "enum": [
            "cn-north-4"
          ]
        },
        "project_id": {
          "type": "string",
          "description": "OBS Bucket所在Region的项目ID",
          "minLength": 1,
          "maxLength": 128
        },
        "bucket": {
          "type": "string",
          "description": "OBS的bucket名称",
          "maxLength": 256,
          "minLength": 1,
          "example": "mybucket"
        },
        "object": {
          "type": "string",
          "description": "OBS对象路径,遵守OBS Object定义。如果为空则保存到根目录",
          "maxLength": 1024,
          "minLength": 0,
          "example": "Record"
        }
      }
    },
    "RecordRule": {
      "description": "创建状态回调请求体",
      "properties": {
        "rule_id": {
          "type": "string",
          "description": "规则id,由服务端返回。创建或修改规则的时候不携带",
          "minLength": 1,
          "maxLength": 128
        },
        "app_id": {
          "description": "应用id",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "obs_addr": {
          "description": "保存录制文件所在的桶信息",
          "$ref": "#/definitions/RecordObsFileAddr"
        },
        "record_formats": {
          "description": "录制格式:HLS格式或者MP4格式",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "enum": [
              "HLS",
              "MP4"
            ]
          }
        },
        "hls_config": {
          "description": "hls格式录制规则管理",
          "$ref": "#/definitions/HLSRecordConfig"
        },
        "mp4_config": {
          "description": "mp4格式录制规则管理",
          "$ref": "#/definitions/MP4RecordConfig"
        },
        "create_time": {
          "description": "创建时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "update_time": {
          "description": "更新时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "example": {
        "app_id": "1",
        "obs_addr": {
          "location": "cn-north-4",
          "bucket": "obsName",
          "object": "/Record",
          "project_id": "ad7456ce8ef89adf567"
        },
        "record_formats": [
          "HLS"
        ]
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rtc-api.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "get",
  "uri": null
}