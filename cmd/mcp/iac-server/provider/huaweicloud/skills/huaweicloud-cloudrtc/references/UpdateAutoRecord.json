{
  "name": "UpdateAutoRecord",
  "summary": "更新自动录制配置",
  "tags": "自动录制配置",
  "productshort": "CloudRTC",
  "region_id": "cn-north-4",
  "paths": {
    "/apps/{app_id}/auto-record-mode": {
      "put": {
        "tags": [
          "自动录制配置"
        ],
        "summary": "更新自动录制配置",
        "consumes": [
          "application/json;charset=utf-8"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "description": "更新自动录制配置,租户可以开启自动单流录制或者停用自动单流录制。",
        "x-constraint": "开启自动单流录制功能之后,只针对新创建的房间有效,对开启自动录制功能之前已经创建的房间不生效。\n\n单流自动录制任务的流名规则:\n\n{appid}\\_{roomid}\\_{userid}\\_{media_type}\\_{video_type}\n\n{media_type}可取值为v(代表纯视频录制),av(代表音视频录制)。\n\n{video_type}可取值为m(代表录主流摄像头视频),a(代表录辅流视频)。\n\n可能的组合有_av_m(自动录制主流和音频)和_v_a(自动录制辅流视频,无音频)。",
        "operationId": "UpdateAutoRecord",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "内容类型。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "default": "application/json;charset=UTF-8"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "name": "app_id",
            "in": "path",
            "description": "应用id",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          {
            "name": "UpdateAutoRecordRequestBody",
            "in": "body",
            "description": "自动录制配置参数",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AutoRecordModeReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "任务创建成功,返回app的概要信息,如包含app_id",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/AutoRecordModeRsp"
            },
            "examples": {
              "application/json": {
                "app_id": "123456789abcdefghijklmno",
                "auto_record_mode": {
                  "mode": "AUTO_RECORD_OFF",
                  "update_time": "2020-07-26T07:53:05.075Z"
                }
              }
            }
          },
          "400": {
            "description": "更新自动录制任务失败,语义有误,当前请求无法被服务器理解,或参数有误",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "RTC.00001003",
                "error_msg": "InvalidParameterValue"
              }
            }
          },
          "404": {
            "description": "更新自动录制任务失败,应用不存在",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "RTC.00001003",
                "error_msg": "InvalidParameterValue"
              }
            }
          },
          "500": {
            "description": "更新自动录制任务失败,服务器错误",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "RTC.00002xxx",
                "error_msg": "InternalError"
              }
            }
          }
        },
        "x-request-examples-url-1": "PUT https://rtc-api.myhuaweicloud.com/v2/apps/{app_id}/auto-record-mode",
        "x-request-examples-1": {
          "mode": "AUTO_RECORD_OFF"
        }
      }
    }
  },
  "definitions": {
    "CommonRsp": {
      "description": "通用返回",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "AppAutoRecordMode": {
      "description": "app自动录制模式",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "description": "录制模式。\n- AUTO_RECORD_OFF:关闭自动录制。\n- AUTO_INDIVIDUAL_RECORD:开启单流自动录制,此时record_rule_id必须非空。",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "default": "AUTO_RECORD_OFF",
          "enum": [
            "AUTO_RECORD_OFF",
            "AUTO_INDIVIDUAL_RECORD"
          ]
        },
        "record_rule_id": {
          "description": "录制规则id。",
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "default": ""
        },
        "update_time": {
          "description": "更新时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        }
      },
      "example": {
        "mode": "AUTO_RECORD_OFF",
        "update_time": "2020-07-26T07:53:05.075Z"
      }
    },
    "AutoRecordModeRsp": {
      "description": "查询修改app自动录制响应",
      "properties": {
        "app_id": {
          "description": "应用id",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "auto_record_mode": {
          "description": "自动录制配置",
          "$ref": "#/definitions/AppAutoRecordMode"
        }
      },
      "example": {
        "app_id": "5f1d2ab42f29b38b6bae5633",
        "auto_record_mode": {
          "mode": "AUTO_RECORD_OFF",
          "update_time": "2020-07-26T07:53:05.075Z"
        }
      }
    },
    "AutoRecordModeReq": {
      "description": "配置app自动录制模式请求",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "description": "录制模式。\n- AUTO_RECORD_OFF:关闭自动录制。\n- AUTO_INDIVIDUAL_RECORD:开启单流自动录制,此时record_rule_id必须非空。",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "default": "AUTO_RECORD_OFF",
          "enum": [
            "AUTO_RECORD_OFF",
            "AUTO_INDIVIDUAL_RECORD"
          ]
        },
        "record_rule_id": {
          "description": "录制规则id。",
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "default": ""
        }
      },
      "example": {
        "mode": "AUTO_INDIVIDUAL_RECORD",
        "record_rule_id": "123456789"
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rtc-api.myhuaweicloud.com",
