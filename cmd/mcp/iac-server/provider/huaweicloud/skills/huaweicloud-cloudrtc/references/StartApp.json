{
  "name": "StartApp",
  "summary": "启用应用",
  "tags": "应用管理",
  "productshort": "CloudRTC",
  "region_id": "cn-north-4",
  "paths": {
    "/apps/{app_id}/enable": {
      "post": {
        "tags": [
          "应用管理"
        ],
        "summary": "启用应用",
        "description": "调用此接口启用单个应用。",
        "operationId": "StartApp",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "内容类型。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "default": "application/json;charset=UTF-8"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "name": "app_id",
            "in": "path",
            "description": "应用id",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "启用成功",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/AppStateRsp"
            },
            "examples": {
              "application/json": {
                "app_id": "123456789abcdefghijklmno",
                "state": {
                  "state": "ACTIVATION",
                  "update_time": "2020-07-26T07:03:05.075Z"
                }
              }
            }
          },
          "404": {
            "description": "app编号不存在",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "RTC.00001003",
                "error_msg": "InvalidParameterValue"
              }
            }
          },
          "500": {
            "description": "设置失败,服务器端错误",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "RTC.00002xxx",
                "error_msg": "InternalError"
              }
            }
          }
        },
        "x-request-examples-url-1": "POST https://rtc-api.myhuaweicloud.com/v2/apps/{app_id}/enable"
      }
    }
  },
  "definitions": {
    "CommonRsp": {
      "description": "通用返回",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "AppState": {
      "description": "app状态信息",
      "properties": {
        "state": {
          "description": "状态\n- ACTIVATION:开启\n- DEACTIVATION:停用\n- ARREARS:欠费\n- DELETED:已删除",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "ACTIVATION",
            "DEACTIVATION",
            "ARREARS",
            "DELETED"
          ]
        },
        "update_time": {
          "description": "app鉴权的更新时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "AppStateRsp": {
      "description": "app状态信息",
      "properties": {
        "app_id": {
          "description": "应用id",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "state": {
          "description": "应用状态",
          "$ref": "#/definitions/AppState"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rtc-api.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "post",
  "uri": null
}