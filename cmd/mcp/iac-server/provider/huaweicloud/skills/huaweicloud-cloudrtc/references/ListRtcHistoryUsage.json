{
  "name": "ListRtcHistoryUsage",
  "summary": "查询用量",
  "tags": "数据统计分析",
  "productshort": "CloudRTC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/rtc/history/usage": {
      "get": {
        "tags": [
          "RtcStatisticsDataApi"
        ],
        "summary": "查询用量",
        "description": "查询过去的某一时间段内各种业务的用量数据",
        "operationId": "ListRtcHistoryUsage",
        "x-support-sdk": "Y",
        "x-external-api": true,
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 32384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息,与路径参数中的项目ID相同。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](rtc_07_0015.xml)。\n",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "query",
            "name": "app",
            "description": "应用标识\n",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "5fa682b34a974f7ad24d223b"
          },
          {
            "in": "query",
            "name": "metric",
            "description": "查询的数据类型\n- CommunicationDuration: 音视频通话时长;\n- TranscodeDuration:转码时长;\n- RecordDuration:录制时长;\n",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "TranscodeDuration"
          },
          {
            "in": "query",
            "name": "start_date",
            "description": "查询起始时间。UTC时间,格式:YYYY-MM-DD,如2020-04-23。\n",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "2020-04-23"
          },
          {
            "in": "query",
            "name": "end_date",
            "description": "查询结束时间。UTC时间,格式:YYYY-MM-DD,如2020-04-23。\n",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "2020-04-26"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功返回。\n",
            "schema": {
              "$ref": "#/definitions/RtcHistoryUsageRsp"
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求的唯一标识"
              }
            },
            "examples": {
              "application/json": {
                "usage": [
                  {
                    "date": "2020-06-04",
                    "video_sd": 1,
                    "video_hd": 1,
                    "video_hdp": 1,
                    "audio": 1,
                    "total_duration": 4
                  }
                ]
              }
            }
          },
          "400": {
            "description": "查询失败返回",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DATA.100011001",
                "error_msg": "Required String parameter 'app' is not present"
              }
            }
          }
        },
        "x-request-examples-url-1": "GET /v1/{project_id}/rtc/history/usage?app=5fa682b34a974f7ad24d223b&metric=TranscodeDuration&start_date=2020-04-23&end_date=2020-04-26\n"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "RtcHistoryUsage": {
      "type": "object",
      "properties": {
        "date": {
          "description": "采样时间。日期格式按照ISO8601表示法,并使用UTC时间。格式为YYYY-MM-DD",
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "video_sd": {
          "description": "标清视频时长,单位秒",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1844674407
        },
        "video_hd": {
          "description": "高清视频时长,单位秒",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1844674407
        },
        "video_hdp": {
          "description": "超高清视频时长,单位秒",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1844674407
        },
        "audio": {
          "description": "音频时长,单位秒",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1844674407
        },
        "total_duration": {
          "description": "音视频总时长,单位秒",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1844674407
        }
      }
    },
    "RtcHistoryUsageRsp": {
      "type": "object",
      "properties": {
        "usage": {
          "description": "时间戳及相应时间的指标数值列表",
          "type": "array",
          "minItems": 0,
          "maxItems": 8928,
          "items": {
            "$ref": "#/definitions/RtcHistoryUsage"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rtc-api.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
