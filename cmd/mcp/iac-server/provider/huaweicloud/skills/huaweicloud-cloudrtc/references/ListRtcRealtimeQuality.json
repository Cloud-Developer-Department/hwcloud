{
  "name": "ListRtcRealtimeQuality",
  "summary": "查询实时质量数据",
  "tags": "数据统计分析",
  "productshort": "CloudRTC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/rtc/realtime/quality": {
      "get": {
        "tags": [
          "RtcStatisticsDataApi"
        ],
        "summary": "查询实时质量数据",
        "description": "获取实时质量数据的相关指标在某一时间段内每分钟的统计数据。\n\n最大查询跨度1天。\n",
        "operationId": "ListRtcRealtimeQuality",
        "x-support-sdk": "Y",
        "x-external-api": true,
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 32384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息,与路径参数中的项目ID相同。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](rtc_07_0015.xml)。\n",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "query",
            "name": "app",
            "description": "应用标识\n",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "5fa682b34a974f7ad24d223b"
          },
          {
            "in": "query",
            "name": "room_id",
            "description": "房间ID\n",
            "type": "string",
            "required": false,
            "minLength": 0,
            "maxLength": 256,
            "x-example": "6951a79e9f811ebbd2ac58d7ac82553"
          },
          {
            "in": "query",
            "name": "metric",
            "description": "查询的数据类型\n- JoinSuccessRate: 加入房间成功率\n- JoinSuccess5SecsRate: 5秒加入成功率\n- VideoFreezeRate: 视频卡顿率\n- AudioFreezeRate: 音频卡顿率\n",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "JoinSuccessRate"
          },
          {
            "in": "query",
            "name": "sdk_type",
            "description": "sdk类型\n- native: 非web版sdk\n- webrtc: web版sdk\n",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "native"
          },
          {
            "in": "query",
            "name": "start_time",
            "description": "查询起始时间。UTC时间,格式:YYYY-MM-DDThh:mm:ssZ,如2020-04-23T06:00:00Z,不写默认读取过去1小时数据。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "2020-04-23T06:00:00Z"
          },
          {
            "in": "query",
            "name": "end_time",
            "description": "查询结束时间。UTC时间,格式:YYYY-MM-DDThh:mm:ssZ,如2020-04-23T06:00:00Z,不写默认为当前时间。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "2020-04-25T06:00:00Z"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功返回。\n",
            "schema": {
              "$ref": "#/definitions/RtcRealtimeQualityDataRsp"
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求的唯一标识"
              }
            },
            "examples": {
              "application/json": {
                "quality": [
                  {
                    "time": "2020-06-04T07:00:00Z",
                    "value": 0
                  }
                ]
              }
            }
          },
          "400": {
            "description": "查询失败返回",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DATA.100011001",
                "error_msg": "Required String parameter 'app' is not present"
              }
            }
          }
        },
        "x-request-examples-url-1": "GET /v1/{project_id}/rtc/realtime/quality?app=5fa682b34a974f7ad24d223b\n"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "TimeDoubleValueData": {
      "type": "object",
      "properties": {
        "time": {
          "description": "采样时间。日期格式按照ISO8601表示法,并使用UTC时间。格式为YYYY-MM-DDThh:mm:ssZ",
          "type": "string",
          "maxLength": 20,
          "minLength": 20
        },
        "value": {
          "description": "当前时间返回参数取值",
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "RtcRealtimeQualityDataRsp": {
      "type": "object",
      "properties": {
        "quality": {
          "description": "时间戳及相应时间的指标数值列表",
          "type": "array",
          "minItems": 0,
          "maxItems": 360,
          "items": {
            "$ref": "#/definitions/TimeDoubleValueData"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rtc-api.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}