        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "AppRecordCallbackUrlRsp": {
      "description": "查询修改app回调响应",
      "properties": {
        "app_id": {
          "description": "应用id",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "record_callback": {
          "description": "回调信息",
          "$ref": "#/definitions/AppCallbackUrl"
        }
      }
    },
    "AppCallbackUrl": {
      "description": "回调配置",
      "properties": {
        "url": {
          "description": "回调通知url地址,url必须以http://或https://开头,需要支持POST调用。",
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "default": ""
        },
        "auth_key": {
          "description": "回调秘钥,主要用于鉴权。如果不设置或者为空,则回调不会增加鉴权头域字段。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "default": ""
        },
        "notify_event_subscription": {
          "description": "订阅云端录制通知消息。\n\n取值如下:\n\n- RECORD_NEW_FILE_START:开始创建新的录制文件。\n\n- RECORD_FILE_COMPLETE:录制文件生成完成。",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "enum": [
              "RECORD_NEW_FILE_START",
              "RECORD_FILE_COMPLETE"
            ]
          }
        },
        "update_time": {
          "description": "更新时间,形如“2006-01-02T15:04:05.075Z”,时区为:UTC。",
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        }
