{
  "name": "CreateApp",
  "summary": "创建应用",
  "tags": "应用管理",
  "productshort": "CloudRTC",
  "region_id": "cn-north-4",
  "paths": {
    "/apps": {
      "post": {
        "tags": [
          "应用管理"
        ],
        "summary": "创建应用",
        "description": "调用此接口创建应用。",
        "x-constraint": "不支持同一租户创建多个app_name相同的应用。",
        "operationId": "CreateApp",
        "consumes": [
          "application/json;charset=utf-8"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "内容类型。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "default": "application/json;charset=UTF-8"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "name": "CreateAppRequestBody",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/AppReq"
            },
            "description": "创建应用请求体",
            "required": true
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "201": {
            "description": "创建成功,返回应用app_id",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/AppID"
            },
            "examples": {
              "application/json": {
                "app_id": "60d539ba00d861ef0802742ce404400c"
              }
            }
          },
          "400": {
            "description": "语义有误,当前请求无法被服务器理解,或参数有误",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "RTC.00001003",
                "error_msg": "InvalidParameterValue"
              }
            }
          },
          "500": {
            "description": "请求失败,服务器端错误",
            "headers": {
              "X-request-Id": {
                "type": "string",
                "description": "此字段携带请求ID号,以便任务跟踪。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CommonRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "RTC.00002xxx",
                "error_msg": "InternalError"
              }
            }
          }
        },
        "x-request-examples-url-1": "POST https://rtc-api.myhuaweicloud.com/v2/apps",
        "x-request-examples-1": {
          "app_name": "rtc"
        }
      }
    }
  },
  "definitions": {
    "CommonRsp": {
      "description": "通用返回",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "AppReq": {
      "description": "创建应用请求体",
      "required": [
        "app_name"
      ],
      "properties": {
        "app_name": {
          "description": "app名称,仅支持填入utf8格式内容",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "example": {
        "app_name": "rtc"
      }
    },
    "AppID": {
      "description": "创建应用返回体",
      "required": [
        "app_id"
      ],
      "properties": {
        "app_id": {
          "description": "应用id",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rtc-api.myhuaweicloud.com",
  "base_path": "/v2",
  "info_version": "v2",
  "method": "post",
  "uri": null
}