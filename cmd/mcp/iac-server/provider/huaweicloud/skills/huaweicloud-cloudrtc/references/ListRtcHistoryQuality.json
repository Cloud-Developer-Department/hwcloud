{
  "name": "ListRtcHistoryQuality",
  "summary": "查询历史质量",
  "tags": "数据统计分析",
  "productshort": "CloudRTC",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/rtc/history/quality": {
      "get": {
        "tags": [
          "RtcStatisticsDataApi"
        ],
        "summary": "查询历史质量",
        "description": "查询质量指标过去每天的体验数据,可查询最近31天的数据。当天未结束,无法查询到当天的体验数据。\n\n最大查询跨度31天。\n",
        "operationId": "ListRtcHistoryQuality",
        "x-support-sdk": "Y",
        "x-external-api": true,
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。使用Token鉴权方式时必选。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 32384,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带的鉴权信息。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx"
          },
          {
            "name": "X-Sdk-Date",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,请求的发生时间。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-example": "20191115T033655Z"
          },
          {
            "name": "X-Project-Id",
            "in": "header",
            "description": "使用AK/SK方式认证时必选,携带项目ID信息,与路径参数中的项目ID相同。\n",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "path",
            "name": "project_id",
            "type": "string",
            "description": "项目ID,获取方法请参考[获取项目ID](rtc_07_0015.xml)。\n",
            "required": true,
            "minLength": 1,
            "maxLength": 64,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "in": "query",
            "name": "app",
            "description": "应用标识\n",
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "5fa682b34a974f7ad24d223b"
          },
          {
            "in": "query",
            "name": "metric",
            "description": "查询的数据类型\n- JoinSuccessRate:加入房间成功率\n- JoinSuccess5SecsRate:5秒加入成功率\n- VideoFreezeRate:视频卡顿率\n- AudioFreezeRate:音频卡顿率\n- FirstVideoRecvTime:首帧视频接收耗时\n- FirstAudioRecvTime:首帧音频接收耗时\n- PullStreamSuccessRate:拉流成功率\n- PushStreamSuccessRate:推流成功率\n- VideoUpstreamExcellentTransRate:客户端视频上行优质传输率\n- AudioUpstreamExcellentTransRate:客户端音频上行优质传输率\n- VideoExcellentTransRate:端到端视频优质传输率\n- AudioExcellentTransRate:端到端音频优质传输率\n- VideoTransDelay:端到端视频网络时,单位为毫秒,取当天所有用户网络延迟的中位数\n- AudioTransDelay:端到端音频网络时延,单位为毫秒,取当天所有用户网络延迟的中位数\n",
            "type": "array",
            "items": {
              "type": "string"
            },
            "required": true,
            "minItems": 1,
            "maxItems": 8928,
            "x-example": "VideoExcellentTransRate"
          },
          {
            "in": "query",
            "name": "start_date",
            "description": "查询起始时间。UTC时间,格式:YYYY-MM-DD,如2020-04-23,不写默认读取过去1天数据数据。\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "2020-04-23"
          },
          {
            "in": "query",
            "name": "end_date",
            "description": "查询结束时间。UTC时间,格式:YYYY-MM-DD,如2020-04-23\n",
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 256,
            "x-example": "2020-04-27"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功返回。\n",
            "schema": {
              "$ref": "#/definitions/RtcHistoryQualityTimeValueRsp"
            },
            "headers": {
              "X-request-id": {
                "type": "string",
                "description": "请求的唯一标识"
              }
            },
            "examples": {
              "application/json": {
                "quality": [
                  {
                    "date": "2020-06-04",
                    "join_success_rate": 0.99
                  }
                ]
              }
            }
          },
          "400": {
            "description": "查询失败返回",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DATA.100011001",
                "error_msg": "Required String parameter 'app' is not present"
              }
            }
          }
        },
        "x-request-examples-url-1": "GET /v1/{project_id}/rtc/history/quality?app=5fa682b34a974f7ad24d223b&metric=VideoFreezeRate,AudioTransDelay&start_date=2020-04-23&end_date=2020-04-26\n"
      }
    }
  },
  "definitions": {
    "RtcHistoryQualityTimeValueRsp": {
      "type": "object",
      "properties": {
        "quality": {
          "description": "时间戳及相应时间的指标数值列表",
          "type": "array",
          "minItems": 0,
          "maxItems": 8928,
          "items": {
            "$ref": "#/definitions/RtcHistoryQualityTimeValue"
          }
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "description": "错误码。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "error_msg": {
          "description": "错误描述。\n",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "RtcHistoryQualityTimeValue": {
      "type": "object",
      "properties": {
        "date": {
          "description": "采样时间。日期格式按照ISO8601表示法,并使用UTC时间。格式为YYYY-MM-DD",
          "type": "string",
          "minLength": 20,
          "maxLength": 20
        },
        "join_success_rate": {
          "description": "加入房间成功率参数取值,取值为1代表成功率100%",
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1
        },
        "join_success_in5secs_rate": {
          "description": "5s内加入房间成功率参数取值,取值为1代表成功率100%",
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1
        },
        "video_freeze_rate": {
          "description": "视频卡顿率参数取值,取值为1代表卡顿率100%",
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1
        },
        "audio_freeze_rate": {
          "description": "音频卡顿率参数取值,取值为1代表卡顿率100%",
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1
        },
        "first_video_recv_time": {
          "description": "首帧视频接收耗时,单位毫秒",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1
        },
        "first_audio_recv_time": {
          "description": "首帧音频接收耗时,单位毫秒",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1
        },
        "pull_stream_success_rate": {
          "description": "拉流成功率参数取值,取值为1代表成功率100%",
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1
        },
        "push_stream_success_rate": {
          "description": "推流成功率参数取值,取值为1代表成功率100%",
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1
        },
        "video_upstream_excellent_trans_rate": {
          "description": "客户端视频上行优质传输率,取值为1代表传输率100%",
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1844674407
        },
        "audio_upstream_excellent_trans_rate": {
          "description": "客户端音频上行优质传输率,取值为1代表传输率100%",
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1
        },
        "video_excellent_trans_rate": {
          "description": "端到端视频优质传输率,取值为1代表传输率100%",
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1
        },
        "audio_excellent_trans_rate": {
          "description": "端到端音频优质传输率,取值为1代表传输率100%",
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1
        },
        "video_trans_delay": {
          "description": "端到端视频网络时延,单位为毫秒,取当天所有用户网络延迟的中位数。",
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1
        },
        "audio_trans_delay": {
          "description": "端到端音频网络时延,单位为毫秒,取当天所有用户网络延迟的中位数。",
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
