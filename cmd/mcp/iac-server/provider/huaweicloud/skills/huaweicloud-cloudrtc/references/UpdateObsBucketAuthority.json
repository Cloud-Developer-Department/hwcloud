          "description": "操作,1-授权;0-取消授权",
          "minimum": 0,
          "maximum": 1,
          "enum": [
            0,
            1
          ]
        },
        "location": {
          "type": "string",
          "description": "查询bucket所在的region\n- cn-north-4\n- cn-north-1\n- cn-north-5\n- cn-north-6\n- cn-south-1\n- cn-east-2",
          "minLength": 4,
          "maxLength": 16,
          "enum": [
            "cn-north-4",
            "cn-north-1",
            "cn-north-5",
            "cn-north-6",
            "cn-south-1",
            "cn-east-2"
          ]
        },
        "project_id": {
          "type": "string",
          "description": "租户华为云账号projectid",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "example": {
        "bucket": "bucket001",
        "operation": 1,
        "project_id": "fa000213acbxxxxx"
      }
