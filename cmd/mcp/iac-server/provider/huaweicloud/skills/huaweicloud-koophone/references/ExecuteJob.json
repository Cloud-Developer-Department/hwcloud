{
  "name": "ExecuteJob",
  "summary": "实例执行任务查询",
  "tags": "实例管理",
  "productshort": "KooPhone",
  "region_id": "cn-south-1",
  "paths": {
    "/instances/tasks/{task_id}": {
      "get": {
        "x-request-examples-url-1": "/v1/instances/tasks/6837531fd3f54550927b930180a706bf",
        "tags": [
          "实例管理"
        ],
        "operationId": "ExecuteJob",
        "summary": "实例执行任务查询",
        "description": "实例执行任务批量查询。\n调用此api的前提条件是租户需要先购买koophone云手机实例。\n该接口需要和实例执行异步命令接口一起使用,使用实例执行异步命令接口返回的task_id作为路径上的参数以此获取异步命令执行的结果。\n同时,该接口也可以和实例安装app接口一起使用,使用实例安装app接口返回的task_id作为路径上的参数,以此获取实例安装app的执行结果。\n实例安装app接口返回的task_id有固定前缀“ZGCA”或者“FULFILL”,和实例执行异步命令接口返回的task_id有所区分。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "租户级Token",
            "type": "string"
          },
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "异步请求返回的任务id",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "正常响应",
            "schema": {
              "$ref": "#/definitions/InstanceJobsRsp"
            },
            "examples": {
              "application/json": {
                "data": {
                  "jobs": [
                    {
                      "job_id": "1564567b8bab40f34711234cb80d0123",
                      "status": -1,
                      "error_code": "CPS0005",
                      "error_msg": "Phone not found.",
                      "execute_msg": null
                    },
                    {
                      "job_id": "1564567b8bab40f34711234cb80d0456",
                      "status": 2,
                      "error_code": "",
                      "error_msg": "",
                      "execute_msg": "xxxxxx"
                    }
                  ]
                },
                "error_code": "0",
                "error_msg": "ok"
              }
            }
          },
          "400": {
            "description": "请求错误",
            "schema": {
              "$ref": "#/definitions/ErrorInfo"
            }
          },
          "500": {
            "description": "内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorInfo"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorInfo": {
      "description": "响应结果",
      "required": [
        "error_code"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码,KOOPHONE.API.0001,数字递增"
        },
        "error_msg": {
          "type": "string",
          "description": "响应描述"
        }
      },
      "type": "object"
    },
    "JobDetailWrapper": {
      "description": "任务查询响应包装",
      "properties": {
        "jobs": {
          "type": "array",
          "description": "根据task_id查询出的任务列表",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/JobDetail"
          }
        }
      }
    },
    "JobDetail": {
      "description": "任务查询响应",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务唯一标识"
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "任务状态。0:未执行,1:运行中,2:成功,3:失败,-1:表示失败。如果是查询实例执行异步命令接口的结果状态,则状态枚举值为1、2和-1。 如果是查询实例安装app接口的任务执行结果状态,则状态枚举值为0、1、2、3。",
          "enum": [
            0,
            1,
            2,
            3,
            1
          ]
        },
        "error_code": {
          "type": "string",
          "description": "任务错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "任务错误码说明"
        },
        "execute_msg": {
          "type": "string",
          "description": "任务执行返回内容,最长1024字节。命令执行成功和失败均将命令的输出返回",
          "maxLength": 1024
        }
      },
      "type": "object"
    },
    "InstanceJobsRsp": {
      "description": "任务查询响应",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码,错误码规范KooPhone.API.1001,数字递增"
        },
        "error_msg": {
          "type": "string",
          "description": "响应描述"
        },
        "data": {
          "type": "object",
          "description": "根据task_id查询出的任务列表",
          "$ref": "#/definitions/JobDetailWrapper"
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "koophone.myhuaweicloud.com",
  "base_path": "/v1",
  "info_version": "v1",
  "method": "get",
  "uri": null
}