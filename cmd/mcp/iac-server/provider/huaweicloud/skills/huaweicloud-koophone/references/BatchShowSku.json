      "type": "object",
      "description": "sku的接口返参",
      "required": [
        "error_code",
        "error_msg",
        "data"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码"
        },
        "error_msg": {
          "type": "string",
          "description": "响应信息"
        },
        "data": {
          "description": "响应体",
          "$ref": "#/definitions/SkuSpecBaseResponse"
        }
      }
    }
