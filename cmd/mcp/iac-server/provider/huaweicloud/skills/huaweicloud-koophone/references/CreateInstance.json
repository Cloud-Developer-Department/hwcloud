{
  "name": "CreateInstance",
  "summary": "实例开通接口",
  "tags": "实例订购",
  "productshort": "KooPhone",
  "region_id": "cn-south-1",
  "paths": {
    "/instances/create": {
      "post": {
        "x-request-examples-description-1": "订购请求参数",
        "x-request-examples-text-1": {
          "os": "AOSP11",
          "instanceSkuId": "kp.professional.2xlarge.128g.2",
          "bandSkuId": "kp.bandwidth",
          "regionId": "cn-north-7",
          "instanceNamePrefix": "koophone",
          "bandSize": 4,
          "count": 1,
          "nodeGroupId": "a112ds43",
          "chargeParam": {
            "chargingMode": 1,
            "periodType": 2,
            "periodNum": 1,
            "isAutoPay": 1,
            "isAutoRenew": 1
          }
        },
        "x-request-examples-1": {
          "os": "AOSP9",
          "instanceSkuId": "kp.professional.2xlarge.128g.2",
          "bandSkuId": "kp.bandwidth",
          "regionId": "cn-north-7",
          "instanceNamePrefix": "koophone",
          "bandSize": 4,
          "count": 1,
          "nodeGroupId": "a112ds43",
          "chargeParam": {
            "chargingMode": 1,
            "periodType": 2,
            "periodNum": 1,
            "isAutoPay": 1,
            "isAutoRenew": 1
          }
        },
        "x-request-examples-url-1": "/v1/instances/create",
        "tags": [
          "实例订购"
        ],
        "summary": "实例开通接口",
        "description": "租户可以通过调用该接口生成实例。\n该接口需要结合BatchShowSku接口一起使用,在BatchShowSku接口中获取全量的可售的sku。租户根据自己需要去选择相应规格进行订购。\n调用该接口时如果想要直接购买成功,请您先在账户上充值并在订购参数中选择isAutoPay为自动付费。\n如果没有选择自动付费,在调完接口后请拿对应的订单号去您账号的待支付订单中选择手动付费。",
        "operationId": "CreateInstance",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "required": true,
            "description": "租户token",
            "type": "string"
          },
          {
            "name": "InstanceCreateReq",
            "in": "body",
            "required": true,
            "description": "订购入参",
            "schema": {
              "$ref": "#/definitions/InstanceCreateReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "实例订购返参",
            "schema": {
              "$ref": "#/definitions/InstanceCreateResp"
            },
            "examples": {
              "application/json": {
                "data": {
                  "orderId": "CS2412261442DBN4E",
                  "instanceInfos": [
                    {
                      "instanceId": "11J6QVu5",
                      "instanceName": "koophone-00001"
                    }
                  ]
                },
                "error_code": "0",
                "error_msg": "OK"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "InstanceCreateResp": {
      "type": "object",
      "description": "实例订购返参",
      "required": [
        "data",
        "error_code",
        "error_msg"
      ],
      "properties": {
        "data": {
          "description": "返回内容",
          "required": [
            "orderId",
            "instanceInfos"
          ],
          "properties": {
            "orderId": {
              "type": "string",
              "example": "CS2412261442DBN4E",
              "description": "订单id"
            },
            "instanceInfos": {
              "type": "array",
              "items": {
                "required": [
                  "instanceId",
                  "instanceName"
                ],
                "properties": {
                  "instanceId": {
                    "type": "string",
                    "example": "11J6QVu5",
                    "description": "实例id"
                  },
                  "instanceName": {
                    "type": "string",
                    "example": "夏慧12181542-00001",
                    "description": "实例名称"
                  }
                }
              },
              "description": "实例信息"
            }
          }
        },
        "error_code": {
          "type": "string",
          "example": "0",
          "description": "0表示成功"
        },
        "error_msg": {
          "type": "string",
          "example": "OK",
          "description": "ok表示成功"
        }
      }
    },
    "InstanceCreateReq": {
      "type": "object",
      "required": [
        "os",
        "instanceSkuId",
        "bandSkuId",
        "regionId",
        "instanceNamePrefix",
        "bandSize",
        "count",
        "chargeParam"
      ],
      "properties": {
        "os": {
          "type": "string",
          "example": "AOSP11",
          "description": "创建实例的镜像规格,当前支持的云手机场景下必填",
          "enum": [
            "AOSP11",
            "AOSP14"
          ]
        },
        "instanceSkuId": {
          "type": "string",
          "example": "kp.professional.2xlarge.128g.2",
          "description": "创建的实例商品规格id,在CBC定义,Console提供规格与资源池映射",
          "maxLength": 64
        },
        "bandSkuId": {
          "type": "string",
          "example": "kp.bandwidth",
          "description": "带宽商品规格id,在CBC定义",
          "maxLength": 64
        },
        "regionId": {
          "type": "string",
          "example": "cn-north-7",
          "description": "区域id",
          "maxLength": 64
        },
        "instanceNamePrefix": {
          "type": "string",
          "example": "koophone",
          "description": "云机实例名称前缀",
          "maxLength": 14
        },
        "bandSize": {
          "type": "number",
          "format": "double",
          "example": 4.0,
          "description": "带宽大小,单位M"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "购买实例数量,最大2000",
          "maximum": 2000
        },
        "chargeParam": {
          "description": "计费相关参数",
          "required": [
            "chargingMode",
            "periodType",
            "periodNum"
          ],
          "properties": {
            "chargingMode": {
              "type": "integer",
              "format": "int32",
              "example": 1,
              "description": "计费模式,1 包年包月, 当前只支持包年包月模式",
              "enum": [
                1
              ]
            },
            "periodType": {
              "type": "integer",
              "format": "int32",
              "example": 2,
              "description": "订购周期类型,2:月;3:年",
              "enum": [
                2,
                3
              ]
            },
            "periodNum": {
              "type": "integer",
              "format": "int32",
              "example": 1,
              "description": "订购周期数。 当订购周期为月时,取值范围[1, 9]。 当订购周期为年时,取值范围[1,3]"
            },
            "isAutoPay": {
              "type": "integer",
              "format": "int32",
              "example": 1,
              "description": "是否自动付款。默认不自动付款。 1:自动付款 0:不自动付款",
              "enum": [
                0,
                1
              ]
            },
            "isAutoRenew": {
              "type": "integer",
              "format": "int32",
              "example": 1,
              "description": "是否自动续订。 0:非自动续订 1:自动续订",
              "enum": [
                0,
                1
              ]
            }
          }
        },
        "network": {
          "type": "string",
          "example": "EIP",
          "description": "网络线路类型。非必填参数,枚举值:EIP和ADN。默认是EIP类型,ADN网络要填。",
          "enum": [
            "EIP",
            "ADN"
          ]
        },
        "nodeGroupId": {
          "type": "string",
          "example": 2035265848488689665,
          "description": "节点组id(节点组订购必填)",
          "maxLength": 32
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "koophone.myhuaweicloud.com",
  "base_path": "/v1",
  "info_version": "v1",
  "method": "post",
  "uri": null
}