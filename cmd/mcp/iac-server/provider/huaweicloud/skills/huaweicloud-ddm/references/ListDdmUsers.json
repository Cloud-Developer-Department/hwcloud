  "definitions": {
    "GetUsersListDetailResponsesV3": {
      "required": [
        "name",
        "status",
        "base_authority",
        "description",
        "created",
        "databases"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "ddmtest",
          "description": "**参数解释**:\n\nDDM实例账号的名称。\n\n**取值范围**:\n\n不涉及。"
        },
        "status": {
          "type": "string",
          "example": "RUNNING",
          "description": "**参数解释**:\n\nDDM实例账号的状态。\n\n**取值范围**:\n\n不涉及。"
        },
        "base_authority": {
          "type": "array",
          "description": "**参数解释**:\n\nDDM实例账号的基础权限。\n\n**取值范围**:\n\n取值为:CREATE、DROP、ALTER、INDEX、INSERT、DELETE、UPDATE、SELECT",
          "items": {
            "type": "string"
          }
        },
        "password_lifetime": {
          "type": "integer",
          "format": "int64",
          "example": "365",
          "description": "**参数解释**:\n\nDDM实例账号密码的有效期。\n\n**取值范围**:\n\n取值范围为0-65535的整数,单位为天。\n\n0与空表示密码永不过期。",
          "minLength": 0,
          "maxLength": 256
        },
        "password_last_changed": {
          "type": "string",
          "example": "2025-12-12T04:03:46+0000",
          "description": "**参数解释**:\n\nDDM实例账号密码最近一次的修改时间。\n\n格式为yyyy-mm-ddThh:mm:ssZ。其中,T指定某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。\n\n**取值范围**:\n\n不涉及。"
        },
        "description": {
          "type": "string",
          "example": "for project a",
          "description": "**参数解释**:\n\n账号的描述信息。\n\n**取值范围**:\n\n不涉及。"
        },
        "created": {
          "type": "string",
          "example": "2025-12-12T04:03:46+0000",
          "description": "**参数解释**:\n\nDDM实例账号的创建时间。\n\n格式为yyyy-mm-ddThh:mm:ssZ。其中,T指定某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。\n\n**取值范围**:\n\n不涉及。"
        },
        "databases": {
          "type": "array",
          "description": "**参数解释**:\n\n关联的逻辑库集合。账号只对已关联的逻辑库有访问权限。\n\n**取值范围**:\n\n不涉及。",
          "items": {
            "$ref": "#/definitions/GetUsersListdatabaseV3"
          }
        },
        "expiration_time": {
          "type": "string",
          "example": "2025-12-12T04:03:46+0000",
          "description": "**参数解释**:\n\nDDM实例账号的创建时间。\n\n格式为yyyy-mm-ddThh:mm:ssZ。其中,T指定某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。\n\n**取值范围**:\n\n不涉及。"
        }
      }
    },
    "ListUsersV3Rsp": {
      "required": [
        "users",
        "offset",
        "limit",
        "total"
      ],
      "properties": {
        "users": {
          "type": "array",
          "description": "**参数解释**:\n\nDDM实例账号相关信息的集合。\n\n**取值范围**:\n\n不涉及",
          "items": {
            "$ref": "#/definitions/GetUsersListDetailResponsesV3"
          }
        },
        "offset": {
          "type": "integer",
          "example": 1,
          "description": "**参数解释**:\n\n分页参数: 起始值。\n\n**取值范围**:\n\n 大于等于0。"
        },
        "limit": {
          "type": "integer",
          "example": 10,
          "description": "**参数解释**:\n\n分页参数: 每页记录数。\n\n**取值范围**:\n\n大于0且小于等于128。"
        },
        "total": {
          "type": "integer",
          "example": 11,
          "description": "**参数解释**:\n\n总记录数。\n\n**取值范围**:\n\n不涉及。"
        }
      }
    },
    "GetUsersListdatabaseV3": {
      "properties": {
        "name": {
          "type": "string",
          "example": "zhxtest",
          "description": "**参数解释**:\n\n关联的逻辑库名称。\n\n**取值范围**:\n\n不涉及。"
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n\n错误码\n\n**取值范围**:\n\n不涉及。",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "**参数解释**:\n\n错误描述\n\n**取值范围**:\n\n不涉及。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    }
