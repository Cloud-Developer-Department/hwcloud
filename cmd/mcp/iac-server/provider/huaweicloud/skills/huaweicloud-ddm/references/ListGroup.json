{
  "name": "ListGroup",
  "summary": "获取实例组信息列表",
  "tags": "DDM实例管理",
  "productshort": "DDM",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/groups": {
      "get": {
        "summary": "获取实例组信息列表",
        "tags": [
          "DDM实例管理"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "description": "获取实例组信息列表",
        "operationId": "ListGroup",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID。"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "DDM实例ID。"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "分页参数:起始值 [大于等于0] 。默认值是0。",
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "分页参数:每页多少条 [大于0且小于等于128]。默认值是10。",
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 128
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。 通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "获取组信息返回",
            "schema": {
              "$ref": "#/definitions/GroupListResponseBody"
            },
            "examples": {
              "application/json": {
                "group_list": [
                  {
                    "id": "xxxxxxxxxxxxxxxxxxxxxgr09",
                    "name": "group-default",
                    "role": "rw",
                    "endpoint": "x.x.x.x:5066",
                    "ipv6_endpoint": null,
                    "is_load_balance": true,
                    "is_default_group": false,
                    "architecture": "X86",
                    "cpu_num_per_node": 4,
                    "mem_num_per_node": 8,
                    "node_list": [
                      {
                        "id": "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyno09",
                        "name": "node_01",
                        "az": "some_az"
                      }
                    ]
                  }
                ],
                "total_count": 1
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "GroupInfo": {
      "type": "object",
      "required": [
        "id",
        "name",
        "role",
        "endpoint",
        "is_load_balance",
        "is_default_group",
        "cpu_num_per_node",
        "mem_num_per_node",
        "architecture",
        "node_list"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "组ID。"
        },
        "name": {
          "type": "string",
          "description": "组名称。"
        },
        "role": {
          "type": "string",
          "description": "组角色类型。",
          "enum": [
            "rw",
            "r"
          ]
        },
        "endpoint": {
          "type": "string",
          "description": "组连接地址,如未开启负载均衡,则返回的是组内节点连接地址串。"
        },
        "ipv6_endpoint": {
          "type": "string",
          "description": "组ipv6连接地址。"
        },
        "is_load_balance": {
          "type": "boolean",
          "description": "是否开启负载均衡。"
        },
        "is_default_group": {
          "type": "boolean",
          "description": "是否默认组。"
        },
        "cpu_num_per_node": {
          "type": "integer",
          "format": "int32",
          "description": "单节点CPU核数。"
        },
        "mem_num_per_node": {
          "type": "integer",
          "format": "int32",
          "description": "单节点内存大小,单位G。"
        },
        "architecture": {
          "type": "string",
          "description": "CPU架构。",
          "enum": [
            "X86",
            "ARM"
          ]
        },
        "node_list": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GroupNodeInfo"
          },
          "description": "节点信息列表。"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "GroupListResponseBody": {
      "type": "object",
      "required": [
        "total_count",
        "group_list"
      ],
      "properties": {
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "总数。"
        },
        "group_list": {
          "items": {
            "required": [
              "id",
              "name",
              "role",
              "endpoint",
              "node_count",
              "is_load_balance",
              "is_default_group"
            ],
            "$ref": "#/definitions/GroupInfo"
          },
          "type": "array",
          "description": "组信息列表。"
        }
      }
    },
    "GroupNodeInfo": {
      "type": "object",
      "required": [
        "id",
        "name",
        "az"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "节点ID。"
        },
        "name": {
          "type": "string",
          "description": "节点名称。"
        },
        "az": {
          "type": "string",
          "description": "节点所在AZ。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ddm.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}