{
  "name": "ValidateWeakPassword",
  "summary": "弱密码校验",
  "tags": "DDM帐号管理",
  "productshort": "DDM",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/weak-password-verification": {
      "post": {
        "tags": [
          "DDM帐号管理"
        ],
        "summary": "弱密码校验",
        "description": "弱密码校验",
        "operationId": "ValidateWeakPassword",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "in": "body",
            "name": "WeakPasswordReq",
            "description": "弱密码请求参数。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/WeakPasswordReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "is_weak_password": true
              }
            },
            "schema": {
              "$ref": "#/definitions/WeakPasswordRsp"
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v3/{project_id}/weak-password-verification",
        "x-request-examples-1": {
          "password": "xxx"
        }
      }
    }
  },
  "definitions": {
    "WeakPasswordRsp": {
      "properties": {
        "is_weak_password": {
          "type": "boolean",
          "example": true,
          "description": "是否是弱密码。true为弱密码,不建议使用。false为非弱密码,可以使用。"
        }
      },
      "description": "弱密码响应结果。"
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "WeakPasswordReq": {
      "required": [
        "password"
      ],
      "properties": {
        "password": {
          "type": "string",
          "example": "xxx",
          "description": "待测试是否是弱密码的字符串。"
        }
      },
      "description": "弱密码请求参数。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ddm.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}