{
  "name": "ShowLogicalProcesses",
  "summary": "查询逻辑会话列表",
  "tags": "DDM会话管理",
  "productshort": "DDM",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/logical-processes": {
      "get": {
        "tags": [
          "DDM会话管理"
        ],
        "operationId": "ShowLogicalProcesses",
        "summary": "查询逻辑会话列表",
        "description": "查询逻辑会话列表",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID。"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "DDM实例ID。"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0。取值必须为数字,且不能为负数。",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "查询个数上限值。取值范围:1~128。不传该参数时,默认值为10。",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "会话结果筛选关键字,支持返回结果全字段模糊匹配,长度最大255",
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。 通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/LogicalProcessesOpenResponse"
            },
            "examples": {
              "application/json": {
                "logical_processes": [
                  {
                    "id": "4564224",
                    "user": "drdsagent",
                    "host": "127.0.0.1:54486",
                    "db": "None",
                    "command": "Query",
                    "time": "0",
                    "state": "starting",
                    "info": "show processlist"
                  }
                ],
                "total_count": 125
              }
            }
          },
          "400": {
            "description": "bad request",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DBS.280001",
                "error_msg": "Parameter error."
              }
            }
          },
          "500": {
            "description": "server error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DBS.280001",
                "error_msg": "Parameter error."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "LogicalProcessesOpenResponse": {
      "type": "object",
      "properties": {
        "logical_processes": {
          "items": {
            "$ref": "#/definitions/LogicalProcessInfo"
          },
          "type": "array",
          "description": "逻辑会话列表"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "总数"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "LogicalProcessInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "会话id"
        },
        "user": {
          "type": "string",
          "description": "当前连接用户"
        },
        "host": {
          "type": "string",
          "description": "所属的 IP 和端口"
        },
        "db": {
          "type": "string",
          "description": "数据库名"
        },
        "command": {
          "type": "string",
          "description": "连接状态,一般是休眠(sleep),查询(query),连接(connect)"
        },
        "time": {
          "type": "string",
          "description": "连接状态持续的时间,单位是秒(s)"
        },
        "state": {
          "type": "string",
          "description": "当前 SQL 语句的状态"
        },
        "info": {
          "type": "string",
          "description": "当前所执行的 SQL 语句"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
