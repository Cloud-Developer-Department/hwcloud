  "definitions": {
    "UpdateUserV3RequestBody": {
      "description": "修改账号的请求对象",
      "properties": {
        "base_authority": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "example": [
            "CREATE",
            "DROP",
            "ALTER",
            "INDEX",
            "INSERT",
            "DELETE",
            "UPDATE",
            "SELECT"
          ],
          "description": "**参数解释**:\n\nDDM实例账号的基础权限。\n\n**约束限制**:\n\n无\n\n**取值范围**:\n\nCREATE、DROP、ALTER、INDEX、INSERT、DELETE、UPDATE、SELECT的任意集合\n\n**默认取值**:\n\n不涉及。",
          "items": {
            "type": "string",
            "enum": [
              "CREATE",
              "DROP",
              "ALTER",
              "INDEX",
              "INSERT",
              "DELETE",
              "UPDATE",
              "SELECT"
            ]
          }
        },
        "description": {
          "type": "string",
          "example": "user for project a",
          "description": "**参数解释**:\n\n实例账号的描述信息。\n\n**约束限制**:\n\n- 长度不超过256个字符。\n\n**取值范围**:\n\n不涉及。\n\n**默认取值**:\n\n不涉及。",
          "minLength": 0,
          "maxLength": 256
        },
        "password_lifetime": {
          "type": "integer",
          "format": "int64",
          "example": "365",
          "description": "**参数解释**:\n\nDDM实例账号的密码有效期。\n\n**约束限制**:\n\n不涉及。\n\n\n**取值范围**:\n\n取值范围为0-65535的整数,单位为天。\n\n0与空表示密码永不过期。\n\n**默认取值**:\n\n默认值为空,永不过期。"
        },
        "databases": {
          "type": "array",
          "minItems": 0,
          "description": "关联的逻辑库的集合。\ndatabases字段可以省略,即创建用户时可以不关联逻辑库。",
          "items": {
            "$ref": "#/definitions/UpdateUserRelatedLogicDbV3"
          }
        }
      }
    },
    "UpdateUserRelatedLogicDbV3": {
      "description": "修改账号关联的逻辑库请求对象",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "logicdbname",
          "description": "**参数解释**:\n\n已创建的逻辑库名称。表示给账号授予逻辑库权限。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n不涉及。\n\n**默认取值**:\n\n不涉及。"
        }
      }
    },
    "ErrorRsp": {
