  "definitions": {
    "ExceptionResponses": {
      "type": "object",
      "required": [
        "errCode",
        "externalMessage"
      ],
      "properties": {
        "errCode": {
          "type": "string",
          "example": "DBS.280001",
          "description": "业务错误码"
        },
        "externalMessage": {
          "type": "string",
          "example": "Parameter error.",
          "description": "错误信息"
        }
      },
      "description": "异常对象"
    },
    "UpdateParametersReq": {
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "description": "需要修改的DDM实例参数的集合。",
          "properties": {
            "bind_table": {
              "type": "string",
              "example": "[{tb.col1,tb2.col2},{tb.col2,tb3.col1}]",
              "description": "用于描述多个拆分表的内在数据关联性,用于告知优化器在处理join时,把join下推到MySQL层执行。格式为:[{tb.col1,tb2.col2},{tb.col2,tb3.col1},...]。"
            },
            "character_set_server": {
              "type": "string",
              "enum": [
                "gbk",
                "utf8",
                "utf8mb4"
              ],
              "description": "DDM服务端字符集,如果需要存储emoji表情符号,请选择utf8mb4,并设置RDS字符集也为utf8mb4。修改DDM服务端字符集时,DDM服务端字符序必须同步修改为对应类型的值。"
            },
            "collation_server": {
              "type": "string",
              "enum": [
                "utf8_unicode_ci",
                "utf8_bin",
                "gbk_chinese_ci",
                "gbk_bin",
                "utf8mb4_unicode_ci",
                "utf8mb4_bin"
              ],
              "description": "DDM服务端字符序。修改DDM服务端字符序时,DDM服务端字符集必须同步修改为对应类型的值。"
            },
            "concurrent_execution_level": {
              "type": "string",
              "enum": [
                "RDS_INSTANCE",
                "DATA_NODE",
                "PHY_TABLE"
              ],
              "description": "逻辑表扫描时的分片并发执行级别: DATA_NODE: 分库间并行扫描,同一分库内各分片串行扫描;RDS_INSTANCE: RDS实例间并行扫描,同一RDS实例内各分片串行扫描;PHY_TABLE: 各物理分片全部并行扫描。"
            },
            "connection_idle_timeout": {
              "type": "string",
              "example": "28800",
              "description": "服务器关闭连接之前等待连接活动的秒数,以秒为单位,取值范围为60-28800,默认值28800,表示服务器关闭连接之前等待28800秒后,关闭连接。"
            },
            "enable_table_recycle": {
              "type": "string",
              "enum": [
                "OFF",
                "ON"
              ],
              "description": "是否开启表回收站。"
            },
            "insert_to_load_data": {
              "type": "string",
              "enum": [
                "OFF",
                "ON"
              ],
              "description": "insert 常量值使用load data执行。"
            },
            "live_transaction_timeout_on_shutdown": {
              "type": "string",
              "example": "1",
              "description": "在途事务等待时间窗口,以秒为单位,取值范围为0-100,默认值为1,表示服务器关闭前端连接之前等待1秒后关闭连接。"
            },
            "long_query_time": {
              "type": "string",
              "example": "1",
              "description": "记录慢查询的最小秒数,以秒为单位,取值范围为0.01-10,默认值为1,表示如果sql执行大于等于1秒就定义为慢sql。"
            },
            "max_allowed_packet": {
              "type": "string",
              "example": "16777216",
              "description": "包或任何生成的中间字符串的最大值。包缓冲区初始化为net_buffer_length字节,但需要时可以增长到max_allowed_packet字节。该值默认很小,以捕获大的(可能是错误的)数据包。该值必须设置为1024的倍数。取值范围为1024~1073741824,默认值为16777216。"
            },
            "max_backend_connections": {
              "type": "string",
              "example": "1000",
              "description": "允许每个DDM节点同时连接RDS的最大客户端总数。0为默认值标识符,实际值等于(RDS的最大连接数-20)/DDM节点数。取值范围为0-10000000。"
            },
            "max_connections": {
              "type": "string",
              "example": "20000",
              "description": "允许同时连接的客户端总数。与后端RDS规格及数量有关。以个数为单位,取值范围为10-40000,默认值为20000,表示允许同时连接的客户端总数不能超过40000。"
            },
            "min_backend_connections": {
              "type": "string",
              "example": "10",
              "description": "允许每个DDM节点同时连接RDS的最小客户端总数。默认值为10。取值范围为0-10000000。"
            },
            "not_from_pushdown": {
              "type": "string",
              "enum": [
                "OFF",
                "ON"
              ],
              "description": "是否强制下推查询语句中不含from的语句。"
            },
            "seconds_behind_master": {
              "type": "string",
              "example": "30",
              "description": "主从rds节点延迟时间阈值,以秒为单位,取值范围为0-7200,默认值为30,表示主rds与从rds之间的数据同步时间值不能超过30秒,如果超过30s,读数据指令就不走当前读节点。"
            },
            "sql_audit": {
              "type": "string",
              "enum": [
                "OFF",
                "ON"
              ],
              "description": "开启或关闭SQL审计。"
            },
            "sql_execute_timeout": {
              "type": "string",
              "example": "28800",
              "description": "SQL执行超时秒数,以秒为单位,取值范围为100-28800,默认值28800,表示sql执行大于等于28800秒超时。"
            },
            "support_ddl_binlog_hint": {
              "type": "string",
              "enum": [
                "OFF",
                "ON"
              ],
              "description": "DDL语句添加binlog hint。"
            },
            "transaction_policy": {
              "type": "string",
              "enum": [
                "XA",
                "FREE",
                "NO_DTX"
              ],
              "description": "XA:XA 事务,保证原子性,保证可见性;FREE:允许多写,不保证原子性,无性能损耗;NO_DTX:单分片事务。"
            },
            "ultimate_optimize": {
              "type": "string",
              "enum": [
                "OFF",
                "ON"
              ],
              "description": "开启或关闭优化器中的极致下推优化功能。"
            }
          }
        }
      }
    },
    "UpdateInstanceParametersResponse": {
      "properties": {
        "nodeList": {
          "type": "string",
          "example": "xxxxx",
          "description": "节点列表。"
        },
        "needRestart": {
          "type": "boolean",
          "example": "false",
          "description": "是否需要重启实例。"
        },
        "jobId": {
          "type": "string",
          "example": "47b059b2-df84-48b8-a281-ce7bf766a1eb",
          "description": "任务id。"
        },
        "configId": {
          "type": "string",
          "example": "47b059b2-df84-48b8-a281-ce7bf766a1eb",
          "description": "参数组id。"
        },
        "configName": {
          "type": "string",
          "example": "Default",
          "description": "参数组名称。"
        }
      }
    }
  },
