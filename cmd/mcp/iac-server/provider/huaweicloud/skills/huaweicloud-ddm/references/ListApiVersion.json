  "paths": {
    "/": {
      "get": {
        "tags": [
          "查询API版本"
        ],
        "operationId": "ListApiVersion",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "summary": "查询API版本列表",
        "description": "查询API版本列表。",
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ListApiVersionResponseBody"
            },
            "examples": {
              "application/json": {
                "versions": [
                  {
                    "id": "v3",
                    "links": [],
                    "status": "CURRENT",
                    "updated": "2019-01-15T12:00:00Z"
                  },
                  {
                    "id": "v1",
                    "links": [],
                    "status": "DEPRECATED",
                    "updated": "2017-02-07T17:34:02Z"
                  }
                ]
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://ddm.cn-north-1.myhuaweicloud.com/"
      }
    }
  },
  "definitions": {
    "LinkInfo": {
      "properties": {
        "href": {
          "type": "string",
          "description": "对应该API的URL"
        },
        "rel": {
          "type": "string",
          "description": "取值为“self”,表示href为本地链接。"
        }
      },
      "type": "object"
    },
    "ListApiVersionResponseBody": {
      "properties": {
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ApiVersion"
          },
          "description": "API版本详细信息列表。"
        }
      }
    },
    "ApiVersion": {
      "description": "API版本详细信息列表。",
      "required": [
        "id",
        "links",
        "status",
        "updated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "API版本号,如v1、v3。",
          "example": "v3"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LinkInfo"
          },
          "description": "对应API的链接信息,v1、v3版本该字段为空。",
          "example": []
        },
        "status": {
          "type": "string",
          "description": "版本状态。\n取值“CURRENT”,表示该版本为主推版本。\n取值“SUPPORTED”,表示为老版本,但是现在还继续支持\n取值“DEPRECATED”,表示为废弃版本,存在后续删除的可能。",
          "example": "CURRENT"
        },
        "version": {
          "type": "string",
          "description": "若该版本API支持微版本,则填支持的最大微版本号,如果不支持微版本,则填空",
          "example": ""
        },
        "updated": {
          "type": "string",
          "description": "版本更新时间。\n格式为“yyyy-mm-dd Thh:mm:ssZ”。\n其中,T指某个时间的开始;Z指UTC时间。",
          "example": "2019-01-15T12:00:00Z"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
