            }
          },
          "400": {
            "description": "bad request",
            "examples": {
              "application/json": {
                "externalMessage": "Parameter error.",
                "errCode": "DBS.280001"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "server error",
            "examples": {
              "application/json": {
                "externalMessage": "Parameter error.",
                "errCode": "DBS.280001"
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
