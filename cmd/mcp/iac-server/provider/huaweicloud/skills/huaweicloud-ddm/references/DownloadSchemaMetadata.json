            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
            "minLength": 0,
            "x-order": 1,
            "maxLength": 1024
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx",
            "x-order": 2,
            "minLength": 1,
            "maxLength": 1024
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "DDM实例ID",
            "required": true,
            "type": "string",
            "x-example": "3828700c4a5a4fd994b22de1xxxxxxxxin09",
            "x-order": 3,
            "minLength": 1,
            "maxLength": 1024
          }
        ],
        "responses": {
          "202": {
            "description": "ok",
            "schema": {
