      "properties": {
        "name": {
          "type": "string",
          "example": "ddm-test-001",
          "pattern": "[A-Za-z0-9-]*$",
          "description": "DDM实例名称,命名要求如下。\n- 长度为4-64个字符。\n- 必须以字母开头。\n- 可以包含字母、数字、中划线,不能包含其它特殊字符。",
          "minLength": 4,
          "maxLength": 64
        },
        "flavor_id": {
          "type": "string",
          "example": "8f2e696c-a9c1-30bd-af90-25522bc67606",
          "description": "规格ID。"
        },
        "node_num": {
          "type": "integer",
          "example": 4,
          "description": "节点个数。"
        },
        "engine_id": {
          "type": "string",
          "example": "2325a707-0361-8be6-dd01-13474bbac437",
          "description": "引擎ID。"
        },
        "enterprise_project_id": {
          "type": "string",
          "example": "0",
          "description": "企业项目ID。"
        },
        "available_zones": {
          "type": "array",
          "example": [
            "az1xahz"
          ],
          "description": "可用区code。取值非空,请参见地区和终端节点(https://developer.huaweicloud.com/endpoint?DDM)。",
          "items": {
            "type": "string"
          }
        },
        "vpc_id": {
          "type": "string",
          "example": "e1d886ec-cfe7-4cd4-b748-fc55a10b4172",
          "description": "虚拟私有云的ID。"
        },
        "security_group_id": {
          "type": "string",
          "example": "035b70ed-319b-4086-9fd7-62a2e8548b2e",
          "description": "安全组ID。"
        },
        "subnet_id": {
          "type": "string",
          "example": "f942f970-1a02-4eee-8927-xxxxxxxx",
          "description": "子网ID。"
        },
        "param_group_id": {
          "type": "string",
          "example": "035b70ed-319b-4086-9fd7-xxxxxxxx",
          "description": "参数组ID."
        },
        "time_zone": {
          "type": "string",
          "example": "UTC+08:00",
          "description": "UTC时区。默认为UTC。取值范围:\"UTC\",\"UTC-12:00\",\"UTC-11:00\",\"UTC-10:00\",\"UTC-09:00\", \"UTC-08:00\", \"UTC-07:00\", \"UTC-06:00\", \"UTC-05:00\", \"UTC-04:00\", \"UTC-03:00\", \"UTC-02:00\", \"UTC-01:00\", \"UTC+01:00\", \"UTC+02:00\", \"UTC+03:00\", \"UTC+04:00\", \"UTC+05:00\", \"UTC+06:00\", \"UTC+07:00\", \"UTC+08:00\", \"UTC+09:00\", \"UTC+10:00\", \"UTC+11:00\", \"UTC+12:00\""
        },
        "admin_user_name": {
          "type": "string",
          "example": "root",
          "description": "管理员账号用户名。\n- 长度为1-32个字符。\n- 必须以字母开头。\n- 可以包含字母,数字、下划线,不能包含其它特殊字符。"
        },
        "admin_user_password": {
          "type": "string",
          "example": "xxx",
          "description": "管理员账号密码。\n- 长度为8~32位。\n- 必须是大写字母(A~Z)、小写字母(a~z)、数字(0~9)、特殊字符~!@#%^*-_=+?的组合。\n建议您输入高强度密码,以提高安全性,防止出现密码被暴力破解等安全风险。"
        }
      },
