    "CreateInstanceExtendParam": {
      "properties": {
        "charge_mode": {
          "type": "string",
          "example": "prePaid",
          "description": "计费模式,取值范围:\n- prePaid:预付费,即包年/包月。\n- postPaid:后付费,即按需付费。\n默认值为postPaid。",
          "enum": [
            "prePaid",
            "postPaid"
          ],
          "default": "postPaid"
        },
        "period_type": {
          "type": "string",
          "description": "订购周期类型,取值范围:\n- month:月。\n- year:年。\n“charge_mode”参数配置为“prePaid”时该参数有效且为必选值。",
          "enum": [
            "month",
            "year"
          ]
        },
        "period_num": {
          "type": "integer",
          "example": 1,
          "description": "订购周期数,取值范围:\n- period_type=month(周期类型为月)时,取值为[1,9]。\n- period_type=year(周期类型为年)时,取值为1。\n“charge_mode”参数配置为“prePaid”时该参数有效且为必选值。"
        },
        "is_auto_renew": {
          "type": "string",
          "description": "是否自动续订,取值范围:\n- “true”:自动续订。\n- “false”:不自动续订。\n“charge_mode”参数配置为“prePaid”时该参数有效,不传该字段时默认为不自动续订。\"",
          "enum": [
            "true",
            "false"
          ]
        },
        "is_auto_pay": {
          "type": "string",
          "description": "下单订购后,是否自动从客户的账户的余额中支付,取值范围:\n- “true”:是(自动从客户账户的余额中支付)。\n- “false”:否(需要客户手动支付)。\n“charge_mode”参数配置为“prePaid”时该参数有效,不传该字段时默认为客户手动支付。\"",
          "enum": [
            "true",
            "false"
          ]
        }
      },
      "description": "扩展参数说明"
    },
    "CreateInstanceDetail": {
      "required": [
        "name",
        "flavor_id",
        "node_num",
        "engine_id",
        "available_zones",
        "vpc_id",
        "subnet_id",
        "security_group_id"
