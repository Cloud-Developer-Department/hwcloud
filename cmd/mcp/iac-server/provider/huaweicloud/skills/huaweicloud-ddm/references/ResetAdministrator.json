{
  "name": "ResetAdministrator",
  "summary": "DDM管理员账号密码管理",
  "tags": "DDM帐号管理",
  "productshort": "DDM",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/admin-user": {
      "put": {
        "tags": [
          "DDM帐号管理"
        ],
        "summary": "DDM管理员账号密码管理",
        "description": "首次调用时新建DDM管理员帐号并设置密码。后续调用时仅更新管理员密码。",
        "operationId": "ResetAdministrator",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "租户在某一region下的project ID。",
            "required": true,
            "type": "string",
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "DDM实例ID。",
            "required": true,
            "type": "string",
            "x-example": "e6b99563-xxxx-xxxx-xxxx-1820d4fd2a67"
          },
          {
            "in": "body",
            "name": "AdminUserInfoReq",
            "description": "管理用用户信息。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AdminUserInfoReq"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "OK"
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/{project_id}/instances/{instance_id}/admin-user",
        "x-request-examples-1": {
          "name": "root",
          "password": "xxx"
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "AdminUserInfoReq": {
      "required": [
        "name",
        "password"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "root",
          "description": "管理员账号用户名。\n- 长度为1-32个字符。\n- 必须以字母开头。\n- 可以包含字母,数字、下划线,不能包含其它特殊字符。"
        },
        "password": {
          "type": "string",
          "example": "xxx",
          "description": "管理员账号密码。\n- 长度为8~32位。\n- 必须是大写字母(A~Z)、小写字母(a~z)、数字(0~9)、特殊字符~!@#%^*-_=+?的组合。\n建议您输入高强度密码,以提高安全性,防止出现密码被暴力破解等安全风险。"
        }
      },
      "description": "管理员账号信息请求参数。"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ddm.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}