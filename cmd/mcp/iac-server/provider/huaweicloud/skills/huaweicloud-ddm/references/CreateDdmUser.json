        "x-request-examples-description-1": "创建账号。",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/619d3e78f61b4be68bc5aa0b59edcf7b/instances/61a4ea66210545909d74a05c27a7179ein09/users",
        "x-request-examples-text-1": "{\n  \"name\": \"user1\",\n  \"description\": \"\",\n  \"base_authority\": [\"CREATE\",\"DROP\",  \"ALTER\",\"INDEX\",\"INSERT\",\"DELETE\",\"UPDATE\",\"SELECT\"],\n  \"password\": \"xxxxxxxxx\"\n}"
      }
    }
  },
  "definitions": {
    "CreateUserRelatedLogicDbV3": {
      "description": "创建账号时关联的逻辑库请求对象",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "logicdbname",
          "description": "**参数解释**:\n\n已创建的逻辑库名称。 表示给账号授予逻辑库权限。\n\n**约束限制**:\n\n不涉及。\n\n**取值范围**:\n\n不涉及。\n\n**默认取值**:\n\n不涉及。"
        }
      }
    },
    "CreateUserRequestV3": {
      "description": "创建账号的请求对象",
      "required": [
        "name",
        "password",
        "base_authority"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "DDMuser1",
          "description": "**参数解释**:\n\n实例账号名称。\n\n**约束限制**:\n\n- 长度为1-32个字符。\n- 必须以字母开头。\n- 可以包含字母、数字、下划线,不能包含其它特殊字符。\n\n**取值范围**:\n\n不涉及。\n\n**默认取值**:\n\n  不涉及。",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "password": {
          "type": "string",
          "example": "xxxx",
          "description": "**参数解释**:\n\n实例账号密码。\n\n**约束限制**:\n\n- 长度为8~32个字符。\n- 至少包含三种字符组合:小写字母、大写字母、数字、特殊字符 ~ ! @ # % ^ * - _ + ?\n- 不能使用简单、强度不够、容易被猜测的密码。\n- 不能与账号名称或者倒序的账号名称相同。\n\n**取值范围**:\n\n不涉及。\n\n**默认取值**:\n\n不涉及。",
          "minLength": 8,
          "maxLength": 32
        },
        "base_authority": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "example": [
            "CREATE",
            "DROP",
            "ALTER",
            "INDEX",
            "INSERT",
            "DELETE",
            "UPDATE",
            "SELECT"
          ],
          "description": "**参数解释**:\n\nDDM实例账号的基础权限。\n\n**约束限制**:\n\n无\n\n**取值范围**:\n\nCREATE、DROP、ALTER、INDEX、INSERT、DELETE、UPDATE、SELECT的任意集合\n\n**默认取值**:\n\n不涉及。",
          "items": {
            "type": "string",
            "enum": [
              "CREATE",
              "DROP",
              "ALTER",
              "INDEX",
              "INSERT",
              "DELETE",
              "UPDATE",
              "SELECT"
            ]
          }
        },
        "description": {
          "type": "string",
          "example": "user for project a",
          "description": "**参数解释**:\n\n实例账号的描述信息。\n\n**约束限制**:\n\n- 长度不超过256个字符。\n\n**取值范围**:\n\n不涉及。\n\n**默认取值**:\n\n不涉及。",
          "minLength": 0,
          "maxLength": 256
        },
        "password_lifetime": {
          "type": "integer",
          "format": "int64",
          "example": "365",
          "description": "**参数解释**:\n\nDDM实例账号的密码有效期。\n\n**约束限制**:\n\n不涉及。\n\n\n**取值范围**:\n\n取值范围为0-65535的整数,单位为天。\n\n0与空表示密码永不过期。\n\n**默认取值**:\n\n默认值为空,永不过期。"
        },
        "databases": {
          "type": "array",
          "minItems": 0,
          "description": "关联的逻辑库的集合。\ndatabases字段可以省略,即创建用户时可以不关联逻辑库。",
          "items": {
            "$ref": "#/definitions/CreateUserRelatedLogicDbV3"
          }
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "**参数解释**:\n\n错误码\n\n**取值范围**:\n\n不涉及。",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "**参数解释**:\n\n错误描述\n\n**取值范围**:\n\n不涉及。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    }
  },
