        "operationId": "CreateDdmUser",
        "summary": "创建账号",
        "description": "账号用于连接和管理逻辑库。一个DDM账号可以关联多个逻辑库。",
        "x-file": "25.12.0",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
