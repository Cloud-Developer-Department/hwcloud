        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "分页参数:每页多少条。"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "计算类型规格总数。"
        }
      },
      "required": [
        "group_type",
        "flavors",
        "offset",
        "limit",
        "total"
      ]
    },
