          "type": "string",
          "description": "资源规格编码。"
        },
        "vcpus": {
          "type": "string",
          "description": "CPU大小。例如:1表示1U。"
        },
        "ram": {
          "type": "string",
          "description": "内存大小,单位:GB。"
        },
        "az_infos": {
          "items": {
            "$ref": "#/definitions/AvailableZone"
          },
          "description": "可用区信息\n\nnormal:在售。\nunsupported:暂不支持该规格。\nsellout:售罄。",
