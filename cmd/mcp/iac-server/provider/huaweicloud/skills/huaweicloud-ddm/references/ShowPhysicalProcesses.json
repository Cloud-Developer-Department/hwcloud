{
  "name": "ShowPhysicalProcesses",
  "summary": "查询物理会话列表",
  "tags": "DDM会话管理",
  "productshort": "DDM",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/physical-processes": {
      "get": {
        "tags": [
          "DDM会话管理"
        ],
        "operationId": "ShowPhysicalProcesses",
        "summary": "查询物理会话列表",
        "description": "查询物理会话列表",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID。"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "关联RDS的ID。"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0。取值必须为数字,且不能为负数。",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "查询个数上限值。取值范围:1~128。不传该参数时,默认值为10。",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "会话结果筛选关键子,长度最大255",
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。 通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/PhysicalProcessesOpenResponse"
            },
            "examples": {
              "application/json": {
                "total_count": 1,
                "physical_processes": [
                  {
                    "id": 1973,
                    "user": "DDMRW1613058863",
                    "hots": "172.16.241.84:58908",
                    "db": "ddm_db_test_0001",
                    "state": "",
                    "command": "Sleep",
                    "info": null,
                    "time": 13977,
                    "trx_executed_time": 0
                  }
                ]
              }
            }
          },
          "400": {
            "description": "bad request",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DBS.280001",
                "error_msg": "Parameter error."
              }
            }
          },
          "500": {
            "description": "server error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DBS.280001",
                "error_msg": "Parameter error."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200001"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "PhysicalProcessInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "会话id"
        },
        "user": {
          "type": "string",
          "description": "用户"
        },
        "host": {
          "type": "string",
          "description": "主机"
        },
        "db": {
          "type": "string",
          "description": "数据库"
        },
        "state": {
          "type": "string",
          "description": "状态"
        },
        "command": {
          "type": "string",
          "description": "连接状态,一般是休眠(sleep),查询(query),连接(connect)"
        },
        "info": {
          "type": "string",
          "description": "线程执行的 sql 语句"
        },
        "time": {
          "type": "integer",
          "format": "int64",
          "description": "会话持续时间,单位秒"
        },
        "trx_executed_time": {
          "type": "integer",
          "format": "int64",
          "description": "事务持续时间,单位秒"
        }
      }
    },
    "PhysicalProcessesOpenResponse": {
      "type": "object",
      "properties": {
        "physical_processes": {
          "items": {
            "$ref": "#/definitions/PhysicalProcessInfo"
          },
          "type": "array",
          "description": "物理会话信息列表"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "总数"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
