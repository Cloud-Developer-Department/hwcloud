  "definitions": {
    "CheckedKey": {
      "type": "object",
      "description": "检查键",
      "properties": {
        "key": {
          "type": "string",
          "description": "键",
          "minLength": 0,
          "maxLength": 2048
        },
        "is_etag_matching": {
          "type": "boolean",
          "description": "是否电子标签匹配"
        },
        "is_object_existing": {
          "type": "boolean",
          "description": "是否存在对象"
        }
      }
    },
    "ErrorResp": {
      "properties": {
        "error_msg": {
          "type": "string",
          "example": "Error message.",
          "description": "错误信息。",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "x-annotations": ""
        },
        "error_code": {
          "type": "string",
          "example": "OMS.0001",
          "description": "错误码。",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "x-annotations": ""
        }
      },
      "description": "标准错误响应体。",
      "x-annotations": "@com.fasterxml.jackson.annotation.JsonPropertyOrder({\"error_code\", \"error_msg\"})"
    },
    "PrefixKeyInfo": {
      "type": "object",
      "description": "前缀key",
      "required": [
        "keys"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 0
          },
          "description": "键",
          "minItems": 0,
          "maxItems": 100
        }
      }
    },
    "SourceCdnReq": {
      "required": [
        "authentication_type",
        "domain",
        "protocol"
      ],
      "properties": {
        "authentication_key": {
          "type": "string",
          "example": "xxx",
          "description": "CDN鉴权密钥,如果CDN需要进行鉴权,则此选项为必选。\n\n无需授权:无需配置此项。\nQiniu:无需配置此项。\nAliyun:根据authentication_type指定的鉴权方式配置此项。\nKingsoftCloud:无需配置此项。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$"
        },
        "authentication_type": {
          "type": "string",
          "example": "ALIYUN_OSS_A",
          "description": "鉴权类型:\nNONE:公开访问,无安全限制,\nQINIU_PRIVATE_AUTHENTICATION:七牛自定义URL签名,\nALIYUN_OSS_A:阿里云  URL携带签名,简单通用,\nALIYUN_OSS_B:阿里云  Header携带签名,用于API调用,\nALIYUN_OSS_C:阿里云  STS临时安全令牌,最安全,\nKSYUN_PRIVATE_AUTHENTICATION:金山云  金山云自定义URL签名,\nAZURE_SAS_TOKEN:微软Azure  灵活安全的共享访问签名,\nTENCENT_COS_A:腾讯云  多次有效签名(不推荐),\nTENCENT_COS_B:腾讯云  单次有效签名,安全性最高,\nTENCENT_COS_C:腾讯云  Header携带签名,用于API调用,\nTENCENT_COS_D:腾讯云  Header携带签名,用于API调用.",
          "enum": [
            "NONE",
            "QINIU_PRIVATE_AUTHENTICATION",
            "ALIYUN_OSS_A",
            "ALIYUN_OSS_B",
            "ALIYUN_OSS_C",
            "KSYUN_PRIVATE_AUTHENTICATION",
            "AZURE_SAS_TOKEN",
            "TENCENT_COS_A",
            "TENCENT_COS_B",
            "TENCENT_COS_C",
            "TENCENT_COS_D"
          ],
          "default": "NONE"
        },
        "domain": {
          "type": "string",
          "example": "xxx.xxx.xxx",
          "description": "\t\n从指定域名获取对象。",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^(?=^.{3,255}$)(?!^.*\\.myhuaweicloud.com$)(?!^.*\\.myhwclouds.com$)((?!^.*(\\d)+$)[a-zA-Z0-9][-a-zA-Z0-9]{0,62}(\\.[a-zA-Z0-9][-a-zA-Z0-9]{0,62})+$)"
        },
        "protocol": {
          "type": "string",
          "example": "https",
          "description": "协议类型,支持http和https协议。",
          "enum": [
            "http",
            "https"
          ]
        },
        "crypto_type": {
          "enum": [
            "DEFAULT",
            "KMS"
          ],
          "type": "string",
          "example": "DEFAULT",
          "description": "加解密类型,默认为DEFAULT,可选类型为DEFAULT、KMS",
          "minLength": 1,
          "maxLength": 32,
          "default": "DEFAULT"
        },
        "kms_key_id": {
          "type": "string",
          "example": "0d0466b0-e727-4d9c-b35d-f84bb474a37f",
          "description": "KMS密钥ID,36个字符",
          "minLength": 0,
          "maxLength": 36,
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$"
        }
      },
      "description": "源端CDN配置。"
    },
    "ShowCdnInfoReq": {
      "type": "object",
      "description": "查桶对应的CDN信息",
      "properties": {
        "ak": {
          "type": "string",
          "description": "源端桶的AK(最大长度100个字符),task_type为非url_list时,本参数为必选。",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "minLength": 0,
          "maxLength": 100
        },
        "sk": {
          "type": "string",
          "description": "源端桶的SK(最大长度100个字符),task_type为非url_list时,本参数为必选。",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "minLength": 0,
          "maxLength": 100
        },
        "connection_string": {
          "type": "string",
          "description": "连接字符串,用于微软云Blob鉴权",
          "minLength": 0,
          "maxLength": 2048
        },
        "cloud_type": {
          "type": "string",
          "description": "云类型\nAWS:亚马逊\nAliyun:阿里云\nQiniu:七牛云\nQingCloud:青云\nTencent:腾讯云\nBaidu:百度云\nKingsoftCloud:金山云\nAzure:微软云\nUCloud:优刻得\nHuaweiCloud:华为云\nURLSource:URL\nHEC:HEC",
          "minLength": 0,
          "maxLength": 100,
          "example": "HuaweiCloud",
          "pattern": "^(AWS|Azure|Aliyun|Tencent|HuaweiCloud|QingCloud|KingsoftCloud|Baidu|Qiniu|URLSource|UCloud|HEC)$"
        },
        "region": {
          "type": "string",
          "description": "区域",
          "example": "cn-north-x",
          "minLength": 0,
          "maxLength": 100
        },
        "app_id": {
          "type": "string",
          "description": "腾讯云APPID,当源端为腾讯云时,需要填写此参数,您可以在腾讯云控制台账号信息页面获取。",
          "example": "xxxxx",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "minLength": 0,
          "maxLength": 255
        },
        "bucket": {
          "type": "string",
          "description": "桶名",
          "example": "xxx",
          "minLength": 0,
          "maxLength": 100,
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$"
        },
        "prefix": {
          "description": "前缀",
          "$ref": "#/definitions/PrefixKeyInfo"
        },
        "source_cdn": {
          "$ref": "#/definitions/SourceCdnReq",
          "description": "指定是否启用CDN迁移支持,若包含此字段则为支持,否则为不支持,启用CDN迁移支持后,迁移时将从CDN域名获取源端对象。"
        }
      },
      "required": [
        "ak",
        "sk",
        "cloud_type",
        "region",
        "bucket",
        "source_cdn"
      ]
    },
    "ShowCdnInfoResp": {
      "type": "object",
      "description": "查询CDN信息响应体",
      "properties": {
        "is_same_cloud_type": {
          "type": "boolean",
          "description": "是否相同云类型"
        },
        "is_download_available": {
          "type": "boolean",
          "description": "是否下载可用"
        },
        "checked_keys": {
          "type": "array",
          "description": "返回的已检查的对象数组",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/CheckedKey"
          }
        }
      }
    }
  },
