          "minLength": 1,
          "maxLength": 32,
          "default": "DEFAULT"
        },
        "kms_key_id": {
          "type": "string",
          "example": "0d0466b0-e727-4d9c-b35d-f84bb474a37f",
          "description": "KMS密钥ID,36个字符",
          "minLength": 0,
          "maxLength": 36,
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$"
        }
      },
      "description": ""
    },
