  "definitions": {
    "SmnConfig": {
      "required": [
        "topic_urn",
        "trigger_conditions"
      ],
      "properties": {
        "language": {
          "type": "string",
          "example": "en-us",
          "description": "当前用户所使用的管理控制台的语言。\n\n可以选择zh-cn或者en-us。",
          "enum": [
            "zh-cn",
            "en-us"
          ],
          "default": "en-us"
        },
        "topic_urn": {
          "type": "string",
          "example": "urn:smn:region:4cf2090802d94440b4cdd72ef26857b2:OMS",
          "description": "迁移任务所绑定的SMN消息主题的urn号。",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$"
        },
        "trigger_conditions": {
          "type": "array",
          "example": "[\"SUCCESS\",\"FAIL\"]",
          "description": "\t\nSMN消息的触发条件,取决于迁移任务状态。\n\n迁移任务状态的取值范围为SUCCESS或者FAILURE。\n\n- FAILURE表示任务失败后发送SMN消息。\n- SUCCESS表示任务成功后发送SMN消息。",
          "items": {
            "type": "string",
            "description": "",
            "pattern": "^(SUCCESS|FAILURE)$"
          },
          "maxItems": 2,
          "minItems": 1,
          "x-annotations": "@Size(min = 1, max = 2) @StringListValidation(pattern = \"^(SUCCESS|FAILURE)$\")"
        },
        "message_template_name": {
          "type": "string",
          "description": "如果设置此值,则表示用模板方式发送smn信息。\n模板示例:\n{\n\t“Task_Status”: \"\",\n    \"Task_Name\" : \"\",\n    \"Start_Time\": \"\",\n    \"Total_Time_Used\": \"\",\n    \"Transferred_Data\": \"\",\n    \"Average_Speed\": \"\",\n    \"Source_Bucket\": \"\",\n    \"Destination_Bucket\": \"\",\n    \"List_File_Bucket\": \"\",\n    \"List_File_Key\": \"\",\n    \"Success_object_list_path\": \"\",\n    \"Skip_object_list_path\": \"\",\n    \"Failed_object_list_path\": \"\"\n}",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$"
        }
      },
      "description": "SMN消息通知配置。"
    },
    "ListFile": {
      "required": [
        "list_file_key",
        "obs_bucket"
      ],
      "properties": {
        "list_file_key": {
          "type": "string",
          "example": "object_list_file.txt",
          "description": "对象列表文件或URL列表文件对象名。",
          "minLength": 1,
          "maxLength": 1024
        },
        "obs_bucket": {
          "type": "string",
          "example": "obs_bucket",
          "description": "存放对象列表文件的OBS桶名。\n\n请确保与目的端桶处于同一区域,否则将导致任务创建失败。",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$"
        },
        "list_file_num": {
          "type": "string",
          "description": "存放对象列表文件的数量",
          "example": 10,
          "minLength": 0,
          "maxLength": 65535
        }
      },
      "description": "列表文件配置。"
    },
    "ErrorResp": {
      "properties": {
        "error_msg": {
          "type": "string",
          "example": "Error message.",
          "description": "错误信息。",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "x-annotations": ""
        },
        "error_code": {
          "type": "string",
          "example": "OMS.0001",
          "description": "错误码。",
