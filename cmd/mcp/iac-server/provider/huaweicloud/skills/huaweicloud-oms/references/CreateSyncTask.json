    },
    "CreateSyncTaskReq": {
      "description": "创建同步请求body体",
      "properties": {
        "src_cloud_type": {
          "type": "string",
          "description": "源端云服务提供商。\n\n可选值有AWS、Azure、Aliyun、Tencent、HuaweiCloud、QingCloud、KingsoftCloud、Baidu、Qiniu、UCloud。默认值为Aliyun。",
          "pattern": "^(AWS|Azure|Aliyun|Tencent|HuaweiCloud|QingCloud|KingsoftCloud|Baidu|Qiniu|UCloud)$",
          "default": "Aliyun",
          "x-annotations": ""
        },
        "src_region": {
          "type": "string",
          "description": "源端桶所处的区域",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "maxLength": 100,
          "minLength": 0
        },
        "src_bucket": {
          "type": "string",
          "description": "源端桶名",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "maxLength": 1024,
          "minLength": 0
        },
        "src_ak": {
          "type": "string",
          "description": "源端桶的AK(最大长度100个字符)。",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "maxLength": 100,
          "minLength": 0
        },
        "src_sk": {
          "type": "string",
          "description": "源端桶的SK(最大长度100个字符)。",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "maxLength": 100,
          "minLength": 0
        },
        "src_crypto_type": {
          "enum": [
            "DEFAULT",
            "KMS"
          ],
          "type": "string",
          "example": "DEFAULT",
          "description": "加解密类型,默认为DEFAULT,可选类型为DEFAULT、KMS",
          "minLength": 1,
          "maxLength": 32,
          "default": "DEFAULT"
        },
        "src_kms_key_id": {
          "type": "string",
          "example": "0d0466b0-e727-4d9c-b35d-f84bb474a37f",
          "description": "KMS密钥ID,36个字符",
          "minLength": 0,
          "maxLength": 36,
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$"
        },
        "dst_ak": {
          "type": "string",
          "description": "目的端桶的AK(最大长度100个字符)。",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "maxLength": 100,
          "minLength": 0
        },
        "dst_sk": {
          "type": "string",
          "description": "目的端桶的SK(最大长度100个字符)。",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "maxLength": 100,
          "minLength": 0
        },
        "dst_crypto_type": {
          "enum": [
            "DEFAULT",
            "KMS"
          ],
          "type": "string",
          "example": "DEFAULT",
          "description": "加解密类型,默认为DEFAULT,可选类型为DEFAULT、KMS",
          "minLength": 1,
          "maxLength": 32,
          "default": "DEFAULT"
        },
        "dst_kms_key_id": {
          "type": "string",
          "example": "0d0466b0-e727-4d9c-b35d-f84bb474a37f",
          "description": "KMS密钥ID,36个字符",
          "minLength": 0,
          "maxLength": 36,
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$"
        },
        "dst_region": {
          "type": "string",
          "description": "目的端region",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "maxLength": 100,
          "minLength": 0
        },
        "dst_bucket": {
          "type": "string",
          "description": "目的端桶名",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "maxLength": 1024,
          "minLength": 0
        },
        "description": {
          "type": "string",
          "description": "任务描述,不能超过255个字符,且不能包含<>()\"'&等特殊字符。",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "maxLength": 255,
          "minLength": 0
        },
        "enable_metadata_migration": {
          "type": "boolean",
          "example": false,
          "description": "是否启用元数据迁移,默认否。不启用时,为保证迁移任务正常运行,仍将为您迁移ContentType元数据。",
          "default": false,
          "x-annotations": ""
        },
        "enable_restore": {
          "type": "boolean",
          "description": "是否自动解冻归档数据,默认否。\n\n开启后,如果遇到归档类型数据,会自动解冻再进行迁移。",
          "default": false,
          "x-annotations": ""
        },
        "dst_storage_policy": {
          "type": "string",
          "description": "目的端存储类型设置,当且仅当目的端为华为云OBS时需要,默认为标准存储\nSTANDARD:华为云OBS标准存储\nIA:华为云OBS低频存储\nARCHIVE:华为云OBS归档存储\nDEEP_ARCHIVE:华为云OBS深度归档存储\nSRC_STORAGE_MAPPING:保留源端存储类型,将源端存储类型映射为华为云OBS存储类型",
          "default": "STANDARD",
          "example": "STANDARD",
          "enum": [
            "STANDARD",
            "IA",
            "ARCHIVE",
            "DEEP_ARCHIVE",
            "SRC_STORAGE_MAPPING"
          ],
          "minLength": 0,
          "maxLength": 128
        },
        "app_id": {
          "type": "string",
          "description": "腾讯云APPID,当源端为腾讯云时,需要填写此参数,您可以在腾讯云控制台账号信息页面获取。",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "maxLength": 255,
          "minLength": 0
        },
        "source_cdn": {
          "description": "指定是否启用CDN迁移支持,若包含此字段则为支持,否则为不支持,启用CDN迁移支持后,迁移时将从CDN域名获取源端对象。",
          "$ref": "#/definitions/SourceCdnReq"
        },
        "consistency_check": {
          "type": "string",
          "description": "一致性校验方式,用于迁移前/后校验对象是否一致,所有校验方式需满足源端/目的端对象的加密状态一致,具体校验方式和校验结果可通过对象列表查看。默认size_last_modified。\nsize_last_modified:默认配置。迁移前后,通过对比源端和目的端对象大小+最后修改时间,判断对象是否已存在或迁移后数据是否完整。源端与目的端同名对象大小相同,且目的端对象最后修改时间不早于源端对象最后修改时间,则代表该对象已存在/迁移成功。\ncrc64:目前仅支持华为/阿里/腾讯。迁移前后,通过对比源端和目的端对象元数据中CRC64值是否相同,判断对象是否已存在/迁移完成。如果源端与目的端对象元数据中不存在CRC64值,则系统会默认使用大小/最后修改时间校验方式来校验。\ntransmission:目前仅支持HTTP/HTTPS数据源。当源端对象无法通过标准http协议中content-length字段获取数据大小时,默认数据下载成功即迁移成功,不对数据做额外校验,且迁移时源端对象默认覆盖目的端同名对象。当源端对象能正常通过标准http协议中content-length字段获取数据大小时,则采用大小/最后修改时间校验方式来校验。",
          "default": "size_last_modified",
          "example": "size_last_modified",
          "enum": [
            "size_last_modified",
            "crc64",
            "transmission"
          ]
        }
      },
      "required": [
        "src_region",
        "src_bucket",
        "src_ak",
        "src_sk",
        "dst_ak",
        "dst_sk",
        "dst_region",
        "dst_bucket"
      ],
      "type": "object"
    },
    "SourceCdnReq": {
      "required": [
        "authentication_type",
        "domain",
        "protocol"
      ],
      "properties": {
        "authentication_key": {
          "type": "string",
          "example": "xxx",
          "description": "CDN鉴权密钥,如果CDN需要进行鉴权,则此选项为必选。\n\n无需授权:无需配置此项。\nQiniu:无需配置此项。\nAliyun:根据authentication_type指定的鉴权方式配置此项。\nKingsoftCloud:无需配置此项。",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$"
        },
        "authentication_type": {
          "type": "string",
          "example": "ALIYUN_OSS_A",
          "description": "鉴权类型:\nNONE:公开访问,无安全限制,\nQINIU_PRIVATE_AUTHENTICATION:七牛自定义URL签名,\nALIYUN_OSS_A:阿里云  URL携带签名,简单通用,\nALIYUN_OSS_B:阿里云  Header携带签名,用于API调用,\nALIYUN_OSS_C:阿里云  STS临时安全令牌,最安全,\nKSYUN_PRIVATE_AUTHENTICATION:金山云  金山云自定义URL签名,\nAZURE_SAS_TOKEN:微软Azure  灵活安全的共享访问签名,\nTENCENT_COS_A:腾讯云  多次有效签名(不推荐),\nTENCENT_COS_B:腾讯云  单次有效签名,安全性最高,\nTENCENT_COS_C:腾讯云  Header携带签名,用于API调用,\nTENCENT_COS_D:腾讯云  Header携带签名,用于API调用.",
          "enum": [
            "NONE",
            "QINIU_PRIVATE_AUTHENTICATION",
            "ALIYUN_OSS_A",
            "ALIYUN_OSS_B",
            "ALIYUN_OSS_C",
            "KSYUN_PRIVATE_AUTHENTICATION",
            "AZURE_SAS_TOKEN",
            "TENCENT_COS_A",
            "TENCENT_COS_B",
            "TENCENT_COS_C",
            "TENCENT_COS_D"
          ],
          "default": "NONE"
        },
        "domain": {
          "type": "string",
          "example": "xxx.xxx.xxx",
          "description": "\t\n从指定域名获取对象。",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^(?=^.{3,255}$)(?!^.*\\.myhuaweicloud.com$)(?!^.*\\.myhwclouds.com$)((?!^.*(\\d)+$)[a-zA-Z0-9][-a-zA-Z0-9]{0,62}(\\.[a-zA-Z0-9][-a-zA-Z0-9]{0,62})+$)"
        },
        "protocol": {
          "type": "string",
          "example": "https",
          "description": "协议类型,支持http和https协议。",
          "enum": [
            "http",
            "https"
          ]
        },
        "crypto_type": {
          "enum": [
            "DEFAULT",
            "KMS"
          ],
          "type": "string",
          "example": "DEFAULT",
          "description": "加解密类型,默认为DEFAULT,可选类型为DEFAULT、KMS",
          "minLength": 1,
          "maxLength": 32,
          "default": "DEFAULT"
        },
        "kms_key_id": {
          "type": "string",
          "example": "0d0466b0-e727-4d9c-b35d-f84bb474a37f",
          "description": "KMS密钥ID,36个字符",
          "minLength": 0,
          "maxLength": 36,
          "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$"
        }
      },
      "description": "源端CDN配置。"
    }
  },
