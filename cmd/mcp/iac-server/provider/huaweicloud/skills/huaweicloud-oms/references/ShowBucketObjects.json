    "ShowBucketReq": {
      "type": "object",
      "description": "查询桶请求体",
      "properties": {
        "cloud_type": {
          "type": "string",
          "description": "云类型\nAWS:亚马逊\nAliyun:阿里云\nQiniu:七牛云\nQingCloud:青云\nTencent:腾讯云\nBaidu:百度云\nKingsoftCloud:金山云\nAzure:微软云\nUCloud:优刻得\nHuaweiCloud:华为云\nGoogle: 谷歌云\nURLSource:URL\nHEC:HEC",
          "minLength": 0,
          "maxLength": 100,
          "example": "HuaweiCloud",
          "pattern": "^(AWS|Azure|Aliyun|Tencent|HuaweiCloud|QingCloud|KingsoftCloud|Baidu|Google|Qiniu|URLSource|UCloud|HEC)$"
        },
        "file_path": {
          "type": "string",
          "description": "目标桶中需要查询的对象文件路径,/结尾",
          "example": "xxx/",
          "minLength": 0,
          "maxLength": 1023
        },
        "ak": {
          "type": "string",
          "description": "源端桶的AK(最大长度100个字符)",
          "example": "xxxxxak",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "minLength": 0,
          "maxLength": 100
        },
        "sk": {
          "type": "string",
          "description": "源端桶的SK(最大长度100个字符)",
          "example": "xxxxxsk",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "minLength": 0,
          "maxLength": 100
        },
        "connection_string": {
          "type": "string",
          "description": "连接字符串,用于微软云Blob鉴权",
          "minLength": 0,
          "maxLength": 2048
        },
        "json_auth_file": {
          "type": "string",
          "description": "用于谷歌云Cloud Storage鉴权",
          "minLength": 0,
          "maxLength": 65535
        },
        "data_center": {
          "type": "string",
          "description": "数据中心,区域",
          "example": "cn-north-x",
          "minLength": 0,
          "maxLength": 100
        },
        "page_size": {
          "type": "integer",
          "format": "int32",
          "description": "分页信息,页大小",
          "example": 100,
          "minimum": 0,
          "maximum": 100
        },
        "behind_filename": {
          "type": "string",
          "description": "分页信息,当前页最后一个对象名称(偏移量)",
          "example": "xxx",
          "minLength": 0,
          "maxLength": 1024
        },
        "app_id": {
          "type": "string",
          "description": "腾讯云APPID,当源端为腾讯云时,需要填写此参数,您可以在腾讯云控制台账号信息页面获取。",
          "example": "apptest123",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "minLength": 0,
          "maxLength": 255
        },
        "bucket_name": {
          "type": "string",
          "description": "桶名",
          "example": "xxxx",
          "minLength": 0,
          "maxLength": 100,
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$"
        }
      },
      "required": [
        "cloud_type",
        "file_path",
        "data_center",
        "page_size",
        "behind_filename",
        "bucket_name"
      ]
    },
    "ShowBucketRecord": {
      "type": "object",
      "description": "查询桶返回的record信息",
      "properties": {
        "name": {
          "type": "string",
          "description": "对象名",
          "minLength": 0,
          "maxLength": 1024
        },
        "size": {
          "type": "string",
          "description": "对象大小,若对象无size属性,则返回--",
          "minLength": 0,
          "maxLength": 100
        }
      }
    },
    "ShowBucketResp": {
      "type": "object",
      "description": "查询桶信息相应体",
      "properties": {
        "next_page": {
          "type": "boolean",
          "description": "是否存在下一页"
        },
        "next_marker": {
          "type": "string",
          "description": "查询下一页所需要的标记(此页末尾对象名,偏移量)",
          "minLength": 0,
          "maxLength": 1024
        },
        "records": {
          "type": "array",
          "description": "查询桶信息返回的record",
          "items": {
            "$ref": "#/definitions/ShowBucketRecord"
          },
          "minItems": 0,
          "maxItems": 100
        }
      }
