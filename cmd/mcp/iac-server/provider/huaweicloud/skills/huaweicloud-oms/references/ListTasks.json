  },
  "definitions": {
    "ListFile": {
      "required": [
        "list_file_key",
        "obs_bucket"
      ],
      "properties": {
        "list_file_key": {
          "type": "string",
          "example": "object_list_file.txt",
          "description": "对象列表文件或URL列表文件对象名。",
          "minLength": 1,
          "maxLength": 1024
        },
        "obs_bucket": {
          "type": "string",
          "example": "obs_bucket",
          "description": "存放对象列表文件的OBS桶名。\n\n请确保与目的端桶处于同一区域,否则将导致任务创建失败。",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$"
        },
        "list_file_num": {
          "type": "string",
          "description": "存放对象列表文件的数量",
          "example": 10,
          "minLength": 0,
          "maxLength": 65535
        }
      },
      "description": "列表文件配置。"
    },
    "ErrorResp": {
      "properties": {
        "error_msg": {
          "type": "string",
          "example": "Error message.",
          "description": "错误信息。",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "x-annotations": ""
        },
        "error_code": {
          "type": "string",
          "example": "OMS.0001",
          "description": "错误码。",
          "pattern": "^[^<>&\\\"'\\\\\\\\]*$",
          "x-annotations": ""
        }
      },
      "description": "标准错误响应体。",
      "x-annotations": "@com.fasterxml.jackson.annotation.JsonPropertyOrder({\"error_code\", \"error_msg\"})"
    },
    "TaskResp": {
      "properties": {
        "bandwidth_policy": {
          "type": "array",
          "description": "流量控制策略,每个任务最多可设置5条限速策略。",
          "items": {
            "$ref": "#/definitions/BandwidthPolicyDto"
          },
          "maxItems": 5,
          "minItems": 0
        },
        "complete_size": {
          "type": "integer",
          "format": "int64",
          "description": "任务迁移完成大小(Byte)。",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "example": 9651103
        },
        "description": {
          "type": "string",
          "example": "test log",
          "description": "任务描述,没有设置时为空字符串。",
          "minLength": 0,
          "maxLength": 255
        },
        "dst_node": {
          "description": "目的端节点信息",
          "$ref": "#/definitions/DstNodeResp"
        },
        "enable_failed_object_recording": {
          "type": "boolean",
          "example": true,
          "description": "是否记录失败对象。开启后,如果有迁移失败对象,会在目的端存储失败对象信息。"
        },
        "enable_metadata_migration": {
          "type": "boolean",
          "example": false,
          "description": "是否启用元数据迁移,默认否。不启用时,为保证迁移任务正常运行,仍将为您迁移ContentType元数据。"
        },
        "enable_restore": {
          "type": "boolean",
          "description": "是否自动解冻归档数据,(由于对象存储解冻需要源端存储等待一定时间,开启自动解冻会对迁移速度有较大影响,建议先完成归档存储数据解冻后再启动迁移)。\n开启后,如果遇到归档类型数据,会自动解冻再进行迁移;关闭后,如果遇到归档类型的对象直接跳过相应对象,系统默认对象迁移失败并记录相关信息到失败对象列表中。"
        },
        "error_reason": {
          "description": "任务失败原因,非失败状态时该字段为空字符串。",
          "$ref": "#/definitions/ErrorReasonResp",
          "x-annotations": ""
        },
        "failed_num": {
          "type": "integer",
          "format": "int64",
          "description": "迁移失败对象数量。",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "example": 1024
        },
        "failed_object_record": {
          "description": "失败对象列表记录结果,记录成功时提供失败对象列表存放链接,记录失败时显示失败原因。",
          "$ref": "#/definitions/FailedObjectRecordDto"
        },
        "group_id": {
          "type": "string",
          "example": "group_id",
          "description": "迁移任务组ID,当任务由迁移任务组创建时会包含迁移任务组的id信息。",
          "minLength": 0,
          "maxLength": 36
        },
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "任务ID。",
          "minimum": 0,
          "maximum": 999999999999999,
          "example": 20200810368547
        },
        "is_query_over": {
          "type": "boolean",
          "example": true,
          "description": "迁移任务是否完成源端对象统计数据扫描。"
        },
        "left_time": {
          "type": "integer",
          "format": "int64",
          "description": "任务剩余时间(毫秒)。",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "example": 6854775807
        },
        "migrate_since": {
          "type": "integer",
          "format": "int64",
          "description": "迁移指定时间(时间戳,毫秒),表示仅迁移在指定时间之后修改的源端待迁移对象。默认为0,表示不设置迁移指定时间。",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "example": 6854775807
        },
        "migrate_speed": {
          "type": "integer",
          "format": "int64",
          "description": "任务迁移速度(Byte/s)。",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "example": 6854775807
        },
        "name": {
          "type": "string",
          "example": "taskname",
          "description": "任务名称。",
          "minLength": 0,
          "maxLength": 10240
        },
        "progress": {
          "type": "number",
          "format": "double",
          "description": "任务进度,例如:0.522代表任务进度为52.2%,1代表任务进度为100%。",
          "minimum": 0,
          "maximum": 1,
          "example": 0.522
        },
        "real_size": {
          "type": "integer",
          "format": "int64",
          "description": "实际迁移对象总大小(Byte),忽略对象的大小不会统计在内。",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "example": 6854775807
        },
        "skipped_num": {
          "type": "integer",
          "format": "int64",
          "description": "迁移忽略对象数(存在以下两种情况会自动跳过:1.源端对象最后修改时间在迁移指定时间前;2.目的端已有该对象。)",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "example": 10240
        },
        "src_node": {
          "description": "源端节点信息",
          "$ref": "#/definitions/SrcNodeResp"
        },
        "start_time": {
          "type": "integer",
          "format": "int64",
          "description": "任务启动时间(Unix时间戳,毫秒)。",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "example": 6854775807
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "任务状态。\n1:等待调度\n2:正在执行\n3:停止\n4:失败\n5:成功\n6:重试中\n7:暂停中",
          "minimum": 1,
          "maximum": 7
        },
        "successful_num": {
          "type": "integer",
          "format": "int64",
          "description": "迁移成功对象数量。",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "example": 409600
        },
        "task_type": {
          "type": "string",
          "example": "string",
          "description": "任务类型,为空默认设置为object。\nlist:对象列表迁移\nobject:文件/文件夹迁移\nprefix:对象前缀迁移\nurl_list: url对象列表",
          "enum": [
            "list",
            "object",
            "prefix",
            "url_list"
          ],
          "default": "object"
        },
        "group_type": {
          "type": "string",
          "example": "NORMAL_TASK",
          "description": "分组类型\nNORMAL_TASK:一般迁移任务\nSYNC_TASK:同步任务所属迁移任务\nGROUP_TASK:任务组所属迁移任务",
          "enum": [
            "NORMAL_TASK",
            "SYNC_TASK",
            "GROUP_TASK"
          ],
          "default": "NORMAL_TASK"
        },
        "total_num": {
          "type": "integer",
          "format": "int64",
          "description": "迁移任务对象总数量。",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "example": 409600
        },
        "total_size": {
          "type": "integer",
          "format": "int64",
          "description": "任务迁移总大小(Byte)。",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "example": 337203685
        },
        "total_time": {
          "type": "integer",
          "format": "int64",
          "description": "任务总耗时(毫秒)。",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "example": 36854775807
        },
        "smn_info": {
          "description": "SMN消息通知结果",
          "$ref": "#/definitions/SmnInfo"
        },
        "source_cdn": {
          "description": "指定是否启用CDN迁移支持。启用CDN迁移支持后,迁移时将从CDN域名获取源端对象。若包含此字段则为支持,否则为不支持。",
          "$ref": "#/definitions/SourceCdnResp"
        },
        "success_record_error_reason": {
          "type": "string",
          "example": "S3M.0309",
          "description": "迁移成功对象列表记录失败错误码,记录成功时为空",
          "minLength": 0,
          "maxLength": 255
        },
        "skip_record_error_reason": {
          "type": "string",
          "example": "S3M.0311",
          "description": "迁移忽略对象列表记录失败错误码,记录记录成功时为空。",
          "minLength": 0,
          "maxLength": 255
        },
        "object_overwrite_mode": {
          "type": "string",
          "description": "迁移前同名对象覆盖方式,用于迁移前判断源端与目的端有同名对象时,覆盖目的端或跳过迁移。默认SIZE_LAST_MODIFIED_COMPARISON_OVERWRITE。\nNO_OVERWRITE:不覆盖。迁移前源端对象与目的端对象同名时,不做对比直接跳过迁移。\nSIZE_LAST_MODIFIED_COMPARISON_OVERWRITE:大小/最后修改时间对比覆盖。默认配置。迁移前源端对象与目的端对象同名时,通过对比源端和目的端对象大小和最后修改时间,判断是否覆盖目的端,需满足源端/目的端对象的加密状态一致。源端与目的端同名对象大小不相同,或目的端对象的最后修改时间晚于源端对象的最后修改时间(源端较新),覆盖目的端。 \nCRC64_COMPARISON_OVERWRITE:CRC64对比覆盖。目前仅支持华为/阿里/腾讯。迁移前源端对象与目的端对象同名时,通过对比源端和目的端对象元数据中CRC64值是否相同,判断是否覆盖目的端,需满足源端/目的端对象的加密状态一致。如果源端与目的端对象元数据中不存在CRC64值,则系统会默认使用SIZE_LAST_MODIFIED_COMPARISON_OVERWRITE(大小/最后修改时间对比覆盖)来对比进行覆盖判断。\nFULL_OVERWRITE:全覆盖。迁移前源端对象与目的端对象同名时,不做对比覆盖目的端。",
          "example": "SIZE_LAST_MODIFIED_COMPARISON_OVERWRITE",
          "enum": [
            "NO_OVERWRITE",
            "SIZE_LAST_MODIFIED_COMPARISON_OVERWRITE",
            "CRC64_COMPARISON_OVERWRITE",
            "FULL_OVERWRITE"
          ]
        },
        "dst_storage_policy": {
          "type": "string",
          "description": "目的端存储类型设置,当且仅当目的端为华为云OBS时需要,默认为标准存储\nSTANDARD:华为云OBS标准存储\nIA:华为云OBS低频存储\nARCHIVE:华为云OBS归档存储\nDEEP_ARCHIVE:华为云OBS深度归档存储\nSRC_STORAGE_MAPPING:保留源端存储类型,将源端存储类型映射为华为云OBS存储类型",
          "default": "STANDARD",
          "example": "STANDARD",
          "enum": [
            "STANDARD",
            "IA",
            "ARCHIVE",
            "DEEP_ARCHIVE",
            "SRC_STORAGE_MAPPING"
          ],
          "minLength": 0,
          "maxLength": 128
        },
        "consistency_check": {
          "type": "string",
          "description": "一致性校验方式,用于迁移前/后校验对象是否一致,所有校验方式需满足源端/目的端对象的加密状态一致,具体校验方式和校验结果可通过对象列表查看。默认size_last_modified。\nsize_last_modified:默认配置。迁移前后,通过对比源端和目的端对象大小+最后修改时间,判断对象是否已存在或迁移后数据是否完整。源端与目的端同名对象大小相同,且目的端对象的最后修改时间不早于源端对象的最后修改时间,则代表该对象已存在/迁移成功。\ncrc64:目前仅支持华为/阿里/腾讯。迁移前后,通过对比源端和目的端对象元数据中CRC64值是否相同,判断对象是否已存在/迁移完成。如果源端与目的端对象元数据中不存在CRC64值,则系统会默认使用大小/最后修改时间校验方式来校验。\nno_check:目前仅支持HTTP/HTTPS数据源。当源端对象无法通过标准http协议中content-length字段获取数据大小时,默认数据下载成功即迁移成功,不对数据做额外校验,且迁移时源端对象默认覆盖目的端同名对象。当源端对象能正常通过标准http协议中content-length字段获取数据大小时,则采用大小/最后修改时间校验方式来校验。",
          "example": "size_last_modified",
          "enum": [
            "size_last_modified",
            "crc64",
            "no_check"
          ]
        },
        "enable_requester_pays": {
          "type": "boolean",
          "description": "是否开启请求者付款,在启用后,请求者支付请求和数据传输费用。",
          "example": "true"
        },
        "obs_system": {
          "type": "string",
          "description": "OBS系统类型\nBUCKET:一般桶\nPFS:并行文件系统",
          "enum": [
            "BUCKET",
            "PFS"
          ]
        },
        "task_priority": {
          "type": "string",
          "description": "HIGH:高优先级\nMEDIUM:中优先级\nLOW:低优先级",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ],
          "default": "MEDIUM"
        }
      },
      "type": "object"
    },
