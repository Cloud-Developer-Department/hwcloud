            "in": "header",
            "required": true,
            "description": "IAM 鉴权 Token",
            "maxLength": 16384,
            "minLength": 1,
            "type": "string",
            "x-order": 5,
            "x-annotations": "",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "查询返回同步任务列表当前页面的数量,默认查询10条。\n最多返回100条迁移任务信息。",
            "type": "integer",
            "format": "int32",
            "default": 10,
            "maximum": 100,
            "minimum": 1,
            "x-order": 4,
            "x-example": 100
          },
          {
            "name": "offset",
