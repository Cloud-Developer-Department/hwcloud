{
  "name": "ListSyncTasks",
  "summary": "查询同步任务列表",
  "tags": "同步任务",
  "productshort": "OMS",
  "region_id": "af-south-1",
  "paths": {
    "/v2/{project_id}/sync-tasks": {
      "get": {
        "x-api-type": "open-api",
        "x-support-sdk": "Y",
        "x-name": "查询所有同步任务",
        "x-constraint": "",
        "x-version": "v2",
        "x-scope": "Commercial",
        "x-iftype": "OpenAPI",
        "x-order": 17,
        "x-request-examples-description-1": "查询2c0689c860ad4728a497c91ec0844383项目下5条同步中的任务",
        "x-request-examples-url-1": "GET https://{endpoint}/v2/2c0689c860ad4728a497c91ec0844383/sync-tasks?offset=0&limit=5&status=SYNCHRONIZING",
        "x-is-registered": "Y",
        "x-request": "none",
        "x-response": "none",
        "tags": [
          "同步任务"
        ],
        "summary": "查询同步任务列表",
        "description": "查询用户名下所有同步任务信息",
        "operationId": "ListSyncTasks",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "项目ID",
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "x-example": "f4e146cac1de45669c3fed73dc9b9c6f",
            "x-order": 1
          },
          {
