{
  "name": "ShowTask",
  "summary": "获取任务详情",
  "tags": "OptVerse Service",
  "productshort": "OptVerse",
  "region_id": "cn-north-4",
  "paths": {
    "/v2/{project_id}/optverse/{service_type}/tasks/{task_id}": {
      "get": {
        "tags": [
          "OptVerse Service"
        ],
        "summary": "获取任务详情",
        "description": "获取任务详情",
        "operationId": "ShowTask",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "minLength": 32,
            "maxLength": 32,
            "required": true,
            "type": "string"
          },
          {
            "name": "service_type",
            "in": "path",
            "description": "服务类型,针对不同服务,为用户提前填充对应值,用户侧不需单独赋值;二维切割-方形件固定为 regular-plate,二维切割-异形件固定为 irregular-textile, 数学规划求解器固定为 optverse-mpsolver",
            "minLength": 0,
            "maxLength": 512,
            "required": true,
            "type": "string"
          },
          {
            "name": "task_id",
            "in": "path",
            "description": "任务id",
            "minLength": 36,
            "maxLength": 36,
            "required": true,
            "type": "string"
          },
          {
            "name": "input_enable",
            "in": "query",
            "required": false,
            "type": "boolean",
            "description": "是否返回输入信息,默认为false; 当前暂不支持该功能,后续扩展"
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取任务详情",
            "schema": {
              "$ref": "#/definitions/TaskBo"
            },
            "examples": {
              "application/json": {
                "task_id": "string",
                "input_json": {},
                "status": "Succeeded",
                "progress": {},
                "output_json": {},
                "start_time": "2019-08-24T14:15:22Z",
                "end_time": "2019-08-24T14:15:22Z",
                "create_time": "2019-08-24T14:15:22Z"
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "string",
                "error_msg": "string"
              }
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "string",
                "error_msg": "string"
              }
            }
          }
        },
        "x-support-sdk": "Y"
      }
    }
  },
  "definitions": {
    "TaskBo": {
      "type": "object",
      "required": [
        "task_id",
        "status"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务ID"
        },
        "input_json": {
          "type": "object",
          "description": "用户输入"
        },
        "status": {
          "type": "string",
          "description": "状态",
          "enum": [
            "Running",
            "Pending",
            "Expired",
            "Unknown",
            "Failed",
            "Succeeded",
            "Stopped",
            "Deleted"
          ]
        },
        "progress": {
          "type": "object",
          "description": "任务进度"
        },
        "output_json": {
          "type": "object",
          "description": "输出"
        },
        "start_time": {
          "type": "string",
          "format": "date-time",
          "description": "开始时间"
        },
        "end_time": {
          "type": "string",
          "format": "date-time",
          "description": "结束时间"
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间"
        }
      }
    },
    "ErrorRsp": {
      "type": "object",
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述",
          "minLength": 2,
          "maxLength": 512
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。\n用于获取操作API的权限。[获取Token接口](https://support.huaweicloud.com/api-ocr/ocr_03_0005.html)响应消息头中X-Subject-Token的值即为Token。",
      "required": true,
      "type": "string",
      "x-example": "MIINRwYJKoZIhvcNAQcCoIINODCCDTQCAQExDTALBglghkgBZQMEAgEwgguVBgkqhkiG..."
    }
  },
  "host": "optverse.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}