              "type": "integer",
              "format": "int32",
              "example": 1,
              "minimum": 1,
              "maximum": 24,
              "description": "每日执行次数"
            },
            "interval": {
              "type": "integer",
              "format": "int32",
              "example": 1,
              "minimum": 1,
              "maximum": 30,
              "default": 1,
              "description": "daily类型下,间隔多少天,默认值:1"
            },
            "days_of_week": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2
              },
              "minItems": 1,
              "maxItems": 7,
              "example": [
                "MO",
                "TU",
                "WE",
                "TH",
                "FR",
                "SA",
                "SU"
              ],
              "description": "如果type是weekly必选,表示一周内那些天备份 如:[\"MO\", \"TU\", \"WE\", \"TH\", \"FR\", \"SA\", \"SU\"]"
            }
          }
        },
        "remote_backup_enabled": {
          "type": "boolean",
          "description": "是否启用异地复制。"
        },
        "remote_backup_retention": {
          "type": "integer",
          "format": "int32",
          "description": "异地复制副本保留时长。",
          "minimum": 1,
          "maximum": 2147483647
