          "$ref": "#/definitions/PolicyTriggerPropertiesResp"
        }
      },
      "type": "object"
    },
    "BccOrganizationPolicy": {
      "description": "BccOrganizationPolicy",
      "type": "object",
      "properties": {
        "region_id": {
          "type": "string",
          "example": "region-123456",
          "description": "区域ID"
        },
        "detail": {
          "description": "组织策略详情",
          "properties": {
            "id": {
              "type": "string",
              "example": "detail-id-123",
              "description": "策略ID"
            },
            "name": {
              "type": "string",
              "example": "Detail Policy Name",
              "description": "组织策略名称"
            },
            "description": {
              "type": "string",
              "example": "This is a detailed description of the organization policy.",
              "description": "策略描述"
            },
            "operation_type": {
              "type": "string",
              "example": "backup",
              "description": "保护类型:备份(backup)、复制(replication)。"
            },
            "domain_id": {
              "type": "string",
              "example": "domain-123456",
              "description": "账号ID"
            },
            "policy_name": {
              "type": "string",
              "example": "Detailed Policy Name",
              "description": "策略名称"
            },
            "policy_enabled": {
              "type": "boolean",
              "example": true,
              "description": "策略是否开启"
            },
            "policy_operation_definition": {
              "description": "策略定义,备份和复制里面的具体字段各不相同,和策略的保持一致。",
              "properties": {
                "day_backups": {
                  "type": "integer",
                  "format": "int32",
                  "example": 7,
                  "description": "保留日备个数,该备份不受保留最大备份数限制。取值为0到100。"
                },
                "destination_project_id": {
                  "type": "string",
                  "example": "project-123456",
                  "description": "复制的目标项目ID,仅在跨区域复制时才会使用并且必须指定。"
                },
                "destination_region": {
                  "type": "string",
                  "example": "destination-region-123",
                  "description": "复制的目标区域。"
                },
                "enable_acceleration": {
                  "type": "boolean",
                  "example": true,
                  "description": "跨区域复制时,是否启用加速从而缩减复制的时间,如果不指定,默认不启用加速。"
                },
                "max_backups": {
                  "type": "integer",
                  "format": "int32",
                  "example": 30,
                  "description": "单个备份对象自动备份的最大备份数。取值为-1或1-99999。-1代表不按备份数清理。"
                },
                "month_backups": {
                  "type": "integer",
                  "format": "int32",
                  "example": 30,
                  "description": "保留月备个数,该备份不受保留最大备份数限制。取值为0到100。"
                },
                "retention_duration_days": {
                  "type": "integer",
                  "format": "int32",
                  "example": 365,
                  "description": "备份保留时长,单位天。最长支持99999天。-1代表不按时间清理。"
                },
                "timezone": {
                  "type": "string",
                  "example": "UTC",
                  "description": "用户所在时区,格式形如UTC+08:00。"
                },
                "week_backups": {
                  "type": "integer",
                  "format": "int32",
                  "example": 4,
                  "description": "保留周备个数,该备份不受保留最大备份数限制。取值为0到100。"
                },
                "year_backups": {
                  "type": "integer",
                  "format": "int32",
                  "example": 52,
                  "description": "保留年备个数,该备份不受保留最大备份数限制。取值为0到100。"
                },
                "full_backup_interval": {
                  "type": "integer",
                  "format": "int32",
                  "example": 7,
                  "description": "每间隔多少次执行一次全量备份,当取值为 -1 时,不执行全量备份。最小值:-1,最大值:100。"
                }
              }
            },
            "policy_trigger": {
              "$ref": "#/definitions/PolicyTriggerResp"
            },
            "status": {
              "type": "string",
              "example": "active",
              "description": "状态"
            },
            "domain_name": {
              "type": "string",
              "example": "Example Domain",
              "description": "账号名称"
            },
            "effective_scope": {
              "type": "string",
              "description": "组织策略生效范围"
            }
          }
        }
      }
    },
    "PolicyTriggerPropertiesResp": {
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "type": "array",
          "description": "调度规则。限制24条规则。调度器的调度规则,可参照iCalendar RFC 2445规范中的事件规则,但仅支持FREQ、BYDAY、BYHOUR、BYMINUTE、INTERVAL等参数,其中FREQ仅支持WEEKLY和DAILY,BYDAY支持一周七天(MO、TU、WE、TH、FR、SA、SU),BYHOUR支持0-23小时,BYMINUTE支持0-59分钟,并且间隔不能小于一小时,一天最大24个时间点。例如,周一到周天,每天UTC时间的14:00调度,其规则为:'FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR,SA,SU;BYHOUR=14;BYMINUTE=00'。例如:某个地区的时间为 UTC+8,如果在该地区每天14:00调度,则在14点基础上减8,其规则为'FREQ=DAILY;INTERVAL=1;BYHOUR=6;BYMINUTE=00'。",
          "items": {
            "type": "string"
          },
          "x-admin": "False"
        }
      },
      "type": "object"
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    }
  },
