        "resource_type": {
          "type": "string",
          "example": "virtual_machine",
          "description": "资源类型"
        },
        "backup_type": {
          "type": "string",
          "description": "备份类型"
        },
        "local_backup_enabled": {
          "type": "boolean",
          "description": "是否启用本地备份"
        },
        "local_backup_retention": {
          "type": "integer",
          "format": "int32",
          "description": "本地备份副本保留时长"
        },
        "local_backup_frequency": {
          "description": "本地备份频率,如按天 2次/天,按周 周一,三,五每天执行2次",
          "required": [
            "times_per_day"
          ],
          "properties": {
            "type": {
              "type": "string",
              "example": "weekly",
              "description": "备份频率类型,可选daily weekly"
            },
            "times_per_day": {
              "type": "integer",
              "format": "int32",
              "example": 1,
              "minimum": 1,
              "maximum": 24,
              "description": "每日执行次数"
            },
            "interval": {
              "type": "integer",
              "format": "int32",
              "example": 1,
              "minimum": 1,
              "maximum": 30,
              "default": 1,
              "description": "daily类型下,间隔多少天,默认值:1"
            },
            "days_of_week": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "MO",
                "TU",
                "WE",
                "TH",
                "FR",
                "SA",
                "SU"
              ],
              "description": "如果type是weekly必选,表示一周内那些天备份 如:[\"MO\", \"TU\", \"WE\", \"TH\", \"FR\", \"SA\", \"SU\"]"
            }
          }
        },
        "remote_backup_enabled": {
          "type": "boolean",
          "description": "是否启用异地复制。"
        },
        "remote_backup_retention": {
          "type": "integer",
          "format": "int32",
          "description": "异地复制副本保留时长。"
        },
        "local_worm_enabled": {
          "type": "boolean",
          "example": true,
          "description": "本地副本是否启用WORM特性。"
        },
        "remote_worm_enabled": {
          "type": "boolean",
          "example": false,
          "description": "异地复制副本是否启用WORM特性。"
        },
        "is_cross_account_backup_forced": {
          "description": "是否开启强制跨账号备份",
          "type": "boolean",
          "example": false
        },
        "description": {
          "type": "string",
          "description": "规则描述"
        },
        "created": {
          "type": "integer",
          "format": "int64",
          "description": "规则创建时间"
        },
        "updated": {
          "type": "integer",
          "format": "int64",
          "description": "规则更新时间"
