  "definitions": {
    "CreateComplianceRuleResponseBody": {
      "type": "object",
      "description": "创建合规规则的返回body",
      "properties": {
        "compliance_id": {
          "type": "string",
          "description": "合规id"
        }
      }
    },
    "CreateComplianceRuleRequestBody": {
      "type": "object",
      "description": "CreateComplianceRuleRequestBody",
      "properties": {
        "name": {
          "type": "string",
          "description": "合规规则名称",
          "maxLength": 32,
          "pattern": "^[a-zA-Z\\一-\\龥][a-zA-Z0-9_\\-\\一-\\龥]*$",
          "minLength": 2
        },
        "local_backup_enabled": {
          "type": "boolean",
          "description": "是否启用本地备份"
        },
        "local_backup_retention": {
          "type": "integer",
          "format": "int32",
          "minimum": -1,
          "maximum": 99999,
          "description": "本地备份保留时长,取值范围-1-99999"
        },
        "local_backup_frequency": {
          "description": "本地备份频率,如按天 2次/天,按周 周一,三,五每天执行2次",
          "required": [
            "times_per_day"
          ],
          "properties": {
            "type": {
              "type": "string",
              "example": "weekly",
              "description": "备份频率类型,可选daily weekly"
            },
            "times_per_day": {
              "type": "integer",
              "format": "int32",
              "example": 1,
              "minimum": 1,
              "maximum": 24,
              "description": "每日执行次数"
            },
            "interval": {
              "type": "integer",
              "format": "int32",
              "example": 1,
              "default": 1,
              "minimum": 1,
              "maximum": 30,
              "description": "daily类型下,间隔多少天"
            },
            "days_of_week": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "MO",
                "TU",
                "WE",
                "TH",
                "FR",
                "SA",
                "SU"
              ],
              "description": "如果type是weekly必选,表示一周内那些天备份 如:[\"MO\", \"TU\", \"WE\", \"TH\", \"FR\", \"SA\", \"SU\"]"
            }
          }
        },
        "remote_backup_enabled": {
          "type": "boolean",
          "description": "是否启用异地复制。"
        },
        "local_worm_enabled": {
          "type": "boolean",
          "description": "本地副本是否启用WORM特性。"
        },
        "remote_backup_retention": {
          "type": "integer",
          "format": "int32",
          "minimum": -1,
          "maximum": 99999,
          "description": "异地复制副本保留时长。"
        },
        "remote_worm_enabled": {
          "type": "boolean",
          "example": true,
          "description": "异地复制副本是否启用WORM特性。"
        },
        "description": {
          "type": "string",
          "example": "这是一个针对特定应用的备份规则",
          "description": "规则描述",
          "maxLength": 255
        },
        "is_cross_account_backup_forced": {
          "type": "boolean",
          "example": true,
          "description": "是否强制开启跨账号备份。"
        }
      },
      "required": [
        "name",
        "local_backup_enabled",
        "remote_backup_enable"
      ]
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
