          "minItems": 0,
          "maxItems": 8,
          "example": [
            "region-xx-4"
          ]
        },
        "resource_types": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceTypeEnum"
          },
          "description": "参与统计的资源类型列表,不设置表示全部资源类型,默认不设置",
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 9,
          "example": "[Server,Volume]"
        },
        "time_range": {
          "default": 7,
          "example": 7,
          "description": "参与统计的数据范围(生成报告时刻往前多少天内的数据参与统计,滚动计算),默认7天,取值范围:7到30天,详情类数据报告不受此项配置约束",
          "minimum": 7,
          "maximum": 30,
          "type": "integer",
          "format": "int32"
        },
        "report_name_prefix": {
          "type": "string",
          "description": "报告名称的前缀,取值长度为3到128个字符",
          "minLength": 3,
          "maxLength": 128,
          "example": "my-report-"
        }
