  "definitions": {
    "ReportSetting": {
      "type": "object",
      "description": "报告配置请求参数",
      "properties": {
        "setting_name": {
          "type": "string",
          "description": "配置名称,取值长度为2到32个字符",
          "minLength": 2,
          "maxLength": 32,
          "example": "my-setting-name"
        },
        "enabled": {
          "type": "boolean",
          "description": "是否启用,取值范围:true,false",
          "enum": [
            true,
            false
          ],
          "example": true
        },
        "region_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 7,
            "maxLength": 32,
            "pattern": "^[a-z](?:[a-z0-9]|-(?!$)){5,30}[a-z0-9]$"
          },
          "description": "参与统计的资源归属的区域列表,不设置表示全部区域,默认不设置",
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 8,
          "example": [
            "region-xx-4"
          ],
          "default": "[]"
        },
        "resource_types": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceTypeEnum"
          },
          "description": "参与统计的资源类型列表,不设置表示全部资源类型,默认不设置",
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 9,
          "example": "[Server,Volume]",
          "default": "[]"
        },
        "time_range": {
          "default": 7,
          "example": 7,
          "description": "参与统计的数据范围(生成报告时刻往前多少天内的数据参与统计,滚动计算),默认7天,取值范围:7到30天,详情类数据报告不受此项配置约束",
          "minimum": 7,
          "maximum": 30,
          "type": "integer",
          "format": "int32"
        },
        "report_template_name": {
          "type": "string",
          "description": "报告模板名称,例如TEMPLATE.TASK",
          "minLength": 2,
          "maxLength": 32,
          "example": "my-template-name"
        },
        "frequency": {
          "example": 7,
          "description": "生成报告的频率(每隔多少天生成一次报告),默认7天,取值范围7到30天",
          "minimum": 7,
          "maximum": 30,
          "type": "integer",
          "format": "int32"
        },
        "retention_duration": {
          "type": "integer",
          "format": "int32",
          "description": "报告保留天数,默认7天,取值范围7到1095天",
          "default": 7,
          "minimum": 7,
          "maximum": 365,
          "example": 100
        },
        "report_name_prefix": {
          "type": "string",
          "description": "报告名称的前缀,取值长度为2到32个字符",
          "minLength": 2,
          "maxLength": 32,
          "example": "my-report-"
        }
      },
      "required": [
        "setting_name",
        "enabled",
        "time_range",
        "report_template_name",
        "frequency",
        "retention_duration",
        "report_name_prefix"
      ]
    },
    "CreateReportSettingResponseBody": {
      "type": "object",
      "description": "创建报告配置返回响应体Body",
      "required": [
        "setting_id"
      ],
      "properties": {
        "setting_id": {
          "type": "string",
          "description": "配置ID",
          "pattern": "^[0-9a-f]{24}$",
          "minLength": 24,
          "maxLength": 24
        }
      }
    },
    "ResourceTypeEnum": {
      "type": "string",
      "enum": [
        "Server",
        "Volume",
        "Sfs-Turbo",
        "Workspace",
        "MySQL",
        "PostgreSQL",
        "SQLServer",
        "MariaDB",
        "GaussDB"
      ],
      "description": "Server:云服务器\nVolume:云硬盘\nSfs-Turbo:高性能文件系统\nWorkspace:云桌面\nMySQL:云数据库RDS(MySQL)\nPostgreSQL:云数据库RDS(PostgreSQL)\nSQLServer:云数据库RDS(SQLServer)\nMariaDB:云数据库RDS(MariaDB)\nGaussDB:云数据库GaussDB",
      "minLength": 2,
      "maxLength": 16,
      "example": "Server"
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    }
