  "definitions": {
    "CreateBccPolicyResponse": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "description": "策略id"
        }
      }
    },
    "CreateBccPolicyRequestBody": {
      "description": "CreateBccPolicyRequestBody",
      "type": "object",
      "properties": {
        "policy": {
          "description": "policy",
          "properties": {
            "protection_type": {
              "type": "string",
              "description": "protection_type",
              "maxLength": 32,
              "example": "backup",
              "minLength": 2,
              "enum": [
                "backup",
                "disaster_recovery"
              ]
            },
            "enabled": {
              "type": "boolean",
              "description": "enabled",
              "example": true,
              "enum": [
                true,
                false
              ],
              "default": true
            },
            "name": {
              "type": "string",
              "description": "策略名称,取值长度范围[2,64]。",
              "maxLength": 64,
              "minLength": 2
            },
            "region_id": {
              "type": "string",
              "description": "区域ID",
              "minLength": 6,
              "maxLength": 32,
              "pattern": "^[a-z0-9-]{6,32}$"
            },
            "cyber": {
              "type": "boolean",
              "description": "是否启用加密",
              "default": false
            },
            "storage_type": {
              "description": "存储类型,obs,evs,sfs,默认obs",
              "type": "string",
              "maxLength": 16,
              "minLength": 2,
              "enum": [
                "obs",
                "evs",
                "sfs"
              ],
              "default": "obs"
            },
            "policy_type": {
              "type": "string",
              "description": "策略类型,cbr_local_policy,cbr_remote_policy,rds_local_policy,rds_remote_policy",
              "enum": [
                "cbr_local_policy",
                "cbr_remote_policy",
                "rds_local_policy",
                "rds_remote_policy"
              ],
              "maxLength": 64
            },
            "service_type": {
              "type": "string",
              "description": "保护服务类型,如:ecs, evs, rds",
              "maxLength": 64,
              "minLength": 2
            },
            "cbr_policy_detail": {
              "description": "cbr策略详情",
              "properties": {
                "operation_definition": {
                  "description": "operation_definition",
                  "properties": {
                    "day_backups": {
                      "type": "integer",
                      "format": "int32",
                      "example": 100,
                      "description": "保留日备个数,该备份不受保留最大备份数限制。"
                    },
                    "destination_project_id": {
                      "type": "string",
                      "example": "string",
                      "description": "复制的目标项目ID,仅在跨区域复制时才会使用并且必须指定。",
                      "maxLength": 128,
                      "minLength": 2
                    },
                    "destination_region": {
                      "type": "string",
                      "example": "region-xx",
                      "description": "复制的目标区域,长度限制2-32,只能由字母、数字、“_”、“-”组成。",
                      "maxLength": 32,
                      "minLength": 2,
                      "pattern": "^[a-z0-9-]{6,32}$"
                    },
                    "enable_acceleration": {
                      "type": "boolean",
                      "example": true,
                      "description": "跨区域复制时,是否启用加速从而缩减复制的时间,如果不指定,默认不启用加速。"
                    },
                    "max_backups": {
                      "type": "integer",
                      "format": "int32",
                      "example": -1,
                      "description": "单个备份对象自动备份的最大备份数。取值为-1或1-99999。-1代表不按备份数清理。"
                    },
                    "month_backups": {
                      "type": "integer",
                      "format": "int32",
                      "example": 100,
                      "description": "保留月备个数,该备份不受保留最大备份数限制。取值为0到100。"
                    },
                    "retention_duration_days": {
                      "type": "integer",
                      "format": "int32",
                      "example": -1,
                      "description": "备份保留时长,单位天。最长支持99999天。-1代表不按时间清理。"
                    },
                    "timezone": {
                      "type": "string",
                      "example": "string",
                      "description": "用户所在时区,格式形如UTC+08:00"
                    },
                    "week_backups": {
                      "type": "integer",
                      "format": "int32",
                      "minimum": 0,
                      "maximum": 100,
                      "example": 0,
                      "description": "保留周备个数,该备份不受保留最大备份数限制。取值为0到100。"
                    },
                    "year_backups": {
                      "type": "integer",
                      "format": "int32",
                      "minimum": 0,
                      "maximum": 100,
                      "example": 100,
                      "description": "保留年备个数,该备份不受保留最大备份数限制。取值为0到100。"
                    },
                    "full_backup_interval": {
                      "type": "integer",
                      "format": "int32",
                      "minimum": -1,
                      "maximum": 100,
                      "example": 100,
                      "description": "每间隔多少次执行一次全量备份,当取值为 -1 时,不执行全量备份"
                    }
                  }
                },
                "operation_type": {
                  "type": "string",
                  "example": "backup",
                  "description": "保护类型,本地备份backup,异地复制replication",
                  "maxLength": 64,
                  "minLength": 2,
                  "enum": [
                    "backup",
                    "replication"
                  ]
                },
                "trigger": {
                  "description": "调度器属性。",
                  "properties": {
                    "properties": {
                      "description": "保护类型:备份(backup)、复制(replication)。",
                      "properties": {
                        "pattern": {
                          "type": "array",
                          "description": "调度规则。",
                          "maxItems": 128,
                          "items": {
                            "maxLength": 128,
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "pattern"
                      ]
                    }
                  },
                  "required": [
                    "properties"
                  ]
                }
              },
              "required": [
                "operation_definition",
                "operation_type",
                "trigger"
              ]
            }
          },
          "required": [
            "protection_type",
            "enabled",
            "name",
            "region_id",
            "cyber",
            "storage_type",
            "policy_type",
            "service_type",
            "cbr_policy_detail"
          ]
        }
      },
      "required": [
        "policy"
      ]
    },
    "ErrorRsp": {
      "description": "失败时返回的错误对象",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    }
  },
