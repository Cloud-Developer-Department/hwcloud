      "type": "object",
      "description": "查询报告数据响应体",
      "required": [
        "data_item_name",
        "data_length"
      ],
      "properties": {
        "data_item_name": {
          "type": "string",
          "description": "数据项名称,例如task-status-pie"
        },
        "data_length": {
          "type": "integer",
          "format": "int32",
          "description": "数据点个数,例如10"
        },
        "dimension_name": {
          "type": "string",
          "description": "数据维度名称,例如区域、日期、任务类型、资源类型"
        },
        "dimension_data": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "数据维度取值,长度等于data_length,例如[\"success\",\"failed\",\"skipped\"],[\"202401\",\"202402\",\"202403']"
        },
        "value_name": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "数据取值名称,例如[任务数量、任务成功率,资源数量、资源保护率、资源合规率"
        },
        "value_data": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "description": "某个点的数据取值,例如某一天的数据取值"
          },
          "description": "数据取值,和value_name相对应,可以是多组数据,例如[[100,0.98,0.97],[99,0.98.0.99]]"
        }
      }
    },
