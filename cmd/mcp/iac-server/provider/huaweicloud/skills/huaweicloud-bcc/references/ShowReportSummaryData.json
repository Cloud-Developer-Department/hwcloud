        ],
        "parameters": [
          {
            "name": "domain_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "租户ID",
            "pattern": "^[a-z0-9]{16,32}$",
            "minLength": 16,
            "maxLength": 32
          },
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "报告ID",
