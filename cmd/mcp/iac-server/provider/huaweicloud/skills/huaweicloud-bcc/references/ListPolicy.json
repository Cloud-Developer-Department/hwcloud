            },
            "start_time": {
              "type": "string",
              "example": "2025-03-25T03:26:29Z",
              "description": "开始时间start_time"
            },
            "max_backups": {
              "type": "integer",
              "format": "int32",
              "example": -1,
              "description": "最大备份数量max_backups"
            },
            "year_backups": {
              "type": "integer",
              "format": "int32",
              "example": 100,
              "description": "保留年备个数,该备份不受保留最大备份数限制。取值为0到100。"
            },
            "month_backups": {
              "type": "integer",
              "format": "int32",
              "example": 100,
              "description": "保留月备个数,该备份不受保留最大备份数限制。取值为0到100。"
            },
            "cross_account_urn": {
