            },
            "week_backups": {
              "type": "integer",
              "format": "int32",
              "example": 0,
              "description": "保留周备个数,该备份不受保留最大备份数限制。取值为0到100。"
            },
            "pattern": {
              "description": "pattern",
              "type": "string",
              "example": [
                "RRULE:FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR,SA,SU;BYHOUR=14;BYMINUTE=00"
              ]
            },
            "destination_region": {
              "type": "string",
              "example": "null",
              "description": "目标region"
            },
            "retention_duration_days": {
              "type": "integer",
              "format": "int32",
              "example": -1,
              "description": "备份保留时长,单位天。最长支持99999天。-1代表不按时间清理。"
            },
            "enabled": {
              "type": "boolean",
              "example": true,
              "description": "是否启用"
            },
            "day_backups": {
              "type": "integer",
              "format": "int32",
              "example": 0,
              "description": "保留日备个数,该备份不受保留最大备份数限制。取值为0到100。"
            },
            "associate_vaults": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/BccPolicyAssociateVault"
