  "definitions": {
    "ResourceCountsRsp": {
      "type": "object",
      "description": "资源统计",
      "properties": {
        "ep_id": {
          "type": "string",
          "description": "企业项目ID",
          "minLength": 1,
          "maxLength": 64
        },
        "provider": {
          "type": "string",
          "description": "云服务类型",
          "minLength": 1,
          "maxLength": 64
        },
        "region_id": {
          "type": "string",
          "description": "区域ID",
          "minLength": 1,
          "maxLength": 64
        },
        "counts": {
          "type": "array",
          "description": "统计体",
          "items": {
            "$ref": "#/definitions/ResourceCountItem"
          },
          "minItems": 0,
          "maxItems": 100
        }
      }
    },
    "GradedCount": {
      "type": "object",
      "description": "已保护已定级的资源统计",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "总数",
          "minimum": 0,
          "maximum": 2147483647
        },
        "complete_match": {
          "type": "integer",
          "format": "int32",
          "description": "合规资源数",
          "minimum": 0,
          "maximum": 2147483647
        },
        "partial_match": {
          "type": "integer",
          "format": "int32",
          "description": "部分合规资源数",
          "minimum": 0,
          "maximum": 2147483647
        },
        "no_match": {
          "type": "integer",
          "format": "int32",
          "description": "不合规资源数",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "total"
      ]
    },
    "ResourceCountItem": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "日期, 如\"2025-05-19\"。",
          "minLength": 1,
          "maxLength": 64
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "资源总数",
          "minimum": 1,
          "maximum": 2147483647
        },
        "unprotected": {
          "$ref": "#/definitions/ProtectionCount",
          "description": "未保护资源统计"
        },
        "protected": {
          "$ref": "#/definitions/ProtectionCount",
          "description": "已保护资源统计"
        }
      },
      "required": [
        "total"
      ]
    },
    "ProtectionCount": {
      "type": "object",
      "description": "未保护资源统计",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "总数",
          "minimum": 0,
          "maximum": 2147483647
        },
        "ungraded": {
          "type": "integer",
          "format": "int32",
          "description": "未定级资源总数",
          "minimum": 0,
          "maximum": 2147483647
        },
        "graded": {
          "description": "已定级资源总数",
          "$ref": "#/definitions/GradedCount"
        }
      },
      "required": [
        "total"
      ]
    },
