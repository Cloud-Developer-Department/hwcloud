{
  "name": "ShowCertificateAuthority",
  "summary": "查询CA详情",
  "tags": "私有CA管理",
  "productshort": "CCM",
  "region_id": "eu-west-101",
  "paths": {
    "/v1/private-certificate-authorities/{ca_id}": {
      "get": {
        "tags": [
          "私有CA管理"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "summary": "查询CA详情",
        "description": "查询CA详情。",
        "operationId": "ShowCertificateAuthority",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "ca_id",
            "in": "path",
            "description": "CA证书ID。",
            "required": true,
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "x-example": "50608bba-87c2-45f8-9fc7-5723766ced75"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户token,参见:[IAM token获取方法](https://support.huaweicloud.com/api-iam/iam_30_0001.html)。",
            "required": true,
            "type": "string",
            "x-example": "MIIePgYJKoZIhvcNAQcCoIIeLzCCHisCAQExDTALBglghkgBZQMEAgEwghxOBgkqhkiG9w0BBwGgghw..."
          }
        ],
        "x-request-examples-description-1": "查询CA详情,请求头中的**X-Auth-Token**字段需要填写token,且该token需要具有本API的访问权限。",
        "x-request-examples-url-1": "GET https://ccm.cn-north-4.myhuaweicloud.com/v1/private-certificate-authorities/4c0e772e-a30c-4029-b929-b7acb04143f7",
        "responses": {
          "200": {
            "description": "请求已成功",
            "schema": {
              "$ref": "#/definitions/CertificateAuthorities"
            },
            "examples": {
              "application/json": {
                "signature_algorithm": "SHA384",
                "issuer_id": "928bd666-e879-448a-ab54-82f6ae3d81e0",
                "issuer_name": "Huawei IT Root CA",
                "not_after": 1647567892000,
                "not_before": 1645148632000,
                "status": "ACTIVED",
                "freeze_flag": 0,
                "gen_mode": "CSR",
                "serial_number": "202202180143522338893611",
                "distinguished_name": {
                  "country": "CN",
                  "state": "guangdong",
                  "locality": "shenzhen",
                  "organization": "Huawei",
                  "organizational_unit": "IT",
                  "common_name": "Huawei IT Root CA"
                },
                "key_algorithm": "RSA",
                "create_time": 1645148633000,
                "delete_time": null,
                "ca_id": "4c0e772e-a30c-4029-b929-b7acb04143f7",
                "type": "SUBORDINATE",
                "path_length": 0,
                "crl_configuration": {
                  "enabled": false,
                  "obs_bucket_name": null,
                  "valid_days": null,
                  "crl_name": null,
                  "crl_dis_point": null
                }
              }
            }
          },
          "400": {
            "description": "请求参数有误。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "401": {
            "description": "被请求的页面需要鉴权。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "403": {
            "description": "认证失败。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "404": {
            "description": "资源不存在或资源未找到。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "500": {
            "description": "服务内部错误。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "DistinguishedName": {
      "type": "object",
      "required": [
        "common_name",
        "country",
        "state",
        "locality",
        "organization",
        "organizational_unit"
      ],
      "properties": {
        "common_name": {
          "type": "string",
          "description": "证书通用名称(CN),名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、\"*\"、字母、数字、汉字组成,长度不能超过64位字符。",
          "minLength": 1,
          "maxLength": 64
        },
        "country": {
          "type": "string",
          "description": "国家编码,只能由英文组成,长度为2位字符。",
          "minLength": 2,
          "maxLength": 2
        },
        "state": {
          "type": "string",
          "description": "省市名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过128位字符。",
          "minLength": 1,
          "maxLength": 128
        },
        "locality": {
          "type": "string",
          "description": "地区名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过128位字符。",
          "minLength": 1,
          "maxLength": 128
        },
        "organization": {
          "type": "string",
          "description": "组织名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过64位字符。",
          "minLength": 1,
          "maxLength": 64
        },
        "organizational_unit": {
          "type": "string",
          "description": "组织单元名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过64位字符。",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "title": "DistinguishedName"
    },
    "Error": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码。"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息。"
        }
      },
      "title": "Error"
    },
    "ListCrlConfiguration": {
      "type": "object",
      "required": [
        "enabled",
        "crl_name",
        "obs_bucket_name",
        "valid_days",
        "crl_dis_point"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "是否启用CRL发布功能。\n- **true**\n- **false**"
        },
        "crl_name": {
          "type": "string",
          "description": "吊销列表文件名称。\n> 若用户不指定,系统将默认采用当前证书的父CA ID。"
        },
        "obs_bucket_name": {
          "type": "string",
          "description": "OBS桶名称。"
        },
        "valid_days": {
          "type": "integer",
          "format": "int32",
          "minimum": 7,
          "maximum": 30,
          "description": "CRL更新周期,单位为\"天\"。当启用CRL发布功能,为必填项。"
        },
        "crl_dis_point": {
          "type": "string",
          "description": "吊销列表分发地址,即对应的OBS桶中的CRL文件地址。\n> 本参数由程序根据crl_name、obs_bucket_name以及OBS地址进行拼接而成。"
        }
      },
      "title": "ListCrlConfiguration"
    },
    "CertificateAuthorities": {
      "type": "object",
      "required": [
        "ca_id",
        "type",
        "status",
        "path_length",
        "issuer_id",
        "issuer_name",
        "key_algorithm",
        "signature_algorithm",
        "freeze_flag",
        "gen_mode",
        "serial_number",
        "create_time",
        "delete_time",
        "not_before",
        "not_after",
        "distinguished_name",
        "crl_configuration"
      ],
      "properties": {
        "ca_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "CA证书ID。"
        },
        "type": {
          "type": "string",
          "description": "CA类型:\n  - **ROOT**: 根CA\n  - **SUBORDINATE**: 从属CA"
        },
        "status": {
          "type": "string",
          "description": "CA证书状态:\n  - **PENDING** : 待激活,此状态下,不可用于签发证书;\n  - **ACTIVED** : 已激活,此状态下,可用于签发证书;\n  - **DISABLED** : 已禁用,此状态下,不可用于签发证书;\n  - **DELETED** : 计划删除,此状态下,不可用于签发证书;\n  - **EXPIRED** : 已过期,此状态下,不可用于签发证书。"
        },
        "path_length": {
          "type": "integer",
          "description": "CA路径长度。\n> 注:生成的根CA证书,其路径长度不做限制,但本字段在数据库中统一置为7。从属CA的路径长度在创建时由用户指定,缺省值为0。",
          "format": "int32",
          "minimum": 0,
          "maximum": 6
        },
        "issuer_id": {
          "type": "string",
          "description": "父CA证书ID,即签发此证书的CA证书ID。根CA中,此参数为**null**。",
          "minLength": 36,
          "maxLength": 36
        },
        "issuer_name": {
          "type": "string",
          "description": "父CA证书名称。根CA中,此参数为**null**。",
          "minLength": 1,
          "maxLength": 64
        },
        "key_algorithm": {
          "type": "string",
          "description": "密钥算法。"
        },
        "signature_algorithm": {
          "type": "string",
          "description": "签名哈希算法。"
        },
        "freeze_flag": {
          "type": "integer",
          "description": "冻结标识:\n  - **0** : 非冻结状态;\n  - **其它值** : 冻结状态,当前预留。",
          "format": "int32"
        },
        "gen_mode": {
          "type": "string",
          "description": "证书生成方式:\n - **GENERATE** : PCA系统生成;\n - **IMPORT** : 外部导入;\n - **CSR** : 外部提供CSR,内部CA进行签发,即私钥不在PCA进行托管。"
        },
        "serial_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "证书序列号。"
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "description": "证书创建时间,格式为时间戳(毫秒级)。"
        },
        "delete_time": {
          "type": "integer",
          "format": "int64",
          "description": "证书删除时间,格式为时间戳(毫秒级)。"
        },
        "not_before": {
          "type": "integer",
          "format": "int64",
          "description": "证书创建时间,格式为时间戳(毫秒级)。"
        },
        "not_after": {
          "type": "integer",
          "format": "int64",
          "description": "证书到期时间,格式为时间戳(毫秒级)。"
        },
        "distinguished_name": {
          "description": "证书名称配置,详情请参见**DistinguishedName**字段数据结构说明。",
          "$ref": "#/definitions/DistinguishedName"
        },
        "crl_configuration": {
          "description": "证书CRL配置,详情请参见**ListCrlConfiguration**字段数据结构说明。",
          "$ref": "#/definitions/ListCrlConfiguration"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID,默认为“0”。 对于开通企业项目的用户,表示资源处于默认企业项目下。 对于未开通企业项目的用户,表示资源未处于企业项目下。"
        },
        "free_quota": {
          "type": "integer",
          "description": "免费证书配额。",
          "format": "int32"
        },
        "charging_mode": {
          "type": "integer",
          "description": "计费模式:\n  - **0** : 包周期;\n  - **1** : 按需。",
          "format": "int32"
        },
        "cluster_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "dhsm集群id。"
        },
        "domain_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "账号ID。"
        }
      },
      "title": "CertificateAuthorities"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ccm.eu-west-101.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}