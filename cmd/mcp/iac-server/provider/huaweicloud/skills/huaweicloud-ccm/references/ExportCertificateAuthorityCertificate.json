  "definitions": {
    "Error": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码。"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息。"
        }
      },
      "title": "Error"
    },
    "ExportCertificateAuthorityCertificateResponseBody": {
      "required": [
        "certificate",
        "certificate_chain"
      ],
      "properties": {
        "certificate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "证书内容。\n >  - 通过API请求本接口,证书内容中换行符已使用\"\\r\\n\"代替;\n >  - 通过console端导出证书,将得到标准的PEM格式的证书文件。"
        },
        "certificate_chain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2097152,
          "description": "证书链内容,证书链中排列顺序(从上至下):中间证书>...>根证书。\n>  - 通过API请求本接口,证书链内容中换行符已使用\"\\r\\n\"代替;\n>  - 通过console端导出证书链,将得到标准的PEM格式的证书链文件。"
        }
      },
      "title": "ExportCertificateAuthorityCertificateResponseBody"
    }
