{
  "name": "ListCertificateAuthority",
  "summary": "查询CA列表",
  "tags": "私有CA管理",
  "productshort": "CCM",
  "region_id": "sa-brazil-1",
  "paths": {
    "/v1/private-certificate-authorities": {
      "get": {
        "tags": [
          "私有CA管理"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "summary": "查询CA列表",
        "description": "查询CA列表。",
        "operationId": "ListCertificateAuthority",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "指定查询返回记录条数,默认值10。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 1000,
            "x-example": 10
          },
          {
            "name": "name",
            "in": "query",
            "description": "CA证书名称(CN)过滤值,用于获取名称中带有特定值的CA证书集合。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "test"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "索引位置,从offset指定的下一条数据开始查询。默认值为0。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "x-example": 0
          },
          {
            "name": "status",
            "in": "query",
            "description": "CA证书状态,通过状态过滤证书集合:\n- **PENDING** : 待激活,此状态下,不可用于签发证书;\n- **ACTIVED** : 已激活,此状态下,可用于签发证书;\n- **DISABLED** : 已禁用,此状态下,不可用于签发证书;\n- **DELETED** : 计划删除,此状态下,不可用于签发证书;\n- **EXPIRED** : 已过期,此状态下,不可用于签发证书。",
            "required": false,
            "type": "string",
            "x-example": "PENDING"
          },
          {
            "name": "type",
            "in": "query",
            "description": "CA证书类型:\n- **ROOT** : 根CA证书\n- **SUBORDINATE** : 从属CA证书",
            "required": false,
            "type": "string",
            "x-example": "ROOT"
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序属性,目前支持以下属性:\n- **create_time** : 证书创建时间(默认)\n- **common_name** : 证书名称\n- **type** : CA证书类型\n- **not_after** : 证书到期时间",
            "required": false,
            "type": "string",
            "x-example": "common_name"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序方向,支持以下值:\n- **DESC** : 降序(默认)\n- **ASC** : 升序",
            "required": false,
            "type": "string",
            "x-example": "ASC"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户token,参见:[IAM token获取方法](https://support.huaweicloud.com/api-iam/iam_30_0001.html)。",
            "required": true,
            "type": "string",
            "x-example": "MIIePgYJKoZIhvcNAQcCoIIeLzCCHisCAQExDTALBglghkgBZQMEAgEwghxOBgkqhkiG9w0BBwGgghw..."
          }
        ],
        "x-request-examples-description-1": "查询CA证书列表,请求头中的**X-Auth-Token**字段需要填写token,且该token需要具有本API的访问权限。",
        "x-request-examples-url-1": "GET https://ccm.cn-north-4.myhuaweicloud.com/v1/private-certificate-authorities",
        "responses": {
          "200": {
            "description": "请求已成功",
            "schema": {
              "$ref": "#/definitions/ListCertificateAuthorityResponseBody"
            },
            "examples": {
              "application/json": {
                "total": 2,
                "certificate_authorities": [
                  {
                    "signature_algorithm": "SHA384",
                    "issuer_id": null,
                    "issuer_name": null,
                    "not_after": 1678159435000,
                    "not_before": 1646623375000,
                    "status": "ACTIVED",
                    "freeze_flag": 0,
                    "gen_mode": "GENERATE",
                    "serial_number": "202203070322544291829058",
                    "distinguished_name": {
                      "country": "cn",
                      "state": "shanghai",
                      "locality": "shanghai",
                      "organization": "shanghai",
                      "organizational_unit": "shanghai",
                      "common_name": "CSR_123"
                    },
                    "key_algorithm": "EC384",
                    "create_time": 1646623375000,
                    "delete_time": null,
                    "ca_id": "a6bbf0be-79f3-4f66-858a-0fdcb96dfcbe",
                    "type": "ROOT",
                    "path_length": 7,
                    "crl_configuration": {
                      "enabled": false,
                      "obs_bucket_name": null,
                      "valid_days": null,
                      "crl_name": null,
                      "crl_dis_point": null
                    }
                  },
                  {
                    "signature_algorithm": "SHA256",
                    "issuer_id": null,
                    "issuer_name": null,
                    "not_after": 1727492412000,
                    "not_before": 1632797952000,
                    "status": "ACTIVED",
                    "freeze_flag": 0,
                    "gen_mode": "GENERATE",
                    "serial_number": "202109280259122080649087",
                    "distinguished_name": {
                      "country": "CN",
                      "state": "Sichuan",
                      "locality": "Chengdu",
                      "organization": "Huawei",
                      "organizational_unit": "CloudBU",
                      "common_name": "pca-ca"
                    },
                    "key_algorithm": "RSA2048",
                    "create_time": 1632797953000,
                    "delete_time": null,
                    "ca_id": "fb7bd6a6-6a11-4a58-8710-a3c0a620aedc",
                    "type": "ROOT",
                    "path_length": 7,
                    "crl_configuration": {
                      "enabled": false,
                      "obs_bucket_name": null,
                      "valid_days": null,
                      "crl_name": null,
                      "crl_dis_point": null
                    }
                  }
                ]
              }
            }
          },
          "400": {
            "description": "请求参数有误。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "401": {
            "description": "被请求的页面需要鉴权。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "403": {
            "description": "认证失败。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "404": {
            "description": "资源不存在或资源未找到。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "500": {
            "description": "服务内部错误。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "definitions": {
    "DistinguishedName": {
      "type": "object",
      "required": [
        "common_name",
        "country",
        "state",
        "locality",
        "organization",
        "organizational_unit"
      ],
      "properties": {
        "common_name": {
          "type": "string",
          "description": "证书通用名称(CN),名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、\"*\"、字母、数字、汉字组成,长度不能超过64位字符。",
          "minLength": 1,
          "maxLength": 64
        },
        "country": {
          "type": "string",
          "description": "国家编码,只能由英文组成,长度为2位字符。",
          "minLength": 2,
          "maxLength": 2
        },
        "state": {
          "type": "string",
          "description": "省市名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过128位字符。",
          "minLength": 1,
          "maxLength": 128
        },
        "locality": {
          "type": "string",
          "description": "地区名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过128位字符。",
          "minLength": 1,
          "maxLength": 128
        },
        "organization": {
          "type": "string",
          "description": "组织名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过64位字符。",
          "minLength": 1,
          "maxLength": 64
        },
        "organizational_unit": {
          "type": "string",
          "description": "组织单元名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过64位字符。",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "title": "DistinguishedName"
    },
    "Error": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码。"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息。"
        }
      },
      "title": "Error"
    },
    "ListCertificateAuthorityResponseBody": {
      "type": "object",
      "required": [
        "total",
        "certificate_authorities"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "description": "CA证书总数。",
          "format": "int32"
        },
        "certificate_authorities": {
          "type": "array",
          "minItems": 0,
          "description": "CA列表,详情请参见**CertificateAuthorities**字段数据结构说明。",
          "items": {
            "$ref": "#/definitions/CertificateAuthorities"
          }
        }
      },
      "title": "ListCertificateAuthorityResponseBody"
    },
    "ListCrlConfiguration": {
      "type": "object",
      "required": [
        "enabled",
        "crl_name",
        "obs_bucket_name",
        "valid_days",
        "crl_dis_point"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "是否启用CRL发布功能。\n- **true**\n- **false**"
        },
        "crl_name": {
          "type": "string",
          "description": "吊销列表文件名称。\n> 若用户不指定,系统将默认采用当前证书的父CA ID。"
        },
        "obs_bucket_name": {
          "type": "string",
          "description": "OBS桶名称。"
        },
        "valid_days": {
          "type": "integer",
          "format": "int32",
          "minimum": 7,
          "maximum": 30,
          "description": "CRL更新周期,单位为\"天\"。当启用CRL发布功能,为必填项。"
        },
        "crl_dis_point": {
          "type": "string",
          "description": "吊销列表分发地址,即对应的OBS桶中的CRL文件地址。\n> 本参数由程序根据crl_name、obs_bucket_name以及OBS地址进行拼接而成。"
        }
      },
      "title": "ListCrlConfiguration"
    },
    "CertificateAuthorities": {
      "type": "object",
      "required": [
        "ca_id",
        "type",
        "status",
        "path_length",
        "issuer_id",
        "issuer_name",
        "key_algorithm",
        "signature_algorithm",
        "freeze_flag",
        "gen_mode",
        "serial_number",
        "create_time",
        "delete_time",
        "not_before",
        "not_after",
        "distinguished_name",
        "crl_configuration"
      ],
      "properties": {
        "ca_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "CA证书ID。"
        },
        "type": {
          "type": "string",
          "description": "CA类型:\n  - **ROOT**: 根CA\n  - **SUBORDINATE**: 从属CA"
        },
        "status": {
          "type": "string",
          "description": "CA证书状态:\n  - **PENDING** : 待激活,此状态下,不可用于签发证书;\n  - **ACTIVED** : 已激活,此状态下,可用于签发证书;\n  - **DISABLED** : 已禁用,此状态下,不可用于签发证书;\n  - **DELETED** : 计划删除,此状态下,不可用于签发证书;\n  - **EXPIRED** : 已过期,此状态下,不可用于签发证书。"
        },
        "path_length": {
          "type": "integer",
          "description": "CA路径长度。\n> 注:生成的根CA证书,其路径长度不做限制,但本字段在数据库中统一置为7。从属CA的路径长度在创建时由用户指定,缺省值为0。",
          "format": "int32",
          "minimum": 0,
          "maximum": 6
        },
        "issuer_id": {
          "type": "string",
          "description": "父CA证书ID,即签发此证书的CA证书ID。根CA中,此参数为**null**。",
          "minLength": 36,
          "maxLength": 36
        },
        "issuer_name": {
          "type": "string",
          "description": "父CA证书名称。根CA中,此参数为**null**。",
          "minLength": 1,
          "maxLength": 64
        },
        "key_algorithm": {
          "type": "string",
          "description": "密钥算法。"
        },
        "signature_algorithm": {
          "type": "string",
          "description": "签名哈希算法。"
        },
        "freeze_flag": {
          "type": "integer",
          "description": "冻结标识:\n  - **0** : 非冻结状态;\n  - **其它值** : 冻结状态,当前预留。",
          "format": "int32"
        },
        "gen_mode": {
          "type": "string",
          "description": "证书生成方式:\n - **GENERATE** : PCA系统生成;\n - **IMPORT** : 外部导入;\n - **CSR** : 外部提供CSR,内部CA进行签发,即私钥不在PCA进行托管。"
        },
        "serial_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "证书序列号。"
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "description": "证书创建时间,格式为时间戳(毫秒级)。"
        },
        "delete_time": {
          "type": "integer",
          "format": "int64",
          "description": "证书删除时间,格式为时间戳(毫秒级)。"
        },
        "not_before": {
          "type": "integer",
          "format": "int64",
          "description": "证书创建时间,格式为时间戳(毫秒级)。"
        },
        "not_after": {
          "type": "integer",
          "format": "int64",
          "description": "证书到期时间,格式为时间戳(毫秒级)。"
        },
        "distinguished_name": {
          "description": "证书名称配置,详情请参见**DistinguishedName**字段数据结构说明。",
          "$ref": "#/definitions/DistinguishedName"
        },
        "crl_configuration": {
          "description": "证书CRL配置,详情请参见**ListCrlConfiguration**字段数据结构说明。",
          "$ref": "#/definitions/ListCrlConfiguration"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID,默认为“0”。 对于开通企业项目的用户,表示资源处于默认企业项目下。 对于未开通企业项目的用户,表示资源未处于企业项目下。"
        },
        "free_quota": {
          "type": "integer",
          "description": "免费证书配额。",
          "format": "int32"
        },
        "charging_mode": {
          "type": "integer",
          "description": "计费模式:\n  - **0** : 包周期;\n  - **1** : 按需。",
          "format": "int32"
        },
        "cluster_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "dhsm集群id。"
        },
        "domain_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "账号ID。"
        }
      },
      "title": "CertificateAuthorities"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ccm.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}