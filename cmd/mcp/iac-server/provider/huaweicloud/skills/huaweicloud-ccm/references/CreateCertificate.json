{
  "name": "CreateCertificate",
  "summary": "申请证书",
  "tags": "私有证书管理",
  "productshort": "CCM",
  "region_id": "eu-west-101",
  "paths": {
    "/v1/private-certificates": {
      "post": {
        "tags": [
          "私有证书管理"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "summary": "申请证书",
        "description": "申请证书。",
        "operationId": "CreateCertificate",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户token,参见:[IAM token获取方法](https://support.huaweicloud.com/api-iam/iam_30_0001.html)。",
            "required": true,
            "type": "string",
            "x-example": "MIIePgYJKoZIhvcNAQcCoIIeLzCCHisCAQExDTALBglghkgBZQMEAgEwghxOBgkqhkiG9w0BBwGgghw..."
          },
          {
            "in": "body",
            "name": "CreateCertificateRequestBody",
            "description": "CreateCertificateRequestBody",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateCertificateRequestBody"
            }
          }
        ],
        "x-request-examples-description-1": "申请证书,请求头中的**X-Auth-Token**字段需要填写token,且该token需要具有本API的访问权限。",
        "x-request-examples-url-1": "POST https://ccm.cn-north-4.myhuaweicloud.com/v1/private-certificates",
        "responses": {
          "200": {
            "description": "请求已成功",
            "schema": {
              "$ref": "#/definitions/CreateCertificateResponseBody"
            },
            "examples": {
              "application/json": {
                "certificate_id": "ae9a326a-b61e-4446-854d-cda30ffe31f5"
              }
            }
          },
          "400": {
            "description": "请求参数有误。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "401": {
            "description": "被请求的页面需要鉴权。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "403": {
            "description": "认证失败。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "404": {
            "description": "资源不存在或资源未找到。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "500": {
            "description": "服务内部错误。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "PCA.XXX",
                "error_msg": "XXX"
              }
            }
          }
        },
        "deprecated": false,
        "x-request-examples-1": {
          "key_algorithm": "RSA2048",
          "distinguished_name": {
            "country": "CN",
            "state": "Sichuan",
            "locality": "Chengdu",
            "organization": "Huawei",
            "organizational_unit": "CloudBU",
            "common_name": "TestCert"
          },
          "subject_alternative_names": [
            {
              "type": "IP",
              "value": "156.127.116.38"
            }
          ],
          "signature_algorithm": "SHA256",
          "validity": {
            "type": "YEAR",
            "value": 3
          },
          "issuer_id": "2cb2878b-6cd1-460d-bd25-afe655159bdc",
          "key_usages": [
            "digitalSignature",
            "nonRepudiation"
          ]
        }
      }
    }
  },
  "definitions": {
    "SubjectAlternativeName": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "备用名称类型,当前仅支持DNS、IP、EMAIL、URI。\n- **DNS**\n- **IP**\n- **EMAIL**\n- **URI**"
        },
        "value": {
          "type": "string",
          "description": "对应备用名称类型的值。\n  - DNS类型,长度为不超过253;\n  - IP类型,长度不超过39,支持IPV4、IPV6;\n  - EMAIL类型,长度不超过256;\n  - URI类型,长度不超过253。"
        }
      },
      "title": "SubjectAlternativeName"
    },
    "Error": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码。"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息。"
        }
      },
      "title": "Error"
    },
    "CreateCertificateResponseBody": {
      "required": [
        "certificate_id"
      ],
      "properties": {
        "certificate_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "当前签发的证书ID。"
        }
      },
      "title": "CreateCertificateResponseBody"
    },
    "CustomizedExtension": {
      "type": "object",
      "properties": {
        "object_identifier": {
          "type": "string",
          "description": "对象标识符。\n> 本参数需要满足ASN1规范的点分十进制符号格式的字符串,如1.3.6.1.4.1.2011.4.99。",
          "minLength": 1,
          "maxLength": 64
        },
        "value": {
          "type": "string",
          "description": "自定义属性内容。",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "title": "CustomizedExtension"
    },
    "Validity": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "有效期类型,为必填值:\n  - **YEAR** : 年(12个月)\n  - **MONTH** : 月(统一按31天)\n  - **DAY** : 日\n  - **HOUR** : 小时"
        },
        "value": {
          "type": "integer",
          "format": "int32",
          "description": "证书有效期值,与type对应的类型值,换算成年需满足以下规则:\n  - 根CA,有效期小于等于30年;\n  - 从属CA与私有证书,有效期小于等于20年。"
        },
        "start_from": {
          "type": "integer",
          "format": "int32",
          "description": "起始时间,为可选值:\n  - 格式为时间戳(毫秒级),如1645146939688代表2022-02-18 09:15:39;\n  - 不早于当前时间5分钟,即start_from > (current_time - 5min)。"
        }
      },
      "title": "Validity"
    },
    "CreateCertificateRequestBody": {
      "type": "object",
      "required": [
        "issuer_id",
        "validity",
        "distinguished_name"
      ],
      "properties": {
        "issuer_id": {
          "type": "string",
          "description": "父CA证书ID。",
          "minLength": 36,
          "maxLength": 36
        },
        "key_algorithm": {
          "type": "string",
          "description": "密钥算法,可选值如下:\n  - **RSA2048** : RSA算法,密钥长度2048位;\n  - **RSA4096** : RSA算法,密钥长度4096位;\n  - **EC256** : 椭圆曲线算法(Elliptic Curve Digital Signature Algorithm (ECDSA)),密钥长度256位;\n  - **EC384** : 椭圆曲线算法(Elliptic Curve Digital Signature Algorithm (ECDSA)),密钥长度384位;\n  - **SM2** : 国家密码管理局颁发的椭圆曲线算法(签名哈希算法SM3),密钥长度256位。(中国站)"
        },
        "signature_algorithm": {
          "type": "string",
          "description": "签名哈希算法,可选值如下:\n  - **SHA256**\n  - **SHA384**\n  - **SHA512**\n  - **SM3**(中国站)"
        },
        "distinguished_name": {
          "description": "证书名称配置,详情请参见**CertDistinguishedName**字段数据结构说明。",
          "$ref": "#/definitions/CertDistinguishedName"
        },
        "validity": {
          "description": "证书有效期,详情请参见**Validity**字段数据结构说明。",
          "$ref": "#/definitions/Validity"
        },
        "key_usages": {
          "type": "array",
          "description": "密钥用法,具体标准参见RFC 5280中:[4.2.1.3节](https://datatracker.ietf.org/doc/html/rfc5280#section-4.2.1.3)。\n  - **digitalSignature** : 数字签名;\n  - **nonRepudiation** : 不可抵赖;\n  - **keyEncipherment** : 密钥用于加密密钥数据;\n  - **dataEncipherment** : 用于加密数据;\n  - **keyAgreement** : 密钥协商;\n  - **keyCertSign** : 签发证书;\n  - **cRLSign** : 签发吊销列表;\n  - **encipherOnly** : 仅用于加密;\n  - **decipherOnly** : 仅用于解密。",
          "items": {
            "type": "string"
          }
        },
        "subject_alternative_names": {
          "type": "array",
          "description": "主体备用名称,详情请参见**SubjectAlternativeName**字段数据结构说明。\n  - array大小:[0,20]。",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/SubjectAlternativeName"
          }
        },
        "extended_key_usage": {
          "description": "增强型密钥用法,详情请参见**ExtendedKeyUsage**字段数据结构说明。",
          "$ref": "#/definitions/ExtendedKeyUsage"
        },
        "customized_extension": {
          "description": "自定义扩展信息,详情请参见**CustomizedExtension**字段数据结构说明。",
          "$ref": "#/definitions/CustomizedExtension"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业多项目ID。用户未开通企业多项目时,不需要输入该字段。 用户开通企业多项目时,查询资源可以输入该字段。 若用户不输入该字段,默认查询租户所有有权限的企业多项目下的资源。 此时“enterprise_project_id”取值为“all”。 若用户输入该字段,取值满足以下任一条件.\n  取值为“all”\n  取值为“0”\n  满足正则匹配:“^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$”"
        }
      },
      "title": "CreateCertificateRequestBody"
    },
    "CertDistinguishedName": {
      "type": "object",
      "required": [
        "common_name"
      ],
      "properties": {
        "common_name": {
          "type": "string",
          "description": "证书通用名称(CN),名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、\"*\"、字母、数字、汉字组成,长度不能超过64位字符。",
          "minLength": 1,
          "maxLength": 64
        },
        "country": {
          "type": "string",
          "description": "国家编码,只能由英文组成,长度为2位字符。若不传入,则默认继承父CA对应的值。",
          "minLength": 2,
          "maxLength": 2
        },
        "state": {
          "type": "string",
          "description": "省市名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过128位字符。若不传入,则默认继承父CA对应的值。",
          "minLength": 1,
          "maxLength": 128
        },
        "locality": {
          "type": "string",
          "description": "地区名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过128位字符。若不传入,则默认继承父CA对应的值。",
          "minLength": 1,
          "maxLength": 128
        },
        "organization": {
          "type": "string",
          "description": "组织名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过64位字符。若不传入,则默认继承父CA对应的值。",
          "minLength": 1,
          "maxLength": 64
        },
        "organizational_unit": {
          "type": "string",
          "description": "组织单元名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过64位字符。若不传入,则默认继承父CA对应的值。",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "title": "CertDistinguishedName"
    },
    "ExtendedKeyUsage": {
      "type": "object",
      "properties": {
        "server_auth": {
          "type": "boolean",
          "default": false,
          "description": "服务器身份验证,OID为:1.3.6.1.5.5.7.3.1。\n- **true**\n- **false**\n> 服务器证书请启用本增强型密钥用法,默认为false。"
        },
        "client_auth": {
          "type": "boolean",
          "default": false,
          "description": "客户端身份验证,OID为:1.3.6.1.5.5.7.3.2。\n- **true**\n- **false**\n> 客户端证书请启用本增强型密钥用法,默认为false。"
        },
        "code_signing": {
          "type": "boolean",
          "default": false,
          "description": "代码签名,OID为:1.3.6.1.5.5.7.3.3。\n- **true**\n- **false**\n> 签署可下载的可执行代码客户端认证,默认为false。"
        },
        "email_protection": {
          "type": "boolean",
          "default": false,
          "description": "安全电子邮件,OID为:1.3.6.1.5.5.7.3.4。\n- **true**\n- **false**\n> 电子邮件保护,默认为false。"
        },
        "time_stamping": {
          "type": "boolean",
          "default": false,
          "description": "时间戳,OID为:1.3.6.1.5.5.7.3.8。\n- **true**\n- **false**\n> 将一个对象的哈希绑定到一个时间,默认为false。"
        },
        "smart_card_logon": {
          "type": "boolean",
          "default": false,
          "description": "智能卡登录,OID为:1.3.6.1.4.1.311.20.2.2。\n- **true**\n- **false**\n> Active Directory登录,默认为false。"
        }
      },
      "title": "ExtendedKeyUsage"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ccm.eu-west-101.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
