  "definitions": {
    "DistinguishedName": {
      "type": "object",
      "required": [
        "common_name",
        "country",
        "state",
        "locality",
        "organization",
        "organizational_unit"
      ],
      "properties": {
        "common_name": {
          "type": "string",
          "description": "证书通用名称(CN),名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、\"*\"、字母、数字、汉字组成,长度不能超过64位字符。",
          "minLength": 1,
          "maxLength": 64
        },
        "country": {
          "type": "string",
          "description": "国家编码,只能由英文组成,长度为2位字符。",
          "minLength": 2,
          "maxLength": 2
        },
        "state": {
          "type": "string",
          "description": "省市名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过128位字符。",
          "minLength": 1,
          "maxLength": 128
        },
        "locality": {
          "type": "string",
          "description": "地区名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过128位字符。",
          "minLength": 1,
          "maxLength": 128
        },
        "organization": {
          "type": "string",
          "description": "组织名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过64位字符。",
          "minLength": 1,
          "maxLength": 64
        },
        "organizational_unit": {
          "type": "string",
          "description": "组织单元名称,名称只能由\"-\"、\"_\"、\" \"、\".\"、\",\"、字母、数字、汉字组成,长度不能超过64位字符。",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "title": "DistinguishedName"
    },
    "Certificates": {
      "type": "object",
      "required": [
        "certificate_id",
        "status",
        "issuer_id",
        "issuer_name",
        "key_algorithm",
        "signature_algorithm",
        "freeze_flag",
        "gen_mode",
        "serial_number",
        "create_time",
        "delete_time",
        "not_before",
        "not_after",
        "distinguished_name"
      ],
      "properties": {
        "certificate_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "私有证书ID。"
        },
        "status": {
          "type": "string",
          "description": "证书状态:\n  - **ISSUED** : 已签发;\n  - **EXPIRED** : 已过期;\n  - **REVOKED** : 已吊销。"
        },
        "issuer_id": {
          "type": "string",
          "description": "父CA证书ID。",
          "minLength": 36,
          "maxLength": 36
        },
        "issuer_name": {
          "type": "string",
          "description": "父CA证书名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "key_algorithm": {
          "type": "string",
          "description": "密钥算法。"
        },
        "signature_algorithm": {
          "type": "string",
          "description": "签名算法。"
        },
        "freeze_flag": {
          "type": "integer",
          "description": "冻结标识:\n  - **0** : 非冻结状态;\n  - **其它值** : 冻结状态,当前预留。",
          "format": "int32"
        },
        "gen_mode": {
          "type": "string",
          "description": "证书生成方式:\n - **GENERATE** : PCA系统生成;\n - **IMPORT** : 外部导入;\n - **CSR** : 外部提供CSR,内部CA进行签发,即私钥不在PCA进行托管。"
        },
        "serial_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "序列号。"
        },
        "create_time": {
          "type": "integer",
          "format": "int64",
          "description": "证书创建时间,格式为时间戳(毫秒级)。"
        },
        "delete_time": {
          "type": "integer",
          "format": "int64",
          "description": "证书删除时间,格式为时间戳(毫秒级)。"
        },
        "not_before": {
          "type": "integer",
          "format": "int64",
          "description": "证书创建时间,格式为时间戳(毫秒级)。"
        },
        "not_after": {
          "type": "integer",
          "format": "int64",
          "description": "证书到期时间,格式为时间戳(毫秒级)。"
        },
        "distinguished_name": {
          "$ref": "#/definitions/DistinguishedName",
          "description": "证书名称配置,详情请参见**DistinguishedName**字段数据结构说明。"
        },
        "enc_cert_info": {
          "$ref": "#/definitions/EncCertInfo",
          "description": "加密证书信息,详情请参见**EncCertInfo**字段数据结构说明。"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID,默认为“0”。 对于开通企业项目的用户,表示资源处于默认企业项目下。 对于未开通企业项目的用户,表示资源未处于企业项目下。"
        }
      },
      "title": "Certificates"
    },
    "Error": {
      "type": "object",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码。"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息。"
        }
      },
      "title": "Error"
    },
    "EncCertInfo": {
      "type": "object",
      "required": [
        "enc_serial_number"
      ],
      "properties": {
        "enc_serial_number": {
          "type": "string",
          "description": "加密证书序列号。",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "title": "EncCertInfo"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "ccm.ru-moscow-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
