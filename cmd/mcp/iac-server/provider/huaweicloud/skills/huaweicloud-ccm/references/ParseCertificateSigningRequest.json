      },
      "title": "Error"
    },
    "ParseCsrResponseBody": {
      "type": "object",
      "required": [
        "key_algorithm",
        "key_algorithm_length",
        "signature_algorithm",
        "public_key",
        "distinguished_name"
      ],
      "properties": {
        "key_algorithm": {
          "type": "string",
          "description": "密钥算法。"
        },
        "key_algorithm_length": {
          "type": "integer",
          "description": "密钥算法长度,单位为bit。",
          "format": "int32"
        },
        "signature_algorithm": {
          "type": "string",
          "description": "签名算法,带具体的签名与哈希算法,如\"SHA256withRSA\"。"
        },
        "public_key": {
          "type": "string",
          "description": "公钥内容。\n> 其中,换行符已被“\\r\\n”替代;",
          "minLength": 0,
          "maxLength": 4096
        },
        "distinguished_name": {
          "description": "证书名称配置,详情请参见**DistinguishedName**字段数据结构说明。",
          "$ref": "#/definitions/DistinguishedName"
