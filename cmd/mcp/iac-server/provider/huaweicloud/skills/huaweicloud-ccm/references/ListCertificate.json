{
  "name": "ListCertificate",
  "summary": "查询私有证书列表",
  "tags": "私有证书管理",
  "productshort": "CCM",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/private-certificates": {
      "get": {
        "tags": [
          "私有证书管理"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "summary": "查询私有证书列表",
        "description": "查询私有证书列表。",
        "operationId": "ListCertificate",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "指定查询返回记录条数,默认值10。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 1000,
            "x-example": "10"
          },
          {
            "name": "name",
            "in": "query",
            "description": "私有证书名称,返回名称带有name字段的证书集合。",
            "required": false,
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-example": "test.com"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "索引位置,从offset指定的下一条数据开始查询。",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "x-example": "0"
          },
          {
            "name": "status",
            "in": "query",
            "description": "私有证书状态,通过状态过滤证书集合。\n  - **ISSUED** : 已签发;\n  - **REVOKED** : 已吊销;\n  - **EXPIRED** : 已过期。",
            "required": false,
            "type": "string",
            "x-example": "ISSUED"
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序属性,目前支持以下属性:\n- **create_time** : 证书创建时间(默认)\n- **common_name** : 证书名称\n- **issuer_name** : 签发CA名称\n- **not_after** : 证书到期时间",
            "required": false,
            "type": "string",
            "x-example": "common_name"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "排序方向,支持以下值:\n  - **DESC** : 降序(默认)\n  - **ASC** : 升序",
            "required": false,
            "type": "string",
            "x-example": "ASC"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户token,参见:[IAM token获取方法](https://support.huaweicloud.com/api-iam/iam_30_0001.html)。",
            "required": true,
            "type": "string",
            "x-example": "MIIePgYJKoZIhvcNAQcCoIIeLzCCHisCAQExDTALBglghkgBZQMEAgEwghxOBgkqhkiG9w0BBwGgghw..."
          }
        ],
        "x-request-examples-description-1": "查询私有证书列表,请求头中的**X-Auth-Token**字段需要填写token,且该token需要具有本API的访问权限。",
        "x-request-examples-url-1": "GET https://ccm.cn-north-4.myhuaweicloud.com/v1/private-certificates",
        "responses": {
          "200": {
            "description": "请求已成功",
