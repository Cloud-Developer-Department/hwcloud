{
  "name": "ShowInstanceSslDetail",
  "summary": "查询实例SSL信息",
  "tags": "网络安全",
  "productshort": "DCS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/instances/{instance_id}/ssl": {
      "get": {
        "x-api-type": "open-api",
        "x-produc-type": "dcs",
        "x-open-region-cloud": "hws,hws_hk,dt",
        "summary": "查询实例SSL信息",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "description": "查询实例SSL信息。该接口目前仅针对Redis 6.0基础版版本实例。",
        "tags": [
          "网络安全"
        ],
        "operationId": "ShowInstanceSslDetail",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参见[获取项目ID](dcs-api-0312045.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询实例SSL信息成功。",
            "schema": {
              "$ref": "#/definitions/SSLDetailResponse"
            },
            "examples": {
              "application/json": {
                "enabled": true,
                "ip": "192.168.0.5",
                "port": "6379",
                "domain_name": "redis-553a2516-b865-4159-b774-204dc0a36e37.dcs.example.com:6379",
                "ssl_expired_at": "2022-06-15T02:21:18.669Z",
                "ssl_validated": true
              }
            }
          },
          "400": {
            "description": "非法请求。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DCS.4201",
                "error_msg": "Do not support SSL."
              }
            }
          },
          "500": {
            "description": "内部服务错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DCS.5010",
                "error_msg": "Failed to operate SSL in database."
              }
            }
          }
        },
        "x-request-examples-url-1": "GET https://{dcs_endpoint}/v2/{project_id}/instances/{instance_id}/ssl"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "description": "错误响应体",
      "properties": {
        "error_msg": {
          "description": "错误信息",
          "type": "string",
          "example": "Invalid capacity parameter in the request.",
          "maxLength": 1024
        },
        "error_code": {
          "description": "错误码",
          "type": "string",
          "example": "DCS.4062",
          "maxLength": 9
        },
        "error_ext_msg": {
          "description": "扩展错误信息(暂未使用,赋值为null)",
          "type": "string",
          "example": null,
          "maxLength": 1024
        }
      }
    },
    "SSLDetailResponse": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "开启或关闭SSL。true:开启/false:关闭",
          "enum": [
            true,
            false
          ],
          "example": true
        },
        "ip": {
          "type": "string",
          "description": "SSL连接IP。",
          "example": "192.168.0.5"
        },
        "port": {
          "type": "string",
          "description": "SSL连接端口。",
          "example": "6379"
        },
        "domain_name": {
          "type": "string",
          "description": "SSL连接域名。",
          "example": "redis-553a2516-b865-4159-b774-204dc0a36e37.dcs.example.com:6379"
        },
        "ssl_expired_at": {
          "type": "string",
          "description": "SSL证书有效期(UTC时间)。",
          "example": "2022-06-15T02:21:18.669Z"
        },
        "ssl_validated": {
          "type": "boolean",
          "description": "SSL证书是否有效。",
          "example": true
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dcs.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}