{
  "name": "BatchShowNodesInformation",
  "summary": "批量查询实例节点信息",
  "tags": "分片与副本",
  "productshort": "DCS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/instances-logical-nodes": {
      "get": {
        "summary": "批量查询实例节点信息",
        "x-open-region-cloud": "hc,hk,otc,ocb,sbc,g42,tm,ctc,cmc",
        "x-hybridcloud": true,
        "x-constraint": "仅支持Redis4.0和Redis5.0实例查询",
        "x-name": "批量查询实例节点信息",
        "x-scope": "",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "description": "批量查询指定项目所有实例的节点信息、有效实例个数及节点个数。\n创建中实例不返回节点信息。\n仅支持Redis4.0和Redis5.0实例查询",
        "operationId": "BatchShowNodesInformation",
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/BatchInstanceNodesInfoResp"
            },
            "description": "查询节点信息成功",
            "examples": {
              "application/json": {
                "count": 1,
                "instances": [
                  {
                    "instance_id": "b4468cb1-4f75-4866-a49d-86959acc0c9c",
                    "node_count": 2,
                    "nodes": [
                      {
                        "logical_node_id": "8f997eb512a92834bf5914be52ca8919",
                        "name": "(replica)192.168.0.178",
                        "status": "Active",
                        "az_code": "cn-north-7c",
                        "node_role": "redis-server",
                        "node_type": "slave",
                        "node_ip": "192.168.0.178",
                        "node_port": "6379",
                        "node_id": "8a2c26c17f4d6516017f4d7b77940030",
                        "is_access": true,
                        "group_id": "ace962d1-7841-4e50-9313-c239fd75dee3",
                        "group_name": "group-0",
                        "priority_weight": 100,
                        "is_remove_ip": false,
                        "replication_id": "e40aa09e-03c2-4319-86eb-5ef4ca637544",
                        "dimensions": [
                          {
                            "name": "dcs_instance_id",
                            "value": "caf2d19f-7783-44b0-be46-8c9da3ef1e94"
                          },
                          {
                            "name": "dcs_cluster_redis_node",
                            "value": "8263dc69629c5b2d840e9816fa9c6200"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "500": {
            "description": "内部服务错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DCS.5000",
                "error_msg": "Internal service error."
              }
            }
          },
          "400": {
            "description": "非法请求",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DCS.4800",
                "error_msg": "Invalid offset in the request."
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "description": "项目ID",
            "type": "string",
            "x-example": "666486c2d9b948c1bbea57e714d744fa",
            "required": true
          },
          {
            "in": "query",
            "name": "offset",
            "format": "int32",
            "description": "偏移量,表示从此偏移量开始查询,offset大于等于0。",
            "type": "integer",
            "x-example": 1
          },
          {
            "in": "query",
            "name": "limit",
            "format": "int32",
            "description": "每页显示的条目数量,当前最大值为100。若不设置该参数,则为10。",
            "type": "integer",
            "x-example": 10
          }
        ],
        "tags": [
          "分片与副本"
        ],
        "x-request-examples-url-1": "GET https://{dcs_endpoint}/v2/{project_id}/instances-logical-nodes?offset={offset}&limit={limit}"
      }
    }
  },
  "definitions": {
    "InstanceNodesInfoResp": {
      "description": "实例信息响应体",
      "properties": {
        "instance_id": {
          "type": "string",
          "description": "实例ID",
          "example": "493c1301-baca-4253-98f8-70b749ac769f"
        },
        "node_count": {
          "type": "integer",
          "format": "int32",
          "description": "当前实例节点总数",
          "example": 2
        },
        "nodes": {
          "type": "array",
          "description": "节点详情。",
          "items": {
            "type": "object",
            "$ref": "#/definitions/NodesInfoResp"
          }
        }
      }
    },
    "ErrorResponse": {
      "description": "错误响应体",
      "properties": {
        "error_msg": {
          "description": "错误信息",
          "type": "string",
          "example": "Invalid capacity parameter in the request.",
          "maxLength": 1024
        },
        "error_code": {
          "description": "错误码",
          "type": "string",
          "example": "DCS.4062",
          "maxLength": 9
        },
        "error_ext_msg": {
          "description": "扩展错误信息(暂未使用,赋值为null)",
          "type": "string",
          "example": null,
          "maxLength": 1024
        }
      }
    },
    "BatchInstanceNodesInfoResp": {
      "description": "批量查询节点信息响应体",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "查询结果的实例总数",
          "example": 1
        },
        "instances": {
          "type": "array",
          "description": "实例列表。",
          "items": {
            "type": "object",
            "$ref": "#/definitions/InstanceNodesInfoResp"
          }
        }
      }
    },
    "NodesInfoResp": {
      "properties": {
        "logical_node_id": {
          "type": "string",
          "description": "逻辑节点ID",
          "example": "8f997eb512a92834bf5914be52ca8919"
        },
        "name": {
          "type": "string",
          "description": "节点名称",
          "example": "(replica)192.168.0.178"
        },
        "status": {
          "type": "string",
          "description": "节点状态,所有值如下:\n- Creating:创建中。\n- Active:运行中。\n- Inactive:故障。\n- Deleting:删除中。\n- AddSharding:添加分片中。",
          "enum": [
            "Creating",
            "Active",
            "Inactive",
            "Deleting",
            "AddSharding"
          ],
          "example": "Active"
        },
        "az_code": {
          "type": "string",
          "description": "可用区code",
          "example": "cn-north-7c"
        },
        "node_role": {
          "type": "string",
          "description": "节点角色,所有值如下:\n- redis-server:Redis server节点。\n- redis-proxy:proxy节点。",
          "enum": [
            "redis-server",
            "redis-proxy"
          ],
          "example": "redis-server"
        },
        "node_type": {
          "type": "string",
          "description": "节点主从角色:\n- master:主\n- slave:从\n- proxy: proxy实例节点角色为\"proxy\"",
          "enum": [
            "master",
            "slave",
            "proxy"
          ],
          "example": "slave"
        },
        "node_ip": {
          "type": "string",
          "description": "节点的IP",
          "example": "192.168.0.178"
        },
        "node_port": {
          "type": "string",
          "description": "节点的port",
          "example": "6379"
        },
        "node_id": {
          "type": "string",
          "description": "节点ID",
          "example": "8a2c26c17f4d6516017f4d7b77940030"
        },
        "priority_weight": {
          "type": "integer",
          "format": "int32",
          "description": "节点权重",
          "example": 100
        },
        "is_access": {
          "type": "boolean",
          "description": "节点的IP是否可直接访问",
          "example": true
        },
        "group_id": {
          "type": "string",
          "description": "分片ID",
          "example": "ace962d1-7841-4e50-9313-c239fd75dee3"
        },
        "group_name": {
          "type": "string",
          "description": "分片名称",
          "example": "group-0"
        },
        "is_remove_ip": {
          "type": "boolean",
          "description": "是否从只读域名中摘除IP",
          "example": false
        },
        "replication_id": {
          "type": "string",
          "description": "副本id",
          "example": "b4468cb1-4f75-4866-a49d-86959acc0c9c"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/InstanceReplicationDimensionsInfo"
          },
          "description": "副本对应的监控指标维度信息。可用于调用云监控服务的查询监控数据指标相关接口\n- 副本的监控维度为多维度,返回数组中包含两个维度信息。从云监控查询监控数据时,要按多维度传递指标维度参数,才能查询到监控指标值\n- 第一个维度为副本父维度信息\n维度名称为dcs_instance_id,维度值对应副本所在的实例ID\n- 第二个维度,维度名称为dcs_cluster_redis_node,维度值为副本的监控对象ID,与副本ID和节点ID不同。"
        }
      }
    },
    "InstanceReplicationDimensionsInfo": {
      "description": "监控指标维度对象信息",
      "properties": {
        "name": {
          "format": "String",
          "description": "监控维度名称",
          "type": "string",
          "example": "dcs_cluster_redis_node"
        },
        "value": {
          "format": "String",
          "description": "维度取值",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dcs.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}