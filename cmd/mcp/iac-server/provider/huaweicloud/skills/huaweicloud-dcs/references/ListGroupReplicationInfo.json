  "definitions": {
    "QueryInstanceGroupInfoResp": {
      "description": "分片副本详情信息。",
      "properties": {
        "group_list": {
          "description": "分片列表",
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/InstanceGroupListInfo"
          }
        },
        "group_count": {
          "description": "实例分片总数。",
          "type": "integer",
          "example": 3
        }
      }
    },
    "InstanceGroupListInfo": {
      "description": "分片列表",
      "properties": {
        "group_id": {
          "description": "分片id",
          "type": "string",
          "example": "995e1f3b-f9c0-4acf-ad9d-89123d1fd12a"
        },
        "group_name": {
          "description": "分片名称",
          "type": "string",
          "example": "group-0"
        },
        "replication_list": {
          "description": "每个分片包含的副本列表。",
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/InstanceReplicationListInfo"
          }
        }
      }
    },
    "InstanceReplicationDimensionsInfo": {
      "description": "监控指标维度对象信息",
      "properties": {
        "name": {
          "format": "String",
          "description": "监控维度名称",
          "type": "string",
          "example": "dcs_cluster_redis_node"
        },
        "value": {
          "format": "String",
          "description": "维度取值",
          "type": "string"
        }
      }
    },
    "InstanceReplicationListInfo": {
      "description": "副本列表",
      "properties": {
        "replication_role": {
          "description": "副本角色,取值有:\n- master:表示主节点。\n- slave:表示从节点。",
          "type": "string",
          "example": "master"
        },
        "replication_ip": {
          "description": "副本IP。",
          "type": "string",
          "example": "192.168.0.233"
        },
        "is_replication": {
          "description": "是否是新加副本。",
          "type": "boolean",
          "example": false
        },
        "replication_id": {
          "description": "副本id。",
          "type": "string",
          "example": "71749f79-e9ea-4173-8bfa-b97357153af8"
        },
        "node_id": {
          "description": "节点id。",
          "type": "string",
          "example": "8aa6999f6de47c69016df0e7ddd223da"
        },
        "status": {
          "description": "副本状态。",
          "type": "string",
          "enum": [
            "Active",
            "Inactive"
          ],
          "example": "Active"
        },
        "az_code": {
          "description": "副本所在的可用区",
          "type": "string"
        },
        "dimensions": {
          "description": "副本对应的监控指标维度信息。可用于调用云监控服务的查询监控数据指标相关接口\n- 副本的监控维度为多维度,返回数组中包含两个维度信息。从云监控查询监控数据时,要按多维度传递指标维度参数,才能查询到监控指标值\n- 第一个维度为副本父维度信息,维度名称为dcs_instance_id,维度值对应副本所在的实例ID\n- 第二个维度,维度名称为dcs_cluster_redis_node,维度值为副本的监控对象ID,与副本ID和节点ID不同。",
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/InstanceReplicationDimensionsInfo"
          }
        }
      }
    }
  },
