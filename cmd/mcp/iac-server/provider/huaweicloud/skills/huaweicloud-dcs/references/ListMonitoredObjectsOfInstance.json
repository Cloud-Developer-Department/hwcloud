  "definitions": {
    "InstancesMonitoredObject": {
      "description": "监控对象结构",
      "properties": {
        "dcs_instance_id": {
          "description": "测量对象ID,即实例的ID。",
          "type": "string"
        },
        "name": {
          "description": "测量对象名称,即实例名称。",
          "type": "string"
        },
        "status": {
          "description": "测量对象状态,即实例状态。",
          "type": "string"
        }
      }
    },
    "Proxy2NodeMonitoredObject": {
      "description": "Redis 4.0 和 5.0 proxy集群中proxy节点监控对象结构",
      "properties": {
        "dcs_instance_id": {
          "description": "测量对象ID,即节点的ID。",
          "type": "string"
        },
        "name": {
          "description": "测量对象名称,即节点IP。",
          "type": "string"
        },
        "dcs_cluster_proxy2_node": {
          "description": "维度dcs_cluster_proxy2_node 的测量对象的ID。",
          "type": "string"
        },
        "status": {
          "description": "测量对象状态,即节点状态。",
          "type": "string"
        }
      }
    },
    "DimChild": {
      "description": "维度对象结构体",
      "properties": {
        "dim_name": {
          "description": "维度名称,当前支持维度有dcs_instance_id、dcs_cluster_redis_node、 dcs_cluster_proxy_node和dcs_memcached_instance_id。",
          "type": "string"
        },
        "dim_route": {
          "description": "维度的路由,结构为主维度名称,当前维度名称,比如: dim_name字段为dcs_cluster_redis_node时,这个字段的值为dcs_instance_id,dcs_cluster_redis_node。",
          "type": "string"
        }
      }
    },
    "ProxyNodeMonitoredObject": {
      "description": "Redis 3.0 proxy集群中proxy节点监控对象结构",
      "properties": {
        "dcs_instance_id": {
          "description": "测量对象ID,即节点的ID。",
          "type": "string"
        },
        "name": {
          "description": "测量对象名称,即节点IP。",
          "type": "string"
        },
        "dcs_cluster_proxy_node": {
          "description": "维度dcs_cluster_proxy_node 的测量对象的ID。",
          "type": "string"
        },
        "status": {
          "description": "测量对象状态,即节点状态。",
          "type": "string"
        }
      }
    },
    "ClusterRedisNodeMonitoredObject": {
      "description": "监控对象结构",
      "properties": {
        "dcs_instance_id": {
          "description": "测量对象ID,即节点的ID。",
          "type": "string"
        },
        "name": {
          "description": "测量对象名称,即节点IP。",
          "type": "string"
        },
        "dcs_cluster_redis_node": {
          "description": "维度dcs_cluster_redis_node的测量对象的ID。",
          "type": "string"
        },
        "status": {
          "description": "测量对象状态,即节点状态。",
          "type": "string"
        }
      }
    },
    "CESMonitoredObjectOfInstance": {
      "description": "监控对象结构",
      "properties": {
        "router": {
          "description": "当前查询维度路由。如果是主维度,则数组中是自身ID。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "children": {
          "description": "当前查询维度子维度对象列表。当前只有维度为dcs_instance_id时才有值。\n- Proxy集群有两个子维度,分别为dcs_cluster_redis_node和dcs_cluster_proxy_node。\n- Cluster集群有一个子维度 dcs_cluster_proxy_node。",
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/DimChild"
          }
        },
        "instances": {
          "description": "当前查询维度监控对象列表。",
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/InstancesMonitoredObject"
          }
        },
        "dcs_cluster_redis_node": {
          "description": "Proxy集群或Cluster集群时才存在,表示集群数据节点维度的监控对象列表。字段名称与children的子维度对象名称相同。",
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/ClusterRedisNodeMonitoredObject"
          }
        },
        "dcs_cluster_proxy_node": {
          "description": "Proxy集群时才存在,表示集群Proxy节点维度的监控对象列表。字段名称与children的子维度对象名称相同。",
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/ProxyNodeMonitoredObject"
          }
        },
        "dcs_cluster_proxy2_node": {
          "description": "Redis 4.0和5.0的Proxy集群时才存在,表示集群Proxy节点维度的监控对象列表。字段名称与children的子维度对象名称相同。",
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Proxy2NodeMonitoredObject"
          }
        },
        "total": {
          "description": "主维度监控对象的总数。",
          "type": "integer"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
