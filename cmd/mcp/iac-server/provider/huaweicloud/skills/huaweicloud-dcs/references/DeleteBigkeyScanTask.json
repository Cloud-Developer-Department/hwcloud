        "size": {
          "description": "key的value大小。",
          "type": "integer",
          "format": "int64",
          "example": 3000
        },
        "unit": {
          "description": "key大小的单位。type为string时,单位是:byte;type为list/set/zset/hash时,单位是:count",
          "type": "string",
          "example": "byte"
        }
      }
    },
