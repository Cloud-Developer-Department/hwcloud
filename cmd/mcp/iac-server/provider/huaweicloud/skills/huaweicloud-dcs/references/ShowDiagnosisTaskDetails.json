        "summary": "查询指定诊断报告",
        "description": "通过报告ID查询诊断报告的详细信息。",
        "operationId": "ShowDiagnosisTaskDetails",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "项目ID",
            "type": "string"
          },
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "description": "诊断报告ID",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "查询指定报告成功。",
