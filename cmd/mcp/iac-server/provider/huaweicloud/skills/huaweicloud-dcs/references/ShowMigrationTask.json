  "definitions": {
    "TargetInstanceBody": {
      "description": "目标实例信息。",
      "properties": {
        "id": {
          "type": "string",
          "description": "Redis实例ID(target_instance信息中必须填写)。",
          "example": "4cd5dbb8-aacd-4603-b817-3e97d48c7a20"
        },
        "name": {
          "type": "string",
          "description": "Redis实例名称(target_instance信息中填写)。",
          "example": "dcs-cdrc"
        },
        "password": {
          "type": "string",
          "description": "Redis密码,如果设置了密码,则必须填写。",
          "example": "xxxxxx"
        },
        "task_status": {
          "description": "任务状态。",
          "type": "string"
        },
        "ip": {
          "description": "Redis IP地址。",
          "type": "string"
        },
        "port": {
          "description": "Redis端口。",
          "type": "string"
        },
        "addrs": {
          "description": "Redis实例地址。",
          "type": "string"
        },
        "proxy_multi_db": {
          "description": "proxy实例是否开启了多DB。",
          "type": "boolean"
        },
        "db": {
          "description": "Redis数据库。",
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "SourceInstanceBody": {
      "description": "源实例信息。",
      "properties": {
        "addrs": {
          "type": "string",
          "description": "Redis实例名称(source_instance信息中填写)。",
          "example": "172.16.0.116:6379"
        },
        "password": {
          "type": "string",
          "description": "Redis密码,如果设置了密码,则必须填写。",
          "example": "xxxxxx"
        },
        "task_status": {
          "description": "任务状态。",
          "type": "string"
        },
        "id": {
          "description": "Redis实例ID。",
          "type": "string"
        },
        "ip": {
          "description": "Redis IP地址。",
          "type": "string"
        },
        "port": {
          "description": "Redis端口。",
          "type": "string"
        },
        "name": {
          "description": "Redis名称。",
          "type": "string"
        },
        "proxy_multi_db": {
          "description": "proxy实例是否开启了多DB。",
          "type": "boolean"
        },
        "db": {
          "description": "Redis数据库。",
          "type": "string"
        }
      },
      "required": [
        "addrs"
      ]
    },
    "BackupFilesBody": {
      "description": "备份文件列表的结构体",
      "properties": {
        "file_source": {
          "type": "string",
          "description": "数据来源,当前仅支持OBS桶方式,取值为:self_build_obs。",
          "enum": [
            "self_build_obs",
            "backup_record"
          ]
        },
        "bucket_name": {
          "type": "string",
          "description": "OBS桶名。"
        },
        "files": {
          "type": "array",
          "description": "导入的备份文件文件列表。",
          "items": {
            "$ref": "#/definitions/Files",
            "type": "object"
          }
        },
        "backup_id": {
          "type": "string",
          "description": "备份记录ID,数据来源为备份记录时必须填写"
        }
      },
      "required": [
        "files"
      ]
    },
    "StopMigrationTaskResp": {
      "description": "停止数据迁移任务响应体",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "迁移任务ID。"
        },
        "task_name": {
          "type": "string",
          "description": "迁移任务名称。"
        },
        "description": {
          "type": "string",
          "description": "迁移任务描述。"
        },
        "status": {
          "type": "string",
          "description": "迁移任务状态,这个字段的值包括:SUCCESS, FAILED, MIGRATING,TERMINATED。",
          "enum": [
            "SUCCESS",
            "FAILED",
            "MIGRATING",
            "TERMINATED"
          ]
        },
        "migration_type": {
          "type": "string",
          "description": "迁移任务类型,包括备份文件导入和在线迁移两种类型。",
          "enum": [
            "backupfile_import",
            "online_migration"
          ]
        },
        "migration_method": {
          "type": "string",
          "description": "迁移方式,包括全量迁移和增量迁移两种类型。",
          "enum": [
            "full_amount_migration",
            "incremental_migration"
          ]
        },
        "ecs_tenant_private_ip": {
          "type": "string",
          "description": "迁移机租户侧私有IP,与目的/源redis私有IP处于同VPC,可将此IP加入白名单",
          "example": "192.168.1.60"
        },
        "backup_files": {
          "type": "object",
          "$ref": "#/definitions/BackupFilesBody",
          "description": "备份文件导入场景的备份文件列表。"
        },
        "network_type": {
          "type": "string",
          "description": "网络类型,包括vpc和vpn两种类型。",
          "enum": [
            "vpc",
            "vpn"
          ]
        },
        "source_instance": {
          "type": "object",
          "$ref": "#/definitions/SourceInstanceBody",
          "description": "源Redis信息。在线迁移场景需要填写。"
        },
        "target_instance": {
          "type": "object",
          "$ref": "#/definitions/TargetInstanceBody",
          "description": "目标Redis信息。"
        },
        "created_at": {
          "type": "string",
          "description": "迁移任务创建时间。"
        },
        "updated_at": {
          "type": "string",
          "description": "迁移任务完成时间。"
        },
        "released_at": {
          "description": "迁移机释放时间。",
          "type": "string"
        },
        "version": {
          "description": "版本。",
          "type": "string"
        },
        "resume_mode": {
          "description": "操作模式,分为auto和manual。",
          "type": "string"
        },
        "supported_features": {
          "description": "支持的特性。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tenant_vpc_id": {
          "description": "租户VPC ID。",
          "type": "string"
        },
        "tenant_subnet_id": {
          "description": "租户子网ID。",
          "type": "string"
        },
        "tenant_security_group_id": {
          "description": "租户安全组ID。",
          "type": "string"
        },
        "bandwidth_limit_mb": {
          "description": "带宽限制速度。",
          "type": "string"
        },
        "task_status": {
          "description": "任务状态。",
          "type": "string"
        }
      }
    },
    "Files": {
      "description": "导入的备份文件文件列表。",
      "properties": {
        "file_name": {
          "type": "string",
          "description": "备份文件名。"
        },
        "size": {
          "type": "string",
          "description": "文件大小(单位:Byte)。"
        },
        "update_at": {
          "type": "string",
          "description": "文件最后修改时间(格式YYYY-MM-DD HH:MM:SS)。"
        }
      },
      "required": [
        "file_name"
      ]
    }
  },
