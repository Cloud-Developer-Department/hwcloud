          "type": "string",
          "example": "5560df16-cebf-4473-95c4-d1b573c16e79"
        },
        "size": {
          "format": "int64",
          "description": "备份文件大小(Byte)。",
          "type": "integer",
          "example": 880232
        },
        "backup_type": {
          "format": "string",
