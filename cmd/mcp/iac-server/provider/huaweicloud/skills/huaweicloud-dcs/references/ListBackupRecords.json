          "enum": [
            "manual",
            "auto"
          ],
          "example": "manual"
        },
        "created_at": {
          "format": "string",
          "description": "备份任务创建时间。",
          "type": "string",
          "example": "2019-05-10T08:31:16.166Z"
        },
        "updated_at": {
          "format": "string",
          "description": "备份完成时间。",
          "type": "string",
          "example": "2019-05-10T08:31:21.461Z"
        },
        "progress": {
          "format": "string",
          "description": "备份进度。",
          "type": "string",
          "example": 100
        },
        "error_code": {
          "description": "备份失败后错误码\n* `dcs.08.0001` - 启动备份恢复工具失败。\n* `dcs.08.0002` - 执行超时。\n* `dcs.08.0003` - 删除桶失败。\n* `dcs.08.0004` - 获取ak/sk 失败。\n* `dcs.08.0005` - 创建桶失败。\n* `dcs.08.0006` - 查询备份数据大小失败。\n* `dcs.08.0007` - 恢复时同步数据失败。\n* `dcs.08.0008` - 自动备份任务未运行,实例正在运行其他任务。",
          "type": "string"
        },
        "remark": {
          "format": "string",
          "description": "备份缓存实例的备注信息。",
          "type": "string",
          "example": 1
        },
        "status": {
          "format": "string",
          "description": "备份状态。\n- waiting:等待中。\n- backuping:备份中。\n- succeed:备份成功。\n- failed:备份失败。\n- expired:备份文件过期。\n- deleted:已手动删除备份文件。",
          "type": "string",
          "enum": [
            "waiting",
            "backuping",
            "succeed",
            "failed",
            "expired",
            "deleted"
          ],
          "example": "succeed"
        },
        "is_support_restore": {
          "format": "string",
          "description": "是否可以进行恢复操作,取值为TRUE或FALSE。",
          "type": "string",
          "example": true
        },
        "backup_format": {
          "type": "string",
          "description": "备份类型。",
          "enum": [
            "aof",
            "rdb"
          ],
          "example": "aof"
        },
        "execution_at": {
          "type": "string",
          "description": "执行时间.",
          "example": "2017-07-18T21:41:20.721Z"
        }
      }
    }
