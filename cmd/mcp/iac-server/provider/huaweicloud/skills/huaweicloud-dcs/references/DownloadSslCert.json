{
  "name": "DownloadSslCert",
  "summary": "下载实例SSL证书",
  "tags": "网络安全",
  "productshort": "DCS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/instances/{instance_id}/ssl-certs/download": {
      "post": {
        "x-api-type": "open-api",
        "x-produc-type": "dcs",
        "x-open-region-cloud": "hws,hws_hk,dt",
        "summary": "下载实例SSL证书",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "description": "下载实例SSL证书。该接口目前仅针对Redis 6.0基础版版本实例。",
        "tags": [
          "网络安全"
        ],
        "operationId": "DownloadSslCert",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,获取方法请参见[获取项目ID](dcs-api-0312045.xml)。",
            "required": true,
            "type": "string"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "下载实例SSL证书成功。",
            "schema": {
              "$ref": "#/definitions/SSLCertResponse"
            },
            "examples": {
              "application/json": {
                "bucket_name": "bucket_name",
                "file_name": "file_name",
                "link": "https://{bucket_name}.{obs_endpoint}:443/{ssl-XXX}/{file_name}?AWSAccessKeyId=XXX&Expires=XXX&Signature=XXX"
              }
            }
          },
          "400": {
            "description": "非法请求。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DCS.4201",
                "error_msg": "Do not support SSL."
              }
            }
          },
          "500": {
            "description": "内部服务错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error_code": "DCS.5010",
                "error_msg": "Failed to operate SSL in database."
              }
            }
          }
        },
        "x-request-examples-url-1": "POST https://{dcs_endpoint}/v2/{project_id}/instances/{instance_id}/ssl-certs/download"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "description": "错误响应体",
      "properties": {
        "error_msg": {
          "description": "错误信息",
          "type": "string",
          "example": "Invalid capacity parameter in the request.",
          "maxLength": 1024
        },
        "error_code": {
          "description": "错误码",
          "type": "string",
          "example": "DCS.4062",
          "maxLength": 9
        },
        "error_ext_msg": {
          "description": "扩展错误信息(暂未使用,赋值为null)",
          "type": "string",
          "example": null,
          "maxLength": 1024
        }
      }
    },
    "SSLCertResponse": {
      "properties": {
        "file_name": {
          "type": "string",
          "description": "SSL证书文件名。",
          "example": "CA-1648543471965.zip"
        },
        "link": {
          "type": "string",
          "description": "SSL证书下载链接。"
        },
        "bucket_name": {
          "type": "string",
          "description": "保存SSL证书的obs桶名。",
          "example": "bucket-external-1c331a8218484cd5802471ba5d2b044b"
        }
      }
    }
  },
  "version": "2.0",
