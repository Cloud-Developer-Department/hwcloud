          "description": "**参数解释**:\ndb索引值。\n**取值范围**:\n不涉及。"
        },
        "keys": {
          "type": "string",
          "description": "**参数解释**:\n节点键数量。\n**取值范围**:\n不涉及。"
        },
        "expires": {
          "type": "string",
          "description": "**参数解释**:\n节点过期键数量。\n**取值范围**:\n不涉及。"
        },
        "avg_ttl": {
          "type": "string",
          "description": "**参数解释**:\n节点键的平均过期时间。\n**取值范围**:\n不涉及。"
        }
      }
    },
    "TopologyInfo": {
      "description": "拓扑详情",
      "properties": {
        "node_id": {
          "type": "string",
          "description": "**参数解释**:\n节点ID。\n**取值范围**:\n不涉及。",
          "example": "8a2c26c17f4d6516017f4d7b77940030"
        },
        "node_name": {
          "type": "string",
          "description": "**参数解释**:\n节点名称。\n**取值范围**:\n不涉及。",
          "example": "dcs-bare-vm-x86-cn-north-7c-1657002433-0"
        },
        "ip": {
          "type": "string",
          "description": "**参数解释**:\n节点IP。\n**取值范围**:\n不涉及。",
          "example": "192.168.60.32"
        },
        "port": {
          "type": "string",
          "description": "**参数解释**:\n节点端口。\n**取值范围**:\n不涉及。",
          "example": "8080"
        },
        "node_type": {
          "type": "string",
          "description": "**参数解释**:\n节点主从角色。\n**取值范围**:\nmaster:主节点\nslave:从节点\nproxy:proxy节点",
          "enum": [
            "master",
            "slave",
            "proxy"
          ],
          "example": "slave"
        },
        "max_memory": {
          "description": "**参数解释**:\n总内存,单位:MB。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "1365"
        },
        "used_memory": {
          "description": "**参数解释**:\n已使用的内存,单位:MB。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "3"
        },
        "qps": {
          "description": "**参数解释**:\n每秒查询率。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "6"
        },
        "bandwidth": {
          "description": "**参数解释**:\n带宽信息。",
          "$ref": "#/definitions/BandWidth"
        },
        "db_num": {
          "description": "**参数解释**:\n该实例的DB数量。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "0"
        },
        "dbs": {
          "description": "**参数解释**:\n键信息。",
          "$ref": "#/definitions/KeySpace"
        },
        "relation_ip": {
          "description": "**参数解释**:\n关联IP。\n**取值范围**:\n不涉及。",
          "type": "string",
          "example": "192.168.53.35"
        },
        "relation_port": {
