          "items": {
            "$ref": "#/definitions/TopologyInfo"
          }
        },
        "cluster_proxy": {
          "type": "array",
          "description": "**参数解释**:\n集群角色:proxy实例拓朴图。",
          "items": {
            "$ref": "#/definitions/TopologyInfo"
          }
        },
        "master": {
          "type": "array",
          "description": "**参数解释**:\nRedis的角色master实例拓朴图,只适用于Redis 3.0版本实例。",
          "items": {
            "$ref": "#/definitions/TopologyInfo"
          }
        },
        "vpcendpoint": {
          "type": "array",
          "description": "**参数解释**:\n集群角色:VPC Endpoint服务实例拓朴图,适用于4.0及以上版本实例。",
          "items": {
            "$ref": "#/definitions/TopologyInfo"
          }
        },
        "elb": {
          "type": "array",
          "description": "**参数解释**:\n集群角色:ELB服务实例拓朴图,适用于Redis 4.0及以上版本实例。",
          "items": {
            "$ref": "#/definitions/TopologyInfo"
          }
        }
      }
    },
