          "type": "string",
          "example": "8080"
        },
        "group_id": {
          "type": "string",
          "description": "**参数解释**:\n分片ID。\n**取值范围**:\n不涉及。",
          "example": "ace962d1-7841-4e50-9313-c239fd75dee3"
        },
        "status": {
          "type": "string",
          "description": "**参数解释**:\n节点状态。\n**取值范围**:\n不涉及。",
          "example": "Active"
        },
        "dims": {
          "description": "**参数解释**:\ndescription: CES监控维护信息。",
          "$ref": "#/definitions/DimsInfo"
        }
      }
    },
