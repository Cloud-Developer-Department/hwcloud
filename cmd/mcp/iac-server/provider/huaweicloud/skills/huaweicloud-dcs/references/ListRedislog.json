{
  "name": "ListRedislog",
  "summary": "查询Redis运行日志列表",
  "tags": "日志管理",
  "productshort": "DCS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/instances/{instance_id}/redislog": {
      "get": {
        "tags": [
          "日志管理"
        ],
        "summary": "查询Redis运行日志列表",
        "description": "查询Redis运行日志列表。",
        "operationId": "ListRedislog",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "a4d31cb6-3d72-4fdc-8ec9-6e3a41e47f71"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "5560df16-cebf-4473-95c4-d1b573c16e79"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,表示从此偏移量开始查询, offset大于等于0",
            "required": false,
            "type": "integer",
            "x-example": "0"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量。",
            "required": false,
            "type": "integer",
            "x-example": "10"
          },
          {
            "name": "log_type",
            "in": "query",
            "description": "返回日志的类型,当前仅支持Redis运行日志,类型为run",
            "required": true,
            "type": "string",
            "x-example": "run"
          }
        ],
        "responses": {
          "200": {
            "description": "查询运行日志成功。",
            "schema": {
              "$ref": "#/definitions/RunlogResponse"
            },
            "examples": {
              "application/json": {
                "total_num": 1,
                "file_list": [
                  {
                    "id": "e79f2d97-e972-41f2-b51c-d18f65f39a45",
                    "file_name": "redis_192.168.0.142_2021-04-16.log",
                    "status": "succeed",
                    "time": "2021-04-16"
                  }
                ]
              }
            }
          },
          "204": {
            "description": "查询运行日志无记录"
          },
          "400": {
            "description": "非法请求。",
            "examples": {
              "application/json": {
                "error_code": "DCS.4800",
                "error_msg": "Invalid logType."
              }
            }
          },
          "401": {
            "description": "认证信息非法。"
          },
          "403": {
            "description": "请求被拒绝访问。"
          },
          "404": {
            "description": "所请求的资源不存在。"
          },
          "500": {
            "description": "内部服务错误。"
          }
        },
        "x-constraint": "",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-produc-type": "dcs",
        "x-name": "查询运行日志",
        "x-scope": "",
        "x-request-examples-url-1": "GET https://dcs.cn-south-1.myhuaweicloud.com/v2/a4d31cb6-3d72-4fdc-8ec9-6e3a41e47f71/instances/5560df16-cebf-4473-95c4-d1b573c16e79/redislog?log_type=run&offset=1&limit=10"
      }
    }
  },
  "definitions": {
    "RunlogResponse": {
      "description": "查询运行日志返回体",
      "properties": {
        "total_num": {
          "description": "总数",
          "type": "integer"
        },
        "file_list": {
          "description": "运行日志列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RunlogItem"
          }
        }
      }
    },
    "RunlogItem": {
      "description": "运行日志单个条目",
      "properties": {
        "id": {
          "description": "日志的唯一标识",
          "type": "string"
        },
        "file_name": {
          "description": "运行日志文件名",
          "type": "string"
        },
        "group_name": {
          "description": "分片名称",
          "type": "string"
        },
        "replication_ip": {
          "description": "采集运行日志所在副本的IP",
          "type": "string"
        },
        "status": {
          "description": "获取运行日志状态",
          "type": "string"
        },
        "time": {
          "description": "运行日志采集的日期,格式为\"yyyy-MM-dd\"",
          "type": "string"
        },
        "backup_id": {
          "description": "日志文件的ID",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
