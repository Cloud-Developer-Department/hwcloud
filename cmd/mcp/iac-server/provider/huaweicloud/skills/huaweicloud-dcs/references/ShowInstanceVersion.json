{
  "name": "ShowInstanceVersion",
  "summary": "根据实例ID获取实例内核版本信息",
  "tags": "实例管理",
  "productshort": "DCS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/instances/{instance_id}/version": {
      "get": {
        "tags": [
          "实例管理"
        ],
        "x-api-type": "open-api",
        "summary": "根据实例ID获取实例内核版本信息",
        "description": "获取对应实例内核版本号。",
        "operationId": "ShowInstanceVersion",
        "x-produc-type": "dcs",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。获取方法请参见[获取项目ID](dcs-api-0312045.xml)。",
            "required": true,
            "type": "string",
            "maxLength": 64
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "maxLength": 64
          }
        ],
        "responses": {
          "200": {
            "description": "返回对应实例版本信息内容",
            "examples": {
              "application/json": {
                "engine_minor_version": "6.0.1.0",
                "proxy_minor_version": "5.0.14.0",
                "latest_proxy_minor_version": "5.0.14.0",
                "latest_engine_minor_version": "6.0.1.0",
                "engine_minor_version_upgradable": false,
                "proxy_minor_version_upgradable": false
              }
            },
            "schema": {
              "$ref": "#/definitions/InstanceVersionResponse"
            }
          },
          "400": {
            "description": "非法请求。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "认证失败。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "请求被拒绝。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "路径错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "内部错误。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-open-region-cloud": "hws,hws_hk",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-request-examples-url-1": "GET https://{dcs_endpoint}/v2/{project_id}/instances/{instance_id}/version"
      }
    }
  },
  "definitions": {
    "InstanceVersionResponse": {
      "type": "object",
      "required": [
        "engine_minor_version_upgradable",
        "proxy_minor_version_upgradable"
      ],
      "properties": {
        "engine_minor_version": {
          "type": "string",
          "description": "当前实例内核小版本信息。"
        },
        "latest_engine_minor_version": {
          "type": "string",
          "description": "DCS实例最新的内核小版本信息。"
        },
        "proxy_minor_version": {
          "type": "string",
          "description": "当前实例proxy代理节点版本信息。"
        },
        "latest_proxy_minor_version": {
          "type": "string",
          "description": "DCS实例最新的proxy代理节点版本信息。"
        },
        "engine_minor_version_upgradable": {
          "type": "boolean",
          "description": "当前实例内核是否可以升级。"
        },
        "proxy_minor_version_upgradable": {
          "type": "boolean",
          "description": "当前实例proxy代理节点是否可以升级。"
        }
      },
      "description": "相关实例版本信息响应内容。"
    },
    "ErrorResponse": {
      "description": "错误响应体",
      "properties": {
        "error_msg": {
          "description": "错误信息",
          "type": "string",
          "example": "Invalid capacity parameter in the request.",
          "maxLength": 1024
        },
        "error_code": {
          "description": "错误码",
          "type": "string",
          "example": "DCS.4062",
          "maxLength": 9
        },
        "error_ext_msg": {
          "description": "扩展错误信息(暂未使用,赋值为null)",
          "type": "string",
          "example": null,
          "maxLength": 1024
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dcs.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
