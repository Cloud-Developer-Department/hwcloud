{
  "name": "ShowIpWhitelist",
  "summary": "查询指定实例的IP白名单",
  "tags": "IP白名单管理",
  "productshort": "DCS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/instance/{instance_id}/whitelist": {
      "get": {
        "tags": [
          "IP白名单管理"
        ],
        "summary": "查询指定实例的IP白名单",
        "description": "查询指定实例的IP白名单。",
        "operationId": "ShowIpWhitelist",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "a4d31cb6-3d72-4fdc-8ec9-6e3a41e47f71"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "5560df16-cebf-4473-95c4-d1b573c16e79"
          }
        ],
        "responses": {
          "200": {
            "description": "查询实例白名单成功。",
            "schema": {
              "$ref": "#/definitions/ModifyIpWhitelistBody"
            },
            "examples": {
              "application/json": {
                "instance_id": "5560df16-cebf-4473-95c4-d1b573c16e79",
                "enable_whitelist": true,
                "whitelist": {
                  "group_name": "test001",
                  "ip_list": [
                    "10.10.10.1",
                    "10.10.10.2"
                  ]
                }
              }
            }
          }
        },
        "x-constraint": "",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-produc-type": "dcs",
        "x-name": "查询指定实例的IP白名单",
        "x-scope": "",
        "x-request-examples-url-1": "GET https://{dcs_endpoint}/v2/{project_id}/instance/{instance_id}/whitelist"
      }
    }
  },
  "definitions": {
    "ModifyIpWhitelistBody": {
      "required": [
        "enable_whitelist",
        "whitelist"
      ],
      "description": "设置IP白名单结构体",
      "properties": {
        "instance_id": {
          "type": "string",
          "description": "实例ID",
          "example": "5560df16-cebf-4473-95c4-d1b573c16e79"
        },
        "enable_whitelist": {
          "type": "boolean",
          "description": "是否启用白名单(true/false)。",
          "enum": [
            true,
            false
          ],
          "example": true
        },
        "whitelist": {
          "type": "array",
          "description": "IP白名单分组列表。",
          "items": {
            "$ref": "#/definitions/Whitelist"
          }
        }
      }
    },
    "Whitelist": {
      "description": "IP白名单分组列表结构体",
      "properties": {
        "group_name": {
          "type": "string",
          "description": "白名单分组名称,每个实例支持创建4个分组。",
          "example": "test001"
        },
        "ip_list": {
          "type": "array",
          "description": "白名单分组下的IP列表,每个实例最多可以添加20个IP地址/地址段。如果有多个,可以用逗号分隔。不支持的IP和地址段:0.0.0.0和0.0.0.0/0",
          "items": {
            "type": "string"
          },
          "example": [
            "192.168.1.135",
            "192.168.1.136"
          ]
        }
      },
      "required": [
        "group_name",
        "ip_list"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "dcs.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}