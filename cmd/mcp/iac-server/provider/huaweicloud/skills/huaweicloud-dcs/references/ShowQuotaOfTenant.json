  "definitions": {
    "Resources": {
      "properties": {
        "unit": {
          "description": "资源的计数单位。\n- 当type为instance时,无单位。\n- 当type为ram时,单位为GB。",
          "type": "string",
          "example": "GB"
        },
        "min": {
          "description": "- 当type为instance时,表示可申请实例配额的最小值。\n- 当type为ram时,表示可申请内存配额的最小值。",
