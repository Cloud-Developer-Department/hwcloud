          "format": "uuid",
          "minLength": 0,
          "maxLength": 36
        },
        "status": {
          "description": "扫描任务状态",
          "enum": [
            "waiting",
            "running",
            "success",
            "failed"
          ],
          "type": "string",
          "example": "success"
        },
        "scan_type": {
          "description": "扫描方式",
          "enum": [
            "manual",
            "auto"
          ],
          "type": "string",
          "example": "manual"
