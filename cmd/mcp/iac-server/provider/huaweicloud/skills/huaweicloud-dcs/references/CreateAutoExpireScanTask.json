        "created_at": {
          "description": "扫描任务创建时间,格式为:\"2020-06-15T02:21:18.669Z\"",
          "type": "string",
          "example": "2020-06-15T02:21:18.669Z"
        },
        "started_at": {
          "description": "扫描任务开始时间,格式为:\"2020-06-15T02:21:18.669Z\"(创建扫描任务时此值为null,不返回)",
