  "definitions": {
    "DeletableReplicationResponse": {
      "description": "获取删除集群副本时可选的可用区以及可选的保留节点的数据结构。",
      "properties": {
        "check_result": {
          "type": "boolean",
          "description": "是否有可供选择的副本组进行删除。",
          "example": "true"
        },
        "available_zone": {
          "type": "string",
          "description": "可选的可用区ID列表",
          "example": "d539378ec1314c85b76fefa3f7071458,9f1c5806706d4c1fb0eb72f0a9b18c77"
        },
        "replication_list": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReplicationInfo"
          },
          "description": "可选的保留节点列表"
        }
      }
    },
    "ErrorResponse": {
      "description": "错误响应体",
      "properties": {
        "error_msg": {
          "description": "错误信息",
          "type": "string",
          "example": "Invalid capacity parameter in the request.",
          "maxLength": 1024
        },
        "error_code": {
          "description": "错误码",
          "type": "string",
          "example": "DCS.4062",
          "maxLength": 9
        },
        "error_ext_msg": {
          "description": "扩展错误信息(暂未使用,赋值为null)",
          "type": "string",
          "example": null,
          "maxLength": 1024
        }
      }
    },
    "ReplicationInfo": {
      "type": "object",
      "properties": {
        "replication_id": {
          "type": "string",
          "description": "副本ID",
          "example": "29d667e5"
        },
        "node_id": {
          "type": "string",
          "description": "节点ID",
          "example": "0af675529ee4"
        },
        "replication_ip": {
          "type": "string",
          "description": "副本IP",
          "example": "192.168.0.1"
        },
        "group_id": {
          "type": "string",
          "description": "组ID",
          "example": "a54d19fa"
        },
        "group_name": {
          "type": "string",
          "description": "组名称",
          "example": "test"
        },
        "available_zone": {
          "type": "string",
          "description": "可用区",
          "example": "cn-north-7c"
        }
