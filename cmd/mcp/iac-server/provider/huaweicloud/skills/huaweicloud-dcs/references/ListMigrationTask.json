  "definitions": {
    "MigrationTaskList": {
      "description": "查询迁移任务列表",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "迁移任务ID。",
          "example": "ff8080816e255ad4016e2682e0b700a5"
        },
        "task_name": {
          "type": "string",
          "description": "迁移任务名称。",
          "example": "dcs-migration"
        },
        "status": {
          "type": "string",
          "description": "迁移任务状态,这个字段的值包括:SUCCESS(成功), FAILED(失败), MIGRATING(迁移中),TERMINATED(已结束)。",
          "enum": [
            "SUCCESS",
            "FAILED",
            "MIGRATING",
            "TERMINATED"
          ],
          "example": "MIGRATING"
        },
        "migration_type": {
          "type": "string",
          "description": "迁移任务类型,包括备份文件导入和在线迁移两种类型。",
          "enum": [
            "backupfile_import",
            "online_migration"
          ],
          "example": "online_migration"
        },
        "migration_method": {
          "type": "string",
          "description": "迁移方式,包括全量迁移和增量迁移两种类型。",
          "enum": [
            "full_amount_migration",
            "incremental_migration"
          ],
          "example": "full_amount_migration"
        },
        "ecs_tenant_private_ip": {
          "type": "string",
          "description": "迁移机租户侧私有IP,与目的/源redis私有IP处于同VPC,可将此IP加入白名单。",
          "example": "192.168.0.12"
        },
        "data_source": {
          "type": "string",
          "description": "源redis地址,格式为ip:port或者桶名。",
          "example": "192.168.0.200:6379"
        },
        "source_instance_name": {
          "type": "string",
          "description": "源实例名称,若自建redis则为空。",
          "example": "migration-resource"
        },
        "source_instance_id": {
          "type": "string",
          "description": "源实例ID,若自建redis则为空。",
          "example": "132e0017-715b-4556-930a-95c7db7e8f7a"
        },
        "target_instance_addrs": {
          "type": "string",
          "description": "目标redis地址,格式为ip:port。",
          "example": "192.168.0.153:6379"
        },
        "target_instance_name": {
          "type": "string",
          "description": "目标实例名称。",
          "example": "migration-target"
        },
        "target_instance_id": {
          "type": "string",
          "description": "目标实例ID。",
          "example": "eb1a8d1c-9ea6-4fcd-ac43-c3d3c2493f06"
        },
        "created_at": {
          "type": "string",
          "description": "迁移任务创建时间。",
          "example": "2021-06-16T06:12:55.508Z"
        },
        "description": {
          "description": "迁移任务描述。",
          "type": "string"
        },
        "source_instance_status": {
          "description": "源实例状态,若自建redis则为空。",
          "type": "string"
        },
        "target_instance_status": {
          "description": "目标实例状态。",
          "type": "string"
        },
        "source_instance_subnet_id": {
