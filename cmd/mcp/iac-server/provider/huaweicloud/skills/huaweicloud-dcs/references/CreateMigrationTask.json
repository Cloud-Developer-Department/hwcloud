  "definitions": {
    "CreateMigrationTaskBody": {
      "required": [
        "task_name",
        "migration_type",
        "migration_method",
        "target_instance"
      ],
      "description": "创建数据迁移任务结构体",
      "properties": {
        "task_name": {
          "type": "string",
          "description": "迁移任务名称。",
          "example": "dcs-migration"
        },
        "description": {
          "type": "string",
          "description": "迁移任务描述。",
          "example": "创建数据迁移任务"
        },
        "migration_type": {
          "type": "string",
          "description": "迁移任务类型,包括备份文件导入和在线迁移两种类型。\n取值范围:\n- backupfile_import:表示备份文件导入\n- online_migration:表示在线迁移。",
          "enum": [
            "backupfile_import",
            "online_migration"
          ],
          "example": "online_migration"
        },
        "migration_method": {
          "type": "string",
          "description": "迁移方式,包括全量迁移和增量迁移两种类型。\n取值范围:\n- full_amount_migration:表示全量迁移。\n- incremental_migration:表示增量迁移。",
          "enum": [
            "full_amount_migration",
            "incremental_migration"
          ],
          "example": "full_amount_migration"
        },
        "backup_files": {
          "type": "object",
          "$ref": "#/definitions/BackupFilesBody",
          "description": "迁移任务类型为备份文件导入场景时的备份文件列表。"
        },
        "network_type": {
          "type": "string",
          "description": "迁移任务类型为在线迁移时,表示源Redis和目标Redis联通的网络类型,包括vpc和vpn两种类型。",
          "enum": [
            "vpc",
            "vpn"
          ],
          "example": "vpc"
        },
        "source_instance": {
          "type": "object",
          "$ref": "#/definitions/SourceInstanceBody",
          "description": "迁移任务类型为在线迁移场景时该参数为必填参数,表示源Redis信息。"
        },
        "target_instance": {
          "type": "object",
          "$ref": "#/definitions/TargetInstanceBody",
          "description": "表示目标Redis信息。"
        }
      }
    },
    "CreateMigrateTaskResponse": {
      "description": "创建数据迁移任务响应体",
      "properties": {
        "id": {
          "type": "string",
          "description": "迁移任务ID。",
          "example": "ff8080816e255ad4016e2682e0b700a5"
        },
        "name": {
          "type": "string",
          "description": "迁移任务名称。",
          "example": "dcs-migration"
        },
        "status": {
          "type": "string",
          "description": "迁移任务状态,这个字段的值包括:SUCCESS, FAILED, MIGRATING,TERMINATED",
          "enum": [
            "SUCCESS",
            "FAILED",
            "MIGRATING",
            "TERMINATED"
          ],
          "example": "MIGRATING"
        }
      }
    },
    "TargetInstanceBody": {
      "description": "目标实例信息。",
      "properties": {
        "id": {
          "type": "string",
          "description": "Redis实例ID(target_instance信息中必须填写)。",
          "example": "4cd5dbb8-aacd-4603-b817-3e97d48c7a20"
        },
        "name": {
          "type": "string",
          "description": "Redis实例名称(target_instance信息中填写)。",
          "example": "dcs-cdrc"
        },
        "password": {
          "type": "string",
          "description": "Redis密码,如果设置了密码,则必须填写。",
          "example": "xxxxxx"
        },
        "task_status": {
          "description": "任务状态。",
          "type": "string"
        },
        "ip": {
          "description": "Redis IP地址。",
          "type": "string"
        },
        "port": {
          "description": "Redis端口。",
          "type": "string"
        },
        "addrs": {
          "description": "Redis实例地址。",
          "type": "string"
        },
        "proxy_multi_db": {
          "description": "proxy实例是否开启了多DB。",
          "type": "boolean"
        },
        "db": {
          "description": "Redis数据库。",
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "SourceInstanceBody": {
      "description": "源实例信息。",
      "properties": {
        "addrs": {
          "type": "string",
          "description": "Redis实例名称(source_instance信息中填写)。",
          "example": "172.16.0.116:6379"
        },
        "password": {
          "type": "string",
          "description": "Redis密码,如果设置了密码,则必须填写。",
          "example": "xxxxxx"
        },
        "task_status": {
          "description": "任务状态。",
          "type": "string"
        },
        "id": {
          "description": "Redis实例ID。",
          "type": "string"
        },
        "ip": {
          "description": "Redis IP地址。",
          "type": "string"
        },
        "port": {
          "description": "Redis端口。",
          "type": "string"
        },
        "name": {
          "description": "Redis名称。",
          "type": "string"
        },
        "proxy_multi_db": {
          "description": "proxy实例是否开启了多DB。",
          "type": "boolean"
        },
        "db": {
          "description": "Redis数据库。",
          "type": "string"
        }
      },
      "required": [
        "addrs"
      ]
    },
    "BackupFilesBody": {
      "description": "备份文件列表的结构体",
      "properties": {
        "file_source": {
          "type": "string",
          "description": "数据来源,当前仅支持OBS桶方式,取值为:self_build_obs。",
          "enum": [
            "self_build_obs",
            "backup_record"
          ]
        },
        "bucket_name": {
          "type": "string",
          "description": "OBS桶名。"
        },
        "files": {
          "type": "array",
          "description": "导入的备份文件文件列表。",
          "items": {
            "$ref": "#/definitions/Files",
            "type": "object"
          }
        },
        "backup_id": {
          "type": "string",
          "description": "备份记录ID,数据来源为备份记录时必须填写"
        }
      },
      "required": [
        "files"
      ]
    },
    "Files": {
      "description": "导入的备份文件文件列表。",
      "properties": {
        "file_name": {
          "type": "string",
          "description": "备份文件名。"
        },
        "size": {
          "type": "string",
          "description": "文件大小(单位:Byte)。"
        },
        "update_at": {
          "type": "string",
          "description": "文件最后修改时间(格式YYYY-MM-DD HH:MM:SS)。"
        }
      },
      "required": [
        "file_name"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
