{
  "name": "ShowQuotas",
  "summary": "查询配额",
  "tags": "配额管理",
  "productshort": "ER",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/enterprise-router/quotas": {
      "get": {
        "tags": [
          "QuotaManager"
        ],
        "summary": "查询配额",
        "description": "查询租户各类资源的使用情况,如企业路由器的使用量,VPC连接的使用量等。",
        "operationId": "ShowQuotas",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectIdInPath"
          },
          {
            "name": "type",
            "in": "query",
            "description": "支持过滤的配额类型:\n- er_instance: 企业路由器实例的配额和使用量\n- dc_attachment: 云专线网关连接的配额和使用量\n- vpc_attachment: VPC连接的配额和使用量\n- vpn_attachment: VPN网关连接的配额和使用量\n- peering_attachment:云连接实例连接的配额和使用量\n- can_attachment: 智能接入网关连接的配额和使用量\n- route_table: 路由表的配额和使用量\n- static_route: 静态路由的配额和使用量\n- vpc_er: 每个vpc可以接入的企业路由器数量和当前使用量\n- flow_log: 每个连接可以创建的流日志数量",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "erId",
            "in": "query",
            "description": "企业路由器ID",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/UUIDS"
            }
          },
          {
            "name": "routeTableId",
            "in": "query",
            "description": "路由表ID",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/UUIDS"
            }
          },
          {
            "name": "vpcId",
            "in": "query",
            "description": "VPC ID",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/UUIDS"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询配额成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowQuotasResponseBody"
                },
                "example": {
                  "quotas": [
                    {
                      "quota_key": "er_instance",
                      "quota_limit": 1,
                      "used": 0,
                      "unit": "count"
                    }
                  ]
                }
              }
            }
          }
        },
        "x-huawei-security": {
          "epsAction": "list",
          "pdpKey": "er:quotas:list",
          "enableEProject": true
        },
        "x-request-examples-description-1": "查询配额信息",
        "x-request-examples-url-1": "GET https://{erouter_endpoint}/v3/08d5a9564a704afda6039ae2babbef3c/enterprise-router/quotas",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-open-region-cloud": "hc,hk,dt,ctc"
      }
    }
  },
  "definitions": null,
  "version": "3.0.1",
  "parameters": null,
  "host": "er.ae-ad-1.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v3",
  "method": "get",
  "uri": null
}