{
  "name": "CreateResourceTag",
  "summary": "创建资源标签",
  "tags": "标签",
  "productshort": "ER",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/{resource_type}/{resource_id}/tags": {
      "post": {
        "tags": [
          "Tags"
        ],
        "summary": "创建资源标签",
        "description": "为特定类型的资源创建标签。",
        "operationId": "CreateResourceTag",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectIdInPath"
          },
          {
            "name": "resource_id",
            "in": "path",
            "description": "资源ID",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
              "type": "string"
            }
          },
          {
            "name": "resource_type",
            "in": "path",
            "description": "标签资源类型:\n- instance: 企业路由器实例\n- route-table: 路由表\n- vpc-attachment: VPC连接\n- vgw-attachment: 虚拟网关连接\n- peering-attachment: 对等连接(Peering)连接\n- vpn-attachment: VPN网关连接\n- attachments: 所有连接类型",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string",
              "enum": [
                "instance",
                "route-table",
                "vpc-attachment",
                "dgw-attachment",
                "vgw-attachment",
                "peering-attachment",
                "vpn-attachment",
                "can-attachment",
                "ecn-attachment",
                "gdgw-attachment",
                "connect-attachment",
                "cfw-attachment",
                "attachments"
              ]
            }
          }
        ],
        "requestBody": {
          "description": "创建资源标签请求体",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateResourceTagRequestBody"
              },
              "example": {
                "tag": {
                  "key": "key1",
                  "value": "value1"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "deprecated": false,
        "x-constraint": "- 一个资源上最多有10个标签。\n- 此接口为幂等接口。\n- 创建时,如果创建的标签已经存在(key相同),则覆盖。",
        "x-huawei-security": {
          "epsAction": "create",
          "pdpKey": "er:tags:create",
          "enableEProject": true
        },
        "x-request-examples-description-1": "为企业路由器资源添加标签,标签值为key1,标签键为value1",
        "x-request-examples-url-1": "POST https://{erouter-endpoint}/v3/cfa563efb77d4b6d9960781d82530fd8/instance/3320166e-b937-40cc-a35c-02cd3f2b3ee2/tags",
        "x-request-examples-1": {
          "tag": {
            "key": "key1",
            "value": "value1"
          }
        },
        "x-codegen-request-body-name": "CreateResourceTagRequestBody",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-open-region-cloud": "hc,hk,dt,ctc"
      }
    }
  },
