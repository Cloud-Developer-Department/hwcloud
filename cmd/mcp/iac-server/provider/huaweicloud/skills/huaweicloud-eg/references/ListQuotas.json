{
  "name": "ListQuotas",
  "summary": "查询配额",
  "tags": "配额管理",
  "productshort": "EG",
  "region_id": "na-mexico-1",
  "paths": {
    "/v1/{project_id}/quotas": {
      "get": {
        "x-api-framework": "RestfulAPI",
        "x-is-open-doc": "Y",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk",
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "配额管理"
        ],
        "operationId": "ListQuotas",
        "summary": "查询配额",
        "description": "查询当前租户的配额,未特殊配置过的会返回默认配额。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/IamToken"
          },
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/QueryQuotaType"
          }
        ],
        "responses": {
          "200": {
            "description": "配额",
            "schema": {
              "$ref": "#/definitions/QuotaResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "QuotaResp": {
      "properties": {
        "quotas": {
          "$ref": "#/definitions/QuotaResourceResp",
          "description": "配额描述"
        }
      }
    },
    "QuotaItemInfo": {
      "properties": {
        "name": {
          "type": "string",
          "description": "名称"
        },
        "type": {
          "type": "string",
          "description": "配额类型",
          "enum": [
            "CHANNEL",
            "CHANNEL_SUBSCRIPTION",
            "SOURCE",
            "SUBSCRIPTION",
            "SUBSCRIPTION_TARGET",
            "SCHEMA",
            "SCHEMA_VERSION",
            "CONNECTION",
            "PRIVATE_ENDPOINT",
            "SOURCE_RABBITMQ",
            "SOURCE_ROCKETMQ"
          ]
        },
        "max": {
          "type": "integer",
          "description": "配额最大值"
        },
        "min": {
          "type": "integer",
          "description": "配额最小值"
        },
        "quota": {
          "type": "integer",
          "description": "当前租户的配额"
        },
        "used": {
          "type": "integer",
          "description": "当前租户已使用的配额"
        }
      }
    },
    "QuotaResourceResp": {
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/QuotaItemInfo"
          },
          "description": "错误描述"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "租户资源空间ID",
      "required": true,
      "type": "string",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    },
    "QueryQuotaType": {
      "name": "type",
      "in": "query",
      "description": "指定查询资源类型的配额",
      "required": false,
      "type": "string",
      "enum": [
        "CHANNEL",
        "CHANNEL_SUBSCRIPTION",
        "SOURCE",
        "SUBSCRIPTION",
        "SUBSCRIPTION_TARGET",
        "SCHEMA",
        "SCHEMA_VERSION",
        "CONNECTION",
        "PRIVATE_ENDPOINT",
        "SOURCE_RABBITMQ",
        "SOURCE_ROCKETMQ"
      ],
      "x-example": "CHANNEL"
    }
  },
  "host": "eg.na-mexico-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}