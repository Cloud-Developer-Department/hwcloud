        "tags": [
          "事件订阅管理"
        ],
        "operationId": "ExecuteSubscriptionOperation",
        "summary": "操作事件订阅",
        "description": "操作事件订阅,支持启用、禁用。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/IamToken"
          },
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "创建订阅时所使用的企业项目id",
            "required": false,
            "type": "string",
            "x-example": "092e1243e88146768798b0e8c9933192"
          },
          {
            "name": "OperateSubscriptionRequestBody",
            "in": "body",
            "description": "operate subscription request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SubscriptionOperateReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Demo Information",
            "schema": {
              "$ref": "#/definitions/SubscriptionOperateResp"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "This field is the request ID number for task tracking. Format is request_uuid-timestamp-hostname."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "SubscriptionOperateResp": {
      "type": "object",
      "properties": {
        "failed_count": {
          "type": "integer",
          "description": "操作失败的订阅个数",
          "example": 0
        },
        "events": {
          "type": "array",
          "description": "事件列表",
          "items": {
            "type": "object",
            "properties": {
              "error_code": {
                "type": "string",
                "description": "失败的错误码"
              },
              "error_msg": {
                "type": "string",
                "description": "失败的原因"
              },
              "subscription_id": {
                "type": "string",
                "description": "订阅ID"
              }
            }
          }
        }
      },
      "example": {
        "failed_count": 0,
        "events": [
          {
            "event_id": "23709d68-54d5-423b-a6be-03302e893152"
          }
        ]
      }
    },
    "SubscriptionOperateReq": {
      "type": "object",
      "description": "订阅批量操作请求",
      "properties": {
        "subscription_ids": {
          "type": "array",
          "description": "订阅对象ID列表,单次批量操作最多支持10个订阅",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string"
          },
          "example": [
            "23709d68-54d5-423b-a6be-03302e893152"
          ]
        },
        "operation": {
          "type": "string",
          "description": "操作类型",
          "enum": [
            "DISABLE",
            "ENABLE"
          ],
          "example": "DISABLE"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "租户资源空间ID",
      "required": true,
      "type": "string",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    }
  },
  "host": "eg.na-mexico-1.myhuaweicloud.com",
