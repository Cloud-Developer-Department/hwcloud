{
  "name": "CreateAgencies",
  "summary": "创建服务委托",
  "tags": "服务委托管理",
  "productshort": "EG",
  "region_id": "cn-north-9",
  "paths": {
    "/v1/{project_id}/service-agencies": {
      "post": {
        "x-api-framework": "RestfulAPI",
        "x-is-open-doc": "Y",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk",
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "服务委托管理"
        ],
        "summary": "创建服务委托",
        "description": "按照业务场景,一键创建服务委托授权。",
        "operationId": "CreateAgencies",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/IamToken"
          },
          {
            "name": "AgencyCreateRequestBody",
            "in": "body",
            "required": true,
            "description": "创建请求",
            "schema": {
              "$ref": "#/definitions/AgencyCreateReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "详情",
            "schema": {
              "$ref": "#/definitions/AgencyOperateResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "AgencyCreateReq": {
      "description": "服务委托创建请求",
      "properties": {
        "type": {
          "type": "string",
          "description": "服务委托应用场景类型",
          "enum": [
            "TARGET_CONNECTION",
            "CUSTOM_SOURCE_RABBITMQ",
            "EG_RESTORE_AGENCY"
          ],
          "example": "TARGET_CONNECTION"
        }
      },
      "required": [
        "type"
      ]
    },
    "AgencyOperateResp": {
      "properties": {
        "agencies": {
          "type": "array",
          "description": "服务委托授权记录。",
          "items": {
            "type": "string",
            "description": "服务委托授权名称",
            "example": "EG_DELEGATE_FG_AGENCY"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "租户资源空间ID",
      "required": true,
      "type": "string",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    }
  },
  "host": "eg.cn-north-9.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
