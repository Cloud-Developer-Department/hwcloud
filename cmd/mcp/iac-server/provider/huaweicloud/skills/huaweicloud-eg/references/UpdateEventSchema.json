{
  "name": "UpdateEventSchema",
  "summary": "更新自定义事件模型",
  "tags": "事件模型管理",
  "productshort": "EG",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/schemas/{schema_id}": {
      "put": {
        "x-api-framework": "RestfulAPI",
        "x-is-open-doc": "Y",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk",
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "事件模型管理"
        ],
        "operationId": "UpdateEventSchema",
        "summary": "更新自定义事件模型",
        "description": "更新自定义事件模型定义",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/IamToken"
          },
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/SchemaId"
          },
          {
            "name": "UpdateEventSchemaRequestBody",
            "in": "body",
            "required": true,
            "description": "update schema request",
            "schema": {
              "$ref": "#/definitions/CustomizeSchemaUpdateReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Information",
            "schema": {
              "$ref": "#/definitions/CustomizeSchemaInfo"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "This field is the request ID number for task tracking. Format is request_uuid-timestamp-hostname."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CustomizeSchemaUpdateReq": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "事件模型描述",
          "maxLength": 255,
          "example": "文件上传事件模型定义"
        },
        "compatibility": {
          "type": "string",
          "description": "事件模型兼容性",
          "enum": [
            "NONE"
          ],
          "example": "NONE"
        }
      }
    },
    "CustomizeSchemaInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "事件模型ID",
          "example": "2a0ee4f2-78a4-4122-80af-7455e37f64ee"
        },
        "name": {
          "type": "string",
          "description": "事件模型名称,租户下唯一",
          "example": "file.upload"
        },
        "description": {
          "type": "string",
          "description": "事件模型描述",
          "example": "文件上传事件模型定义"
        },
        "compatibility": {
          "type": "string",
          "description": "事件模型兼容性",
          "enum": [
            "NONE"
          ],
          "example": "NONE"
        },
        "provider_type": {
          "type": "string",
          "description": "提供方类型,OFFICIAL:官方事件源;CUSTOM:自定义事件源",
          "enum": [
            "OFFICIAL",
            "CUSTOM"
          ],
          "example": "CUSTOM"
        },
        "format": {
          "type": "string",
          "description": "事件模型格式",
          "example": "OPENAPI_3_0"
        },
        "number_of_versions": {
          "type": "integer",
          "description": "事件模型版本数",
          "example": 1
        },
        "created_time": {
          "type": "string",
          "description": "创建时间",
          "example": "2021-12-09 09:00:00"
        },
        "updated_time": {
          "type": "string",
          "description": "更新时间",
          "example": "2021-12-09 09:00:00"
        },
        "version": {
          "type": "integer",
          "description": "事件模型当前版本号",
          "example": 1
        },
        "definition": {
          "type": "string",
          "description": "事件模型内容定义",
          "example": "{\"$schema\": \"http://json-schema.org/draft-06/schema#\",\"title\": \"fileUpload\",\"definitions\": {\"fileUpload\": {\"properties\": {\"fileName\": {\"type\": \"string\"},\"fileSize\": {\"type\": \"integer\"}},\"required\": [\"foo\",\"bar\"],\"type\": \"object\"}},\"properties\": {\"specversion\": {\"type\": \"string\"},\"id\": {\"type\": \"string\"},\"type\": {\"type\": \"string\"},\"source\": {\"type\": \"string\"},\"subject\": {\"type\": \"string\"},\"datacontenttype\": {\"type\": \"string\"},\"dataschema\": {\"type\": \"string\"},\"time\": {\"format\": \"date-time\",\"type\": \"string\"},\"data\": {\"$ref\": \"#/definitions/fileUpload\"}},\"required\": [\"id\",\"source\",\"time\",\"type\",\"specversion\"],\"type\": \"object\"}"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "租户资源空间ID",
      "required": true,
      "type": "string",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "SchemaId": {
      "name": "schema_id",
      "in": "path",
      "description": "指定查询的事件模型ID",
      "required": true,
      "type": "string",
      "x-example": "32411755cbde403d8655151bc07fd4c8"
    },
    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    }
  },
  "host": "eg.cn-east-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
}