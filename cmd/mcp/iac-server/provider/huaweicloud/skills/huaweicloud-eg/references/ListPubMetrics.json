{
  "name": "ListPubMetrics",
  "summary": "查询事件通道监控指标数据",
  "tags": "监控指标管理",
  "productshort": "EG",
  "region_id": "cn-north-9",
  "paths": {
    "/v1/{project_id}/metrics/pub": {
      "get": {
        "x-request-examples-url-1": "GET https://{eg_endpoint}/v1/{project_id}/metrics/pub",
        "x-request-examples-description-1": "按平均统计方式查询事件通道监控指标数据",
        "x-request-examples-text-1": "filter:AVG",
        "x-request-examples-1": "filter:AVG",
        "x-api-framework": "RestfulAPI",
        "x-is-open-doc": "Y",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk",
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "监控指标管理"
        ],
        "operationId": "ListPubMetrics",
        "summary": "查询事件通道监控指标数据",
        "description": "查询事件通道监控指标数据。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/IamToken"
          },
          {
            "$ref": "#/parameters/QueryMericsFilter"
          },
          {
            "$ref": "#/parameters/QueryMericsPeriod"
          },
          {
            "$ref": "#/parameters/QueryMericsStartTime"
          },
          {
            "$ref": "#/parameters/QueryMericsEndTime"
          },
          {
            "$ref": "#/parameters/QueryMericsChannelId"
          },
          {
            "$ref": "#/parameters/QueryMericsProviderType"
          },
          {
            "$ref": "#/parameters/QueryMericsSourceName"
          }
        ],
        "responses": {
          "200": {
            "description": "事件通道监控指标数据列表",
            "schema": {
              "$ref": "#/definitions/EventPubMetricsResp"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "EventPubMetricsItem": {
      "properties": {
        "event_size": {
          "type": "integer",
          "format": "int64",
          "description": "事件大小"
        },
        "timestamp": {
          "type": "integer",
          "format": "int64",
          "description": "时间戳"
        },
        "num": {
          "type": "integer",
          "format": "int64",
          "description": "调用数"
        },
        "success_num": {
          "type": "integer",
          "format": "int64",
          "description": "调用成功数"
        },
        "process_time": {
          "type": "integer",
          "format": "int64",
          "description": "处理时间"
        },
        "invoke_time": {
          "type": "integer",
          "format": "int64",
          "description": "调用时间"
        }
      },
      "type": "object",
      "description": "事件通道监控指标数据"
    },
    "EventPubMetricsResp": {
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "总数",
          "example": 1,
          "minimum": 0,
          "maximum": 100
        },
        "result": {
          "type": "array",
          "description": "指标列表",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/EventPubMetricsItem"
          }
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "租户资源空间ID",
      "required": true,
      "type": "string",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    },
    "QueryMericsPeriod": {
      "name": "period",
      "in": "query",
      "required": false,
      "default": "1",
      "type": "integer",
      "format": "int32",
      "allowEmptyValue": true,
      "description": "指标数据统计周期,单位minute。"
    },
    "QueryMericsFilter": {
      "name": "filter",
      "in": "query",
      "required": false,
      "allowEmptyValue": true,
      "default": "AVG",
      "enum": [
        "AVG",
        "MIN",
        "MAX"
      ],
      "type": "string",
      "description": "指标数据统计方式"
    },
    "QueryMericsChannelId": {
      "name": "channel_id",
      "in": "query",
      "required": true,
      "type": "string",
      "description": "事件通道id",
      "allowEmptyValue": false
    },
    "QueryMericsProviderType": {
      "name": "provider_type",
      "in": "query",
      "required": false,
      "allowEmptyValue": true,
      "enum": [
        "OFFICIAL",
        "CUSTOM"
      ],
      "type": "string",
      "description": "事件目标类型/事件通道类型"
    },
    "QueryMericsStartTime": {
      "name": "start_time",
      "in": "query",
      "required": true,
      "type": "integer",
      "format": "int64",
      "description": "获取指标数据起始时间",
      "allowEmptyValue": false
    },
    "QueryMericsSourceName": {
      "name": "source_name",
      "in": "query",
      "required": false,
      "allowEmptyValue": true,
      "type": "string",
      "description": "事件源名称"
    },
    "QueryMericsEndTime": {
      "name": "end_time",
      "in": "query",
      "required": false,
      "allowEmptyValue": true,
      "type": "integer",
      "format": "int64",
      "description": "获取指标数据结束时间"
    }
  },
  "host": "eg.cn-north-9.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}