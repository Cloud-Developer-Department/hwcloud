          "name": {
            "type": "string",
            "description": "目标参数名称",
            "minLength": 1,
            "maxLength": 128,
            "example": "urn"
          },
          "label": {
            "type": "string",
            "description": "目标参数名称展示说明",
            "example": "函数URN",
            "maxLength": 255
          },
          "metadata": {
            "type": "object",
            "description": "参数展示元数据,比如是否必选,输入框类型等等"
          }
        }
      }
    },
    "CatalogTargetInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "事件目标分类ID",
          "example": "3a0ee4f3-78a4-4123-80a3-7455e37f64e3"
        },
        "name": {
          "type": "string",
          "description": "事件目标分类名称",
          "minLength": 1,
          "maxLength": 128,
          "example": "hc.functionGraph"
        },
        "label": {
          "type": "string",
          "description": "事件目标分类名称展示说明",
          "example": "函数云服务",
          "maxLength": 255
        },
        "description": {
          "type": "string",
          "description": "事件目标分类描述",
          "example": "函数云服务",
          "maxLength": 512
        },
        "provider_type": {
          "type": "string",
          "description": "提供方类型,OFFICIAL:官方云服务事件目标;CUSTOM:第三方事件目标",
          "enum": [
            "OFFICIAL",
            "CUSTOM"
          ],
          "example": "OFFICIAL"
        },
        "parameters": {
          "$ref": "#/definitions/CatalogTargetParameters"
        },
        "created_time": {
          "type": "string",
          "description": "创建UTC时间",
          "example": "2021-12-09 09:00:00"
        },
        "updated_time": {
          "type": "string",
          "description": "更新UTC时间",
          "example": "2021-12-09 09:00:00"
        }
      }
    },
    "CatalogTargetList": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "description": "总数",
          "minimum": 0,
          "maximum": 100,
          "example": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "本页数量",
          "example": 1
        },
        "items": {
          "type": "array",
          "description": "对象列表",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/CatalogTargetInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "租户资源空间ID",
      "required": true,
      "type": "string",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "QueryOffset": {
      "name": "offset",
      "in": "query",
      "description": "偏移量,表示从此偏移量开始查询,偏移量不能小于0",
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 0,
      "x-example": 1
    },
    "QuerySort": {
      "name": "sort",
      "in": "query",
      "description": "指定查询排序",
      "type": "string",
      "default": "created_time:DESC",
      "x-example": "created_time:DESC"
    },
    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    },
    "support_types": {
      "name": "support_types",
      "in": "query",
      "required": false,
      "description": "事件目标支持方式:事件订阅:SUBSCRIPTION、事件流:FLOW",
      "items": {
        "enum": [
          "SUBSCRIPTION",
          "FLOW"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "QueryTargetLabelFuzzy": {
      "name": "fuzzy_label",
      "in": "query",
      "description": "指定查询的事件目标标签,模糊匹配",
      "required": false,
      "type": "string",
      "x-example": "demo"
    },
    "QueryLimit": {
      "name": "limit",
      "in": "query",
      "description": "每页显示的条目数量,不能小于1或大于1000",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 15,
      "x-example": 15
    }
  },
  "host": "eg.na-mexico-1.myhuaweicloud.com",
  "base_path": "/",
