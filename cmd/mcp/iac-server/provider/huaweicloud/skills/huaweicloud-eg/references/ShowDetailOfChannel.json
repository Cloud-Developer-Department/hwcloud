  },
  "definitions": {
    "ChannelInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "通道ID",
          "example": "bd14144e-8f3c-43d6-bdfd-bf09b52c2b96"
        },
        "name": {
          "type": "string",
          "description": "通道名称",
          "example": "channel"
        },
        "description": {
          "type": "string",
          "description": "通道描述",
          "example": "first channel"
        },
        "provider_type": {
          "type": "string",
          "description": "通道提供方类型,OFFICIAL:官方事件通道;CUSTOM:自定义事件通道;PARTNER:伙伴事件通道",
          "enum": [
            "OFFICIAL",
            "CUSTOM",
            "PARTNER"
          ],
          "example": "CUSTOM"
        },
        "created_time": {
          "type": "string",
          "description": "创建UTC时间",
          "example": "2021-12-09 09:00:00"
        },
        "updated_time": {
          "type": "string",
          "description": "更新UTC时间",
          "example": "2021-12-09 09:00:00"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目id"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "租户资源空间ID",
      "required": true,
      "type": "string",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    },
    "ChannelId": {
      "name": "channel_id",
      "in": "path",
      "description": "指定查询的事件通道ID",
      "required": true,
      "type": "string",
      "x-example": "092e1243e88146768798b0e8c9933192"
    }
  },
  "host": "eg.cn-south-1.myhuaweicloud.com",
