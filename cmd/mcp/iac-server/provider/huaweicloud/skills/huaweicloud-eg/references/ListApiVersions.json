{
  "name": "ListApiVersions",
  "summary": "获取API版本列表",
  "tags": "API版本管理",
  "productshort": "EG",
  "region_id": "na-mexico-1",
  "paths": {
    "/": {
      "get": {
        "x-api-framework": "RestfulAPI",
        "x-is-open-doc": "Y",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk",
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "API版本管理"
        ],
        "operationId": "ListApiVersions",
        "summary": "获取API版本列表",
        "description": "获取服务支持的API版本列表。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/IamToken"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "$ref": "#/definitions/ApiVersions"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ApiVersions": {
      "type": "object",
      "properties": {
        "versions": {
          "type": "array",
          "description": "版本定义",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "版本号,如v1",
                "example": "v1"
              },
              "links": {
                "type": "array",
                "description": "url地址",
                "items": {
                  "type": "object",
                  "properties": {
                    "href": {
                      "type": "string",
                      "description": "href属性",
                      "example": "https://eg.cn-north-4.myhuaweicloud.com/v1"
                    },
                    "rel": {
                      "type": "string",
                      "description": "rel属性",
                      "example": "self"
                    }
                  }
                }
              },
              "version": {
                "type": "string",
                "description": "若该版本API支持微版本,则为支持的最大微版本号,如果不支持微版本,则为空",
                "example": ""
              },
              "min_version": {
                "type": "string",
                "description": "若该版本API支持微版本,则为支持的最小微版本号,如果不支持微版本,则为空",
                "example": ""
              },
              "status": {
                "type": "string",
                "description": "版本状态,支持CURRENT:推荐版本;SUPPORTED:老版本,仍支持使用;DEPRECATED:废弃版本,后续会删除",
                "enum": [
                  "CURRENT",
                  "SUPPORTED",
                  "DEPRECATED"
                ],
                "example": "CURRENT"
              },
              "updated": {
                "type": "string",
                "description": "版本发布UTC时间",
                "example": "2022-04-19T12:20:10Z"
              }
            }
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    }
  },
  "host": "eg.na-mexico-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}