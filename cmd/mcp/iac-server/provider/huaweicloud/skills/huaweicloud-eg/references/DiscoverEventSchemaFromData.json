              "description": "{\n  \"description\": \"通过事件数据发现事件模型的请求\",\n  \"type\": \"object\",\n  \"required\": [\n    \"event\"\n  ],\n  \"properties\": {\n    \"event\": {\n      \"description\": \"事件数据内容\",\n      \"type\": \"string\",\n      \"maxLength\": 1024,\n      \"example\": \"{\\\"fileName\\\": \\\"one.jpg\\\", \\\"fileSize\\\": 1048576}\"\n    },\n    \"format\": {\n      \"description\": \"事件模型格式类型\",\n      \"type\": \"string\",\n      \"default\": \"JSON_SCHEMA_DRAFT_6\",\n      \"enum\": [\n        \"JSON_SCHEMA_DRAFT_6\"\n      ]\n    }\n  }\n}",
              "format": "STREAM"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "列表",
            "schema": {
              "$ref": "#/definitions/CustomizeSchemaList"
            }
          }
        }
      }
    }
  },
