        },
        "created_time": {
          "type": "string",
          "description": "创建时间",
          "example": "2024-02-06 09:00:00"
        },
        "updated_time": {
          "type": "string",
          "description": "更新时间",
          "example": "2024-02-06 09:00:00"
        },
        "deleted_time": {
          "type": "string",
          "description": "删除时间",
          "example": "2024-02-06 09:00:00"
        }
      }
    }
