        },
        "event_source_id": {
          "type": "string",
          "description": "事件示例对应的事件源ID",
          "example": "09b6b4f6-b3ea-49a9-b0c5-e8ee8d9f19fc"
        },
        "event_source_name": {
          "type": "string",
          "description": "事件示例对应的事件源名称",
