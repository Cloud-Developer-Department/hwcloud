    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    },
    "QueryEventSourceId": {
      "name": "event_source_id",
      "in": "query",
      "description": "指定查询事件示例的事件源",
      "required": false,
      "type": "string",
      "x-example": "cf08862a-aac7-4f7f-b77f-2c1c4aafd345"
    },
    "QueryLimit": {
      "name": "limit",
      "in": "query",
      "description": "每页显示的条目数量,不能小于1或大于1000",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 15,
      "x-example": 15
