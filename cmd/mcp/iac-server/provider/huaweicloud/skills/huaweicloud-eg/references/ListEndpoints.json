          "type": "string",
          "description": "访问端点状态",
          "enum": [
            "CREATED",
            "CREATING",
            "CREATE_FAILED",
            "DELETE_FAILED"
          ],
          "example": "CREATED"
        },
        "error_info": {
          "$ref": "#/definitions/ErrorInfo"
        },
        "type": {
          "type": "string",
          "description": "访问端点类型",
          "enum": [
            "PRIVATE",
            "PUBLIC"
          ],
          "example": "PRIVATE"
        },
        "scalable": {
          "type": "boolean",
          "description": "是否可更新",
          "example": false
        },
        "created_time": {
          "type": "string",
          "description": "创建UTC时间",
          "example": "2021-12-09 09:00:00"
        },
        "updated_time": {
          "type": "string",
          "description": "更新UTC时间",
          "example": "2021-12-09 09:00:00"
        },
        "endpoints": {
          "type": "array",
          "description": "访问端点终端节点列表",
          "items": {
            "$ref": "#/definitions/EndpointConnection"
          }
        }
      }
