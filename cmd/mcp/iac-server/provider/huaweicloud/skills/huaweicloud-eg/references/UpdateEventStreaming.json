        },
        "access_key": {
          "type": "string",
          "description": "AccessKey",
          "maxLength": 128
        },
        "secret_key": {
          "type": "string",
          "description": "SecretKey",
          "maxLength": 128
        },
        "message_model": {
          "type": "string",
          "description": "订阅方式",
