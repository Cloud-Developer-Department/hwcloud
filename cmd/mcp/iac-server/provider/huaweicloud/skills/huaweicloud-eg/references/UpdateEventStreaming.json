          "enum": [
            "CLUSTERING",
            "BROADCASTING"
          ]
        },
        "addr_type": {
          "type": "string",
          "description": "接入点类型",
          "default": "PUBLIC",
          "enum": [
            "PUBLIC",
            "PRIVATE"
          ]
        },
        "addr": {
          "type": "string",
          "description": "地址",
          "maxLength": 256
