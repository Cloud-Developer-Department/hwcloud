        "sdk_url": {
          "type": "string",
          "description": "依赖SDK",
          "maxLength": 256
        },
        "consume_timeout": {
          "type": "integer",
          "format": "int32",
          "description": "消费超时时间",
          "default": 30000,
          "minimum": 1000,
          "maximum": 900000
        },
        "message_type": {
          "type": "string",
          "description": "消息类型",
          "enum": [
            "NORMAL"
          ]
