  "definitions": {
    "DeliverDetail": {
      "type": "object",
      "description": "投递详情",
      "properties": {
        "deliverTime": {
          "type": "string",
          "description": "投递时间   格式 yyyy/mm/dd xx:yy:zz"
        },
        "deliverStatus": {
          "type": "string",
          "description": "投递状态     SUCCESS Or  FAILED"
        },
        "deliverConsuming": {
          "type": "string",
          "description": "投递耗时,单位ms"
        },
        "deliverRspCode": {
          "type": "string",
          "description": "投递响应码"
        }
      }
    },
    "DeliverItem": {
      "type": "object",
      "properties": {
        "subscriptionId": {
          "type": "string",
          "description": "订阅ID,全局唯一"
        },
        "subscriptionName": {
          "type": "string",
          "description": "订阅名称"
        },
        "successCounts": {
          "type": "integer",
          "format": "int32",
          "description": "成功目标个数"
        },
        "failCounts": {
          "type": "integer",
          "format": "int32",
          "description": "失败目标个数"
        },
        "allDeliverTimes": {
          "type": "integer",
          "format": "int32",
          "description": "共投递次数"
        },
        "deliverTargetList": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DeliverTarget"
          },
          "description": "投递详情"
        }
      }
    },
    "DeliverTarget": {
      "type": "object",
      "properties": {
        "deliverTargetId": {
          "type": "string",
          "description": "投递目标ID,即事件目标ID"
        },
        "deliverTargetName": {
          "type": "string",
          "description": "投递目标名称,及事件目标名称"
        },
        "deliverStatus": {
          "type": "string",
          "description": "投递状态         SUCCESS Or  FAILED"
        },
        "deliverDetailList": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DeliverDetail"
          },
          "description": "考虑展示的个数    例如限制只展示最新三条"
        }
      }
    },
    "EventTraceRsp": {
      "type": "object",
      "description": "事件轨迹的返回体",
      "properties": {
        "eventId": {
          "type": "string",
          "description": "事件ID"
        },
        "eventSource": {
          "type": "string",
          "description": "事件源"
        },
        "eventType": {
          "type": "string",
          "description": "事件类型"
        },
        "receiveTime": {
          "type": "string",
          "description": "接收时间"
        },
        "channelId": {
          "type": "string",
          "description": "通道ID"
        },
        "channelName": {
          "type": "string",
          "description": "通道名称"
        },
        "deliverList": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DeliverItem"
          },
          "description": "事件投递列表"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "租户资源空间ID",
      "required": true,
      "type": "string",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    }
  },
