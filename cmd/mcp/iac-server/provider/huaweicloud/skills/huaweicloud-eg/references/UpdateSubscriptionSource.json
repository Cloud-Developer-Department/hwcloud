  "definitions": {
    "SubscriptionSource": {
      "type": "object",
      "required": [
        "name",
        "provider_type",
        "filter"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "订阅源ID,需保证全局唯一。指定ID的订阅源存在时则进行更新,否则进行创建;未指定时由系统自动生成。由小写字母、数字、中划线组成,必须字母或数字开头。",
          "minLength": 32,
          "maxLength": 64,
          "example": "3a0eeff2-78a4-4122-dfge-7ty5e37f64er"
        },
        "name": {
          "type": "string",
          "description": "订阅的事件源名称",
          "example": "HC.OBS",
          "maxLength": 128
        },
        "provider_type": {
          "type": "string",
          "description": "订阅的事件源的提供方类型",
          "enum": [
            "CUSTOM",
            "OFFICIAL",
            "PARTNER"
          ],
          "example": "OFFICIAL"
        },
        "detail": {
          "type": "object",
          "description": "订阅的事件源参数列表, 该字段序列化后总长度不超过1024字节",
          "example": {
            "name": "name"
          }
        },
        "filter": {
          "type": "object",
          "description": "订阅事件源的匹配过滤规则, 该字段序列化后总长度不超过2048字节",
          "example": {
            "data": {
              "count": [
                {
                  "op": "NumberIn",
                  "values": [
                    1,
                    2
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "SubscriptionSourceInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "订阅源ID",
          "example": "3a0eeff2-78a4-4122-dfge-7ty5e37f64er"
        },
        "name": {
          "type": "string",
          "description": "订阅的事件源名称",
          "example": "HC.OBS"
        },
        "provider_type": {
          "type": "string",
          "description": "订阅的事件源的提供方类型",
          "example": "OFFICIAL"
        },
        "detail": {
          "type": "object",
          "description": "订阅的事件源参数列表",
          "example": {
            "name": "name"
          }
        },
        "filter": {
          "type": "object",
          "description": "订阅事件源的匹配过滤规则",
          "example": {
            "data": {
              "count": [
                {
                  "op": "NumberIn",
                  "values": [
                    1,
                    2
                  ]
                }
              ]
            }
          }
        },
        "created_time": {
          "type": "string",
          "description": "创建时间",
          "example": "2021-12-09 09:00:00"
        },
        "updated_time": {
          "type": "string",
          "description": "更新时间",
          "example": "2021-12-09 09:00:00"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "租户资源空间ID",
      "required": true,
      "type": "string",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "SubscriptionId": {
      "name": "subscription_id",
