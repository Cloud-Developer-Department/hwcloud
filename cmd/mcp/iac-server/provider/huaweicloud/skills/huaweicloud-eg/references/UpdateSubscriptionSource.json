      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    },
    "SubscriptionSourceId": {
      "name": "source_id",
      "in": "path",
      "description": "事件订阅源ID",
      "required": true,
      "type": "string",
      "x-example": "9afe4b607c3a4e31dcd0eb7e89c9ba9f"
    }
  },
