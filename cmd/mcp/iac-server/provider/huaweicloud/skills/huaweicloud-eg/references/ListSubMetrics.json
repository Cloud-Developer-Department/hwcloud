  "definitions": {
    "EventSubMetricsResp": {
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "总数",
          "example": 1,
          "minimum": 0,
          "maximum": 100
        },
        "result": {
          "type": "array",
          "description": "指标数据列表",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/EventSubMetricsItem"
          }
        }
      },
      "type": "object"
    },
    "EventSubMetricsItem": {
      "properties": {
        "fail_num": {
          "type": "integer",
          "format": "int64",
          "description": "失败数"
        },
        "retry_success_num": {
          "type": "integer",
          "format": "int64",
          "description": "重试成功数"
        },
        "retry_fail_num": {
          "type": "integer",
          "format": "int64",
          "description": "重试失败数"
        },
        "retry_times": {
          "type": "integer",
          "description": "重试数"
        },
        "timestamp": {
          "type": "integer",
          "format": "int64",
          "description": "时间戳"
        },
        "num": {
          "type": "integer",
          "format": "int64",
          "description": "调用数"
        },
        "success_num": {
          "type": "integer",
          "format": "int64",
          "description": "调用成功数"
        },
        "process_time": {
          "type": "integer",
          "format": "int64",
          "description": "处理时间"
        },
        "invoke_time": {
          "type": "integer",
          "format": "int64",
          "description": "调用时间"
        }
      },
      "type": "object",
      "description": "事件订阅监控指标数据"
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "租户资源空间ID",
      "required": true,
      "type": "string",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    },
    "QueryMericsPeriod": {
      "name": "period",
      "in": "query",
      "required": false,
      "default": "1",
      "type": "integer",
      "format": "int32",
      "allowEmptyValue": true,
      "description": "指标数据统计周期,单位minute。"
    },
    "QueryMericsFilter": {
      "name": "filter",
      "in": "query",
      "required": false,
      "allowEmptyValue": true,
      "default": "AVG",
      "enum": [
        "AVG",
        "MIN",
        "MAX"
      ],
      "type": "string",
      "description": "指标数据统计方式"
    },
    "QueryMericsProviderType": {
      "name": "provider_type",
      "in": "query",
      "required": false,
      "allowEmptyValue": true,
      "enum": [
        "OFFICIAL",
        "CUSTOM"
      ],
      "type": "string",
      "description": "事件目标类型/事件通道类型"
    },
    "QueryMericsStartTime": {
      "name": "start_time",
      "in": "query",
      "required": true,
      "type": "integer",
      "format": "int64",
      "description": "获取指标数据起始时间",
      "allowEmptyValue": false
    },
    "QueryMericsSubscriptionId": {
      "name": "subscription_id",
      "in": "query",
      "required": true,
      "type": "string",
      "description": "事件订阅id",
      "allowEmptyValue": false
    },
    "QueryMericsEndTime": {
      "name": "end_time",
      "in": "query",
      "required": false,
      "allowEmptyValue": true,
      "type": "integer",
      "format": "int64",
      "description": "获取指标数据结束时间"
    },
    "QueryMericsTargetId": {
      "name": "target_id",
      "in": "query",
      "required": false,
      "allowEmptyValue": true,
      "type": "string",
      "description": "事件目标id"
    }
  },
  "host": "eg.cn-north-11.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
