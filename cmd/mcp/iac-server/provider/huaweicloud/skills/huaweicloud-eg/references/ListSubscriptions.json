        "x-request-examples-url-1": "/v1/{project_id}/subscriptions?channel_id=123",
        "x-request-examples-description-1": "查询指定事件通道为123的事件订阅列表",
        "x-api-framework": "RestfulAPI",
        "x-is-open-doc": "Y",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk",
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "事件订阅管理"
        ],
        "operationId": "ListSubscriptions",
        "summary": "查询事件订阅列表",
        "description": "查询事件订阅列表,支持指定事件通道。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/IamToken"
          },
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/QueryChannelId"
          },
          {
            "$ref": "#/parameters/QueryOffset"
          },
          {
            "$ref": "#/parameters/QueryLimit"
          },
          {
            "$ref": "#/parameters/QuerySort"
          },
          {
            "$ref": "#/parameters/QuerySubscriptionName"
          },
          {
            "$ref": "#/parameters/QuerySubscriptionNameFuzzy"
          },
          {
            "$ref": "#/parameters/QueryConnectionId"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "创建订阅时所使用的企业项目id",
            "required": false,
            "type": "string",
            "x-example": "092e1243e88146768798b0e8c9933192"
          }
        ],
        "responses": {
          "200": {
            "description": "事件订阅列表",
