{
  "name": "ListSubscriptions",
  "summary": "查询事件订阅列表",
  "tags": "事件订阅管理",
  "productshort": "EG",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/subscriptions": {
