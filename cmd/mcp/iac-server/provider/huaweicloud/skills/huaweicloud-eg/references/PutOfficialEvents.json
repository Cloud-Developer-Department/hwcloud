{
  "name": "PutOfficialEvents",
  "summary": "发布官方事件到事件通道",
  "tags": "事件管理",
  "productshort": "EG",
  "region_id": "sa-brazil-1",
  "paths": {
    "/v1/{project_id}/official/sources/{source_name}/events": {
      "post": {
        "x-api-framework": "RestfulAPI",
        "x-is-open-doc": "Y",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk",
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "事件管理"
        ],
        "operationId": "PutOfficialEvents",
        "summary": "发布官方事件到事件通道",
        "description": "发布官方事件到事件通道。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/IamToken"
          },
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/SourceName"
          },
          {
            "name": "PutOfficialEventsRequestBody",
            "in": "body",
            "description": "发布官方事件到事件通道",
            "schema": {
              "$ref": "#/definitions/PutEventsReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Information",
            "schema": {
              "$ref": "#/definitions/PutEventsResp"
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "This field is the request ID number for task tracking. Format is request_uuid-timestamp-hostname."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "PutEventsReq": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "maximum": 16,
          "minimum": 1,
          "items": {
            "$ref": "#/definitions/CloudEvents"
          }
        }
      }
    },
    "CloudEvents": {
      "type": "object",
      "description": "CloudEvents事件格式定义,参考https://github.com/cloudevents/spec/blob/v1.0.1/spec.md",
      "required": [
        "id",
        "source",
        "specversion",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "事件唯一标识串,同一个事件来源里必须唯一",
          "example": "r652c3f4e52c4eab89265b7a09ae6196"
        },
        "source": {
          "type": "string",
          "description": "事件来源上下文标识串,source+id可以唯一确定一个事件。采用URI-Reference格式,参考https://tools.ietf.org/html/rfc3986#section-4.1",
          "example": "https://example.com/storage/tenant/container"
        },
        "specversion": {
          "type": "string",
          "description": "CloudEvents协议版本,格式为major.minor",
          "example": "1.0"
        },
        "type": {
          "type": "string",
          "description": "事件类型",
          "example": "blob_created"
        },
        "datacontenttype": {
          "type": "string",
          "description": "事件内容格式,采用MIME格式,遵循RFC2046,参考https://tools.ietf.org/html/rfc2046",
          "example": "application/json"
        },
        "dataschema": {
          "type": "string",
          "description": "事件内容模型定义的URI,遵循RFC3986,参考https://tools.ietf.org/html/rfc3986#section-4.3",
          "example": "https://github.com/cloudevents/cloudevent.json"
        },
        "data": {
          "type": "object",
          "description": "事件的负载内容,采用datacontenttype字段指定的格式,内容字段遵循dataschema字段的描述",
          "example": {
            "name": "value"
          }
        },
        "time": {
          "type": "string",
          "format": "dateTime",
          "description": "事件发生UTC日期时间,相同来源的事件格式相同,遵循RFC3339,格式需满足2018-04-05T17:31:00Z,参考https://tools.ietf.org/html/rfc3339",
          "example": "2018-04-05T17:31:00Z"
        },
        "subject": {
          "type": "string",
          "description": "事件发生的主题或对象,用以标识哪个具体对象发生了当前事件",
          "example": "mynewfile.jpg"
        }
      }
    },
    "PutEventsResp": {
      "type": "object",
      "properties": {
        "failed_count": {
          "type": "integer",
          "description": "发布失败的事件个数",
          "example": 0
        },
        "events": {
          "type": "array",
          "description": "事件列表",
          "items": {
            "type": "object",
            "properties": {
              "error_code": {
                "type": "string",
                "description": "发布失败的错误码"
              },
              "error_msg": {
                "type": "string",
                "description": "发布失败的原因"
              },
              "event_id": {
                "type": "string",
                "description": "事件唯一标识串"
              }
            }
          }
        }
      },
      "example": {
        "failed_count": 0,
        "events": [
          {
            "event_id": "r652c3f4e52c4eab89265b7a09ae6196"
          }
        ]
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "租户资源空间ID",
      "required": true,
      "type": "string",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    },
    "SourceName": {
      "name": "source_name",
      "in": "path",
      "description": "事件源名称",
      "required": true,
      "type": "string",
      "x-example": "HC.MRS"
    }
  },
  "host": "eg.sa-brazil-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}