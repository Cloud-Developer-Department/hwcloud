        }
      }
    },
    "EndpointCreateReq": {
      "type": "object",
      "required": [
        "name",
        "vpc_id",
        "subnet_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "endpoint名称,租户下唯一,由字母、数字、点、下划线和中划线组成,必须以字母或数字开头",
          "example": "endpoint",
          "minLength": 1,
          "maxLength": 128
        },
        "vpc_id": {
          "type": "string",
          "description": "访问端点所在的VPC的ID",
          "example": "68bfbcc1-dff2-47e4-a9d4-332b9bc1b8de",
          "maxLength": 64
        },
        "subnet_id": {
          "type": "string",
          "description": "访问端点所在的子网的ID",
          "example": "84758cf5-9c62-43ae-a778-3dbd8370c0a4",
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "description": "描述",
          "maxLength": 255
        }
      }
    },
    "EndpointInfo": {
      "properties": {
        "id": {
          "type": "string",
          "description": "访问端点ID",
          "example": "23709d68-54d5-423b-a6be-03302e893152"
        },
        "name": {
          "type": "string",
          "description": "用户指定的访问端点名称",
          "example": "endpoint"
        },
        "vpc_id": {
          "type": "string",
          "description": "访问端点所在的VPC的ID",
          "example": "68bfbcc1-dff2-47e4-a9d4-332b9bc1b8de"
        },
        "subnet_id": {
          "type": "string",
          "description": "访问端点所在的子网的ID",
          "example": "84758cf5-9c62-43ae-a778-3dbd8370c0a4"
        },
        "domain": {
          "type": "string",
          "description": "访问域名",
          "example": "events.cn-north-4.myhuaweicloud.com"
        },
        "description": {
          "type": "string",
          "description": "描述",
          "example": "访问端点"
        },
        "status": {
          "type": "string",
          "description": "访问端点状态",
          "enum": [
            "CREATED",
            "CREATING",
            "CREATE_FAILED",
            "DELETE_FAILED"
          ],
          "example": "CREATED"
        },
        "error_info": {
          "$ref": "#/definitions/ErrorInfo"
        },
        "type": {
          "type": "string",
          "description": "访问端点类型",
          "enum": [
            "PRIVATE",
            "PUBLIC"
          ],
          "example": "PRIVATE"
        },
        "scalable": {
          "type": "boolean",
          "description": "是否可更新",
          "example": false
        },
        "created_time": {
          "type": "string",
          "description": "创建UTC时间",
          "example": "2021-12-09 09:00:00"
        },
        "updated_time": {
          "type": "string",
          "description": "更新UTC时间",
          "example": "2021-12-09 09:00:00"
        },
        "endpoints": {
          "type": "array",
          "description": "访问端点终端节点列表",
          "items": {
            "$ref": "#/definitions/EndpointConnection"
          }
        }
      }
    },
    "EndpointConnection": {
      "properties": {
        "endpoint_service_id": {
          "type": "string",
          "example": "a6f06041-5f8a-4985-bd95-3a333f65db7f",
          "description": "访问端点的服务ID"
        },
        "endpoint_service_name": {
          "type": "string",
          "example": "cn-north-7.css-axdnew.a6f06041-5f8a-4985-bd95-3a333f65db7f",
          "description": "访问端点的服务名称"
        },
        "marker_id": {
          "type": "string",
          "description": "访问端点的终端节点的报文ID"
        },
        "id": {
          "type": "string",
          "example": "4373566d-2933-44ce-a8a7-64c0c31631e6",
          "description": "访问端点的终端节点ID"
        },
        "ip": {
          "type": "string",
          "example": "10.66.171.255",
          "description": "访问端点的终端节点IP"
        },
        "created_time": {
          "type": "string",
          "description": "访问端点的终端节点创建时间"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
