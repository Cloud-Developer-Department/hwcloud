{
  "name": "ListEventSchema",
  "summary": "查询事件模型列表",
  "tags": "事件模型管理",
  "productshort": "EG",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/schemas": {
      "get": {
        "x-api-framework": "RestfulAPI",
        "x-is-open-doc": "Y",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk",
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "事件模型管理"
        ],
        "operationId": "ListEventSchema",
        "summary": "查询事件模型列表",
        "description": "查询事件模型列表,包括系统事件模型和自定义事件模型",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/IamToken"
          },
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/QueryOffset"
          },
          {
            "$ref": "#/parameters/QueryLimit"
          },
          {
            "$ref": "#/parameters/QuerySort"
          },
          {
            "$ref": "#/parameters/QueryProviderType"
          },
          {
            "$ref": "#/parameters/QuerySchemaName"
          },
          {
            "$ref": "#/parameters/QuerySchemaNameFuzzy"
          }
        ],
        "responses": {
          "200": {
            "description": "列表",
            "schema": {
              "$ref": "#/definitions/CustomizeSchemaList"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CustomizeSchemaItemInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "事件模型ID",
          "example": "2a0ee4f2-78a4-4122-80af-7455e37f64ee"
        },
        "name": {
          "type": "string",
          "description": "事件模型名称,租户下唯一",
          "example": "file.upload"
        },
        "description": {
          "type": "string",
          "description": "事件模型描述",
          "example": "文件上传事件模型定义"
        },
        "compatibility": {
          "type": "string",
          "description": "事件模型兼容性",
          "enum": [
            "NONE"
          ],
          "example": "NONE"
        },
        "provider_type": {
          "type": "string",
          "description": "提供方类型,OFFICIAL:官方事件源;CUSTOM:自定义事件源",
          "enum": [
            "OFFICIAL",
            "CUSTOM"
          ],
          "example": "CUSTOM"
        },
        "format": {
          "type": "string",
          "description": "事件模型格式",
          "example": "OPENAPI_3_0"
        },
        "number_of_versions": {
          "type": "integer",
          "description": "事件模型版本数",
          "example": 1
        },
        "event_type_id": {
          "type": "string",
          "description": "事件类型ID",
          "example": "0cdbba1c-ab7c-4644-b4ac-5ddfc183af94"
        },
        "event_type_name": {
          "type": "string",
          "description": "事件类型名称",
          "example": "CBH:CloudTrace:SystemAction"
        },
        "event_source_id": {
          "type": "string",
          "description": "事件源ID",
          "example": "95630215-05af-4ef7-9eb9-c3c075bbbdec"
        },
        "event_source_name": {
          "type": "string",
          "description": "事件源名称",
          "example": "HC.IEC"
        },
        "event_source_label": {
          "type": "string",
          "description": "事件源标签",
          "example": "智能边缘云 IEC"
        },
        "created_time": {
          "type": "string",
          "description": "创建时间",
          "example": "2021-12-09 09:00:00"
        },
        "updated_time": {
          "type": "string",
          "description": "更新时间",
          "example": "2021-12-09 09:00:00"
        }
      }
    },
    "CustomizeSchemaList": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "description": "总数",
          "minimum": 0,
          "maximum": 100,
          "example": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "本页数量",
          "example": 1
        },
        "items": {
          "type": "array",
          "description": "对象列表",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/CustomizeSchemaItemInfo"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "租户资源空间ID",
      "required": true,
      "type": "string",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "QueryOffset": {
      "name": "offset",
      "in": "query",
      "description": "偏移量,表示从此偏移量开始查询,偏移量不能小于0",
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 0,
      "x-example": 1
    },
    "QuerySchemaName": {
      "name": "name",
      "in": "query",
      "description": "指定查询的事件模型名称,精准匹配",
      "required": false,
      "type": "string",
      "x-example": "obs:CloudTrace:ApiCall"
    },
    "QuerySort": {
      "name": "sort",
      "in": "query",
      "description": "指定查询排序",
      "type": "string",
      "default": "created_time:DESC",
      "x-example": "created_time:DESC"
    },
    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    },
    "QuerySchemaNameFuzzy": {
      "name": "fuzzy_name",
      "in": "query",
      "description": "指定查询的事件模型名称,模糊匹配",
      "required": false,
      "type": "string",
      "x-example": "obs:CloudTrace:ApiCall"
    },
    "QueryLimit": {
      "name": "limit",
      "in": "query",
      "description": "每页显示的条目数量,不能小于1或大于1000",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 15,
      "x-example": 15
    },
    "QueryProviderType": {
      "name": "provider_type",
      "in": "query",
      "description": "指定查询提供方的类型",
      "required": false,
      "type": "string",
      "enum": [
        "OFFICIAL",
        "CUSTOM",
        "PARTNER"
      ],
      "x-example": "CUSTOM"
    }
  },
  "host": "eg.cn-east-3.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}