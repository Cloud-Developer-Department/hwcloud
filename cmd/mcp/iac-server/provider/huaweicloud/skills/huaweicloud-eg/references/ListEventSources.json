{
  "name": "ListEventSources",
  "summary": "查询事件源列表",
  "tags": "事件源管理",
  "productshort": "EG",
  "region_id": "cn-north-9",
  "paths": {
    "/v1/{project_id}/sources": {
      "get": {
        "x-api-framework": "RestfulAPI",
        "x-is-open-doc": "Y",
        "x-api-user": "IAM普通租户",
        "x-api-position": "管理面",
        "x-open-region-cloud": "hws,hws_hk",
        "x-api-type": "open-api",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "tags": [
          "事件源管理"
        ],
        "operationId": "ListEventSources",
        "summary": "查询事件源列表",
        "description": "支持条件查询,如可以指定事件通道ID来查询某个事件通道下的所有事件源。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/IamToken"
          },
          {
            "$ref": "#/parameters/ProjectId"
          },
          {
            "$ref": "#/parameters/QueryChannelId"
          },
          {
            "$ref": "#/parameters/QueryOffset"
          },
          {
            "$ref": "#/parameters/QueryLimit"
          },
          {
            "$ref": "#/parameters/QuerySort"
          },
          {
            "$ref": "#/parameters/QueryProviderType"
          },
          {
            "$ref": "#/parameters/QuerySourceName"
          },
          {
            "$ref": "#/parameters/QuerySourceNameFuzzy"
          },
          {
            "$ref": "#/parameters/QuerySourceLabelFuzzy"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "schema": {
              "$ref": "#/definitions/CustomizeSourceList"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CustomizeSourceList": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "description": "总数",
          "minimum": 0,
          "maximum": 100,
          "example": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "本页数量",
          "example": 1
        },
        "items": {
          "type": "array",
          "description": "对象列表",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/CustomizeSourceInfo"
          }
        }
      }
    },
    "ErrorInfo": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 1,
          "maxLength": 128,
          "example": "EGS.00511000"
        },
        "error_detail": {
          "type": "string",
          "description": "错误详情",
          "minLength": 1,
          "maxLength": 128,
          "example": "unknown"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息",
          "minLength": 1,
          "maxLength": 128,
          "example": "internal server error, unknown"
        }
      }
    },
    "CustomizeSourceInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "事件源ID",
          "example": "90e0b962-c6c1-438c-ba8a-3024fe592bda"
        },
        "name": {
          "type": "string",
          "description": "事件源名称",
          "example": "first-source"
        },
        "label": {
          "type": "string",
          "description": "事件源名称展示",
          "example": "first-source"
        },
        "description": {
          "type": "string",
          "description": "事件源描述",
          "example": "first event source"
        },
        "provider_type": {
          "type": "string",
          "description": "事件源提供方类型,OFFICIAL:官方云服务事件源;CUSTOM:用户创建的自定义事件源;PARTNER:伙伴事件源",
          "enum": [
            "OFFICIAL",
            "CUSTOM",
            "PARTNER"
          ],
          "example": "CUSTOM"
        },
        "event_types": {
          "type": "array",
          "description": "事件源提供的事件类型列表,只有官方云服务事件源提供事件类型",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "事件类型名称",
                "example": "OBS:CloudTrace:ApiCall"
              },
              "description": {
                "type": "string",
                "description": "事件类型描述",
                "example": "服务API调用类型事件"
              }
            }
          }
        },
        "created_time": {
          "type": "string",
          "description": "创建UTC时间",
          "example": "2021-12-09 09:00:00"
        },
        "updated_time": {
          "type": "string",
          "description": "更新UTC时间",
          "example": "2021-12-09 09:00:00"
        },
        "channel_id": {
          "type": "string",
          "description": "事件源归属的事件通道ID",
          "example": "bd14144e-8f3c-43d6-bdfd-bf09b52c2b96"
        },
        "channel_name": {
          "type": "string",
          "description": "事件源归属的事件通道名称",
          "example": "channel"
        },
        "type": {
          "type": "string",
          "description": "事件源类型",
          "example": "RABBITMQ"
        },
        "detail": {
          "type": "object",
          "description": "json格式封装消息实例链接信息:如RabbitMQ实例的instance_id字段、虚拟主机vhost字段、队列queue字段、用户名、密码等",
          "example": "{\"instance_id\":\"ac14144e-9v3c-43d6-acfd-bf09b52c98uy\",\"user_name\":\"rabbitmq_user\",\"password\":\"changeme\",\"vhost_name\":\"vhost_name\",\"queue_name\":\"queue_name\"}"
        },
        "status": {
          "type": "string",
          "description": "自定义事件源状态",
          "enum": [
            "CREATE_FAILED",
            "RUNNING",
            "ERROR"
          ],
          "example": "RUNNING"
        },
        "error_info": {
          "$ref": "#/definitions/ErrorInfo"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "ProjectId": {
      "name": "project_id",
      "in": "path",
      "description": "租户资源空间ID",
      "required": true,
      "type": "string",
      "x-example": "73d69ae0cfcf460190522d06b60f05ad"
    },
    "QuerySourceLabelFuzzy": {
      "name": "fuzzy_label",
      "in": "query",
      "description": "指定查询的事件源标签,模糊匹配",
      "required": false,
      "type": "string",
      "x-example": "demo"
    },
    "QuerySourceName": {
      "name": "name",
      "in": "query",
      "description": "指定查询的事件源名称,精准匹配",
      "required": false,
      "type": "string",
      "x-example": "demo"
    },
    "QueryChannelId": {
      "name": "channel_id",
      "in": "query",
      "description": "指定查询的事件通道ID",
      "required": false,
      "type": "string",
      "x-example": "092e1243e88146768798b0e8c9933192"
    },
    "QuerySourceNameFuzzy": {
      "name": "fuzzy_name",
      "in": "query",
      "description": "指定查询的事件源名称,模糊匹配",
      "required": false,
      "type": "string",
      "x-example": "demo"
    },
    "QueryLimit": {
      "name": "limit",
      "in": "query",
      "description": "每页显示的条目数量,不能小于1或大于1000",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 15,
      "x-example": 15
    },
    "QueryProviderType": {
      "name": "provider_type",
      "in": "query",
      "description": "指定查询提供方的类型",
      "required": false,
      "type": "string",
      "enum": [
        "OFFICIAL",
        "CUSTOM",
        "PARTNER"
      ],
      "x-example": "CUSTOM"
    },
    "QueryOffset": {
      "name": "offset",
      "in": "query",
      "description": "偏移量,表示从此偏移量开始查询,偏移量不能小于0",
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 0,
      "x-example": 1
    },
    "QuerySort": {
      "name": "sort",
      "in": "query",
      "description": "指定查询排序",
      "type": "string",
      "default": "created_time:DESC",
      "x-example": "created_time:DESC"
    },
    "IamToken": {
      "in": "header",
      "name": "X-Auth-Token",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX...",
      "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
      "type": "string",
      "required": true,
      "maxLength": 16384,
      "minLength": 1
    }
  },
  "host": "eg.cn-north-9.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}