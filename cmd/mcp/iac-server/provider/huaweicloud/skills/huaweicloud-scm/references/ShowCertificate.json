        "status": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "证书状态。取值如下:\n- PAID:证书已支付,待申请证书。\n- ISSUED:证书已签发。\n- CHECKING:证书申请审核中。\n- CANCELCHECKING:取消证书申请审核中。\n- UNPASSED:证书申请未通过。\n- EXPIRED:证书已过期。\n- REVOKING:证书吊销申请审核中。\n- REVOKED:证书已吊销。\n- UPLOAD:证书托管中。\n- SUPPLEMENTCHECKING:多域名证书新增附加域名审核中。\n- CANCELSUPPLEMENTING:取消新增附加域名审核中。"
        },
        "order_id": {
          "type": "string",
          "description": "订单id。",
          "minLength": 0,
          "maxLength": 63
