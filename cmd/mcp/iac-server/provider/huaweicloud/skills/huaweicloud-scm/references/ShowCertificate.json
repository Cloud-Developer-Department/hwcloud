        },
        "brand": {
          "type": "string",
          "description": "证书品牌。取值如下:\nGLOBALSIGN、SYMANTEC、GEOTRUST、CFCA。",
          "minLength": 0,
          "maxLength": 32
        },
        "push_support": {
          "type": "string",
          "description": "证书是否支持推送。",
          "minLength": 0,
          "maxLength": 32
        },
