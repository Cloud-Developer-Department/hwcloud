{
  "name": "ListDeployedResources",
  "summary": "查询已部署资源",
  "tags": "证书部署管理",
  "productshort": "SCM",
  "region_id": "ap-southeast-1",
  "paths": {
    "/v3/scm/deployed-resources": {
      "post": {
        "tags": [
          "证书部署管理"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "summary": "查询已部署资源",
        "description": "查询证书已部署的具体资源。针对已签发和上传的非国密证书。",
        "operationId": "ListDeployedResources",
        "consumes": [
          "application/json"
        ],
