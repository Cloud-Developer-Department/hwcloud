  "definitions": {
    "DeployedResourceDetail": {
      "type": "object",
      "required": [
        "service",
        "resource_num",
        "resource_location",
        "region_resources"
      ],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 0,
          "maxLength": 5,
          "description": "证书已部署资源服务名称。\n- WAF:证书关联Web应用防火墙的资源。\n- CDN:证书关联内容分发网络的资源。\n- ELB:证书关联弹性负载均衡(经典型)的资源。"
        },
        "resource_num": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "证书在当前服务已部署资源数量。"
        },
        "resource_location": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63,
          "description": "全局服务或Region级服务。"
        },
        "region_resources": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "description": "局点资源列表,详情请参见RegionResourceDetail字段数据结构说明。",
          "items": {
            "$ref": "#/definitions/RegionResourceDetail"
          }
        }
      },
      "title": "DeployedResourceDetail"
    },
    "ListDeployedResourcesRequestBody": {
      "type": "object",
      "required": [
        "certificate_ids",
        "service_names"
      ],
      "properties": {
        "certificate_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "description": "证书ID列表。",
          "items": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16
          }
        },
        "service_names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "description": "服务名称列表。\n- WAF:查询证书关联Web应用防火墙的资源。\n- CDN:查询证书关联内容分发网络的资源。\n- ELB:查询证书关联弹性负载均衡(经典型)的资源。\n- ALL:查询证书以上四种服务的资源。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 5
          }
        }
      },
      "title": "ListDeployedResourcesRequestBody"
    },
    "RegionResourceDetail": {
      "type": "object",
      "required": [
        "region_id",
        "is_error",
        "resources"
      ],
      "properties": {
        "region_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63,
          "description": "局点ID。当服务为全局服务时,region_id为global,其余按照IAM的标准命名。"
        },
        "is_error": {
          "type": "boolean",
          "description": "请求当前region资源信息过程中,响应是否存在异常的标志。\n- true : 存在异常,当前region所统计数据不准确\n- false: 无异常,当前region所统计数据准确"
        },
        "resources": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "description": "资源集合,每个资源的标识:资源ID + “:” + 资源名称,详情请参见ResourceDetail字段数据结构说明。",
          "items": {
            "$ref": "#/definitions/ResourceDetail"
          }
        }
      },
      "title": "RegionResourceDetail"
    },
    "Error": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码。"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息。"
        }
      },
      "title": "Error"
    },
    "ResourceDetail": {
      "type": "object",
      "required": [
        "resource_id",
        "resource_name"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63,
          "description": "资源ID。"
        },
        "resource_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63,
          "description": "资源名称。"
        }
      },
      "title": "ResourceDetail"
    },
    "ListDeployedResourcesResponseBody": {
      "type": "object",
      "required": [
        "results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "description": "请求结果列表,详情请参见ResultDetail字段数据结构说明。",
          "items": {
            "$ref": "#/definitions/ResultDetail"
          }
        }
      },
      "title": "ListDeployedResourcesResponseBody"
    },
    "ResultDetail": {
      "type": "object",
      "required": [
        "certificate_id",
        "total_num",
        "deployed_resources"
      ],
      "properties": {
        "certificate_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16,
          "description": "证书ID。"
        },
        "total_num": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "当前证书在所查询服务中已部署资源总数。"
        },
        "deployed_resources": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "description": "当前证书已部署资源列表,详情请参见DeployedResourceDetail字段数据结构说明。",
          "items": {
            "$ref": "#/definitions/DeployedResourceDetail"
          }
        }
      },
      "title": "ResultDetail"
    }
  },
