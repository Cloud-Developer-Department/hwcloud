{
  "name": "ExportCertificate",
  "summary": "导出证书",
  "tags": "证书生命周期管理",
  "productshort": "SCM",
  "region_id": "cn-north-4",
  "paths": {
    "/v3/scm/certificates/{certificate_id}/export": {
      "post": {
        "tags": [
          "证书生命周期管理"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "summary": "导出证书",
        "description": "导出证书。",
        "operationId": "ExportCertificate",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "certificate_id",
            "in": "path",
            "description": "证书id。",
            "required": true,
            "type": "string",
            "minLength": 16,
            "maxLength": 16
          }
        ],
        "responses": {
          "200": {
            "description": "正常返回。",
            "schema": {
              "$ref": "#/definitions/ExportCertificateResponseBody"
            },
            "examples": {
              "application/json": {
                "entire_certificate": "-----BEGIN CERTIFICATE---******----END CERTIFICATE----------BEGIN CERTIFICATE---******----END CERTIFICATE-----",
                "certificate": "-----BEGIN CERTIFICATE-----*******-----END CERTIFICATE-----",
                "certificate_chain": "-----BEGIN CERTIFICATE-----*******-----END CERTIFICATE-----",
                "private_key": "-----BEGIN RSA PRIVATE KEY-----******-----END RSA PRIVATE KEY-----"
              }
            }
          },
          "401": {
            "description": "认证失败。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "SCM.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "403": {
            "description": "禁止访问。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "SCM.XXX",
                "error_msg": "XXX"
              }
            }
          },
          "404": {
            "description": "访问页面未找到。"
          },
          "500": {
            "description": "请求未完成,服务器内部异常。",
            "schema": {
              "$ref": "#/definitions/Error"
            },
            "examples": {
              "application/json": {
                "error_code": "SCM.XXX",
                "error_msg": "XXX"
              }
            }
          }
        },
        "x-hc": "Y",
        "x-hk": "Y",
        "x-open-region-cloud": "hc,hk"
      }
    }
  },
  "definitions": {
    "Error": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码。"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息。"
        }
      },
      "title": "Error"
    },
    "ExportCertificateResponseBody": {
      "type": "object",
      "required": [
        "certificate",
        "certificate_chain",
        "entire_certificate",
        "private_key"
      ],
      "properties": {
        "entire_certificate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12288,
          "description": "证书及证书链。"
        },
        "certificate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "证书内容,不包含证书链。"
        },
        "certificate_chain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "证书链。"
        },
        "private_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "证书私钥。"
        },
        "enc_certificate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "国密证书返回,加密证书内容。",
          "x-open-region-cloud": "hc"
        },
        "enc_private_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "国密证书返回,加密证书私钥。\n- 自己生成csr的方式:该字段是加密状态,需要解密。\n  解密思路如下: \n  1、从数字信封中获取“对称密钥密文”和“加密私钥密文”;\n  2、使用签名私钥解密“对称密钥密文”,得到“对称密钥明文”;\n  3、使用对称密钥解密“加密私钥密文”,得到“加密私钥明文”。\n- 非自己生成csr的方式:该字段不需要解密。",
          "x-open-region-cloud": "hc"
        }
      },
      "title": "ExportCertificateResponseBody"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "scm.cn-north-4.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}