          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码。"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息。"
        }
      },
      "title": "Error"
    },
    "ApplyCertificateRequestBody": {
      "type": "object",
      "required": [
        "domain",
        "applicant_name",
        "applicant_phone",
        "applicant_email",
        "agree_privacy_protection",
        "domain_method"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "该证书绑定的域名。\n- 当购买的证书为“单域名”或“泛域名”类型的证书时,请直接填写单域名或泛域名即可。\n- 当购买的证书为“多域名”类型的证书时,需要选择1个域名作为主域名。\n示例:www.example.com"
        },
        "sans": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096,
          "description": "绑定多域名类型证书的附加域名。\n当购买的证书为“多域名”类型的证书,且有可增加附加域名的额度时,才需要设置该值。\n多个域名需要以“;”隔开。\n示例:www.example.com;www.example1.com;www.example2.com"
        },
        "csr": {
          "type": "string",
          "minLength": 0,
          "maxLength": 5120,
          "description": "证书CSR串,与域名必须匹配。"
        },
        "company_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63,
          "description": "公司名称,OV和EV型证书必填。字符长度为0~63位。"
        },
        "company_unit": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63,
          "description": "部门名称。字符长度为0~63位。"
        },
        "company_province": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63,
          "description": "公司所在省份,OV和EV型证书必填。字符长度为0~63位。"
        },
        "company_city": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63,
          "description": "公司所在市区,OV和EV型证书必填。字符长度为0~63位。"
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "description": "OV和EV型证书必填,国家编码,需符合正则\"**[A-Za-z]{2}**\"。"
        },
        "applicant_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63,
          "description": "申请人的姓名。请输入中文、英文字符,下划线,中划线,英文逗号,英文句点,且长度为4到100字节。"
        },
        "applicant_phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63,
          "description": "申请人的电话号码。示例:13212345678"
        },
        "applicant_email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "申请人的邮箱。示例:example@huawei.com"
        },
        "contact_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63,
          "description": "技术联系人的姓名。字符长度为0~63位。"
        },
        "contact_phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63,
          "description": "技术联系人的电话号码。示例:13212345678"
        },
        "contact_email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "技术联系人的邮箱。示例:example@huawei.com"
        },
        "auto_dns_auth": {
          "type": "boolean",
          "description": "是否将DNS验证信息推送到华为云解析服务。\n- true:推送。\n- false:不推送。"
        },
        "agree_privacy_protection": {
          "type": "boolean",
          "description": "是否同意授权隐私协议。此处仅能设置为true才能成功申请证书。\n- true:同意隐私协议。\n- false:不同意隐私协议。"
        },
        "domain_method": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "域名验证方式。\n- DNS:DNS验证,指在域名管理平台通过解析指定的DNS记录,验证域名所有权。\n- FILE:文件验证,指通过在服务器上创建指定文件的方式来验证域名所有权。\n- EMAIL:邮箱验证,指登录域名管理员邮箱,接收域名确认邮件并根据提示进行操作来验证域名所有权。\nDV域名型和DV基础版证书(GeoTrust入门级SSL证书和DigiCert免费SSL证书)默认通过“DNS验证”方式进行验证。\n纯IP(公网IP)的证书仅支持通过“文件验证”方式进行验证,且仅纯IP证书支持“文件验证”方式验证。"
        },
        "key_algorithm": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "密钥算法。默认RSA_2048"
        },
        "ca_hash_algorithm": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "签名算法。Geo OV证书必填。\n- DEFAULT\n- SHA-256",
          "x-open-region-cloud": "hc"
        }
      },
      "title": "ApplyCertificateRequestBody"
    }
  },
