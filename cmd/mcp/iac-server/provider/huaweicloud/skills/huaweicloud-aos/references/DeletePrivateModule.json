{
  "name": "DeletePrivateModule",
  "summary": "删除私有模块",
  "tags": "资源编排-模块管理",
  "productshort": "AOS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/private-modules/{module_name}": {
      "delete": {
        "tags": [
          "Module"
        ],
        "summary": "删除私有模块",
        "description": "删除私有模块(DeletePrivateModule)\n\n删除某个私有模块以及私有模块下的全部模块版本\n\n  * 如果module_name和module_id同时存在,则资源编排服务会检查是否两个匹配,如果不匹配则会返回400。\n\n**请谨慎操作,删除私有模块将会删除该私有模块下的所有的模块版本。**",
        "operationId": "DeletePrivateModule",
        "parameters": [
          {
            "name": "Client-Request-Id",
            "in": "header",
            "description": "用户指定的,对于此请求的唯一Id,用于定位某个请求,推荐使用UUID",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 36,
            "pattern": "^[A-Za-z0-9]+[A-Za-z0-9-]*$"
          },
          {
            "name": "module_name",
            "in": "path",
            "description": "私有模块(private-module)的名字。此名字在domain_id+region下应唯一,可以使用中文、大小写英文、数字、下划线、中划线。首字符需为中文或者英文,区分大小写。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[一-龥A-Za-z]+[一-龥A-Za-z0-9_-]*$"
          },
          {
            "name": "module_id",
            "in": "query",
            "description": "私有模块(private-module)的唯一Id。\n\n此Id由资源编排服务在生成模块的时候生成,为UUID。\n\n由于私有模块名称仅仅在同一时间下唯一,即用户允许先生成一个叫HelloWorld的私有模块,删除,再重新创建一个同名私有模块。\n\n对于团队并行开发,用户可能希望确保,当前我操作的私有模块就是我认为的那个,而不是其他队友删除后创建的同名私有模块。因此,使用Id就可以做到强匹配。\n\n资源编排服务保证每次创建的私有模块所对应的Id都不相同,更新不会影响Id。如果给予的module_id和当前模块的Id不一致,则返回400",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[a-z0-9]+[a-z0-9-]*$",
            "x-isnullable": true
          }
        ],
        "responses": {
          "204": {
            "description": "删除私有模块成功,无数据返回"
          },
          "400": {
            "description": "用户请求非法",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "401": {
            "description": "用户身份认证失败",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "403": {
            "description": "用户无权限调用此API",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "404": {
            "description": "模块不存在",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "429": {
            "description": "请求数量过多",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "false",
        "x-rfs-internal": "Y",
        "x-rfs-external": "Y",
        "x-api-type": "open-api",
        "x-request-examples-url-1": "DELETE /v1/private-modules/{module_name}",
        "x-request-examples-description-1": "删除某个私有模块以及私有模块下的全部模块版本"
      }
    }
  },
