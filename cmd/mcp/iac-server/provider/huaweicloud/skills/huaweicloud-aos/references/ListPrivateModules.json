      "properties": {
        "create_time": {
          "type": "string",
          "description": "私有模块(private-module)的生成时间,格式为YYYY-MM-DDTHH:mm:ss.SSSZ,精确到毫秒,UTC时区,即,如1970-01-01T00:00:00.000Z。"
        }
      },
      "example": {
