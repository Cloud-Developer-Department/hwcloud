    "PageInfo": {
      "type": "object",
      "properties": {
        "next_marker": {
          "type": "string",
          "description": "向后分页标识符。如果存在,则表示实际总输出比当前响应中包含的输出多。在对请求的后续调用中,在请求参数中使用此值,以获取输出的下一部分。您应该重复此操作,直到next_marker响应元素返回为null。",
          "x-omitempty": false,
          "x-isnullable": true
        },
        "previous_marker": {
          "type": "string",
          "description": "向前分页标识符。",
          "x-omitempty": false,
