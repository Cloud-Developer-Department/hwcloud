{
  "name": "ShowPrivateHookMetadata",
  "summary": "获取私有hook元数据",
  "tags": "资源编排-Hook",
  "productshort": "AOS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/private-hooks/{hook_name}/metadata": {
      "get": {
        "tags": [
          "Hook"
        ],
        "summary": "获取私有hook元数据",
        "description": "获取私有hook元数据(ShowPrivateHookMetadata)\n\n获取某个私有hook的元数据信息\n\n  * 具体返回的信息见ShowPrivateHookMetadataResponseBody,若想查看私有hook下全部版本,请调用ListPrivateHookVersions。\n  * 若hook_name和hook_id同时存在,则资源编排服务会检查两个是否匹配,如果不匹配则会返回400。",
        "operationId": "ShowPrivateHookMetadata",
        "parameters": [
          {
            "name": "Client-Request-Id",
            "in": "header",
            "description": "用户指定的,对于此请求的唯一Id,用于定位某个请求,推荐使用UUID",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 36,
            "pattern": "^[A-Za-z0-9]+[A-Za-z0-9-]*$"
          },
          {
            "name": "hook_name",
            "in": "path",
            "description": "私有hook的名字。此名字在domain_id+region下应唯一,可以使用中文、大小写英文、数字、下划线、中划线。首字符需为中文或者英文,区分大小写。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[一-龥A-Za-z]+[一-龥A-Za-z0-9_-]*$"
          },
          {
            "name": "hook_id",
            "in": "query",
            "description": "私有hook(private-hook)的唯一Id。\n\n此Id由资源编排服务在生成私有hook的时候生成,为UUID。\n\n由于私有hook名称仅仅在同一时间下唯一,即用户允许先生成一个叫HelloWorld的私有hook,删除,再重新创建一个同名私有hook。\n\n对于团队并行开发,用户可能希望确保,当前我操作的私有hook就是我认为的那个,而不是其他队友删除后创建的同名私有hook。因此,使用Id就可以做到强匹配。\n\n资源编排服务保证每次创建的私有hook所对应的Id都不相同,更新不会影响Id。如果给予的hook_id和当前hook的Id不一致,则返回400。",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[a-z0-9]+[a-z0-9-]*$",
            "x-isnullable": true
          }
        ],
        "responses": {
          "200": {
            "description": "获取私有hook元数据成功",
            "examples": {
              "x-response-examples-1": {
                "hook_name": "my-hello-world-hook-name",
                "hook_id": "1b15e005-bdbb-4bd7-8f9a-a09b6774b4b3",
                "hook_description": "my first hello world private hook",
                "default_version": "1.2.3",
                "configuration": {
                  "target_stacks": "NONE",
                  "failure_mode": "WARN"
                },
                "create_time": "1970-01-01T00:00:00.000Z",
                "update_time": "1970-01-01T00:00:00.000Z"
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowPrivateHookMetadataResponseBody"
            }
          },
          "400": {
            "description": "用户请求非法",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "401": {
            "description": "用户身份认证失败",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "403": {
            "description": "用户无权限调用此API",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "404": {
            "description": "私有hook不存在",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "429": {
            "description": "请求数量过多",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-rfs-internal": "Y",
        "x-rfs-external": "Y",
        "x-api-type": "open-api",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/private-hooks/my-hello-world-hook-name/metadata",
        "x-request-examples-description-1": "获取私有hook元数据",
        "x-request-examples-url-2": "GET https://{endpoint}/v1/private-hooks/my-hello-world-hook-name/metadata?hook_id=ea6a4f0e-ee8a-494e-b12a-8be4a1e65af2",
        "x-request-examples-description-2": "获取私有hook元数据,并提供hook ID以校验是否与当前私有hook匹配"
      }
    }
  },
  "definitions": {
    "PrivateHookSummary": {
      "allOf": [
        {
          "$ref": "#/definitions/PrivateHookNamePrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateHookIdPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateHookDescriptionPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateHookDefaultVersionPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/ConfigurationPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateHookCreateTimePrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateHookUpdateTimePrimitiveTypeHolder"
        }
      ]
    },
    "PrivateHookCreateTimePrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "create_time": {
          "type": "string",
          "description": "私有Hook(private-hook)的生成时间,格式为YYYY-MM-DDTHH:mm:ss.SSSZ,精确到毫秒,UTC时区,即,如1970-01-01T00:00:00.000Z。"
        }
      },
      "example": {
        "create_time": "1970-01-01T00:00:00.000Z"
      }
    },
    "ConfigurationPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "configuration": {
          "type": "object",
          "description": "私有hook配置项,可以指定私有hook生效的目标资源栈以及私有hook校验失败后资源栈的行为。可通过UpdatePrivateHook API更新私有hook配置项。",
          "properties": {
            "target_stacks": {
              "type": "string",
              "description": "指定私有hook生效的目标资源栈,有效值为NONE或ALL,默认值为NONE。\n\nNONE:指定此私有hook不会作用于任何资源栈\nALL:指定此私有hook将会应用于账号下的所有资源栈",
              "enum": [
                "NONE",
                "ALL"
              ],
              "default": "NONE"
            },
            "failure_mode": {
              "type": "string",
              "description": "指定私有hook校验失败后的行为,有效值为FAIL或WARN,默认值为WARN。\n\nFAIL:指定此私有hook校验失败后资源栈将停止部署,资源栈状态将更新为DEPLOYMENT_FAILED。\nWARN:指定此私有hook校验失败后仅通过资源栈事件展示警告消息,但不影响资源栈部署。",
              "enum": [
                "WARN",
                "FAIL"
              ],
              "default": "WARN"
            }
          }
        }
      }
    },
    "PrivateHookDescriptionPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "hook_description": {
          "type": "string",
          "description": "私有hook的描述。可用于客户识别创建的私有hook。可通过UpdatePrivateHook API更新私有hook的描述。",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "example": {
        "hook_description": "My First Hello World Hook Description"
      }
    },
    "CommonErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码",
          "minLength": 11,
          "maxLength": 11
        },
        "error_msg": {
          "type": "string",
          "description": "响应消息"
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "包含有关未经授权请求的信息。",
          "x-omitempty": true
        },
        "details": {
          "type": "array",
          "description": "权限拒绝时服务返回的详细错误信息。",
          "items": {
            "$ref": "#/definitions/Detail"
          },
          "x-omitempty": true
        }
      },
      "description": "通用错误响应体"
    },
    "PrivateHookUpdateTimePrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "update_time": {
          "type": "string",
          "description": "私有Hook(private-hook)的更新时间,格式为YYYY-MM-DDTHH:mm:ss.SSSZ,精确到毫秒,UTC时区,即,如1970-01-01T00:00:00.000Z。"
        }
      },
      "example": {
        "update_time": "1970-01-01T00:00:00.000Z"
      }
    },
    "Detail": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "响应码"
        },
        "error_msg": {
          "type": "string",
          "description": "响应消息"
        }
      }
    },
    "PrivateHookNamePrimitiveTypeHolder": {
      "type": "object",
      "required": [
        "hook_name"
      ],
      "properties": {
        "hook_name": {
          "type": "string",
          "description": "私有hook的名字。此名字在domain_id+region下应唯一,可以使用中文、大小写英文、数字、下划线、中划线。首字符需为中文或者英文,区分大小写。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[一-龥A-Za-z]+[一-龥A-Za-z0-9_-]*$"
        }
      },
      "example": {
        "hook_name": "test-limit_vpc_resource-hook"
      }
    },
    "PrivateHookDefaultVersionPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "default_version": {
          "type": "string",
          "description": "私有hook的默认版本号。版本号必须遵循语义化版本号(Semantic Version),为用户自定义。",
          "minLength": 5,
          "maxLength": 128,
          "x-isnullable": true
        }
      },
      "example": {
        "default_version": "1.0.0"
      }
    },
    "ShowPrivateHookMetadataResponseBody": {
      "allOf": [
        {
          "$ref": "#/definitions/PrivateHookSummary"
        }
      ]
    },
    "PrivateHookIdPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "hook_id": {
          "type": "string",
          "description": "私有hook(private-hook)的唯一Id。\n\n此Id由资源编排服务在生成私有hook的时候生成,为UUID。\n\n由于私有hook名称仅仅在同一时间下唯一,即用户允许先生成一个叫HelloWorld的私有hook,删除,再重新创建一个同名私有hook。\n\n对于团队并行开发,用户可能希望确保,当前我操作的私有hook就是我认为的那个,而不是其他队友删除后创建的同名私有hook。因此,使用Id就可以做到强匹配。\n\n资源编排服务保证每次创建的私有hook所对应的Id都不相同,更新不会影响Id。如果给予的hook_id和当前hook的Id不一致,则返回400。",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[a-z0-9]+[a-z0-9-]*$",
          "x-isnullable": true
        }
      },
      "example": {
        "hook_id": "77dad9a0-6b11-4bf5-ba62-c7e0029dcb6f"
      }
    }
  },
