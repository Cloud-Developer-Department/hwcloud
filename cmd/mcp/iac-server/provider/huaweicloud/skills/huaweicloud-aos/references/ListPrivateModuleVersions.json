{
  "name": "ListPrivateModuleVersions",
  "summary": "列举私有模块版本",
  "tags": "资源编排-模块管理",
  "productshort": "AOS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/private-modules/{module_name}/versions": {
      "get": {
        "tags": [
          "Module"
        ],
        "summary": "列举私有模块版本",
        "description": "列举私有模块版本(ListPrivateModuleVersions)\n\n列举所选择的私有模块中所有的模块版本信息。\n\n  * 可以使用sort_key和sort_dir两个关键字对返回结果按创建时间(create_time)进行排序。给予的sort_key和sort_dir数量须一致,否则返回400。如果未给予sort_key和sort_dir,则默认按照创建时间降序排序。\n  * 如果module_name和module_id同时存在,则资源编排服务会检查是否两个匹配,如果不匹配则会返回400。\n  * 如果模块不存在则返回404。\n  * 支持分页返回。如果响应中存在next_marker,则表示实际总输出比当前响应中包含的输出多。在对请求的后续调用中,在请求参数中使用此值,以获取输出的下一部分。您应该重复此操作,直到next_marker响应元素返回为null\n\nListPrivateModuleVersions返回的只有摘要信息(具体摘要信息见ListPrivateModuleVersionsResponseBody),如果用户需要详细的模块版本元数据请调用ShowPrivateModuleVersionMetadata",
        "operationId": "ListPrivateModuleVersions",
        "parameters": [
          {
            "name": "Client-Request-Id",
            "in": "header",
            "description": "用户指定的,对于此请求的唯一Id,用于定位某个请求,推荐使用UUID",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 36,
            "pattern": "^[A-Za-z0-9]+[A-Za-z0-9-]*$"
          },
          {
            "name": "module_name",
            "in": "path",
            "description": "私有模块(private-module)的名字。此名字在domain_id+region下应唯一,可以使用中文、大小写英文、数字、下划线、中划线。首字符需为中文或者英文,区分大小写。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[一-龥A-Za-z]+[一-龥A-Za-z0-9_-]*$"
          },
          {
            "name": "module_id",
            "in": "query",
            "description": "私有模块(private-module)的唯一Id。\n\n此Id由资源编排服务在生成模块的时候生成,为UUID。\n\n由于私有模块名称仅仅在同一时间下唯一,即用户允许先生成一个叫HelloWorld的私有模块,删除,再重新创建一个同名私有模块。\n\n对于团队并行开发,用户可能希望确保,当前我操作的私有模块就是我认为的那个,而不是其他队友删除后创建的同名私有模块。因此,使用Id就可以做到强匹配。\n\n资源编排服务保证每次创建的私有模块所对应的Id都不相同,更新不会影响Id。如果给予的module_id和当前模块的Id不一致,则返回400",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[a-z0-9]+[a-z0-9-]*$",
            "x-isnullable": true
          },
          {
            "name": "sort_key",
            "in": "query",
            "description": "排序字段,仅支持给予create_time",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "create_time"
              ]
            },
            "collectionFormat": "multi"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "description": "指定升序还是降序\n  * `asc` - 升序\n  * `desc` - 降序",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "asc",
                "desc"
              ]
            },
            "collectionFormat": "multi"
          },
          {
            "name": "marker",
            "in": "query",
            "description": "分页标记。当一页无法返回所有结果,上一次的请求将返回next_marker以指引还有更多页数,用户可以将next_marker中的值放到此处以查询下一页的信息。此marker只能用于与上一请求指定的相同参数的请求。不指定时默认从第一页开始查询。",
            "required": false,
            "type": "string",
            "maxLength": 512,
            "minLength": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页返回的最多结果数量",
            "required": false,
            "type": "integer",
            "default": 1000,
            "maximum": 1000,
            "minimum": 10
          }
        ],
        "responses": {
          "200": {
            "description": "列举私有模块版本成功",
            "examples": {
              "x-response-examples-1": {
                "versions": [
                  {
                    "module_name": "test-limit_vpc_resource-module20241211160209172862",
                    "module_id": "fd0e12bc-a1a4-4cac-8cbe-b023c389736b",
                    "module_version": "1.0.1",
                    "create_time": "2024-12-11T08:03:57.747Z"
                  },
                  {
                    "module_name": "test-limit_vpc_resource-module20241211160209172862",
                    "module_id": "fd0e12bc-a1a4-4cac-8cbe-b023c389736b",
                    "module_version": "1.0.0",
                    "version_description": "My First Hello World Module Version Description",
                    "create_time": "2024-12-11T08:03:37.417Z"
                  }
                ],
                "page_info": {
                  "current_count": 2,
                  "previous_marker": "zxc1oHc08HcCmypYGTsOoRcvoHUvHRUAW5NOSnc1oHc08HcCPZrwP5NOeTlRiukJgtGxeujJeuGwGIihaIUCmypYGTsOtqvKPr2xmH8fPqpGWyQ0axGwGZp9aqvx8pQ7m5FvGTsJiKk7gtNFiuaxetdRCks="
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/ListPrivateModuleVersionsResponseBody"
            }
          },
          "400": {
            "description": "用户请求非法",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "401": {
            "description": "用户身份认证失败",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "403": {
            "description": "用户无权限调用此API",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "404": {
            "description": "模块不存在",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "429": {
            "description": "请求数量过多",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "false",
        "x-rfs-internal": "Y",
        "x-rfs-external": "Y",
        "x-api-type": "open-api",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/private-modules/my_module/versions",
        "x-request-examples-description-1": "获取名为my_module的私有模块下的所有版本,以创建时间降序排序",
        "x-request-examples-url-2": "GET https://{endpoint}/v1/private-modules/my_module/versions?sort_key=create_time&sort_dir=desc",
        "x-request-examples-description-2": "获取名为my_module的私有模块下的所有版本,以创建时间降序排序",
        "x-request-examples-url-3": "GET https://{endpoint}/v1/private-modules/my_module/versions?sort_key=create_time&sort_dir=asc",
        "x-request-examples-description-3": "获取名为my_module的私有模块下的所有版本,以创建时间升序排序"
      }
    }
  },
  "definitions": {
    "PrivateModuleVersionSummary": {
      "allOf": [
        {
          "$ref": "#/definitions/PrivateModuleNamePrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateModuleIdPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateModuleVersionPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateModuleVersionDescriptionPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/PrivateModuleVersionCreateTimePrimitiveTypeHolder"
        }
      ]
    },
    "PrivateModuleIdPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "module_id": {
          "type": "string",
          "description": "私有模块(private-module)的唯一Id。\n\n此Id由资源编排服务在生成模块的时候生成,为UUID。\n\n由于私有模块名仅在同一时间下唯一,即允许用户先生成一个叫HelloWorld的私有模块,删除,再重新创建一个同名私有模块。\n\n对于团队并行开发,用户可能希望确保,当前我操作的私有模块就是我以为的那个,而不是其他队友删除后创建的同名私有模块。因此,使用Id就可以做到强匹配。\n\n资源编排服务保证每次创建的私有模块所对应的Id都不相同,更新不会影响Id。如果给予的module_id和当前模块的Id不一致,则返回400",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[a-z0-9]+[a-z0-9-]*$",
          "x-isnullable": true
        }
      },
      "example": {
        "module_id": "1b15e005-bdbb-4bd7-8f9a-a09b6774b4b3"
      }
    },
    "ListPrivateModuleVersionsResponseBody": {
      "type": "object",
      "properties": {
        "versions": {
          "type": "array",
          "description": "私有模块版本的列表。默认以创建时间升序排序。",
          "items": {
            "$ref": "#/definitions/PrivateModuleVersionSummary"
          }
        },
        "page_info": {
          "description": "分页信息",
          "$ref": "#/definitions/PageInfo"
        }
      },
      "description": "ListPrivateModuleVersions API的响应Body体"
    },
    "PrivateModuleNamePrimitiveTypeHolder": {
      "type": "object",
      "required": [
        "module_name"
      ],
      "properties": {
        "module_name": {
          "type": "string",
          "description": "私有模块(private-module)的名字。此名字在domain_id+region下应唯一,可以使用中文、大小写英文、数字、下划线、中划线。首字符需为中文或者英文,区分大小写。",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[一-龥A-Za-z]+[一-龥A-Za-z0-9_-]*$"
        }
      },
      "example": {
        "module_name": "私有模块名称-Private_Module_Name"
      }
    },
    "PageInfo": {
      "type": "object",
      "properties": {
        "next_marker": {
          "type": "string",
          "description": "向后分页标识符。如果存在,则表示实际总输出比当前响应中包含的输出多。在对请求的后续调用中,在请求参数中使用此值,以获取输出的下一部分。您应该重复此操作,直到next_marker响应元素返回为null。",
          "x-omitempty": false,
          "x-isnullable": true
        },
        "previous_marker": {
          "type": "string",
          "description": "向前分页标识符。",
          "x-omitempty": false,
          "x-isnullable": true
        },
        "current_count": {
          "type": "integer",
          "description": "本页显示的条目数量。",
          "x-omitempty": false
        }
      },
      "description": "分页信息",
      "x-isnullable": false
    },
    "PrivateModuleVersionDescriptionPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "version_description": {
          "type": "string",
          "description": "模块版本(module version)的描述。可用于客户识别并管理模块的版本。注意:模块版本为不可更新(immutable),即描述不可更新,如果需要更新,请删除后重建",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "example": {
        "version_description": "My First Hello World Module Version"
      }
    },
    "PrivateModuleVersionCreateTimePrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "create_time": {
          "type": "string",
          "description": "私有模块(private-module)版本的生成时间,格式为YYYY-MM-DDTHH:mm:ss.SSSZ,精确到毫秒,UTC时区,即,如1970-01-01T00:00:00.000Z。"
        }
      },
      "example": {
        "create_time": "1970-01-01T00:00:00.000Z"
      }
    },
    "CommonErrorResponse": {
