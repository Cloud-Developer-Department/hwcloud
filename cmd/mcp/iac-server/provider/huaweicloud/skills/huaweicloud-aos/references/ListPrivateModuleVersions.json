      "properties": {
        "module_version": {
          "type": "string",
          "description": "模块的版本号。版本号必须遵循语义化版本号(Semantic Version),为用户自定义",
          "minLength": 5,
          "maxLength": 128,
          "x-isnullable": true
        }
      },
      "example": {
        "module_version": "3.7.10"
      }
    }
  },
