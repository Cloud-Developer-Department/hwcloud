        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-rfs-internal": "N",
        "x-rfs-external": "N",
        "x-request-examples-url-1": "PATCH https://{endpoint}/v1/private-providers/my-hello-world-provider-name/metadata",
        "x-request-examples-description-1": "更新私有provider元数据",
        "x-request-examples-1": {
          "provider_description": "my first private provider"
        },
        "x-request-examples-url-2": "PATCH https://{endpoint}/v1/private-providers/my-hello-world-provider-name/metadata",
        "x-request-examples-description-2": "更新私有provider元数据,并提供provider ID以校验是否与当前私有provider匹配",
        "x-request-examples-2": {
