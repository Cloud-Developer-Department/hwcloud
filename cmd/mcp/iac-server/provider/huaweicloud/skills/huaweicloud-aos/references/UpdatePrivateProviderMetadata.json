  "paths": {
    "/v1/private-providers/{provider_name}/metadata": {
      "patch": {
        "tags": [
          "CustomizedProvider"
        ],
        "summary": "更新私有provider元数据",
        "description": "更新私有provider元数据(UpdatePrivateProviderMetadata)\n\n更新当前私有provider的元数据信息\n\n  * 目前只支持更新私有provider的描述\n  * 如果需要创建新的版本,请调用CreatePrivateProviderVersion\n  * 更新为增量更新,即如果某个参数不提供,则保持原始值\n  * 如果请求中没有需要被更新的参数,则返回400。注意:即使更新原始值和目标值一致也被认为是有效更新\n  * 更新后私有provider的更新时间(update_time)也会被更新\n  * 如果provider_name和provider_id同时存在,则资源编排服务会检查是否两个匹配,如果不匹配则会返回400。",
        "operationId": "UpdatePrivateProviderMetadata",
        "parameters": [
          {
            "name": "Client-Request-Id",
            "in": "header",
            "description": "用户指定的,对于此请求的唯一Id,用于定位某个请求,推荐使用UUID",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 36,
            "pattern": "^[A-Za-z0-9]+[A-Za-z0-9-]*$"
          },
          {
            "name": "provider_name",
            "in": "path",
            "description": "私有provider(private-provider)的名称。此名字在domain_id+region下应唯一,可以使用小写英文、数字、中划线。仅支持以小写英文、数字开头结尾。",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[0-9a-z]([0-9a-z-]*[0-9a-z])*$"
          },
          {
            "in": "body",
            "name": "UpdatePrivateProviderMetadataRequestBody",
            "description": "UpdatePrivateProviderMetadata API的请求Body体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdatePrivateProviderMetadataRequestBody"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "更新私有provider元数据成功"
          },
          "400": {
