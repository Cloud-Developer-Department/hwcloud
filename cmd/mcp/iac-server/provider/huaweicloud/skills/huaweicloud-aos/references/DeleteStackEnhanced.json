          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/CommonErrorResponse"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/{project_id}/stacks/{stack_name}/deletion",
        "x-request-examples-description-1": "删除资源栈,不保留资源",
        "x-request-examples-1": {
          "stack_id": "1b15e005-bdbb-4bd7-8f9a-a09b6774b4b3"
        },
        "x-request-examples-url-2": "POST https://{endpoint}/v1/{project_id}/stacks/{stack_name}/deletion",
        "x-request-examples-description-2": "删除资源栈,保留资源",
        "x-request-examples-2": {
          "stack_id": "1b15e005-bdbb-4bd7-8f9a-a09b6774b4b3",
          "retain_all_resources": true
        }
      }
    }
  },
  "definitions": {
    "StackIdPrimitiveTypeHolder": {
      "type": "object",
      "properties": {
        "stack_id": {
          "type": "string",
          "description": "资源栈(stack)的唯一ID。\n\n此ID由资源编排服务在生成资源栈的时候生成,为UUID。\n\n由于资源栈名仅仅在同一时间下唯一,即用户允许先生成一个叫HelloWorld的资源栈,删除,再重新创建一个同名资源栈。\n\n对于团队并行开发,用户可能希望确保,当前我操作的资源栈就是我认为的那个,而不是其他队友删除后创建的同名资源栈。因此,使用ID就可以做到强匹配。\n\n资源编排服务保证每次创建的资源栈所对应的ID都不相同,更新不会影响ID。如果给予的stack_id和当前资源栈的ID不一致,则返回400"
        }
      },
      "example": {
        "stack_id": "1b15e005-bdbb-4bd7-8f9a-a09b6774b4b3"
      }
    },
    "RetainAllResourcesTypeHolder": {
      "type": "object",
      "properties": {
        "retain_all_resources": {
          "type": "boolean",
          "description": "删除资源栈是否保留资源的标志位,如果不传默认为false,即默认不保留资源(删除资源栈后会删除资源栈中的资源)\n\nDeleteStackEnhanced API中,如果该参数未在RequestBody中给予,则删除时不会保留资源栈中的资源",
          "x-omitempty": false,
          "x-isnullable": true
        }
      },
      "example": {
        "retain_all_resources": true
      }
    },
    "DeleteStackEnhancedRequestBody": {
      "allOf": [
        {
          "$ref": "#/definitions/StackIdPrimitiveTypeHolder"
        },
        {
          "$ref": "#/definitions/RetainAllResourcesTypeHolder"
        }
      ]
    },
