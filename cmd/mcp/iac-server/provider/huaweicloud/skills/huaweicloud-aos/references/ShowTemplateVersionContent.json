{
  "name": "ShowTemplateVersionContent",
  "summary": "获取模板版本内容",
  "tags": "资源编排-模板管理",
  "productshort": "AOS",
  "region_id": "af-north-1",
  "paths": {
    "/v1/{project_id}/templates/{template_name}/versions/{version_id}": {
      "get": {
        "tags": [
          "Template Management"
        ],
        "summary": "获取模板版本内容",
        "description": "获取模板版本内容(ShowTemplateVersionContent)\n\n此API用于获取用户的模板版本内容\n\n  * template_id是模板的唯一Id。此Id由资源编排服务在生成模板的时候生成,为UUID。由于模板名仅仅在同一时间下唯一,即用户允许先生成一个叫HelloWorld的模板,删除,再重新创建一个同名模板。对于团队并行开发,用户可能希望确保当前我操作的模板就是我认为的那个,而不是其他队友删除后创建的同名模板。因此,使用ID就可以做到强匹配。资源编排服务保证每次创建的模板所对应的ID都不相同,更新不会影响ID。如果给予的template_id和当前模板管理的ID不一致,则返回400\n  * 此api会以临时重定向形式返回模板内容的下载链接,用户通过下载获取模板版本内容(OBS Pre Signed地址,有效期为5分钟)\n  * 如果手动访问重定向的obs下载链接,请求时不可以携带任何的Request-Header,否则会导致签名失败\n\nShowTemplateVersionContent返回的信息只包含模板版本内容,如果想知道模板版本的元数据,请调用ShowTemplateVersionMetadata",
        "operationId": "ShowTemplateVersionContent",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "Client-Request-Id",
            "in": "header",
            "description": "用户指定的,对于此请求的唯一ID,用于定位某个请求,推荐使用UUID",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 36,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{35,127}$"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,可以从调用API处获取,也可以从控制台获取。\n\n[项目ID获取方式](https://support.huaweicloud.com/api-ticket/ticket_api_20002.html)",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9-]{3,64}$",
            "x-example": "04ed32dc1b0025b52fe3c01a27c2b0a8"
          },
          {
            "name": "template_name",
            "in": "path",
            "description": "模板(Template)的名字。此名字在domain_id+region下应唯一,可以使用中文、大小写英文、数字、下划线、中划线。首字符需为中文或者英文,区分大小写。",
            "required": true,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[\\一-\\龥A-Za-z][\\一-\\龥A-Za-z0-9_-]{0,127}$"
          },
          {
            "name": "version_id",
            "in": "path",
            "description": "模板版本ID,以大写V开头,每次创建模板版本,模板版本ID数字部分会自增加一",
            "required": true,
            "type": "string",
            "maxLength": 11,
            "minLength": 2,
            "pattern": "^V[1-9][0-9]{0,9}$"
          },
          {
            "name": "template_id",
            "in": "query",
            "description": "模板的ID。当template_id存在时,模板服务会检查template_id是否和template_name匹配,不匹配会返回400",
            "required": false,
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[a-z0-9][a-z0-9-]{35}$"
          },
          {
            "name": "access_control_source_vpc_ids",
            "in": "query",
            "description": "允许访问资源栈模板的source vpc id列表, source vpc id应仅包含小写字母、数字或中划线。",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "pattern": "^[a-z0-9-]+$"
            },
            "collectionFormat": "multi",
            "maxItems": 8,
            "minItems": 1,
            "uniqueItems": true
          },
          {
            "name": "access_control_source_ips",
            "in": "query",
            "description": "允许访问资源栈模板的source ip列表,source ip应是具有CIDR表示法且带有子网掩码的IPv4地址。",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 18,
              "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\/(?:[0-9]|[12][0-9]|3[01])$"
            },
            "collectionFormat": "multi",
            "maxItems": 8,
            "minItems": 1,
            "uniqueItems": true
          }
        ],
        "security": [
          {
            "apig-auth-iam": []
          }
        ],
        "responses": {
          "307": {
            "description": "请求模板版本内容成功,重定向至下载链接进行下载",
            "headers": {
              "Location": {
                "type": "string",
                "description": "HTTP重定向指定头域,客户端可通过此头域重定向至新地址。其内容为模板下载链接,为OBS Pre Signed地址,有效期为10分钟"
              }
            },
            "schema": {
              "$ref": "#/definitions/VoidBody"
            }
          },
          "400": {
            "description": "用户请求非法",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "401": {
            "description": "用户身份认证失败",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "403": {
            "description": "用户无权限调用此API",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "404": {
            "description": "模板不存在或模板版本不存在",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "429": {
            "description": "请求数量过多",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/ErrorRsp"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-returnType": "String",
        "x-apigateway-backend": {
          "httpVpcEndpoints": {
            "description": "",
            "name": "template",
            "scheme": "https",
            "timeout": 30000
          },
          "parameters": [
            {
              "name": "project_id",
              "in": "PATH",
              "origin": "REQUEST",
              "value": "project_id"
            },
            {
              "name": "template_name",
              "in": "PATH",
              "origin": "REQUEST",
              "value": "template_name"
            },
            {
              "name": "version_id",
              "in": "PATH",
              "origin": "REQUEST",
              "value": "version_id"
            },
            {
              "name": "template_id",
              "in": "QUERY",
              "origin": "REQUEST",
              "value": "template_id"
            },
            {
              "name": "access_control_source_vpc_ids",
              "in": "QUERY",
              "origin": "REQUEST",
              "value": "access_control_source_vpc_ids"
            },
            {
              "name": "access_control_source_ips",
              "in": "QUERY",
              "origin": "REQUEST",
              "value": "access_control_source_ips"
            }
          ],
          "type": "HTTP-VPC"
        },
        "x-apigateway-cors": false,
        "x-apigateway-match-mode": "NORMAL",
        "x-apigateway-query-string-encode": "DISABLE",
        "x-apigateway-request-type": "public",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/c364070ab35041ddae68cf8b4839b60f/templates/my_template/versions/V1",
        "x-request-examples-description-1": "获取指定模板的指定版本内容",
        "x-request-examples-url-2": "GET https://{endpoint}/v1/c364070ab35041ddae68cf8b4839b60f/templates/my_template/versions/V1?template_id=1b15e005-bdbb-4bd7-8f9a-a09b6774b4b3",
        "x-request-examples-description-2": "获取指定模板的指定版本内容,并提供模板id以校验是否与当前模板匹配",
        "x-request-examples-url-3": "GET https://{endpoint}/v1/c364070ab35041ddae68cf8b4839b60f/templates/my_template/versions/V1?access_control_source_ips=100.11.5.100/24&access_control_source_ips=100.22.5.100/24",
        "x-request-examples-description-3": "获取指定模板的指定版本内容,并提供access_control_source_ips以控制允许访问资源模板的ip",
        "x-request-examples-url-4": "GET https://{endpoint}/v1/c364070ab35041ddae68cf8b4839b60f/templates/my_template/versions/V1?access_control_source_vpc_ids=d42a8768-ad3c-4bca-91t8-53870f3402a9&access_control_source_vpc_ids=d42a8768-ad3c-4bca-91t8-53870f3402a8",
        "x-request-examples-description-4": "获取指定模板的指定版本内容,并提供access_control_source_vpc_ids以控制允许访问资源模板的vpc id",
        "x-imports": [
          "com.huawei.clouds.wushan.integration.common.auth.EnableAuth;",
          "com.huawei.clouds.wushan.auth.token.IamAuthMeta;",
          "com.huawei.clouds.wushan.auth.token.IamAuthLevel;",
