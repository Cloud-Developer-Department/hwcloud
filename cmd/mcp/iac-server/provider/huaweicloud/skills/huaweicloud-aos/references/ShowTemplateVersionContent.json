        ],
        "x-method-annotations": [
          "@EnableAuth",
          "@IamAuthMeta(abacAction = \"rf:privateTemplate:showVersionContent\", authLevel = IamAuthLevel.INSTANCE, needAbacResourceCheck = true, needApigwJwtAuthCheck = true, authContextInitializerName = \"defaultIamAuthContextInitializer\")",
          "@IamAuthParam(instanceId = \"template_name\")",
          "@CtsMeta(resourceType = \"rf-template\", traceName = \"showTemplateVersionContent\", operationId = \"ShowTemplateVersionContent\")"
        ]
      }
    }
  },
