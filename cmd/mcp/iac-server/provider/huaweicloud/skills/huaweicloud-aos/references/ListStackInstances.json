          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-rfs-internal": "Y",
        "x-rfs-external": "Y",
        "x-api-type": "open-api",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/stack-sets/my_hello_world_stack_set/stack-instances?filter=stack_domain_id==stackDomainIdA|stack_domain_id==stackDomainIdB",
        "x-request-examples-description-1": "通过filter获取指定资源栈集在成员账号domainA和domainB下的资源栈实例",
        "x-request-examples-url-2": "GET https://{endpoint}/v1/stack-sets/my_hello_world_stack_set/stack-instances?sort_key=create_time&sort_dir=asc",
        "x-request-examples-description-2": "通过sort_key和sort_dir指定返回的资源栈实例列表,以创建时间升序返回"
      }
    }
  },
