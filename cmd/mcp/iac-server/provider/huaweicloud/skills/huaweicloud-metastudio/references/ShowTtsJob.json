  "definitions": {
    "TtsJobDetail": {
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID。",
          "minLength": 1,
          "maxLength": 128
        },
        "websocket_job_id": {
          "type": "string",
          "description": "websocket任务ID。",
          "minLength": 1,
          "maxLength": 255
        },
        "asset_id": {
          "type": "string",
          "description": "音色ID",
          "minLength": 1,
          "maxLength": 48
        },
        "tts_service_enum": {
          "type": "string",
          "description": "声音版本",
          "minLength": 1,
          "maxLength": 64
        },
        "text_length": {
          "type": "integer",
          "description": "文本长度",
          "minimum": 1,
          "maximum": 10000
        },
        "create_time": {
          "type": "string",
          "description": "任务创建时间。",
          "minLength": 0,
          "maxLength": 20
        },
        "audio_format": {
          "type": "string",
          "description": "输出音频文件格式。默认WAV。\n* WAV:wav格式。\n* MP3:mp3格式。\n* PCM:pcm格式。",
          "minLength": 1,
          "maxLength": 10,
          "default": "WAV"
        },
        "need_timestamp": {
          "type": "boolean",
          "description": "是否需要时间戳。false为不需要,true为需要返回时间戳信息。默认值为false。",
          "default": false
        },
        "gen_srt": {
          "type": "boolean",
          "description": "是否开启字幕"
        },
        "job_type": {
          "type": "string",
          "example": "ASYNC_JOB",
          "description": "任务类型。\n* PRELOAD:预加载任务\n* WEBSOCKET:websocket接口任务\n* ASYNC_JOB:异步任务\n* AUDITION:试听任务",
          "minLength": 0,
          "maxLength": 64
        },
        "job_state": {
          "type": "string",
          "description": "任务状态。\n* WAITING:等待中\n* PROCESSING:合成中\n* FAILED:合成失败\n* SUCCEED:合成成功",
          "minLength": 1,
          "maxLength": 64
        },
        "fail_msg": {
          "type": "string",
          "description": "任务合成错误信息",
          "minLength": 1,
          "maxLength": 100000
        },
        "files": {
          "type": "array",
          "description": "任务合成文件列表。",
          "items": {
            "$ref": "#/definitions/TtsJobFile"
          },
          "maxItems": 255,
          "minItems": 0
        }
      },
      "description": "文本转语音任务合成记录。",
      "x-imports": "com.huawei.mss.annotation4ttscs.TextLength;"
    },
    "ShowTtsJobResponseBody": {
      "required": [
        "count",
        "data"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "example": 1,
          "description": "总记录数。",
          "minimum": 0,
          "maximum": 2147483647
