            "description": "任务ID。",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "name": "job_type",
            "in": "query",
            "description": "任务类型。\n* AUDITION:试听任务\n* ASYNC_JOB:异步任务\n* WEBSOCKET:websocket接口合成任务",
            "required": false,
            "type": "string",
            "maxLength": 20,
            "minLength": 0,
            "x-example": "WEBSOCKET"
          },
          {
            "name": "tts_service_enum",
            "in": "query",
            "description": "tts版本。\n* TTS_LLM: 530大模型(V7版本)\n* TTS_LLM_VC:530大模型VC版本(V7版本)\n* TTS_LAB:lab小模型(V5版本)\n* TTS_LAB_GPU:lab小模型GPU版本(V5版本)\n* GPU_CLONE:V4模型\n* TTS_LLM_VQ:VQ模型(V10版本)",
            "required": false,
            "type": "string",
            "maxLength": 20,
            "minLength": 0,
            "x-example": "TTS_LLM"
          },
          {
            "name": "business_type",
            "in": "query",
            "description": "业务类型。",
            "required": false,
            "type": "string",
            "maxLength": 1000,
            "minLength": 0,
            "x-example": "DHIS"
          }
        ],
