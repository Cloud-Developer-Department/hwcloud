{
  "name": "CreateDigitalAsset",
  "summary": "创建资产",
  "tags": "数字资产管理",
  "productshort": "MetaStudio",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/digital-assets": {
      "post": {
        "tags": [
          "DigitalAssetContentManager"
        ],
        "summary": "创建资产",
        "description": "该接口用于在资产库中添加上传新的媒体资产。可上传的资产类型包括:分身数字人模型、背景图片、素材图片、素材视频、PPT等。\n> 上传的图片、视频和背景图片,如果需要在视频制作素材中可见,需要设置system_properties。\n> - 资产类型是IMAGE时,通过system_properties来区分背景图片(BACKGROUND_IMG)、素材图片(MATERIAL_IMG)。\n> - 资产类型是VIDEO时,通过system_properties来区分素材视频(MATERIAL_VIDEO)、名片视频(BUSSINESS_CARD_VIDEO)。\n> MetaStudio平台生成的视频,system_properties带CREATED_BY_PLATFORM。",
        "operationId": "CreateDigitalAsset",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-App-UserId"
          },
          {
            "name": "X-MSS-Authorization",
            "in": "header",
            "description": "数字人内部token",
            "required": false,
            "type": "string",
            "maxLength": 1024,
            "minLength": 0
          },
          {
            "in": "body",
            "name": "CreateDigitalAssetRequestBody",
            "description": "创建资产",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateDigitalAssetRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "examples": {
              "application/json": {
                "asset_id": "93769b5a-c8c6-4692-9c95-53933a1f0c93"
              }
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求ID。"
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateDigitalAssetResponseBody"
            }
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-apig-group": "public-iam,internal-appcode",
        "x-open-range": "public",
        "x-constraint": "- 不同资产类型主文件格式与大小约束如下\n  视频资产:资产类型为VIDEO,主文件格式(忽略大小写)为mp4、m4v、mkv、mov、flv、3gp、wmv、avi、webm,主文件大小不超过5G\n  图片资产:资产类型为IMAGE,主文件格式(忽略大小写)为jpeg、jpg、png、bmp、gif,主文件大小不超过50M\n  背景音乐资产:资产类型为MUSIC,主文件格式(忽略大小写)为wav,mp3,m4a,主文件大小不超过100M\n  音频资产:资产类型为AUDIO,主文件格式(忽略大小写)为wav,mp3,m4a,主文件大小不超过100M\n  幻灯片资产:资产类型为PPT,主文件格式(忽略大小写)为ppt、pptx和pdf,主文件大小不超过100M",
        "x-classAnnotation": "@HttpStatusController",
        "x-methodAnnotations": [
          "@DeprecatedUserIdApi"
        ],
        "x-imports": "com.huawei.springframework.advice.HttpStatusController;com.huawei.springframework.om.trace.masker.annotation.ResponseMaskRule;com.huawei.springframework.om.trace.masker.annotation.Rule;com.huawei.springframework.om.trace.masker.base.PasswordMasker;com.huawei.common.annotations.DeprecatedUserIdApi",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/6a6a1f8354f64dd9b9a614def7b59d83/digital-assets",
        "x-request-examples-1": {
          "asset_name": "云笙模型",
          "asset_description": "数字人员工",
          "asset_type": "HUMAN_MODEL_2D",
          "tags": [
            "数字人员工"
          ]
        },
        "x-order": 0
      }
    }
  },
  "definitions": {
    "HumanModel2DAssetMeta": {
      "type": "object",
      "properties": {
        "is_action_editable": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n分身数字人的动作是否可编辑\n**约束限制**:\n不涉及\n**取值范围**:\n* true: 动作可编辑\n* false: 动作不可编辑",
          "default": false
        },
        "is_live_copy": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n是否是直播间复刻任务\n**约束限制**:\n不涉及\n**取值范围**:\n* true: 是直播间复刻任务\n* false: 不是直播间复刻任务",
          "default": false
        },
        "is_real_background": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n是否是实景分身数字人\n**约束限制**:\n实景分身数字人不做背景替换。\n**取值范围**:\n* true: 实景分身数字人\n* false: 普通分身数字人,不带背景。",
          "default": false
        },
        "support_live": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n是否支持直播\n**约束限制**:\n不涉及\n**取值范围**:\n* true: 支持直播\n* false: 不支持直播。",
          "default": false
        },
        "model_version": {
          "type": "string",
          "example": "V3",
          "description": "**参数解释**:\n分身数字人模型版本\n**约束限制**:\n不涉及\n**取值范围**:\n* V2: V2版本模型\n* V3:V3版本模型\n* V3_2:V3.2版本模型\n* V3_3:V3.3版本模型",
          "minLength": 0,
          "maxLength": 64,
          "enum": [
            "V2",
            "V3",
            "V3_2",
            "V3_3"
          ],
          "default": "V2"
        },
        "model_resolution": {
          "type": "string",
          "example": "1080P",
          "description": "**参数解释**:\n分身数字人模型分辨率。\n**约束限制**:\n不涉及\n**取值范围**:\n* 1080P:1080P。支持1080P及720P的视频输出。\n* 4K:4K。支持4K、1080P及720P的视频输出。",
          "minLength": 0,
          "maxLength": 64,
          "default": "1080P"
        },
        "device_names": {
          "type": "array",
          "description": "**参数解释**:\n已执行编译任务设备类型列表。\n**约束限制**:\n支持走动的数字人,当前仅用于视频制作,不能用于直播和智能交互\n**取值范围**:\n设备名称列表最多16个。\n设备名称字符长度1-64位。\n**默认取值**:\nfalse",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 16,
          "minItems": 0,
          "x-maxLength": 16,
          "x-minLength": 0
        },
        "is_with_action_library": {
          "type": "boolean",
          "example": true,
          "description": "分身数字人是否带原子动作库。\n> * 带原子动作库的分身数字人可做动作编排。",
          "default": false
        },
        "action_tag_map": {
          "type": "array",
          "description": "动作标签映射。",
          "items": {
            "$ref": "#/definitions/ActionTagInfo"
          },
          "maxItems": 256,
          "minItems": 0,
          "x-maxLength": 256,
          "x-minLength": 0
        },
        "is_flexus": {
          "type": "boolean",
          "example": true,
          "description": "是否是Flexus版本分身数字人。",
          "default": false
        },
        "voice_asset_id": {
          "type": "string",
          "example": "8cb2f48a2cb006154794741933421100",
          "description": "形象关联的声音资产ID。",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "description": "分身模型元数据"
    },
    "MaterialComponentInfo": {
      "required": [
        "component_name",
        "component_type"
      ],
      "properties": {
        "component_name": {
          "type": "string",
          "description": "素材组件名称。",
          "minLength": 1,
          "maxLength": 256
        },
        "component_type": {
          "type": "string",
          "description": "素材组件类型。\n* CLOTHES:衣服\n* PANTS:裤子\n* SHOES:鞋子\n* HAIR:头发\n* EYELASH:睫毛\n* EYEBROW:眉毛",
          "minLength": 1,
          "maxLength": 256,
          "enum": [
            "CLOTHES",
            "PANTS",
            "SHOES",
            "HAIR",
            "EYELASH",
            "EYEBROW"
          ]
        },
        "component_desc": {
          "type": "string",
          "description": "素材组件描述。",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "description": "可替换的素材组件信息"
    },
    "CreateDigitalAssetRequestBody": {
      "type": "object",
      "required": [
        "asset_name",
        "asset_type"
      ],
      "properties": {
        "asset_name": {
          "type": "string",
          "example": "yunsheng",
          "description": "**参数解释**:\n资产名称。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能使用中英文字符,字符长度0-256位。\n**默认取值**:\n不涉及。",
          "minLength": 0,
          "maxLength": 256
        },
        "asset_description": {
          "type": "string",
          "example": "云笙的模型资产。",
          "description": "**参数解释**:\n资产描述。\n**约束限制**:\n不涉及。\n**取值范围**:\n只能使用中英文字符,字符长度0-4096位。\n**默认取值**:\n不涉及。",
          "minLength": 0,
          "maxLength": 4096
        },
        "asset_type": {
          "type": "string",
          "example": "HUMAN_MODEL_2D",
          "description": "**参数解释**:\n资产类型。\n**约束限制**:\nVOICE_MODEL,HUMAN_MODEL_2D 普通用户均无法上传。\n**取值范围**:\n公共资产类型:\n* VOICE_MODEL:音色模型\n* VIDEO:视频文件\n* IMAGE:图片文件\n* PPT:幻灯片文件\n* MUSIC: 音乐\n* AUDIO: 音频\n* COMMON_FILE:通用文件\n\n分身数字人资产:\n* HUMAN_MODEL_2D: 分身数字人模型\n* BUSINESS_CARD_TEMPLET: 数字人名片模板\n\n**默认取值**:\n不涉及。",
          "enum": [
            "HUMAN_MODEL",
            "VOICE_MODEL",
            "SCENE",
            "ANIMATION",
            "VIDEO",
            "IMAGE",
            "PPT",
            "MATERIAL",
            "NORMAL_MODEL",
            "COMMON_FILE",
            "HUMAN_MODEL_2D",
            "BUSINESS_CARD_TEMPLET",
            "MUSIC",
            "AUDIO"
          ]
        },
        "review_config": {
          "description": "内容审核配置。",
          "$ref": "#/definitions/ReviewConfig"
        },
        "tags": {
          "type": "array",
          "example": [
            "女性",
            "现代"
          ],
          "description": "**参数解释**:\n标签列表。\n> 分身形象系统资产的tag定义如下:\n> - 行业:NEWS,BUSINESS,E_COMMERCE,MARKETING,KNOWLEDGE,EDUCATION,MEDICAL,SPORTS\n> - 性别:MALE,FEMALE\n> - 姿势:FULL_BODY,HALF_BODY,STANDING,SITTING,FRONT_PHOTO,SIDE_PHOTO\n> - 区域:ASIAN,WESTERN,MIDDLE_EASTERNER,AFRICAN,LATINO\n\n**约束限制**:\n不涉及\n**取值范围**:\n标签个数最大为50个。\n标签内容为中英文,字符长度0-128位。\n**默认取值**:\n不涉及",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          },
          "maxItems": 50,
          "minItems": 0,
          "x-maxLength": 50,
          "x-minLength": 0
        },
        "asset_extra_meta": {
          "$ref": "#/definitions/AssetExtraMeta"
        },
        "system_properties": {
          "type": "array",
          "description": "**参数解释**:\n设置系统属性。内部参数,普通用户无需设置。\n**约束限制**:\n不涉及\n**取值范围**:\n个数最大为50个。\n**默认取值**:\n不涉及",
          "items": {
            "$ref": "#/definitions/SystemProperty"
          },
          "maxItems": 50,
          "minItems": 0,
          "x-maxLength": 50,
          "x-minLength": 0
        },
        "shared_config": {
          "description": "**参数解释**:\n资产共享配置。\n**约束限制**:\n当前仅用于直播模板分享连带的资产共享。\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
          "$ref": "#/definitions/AssetSharedConfig"
        },
        "is_need_generate_cover": {
          "type": "boolean",
          "description": "**参数解释**:\n是否需要生成封面。\n**约束限制**:\n仅用于视频类资产。\n**取值范围**:\n* true:自动生成封面。\n* false:不自动生成封面。",
          "default": false
        },
        "asset_order": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "**参数解释**:\n用于console控制台展示顺序。\n如果取值相同,则默认最新的排在前面。\n**约束限制**:\n不涉及\n**默认取值**:\n不涉及",
          "minimum": 0,
          "maximum": 32767
        },
        "supported_service": {
          "type": "array",
          "example": [
            "VIDEO_2D",
            "LIVE_2D"
          ],
          "description": "支持的业务类型。:\n* VIDEO_2D:分身数字人视频制作\n* LIVE_2D:分身数字人直播\n* CHAT_2D:分身数字人智能交互",
          "items": {
            "$ref": "#/definitions/SupportedServiceEnum"
          },
          "maxItems": 10,
          "minItems": 0
        },
        "auto_operation_config": {
          "type": "array",
          "description": "资产自动处理任务。",
          "items": {
            "$ref": "#/definitions/AutoOperationConfig"
          },
          "maxItems": 10,
          "minItems": 0,
          "x-maxLength": 10,
          "x-minLength": 0
        }
      },
      "description": "创建资产请求体。"
    },
    "AssetExtraMeta": {
      "type": "object",
      "properties": {
        "voice_model_meta": {
          "$ref": "#/definitions/VoiceModelAssetMeta"
        },
        "ppt_meta": {
          "$ref": "#/definitions/PPTAssetMeta"
        },
        "material_meta": {
          "$ref": "#/definitions/MaterialAssetMeta"
        },
        "human_model_2d_meta": {
          "$ref": "#/definitions/HumanModel2DAssetMeta"
        },
        "image_meta": {
          "$ref": "#/definitions/ImageAssetMeta"
        },
        "video_meta": {
          "$ref": "#/definitions/VideoAssetMeta"
        },
        "audio_meta": {
          "$ref": "#/definitions/AudioAssetMeta"
        }
      },
      "description": "**参数解释**:\n资产额外元数据。\n\n**约束限制**:\n根据asset_type选择对应结构填写,填写其他不匹配的结构会被忽略。\n* HUMAN_MODEL_2D: 填写human_model_2d_meta\n* MATERIAL:填写material_meta\n* VOICE_MODEL:填写voice_model_meta\n* VIDEO:填写video_meta\n* IMAGE:填写image_meta\n* PPT:填写ppt_meta\n* AUDIO: 填写audio_meta"
    },
    "ReviewConfig": {
      "type": "object",
      "properties": {
        "no_need_review": {
          "type": "boolean",
          "description": "免审核。 目前仅白名单用户可使用此参数,非白名单用户跟随系统策略审核。"
        }
      },
      "description": "内容审核配置"
    },
    "ExternalVoiceAssetMeta": {
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "example": "XIMALAYA",
          "description": "第三方TTS供应商类型。\n* XIMALAYA:喜马拉雅TTS\n* HUAWEI_EI:华为云EI TTS\n* MOBVOI:出门问问 TTS\n* AUDIOX:逻辑智能 TTS\n* SINOVOICE:捷通华声 TTS\n* DATABAKER:标贝 TTS\n* AISPEECH:思必驰 TTS",
          "minLength": 0,
          "maxLength": 32,
          "enum": [
            "XIMALAYA",
            "HUAWEI_EI",
            "MOBVOI",
            "AUDIOX",
            "SINOVOICE",
            "DATABAKER",
            "AISPEECH"
          ]
        }
      },
      "description": "第三方TTS音色元数据。"
    },
    "VoiceLanguage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "description": "**参数解释**:\n声音语言。\n**约束限制**:\n不涉及。\n**取值范围**:\n* UNKNOW:未知\n* CN:中文\n* EN:英文\n* GER:德语\n* fr:法语\n* Kr:韩语\n* por:葡萄牙语\n* JPN:日语\n* Ita:意大利语\n* ESP:西班牙语\n* DBH:东北话\n* GT:港台\n* GXH:广西话\n* HBH:湖北话\n* SXH:陕西话\n* SCH:四川话\n* YY:粤语\n* Russian: 俄罗斯语\n* Filipino: 菲律宾语\n* Dutch: 荷兰语\n* Indonesian: 印尼语\n* Vietnamese: 越南语\n* Arabic: 阿拉伯语\n* Turkish: 土耳其语\n* Malay: 马来语\n* Thai: 泰语\n* Finnish: 芬兰语",
      "enum": [
        "UNKNOW",
        "CN",
        "EN",
        "GER",
        "fr",
        "Kr",
        "por",
        "JPN",
        "Ita",
        "ESP",
        "DBH",
        "GT",
        "GXH",
        "HBH",
        "SXH",
        "SCH",
        "YY",
        "Russian",
        "Filipino",
        "Dutch",
        "Indonesian",
        "Vietnamese",
        "Arabic",
        "Turkish",
        "Malay",
        "Thai",
        "Finnish"
      ],
      "default": "UNKNOW"
    },
    "MaterialAssetMeta": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "description": "可替换的素材组件列表。",
          "items": {
            "$ref": "#/definitions/MaterialComponentInfo"
          },
          "maxItems": 512,
          "minItems": 0,
          "x-maxLength": 512,
          "x-minLength": 0
        }
      },
      "description": "素材元数据。"
    },
    "VoiceModelAssetMeta": {
      "properties": {
        "order": {
          "type": "integer",
          "example": 1,
          "description": "**参数解释**:\n展示顺序。\n**约束限制**:\n不涉及。",
          "minimum": 0,
          "maximum": 32767
        },
        "model_type": {
          "type": "string",
          "example": "COMMON",
          "description": "**参数解释**:\n声音资产类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n* COMMON:通用情感模型\n* CLONE:语音克隆模型",
          "minLength": 0,
          "maxLength": 32,
          "enum": [
            "COMMON",
            "CLONE"
          ],
          "default": "CLONE"
        },
        "sex": {
          "type": "string",
          "example": "MALE",
          "description": "**参数解释**:\n声音性别。\n**约束限制**:\n不涉及。\n**取值范围**:\n* UNKNOW:未知性别声音\n* MALE:男性声音\n* FEMALE:女性声音",
          "minLength": 1,
          "maxLength": 16,
          "enum": [
            "UNKNOW",
            "MALE",
            "FEMALE"
          ],
          "default": "UNKNOW"
        },
