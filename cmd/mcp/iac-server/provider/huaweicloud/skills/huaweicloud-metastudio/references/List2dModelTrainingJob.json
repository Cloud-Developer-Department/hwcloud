  "definitions": {
    "TrainingJobBasicInfo": {
      "type": "object",
      "required": [
        "job_id",
        "name",
        "state"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "example": "7affc1c9d10b9779957fce7d4aecbd35",
          "description": "任务ID。",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "example": "华为云笙",
          "description": "分身数字人模型名称。该名称会作为资产库中分身数字人模型资产名称。",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "type": "string",
          "description": "任务的状态。\n\n与MetaStudio Console上用户看到的状态映射关系如下:\n\n- 待提交\n  * WAIT_FILE_UPLOAD: 待上传文件\n\n- 系统审核中\n  * AUTO_VERIFYING: 自动审核中\n  * MANUAL_VERIFYING: 人工审核中\n\n- 系统审核未通过\n  * AUTO_VERIFY_FAILED: 自动审核失败\n  * MANUAL_VERIFY_FAILED: 人工审核失败\n\n- 算法训练中\n  > 算法训练中的状态仅管理员需要处理,普通用户仅需要显示“算法训练中”即可。\n  * MANUAL_VERIFY_SUCCESS: 审核通过,等待预处理资源\n  * WAIT_TRAINING_DATA_PREPROCESS: 等待训练数据预处理\n  * TRAINING_DATA_PREPROCESSING: 训练数据预处理中\n  * TRAINING_DATA_PREPROCESS_FAILED: 训练数据预处理失败\n  * TRAINING_DATA_PREPROCESS_SUCCESS: 训练数据预处理完成,等待训练资源中\n  * TRAINING: 训练中\n  * TRAIN_FAILED: 训练失败\n  * TRAIN_SUCCESS: 训练完成,等待预处理资源\n  * INFERENCE_DATA_PREPROCESSING: 推理数据预处理中\n  * INFERENCE_DATA_PREPROCESS_FAILED: 推理数据预处理失败\n  * WAIT_MAIN_FILE_UPLOAD: 等待主文件上传\n  * MANUAL_STOP_INFERENCE_DATA_PREPROCESS: 人工中止推理预处理\n  * MANUAL_STOP_TRAIN: 人工中止训练\n  * MANUAL_STOP_TRAINING_DATA_PREPROCESS: 人工中止训练预处理\n  * WAIT_ADMIN_CONFIRM: 等待管理员审核\n  * WAIT_COMPILE: 等待转编译\n  * COMPILING: 转编译中\n  * COMPILE_FAILED: 转编译失败\n  * WAIT_GENERATE_ACTION: 等待原子动作生成\n  * WAIT_ARRANGE: 等待编排\n  * ACTION_GENERATE_DATA_PROCESSING: 原子动作生成中\n  * MANUAL_STOP_ACTION_GENERATE_DATA_PROCESSING: 人工中止动作生成\n  * MANUAL_STOP_ACTION_GENERATE_ORI_PROCESSING: 人工中止动作编排\n  * ACTION_GENERATE_ORI_PROCESSING: 动作编排中\n  * ACTION_GENERATE_DATA_FAILED: 动作生成失败\n  * ACTION_GENERATE_ORI_FAILED: 生成动作编排资产失败\n  * ACTION_GENERATE_ORI_SUCCESS: 动作编排成功\n  * GENERATE_ACTION_PREPROCESS_FAILED: 生成动作编排原子动作失败\n  * WAIT_ADMIN_CALIBRATION: 等待管理员确认动作信息\n  * WAIT_ASSET_SYNC: 等待资产同步\n  * WAIT_GENERATE_ACTION_MARK 等待动作标定\n  * ACTION_MARKING: 动作标定生成\n- 待用户审核,仅NA白名单用户有该状态\n  * WAIT_USER_CONFIRM: 等待用户确认训练效果\n\n- 用户驳回,仅NA白名单用户有该状态\n  * JOB_REJECT: 驳回任务\n\n- 已完成\n  * JOB_SUCCESS: 训练任务完成(普通用户任务的完成状态,此时用户已经可以使用模型)\n  * JOB_FINISH: 任务结束,是最终状态,不支持修改此状态(NA用户任务的完成状态,并且此状态表明模型效果已通过用户的验收)\n\n- 挂起,仅NA白名单用户有该状态\n  * JOB_PENDING: 挂起任务\n\n * WAIT_TEST_VIDEO_CHECK: 等待进行测试视频推理任务\n * TEST_VIDEO_CHECK_PROCESSING:测试视频推理质量检测中\n * TEST_VIDEO_CHECK_SUCCESS:测试视频推理质量检测通过\n * TEST_VIDEO_CHECK_FAILED:测试视频推理质量检测未通过\n * VIDEO_ANALYZE_PROCESSING:视频检测中\n * VIDEO_ANALYZE_SUCCESS:视频检测通过\n * VIDEO_ANALYZE_FAILED:视频检测未通过\n * ACTION_MARKING:动作标定中\n * ACTION_MARK_SUCCESS:动作标定成功\n * ACTION_MARK_FAILED:动作标定失败\n * ACTION_MARK_UPLOADED:动作标定文件上传成功\n * MANUL_STOP_ACTION_MARK:中止动作标定",
          "minLength": 1,
          "maxLength": 64,
          "enum": [
            "WAIT_FILE_UPLOAD",
            "AUTO_VERIFYING",
            "AUTO_VERIFY_FAILED",
            "MANUAL_VERIFYING",
            "WAIT_TRAINING_DATA_PREPROCESS",
            "MANUAL_VERIFY_FAILED",
            "MANUAL_VERIFY_SUCCESS",
            "TRAINING_DATA_PREPROCESSING",
            "TRAINING_DATA_PREPROCESS_FAILED",
            "TRAINING_DATA_PREPROCESS_SUCCESS",
            "TRAINING",
            "TRAIN_FAILED",
            "TRAIN_SUCCESS",
            "INFERENCE_DATA_PREPROCESSING",
            "INFERENCE_DATA_PREPROCESS_FAILED",
            "WAIT_MASK_UPLOAD",
            "WAIT_MAIN_FILE_UPLOAD",
            "JOB_SUCCESS",
            "MANUAL_STOP_INFERENCE_DATA_PREPROCESS",
            "MANUAL_STOP_TRAIN",
            "MANUAL_STOP_TRAINING_DATA_PREPROCESS",
            "MANUAL_STOP_BEAUTY_PREPROCESS",
            "WAIT_USER_CONFIRM",
            "JOB_REJECT",
            "JOB_PENDING",
            "WAIT_ASSET_SYNC",
            "WAIT_ADMIN_CONFIRM",
            "JOB_FINISH",
            "COMPILING",
            "WAIT_COMPILE",
            "COMPILE_FAILED",
            "WAIT_BEAUTY",
            "WAIT_GENERATE_ACTION",
            "WAIT_ARRANGE",
            "ACTION_GENERATE_DATA_PROCESSING",
            "MANUAL_STOP_ACTION_GENERATE_DATA_PROCESSING",
            "MANUAL_STOP_ACTION_GENERATE_ORI_PROCESSING",
            "ACTION_GENERATE_ORI_PROCESSING",
            "ACTION_GENERATE_DATA_FAILED",
            "ACTION_GENERATE_ORI_FAILED",
            "ACTION_GENERATE_ORI_SUCCESS",
            "GENERATE_ACTION_PREPROCESS_FAILED",
            "WAIT_ADMIN_CALIBRATION",
            "BEAUTY_VIDEO_FILE_UPLOADED",
            "BEAUTYFACE_SUCCESS",
            "BEAUTYFACE_FAILED",
            "WAIT_BEAUTY_VIDEO_FILE_UPLOAD",
            "BEAUTYFACE_ROCESSING",
            "WAIT_TEST_VIDEO_CHECK",
            "TEST_VIDEO_CHECK_PROCESSING",
            "TEST_VIDEO_CHECK_SUCCESS",
            "TEST_VIDEO_CHECK_FAILED",
            "VIDEO_ANALYZE_PROCESSING",
            "VIDEO_ANALYZE_SUCCESS",
            "VIDEO_ANALYZE_FAILED",
            "ACTION_MARKING",
            "ACTION_MARK_SUCCESS",
            "ACTION_MARK_FAILED",
            "ACTION_MARK_UPLOADED",
            "WAIT_GENERATE_ACTION_MARK",
            "MANUL_STOP_ACTION_MARK"
          ]
        },
        "asset_id": {
          "type": "string",
          "example": "7affc1c9d10b9779957fce7d4aecbd35",
          "description": "模型资产ID。",
          "minLength": 1,
          "maxLength": 64
        },
        "project_id": {
