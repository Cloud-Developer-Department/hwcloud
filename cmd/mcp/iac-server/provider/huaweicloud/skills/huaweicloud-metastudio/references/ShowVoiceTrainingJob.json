    "ChardMode": {
      "type": "string",
      "description": "资源计费类型。\n* ON_DEMAND:按需计费,目前只有进阶版声音,最多制作三个任务\n* PERIODIC: 包周期\n* ONE_TIME:一次性计费\n> * 一次性计费包括:租户订购的一次性资源,SP管理员分配给租户的一次性资源。",
      "example": "ONE_TIME",
      "enum": [
        "PERIODIC",
        "ONE_TIME",
        "ON_DEMAND"
      ],
      "default": "ONE_TIME"
