{
  "name": "SignAgreement",
  "summary": "签署云服务声明",
  "tags": "租户管理",
  "productshort": "MetaStudio",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/tenants/service-agreements/signed": {
      "post": {
        "tags": [
          "TenantManager"
        ],
        "summary": "签署云服务声明",
        "description": "签署云服务声明。调用此接口前请知悉[metastudio隐私协议](https://www.huaweicloud.com/declaration/tsa_metastudio.html)。",
        "operationId": "SignAgreement",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "签署云服务声明已签署",
            "examples": {
              "application/json": {
                "current_version": "V20230512",
                "need_to_sign": true,
                "signed_version": "V20230512",
                "signed_time": "202-05-20T08:43:17Z"
              }
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求ID。"
              }
            },
            "schema": {
              "$ref": "#/definitions/AgreementSignInfo"
            }
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          },
          "401": {
            "$ref": "#/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/responses/Forbidden"
          },
          "500": {
            "$ref": "#/responses/InternalServiceError"
          }
        },
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-apig-group": "public-iam,internal-appcode",
        "x-open-range": "public",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/{projectId}/tenants/service-agreements/signed"
      }
    }
  },
  "definitions": {
    "AgreementSignInfo": {
      "type": "object",
      "required": [
        "current_version",
        "need_to_sign"
      ],
      "properties": {
        "current_version": {
          "type": "string",
          "description": "当前服务协议版本",
          "minLength": 0,
          "maxLength": 64
        },
        "need_to_sign": {
          "type": "boolean",
          "description": "是否需要签署",
          "default": true
        },
        "signed_version": {
          "type": "string",
          "description": "签署服务协议版本",
          "minLength": 0,
          "maxLength": 64
        },
        "signed_time": {
          "type": "string",
          "description": "协议签署时间。格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"",
          "minLength": 0,
          "maxLength": 20
        },
        "resign_deadline": {
          "type": "string",
          "example": "2024-10-10T15:59:59Z",
          "description": "签署最后期限。格式遵循:RFC 3339 如\"2024-10-10T15:59:59Z\"",
          "minLength": 0,
          "maxLength": 20
        },
        "resign_expire_process_mode": {
          "type": "string",
          "description": "重新签署过期处理方式:EXPIRE_AUTO_AGREE 自动签署协议,EXPIRE_STOP_SERVICE 强制签署协议",
          "minLength": 0,
          "maxLength": 64,
          "enum": [
            "EXPIRE_AUTO_AGREE",
            "EXPIRE_STOP_SERVICE"
          ]
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Sdk-DateHeader": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n\n格式为(YYYYMMDD'T'HHMMSS'Z')。",
      "required": false,
      "type": "string",
      "maxLength": 16,
      "minLength": 16,
      "x-annotations": [
        "@Size(min = 16, max = 16)"
      ],
      "x-example": "20191115T033655Z",
      "x-apig-registered": false
    },
    "X-Project-IdHeader": {
      "name": "X-Project-Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
      "required": false,
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 64)"
      ],
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
      "x-apig-registered": false
    },
    "AuthorizationHeader": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 256)"
      ],
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx",
      "x-apig-registered": false
    },
    "X-Auth-TokenHeader": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取。\n\n响应消息头中X-Subject-Token的值。",
      "required": false,
      "type": "string",
      "maxLength": 16384,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 16384)"
      ],
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "x-apig-registered": false
    },
    "Project-IdPath": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参考[获取项目ID](metastudio_02_0006.xml)。",
      "required": true,
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 64)"
      ],
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    }
  },
  "host": "metastudio.cn-east-3.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "post",
  "uri": null
}