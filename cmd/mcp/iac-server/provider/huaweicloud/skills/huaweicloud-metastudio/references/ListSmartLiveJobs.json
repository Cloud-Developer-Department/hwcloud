{
  "name": "ListSmartLiveJobs",
  "summary": "查询租户所有数字人直播任务列表",
  "tags": "直播任务管理",
  "productshort": "MetaStudio",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/smart-live-jobs": {
      "get": {
        "tags": [
          "SmartLiveJobManager"
        ],
        "summary": "查询租户所有数字人直播任务列表",
        "description": "该接口用于查询租户所有数字人智能直播任务列表。",
        "operationId": "ListSmartLiveJobs",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader"
          },
          {
            "$ref": "#/parameters/X-App-UserId"
          },
          {
            "$ref": "#/parameters/OffsetQuery"
          },
          {
            "$ref": "#/parameters/LimitQuery"
          },
          {
            "$ref": "#/parameters/StateQuery"
          },
          {
            "$ref": "#/parameters/SortKeyQuery"
          },
          {
            "$ref": "#/parameters/SortDirQuery"
          },
          {
            "$ref": "#/parameters/CreateSinceQuery"
          },
          {
            "$ref": "#/parameters/CreateUntilQuery"
          },
          {
            "name": "room_name",
            "in": "query",
            "description": "按直播间名称模糊查询。",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "examples": {
              "application/json": {
                "count": 1,
                "smart_live_jobs": [
                  {
                    "job_id": "26f06524-4f75-4b3a-a853-b649a21aaf66",
                    "state": "WAITING",
                    "start_time": "2022-01-18T16:29:36Z",
                    "end_time": "2022-01-18T16:30:36Z",
                    "duration": 60
                  }
                ]
              }
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求ID。"
              }
            },
            "schema": {
              "$ref": "#/definitions/ListSmartLiveJobsInfo"
            }
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          },
          "401": {
            "$ref": "#/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/responses/InternalServiceError"
          }
        },
        "x-interface-frequency": "LOW",
        "x-interface-rist": "LOW",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-apig-group": "public-iam,internal-appcode",
        "x-open-range": "public",
        "x-feature": "2dlive",
        "x-navigation-title": "ListSmartLiveJobs",
        "x-request-examples-url-1": "GET https://metastudio.cn-north-4.myhuaweicloud.com/v1/70b76xxxxxx34253880af501cdxxxxxx/smart-live-rooms/24bad716-87b1-45e5-8912-6102f7693265/smart-live-jobs"
      }
    }
  },
  "definitions": {
    "LiveJobLog": {
      "properties": {
        "interaction_records_url": {
          "type": "string",
          "description": "直播互动记录文件地址",
          "minLength": 0,
          "maxLength": 2048
        },
        "job_config_records_url": {
          "type": "string",
          "description": "任务配置记录文件地址",
          "minLength": 0,
          "maxLength": 2048
        },
        "scripts_records_url": {
          "type": "string",
          "description": "剧本播放记录文件地址",
          "minLength": 0,
          "maxLength": 2048
        },
        "command_reviced_records_url": {
          "type": "string",
          "description": "命令接受记录文件地址",
          "minLength": 0,
          "maxLength": 2048
        },
        "command_exec_records_url": {
          "type": "string",
          "description": "命令执行记录文件地址",
          "minLength": 0,
          "maxLength": 2048
        }
      },
      "description": "直播任务记录。"
    },
    "SmartLiveJob": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "数字人直播任务ID。",
          "minLength": 1,
          "maxLength": 64
        },
        "room_id": {
          "type": "string",
          "description": "直播间ID",
          "minLength": 0,
          "maxLength": 64
        },
        "room_name": {
          "type": "string",
          "description": "直播间名称",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "type": "string",
          "description": "数字人直播任务的状态。\n* WAITING: 等待\n* PROCESSING: 处理中\n* SUCCEED: 成功\n* FAILED: 失败\n* BLOCKED: 封禁",
          "minLength": 1,
          "maxLength": 64,
          "enum": [
            "WAITING",
            "PROCESSING",
            "SUCCEED",
            "FAILED",
            "BLOCKED"
          ]
        },
        "duration": {
          "type": "number",
          "format": "float",
          "description": "**参数解释**:\n数字人直播时长,单位秒。",
          "minimum": 0,
          "maximum": 2147483647
        },
        "start_time": {
          "type": "string",
          "description": "数字人直播任务开始时间。格式遵循:RFC 3339 如“2021-01-10T08:43:17Z”。",
          "minLength": 20,
          "maxLength": 20
        },
        "end_time": {
          "type": "string",
          "description": "数字人直播任务结束时间。格式遵循:RFC 3339 如“2021-01-10T08:43:17Z”。",
          "minLength": 20,
          "maxLength": 20
        },
        "error_info": {
          "description": "数字人直播任务出错信息。",
          "$ref": "#/definitions/ErrorResponse"
        },
        "create_time": {
          "type": "string",
          "description": "数字人直播任务创建时间。格式遵循:RFC 3339 如“2021-01-10T08:43:17Z”。",
          "minLength": 20,
          "maxLength": 20
        },
        "lastupdate_time": {
          "type": "string",
          "description": "数字人直播任务最后更新时间。格式遵循:RFC 3339 如“2021-01-10T08:43:17Z”。",
          "minLength": 20,
          "maxLength": 20
        },
        "rtc_room_info": {
          "$ref": "#/definitions/RTCRoomInfoList"
        },
        "live_event_report_url": {
          "type": "string",
          "description": "直播事件上报地址。用户将自行获取的直播间事件上报到此地址,用于触发智能互动,自动回复话术。",
          "minLength": 0,
          "maxLength": 2048
        },
        "live_event_callback_config": {
          "$ref": "#/definitions/LiveEventCallBackConfig"
        },
        "rtc_callback_config": {
          "$ref": "#/definitions/RTCLiveEventCallBackConfig"
        },
        "stream_duration": {
          "type": "number",
          "format": "float",
          "description": "**参数解释**:\n数字人直播推流时长,单位秒。",
          "minimum": 0,
          "maximum": 2147483647
        },
        "block_reason": {
          "type": "string",
          "description": "封禁信息",
          "minLength": 0,
          "maxLength": 2000
        },
        "cover_url": {
          "type": "string",
          "description": "直播间封面图URL",
          "minLength": 0,
          "maxLength": 2048
        },
        "co_streamer_config": {
          "$ref": "#/definitions/CoStreamerConfig"
        },
        "live_job_log": {
          "description": "直播任务记录",
          "$ref": "#/definitions/LiveJobLog"
        },
        "relation_live_platform_info": {
          "$ref": "#/definitions/PlatformLiveDetailInfo"
        },
        "used_resource_type": {
          "type": "string",
          "description": "使用的资源类型。\n* PERIOD:包周期资源\n* ONDEMAND:按需资源\n* ONE_TIME:一次性资源\n* UNKNOW:未知资源类型。",
          "minLength": 0,
          "maxLength": 64,
          "enum": [
            "PERIOD",
            "ONDEMAND",
            "ONE_TIME",
            "UNKNOW"
          ]
        },
        "is_ai_mark_on": {
          "type": "boolean",
          "example": true,
          "description": "AI标识开关",
          "default": false
        }
      },
      "description": "数字人直播任务信息。"
    },
    "ListSmartLiveJobsInfo": {
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n数字人直播任务总数。",
          "minimum": 0,
          "maximum": 2147483647
        },
        "smart_live_jobs": {
          "type": "array",
          "description": "数字人直播任务列表。",
          "items": {
            "$ref": "#/definitions/SmartLiveJob"
          },
          "maxItems": 100,
          "minItems": 1
        }
      },
      "description": "数字人直播任务查询列表。"
    },
    "RTCLiveEventCallBackConfig": {
      "type": "object",
      "properties": {
        "rtc_callback_event_type": {
          "type": "array",
          "description": "RTC回调的直播事件类型列表。\n\n当前仅支持如下取值:\n* LIVE_PROGRESS:直播剧本进度通知。 \n* REPLY_COMMAND_FINISH:回复播放完成通知。\n\n回调事件结构体定义:\n* message_type:消息类型。\n* data:消息描述。\n  - LIVE_PROGRESS事件回调定义如下:\n    ```json\n    {\n        \"message_type\": \"live_progress_notify\",\n        \"data\": {\n            \"script_name\": \"场景一\",\n            \"shoot_script_sequence_no\": 2,\n            \"shoot_script_title\": \"引导语\",\n            \"offset\": \"247\",\n            \"reply_id\": \"e87104f76d7546ce8a46ac6b04c49c3c\"\n        }\n    }\n    ```\n  - REPLY_COMMAND_FINISH回调定义如下:\n    ```json\n    {\n      \"message_type\": \"reply_command_finish_notify\",\n      \"data\":\"{\n        \"reply_id\":\"e87104f76d7546ce8a46ac6b04c49c3c\"\n      }\"\n    }\n    ```",
          "items": {
            "type": "string",
            "description": "回调的直播事件类型\n* LIVE_PROGRESS,直播剧本进度通知\n* REPLY_COMMAND_FINISH, 回复播放完成通知",
            "minLength": 1,
            "maxLength": 32
          },
          "maxItems": 10,
          "minItems": 1,
          "x-maxLength": 10000
        }
      },
      "description": "RTC回调事件配置。兼容处理,未携带配置则默认订阅LIVE_PROGRESS"
    },
    "VoiceConfig": {
      "required": [
        "voice_asset_id"
      ],
      "properties": {
        "voice_asset_id": {
          "type": "string",
          "example": "39b9cedccec1f19b33d8f7ce1a6d35b9",
          "description": "**参数解释**:\n音色资产ID,可以从资产库中查询。\n音色ID的查询操作,详见[查询预置音色ID](metastudio_02_0054.xml)。\n**约束限制**:\n不涉及。\n**取值范围**:\n字符长度1-256位。\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 64
        },
        "speed": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n语速。50表示0.5倍语速,100表示正常语速,200表示2倍语速。\n当取值为“100”时,表示一个成年人的正常语速,约为250字/分钟。\n\n**约束限制**:\n不涉及。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "pitch": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n音高。\n**约束限制**:\n不涉及。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "volume": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n音量。\n**约束限制**:\n不涉及。",
          "minimum": 90,
          "maximum": 240,
          "default": 140
        }
      },
      "description": "语音配置参数。"
    },
    "RTCRoomInfoList": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string",
          "description": "RTC应用ID。",
          "minLength": 1,
          "maxLength": 32
        },
        "room_id": {
          "type": "string",
          "description": "RTC房间ID。",
          "minLength": 1,
          "maxLength": 36
        },
        "users": {
          "type": "array",
          "description": "加入RTC房间用户信息。",
          "items": {
            "$ref": "#/definitions/RTCUserInfo"
          },
          "maxItems": 4,
          "minItems": 2
        }
      },
      "description": "RTC房间信息。"
    },
    "PlatformLiveDetailInfo": {
      "properties": {
        "platform_id": {
          "type": "string",
          "description": "直播平台ID。",
          "minLength": 0,
          "maxLength": 64
        },
        "platform": {
          "type": "string",
          "description": "直播平台。美团填写meituan",
          "minLength": 0,
          "maxLength": 256
        },
        "account": {
          "type": "string",
          "description": "授权账号信息。\n美团平台对应:opBizCode",
          "minLength": 0,
          "maxLength": 20
        },
        "live_id": {
          "type": "string",
          "description": "直播ID。如果配置,则段落切换回调中会携带该信息。\n美团对应liveId",
          "minLength": 0,
          "maxLength": 64
        }
      },
      "description": "平台直播信息"
    },
    "LiveEventCallBackConfig": {
      "type": "object",
      "properties": {
        "live_event_type_callback_url": {
          "type": "string",
          "description": "**参数解释**:\n直播事件回调地址,为https地址。\n**约束限制**:\n不涉及。\n**取值范围**:\n字符长度0-2048位。\n**默认取值**:\n不涉及。",
          "minLength": 0,
          "maxLength": 2048
        },
        "auth_type": {
          "type": "string",
          "description": "**参数解释**:\n认证类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n* NONE:URL中自带认证。\n* MSS_A:HMACSHA256签名模式,在URL中追加参数hwSecret、hwTime。\n  取值方式:hwSecret=hmac_sha256(Key, URI(live_event_callback_url)+ hwTime)&hwTime=hex(timestamp)\n* MSS_A_HEAD:HMACSHA256签名模式,参数hwSecret、hwTime放置在Head中。\n  取值方式:x-hw-mss-secret=hmac_sha256(Key, URI(live_event_callback_url)+ hwTime)\n    x-hw-mss-time=hex(timestamp)\n* MEITUAN_DEFAULT:仅用于美团平台调用回调使用。",
          "minLength": 0,
          "maxLength": 32,
          "enum": [
            "NONE",
            "MSS_A",
            "MSS_A_HEAD",
            "MEITUAN_DEFAULT"
          ],
          "default": "NONE"
        },
        "key": {
          "type": "string",
          "description": "**参数解释**:\n密钥Key。\n**约束限制**:\n不涉及。\n**取值范围**:\n字符长度0-32位。\n**默认取值**:\n不涉及。",
          "minLength": 0,
          "maxLength": 32
        },
        "callback_event_type": {
          "type": "array",
          "description": "**参数解释**:\n回调的直播事件类型列表。\n**约束限制**:\n不涉及。\n**取值范围**:\n当前仅支持如下取值:\n* SHOOT_SCRIPT_SWITCH:剧本段落切换事件。 \n* RTMP_STREAM_STATE_CHANGE:RTMP链接发生变化回调事件。\n* REPLY_COMMAND_FINISH:回复播放完成通知。\n\n回调事件结构体定义:\n* event_type:事件类型。\n* message:事件描述。\n  - SHOOT_SCRIPT_SWITCH事件回调定义如下:\n    ```json\n    {\n      \"event_type\":  \"SHOOT_SCRIPT_SWITCH\",\n      \"message\":\"{\\\"room_id\\\":\\\"26f065244f754b3aa853b649a21aaf66\\\",\\\"job_id\\\":\\\"e87104f76d7546ce8a46ac6b04c49c3c\\\",\\\"scene_script_name\\\":\\\"商品1\\\",\\\"shoot_script_sequence_no\\\":\\\"2\\\",\\\"shoot_script_title\\\":\\\"段落2\\\"}\"\n    }\n    ```\n  - RTMP_STREAM_STATE_CHANGE回调定义如下:\n    ```json\n    {\n      \"event_type\":  \"RTMP_STREAM_STATE_CHANGE\",\n      \"message\":\"{\\\"room_id\\\":\\\"26f065244f754b3aa853b649a21aaf66\\\",\\\"job_id\\\":\\\"e87104f76d7546ce8a46ac6b04c49c3c\\\",\\\"output_url\\\":\\\"rtmp://xxx/xx/xx\\\",\\\"stream_key\\\":\\\"xxxxx\\\",\\\"state\\\":\\\"CONNECTED\\\"}\"\n    }\n    ```\n    其中state取值:CONNECTING链路连接中;CONNECTED链路已连接;DISCONNECTED链路已断开,RECONNECTING链路重连中;END联络不再重连,链路已结束。\n\n  - REPLY_COMMAND_FINISH回调定义如下:\n    ```json\n    {\n      \"event_type\":  \"REPLY_COMMAND_FINISH\",\n      \"message\":\"{\\\"room_id\\\":\\\"26f065244f754b3aa853b649a21aaf66\\\",\\\"job_id\\\":\\\"e87104f76d7546ce8a46ac6b04c49c3c\\\",\\\"reply_id\\\":\\\"e87104f76d7546ce8a46ac6b04c49c3c\"}\"\n    }",
          "items": {
            "type": "string",
            "description": "回调的直播事件类型\n* SHOOT_SCRIPT_SWITCH,剧本段落切换事件\n* RTMP_STREAM_STATE_CHANGE,RTMP链接发生变化回调事件\n* REPLY_COMMAND_FINISH,回复播放完成通知",
            "minLength": 1,
            "maxLength": 32
          },
          "maxItems": 10,
          "minItems": 1,
          "x-maxLength": 10000
        }
      },
      "description": "直播事件HTTPS回调通知配置"
    },
    "RTCUserInfo": {
      "type": "object",
      "properties": {
        "user_type": {
          "type": "string",
          "description": "用户类型。\n* CAPTURE: 直播助手,将摄像头获取视频流推送到RTC房间\n* ANIMATION: VDS服务,从RTC房间拉视频流生成动作数据\n* RENDER: 渲染服务,将动作数据渲染成数字人动画\n* PLAYER: 普通观看方,可选择原始视频流或者数字人动画视频流观看\n* INFERENCE_USER: 数字人推理端用户。从RTC房间接收音频流,并推送视频流到RTC房间\n* END_USER: 端侧用户。从推送音频流到RTC房间,并从RTC房间接收视频流",
          "enum": [
            "CAPTURE",
            "ANIMATION",
            "RENDER",
            "PLAYER",
            "INFERENCE_USER",
            "END_USER"
          ]
        },
        "user_id": {
          "type": "string",
          "description": "RTC用户ID。",
          "minLength": 1,
          "maxLength": 64
        },
        "signature": {
          "type": "string",
          "description": "RTC鉴权token。",
          "minLength": 1,
          "maxLength": 64
        },
        "ctime": {
          "type": "integer",
          "format": "int64",
          "description": "有效期。时间戳,单位:秒。",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "description": "接入RTC的用户信息。"
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 1,
          "maxLength": 32
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "CoStreamerConfig": {
      "properties": {
        "voice_config": {
          "description": "语音配置参数。",
          "$ref": "#/definitions/VoiceConfig"
        },
        "streamer_action": {
          "type": "string",
          "description": "**参数解释**:\n助播出声时主播行为设置。\n**约束限制**:\n不涉及\n**取值范围**:\n* SILENCE:静默\n* VOLUME_DOWN:音量降低\n\n**默认取值**:\n不涉及。",
          "enum": [
            "SILENCE",
            "VOLUME_DOWN"
          ]
        }
      },
      "description": "助播配置"
    }
  },
  "version": "2.0",
  "parameters": {
    "SortKeyQuery": {
      "name": "sort_key",
      "in": "query",
      "description": "排序字段,支持的排序方式有:\n- 按创建时间排序:create_time\n- 按更新时间排序:update_time\n- 按资产排序:asset_order",
      "required": false,
      "type": "string",
      "maxLength": 128,
      "minLength": 0,
      "x-annotations": [
        "@Size( min = 1, max = 128)"
      ],
      "x-apig-registered": false
    },
    "X-Sdk-DateHeader": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n\n格式为(YYYYMMDD'T'HHMMSS'Z')。",
      "required": false,
      "type": "string",
      "maxLength": 16,
      "minLength": 16,
      "x-annotations": [
        "@Size(min = 16, max = 16)"
