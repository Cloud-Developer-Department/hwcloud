        ],
        "summary": "更新智能直播间互动规则库",
        "description": "该接口用于更新智能直播间互动规则库。",
        "operationId": "UpdateInteractionRuleGroup",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
