{
  "name": "ListLivePlatforms",
  "summary": "查询直播平台列表",
  "tags": "第三方直播平台管理",
  "productshort": "MetaStudio",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/live-platforms/platforms": {
      "get": {
        "tags": [
          "LivePlatformManage"
        ],
        "summary": "查询直播平台列表",
        "description": "该接口用于查询直播平台列表。",
        "operationId": "ListLivePlatforms",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader"
          },
          {
            "$ref": "#/parameters/OffsetQuery"
          },
          {
            "$ref": "#/parameters/LimitQuery"
          },
          {
            "name": "access_type",
            "in": "query",
            "description": "平台对接类型。|\n* MEITUAN_OFFICIAL:对接美团直播平台官方接口\n* MSS_STANDARD:对接MetaStudio定义的标准接口",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "x-annotations": [
              "@Size(min = 0, max = 64)"
            ]
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "成功。",
            "examples": {
              "application/json": {
                "live_platforms": [
                  {
                    "name": "meituan"
                  }
                ]
              }
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求ID。"
              }
            },
            "schema": {
              "$ref": "#/definitions/ListLivePlatforms"
            }
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          },
          "401": {
            "$ref": "#/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/responses/InternalServiceError"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-apig-group": "public-iam",
        "x-open-range": "public",
        "x-feature": "2dlive",
