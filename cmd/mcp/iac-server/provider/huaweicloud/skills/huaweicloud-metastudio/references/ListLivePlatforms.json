  "definitions": {
    "CustomPlatformAuthConfig": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "密钥Key。调用自定义直播平台时使用。\n使用方式:\n调用接口时,增加两个头域:x-hw-mss-time,x-hw-mss-secret\n* x-hw-mss-time:当前时间戳。Unix时间戳的十六进制结果。1分钟内有效。\n\n\n示例: 66df9308(即2024.09.10 08:30:00)\n* x-hw-mss-secret:鉴权串。hmac_sha256(Key, URI(product_query_url,query参数按照Key的字典序排列)+ x-hw-mss-time)\n\n示例:\nURL  https://api.example.com/v1/products?live_id=111&limit=10&offset=0\n\n\nKey:GCTbw44s6MPLh4GqgDpnfuFHgy25Enly\n\n\nhwTime:66df9308\n\n\nx-hw-mss-secret=hmac_sha256(GCTbw44s6MPLh4GqgDpnfuFHgy25Enly,api.example.com/v1/products?limit=10&live_id=111&offset=066df9308)=5e7fe8869a12a87ea966d9edbc02e38cd4ce62c73b8b05c638f15835e78902d7\n\n\nx-hw-mss-secret: 5e7fe8869a12a87ea966d9edbc02e38cd4ce62c73b8b05c638f15835e78902d7",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "description": "自定义直播平台鉴权配置"
    },
    "StandardPlatformApiConfig": {
      "type": "object",
      "required": [
        "api_type",
        "url"
      ],
      "properties": {
        "api_type": {
          "type": "string",
          "description": "API类型。\n* PRODUCT_QUERY: 查询商品\n* LIVE_EVENT_CALLBACK: 直播事件回调",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "PRODUCT_QUERY",
            "LIVE_EVENT_CALLBACK"
          ]
        },
        "url": {
          "type": "string",
          "description": "URL。仅支持HTTPS形式URL",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "description": "自定义直播平台回调配置"
    },
    "LivePlatformInfo": {
      "type": "object",
      "properties": {
        "platform_id": {
          "type": "string",
          "description": "平台ID",
          "minLength": 1,
          "maxLength": 64
        },
        "access_type": {
          "$ref": "#/definitions/AccessTypeEnum"
        },
        "name": {
          "type": "string",
          "description": "直播平台名称",
          "minLength": 1,
          "maxLength": 256
        },
        "authorization_info": {
          "$ref": "#/definitions/PlatformAuthorizationInfo"
        },
        "auth_config": {
          "$ref": "#/definitions/CustomPlatformAuthConfig"
        },
        "callback_config": {
          "type": "array",
          "description": "自定义直播平台回调配置。同一种类型仅保留一个配置,如果配置多个会随机保存一个。",
          "items": {
            "$ref": "#/definitions/StandardPlatformApiConfig"
          },
          "maxItems": 10,
          "minItems": 0
        }
      },
      "description": "直播平台信息"
    },
    "PlatformAuthorizationInfo": {
      "type": "object",
      "properties": {
        "authorize_state": {
          "type": "string",
          "description": "授权状态。\n* AUTHORIZED: 已授权\n* UNAUTHORIZED: 未授权",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "AUTHORIZED",
            "UNAUTHORIZED"
          ]
        },
        "authorized_time": {
          "type": "string",
          "description": "授权时间",
          "minLength": 0,
          "maxLength": 20
        },
        "expire_time": {
          "type": "string",
          "description": "过期时间",
          "minLength": 0,
          "maxLength": 20
        },
        "account": {
          "type": "string",
          "description": "授权账号信息。\n美团平台对应:opBizCode",
          "minLength": 0,
          "maxLength": 20
        }
      },
      "description": "直播平台授权信息"
    },
    "AccessTypeEnum": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "平台对接类型。\n* MEITUAN_OFFICIAL:对接美团直播平台官方接口\n* MSS_STANDARD:对接MetaStudio定义的标准接口",
      "enum": [
        "MEITUAN_OFFICIAL",
        "MSS_STANDARD"
      ]
    },
    "ListLivePlatforms": {
      "type": "object",
      "properties": {
        "live_platforms": {
          "type": "array",
          "description": "直播平台列表",
          "items": {
            "$ref": "#/definitions/LivePlatformInfo"
          },
          "maxItems": 100,
          "minItems": 0
        }
      },
      "description": "直播平台列表"
    }
  },
