{
  "name": "ShowResourceUsage",
  "summary": "查看租户资源用量信息",
  "tags": "租户管理",
  "productshort": "MetaStudio",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/tenants/resources-usage": {
      "get": {
        "tags": [
          "TenantManager"
        ],
        "summary": "查看租户资源用量信息",
        "description": "查询租户一次性和包周期(包年/包月)资源用量信息。\n> 按需套餐包用量本接口无法查询,需要调用CBC接口查询,详见[按需套餐包用量查询](https://cbc.huaweicloud.com/bm/support/api-apidt/CBCInterface_0001239.html)和[查询资源包信息](https://cbc.huaweicloud.com/bm/support/api-apidt/CBCInterface_0000511.html)。\n> 各种资源的计费方式请参考[计费说明](https://support.huaweicloud.com/productdesc-metastudio/metastudio_01_0006.html)。",
        "operationId": "ShowResourceUsage",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader"
          },
          {
            "name": "resource",
            "in": "query",
            "description": "资源类型。可填多个,用\",\"分隔。详见[资源类型](metastudio_02_0042.xml)。",
            "required": false,
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "x-apig-registered": false
          },
          {
            "name": "business",
            "in": "query",
            "description": "业务类型。可填多个,用\",\"分隔。\n* VOICE_CLONE:声音制作\n* SYNTHETICS_SOUND:声音合成\n* ASSET_MANAGER:资产管理\n* MODELING_2D:形象制作\n* LIVE_2D:分身数字人视频直播\n* VIDEO_2D:分身数字人视频制作\n* CHAT_2D:分身数字人智能交互\n* BUSINESS_CARD_2D:分身数字人名片\n* PICTURE_2D:照片数字人视频\n* MODELING_3D:3D照片建模\n* VDS_3D:3D视觉驱动\n* TTSA_3D:3D语音驱动\n* FLEXUS_2D:FLEXUS版本资源",
            "required": false,
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "x-apig-registered": false
          }
        ],
        "responses": {
          "200": {
            "description": "查看租户信息",
            "examples": {
              "application/json": {
                "resources": [
                  {
                    "resource_type": "video",
                    "charging_mode": "ONE_TIME",
                    "amount": 6000,
                    "usage": 100.5,
                    "unit": "MIN"
                  }
                ]
              }
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求ID。"
              }
            },
            "schema": {
              "$ref": "#/definitions/TenantResourcesUsageInfo"
            }
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          }
        },
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-apig-group": "public-iam,internal-appcode",
        "x-open-range": "public",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/f488337c31c8e4622f1590735b134c65/tenants/resources-usage"
      }
    }
  },
  "definitions": {
    "TenantResourcesUsageInfo": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "description": "资源用量列表",
          "items": {
            "$ref": "#/definitions/ResourceUsageInfo"
          },
          "maxItems": 100,
          "minItems": 0
        }
      },
      "description": "租户资源用量列表"
    },
    "ResourceUsageInfo": {
      "type": "object",
      "properties": {
        "resource_type": {
          "type": "string",
          "description": "资源类型。详见[资源类型](metastudio_02_0042.xml)。",
          "minLength": 1,
          "maxLength": 64
        },
        "business_type": {
          "type": "string",
          "description": "业务类型。\n* VOICE_CLONE:声音制作\n* SYNTHETICS_SOUND:声音合成\n* ASSET_MANAGER:资产管理\n* MODELING_2D:形象制作\n* LIVE_2D:分身数字人视频直播\n* VIDEO_2D:分身数字人视频制作\n* CHAT_2D:分身数字人智能交互\n* BUSINESS_CARD_2D:分身数字人名片\n* PICTURE_2D:照片数字人视频\n* MODELING_3D:3D照片建模\n* VDS_3D:3D视觉驱动\n* TTSA_3D:3D语音驱动\n* FLEXUS_2D:FLEXUS版本资源",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "VOICE_CLONE",
            "SYNTHETICS_SOUND",
            "ASSET_MANAGER",
            "MODELING_2D",
            "LIVE_2D",
            "VIDEO_2D",
            "CHAT_2D",
            "BUSINESS_CARD_2D",
            "PICTURE_2D",
            "MODELING_3D",
            "VDS_3D",
            "TTSA_3D",
            "FLEXUS_2D"
          ]
        },
        "sub_resource_type": {
          "type": "string",
          "description": "子资源类型。当前只有flexus套餐包存在该字段\n* voice_clone_flexus: 语音克隆Flexus版\n* modeling_count_2d_model_flexus: 分身数字人形象制作Flexus版\n* video_time_flexus_2d_model: 分身数字人Flexus版本视频制作",
          "minLength": 1,
          "maxLength": 64
        },
        "is_sub_resource": {
          "type": "boolean",
          "description": "是否子资源。子资源描述的是子资源的数量和单位",
          "default": false
        },
        "charging_mode": {
          "type": "string",
          "description": "计费类型。\n* PERIODIC: 包周期\n* ONE_TIME:一次性\n* ON_DEMAND:按需",
          "minLength": 1,
          "maxLength": 128,
          "enum": [
            "PERIODIC",
            "ONE_TIME",
            "ON_DEMAND"
          ]
        },
        "resource_source": {
          "type": "string",
          "format": "int64",
          "example": "ADMIN_ALLOCATED",
          "description": "资源来源。\n* PURCHASED: 购买\n* SP_ALLOCATED:SP分配\n* ADMIN_ALLOCATED:系统管理员分配",
          "minLength": 1,
          "maxLength": 64
        },
        "amount": {
          "type": "number",
          "format": "float",
          "description": "总量",
          "minimum": 0,
          "maximum": 1000000
        },
        "usage": {
          "type": "number",
          "format": "float",
          "description": "使用量",
          "minimum": 0,
          "maximum": 1000000
        },
        "unit": {
          "type": "string",
          "description": "单位。\n* NUM:个数(形象/声音)\n* MIN:分钟(视频制作)\n* HOUR:小时 (直播)\n* CHANNEL:路(直播/交互)\n* GB:GB(资产管理)\n* MILLION_WORDS:百万字\n* TEN_THOUSAND_WORDS:万字\n* TIME:次",
          "enum": [
            "NUM",
            "MIN",
            "HOUR",
            "CHANNEL",
            "GB",
            "MILLION_WORDS",
            "TEN_THOUSAND_WORDS",
            "TIME"
          ]
        }
      },
      "description": "资源使用信息"
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Sdk-DateHeader": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n\n格式为(YYYYMMDD'T'HHMMSS'Z')。",
      "required": false,
      "type": "string",
      "maxLength": 16,
      "minLength": 16,
      "x-annotations": [
        "@Size(min = 16, max = 16)"
      ],
      "x-example": "20191115T033655Z",
      "x-apig-registered": false
    },
    "X-Project-IdHeader": {
      "name": "X-Project-Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
      "required": false,
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 64)"
      ],
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
      "x-apig-registered": false
    },
    "AuthorizationHeader": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 256)"
      ],
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx",
      "x-apig-registered": false
    },
    "X-Auth-TokenHeader": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取。\n\n响应消息头中X-Subject-Token的值。",
      "required": false,
      "type": "string",
      "maxLength": 16384,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 16384)"
      ],
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "x-apig-registered": false
    },
    "Project-IdPath": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参考[获取项目ID](metastudio_02_0006.xml)。",
      "required": true,
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 64)"
      ],
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    }
  },
  "host": "metastudio.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}