{
  "name": "ListVideoScripts",
  "summary": "查询视频制作剧本列表",
  "tags": "视频制作剧本管理",
  "productshort": "MetaStudio",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/digital-human-video-scripts": {
      "get": {
        "tags": [
          "VideoScriptManager"
        ],
        "summary": "查询视频制作剧本列表",
        "description": "该接口用于查询视频制作剧本列表。",
        "operationId": "ListVideoScripts",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader"
          },
          {
            "$ref": "#/parameters/X-App-UserId"
          },
          {
            "$ref": "#/parameters/OffsetQuery"
          },
          {
            "$ref": "#/parameters/LimitQuery"
          },
          {
            "$ref": "#/parameters/NameQuery"
          },
          {
            "name": "script_catalog",
            "in": "query",
            "description": "剧本类型。默认查询VIDEO_DRAFT。\n* VIDEO_DRAFT:视频草稿。\n* SYSTEM_VIDEO_TEMPLET: 系统视频模板。",
            "required": false,
            "type": "string",
            "enum": [
              "VIDEO_DRAFT",
              "SYSTEM_VIDEO_TEMPLET"
            ]
          },
          {
            "name": "view_mode",
            "in": "query",
            "description": "横竖屏类型(内部参数,不对外开放)。默认值是LANDSCAPE。\n* LANDSCAPE:横屏。\n* VERTICAL:竖屏。",
            "required": false,
            "type": "string",
            "enum": [
              "LANDSCAPE",
              "VERTICAL"
            ]
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "成功。",
            "examples": {
              "application/json": {
                "count": 1,
                "video_scripts": [
                  {
                    "script_id": "26f06524-4f75-4b3a-a853-b649a21aaf66",
                    "script_name": "大自然的传说",
                    "model_asset_id": "a5d295cdb345c11bd9f36bc22ced3a7a",
                    "script_description": "课件",
                    "create_time": "2022-11-30T06:59:55Z",
                    "update_time": "2022-12-05T12:30:37Z"
                  }
                ]
              }
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求ID。"
              }
            },
            "schema": {
              "$ref": "#/definitions/ListVideoScripts"
            }
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          },
          "401": {
            "$ref": "#/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/responses/InternalServiceError"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-apig-group": "public-iam,internal-appcode",
        "x-open-range": "public",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/70b76xxxxxx34253880af501cdxxxxxx/digital-human-video-scripts"
      }
    }
  },
  "definitions": {
    "ListVideoScripts": {
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "剧本总数。",
          "minimum": 0,
          "maximum": 2147483647
        },
        "video_scripts": {
          "type": "array",
          "description": "剧本列表。",
          "items": {
            "$ref": "#/definitions/VideoScriptBaseInfo"
          },
          "maxItems": 100,
          "minItems": 1
        }
      }
    },
    "VideoScriptBaseInfo": {
      "required": [
        "script_id",
        "script_name"
      ],
      "properties": {
        "script_id": {
          "type": "string",
          "description": "剧本ID。",
          "minLength": 1,
          "maxLength": 64
        },
        "script_name": {
          "type": "string",
          "description": "剧本名称。",
          "minLength": 1,
          "maxLength": 256
        },
        "script_description": {
          "type": "string",
          "description": "剧本描述。",
          "minLength": 0,
          "maxLength": 1024
        },
        "model_asset_id": {
          "type": "string",
          "description": "数字人模型资产ID,可以从资产库中查询。",
          "minLength": 1,
          "maxLength": 64
        },
        "model_asset_type": {
          "type": "string",
          "description": "数字人模型类型。\n\n* HUMAN_MODEL_2D:分身数字人",
          "enum": [
            "HUMAN_MODEL_2D"
          ]
        },
        "script_cover_url": {
          "type": "string",
          "description": "剧本封面下载url。",
          "minLength": 1,
          "maxLength": 2048
        },
        "script_type": {
          "type": "string",
          "description": "脚本类型,即视频制作的驱动方式。默认TEXT\n* TEXT: 文本驱动,即通过TTS合成语音\n* AUDIO: 语音驱动",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "description": "台词脚本。",
          "minLength": 1,
          "maxLength": 131072
        },
        "create_time": {
          "type": "string",
          "description": "创建时间,格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"。",
          "minLength": 20,
          "maxLength": 20
        },
        "update_time": {
          "type": "string",
          "description": "更新时间,格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"。",
          "minLength": 20,
          "maxLength": 20
        }
      }
    }
  },
