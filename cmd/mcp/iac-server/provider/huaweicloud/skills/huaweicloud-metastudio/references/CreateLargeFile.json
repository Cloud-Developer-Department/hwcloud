  "definitions": {
    "LargeFilesCreateRsp": {
      "required": [
        "file_id"
      ],
      "properties": {
        "file_id": {
          "type": "string",
          "example": "b2f8a9e9c39b6dc7ed4c0cfd67366c6a",
          "description": "文件ID。",
          "minLength": 1,
          "maxLength": 64
        },
        "upload_urls": {
          "type": "array",
          "example": [
            "https://{endpoint}:443/0d697589d98091f12f92c0073501cd79/942e65a5fd219a2e01fb08d881cfadb9/ori4k.zip?AccessKeyId=BHFSP0ZDGFL6BLGHCNPK&Expires=1695532670&partNumber=1&uploadId=0000018AC154BC218415213228194267&Signature=FrLhTRdhMjpAFVb%2Ff%2BcGJQgvjlw%3D",
            "https://{endpoint}:443/0d697589d98091f12f92c0073501cd79/942e65a5fd219a2e01fb08d881cfadb9/ori4k.zip?AccessKeyId=BHFSP0ZDGFL6BLGHCNPK&Expires=1695532670&partNumber=2&uploadId=0000018AC154BC218415213228194267&Signature=FrLhTRdhMjpAFVb%2Ff%2BcGJQgvjlw%3D"
          ],
          "description": "文件分段上传URL。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2048
          },
          "maxItems": 10,
          "minItems": 0,
          "x-maxLength": 10,
          "x-minLength": 0
        }
      },
      "description": "大文件信息返回"
    },
    "LargeFilesCreateReq": {
      "type": "object",
      "required": [
        "asset_file_category",
        "asset_id",
        "file_name",
        "file_type"
      ],
      "properties": {
        "file_name": {
          "type": "string",
          "example": "a.jpg",
          "description": "文件名,不区分大小写,最大长度256,最小长度1。",
          "minLength": 1,
          "maxLength": 256
        },
        "file_size": {
          "type": "integer",
          "format": "int64",
          "example": 1024,
          "description": "文件总的大小,最小1,最大536870912000。",
          "minimum": 1,
          "maximum": 536870912000
        },
        "file_type": {
          "type": "string",
          "example": "jpg",
          "description": "文件类型(默认提取文件后缀)。",
          "minLength": 1,
          "maxLength": 64
        },
        "asset_id": {
          "type": "string",
          "example": "8cb2f48a2cb006154794741933421100",
          "description": "资产ID。",
          "minLength": 1,
          "maxLength": 64
        },
        "asset_file_category": {
          "type": "string",
          "example": "OTHER",
          "description": "文件在资产中的分类。每种资产类型包含的文件分类不同。\n* MAIN:主文件\n* OTHER:其他文件\n* PACKAGE:打包后的资产文件",
          "minLength": 1,
          "maxLength": 128
        },
        "file_multipart_count": {
          "type": "integer",
          "format": "int32",
          "example": 2,
          "description": "ORI4K文件分段上传数量,默认值为1",
          "minimum": 1,
          "maximum": 100,
          "default": 1
        }
      },
      "description": "创建大文件请求。"
    }
  },
