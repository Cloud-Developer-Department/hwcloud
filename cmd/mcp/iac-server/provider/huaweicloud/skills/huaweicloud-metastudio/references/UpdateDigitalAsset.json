    "SystemProperty": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "**参数解释**:\n操作。\n**约束限制**:\n系统属性仅为系统设置,普通用户无法修改。\n**取值范围**:\n* ADD:增加\n* DELETE:删除\n\n**默认取值**:\n不涉及",
          "enum": [
