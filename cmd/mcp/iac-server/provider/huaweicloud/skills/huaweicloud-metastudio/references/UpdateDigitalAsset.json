  "definitions": {
    "HumanModel2DAssetMeta": {
      "type": "object",
      "properties": {
        "is_action_editable": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n分身数字人的动作是否可编辑\n**约束限制**:\n不涉及\n**取值范围**:\n* true: 动作可编辑\n* false: 动作不可编辑",
          "default": false
        },
        "is_live_copy": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n是否是直播间复刻任务\n**约束限制**:\n不涉及\n**取值范围**:\n* true: 是直播间复刻任务\n* false: 不是直播间复刻任务",
          "default": false
        },
        "is_real_background": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n是否是实景分身数字人\n**约束限制**:\n实景分身数字人不做背景替换。\n**取值范围**:\n* true: 实景分身数字人\n* false: 普通分身数字人,不带背景。",
          "default": false
        },
        "support_live": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n是否支持直播\n**约束限制**:\n不涉及\n**取值范围**:\n* true: 支持直播\n* false: 不支持直播。",
          "default": false
        },
        "model_version": {
          "type": "string",
          "example": "V3",
          "description": "**参数解释**:\n分身数字人模型版本\n**约束限制**:\n不涉及\n**取值范围**:\n* V2: V2版本模型\n* V3:V3版本模型\n* V3_2:V3.2版本模型\n* V3_3:V3.3版本模型",
          "minLength": 0,
          "maxLength": 64,
          "enum": [
            "V2",
            "V3",
            "V3_2",
            "V3_3"
          ],
          "default": "V2"
        },
        "model_resolution": {
          "type": "string",
          "example": "1080P",
          "description": "**参数解释**:\n分身数字人模型分辨率。\n**约束限制**:\n不涉及\n**取值范围**:\n* 1080P:1080P。支持1080P及720P的视频输出。\n* 4K:4K。支持4K、1080P及720P的视频输出。",
          "minLength": 0,
          "maxLength": 64,
          "default": "1080P"
        },
        "device_names": {
          "type": "array",
          "description": "**参数解释**:\n已执行编译任务设备类型列表。\n**约束限制**:\n支持走动的数字人,当前仅用于视频制作,不能用于直播和智能交互\n**取值范围**:\n设备名称列表最多16个。\n设备名称字符长度1-64位。\n**默认取值**:\nfalse",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 16,
          "minItems": 0,
          "x-maxLength": 16,
          "x-minLength": 0
        },
        "is_with_action_library": {
          "type": "boolean",
          "example": true,
          "description": "分身数字人是否带原子动作库。\n> * 带原子动作库的分身数字人可做动作编排。",
          "default": false
        },
        "action_tag_map": {
          "type": "array",
          "description": "动作标签映射。",
          "items": {
            "$ref": "#/definitions/ActionTagInfo"
          },
          "maxItems": 256,
          "minItems": 0,
          "x-maxLength": 256,
          "x-minLength": 0
        },
        "is_flexus": {
          "type": "boolean",
          "example": true,
          "description": "是否是Flexus版本分身数字人。",
          "default": false
        },
        "voice_asset_id": {
          "type": "string",
          "example": "8cb2f48a2cb006154794741933421100",
          "description": "形象关联的声音资产ID。",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "description": "分身模型元数据"
    },
    "MaterialComponentInfo": {
      "required": [
