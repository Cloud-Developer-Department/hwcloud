    "DigitalAssetSummary": {
      "properties": {
        "asset_id": {
          "type": "string",
          "example": "8cb2f48a2cb006154794741933421100",
          "description": "资产ID。",
          "minLength": 0,
          "maxLength": 2048
        },
        "asset_name": {
          "type": "string",
          "example": "数字人",
          "description": "资产名称。",
          "minLength": 0,
          "maxLength": 2048
        },
        "asset_state": {
          "type": "string",
          "description": "资产状态。\n* CREATING:资产创建中,主文件尚未上传\n* FAILED:主文件上传失败\n* UNACTIVED:主文件上传成功,资产未激活,资产不可用于其他业务(用户可更新状态)\n* ACTIVED:主文件上传成功,资产激活,资产可用于其他业务(用户可更新状态)\n* DELETING:资产删除中,资产不可用,资产可恢复\n* DELETED:资产文件已删除,资产不可用,资产不可恢复\n* BLOCK: 资产被冻结,资产不可用,不可查看文件。\n* WAITING_DELETE:资产将被下线",
          "enum": [
            "CREATING",
            "FAILED",
            "UNACTIVED",
            "ACTIVED",
            "DELETING",
            "DELETED",
            "BLOCK",
            "WAITING_DELETE"
          ]
        },
        "asset_type": {
          "type": "string",
          "example": "PPT",
          "description": "资产类型。\n公共资产类型:\n* VOICE_MODEL:音色模型(仅系统管理员可上传,普通租户仅可查询)\n* VIDEO:视频文件\n* IMAGE:图片文件\n* PPT:幻灯片文件\n* MUSIC: 音乐\n* AUDIO: 音频\n* COMMON_FILE:通用文件\n\n分身数字人资产:\n* HUMAN_MODEL_2D: 分身数字人模型\n* BUSINESS_CARD_TEMPLET: 数字人名片模板",
          "enum": [
            "HUMAN_MODEL",
            "MODEL",
            "ANIMATION",
            "SCENE",
            "PPT",
            "VIDEO",
            "IMAGE",
            "MATERIAL",
            "VOICE_MODEL",
            "HUMAN_MODEL_2D",
            "BUSINESS_CARD_TEMPLET",
            "MUSIC",
            "AUDIO"
          ]
        },
        "block_reason_code": {
          "type": "string",
          "description": "冻结原因编号。",
          "minLength": 0,
          "maxLength": 256
        },
        "cover_url": {
          "type": "string",
          "example": "https://{endpoint}:443/0d697589d98091f12f92c0073501cd79/8cb2f48a2cb006154794741933421100/b2f8a9e9c39b6dc7ed4c0cfd67366c6a.jpg?AccessKeyId=XCQKTA8IWQPCAfQS4SDA&Expires=1671154644&Signature=vXxitTO239WZcG8sniotTe9qOc4%3D",
          "description": "封面图片路径。",
          "minLength": 0,
          "maxLength": 2048
        },
        "thumbnail_url": {
          "type": "string",
          "example": "https://{endpoint}:443/0d697589d98091f12f92c0073501cd79/8cb2f48a2cb006154794741933421100/b2f8a9e9c39b6dc7ed4c0cfd67366c6a.jpg",
          "description": "缩略图路径。",
          "minLength": 0,
          "maxLength": 2048
        }
      }
    },
    "TransferTypeEnum": {
      "type": "string",
      "description": "**参数解释**:\n转移类型。默认值是TRANSFER_OUT。\n**约束限制**:\n* 只有管理员或者开了资产转移白名单租户才有权限转出资产。\n* 普通租户有权限转回已接收成功的资产,转回给转移发起方。\n**取值范围**:\n* TRANSFER_OUT: 资产转出\n* TRANSFER_BACK:资产转回",
      "enum": [
        "TRANSFER_OUT",
        "TRANSFER_BACK"
      ],
      "default": "TRANSFER_OUT"
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
