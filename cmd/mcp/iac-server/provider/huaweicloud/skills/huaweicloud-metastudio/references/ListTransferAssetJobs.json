          "type": "string",
          "description": "任务状态\n- PROCESSING: 处理过程中\n- ACCEPT: 接受\n- REJECT: 拒绝\n- CANCEL:取消\n- FAIL: 失败",
          "minLength": 0,
          "maxLength": 64,
          "enum": [
            "PROCESSING",
            "ACCEPT",
            "REJECT",
            "CANCEL",
            "FAIL"
          ]
        },
        "src_project_id": {
          "type": "string",
          "description": "源用户ID",
          "minLength": 0,
          "maxLength": 64
        },
        "dest_project_id": {
          "type": "string",
          "description": "目标用户ID",
          "minLength": 0,
          "maxLength": 64
        },
        "memo": {
          "type": "string",
          "description": "备注信息",
          "minLength": 0,
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "description": "冻结/解冻原因。",
          "minLength": 0,
          "maxLength": 256
        },
        "start_time": {
          "type": "string",
          "description": "资产转移开始时间",
          "minLength": 0,
          "maxLength": 20
        },
        "finish_time": {
          "type": "string",
          "description": "资产转移完成时间",
          "minLength": 0,
          "maxLength": 20
        },
        "expire_time": {
          "type": "string",
          "description": "资产转移过期时间",
          "minLength": 0,
          "maxLength": 20
        },
        "is_need_billing": {
          "type": "boolean",
          "description": "资产转移时,是否需要从接收方扣减资源(产生计费话单)",
          "default": false
        },
        "error_info": {
          "description": "错误信息",
          "$ref": "#/definitions/ErrorResponse"
        }
      }
    }
