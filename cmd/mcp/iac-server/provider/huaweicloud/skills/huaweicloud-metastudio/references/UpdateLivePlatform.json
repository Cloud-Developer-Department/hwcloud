  "definitions": {
    "StandardPlatformApiConfig": {
      "type": "object",
      "required": [
        "api_type",
        "url"
      ],
      "properties": {
        "api_type": {
          "type": "string",
          "description": "API类型。\n* PRODUCT_QUERY: 查询商品\n* LIVE_EVENT_CALLBACK: 直播事件回调",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "PRODUCT_QUERY",
            "LIVE_EVENT_CALLBACK"
          ]
        },
        "url": {
          "type": "string",
          "description": "URL。仅支持HTTPS形式URL",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "description": "自定义直播平台回调配置"
    },
    "UpdateCustomPlatformAuthConfig": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "密钥Key。调用自定义直播平台时使用。\n使用方式:\n调用接口时,增加两个头域:x-hw-mss-time,x-hw-mss-secret\n* x-hw-mss-time:当前时间戳。Unix时间戳的十六进制结果。1分钟内有效。\n\n\n示例: 66df9308(即2024.09.10 08:30:00)\n* x-hw-mss-secret:鉴权串。hmac_sha256(Key, URI(product_query_url,query参数按照Key的字典序排列)+ x-hw-mss-time)\n\n示例:\nURL  https://api.example.com/v1/products?live_id=111&limit=10&offset=0\n\n\nKey:GCTbw44s6MPLh4GqgDpnfuFHgy25Enly\n\n\nhwTime:66df9308\n\n\nx-hw-mss-secret=hmac_sha256(GCTbw44s6MPLh4GqgDpnfuFHgy25Enly,api.example.com/v1/products?limit=10&live_id=111&offset=066df9308)=5e7fe8869a12a87ea966d9edbc02e38cd4ce62c73b8b05c638f15835e78902d7\n\n\nx-hw-mss-secret: 5e7fe8869a12a87ea966d9edbc02e38cd4ce62c73b8b05c638f15835e78902d7",
          "minLength": 0,
          "maxLength": 32
        }
      },
      "description": "自定义直播平台鉴权配置"
    },
    "CreateLivePlatformRsp": {
      "type": "object",
      "properties": {
        "platform_id": {
          "type": "string",
          "description": "平台ID",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "description": "自定义直播平台回调配置"
    },
    "UpdateLivePlatformReq": {
      "type": "object",
      "required": [
        "callback_config",
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "直播平台名称",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\一-\\龥a-zA-Z0-9]+$"
        },
        "auth_config": {
          "$ref": "#/definitions/UpdateCustomPlatformAuthConfig"
        },
        "callback_config": {
          "type": "array",
          "description": "自定义直播平台回调配置。同一种类型仅保留一个配置,如果配置多个会随机保存一个。",
          "items": {
            "$ref": "#/definitions/StandardPlatformApiConfig"
          },
          "maxItems": 100,
          "minItems": 0
        }
      },
      "description": "自定义直播平台创建请求"
    }
  },
