  "definitions": {
    "ReviewConfig": {
      "type": "object",
      "properties": {
        "no_need_review": {
          "type": "boolean",
          "description": "免审核。 目前仅白名单用户可使用此参数,非白名单用户跟随系统策略审核。"
        }
      },
      "description": "内容审核配置"
    },
    "LiveEvent": {
      "type": "object",
      "required": [
        "timestamp"
      ],
      "properties": {
        "timestamp": {
          "type": "integer",
          "format": "int64",
          "description": "**参数解释**:\n事件戳。从1970-01-01 00:00:00:000开始的毫秒数",
          "minimum": 0,
          "maximum": 4102415999000
        },
        "type": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n事件类型。\n* 1 弹幕信息\n* 2 用户入场\n* 3 用户点赞\n* 4 用户送礼\n* 5 用户订阅\\关注\n* 6 房间观看人数",
          "minimum": 0,
          "maximum": 100
        },
        "content": {
          "type": "string",
          "description": "事件内容。\n事件类型不同,content内容也不同,定义如下所示:\n- type=1 弹幕信息\n  content定义:\n    * user:用户,json\n    * content: string,弹幕内容  \n  user定义:\n    * userId:用户id,string\n    * name:用户姓名,string\n    * level:用户平台等级,int\n    * badge:用户牌子名称,string\n    * badgeLevel:牌子等级,int  \n  举例:\n  ```json\n  {\n    \"timestamp\": 1694481224245,\n    \"type\": 1,\n    \"content\": \"{\\\"user\\\":{\\\"userId\\\":\\\"2027271526\\\",\\\"name\\\":\\\"***\\\",\\\"level\\\":17,\\\"badge\\\":\\\"\\\",\\\"badgeLevel\\\":0},\\\"content\\\":\\\"***\\\"}\"\n  }\n  ```\n- type=2 用户入场\n  content定义:\n    * user:用户,json  \n  举例:\n  ```json\n  {\n    \"timestamp\": 1694481227655,\n    \"type\": 2,\n    \"content\": \"{\\\"user\\\":{\\\"userId\\\":\\\"2978899271\\\",\\\"name\\\":\\\"***\\\",\\\"level\\\":1,\\\"badge\\\":\\\"\\\",\\\"badgeLevel\\\":0}}\"\n  }\n  ```\n- type=3 用户点赞 \n  content定义:\n    * user:用户,json  \n  举例:\n  ```json\n  {\n    \"timestamp\": 1694481227655,\n    \"type\": 2,\n    \"content\": \"{\\\"user\\\":{\\\"userId\\\":\\\"2978899271\\\",\\\"name\\\":\\\"***\\\",\\\"level\\\":1,\\\"badge\\\":\\\"\\\",\\\"badgeLevel\\\":0}}\"\n  }\n  ```\n- type=4 用户送礼\n  content定义:\n    * user:用户,json\n    * gift:礼物信息,json  \n  gift定义:\n    * giftName:礼物名称,string\n    * giftNum:礼物数量,int\n    * totalValue:此处礼物总价值,int\n    * giftValue:单个礼物价值,int  \n  举例:\n  ```json\n  {\n    \"timestamp\": 1690531652862,\n    \"type\": 4,\n    \"content\": \"{\\\"gift\\\":{\\\"giftName\\\":\\\"小星星\\\",\\\"giftNum\\\":10,\\\"totalValue\\\":10,\\\"giftValue\\\":3},\\\"user\\\":{\\\"userId\\\":\\\"douyin_95882940927\\\",\\\"name\\\":\\\"纯爱战士熙熙\\\",\\\"level\\\":2,\\\"badge\\\":\\\"\\\",\\\"badgeLevel\\\":0}}\"\n  }\n  ```\n- type=5 用户订阅 \n  暂未使用\n- type=6 房间观看人数\n  content定义:\n    * numberOfViewers:房间观看人数,int  \n  举例:\n  ```json\n  {\n    \"timestamp\": 1694481236886,\n    \"type\": 6,\n    \"content\": \"{\\\"numberOfViewers\\\":5466}\"\n  }\n  ```",
          "minLength": 0,
          "maxLength": 4096
        }
      }
    },
    "ReportLiveEventReq": {
      "type": "object",
      "required": [
        "total"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n事件条目数。",
          "minimum": 1,
          "maximum": 1000
        },
        "events": {
          "type": "array",
          "description": "事件内容。",
          "items": {
            "$ref": "#/definitions/LiveEvent"
          },
          "maxItems": 1000,
          "minItems": 1,
          "x-maxLength": 10000
        },
        "review_config": {
          "description": "内容审核配置",
          "$ref": "#/definitions/ReviewConfig"
        }
      }
    },
    "ReportLiveEventRsp": {
      "properties": {
        "live_event_report_url": {
          "type": "string",
          "description": "刷新后的直播事件上传URL",
          "minLength": 0,
          "maxLength": 2048
        }
      },
      "description": "直播上报时间返回信息"
    }
  },
