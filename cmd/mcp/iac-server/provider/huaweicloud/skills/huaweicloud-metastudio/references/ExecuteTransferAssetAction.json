      "enum": [
        "2D_DIGITAL_HUMAN_BASIC",
        "2D_DIGITAL_HUMAN_ADVANCED",
        "2D_DIGITAL_HUMAN_FLEXUS",
        "VOICE_BASIC",
        "VOICE_MIDDLE",
        "VOICE_ADVANCE",
        "VOICE_THIRD_PARTY",
        "VOICE_THIRD_PARTY_LJZN",
        "VOICE_FLEXUS"
