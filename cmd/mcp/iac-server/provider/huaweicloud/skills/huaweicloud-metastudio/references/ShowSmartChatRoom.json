{
  "name": "ShowSmartChatRoom",
  "summary": "查询智能交互对话详情",
  "tags": "智能交互数字人对话管理",
  "productshort": "MetaStudio",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/smart-chat-rooms/{room_id}": {
      "get": {
        "tags": [
          "SmartChatRoomManager"
        ],
        "summary": "查询智能交互对话详情",
        "description": "该接口用于查询智能交互对话详情。",
        "operationId": "ShowSmartChatRoom",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "name": "room_id",
            "in": "path",
            "description": "智能交互对话ID。获取方法请参考[创建智能交互对话](CreateSmartChatRoom.xml)。",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "x-annotations": [
              "@Size(min = 1, max = 64)"
            ],
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader"
          },
          {
            "$ref": "#/parameters/X-App-UserId"
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "成功。",
            "examples": {
              "application/json": {
                "room_id": "24bad716-87b1-45e5-8912-6102f7693265",
                "room_name": "云笙展厅",
                "room_description": "云笙"
              }
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求ID。"
              }
            },
            "schema": {
              "$ref": "#/definitions/SmartChatRoomInfo"
            }
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          },
          "401": {
            "$ref": "#/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/responses/NotFound"
          },
          "500": {
            "$ref": "#/responses/InternalServiceError"
          }
        },
        "x-methodAnnotations": [
          "@ResponseMaskRule"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-apig-group": "public-iam,internal-appcode",
        "x-open-range": "public",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/70b76xxxxxx34253880af501cdxxxxxx/smart-chat-rooms/24bad716-87b1-45e5-8912-6102f7693265",
        "x-order": 2
      }
    }
  },
  "definitions": {
    "ChatSubtitleConfig": {
      "properties": {
        "dx": {
          "type": "integer",
          "format": "int32",
          "example": 256,
          "description": "**参数解释**:\n字幕左上角像素点坐标。\n\n横屏(16:9)视频像素为1920x1080;竖屏(9:16)视频像素为1080x1920。",
          "minimum": 0,
          "maximum": 1920
        },
        "dy": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n字幕左上角像素点坐标。\n\n横屏(16:9)视频像素为1920x1080;竖屏(9:16)视频像素为1080x1920。",
          "minimum": 0,
          "maximum": 1920
        },
        "width": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n图层图片宽度像素值(相对画布大小)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。",
          "minimum": 1,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n图层图片高度像素值(相对画布大小)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。",
          "minimum": 1,
          "maximum": 7680
        }
      },
      "description": "字幕配置。"
    },
    "ChatResourceConfigInfo": {
      "properties": {
        "resource_id": {
          "type": "string",
          "description": "资源id",
          "minLength": 1,
          "maxLength": 64
        },
        "count_resource": {
          "type": "integer",
          "format": "int32",
          "description": "资源数量",
          "minimum": 0,
          "maximum": 10000
        },
        "resource_source": {
          "type": "string",
          "example": "PURCHASED",
          "description": "资源来源。\n* PURCHASED: 购买\n* SP_ALLOCATED:SP分配\n* ADMIN_ALLOCATED:系统管理员分配\n> * 开通按需;购买按需套餐包、一次性资源、包周期等都属于PURCHASED。",
          "enum": [
            "PURCHASED",
            "SP_ALLOCATED",
            "ADMIN_ALLOCATED"
          ]
        },
        "charge_mode": {
          "type": "string",
          "example": "PERIODIC",
          "description": "资源计费类型。\n* PERIODIC: 包周期\n* ONE_TIME:一次性计费\n* ON_DEMAND: 按需计费\n> * 一次性计费包括:租户订购的一次性资源,SP管理员分配给租户的一次性资源,SP管理员分配给租户的按需套餐包资源,系统管理员分配的资源(分钟数等)。",
          "enum": [
            "PERIODIC",
            "ONE_TIME",
            "ON_DEMAND"
          ]
        },
        "resource_nums": {
          "type": "integer",
          "description": "资源数量。智能交互并发路数。",
          "minimum": 0,
          "maximum": 10000000
        },
        "resource_available_nums": {
          "type": "integer",
          "description": "可用资源数量。智能交互并发路数。",
          "minimum": 0,
          "maximum": 10000000
        },
        "status": {
          "type": "string",
          "example": "ACTIVE",
          "description": "资源状态。\n* ACTIVE: 正常\n* FREEZE:冻结\n* DELETED:退订或过期",
          "enum": [
            "ACTIVE",
            "FREEZE",
            "DELETED"
          ]
        },
        "expire_time": {
          "type": "string",
          "description": "资源过期时间,格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"",
          "minLength": 20,
          "maxLength": 20
        }
      },
      "description": "资源配置。"
    },
    "BackgroundConfigInfo": {
      "required": [
        "background_type"
      ],
      "properties": {
        "background_type": {
          "type": "string",
          "description": "**参数解释**:\n背景类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n* IMAGE:图片背景,指定图片用作分身数字人背景。\n* COLOR:纯色背景,指定颜色RGB值作为分身数字人背景。\n\n**默认取值**:\n不涉及",
          "minLength": 1,
          "maxLength": 2048,
          "enum": [
            "IMAGE",
            "COLOR",
            "IMAGE_2D",
            "VIDEO",
            "AUDIO"
          ]
        },
        "background_config": {
          "type": "string",
          "example": "https://{endpoint}/0d697589d98091f12f92c0073501cd79/8cb2f48a2cb006154794741933421100/b2f8a9e9c39b6dc7ed4c0cfd67366c6a.jpg?AccessKeyId=XCQKTA8IWQPCAUQS4SDA&Expires=1671241324&Signature=tD38peKsCkh%2FygE3IffeLbewuEw%3D",
          "description": "**参数解释**:\n背景文件的URL。\n**约束限制**:\n* 仅直播支持外部URL,其他业务通过资产库查询获取,不支持外部URL。\n* background_type=IMAGE时需要填写。\n\n**取值范围**:\n字符长度1-2048位\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 2048
        },
        "background_color_config": {
          "type": "string",
          "description": "**参数解释**:\n纯色背景的RGB颜色值。\n**约束限制**:\nbackground_type=COLOR时需要填写。\n**取值范围**:\n字符长度0-16位",
          "minLength": 0,
          "maxLength": 16,
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": "#FFFFFF"
        },
        "background_asset_id": {
          "type": "string",
          "example": "a5d295cdb345c11bd9f36bc22ced3a7b",
          "description": "**参数解释**:\n背景资产ID。\n> 背景是背景图片时,填图片资产ID。\n\n**约束限制**:\n不涉及\n**取值范围**:\n字符长度0-64位\n**默认取值**:\n不涉及",
          "minLength": 0,
          "maxLength": 64
        },
        "background_image_config": {
          "$ref": "#/definitions/BackgroundImageConfig"
        }
      },
      "description": "背景配置。"
    },
    "BackgroundImageConfig": {
      "type": "object",
      "required": [
        "dx",
        "dy",
        "height",
        "width"
      ],
      "properties": {
        "dx": {
          "type": "integer",
          "format": "int32",
          "example": -256,
          "description": "**参数解释**:\n背景图片左上角像素点的X轴位置值(画布左上角坐标是0x0)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n需要保证背景图片要铺满画布。即dx <= 0,并且横屏时dx + width >=1920,竖屏时dx + width >=1080。",
          "minimum": -5760,
          "maximum": 0,
          "default": 0
        },
        "dy": {
          "type": "integer",
          "format": "int32",
          "example": -512,
          "description": "**参数解释**:\n背景图片左上角像素点的Y轴位置值(画布左上角坐标是0x0)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n 需要保证背景图片要铺满画布。即dy <= 0,并且横屏时dy + height >=1080,竖屏时dy + height >=1920。",
          "minimum": -5760,
          "maximum": 0,
          "default": 0
        },
        "width": {
          "type": "integer",
          "format": "int32",
          "example": 2880,
          "description": "**参数解释**:\n背景图片宽度像素值(相对画布大小)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n需要保证背景图片要铺满画布。即width > 1080,并且横屏时dx + width >=1920,竖屏时dx + width >=1080。",
          "minimum": 1,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "format": "int32",
          "example": 1620,
          "description": "**参数解释**:\n背景图片高度像素值(相对画布大小)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n需要保证背景图片要铺满画布。height> 1080,并且横屏时dy + height >=1080,竖屏时dy + height >=1920。",
          "minimum": 1,
          "maximum": 7680
        }
      },
      "description": "背景图片大小及位置配置。"
    },
    "CreateSmartChatRoomRequestBody": {
      "type": "object",
      "required": [
        "room_name"
      ],
      "properties": {
        "room_name": {
          "type": "string",
          "example": "云笙展厅",
          "description": "对话名称",
          "minLength": 1,
          "maxLength": 256
        },
        "room_description": {
          "type": "string",
          "example": "课件",
          "description": "对话描述。",
          "minLength": 0,
          "maxLength": 1024
        },
        "video_config": {
          "description": "视频输出配置。\n> * 智能交互仅支持配置codec=H264,bitrate,width,height,frame_rate。",
          "$ref": "#/definitions/VideoConfig"
        },
        "model_asset_id": {
          "type": "string",
          "example": "a5d295cdb345c11bd9f36bc22ced3a7a",
          "description": "数字人模型资产ID。",
          "minLength": 0,
          "maxLength": 64
        },
        "voice_config": {
          "description": "语音配置参数。\n> *此参数将被废弃,请使用voice_config_list。",
          "$ref": "#/definitions/VoiceConfig"
        },
        "voice_config_list": {
          "type": "array",
          "description": "语音配置参数列表。",
          "items": {
            "$ref": "#/definitions/ChatVoiceConfig"
          },
          "maxItems": 100,
          "minItems": 1
        },
        "robot_id": {
          "type": "string",
          "example": "e37a28485f684769aa537466e719629d",
          "description": "机器人ID。获取方法请参考[创建应用](CreateRobot.xml)。",
          "minLength": 1,
          "maxLength": 64
        },
        "billing_mode": {
          "type": "string",
          "description": "计费模式,默认值CONCURRENCY\n* CONCURRENCY:并发计费\n* CLIENT:按接入端计费\n* CLIENT_TOKENS: 按接入端计费(TOKENS)",
          "enum": [
            "CONCURRENCY",
            "CLIENT",
            "CLIENT_TOKENS"
          ]
        },
        "reuse_resource": {
          "type": "boolean",
          "description": "是否允许使用未分配的并发数(端模式下不能复用),默认不使用。"
        },
        "concurrency": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n并发路数。\n**约束限制**:\n默认没有并发路数,如果不配置并发数量,则无法启动智能交互对话任务。",
          "minimum": 0,
          "maximum": 1024
        },
        "client_nums": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n允许接入终端端数量。",
          "minimum": 0,
          "maximum": 1024
        },
        "default_language": {
          "type": "string",
          "description": "默认语言,智能交互接口使用。默认值CN。\n* CN:简体中文。\n* EN:英语。\n* ESP:西班牙语(仅海外站点支持)\n* por:葡萄牙语(仅海外站点支持)\n* Arabic:阿拉伯语(仅海外站点支持)\n* Thai:泰语(仅海外站点支持)",
          "enum": [
            "CN",
            "EN",
            "ESP",
            "por",
            "Arabic",
            "Thai"
          ]
        },
        "background_config": {
          "description": "背景配置,background_config=null或background_type=null时为空背景配置。",
          "$ref": "#/definitions/BackgroundConfigInfo"
        },
        "layer_config": {
          "type": "array",
          "description": "图层配置。",
          "items": {
            "$ref": "#/definitions/LayerConfig"
          },
          "maxItems": 100,
          "minItems": 0,
          "x-maxLength": 10000,
          "x-minLength": 0
        },
        "review_config": {
          "description": "内容审核配置",
          "$ref": "#/definitions/ReviewConfig"
        },
        "chat_subtitle_config": {
          "description": "对话字幕配置",
          "$ref": "#/definitions/ChatSubtitleConfig"
        },
        "chat_video_type": {
          "type": "string",
          "description": "智能交互对话端配置。\n* COMPUTER: 电脑端\n* MOBILE: 手机端\n* HUB: 大屏",
          "minLength": 1,
          "maxLength": 64,
          "enum": [
            "COMPUTER",
            "MOBILE",
            "HUB"
          ]
        },
        "exit_mute_threshold": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n静默退出时长。",
          "minimum": 0,
          "maximum": 1440
        },
        "enable_semantic_action": {
          "type": "boolean",
          "description": "是否优先级加载模型资产"
        }
      }
    },
    "ReviewConfig": {
      "type": "object",
      "properties": {
        "no_need_review": {
          "type": "boolean",
          "description": "免审核。 目前仅白名单用户可使用此参数,非白名单用户跟随系统策略审核。"
        }
      },
      "description": "内容审核配置"
    },
    "ChatVoiceConfig": {
      "properties": {
        "voice_asset_id": {
          "type": "string",
          "description": "语音合成特征字符串",
          "minLength": 1,
          "maxLength": 64
        },
        "speed": {
          "type": "integer",
          "format": "int32",
          "description": "语速。默认值100,最小值50,最大值200。\n> 当取值为“100”时,表示一个成年人正常的语速,约为250字/分钟。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "pitch": {
          "type": "integer",
          "format": "int32",
          "description": "音高。默认值100,最小值50,最大值200。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "volume": {
          "type": "integer",
          "format": "int32",
          "description": "音量。默认值140,最小值90,最大值240。",
          "minimum": 90,
          "maximum": 240,
          "default": 140
        },
        "provider": {
          "type": "string",
          "description": "第三方TTS供应商类型。\n* XIMALAYA:喜马拉雅TTS\n* HUAWEI_EI:EI TTS\n* MOBVOI:出门问问TTS",
          "minLength": 0,
          "maxLength": 32
        },
        "language": {
          "type": "string",
          "description": "语言类型。默认值CN。\n* CN:简体中文。\n* EN:英语。\n* ESP:西班牙语(仅海外站点支持)\n* por:葡萄牙语(仅海外站点支持)\n* Arabic:阿拉伯语(仅海外站点支持)\n* Thai:泰语(仅海外站点支持)",
          "enum": [
            "CN",
            "EN",
            "ESP",
            "por",
            "Arabic",
            "Thai"
          ],
          "default": "CN"
        }
      },
      "description": "语音配置参数"
    },
    "SmartChatRoomInfo": {
      "allOf": [
        {
          "$ref": "#/definitions/CreateSmartChatRoomRequestBody"
        },
        {
          "properties": {
            "room_id": {
              "type": "string",
              "description": "对话ID。",
              "minLength": 0,
              "maxLength": 64
            },
            "create_time": {
              "type": "string",
              "description": "智能交互对话创建时间,格式遵循:RFC 3339 如“2021-01-10T08:43:17Z”。",
              "minLength": 20,
              "maxLength": 20
            },
            "update_time": {
              "type": "string",
              "description": "智能交互对话更新时间,格式遵循:RFC 3339 如“2021-01-10T08:43:17Z”。",
              "minLength": 20,
              "maxLength": 20
            },
            "cover_url": {
              "type": "string",
              "description": "对话封面图URL",
              "minLength": 0,
              "maxLength": 2048
            },
            "is_pool_mode": {
              "type": "boolean",
              "description": "是否是资源池模式",
              "default": false
            },
            "chat_resource_config": {
              "type": "array",
              "description": "资源配置。",
              "items": {
                "$ref": "#/definitions/ChatResourceConfigInfo"
              },
              "maxItems": 10000,
              "minItems": 0
            }
          }
        }
      ]
    },
    "VideoConfig": {
      "type": "object",
      "required": [
        "bitrate",
        "height",
        "width"
      ],
      "properties": {
        "clip_mode": {
          "type": "string",
          "description": "**参数解释**:\n输出视频的剪辑方式。\n**约束限制**:\n不涉及。\n**取值范围**:\n* RESIZE:视频缩放。\n* CROP:视频裁剪。",
          "enum": [
            "RESIZE",
            "CROP"
          ],
          "default": "RESIZE"
        },
        "codec": {
          "type": "string",
          "description": "**参数解释**:\n视频编码格式及视频文件格式。\n**约束限制**:\n仅分身数字人视频制作支持VP8和QTRLE编码。QTRLE编码时文本驱动字符数限制小于1500字,音频驱动音频长度小于5分钟。\nQTRLE编码需要先申请开通白名单后才能使用\n\n**取值范围**:\n* H264:h264编码,输出mp4文件。\n* VP8:vp8编码,输出webm文件。\n* QTRLE:qtrle ,输出mov文件。\n\n**默认取值**:\nH264",
          "enum": [
            "H264",
            "VP8",
            "VP9",
            "QTRLE"
          ],
          "default": "H264"
        },
        "bitrate": {
          "type": "integer",
          "description": "**参数解释**:\n输出平均码率。单位:kbps。\n**约束限制**:\n* 分身数字人视频制作采用质量优先,可能会超过设置的码率。\n* 分身数字人直播码率范围[1000, 8000]。\n\n**默认取值**:\n不涉及",
          "minimum": 40,
          "maximum": 30000
        },
        "width": {
          "type": "integer",
          "description": "**参数解释**:\n视频宽度。单位:像素。\n**约束限制**:\n* clip_mode=RESIZE时,当前支持1920x1080、1080x1920、1280x720、720x1280、3840x2160、2160x3840六种分辨率。4K分辨率视频需要分身数字人模型支持4K的情况下才能使用。\n* clip_mode=CROP,裁剪后视频,(dx,dy)为原点,保留视频像宽度为width。\n* 分身数字人直播和智能交互目前只支持1080x1920、1920x1080。\n\n**默认取值**:\n不涉及",
          "minimum": 0,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "description": "**参数解释**:\n视频高度。\n\n单位:像素。\n**约束限制**:\n* clip_mode=RESIZE时,当前支持1920x1080、1080x1920、1280x720、720x1280、3840x2160、2160x3840六种分辨率分辨率。\n* clip_mode=CROP,裁剪后视频,(dx,dy)为原点,保留视频像高度为height。\n* 分身数字人直播和智能交互目前只支持1080x1920、1920x1080。\n\n**默认取值**:\n不涉及",
          "minimum": 0,
          "maximum": 3840
        },
        "frame_rate": {
          "type": "string",
          "format": "string",
          "description": "**参数解释**:\n帧率。单位:FPS。\n**约束限制**:\n分身数字人视频固定25FPS。",
          "minLength": 0,
          "maxLength": 10,
          "enum": [
            "24",
            "25",
            "30"
          ],
          "default": "25"
        },
        "is_subtitle_enable": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n输出的视频是否带字幕。\n**约束限制**:\n分身数字人直播暂时不支持字幕。\n\n**取值范围**:\n* true: 打开字幕\n* false: 关闭字幕",
          "enum": [
            true,
            false
          ],
          "default": false
        },
        "subtitle_config": {
          "$ref": "#/definitions/SubtitleConfig"
        },
        "dx": {
          "type": "integer",
          "format": "int32",
          "example": 256,
          "description": "**参数解释**:\n裁剪视频左上角像素点横坐标。\n> 以模特分辨率为画布大小,比如1920*1080分辨率的模特,dx最小值是0,最大值是1920。\n\n**约束限制**:\nclip_mode= CROP时生效。\n**默认取值**:\n不涉及",
          "minimum": -1920,
          "maximum": 3840
        },
        "dy": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n裁剪视频左上角像素点纵坐标。\n> 以模特分辨率为画布大小,比如1920*1080分辨率的模特,dy最小值是0,最大值是1080\n\n**约束限制**:\nclip_mode= CROP时生效。\n**默认取值**:\n不涉及",
          "minimum": -1920,
          "maximum": 3840
        },
        "is_enable_super_resolution": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n视频是否开启超分。\n**约束限制**:\n仅分身数字人视频制作支持。\n**取值范围**\n* true: 开启\n* false: 不开启",
          "enum": [
            true,
            false
          ],
          "default": false
        },
        "is_end_at_first_frame": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n视频结束帧是否跟起始帧相同。需要多个数字人视频无缝拼接时设置成true。\n**约束限制**:\n仅分身数字人视频制作支持,当视频制作时插入动作标签后此设置将失效。\n**取值范围**\n* true: 开启\n* false: 不开启",
          "enum": [
            true,
            false
          ],
          "default": false
        },
        "output_external_url": {
          "type": "string",
          "example": "https://{endpoint}/a5d295cdb345c11bd9f36bc22ced3a7a/test.mp3?AccessKeyId=dnhlruEz0ZPD8Y8wnodo&Signature=E94GDa%2Bt3L%2F9mTnNXpFfGGFEe7c%3D",
          "description": "视频文件上传的外部URL。\n > * 需要先申请开通白名单后,才允许将视频上传到外部URL。",
          "minLength": 1,
          "maxLength": 2048
        },
        "is_vocabulary_config_enable": {
          "type": "boolean",
          "description": "**参数解释**:\n是否应用当前租户的读法配置\n**约束限制**:\n仅分身数字人视频制作支持。\n**取值范围**\n* true: 开启\n* false: 不开启",
          "default": true
        }
      },
      "description": "视频输出配置。"
    },
    "VideoLayerConfig": {
      "type": "object",
      "properties": {
        "video_url": {
          "type": "string",
          "description": "**参数解释**:\n视频文件的URL。\n**约束限制**:\n* 仅直播支持外部URL,其他业务通过资产库查询获取,不支持外部URL。\n**取值范围**:\n字符长度1-2048位。\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 2048
        },
        "video_cover_url": {
          "type": "string",
          "description": "**参数解释**:\n视频封面文件的URL。\n**约束限制**:\n* 仅直播支持外部URL,其他业务通过资产库查询获取,不支持外部URL。\n**取值范围**:\n字符长度1-2048位。\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 2048
        },
        "loop_count": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n循环播放视频次数。\n\n特殊取值:\n* 0:表示不播放\n* -1:表示持续循环播放\n\n**约束限制**:\n不涉及。",
          "minimum": -1,
          "maximum": 100,
          "default": -1
        },
        "video_sound": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n按照百分比,调整视频素材的音量,取值为0-100。\n\n特殊取值为0,表示不开启声音(默认值)。\n\n**约束限制**:\n不涉及。",
          "minimum": 0,
          "maximum": 100
        },
        "is_play_the_entire_video": {
          "type": "boolean",
          "description": "**参数解释**:\n是否播放完整个视频,true表示播放完整个视频,false表示当场景文本/音频结束时,视频也同时不再播放。\n\n特殊取值:\n默认值为false\n\n**约束限制**:\n不涉及。"
        }
      },
      "description": "素材视频图层配置。"
    },
    "VoiceConfig": {
      "required": [
        "voice_asset_id"
      ],
      "properties": {
        "voice_asset_id": {
          "type": "string",
          "example": "39b9cedccec1f19b33d8f7ce1a6d35b9",
          "description": "**参数解释**:\n音色资产ID,可以从资产库中查询。\n音色ID的查询操作,详见[查询预置音色ID](metastudio_02_0054.xml)。\n**约束限制**:\n不涉及。\n**取值范围**:\n字符长度1-256位。\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 64
        },
        "speed": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n语速。50表示0.5倍语速,100表示正常语速,200表示2倍语速。\n当取值为“100”时,表示一个成年人的正常语速,约为250字/分钟。\n\n**约束限制**:\n不涉及。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "pitch": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n音高。\n**约束限制**:\n不涉及。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "volume": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n音量。\n**约束限制**:\n不涉及。",
          "minimum": 90,
          "maximum": 240,
          "default": 140
        }
      },
      "description": "语音配置参数。"
    },
    "ImageLayerConfig": {
      "type": "object",
      "properties": {
        "image_url": {
          "type": "string",
          "description": "**参数解释**:\n图片文件的URL。\n**约束限制**:\n* 仅直播支持外部URL,其他业务通过资产库查询获取,不支持外部URL。\n**取值范围**:\n字符长度1-2048位。\n**默认取值**:\n不涉及",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "description": "素材图片图层配置。"
    },
    "LayerRotationConfig": {
      "type": "object",
      "properties": {
        "angle": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n旋转角度。\n**取值范围**:\n角度范围0-360度。\n**默认取值**:\n0度。\n**约束限制**:\n以素材中心点旋转。\n视频素材不支持旋转",
          "minimum": 0,
          "maximum": 360
        }
      },
      "description": "图层旋转配置。"
    },
    "SubtitleConfig": {
      "type": "object",
      "properties": {
        "dx": {
          "type": "integer",
          "format": "int32",
          "example": 256,
          "description": "**参数解释**:\n字幕框左下角像素点坐标。\n**约束限制**:\n不涉及。\n**默认取值**:\n不涉及。",
          "minimum": 0,
          "maximum": 1920
        },
        "dy": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n字幕框左下角像素点坐标。\n**约束限制**:\n不涉及。\n**默认取值**:\n不涉及。",
          "minimum": 0,
          "maximum": 1920
        },
        "h": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n字幕框高度。\n**约束限制**:\n参数h用于方便前端计算字幕框左上角坐标,后台不使用该参数。",
          "minimum": 0,
          "maximum": 1920
        },
        "w": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n字幕框宽度。\n**约束限制**:\n* 字幕框宽度固定为屏幕宽度的80%\n* 参数w用于方便前端计算字幕框左上角坐标,后台不使用该参数",
          "minimum": 0,
          "maximum": 1920
        },
        "font_name": {
          "type": "string",
          "description": "**参数解释**:\n字体。当前支持的字体请参考[服务支持的字体](metastudio_02_0041.xml)\n**约束限制**:\n不涉及。\n**取值范围**:\n字符长度0-64位",
          "minLength": 0,
          "maxLength": 64,
          "default": "HarmonyOS_Sans_SC_Black"
        },
        "font_size": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n字体大小。接口的取值范围为0-120,实际业务使用的取值范围要求为24-120,请以业务实际使用要求为准。\n**约束限制**:\n不涉及。",
          "minimum": 0,
          "maximum": 120,
          "default": 54
        },
        "font_color": {
          "type": "string",
          "description": "**参数解释**:\n字幕字体颜色的RGB颜色值。\n**约束限制**:\n无\n**取值范围**:\n字符长度0-7位,固定长度",
          "minLength": 0,
          "maxLength": 16,
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": "#FFFFFF"
        },
        "stroke_color": {
          "type": "string",
          "description": "**参数解释**:\n字幕字体描边颜色的RGB颜色值。\n**约束限制**:\n无\n**取值范围**:\n字符长度0-7位,固定长度",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "stroke_thickness": {
          "type": "number",
          "format": "float",
          "description": "**参数解释**:\n字幕字体描边粗细像素值。\n**约束限制**:\n无\n**取值范围**:\n0-50",
          "minimum": 0,
          "maximum": 50
        },
        "opacity": {
          "type": "number",
          "format": "float",
          "example": 0.5,
          "description": "**参数解释**:\n字幕字体不透明度,0表示完全透明,1表示完全不透明。默认1。\n**约束限制**:\n无\n**取值范围**:\n0-1",
          "minimum": 0,
          "maximum": 1,
          "default": 1.0
        }
      },
      "description": "字幕配置。"
    },
    "LayerPositionConfig": {
      "type": "object",
      "required": [
        "dx",
        "dy",
        "layer_index"
      ],
      "properties": {
        "dx": {
          "type": "integer",
          "format": "int32",
          "example": 256,
          "description": "**参数解释**:\n图层左上角像素点的X轴位置值(画布左上角坐标是0x0)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n该值为相对于画布的像素值,仅表示布局位置关系,与输出画面分辨率无关。",
          "minimum": -1920,
          "maximum": 3840,
          "default": 0
        },
        "dy": {
          "type": "integer",
          "format": "int32",
          "example": 512,
          "description": "**参数解释**:\n图层图片左上角像素点的Y轴位置值(画布左上角坐标是0x0)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n该值为相对于画布的像素值,仅表示布局位置关系,与输出画面分辨率无关。",
          "minimum": -1920,
          "maximum": 3840,
          "default": 0
        },
        "layer_index": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "**参数解释**:\n图片、视频、人物图的层顺序。\n> 图层顺序为从1开始的整数,底层图层顺序是1,往上依次增加。\n\n**约束限制**:\n如果出现重复则重复图层叠加关系随机。",
          "minimum": 1,
          "maximum": 100,
          "default": 100
        }
      },
      "description": "图层位置配置。"
    },
    "LayerSizeConfig": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n图层图片左上角像素点的Y轴位置值图层图片宽度像素值(相对画布大小)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n该值为相对于画布的像素值,仅表示布局位置关系,与输出画面分辨率无关。",
          "minimum": 1,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n图层图片高度像素值(相对画布大小)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n该值为相对于画布的像素值,仅表示布局位置关系,与输出画面分辨率无关。|",
          "minimum": 1,
          "maximum": 7680
        }
      },
      "description": "图层大小配置。"
    },
    "LayerConfig": {
      "required": [
        "layer_type"
      ],
      "properties": {
        "layer_type": {
          "type": "string",
          "description": "**参数解释**:\n图层类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n* HUMAN:  人物图层\n* IMAGE: 素材图片图层\n* VIDEO: 素材视频图层\n* TEXT: 素材文字图层\n\n**默认取值**:\n不涉及",
          "enum": [
            "HUMAN",
            "IMAGE",
            "VIDEO",
            "TEXT"
          ]
        },
        "asset_id": {
          "type": "string",
          "description": "**参数解释**:\n图层所需资产的资产id,外部资产信息无需填写。\n**约束限制**:\n不涉及。\n**取值范围**:\n字符长度0-64位\n**默认取值**:\n不涉及",
          "minLength": 0,
          "maxLength": 64
        },
        "group_id": {
          "type": "string",
          "description": "**参数解释**:\n多场景素材编组。同一group_id的素材,在应用全局时共享位置信息。\n**约束限制**:\n不涉及。\n**取值范围**:\n字符长度0-64位\n**默认取值**:\n不涉及",
          "minLength": 0,
          "maxLength": 64
        },
        "sequence_no": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "**参数解释**:\n播放到对应的段落,显示对应的图层。该字段向前兼容,可以不填,字段可选。\n只支持直播业务。\n**约束限制**:\n段落sequence_no。\n**默认取值**:\n不涉及。",
          "minimum": 0,
          "maximum": 2147483647
        },
        "position": {
          "$ref": "#/definitions/LayerPositionConfig"
        },
        "size": {
          "$ref": "#/definitions/LayerSizeConfig"
        },
        "rotation": {
          "$ref": "#/definitions/LayerRotationConfig"
        },
        "image_config": {
          "$ref": "#/definitions/ImageLayerConfig"
        },
        "video_config": {
          "$ref": "#/definitions/VideoLayerConfig"
        },
        "text_config": {
          "$ref": "#/definitions/TextLayerConfig"
        }
      },
      "description": "图层配置。"
    },
    "TextLayerConfig": {
      "type": "object",
      "properties": {
        "text_context": {
          "type": "string",
          "description": "**参数解释**:\n文字图层的文本,内容需做Base64编码。\n\n示例:若想添加文字水印“测试文字水印”,那么text_context的值为:5rWL6K+V5paH5a2X5rC05Y2w\n**约束限制**:\n不涉及。\n**取值范围**:\n字符长度0-1024位。\n**默认取值**:\n不涉及。",
          "minLength": 0,
          "maxLength": 1024
        },
        "font_name": {
          "type": "string",
          "description": "字体。当前支持的字体请参考[服务支持的字体](metastudio_02_0041.xml)\n**约束限制**:\n不涉及。\n**取值范围**:\n字符长度0-64位",
          "minLength": 0,
          "maxLength": 64,
          "default": "HarmonyOS_Sans_SC_Black"
        },
        "font_size": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n字体大小(像素)。接口的取值范围为0-120,实际业务使用的取值范围要求为4-120,请以业务实际使用要求为准。\n\n**约束限制**:\n不涉及。",
          "minimum": 0,
          "maximum": 120,
          "default": 16
        },
        "font_color": {
          "type": "string",
          "description": "**参数解释**:\n字体颜色。RGB颜色值。\n\n**约束限制**:\n不涉及。\n**取值范围**:\n字符长度0-16位",
          "minLength": 0,
          "maxLength": 16,
          "default": "#FFFFFF"
        }
      },
      "description": "素材文字图层配置。"
    }
