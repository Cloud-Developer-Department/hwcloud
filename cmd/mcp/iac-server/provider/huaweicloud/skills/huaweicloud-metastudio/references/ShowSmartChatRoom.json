  "version": "2.0",
  "parameters": {
    "X-Sdk-DateHeader": {
      "name": "X-Sdk-Date",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,请求的发生时间。\n\n格式为(YYYYMMDD'T'HHMMSS'Z')。",
      "required": false,
      "type": "string",
      "maxLength": 16,
      "minLength": 16,
      "x-annotations": [
        "@Size(min = 16, max = 16)"
      ],
      "x-example": "20191115T033655Z",
      "x-apig-registered": false
    },
    "X-Project-IdHeader": {
      "name": "X-Project-Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
      "required": false,
