    "SaveTtscVocabularyConfigsRequestBody": {
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "支持配置的自定义读法类型。当前读法类型会映射为SSML标签,详见[文本驱动SSML定义](metastudio_02_0038.xml)。\n\n包含如下选项:\n* CHINESE_G2P:拼音\n* PHONETIC_SYMBOL:音标\n* CONTINUUM:连读\n* ALIAS:别名\n* SAY_AS:数字/英文的读法。不同value值有不同的读法,详情如下所示。\n  数字的读法包括:\n  - date:读日期\n  - number:读数字\n  - figure:读数值\n  - telephone:读电话\n\n  英文的读法包括:\n  - spell:读字母\n  - english:读单词",
          "enum": [
            "CHINESE_G2P",
            "PHONETIC_SYMBOL",
            "CONTINUUM",
            "ALIAS",
            "SAY_AS"
          ]
        },
        "key": {
          "type": "string",
          "example": "同行",
          "description": "原始词。",
          "minLength": 0,
          "maxLength": 200,
          "default": ""
        },
        "value": {
          "type": "string",
          "example": "tong2 xing2",
          "description": "自定义读法。其中,音标的读法请参考[词典](https://www.youdao.com/)。",
          "minLength": 0,
          "maxLength": 200,
          "default": ""
        },
        "group_id": {
          "type": "string",
          "example": "098848hd90247b5e90247b5e322213",
          "description": "分组id",
          "minLength": 0,
          "maxLength": 64
        }
      },
      "description": "保存租户级tts自定义读法配置请求"
    }
