{
  "name": "ShowPhotoDigitalHumanVideo",
  "summary": "查询照片分身数字人视频制作任务详情",
  "tags": "照片数字人视频制作管理",
  "productshort": "MetaStudio",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/photo-digital-human-videos/{job_id}": {
      "get": {
        "tags": [
          "DigitalHumanVideoManagerForPhoto"
        ],
        "summary": "查询照片分身数字人视频制作任务详情",
        "description": "该接口用于查询照片分身数字人视频制作任务详情。",
        "operationId": "ShowPhotoDigitalHumanVideo",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/Job-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader"
          },
          {
            "$ref": "#/parameters/X-App-UserId"
          },
          {
            "name": "show_script",
            "in": "query",
            "description": "是否需要返回剧本参数配置。",
            "required": false,
            "type": "boolean",
            "default": false
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。",
            "examples": {
              "application/json": {
                "job_id": "26f06524-4f75-4b3a-a853-b649a21aaf66",
                "state": "SUCCESS",
                "start_time": "2022-01-18T16:29:36Z",
                "end_time": "2022-01-18T16:30:36Z",
                "duration": 60,
                "output_asset_config": {
                  "asset_id": "942e65a5fd219a2e01fb08d881cfadb9",
                  "asset_name": "One Day",
                  "cover_url": "https://{endpoint}/0d697589d98091f12f92c0073501cd79/942e65a5fd219a2e01fb08d881cfadb9/20d367508e62d3d4ad608cedbe81bd35.png?AccessKeyId=XCQKTA8IWQPCAUQS4SDA&Expires=1671241457&Signature=zVGMVbI5ji9rr8epD1Cir5OGIRk%3D"
                },
                "create_time": "2022-11-30T06:59:56Z",
                "lastupdate_time": "2022-11-30T07:00:09Z",
                "script_id": "4b5b6effcf3b4c72a0baccb265111765",
                "voice_config": {
                  "voice_asset_id": "f5e6a13eab4443fa85421191ad061780",
                  "speed": 100,
                  "pitch": 100,
                  "volume": 140
                },
                "video_config": {
                  "codec": "H264",
                  "bitrate": 5000,
                  "frame_rate": 30
                },
                "shoot_scripts": [
                  {
                    "sequence_no": 0,
                    "shoot_script": {
                      "text_config": {
                        "text": "大家好,我是云玲。"
                      }
                    }
                  }
                ]
              }
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求ID。"
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowPhotoDigitalHumanVideoDetail"
            }
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          },
          "401": {
            "$ref": "#/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/responses/NotFound"
          },
          "500": {
            "$ref": "#/responses/InternalServiceError"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-open-range": "public",
        "x-apig-group": "public-iam,internal-appcode",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/0d697589d98091f12f92c0073501cd79/photo-digital-human-videos/26f06524-4f75-4b3a-a853-b649a21aaf66"
      }
    }
  },
  "definitions": {
    "OutputAssetInfo": {
      "required": [
        "asset_id",
        "asset_name"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "description": "输出视频资产ID。",
          "minLength": 1,
          "maxLength": 256
        },
        "asset_name": {
          "type": "string",
          "description": "输出视频资产名称。",
          "minLength": 0,
          "maxLength": 256
        },
        "cover_url": {
          "type": "string",
          "description": "视频封面URL。",
          "minLength": 1,
          "maxLength": 2048
        },
        "preview_video_url": {
          "type": "string",
          "description": "预览视频下载URL。URL有效期24小时。\n> * 分身数字人视频制作不支持预览。",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "description": "输出资产信息配置。"
    },
    "ShowPhotoDigitalHumanVideoDetail": {
      "allOf": [
        {
          "$ref": "#/definitions/DigitalHumanVideo"
        },
        {
          "properties": {
            "script_id": {
              "type": "string",
              "description": "剧本ID。",
              "minLength": 1,
              "maxLength": 64
            },
            "human_image": {
              "type": "string",
              "example": "/9j/4AAQSkZJRgABAQEAYABg...",
              "description": "人物照片,需要Base64编码。",
              "minLength": 1,
              "maxLength": 2147483647
            },
            "voice_config": {
              "$ref": "#/definitions/VoiceConfig"
            },
            "video_config": {
              "description": "视频输出配置。",
              "$ref": "#/definitions/PhotoVideoConfig"
            },
            "shoot_scripts": {
              "type": "array",
              "description": "拍摄脚本列表。",
              "items": {
                "$ref": "#/definitions/ShootScriptItem"
              },
              "maxItems": 100,
              "minItems": 0
            }
          }
        }
      ]
    },
    "BackgroundConfigInfo": {
      "required": [
        "background_type"
      ],
      "properties": {
        "background_type": {
          "type": "string",
          "description": "**参数解释**:\n背景类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n* IMAGE:图片背景,指定图片用作分身数字人背景。\n* COLOR:纯色背景,指定颜色RGB值作为分身数字人背景。\n\n**默认取值**:\n不涉及",
          "minLength": 1,
          "maxLength": 2048,
          "enum": [
            "IMAGE",
            "COLOR",
            "IMAGE_2D",
            "VIDEO",
            "AUDIO"
          ]
        },
        "background_config": {
          "type": "string",
          "example": "https://{endpoint}/0d697589d98091f12f92c0073501cd79/8cb2f48a2cb006154794741933421100/b2f8a9e9c39b6dc7ed4c0cfd67366c6a.jpg?AccessKeyId=XCQKTA8IWQPCAUQS4SDA&Expires=1671241324&Signature=tD38peKsCkh%2FygE3IffeLbewuEw%3D",
          "description": "**参数解释**:\n背景文件的URL。\n**约束限制**:\n* 仅直播支持外部URL,其他业务通过资产库查询获取,不支持外部URL。\n* background_type=IMAGE时需要填写。\n\n**取值范围**:\n字符长度1-2048位\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 2048
        },
        "background_color_config": {
          "type": "string",
          "description": "**参数解释**:\n纯色背景的RGB颜色值。\n**约束限制**:\nbackground_type=COLOR时需要填写。\n**取值范围**:\n字符长度0-16位",
          "minLength": 0,
          "maxLength": 16,
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": "#FFFFFF"
        },
        "background_asset_id": {
          "type": "string",
          "example": "a5d295cdb345c11bd9f36bc22ced3a7b",
          "description": "**参数解释**:\n背景资产ID。\n> 背景是背景图片时,填图片资产ID。\n\n**约束限制**:\n不涉及\n**取值范围**:\n字符长度0-64位\n**默认取值**:\n不涉及",
          "minLength": 0,
          "maxLength": 64
        },
        "background_image_config": {
          "$ref": "#/definitions/BackgroundImageConfig"
        }
      },
      "description": "背景配置。"
    },
    "BackgroundImageConfig": {
      "type": "object",
      "required": [
        "dx",
        "dy",
        "height",
        "width"
      ],
      "properties": {
        "dx": {
          "type": "integer",
          "format": "int32",
          "example": -256,
          "description": "**参数解释**:\n背景图片左上角像素点的X轴位置值(画布左上角坐标是0x0)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n需要保证背景图片要铺满画布。即dx <= 0,并且横屏时dx + width >=1920,竖屏时dx + width >=1080。",
          "minimum": -5760,
          "maximum": 0,
          "default": 0
        },
        "dy": {
          "type": "integer",
          "format": "int32",
          "example": -512,
          "description": "**参数解释**:\n背景图片左上角像素点的Y轴位置值(画布左上角坐标是0x0)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n 需要保证背景图片要铺满画布。即dy <= 0,并且横屏时dy + height >=1080,竖屏时dy + height >=1920。",
          "minimum": -5760,
          "maximum": 0,
          "default": 0
        },
        "width": {
          "type": "integer",
          "format": "int32",
          "example": 2880,
          "description": "**参数解释**:\n背景图片宽度像素值(相对画布大小)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n需要保证背景图片要铺满画布。即width > 1080,并且横屏时dx + width >=1920,竖屏时dx + width >=1080。",
          "minimum": 1,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "format": "int32",
          "example": 1620,
          "description": "**参数解释**:\n背景图片高度像素值(相对画布大小)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n需要保证背景图片要铺满画布。height> 1080,并且横屏时dy + height >=1080,竖屏时dy + height >=1920。",
          "minimum": 1,
          "maximum": 7680
        }
      },
      "description": "背景图片大小及位置配置。"
    },
    "ShootScriptItem": {
      "required": [
        "shoot_script"
      ],
      "allOf": [
        {
          "$ref": "#/definitions/ShootScriptItemBaseInfo"
        },
        {
          "properties": {
            "shoot_script": {
              "$ref": "#/definitions/ShootScript"
            },
            "subtitle_file_info": {
              "description": "字幕文件信息。",
              "$ref": "#/definitions/SubtitleFiles"
            }
          }
        }
      ],
      "description": "剧本参数配置。"
    },
    "PhotoVideoConfig": {
      "required": [
        "codec"
      ],
      "properties": {
        "codec": {
          "type": "string",
          "description": "视频编码格式及视频文件格式。\n* H264:h264编码,输出mp4文件",
          "enum": [
            "H264"
          ]
        },
        "bitrate": {
          "type": "integer",
          "description": "**参数解释**:\n输出平均码率。\n\n单位:kbps。\n\n最小值40,最大值30000。",
          "minimum": 40,
          "maximum": 30000
        },
        "frame_rate": {
          "type": "string",
          "format": "string",
          "description": "帧率。\n\n单位:FPS。",
          "minLength": 0,
          "maxLength": 10,
          "enum": [
            "24",
            "25",
            "30"
          ],
          "default": "30"
        }
      },
      "description": "视频输出配置。照片数字人支持该输出配置查询,不支持修改。"
    },
    "SubtitleFiles": {
      "type": "object",
      "properties": {
        "text_subtitle_file": {
          "$ref": "#/definitions/SubtitleFileInfo"
        },
        "audio_subtitle_file": {
          "$ref": "#/definitions/SubtitleFileInfo"
        }
      }
    },
    "AudioInfo": {
      "properties": {
        "audio_id": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "**参数解释**:\n音频id。\n> * 获取方式:剧本为音频驱动时,查询剧本详情或者更新剧本会返回audio_id\n\n**约束限制**:\n不涉及\n**默认取值**:\n不涉及",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "VideoLayerConfig": {
      "type": "object",
      "properties": {
        "video_url": {
          "type": "string",
          "description": "**参数解释**:\n视频文件的URL。\n**约束限制**:\n* 仅直播支持外部URL,其他业务通过资产库查询获取,不支持外部URL。\n**取值范围**:\n字符长度1-2048位。\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 2048
        },
        "video_cover_url": {
          "type": "string",
          "description": "**参数解释**:\n视频封面文件的URL。\n**约束限制**:\n* 仅直播支持外部URL,其他业务通过资产库查询获取,不支持外部URL。\n**取值范围**:\n字符长度1-2048位。\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 2048
        },
        "loop_count": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n循环播放视频次数。\n\n特殊取值:\n* 0:表示不播放\n* -1:表示持续循环播放\n\n**约束限制**:\n不涉及。",
          "minimum": -1,
          "maximum": 100,
          "default": -1
        },
        "video_sound": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n按照百分比,调整视频素材的音量,取值为0-100。\n\n特殊取值为0,表示不开启声音(默认值)。\n\n**约束限制**:\n不涉及。",
          "minimum": 0,
          "maximum": 100
        },
        "is_play_the_entire_video": {
          "type": "boolean",
          "description": "**参数解释**:\n是否播放完整个视频,true表示播放完整个视频,false表示当场景文本/音频结束时,视频也同时不再播放。\n\n特殊取值:\n默认值为false\n\n**约束限制**:\n不涉及。"
        }
      },
      "description": "素材视频图层配置。"
    },
    "VoiceConfig": {
      "required": [
        "voice_asset_id"
      ],
      "properties": {
        "voice_asset_id": {
          "type": "string",
          "example": "39b9cedccec1f19b33d8f7ce1a6d35b9",
          "description": "**参数解释**:\n音色资产ID,可以从资产库中查询。\n音色ID的查询操作,详见[查询预置音色ID](metastudio_02_0054.xml)。\n**约束限制**:\n不涉及。\n**取值范围**:\n字符长度1-256位。\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 64
        },
        "speed": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n语速。50表示0.5倍语速,100表示正常语速,200表示2倍语速。\n当取值为“100”时,表示一个成年人的正常语速,约为250字/分钟。\n\n**约束限制**:\n不涉及。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "pitch": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n音高。\n**约束限制**:\n不涉及。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "volume": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n音量。\n**约束限制**:\n不涉及。",
          "minimum": 90,
          "maximum": 240,
          "default": 140
        }
      },
      "description": "语音配置参数。"
    },
    "TextConfig": {
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "**参数解释**:\n台词脚本。支持两种模式,纯文本模式和标签模式。\n- 纯文本模式:使用方法,如“大家好,我是人工智大家,是个虚拟主播”。\n- 标签模式:SSML标签的详细定义请参考[文本驱动SSML定义](metastudio_02_0038.xml)。\n\n**约束限制**:\n不含SSML标签字符数最长10000个字符。\n**取值范围**:\n字符长度0-131072位。\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 300000,
          "x-annotations": "@TextLength(maxLength = 300000)"
        }
      },
      "description": "台词脚本。\n> 最长10000个字符,不含SSML标签字符数。",
      "x-imports": [
        "com.huawei.hdh.mps.annotations.TextLength"
      ]
    },
    "ImageLayerConfig": {
      "type": "object",
      "properties": {
        "image_url": {
          "type": "string",
          "description": "**参数解释**:\n图片文件的URL。\n**约束限制**:\n* 仅直播支持外部URL,其他业务通过资产库查询获取,不支持外部URL。\n**取值范围**:\n字符长度1-2048位。\n**默认取值**:\n不涉及",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "description": "素材图片图层配置。"
    },
    "LayerRotationConfig": {
      "type": "object",
      "properties": {
        "angle": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n旋转角度。\n**取值范围**:\n角度范围0-360度。\n**默认取值**:\n0度。\n**约束限制**:\n以素材中心点旋转。\n视频素材不支持旋转",
          "minimum": 0,
          "maximum": 360
        }
      },
      "description": "图层旋转配置。"
    },
    "LayerPositionConfig": {
      "type": "object",
      "required": [
        "dx",
        "dy",
        "layer_index"
      ],
      "properties": {
        "dx": {
          "type": "integer",
          "format": "int32",
          "example": 256,
          "description": "**参数解释**:\n图层左上角像素点的X轴位置值(画布左上角坐标是0x0)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n该值为相对于画布的像素值,仅表示布局位置关系,与输出画面分辨率无关。",
          "minimum": -1920,
          "maximum": 3840,
          "default": 0
        },
        "dy": {
          "type": "integer",
          "format": "int32",
          "example": 512,
          "description": "**参数解释**:\n图层图片左上角像素点的Y轴位置值(画布左上角坐标是0x0)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n该值为相对于画布的像素值,仅表示布局位置关系,与输出画面分辨率无关。",
          "minimum": -1920,
          "maximum": 3840,
          "default": 0
        },
        "layer_index": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "**参数解释**:\n图片、视频、人物图的层顺序。\n> 图层顺序为从1开始的整数,底层图层顺序是1,往上依次增加。\n\n**约束限制**:\n如果出现重复则重复图层叠加关系随机。",
          "minimum": 1,
          "maximum": 100,
          "default": 100
        }
      },
      "description": "图层位置配置。"
    },
    "ShootScript": {
      "properties": {
        "script_type": {
          "type": "string",
          "description": "**参数解释**:\n脚本类型,即视频制作的驱动方式\n**约束限制**:\n不涉及\n**取值范围**\n* TEXT: 文本驱动,即通过TTS合成语音\n* AUDIO: 语音驱动",
          "enum": [
            "TEXT",
            "AUDIO"
          ],
          "default": "TEXT"
        },
        "text_config": {
          "description": "讲解词配置。",
          "$ref": "#/definitions/TextConfig"
        },
        "audio_duration": {
          "type": "number",
          "format": "float",
          "example": 30.52,
