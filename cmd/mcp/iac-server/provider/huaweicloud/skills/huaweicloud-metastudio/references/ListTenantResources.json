  "definitions": {
    "BoundAssetInfo": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "description": "资产ID。",
          "minLength": 1,
          "maxLength": 256
        },
        "asset_name": {
          "type": "string",
          "example": "云笙",
          "description": "资产名称。从资产库查询的资产名称",
          "minLength": 0,
          "maxLength": 256
        }
      },
      "description": "绑定的资产信息。形象和声音训练完成后,资源会绑定到资产上。"
    },
    "TenantResourcesList": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "description": "资源用量列表",
          "items": {
            "$ref": "#/definitions/ResourceItemInfo"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "count": {
          "type": "number",
          "description": "资源总数。",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "description": "租户资源列表"
    },
    "ResourceItemInfo": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string",
          "description": "资源ID。",
          "minLength": 1,
          "maxLength": 128
        },
        "order_id": {
          "type": "string",
          "description": "cloudServiceId的订单id。\n云服务购买清单等场景必填(purchaseMode取值为3、4),每个CloudService生成一个订单;此场景如果为空,则报错。\n其他场景,为空。",
          "minLength": 0,
          "maxLength": 64
        },
        "bound_asset": {
          "description": "绑定的资产。",
          "$ref": "#/definitions/BoundAssetInfo"
        },
        "resource_expire_time": {
          "type": "string",
          "description": "资源截止时间。格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"",
          "minLength": 0,
          "maxLength": 20
        },
        "resource_type": {
          "type": "string",
          "description": "资源类型。详见[资源类型](metastudio_02_0042.xml)。",
          "minLength": 1,
          "maxLength": 64
        },
        "business_type": {
          "type": "string",
          "description": "业务类型。\n* VOICE_CLONE:声音制作\n* SYNTHETICS_SOUND:声音合成\n* ASSET_MANAGER:资产管理\n* MODELING_2D:形象制作\n* LIVE_2D:分身数字人视频直播\n* VIDEO_2D:分身数字人视频制作\n* CHAT_2D:分身数字人智能交互\n* BUSINESS_CARD_2D:分身数字人名片\n* PICTURE_2D:照片数字人视频\n* MODELING_3D:3D照片建模\n* VDS_3D:3D视觉驱动\n* TTSA_3D:3D语音驱动\n* FLEXUS_2D:flexus版本资源",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "VOICE_CLONE",
            "SYNTHETICS_SOUND",
            "ASSET_MANAGER",
            "MODELING_2D",
            "LIVE_2D",
            "VIDEO_2D",
            "CHAT_2D",
            "BUSINESS_CARD_2D",
            "PICTURE_2D",
            "MODELING_3D",
            "VDS_3D",
            "TTSA_3D",
            "FLEXUS_2D"
          ]
        },
        "sub_resource_type": {
          "type": "string",
          "description": "子资源类型。当前只有flexus套餐包存在该字段\n* voice_clone_flexus: 语音克隆Flexus版\n* modeling_count_2d_model_flexus: 分身数字人形象制作Flexus版\n* video_time_flexus_2d_model: 分身数字人Flexus版本视频制作",
          "minLength": 1,
          "maxLength": 64
        },
        "is_sub_resource": {
          "type": "boolean",
          "description": "是否子资源。子资源描述的是子资源的数量和单位",
          "default": false
        },
        "charging_mode": {
          "type": "string",
          "description": "计费类型。\n* PERIODIC: 包周期\n* ONE_TIME:一次性\n* ON_DEMAND:按需",
          "minLength": 1,
          "maxLength": 128,
          "enum": [
            "PERIODIC",
            "ONE_TIME",
            "ON_DEMAND"
          ]
        },
        "resource_source": {
          "type": "string",
          "format": "int64",
          "example": "ADMIN_ALLOCATED",
          "description": "资源来源。\n* PURCHASED: 购买\n* SP_ALLOCATED:SP分配\n* ADMIN_ALLOCATED:系统管理员分配",
          "minLength": 1,
          "maxLength": 64
        },
        "amount": {
          "type": "number",
          "format": "float",
          "description": "总量",
          "minimum": 0,
          "maximum": 1000000
        },
        "usage": {
          "type": "number",
          "format": "float",
          "description": "使用量",
          "minimum": 0,
          "maximum": 1000000
        },
        "status": {
          "type": "integer",
          "description": "资源状态 0:正常 1:冻结",
          "minimum": 0,
          "maximum": 1
        },
        "unit": {
          "type": "string",
          "description": "单位。\n* NUM:个数(形象/声音)\n* MIN:分钟(视频制作)\n* HOUR:小时 (直播)\n* CHANNEL:路(直播/交互)\n* GB:GB(资产管理)\n* MILLION_WORDS:百万字\n* TEN_THOUSAND_WORDS:万字\n* TIME:次",
          "enum": [
            "NUM",
            "MIN",
            "HOUR",
            "CHANNEL",
            "GB",
            "MILLION_WORDS",
            "TEN_THOUSAND_WORDS",
            "TIME"
          ]
        }
      },
      "description": "资源使用信息"
    }
  },
