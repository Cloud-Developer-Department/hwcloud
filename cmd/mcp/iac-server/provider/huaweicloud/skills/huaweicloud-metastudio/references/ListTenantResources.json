{
  "name": "ListTenantResources",
  "summary": "查看租户资源列表",
  "tags": "租户管理",
  "productshort": "MetaStudio",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/tenants/resources": {
      "get": {
        "tags": [
          "TenantManager"
        ],
        "summary": "查看租户资源列表",
        "description": "查看租户资源列表。\n > 按需套餐包用量本接口无法查询,需要调用CBC接口查询,详见[按需套餐包用量查询](https://cbc.huaweicloud.com/bm/support/api-apidt/CBCInterface_0001239.html)和[查询资源包信息](https://cbc.huaweicloud.com/bm/support/api-apidt/CBCInterface_0000511.html)。\n> 各种资源的计费方式请参考[计费说明](https://support.huaweicloud.com/productdesc-metastudio/metastudio_01_0006.html)。",
        "operationId": "ListTenantResources",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader"
          },
          {
            "$ref": "#/parameters/LimitQuery"
          },
          {
            "$ref": "#/parameters/OffsetQuery"
          },
          {
            "name": "resource",
            "in": "query",
            "description": "资源类型。可填多个,用\",\"分隔。详见[资源类型](metastudio_02_0042.xml)。",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "x-apig-registered": false
          },
          {
            "name": "business",
            "in": "query",
            "description": "业务类型。可填多个,用\",\"分隔。\n* VOICE_CLONE:声音制作\n* SYNTHETICS_SOUND:声音合成\n* ASSET_MANAGER:资产管理\n* MODELING_2D:形象制作\n* LIVE_2D:分身数字人视频直播\n* VIDEO_2D:分身数字人视频制作\n* CHAT_2D:分身数字人智能交互\n* BUSINESS_CARD_2D:分身数字人名片\n* PICTURE_2D:照片数字人视频\n* MODELING_3D:3D照片建模\n* VDS_3D:3D视觉驱动\n* TTSA_3D:3D语音驱动\n* FLEXUS_2D:FLEXUS版本资源",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "x-apig-registered": false
          },
          {
            "name": "resource_source",
            "in": "query",
            "description": "资源来源,可填多个\n例如:PURCHASED,ADMIN_ALLOCATED,将返回商用资源与管理员分配资源。\n* PURCHASED: 用户购买的资源\n* SP_ALLOCATED: SP分配的资源\n* ADMIN_ALLOCATED: 系统管理员分配的资源",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          {
            "name": "resource_id",
            "in": "query",
            "description": "资源id。",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          },
          {
            "name": "order_id",
            "in": "query",
            "description": "订单id。",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          },
          {
            "name": "charging_mode",
            "in": "query",
            "description": "计费类型。 \n* PERIODIC: 包周期 \n* ONE_TIME:一次性 \n* ON_DEMAND:按需 计费模式。",
            "required": false,
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          {
            "name": "resource_expire_start_time",
            "in": "query",
            "description": "资源过期时间段 开始时间。格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"",
            "required": false,
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          {
            "name": "resource_expire_end_time",
            "in": "query",
            "description": "资源过期时间段 结束时间。格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"",
            "required": false,
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          {
            "name": "sub_resource",
            "in": "query",
            "description": "子资源类型。当前只有flexus套餐包存在该字段\n* voice_clone_flexus: 语音克隆Flexus版\n* modeling_count_2d_model_flexus: 分身数字人形象制作Flexus版\n* video_time_flexus_2d_model: 分身数字人Flexus版本视频制作",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          {
            "name": "status",
            "in": "query",
            "description": "资源状态。",
            "required": false,
            "type": "integer",
            "maximum": 1,
            "minimum": 0
          }
        ],
        "responses": {
          "200": {
            "description": "查看租户信息",
            "examples": {
              "application/json": {
                "resources": [
                  {
                    "resource_id": "f488337c31c8e4622f1590735b134c65",
                    "resource_type": "Interaction.basic.channel",
                    "business_type": "LIVE_2D",
                    "order_id": "ed4553db2cf949fca7eeb327a276bdbd",
                    "resource_expire_time": "2021-01-10T08:43:17Z",
                    "charging_mode": "ONE_TIME",
                    "amount": 1,
                    "unit": "CHANNEL"
                  }
                ],
                "count": 1
              }
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求ID。"
