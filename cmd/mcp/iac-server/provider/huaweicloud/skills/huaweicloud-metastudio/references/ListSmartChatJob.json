{
  "name": "ListSmartChatJob",
  "summary": "查询数字人智能交互任务列表",
  "tags": "智能交互数字人对话任务管理",
  "productshort": "MetaStudio",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/digital-human-chat/smart-chat-rooms/{room_id}/smart-chat-jobs": {
      "get": {
        "tags": [
          "DialogManagement"
        ],
        "summary": "查询数字人智能交互任务列表",
        "description": "该接口用于查询数字人智能交互任务列表。",
        "operationId": "ListSmartChatJob",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader-notgenerate"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader-notgenerate"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader-notgenerate"
          },
          {
            "$ref": "#/parameters/X-App-UserId-notgenerate"
          },
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/Room-IdPath"
          },
          {
            "$ref": "#/parameters/StateQuery"
          },
          {
            "$ref": "#/parameters/OffsetQuery"
          },
          {
            "$ref": "#/parameters/LimitQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。",
            "examples": {
              "application/json": {
                "count": 1,
                "smart_chat_jobs": [
                  {
                    "job_id": "26f06524-4f75-4b3a-a853-b649a21aaf66",
                    "state": "WAITING",
                    "start_time": "2022-01-18T16:29:36Z",
                    "end_time": "2022-01-18T16:30:36Z",
                    "duration": 60
                  }
                ]
              }
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求ID。"
              }
            },
            "schema": {
              "$ref": "#/definitions/ListSmartChatJobsInfo"
            }
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-apig-group": "public-iam,internal-appcode",
        "x-open-range": "public",
        "x-imports": "com.huawei.springframework.advice.HttpStatusController;com.huawei.springframework.security.auth.annotation.TokenAuthorization;com.huawei.mss.ics.manage.constants.IcsValidateConstants;",
        "x-api-type": "open-api",
        "x-request-examples-url-1": "GET https://metastudio.cn-north-4.myhuaweicloud.com/v1/70b76xxxxxx34253880af501cdxxxxxx/digital-human-chat/smart-chat-rooms/41c86xxxxxx34253850af102cdxxxxxx/smart-chat-jobs"
      }
    }
  },
  "definitions": {
    "SmartChatJobBaseInfo": {
      "properties": {
        "job_id": {
          "type": "string",
          "example": "38ch6xxxxxx5z233850af709crxxxxxx",
          "description": "数字人智能交互对话任务ID。",
          "minLength": 1,
          "maxLength": 64
        },
        "state": {
          "type": "string",
          "example": "PROCESSING",
          "description": "数字人智能交互对话任务的状态。\n* WAITING: 等待\n* PROCESSING: 处理中\n* SUCCEED: 成功\n* FAILED: 失败\n* DELETING: 删除中",
          "minLength": 1,
          "maxLength": 64,
          "enum": [
            "WAITING",
            "PROCESSING",
            "SUCCEED",
            "FAILED",
            "CANCELED",
            "HEARTBEAT",
            "IDLE",
            "DELETING"
          ]
        },
        "duration": {
          "type": "number",
          "format": "float",
          "example": 300.0,
          "description": "数字人智能交互对话时长,单位秒。",
          "minimum": 0,
          "maximum": 2147483647
        },
        "start_time": {
          "type": "string",
          "example": "2023-12-01T08:43:17Z",
          "description": "数字人智能交互对话任务开始时间。格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"。",
          "minLength": 20,
          "maxLength": 20
        },
        "end_time": {
          "type": "string",
          "example": "2023-12-01T10:13:14Z",
          "description": "数字人智能交互对话任务结束时间。格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"。",
          "minLength": 20,
          "maxLength": 20
        },
        "error_info": {
          "description": "数字人智能交互对话任务出错信息。",
          "$ref": "#/definitions/ErrorResponse"
        },
        "create_time": {
          "type": "string",
          "example": "2023-12-01T08:13:17Z",
          "description": "数字人智能交互对话任务创建时间。格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"。",
          "minLength": 20,
          "maxLength": 20
        },
        "lastupdate_time": {
          "type": "string",
          "example": "2023-12-01T08:15:13Z",
          "description": "数字人智能交互对话任务最后更新时间。格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"。",
          "minLength": 20,
          "maxLength": 20
        },
        "chat_subtitle_config": {
          "description": "对话字幕配置",
          "$ref": "#/definitions/SmartChatSubtitleConfig"
        },
        "video_config": {
          "description": "视频输出配置。",
          "$ref": "#/definitions/SmartChatVideoConfig"
        },
        "voice_config_list": {
          "type": "array",
          "description": "语音配置参数列表。",
          "items": {
            "$ref": "#/definitions/SmartChatVoiceConfig"
          },
          "maxItems": 100,
          "minItems": 1
        },
        "chat_video_type": {
          "type": "string",
          "description": "智能交互对话端配置。\n* COMPUTER: 电脑端\n* MOBILE: 手机端\n* HUB: 大屏",
          "minLength": 1,
          "maxLength": 64,
          "enum": [
            "COMPUTER",
            "MOBILE",
            "HUB"
          ]
        },
        "is_transparent": {
          "type": "boolean",
          "example": true,
          "description": "是否透明背景",
          "default": false
        },
        "default_language": {
          "type": "string",
          "description": "默认语言,智能交互接口使用。默认值CN。\n* CN:中文。\n* EN:英文。\n* ESP:西班牙语(仅海外站点支持)\n* por:葡萄牙语(仅海外站点支持)\n* Arabic:阿拉伯语(仅海外站点支持)\n* Thai:泰语(仅海外站点支持)\n* fr:法语(仅海外站点支持)",
          "enum": [
            "CN",
            "EN",
            "ESP",
            "por",
            "Arabic",
            "Thai",
            "fr"
          ],
          "default": "CN"
        },
        "client_id": {
          "type": "string",
          "description": "clientId",
          "minLength": 0,
          "maxLength": 64
        },
        "is_pool_mode": {
          "type": "boolean",
          "description": "是否是资源池模式",
          "default": false
        },
        "job_finish_reason": {
          "type": "string",
          "description": "对话结束原因\n* NORMAL:正常结束\n* MUTE_TIMEOUT:静音超时",
          "enum": [
            "NORMAL",
            "MUTE_TIMEOUT"
          ]
        }
      },
      "description": "数字人智能交互对话任务信息。"
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 1,
          "maxLength": 32
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "SmartChatVideoConfig": {
      "properties": {
        "width": {
          "type": "integer",
          "example": 1920,
          "description": "视频宽度。\n\n单位:像素。\n\n最小值320,最大值2560。\n> * clip_mode=RESIZE时,当前支持1920x1080、1080x1920、1280x720、720x1280、3840x2160、2160x3840六种分辨率。4K分辨率视频需要分身数字人模型支持4K的情况下才能使用。\n> * clip_mode=CROP,裁剪后视频,(dx,dy)为原点,保留视频像宽度为width。\n> * 分身数字人直播目前只支持1080x1920。",
          "minimum": 0,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "example": 1080,
          "description": "视频高度。\n\n单位:像素。\n\n最小值320,最大值2560。\n> * clip_mode=RESIZE时,当前支持1920x1080、1080x1920、1280x720、720x1280、3840x2160、2160x3840六种分辨率分辨率。\n> * clip_mode=CROP,裁剪后视频,(dx,dy)为原点,保留视频像高度为height。\n> * 分身数字人直播目前只支持1080x1920。",
          "minimum": 0,
          "maximum": 3840
        }
      }
    },
    "SmartChatSubtitleConfig": {
      "properties": {
        "dx": {
          "type": "integer",
          "format": "int32",
          "example": 256,
          "description": "字幕左上角像素点坐标。\n\n> *横屏(16:9)视频像素为1920x1080;竖屏(9:16)视频像素为1080x1920。",
          "minimum": 0,
          "maximum": 1920
        },
        "dy": {
          "type": "integer",
          "format": "int32",
          "example": 256,
          "description": "字幕左上角像素点坐标。\n\n> *横屏(16:9)视频像素为1920x1080;竖屏(9:16)视频像素为1080x1920。",
          "minimum": 0,
          "maximum": 1920
        },
        "width": {
          "type": "integer",
          "format": "int32",
          "example": 256,
          "description": "图层图片宽度像素值(相对画布大小)。\n> 横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。",
          "minimum": 1,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "format": "int32",
          "example": 256,
          "description": "图层图片高度像素值(相对画布大小)。\n> 横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。",
          "minimum": 1,
          "maximum": 7680
        }
      },
      "description": "字幕配置。"
    },
    "ListSmartChatJobsInfo": {
      "type": "object",
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "数字人智能交互对话任务总数。",
          "minimum": 0,
          "maximum": 2147483647
        },
        "smart_chat_jobs": {
          "type": "array",
          "description": "数字人智能交互对话任务列表。",
          "items": {
            "$ref": "#/definitions/SmartChatJobBaseInfo"
          },
          "maxItems": 100,
          "minItems": 1
        }
      },
      "description": "数字人智能交互对话任务查询列表。"
    },
    "SmartChatVoiceConfig": {
      "properties": {
        "voice_asset_id": {
          "type": "string",
          "description": "语音合成特征字符串",
          "minLength": 1,
          "maxLength": 64
        },
        "speed": {
          "type": "integer",
          "format": "int32",
          "description": "语速。默认值100,最小值50,最大值200。\n> 当取值为“100”时,表示一个成年人正常的语速,约为250字/分钟。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "pitch": {
          "type": "integer",
          "format": "int32",
          "description": "音高。默认值100,最小值50,最大值200。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "volume": {
          "type": "integer",
          "format": "int32",
          "description": "音量。默认值140,最小值90,最大值240。",
          "minimum": 90,
          "maximum": 240,
          "default": 140
        },
        "provider": {
          "type": "string",
          "description": "第三方TTS供应商类型。\n* XIMALAYA:喜马拉雅TTS\n* HUAWEI_EI:EI TTS\n* MOBVOI:出门问问TTS",
          "minLength": 0,
          "maxLength": 32
        },
        "language": {
          "type": "string",
          "description": "语言类型。默认值CN。\n* CN:中文。\n* EN:英文。\n* ESP:西班牙语(仅海外站点支持)\n* por:葡萄牙语(仅海外站点支持)\n* Arabic:阿拉伯语(仅海外站点支持)\n* Thai:泰语(仅海外站点支持)\n* fr:法语(仅海外站点支持)",
          "enum": [
            "CN",
            "EN",
            "ESP",
            "por",
            "Arabic",
            "Thai",
            "fr"
          ],
          "default": "CN"
        },
        "language_desc": {
          "type": "string",
          "description": "语言描述。",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "description": "语音配置参数"
    }
  },
  "version": "2.0",
  "parameters": {
