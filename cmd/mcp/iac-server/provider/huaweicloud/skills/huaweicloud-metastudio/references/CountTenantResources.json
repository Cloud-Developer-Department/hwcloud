          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader"
          },
          {
            "name": "business",
            "in": "query",
            "description": "业务类型。可填多个用\",\"分隔\n* VOICE_CLONE:声音制作\n* SYNTHETICS_SOUND:声音合成\n* ASSET_MANAGER:资产管理\n* MODELING_2D:形象制作\n* LIVE_2D:分身数字人视频直播\n* VIDEO_2D:分身数字人视频制作\n* CHAT_2D:分身数字人智能交互\n* BUSINESS_CARD_2D:分身数字人名片\n* PICTURE_2D:照片数字人视频\n* MODELING_3D:3D照片建模\n* VDS_3D:3D视觉驱动\n* TTSA_3D:3D语音驱动\n* FLEXUS_2D:FLEXUS版本资源",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "x-apig-registered": false
          },
          {
            "name": "resource_expire_start_time",
            "in": "query",
            "description": "资源过期时间段 开始时间。格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"",
            "required": false,
            "type": "string",
            "maxLength": 20,
            "minLength": 0,
            "x-apig-registered": false
          },
          {
            "name": "resource_expire_end_time",
