          "maxLength": 64,
          "enum": [
            "INSERT_PLAY_SCRIPT",
            "INSERT_PLAY_AUDIO",
            "REWRITE_INTERACTION_RULES"
          ]
        },
        "params": {
          "type": "object",
          "description": "命令参数。",
          "properties": {}
        },
        "source": {
          "type": "string",
          "description": "命令来源。\n* EXTERNAL: 外部命令\n* AUTO: 系统自动触发",
          "minLength": 0,
          "maxLength": 32,
          "enum": [
            "EXTERNAL",
            "AUTO"
          ]
        }
      },
      "description": "插入播放命令列表"
    },
