{
  "name": "ShowUsageData",
  "summary": "查询用户数据详情",
  "tags": "数据分析管理",
  "productshort": "MetaStudio",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/data-analysis": {
      "get": {
        "tags": [
          "DataAnalysis"
        ],
        "summary": "查询用户数据详情",
        "description": "获取周期内用户的资源使用情况",
        "operationId": "ShowUsageData",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量。",
            "required": false,
            "type": "integer",
            "default": 10,
            "maximum": 1000,
            "minimum": 1,
            "format": "uint32",
            "x-apig-registered": false,
            "x-example": 10
          },
          {
            "$ref": "#/parameters/OffsetQuery"
          },
          {
            "$ref": "#/parameters/X-App-UserId"
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "查询时间段开始时间,格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"",
            "required": true,
            "type": "string",
            "maxLength": 30,
            "minLength": 20,
            "x-apig-registered": false,
            "x-example": "2021-01-10T08:43:17Z"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "查询时间段结束时间,格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"",
            "required": true,
            "type": "string",
            "maxLength": 30,
            "minLength": 20,
            "x-apig-registered": false,
            "x-example": "2021-01-10T08:43:17Z"
          },
          {
            "name": "user_id",
            "in": "query",
            "description": "用户id(仅开启了子账号隔离功能的主账号携带才生效)",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 0,
            "x-apig-registered": false,
            "x-example": "dd899XXXXXXXXXXXXXX4aeae43"
          },
          {
            "name": "resource_type",
            "in": "query",
            "description": "资源类型\n* video_time_2d_model:分身数字人视频制作\n* video_time_flexus_2d_model:分身数字人视频制作flexus版",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "x-apig-registered": false,
            "x-example": "video_time_flexus_2d_model"
          },
          {
            "name": "business_type",
            "in": "query",
            "description": "业务类型\n* LIVE_2D:分身数字人视频直播\n* VIDEO_2D:分身数字人视频制作",
            "required": false,
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "x-apig-registered": false,
            "x-example": "VIDEO_2D"
          },
          {
            "name": "unit",
            "in": "query",
            "description": "使用量的单位。\n* MIN:分钟\n* HOUR:小时",
            "required": false,
            "type": "string",
            "enum": [
              "MIN",
              "HOUR"
            ],
            "x-apig-registered": false,
            "x-example": "MIN"
          }
        ],
        "responses": {
          "200": {
            "description": "创建数据分析接口响应",
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求ID。"
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowUsageDataRsp"
            }
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          },
          "401": {
            "$ref": "#/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/responses/Forbidden"
          },
          "500": {
            "$ref": "#/responses/InternalServiceError"
          }
        },
        "x-apiexplorer-hide": "N",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "x-apig-group": "public-iam,internal-appcode",
        "x-open-range": "public",
        "x-request-examples-url-1": "GET https://{endpoint}/v1//{project_id}/data-analysis"
      }
    }
  },
  "definitions": {
    "ShowUsageDataRsp": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "资源总数。",
          "minimum": 0,
          "maximum": 2147483647
        },
        "time_list": {
          "type": "array",
          "description": "资源用量列表",
          "items": {
            "$ref": "#/definitions/TimeResourceUsageInfo"
          },
          "maxItems": 100,
          "minItems": 0
        }
      }
    },
    "ResourceUsageInfo": {
      "type": "object",
      "properties": {
        "resource_type": {
          "type": "string",
          "description": "资源类型。详见[资源类型](metastudio_02_0042.xml)。",
          "minLength": 1,
          "maxLength": 64
        },
        "business_type": {
          "type": "string",
          "description": "业务类型。\n* VOICE_CLONE:声音制作\n* SYNTHETICS_SOUND:声音合成\n* ASSET_MANAGER:资产管理\n* MODELING_2D:形象制作\n* LIVE_2D:分身数字人视频直播\n* VIDEO_2D:分身数字人视频制作\n* CHAT_2D:分身数字人智能交互\n* BUSINESS_CARD_2D:分身数字人名片\n* PICTURE_2D:照片数字人视频\n* MODELING_3D:3D照片建模\n* VDS_3D:3D视觉驱动\n* TTSA_3D:3D语音驱动\n* FLEXUS_2D:FLEXUS版本资源",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "VOICE_CLONE",
            "SYNTHETICS_SOUND",
            "ASSET_MANAGER",
            "MODELING_2D",
            "LIVE_2D",
            "VIDEO_2D",
            "CHAT_2D",
            "BUSINESS_CARD_2D",
            "PICTURE_2D",
            "MODELING_3D",
            "VDS_3D",
            "TTSA_3D",
            "FLEXUS_2D"
          ]
        },
        "sub_resource_type": {
          "type": "string",
          "description": "子资源类型。当前只有flexus套餐包存在该字段\n* voice_clone_flexus: 语音克隆Flexus版\n* modeling_count_2d_model_flexus: 分身数字人形象制作Flexus版\n* video_time_flexus_2d_model: 分身数字人Flexus版本视频制作",
          "minLength": 1,
          "maxLength": 64
        },
        "is_sub_resource": {
          "type": "boolean",
          "description": "是否子资源。子资源描述的是子资源的数量和单位",
          "default": false
        },
        "charging_mode": {
          "type": "string",
          "description": "计费类型。\n* PERIODIC: 包周期\n* ONE_TIME:一次性\n* ON_DEMAND:按需",
          "minLength": 1,
          "maxLength": 128,
          "enum": [
            "PERIODIC",
            "ONE_TIME",
            "ON_DEMAND"
          ]
        },
        "resource_source": {
          "type": "string",
          "format": "int64",
          "example": "ADMIN_ALLOCATED",
          "description": "资源来源。\n* PURCHASED: 购买\n* SP_ALLOCATED:SP分配\n* ADMIN_ALLOCATED:系统管理员分配",
          "minLength": 1,
          "maxLength": 64
        },
        "amount": {
          "type": "number",
          "format": "float",
          "description": "总量",
          "minimum": 0,
          "maximum": 1000000
        },
        "usage": {
          "type": "number",
          "format": "float",
          "description": "使用量",
          "minimum": 0,
          "maximum": 1000000
        },
        "unit": {
          "type": "string",
          "description": "单位。\n* NUM:个数(形象/声音)\n* MIN:分钟(视频制作)\n* HOUR:小时 (直播)\n* CHANNEL:路(直播/交互)\n* GB:GB(资产管理)\n* MILLION_WORDS:百万字\n* TEN_THOUSAND_WORDS:万字\n* TIME:次",
          "enum": [
            "NUM",
            "MIN",
            "HOUR",
            "CHANNEL",
            "GB",
            "MILLION_WORDS",
            "TEN_THOUSAND_WORDS",
            "TIME"
          ]
        }
      },
      "description": "资源使用信息"
    },
    "TimeResourceUsageInfo": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "example": "2021-01-10T08:43:17Z",
          "description": "查询时间段开始时间,格式遵循:RFC 3339 如\"2021-01-10T08:43:17Z\"",
          "minLength": 20,
          "maxLength": 20
        },
        "resources_usage": {
          "type": "array",
          "description": "资源用量列表",
          "items": {
            "$ref": "#/definitions/ResourceUsageInfo"
          },
          "maxItems": 100,
          "minItems": 0
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
