    "Project-IdPath": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参考[获取项目ID](metastudio_02_0006.xml)。",
      "required": true,
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 64)"
      ],
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    },
    "X-App-UserId": {
      "name": "X-App-UserId",
      "in": "header",
      "description": "第三方用户ID。不允许输入中文。",
      "required": false,
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
