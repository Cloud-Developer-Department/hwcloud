  "paths": {
    "/v1/{project_id}/digital-assets/summarys": {
      "post": {
        "tags": [
          "DigitalAssetContentManager"
        ],
        "summary": "查询资产概要",
        "description": "该接口用于查询媒体资产库中指定的多个资产的概要信息。",
        "operationId": "ListAssetSummary",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-App-UserId"
          },
          {
            "in": "body",
            "name": "ListAssetSummaryRequestBody",
            "description": "资产概要查询。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ListAssetSummarysReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
