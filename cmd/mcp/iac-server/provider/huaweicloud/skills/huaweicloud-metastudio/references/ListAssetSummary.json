                  {
                    "asset_id": "93769b5a-c8c6-4692-9c95-53933a1f0c93",
                    "asset_name": "男教师",
                    "asset_type": "HUMAN_MODEL_2D",
                    "cover_url": "https://{endpoint}:443/05a8ae5925000fb72f83c0091083231a/ca40212e1cdb64ab5f74446bcddb8eb9/model/image/6dd0c018-7b8e-46aa-8a45-3075c161c500.png?AccessKeyId=F8DE4LGO7EOYY0CM9ERJ&Expires=1657527524&Signature=BWgSQpc4lMFFrtj2ae67fw679%2Bc%3D"
                  }
                ]
              }
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求ID。"
              }
            },
            "schema": {
              "$ref": "#/definitions/ListAssetSummarysRsp"
            }
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-apig-group": "public-iam,internal-appcode",
        "x-open-range": "public",
        "x-imports": "com.huawei.springframework.advice.HttpStatusController;com.huawei.springframework.om.trace.masker.annotation.ResponseMaskRule;com.huawei.springframework.om.trace.masker.annotation.Rule;com.huawei.springframework.om.trace.masker.base.PasswordMasker",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/6a6a1f8354f64dd9b9a614def7b59d83/digital-assets/summarys",
        "x-request-examples-1": {
          "asset_ids": [
            "8cb2f48a2cb006154794741933421100",
            "e2ba8314ebaab34d368711d118fcecba"
          ]
        },
