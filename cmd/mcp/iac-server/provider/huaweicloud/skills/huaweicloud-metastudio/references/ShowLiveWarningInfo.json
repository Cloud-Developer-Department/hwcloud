  "definitions": {
    "SmartLiveRoomWarningInfos": {
      "properties": {
        "live_warning_info": {
          "type": "array",
          "description": "开播风险告警列表。",
          "items": {
            "$ref": "#/definitions/LiveWarningItem"
          },
          "maxItems": 100,
          "minItems": 1
        },
        "limit_duration": {
          "type": "integer",
          "description": "**参数解释**:\n配置的最大直播时长。单位小时。\n0 为不限制。\n**约束限制**:\n停止直播逻辑配置为立即停止则直播停止误差在5分钟之内。其他逻辑则加上处理时长。\n**默认取值**:\n不设置则表示不限时。",
          "minimum": 0,
          "maximum": 168
        }
      },
      "description": "直播间开播告警信息"
    },
    "LiveWarningItem": {
      "properties": {
        "warning_type": {
          "type": "string",
          "description": "告警类型。\n- TOO_LESSS_SCRIPT_ITEMS:段落(话术)数量太少。\n- TOO_SHORT_SCRIPT_TIME:段落(话术)总时长太短。\n- TOO_LESS_DANMAKU_RULES: 弹幕互动规则太少。\n- RANDOM_PLAY_CLOSED: 随机播放开关关闭。\n- ROTATION_MODEL_CLOSED: 主播轮转未配置。",
          "minLength": 0,
          "maxLength": 32,
          "enum": [
            "TOO_LESSS_SCRIPT_ITEMS",
            "TOO_SHORT_SCRIPT_TIME",
            "TOO_LESS_DANMAKU_RULES",
            "RANDOM_PLAY_CLOSED",
            "ROTATION_MODEL_CLOSED"
          ]
        }
      },
      "description": "开播风险警告"
    }
  },
