{
  "name": "CheckVoiceAsset",
  "summary": "校验音色模型是否可用(自研和第三方音色)",
  "tags": "语音合成管理",
  "productshort": "MetaStudio",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/ttsc/check-voice-asset/{voice_asset_id}": {
      "post": {
        "tags": [
          "Ttsc"
        ],
        "summary": "校验音色模型是否可用(自研和第三方音色)",
        "description": "该接口用于校验音色模型是否可用,模型可用返回模型信息,不可用返回具体不可用的原因",
        "operationId": "CheckVoiceAsset",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader-notgenerate"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader-notgenerate"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader-notgenerate"
          },
          {
            "$ref": "#/parameters/X-App-UserId-notgenerate"
          },
          {
            "name": "voice_asset_id",
            "in": "path",
            "description": "音色资产id",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功。",
            "schema": {
              "$ref": "#/definitions/TtscDigitalAssetInfo"
            }
          },
          "400": {
            "description": "参数异常",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "500": {
            "description": "服务端异常",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-apig-group": "public-iam,internal-appcode",
        "x-open-range": "public",
        "x-request-examples-url-1": "POST https://{endpoint}/v1/3f0924078d1b471c884a5383d4dec9fa/ttsc/preload/858153064daf186c36a07802dc859234"
      }
    }
  },
  "definitions": {
    "TtscMobvoiVoiceAssetMeta": {
      "required": [
        "speaker"
      ],
      "properties": {
        "speaker": {
          "type": "string",
          "example": "cissy_meet",
          "description": "合成音频指定发音人",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "description": "出门问问TTS音色元数据。"
    },
    "AbnormalResultDTO": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "业务返回码\n* MSS.000000001 - 失败\n* MSS.000000002 - 内部错误\n* MSS.000000003 - 非法参数\n* MSS.000000004 - 非法访问,未鉴权或者鉴权失败",
          "minLength": 1,
          "maxLength": 255
        },
        "error_msg": {
          "type": "string",
          "description": "返回描述",
          "minLength": 1,
          "maxLength": 255
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "description": "统一返回结果",
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.hdh.ttss.model.discard.*"
    },
    "TtscAudioxVoiceAssetMeta": {
      "required": [
        "speaker"
      ],
      "properties": {
        "speaker": {
          "type": "string",
          "example": "spk_10019",
          "description": "合成音频指定发音人",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "description": "逻辑智能TTS音色元数据。"
    },
    "TtscAssetFileInfo": {
      "type": "object",
      "properties": {
        "file_id": {
          "type": "string",
          "description": "文件ID。",
          "minLength": 1,
          "maxLength": 64
        },
        "file_name": {
          "type": "string",
          "example": "a.jpg",
          "description": "文件名创建文件时候不区分大小写,最大长度256,最小长度1。",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9-!$'(),.+=@_~/]{1,}[A-Za-z0-9-!$'(),.+=@_~]*$"
        },
        "file_md5": {
          "type": "string",
          "example": "38b8c2c1093dd0fec383a9d9ac940515",
          "description": "文件内容MD5值,固定24位。",
          "minLength": 24,
          "maxLength": 24
        },
        "file_size": {
          "type": "integer",
          "format": "int64",
          "example": 1024,
          "description": "文件总的大小,最小1,最大5368709120。",
          "minimum": 1,
          "maximum": 5368709120
        },
        "file_type": {
          "type": "string",
          "description": "文件类型(默认提取文件后缀)。",
          "minLength": 1,
          "maxLength": 64
        },
        "asset_file_category": {
          "type": "string",
          "example": "COVER",
          "description": "文件在资产中的分类。每种资产类型包含的文件分类不同。\n* MAIN:主文件\n* COVER:封面文件\n* PAGE:内容页图片\n* SAMPLE:样例音频\n* OTHER:其他文件\n* WHOLE_MODEL:全模型\n* USER_MODIFIED_MODEL:用户上传模型\n> * 资产类型为SCENE、ANIMATION、VIDEO、IMAGE、MATERIAL时,包含MAIN、COVER和OTHER\n> * 资产类型为PPT时,包含MAIN、COVER、PAGE和OTHER\n> * 资产类型为HUMAN_MODEL时,包含MAIN、COVER和OTHER\n> * 资产类型为VOICE_MODEL时,包含MAIN、SAMPLE(样例音频文件)和OTHER\n> * 资产类型为HUMAN_MODEL_2D时,包含MAIN、COVER、SAMPLE(动作样例)和OTHER(遮罩文件)\n> * 资产类型为BUSINESS_CARD_TEMPLET时,包含MAIN和COVER(名片效果图)",
          "minLength": 1,
          "maxLength": 128
        },
        "download_url": {
          "type": "string",
          "description": "文件下载URL,有效期为24小时。",
          "minLength": 0,
          "maxLength": 2048
        },
        "state": {
          "type": "string",
          "description": "文件状态枚举:\n* CREATING:文件上传中\n* CREATED:文件已上传(自动审核通过)\n* FAILED:文件上传失败\n* CANCELLED:文件上传已取消\n* DELETING:文件删除中\n* DELETED:文件已删除\n* UPLOADED:文件已上传(尚未审核)\n* REVIEW:人工审核(文件已上传)",
          "minLength": 0,
          "maxLength": 32
        },
        "reason": {
          "type": "string",
          "description": "审核失败原因",
          "minLength": 0,
          "maxLength": 256
        }
      },
      "description": "文件信息。"
    },
    "TtscDigitalAssetInfo": {
      "properties": {
        "asset_id": {
          "type": "string",
          "description": "资产ID。",
          "minLength": 1,
          "maxLength": 256
        },
        "asset_name": {
          "type": "string",
          "example": "云笙",
          "description": "资产名称。",
          "minLength": 0,
          "maxLength": 256
        },
        "asset_type": {
          "type": "string",
          "example": "VOICE_MODEL",
          "description": "资产类型。\n\n公共资产类型:\n* VOICE_MODEL:音色模型",
          "minLength": 0,
          "maxLength": 32
        },
        "asset_state": {
          "type": "string",
          "example": "ACTIVED",
          "description": "资产状态。\n* CREATING:资产创建中,主文件尚未上传\n* FAILED:主文件上传失败\n* UNACTIVED:主文件上传成功,资产未激活,资产不可用于其他业务(用户可更新状态)\n* ACTIVED:主文件上传成功,资产激活,资产可用于其他业务(用户可更新状态)\n* DELETING:资产删除中,资产不可用,资产可恢复\n* DELETED:资产文件已删除,资产不可用,资产不可恢复\n* BLOCK: 资产被冻结,资产不可用,不可查看文件。",
          "minLength": 0,
          "maxLength": 32
        },
        "create_time": {
          "type": "string",
          "description": "资产创建时间。",
          "minLength": 20,
          "maxLength": 20
        },
        "update_time": {
          "type": "string",
          "description": "资产更新时间。",
          "minLength": 20,
          "maxLength": 20
        },
        "asset_extra_meta": {
          "$ref": "#/definitions/TtscAssetExtraMeta"
        },
        "files": {
          "type": "array",
          "description": "资产下的文件。",
          "items": {
            "$ref": "#/definitions/TtscAssetFileInfo"
          },
          "maxItems": 100,
          "minItems": 0
        }
      },
      "description": "资产信息。"
    },
    "TtscExternalVoiceAssetMeta": {
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "example": "XIMALAYA",
          "description": "第三方TTS供应商类型。\n* XIMALAYA:喜马拉雅TTS\n* HUAWEI_EI:EI TTS\n* MOBVOI:出门问问TTS",
          "minLength": 0,
          "maxLength": 32
        },
        "mobvoi_voice_meta": {
          "$ref": "#/definitions/TtscMobvoiVoiceAssetMeta"
        },
        "audiox_voice_meta": {
          "$ref": "#/definitions/TtscAudioxVoiceAssetMeta"
        }
      },
      "description": "第三方TTS音色元数据。"
    },
    "TtscVoiceModelAssetMeta": {
      "properties": {
        "sex": {
          "type": "string",
          "example": "MALE",
          "description": "音色性别。\n* UNKNOW:中性音色\n* MALE:男性音色\n* FEMALE:女性音色\n\n默认UNKNOW。",
          "minLength": 1,
          "maxLength": 16,
          "default": "UNKNOW"
        },
        "external_voice_meta": {
          "$ref": "#/definitions/TtscExternalVoiceAssetMeta"
        },
        "language": {
          "type": "string",
          "description": "音色语言。\n* UNKNOW:未知\n* CN:中文\n* EN:英文\n* GER:德语\n* fr:法语\n* Kr:韩语\n* por:葡萄牙语\n* JPN:日语\n* Ita:意大利语\n* ESP:西班牙语\n* DBH:东北话\n* GT:港台\n* GXH:广西话\n* HBH:湖北话\n* SXH:陕西话\n* SCH:四川话\n* YY:粤语\n* Russian: 俄罗斯语\n* Filipino: 菲律宾语\n* Dutch: 荷兰语\n* Indonesian: 印尼语\n* Vietnamese: 越南语\n* Arabic: 阿拉伯语\n* Turkish: 土耳其语\n* Malay: 马来语\n* Thai: 泰语\n* Finnish: 芬兰语\n\n默认UNKNOW。",
          "minLength": 1,
          "maxLength": 16,
          "default": "UNKNOW"
        },
        "speed_ratio": {
          "type": "number",
          "format": "float",
          "description": "语速缩放比例",
          "minimum": 0,
          "maximum": 100,
          "default": 1.0
        },
        "volume_ratio": {
          "type": "number",
          "format": "float",
          "description": "音量缩放比例",
          "minimum": 0,
          "maximum": 100,
          "default": 1.0
        }
      },
      "description": "音色模型元数据。"
    },
    "TtscAssetExtraMeta": {
      "type": "object",
      "properties": {
        "voice_model_meta": {
          "$ref": "#/definitions/TtscVoiceModelAssetMeta"
        }
      },
      "description": "资产元数据。根据资产类型选择其中一个填写。"
    }
  },
  "version": "2.0",
  "parameters": {
