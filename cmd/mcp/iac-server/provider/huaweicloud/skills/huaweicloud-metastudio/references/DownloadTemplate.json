{
  "name": "DownloadTemplate",
  "summary": "下载信息导入模板",
  "tags": "导入导出管理",
  "productshort": "MetaStudio",
  "region_id": "cn-east-3",
  "paths": {
    "/v2/{project_id}/ies/import/{resource}/template": {
      "get": {
        "tags": [
          "BatchV2"
        ],
        "summary": "下载信息导入模板",
        "description": "下载导入模板,返回导入模板文件",
        "operationId": "DownloadTemplate",
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader"
          },
          {
            "name": "resource",
            "in": "path",
            "description": "资源名称",
            "required": true,
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]*$",
            "x-example": "knowledge-intent-question-create"
          }
        ],
        "responses": {
          "200": {
            "description": "导入的模板文件",
            "schema": {
              "type": "file"
            }
          },
          "400": {
            "description": "客户端传参异常,包含错误码及对应描述",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-open-range": "public",
        "x-apig-group": "public-iam",
        "x-imports": "com.huawei.springframework.advice.HttpStatusController;com.huawei.springframework.security.auth.annotation.TokenAuthorization;org.springframework.http.ResponseEntity;com.huawei.usg.oms.model.kafka.constants.oplog.*;com.huawei.usg.oms.model.kafka.annotation.*;org.springframework.http.HttpStatus;jakarta.servlet.http.HttpServletRequest;",
        "x-requestHandler": true,
        "x-classAnnotation": [
          "@HttpStatusController"
        ],
        "x-returnType": "ResponseEntity<?>"
      }
    }
  },
  "definitions": {
    "AbnormalResultDTO": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "业务返回码\n* MSS.000000001 - 失败\n* MSS.000000002 - 内部错误\n* MSS.000000003 - 非法参数\n* MSS.000000004 - 非法访问,未鉴权或者鉴权失败",
          "minLength": 1,
          "maxLength": 255
        },
        "error_msg": {
          "type": "string",
          "description": "返回描述",
          "minLength": 1,
          "maxLength": 255
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "description": "统一返回结果",
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.hdh.ttss.model.discard.*"
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Sdk-DateHeader": {
      "name": "X-Sdk-Date",
