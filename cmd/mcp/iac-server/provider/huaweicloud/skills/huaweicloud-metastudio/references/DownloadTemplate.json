      "required": false,
      "type": "string",
      "maxLength": 16,
      "minLength": 16,
      "x-annotations": [
        "@Size(min = 16, max = 16)"
      ],
      "x-example": "20191115T033655Z",
      "x-apig-registered": false
    },
    "X-Project-IdHeader": {
      "name": "X-Project-Id",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带项目ID信息。",
      "required": false,
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 64)"
      ],
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx",
      "x-apig-registered": false
    },
    "AuthorizationHeader": {
      "name": "Authorization",
      "in": "header",
      "description": "使用AK/SK方式认证时必选,携带的鉴权信息。",
      "required": false,
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 256)"
      ],
      "x-example": "SDK-HMAC-SHA256 Access=xxx, SignedHeaders=content-type;host;x-sdk-date, Signature=xxx",
      "x-apig-registered": false
    },
    "X-Auth-TokenHeader": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "用户Token。使用Token鉴权方式时必选。\n\n通过调用IAM服务获取用户Token接口获取。\n\n响应消息头中X-Subject-Token的值。",
      "required": false,
      "type": "string",
      "maxLength": 16384,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 16384)"
      ],
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX...",
      "x-apig-registered": false
    },
    "Project-IdPath": {
      "name": "project_id",
      "in": "path",
