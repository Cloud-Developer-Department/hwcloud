      "required": true,
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 64)"
      ],
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    }
  },
  "host": "metastudio.cn-east-3.myhuaweicloud.com",
  "base_path": null,
