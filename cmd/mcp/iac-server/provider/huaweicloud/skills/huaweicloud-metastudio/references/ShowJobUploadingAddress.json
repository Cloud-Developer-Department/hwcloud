{
  "name": "ShowJobUploadingAddress",
  "summary": "获取语音文件上传地址",
  "tags": "声音制作任务管理",
  "productshort": "MetaStudio",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/voice-training-manage/user/jobs/{job_id}/uploading-address-url": {
      "get": {
        "tags": [
          "TrainingJobManager"
        ],
        "summary": "获取语音文件上传地址",
        "description": "获取语音文件上传地址",
        "operationId": "ShowJobUploadingAddress",
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "name": "job_id",
            "in": "path",
            "description": "任务id。",
            "required": true,
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功返回。",
            "examples": {
              "application/json": {
                "segment_url": {
                  "audio_uploading_url": [
                    "https://my-bucket/data0.wav"
                  ],
                  "txt_uploading_url": [
                    "https://my-bucket/data0.txt"
                  ]
                },
                "package_url": {
                  "training_data_uploading_url": "https://my-bucket/data.zip"
                },
                "authorization_letter_uploading_url": "https://my-bucket/data"
              }
            },
            "schema": {
              "$ref": "#/definitions/ShowJobUploadingAddressRsp"
            }
          },
          "400": {
            "description": "训练异常",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-apig-group": "public-iam,internal-appcode",
        "x-open-range": "public",
        "x-methodAnnotations": [
          "@ResponseMaskRule",
          "@AppUserAuth"
        ],
        "x-request-examples-url-1": "GET https://{endpoint}/v1/3f0924078d1b471c884a5383d4dec9fa/voice-training-manage/user/jobs/26f06524-4f75-4b3a-a853-b649a21aaf66/uploading-address-url"
      }
    }
  },
  "definitions": {
    "ShowJobUploadingAddressRsp": {
      "properties": {
        "segment_url": {
          "type": "object",
          "description": "分句上传任务的上传地址。",
          "properties": {
            "audio_uploading_url": {
              "type": "array",
              "description": "音频上传的地址。\n> * 通过该obs地址上传时需要设置content-type为audio/wav",
              "items": {
                "type": "string",
                "example": "https://my-bucket/data0.wav",
                "minLength": 1,
                "maxLength": 4096
              },
              "maxItems": 4096,
              "minItems": 1
            },
            "txt_uploading_url": {
              "type": "array",
              "description": "文本上传的地址。\n> * 通过该obs地址上传时需要设置content-type为text/plain",
              "items": {
                "type": "string",
                "example": "https://my-bucket/data0.txt",
                "minLength": 1,
                "maxLength": 4096
              },
              "maxItems": 4096,
              "minItems": 1
            }
          }
        },
        "package_url": {
          "type": "object",
          "description": "整包上传任务的url。",
          "properties": {
            "training_data_uploading_url": {
              "type": "string",
              "example": "https://my-bucket/data.zip",
              "description": "上传的训练数据地址,用户需要将训练数据打成zip包后上传到该url。\n> * 通过该obs地址上传时需要设置content-type为application/zip",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "authorization_letter_uploading_url": {
          "type": "string",
          "example": "https://my-bucket/data",
          "description": "授权书的上传地址。",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "description": "获取下载连接"
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码。",
          "minLength": 1,
          "maxLength": 32
        },
        "error_msg": {
          "type": "string",
          "description": "错误描述。",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "Project-IdPath": {
      "name": "project_id",
      "in": "path",
      "description": "项目ID,获取方法请参考[获取项目ID](metastudio_02_0006.xml)。",
      "required": true,
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "x-annotations": [
        "@Size(min = 1, max = 64)"
      ],
      "x-example": "70b76xxxxxx34253880af501cdxxxxxx"
    }
  },
  "host": "metastudio.cn-north-4.myhuaweicloud.com",
  "base_path": null,
  "info_version": "v1",
  "method": "get",
  "uri": null
}