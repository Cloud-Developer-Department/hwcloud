{
  "name": "CreateAsyncTtsJob",
  "summary": "创建TTS异步任务",
  "tags": "语音合成异步任务管理",
  "productshort": "MetaStudio",
  "region_id": "cn-north-4",
  "paths": {
    "/v1/{project_id}/ttsc/async-jobs": {
      "post": {
        "tags": [
          "TtscAsync"
        ],
        "summary": "创建TTS异步任务",
        "description": "该接口用于对外生成音频文件。每个预置音色的计费标准详见[预置音色计费标准](metastudio_02_0060.xml)。\n\n> 使用本接口前,需要在MetaStudio控制台服务概览页面,开通“声音合成”的按需计费。\n> 详细操作为:单击“声音合成”卡片中的“去开通”,在弹出的“开通按需计费服务提示”对话框中,勾选同意协议。单击“确定”,开通按需计费。\n> 如需使用第三方声音进行语音合成,请购买出门问问声音套餐,操作请参考《用户指南》的“购买出门问问声音套餐”章节。",
        "operationId": "CreateAsyncTtsJob",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader-notgenerate"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader-notgenerate"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader-notgenerate"
          },
          {
            "$ref": "#/parameters/X-App-UserId-notgenerate"
          },
          {
            "in": "body",
            "name": "CreateAsyncTtsJobRequestBody",
            "description": "创建文本转音频文件请求。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateAsyncTtsJobRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "处理成功。",
            "examples": {
              "application/json": {
                "job_id": "26f06524-4f75-4b3a-a853-b649a21aaf66"
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateTtsAuditionResponseBody"
            }
          },
          "400": {
            "description": "参数异常",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          },
          "500": {
            "description": "服务端异常",
            "schema": {
              "$ref": "#/definitions/AbnormalResultDTO"
            }
          }
        },
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-apig-group": "public-iam,internal-appcode",
        "x-open-range": "public",
        "x-imports": "com.huawei.springframework.advice.HttpStatusController;org.springframework.http.ResponseEntity;com.huawei.springframework.om.trace.masker.annotation.RequestMaskRule;com.huawei.springframework.om.trace.masker.annotation.ResponseMaskRule;com.huawei.springframework.om.trace.masker.annotation.Rule;com.huawei.springframework.om.trace.masker.annotation.Type;com.huawei.springframework.om.trace.masker.base.OneThirdMasker;",
        "x-classAnnotation": "@HttpStatusController",
        "x-methodAnnotations": [
          "@RequestMaskRule(type = Type.JSON,rules = {@Rule(path = \"$.text\",masker = OneThirdMasker.class)})"
        ],
        "x-request-examples-1": {
          "text": "大家好,我是小花",
          "voice_asset_id": "c84054e7f29543048d585f61248c64c9"
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v1/3f0924078d1b471c884a5383d4dec9fa/ttsc/async-jobs"
      }
    }
  },
  "definitions": {
    "TtsCallBackConfig": {
      "required": [
        "callback_url"
      ],
      "properties": {
        "callback_url": {
          "type": "string",
          "description": "回调URL。\n回调请求body为json格式,带参数如下:\nstatus: FINISHED或ERROR或者WAITING\njob_id: 任务id\naudio_file_download_url: 音频文件路径\nsubtitle_file_download_url: 字幕文件路径\naudio_duration: 音频时长(秒)",
          "minLength": 0,
          "maxLength": 2048
        }
      }
    },
    "CreateTtsAuditionResponseBody": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID。",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "AbnormalResultDTO": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "description": "业务返回码\n* MSS.000000001 - 失败\n* MSS.000000002 - 内部错误\n* MSS.000000003 - 非法参数\n* MSS.000000004 - 非法访问,未鉴权或者鉴权失败",
          "minLength": 1,
          "maxLength": 255
        },
        "error_msg": {
          "type": "string",
          "description": "返回描述",
          "minLength": 1,
          "maxLength": 255
        },
        "request_id": {
          "type": "string",
          "description": "请求唯一标识",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "description": "统一返回结果",
      "x-subPackage": "discard",
      "x-ref-external": "com.huawei.hdh.ttss.model.discard.*"
    },
    "CreateAsyncTtsJobRequestBody": {
      "required": [
        "text",
        "voice_asset_id"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "待合成文本",
          "minLength": 0,
          "maxLength": 100000,
          "x-annotations": "@TextLength"
        },
        "tts_text": {
          "type": "string",
          "description": "发送给tts的待合成文本",
          "minLength": 0,
          "maxLength": 100000
        },
        "voice_asset_id": {
          "type": "string",
          "description": "音色ID,获取方式详见[获取音色ID](metastudio_02_0054.xml)。\n\n不同Region的计费标准详见[预置音色计费标准](metastudio_02_0060.xml)。",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9-_]+$"
        },
        "speed": {
          "type": "integer",
          "format": "int32",
          "description": "语速。\n* 当取值为“100”时,表示一个成年人正常的语速,约为250字/分钟。\n* 50表示0.5倍语速,100表示正常语速,200表示2倍语速。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "pitch": {
          "type": "integer",
          "format": "int32",
          "description": "音高。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "volume": {
          "type": "integer",
          "format": "int32",
          "example": 100,
          "description": "音量。",
          "minimum": 90,
          "maximum": 240,
          "default": 140
        },
        "audio_format": {
          "type": "string",
          "description": "输出音频文件格式。默认WAV。\n* WAV:wav格式。\n* MP3:mp3格式。",
          "enum": [
            "WAV",
            "MP3"
          ],
          "default": "WAV"
        },
        "need_timestamp": {
          "type": "boolean",
          "description": "是否需要时间戳。false为不需要,true为需要返回时间戳信息。默认值为false。",
          "default": false
        },
        "silence_flag": {
          "type": "boolean",
          "description": "异常时是否返回静默音频流",
          "default": false
        },
        "silence_time_ms": {
          "type": "integer",
          "example": 1000,
          "description": "异常时返回的静默音频流时长,单位毫秒。",
          "minimum": 0,
          "maximum": 5000
        },
        "callback_config": {
          "description": "回调设置。",
          "$ref": "#/definitions/TtsCallBackConfig"
        },
        "gen_srt": {
          "type": "boolean",
          "description": "是否开启字幕"
        },
        "srt_len": {
          "type": "integer",
          "format": "int64",
          "example": 28,
          "description": "字幕最大长度限制",
          "minimum": 0,
          "maximum": 10000
        },
        "srt_line_limit": {
          "type": "integer",
          "format": "int32",
          "example": 10,
          "description": "字幕行数限制,默认为1",
          "minimum": 0,
          "maximum": 5000,
          "default": 1
        },
        "slice_segments": {
          "type": "boolean",
          "description": "是否对文本进行分段",
          "default": true
        },
        "channels": {
          "type": "integer",
          "format": "int32",
          "description": "声道。(单声道|双声道)\n默认值1,最小值1,最大值2。",
          "minimum": 1,
          "maximum": 2,
          "default": 1
        },
        "output_external_url": {
          "type": "string",
          "example": "https://{endpoint}/f40579bcc9f146f7aad308882a052295/415885a1f1f245389fe179a02f75d8a9?AccessKeyId=TO34W7XKB17XRAXO4ORG&Expires=1705545755&x-obs-security-token=gQpjbi1ub3J0aC00jMvnckIomHWumw8JQBkzk9yZgOH",
          "description": "音频文件上传的外部URL\n> * 需要先申请开通白名单, 才允许将音频等文件上传到外部URL。",
          "minLength": 1,
          "maxLength": 2048
        },
        "srt_output_external_url": {
          "type": "string",
          "example": "https://{endpoint}/f40579bcc9f146f7aad308882a052295/415885a1f1f245389fe179a02f75d8a9?AccessKeyId=TO34W7XKB17XRAXO4ORG&Expires=1705545755&x-obs-security-token=gQpjbi1ub3J0aC00jMvnckIomHWumw8JQBkzk9yZgOH",
          "description": "字幕文件上传的外部URL\n> * 需要先申请开通白名单, 才允许将字幕等文件上传到外部URL。",
          "minLength": 1,
          "maxLength": 2048
        },
        "action_output_external_url": {
          "type": "string",
          "example": "https://{endpoint}/f40579bcc9f146f7aad308882a052295/415885a1f1f245389fe179a02f75d8a9?AccessKeyId=TO34W7XKB17XRAXO4ORG&Expires=1705545755&x-obs-security-token=gQpjbi1ub3J0aC00jMvnckIomHWumw8JQBkzk9yZgOH",
          "description": "动作信息文件上传的外部URL\n> * 需要先申请开通白名单, 才允许将时间戳等文件上传到外部URL。",
          "minLength": 1,
          "maxLength": 2048
        },
        "is_vocabulary_config_enable": {
          "type": "boolean",
          "description": "是否应用当前租户的读法配置"
        },
        "is_concurrent_resource": {
          "type": "boolean",
          "description": "是否使用包周期路数资源进行计费"
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "example": 5,
          "description": "优先级(0-10),0为最高优先级,默认5",
          "minimum": 0,
          "maximum": 10,
          "default": 10
        }
      },
      "description": "文本转语音任务请求。",
      "x-imports": "com.huawei.mss.annotation4ttscs.TextLength;"
    }
  },
