{
  "name": "ListSmartChatRooms",
  "summary": "查询智能交互对话列表",
  "tags": "智能交互数字人对话管理",
  "productshort": "MetaStudio",
  "region_id": "cn-east-3",
  "paths": {
    "/v1/{project_id}/smart-chat-rooms": {
      "get": {
        "tags": [
          "SmartChatRoomManager"
        ],
        "summary": "查询智能交互对话列表",
        "description": "该接口用于智能交互对话列表。",
        "operationId": "ListSmartChatRooms",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/Project-IdPath"
          },
          {
            "$ref": "#/parameters/X-Auth-TokenHeader"
          },
          {
            "$ref": "#/parameters/AuthorizationHeader"
          },
          {
            "$ref": "#/parameters/X-Sdk-DateHeader"
          },
          {
            "$ref": "#/parameters/X-Project-IdHeader"
          },
          {
            "$ref": "#/parameters/X-App-UserId"
          },
          {
            "$ref": "#/parameters/OffsetQuery"
          },
          {
            "$ref": "#/parameters/LimitQuery"
          },
          {
            "name": "room_name",
            "in": "query",
            "description": "按智能交互对话名称模糊查询。",
            "required": false,
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          },
          {
            "$ref": "#/parameters/ModelNameQuery"
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "最近智能交互对话任务起始时间。格式遵循:RFC 3339 如“2021-01-10T08:43:17Z”。",
            "required": false,
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          {
            "$ref": "#/parameters/EndTimeQuery"
          }
        ],
        "deprecated": false,
        "responses": {
          "200": {
            "description": "成功。",
            "examples": {
              "application/json": {
                "count": 1,
                "smart_chat_rooms": [
                  {
                    "room_id": "26f06524-4f75-4b3a-a853-b649a21aaf66",
                    "room_name": "云笙展厅",
                    "room_description": "云笙",
                    "create_time": "2022-11-30T06:59:55Z",
                    "update_time": "2022-12-05T12:30:37Z"
                  }
                ]
              }
            },
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求ID。"
              }
            },
            "schema": {
              "$ref": "#/definitions/ListSmartChatRooms"
            }
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          },
          "401": {
            "$ref": "#/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/responses/InternalServiceError"
          }
        },
        "x-support-sdk": "Y",
        "x-php-exclude": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-api-type": "open-api",
        "x-apig-group": "public-iam,internal-appcode",
        "x-open-range": "public",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/70b76xxxxxx34253880af501cdxxxxxx/smart-chat-rooms",
        "x-order": 1
      }
    }
  },
  "definitions": {
    "ListSmartChatRooms": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n智能交互对话总数。",
          "minimum": 0,
          "maximum": 2147483647
        },
        "count_concurrency": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n智能交互对话总并发路数。",
          "minimum": 0,
          "maximum": 1024000
        },
        "count_client_nums": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n智能交互对话按接入端计费总路数。",
          "minimum": 0,
          "maximum": 1024000
        },
        "count_client_nums_token": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n智能交互对话按接入端计费(Token)总路数。",
          "minimum": 0,
          "maximum": 1024000
        },
        "smart_chat_rooms": {
          "type": "array",
          "description": "智能交互对话列表。",
          "items": {
            "$ref": "#/definitions/SmartChatRoomBaseInfo"
          },
          "maxItems": 100,
          "minItems": 1
        }
      }
    },
    "ModelInfo": {
      "properties": {
        "model_asset_id": {
          "type": "string",
          "example": "a5d295cdb345c11bd9f36bc22ced3a7a",
          "description": "模型资产ID,可以从资产库中查询。",
          "minLength": 0,
          "maxLength": 64
        },
        "asset_name": {
          "type": "string",
          "example": "小芸",
          "description": "资产名称",
          "minLength": 0,
          "maxLength": 256
        },
        "backup_model_asset_ids": {
          "type": "array",
          "description": "主播轮换时备选主播数字人资产ID(仅形象资产,不包含音色),可以从资产库中查询。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 32
          },
          "maxItems": 32,
          "minItems": 0
        }
      },
      "description": "模型信息"
    },
    "SmartChatRoomBaseInfo": {
      "properties": {
        "room_id": {
          "type": "string",
          "description": "智能交互对话ID",
          "minLength": 0,
          "maxLength": 64
        },
        "room_name": {
          "type": "string",
          "example": "云笙展厅",
          "description": "智能交互对话名称",
          "minLength": 1,
          "maxLength": 256
        },
        "room_description": {
          "type": "string",
          "example": "云笙",
          "description": "智能交互对话描述。",
          "minLength": 0,
          "maxLength": 1024
        },
        "robot_id": {
          "type": "string",
          "example": "e37a28485f684769aa537466e719629d",
          "description": "机器人ID。",
          "minLength": 1,
          "maxLength": 64
        },
        "cover_url": {
          "type": "string",
          "description": "对话封面图URL",
          "minLength": 0,
          "maxLength": 2048
        },
        "model_infos": {
          "description": "数字人模型信息",
          "$ref": "#/definitions/ModelInfo"
        },
        "voice_config": {
          "description": "语音配置参数。\n> *此参数将被废弃,请使用voice_config_list。",
          "$ref": "#/definitions/VoiceConfig"
        },
        "billing_mode": {
          "type": "string",
          "description": "计费模式,默认值CONCURRENCY\n* CONCURRENCY:并发计费\n* CLIENT:按接入端计费\n* CLIENT_TOKENS: 按接入端计费(TOKENS)",
          "enum": [
            "CONCURRENCY",
            "CLIENT",
            "CLIENT_TOKENS"
          ]
        },
        "reuse_resource": {
          "type": "boolean",
          "description": "是否允许使用未分配的并发数(端模式下不能复用),默认不使用。"
        },
        "concurrency": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n并发路数。",
          "minimum": 0,
          "maximum": 1024
        },
        "client_nums": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n允许接入终端端数量。",
          "minimum": 0,
          "maximum": 1024
        },
        "voice_config_list": {
          "type": "array",
          "description": "语音配置参数列表。",
          "items": {
            "$ref": "#/definitions/VoiceConfigRsp"
          },
          "maxItems": 100,
          "minItems": 1
        },
        "default_language": {
          "type": "string",
          "description": "默认语言,智能交互接口使用。默认值CN。\n* CN:简体中文。\n* EN:英语。\n* ESP:西班牙语(仅海外站点支持)\n* por:葡萄牙语(仅海外站点支持)\n* Arabic:阿拉伯语(仅海外站点支持)\n* Thai:泰语(仅海外站点支持)",
          "enum": [
            "CN",
            "EN",
            "ESP",
            "por",
            "Arabic",
            "Thai"
          ],
          "default": "CN"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间,格式遵循:RFC 3339 如“2021-01-10T08:43:17Z”。",
          "minLength": 20,
          "maxLength": 20
        },
        "update_time": {
          "type": "string",
          "description": "更新时间,格式遵循:RFC 3339 如“2021-01-10T08:43:17Z”。",
          "minLength": 20,
          "maxLength": 20
        },
        "exit_mute_threshold": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n静默退出时长。",
          "minimum": 0,
          "maximum": 1440
        }
      }
    },
    "VoiceConfigRsp": {
      "properties": {
        "voice_asset_id": {
          "type": "string",
          "description": "语音合成特征字符串",
          "minLength": 1,
          "maxLength": 64
        },
        "speed": {
          "type": "integer",
          "format": "int32",
          "description": "语速。默认值100,最小值50,最大值200。\n> 当取值为“100”时,表示一个成年人正常的语速,约为250字/分钟。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "pitch": {
          "type": "integer",
          "format": "int32",
          "description": "音高。默认值100,最小值50,最大值200。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "volume": {
          "type": "integer",
          "format": "int32",
          "description": "音量。默认值140,最小值90,最大值240。",
          "minimum": 90,
          "maximum": 240,
          "default": 140
        },
        "provider": {
          "type": "string",
          "description": "第三方TTS供应商类型。\n* XIMALAYA:喜马拉雅TTS\n* HUAWEI_EI:EI TTS\n* MOBVOI:出门问问TTS",
          "minLength": 0,
          "maxLength": 32
        },
        "language": {
          "type": "string",
          "description": "语言类型。默认值CN。\n* CN:简体中文。\n* EN:英语。\n* ESP:西班牙语(仅海外站点支持)\n* por:葡萄牙语(仅海外站点支持)\n* Arabic:阿拉伯语(仅海外站点支持)\n* Thai:泰语(仅海外站点支持)",
          "enum": [
            "CN",
            "EN",
            "ESP",
            "por",
            "Arabic",
            "Thai"
          ],
          "default": "CN"
        },
        "language_desc": {
          "type": "string",
          "description": "语言描述",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "description": "语音配置参数"
    },
    "VoiceConfig": {
      "required": [
        "voice_asset_id"
      ],
      "properties": {
        "voice_asset_id": {
          "type": "string",
          "example": "39b9cedccec1f19b33d8f7ce1a6d35b9",
          "description": "**参数解释**:\n音色资产ID,可以从资产库中查询。\n音色ID的查询操作,详见[查询预置音色ID](metastudio_02_0054.xml)。\n**约束限制**:\n不涉及。\n**取值范围**:\n字符长度1-256位。\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 64
        },
        "speed": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n语速。50表示0.5倍语速,100表示正常语速,200表示2倍语速。\n当取值为“100”时,表示一个成年人的正常语速,约为250字/分钟。\n\n**约束限制**:\n不涉及。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "pitch": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n音高。\n**约束限制**:\n不涉及。",
          "minimum": 50,
          "maximum": 200,
          "default": 100
        },
        "volume": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n音量。\n**约束限制**:\n不涉及。",
          "minimum": 90,
          "maximum": 240,
          "default": 140
        }
      },
      "description": "语音配置参数。"
    }
  },
