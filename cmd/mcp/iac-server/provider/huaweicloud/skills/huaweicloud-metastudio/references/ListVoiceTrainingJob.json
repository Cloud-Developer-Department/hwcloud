        },
        "suggestion": {
          "type": "string",
          "example": "通过",
          "description": "综合建议",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "description": "音频质量评估结果"
    },
    "AssessProperty": {
      "type": "object",
      "properties": {
        "expected": {
          "type": "string",
          "example": "100 ~ 200",
          "description": "预期信息",
          "minLength": 1,
          "maxLength": 2048
        },
        "actual": {
          "type": "string",
          "example": "133",
          "description": "实际信息",
          "minLength": 1,
          "maxLength": 2048
        },
        "suggestion": {
          "type": "string",
          "example": "符合要求",
          "description": "中文建议",
          "minLength": 1,
          "maxLength": 2048
