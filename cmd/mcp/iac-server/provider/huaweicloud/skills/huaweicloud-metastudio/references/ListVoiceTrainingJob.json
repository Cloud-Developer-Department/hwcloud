    "JobType": {
      "type": "string",
      "description": "训练类型。\n* BASIC: 基础版(20句话)\n* MIDDLE: 进阶版(100句话)\n* ADVANCE: 高级版\n* THIRD_PARTY: 第三方出门问问训练版\n* THIRD_PARTY_LJZN: 第三方逻辑智能训练版\n* FLEXUS: Flexus版---用的是大模型特征提取",
      "enum": [
        "BASIC",
        "MIDDLE",
        "ADVANCE",
        "THIRD_PARTY",
        "THIRD_PARTY_LJZN",
        "FLEXUS"
      ]
