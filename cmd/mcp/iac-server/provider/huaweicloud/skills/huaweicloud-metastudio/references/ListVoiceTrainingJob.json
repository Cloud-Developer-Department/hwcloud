          "maxItems": 2147483647,
          "minItems": 0
        }
      },
      "description": "任务列表查询结果。"
    },
    "JobState": {
      "type": "string",
      "description": "任务状态。\n* CREATING: 创建中\n* SYSTEM_AUDITING: 系统审核中\n* AUDITING: 人工审核中\n* WAITING_SPLIT: 等待切割\n* SPLITTING: 切割中\n* SPLIT_FAILED: 切割失败\n* ANNOTATING: 标注中\n* WAITING: 等待训练\n* PROCESSING: 任务训练中\n* RESULT_REVIEW: 审核结果\n* AUDIT_FAILED: 审核失败,等待用户重传数据\n* UPLOADING: 上传中\n* FAILED: 失败\n* SUCCEED: 成功",
      "example": "WAITING",
      "enum": [
        "CREATING",
        "SYSTEM_AUDITING",
        "AUDITING",
        "WAITING_SPLIT",
        "SPLITTING",
        "SPLIT_FAILED",
        "ANNOTATING",
        "WAITING",
        "PROCESSING",
        "RESULT_REVIEW",
        "AUDIT_FAILED",
        "USER_RESULT_REVIEW",
        "USER_REVIEW_REJECT",
        "UPLOADING",
        "FAILED",
        "SUCCEED"
      ]
