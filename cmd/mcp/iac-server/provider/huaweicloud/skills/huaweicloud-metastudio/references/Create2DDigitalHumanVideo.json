  "definitions": {
    "CallBackConfig": {
      "required": [
        "callback_url",
        "state"
      ],
      "properties": {
        "callback_url": {
          "type": "string",
          "description": "回调URL。\n\n回调请求body为json格式,带参数如下:\n\nresult: SUCCEED或FAILED\n\nasset_id: 资产ID\n\njob_id: 任务",
          "minLength": 0,
          "maxLength": 2048
        },
        "auth_type": {
          "type": "string",
          "description": "认证类型。\n* NONE。URL中自带认证。\n* MSS_A。HMACSHA256签名模式,在URL中追加参数:secret,time_stamp。取值方式:secret=hmac_sha256(key, URI(callback_url)+ time_stamp)&time_stamp=hex(timestamp)",
          "minLength": 0,
          "maxLength": 32,
          "enum": [
            "NONE",
            "MSS_A"
          ],
          "default": "NONE"
        },
        "key": {
          "type": "string",
          "description": "密钥Key",
          "minLength": 0,
          "maxLength": 32
        }
      }
    },
    "BackgroundConfigInfo": {
      "required": [
        "background_type"
      ],
      "properties": {
        "background_type": {
          "type": "string",
          "description": "**参数解释**:\n背景类型。\n**约束限制**:\n不涉及。\n**取值范围**:\n* IMAGE:图片背景,指定图片用作分身数字人背景。\n* COLOR:纯色背景,指定颜色RGB值作为分身数字人背景。\n\n**默认取值**:\n不涉及",
          "minLength": 1,
          "maxLength": 2048,
          "enum": [
            "IMAGE",
            "COLOR",
            "IMAGE_2D",
            "VIDEO",
            "AUDIO"
          ]
        },
        "background_config": {
          "type": "string",
          "example": "https://{endpoint}/0d697589d98091f12f92c0073501cd79/8cb2f48a2cb006154794741933421100/b2f8a9e9c39b6dc7ed4c0cfd67366c6a.jpg?AccessKeyId=XCQKTA8IWQPCAUQS4SDA&Expires=1671241324&Signature=tD38peKsCkh%2FygE3IffeLbewuEw%3D",
          "description": "**参数解释**:\n背景文件的URL。\n**约束限制**:\n* 仅直播支持外部URL,其他业务通过资产库查询获取,不支持外部URL。\n* background_type=IMAGE时需要填写。\n\n**取值范围**:\n字符长度1-2048位\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 2048
        },
        "background_color_config": {
          "type": "string",
          "description": "**参数解释**:\n纯色背景的RGB颜色值。\n**约束限制**:\nbackground_type=COLOR时需要填写。\n**取值范围**:\n字符长度0-16位",
          "minLength": 0,
          "maxLength": 16,
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": "#FFFFFF"
        },
        "background_asset_id": {
          "type": "string",
          "example": "a5d295cdb345c11bd9f36bc22ced3a7b",
          "description": "**参数解释**:\n背景资产ID。\n> 背景是背景图片时,填图片资产ID。\n\n**约束限制**:\n不涉及\n**取值范围**:\n字符长度0-64位\n**默认取值**:\n不涉及",
          "minLength": 0,
          "maxLength": 64
        },
        "background_image_config": {
          "$ref": "#/definitions/BackgroundImageConfig"
        }
      },
      "description": "背景配置。"
    },
    "BackgroundImageConfig": {
      "type": "object",
      "required": [
        "dx",
        "dy",
        "height",
        "width"
      ],
      "properties": {
        "dx": {
          "type": "integer",
          "format": "int32",
          "example": -256,
          "description": "**参数解释**:\n背景图片左上角像素点的X轴位置值(画布左上角坐标是0x0)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n需要保证背景图片要铺满画布。即dx <= 0,并且横屏时dx + width >=1920,竖屏时dx + width >=1080。",
          "minimum": -5760,
          "maximum": 0,
          "default": 0
        },
        "dy": {
          "type": "integer",
          "format": "int32",
          "example": -512,
          "description": "**参数解释**:\n背景图片左上角像素点的Y轴位置值(画布左上角坐标是0x0)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n 需要保证背景图片要铺满画布。即dy <= 0,并且横屏时dy + height >=1080,竖屏时dy + height >=1920。",
          "minimum": -5760,
          "maximum": 0,
          "default": 0
        },
        "width": {
          "type": "integer",
          "format": "int32",
          "example": 2880,
          "description": "**参数解释**:\n背景图片宽度像素值(相对画布大小)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n需要保证背景图片要铺满画布。即width > 1080,并且横屏时dx + width >=1920,竖屏时dx + width >=1080。",
          "minimum": 1,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "format": "int32",
          "example": 1620,
          "description": "**参数解释**:\n背景图片高度像素值(相对画布大小)。\n横屏(16:9)画布像素为1920x1080;竖屏(9:16)画布像素为1080x1920。\n\n**约束限制**:\n需要保证背景图片要铺满画布。height> 1080,并且横屏时dy + height >=1080,竖屏时dy + height >=1920。",
          "minimum": 1,
          "maximum": 7680
        }
      },
      "description": "背景图片大小及位置配置。"
    },
    "ShootScriptItem": {
      "required": [
        "shoot_script"
      ],
      "allOf": [
        {
          "$ref": "#/definitions/ShootScriptItemBaseInfo"
        },
        {
          "properties": {
            "shoot_script": {
              "$ref": "#/definitions/ShootScript"
            },
            "subtitle_file_info": {
              "description": "字幕文件信息。",
              "$ref": "#/definitions/SubtitleFiles"
            }
          }
        }
      ],
      "description": "剧本参数配置。"
    },
    "ReviewConfig": {
      "type": "object",
      "properties": {
        "no_need_review": {
          "type": "boolean",
          "description": "免审核。 目前仅白名单用户可使用此参数,非白名单用户跟随系统策略审核。"
        }
      },
      "description": "内容审核配置"
    },
    "SubtitleFiles": {
      "type": "object",
      "properties": {
        "text_subtitle_file": {
          "$ref": "#/definitions/SubtitleFileInfo"
        },
        "audio_subtitle_file": {
          "$ref": "#/definitions/SubtitleFileInfo"
        }
      }
    },
    "VideoConfig": {
      "type": "object",
      "required": [
        "bitrate",
        "height",
        "width"
      ],
      "properties": {
        "clip_mode": {
          "type": "string",
          "description": "**参数解释**:\n输出视频的剪辑方式。\n**约束限制**:\n不涉及。\n**取值范围**:\n* RESIZE:视频缩放。\n* CROP:视频裁剪。",
          "enum": [
            "RESIZE",
            "CROP"
          ],
          "default": "RESIZE"
        },
        "codec": {
          "type": "string",
          "description": "**参数解释**:\n视频编码格式及视频文件格式。\n**约束限制**:\n仅分身数字人视频制作支持VP8和QTRLE编码。QTRLE编码时文本驱动字符数限制小于1500字,音频驱动音频长度小于5分钟。\nQTRLE编码需要先申请开通白名单后才能使用\n\n**取值范围**:\n* H264:h264编码,输出mp4文件。\n* VP8:vp8编码,输出webm文件。\n* QTRLE:qtrle ,输出mov文件。\n\n**默认取值**:\nH264",
          "enum": [
            "H264",
            "VP8",
            "VP9",
            "QTRLE"
          ],
          "default": "H264"
        },
        "bitrate": {
          "type": "integer",
          "description": "**参数解释**:\n输出平均码率。单位:kbps。\n**约束限制**:\n* 分身数字人视频制作采用质量优先,可能会超过设置的码率。\n* 分身数字人直播码率范围[1000, 8000]。\n\n**默认取值**:\n不涉及",
          "minimum": 40,
          "maximum": 30000
        },
        "width": {
          "type": "integer",
          "description": "**参数解释**:\n视频宽度。单位:像素。\n**约束限制**:\n* clip_mode=RESIZE时,当前支持1920x1080、1080x1920、1280x720、720x1280、3840x2160、2160x3840六种分辨率。4K分辨率视频需要分身数字人模型支持4K的情况下才能使用。\n* clip_mode=CROP,裁剪后视频,(dx,dy)为原点,保留视频像宽度为width。\n* 分身数字人直播和智能交互目前只支持1080x1920、1920x1080。\n\n**默认取值**:\n不涉及",
          "minimum": 0,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "description": "**参数解释**:\n视频高度。\n\n单位:像素。\n**约束限制**:\n* clip_mode=RESIZE时,当前支持1920x1080、1080x1920、1280x720、720x1280、3840x2160、2160x3840六种分辨率分辨率。\n* clip_mode=CROP,裁剪后视频,(dx,dy)为原点,保留视频像高度为height。\n* 分身数字人直播和智能交互目前只支持1080x1920、1920x1080。\n\n**默认取值**:\n不涉及",
          "minimum": 0,
          "maximum": 3840
        },
        "frame_rate": {
          "type": "string",
          "format": "string",
          "description": "**参数解释**:\n帧率。单位:FPS。\n**约束限制**:\n分身数字人视频固定25FPS。",
          "minLength": 0,
          "maxLength": 10,
          "enum": [
            "24",
            "25",
            "30"
          ],
          "default": "25"
        },
        "is_subtitle_enable": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n输出的视频是否带字幕。\n**约束限制**:\n分身数字人直播暂时不支持字幕。\n\n**取值范围**:\n* true: 打开字幕\n* false: 关闭字幕",
          "enum": [
            true,
            false
          ],
          "default": false
        },
        "subtitle_config": {
          "$ref": "#/definitions/SubtitleConfig"
        },
        "dx": {
          "type": "integer",
          "format": "int32",
          "example": 256,
          "description": "**参数解释**:\n裁剪视频左上角像素点横坐标。\n> 以模特分辨率为画布大小,比如1920*1080分辨率的模特,dx最小值是0,最大值是1920。\n\n**约束限制**:\nclip_mode= CROP时生效。\n**默认取值**:\n不涉及",
          "minimum": -1920,
          "maximum": 3840
        },
        "dy": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n裁剪视频左上角像素点纵坐标。\n> 以模特分辨率为画布大小,比如1920*1080分辨率的模特,dy最小值是0,最大值是1080\n\n**约束限制**:\nclip_mode= CROP时生效。\n**默认取值**:\n不涉及",
          "minimum": -1920,
          "maximum": 3840
        },
        "is_enable_super_resolution": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n视频是否开启超分。\n**约束限制**:\n仅分身数字人视频制作支持。\n**取值范围**\n* true: 开启\n* false: 不开启",
          "enum": [
            true,
            false
          ],
          "default": false
        },
        "is_end_at_first_frame": {
          "type": "boolean",
          "example": true,
          "description": "**参数解释**:\n视频结束帧是否跟起始帧相同。需要多个数字人视频无缝拼接时设置成true。\n**约束限制**:\n仅分身数字人视频制作支持,当视频制作时插入动作标签后此设置将失效。\n**取值范围**\n* true: 开启\n* false: 不开启",
          "enum": [
            true,
            false
          ],
          "default": false
        },
        "output_external_url": {
          "type": "string",
          "example": "https://{endpoint}/a5d295cdb345c11bd9f36bc22ced3a7a/test.mp3?AccessKeyId=dnhlruEz0ZPD8Y8wnodo&Signature=E94GDa%2Bt3L%2F9mTnNXpFfGGFEe7c%3D",
          "description": "视频文件上传的外部URL。\n > * 需要先申请开通白名单后,才允许将视频上传到外部URL。",
          "minLength": 1,
          "maxLength": 2048
        },
        "is_vocabulary_config_enable": {
          "type": "boolean",
          "description": "**参数解释**:\n是否应用当前租户的读法配置\n**约束限制**:\n仅分身数字人视频制作支持。\n**取值范围**\n* true: 开启\n* false: 不开启",
          "default": true
        }
      },
      "description": "视频输出配置。"
    },
    "AudioInfo": {
      "properties": {
        "audio_id": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "**参数解释**:\n音频id。\n> * 获取方式:剧本为音频驱动时,查询剧本详情或者更新剧本会返回audio_id\n\n**约束限制**:\n不涉及\n**默认取值**:\n不涉及",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "Create2DDigitalHumanVideoReq": {
      "properties": {
        "script_id": {
          "type": "string",
          "example": "2340518bf885433b88e135dd744d5b27",
          "description": "剧本ID。\n> * 如果填写了script_id,model_asset_id、voice_config、scene_asset_id、video_config、shoot_scripts可以不填,以脚本中的配置为准。\n> * 如果填写了script_id,并且同时也填写了model_asset_id、voice_config、scene_asset_id、video_config、shoot_scripts则以本接口中的配置为准。",
          "minLength": 1,
          "maxLength": 64
        },
        "model_asset_id": {
          "type": "string",
          "example": "0c7798664ee7178b3dba3bbef57c32e7",
          "description": "分身数字人模型资产ID,可以从资产库中查询。",
          "minLength": 0,
          "maxLength": 64,
          "x-annotations": "@AssetIdValid()"
        },
        "voice_config": {
          "description": "音色配置。",
          "$ref": "#/definitions/VoiceConfig"
        },
        "video_config": {
          "description": "视频输出配置。",
          "$ref": "#/definitions/VideoConfig"
        },
        "shoot_scripts": {
          "type": "array",
          "description": "拍摄脚本列表。",
          "items": {
            "$ref": "#/definitions/ShootScriptItem"
          },
          "maxItems": 100,
          "minItems": 1
        },
        "output_asset_config": {
          "description": "输出资产信息配置。",
          "$ref": "#/definitions/OutputAssetConfig"
        },
        "background_music_config": {
          "description": "背景音乐配置。",
          "$ref": "#/definitions/BackgroundMusicConfig"
        },
        "review_config": {
          "description": "内容审核配置。",
          "$ref": "#/definitions/ReviewConfig"
        },
        "callback_config": {
          "description": "回调设置。",
          "$ref": "#/definitions/CallBackConfig"
        },
        "action_config": {
          "description": "动作编排配置\n> * 只对分身数字人视频制作生效",
          "$ref": "#/definitions/ActionConfig"
        }
      },
      "x-imports": [
        "com.huawei.hdh.mps.annotations.AssetIdValid"
      ]
    },
    "ActionConfig": {
      "properties": {
        "action_interval": {
          "type": "number",
          "format": "float",
          "description": "算法自动插入无语义动作的时间间隔。这个参数填0或者不填默认是间隔4秒,设置成255时不自动插入无语义动作。",
          "minimum": 0,
          "maximum": 255,
          "default": 0.0
        }
      },
      "description": "动作编排配置。"
    },
    "VideoLayerConfig": {
      "type": "object",
      "properties": {
        "video_url": {
          "type": "string",
          "description": "**参数解释**:\n视频文件的URL。\n**约束限制**:\n* 仅直播支持外部URL,其他业务通过资产库查询获取,不支持外部URL。\n**取值范围**:\n字符长度1-2048位。\n**默认取值**:\n不涉及。",
          "minLength": 1,
          "maxLength": 2048
        },
        "video_cover_url": {
          "type": "string",
