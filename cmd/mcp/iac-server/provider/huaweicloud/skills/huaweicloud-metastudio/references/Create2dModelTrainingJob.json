  "definitions": {
    "Create2dModelTrainingJobReq": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "华为云笙",
          "description": "分身数字人模型名称。该名称会作为资产库中分身数字人模型资产名称。",
          "minLength": 1,
          "maxLength": 256
        },
        "contact": {
          "type": "string",
          "example": "13775652635",
          "description": "分身数字人训练任务创建者的手机号",
          "minLength": 0,
          "maxLength": 64
        },
        "command_message": {
          "type": "string",
          "example": "UPDATE_VIDEO",
          "description": "命令类型:\n* UPDATE_VIDEO: 更新视频\n* UPLOAD_VIDEO:上传视频\n* CONFIRM_ACTION_VIDEO: 确认动作编排视频\n* GET_ACTION_VIDEO_MULTIPART: 获取动作编排视频分片",
          "enum": [
            "UPDATE_VIDEO",
            "UPLOAD_VIDEO",
            "CONFIRM_ACTION_VIDEO",
            "GET_ACTION_VIDEO_MULTIPART"
          ],
          "default": "UPLOAD_VIDEO"
        },
        "video_multipart_count": {
          "type": "integer",
          "format": "int32",
          "description": "训练视频上传分片数(上传时对唯一训练视频文件的数据分片,用于对该文件的并发上传,不是分多个视频文件上传)。",
          "minimum": 1,
          "maximum": 1000,
          "default": 1
        },
        "action_video_multipart_count": {
          "type": "integer",
          "format": "int32",
          "description": "动作视频上传分片数。",
          "minimum": 1,
          "maximum": 1000,
          "default": 1
        },
        "is_background_replacement": {
          "type": "boolean",
          "example": true,
          "description": "分身数字人是否需要背景替换。需要背景替换的分身数字人训练视频需要绿幕拍摄。",
          "default": true
        },
        "batch_name": {
          "type": "string",
          "example": "第一批",
          "description": "分身数字人训练任务的批次名称。",
          "minLength": 1,
          "maxLength": 256
        },
        "tags": {
          "type": "array",
          "description": "分身数字人训练任务标签。",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          },
          "maxItems": 10,
          "minItems": 0,
          "x-maxLength": 10,
          "x-minLength": 0
        },
        "model_version": {
          "type": "string",
          "example": "V3.2",
          "description": "分身数字人模型版本。默认是V3.2版本模型。\n* V3.2:V3.2版本模型\n* V3.3: 极速版flexus训练用的模型\n> * V3和V2版本已废弃不用",
          "enum": [
            "V2",
            "V3",
            "V3.2",
            "V3.3"
          ],
          "default": "V3.2"
        },
        "is_ondemand_resource": {
          "type": "boolean",
          "description": "分身数字人训练任务类型\ntrue 按需任务\nfalse 普通任务",
          "default": false
        },
        "is_flexus": {
          "type": "boolean",
          "example": true,
          "description": "是否是基础版的形象训练",
          "default": false
        },
        "is_fast_flexus": {
          "type": "boolean",
          "example": true,
          "description": "是否极速版flexus",
          "default": false
        },
        "is_live_copy": {
          "type": "boolean",
          "example": true,
          "description": "是否是直播间复刻任务",
          "default": false
        },
        "is_only_human_model": {
          "type": "boolean",
          "example": true,
          "description": "是否只训练形象模型,不训练声音模型。仅Flexus版本时有效,默认false。",
          "default": false
        },
        "audio_source_type": {
          "type": "string",
          "example": "VIDEO",
          "description": "声音来源类型\n* VIDEO:视频中抽取音频\n* AUDIO:单独上传的音频",
          "enum": [
            "VIDEO",
            "AUDIO"
          ],
          "default": "VIDEO"
        },
        "voice_properties": {
          "$ref": "#/definitions/VoiceProperties"
        },
        "supported_service": {
          "type": "array",
          "description": "该任务所生成的模型支持的业务类型,可多选。\n\nFlexus版数字人仅支持选择“VIDEO_2D”。",
          "items": {
            "description": "支持的业务类型。:\n* VIDEO_2D:分身数字人视频制作\n* LIVE_2D:分身数字人直播\n* CHAT_2D:分身数字人智能交互",
            "$ref": "#/definitions/SupportedServiceEnum"
          },
          "maxItems": 10,
          "minItems": 0
        }
      },
      "description": "创建或更新分身数字人模型训练任务请求。"
    },
    "SupportedServiceEnum": {
      "type": "string",
      "enum": [
        "VIDEO_2D",
        "LIVE_2D",
        "CHAT_2D"
      ]
    },
    "VoiceProperties": {
      "required": [
        "job_tag",
        "language",
        "sex"
      ],
      "properties": {
        "job_tag": {
          "type": "string",
          "example": "ECOMMERCE",
          "description": "任务标签,为Flexus版声音的配置。\n  * ECOMMERCE: 电商\n  * NEWS: 新闻\n  * MARKETING: 营销",
          "enum": [
            "ECOMMERCE",
            "NEWS",
            "MARKETING"
          ]
        },
        "sex": {
          "type": "string",
          "example": "FEMALE",
          "description": "语音性别,是男性声音还是女性声音,为Flexus版声音的配置。\n* FEMALE: 女性\n* MALE: 男性",
          "enum": [
            "FEMALE",
            "MALE"
          ],
          "default": "FEMALE"
        },
        "language": {
          "type": "string",
          "example": "CN",
          "description": "训练语言,当前仅支持中文,为Flexus版声音的配置。\n* CN: 中文\n* EN: 英文",
          "enum": [
            "CN",
            "EN"
          ]
        }
      },
      "description": "声音配置信息,为Flexus版声音的配置项,标准版声音不支持此配置。"
    },
