          "minLength": 1,
          "maxLength": 2048
        },
        "pre_beauty_image_upload_url": {
          "type": "string",
          "example": "https://example.com:443/0d697589d98091f12f92c0073501cd79/942e65a5fd219a2e01fb08d881cfadb9/pre_beauty_image.png?AccessKeyId=XCQKTA8IWQPCAUQS4SDA&Expires=1671241457&Signature=zVGMVbI5ji9rr8epD1Cir5OGIRk%3D",
