{
  "name": "ListRepositoryTags",
  "summary": "查询仓库标签列表",
  "tags": "仓库管理",
  "productshort": "OpenSource",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/projects/{namespace}/{project}/repository/tags": {
      "get": {
        "tags": [
          "仓库管理"
        ],
        "summary": "查询仓库标签列表",
        "description": "获取仓库的标签列表,默认以标签名逆序排序。\n\n如果仓库是公开的,接口可无认证调用。",
        "operationId": "ListRepositoryTags",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvIIDgzCCXXXXXX..."
          },
          {
            "name": "namespace",
            "in": "path",
            "description": "仓库所属空间",
            "required": true,
            "type": "string",
            "x-example": "DevCloud"
          },
          {
            "name": "project",
            "in": "path",
            "description": "仓库名",
            "required": true,
            "type": "string",
            "x-example": "DevToCloud"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量",
            "required": false,
            "type": "integer",
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "format": "int32",
            "x-example": 20
          },
          {
            "name": "offset",
            "in": "query",
            "description": "页码,默认为1。\n\n取值大于等于1。",
            "required": false,
            "type": "integer",
            "default": 1,
            "format": "int32",
            "x-example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "total_count": 1,
                "tags": [
                  {
                    "name": "v1.0",
                    "message": "tag v1.0",
                    "commit": {
                      "id": "cc841bd77f9970cc9de13e7df725555b1c44fae9",
                      "title": "merge sync_from_gitee into master",
                      "message": "merge sync_from_gitee into master",
                      "short_id": "cc841bd7",
                      "committer_name": "BinaryFZ",
                      "committed_date": "2019-10-25T13:02:57.000Z"
                    }
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/TagList"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "GET https://{endpoint}/v1/projects/{namespace}/{project}/repository/tags",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "x-apiexplorer-auth": false
      }
    }
  },
  "definitions": {
    "Tag": {
      "type": "object",
      "properties": {
        "commit": {
          "description": "标签对应的commit信息",
          "$ref": "#/definitions/Commit"
        },
        "message": {
          "type": "string",
          "description": "标签携带的记录信息"
        },
        "name": {
          "type": "string",
          "description": "标签名"
        }
      }
    },
    "TagList": {
      "type": "object",
      "properties": {
        "tags": {
          "type": "array",
          "description": "分页后的标签列表",
          "items": {
            "$ref": "#/definitions/Tag"
          }
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "仓库的标签总数"
        }
      }
    },
    "Commit": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "commit id"
        },
        "message": {
          "type": "string",
          "description": "提交信息"
        },
        "short_id": {
          "type": "string",
          "description": "commit 短id"
        },
        "title": {
          "type": "string",
          "description": "标题"
        },
        "committer_name": {
          "type": "string",
          "description": "提交者名字"
        },
        "committed_date": {
          "type": "string",
          "format": "date-time",
          "description": "提交日期"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
