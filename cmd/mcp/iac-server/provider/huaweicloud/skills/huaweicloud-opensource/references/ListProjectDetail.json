{
  "name": "ListProjectDetail",
  "summary": "查询项目详情",
  "tags": "项目管理",
  "productshort": "OpenSource",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/projects/{namespace}/{project}": {
      "get": {
        "tags": [
          "项目管理"
        ],
        "summary": "查询项目详情",
        "description": "获取指定的项目详情。\n\n如果项目是公开的,接口可无认证调用。",
        "operationId": "ListProjectDetail",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvIIDgzCCXXXXXX..."
          },
          {
            "name": "namespace",
            "in": "path",
            "description": "仓库所属空间",
            "required": true,
            "type": "string",
            "x-example": "DevCloud"
          },
          {
            "name": "project",
            "in": "path",
            "description": "仓库名",
            "required": true,
            "type": "string",
            "x-example": "DevToCloud"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "id": 12,
                "description": "Demo项目",
                "name": "DevToCloud",
                "path": "DevToCloud",
                "visibility": "public",
                "namespace": {
                  "name": "DevCloud",
                  "path": "DevCloud",
                  "full_path": "DevCloud"
                },
                "starred": false,
                "empty_repo": false,
                "name_with_namespace": "DevCloud / DevToCloud",
                "path_with_namespace": "DevCloud/DevToCloud",
                "open_issues_count": 0,
                "branch_count": 1,
                "tag_count": 0,
                "default_branch": "master",
                "ssh_url_to_repo": "git@code.opensource.cn-north-7.ulanqab.huawei.com:DevCloud/DevToCloud.git",
                "http_url_to_repo": "https://code.opensource.cn-north-7.ulanqab.huawei.com/DevCloud/DevToCloud.git",
                "star_count": 0,
                "last_activity_at": "2020-09-22T11:06:41.098Z",
                "web_url": "https://opensource.cn-north-7.ulanqab.huawei.com/DevCloud/DevToCloud"
              }
            },
            "schema": {
              "$ref": "#/definitions/Project"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "GET https://{endpoint}/v1/projects/{namespace}/{project}",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "x-apiexplorer-auth": false
      }
    }
