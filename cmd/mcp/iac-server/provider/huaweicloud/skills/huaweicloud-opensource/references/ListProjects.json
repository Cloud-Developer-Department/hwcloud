{
  "name": "ListProjects",
  "summary": "获取项目列表",
  "tags": "项目管理",
  "productshort": "OpenSource",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/projects": {
      "get": {
        "tags": [
          "项目管理"
        ],
        "summary": "获取项目列表",
        "description": "获取当前用户可见的项目列表。\n\n当无认证调用时,仅返回公开的项目列表。",
        "operationId": "ListProjects",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": false,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvIIDgzCCXXXXXX..."
          },
          {
            "name": "forked",
            "in": "query",
            "description": "当前用户fork的项目",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-example": false
          },
          {
            "name": "owned",
            "in": "query",
            "description": "当前用户管理的项目",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-example": false
          },
          {
            "name": "starred",
            "in": "query",
            "description": "当前用户关注的项目",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-example": false
          },
          {
            "name": "membership",
            "in": "query",
            "description": "当前用户所在的项目",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-example": false
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量",
            "required": false,
            "type": "integer",
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "format": "int32",
            "x-example": 20
          },
          {
            "name": "offset",
            "in": "query",
            "description": "页码,默认为1。\n\n取值大于等于1。",
            "required": false,
            "type": "integer",
            "default": 1,
            "format": "int32",
            "x-example": 1
          },
          {
            "name": "search",
            "in": "query",
            "description": "搜索关键字,根据项目名、项目路径搜索",
            "type": "string",
            "default": "",
            "x-example": "DevToCloud"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "total_count": 5,
                "project_list": [
                  {
                    "id": 12,
                    "description": "Demo项目",
                    "name": "DevToCloud",
                    "path": "DevToCloud",
                    "visibility": "public",
                    "namespace": {
                      "name": "DevCloud",
                      "path": "DevCloud",
                      "full_path": "DevCloud"
                    },
                    "starred": false,
                    "empty_repo": false,
                    "name_with_namespace": "DevCloud / DevToCloud",
                    "path_with_namespace": "DevCloud/DevToCloud",
                    "open_issues_count": 0,
                    "branch_count": 1,
                    "tag_count": 0,
                    "default_branch": "master",
                    "ssh_url_to_repo": "git@code.opensource.cn-north-7.ulanqab.huawei.com:DevCloud/DevToCloud.git",
                    "http_url_to_repo": "https://code.opensource.cn-north-7.ulanqab.huawei.com/DevCloud/DevToCloud.git",
                    "star_count": 0,
                    "last_activity_at": "2020-09-22T11:06:41.098Z",
                    "web_url": "https://opensource.cn-north-7.ulanqab.huawei.com/DevCloud/DevToCloud"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ProjectList"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "GET https://{endpoint}/v1/projects",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "x-apiexplorer-auth": false
      }
    }
  },
