          "type": "string",
          "description": "webhook名字"
        },
        "note_events": {
          "type": "boolean",
          "description": "评论事件"
        },
        "push_events": {
          "type": "boolean",
          "description": "提交代码事件"
        },
        "push_events_branch_filter": {
          "type": "string",
          "description": "触发hook的分支,在该分支上提交代码才会触发hook,仅限push_events"
        },
        "tag_push_events": {
          "type": "boolean",
          "description": "创建tag事件"
        },
        "token": {
          "type": "string",
          "description": "hook token"
        },
        "token_type": {
          "type": "string",
          "description": "token类型,目前支持'X-Auth-Token'和'X-CodeHub-Token'"
        },
