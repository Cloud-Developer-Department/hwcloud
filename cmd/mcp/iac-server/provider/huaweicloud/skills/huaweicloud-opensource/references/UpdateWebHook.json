      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "issues_events": {
          "type": "boolean",
          "description": "创建issue事件"
        },
        "merge_requests_events": {
          "type": "boolean",
          "description": "合并请求事件"
        },
