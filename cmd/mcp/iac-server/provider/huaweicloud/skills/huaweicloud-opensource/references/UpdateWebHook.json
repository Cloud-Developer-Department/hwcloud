{
  "name": "UpdateWebHook",
  "summary": "修改webhook",
  "tags": "Hook管理",
  "productshort": "OpenSource",
  "region_id": "ap-southeast-3",
  "paths": {
    "/v1/projects/{namespace}/{project}/hooks/{hook_id}": {
      "put": {
        "tags": [
          "Hook管理"
        ],
        "summary": "修改webhook",
        "description": "修改项目的webhook",
        "operationId": "UpdateWebHook",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvIIDgzCCXXXXXX..."
          },
          {
            "name": "namespace",
            "in": "path",
            "description": "仓库所属空间",
            "required": true,
            "type": "string",
            "x-example": "DevCloud"
          },
          {
            "name": "project",
            "in": "path",
            "description": "仓库名",
            "required": true,
            "type": "string",
            "x-example": "DevToCloud"
          },
          {
            "name": "hook_id",
            "in": "path",
            "description": "Hook ID",
            "required": true,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "UpdateWebHookRequestBody",
            "in": "body",
            "description": "更新web hook请求参数",
            "required": true,
            "schema": {
              "$ref": "#/definitions/WebHookVO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "id": 10,
                "url": "http://example.huawei.com/api/v1/webhook",
                "token": "MIIThwYJKoZIhvcNAQcCoIITeDCCE......",
                "push_events": true,
                "tag_push_events": false,
                "issues_events": false,
                "merge_requests_events": false,
                "note_events": false,
                "token_type": "X-Auth-Token",
                "push_events_branch_filter": "master"
              }
            },
            "schema": {
              "$ref": "#/definitions/WebHook"
            }
          }
        },
        "deprecated": false,
        "x-request-examples-url-1": "PUT https://{endpoint}/v1/projects/{namespace}/{project}/hooks/{hook_id}",
        "x-support-sdk": "N",
        "x-is-registered": "Y",
        "x-apiexplorer-auth": false
      }
    }
  },
  "definitions": {
