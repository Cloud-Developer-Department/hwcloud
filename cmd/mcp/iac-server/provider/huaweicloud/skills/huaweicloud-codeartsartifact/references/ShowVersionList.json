          "description": "**参数解释**:\n发布库版本的状态。\n**取值范围**:\n- test:测试包。\n- prod:发布包。"
        },
        "build_version": {
          "type": "string",
          "description": "**参数解释**:\n发布库版本的名称。\n**取值范围**:\n不涉及。"
        },
        "files_count": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n版本下的文件个数。\n**取值范围**:\n不涉及。"
        }
      }
    },
    "VersionListV5Res": {
