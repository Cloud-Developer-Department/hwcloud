{
  "name": "ShowProjectReleaseFiles",
  "summary": "获取项目下文件版本信息列表",
  "tags": "发布库文件查询",
  "productshort": "CodeArtsArtifact",
  "region_id": "af-north-1",
  "paths": {
    "/v2/{project_id}/release/files": {
      "get": {
        "tags": [
          "发布库文件查询"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "summary": "获取项目下文件版本信息列表",
        "description": "获取项目下文件版本信息列表",
        "operationId": "ShowProjectReleaseFiles",
        "produces": [
          "application/json;charset=UTF-8"
        ],
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户token",
            "minLength": 1,
            "maxLength": 10000,
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvIIDgzCCXXXXXX..."
          },
          {
            "name": "file_name",
            "in": "query",
            "description": "文件名称,模糊搜索",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "x-example": "javaMavenDemo"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页显示的条目数量",
            "required": false,
            "type": "integer",
            "default": 10,
            "format": "int32",
            "minimum": 1,
            "maximum": 100,
            "x-example": "10"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量,表示从此偏移量开始查询, offset大于等于0",
            "required": false,
            "type": "integer",
            "default": 0,
            "format": "int32",
            "minimum": 0,
            "maximum": 10000000,
            "x-example": "0"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目id",
            "required": true,
            "type": "string",
            "minLength": 0,
            "maxLength": 32,
            "x-example": "bc6139d224c940b294867faaefd32373"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/StandardResponse"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/StandardError"
            },
            "examples": {
              "application/json": {
                "error_code": "CR.4102",
                "error_msg": "当前用户没有该项目权限"
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "schema": {
              "$ref": "#/definitions/StandardError"
            },
            "examples": {
              "application/json": {
                "error_code": "CR.5000",
                "error_msg": "未知服务错误"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "StandardError": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码",
          "minLength": 0,
          "maxLength": 1000
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息",
          "minLength": 0,
          "maxLength": 1000
        }
      },
      "title": "Error"
    },
    "StandardResponse": {
      "type": "object",
      "description": "返回结果信息",
      "properties": {
        "result": {
          "description": "返回的具体结果信息",
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "description": "符合条件的结果列表",
              "items": {
                "$ref": "#/definitions/ReleaseFileVersionDo"
              }
            },
            "total_records": {
              "type": "integer",
              "description": "符合条件的结果总数",
              "minimum": 1,
              "maximum": 1000
            },
            "total_pages": {
              "type": "integer",
              "description": "符合条件的结果总页数",
              "minimum": 1,
              "maximum": 10000
            }
          }
        }
      },
      "title": "StandardResponse"
    },
    "ReleaseFileVersionDo": {
      "type": "object",
      "description": "发布文件版本信息",
      "properties": {
        "version": {
          "type": "string",
          "description": "发布库文件的版本",
          "minLength": 0,
          "maxLength": 100
        },
        "path": {
          "type": "string",
          "description": "发布库文件的路径",
          "minLength": 0,
          "maxLength": 100
        },
        "download_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "发布库文件的下载链接"
        }
      },
      "title": "ReleaseFileVersionDo"
    }
  },
  "version": "2.0",
