  "definitions": {
    "RestoreSnapshotReq": {
      "required": [
        "target_cluster"
      ],
      "properties": {
        "target_cluster": {
          "type": "string",
          "description": "快照要恢复到的集群的ID。",
          "example": "ea244205-d641-45d9-9dcb-ab2236bcd07e"
        },
        "indices": {
          "type": "string",
          "description": "指定要恢复的索引名称,多个索引用逗号隔开,默认恢复所有索引。支持使用“\\*”匹配多个索引,例如:2018-06\\*,表示恢复名称前缀是2018-06的所有索引的数据。\n\n0~1024个字符,不能包含空格和大写字母,且不能包含\\\"\\\\<|>/?特殊字符。",
          "example": "myindex1,myindex2"
        },
        "rename_pattern": {
          "type": "string",
          "description": "匹配要恢复的索引规则,最大支持1024个字符。根据此处定义的过滤条件去恢复符合条件的索引,过滤条件请使用正则表达式。\n\n0~1024个字符,不能包含空格和大写字母,且不能包含\\\"\\\\<|>/?,特殊字符。\n\n renamePattern参数与renameReplacement参数必须同时设置才能生效。"
        },
        "rename_replacement": {
          "type": "string",
          "description": "索引重命名的规则。0~1024个字符,不能包含空格和大写字母,且不能包含\\\"\\\\<|>/?,特殊字符。例如,“restored_index_$1”表示在所有恢复的索引名称前面加上“restored_”。\n\n\n renamePattern参数与renameReplacement参数必须同时设置才能生效。"
        },
        "replace_exist_indices": {
          "type": "boolean",
          "description": "替换已存在的索引。"
        }
      }
    }
  },
