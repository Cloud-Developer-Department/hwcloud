  "definitions": {
    "ShrinkNodeReq": {
      "required": [
        "reducedNodeNum",
        "type"
      ],
      "properties": {
        "reducedNodeNum": {
          "type": "integer",
          "format": "int32",
          "description": "需要缩容的节点数量。\n\n- 对节点缩容后,请确保每个节点类型在每个AZ中的数量至少为1。\n\n- 关于跨AZ的集群,在不同AZ中同类型节点个数的差值要小于等于1。\n\n- 关于没有Master节点的集群,每次缩容的数据节点个数(包含冷数据节点和其他类型节点)要小于当前数据节点总数的一半,缩容后的数据节点个数要大于索引的最大副本个数。\n\n- 关于有Master节点的集群,每次缩容的Master节点个数要小于当前Master节点总数的一半,缩容后的Master节点个数必须是奇数且不小于3。",
          "example": 1
        },
        "type": {
          "type": "string",
          "description": "指定节点类型。\n- ess:数据节点。\n- ess-cold:冷数据节点。\n- ess-client:Client节点。\n- ess-master:Master节点。"
        }
      }
    },
    "ShrinkClusterReq": {
      "properties": {
        "shrink": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShrinkNodeReq"
          },
          "description": "需要缩容的节点类型和数量集合。"
        },
        "agency_name": {
          "type": "string",
          "description": "委托名称,委托给CSS服务,允许CSS调用您的其他云服务。"
        },
        "operation_type": {
          "type": "string",
          "description": "操作类型。"
        },
        "cluster_load_check": {
          "type": "boolean",
          "description": "是否需要检查集群负载。"
        }
      },
      "required": [
        "shrink"
      ]
    }
  },
