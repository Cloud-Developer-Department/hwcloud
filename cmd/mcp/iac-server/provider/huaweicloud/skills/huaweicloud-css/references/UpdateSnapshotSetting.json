  "definitions": {
    "UpdateSnapshotSettingReq": {
      "required": [
        "bucket",
        "agency"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "description": "备份使用的OBS桶的桶名。",
          "example": "test-bucket"
        },
        "agency": {
          "type": "string",
          "description": "委托名称,委托给CSS,允许CSS调用您的其他云服务。",
          "example": "usearch"
        },
        "base_path": {
          "type": "string",
          "description": "快照在OBS桶中的存放路径。",
          "example": "css_repository/Es-name"
        },
        "max_snapshot_bytes_per_seconds": {
          "type": "string",
          "description": "配置每个节点的最大备份速率(每秒),即当备份的速率超过该值时会被限流,避免速率太大导致资源占用过高,影响系统稳定性。实际备份速率不一定能达到该值,会受OBS、磁盘等影响。",
          "example": 0
        },
        "max_restore_bytes_per_seconds": {
          "type": "string",
          "description": "配置每个节点的最大恢复速率(每秒),即当恢复的速率超过该值时会被限流,避免速率太大导致资源占用过高,影响系统稳定性。实际恢复速率不一定能达到该值,会受OBS、磁盘等影响。",
          "example": 0
        },
        "enable": {
          "type": "string",
          "description": "是否开启自动创建快照策略。"
        },
        "indices": {
          "type": "string",
          "description": "需要备份的索引名。"
        },
        "prefix": {
          "type": "string",
          "description": "自动创建快照的名称前缀,需要用户自己手动输入。"
        },
        "period": {
          "type": "string",
          "description": "每天创建快照的时刻。"
        },
        "keepday": {
          "type": "integer",
          "format": "int32",
          "description": "自定义设置快照保留的个数。系统在半点时刻会自动删除超过保留个数的快照。过期删除策略只针对与当前自动创建快照策略相同执行频次的自动快照。",
          "example": 7
        },
        "frequency": {
          "type": "string",
          "description": "自动创建快照的执行频次。"
        },
        "delete_auto": {
          "type": "string",
          "description": "表示关闭自动创建快照策略时,是否需要清除所有自动创建的快照。"
        }
      }
    }
  },
  "version": "2.0",
