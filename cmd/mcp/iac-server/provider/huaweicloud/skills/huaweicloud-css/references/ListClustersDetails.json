  "definitions": {
    "ClusterListTags": {
      "properties": {
        "key": {
          "type": "string",
          "description": "集群标签的key值。"
        },
        "value": {
          "type": "string",
          "description": "集群标签的value值。"
        }
      },
      "description": "集群标签。"
    },
    "SnapshotPolicyResp": {
      "type": "object",
      "description": "自动快照信息",
      "properties": {
        "backupEnable": {
          "type": "boolean",
          "description": "集群是否开启自动快照。"
        },
        "bakPeriod": {
          "type": "string",
          "description": "快照备份时间。"
        },
        "bakFrequency": {
          "type": "string",
          "description": "快照备份间隔。"
        },
        "bakKeepDay": {
          "type": "integer",
          "format": "int32",
          "description": "快照备份保留个数。"
        }
      }
    },
    "ClusterListResponse": {
      "properties": {
        "totalSize": {
          "type": "integer",
          "description": "集群个数。"
        },
        "clusters": {
          "type": "array",
          "description": "集群对象列表。",
          "items": {
            "$ref": "#/definitions/ClusterList"
          }
        }
      }
    },
    "kibanaElbWhiteListResp": {
      "properties": {
        "enableWhiteList": {
          "type": "boolean",
          "description": "是否开启kibana访问控制。\n- true: 开启访问控制。\n- false: 关闭访问控制"
        },
        "whiteList": {
          "type": "string",
          "description": "kibana公网访问白名单。"
        }
      },
      "description": "Kibana公网访问信息。"
    },
    "ClusterList": {
      "description": "集群对象。",
      "properties": {
        "datastore": {
          "$ref": "#/definitions/ClusterListDatastore"
        },
        "snapshotPolicy": {
          "description": "集群自动快照策略相关信息。",
          "$ref": "#/definitions/SnapshotPolicyResp"
        },
        "instances": {
          "type": "array",
          "description": "节点对象列表。",
          "items": {
            "$ref": "#/definitions/ClusterListInstances"
          }
        },
        "publicKibanaResp": {
          "description": "Kibana公网访问信息。",
          "$ref": "#/definitions/publicKibanaRespBody"
        },
        "elbWhiteList": {
          "description": "弹性IP白名单列表。",
          "$ref": "#/definitions/elbWhiteListResp"
        },
        "updated": {
          "type": "string",
          "description": "集群上次修改时间,格式为ISO8601: CCYY-MM-DDThh:mm:ss。"
        },
        "name": {
          "type": "string",
          "description": "集群名称。"
        },
        "publicIp": {
          "type": "string",
          "description": "公网IP信息。"
        },
        "created": {
          "type": "string",
          "description": "集群创建时间,格式为ISO8601:CCYY-MM-DDThh:mm:ss。\n\n返回的集群列表信息按照创建时间降序排序,即创建时间最新的集群排在最前。"
        },
        "id": {
          "type": "string",
          "description": "集群ID。"
        },
        "status": {
          "type": "string",
          "description": "集群状态值。\n\n- 100:创建中。\n- 200:可用。\n- 303:不可用,如创建失败。"
        },
        "endpoint": {
          "type": "string",
          "description": "用户VPC访问IP地址和端口号。"
        },
        "vpcId": {
          "type": "string",
          "description": "VPC ID。"
        },
        "subnetId": {
          "type": "string",
          "description": "子网ID。"
        },
        "securityGroupId": {
          "type": "string",
          "description": "安全组ID。"
        },
        "bandwidthSize": {
          "type": "integer",
          "format": "int32",
          "description": "公网带宽大小。单位:Mbit/s"
        },
        "httpsEnable": {
          "type": "boolean",
          "description": "通信加密状态。\n- false:未设置通信加密。\n- true:已设置通信加密。"
        },
        "authorityEnable": {
          "type": "boolean",
          "description": "是否开启认证。\n- true:表示集群开启认证。\n- false:表示集群不开启认证。"
        },
        "diskEncrypted": {
          "type": "boolean",
          "description": "磁盘是否加密。\n\n- true : 磁盘已加密。\n- false : 磁盘未加密。"
        },
        "backupAvailable": {
          "type": "boolean",
          "description": "快照是否开启。\n- true: 快照开启状态。\n- false: 快照关闭状态。"
        },
        "actionProgress": {
          "type": "object",
          "description": "集群行为进度,显示创建或扩容进度的百分比等。CREATING表示创建的百分比。"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "集群当前行为。REBOOTING表示重启、GROWING表示扩容、RESTORING表示恢复集群、SNAPSHOTTING表示创建快照等。"
        },
        "enterpriseProjectId": {
          "type": "string",
          "description": "集群所属的企业项目ID。\n如果集群所属用户没有开通企业项目,则不会返回该参数。"
        },
        "tags": {
          "type": "array",
          "description": "集群标签。",
          "items": {
            "$ref": "#/definitions/ClusterListTags"
          }
        },
        "failedReason": {
          "$ref": "#/definitions/ClusterListFailedReasons"
        },
        "period": {
          "type": "boolean",
          "description": "是否为包周期集群。\n- \"true\" 表示是包周期计费的集群。\n- \"false\" 表示是按需计费的集群。"
        },
        "bandwidthResourceId": {
          "type": "string",
          "description": "es公网访问的资源id。"
        },
        "ipv6Endpoint": {
          "type": "string",
          "description": "集群内网访问IPv6地址和端口号。"
        },
        "cmkId": {
          "type": "string",
          "description": "当前集群使用的磁盘加密密钥ID。"
        },
        "currentSubnetIds": {
          "type": "string",
          "description": "集群节点的当前子网。"
        },
        "desc": {
          "type": "string",
          "example": "ES-Test-new",
          "description": "集群描述。"
        }
      },
      "type": "object"
    },
    "ClusterVolumeRsp": {
      "properties": {
        "type": {
          "type": "string",
          "description": "实例磁盘类型。"
        },
        "size": {
          "type": "integer",
          "description": "实例磁盘大小。"
        },
        "resourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "该实例拥有的磁盘对应的资源Id。"
        }
      },
      "description": "实例磁盘信息。",
      "type": "object"
    },
    "ClusterListDatastore": {
      "properties": {
        "type": {
          "type": "string",
          "description": "引擎类型,目前只支持elasticsearch。"
        },
        "version": {
          "type": "string",
          "description": "CSS集群引擎版本号。详细请参考CSS[支持的集群版本](css_03_0056.xml)。"
        },
        "supportSecuritymode": {
          "type": "boolean",
          "description": "是否支持安全模式"
        },
        "subVersion": {
          "type": "string",
          "description": "集群发布版本号。"
        },
        "isEosCluster": {
          "type": "boolean",
          "description": "表示集群发布版本是否EOS。"
        }
      },
      "description": "数据搜索引擎类型。"
    },
    "elbWhiteListResp": {
      "properties": {
        "enableWhiteList": {
          "type": "boolean",
          "description": "是否开启公网访问控制。\n- true: 开启公网访问控制。\n- false: 关闭公网访问控制。"
        },
        "whiteList": {
          "type": "string",
          "description": "公网访问白名单。"
        }
      },
      "description": "公网访问信息。"
    },
    "publicKibanaRespBody": {
      "description": "Kibana公网访问信息。",
      "properties": {
        "eipSize": {
          "type": "integer",
          "description": "带宽大小。单位:Mbit/s"
        },
        "elbWhiteListResp": {
          "$ref": "#/definitions/kibanaElbWhiteListResp"
        },
        "publicKibanaIp": {
          "type": "string",
          "description": "kibana访问IP。"
        },
        "bandwidthResourceId": {
          "type": "string",
          "description": "当前kibana公网对应的资源Id。"
        }
      },
      "type": "object"
    },
    "ClusterListInstances": {
      "description": "节点对象。",
      "properties": {
        "status": {
          "type": "string",
          "description": "节点状态值。\n\n- 100:创建中。\n- 200:可用。\n- 303:不可用,如创建失败。"
        },
        "type": {
          "type": "string",
          "description": "当前节点的类型。",
          "pattern": "ess"
        },
        "id": {
          "type": "string",
          "description": "实例ID。"
        },
        "name": {
          "type": "string",
          "description": "实例名字。"
        },
        "specCode": {
          "type": "string",
          "description": "节点规格名称。"
        },
        "azCode": {
          "type": "string",
          "description": "节点所属AZ信息。"
        },
        "ip": {
          "type": "string",
          "description": "实例ip信息。"
        },
        "volume": {
          "$ref": "#/definitions/ClusterVolumeRsp"
        },
        "resourceId": {
          "type": "string",
          "description": "该实例对应的资源Id。"
        },
        "subnetId": {
          "type": "string",
          "description": "集群当前节点所属子网ID。"
        }
      },
      "type": "object"
    },
    "ClusterListFailedReasons": {
      "properties": {
        "errorCode": {
          "type": "string",
          "description": "错误码。\n\n- CSS.6000:表示集群创建失败。\n- CSS.6001:表示集群扩容失败。\n- CSS.6002:表示集群重启失败。\n- CSS.6004:表示集群节点创建失败。\n- CSS.6005:表示服务初始化失败。"
        },
        "errorMsg": {
          "type": "string",
          "description": "详细错误信息。"
        }
      },
      "description": "失败原因。如果集群处于正常状态,则不返回该参数。"
    }
  },
