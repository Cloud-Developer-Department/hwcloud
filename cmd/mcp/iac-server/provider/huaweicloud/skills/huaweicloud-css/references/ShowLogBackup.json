  "definitions": {
    "logList": {
      "properties": {
        "content": {
          "type": "string",
          "description": "日志内容。",
          "example": "xxxxxxxx"
        },
        "date": {
          "type": "string",
          "description": "日期。",
          "example": "2021-10-08T03:55:54,718"
        },
        "level": {
          "type": "string",
          "description": "日志级别。",
          "example": "ERROR"
        }
      },
      "description": "日志列表。"
    },
    "GetLogBackupReq": {
      "required": [
        "instance_name",
        "log_type"
      ],
      "properties": {
        "instance_name": {
          "type": "string",
          "description": "节点名称。通过[查询集群详情](ShowClusterDetail.xml)获取instances中的name属性。",
          "example": "css-4312-ess-esn-1-1"
        },
        "level": {
          "type": "string",
          "description": "日志级别。可查询的日志级别为:INFO,ERROR,DEBUG,WARN。",
          "example": "INFO"
        },
        "log_type": {
          "type": "string",
          "description": "日志类型。可查询的日志类型为:deprecation,indexingSlow,searchSlow, instance。",
          "example": "instance"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "指定返回日志的条数,默认返回100条,最大返回10000条日志,且日志大小不超过1MB。"
        },
        "time_index": {
          "type": "string",
          "description": "返回指定时间之前的日志。"
        },
        "keyword": {
          "type": "string",
          "description": "基于日志内容字段值需要过滤的关键字,注意搜索到的日志包含关键字。"
        }
      }
    },
    "GetLogBackupResponseBody": {
      "properties": {
        "logList": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/logList"
          }
        },
        "type": {
          "type": "string",
          "description": "查询日志的类型。"
        },
        "completed": {
          "type": "boolean",
          "description": "**参数解释**:\n日志文件是否已经查询完。\n**取值范围**:\n- true: 日志文件已经查询完,没有更多结果了。\n- false:日志文件未查询完,因日志条数已达到请求条数或者日志大小达到1MB,查询提前返回结果。"
        }
      }
    }
  },
