{
  "name": "ShowGetLogSetting",
  "summary": "查询日志基础配置",
  "tags": "日志管理接口",
  "productshort": "CSS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1.0/{project_id}/clusters/{cluster_id}/logs/settings": {
      "get": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-publishpath": "",
        "tags": [
          "日志管理接口"
        ],
        "summary": "查询日志基础配置",
        "description": "该接口用于日志基础配置查询。",
        "operationId": "ShowGetLogSetting",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "description": "项目ID。获取方法请参见[获取项目ID和名称](css_03_0071.xml)。",
            "required": true,
            "type": "string",
            "x-example": "6204a5bd270343b5885144cf9c8c158d"
          },
          {
            "in": "path",
            "name": "cluster_id",
            "description": "指定查询集群ID。",
            "required": true,
            "type": "string",
            "x-example": "5c77b71c-5b35-4f50-8984-76387e42451a"
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功。",
            "examples": {
              "application/json": {
                "logConfiguration": {
                  "id": "d455a541-597e-4846-a6be-baad0ea361b1",
                  "clusterId": "4213d908-f5dc-4633-8401-cfd7175fca0c",
                  "obsBucket": "css-auto-test",
                  "agency": "css_obs_agency",
                  "updateAt": 1633663681055,
                  "basePath": "css/log",
                  "autoEnable": false,
                  "period": "00:00 GMT+08:00",
                  "logSwitch": true
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/GetLogSettingResponseBody"
            }
          },
          "400": {
            "description": "非法请求。\n\n建议直接修改该请求,不要重试该请求。"
          },
          "409": {
            "description": "服务器在完成请求时发生冲突。\n\n返回该状态码,表明客户端尝试创建的资源已经存在,或者由于冲突请求的更新操作不能被完成。"
          },
          "412": {
            "description": "未满足前提条件,服务器未满足请求者在请求中设置的其中一个前提条件。"
          }
        },
        "x-request-examples-url": "GET /v1.0/6204a5bd270343b5885144cf9c8c158d/clusters/5c77b71c-5b35-4f50-8984-76387e42451a/logs/settings"
      }
    }
  },
  "definitions": {
    "logConfiguration": {
      "properties": {
        "id": {
          "type": "string",
          "description": "日志备份ID,通过系统UUID生成。",
          "example": "d455a541-597e-4846-a6be-baad0ea361b1"
        },
        "clusterId": {
          "type": "string",
          "description": "集群ID。",
          "example": "4213d908-f5dc-4633-8401-cfd7175fca0c"
        },
        "obsBucket": {
          "type": "string",
          "description": "用于存储日志的OBS桶的桶名。",
          "example": "css-auto-test"
        },
        "agency": {
          "type": "string",
          "description": "委托名称,委托给CSS,允许CSS调用您的其他云服务。",
          "example": "css_obs_agency"
        },
        "updateAt": {
          "type": "integer",
          "format": "int64",
          "description": "更新时间。格式为:Unix时间戳格式。",
          "example": 1633663681055
        },
        "basePath": {
          "type": "string",
          "description": "日志在OBS桶中的备份路径。",
          "example": "css/log"
        },
        "autoEnable": {
          "type": "boolean",
          "description": "自动备份开关。\n- true: 自动备份开启。\n- false: 自动备份关闭。",
          "example": false
        },
        "period": {
          "type": "string",
          "description": "自动备份日志开始时间。当autoEnable为false时该字段为null。格式为:格林威治标准时间。",
          "example": "00:00 GMT+08:00"
        },
        "logSwitch": {
          "type": "boolean",
          "description": "日志开关。\n- true: 日志开启。\n- false: 日志关闭。",
          "example": true
        }
      }
    },
    "GetLogSettingResponseBody": {
      "properties": {
        "logConfiguration": {
          "$ref": "#/definitions/logConfiguration",
          "description": "日志配置实体对象。"
        },
        "realTimeLogCollectRecord": {
          "description": "日志实时采集的配置。",
          "$ref": "#/definitions/realTimeLogCollect"
        }
      },
      "description": "请求日志配置返回的实体对象。"
    },
    "realTimeLogCollect": {
      "type": "object",
      "required": [
        "createAt",
        "indexPrefix",
        "keepDays",
        "status",
        "targetClusterId",
        "updateAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "日志采集ID,通过系统UUID生成。"
        },
        "clusterId": {
          "type": "string",
          "description": "集群ID。"
        },
        "indexPrefix": {
          "type": "string",
          "example": "css-log",
          "description": "日志保存索引的前缀。"
        },
        "keepDays": {
          "type": "integer",
          "format": "int32",
          "example": 7,
          "description": "日志保存时间。",
          "minimum": 1,
          "maximum": 3650
        },
        "targetClusterId": {
          "type": "string",
          "example": "66f5cdfd-9285-4cae-9c90-fe4ccfa9322c",
          "description": "保存日志的目标集群ID。"
        },
        "status": {
          "type": "string",
          "example": "200",
          "description": "日志实时采集任务状态。"
        },
        "createAt": {
          "type": "integer",
          "format": "int64",
          "example": 1633663681055,
          "description": "日志实时采集任务开启时间。"
        },
        "updateAt": {
          "type": "integer",
          "format": "int64",
          "example": 1633663681055,
          "description": "日志实时采集任务更新时间。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "css.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
