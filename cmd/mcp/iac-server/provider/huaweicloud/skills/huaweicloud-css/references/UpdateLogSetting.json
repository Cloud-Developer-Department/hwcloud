  "definitions": {
    "UpdateLogSettingReq": {
      "properties": {
        "agency": {
          "type": "string",
          "description": "委托名称,委托给CSS,允许CSS调用您的其他云服务。",
          "example": "css_obs_agency"
        },
        "log_base_path": {
          "type": "string",
          "description": "日志在OBS桶中的备份路径。",
          "example": "css/log"
        },
        "log_bucket": {
          "type": "string",
          "description": "用于存储日志的OBS桶的桶名。",
          "example": "000-words"
        },
        "index_prefix": {
          "type": "string",
          "example": "css-log",
          "description": "设置保存日志的索引前缀。"
        },
        "keep_days": {
          "type": "integer",
          "format": "int32",
          "example": 7,
          "description": "修改日志保存的天数。"
        },
        "target_cluster_id": {
          "type": "string",
          "example": "4f3deec3-efa8-4598-bf91-560aad1377a3",
          "description": "设置保存日志的目标集群ID。"
        },
        "auto_enable": {
          "type": "boolean",
          "description": "集群日志是否开启自动备份。"
        },
        "period": {
          "type": "string",
          "description": "集群日志备份开始时间。"
        }
