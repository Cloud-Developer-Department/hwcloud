        "tags": [
          "日志管理接口"
        ],
        "summary": "开启日志备份或日志采集功能",
        "description": "该接口用于开启集群的日志备份或日志采集功能开关。",
        "operationId": "StartLogs",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "description": "项目ID。获取方法请参见[获取项目ID和名称](css_03_0071.xml)。",
            "required": true,
            "type": "string",
            "x-example": "6204a5bd270343b5885144cf9c8c158d"
          },
          {
            "in": "path",
            "name": "cluster_id",
            "description": "指定开启日志的集群ID。",
            "required": true,
            "type": "string",
            "x-example": "5c77b71c-5b35-4f50-8984-76387e42451a"
          },
          {
            "in": "query",
            "name": "action",
            "required": false,
            "description": "action支持base_log_collect和real_time_log_collect两种,base就是之前历史的能力,real_time为实时采集能力,默认不传就是base,兼容之前的逻辑",
            "type": "string",
            "default": "base_log_collect",
            "enum": [
              "base_log_collect",
              "real_time_log_collect"
            ]
          },
          {
            "in": "body",
            "name": "StartLogsReq",
            "required": true,
            "schema": {
              "$ref": "#/definitions/StartLogsReq"
            },
            "description": "开启日志请求体。"
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功。"
          },
          "400": {
            "description": "非法请求。\n\n建议直接修改该请求,不要重试该请求。"
          },
          "409": {
            "description": "服务器在完成请求时发生冲突。\n\n返回该状态码,表明客户端尝试创建的资源已经存在,或者由于冲突请求的更新操作不能被完成。"
          },
          "412": {
            "description": "未满足前提条件,服务器未满足请求者在请求中设置的其中一个前提条件。"
          }
        },
        "x-request-examples-url": "POST /v1.0/6204a5bd270343b5885144cf9c8c158d/clusters/5c77b71c-5b35-4f50-8984-76387e42451a/logs/open",
        "x-request-examples-1": {
          "agency": "css_obs_agency",
          "log_base_path": "css/log",
          "log_bucket": "000-words"
        }
      }
    }
  },
  "definitions": {
    "StartLogsReq": {
      "properties": {
        "agency": {
          "type": "string",
          "description": "委托名称,委托给CSS,允许CSS调用您的其他云服务。",
          "example": "css_obs_agency"
        },
        "log_base_path": {
          "type": "string",
          "description": "日志在OBS桶中的备份路径。",
          "example": "css/log"
        },
        "log_bucket": {
          "type": "string",
          "description": "用于存储日志的OBS桶的桶名。",
          "example": "000-words"
        },
        "auto_enable": {
          "type": "boolean",
          "description": "集群日志是否开启自动备份。"
        },
        "period": {
          "type": "string",
          "description": "集群日志备份开始时间。"
        },
        "index_prefix": {
          "type": "string",
          "description": "保存日志的索引前缀。action等于real_time_log_collect时必选",
          "example": "css-log"
        },
        "keep_days": {
          "type": "integer",
          "format": "int32",
          "description": "日志保存时间。action等于real_time_log_collect时必选",
          "example": 7,
          "minimum": 1,
          "maximum": 3650
        },
        "target_cluster_id": {
          "type": "string",
          "description": "保存日志的目标集群。action等于real_time_log_collect时必选",
          "example": "4f3deec3-efa8-4598-bf91-560aad1377a3"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
