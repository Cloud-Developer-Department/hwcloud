  "tags": "日志管理接口",
  "productshort": "CSS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1.0/{project_id}/clusters/{cluster_id}/logs/records": {
      "get": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "N",
        "x-publishpath": "",
        "tags": [
          "日志管理接口"
        ],
        "summary": "查询作业列表",
        "description": "该接口用于查询具体某个集群的日志任务记录列表。",
        "operationId": "ListLogsJob",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "description": "项目ID。获取方法请参见[获取项目ID和名称](css_03_0071.xml)。",
            "required": true,
            "type": "string",
            "x-example": "6204a5bd270343b5885144cf9c8c158d"
          },
          {
            "in": "path",
            "name": "cluster_id",
            "description": "指定查询集群ID。",
            "required": true,
            "type": "string",
            "x-example": "5c77b71c-5b35-4f50-8984-76387e42451a"
          },
          {
            "in": "query",
            "name": "offset",
            "description": "指定查询起始值,默认值为1,即从第1个任务开始查询。",
            "type": "integer",
            "x-example": 1,
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "description": "指定查询个数,默认值为10,即一次查询10个任务信息。",
            "type": "integer",
            "x-example": 10,
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功。",
            "examples": {
              "application/json": {
                "clusterLogRecord": [
                  {
                    "id": "d455a541-597e-4846-a6be-baad0ea361b1",
                    "clusterId": "4213d908-f5dc-4633-8401-cfd7175fca0c",
                    "createAt": 1656042837000,
                    "logPath": "css-backup-1610678043608/css/log",
                    "status": "RUNNING",
                    "finishedAt": null,
                    "jobTypes": "Manual",
                    "failedMsg": null,
                    "jobId": "2c9080df7c171342017c5e0884f8011c"
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListLogsJobResponseBody"
            }
          },
          "400": {
            "description": "非法请求。\n\n建议直接修改该请求,不要重试该请求。"
          },
          "409": {
            "description": "服务器在完成请求时发生冲突。\n\n返回该状态码,表明客户端尝试创建的资源已经存在,或者由于冲突请求的更新操作不能被完成。"
          },
          "412": {
            "description": "未满足前提条件,服务器未满足请求者在请求中设置的其中一个前提条件。"
          }
        },
        "x-request-examples-url": "GET /v1.0/6204a5bd270343b5885144cf9c8c158d/clusters/5c77b71c-5b35-4f50-8984-76387e42451a/logs/records"
      }
    }
  },
  "definitions": {
    "ListLogsJobResponseBody": {
      "properties": {
        "clusterLogRecord": {
          "items": {
            "$ref": "#/definitions/clusterLogRecord"
          },
          "type": "array"
        },
        "totalSize": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n日志记录总条数。\n**取值范围**:\n不涉及"
        }
      }
    },
    "clusterLogRecord": {
      "properties": {
        "id": {
          "type": "string",
          "description": "日志任务ID,通过系统UUID生成。",
          "example": "d455a541-597e-4846-a6be-baad0ea361b1"
        },
        "clusterId": {
          "type": "string",
          "description": "集群ID。",
          "example": "4213d908-f5dc-4633-8401-cfd7175fca0c"
        },
        "createAt": {
          "type": "string",
          "description": "创建时间。格式:Unix时间戳格式。",
          "example": 1656042837000
        },
        "logPath": {
          "type": "string",
          "description": "日志在OBS桶中的备份路径。",
          "example": "css-backup-1610678043608/css/log"
        },
        "status": {
          "type": "string",
          "description": "任务状态。\n- RUNNING: 备份行中。\n- SUCCESS: 备份成功。\n- FAIL: 备份失败。",
          "example": "RUNNING"
        },
        "finishedAt": {
          "type": "integer",
          "format": "int64",
          "description": "结束时间,当创建未结束时结束时间为null。格式:Unix时间戳格式。"
        },
        "jobTypes": {
          "type": "string",
          "description": "任务类型。\n- Manual: 手动备份。\n- Auto: 自动备份。",
          "example": "Manual"
        },
        "failedMsg": {
          "type": "string",
          "description": "错误信息。当任务状态没有处于失败状态时该字段为null。"
        },
        "jobId": {
          "type": "string",
          "description": "任务ID。",
          "example": "2c9080df7c171342017c5e0884f8011c"
        }
      },
      "description": "集群日志记录实体对象。"
    }
  },
