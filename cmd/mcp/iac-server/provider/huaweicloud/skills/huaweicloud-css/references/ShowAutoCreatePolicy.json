  "definitions": {
    "ShowPolicyResp": {
      "properties": {
        "keepday": {
          "type": "integer",
          "description": "快照保留的天数。"
        },
        "period": {
          "type": "string",
          "description": "每天快照创建时刻。"
        },
        "frequency": {
          "type": "string",
          "description": "自动创建快照的执行频次。"
        },
        "prefix": {
          "type": "string",
          "description": "快照命名前缀,需要用户自己手动输入。"
        },
        "bucket": {
          "type": "string",
          "description": "快照存放的OBS桶的桶名。"
        },
        "basePath": {
          "type": "string",
          "description": "快照在OBS桶中的存放路径。"
        },
        "agency": {
          "type": "string",
          "description": "访问OBS桶用到的委托。"
        },
        "enable": {
          "type": "string",
          "description": "是否开启自动创建快照策略。\n- true:表示开启自动创建快照策略。\n- false:表示关闭自动创建快照策略。"
        },
        "indices": {
          "type": "string",
          "description": "需要备份的索引名。"
        },
        "snapshotCmkId": {
          "type": "string",
          "description": "快照ID。"
        },
        "maxSnapshotBytesPerSeconds": {
          "type": "string",
          "description": "配置每个节点的最大备份速率(每秒),即当备份的速率超过该值时会被限流,避免速率太大导致资源占用过高,影响系统稳定性。实际备份速率不一定能达到该值,会受OBS、磁盘等影响。"
        },
        "maxRestoreBytesPerSeconds": {
          "type": "string",
          "description": "配置每个节点的最大恢复速率(每秒),即当恢复的速率超过该值时会被限流,避免速率太大导致资源占用过高,影响系统稳定性。实际恢复速率不一定能达到该值,会受OBS、磁盘等影响。"
        }
      }
    }
