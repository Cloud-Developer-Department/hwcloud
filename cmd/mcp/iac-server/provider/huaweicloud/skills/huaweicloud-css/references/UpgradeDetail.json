{
  "name": "UpgradeDetail",
  "summary": "获取集群升级或切换AZ的详情信息",
  "tags": "集群管理接口",
  "productshort": "CSS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1.0/{project_id}/clusters/{cluster_id}/upgrade/detail": {
      "get": {
        "x-request-examples-description-1": "集群升级请求示例",
