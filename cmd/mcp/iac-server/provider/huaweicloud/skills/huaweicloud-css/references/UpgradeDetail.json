  "definitions": {
    "CurrentNodeDetail": {
      "properties": {
        "order": {
          "type": "integer",
          "description": "升级任务序号。",
          "example": 0
        },
        "name": {
          "type": "string",
          "description": "升级任务名称。",
          "example": "Data migration"
        },
        "status": {
          "type": "string",
          "description": "当前任务状态。",
          "example": "SUCCESS"
        },
        "desc": {
          "type": "string",
          "description": "当前任务描述。",
          "example": "Data is migrated from a node to other nodes in the cluster by running the exclude command."
        },
        "beginTime": {
          "type": "string",
          "description": "当前任务开始时间。",
          "example": "2022-12-26T07:03:04"
        },
        "endTime": {
          "type": "string",
          "description": "当前任务结束时间。",
          "example": "2022-12-26T07:03:22"
        }
      },
      "description": "当前正在升级节点任务详情。"
    },
    "GetUpgradeDetail": {
      "properties": {
        "totalSize": {
          "type": "integer",
          "description": "下发执行接口次数。",
          "example": 1
        },
        "detailList": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GetUpgradeDetailInfo"
          }
        }
      }
    },
    "GetUpgradeDetailInfo": {
      "properties": {
        "id": {
          "type": "string",
          "description": "任务ID。",
          "example": "23e1985f-65bb-4450-b349-f6f1c3834c69"
        },
        "startTime": {
          "type": "string",
          "description": "升级开始时间。",
          "example": "2022-12-26T06:33:31"
        },
        "endTime": {
          "type": "string",
          "description": "升级结束时间。",
          "example": ""
        },
        "status": {
          "type": "string",
          "description": "任务状态。\n- RUNNING:升级中。\n- SUCCESS:升级成功。\n- FAILED:升级失败。\n- PARTIAL_FAILED:部分升级失败。",
          "example": "RUNNING"
        },
        "agencyName": {
          "type": "string",
          "description": "委托名称,委托给CSS,允许CSS调用您的其他云服务。",
          "example": "css_upgrade_agency"
        },
        "imageInfo": {
          "$ref": "#/definitions/GetTargetImageIdDetail"
        },
        "totalNodes": {
          "type": "string",
          "description": "所有需要升级的节点名称集合。",
          "example": "CSS_upgrade-ess-esn-3-1,CSS_upgrade-ess-esn-2-1,CSS_upgrade-ess-esn-1-1"
        },
        "completedNodes": {
          "type": "string",
          "description": "所有升级完成的节点名称集合。",
          "example": "CSS_upgrade-ess-esn-3-1,CSS_upgrade-ess-esn-1-1"
        },
        "currentNodeName": {
          "type": "string",
          "description": "当前正在升级的节点名称。",
          "example": "CSS_upgrade-ess-esn-2-1"
        },
        "executeTimes": {
          "type": "string",
          "description": "重试次数。",
          "example": 1
        },
        "migrateParam": {
          "type": "string",
          "description": "集群当前升级的行为。当有query参数时显示该返回值。",
          "example": "{\"instType\":\"ess\",\"migrateType\":\"az_migrate\",\"sourceAz\":\"cn-north-4a\",\"targetAz\":\"cn-north-4c\"}"
        },
        "finalAzInfoMap": {
          "type": "string",
          "description": "集群升级预期结果。当有query参数时显示该返回值。",
          "example": "{\"cn-north-7c\":\"css-test-ess-esn-2-1,css-test-ess-esn-1-1,css-test-ess-esn-3-1\"}"
        },
        "currentNodeDetail": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CurrentNodeDetail"
          }
        },
        "batchSize": {
          "type": "integer",
          "format": "int32",
          "description": "同时有多少个节点在迁移数据。"
        },
        "currentBatchNodes": {
          "type": "string",
          "description": "当前正在迁移数据的节点。"
        }
      },
      "description": "升级任务详情。"
    },
    "GetTargetImageIdDetail": {
      "properties": {
        "id": {
          "type": "string",
          "description": "可以升级的目标镜像ID。",
          "example": "bcdb711c-a7f0-4007-b8ee-9f13c05f8326"
        },
        "displayName": {
          "type": "string",
          "description": "可以升级的目标镜像名称。",
          "example": "7.10.2_22.5.1_1214"
        },
        "imageDesc": {
          "type": "string",
          "description": "镜像描述信息。",
          "example": "The latest image of version 7.10.2 will be officially released on December 14, 2022. the stability of the cluster has been optimized. It is recommended that you upgrade to this version."
        },
        "datastoreType": {
          "type": "string",
          "description": "镜像引擎类型。",
          "example": "elasticsearch"
        },
        "datastoreVersion": {
          "type": "string",
          "description": "镜像引擎版本。",
          "example": "7.10.2"
        },
        "priority": {
          "type": "integer",
          "description": "优先级。",
          "example": 15
        }
      },
      "description": "镜像详情信息。"
    }
  },
