        "x-publishpath": "",
        "tags": [
          "集群管理接口"
        ],
        "summary": "获取集群升级或切换AZ的详情信息",
        "description": "由于升级过程时间较长,该接口可以展示当前升级(切换AZ)节点的各个阶段信息。",
        "operationId": "UpgradeDetail",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "description": "项目ID。获取方法请参见[获取项目ID和名称](css_03_0071.xml)。",
            "required": true,
            "type": "string",
            "x-example": "6204a5bd270343b5885144cf9c8c158d"
          },
          {
            "in": "path",
            "name": "cluster_id",
            "description": "待升级的集群的ID。",
            "required": true,
            "type": "string",
            "x-example": "ea244205-d641-45d9-9dcb-ab2236bcd07e"
          },
          {
            "in": "query",
            "name": "offset",
            "description": "偏移量。 偏移量为一个大于0小于终端节点服务总个数的整数, 表示从偏移量后面的终端节点服务开始查询。",
            "required": false,
            "type": "integer",
            "x-example": 0
          },
          {
            "in": "query",
            "name": "limit",
            "description": "查询返回终端节点服务的连接列表限制每页个数,即每页返回的个数。",
            "required": false,
            "type": "integer",
            "x-example": 10
          },
          {
            "in": "query",
            "name": "action_mode",
            "description": "查询升级行为。\n- 查询集群版本升级详情:不填写该参数。\n- 查询切换AZ详情:当前仅支持AZ_MIGRATION。",
            "required": false,
            "type": "string",
            "x-example": "AZ_MIGRATION"
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功。",
            "schema": {
              "$ref": "#/definitions/GetUpgradeDetail"
            },
