        "x-request-examples-description-2": "集群升级请求示例",
        "x-request-examples-url-2": "GET /v1.0/6204a5bd270343b5885144cf9c8c158d/clusters/ea244205-d641-45d9-9dcb-ab2236bcd07e/upgrade/detail?action_mode=AZ_MIGRATION",
