  "definitions": {
    "ClusterDetailFailedReasons": {
      "properties": {
        "errorCode": {
          "type": "string",
          "description": "错误码。\n\n- CSS.6000:表示集群创建失败。\n- CSS.6001:表示集群扩容失败。\n- CSS.6002:表示集群重启失败。\n- CSS.6004:表示集群节点创建失败。\n- CSS.6005:表示服务初始化失败。"
        },
        "errorMsg": {
          "type": "string",
          "description": "详细错误信息。"
        }
      },
