          "type": "string",
          "description": "节点所属AZ信息。"
        },
        "ip": {
          "type": "string",
          "description": "实例ip信息。"
        },
        "volume": {
          "$ref": "#/definitions/ShowClusterVolumeRsp"
        },
        "subnetId": {
          "type": "string",
          "description": "当前节点所属子网ID。"
        }
      },
      "type": "object"
    },
    "SnapshotPolicyResp": {
      "type": "object",
