        },
        "resourceId": {
          "type": "string",
          "description": "该实例对应的资源Id。"
        },
        "type": {
          "type": "string",
          "description": "当前节点的类型。",
          "pattern": "ess"
        },
        "id": {
          "type": "string",
          "description": "实例ID。"
        },
        "name": {
          "type": "string",
          "description": "实例名字。"
