    "ListRetirableGrantsRequestBody": {
      "properties": {
        "limit": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4,
          "description": "指定查询可退役授权返回记录条数,如果查询记录条数小于存在的条数,响应参数“truncated”将返回“true”,表示存在分页。\n取值在授权最大个数范围以内。例如:100"
        },
        "marker": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4,
          "description": "分页查询起始位置标识。\n分页查询收到的响应参数“truncated”为“true”时,可以发送连续的请求获取更多的记录条数,“marker”设置为响应的“next_marker”的值。例如:10。"
        },
        "sequence": {
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "description": "请求消息序列号,36字节序列号。\n例如:919c82d4-8046-4722-9094-35c3c6524cff"
        }
      }
    },
    "Grants": {
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "密钥ID。"
        },
        "grant_id": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "description": "授权ID,64字节。"
        },
        "grantee_principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "被授权用户ID,1~64字节,满足正则匹配“^[a-zA-Z0-9]{1,64}$”。\n例如:0d0466b00d0466b00d0466b00d0466b0"
        },
        "grantee_principal_type": {
          "type": "string",
          "enum": [
            "user",
            "domain"
          ],
          "description": "授权类型。\n有效值:“user”,“domain”。"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "description": "授权允许的操作列表。\n有效的值:“create-datakey”,“create-datakey-without-plaintext”,“encrypt-datakey”,“decrypt-datakey”,“describe-key”,“create-grant”,“retire-grant”,“encrypt-data”,“decrypt-data”。\n有效值不能仅为“create-grant”。\n - “create-datakey” 创建数据密钥\n - “create-datakey-without-plaintext” 创建不含明文数据密钥\n - “encrypt-datakey” 加密数据密钥\n - “decrypt-datakey” 解密数据密钥\n - “describe-key” 查询密钥信息\n - “retire-grant” 退役授权\n - “encrypt-data” 加密数据\n - “decrypt-data” 解密数据",
          "items": {
            "type": "string"
          }
        },
        "issuing_principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "创建授权用户ID,1~64字节,满足正则匹配“^[a-zA-Z0-9]{1,64}$”。\n例如:0d0466b00d0466b00d0466b00d0466b0"
        },
        "creation_date": {
          "type": "string",
          "minLength": 0,
          "maxLength": 13,
          "description": "创建时间,时间戳,即从1970年1月1日至该时间的总秒数。\n例如:1497341531000"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "授权名字,取值1到255字符,满足正则匹配“^[a-zA-Z0-9:/_-]{1,255}$”。"
        },
        "retiring_principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "可退役授权的用户ID,1~64字节,满足正则匹配“^[a-zA-Z0-9]{1,64}$”。\n例如:0d0466b00d0466b00d0466b00d0466b0"
        }
      }
