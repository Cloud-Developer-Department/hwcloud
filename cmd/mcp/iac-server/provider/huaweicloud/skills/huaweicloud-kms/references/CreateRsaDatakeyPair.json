          "maxLength": 36
        },
        "key_spec": {
          "type": "string",
          "description": "需要包含算法、长度、曲线信息。可选值有RSA_2048 | RSA_3072 | RSA_4096",
          "enum": [
            "RSA_2048",
            "RSA_3072",
            "RSA_4096"
          ]
        },
        "with_plain_text": {
          "type": "boolean",
          "description": "是否返回明文私钥,默认为true",
          "default": true
        },
        "additional_authenticated_data": {
          "type": "string",
          "description": "认证加密的额外信息,请不要填写敏感信息",
          "minLength": 0,
          "maxLength": 127
        },
        "sequence": {
          "type": "string",
          "description": "请求消息序列号,36字节序列号。\n例如:919c82d4-8046-4722-9094-35c3c6524cff",
          "minLength": 0,
          "maxLength": 36
        }
      }
    },
    "CreateDataKeyPairResponseBody": {
      "type": "object",
      "required": [
        "key_id",
        "private_key_cipher_text",
        "public_key"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "description": "密钥ID。",
          "minLength": 36,
          "maxLength": 36
        },
        "key_spec": {
          "type": "string",
          "description": "需要包含算法、长度、曲线信息。可选值有RSA_2048 | RSA_3072 | RSA_4096 | ECC_NIST_P256 | ECC_NIST_P384 | ECC_NIST_P521 | ECC_SECG_P256K1 | SM2",
          "enum": [
            "RSA_2048",
            "RSA_3072",
            "RSA_4096",
            "ECC_NIST_P256",
            "ECC_NIST_P384",
            "ECC_NIST_P521",
            "ECC_SECG_P256K1",
            "SM2"
          ]
        },
