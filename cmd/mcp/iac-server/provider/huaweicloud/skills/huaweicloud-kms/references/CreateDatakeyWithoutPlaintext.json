  "definitions": {
    "Error": {
      "properties": {
        "error": {
          "description": "错误信息返回体。",
          "items": {
            "$ref": "#/definitions/ErrorDetail"
          }
        }
      }
    },
    "CreateDatakeyRequestBody": {
      "required": [
        "key_id"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "密钥ID,36字节,满足正则匹配“^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$”。\n例如:0d0466b0-e727-4d9c-b35d-f84bb474a37f。"
        },
        "key_spec": {
          "type": "string",
          "enum": [
            "AES_256",
            "AES_128",
            "SM4",
            "HMAC_256",
            "HMAC_384",
            "HMAC_512",
            "HMAC_SM3"
          ],
          "description": "指定生成的密钥bit位长度。有效值:AES_256、AES_128、SM4、HMAC_256、HMAC_384、HMAC_512、HMAC_SM3。\n - AES_256:表示256比特的对称密钥。\n - AES_128:表示128比特的对称密钥。\n - SM4:表示SM4密钥。\n - HMAC_256:表示HMAC_256密钥。\n - HMAC_384:表示HMAC_384密钥。\n - HMAC_512:表示HMAC_512密钥。\n - HMAC_SM3:表示HMAC_SM3密钥。   \n 说明:\n datakey_length和key_spec二选一。\n  - 若datakey_length和key_spec都为空,默认生成256bit的密钥。\n  - 若datakey_length和key_spec都指定了值,仅datakey_length生效。"
        },
        "datakey_length": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "description": "密钥bit位长度。取值为8的倍数,取值范围为8~8192。\n说明:\n datakey_length和key_spec二选一。\n  - 若datakey_length和key_spec都为空,默认生成256bit的密钥。\n  - 若datakey_length和key_spec都指定了值,仅datakey_length生效。"
        },
        "additional_authenticated_data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "身份验证的非敏感额外数据。任意字符串,长度不超过128字节。"
        },
        "sequence": {
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "description": "请求消息序列号,36字节序列号。\n例如:919c82d4-8046-4722-9094-35c3c6524cff"
        },
        "pin": {
          "type": "string",
          "description": "pin码,用于数据密钥的认证,仅四级密评场景生效"
        },
        "pin_type": {
          "type": "string",
          "description": "pin码的类型,默认为“CipherText”:\n- PlainText:表示明文pin\n- CipherText:表示密文pin",
          "default": "CipherText",
          "enum": [
            "CipherText",
            "PlainText"
          ]
        }
      }
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    },
    "CreateDatakeyWithoutPlaintextResponseBody": {
      "properties": {
        "key_id": {
          "minLength": 36,
          "maxLength": 36,
          "type": "string",
          "description": "密钥ID。"
        },
        "cipher_text": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8192,
          "description": "DEK密文16进制,两位表示1byte。"
        }
      }
    }
  },
