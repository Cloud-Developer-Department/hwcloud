  "definitions": {
    "DeriveSharedSecretResponseBody": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string",
          "description": "密钥ID",
          "minLength": 36,
          "maxLength": 36
        },
        "key_agreement_algorithm": {
          "type": "string",
          "description": "密钥协商算法"
        },
        "shared_secret": {
          "type": "string",
          "description": "由KMS私钥和您的对端公钥协商出的密钥,Base64格式,如果响应体包含了ciphertext_recipient,则不会包含shared_secret"
        },
        "ciphertext_recipient": {
          "type": "string",
          "description": "KMS私钥和您的对端公钥协商出的密钥经过擎天证明文档加密后的密文,密文仅能被机密环境中的私钥解密,指定擎天证明文档后,才会响应ciphertext_recipient,否则通过shared_secret响应明文的共享密钥"
        }
      },
      "required": [
        "key_id",
        "key_agreement_algorithm"
      ]
    },
    "Recipient": {
      "type": "object",
      "description": "擎天机密计算请求体",
      "properties": {
        "attestation_document": {
          "type": "string",
          "description": "擎天机密计算证明文档"
        },
        "key_encryption_algorithm": {
          "type": "string",
          "description": "指定加密算法,仅支持RSAES_OAEP_SHA_256"
        }
      }
    },
    "DeriveSharedSecretRequestBody": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string",
          "description": "密钥ID",
          "minLength": 36,
          "maxLength": 36
        },
        "key_agreement_algorithm": {
          "type": "string",
          "enum": [
            "ECDH"
          ],
          "description": "密钥协商算法,仅支持ECDH"
        },
        "public_key": {
          "type": "string",
          "description": "对端密钥对的的公钥,您需要保证是EC_P256,EC_384,SECP256K1或SM2(仅中国区域支持)密钥对的公钥。公钥的格式必须是DER-encoded X.509类型的Base64的字符串"
        },
        "recipient": {
          "description": "擎天加密计算",
          "$ref": "#/definitions/Recipient"
        }
      },
      "required": [
        "key_id",
        "key_agreement_algorithm",
        "public_key"
      ]
    }
