{
  "name": "ImportKeyMaterial",
  "summary": "导入密钥材料",
  "tags": "导入密钥管理",
  "productshort": "KMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1.0/{project_id}/kms/import-key-material": {
      "post": {
        "tags": [
          "导入密钥管理"
        ],
        "summary": "导入密钥材料",
        "description": "- 功能介绍:导入密钥材料。",
        "operationId": "ImportKeyMaterial",
        "produces": [
          "application/json"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "ImportKeyMaterialRequestBody",
            "in": "body",
            "description": "import_key_material",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ImportKeyMaterialRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功"
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "x-request-examples-1": {
          "key_id": "0d0466b0-e727-4d9c-b35d-f84bb474a37f",
          "import_token": "AACIBjY2ZTQxYItNDU4Ny04OTIxLWVhZTVhZjg5NDZm....",
          "encrypted_key_material": "e0wTU/YJT/HDxsEv2NE+3CKT1..."
        }
      }
    }
  },
  "definitions": {
    "Error": {
      "properties": {
        "error": {
          "description": "错误信息返回体。",
          "items": {
            "$ref": "#/definitions/ErrorDetail"
          }
        }
      }
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    },
    "ImportKeyMaterialRequestBody": {
      "required": [
        "key_id",
        "encrypted_key_material",
        "import_token"
      ],
      "properties": {
        "key_id": {
          "minLength": 36,
          "maxLength": 36,
          "type": "string",
          "description": "密钥ID,36字节,满足正则匹配“^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$”。\n例如:0d0466b0-e727-4d9c-b35d-f84bb474a37f。"
        },
        "import_token": {
          "type": "string",
          "pattern": "^[0-9a-zA-Z+/=]{200,6144}$",
          "description": "密钥导入令牌,base64格式,满足正则匹配“^[0-9a-zA-Z+/=]{200,6144}$”。"
        },
        "encrypted_key_material": {
          "type": "string",
          "pattern": "^[0-9a-zA-Z+/=]{344,360}$",
          "description": "加密后的对称密钥材料,base64格式,满足正则匹配“^[0-9a-zA-Z+/=]{344,360}$”。若导入非对称密钥,则该参数为用于加密私钥的临时中间密钥。"
        },
        "encrypted_privatekey": {
          "type": "string",
          "pattern": "^[0-9a-zA-Z+/=]{200,6144}$",
          "description": "使用临时中间密钥加密后的私钥,导入非对称密钥需要该参数,base64格式,满足正则匹配“^[0-9a-zA-Z+/=]{200,6144}$”。"
        },
        "expiration_time": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 10000000000,
          "description": "密钥材料到期时间,时间戳,即从1970年1月1日至该时间的总秒数,KMS会在该时间的24小时内删除密钥材料。\n例如:1550291833"
        },
        "sequence": {
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "description": "请求消息序列号,36字节序列号。\n例如:919c82d4-8046-4722-9094-35c3c6524cff"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
