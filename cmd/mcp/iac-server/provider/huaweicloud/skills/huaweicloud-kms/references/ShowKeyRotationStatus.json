  "definitions": {
    "GetkeyRotationStatusResponseBody": {
      "properties": {
        "key_rotation_enabled": {
          "type": "boolean",
          "description": "密钥轮换状态,默认为“false”,表示关闭密钥轮换功能。"
        },
        "rotation_interval": {
          "type": "integer",
          "format": "int32",
          "minimum": 30,
          "maximum": 365,
          "description": "轮换周期,取值范围为30~365的整数。\n周期范围设置根据密钥使用频率进行,若密钥使用频率高,建议设置为短周期;反之,则设置为长周期。"
        },
        "last_rotation_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 13,
          "description": "上一次密钥轮换时间。时间戳,即从1970年1月1日至该时间的总秒数。"
        },
        "number_of_rotations": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 1000,
          "description": "密钥轮换次数。"
        }
      }
    },
    "Error": {
      "properties": {
        "error": {
          "description": "错误信息返回体。",
          "items": {
            "$ref": "#/definitions/ErrorDetail"
          }
        }
      }
    },
    "OperateKeyRequestBody": {
      "required": [
        "key_id"
      ],
      "properties": {
        "key_id": {
          "minLength": 36,
          "maxLength": 36,
          "type": "string",
          "description": "密钥ID,36字节,满足正则匹配“^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$”。\n例如:0d0466b0-e727-4d9c-b35d-f84bb474a37f。"
        },
        "sequence": {
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "description": "请求消息序列号,36字节序列号。\n例如:919c82d4-8046-4722-9094-35c3c6524cff"
        }
      }
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    }
