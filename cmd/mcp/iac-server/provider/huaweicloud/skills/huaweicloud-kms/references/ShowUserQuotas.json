{
  "name": "ShowUserQuotas",
  "summary": "查询配额",
  "tags": "密钥查询",
  "productshort": "KMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1.0/{project_id}/kms/user-quotas": {
      "get": {
        "tags": [
          "密钥查询"
        ],
        "summary": "查询配额",
        "description": "- 功能介绍:查询配额,查询用户可以创建的用户主密钥配额总数及当前使用量信息。",
        "operationId": "ShowUserQuotas",
        "produces": [
          "application/json"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "schema": {
              "$ref": "#/definitions/UserQuotasResponseBody"
            },
            "examples": {
              "application/json": {
                "quotas": {
                  "resources": [
                    {
                      "quota": 20,
                      "used": 20,
                      "type": "CMK"
                    },
                    {
                      "quota": 100,
                      "used": 0,
                      "type": "grant_per_CMK"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Resources": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "CMK",
            "grant_per_CMK"
          ],
          "description": "配额类型。枚举值说明:\n - CMK,用户主密钥\n - grant_per_CMK,单个用户主密钥可创建授权数"
        },
        "used": {
          "type": "integer",
          "description": "已使用配额数。",
          "format": "int32",
          "minimum": 0,
          "maximum": 100
        },
        "quota": {
          "type": "integer",
          "description": "配额总数。",
          "format": "int32",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "Quotas": {
      "description": "配额详情。",
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "description": "资源配额列表,详情请参见Resources",
          "items": {
            "$ref": "#/definitions/Resources"
          }
        }
      }
    },
    "Error": {
      "properties": {
        "error": {
          "description": "错误信息返回体。",
          "items": {
            "$ref": "#/definitions/ErrorDetail"
          }
        }
      }
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    },
    "UserQuotasResponseBody": {
      "properties": {
        "quotas": {
          "$ref": "#/definitions/Quotas"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}