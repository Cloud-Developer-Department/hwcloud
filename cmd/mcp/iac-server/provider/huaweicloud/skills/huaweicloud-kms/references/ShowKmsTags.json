    "TagItem": {
      "description": "标签。",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "键。\n最大长度36个unicode字符。 key不能为空。不能包含非打印字符“ASCII(0-31)”、“*”、“<”、“>”、“\\”、“=”。"
        },
        "value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 43,
