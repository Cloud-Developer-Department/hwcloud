{
  "name": "CreateKeyStore",
  "summary": "创建专属密钥库",
  "tags": "专属密钥库管理",
  "productshort": "KMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1.0/{project_id}/keystores": {
      "post": {
        "tags": [
          "专属密钥库管理"
        ],
        "summary": "创建专属密钥库",
        "description": "- \"创建租户专属密钥库,专属密钥库使用DHSM实例作为密钥的存储\"",
        "operationId": "CreateKeyStore",
        "produces": [
          "application/json"
        ],
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "type": "string",
            "description": "项目ID",
            "minLength": 32,
            "maxLength": 32,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "CreateKeyStoreRequestBody",
            "in": "body",
            "description": "创建专属密钥库请求体",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateKeyStoreRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "schema": {
              "$ref": "#/definitions/CreateKeyStoreResponseBody"
            },
            "examples": {
              "application/json": {
                "keystore": {
                  "keystore_id": "bb6a3d22-dc93-47ac-b5bd-88df7ad35f1e",
                  "domain_id": "b168fe00ff56492495a7d22974df2d0b"
                }
              }
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "x-request-examples-1": {
          "keystore_alias": "keystore_alia1",
          "hsm_cluster_id": "hsm_cluster_id",
          "hsm_ca_cert": "-----BEGIN CERTIFICATE---******----END CERTIFICATE-----"
        }
      }
    }
  },
  "definitions": {
    "CreateKeyStoreResponseBody": {
      "description": "创建专属密钥库响应体",
      "properties": {
        "keystore": {
          "description": "密钥库信息。",
          "$ref": "#/definitions/KeystoreInfo"
        }
      }
    },
    "Error": {
      "properties": {
        "error": {
          "description": "错误信息返回体。",
          "items": {
            "$ref": "#/definitions/ErrorDetail"
          }
        }
      }
    },
    "CreateKeyStoreRequestBody": {
      "description": "创建专属密钥库请求体",
      "required": [
        "keystore_alias"
      ],
      "properties": {
        "keystore_alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9:/_-]{1,255}$",
          "description": "专属密钥库别名,取值范围为1到255个字符,满足正则匹配“^[a-zA-Z0-9:/_-]{1,255}$”,且不与已有的专属密钥库别名重名。"
        },
        "hsm_cluster_id": {
          "type": "string",
          "description": "DHSM集群Id,要求集群当前未创建专属密钥库。"
        },
        "hsm_ca_cert": {
          "type": "string",
          "description": "DHSM集群的CA证书"
        },
        "cluster_id": {
          "type": "string",
          "description": "集群ID。当类型为DHSM时,cluster_id为hsm_cluster_id。当类型为CDMS时,为cdms_cluster_id"
        },
        "keystore_type": {
          "type": "string",
          "description": "专属密钥库集群类型。DHSM表示专属加密服务集群,CDMS表示密码卡集群,DEFAULT表示KMS原有集群",
          "enum": [
            "DEFAULT",
            "DHSM",
            "CDMS"
          ]
        }
      },
      "type": "object"
    },
    "KeystoreInfo": {
      "properties": {
        "keystore_id": {
          "type": "string",
          "description": "密钥库ID"
        },
        "domain_id": {
          "type": "string",
          "description": "用户域ID"
        }
      }
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}