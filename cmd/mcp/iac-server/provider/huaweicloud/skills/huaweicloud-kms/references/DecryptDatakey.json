      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "密钥ID,36字节,满足正则匹配“^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$”。\n例如:0d0466b0-e727-4d9c-b35d-f84bb474a37f。"
        },
        "cipher_text": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8192,
          "description": "DEK密文及元数据的16进制字符串。取值为加密数据密钥结果中的cipher_text的值。"
        },
        "datakey_cipher_length": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "description": "密钥字节长度,取值范围为1~1024。\n密钥字节长度,取值为“64”。"
        },
        "additional_authenticated_data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "身份验证的非敏感额外数据。任意字符串,长度不超过128字节。"
        },
        "sequence": {
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "description": "请求消息序列号,36字节序列号。\n例如:919c82d4-8046-4722-9094-35c3c6524cff"
        }
      }
    },
