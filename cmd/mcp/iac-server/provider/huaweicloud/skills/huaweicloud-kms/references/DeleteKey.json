          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "x-request-examples-1": {
          "key_id": "0d0466b0-e727-4d9c-b35d-f84bb474a37f",
          "pending_days": "7"
        }
      }
    }
  },
  "definitions": {
    "Error": {
      "properties": {
        "error": {
          "description": "错误信息返回体。",
          "items": {
            "$ref": "#/definitions/ErrorDetail"
          }
        }
      }
    },
    "ScheduleKeyDeletionRequestBody": {
      "required": [
        "key_id",
        "pending_days"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "密钥ID,36字节,满足正则匹配“^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$”。\n例如:0d0466b0-e727-4d9c-b35d-f84bb474a37f。"
        },
        "pending_days": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "description": "计划多少天后删除密钥,取值为7到1096。"
        },
        "sequence": {
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "description": "请求消息序列号,36字节序列号。\n例如:919c82d4-8046-4722-9094-35c3c6524cff"
        }
      }
    },
    "KeyStatusInfo": {
      "description": "密钥状态信息。",
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "密钥ID"
        },
        "key_state": {
          "type": "string",
          "pattern": "^[1-5]{1}$",
          "description": "密钥状态:\n- 2为启用状态\n- 3为禁用状态\n- 4为计划删除状态\n- 5为等待导入状态\n- 7为冻结状态"
        }
      }
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    }
