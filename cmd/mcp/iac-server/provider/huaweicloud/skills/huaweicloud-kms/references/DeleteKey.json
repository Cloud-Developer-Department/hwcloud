{
  "name": "DeleteKey",
  "summary": "计划删除密钥",
  "tags": "密钥生命周期管理",
  "productshort": "KMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1.0/{project_id}/kms/schedule-key-deletion": {
      "post": {
        "tags": [
          "密钥生命周期管理"
        ],
        "summary": "计划删除密钥",
        "description": "- 功能介绍:计划多少天后删除密钥,可设置7天~1096天内删除密钥。",
        "operationId": "DeleteKey",
        "produces": [
          "application/json"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "DeleteKeyRequestBody",
            "in": "body",
            "description": "schedule_key_deletion",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ScheduleKeyDeletionRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
