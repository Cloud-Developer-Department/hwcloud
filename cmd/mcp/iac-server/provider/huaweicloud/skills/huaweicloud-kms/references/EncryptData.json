  "paths": {
    "/v1.0/{project_id}/kms/encrypt-data": {
      "post": {
        "tags": [
          "小数据加解密"
        ],
        "summary": "加密数据",
        "description": "- 功能介绍:加密数据,用指定的用户主密钥加密数据。",
        "x-constraint": "- 使用非对称密钥加密数据时,请记录选择的密钥ID和加密算法。解密数据时,您将需要提供相同的密钥ID和加密算法。如果指定的密钥和加密算法与用于加密数据的值不匹配,解密操作将失败。\n- 使用对称密钥解密时,不需要提供密钥ID和加密算法,KMS会将此信息存储在密文中。KMS无法将元数据存储在使用非对称密钥生成的密文中,非对称密钥密文的标准格式不包括可配置字段。",
        "operationId": "EncryptData",
        "produces": [
          "application/json"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
