  "definitions": {
    "Error": {
      "properties": {
        "error": {
          "description": "错误信息返回体。",
          "items": {
            "$ref": "#/definitions/ErrorDetail"
          }
        }
      }
    },
    "EncryptDataRequestBody": {
      "required": [
        "key_id",
        "plain_text"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "密钥ID,36字节,满足正则匹配“^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$”。\n例如:0d0466b0-e727-4d9c-b35d-f84bb474a37f。"
        },
        "plain_text": {
          "type": "string",
          "pattern": "^.{1,4096}$",
          "description": "明文数据,1~4096字节,满足正则匹配“^.{1,4096}$”,且转化为byte数组后长度取值范围为1~4096字节。"
        },
        "encryption_algorithm": {
          "type": "string",
          "enum": [
            "SYMMETRIC_DEFAULT",
            "RSAES_OAEP_SHA_256",
            "SM2_ENCRYPT"
          ],
          "description": "数据加密算法,仅使用非对称密钥需要指定该参数,默认值为“SYMMETRIC_DEFAULT”,合法枚举值如下:\n - SYMMETRIC_DEFAULT\n - RSAES_OAEP_SHA_256\n - SM2_ENCRYPT"
        },
        "additional_authenticated_data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "身份验证的非敏感额外数据。任意字符串,长度不超过128字节。"
        },
        "sequence": {
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "description": "请求消息序列号,36字节序列号。\n例如:919c82d4-8046-4722-9094-35c3c6524cff"
        }
      }
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    },
    "CreateDatakeyWithoutPlaintextResponseBody": {
      "properties": {
        "key_id": {
          "minLength": 36,
          "maxLength": 36,
          "type": "string",
          "description": "密钥ID。"
        },
        "cipher_text": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8192,
          "description": "DEK密文16进制,两位表示1byte。"
        }
      }
    }
