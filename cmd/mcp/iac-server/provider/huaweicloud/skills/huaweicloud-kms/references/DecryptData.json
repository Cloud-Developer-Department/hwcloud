{
  "name": "DecryptData",
  "summary": "解密数据",
  "tags": "小数据加解密",
  "productshort": "KMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1.0/{project_id}/kms/decrypt-data": {
      "post": {
        "tags": [
          "小数据加解密"
        ],
        "summary": "解密数据",
        "description": "- 功能介绍:解密数据。",
        "x-constraint": "- 解密非对称密钥加密的数据时,需要指定密钥ID和加密算法。如果指定的密钥和加密算法与用于加密数据的值不匹配,解密操作将失败。",
        "operationId": "DecryptData",
        "produces": [
          "application/json"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "DecryptDataRequestBody",
            "in": "body",
            "description": "decrypt_data",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DecryptDataRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "schema": {
              "$ref": "#/definitions/DecryptDataResponseBody"
            },
            "examples": {
              "application/json": {
                "key_id": "bb6a3d22-dc93-47ac-b5bd-88df7ad35f1e",
                "plain_text": "hello world",
                "plain_text_base64": "aGVsbG8gd29ybGQ="
              }
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "x-request-examples-1": {
          "cipher_text": "AgDoAG7EsEc2OHpQxz4gDFDH54Cqwaelxxxxxxx",
          "encryption_algorithm": "SYMMETRIC_DEFAULT",
          "additional_authenticated_data": "123aad"
        }
      }
    }
  },
  "definitions": {
    "DecryptDataRequestBody": {
      "required": [
        "cipher_text"
      ],
      "properties": {
        "cipher_text": {
          "type": "string",
          "pattern": "^[0-9a-zA-Z+/=]{128,5648}$",
          "description": "被加密数据密文。取值为加密数据结果中的cipher_text的值,满足正则匹配“^[0-9a-zA-Z+/=]{128,5648}$”。"
        },
        "encryption_algorithm": {
          "type": "string",
          "enum": [
            "SYMMETRIC_DEFAULT",
            "RSAES_OAEP_SHA_256",
            "SM2_ENCRYPT"
          ],
          "description": "数据加密算法,仅使用非对称密钥需要指定该参数,默认值为“SYMMETRIC_DEFAULT”,合法枚举值如下:\n - SYMMETRIC_DEFAULT\n - RSAES_OAEP_SHA_256\n - SM2_ENCRYPT"
        },
        "key_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "密钥ID,36字节,满足正则匹配“^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$”。仅当密文使用非对称密钥加密时才需要此参数。\n例如:0d0466b0-e727-4d9c-b35d-f84bb474a37f。"
        },
        "additional_authenticated_data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "身份验证的非敏感额外数据。任意字符串,长度不超过128字节。"
        },
        "sequence": {
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "description": "请求消息序列号,36字节序列号。\n例如:919c82d4-8046-4722-9094-35c3c6524cff"
        }
      }
    },
    "Error": {
      "properties": {
        "error": {
          "description": "错误信息返回体。",
          "items": {
            "$ref": "#/definitions/ErrorDetail"
          }
        }
      }
    },
    "DecryptDataResponseBody": {
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "密钥ID。"
        },
        "plain_text": {
          "type": "string",
          "pattern": "^.{1,4096}$",
          "description": "明文。"
        },
        "plain_text_base64": {
          "type": "string",
          "pattern": "^[0-9a-zA-Z+/=]{0,6144}$",
          "description": "明文的Base64值,在非对称加密场景下,若加密的明文中含有不可见字符,则解密结果以该值为准。"
        }
      }
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}