    "EncryptDatakeyRequestBody": {
      "required": [
        "key_id",
        "plain_text",
        "datakey_plain_length"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "密钥ID,36字节,满足正则匹配“^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$”。\n例如:0d0466b0-e727-4d9c-b35d-f84bb474a37f。"
        },
        "plain_text": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8192,
          "description": "CMK为AES时,DEK明文和DEK明文的SHA256(32字节);CMK为SM4时,DEK明文和DEK明文的SM3(32字节),均为16进制字符串表示。"
        },
        "datakey_plain_length": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "description": "DEK明文字节长度,取值范围为1~1024。\nDEK明文字节长度,取值为“64”。"
        },
        "additional_authenticated_data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "身份验证的非敏感额外数据。任意字符串,长度不超过128字节。"
        },
        "sequence": {
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "description": "请求消息序列号,36字节序列号。\n例如:919c82d4-8046-4722-9094-35c3c6524cff"
        },
        "pin": {
          "type": "string",
          "description": "指定PIN码保护。仅四级密评场景支持该参数。"
        },
        "pin_type": {
          "type": "string",
          "description": "pin码的类型,默认为“CipherText”,可选“PlainText”。仅四级密评场景支持该参数。"
        },
        "key_spec": {
          "type": "string",
          "enum": [
            "SM2",
            "RSA"
          ],
          "description": "指定待加密数据密钥的类型,仅四级密评场景生效。有效值: SM2、RSA。"
        }
      }
    },
    "EncryptDataKeyResponseBody": {
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "description": "密钥ID"
        },
        "cipher_text": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8192,
          "description": "DEK密文16进制,两位表示1byte。"
        },
        "datakey_length": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "description": "DEK字节长度。"
        }
