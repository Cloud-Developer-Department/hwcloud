{
  "name": "ListKeyDetail",
  "summary": "查询密钥信息",
  "tags": "密钥查询",
  "productshort": "KMS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1.0/{project_id}/kms/describe-key": {
      "post": {
        "tags": [
          "密钥查询"
        ],
        "summary": "查询密钥信息",
        "description": "- 功能介绍:查询密钥详细信息。",
        "operationId": "ListKeyDetail",
        "produces": [
          "application/json"
        ],
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "required": true,
            "x-example": "2b31ed520xxxxxxebedb6e57xxxxxxxx"
          },
          {
            "name": "ListKeyDetailRequestBody",
            "in": "body",
            "description": "describe_key",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OperateKeyRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求已成功",
            "schema": {
              "$ref": "#/definitions/DescribeKeyResponseBody"
            },
            "examples": {
              "application/json": {
                "key_info": {
                  "key_id": "0d0466b0-e727-4d9c-b35d-f84bb474a37f",
                  "domain_id": "00074811d5c27c4f8d48bb91e4a1dcfd",
                  "key_alias": "test",
                  "realm": "test",
                  "key_description": "key_description",
                  "creation_date": "1502799822000",
                  "scheduled_deletion_date": "",
                  "key_spec": "AES_256",
                  "key_usage": "ENCRYPT_DECRYPT",
                  "key_state": "2",
                  "default_key_flag": "0",
                  "key_type": "1",
                  "expiration_time": "1501578672000",
                  "origin": "kms",
                  "key_rotation_enabled": "false",
                  "sys_enterprise_project_id": "0"
                }
              }
            }
          },
          "400": {
            "description": "请求参数有误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "被请求的页面需要用户名和密码",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "认证失败",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "资源不存在,资源未找到",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "502": {
            "description": "请求未完成。服务器从上游服务器收到一个无效的响应",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "504": {
            "description": "网关超时",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "x-request-examples-1": {
          "key_id": "0d0466b0-e727-4d9c-b35d-f84bb474a37f"
        }
      }
    }
  },
  "definitions": {
    "KeyDetails": {
      "description": "密钥详情。",
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "密钥ID。"
        },
        "domain_id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 64,
          "description": "用户域ID。"
        },
        "key_alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "密钥别名。"
        },
        "realm": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "密钥区域。"
        },
        "key_spec": {
          "type": "string",
          "enum": [
            "AES_256",
            "SM4",
            "RSA_2048",
            "RSA_3072",
            "RSA_4096",
            "EC_P256",
            "EC_P384",
            "SM2"
          ],
          "description": "密钥生成算法。\n - AES_256\n - SM4\n - RSA_2048\n - RSA_3072\n - RSA_4096\n - EC_P256\n - EC_P384\n - SM2"
        },
        "key_usage": {
          "type": "string",
          "enum": [
            "ENCRYPT_DECRYPT",
            "SIGN_VERIFY"
          ],
          "description": "密钥用途。\n- ENCRYPT_DECRYPT\n- SIGN_VERIFY"
        },
        "key_description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "description": "密钥描述。"
        },
        "creation_date": {
          "type": "string",
          "minLength": 13,
          "maxLength": 13,
          "description": "密钥创建时间,时间戳,即从1970年1月1日至该时间的总秒数。"
        },
        "scheduled_deletion_date": {
          "type": "string",
          "minLength": 0,
          "maxLength": 13,
          "description": "密钥计划删除时间,时间戳,即从1970年1月1日至该时间的总秒数。"
        },
        "key_state": {
          "type": "string",
          "pattern": "^[1-5]{1}$",
          "description": "密钥状态,满足正则匹配“^[1-5]{1}$”,枚举如下:\n - “1”表示待激活状态\n - “2”表示启用状态\n - “3”表示禁用状态\n - “4”表示计划删除状态\n - “5”表示等待导入状态"
        },
        "default_key_flag": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1,
          "description": "默认主密钥标识,默认主密钥标识为1,非默认标识为0。"
        },
        "key_type": {
          "type": "string",
          "minLength": 0,
          "maxLength": 13,
          "description": "密钥类型。"
        },
        "expiration_time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 13,
          "description": "密钥材料失效时间,时间戳,即从1970年1月1日至该时间的总秒数。"
        },
        "origin": {
          "type": "string",
          "enum": [
            "kms",
            "external"
          ],
          "description": "密钥来源,默认为“kms”,枚举如下:\n - kms表示密钥材料由kms生成kms表示密钥材料由kms生成\n - external表示密钥材料由外部导入"
        },
        "key_rotation_enabled": {
          "type": "string",
          "minLength": 4,
          "maxLength": 5,
          "description": "密钥轮换状态,默认为“false”,表示关闭密钥轮换功能。"
        },
        "sys_enterprise_project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "企业项目ID,默认为“0”。\n - 对于开通企业项目的用户,表示资源处于默认企业项目下。\n - 对于未开通企业项目的用户,表示资源未处于企业项目下。"
        },
        "keystore_id": {
          "type": "string",
          "description": "密钥库ID"
        }
      }
    },
    "Error": {
      "properties": {
        "error": {
          "description": "错误信息返回体。",
          "items": {
            "$ref": "#/definitions/ErrorDetail"
          }
        }
      }
    },
    "OperateKeyRequestBody": {
      "required": [
        "key_id"
      ],
      "properties": {
        "key_id": {
          "minLength": 36,
          "maxLength": 36,
          "type": "string",
          "description": "密钥ID,36字节,满足正则匹配“^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$”。\n例如:0d0466b0-e727-4d9c-b35d-f84bb474a37f。"
        },
        "sequence": {
          "type": "string",
          "minLength": 0,
          "maxLength": 36,
          "description": "请求消息序列号,36字节序列号。\n例如:919c82d4-8046-4722-9094-35c3c6524cff"
        }
      }
    },
    "ErrorDetail": {
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 36,
          "description": "错误请求返回的错误码"
        },
        "error_msg": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "错误请求返回的错误信息"
        }
      }
    },
    "DescribeKeyResponseBody": {
      "properties": {
        "key_info": {
          "$ref": "#/definitions/KeyDetails"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "kms.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}