{
  "name": "ListCompositeHosts",
  "summary": "查询全部防护域名列表",
  "tags": "租户域名查询",
  "productshort": "WAF",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/composite-waf/host": {
      "get": {
        "x-request-examples-description-1": "查询项目id为project_id的全部防护域名列表。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-hybridcloud": true,
        "tags": [
          "租户域名查询"
        ],
        "summary": "查询全部防护域名列表",
        "operationId": "ListCompositeHosts",
        "description": "查询全部防护域名列表,包括云模式和独享模式",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 4096
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "内容类型",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,对应华为云控制台用户名->我的凭证->项目列表->项目ID",
            "required": true,
            "type": "string"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。默认值为0,表示默认企业项目。若需要查询当前用户所有企业项目绑定的资源信息,请传参all_granted_eps。\n\n缺省值:0",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "description": "分页查询时,返回第几页数据。默认值为1,表示返回第1页数据。",
            "required": false,
            "type": "integer",
            "default": 1
          },
          {
            "name": "pagesize",
            "in": "query",
            "description": "分页查询时,每页包含多少条结果。范围1-100,默认值为10,表示每页包含10条结果。如果需要一次查全部域名,该参数值填-1。",
            "required": false,
            "type": "integer",
            "default": 10
          },
          {
            "name": "hostname",
            "in": "query",
            "description": "域名名称",
            "required": false,
            "type": "string"
          },
          {
            "name": "policyname",
            "in": "query",
            "description": "防护策略名称",
            "required": false,
            "type": "string"
          },
          {
            "name": "protect_status",
            "in": "query",
            "description": "**参数解释:**\n域名防护状态标识,用于指定域名在WAF中的防护运行状态\n**约束限制:**\n不涉及\n**取值范围:**\n - -1:bypass,该域名的请求直接到达其后端服务器,不再经过WAF\n - 0:暂停防护,WAF只转发该域名的请求,不做攻击检测\n - 1:开启防护,WAF根据您配置的策略进行攻击检测\n**默认取值:**\n不涉及",
            "required": false,
            "type": "integer",
            "enum": [
              -1,
              0,
              1
            ]
          },
          {
            "name": "waf_type",
            "in": "query",
            "description": "域名所属WAF模式",
            "required": false,
            "type": "string"
          },
          {
            "name": "is_https",
            "in": "query",
            "required": false,
            "description": "域名是否使用HTTPS",
            "type": "boolean"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListCompositeHostResponseBody"
            },
            "examples": {
              "application/json": {
                "items": [
                  {
                    "id": "31af669f567246c289771694f2112289",
                    "hostid": "31af669f567246c289771694f2112289",
                    "description": "",
                    "proxy": false,
                    "flag": {
                      "pci_3ds": "false",
                      "pci_dss": "false",
                      "ipv6": "false",
                      "cname": "new",
                      "is_dual_az": "true"
                    },
                    "region": "cn-north-4",
                    "hostname": "www.demo.com",
                    "access_code": "1b18879b9d064f8bbcbf8abce7294cac",
                    "policyid": "41cba8aee2e94bcdbf57460874205494",
                    "timestamp": 1650527546454,
                    "protect_status": 0,
                    "access_status": 0,
                    "exclusive_ip": false,
                    "web_tag": "",
                    "paid_type": "prePaid",
                    "waf_type": "cloud"
                  }
                ],
                "total": 1,
                "cloud_total": 1,
                "premium_total": 0
              }
            }
          },
          "400": {
            "description": "请求失败",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          },
          "401": {
            "description": "token权限不足",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{Endpoint}/v1/{project_id}/composite-waf/host?enterprise_project_id=0"
      }
    }
  },
  "definitions": {
    "IAM5ErrorDetails": {
      "description": "调用下游服务的报错信息集合,IAM5鉴权错误时才会返回此信息0。",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "下游服务错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "下游服务报错信息"
        }
      }
    },
    "WafServer": {
      "description": "防护域名的源站服务器配置信息",
      "properties": {
        "front_protocol": {
          "type": "string",
          "description": "**参数解释:**\n客户端请求访问防护域名源站服务器的协议\n**约束限制:**\n不涉及\n**取值范围:**\n - HTTP: HTTP协议\n - HTTPS: HTTPS协议\n\n**默认取值:**\n不涉及",
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        },
        "back_protocol": {
          "type": "string",
          "description": "**参数解释:**\nWAF转发客户端请求到防护域名源站服务器的协议\n**约束限制:**\n不涉及\n**取值范围:**\n - HTTP: HTTP协议\n - HTTPS: HTTPS协议\n\n**默认取值:**\n不涉及",
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        },
        "weight": {
          "type": "integer",
          "description": "源站权重,负载均衡算法将按该权重将请求分配给源站,默认值是1,云模式的冗余字段"
        },
        "address": {
          "type": "string",
          "description": "客户端访问的源站服务器的IP地址"
        },
        "port": {
          "type": "integer",
          "description": "WAF转发客户端请求到源站服务的业务端口"
        },
        "type": {
          "type": "string",
          "description": "**参数解释:**\n源站地址类型,为ipv4或ipv6\n**约束限制:**\n不涉及\n**取值范围:**\n- ipv4 \n- ipv6\n\n**默认取值:**\n不涉及",
          "enum": [
            "ipv4",
            "ipv6"
          ]
        },
        "vpc_id": {
          "type": "string",
          "description": "VPC id,通过以下步骤获取VPC id: \n - 1.找到独享引擎所在的虚拟私有云名称,VPC\\子网这一列就是VPC的名称:登录WAF的控制台->单击系统管理->独享引擎->VPC\\子网 \n - 2.登录虚拟私有云 VPC控制台->虚拟私有云->单击虚拟私有云的名称->基本信息的ID"
        }
      }
    },
    "Premium_waf_instances": {
      "description": "租户引擎实例信息",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "引擎实例id"
        },
        "name": {
          "type": "string",
          "description": "引擎实例名"
        },
        "accessed": {
          "type": "boolean",
          "description": "引擎实例是否已接入,false:未接入;true:已接入"
        }
      }
    },
    "Access_progress": {
      "description": "冗余参数,仅用于新版console(前端)使用",
      "properties": {
        "step": {
          "description": "步骤 \n - 1: 指回源IP加白 \n - 2: 指本地验证 \n - 3:指修改DNS解析",
          "type": "integer",
          "format": "int32"
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释:**\n步骤完成状态标识,用于指示对应步骤的完成情况\n**约束限制:**\n不涉及\n**取值范围:**\n - 0:未完成这个步骤\n - 1:已完成这个步骤\n**默认取值:**\n不涉及",
          "enum": [
            0,
            1
          ]
        }
      }
    },
    "RestErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "编码 (加密) 后的详细拒绝原因,用户可以自行调用 STS 服务的decode-authorization-message接口进行解码,可参考STS5联调自验证。IAM5鉴权错误时才会返回此字段。"
        },
        "details": {
          "type": "array",
          "description": "调用下游服务的报错信息集合,IAM5鉴权错误时才会返回此字段。",
          "items": {
            "$ref": "#/definitions/IAM5ErrorDetails"
          }
        }
      },
      "title": "RestErrorResponse"
    },
    "ListCompositeHostResponseBody": {
      "properties": {
        "total": {
          "description": "所有防护域名的数量",
          "type": "integer"
        },
        "cloud_total": {
          "description": "云模式防护域名的数量",
          "type": "integer"
        },
        "premium_total": {
          "description": "独享模式防护域名的数量",
          "type": "integer"
        },
        "items": {
          "description": "详细的防护域名信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CompositeHostResponse"
          }
        }
      }
    },
    "Flag": {
      "description": "特殊标识,用于前端使用",
      "properties": {
        "pci_3ds": {
          "type": "string",
          "description": "是否开启pci_3ds合规认证 \n - true:开启 \n - false:不开启",
          "enum": [
            "true",
            "false"
          ]
        },
        "pci_dss": {
          "type": "string",
          "description": "是否开启pci_dss合规认证 \n - true:开启 \n - false:不开启",
          "enum": [
            "true",
            "false"
          ]
        },
        "cname": {
          "type": "string",
          "description": "old:代表域名使用的老的cname,new:代表域名使用新的cname",
          "enum": [
            "old",
            "new"
          ]
        },
        "is_dual_az": {
          "type": "string",
          "description": "域名是否开启ipv6 \n - true:开启 \n - false:不开启",
          "enum": [
            "true",
            "false"
          ]
        },
        "ipv6": {
          "type": "string",
          "description": "域名是否开启ipv6 \n - true:开启 \n - false:不开启",
          "enum": [
            "true",
            "false"
          ]
        }
      }
    },
    "CompositeHostResponse": {
      "properties": {
        "id": {
          "description": "域名id",
          "type": "string"
        },
        "hostid": {
          "description": "域名id",
          "type": "string"
        },
        "hostname": {
          "description": "创建的云模式防护域名",
          "type": "string"
        },
        "policyid": {
          "description": "策略id",
          "type": "string"
        },
        "access_code": {
          "description": "cname前缀",
          "type": "string"
        },
        "protect_status": {
          "type": "integer",
          "description": "**参数解释:**\n域名防护状态标识,用于指定域名在WAF中的防护运行状态\n**约束限制:**\n不涉及\n**取值范围:**\n - -1:bypass,该域名的请求直接到达其后端服务器,不再经过WAF\n - 0:暂停防护,WAF只转发该域名的请求,不做攻击检测\n - 1:开启防护,WAF根据您配置的策略进行攻击检测\n\n**默认取值:**\n不涉及",
          "enum": [
            -1,
            0,
            1
          ]
        },
        "access_status": {
          "description": "**参数解释:**\n域名接入状态\n**约束限制:**\n不涉及\n**取值范围:**\n - 0: 未接入\n - 1: 已接入\n\n**默认取值:**\n不涉及",
          "enum": [
            0,
            1
          ],
          "type": "integer"
        },
        "proxy": {
          "type": "boolean",
          "description": "防护域名是否使用代理 \n - false:不使用代理 \n - true:使用代理"
        },
        "timestamp": {
          "description": "创建防护域名的时间",
          "type": "integer",
          "format": "int64"
        },
        "paid_type": {
          "type": "string",
          "description": "**参数解释:**\n套餐付费模式标识,用于指定套餐的计费方式\n**约束限制:**\n不涉及\n**取值范围:**\n - prePaid:包周期模式\n - postPaid:按需模式\n\n**默认取值:**\nprePaid",
          "enum": [
            "prePaid",
            "postPaid"
          ]
        },
        "flag": {
          "description": "特殊标识,用于前端使用",
          "$ref": "#/definitions/Flag"
        },
        "waf_type": {
          "description": "域名所属WAF模式,cloud为云模式,premium为独享模式",
          "type": "string"
        },
        "web_tag": {
          "description": "网站名称,对应WAF控制台域名详情中的网站名称",
          "type": "string"
        },
        "access_progress": {
          "description": "接入进度,仅用于新版console(前端)使用",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Access_progress"
          }
        },
        "premium_waf_instances": {
          "description": "租户引擎实例信息列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Premium_waf_instances"
          }
        },
        "description": {
          "type": "string",
          "description": "域名描述"
        },
        "exclusive_ip": {
          "description": "是否使用独享ip \n - true:使用独享ip \n - false:不使用独享ip",
          "type": "boolean"
        },
        "region": {
          "type": "string",
          "description": "华为云区域ID,控制台创建的域名会携带此参数,api调用创建的域名此参数为空,可以通过华为云上地区和终端节点文档查询区域ID对应的中文名称"
        },
        "server": {
          "description": "防护域名的源站服务器配置信息,只有独享模式域名才返回vpc_id",
          "type": "array",
          "items": {
            "$ref": "#/definitions/WafServer"
          }
        },
        "enterprise_project_id": {
          "description": "企业项目id",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "waf.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}