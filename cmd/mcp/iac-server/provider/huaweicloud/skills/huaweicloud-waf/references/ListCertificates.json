{
  "name": "ListCertificates",
  "summary": "查询证书列表",
  "tags": "证书管理",
  "productshort": "WAF",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/waf/certificate": {
      "get": {
        "x-request-examples-description-1": "查询项目id为project_id证书列表。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-hybridcloud": true,
        "tags": [
          "证书管理"
        ],
        "summary": "查询证书列表",
        "operationId": "ListCertificates",
        "description": "查询证书列表",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 4096
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "内容类型",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,对应华为云控制台用户名->我的凭证->项目列表->项目ID",
            "required": true,
            "type": "string"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。若需要查询当前用户所有企业项目绑定的资源信息,请传参all_granted_eps。",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "description": "分页查询时,返回第几页数据。默认值为1,表示返回第1页数据。",
            "required": false,
            "type": "integer",
            "default": 1
          },
          {
            "name": "pagesize",
            "in": "query",
            "description": "分页查询时,每页包含多少条结果。范围1-100,默认值为10,表示每页包含10条结果。",
            "required": false,
            "type": "integer",
            "default": 10
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "证书名称",
            "type": "string"
          },
          {
            "name": "host",
            "in": "query",
            "required": false,
            "description": "是否获取证书关联的域名,默认为false \n -true:获取已关联域名的证书 \n -false:获取未关联域名的证书",
            "default": false,
            "type": "boolean"
          },
          {
            "name": "exp_status",
            "in": "query",
            "required": false,
            "description": "**参数解释:**\n证书过期状态\n**约束限制:**\n不涉及\n**取值范围:**\n - 0:未过期\n - 1:已过期\n - 2:即将过期(证书将在一个月内过期)\n\n**默认取值:**\n不涉及",
            "enum": [
              0,
              1,
              2
            ],
            "type": "integer"
          },
          {
            "name": "query_scm",
            "in": "query",
            "required": false,
            "description": "查询结果的证书来源服务是否包括SCM服务,值为true或者false。",
            "type": "boolean"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "examples": {
              "application/json": {
                "total": 1,
                "items": [
                  {
                    "id": "dc443ca4f29c4f7e8d4adaf485be317b",
                    "name": "demo",
                    "timestamp": 1643181401751,
                    "expire_time": 1650794100000,
                    "bind_host": [],
                    "exp_status": 2
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/ListCertificateResponseBody"
            }
          },
          "400": {
            "description": "请求失败",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          },
          "401": {
            "description": "token权限不足",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{Endpoint}/v1/{project_id}/waf/certificate?enterprise_project_id=0"
      }
    }
