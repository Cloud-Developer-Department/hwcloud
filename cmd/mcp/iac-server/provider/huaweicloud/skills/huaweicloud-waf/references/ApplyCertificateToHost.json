{
  "name": "ApplyCertificateToHost",
  "summary": "绑定证书到域名",
  "tags": "证书管理",
  "productshort": "WAF",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/waf/certificate/{certificate_id}/apply-to-hosts": {
      "post": {
        "x-request-examples-description-1": "绑定项目id为project_id和证书id为certificate_id的证书到两个域名,分别为域名id为“85e554189d494c0f97789e93531c9f90”的云模式域名和域名id为“4e9e97c425fc463c8f374b90124e8392”的独享模式域名。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-hybridcloud": true,
        "x-constraint": "中东-阿布扎比暂不支持该功能。",
        "tags": [
          "证书管理"
        ],
        "summary": "绑定证书到域名",
        "operationId": "ApplyCertificateToHost",
        "consumes": [
          "application/json"
        ],
        "description": "绑定证书到域名",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 4096
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "内容类型",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,对应华为云控制台用户名->我的凭证->项目列表->项目ID",
            "required": true,
            "type": "string"
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "**参数解释:**\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目ID。若需要查询当前用户所有企业项目绑定的资源信息,请传参all_granted_eps。\n**约束限制:**\n不涉及\n**取值范围:**\n - 0:代表default企业项目\n - all_granted_eps:代表所有企业项目\n - 其它企业项目ID:长度为36个字符\n\n**默认取值:**\n0",
            "required": false,
            "type": "string"
          },
          {
            "name": "certificate_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "https证书id,您可以通过调用查询证书列表(ListCertificates)接口获取证书id"
          },
          {
            "name": "ApplyCertificateToHostRequestBody",
            "in": "body",
            "required": false,
            "description": "证书绑定域名请求体",
            "schema": {
              "$ref": "#/definitions/ApplyCertificateToHostRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ApplyCertificateToHostResponseBody"
            },
            "examples": {
              "application/json": {
                "id": "3ac1402300374a63a05be68c641e92c8",
                "name": "www.abc.com",
                "timestamp": 1636343349139,
                "expire_time": 1650794100000,
                "bind_host": [
                  {
                    "id": "e350cf556da34adab1f017523d1c05ed",
                    "hostname": "www.demo.com",
                    "waf_type": "cloud"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "请求失败",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          },
          "401": {
            "description": "token权限不足",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{Endpoint}/v1/{project_id}/waf/certificate/{certificate_id}/apply-to-hosts?enterprise_project_id=0",
        "x-request-examples-1": {
          "cloud_host_ids": [
            "85e554189d494c0f97789e93531c9f90"
          ],
          "premium_host_ids": [
            "4e9e97c425fc463c8f374b90124e8392"
          ]
        }
      }
    }
  },
  "definitions": {
    "IAM5ErrorDetails": {
      "description": "调用下游服务的报错信息集合,IAM5鉴权错误时才会返回此信息0。",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "下游服务错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "下游服务报错信息"
        }
      }
    },
    "ApplyCertificateToHostResponseBody": {
      "description": "应用证书到域名返回参数",
      "properties": {
        "id": {
          "type": "string",
          "description": "证书id"
        },
        "name": {
          "type": "string",
          "description": "证书名"
        },
        "timestamp": {
          "type": "integer",
          "format": "int64",
          "description": "时间戳"
        },
        "expire_time": {
          "type": "integer",
          "format": "int64",
          "description": "过期时间"
        },
        "bind_host": {
          "description": "绑定域名列表",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CertificateBundingHostBody"
          }
        }
      }
    },
    "ApplyCertificateToHostRequestBody": {
      "example": {
        "cloud_host_ids": [
          "85e554189d494c0f97789e93531c9f90"
        ],
        "premium_host_ids": [
          "4e9e97c425fc463c8f374b90124e8392"
        ]
      },
      "description": "绑定证书和域名的请求体,云模式HTTPS域名id(cloud_host_ids)与独享模式HTTPS域名id(premium_host_ids)至少填一项",
      "properties": {
        "cloud_host_ids": {
          "type": "array",
          "description": "云模式HTTPS域名id,通过查询云模式防护域名列表(ListHost)接口获取",
          "items": {
            "type": "string"
          }
        },
        "premium_host_ids": {
          "type": "array",
          "description": "独享模式HTTPS域名id,通过查询独享模式域名列表(ListPremiumHost)接口获取",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CertificateBundingHostBody": {
      "description": "绑定域名列表",
      "properties": {
        "id": {
          "type": "string",
          "description": "域名id"
        },
        "hostname": {
          "type": "string",
          "description": "域名"
        },
        "waf_type": {
          "type": "string",
          "description": "waf模式(分为云模式:cloud,独享模式:premium)",
          "enum": [
            "cloud",
            "premium"
          ]
        }
      }
    },
    "RestErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "编码 (加密) 后的详细拒绝原因,用户可以自行调用 STS 服务的decode-authorization-message接口进行解码,可参考STS5联调自验证。IAM5鉴权错误时才会返回此字段。"
        },
        "details": {
          "type": "array",
          "description": "调用下游服务的报错信息集合,IAM5鉴权错误时才会返回此字段。",
          "items": {
            "$ref": "#/definitions/IAM5ErrorDetails"
          }
        }
      },
      "title": "RestErrorResponse"
    }
