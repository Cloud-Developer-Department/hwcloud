          "type": "integer",
          "enum": [
            0,
            1,
            2
          ]
        }
      },
      "type": "object",
      "required": [
        "step",
        "status"
      ]
    },
    "RestErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
