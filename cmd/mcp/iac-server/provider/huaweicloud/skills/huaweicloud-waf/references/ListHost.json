  "definitions": {
    "CloudWafHostItem": {
      "properties": {
        "id": {
          "description": "域名id",
          "type": "string"
        },
        "hostid": {
          "description": "域名id",
          "type": "string"
        },
        "region": {
          "type": "string",
          "description": "华为云区域ID,控制台创建的域名会携带此参数,api调用创建的域名此参数为空,可以通过华为云上地区和终端节点文档查询区域ID对应的中文名称"
        },
        "description": {
          "description": "域名描述信息,可选参数。",
          "type": "string"
        },
        "server": {
          "description": "防护域名的源站服务器配置信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CloudWafServer"
          }
        },
        "type": {
          "description": "WAF部署模式,默认是1,目前仅支持反代模式,冗余参数",
          "type": "integer"
        },
        "proxy": {
          "type": "boolean",
          "description": "防护域名是否使用代理 \n - false:不使用代理 \n - true:使用代理"
        },
        "hostname": {
          "description": "创建的云模式防护域名",
          "type": "string"
        },
        "access_code": {
          "description": "cname前缀",
          "type": "string"
        },
        "policyid": {
          "description": "防护策略id",
          "type": "string"
        },
        "timestamp": {
          "description": "创建防护域名的时间",
          "type": "integer",
          "format": "int64"
        },
        "protect_status": {
          "type": "integer",
          "description": "**参数解释:**\n域名防护状态标识,用于指定域名在WAF中的防护运行状态\n**约束限制:**\n不涉及\n**取值范围:**\n - -1:bypass,该域名的请求直接到达其后端服务器,不再经过WAF\n - 0:暂停防护,WAF只转发该域名的请求,不做攻击检测\n - 1:开启防护,WAF根据您配置的策略进行攻击检测\n\n**默认取值:**\n不涉及",
          "enum": [
            -1,
            0,
            1
          ]
        },
        "access_status": {
          "description": "**参数解释:**\n域名接入状态\n**约束限制:**\n不涉及\n**取值范围:**\n - 0: 未接入\n - 1: 已接入\n\n**默认取值:**\n不涉及",
          "enum": [
            0,
            1
          ],
          "type": "integer"
        },
        "exclusive_ip": {
          "description": "是否使用独享ip \n - true:使用独享ip \n - false:不使用独享ip",
          "type": "boolean"
        },
        "paid_type": {
          "type": "string",
          "description": "**参数解释:**\n套餐付费模式标识,用于指定套餐的计费方式\n**约束限制:**\n不涉及\n**取值范围:**\n - prePaid:包周期模式\n - postPaid:按需模式\n\n**默认取值:**\nprePaid",
          "enum": [
            "prePaid",
            "postPaid"
          ]
        },
        "web_tag": {
          "description": "网站名称,对应WAF控制台域名详情中的网站名称",
          "type": "string"
        },
        "flag": {
          "description": "特殊标识,用于前端使用",
          "$ref": "#/definitions/Flag"
        },
        "enterprise_project_id": {
          "description": "企业项目id",
          "type": "string"
        }
      },
      "example": {
        "id": "d0a4bc2f74e3407388a50243af700305",
        "hostid": "d0a4bc2f74e3407388a50243af700305",
        "description": "e",
        "type": 1,
        "proxy": false,
        "flag": {
          "pci_3ds": "false",
          "pci_dss": "false",
          "ipv6": "false",
          "cname": "new",
          "is_dual_az": "true"
        },
        "region": "cn-north-4",
        "hostname": "www.demo.com",
        "access_code": "7d06456ffaexxxxxxxxxxx281bc13b",
        "policyid": "bb2124fabe6f42ff9fe4770eeccb2670",
        "timestamp": 1642648030687,
        "protect_status": 1,
        "access_status": 0,
        "exclusive_ip": false,
        "web_tag": "iii",
        "paid_type": "prePaid"
      }
    },
    "IAM5ErrorDetails": {
      "description": "调用下游服务的报错信息集合,IAM5鉴权错误时才会返回此信息0。",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "下游服务错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "下游服务报错信息"
        }
      }
    },
    "CloudWafServer": {
      "description": "防护域名的源站服务器配置信息",
      "required": [
        "front_protocol",
        "back_protocol",
        "address",
        "port",
        "type"
      ],
      "properties": {
        "front_protocol": {
          "type": "string",
          "description": "**参数解释:**\n客户端请求访问防护域名源站服务器的协议\n**约束限制:**\n不涉及\n**取值范围:**\n - HTTP: HTTP协议\n - HTTPS: HTTPS协议\n\n**默认取值:**\n不涉及",
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        },
        "back_protocol": {
          "type": "string",
          "description": "**参数解释:**\nWAF转发客户端请求到防护域名源站服务器的协议\n**约束限制:**\n不涉及\n**取值范围:**\n - HTTP: HTTP协议\n - HTTPS: HTTPS协议\n\n**默认取值:**\n不涉及",
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        },
        "weight": {
          "type": "integer",
          "description": "源站权重,负载均衡算法将按该权重将请求分配给源站,默认值是1,云模式的冗余字段"
        },
        "address": {
          "type": "string",
          "description": "客户端访问的源站服务器的IP地址"
        },
        "port": {
          "type": "integer",
          "description": "WAF转发客户端请求到源站服务的业务端口"
        },
        "type": {
          "type": "string",
          "description": "源站地址为ipv4或ipv6",
          "enum": [
            "ipv4",
            "ipv6"
          ]
        }
      }
    },
    "ListHostResponseBody": {
      "properties": {
        "total": {
          "description": "云模式防护域名的数量",
          "type": "integer"
        },
        "items": {
          "description": "详细的云模式防护域名列表信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CloudWafHostItem"
          }
        }
      },
      "example": {
        "total": 1,
        "items": [
          {
            "id": "d0a4bc2f74e3407388a50243af700305",
            "hostid": "d0a4bc2f74e3407388a50243af700305",
            "description": "e",
            "type": 1,
            "proxy": false,
            "flag": {
              "pci_3ds": "false",
              "pci_dss": "false",
              "ipv6": "false",
              "cname": "new",
              "is_dual_az": "true"
            },
            "region": "cn-north-4",
            "hostname": "www.demo.com",
            "access_code": "7d06456ffaexxxxxxxxxxx281bc13b",
            "policyid": "bb2124fabe6f42ff9fe4770eeccb2670",
            "timestamp": 1642648030687,
            "protect_status": 1,
            "access_status": 0,
            "exclusive_ip": false,
            "web_tag": "iii",
            "paid_type": "prePaid"
          }
        ]
      }
    },
    "RestErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "编码 (加密) 后的详细拒绝原因,用户可以自行调用 STS 服务的decode-authorization-message接口进行解码,可参考STS5联调自验证。IAM5鉴权错误时才会返回此字段。"
        },
        "details": {
          "type": "array",
          "description": "调用下游服务的报错信息集合,IAM5鉴权错误时才会返回此字段。",
          "items": {
            "$ref": "#/definitions/IAM5ErrorDetails"
          }
        }
      },
      "title": "RestErrorResponse"
    },
    "Flag": {
      "description": "特殊标识,用于前端使用",
      "properties": {
        "pci_3ds": {
          "type": "string",
          "description": "是否开启pci_3ds合规认证 \n - true:开启 \n - false:不开启",
          "enum": [
            "true",
            "false"
          ]
        },
        "pci_dss": {
          "type": "string",
          "description": "是否开启pci_dss合规认证 \n - true:开启 \n - false:不开启",
          "enum": [
            "true",
            "false"
          ]
        },
        "cname": {
          "type": "string",
          "description": "old:代表域名使用的老的cname,new:代表域名使用新的cname",
          "enum": [
            "old",
            "new"
          ]
        },
        "is_dual_az": {
          "type": "string",
          "description": "域名是否开启ipv6 \n - true:开启 \n - false:不开启",
          "enum": [
            "true",
            "false"
          ]
        },
        "ipv6": {
          "type": "string",
          "description": "域名是否开启ipv6 \n - true:开启 \n - false:不开启",
          "enum": [
            "true",
            "false"
          ]
        }
      }
    }
  },
