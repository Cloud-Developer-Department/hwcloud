{
  "name": "ListHost",
  "summary": "查询云模式防护域名列表",
  "tags": "云模式防护网站管理",
  "productshort": "WAF",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/waf/instance": {
      "get": {
        "x-request-examples-description-1": "获取项目id为project_id的项目中的所有云模式防护域名",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-hybridcloud": false,
        "tags": [
          "云模式防护网站管理"
        ],
        "summary": "查询云模式防护域名列表",
        "operationId": "ListHost",
        "description": "查询云模式防护域名列表",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 4096,
            "default": ""
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "内容类型",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,对应华为云控制台用户名->我的凭证->项目列表->项目ID",
            "required": true,
            "type": "string",
            "default": ""
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目id。若需要查询当前用户所有企业项目绑定的资源信息,请传参all_granted_eps。",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "description": "分页查询时,返回第几页数据。默认值为1,表示返回第1页数据。",
            "required": false,
            "type": "integer",
            "default": 1
          },
          {
            "name": "pagesize",
            "in": "query",
            "description": "分页查询时,每页包含多少条结果。范围1-100,默认值为10,表示每页包含10条结果。如果需要一次查全部域名,该参数值填-1。",
            "required": false,
            "type": "integer",
            "default": 10
          },
          {
            "name": "hostname",
            "in": "query",
            "description": "要查询的防护域名,用于查询指定防护域名信息;可不传,查询用户云模式下所有防护域名",
            "required": false,
            "type": "string"
          },
          {
            "name": "policyname",
            "in": "query",
            "description": "防护策略名,用于查询指定防护策略下的域名,可不传",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ListHostResponseBody"
            },
            "examples": {
              "application/json": {
                "total": 1,
                "items": [
                  {
                    "id": "d0a4bc2f74e3407388a50243af700305",
                    "hostid": "d0a4bc2f74e3407388a50243af700305",
                    "description": "e",
                    "type": 1,
                    "proxy": false,
                    "flag": {
                      "pci_3ds": "false",
                      "pci_dss": "false",
                      "ipv6": "false",
                      "cname": "new",
                      "is_dual_az": "true"
                    },
                    "region": "cn-north-4",
                    "hostname": "www.demo.com",
                    "access_code": "7d06456ffaexxxxxxxxxxx281bc13b",
                    "policyid": "bb2124fabe6f42ff9fe4770eeccb2670",
                    "timestamp": 1642648030687,
                    "protect_status": 1,
                    "access_status": 0,
                    "exclusive_ip": false,
                    "web_tag": "iii",
                    "paid_type": "prePaid"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "请求失败",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          },
          "401": {
            "description": "token权限不足",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "GET https://{Endpoint}/v1/{project_id}/waf/instance?enterprise_project_id=0"
      }
    }
