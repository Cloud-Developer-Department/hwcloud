{
  "name": "ListResponseCodeTimeline",
  "summary": "查询安全统计响应码数据",
  "tags": "安全总览",
  "productshort": "WAF",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/waf/overviews/response-code/timeline": {
      "get": {
        "x-is-registered": "Y",
        "x-support-international": true,
        "x-support-sdk": "Y",
        "x-api-type": "open-api",
        "tags": [
          "安全总览"
        ],
        "summary": "查询安全统计响应码数据",
        "operationId": "ListResponseCodeTimeline",
        "description": "查询安全统计响应码数据",
        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string"
          },
          {
            "name": "Content-Type",
            "description": "**参数解释:**\n内容类型\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\napplication/json;charset=utf8",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "project_id",
            "in": "path",
            "type": "string",
            "description": "**参数解释:**\n项目ID,对应华为云控制台用户名->我的凭证->项目列表->项目ID\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "type": "string",
            "description": "**参数解释:**\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目ID。若需要查询当前用户所有企业项目绑定的资源信息,请传参all_granted_eps。\n**约束限制:**\n不涉及\n**取值范围:**\n - 0:代表default企业项目\n - all_granted_eps:代表所有企业项目\n - 其它企业项目ID:长度为36个字符\n**默认取值:**\n0",
            "required": false
          },
          {
            "name": "from",
            "in": "query",
            "type": "integer",
            "format": "int64",
            "description": "**参数解释:**\n起始时间(毫秒时间戳),需要和to同时使用\n**约束限制:**\nfrom <= to\n**取值范围:**\nfrom ~ to 最大范围30天\n**默认取值:**\n不涉及",
            "required": true
          },
          {
            "name": "to",
            "in": "query",
            "type": "integer",
            "format": "int64",
            "description": "**参数解释:**\n结束时间(毫秒时间戳),需要和from同时使用\n**约束限制:**\nfrom ~ to 最大范围30天\n**取值范围:**\n不能超过当天的结束时间\n**默认取值:**\n不涉及",
            "required": true
          },
          {
            "name": "hosts",
            "in": "query",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "**参数解释:**\n要查询的域名id列表,通过 ”查询独享模式域名列表“(ListPremiumHost)或者 “查询云模式防护域名列表” (ListHost)接口获取;不传参代表查询全部域名的数据\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": false,
            "collectionFormat": "multi"
          },
          {
            "name": "instances",
            "in": "query",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "**参数解释:**\n要查询的实例id列表,通过 “查询WAF独享引擎列表”(ListInstance)接口获取\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": false,
            "collectionFormat": "multi"
          },
          {
            "name": "response_source",
            "in": "query",
            "type": "string",
            "description": "**参数解释:**\n响应源\n**约束限制:**\n不涉及\n**取值范围:**\n- WAF\n- UPSTREAM\n**默认取值:**\n不涉及",
            "required": false,
            "enum": [
              "WAF",
              "UPSTREAM"
            ]
          },
          {
            "name": "group_by",
            "in": "query",
            "type": "string",
            "description": "**参数解释:**\n展示维度,按天展示时传\"DAY\"\n**约束限制:**\n不涉及\n**取值范围:**\n- DAY\n**默认取值:**\n不涉及",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "examples": {
              "application/json": [
                {
                  "key": "ACCESS",
                  "timeline": [
                    {
                      "time": 1714521600000,
                      "num": 15820
                    },
                    {
                      "time": 1714525200000,
                      "num": 16358
                    },
                    {
                      "time": 1714528800000,
                      "num": 14982
                    },
                    {
                      "time": 1714532400000,
                      "num": 13650
                    }
                  ]
                }
              ]
            },
            "description": "ok",
            "schema": {
              "$ref": "#/definitions/StatisticsTimeline"
            }
          },
          "400": {
            "description": "请求失败",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          },
          "401": {
            "description": "token权限不足",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "StatisticsTimelineItem": {
      "type": "object",
      "example": [
        {
          "key": "ACCESS",
          "timeline": [
            {
              "time": 1714521600000,
              "num": 15820
            },
            {
              "time": 1714525200000,
              "num": 16358
            },
            {
              "time": 1714528800000,
              "num": 14982
            },
            {
              "time": 1714532400000,
              "num": 13650
            }
          ]
        },
        {
          "key": "CRAWLER",
          "timeline": [
            {
              "time": 1714521600000,
              "num": 235
            },
            {
              "time": 1714525200000,
              "num": 189
            },
            {
              "time": 1714528800000,
              "num": 212
            },
            {
              "time": 1714532400000,
              "num": 156
            }
          ]
        }
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n键值标识,用于区分不同的防护统计类型\n**约束限制:**\n不涉及\n**取值范围:**\n - ACCESS:请求总量\n - CRAWLER:Bot攻击防护\n - ATTACK:攻击总量\n - WEB_ATTACK:Web基础防护\n - PRECISE:精准防护\n - CC:CC攻击防护\n**默认取值:**\n不涉及",
          "enum": [
            "ACCESS",
            "CRAWLER",
            "ATTACK",
            "WEB_ATTACK",
            "PRECISE",
            "CC"
          ]
        },
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimeLineItem"
          },
          "description": "对应键值的时间线统计数据"
        }
      },
      "description": "不同键值对应的时间线"
    },
    "IAM5ErrorDetails": {
      "description": "调用下游服务的报错信息集合,IAM5鉴权错误时才会返回此信息0。",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "下游服务错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "下游服务报错信息"
        }
      }
    },
    "TimeLineItem": {
      "type": "object",
      "properties": {
        "time": {
          "type": "integer",
          "format": "int64",
          "description": "时间点"
        },
        "num": {
          "type": "integer",
          "description": "数量"
        }
      },
      "title": "CountItem"
    },
    "StatisticsTimeline": {
      "type": "array",
      "description": "安全统计的时间线,按时间顺序展示统计数据",
      "items": {
        "$ref": "#/definitions/StatisticsTimelineItem"
      }
    },
    "RestErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "编码 (加密) 后的详细拒绝原因,用户可以自行调用 STS 服务的decode-authorization-message接口进行解码,可参考STS5联调自验证。IAM5鉴权错误时才会返回此字段。"
        },
        "details": {
          "type": "array",
          "description": "调用下游服务的报错信息集合,IAM5鉴权错误时才会返回此字段。",
          "items": {
            "$ref": "#/definitions/IAM5ErrorDetails"
          }
        }
      },
      "title": "RestErrorResponse"
    }
  },
