        "description": {
          "type": "string",
          "description": "域名描述"
        },
        "policyid": {
          "description": "防护域名初始绑定的防护策略ID,可以通过策略名称调用查询防护策略列表(ListPolicy)接口查询到对应的策略id",
          "type": "string"
        },
        "protect_status": {
          "type": "integer",
          "description": "**参数解释:**\n域名防护状态标识,用于指定域名在WAF中的防护运行状态\n**约束限制:**\n不涉及\n**取值范围:**\n - -1:bypass,该域名的请求直接到达其后端服务器,不再经过WAF\n - 0:暂停防护,WAF只转发该域名的请求,不做攻击检测\n - 1:开启防护,WAF根据您配置的策略进行攻击检测\n**默认取值:**\n不涉及",
          "enum": [
            -1,
            0,
            1
          ]
        },
        "access_status": {
          "description": "**参数解释:**\n域名接入状态\n**约束限制:**\n不涉及\n**取值范围:**\n - 0: 未接入\n - 1: 已接入\n**默认取值:**\n不涉及",
          "enum": [
            0,
            1
          ],
          "type": "integer"
        },
        "web_tag": {
          "description": "网站名称,对应WAF控制台域名详情中的网站名称",
          "type": "string"
        },
        "hostid": {
          "description": "域名id,和id的值是一样的,属于冗余字段",
          "type": "string"
        },
        "enterprise_project_id": {
          "description": "企业项目id",
          "type": "string"
        },
        "pool_ids": {
          "description": "云模式elb接入域名返回此字段,表示域名所属独享引擎组",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "loadbalancer_id": {
          "description": "云模式elb接入域名返回此字段,表示负载均衡器(ELB)id",
          "type": "string"
        },
        "protocol_port": {
          "description": "云模式elb接入域名返回此字段,表示业务端口",
          "type": "integer"
        }
      },
      "description": "独享模式域名信息列表"
    },
    "ListPremiumWafHostResponseBody": {
      "properties": {
