            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "分页查询时,返回第几页数据。默认值为1,表示返回第1页数据。",
            "default": 1,
            "type": "string"
          },
          {
            "name": "pagesize",
            "in": "query",
            "required": false,
            "description": "分页查询时,每页包含多少条结果。范围1-100,默认值为10,表示每页包含10条结果。如果需要一次查全部域名,该参数值填-1。",
            "default": 10,
            "type": "string"
          },
          {
            "name": "hostname",
            "in": "query",
            "required": false,
            "description": "域名",
            "type": "string"
          },
          {
            "name": "policyname",
            "in": "query",
            "required": false,
            "description": "策略名称",
            "type": "string"
          },
          {
            "name": "protect_status",
