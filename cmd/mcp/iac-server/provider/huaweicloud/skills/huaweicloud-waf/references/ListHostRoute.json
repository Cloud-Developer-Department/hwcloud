  "definitions": {
    "ListRouteResponseBody": {
      "description": "该防护域名设置的路由线路信息",
      "type": "object",
      "properties": {
        "total": {
          "description": "路由线路数量",
          "type": "integer"
        },
        "items": {
          "description": "路由线路列表",
          "$ref": "#/definitions/RouteResponseBody"
        }
      }
    },
    "RouteBody": {
      "description": "单个路由线路详细信息",
      "type": "object",
      "required": [
        "name",
        "servers"
      ],
      "properties": {
        "cname": {
          "description": "WAF集群的cname后缀",
          "type": "string"
        },
        "name": {
          "description": "WAF集群名称",
          "type": "string"
        },
        "servers": {
          "description": "防护域名源站服务器信息列表",
          "type": "array",
          "example": [
            {
              "back_protocol": "HTTP",
              "address": "x.x.x.x",
              "port": 80
            },
            {
              "back_protocol": "HTTPS",
              "address": "1.2.2.2",
              "port": 443
            }
          ],
          "items": {
            "$ref": "#/definitions/RouteServerBody"
          }
        }
      }
    },
    "IAM5ErrorDetails": {
      "description": "调用下游服务的报错信息集合,IAM5鉴权错误时才会返回此信息0。",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "下游服务错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "下游服务报错信息"
        }
      }
    },
    "RouteResponseBody": {
      "description": "单个路由线路详细信息",
      "type": "array",
      "items": {
        "$ref": "#/definitions/RouteBody"
      }
    },
    "RouteServerBody": {
      "description": "防护域名源站服务器信息",
      "type": "object",
      "example": {
        "back_protocol": "HTTP",
        "address": "x.x.x.x",
        "port": 80
      },
      "properties": {
        "back_protocol": {
          "type": "string",
          "description": "**参数解释:**\nWAF转发客户端请求到防护域名源站服务器的协议\n**约束限制:**\n不涉及\n**取值范围:**\n - HTTP: HTTP协议\n - HTTPS: HTTPS协议\n\n**默认取值:**\n不涉及",
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        },
        "address": {
          "type": "string",
          "description": "客户端访问的源站服务器的IP地址"
        },
        "port": {
          "type": "integer",
          "description": "WAF转发客户端请求到源站服务的业务端口"
        }
      }
    },
    "RestErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        },
        "encoded_authorization_message": {
