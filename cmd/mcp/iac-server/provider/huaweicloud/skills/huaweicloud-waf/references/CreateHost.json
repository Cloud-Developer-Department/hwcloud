{
  "name": "CreateHost",
  "summary": "创建云模式防护域名",
  "tags": "云模式防护网站管理",
  "productshort": "WAF",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/waf/instance": {
      "post": {
        "x-request-examples-description-1": "在项目id为project_id的项目下,创建域名是“www.example.com”的云模式防护域名,该域名的客户端请求访问防护域名源站服务器的协议是“HTTPS”,WAF转发客户端请求到防护域名源站服务器的协议是“HTTP”,源站地址是“ipv4”,源站服务器的IP地址是“x.x.x.x”,WAF转发客户端请求到源站服务的业务端口是\"7443\",该域名不使用代理和独享ip,套餐付费模式是包周期模式,域名描述是“demo”,对应WAF控制台域名详情中的网站名称是“demo”,对外协议的证书名称是“test6”,证书id是“3ac1402300374a63a05be68c641e92c8”。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-hybridcloud": false,
        "tags": [
          "云模式防护网站管理"
        ],
        "summary": "创建云模式防护域名",
        "operationId": "CreateHost",
        "description": "创建云模式防护域名",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string",
            "minLength": 32,
            "maxLength": 4096
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "内容类型",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID,对应华为云控制台用户名->我的凭证->项目列表->项目ID",
            "required": true,
            "type": "string",
            "default": ""
          },
          {
            "name": "enterprise_project_id",
            "in": "query",
            "description": "**参数解释:**\n您可以通过调用企业项目管理服务(EPS)的查询企业项目列表接口(ListEnterpriseProject)查询企业项目ID。若需要查询当前用户所有企业项目绑定的资源信息,请传参all_granted_eps。\n**约束限制:**\n不涉及\n**取值范围:**\n - 0:代表default企业项目\n - all_granted_eps:代表所有企业项目\n - 其它企业项目ID:长度为36个字符\n\n**默认取值:**\n0",
            "required": false,
            "type": "string"
          },
          {
            "name": "CreateHostRequestBody",
            "description": "创建域名请求体",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateHostRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/CreateHostResponseBody"
            },
            "examples": {
              "application/json": {
                "id": "31af669f567246c289771694f2112289",
                "hostname": "www.demo.com",
                "protocol": "HTTP",
                "server": [
                  {
                    "address": "x.x.x.x",
                    "port": 80,
                    "type": "ipv4",
                    "weight": 1,
                    "front_protocol": "HTTP",
                    "back_protocol": "HTTP"
                  }
                ],
                "proxy": false,
                "timestamp": 1650527546420,
                "flag": {
                  "pci_3ds": "false",
                  "pci_dss": "false",
                  "ipv6": "false",
                  "cname": "new",
                  "is_dual_az": "true"
                },
                "policyid": "41cba8aee2e94bcdbf57460874205494",
                "protect_status": 1,
                "access_status": 0,
                "access_code": "1b18879b9d064f8bbcbf8abce7294cac",
                "block_page": {
                  "template": "default"
                },
                "web_tag": "",
                "exclusive_ip": false,
                "http2_enable": false
              }
            }
          },
          "400": {
            "description": "请求失败",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          },
          "401": {
            "description": "token权限不足",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/RestErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{Endpoint}/v1/{project_id}/waf/instance?enterprise_project_id=0",
        "x-request-examples-1": {
          "hostname": "www.demo.com",
          "server": [
            {
              "front_protocol": "HTTPS",
              "back_protocol": "HTTP",
              "type": "ipv4",
              "address": "x.x.x.x",
              "port": "7443"
            }
          ],
          "proxy": false,
          "paid_type": "prePaid",
          "description": "demo",
          "web_tag": "demo",
          "certificateid": "3ac1402300374a63a05be68c641e92c8",
          "certificatename": "test6",
          "exclusive_ip": false
        }
      }
    }
  },
  "definitions": {
    "CreateHostRequestBody": {
      "description": "域名请求体",
      "example": {
        "hostname": "www.demo.com",
        "server": [
          {
            "front_protocol": "HTTPS",
            "back_protocol": "HTTP",
            "type": "ipv4",
            "address": "x.x.x.x",
            "port": "7443"
          }
        ],
        "proxy": false,
        "paid_type": "prePaid",
        "description": "demo",
        "web_tag": "demo",
        "certificateid": "3ac1402300374a63a05be68c641e92c8",
        "certificatename": "test6",
        "exclusive_ip": false
      },
      "required": [
        "hostname",
        "proxy",
        "server"
      ],
      "properties": {
        "hostname": {
          "description": "域名(域名只能由字母、数字、-、_和.组成,长度不能超过64个字符,如www.domain.com)",
          "type": "string"
        },
        "policyid": {
          "type": "string",
          "description": "防护域名初始绑定的策略ID,可以通过策略名称调用查询防护策略列表(ListPolicy)接口查询到对应的策略id"
        },
        "server": {
          "description": "防护域名的源站服务器配置信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CloudWafServer"
          }
        },
        "certificateid": {
          "description": "证书id,通过查询证书列表接口(ListCertificates)接口获取证书id \n - 对外协议为HTTP时不需要填写 \n - 对外协议HTTPS时为必填参数",
          "type": "string"
        },
        "certificatename": {
          "description": "证书名 \n - 对外协议为HTTP时不需要填写 \n - 对外协议HTTPS时为必填参数",
          "type": "string"
        },
        "web_tag": {
          "description": "网站名称,对应WAF控制台域名详情中的网站名称",
          "type": "string"
        },
        "exclusive_ip": {
          "description": "是否使用独享ip \n - true:使用独享ip \n - false:不使用独享ip",
          "type": "boolean"
        },
        "paid_type": {
          "type": "string",
          "description": "**参数解释:**\n套餐付费模式标识,用于指定套餐的计费方式\n**约束限制:**\n不涉及\n**取值范围:**\n - prePaid:包周期模式\n - postPaid:按需模式\n\n**默认取值:**\nprePaid",
          "enum": [
            "prePaid",
            "postPaid"
          ]
        },
        "proxy": {
          "type": "boolean",
          "description": "防护域名是否使用代理 \n - false:不使用代理 \n - true:使用代理"
        },
        "lb_algorithm": {
          "description": "**参数解释:**\nLB负载均衡,仅专业版和企业版支持配置负载均衡算法\n**约束限制:**\n不涉及\n**取值范围:**\n - ip_hash: 源IP Hash,将某个IP的请求定向到同一个服务器\n - round_robin: 加权轮询,所有请求将按权重轮流分配给源站服务器\n - session_hash: 将某个Session标识的请求定向到同一个源站服务器,请确保在域名添加完毕后配置攻击惩罚的流量标识,否则Session Hash配置不生效\n\n**默认取值:**\n不涉及",
          "enum": [
            "ip_hash",
            "round_robin",
            "session_hash"
          ],
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "域名描述"
        },
        "forward_header_map": {
          "type": "object",
          "description": "字段转发配置,WAF会将添加的字段插到header中,转给源站;Key不能跟nginx原生字段重复。Value支持的值包括: \n - $time_local \n - $request_id \n - $connection_requests \n - $tenant_id \n - $project_id \n - $remote_addr \n - $remote_port \n - $scheme \n - $request_method \n - $http_host \n -$origin_uri \n - $request_length \n - $ssl_server_name \n - $ssl_protocol \n - $ssl_curves \n - $ssl_session_reused",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "IAM5ErrorDetails": {
      "description": "调用下游服务的报错信息集合,IAM5鉴权错误时才会返回此信息0。",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "下游服务错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "下游服务报错信息"
        }
      }
    },
    "CloudWafServer": {
      "description": "防护域名的源站服务器配置信息",
      "required": [
        "front_protocol",
        "back_protocol",
        "address",
        "port",
        "type"
      ],
      "properties": {
        "front_protocol": {
          "type": "string",
          "description": "**参数解释:**\n客户端请求访问防护域名源站服务器的协议\n**约束限制:**\n不涉及\n**取值范围:**\n - HTTP: HTTP协议\n - HTTPS: HTTPS协议\n\n**默认取值:**\n不涉及",
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        },
        "back_protocol": {
          "type": "string",
          "description": "**参数解释:**\nWAF转发客户端请求到防护域名源站服务器的协议\n**约束限制:**\n不涉及\n**取值范围:**\n - HTTP: HTTP协议\n - HTTPS: HTTPS协议\n\n**默认取值:**\n不涉及",
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        },
        "weight": {
          "type": "integer",
          "description": "源站权重,负载均衡算法将按该权重将请求分配给源站,默认值是1,云模式的冗余字段"
        },
        "address": {
          "type": "string",
          "description": "客户端访问的源站服务器的IP地址"
        },
        "port": {
          "type": "integer",
          "description": "WAF转发客户端请求到源站服务的业务端口"
        },
        "type": {
          "type": "string",
          "description": "源站地址为ipv4或ipv6",
          "enum": [
            "ipv4",
            "ipv6"
          ]
        }
      }
    },
    "CustomPage": {
      "description": "自定义告警页面",
      "required": [
        "status_code",
        "content_type",
        "content"
      ],
      "properties": {
        "status_code": {
          "type": "string",
          "description": "返回状态码"
        },
        "content_type": {
          "type": "string",
          "description": "**参数解释:**\n“自定义”告警页面内容类型\n**约束限制:**\n不涉及\n**取值范围:**\n - text/html\n - text/xml\n - application/json\n**默认取值:**\n不涉及",
          "enum": [
            "text/html",
            "text/xml",
            "application/json"
          ]
        },
        "content": {
          "type": "string",
          "description": "根据选择的“页面类型”配置对应的页面内容,具体示例可以参考“Web应用防火墙 WAF”用户手册"
        }
      }
    },
    "BlockPage": {
      "description": "告警页面配置参数,用于配置“自定义”或者“重定向”页面",
      "required": [
        "template"
      ],
      "properties": {
        "template": {
          "type": "string",
          "description": "模板名称,默认页面请输入default,自定义告警页面时请输入custom,重定向请输入redirect"
        },
        "custom_page": {
          "description": "自定义告警页面",
          "$ref": "#/definitions/CustomPage"
        },
        "redirect_url": {
          "type": "string",
          "description": "“重定向”页面URL"
        }
      }
    },
    "RestErrorResponse": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "string",
          "description": "错误码"
        },
        "error_msg": {
          "type": "string",
          "description": "错误信息"
        },
        "encoded_authorization_message": {
          "type": "string",
          "description": "编码 (加密) 后的详细拒绝原因,用户可以自行调用 STS 服务的decode-authorization-message接口进行解码,可参考STS5联调自验证。IAM5鉴权错误时才会返回此字段。"
        },
        "details": {
          "type": "array",
          "description": "调用下游服务的报错信息集合,IAM5鉴权错误时才会返回此字段。",
          "items": {
            "$ref": "#/definitions/IAM5ErrorDetails"
          }
        }
      },
      "title": "RestErrorResponse"
    },
    "CreateHostResponseBody": {
      "properties": {
        "id": {
          "description": "域名id",
          "type": "string"
        },
        "hostname": {
          "description": "创建的云模式防护域名",
          "type": "string"
        },
        "policyid": {
          "description": "策略id",
          "type": "string"
        },
        "access_code": {
          "description": "cname前缀",
          "type": "string"
        },
        "protect_status": {
          "type": "integer",
          "description": "**参数解释:**\n域名防护状态标识,用于指定域名在WAF中的防护运行状态\n**约束限制:**\n不涉及\n**取值范围:**\n - -1:bypass,该域名的请求直接到达其后端服务器,不再经过WAF\n - 0:暂停防护,WAF只转发该域名的请求,不做攻击检测\n - 1:开启防护,WAF根据您配置的策略进行攻击检测\n\n**默认取值:**\n不涉及",
          "enum": [
            -1,
            0,
            1
          ]
        },
        "access_status": {
          "description": "**参数解释:**\n域名接入状态\n**约束限制:**\n不涉及\n**取值范围:**\n - 0: 未接入\n - 1: 已接入\n\n**默认取值:**\n不涉及",
          "enum": [
            0,
            1
          ],
          "type": "integer"
        },
        "lb_algorithm": {
          "description": "**参数解释:**\nLB负载均衡,仅专业版和企业版支持配置负载均衡算法\n**约束限制:**\n不涉及\n**取值范围:**\n - ip_hash: 源IP Hash,将某个IP的请求定向到同一个服务器\n - round_robin: 加权轮询,所有请求将按权重轮流分配给源站服务器\n - session_hash: 将某个Session标识的请求定向到同一个源站服务器,请确保在域名添加完毕后配置攻击惩罚的流量标识,否则Session Hash配置不生效\n\n**默认取值:**\n不涉及",
          "enum": [
            "ip_hash",
            "round_robin",
            "session_hash"
          ],
          "type": "string"
        },
        "protocol": {
          "description": "返回的客户端协议类型",
          "type": "string"
        },
        "certificateid": {
          "description": "返回的证书id",
          "type": "string"
        },
        "certificatename": {
          "description": "证书名称",
          "type": "string"
        },
        "server": {
          "description": "防护域名的源站服务器配置信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CloudWafServer"
          }
        },
        "proxy": {
          "type": "boolean",
          "description": "防护域名是否使用代理 \n - false:不使用代理 \n - true:使用代理"
        },
        "timestamp": {
          "description": "创建防护域名的时间",
          "type": "integer",
          "format": "int64"
        },
        "exclusive_ip": {
          "description": "是否使用独享ip \n - true:使用独享ip \n - false:不使用独享ip",
          "type": "boolean"
        },
        "web_tag": {
          "description": "网站名称,对应WAF控制台域名详情中的网站名称",
          "type": "string"
        },
        "http2_enable": {
          "description": "是否支持http2 \n - true:表示支持http2 \n - false:表示不支持http2",
          "type": "boolean"
        },
        "block_page": {
          "description": "告警页面配置",
          "$ref": "#/definitions/BlockPage"
        },
        "flag": {
          "description": "特殊标识,用于前端使用",
          "$ref": "#/definitions/Flag"
        },
        "extend": {
          "type": "object",
          "description": "扩展字段,用于保存防护域名的一些配置信息。",
          "additionalProperties": {
            "type": "string"
          }
        },
        "forward_header_map": {
          "type": "object",
          "description": "字段转发配置,WAF会将添加的字段插到header中,转给源站;Key不能跟nginx原生字段重复。Value支持的值包括: \n - $time_local \n - $request_id \n - $connection_requests \n - $tenant_id \n - $project_id \n - $remote_addr \n - $remote_port \n - $scheme \n - $request_method \n - $http_host \n -$origin_uri \n - $request_length \n - $ssl_server_name \n - $ssl_protocol \n - $ssl_curves \n - $ssl_session_reused",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "Flag": {
      "description": "特殊标识,用于前端使用",
      "properties": {
        "pci_3ds": {
          "type": "string",
          "description": "是否开启pci_3ds合规认证 \n - true:开启 \n - false:不开启",
          "enum": [
            "true",
            "false"
          ]
        },
        "pci_dss": {
          "type": "string",
          "description": "是否开启pci_dss合规认证 \n - true:开启 \n - false:不开启",
          "enum": [
            "true",
            "false"
          ]
        },
        "cname": {
          "type": "string",
          "description": "old:代表域名使用的老的cname,new:代表域名使用新的cname",
          "enum": [
            "old",
            "new"
          ]
        },
        "is_dual_az": {
          "type": "string",
          "description": "域名是否开启ipv6 \n - true:开启 \n - false:不开启",
          "enum": [
            "true",
            "false"
          ]
        },
        "ipv6": {
          "type": "string",
          "description": "域名是否开启ipv6 \n - true:开启 \n - false:不开启",
          "enum": [
            "true",
            "false"
          ]
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "waf.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "post",
  "uri": null
}