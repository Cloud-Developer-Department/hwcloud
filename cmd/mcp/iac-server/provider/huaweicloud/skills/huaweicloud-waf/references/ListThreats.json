        "produces": [
          "application/json;charset=utf-8"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "**参数解释:**\n用户Token,通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true,
            "type": "string"
          },
          {
            "name": "Content-Type",
            "description": "**参数解释:**\n内容类型\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\napplication/json;charset=utf8",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "application/json;charset=utf8"
          },
          {
            "name": "project_id",
            "in": "path",
            "type": "string",
            "description": "**参数解释:**\n项目ID,对应华为云控制台用户名->我的凭证->项目列表->项目ID\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "required": true
          },
          {
            "name": "recent",
            "in": "query",
            "type": "string",
            "description": "**参数解释:**\n查询的时间范围,recent参数与from、to必须使用其中一个。当同时使用recent参数与from、to时,以recent参数为准\n**约束限制:**\n不涉及\n**取值范围:**\n - yesterday:昨天\n - today:今天\n - 3days:近3天 \n - 1week:近7天 \n - 1month:近30天 \n**默认取值:**\n不涉及",
            "required": false,
            "enum": [
              "yesterday",
              "today",
              "3days",
              "1week",
              "1month"
            ]
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "**参数解释:**\n起始时间(毫秒时间戳),需要和to同时使用\n**约束限制:**\nfrom <= to\n**取值范围:**\nfrom ~ to 最大范围30天\n**默认取值:**\n不涉及",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "**参数解释:**\n结束时间(毫秒时间戳),需要和from同时使用\n**约束限制:**\nfrom ~ to 最大范围30天\n**取值范围:**\n不能超过当天的结束时间\n**默认取值:**\n不涉及",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "hosts",
            "in": "query",
            "type": "array",
            "description": "**参数解释:**\n要查询的域名id列表,通过 ”查询独享模式域名列表“(ListPremiumHost)或者 “查询云模式防护域名列表” (ListHost)接口获取;不传参代表查询全部域名的数据\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "items": {
              "type": "string"
            },
            "required": false
          },
          {
            "name": "instances",
            "in": "query",
            "required": false,
            "description": "**参数解释:**\n要查询的实例id列表,通过 “查询WAF独享引擎列表”(ListInstance)接口获取\n**约束限制:**\n不涉及\n**取值范围:**\n不涉及\n**默认取值:**\n不涉及",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "examples": {
              "application/json": {
                "xss": 156,
                "sqli": 89,
                "cmdi": 32,
                "lfi": 17,
                "rfi": 9,
