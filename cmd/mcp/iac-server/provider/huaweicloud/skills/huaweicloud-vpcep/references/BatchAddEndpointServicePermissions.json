    },
    "EpsAddPermissionRequest": {
      "description": "添加终端节点服务白名单请求体。",
      "properties": {
        "permission": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "权限格式为:iam:domain::domain_id或者organizations:orgPath::org_path其中,\n - “iam:domain::”和“organizations:orgPath::”为固定格式。\n - “domain_id”为可连接用户的账号ID,org_path可连接用户的组织路径\ndomain_id类型支持输入包括“a~z”、“A~Z”、“0~9”或者“*,最大长度可以传64;\norg_path类型支持“a~z”、“A~Z”、“0~9”、“/-*?”或者“*”,最大长度可以传1024;\n例如:iam:domain::6e9dfd51d1124e8d8498dce894923a0dd或者organizations:orgPath::o-3j59d1231uprgk9yuvlidra7zbzfi578/r-rldbu1vmxdw5ahdkknxnvd5rgag77m2z/ou-7tuddd8nh99rebxltawsm6qct5z7rklv/*"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "description": "终端节点服务白名单描述"
        }
      },
      "required": [
        "permission",
        "description"
      ]
    },
    "EpsPermission": {
      "description": "终端节点服务白名单响应体。",
      "properties": {
        "id": {
          "type": "string",
          "description": "白名单表主键ID"
        },
        "permission": {
          "type": "string",
          "description": "权限格式为:iam:domain::domain_id或者organizations:orgPath::org_path其中,\n - “iam:domain::”和“organizations:orgPath::”为固定格式。\n - “domain_id”为可连接用户的账号ID,org_path可连接用户的组织路径\ndomain_id类型支持输入包括“a~z”、“A~Z”、“0~9”或者“*”,org_path类型支持“a~z”、“A~Z”、“0~9”、“/-*?”或者“*”。\n“*”表示所有终端节点可连接。\n例如:iam:domain::6e9dfd51d1124e8d8498dce894923a0dd或者organizations:orgPath::o-3j59d1231uprgk9yuvlidra7zbzfi578/r-rldbu1vmxdw5ahdkknxnvd5rgag77m2z/ou-7tuddd8nh99rebxltawsm6qct5z7rklv/*",
