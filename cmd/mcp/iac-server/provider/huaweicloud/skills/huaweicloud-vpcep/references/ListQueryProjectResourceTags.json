{
  "name": "ListQueryProjectResourceTags",
  "summary": "查询租户资源标签接口",
  "tags": "TAG功能",
  "productshort": "VPCEP",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/{resource_type}/tags": {
      "get": {
        "x-request-examples-description-1": "查询终端节点服务的资源标签",
        "x-request-examples-description-2": "查询终端节点的资源标签",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/endpoint_service/tags",
        "x-request-examples-url-2": "GET https://{endpoint}/v1/{project_id}/endpoint/tags",
        "description": "根据租户ID和资源类型,获取租户下资源的标签。",
        "operationId": "ListQueryProjectResourceTags",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID。",
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "resource_type",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "资源类型。\n - endpoint_service:终端节点服务\n - endpoint:终端节点",
            "enum": [
              "endpoint_service",
              "endpoint"
            ]
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "type": "string"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "发送的实体的MIME类型。推荐用户默认使用application/json, 如果API是对象、镜像上传等接口,媒体类型可按照流类型的不同进行确定。",
            "required": false,
            "default": "application/json",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "标签列表。",
            "schema": {
              "$ref": "#/definitions/ProjectResourceTags"
            },
            "examples": {
              "application/json": {
                "tags": [
                  {
                    "key": "key1",
                    "values": [
                      "*value1",
                      "value2"
                    ]
                  }
                ]
              }
            }
          }
        },
        "x-name": "查询租户资源标签",
        "x-scope": "Commercial",
        "x-order": 1,
        "x-flow-control-group": "vpcep",
        "x-multi-tenant-flow-value": "200",
        "x-multi-tenant-flow-time": "1",
        "x-tenant-flow-value": "50",
        "x-tenant-flow-time": "1",
        "x-in-cli": "",
        "x-is-registered": "Y",
        "x-first-open-time": "2018-06-01",
        "x-hybridcloud": "false",
        "x-source": "SelfDeveloped",
        "x-version": "",
        "x-timeout": "30s",
        "x-is-calling": "Y",
        "x-un-cli": "",
        "x-support-sdk": "Y",
        "tags": [
          "TAG功能"
        ],
        "summary": "查询租户资源标签接口"
      }
    }
  },
  "definitions": {
    "ProjectResourceTags": {
      "description": "租户资源标签响应体",
      "properties": {
        "tags": {
          "items": {
            "$ref": "#/definitions/TagValuesList"
          },
          "description": "包含标签,最多包含10个key,每个key下面的value最多10个,\n每个key对应的value可以为空数组但结构体不能缺失。\nKey不能重复,同一个key中values不能重复。结果返回包含所有标签的资源列表,\nkey之间是与的关系,key-value结构中value是或的关系。无tag过滤条件时返回全量数据。",
          "type": "array",
          "minItems": 1,
          "maxItems": 10
        }
      },
      "required": [
        "tags"
      ]
    },
    "TagValuesList": {
      "properties": {
        "key": {
          "description": "键。\n最大长度128个unicode字符。key不能为空。(搜索时不对此参数做字符集校),\nkey不能为空或者空字符串,不能为空格,校验和使用之前先trim前后半角空格。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "values": {
          "description": "值列表。\n每个值最大长度255个unicode字符,校验和使用之前先trim前后半角空格。\nvalue可为空数组但不可缺省。如果values为空列表,则表示any_value(查询任意value)。\nvalue之间为或的关系。(搜索时不对此参数做字符集校验,只做长度校验)。",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 255
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "key",
        "values"
      ]
    }
  },
  "version": "2.0",
  "parameters": {},
