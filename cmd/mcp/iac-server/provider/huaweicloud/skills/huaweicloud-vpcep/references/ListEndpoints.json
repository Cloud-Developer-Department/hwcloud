  "definitions": {
    "EndpointListResponseBody": {
      "properties": {
        "endpoints": {
          "type": "array",
          "description": "终端节点列表。",
          "items": {
            "$ref": "#/definitions/EndpointResponseBody"
          }
        },
        "total_count": {
          "type": "integer",
          "description": "满足查询条件的终端节点总条数,不受分页(即limit、offset参数)影响。"
        }
      },
      "description": "查询终端节点列表接口响应结构体"
    },
    "PolicyStatement": {
      "description": "policy",
      "properties": {
        "Effect": {
          "type": "string",
          "description": "- Allow,允许控制访问权限\n- Deny,拒绝控制访问权限",
          "enum": [
            "Allow",
            "Deny"
          ]
        },
        "Action": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "obs访问权限"
        },
        "Resource": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "obs对象"
        },
        "Condition": {
          "type": "object",
          "description": "statement生效的条件"
        },
        "Sid": {
          "type": "string",
          "description": "策略Id"
        }
      },
      "required": [
        "Effect",
        "Action",
        "Resource"
      ]
    },
    "TagList": {
      "description": "标签列表,没有标签默认为空数组。",
      "properties": {
        "key": {
          "description": "键。\nkey不能为空,长度1~128个字符(中文也可以输入128个字符)。 \n可用 UTF-8 格式表示的字母(包含中文、西班牙语、葡语等)、数字和空格,以及以下字符: _ . : = + - @。\n_sys_开头属于系统标签,租户不能输入。\nkey两头不能有空格字符。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "description": "值。\n长度0~255个字符(中文也可以输入255个字符)。 \n可用 UTF-8 格式表示的字母(包含中文、西班牙语、葡语等)、数字和空格,以及以下字符: _ . : / = + - @。\n资源标签值可以为空字符串。",
          "type": "string",
          "maxLength": 255
        }
      }
    },
    "EndpointResponseBody": {
      "description": "终端节接口响应结构体",
      "properties": {
        "id": {
          "description": "终端节点的ID,唯一标识。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "service_type": {
          "description": "终端节点连接的终端节点服务类型。\n - gateway:由运维人员配置。用户无需创建,可直接使用。\n - interface:包括运维人员配置的云服务和用户自己创建的私有服务。\n其中,运维人员配置的云服务无需创建,用户可直接使用。\n您可以通过查询公共终端节点服务列表,\n查看由运维人员配置的所有用户可见且可连接的终端节点服务,\n并通过创建终端节点服务创建Interface类型的终端节点服务。",
          "type": "string"
        },
        "status": {
          "description": "终端节点的连接状态。\n - pendingAcceptance:待接受\n - creating:创建中\n - accepted:已接受\n - rejected:已拒绝\n - failed:失败\n - deleting:删除中",
          "type": "string"
        },
        "active_status": {
          "description": "账号状态。\n - frozen:冻结\n - active:解冻",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endpoint_service_name": {
          "description": "终端节点服务的名称。",
          "type": "string"
        },
        "marker_id": {
          "description": "终端节点的报文标识。",
          "type": "integer"
        },
        "endpoint_service_id": {
          "description": "终端节点服务的ID。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "enable_dns": {
          "description": "是否创建域名。\n - true:创建域名\n - false:不创建域名\n说明\n当创建gateway类型终端节点服务的终端节点时,\n“enable_dns”设置为true或者false,均不创建域名。",
          "type": "boolean"
        },
        "dns_names": {
          "type": "array",
          "description": "访问所连接的终端节点服务的域名。\n当“enable_dns”为true时,该参数可见。",
          "items": {
            "description": "域名。",
            "type": "string",
            "minLength": 0,
            "maxLength": 32
          }
        },
        "ip": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "访问所连接的终端节点服务的IP。\n仅当同时满足如下条件时,返回该参数:\n当查询连接interface类型终端节点服务的终端节点时。\n终端节点服务启用“连接审批”功能,且已经“接受”连接审批。\n“status”可以是“accepted”或者“rejected(仅支持“接受”连接审批后再“拒绝”的情况)”。"
        },
        "vpc_id": {
          "description": "终端节点所在的VPC的ID。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "subnet_id": {
          "description": "vpc_id对应VPC下已创建的网络(network)的ID,UUID格式。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "终端节点的创建时间。\n采用UTC时间格式,格式为:YYYY-MM-DDTHH:MM:SSZ"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "终端节点的更新时间。\n采用UTC时间格式,格式为:YYYY-MM-DDTHH:MM:SSZ"
        },
        "project_id": {
          "description": "项目ID,获取方法请参见获取项目ID。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "tags": {
          "items": {
            "$ref": "#/definitions/TagList"
          },
          "description": "标签列表,没有标签默认为空数组。",
          "type": "array"
        },
        "error": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/QueryError"
          },
          "description": "错误信息。\n当终端节点状态异常,即“status”的值为“failed”时,会返回该字段。"
        },
        "whitelist": {
          "type": "array",
          "description": "控制访问终端节点的白名单。\n若未创建,则返回空列表。\n创建连接Interface类型终端节点服务的终端节点时,显示此参数。",
          "items": {
            "description": "ipv4或cidr。",
            "type": "string",
            "minLength": 0,
            "maxLength": 32
          }
        },
        "enable_whitelist": {
          "description": "是否开启网络ACL隔离。\n - true:开启网络ACL隔离\n - false:不开启网络ACL隔离\n若未指定,则返回false。\n创建连接Interface类型终端节点服务的终端节点时,显示此参数。",
          "type": "boolean"
        },
        "routetables": {
          "type": "array",
          "description": "路由表ID列表。\n若未指定,返回默认VPC下路由表ID。\n创建gateway类型终端节点服务的终端节点时,显示此参数。",
          "items": {
            "description": "路由表ID。",
            "type": "string",
            "minLength": 0,
            "maxLength": 64
          }
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512,
          "description": "描述字段,支持中英文字母、数字等字符,不支持“<”或“>”字符。"
        },
        "policy_statement": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/PolicyStatement"
          },
          "description": "Gateway类型终端节点策略信息,仅限OBS、SFS的终端节点服务的enable_policy值为true时支持该参数。"
        },
        "policy_document": {
          "type": "object",
          "description": "终端节点策略信息,仅当终端节点服务的enable_policy值为true时支持该参数,默认值为完全访问权限。(OBS、SFS的终端节点服务暂不支持该参数)",
          "minItems": 0,
          "maxItems": 20480
        },
        "endpoint_pool_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "待废弃,实例相关联的集群ID"
        },
        "public_border_group": {
          "type": "string",
          "description": "终端节点关联的Public Border Group信息,只有当终端节点和边缘Pool相关联时才会返回该字段"
        }
      },
      "type": "object"
    },
    "QueryError": {
      "properties": {
        "error_code": {
          "description": "错误编码。",
          "type": "string",
          "minLength": 0,
          "maxLength": 10
        },
        "error_message": {
          "description": "错误信息。",
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "description": "查询资源返回的异常信息"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "vpcep.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
