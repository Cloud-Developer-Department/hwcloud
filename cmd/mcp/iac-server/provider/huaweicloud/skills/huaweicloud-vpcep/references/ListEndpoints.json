{
  "name": "ListEndpoints",
  "summary": "查询终端节点列表",
  "tags": "终端节点功能",
  "productshort": "VPCEP",
  "region_id": "ae-ad-1",
  "paths": {
    "/v1/{project_id}/vpc-endpoints": {
      "get": {
        "x-request-examples-description-1": "查询终端节点列表",
        "x-request-examples-url-1": "GET https://{endpoint}/v1/{project_id}/vpc-endpoints?endpoint_service_name={endpoint_service_name}&vpc_id={vpc_id}&limit={limit}&offset={offset}&id={id}&sort_key={sort_key}&sort_dir={sort_dir}",
        "summary": "查询终端节点列表",
        "description": "查询当前用户下的终端节点的列表。",
        "operationId": "ListEndpoints",
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-order": 1
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "发送的实体的MIME类型。推荐用户默认使用application/json, 如果API是对象、镜像上传等接口,媒体类型可按照流类型的不同进行确定。",
            "required": false,
            "default": "application/json",
            "type": "string",
            "x-order": 2
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-order": 3,
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "endpoint_service_name",
            "in": "query",
            "description": "终端节点服务的名称,支持大小写,前后模糊匹配。",
            "required": false,
            "type": "string",
            "x-order": 4,
            "minLength": 1,
            "maxLength": 128
          },
          {
            "name": "vpc_id",
            "in": "query",
            "description": "终端节点所在的VPC的ID。",
            "required": false,
            "type": "string",
            "x-order": 5,
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "id",
            "in": "query",
            "description": "终端节点的ID,唯一标识。",
            "required": false,
            "type": "string",
            "x-order": 6,
            "minLength": 1,
            "maxLength": 64
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询返回终端节点的数量限制,即每页返回的资源个数。\n取值范围:0~1000,取值一般为10,20或者50,默认为10。",
            "default": 10,
            "required": false,
            "type": "integer",
            "x-order": 9,
            "minimum": 1,
            "maximum": 1000
          },
          {
            "name": "offset",
            "in": "query",
            "description": "偏移量。\n偏移量为一个大于0小于终端节点服务总个数的整数,\n表示从偏移量后面的终端节点服务开始查询。",
            "required": false,
            "type": "integer",
            "x-order": 10,
            "minimum": 0,
            "exclusiveMaximum": true
          },
          {
            "name": "sort_key",
            "in": "query",
            "required": false,
            "description": "查询结果中终端节点列表的排序字段,取值为:\n - create_at:终端节点的创建时间\n - update_at:终端节点的更新时间\n默认值为create_at。",
            "type": "string",
            "default": "create_at",
            "enum": [
              "create_at",
              "update_at"
            ]
          },
          {
            "name": "sort_dir",
            "in": "query",
            "required": false,
            "description": "查询结果中终端节点列表的排序方式,取值为:\n - desc:降序排序\n - asc:升序排序\n默认值为desc。",
            "type": "string",
            "default": "desc",
            "enum": [
              "desc",
              "asc"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "服务器已成功处理了请求",
            "examples": {
