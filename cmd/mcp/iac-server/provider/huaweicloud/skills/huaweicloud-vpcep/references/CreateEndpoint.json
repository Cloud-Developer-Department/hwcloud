  "definitions": {
    "PolicyStatement": {
      "description": "policy",
      "properties": {
        "Effect": {
          "type": "string",
          "description": "- Allow,允许控制访问权限\n- Deny,拒绝控制访问权限",
          "enum": [
            "Allow",
            "Deny"
          ]
        },
        "Action": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "obs访问权限"
        },
        "Resource": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "obs对象"
        },
        "Condition": {
          "type": "object",
          "description": "statement生效的条件"
        },
        "Sid": {
          "type": "string",
          "description": "策略Id"
        }
      },
      "required": [
        "Effect",
        "Action",
        "Resource"
      ]
    },
    "TagList": {
      "description": "标签列表,没有标签默认为空数组。",
      "properties": {
        "key": {
          "description": "键。\nkey不能为空,长度1~128个字符(中文也可以输入128个字符)。 \n可用 UTF-8 格式表示的字母(包含中文、西班牙语、葡语等)、数字和空格,以及以下字符: _ . : = + - @。\n_sys_开头属于系统标签,租户不能输入。\nkey两头不能有空格字符。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "description": "值。\n长度0~255个字符(中文也可以输入255个字符)。 \n可用 UTF-8 格式表示的字母(包含中文、西班牙语、葡语等)、数字和空格,以及以下字符: _ . : / = + - @。\n资源标签值可以为空字符串。",
          "type": "string",
          "maxLength": 255
        }
      }
    },
    "CreateEndpointRequestBody": {
      "description": "创建终端节接口请求结构体",
      "properties": {
        "subnet_id": {
          "description": "创建连接Interface类型终端节点服务的终端节点时,此参数必选。\n需要指定vpc_id对应VPC下已创建的网络(network)的ID,UUID格式。\n说明:\n- VPC的子网网段不能与198.19.128.0/17重叠\n- VPC路由表中自定义路由的目的地址不能与198.19.128.0/17重叠",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "endpoint_service_id": {
          "description": "终端节点服务的ID。\n可以通过查询终端节点服务概\n要获取要连接的终端节点服务\nID。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "vpc_id": {
          "description": "终端节点所在的VPC的ID。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "enable_dns": {
          "description": "是否创建域名。\n - true:创建域名\n - false:不创建域名\n默认值为false。\n说明\n当创建gateway类型终端节点服务的终端节点时,\n“enable_dns”设置为true或者false,均不创建域名。",
          "type": "boolean",
          "default": false
        },
        "tags": {
          "items": {
            "$ref": "#/definitions/TagList"
          },
          "description": "标签列表,没有标签默认为空数组。",
          "type": "array"
        },
        "routetables": {
          "type": "array",
          "description": "路由表ID列表。\n创建gateway类型终端节点服务的终端节点时,此参数必选。\n不设置此参数时,选择默认路由表。",
          "items": {
            "description": "路由表ID。",
            "type": "string",
            "minLength": 0,
            "maxLength": 64
          },
          "minItems": 1,
          "maxItems": 10
        },
        "port_ip": {
          "type": "string",
          "description": "访问所连接的终端节点服务的IP。\n创建终端节点时,可以指定访问所连接的终端节点服务的IP,目前只支持IPv4类型 。\n创建连接Interface类型终端节点服务的终端节点时,此参数必选。",
          "minLength": 1,
          "maxLength": 128
        },
        "whitelist": {
          "type": "array",
          "description": "添加用于控制访问终端节点的白名单。\n创建终端节点时,支持访问控制,使用此参数可以添加IPv4或CIDR,默认空列表。\n仅当创建连接Interface类型终端节点服务的终端节点时,支持设置此参数。",
          "items": {
            "description": "IPv4或CIDR。",
            "type": "string",
            "minLength": 0,
            "maxLength": 32
          }
        },
        "enable_whitelist": {
          "description": "是否开启网络ACL隔离。",
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "description": "描述字段,支持中英文字母、数字等字符,不支持“<”或“>”字符。",
          "minLength": 0,
          "maxLength": 512
        },
        "policy_statement": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/PolicyStatement"
          },
          "description": "Gateway类型终端节点策略信息,仅限OBS、SFS的终端节点服务的enable_policy值为true时支持该参数。"
        },
        "policy_document": {
          "type": "object",
          "description": "终端节点策略信息,仅当终端节点服务的enable_policy值为true时支持该参数,默认值为完全访问权限。(OBS、SFS的终端节点服务暂不支持该参数)",
          "minItems": 0,
          "maxItems": 20480
        },
        "ip_version": {
          "type": "string",
          "description": "指定终端节点的IP版本,仅专业型终端节点支持此参数。\n\n- ipv4,  IPv4\n- dualstack, 双栈",
          "enum": [
            "ipv4",
            "dualstack"
          ]
        },
        "ipv6_address": {
          "type": "string",
          "description": "访问所连接的终端节点服务的IPv6的地址。\n\n创建终端节点时,可以指定访问所连接的终端节点服务的IP,不指定的情况下,会使用系统生成的一个地址。\n\n仅专业型终端节点支持此参数。",
          "format": "ipv6"
        }
      },
      "required": [
        "endpoint_service_id",
        "vpc_id"
      ]
    },
    "CreateEndpointResponseBody": {
      "description": "终端节接口响应结构体",
      "properties": {
        "id": {
          "description": "终端节点的ID,唯一标识。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "service_type": {
          "description": "终端节点连接的终端节点服务类型。 \n - gateway:由运维人员配置。用户无需创建,可直接使用。 \n - interface:包括运维人员配置的云服务和用户自己创建的私有服务。\n其中,运维人员配置的云服务无需创建,用户可直接使用。\n您可以通过\"查询公共终端节点服务列表\"查看由运维人员配置的所有用户可见且可连接的终端节点服务,并通过创建终端节点服务创建Interface类型的终端节点服务。",
          "type": "string"
        },
        "status": {
          "description": "终端节点的状态。\n - pendingAcceptance:待接受\n - creating:创建中\n - accepted:已接受\n - rejected:已拒绝\n - failed:失败\n - deleting:删除中",
          "type": "string"
        },
        "ip": {
          "description": "终端节点ip",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "active_status": {
          "description": "账号状态。\n - frozen:冻结\n - active:解冻",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endpoint_service_name": {
          "description": "终端节点服务的名称。",
          "type": "string"
        },
        "marker_id": {
          "description": "终端节点的报文标识。",
          "type": "integer"
        },
        "endpoint_service_id": {
          "description": "终端节点服务的ID。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "enable_dns": {
          "description": "是否创建域名。\n - true:创建域名\n - false:不创建域名\n说明\n当创建gateway类型终端节点服务的终端节点时,\n“enable_dns”设置为true或者false,均不创建域名。",
          "type": "boolean"
        },
        "subnet_id": {
          "description": "vpc_id对应VPC下已创建的网络(network)的ID,UUID格式。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "vpc_id": {
          "description": "终端节点所在的VPC的ID。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "终端节点的创建时间。\n采用UTC时间格式,格式为:YYYY-MM-DDTHH:MM:SSZ"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "终端节点的更新时间。\n采用UTC时间格式,格式为:YYYY-MM-DDTHH:MM:SSZ"
        },
        "project_id": {
          "description": "项目ID,获取方法请参见获取项目ID。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "tags": {
          "items": {
            "$ref": "#/definitions/TagList"
          },
          "description": "标签列表,没有标签默认为空数组。",
          "type": "array"
        },
        "whitelist": {
          "type": "array",
          "description": "控制访问终端节点的白名单。\n若未创建,则返回空列表。\n创建连接Interface类型终端节点服务的终端节点时,显示此参数。",
          "items": {
            "description": "ipv4或cidr。",
            "type": "string",
            "minLength": 0,
            "maxLength": 32
          }
        },
        "enable_whitelist": {
          "description": "是否开启网络ACL隔离。\n - true:开启网络ACL隔离\n - false:不开启网络ACL隔离\n若未指定,则返回false。\n创建连接Interface类型终端节点服务的终端节点时,显示此参数。",
          "type": "boolean"
        },
        "routetables": {
          "type": "array",
          "description": "路由表ID列表。\n若未指定,返回默认VPC下路由表ID。\n创建gateway类型终端节点服务的终端节点时,显示此参数。",
          "items": {
            "description": "路由表ID。",
            "type": "string",
            "minLength": 0,
            "maxLength": 64
          }
        },
        "specification_name": {
          "type": "string",
          "description": "规格名称"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "描述"
        },
        "policy_statement": {
          "minItems": 0,
          "maxItems": 10,
          "type": "array",
          "items": {
            "$ref": "#/definitions/PolicyStatement"
          },
          "description": "Gateway类型终端节点策略信息,仅限OBS、SFS的终端节点服务的enable_policy值为true时支持该参数。"
        },
        "policy_document": {
          "type": "object",
          "description": "终端节点策略信息,仅当终端节点服务的enable_policy值为true时支持该参数,默认值为完全访问权限。(OBS、SFS的终端节点服务暂不支持该参数)",
          "minItems": 0,
          "maxItems": 20480
        },
        "enable_status": {
          "type": "string",
          "description": "终端节点是否可用。\n - enable:启用\n - disable:不启用"
        },
        "endpoint_pool_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "待废弃,实例相关联的集群ID"
        },
        "public_border_group": {
          "type": "string",
          "description": "终端节点对应Pool的Public Border Group信息"
        },
        "ipv6_address": {
          "type": "string",
          "description": "终端节点的IPv6地址,仅专业型终端节点支持此参数",
          "format": "ipv6"
        }
      }
    }
  },
