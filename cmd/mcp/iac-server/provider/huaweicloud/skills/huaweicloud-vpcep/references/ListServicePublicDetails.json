  "definitions": {
    "EndpointService": {
      "description": "终端节点服务列表",
      "properties": {
        "id": {
          "description": "公共终端节点服务的ID,唯一标识。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "owner": {
          "description": "终端节点服务的所有者。",
          "type": "string"
        },
        "service_name": {
          "description": "公共终端节点服务的名称。",
          "type": "string"
        },
        "service_type": {
          "description": "终端节点服务类型。\n - gateway:由运维人员配置。用户无需创建,可直接使用。\n - interface:包括运维人员配置的云服务和用户自己创建的私有服务。\n其中,运维人员配置的云服务无需创建,\n用户可直接使用。\n您可以通过创建终端节点创建访问Gateway和Interface类型终端节点服务的终端节点。",
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "终端节点服务的创建时间。\n采用UTC时间格式,格式为:YYYY-MM-DDTHH:MM:SSZ"
        },
        "is_charge": {
          "type": "boolean",
          "description": "连接该终端节点服务的终端节点是否计费。\n - true:计费\n - false:不计费"
        },
        "enable_policy": {
          "type": "boolean",
          "description": "是否允许自定义终端节点策略。\n - false:不支持设置终端节点策略\n - true:支持设置终端节点策略\n默认为false"
        }
      }
    },
    "QueryPublicServiceResponseBody": {
      "properties": {
        "endpoint_services": {
          "type": "array",
          "description": "终端节点服务列表。",
          "items": {
            "$ref": "#/definitions/EndpointService"
          }
        },
        "total_count": {
          "type": "integer",
          "description": "满足查询条件的公共终端节点服务总条数,不受分页(即limit、offset参数)影响。"
        }
      },
      "description": "查询公共终端节点服务列表接口响应结构体",
      "type": "object"
