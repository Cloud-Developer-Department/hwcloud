  "definitions": {
    "AcceptOrRejectEndpointRequestBody": {
      "description": "连接终端节点列表请求结构体",
      "properties": {
        "action": {
          "description": "允许或拒绝连接。\n - receive:允许连接。\n - reject:拒绝连接。",
          "type": "string",
          "enum": [
            "receive",
            "reject"
          ]
        },
        "endpoints": {
          "type": "array",
          "description": "终端节点ID列表。\n每次请求目前支持单条endpoint的接受或拒绝。",
          "items": {
            "description": "string类型。",
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "action",
        "endpoints"
      ]
    },
    "ConnectionEndpointResponseBody": {
      "description": "连接终端节点响应结构体",
      "properties": {
        "connections": {
          "type": "array",
          "description": "连接列表",
          "items": {
            "$ref": "#/definitions/ConnectionEndpoints"
          }
        }
      }
    },
