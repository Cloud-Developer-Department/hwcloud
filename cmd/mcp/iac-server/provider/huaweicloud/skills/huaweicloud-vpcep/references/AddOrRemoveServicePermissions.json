  "definitions": {
    "OperatePermissionsResponseBody": {
      "properties": {
        "permissions": {
          "type": "array",
          "description": "permission列表。\n权限格式为:\n- iam:domain::domain_id。其中:\n“iam:domain::”为固定格式,“domain_id”为可连接用户的账号ID。\ndomain_id类型支持输入包括“a~z”、“A~Z”、“0~9”或者“*”,最大长度可以传64。\n\n- organizations:orgPath::org_path。其中:\n“organizations:orgPath::”为固定格式,org_path为可连接用户的组织路径。\norg_path类型支持“a~z”、“A~Z”、“0~9”、“/-*?”或者“*”,最大长度可以传1024。\n\n“*”表示所有终端节点可连接。\n示例:\n- iam:domain::6e9dfd51d1124e8d8498dce894923a0dd\n- organizations:orgPath::o-3j59d1231uprgk9yuvlidra7zbzfi578/r-rldbu1vmxdw5ahdkknxnvd5rgag77m2z/ou-7tuddd8nh99rebxltawsm6qct5z7rklv/*",
          "items": {
            "description": "IPV4或CIDR。",
            "type": "string",
            "minLength": 0,
            "maxLength": 32
          }
        },
        "permission_type": {
          "type": "string",
          "description": "终端节点服务白名单类型。\n - domainId:基于账户ID配置终端节点服务白名单。\n - orgPath:基于账户所在组织路径配置终端节点服务白名单。"
        }
      },
      "description": "批量添加或删除终端节点服务的白名单列表接口响应结构体",
      "type": "object"
    },
    "AddOrRemoveServicePermissionsRequestBody": {
      "description": "操作权限请求结构体",
      "properties": {
        "permissions": {
          "type": "array",
          "description": "permission列表。\n权限格式为:\n- iam:domain::domain_id。其中:\n“iam:domain::”为固定格式,“domain_id”为可连接用户的账号ID。\ndomain_id类型支持输入包括“a~z”、“A~Z”、“0~9”或者“*”,最大长度可以传64。\n\n- organizations:orgPath::org_path。其中:\n“organizations:orgPath::”为固定格式,org_path为可连接用户的组织路径。\norg_path类型支持“a~z”、“A~Z”、“0~9”、“/-*?”或者“*”,最大长度可以传1024。\n\n“*”表示所有终端节点可连接。\n示例:\n- iam:domain::6e9dfd51d1124e8d8498dce894923a0dd\n- organizations:orgPath::o-3j59d1231uprgk9yuvlidra7zbzfi578/r-rldbu1vmxdw5ahdkknxnvd5rgag77m2z/ou-7tuddd8nh99rebxltawsm6qct5z7rklv/*",
          "items": {
            "description": "可连接的用户domian_id或者org_path。",
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 50
        },
        "permission_type": {
          "type": "string",
          "enum": [
            "domainId",
            "orgPath"
          ],
          "description": "终端节点服务白名单类型。\n - domainId:基于账户ID配置终端节点服务白名单。\n - orgPath:基于账户所在组织路径配置终端节点服务白名单。"
        },
        "action": {
          "description": "要执行的操作。\nadd/remove。",
          "type": "string",
          "enum": [
            "add",
            "remove"
          ],
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": [
        "permissions",
        "action"
      ],
      "type": "object"
    }
